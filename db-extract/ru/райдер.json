                ],
                "senses": [
                    {
                        "sense_id": "9b442d6b-8cec-33ae-9a5b-4e04507c156c",
                        "entry_id": "4e4c610f-0324-3573-9240-585a2aa7ec62",
                        "glosses": [
                            "спорт. тот, кто занимается катанием на спортивном снаряде в виде доски или на велосипеде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda68a9b-d451-46e4-b5fd-aa1921b95655",
                                "sense_id": "9b442d6b-8cec-33ae-9a5b-4e04507c156c",
                                "text": "Не отставали от мужчин и представительницы прекрасного пола. Трюкам, выполняемым хрупкими девушками, порой мог позавидовать даже бывалый райдер."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b800f30-43ca-4b85-b541-f709e67941e9",
                        "source_entry_id": "4e4c610f-0324-3573-9240-585a2aa7ec62",
                        "source_sense_id": "9b442d6b-8cec-33ae-9a5b-4e04507c156c",
                        "target_lang_word": "rider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80dfc02e-1180-35f1-ba84-425aaa2fab48",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "A knight, or other mounted warrior."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc3e394c-104b-3284-99ec-4de710e8a778",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "An old Dutch gold coin with the figure of a man on horseback stamped upon it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d18740c-0319-4c07-b38d-72dc6c0ed6e5",
                                                "sense_id": "cc3e394c-104b-3284-99ec-4de710e8a778",
                                                "text": "His mouldy money! half a dozen riders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c963d55a-9a4f-3c8b-a5cf-ca4dac31511f",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "Someone who rides a horse or (later) a bicycle, motorcycle etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40e5104-6d80-449b-b25c-0936989336d9",
                                                "sense_id": "c963d55a-9a4f-3c8b-a5cf-ca4dac31511f",
                                                "text": "The eyes of Holstein de Dorenstorff stared, wildly, upon a figure, which at this instant appeared, mounted on a beautiful beast,[…]; its rider was enveloped in a kind of large, concealing coat, which well answered the intent of its purport: […]"
                                            },
                                            {
                                                "example_id": "0c723118-17a1-4082-a648-26d6e54ad1be",
                                                "sense_id": "c963d55a-9a4f-3c8b-a5cf-ca4dac31511f",
                                                "text": "After riding high for two decades, the company that makes the hulky bikes that devoted riders affectionately call Hogs is sputtering. […] When customers buy a Harley, they’re instantly a member of a family of zealous fans  guys with tattoos and unruly hair as well as lawyers and doctors. (The average household income of today’s rider is about $87,000.)"
                                            },
                                            {
                                                "example_id": "0dbc10a0-334a-4f9a-84d7-227555a45207",
                                                "sense_id": "c963d55a-9a4f-3c8b-a5cf-ca4dac31511f",
                                                "text": "BMX rider Saya Sakakibara is all too aware of the risks of her chosen profession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a7fa868-6c95-3c53-a35f-59a6bd45f885",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "A mounted robber; a bandit, especially in the Scottish borders."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f356a01-b777-4889-a51b-c6d748ef8da5",
                                                "sense_id": "2a7fa868-6c95-3c53-a35f-59a6bd45f885",
                                                "text": "In Ewsdale eight and forty notorious riders are hung on growing trees, the most famous of which was John Armstrong"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84917052-72e1-3817-915b-f170152be97b",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "Someone who breaks in or manages a horse; a riding master."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b92b5d-2dc1-4921-81f9-02cab76b0270",
                                                "sense_id": "84917052-72e1-3817-915b-f170152be97b",
                                                "text": "They are taught their mannage, and to that end Riders deerely hir'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb26c674-fcd2-3c41-a7aa-1de961d13afa",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "An agent who goes out with samples of goods to obtain orders; a commercial traveller or travelling salesman."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d272acfa-8c06-49e0-ad6e-097a2c214d53",
                                                "sense_id": "cb26c674-fcd2-3c41-a7aa-1de961d13afa",
                                                "text": "I set out with a Paisley manufacturer and a London rider, the latter of whom I envied for his smartness and self-complacency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "543cb905-37ee-330e-a7c3-b4be42a3220a",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "Someone riding in a vehicle; a passenger on public transport."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8db86f0-82b4-4ac0-b651-e2775f87a2ee",
                                                "sense_id": "543cb905-37ee-330e-a7c3-b4be42a3220a",
                                                "text": "On the London Underground, Piccadilly Circus station is nearly vacant on a weekday morning, while the Delhi Metro is ferrying fewer than half of the riders it used to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32ba3fc5-3195-3c87-a8c7-7154ee84dcf3",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "A boarder, a person who rides a board in boardsports.",
                                            "A skateboarder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3ba62a-af61-4fd0-ac17-b6d78879889f",
                                                "sense_id": "32ba3fc5-3195-3c87-a8c7-7154ee84dcf3",
                                                "text": "In its May 1965 issue, Life magazine condemned skateboards as a “menace to limb and even to life,” and cautioned readers about riders who “take over the paths made for peaceful strollers.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c294cd85-6f2d-310b-a746-8209e8fa7c78",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "A mounted person.",
                                            "A boarder, a person who rides a board in boardsports.",
                                            "A snowboarder"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "342ba626-df34-3ecc-bc60-a123b7c04a68",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "An addition, supplement.",
                                            "A supplementary clause added to a document after drafting, especially to a bill under the consideration of a legislature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30369c5b-9be9-3acd-936e-54706b6a0484",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "An addition, supplement.",
                                            "An amendment or addition to an entertainer's performance contract, often covering a performer's equipment or food, drinks, and general comfort requirements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee19ad54-786d-4baa-bbd0-7df6a26890bd",
                                                "sense_id": "30369c5b-9be9-3acd-936e-54706b6a0484",
                                                "text": "I had sixteen nudity riders to sign and having Jean, our intimacy coordinator, Jean Franzblau, was absolutely pivotal to being able to do this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aefbda0-f1b6-3c4f-a315-543ecf00d6c8",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "An addition, supplement.",
                                            "An additional matter or question arising in corollary; a qualification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8786d3c-44c2-46eb-a7fa-756672ddf3a5",
                                                "sense_id": "8aefbda0-f1b6-3c4f-a315-543ecf00d6c8",
                                                "text": "But they would hush momentarily for the farce, specially if billed with the grand rider: 'licensed by the Lord Chamberlain expressly for this theatre'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef27099-025b-3747-b632-9f87c5bdf2ef",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "An addition, supplement.",
                                            "A supplementary question, now especially in mathematics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a60ed31-2c66-4820-ae44-2d6ad838c393",
                                                "sense_id": "6ef27099-025b-3747-b632-9f87c5bdf2ef",
                                                "text": "This [question] was a rider which Mab found difficult to answer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bf5798a-1a45-3e33-8068-04eb7a3b539c",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "An addition, supplement.",
                                            "An add-on to an insurance policy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "700e10ee-8ecc-39f3-8777-f1a817451ae4",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "Technical senses.",
                                            "An interior rib occasionally fixed in a ship's hold, reaching from the keelson to the beams of the lower deck, to strengthen the frame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9944537a-0241-412a-abe0-7e21b246e483",
                                                "sense_id": "700e10ee-8ecc-39f3-8777-f1a817451ae4",
                                                "text": "During the four weeks of research, a considerable part of the ships structure was discovered underneath the ballast stones: keel, floor timbers, strakes, keelson together with mast step and its sisters and rider"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87659473-9c9c-3b4b-b808-259a46e86875",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "Technical senses.",
                                            "Rock material in a vein of ore, dividing it."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae06c8aa-3ff0-335d-b937-bfb7af94d34c",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "Technical senses.",
                                            "The second tier of casks in a vessel's hold."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f89753a-9c09-31e5-bade-9e8cb978eb9f",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "Technical senses.",
                                            "A small, sliding piece of thin metal on a balance, used to determine small weights."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bce1c6cc-4f26-3c15-89e5-dff0dce44b35",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "Technical senses.",
                                            "The first Lenormand card, also known as either the horseman or the cavalier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae553d44-6986-35fb-9620-657d02e6b5f3",
                                        "entry_id": "c12735ef-9535-3998-9832-9cb3c51c7356",
                                        "glosses": [
                                            "Technical senses.",
                                            "A piece, such as the rook or bishop, which moves any distance in one direction as long as no other piece is in the way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359afc8f-ad20-4d9f-a8af-2448e0b44bb1",
                                                "sense_id": "ae553d44-6986-35fb-9620-657d02e6b5f3",
                                                "text": "It simply blocks the cell to entry by any piece, though riders may pass over it (otherwise checkmates become difficult, since the coin could be used to block any distant check by a rider). […] Another type of rider is the Mao which is the knight in Chinese chess. It makes its move in two steps, a noncapturing wazir move followed by a fers move, so the cell moved through must be vacant. The Moa (W.Speckman) is a knight that moves as fers followed by wazir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
