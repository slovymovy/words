                ],
                "translations": [
                    {
                        "translation_id": "4d1336bc-4178-42ef-8cc2-59306f91517a",
                        "source_entry_id": "8ddd525b-c903-347f-963d-6118e7bfe6b9",
                        "source_sense_id": "32bb2017-4c23-3406-844c-f455f0c046ba",
