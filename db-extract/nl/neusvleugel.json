                                                "example_id": "16f0a137-2e0d-4c27-82d9-c81eb75b6c2c",
                                                "sense_id": "f4475b00-0ffd-32de-81eb-3aab7d8a05c5",
                                                "text": "„Das Nasenpflaster wird so über den Nasenrücken geklebt, dass die Nasenflügel durch die Biegung der Kunststoffverstärkungen leicht nach oben gezogen werden.“"
                                            },
                                            {
                                                "example_id": "57c61602-0a23-4ee4-874b-e01ffac519db",
                                                "sense_id": "f4475b00-0ffd-32de-81eb-3aab7d8a05c5",
                                                "text": "„Und ihr linker Nasenflügel zitterte.“"
                                            },
                                            {
                                                "example_id": "06c82b5c-222c-41a8-a58d-e4f9a724083f",
                                                "sense_id": "f4475b00-0ffd-32de-81eb-3aab7d8a05c5",
                                                "text": "„An dieser Stelle weiteten sich Amalias Nasenflügel wie die Nüstern eines Drachen, und ihre Hand schloss sich so fest um ihr Weinglas, dass ich schon fürchtete, es würde zerbrechen.“"
                                            }
                                        ],
