{
    "word_family": [
        "insistance",
        "insistant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "705aac83-da1e-320c-990c-5751ef30f4dd",
                    "sense_definition": "Persévérer avec ténacité dans une demande, une démarche ou une volonté sans renoncer facilement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "persévérance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'a pas voulu me donner son avis, alors je n'ai pas <w>insisté</w> davantage."
                        },
                        {
                            "text": "Mon ami a tellement <w>insisté</w> que nous avons fini par accepter son invitation à dîner."
                        }
                    ],
                    "common_phrases": [
                        "insister lourdement",
                        "insister pour venir"
                    ]
                },
                {
                    "sense_id": "f900ba23-7cac-3a6e-b745-1d31fcb3c06e",
                    "sense_definition": "Mettre l'accent sur une idée ou souligner un élément avec force pour attirer l'attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souligner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a <w>insisté</w> sur les notions clés pour aider les élèves à préparer l'examen."
                        },
                        {
                            "text": "Je voudrais <w>insister</w> sur ce point car il est déterminant pour la réussite du projet."
                        }
                    ],
                    "synonyms": [
                        "marteler"
                    ],
                    "common_phrases": [
                        "insister sur ce point",
                        "insister sur un détail"
                    ]
                }
            ]
        }
    ]
}