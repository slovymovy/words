                                        "glosses": [
                                            "The tissue of the skin underlying the epidermis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e30565a-7927-420b-ad31-b5138e4d84cf",
                        "source_entry_id": "8f2fe784-83e0-302d-8f6a-28a9af70cf1a",
                        "source_sense_id": "12379e0d-47f4-39d2-829a-921b9af71b2a",
                        "target_lang_word": "corium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corium",
