                                "sense_id": "144cb4ae-20b6-369d-9411-518470fe225a",
                                "text": "„Er wird ſagen, daß der alte Ratſch ein Einfaltspinſel iſt, ein Ruſſacke dem Geiſte, wenn auch nicht der Abſtammung nach, ha – ha!“"
                            },
                            {
                                "example_id": "b36bbe44-50af-44e8-9753-7cb8476bd15b",
                                "sense_id": "144cb4ae-20b6-369d-9411-518470fe225a",
                                "text": "„Scheinbar will man nicht den Fehler des ollen Napoleon machen und den Ruſſacken bis Moskau nachlatſchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
