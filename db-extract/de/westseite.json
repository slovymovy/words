                ],
                "senses": [
                    {
                        "sense_id": "3e9c05c4-561d-3b17-b88b-8bbac6092902",
                        "entry_id": "4128a9f1-59c0-3e08-a38e-98fb3309ed3e",
                        "glosses": [
                            "westliche Seite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e529dc92-711f-45de-8aa1-b7472e5d4b7d",
                                "sense_id": "3e9c05c4-561d-3b17-b88b-8bbac6092902",
                                "text": "„Oben angekommen, bemerkte ich, dass auf der Westseite der Insel ein ganz anderes Wetter herrschte.“"
                            },
                            {
                                "example_id": "9b4fd550-83e4-43bc-8959-59f1e6234d09",
                                "sense_id": "3e9c05c4-561d-3b17-b88b-8bbac6092902",
                                "text": "„Dort befand sich auf der Westseite eine dreiräumige Vorhalle, in der man die dort harrenden Leute mit Tee zu bewirten pflegte.“"
                            },
                            {
                                "example_id": "55d6418a-a5b8-4603-9536-12b1daa8612b",
                                "sense_id": "3e9c05c4-561d-3b17-b88b-8bbac6092902",
                                "text": "„Nach Süden hin lief die Insel in einem 50 km langen Schwanz aus, der nur an der Westseite durch eine kleine Bucht unterbrochen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
