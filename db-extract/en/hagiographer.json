                                        "entry_id": "6afe6d71-2adc-34c2-8865-041623e9cd63",
                                        "glosses": [
                                            "Qui concerne cette partie de l’Ancien Testament qui n’est ni de Moïse, ni des prophètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8677d4e8-657f-4e02-a46d-ce5761e35911",
