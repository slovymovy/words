                            },
                            {
                                "target_word": "gouttière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5c8e4a-f85b-39f5-8cd9-f5ed666345d6",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Petit canal placé au bord des toits et par où les eaux de pluie s’écoulent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fd81e32-27d2-425c-9e8c-51ba5069f64f",
                                                "sense_id": "4d5c8e4a-f85b-39f5-8cd9-f5ed666345d6",
                                                "text": "Maintenant il pleut. J’entends l’eau qui ruisselle des gouttières, et qui fouette les vitres de ma chambre."
                                            },
                                            {
                                                "example_id": "843319bd-bfb1-4cae-9fc6-c37b3c9580e1",
                                                "sense_id": "4d5c8e4a-f85b-39f5-8cd9-f5ed666345d6",
                                                "text": "Elle ne savait pas que, sur la terrasse des maisons, la pluie fait des lacs quand les gouttières sont bouchées."
                                            },
                                            {
                                                "example_id": "7d602943-d92a-431d-a2d6-e63144d4be6b",
                                                "sense_id": "4d5c8e4a-f85b-39f5-8cd9-f5ed666345d6",
                                                "text": "Bref, nous avions fini le litre, assis sur une grosse souche, avec la fameuse couverture pendue aux branches, qui pissait l’eau comme une gouttière."
                                            },
                                            {
                                                "example_id": "80fea19d-49d9-4684-bdb8-7e93400c2059",
                                                "sense_id": "4d5c8e4a-f85b-39f5-8cd9-f5ed666345d6",
                                                "text": "En descendant pour ouvrir le portail, Patrice remarqua même un pochon de Super U envolé de chez lui qui pendait à la gouttière, juste au-dessus d'une fenêtre basse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0bfbce5-da2d-3d6b-b96c-7253dce61b56",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Le toit même."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "note": "Dans ce sens, on le met ordinairement au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "ecfa0505-0e68-4bed-b59f-ae8d01fc7506",
                                                "sense_id": "e0bfbce5-da2d-3d6b-b96c-7253dce61b56",
                                                "text": "Se promener sur les gouttières."
                                            },
                                            {
                                                "example_id": "b78b1fdc-1e01-41c5-816f-86eec436eb7c",
                                                "sense_id": "e0bfbce5-da2d-3d6b-b96c-7253dce61b56",
                                                "text": "Des chats qui se battent dans les gouttières."
                                            },
                                            {
                                                "example_id": "f7ea2596-9fc1-487b-823c-88ef5a36f9c1",
                                                "sense_id": "e0bfbce5-da2d-3d6b-b96c-7253dce61b56",
                                                "text": "Un chat de gouttières : Un chat d’espèce commune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bbff5d5-2167-342e-8a8f-636de8ae1d77",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Chat de gouttières."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49500d2-8c3f-41e4-8750-d5eaaf026caf",
                                                "sense_id": "5bbff5d5-2167-342e-8a8f-636de8ae1d77",
                                                "text": "Nous avions, mes filles ma compagne et moi, avec notre petite gouttière Akiko, un modus vivendi : libre à elle d’aller la nuit sur les toits par le fenestron des toilettes, tant qu’elle y restait ou faisait un petit tour sur les tuiles encore chaudes, sans descendre dans la nuit profonde, vers les jardins en contrebas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09535bc1-0b36-36a8-9643-8f228cf1bf24",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Fuite d'eau venant du toit, du plafond."
                                        ],
                                        "tags": [
                                            "Régionalisme",
                                            "Ouest de la France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a62d6dbd-5ab5-4ca5-9161-50dfcdc42793",
                                                "sense_id": "09535bc1-0b36-36a8-9643-8f228cf1bf24",
                                                "text": "Depuis que la grêle a cassée une tuile j'ai une gouttière dans le grenier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a587a6e6-32c9-3665-9da9-6b042e1b4e55",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Canal permettant l’écoulement d’un liquide quelconque."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e4fad9-2982-4668-82dc-e5732b35de04",
                                                "sense_id": "a587a6e6-32c9-3665-9da9-6b042e1b4e55",
                                                "text": "Pantalon avec gouttière."
                                            },
                                            {
                                                "example_id": "e57de306-4c6a-4e73-bdf6-4246e25f9b8d",
                                                "sense_id": "a587a6e6-32c9-3665-9da9-6b042e1b4e55",
                                                "text": "La masse des enfants se précipite sans cesse autour de la grande cuve qui tourne sur elle-même, pour guetter le moment où les valves ouvertes, tandis que l’air pénètre en sifflant à l’intérieur des cuiseurs, arrive la vague de sirop bouillant, qui coule le long des gouttières comme un fleuve blond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8882e137-f4a1-3702-9b75-0e8abcde19d4",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Rainure dissimulée permettant à l’eau de s’écouler autour des portières des automobiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d699cfbb-02e1-3134-8d50-cb6431029ce3",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Coupe creuse qu’on donne à la tranche du livre opposée au dos."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20df75f5-12f5-406d-81df-3dbb9b1863cf",
                                                "sense_id": "d699cfbb-02e1-3134-8d50-cb6431029ce3",
                                                "text": "Gouttière (Rel.). — C’est la tranche intérieure d’un volume relié ; elle affecte toujours la forme concave, par opposition au dos, qui est convexe, d’où son nom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a2f6d7-80ca-37e7-b491-288d3664d1bc",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Fentes ou raies creuses qui sont le long des bois de la tête du cerf, du chevreuil, etc.."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b23b940-9275-3e01-b19a-056da76e86dc",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Certains enfoncements que présentent les os."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baae1d58-b854-4f98-864f-5d182705298d",
                                                "sense_id": "5b23b940-9275-3e01-b19a-056da76e86dc",
                                                "text": "Les gouttières des malléoles."
                                            },
                                            {
                                                "example_id": "de279863-e126-4be6-921e-12dc80790610",
                                                "sense_id": "5b23b940-9275-3e01-b19a-056da76e86dc",
                                                "text": "La gouttière sagittale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1935b14-2b7d-3d71-96bf-e5f5c8607d30",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Appareil destiné à maintenir dans l’immobilité un membre brisé ou malade pendant le temps nécessaire à la guérison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae251de-f2e6-4e7c-a139-aad8dae4150b",
                                                "sense_id": "d1935b14-2b7d-3d71-96bf-e5f5c8607d30",
                                                "text": "Une jambe pendait, entourée d'un volumineux pansement, peut-être d'une gouttière comme on en place autour des membres cassés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8a1daa-84d7-39bf-8bb1-dbf7a97bc0bd",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Sorte de civière destinée à déplacer un malade ou un handicapé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2003f6c6-9fa5-4f0f-8741-6abf2cd1ae0f",
                                                "sense_id": "cb8a1daa-84d7-39bf-8bb1-dbf7a97bc0bd",
                                                "text": "Les porteurs prenaient les gouttières par les deux extrémités, les détachaient de leurs chariots et les portaient jusqu'aux wagons. Dans les wagons, il y avait des employés avec des casquettes, ils se courbaient, ils attrapaient les gouttières comme ils pouvaient et ils les emportaient dans les ténèbres. […] Charles voulut répondre mais sa gouttière bascula brusquement et il fut emporté dans les airs, la tête en bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1740f04-c3ab-3d58-a1c5-032198425232",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Certains enfoncements végétaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88bd654a-5bd8-49ae-aa91-3d2caec44a4d",
                                                "sense_id": "d1740f04-c3ab-3d58-a1c5-032198425232",
                                                "text": "Creusé en gouttière : Qui a sur sa longueur et d’un seul côté un demi-canal, une espèce de rainure."
                                            },
                                            {
                                                "example_id": "8177f0ba-1821-4ea4-a3c1-676b0f2f2b65",
                                                "sense_id": "d1740f04-c3ab-3d58-a1c5-032198425232",
                                                "text": "Pétiole creusé en gouttière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62808059-149a-38bc-a504-ad8cc4762c6c",
                                        "entry_id": "05a6cb09-837b-3736-a963-8d9fd11e1407",
                                        "glosses": [
                                            "Espace entre les poses."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ec6336-4165-4b31-9144-094aa7faf901",
                                                "sense_id": "62808059-149a-38bc-a504-ad8cc4762c6c",
                                                "text": "La largeur de gouttière correspondant à l’espace entre les colonnes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
