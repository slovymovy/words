                    ]
                },
                {
                    "sense_id": "4e8a8ce8-7795-3f09-81c4-1bdda23ef224",
                    "sense_definition": "Zone intermédiaire entre l'ombre totale et la pleine lumière créée lorsqu'une source lumineuse est partiellement occultée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "optique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant une éclipse partielle, la Terre traverse la <w>pénombre</w> projetée par la Lune."
                        },
                        {
                            "text": "Le télescope étudie le contraste lumineux au bord précis de la <w>pénombre</w> solaire."
                        }
                    ],
                    "common_phrases": [
                        "zone de pénombre"
                    ]
                },
                {
                    "sense_id": "6ef72ec9-f573-3d46-aac1-7efd647bfd24",
                    "sense_definition": "Situation d'une personne ou d'une œuvre tenue à l'écart de la notoriété ou de l'attention publique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "effacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré son rôle capital dans cette découverte, ce chercheur a toujours préféré rester dans la <w>pénombre</w>."
                        },
                        {
                            "text": "Cette romancière talentueuse est demeurée longtemps dans la <w>pénombre</w> avant d'obtenir une reconnaissance internationale."
                        }
                    ],
                    "synonyms": [
                        "oubli"
                    ],
                    "common_phrases": [
