                ],
                "senses": [
                    {
                        "sense_id": "a7573754-12d6-3ecd-8198-c7cf30df6eee",
                        "entry_id": "d9d8750d-dbbf-36d2-b6ed-cdd2aa50b26f",
                        "glosses": [
                            "zu würfel- oder quaderförmigen Stücken gepresster Zucker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c19ff43f-2a02-496c-b715-45542bfe1688",
                                "sense_id": "a7573754-12d6-3ecd-8198-c7cf30df6eee",
                                "text": "„Denkt an Sommer, an das Regnen von Sonnenstrahlen, an den türkischen Tee im Imbiss, dessen Zuckerwürfel, mit dem Löffel, zerdrückt wie Schnee wirkt, auf den man mit nackten Füßen tritt und beißt, wenn man mal Kind gewesen ist.“"
                            },
                            {
                                "example_id": "98036445-edeb-4c0c-a353-c0d316e10dbe",
                                "sense_id": "a7573754-12d6-3ecd-8198-c7cf30df6eee",
                                "text": "„Ein in Deutschland handelsüblicher Zuckerwürfel (Weißzucker) wiegt ca. 3 g, in der Schweiz ist ein Gewicht von ca. 4,4 g üblich.“"
                            },
                            {
                                "example_id": "f78d28c3-272f-437b-96c3-4b8193e52f2e",
                                "sense_id": "a7573754-12d6-3ecd-8198-c7cf30df6eee",
                                "text": "„Sie holte Milch aus dem Kühlschrank und stellte sie neben ein paar Zuckerwürfeln auf den Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
