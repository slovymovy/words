                                "sense_id": "01875f62-2963-3689-a4a4-95fbd0db644b",
                                "text": "Met een eetlepel eet je meestal soep"
                            },
                            {
                                "example_id": "02b76d17-0e95-46a9-a9d8-b680563571a4",
                                "sense_id": "01875f62-2963-3689-a4a4-95fbd0db644b",
                                "text": "Een eetlepel is groter dan een dessertlepel en kleiner dan een opscheplepel."
                            }
                        ]
                    },
                    {
                        "sense_id": "204325e7-530a-35ac-ba85-c32dd0618af6",
                        "entry_id": "78326a11-3aea-34f0-9ce9-58b35bef9537",
                        "glosses": [
