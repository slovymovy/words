                                    {
                                        "sense_id": "d7b1af7d-15d1-3107-b298-06483aa4b543",
                                        "entry_id": "ea1ba400-55ec-3124-afe4-571506e24f2a",
                                        "glosses": [
                                            "orientalische Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77eb630d-79a7-4f08-80ae-af6f21843470",
                                                "sense_id": "d7b1af7d-15d1-3107-b298-06483aa4b543",
                                                "text": "„Die Verfassung von 1982 atmet noch immer den autoritären Geist, in dem Kemal 1925 durch das sogenannte Hutgesetz den Fes, die traditionell \"osmanische\" Kopfbedeckung, abschaffte.“"
                                            },
                                            {
                                                "example_id": "7353a790-202d-404e-bb3a-83cf9e87aaf6",
                                                "sense_id": "d7b1af7d-15d1-3107-b298-06483aa4b543",
                                                "text": "„Sie trug nämlich eine Mütze, die wie ein Fes aussah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
