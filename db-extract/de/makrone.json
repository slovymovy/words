                                            "Alternative spelling of macaron."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "macaroon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "220b262e-281c-3bf3-a47a-2fccce9895b7",
                                        "entry_id": "ed343a49-0828-3858-9985-0ca4a0f9cc74",
                                        "glosses": [
                                            "A coarse, rude, low fellow."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e05c3bd-b661-46fa-b639-3b0063f648da",
                                                "sense_id": "220b262e-281c-3bf3-a47a-2fccce9895b7",
                                                "text": "Like a big wife, at sight of lothed meat,\nReady to travail; so I sigh and sweat,\nTo hear this macaroon talk on in vain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
