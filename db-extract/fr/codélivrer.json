                "senses": [
                    {
                        "sense_id": "06b717d1-c227-329d-b54d-c7e36723ab20",
                        "entry_id": "36e76744-dd2c-3557-9d5a-4ebc6f0107f5",
                        "glosses": [
                            "Délivrer (un diplôme, par exemple) en commun avec d’autres qui participent aussi à cette délivrance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6030b42f-6afe-40da-a0b7-3f197b31e283",
                                "sense_id": "06b717d1-c227-329d-b54d-c7e36723ab20",
                                "text": "Elles conduisent à différents diplômes d'état codélivrés par le Ministère de l'Agriculture, de l'Education Nationale et du Ministère de la Jeunesse et des Sports."
                            },
                            {
                                "example_id": "148f9421-4794-460d-a80d-f72480ba4b41",
                                "sense_id": "06b717d1-c227-329d-b54d-c7e36723ab20",
                                "text": "L'ENS Lyon allait, dans ces conditions, codélivrer le diplôme national de master."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7cad5c7-1c75-3197-9357-003b90fae88f",
                        "entry_id": "36e76744-dd2c-3557-9d5a-4ebc6f0107f5",
                        "glosses": [
                            "Délivrer en même temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
