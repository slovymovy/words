                                    {
                                        "sense_id": "bcb36450-75ab-3dc1-bef7-0605f50c685b",
                                        "entry_id": "8df066d4-f0e6-3169-8e27-58172615dea1",
                                        "glosses": [
                                            "Monarca soberano de un califato y, para el islam, de la umma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6753612-55f0-4b79-84a4-b4f2def0501d",
                                                "sense_id": "bcb36450-75ab-3dc1-bef7-0605f50c685b",
                                                "text": "Desde entonces, el califato que detentaban los Abbasíes fue ya una sombra. La independencia fue completa, cuando Abd al Rahmán III, en el año 929, se tituló califa y, por tanto, Príncipe de los creyentes y sucesor de Mahoma. El emirato quedó transformado en califato."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "califa",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8f856794-b305-3354-84ae-2627d9e153c7",
                                        "entry_id": "d0bf05df-d6ed-3d81-bedc-a24b6ce23e89",
                                        "glosses": [
                                            "Que posee un marcado apetito sexual."
                                        ],
                                        "tags": [
                                            "Chile",
                                            "colloquial",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e1cf42-875b-4d52-93d0-4f11c4262873",
                                                "sense_id": "8f856794-b305-3354-84ae-2627d9e153c7",
                                                "text": "Ni por todas las lucrecias del planetoide hay minocas que están dispuestas a mostrar sus presitas en la revista Playboy. Pa' que se haga una idea, una publicación gringa entregó un listado con todas las féminas más ricas de Hollywood le han dicho nones al conejo califa del vejete Hugh Hefner."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
