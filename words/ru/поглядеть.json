{
    "word_family": [
        "глядеть",
        "взглянуть",
        "выглядеть",
        "заглянуть",
        "оглянуться",
        "приглядеться",
        "разглядеть"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5d9d1ab-68ca-3b45-8b51-7caaf1f39408",
                    "sense_definition": "Направить взгляд на кого-либо или что-либо, увидеть на короткое время.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "зрение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я решил <w>поглядеть</w> в окно, чтобы узнать, какая там погода.",
                            "target_lang_translations": {
                                "it": "Ho deciso di <w>guardare</w> fuori dalla finestra per vedere che tempo fa."
                            }
                        },
                        {
                            "text": "Дай мне <w>поглядеть</w> на твою новую фотографию.",
                            "target_lang_translations": {
                                "it": "Lasciami <w>dare un'occhiata</w> alla tua nuova foto."
                            }
                        }
                    ],
                    "synonyms": [
                        "посмотреть"
                    ],
                    "common_phrases": [
                        "поглядеть в окно",
                        "поглядеть на часы"
                    ],
                    "target_lang_definitions": {
                        "it": "Dirigere lo sguardo verso qualcuno o qualcosa, vedere per un breve periodo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "guardare",
                                "target_lang_sense_clarification": "rivolgere lo sguardo verso qualcosa"
                            },
                            {
                                "target_lang_word": "dare un'occhiata",
                                "target_lang_sense_clarification": "guardare velocemente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "494fed42-f606-3eed-8352-440363996911",
                    "sense_definition": "Провести некоторое время, наблюдая за чем-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "зрение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед сном мы решили немного <w>поглядеть</w> на звёзды с балкона.",
                            "target_lang_translations": {
                                "it": "Prima di andare a letto abbiamo deciso di <w>guardare</w> un po' le stelle dal balcone."
                            }
                        },
                        {
                            "text": "Они остались <w>поглядеть</w> на выступление уличных музыкантов.",
                            "target_lang_translations": {
                                "it": "Sono rimasti a <w>vedere</w> l'esibizione degli artisti di strada."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поглядеть фильм"
                    ],
                    "target_lang_definitions": {
                        "it": "Trascorrere del tempo osservando qualcosa."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "guardare",
                                "target_lang_sense_clarification": "osservare un contenuto o uno spettacolo"
                            },
                            {
                                "target_lang_word": "vedere",
                                "target_lang_sense_clarification": "assistere a un evento o film"
                            }
                        ]
                    },
                    "synonyms": [
                        "посмотреть"
                    ]
                },
                {
                    "sense_id": "1f1e2de7-8b65-3c00-94fa-bcb7e2ed8f5b",
                    "sense_definition": "Присматривать за кем-либо или чем-либо, заботиться.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "забота",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Соседка попросила меня <w>поглядеть</w> за её кошкой, пока она в отпуске.",
                            "target_lang_translations": {
                                "it": "La vicina mi ha chiesto di <w>badare</w> al suo gatto mentre è in vacanza."
                            }
                        },
                        {
                            "text": "Нужно <w>поглядеть</w> за детьми, чтобы они не убежали далеко.",
                            "target_lang_translations": {
                                "it": "Bisogna <w>sorvegliare</w> i bambini affinché non si allontanino troppo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поглядеть за детьми"
                    ],
                    "target_lang_definitions": {
                        "it": "Prendersi cura di qualcuno o qualcosa, sorvegliare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "badare a",
                                "target_lang_sense_clarification": "prendersi cura di qualcuno"
                            },
                            {
                                "target_lang_word": "sorvegliare",
                                "target_lang_sense_clarification": "tenere d'occhio qualcuno"
                            }
                        ]
                    },
                    "synonyms": [
                        "присмотреть"
                    ]
                },
                {
                    "sense_id": "fe470109-9df8-3f6d-8289-0379caddcca7",
                    "sense_definition": "Подождать развития событий, чтобы принять решение.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ожидание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ситуация на рынке сложная, поэтому мы <w>поглядим</w>, как изменятся цены.",
                            "target_lang_translations": {
                                "it": "La situazione sul mercato è complessa, quindi <w>staremo a vedere</w> come cambieranno i prezzi."
                            }
                        },
                        {
                            "text": "Не спеши с выводами, <w>поглядим</w>, что он скажет завтра.",
                            "target_lang_translations": {
                                "it": "Non trarre conclusioni affrettate, <w>vedremo</w> cosa dirà domani."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Aspettare l'evolversi degli eventi prima di prendere una decisione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "stare a vedere",
                                "target_lang_sense_clarification": "attendere gli sviluppi"
                            },
                            {
                                "target_lang_word": "vedere",
                                "target_lang_sense_clarification": "aspettare per valutare la situazione"
                            }
                        ]
                    },
                    "synonyms": [
                        "посмотреть"
                    ]
                }
            ]
        }
    ]
}