                    {
                        "sense_id": "dc0ddd02-2f5f-3ba0-8519-32263d2cf8c1",
                        "entry_id": "c4737f66-3a37-3e0b-93ea-55c51831c9bc",
                        "glosses": [
                            "Qui culpabilise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fbf00b0-a749-4aa0-bd4b-b22319198cdc",
                                "sense_id": "dc0ddd02-2f5f-3ba0-8519-32263d2cf8c1",
                                "text": "L'attitude culpabilisante d'une certaine intelligentsia «accommodante» n'est d'ailleurs pas étrangère à ce phénomène inquiétant."
                            },
                            {
                                "example_id": "2f1252e1-45e4-4840-a27e-40985b0b7fda",
                                "sense_id": "dc0ddd02-2f5f-3ba0-8519-32263d2cf8c1",
                                "text": "« Ces troubles nous détruisent le moral, la santé et, désormais, le porte-monnaie. C’est d’autant plus culpabilisant. Et quand on culpabilise, on re-craque », déplore-t-il."
                            }
                        ]
                    }
