                    },
                    {
                        "translation_id": "44614da9-255c-4065-90e3-b24427aaf982",
                        "source_entry_id": "80267c7b-194c-3ac9-8354-4bede6bdd032",
                        "source_sense_id": "dadf5e4e-7c74-3e1a-96b8-53a36139877d",
                        "target_lang_word": "montgolfière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "montgolfière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d805a2a6-f0ed-3466-9089-5d4fa1ecdbca",
                                        "entry_id": "04e76911-d649-3819-9268-b5e4bb5fde87",
                                        "glosses": [
                                            "Aérostat gonflé à l’air chaud supportant une nacelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ef4d76-565d-4f29-871f-d36380ca230e",
                                                "sense_id": "d805a2a6-f0ed-3466-9089-5d4fa1ecdbca",
                                                "text": "Le vol record que vient de réaliser le CNES a en effet conduit une montgolfière infrarouge de 36 000 m3 (40 m de diamètre) portant une charge d'environ 50 kg à effectuer en deux mois un tour du monde dans l’hémisphère sud."
                                            },
                                            {
                                                "example_id": "de5c8fae-4bf1-4f23-8ac2-91869a954f37",
                                                "sense_id": "d805a2a6-f0ed-3466-9089-5d4fa1ecdbca",
                                                "text": "— Une société, c’est comme une montgolfière ; si tu veux que ça monte, il faut lâcher du lest."
                                            },
                                            {
                                                "example_id": "39a22f2d-a3c4-4a91-a95d-d5e4b8087189",
                                                "sense_id": "d805a2a6-f0ed-3466-9089-5d4fa1ecdbca",
                                                "text": "Ce dernier, âgé d’une soixantaine d’années, n’aurait pas supporté de voir la montgolfière voler au-dessus de son domicile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899cd8c3-629c-3162-95b9-5d80580fc523",
                                        "entry_id": "04e76911-d649-3819-9268-b5e4bb5fde87",
                                        "glosses": [
                                            "Meuble représentant l’aérostat du même nom dans les armoiries. À rapprocher de aéroplane, avion et ballon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce02f6d-bba4-4409-8491-5256c460967b",
                                                "sense_id": "899cd8c3-629c-3162-95b9-5d80580fc523",
                                                "text": "D’azur au sautoir estré d’argent, à la montgolfière de huit panneaux de gueules et d’or, d’où s’échappe une nuée aussi d’argent, brochant sur le sautoir et surmontée d’une fleur de lys aussi d’or, à une feuille de papier velin d’argent à dextre et à une gerbe de blé d’or à senestre, brochant sur la montgolfière, qui est de la commune de Davézieux de l’Ardèche",
                                                "translation": "→ voir illustration « armoiries avec une montgolfière »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
