                "senses": [
                    {
                        "sense_id": "20765625-7f4a-3c2f-9369-ad7691fbbe2e",
                        "entry_id": "3dbac4ea-e402-30cf-870e-43eac08564ea",
                        "glosses": [
                            "auf dem Kopf mittels eines Reifens befestigtes Gerät aus Kopfhörer und Mikrofon; Headset"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26fe6bbd-fd0c-4b24-a80c-d93656207ba7",
                                "sense_id": "20765625-7f4a-3c2f-9369-ad7691fbbe2e",
                                "text": "Sie müssen sich einen Kopfhörer aufsetzen, möglichst einen mit Mikrophon. Das Ganze genannt »Headset«, Sprechgarnitur18 oder gar Hörsprechgarnitur. (GoogleBooks-Korpus)"
                            },
                            {
                                "example_id": "a722d62e-f17e-4470-8768-1e0528ebbc67",
                                "sense_id": "20765625-7f4a-3c2f-9369-ad7691fbbe2e",
                                "text": "Er trug eine HörSprechGarnitur und konnte über eine abhörsichere Verbindung direkt mit Commander Dorph sprechen. (GoogleBooks-Korpus)"
                            },
                            {
                                "example_id": "3dbc2246-8827-4527-8f72-7faea8b6018d",
                                "sense_id": "20765625-7f4a-3c2f-9369-ad7691fbbe2e",
                                "text": "Dies kann z.B. durch einfaches Ausstecken der Hörsprechgarnitur und anschließender normaler Verwendung des Hand-Funkgerätes sichergestellt werden. (GoogleBooks-Korpus)"
                            },
                            {
                                "example_id": "c3fc3f5f-e706-416d-bfba-e0c7badb6f58",
                                "sense_id": "20765625-7f4a-3c2f-9369-ad7691fbbe2e",
                                "text": "Hörsprechgarnitur und Handmonophon (hier mit zusätzlichem Ohrhörer) sind seit Jahren verfügbares, sinnvolles und notwendiges Zubehör für Handfunkgeräte. (GoogleBooks-Korpus)"
                            },
                            {
                                "example_id": "ff9249bd-8ef9-4fd5-b4bc-0d59ee75a18a",
                                "sense_id": "20765625-7f4a-3c2f-9369-ad7691fbbe2e",
                                "text": "Dolmetschermikrofone sind entweder am Kopfhörer befestigt (Hörsprechgarnitur) oder als Tischmikrofone ausgeführt. Hörsprechgamituren sind vorzuziehen, weil sie dem Dolmetscher Bewegungsfreiheit lassen und dem Zuhörer einen gleichmäßigen Ton ohne Verfärbungen oder Pegelschwankungen garantieren. (GoogleBooks-Korpus)"
                            },
                            {
                                "example_id": "caee28e3-bb3f-49c4-a916-38a59856b471",
                                "sense_id": "20765625-7f4a-3c2f-9369-ad7691fbbe2e",
                                "text": "Derzeit sind bei der GSG 9 Systeme in Entwicklung, die ein unmittelbares, störungsfreies Ansprechen der Präzisionsschützen ermöglichen sollen (Hörsprechgarnitur mit Quittungstaste). (GoogleBooks-Korpus)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
