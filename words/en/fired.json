                {
                    "sense_id": "f133bf59-1e27-3aa7-ad86-551919cd2427",
                    "sense_definition": "Simple past and past participle of <w>fire</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer <w>fired</w> a warning shot into the air to stop the suspect.",
                            "target_lang_translations": {
                                "ru": "Полицейский <w>выстрелил</w> в воздух предупредительным выстрелом, чтобы остановить подозреваемого.",
                                "pl": "Policjant <w>oddał</w> strzał ostrzegawczy w powietrze, aby zatrzymać podejrzanego."
                            }
                        },
                        {
                            "text": "She <w>fired</w> off a quick email to her boss before leaving the office.",
                            "target_lang_translations": {
                                "ru": "Она быстро <w>отправила</w> электронное письмо своему начальнику перед уходом из офиса.",
                                "pl": "Szybko <w>wysłała</w> e-mail do szefa przed wyjściem z biura."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fired a gun",
                        "fired at",
                        "fired up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола fire.",
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika fire."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выстрелил",
                                "target_lang_sense_clarification": "произвел выстрел"
                            },
                            {
                                "target_lang_word": "уволил",
                                "target_lang_sense_clarification": "отстранил от работы"
                            },
                            {
                                "target_lang_word": "обжег",
                                "target_lang_sense_clarification": "обработал огнем"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wystrzelił",
                                "target_lang_sense_clarification": "o broni palnej"
                            },
                            {
                                "target_lang_word": "zwolnił",
                                "target_lang_sense_clarification": "z pracy"
                            },
                            {
                                "target_lang_word": "posłał",
                                "target_lang_sense_clarification": "o wiadomości lub spojrzeniu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5f0f417-8840-3135-b52a-7482f941877f",
                    "sense_definition": "Dismissed or terminated from employment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "employment_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>fired</w> from his job last week because he was always late.",
                            "target_lang_translations": {
                                "ru": "Его <w>уволили</w> с работы на прошлой неделе, потому что он всегда опаздывал.",
                                "pl": "Został <w>zwolniony</w> z pracy w zeszłym tygodniu, ponieważ zawsze się spóźniał."
                            }
                        },
                        {
                            "text": "She is worried that she might get <w>fired</w> due to the recent budget cuts.",
                            "target_lang_translations": {
                                "ru": "Она переживает, что её могут <w>уволить</w> из-за недавних сокращений бюджета.",
                                "pl": "Martwi się, że może zostać <w>zwolniona</w> z powodu ostatnich cięć budżetowych."
                            }
                        }
                    ],
                    "synonyms": [
                        "dismissed",
                        "sacked",
                        "terminated",
                        "let go"
                    ],
                    "antonyms": [
                        "hired",
                        "employed",
                        "recruited"
                    ],
                    "common_phrases": [
                        "get fired",
                        "be fired",
                        "fired from a job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уволенный или отстраненный от работы.",
                        "pl": "Zwolniony z pracy lub usunięty ze stanowiska."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уволенный",
                                "target_lang_sense_clarification": "лишенный работы"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zwolniony",
                                "target_lang_sense_clarification": "z pracy"
                            },
                            {
                                "target_lang_word": "wylany",
                                "target_lang_sense_clarification": "potocznie o zwolnieniu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd31f1fa-bd09-318f-b4ec-5e02ba73094c",
                    "sense_definition": "Heated in a furnace or kiln to become permanently hardened.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fired</w> clay pot is much more durable than the one that is still drying.",
                            "target_lang_translations": {
                                "ru": "<w>Обожженный</w> глиняный горшок гораздо прочнее того, который еще сохнет.",
                                "pl": "<w>Wypalony</w> gliniany garniec jest znacznie trwalszy niż ten, który wciąż schnie."
                            }
                        },
                        {
                            "text": "Builders used <w>fired</w> bricks for the wall to ensure it could withstand the weather.",
                            "target_lang_translations": {
                                "ru": "Строители использовали <w>обожженный</w> кирпич для стены, чтобы гарантировать, что она выдержит погодные условия.",
                                "pl": "Budowniczowie użyli <w>wypalanych</w> cegieł do budowy ściany, aby zapewnić jej odporność na warunki pogodowe."
                            }
                        }
                    ],
                    "synonyms": [
                        "baked",
                        "hardened"
                    ],
                    "antonyms": [
                        "unfired"
                    ],
                    "common_phrases": [
                        "fired clay",
                        "fired brick",
                        "fired pottery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергнутый обжигу в печи для затвердевания.",
                        "pl": "Poddany działaniu wysokiej temperatury w piecu w celu utwardzenia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обожженный",
                                "target_lang_sense_clarification": "о глине или кирпиче"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wypalany",
                                "target_lang_sense_clarification": "o ceramice lub cegle"
                            },
                            {
                                "target_lang_word": "wypalony",
                                "target_lang_sense_clarification": "o gotowym produkcie ceramicznym"
                            }
                        ]
                    }
                }
            ]
        }
