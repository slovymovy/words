                                    {
                                        "sense_id": "d5b877b8-c965-3fe9-ab3a-1789ff0a3fc7",
                                        "entry_id": "44879842-9b71-3986-becd-9926e1ac19bb",
                                        "glosses": [
                                            "книжн. религ. (иудаизм, христианство) религиозное учение о грядущем пришествии в мир Божьего посланца (мессии), призванного установить справедливость на Земле"
                                        ],
