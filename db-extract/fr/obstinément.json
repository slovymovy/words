        "fr-extract.jsonl": [
            {
                "entry_id": "66a8e28d-ae98-3def-aa8c-c1992f1f0a8e",
                "word": "obstinément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                        "entry_id": "66a8e28d-ae98-3def-aa8c-c1992f1f0a8e",
                        "glosses": [
                            "Avec obstination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4afccc-d60e-4fa8-a425-e41859a43e62",
                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                "text": "Sa femme s’étant obstinément refusée à céder à ses injonctions, il se résigna de fort méchante humeur à vaquer à ses travaux quotidiens dans la ferme ; […]."
                            },
                            {
                                "example_id": "ea7eb16f-ef17-4ffb-b25d-acda6da6feb1",
                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                "text": "Et bien que tout mon cœur obstinément se donne, Ma raison n'ose me donner."
                            },
                            {
                                "example_id": "dcd9695b-b836-4d9b-aea2-d6e7038621f8",
                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                "text": "J'ai beau la conjurer de montrer son visage ; Ma prière au refus obstinément l’engage."
                            },
                            {
                                "example_id": "b387e8db-a3ac-4649-a43a-06ba3c41ff7c",
                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                "text": "Après m’avoir obstinément refusé quand je l’en pressais devant sa maîtresse."
                            },
                            {
                                "example_id": "d3ca5658-68bf-40b8-9ba3-7ed26778466d",
                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                "text": "Si je parvins à mes fins pour le jeûne, elle refusa obstinément que je déroge aux classes de catéchisme, convaincue que la science de Dieu est plus nécessaire encore que celle du collège."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8f72b3c-7f91-433c-85cb-6f75db226738",
                        "source_entry_id": "66a8e28d-ae98-3def-aa8c-c1992f1f0a8e",
                        "source_sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                        "target_lang_word": "obstinately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cde3a47a-5121-306f-b048-69ce3f6248f8",
                                        "entry_id": "6bdc2688-922e-371a-be99-61ff5d5b0269",
                                        "glosses": [
                                            "In an obstinate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "889f7cbb-6c63-412a-9ec4-861ba53beb88",
                                                "sense_id": "cde3a47a-5121-306f-b048-69ce3f6248f8",
                                                "text": "He obstinately made his motion at every meeting, even though no one else ever supported it and everyone else was bored with it."
                                            },
                                            {
                                                "example_id": "24986585-c1f7-4ee7-b45e-6665a0f17037",
                                                "sense_id": "cde3a47a-5121-306f-b048-69ce3f6248f8",
                                                "text": "'She'll do no such thing,' said the old man obstinately."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1818e814-cb33-4c03-b45b-737b80bf2d99",
                        "source_entry_id": "66a8e28d-ae98-3def-aa8c-c1992f1f0a8e",
                        "source_sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                        "target_lang_word": "persistently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persistently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d00633d9-28c1-3bd3-96f7-cc4b9d6ce6ae",
                                        "entry_id": "e9112d1c-9901-34a0-a648-1e798483773e",
                                        "glosses": [
                                            "In a persistent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e67a906-7cef-4638-9b52-c2810fb6d4de",
                                                "sense_id": "d00633d9-28c1-3bd3-96f7-cc4b9d6ce6ae",
                                                "text": "The small girl persistently asked her father to buy her the doll."
                                            },
                                            {
                                                "example_id": "251da8f6-1cb7-4589-a9a7-6dd193bbe37e",
                                                "sense_id": "d00633d9-28c1-3bd3-96f7-cc4b9d6ce6ae",
                                                "text": "One of the most persistently held beliefs about sharks is that they have to stay in motion to stay alive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41bb7d65-9114-4e71-87cc-6f5926e807c4",
                        "source_entry_id": "66a8e28d-ae98-3def-aa8c-c1992f1f0a8e",
                        "source_sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                        "target_lang_word": "doggedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doggedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                        "entry_id": "61396804-290c-3f1e-944c-859b4d666f90",
                                        "glosses": [
                                            "In a way that is stubbornly persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f10c33-6921-41d7-8494-2df1cd31fb9d",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "I grew moody, silent, and unsocial, but studied on doggedly and incessantly."
                                            },
                                            {
                                                "example_id": "1fdaa2dc-9974-41b6-8c8f-41f3210d4791",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "I continued to pound along doggedly. I was grimly resolute."
                                            },
                                            {
                                                "example_id": "2ede5bba-7401-4265-a100-cedf91001c23",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "She was married to someone.\nHe was doggedly determined he would get her."
                                            },
                                            {
                                                "example_id": "8f828a23-7171-47e5-9ec1-2bff193bce2e",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "Unemployment hovered doggedly near 10%."
                                            },
                                            {
                                                "example_id": "5256124d-ee34-48ca-b5ed-cc82373edd4c",
                                                "sense_id": "566d22fa-0eba-397e-8b5b-fd30fd155a41",
                                                "text": "The announcement was made in Leeds - the largest city in Europe without a mass transit system. It's also a city which has been doggedly pressing (to little avail) for an integrated transport system for two decades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bc03559-6499-37c3-822b-e8a06bc29797",
                                        "entry_id": "61396804-290c-3f1e-944c-859b4d666f90",
                                        "glosses": [
                                            "sullenly, gloomily"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2fb4b86-f899-486d-8bdf-7f97a4f8eed2",
                                                "sense_id": "8bc03559-6499-37c3-822b-e8a06bc29797",
                                                "text": "'Nay,' said Dr Johnson, 'a man may write at any time, if he will set himself DOGGEDLY to it.' [Footnote: This word is commonly used to signify sullenly, gloomily and in that sense alone it appears in Dr Johnson's Dictionary. I suppose he meant by it 'with an OBSTINATE RESOLUTION, similar to that of a sullen man'.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
