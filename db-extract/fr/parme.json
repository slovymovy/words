                        "examples": [
                            {
                                "example_id": "a70098c5-1137-40ac-9ad3-29784629968e",
                                "sense_id": "3847a398-2193-33c6-a291-f7a0c83d84f5",
                                "text": "Mousseline de soie parme."
                            },
                            {
                                "example_id": "e1bf94f9-541a-41fa-823a-297c6825eeff",
                                "sense_id": "3847a398-2193-33c6-a291-f7a0c83d84f5",
                                "text": "Toile de soie rose, corail, […] parme."
                            },
                            {
                                "example_id": "ee59b1ea-84bb-4c59-86af-317f729acdee",
                                "sense_id": "3847a398-2193-33c6-a291-f7a0c83d84f5",
                                "text": "J'avais beau marcher pieds nus, fumer des Vogue multicolores, me parfumer au patchouli, porter des robes parme sous des gilets fuchsia et des bracelets autour des chevilles, rien n'y faisait : Léa grandissait plus vite que moi."
                            }
                        ]
                    }
