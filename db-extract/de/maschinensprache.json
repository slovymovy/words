                "senses": [
                    {
                        "sense_id": "5868e70a-eff0-317c-ba71-b2c4fb6ee7fc",
                        "entry_id": "2d0ecffb-88d3-3a36-916e-7202430963f3",
                        "glosses": [
                            "native Befehlssprache eines Prozessors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6978e543-f7b0-4fc5-b663-30c7f04916a9",
                                "sense_id": "5868e70a-eff0-317c-ba71-b2c4fb6ee7fc",
                                "text": "Maschinensprachen sind im Binärcode verfasst und werden vom Prozessor des Rechners verwendet."
                            },
                            {
                                "example_id": "2ac47651-8481-4000-a84a-183eac897c67",
                                "sense_id": "5868e70a-eff0-317c-ba71-b2c4fb6ee7fc",
                                "text": "„Quellcode, der das .Net-Framework verwendet, wird üblicherweise erst in eine Zwischensprache übersetzt, dann mit Hilfe der Common Language Runtime (CLR) in Maschinensprache übertragen und ausgeführt.“"
                            },
                            {
                                "example_id": "93ed6306-1ab2-4f94-a744-1af1f31d552e",
                                "sense_id": "5868e70a-eff0-317c-ba71-b2c4fb6ee7fc",
                                "text": "„Ihr Vater entwickelte für den Selective Sequence Electronic Calculator von IBM Programme zur Berechnung der Mondbahn und erfand zusammen mit Harlan Herrick Speedcoding, das Programmierer von der Notwendigkeit befreite, in der Maschinensprache des Computers zu programmieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61d5c2ca-f10c-4596-ab80-391e3c23b45a",
                        "source_entry_id": "2d0ecffb-88d3-3a36-916e-7202430963f3",
                        "source_sense_id": "5868e70a-eff0-317c-ba71-b2c4fb6ee7fc",
                        "source_sense_description": "Informatik: native Befehlssprache eines Prozessors",
                        "target_lang_word": "machine language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b86277fa-174c-3410-9b7e-c8319c8957f3",
                                        "entry_id": "8e646cce-3f74-36bf-883e-ed07dff144da",
                                        "glosses": [
                                            "The set of instructions that a particular computer is designed to execute; generated from an assembly language by an assembler, or from a high-level language by a compiler or interpreter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90a5a7c8-d518-476d-85ed-054ad9b69d06",
                                                "sense_id": "b86277fa-174c-3410-9b7e-c8319c8957f3",
                                                "text": "Machine language is certainly the most efficient language on the Apple, albeit the least pleasant in which to code. The Monitor has special facilities for those of you who are determined to use machine language to simplify creating, writing, and debugging machine language programs."
                                            },
                                            {
                                                "example_id": "63f4643d-73b4-4c2f-974f-a7bbba72273d",
                                                "sense_id": "b86277fa-174c-3410-9b7e-c8319c8957f3",
                                                "text": "Though machine language is efficient for computers, it is inefficient for programmers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbf91c0d-d7ca-477e-8727-01b2d0190247",
                        "source_entry_id": "2d0ecffb-88d3-3a36-916e-7202430963f3",
                        "source_sense_id": "5868e70a-eff0-317c-ba71-b2c4fb6ee7fc",
