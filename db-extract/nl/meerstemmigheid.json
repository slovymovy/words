        "nl-extract.jsonl": [
            {
                "entry_id": "5207b58f-ae1f-3e8b-b2ce-5ecd9c049333",
                "word": "meerstemmigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "243ed12d-0129-3c17-b5a4-27d76cf4b102",
                        "entry_id": "5207b58f-ae1f-3e8b-b2ce-5ecd9c049333",
                        "glosses": [
                            "een muziekstuk waarin meerdere stemmen verschillende tonen produceren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de884ad6-d52e-44f6-a24a-0f7c49d90893",
                                "sense_id": "243ed12d-0129-3c17-b5a4-27d76cf4b102",
                                "text": "Een kerkkoortje, dat achter een soort kamerscherm staat, zingt hemelse gezangen, die mooi zijn in hun meerstemmigheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "12c8418e-1668-3821-b180-1e85ce052309",
                        "entry_id": "5207b58f-ae1f-3e8b-b2ce-5ecd9c049333",
                        "glosses": [
                            "met meerdere standpunten; vanuit meerdere gezichtspunten"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4c367338-2a9e-455a-938b-dfab24767a87",
                                "sense_id": "12c8418e-1668-3821-b180-1e85ce052309",
                                "text": "Op de shortlist staan volgens de jury titels die - 'zelfs na twee, drie of vier keer lezen' - bleven verrassen: \"Verhalen met een eigen blik, een ziel, een stem en soms meerstemmigheid, verhalen van schrijvers die weten wat ze doen, wat ze de lezer aandoen - of dat onderzoeken\"."
                            },
                            {
                                "example_id": "2dd843e8-4429-4d71-a8fc-437afd4204e0",
                                "sense_id": "12c8418e-1668-3821-b180-1e85ce052309",
                                "text": "\"Meerstemmigheid was het vertrekpunt van de tentoonstelling. We wilden vanaf het begin kijken wat er al heel vaak is getoond en wat nu juist een nieuwe plek verdient. Zo kunnen we een rijker en meer volledig verhaal vertellen.\""
                            }
                        ]
                    }
                ],
