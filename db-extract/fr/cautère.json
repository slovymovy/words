                    {
                        "sense_id": "d5b92917-1cdd-36dd-a48b-ffb2115398d1",
                        "entry_id": "321722f2-a4f3-3526-936f-76875fb1f00f",
                        "glosses": [
                            "Instrument qui sert à brûler les tissus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a66dcda-650d-46bc-ae6b-49477ad8c7ea",
                                "sense_id": "d5b92917-1cdd-36dd-a48b-ffb2115398d1",
                                "text": "Et dès l’incision, il arrêta le saignement avec un cautère rougi."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fc103f3-3e58-3549-b3ca-a54738d3d6b0",
                        "entry_id": "321722f2-a4f3-3526-936f-76875fb1f00f",
                        "glosses": [
                            "Ulcération artificielle que l’on provoque à l’aide d’un caustique pour entretenir la suppuration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03521758-ff0a-44c4-bf23-6d01b66eb4b6",
                                "sense_id": "6fc103f3-3e58-3549-b3ca-a54738d3d6b0",
                                "text": "Panser un cautère. Laisser fermer un cautère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74a7ba2b-3288-4947-9682-03e7d841a30e",
                        "source_entry_id": "321722f2-a4f3-3526-936f-76875fb1f00f",
                        "source_sense_description": "instrument qui sert à bruler les tissus",
                        "target_lang_word": "Kauter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kauter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbbca73-e633-38a9-b595-c6976e54e558",
                                        "entry_id": "5608ea18-1b1b-38a8-95f4-91cc5ac5c7a4",
                                        "glosses": [
                                            "chirurgisches Instrument zur Zerstörung von Gewebe, zum Schneiden von Tumoren und zur Verödung oder Blutstillung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6317030c-b781-4297-a7ee-5633ea9689e2",
                                                "sense_id": "cbbbca73-e633-38a9-b595-c6976e54e558",
                                                "text": "Im Wesentlichen dient der Kauter während einer Operation zur Blutstillung oder zum Schneiden."
                                            },
                                            {
                                                "example_id": "b3753fe0-7087-4cad-ab27-a00531c13130",
                                                "sense_id": "cbbbca73-e633-38a9-b595-c6976e54e558",
                                                "text": "Der Kauter wird auch zum Entfernen von Zahnfleisch benutzt."
                                            },
                                            {
                                                "example_id": "04171ca9-8e7e-4278-adc0-ea8d68b27a4f",
                                                "sense_id": "cbbbca73-e633-38a9-b595-c6976e54e558",
                                                "text": "Insbesondere vor Abschluß der Operation soll ein Wechsel von Kauter und Optik vorgenommen werden."
                                            },
                                            {
                                                "example_id": "4b448fa1-64e3-42be-b58c-ac7ff996beeb",
                                                "sense_id": "cbbbca73-e633-38a9-b595-c6976e54e558",
                                                "text": "Liegen Muscheln und Scheidewand ganz an einander oder finden sich Leisten, welche mit der Muschel für gewöhnlich in Berührung sind, so nehme ich den gedeckten Kauter (Fig. 56)."
                                            },
                                            {
                                                "example_id": "cd1a28ba-93de-47d1-96c6-09b8496e8bd0",
                                                "sense_id": "cbbbca73-e633-38a9-b595-c6976e54e558",
                                                "text": "Ohne vorausgegangene Skleralpunktion mit dem Messer nicht ratsam, ist es mit dem glühenden Kauter durch die Sklera einzudringen, da man hierbei die äußere Bulbushülle zu stark verletzt; …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
