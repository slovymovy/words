                "senses": [
                    {
                        "sense_id": "7a231e76-51bc-3538-961f-0a27613ae3a3",
                        "entry_id": "ce127b6c-8931-3b20-9132-a3fa628b9151",
                        "glosses": [
                            "The quality of being unpredictable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ec563d6-1e8d-46b3-aa67-c25402529424",
                                "sense_id": "7a231e76-51bc-3538-961f-0a27613ae3a3",
                                "text": "The unpredictability of Gemini was then contrasted with examples of human spontaneity, like the splatter technique of Jackson Pollock."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa7ffa66-abe0-33c9-b6e6-c60a474b22cc",
                        "entry_id": "ce127b6c-8931-3b20-9132-a3fa628b9151",
