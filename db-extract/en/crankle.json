                                                "example_id": "d68d00f9-d604-49d6-becb-f0a7830e0812",
                                                "sense_id": "a8caa026-f652-3ad2-a18e-916ada1ac026",
                                                "text": "Die verbogene Stoßstange mindert den Wert des Wagens."
