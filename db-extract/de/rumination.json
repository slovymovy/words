                ],
                "senses": [
                    {
                        "sense_id": "7bfa4913-5ac4-3b57-8067-644a2dfaf10d",
                        "entry_id": "a86b4799-907f-38f6-b349-6e727a5377e1",
                        "glosses": [
                            "das Wiederkäuen; vorverdaute Nahrung wird bei Wiederkäuern wieder hochgewürgt und erst nach erneutem Kauen und Verschlucken verdaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a6a4a6b-b7ef-4a25-a2eb-e52b740bed16",
                                "sense_id": "7bfa4913-5ac4-3b57-8067-644a2dfaf10d",
                                "text": "Es stellte sich auch wieder Rumination ein und die Kuh gab nun wieder 4 — 5 Liter Milch pro Tag."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8c1c315-32f3-3fca-8744-2a8aeff2ebae",
                        "entry_id": "a86b4799-907f-38f6-b349-6e727a5377e1",
                        "glosses": [
                            "Essstörung; wiederholtes Zurücktreten von Nahrung aus dem Magen in den Mund und erneutes Verschlucken (ohne vorliegende Übelkeit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e861e019-6a8e-4184-a855-a2097798815b",
                                "sense_id": "c8c1c315-32f3-3fca-8744-2a8aeff2ebae",
                                "text": "Rumination, das grundlose Heraufwürgen von Nahrung, ist typischerweise nicht von Unruhegefühlen begleitet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bb6f3241-f6c1-34d2-8944-c96a91dc1f15",
                        "entry_id": "a86b4799-907f-38f6-b349-6e727a5377e1",
                        "glosses": [
                            "Neigung zum Grübeln, inneres Nachbearbeiten, oft prolongiert/zirkulär/nicht zielgerichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d56262f7-125c-4da9-9a51-d35c76b02290",
                                "sense_id": "bb6f3241-f6c1-34d2-8944-c96a91dc1f15",
                                "text": "„Gegen die täglichen Hudeleien, kleinlichen Reibungen im menschlichen Verkehr, unbedeutende Anstöße, Ungebührlichkeiten anderer, Klatschereien u. dgl. m. muß man ein gehörnter Siegfried sein, d. h. sie gar nicht empfinden, weit weniger sich zu Herzen nehmen und darüber brüten; sondern von dem allen nichts an sich kommen lassen, es von sich stoßen, wie Steinchen, die im Wege liegen, und keineswegs es aufnehmen in das Innere seiner Überlegung und Rumination.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "a8752af4-482e-3580-9688-4d5f81304af3",
                        "entry_id": "a86b4799-907f-38f6-b349-6e727a5377e1",
                        "glosses": [
                            "reifliches Nachdenken, philosophisches Grübeln, sozusagen gedankliches Wiederkäuen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"4\""
                    }
                ],
