{
    "word_family": [
        "steamer",
        "steamy",
        "steamship",
        "steamboat",
        "steamroller"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea35c40a-6197-3af3-9abc-fa1e60959e09",
                    "sense_definition": "The hot gas that is produced when water boils.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to burn your hand on the hot <w>steam</w> from the kettle.",
                            "target_lang_translations": {
                                "ru": "Осторожно, не обожги руку горячим <w>паром</w> из чайника."
                            }
                        },
                        {
                            "text": "The engine converts water into high-pressure <w>steam</w> to generate electricity.",
                            "target_lang_translations": {
                                "ru": "Двигатель превращает воду в <w>пар</w> высокого давления для выработки электроэнергии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hot steam",
                        "water and steam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горячий газ, образующийся при кипении воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пар",
                                "target_lang_sense_clarification": "водяной пар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "801533ae-c127-3d9b-a0a6-dde78b92d34e",
                    "sense_definition": "The visible white mist or cloud that forms when hot water vapour meets cold air.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bathroom mirror was covered in <w>steam</w> after his long, hot shower.",
                            "target_lang_translations": {
                                "ru": "Зеркало в ванной <w>запотело</w> после его долгого горячего душа."
                            }
                        },
                        {
                            "text": "You could see your breath turn to <w>steam</w> in the freezing winter air.",
                            "target_lang_translations": {
                                "ru": "Можно было видеть, как дыхание превращается в <w>пар</w> на морозном зимнем воздухе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloud of steam",
                        "through the steam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Видимый белый туман или облако, образующееся при контакте горячего водяного пара с холодным воздухом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пар",
                                "target_lang_sense_clarification": "видимое испарение"
                            },
                            {
                                "target_lang_word": "испарение",
                                "target_lang_sense_clarification": "выделяющийся пар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c65d125-5925-36b9-86bf-ce4f471b1abd",
                    "sense_definition": "Power or energy produced by pressurized water vapour, used to operate engines and machines.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "power_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The industrial revolution was driven by the invention of <w>steam</w> power.",
                            "target_lang_translations": {
                                "ru": "Промышленная революция была вызвана изобретением <w>паровой</w> энергии."
                            }
                        },
                        {
                            "text": "Old locomotives used coal fires to generate the <w>steam</w> needed to move the train.",
                            "target_lang_translations": {
                                "ru": "Старые локомотивы использовали уголь для выработки <w>пара</w>, необходимого для движения поезда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steam engine",
                        "steam power",
                        "steam locomotive",
                        "full steam ahead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощность или энергия, вырабатываемая сжатым водяным паром и используемая для работы двигателей и машин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пар",
                                "target_lang_sense_clarification": "как источник энергии"
                            },
                            {
                                "target_lang_word": "паровая энергия",
                                "target_lang_sense_clarification": "энергия пара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ba21a7c-f34f-3863-985e-572c85e8f455",
                    "sense_definition": "Momentum, energy, or force required to continue an action or achieve a goal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The campaign started well but ran out of <w>steam</w> before the election day.",
                            "target_lang_translations": {
                                "ru": "Кампания началась хорошо, но <w>выдохлась</w> еще до дня выборов."
                            }
                        },
                        {
                            "text": "She managed to finish the difficult project under her own <w>steam</w> without any help.",
                            "target_lang_translations": {
                                "ru": "Ей удалось закончить сложный проект <w>своими силами</w> без какой-либо помощи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "run out of steam",
                        "pick up steam",
                        "under one's own steam",
                        "gather steam"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in idioms"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Импульс, энергия или сила, необходимые для продолжения действия или достижения цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "энергия",
                                "target_lang_sense_clarification": "внутренний запал"
                            },
                            {
                                "target_lang_word": "силы",
                                "target_lang_sense_clarification": "способность продолжать"
                            },
                            {
                                "target_lang_word": "обороты",
                                "target_lang_sense_clarification": "темп или импульс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e5fca3c-4074-3804-81ba-051e8a26bea3",
                    "sense_definition": "Pent-up anger, stress, or energy that needs to be released.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went for a long run to blow off some <w>steam</w> after the argument.",
                            "target_lang_translations": {
                                "ru": "Он отправился на долгую пробежку, чтобы <w>выпустить пар</w> после ссоры."
                            }
                        },
                        {
                            "text": "It is better to talk about your problems than to let the <w>steam</w> build up inside.",
                            "target_lang_translations": {
                                "ru": "Лучше говорить о своих проблемах, чем позволять <w>гневу</w> копиться внутри."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blow off steam",
                        "let off steam"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mostly used in the phrase 'blow off steam' or 'let off steam'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдерживаемый гнев, стресс или энергия, требующие выхода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пар",
                                "target_lang_sense_clarification": "в переносном смысле (выпустить пар)"
                            },
                            {
                                "target_lang_word": "гнев",
                                "target_lang_sense_clarification": "сильное возмущение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d735d2-ebf0-33f1-96c4-4afd0c273bde",
                    "sense_definition": "A vehicle, such as a ship or train, that is powered by a steam engine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Travel by <w>steam</w> was the primary method of long-distance transport in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Путешествие на <w>пароходах</w> и паровозах было основным способом передвижения на большие расстояния в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "The museum preserves the history of <w>steam</w> and its impact on global trade.",
                            "target_lang_translations": {
                                "ru": "Музей хранит историю <w>парового транспорта</w> и его влияния на мировую торговлю."
                            }
                        }
                    ],
                    "synonyms": [
                        "steamer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство, такое как корабль или поезд, приводимое в движение паровым двигателем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пароход",
                                "target_lang_sense_clarification": "судно"
                            },
                            {
                                "target_lang_word": "паровоз",
                                "target_lang_sense_clarification": "локомотив"
                            },
                            {
                                "target_lang_word": "паровая тяга",
                                "target_lang_sense_clarification": "способ передвижения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76464f29-b8b3-337a-9399-555cea361813",
                    "sense_definition": "To cook food by placing it over boiling water so that it is cooked by the hot vapour.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is much healthier to <w>steam</w> the vegetables than to fry them in oil.",
                            "target_lang_translations": {
                                "ru": "Гораздо полезнее <w>готовить</w> овощи <w>на пару</w>, чем жарить их в масле."
                            }
                        },
                        {
                            "text": "We decided to <w>steam</w> the fish with some lemon and herbs for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>приготовить</w> рыбу <w>на пару</w> с лимоном и травами на ужин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steam vegetables",
                        "steam rice",
                        "lightly steam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить пищу, помещая ее над кипящей водой, чтобы она готовилась под воздействием горячего пара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовить на пару",
                                "target_lang_sense_clarification": "способ приготовления"
                            },
                            {
                                "target_lang_word": "пропаривать",
                                "target_lang_sense_clarification": "обрабатывать паром"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546330b2-0a35-333d-b948-3496ed1c972e",
                    "sense_definition": "To become covered with a thin layer of condensed water droplets, usually blocking vision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car windows began to <w>steam</w> up as soon as we got inside out of the rain.",
                            "target_lang_translations": {
                                "ru": "Окна в машине начали <w>запотевать</w>, как только мы зашли внутрь с дождя."
                            }
                        },
                        {
                            "text": "My glasses always <w>steam</w> when I walk into a warm building from the cold.",
                            "target_lang_translations": {
                                "ru": "Мои очки всегда <w>запотевают</w>, когда я захожу в теплое здание с холода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steam up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться тонким слоем сконденсированных капель воды, обычно ограничивая видимость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запотевать",
                                "target_lang_sense_clarification": "о стеклах или зеркалах"
                            },
                            {
                                "target_lang_word": "покрываться паром",
                                "target_lang_sense_clarification": "о поверхностях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93b5c6bc-c839-3b92-ad12-f04a46614bec",
                    "sense_definition": "To produce or give off hot water vapour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot mug of coffee continued to <w>steam</w> on the cold table.",
                            "target_lang_translations": {
                                "ru": "Горячая кружка кофе продолжала <w>парить</w> на холодном столе."
                            }
                        },
                        {
                            "text": "We could see the horses <w>steam</w> in the chilly morning air after their run.",
                            "target_lang_translations": {
                                "ru": "Мы видели, как лошади <w>парят</w> на прохладном утреннем воздухе после бега."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять или испускать горячий водяной пар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "испускать пар"
                            },
                            {
                                "target_lang_word": "дымиться",
                                "target_lang_sense_clarification": "о горячей еде или напитках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e3d212-870b-36c6-abfd-0423f4d0c2ad",
                    "sense_definition": "To move forward quickly, forcefully, or with great determination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large ship began to <w>steam</w> out of the harbour towards the open sea.",
                            "target_lang_translations": {
                                "ru": "Большой корабль начал <w>выходить</w> из гавани в открытое море."
                            }
                        },
                        {
                            "text": "He decided to <w>steam</w> ahead with the new business plan despite the risks.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>двигаться вперед</w> с новым бизнес-планом, несмотря на риски."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steam ahead",
                        "steam in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться вперед быстро, решительно или с большой силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "быстро двигаться"
                            },
                            {
                                "target_lang_word": "идти на всех парах",
                                "target_lang_sense_clarification": "двигаться решительно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec45654f-7fa4-3eb1-835c-3eae8ddc9445",
                    "sense_definition": "To be very angry or furious.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was left to <w>steam</w> in the hallway while he ignored her complaints.",
                            "target_lang_translations": {
                                "ru": "Ее оставили <w>кипеть от злости</w> в коридоре, пока он игнорировал ее жалобы."
                            }
                        },
                        {
                            "text": "It really makes me <w>steam</w> when people are rude to service staff.",
                            "target_lang_translations": {
                                "ru": "Меня действительно <w>бесит</w>, когда люди грубят обслуживающему персоналу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть очень злым или в ярости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кипеть",
                                "target_lang_sense_clarification": "от негодования"
                            },
                            {
                                "target_lang_word": "разъяряться",
                                "target_lang_sense_clarification": "приходить в ярость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fffab139-f954-3216-80eb-2e7e5442cbfd",
                    "sense_definition": "Old-fashioned or belonging to a time before modern digital technology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather still prefers listening to what he calls <w>steam</w> radio.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка до сих пор предпочитает слушать то, что он называет <w>допотопным</w> радио."
                            }
                        },
                        {
                            "text": "The office was using <w>steam</w> methods to organize files instead of computers.",
                            "target_lang_translations": {
                                "ru": "Офис использовал <w>устаревшие</w> методы организации файлов вместо компьютеров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steam radio"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often humorous or pejorative"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старомодный или относящийся к эпохе до современных цифровых технологий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допотопный",
                                "target_lang_sense_clarification": "устаревший"
                            },
                            {
                                "target_lang_word": "старинный",
                                "target_lang_sense_clarification": "нецифровой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}