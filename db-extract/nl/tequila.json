                                                "example_id": "e655e251-38f2-4a7f-b89c-582eedf01d57",
                                                "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                                                "text": "„Tequila ist aber auch gemein: Tut farblich so, als wäre es Wasser, wirkt aber vollkommen anders.“"
                                            },
                                            {
                                                "example_id": "1f5b97bf-ca6f-4f93-a758-cce4ce187a3b",
                                                "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                                                "text": "„Ich durfte Herrn Kilmister von da an noch ein paar Tequila servieren, war aber ansonsten abgemeldet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
