                ],
                "senses": [
                    {
                        "sense_id": "ef033dd6-6cd6-3dc0-92b2-0816f74faf4b",
                        "entry_id": "b00c956c-bd53-37a6-931f-258d81eb333e",
                        "glosses": [
                            "Leather from the skin of a female deer or sheep."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "92f556da-d0d8-4cc1-8b4a-d9416062397d",
                                "sense_id": "ef033dd6-6cd6-3dc0-92b2-0816f74faf4b",
                                "text": "He was dressed in shirt of doeskin, / White and soft, and fringed with ermine, / All inwrought with beads of wampum..."
                            },
                            {
                                "example_id": "57c9fdd6-b095-4c62-8a5e-79565e27e56d",
                                "sense_id": "ef033dd6-6cd6-3dc0-92b2-0816f74faf4b",
                                "text": "A long knife was in the doeskin belt that supported the doeskin skirt tightly about her lithe limbs."
                            }
                        ]
                    },
                    {
                        "sense_id": "abcccd8b-8f61-328e-ac67-bc77b9e3679e",
                        "entry_id": "b00c956c-bd53-37a6-931f-258d81eb333e",
                        "glosses": [
                            "The hide of a doe, as opposed to a buck."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "e8aadc46-e3f3-4ac1-b710-03ed7dffd7de",
                                "sense_id": "abcccd8b-8f61-328e-ac67-bc77b9e3679e",
                                "text": "Frequently, doeskins had a higher value in trade than the skins of bucks, as they were considered of finer quality."
                            }
                        ]
                    },
                    {
                        "sense_id": "37b7513d-87e6-3ce4-9898-ed8dcb356023",
                        "entry_id": "b00c956c-bd53-37a6-931f-258d81eb333e",
                        "glosses": [
                            "A glove made of doeskin leather."
                        ],
                        "tags": [
                            "countable",
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ad191b06-4ef9-4566-a963-798ea06f37eb",
                                "sense_id": "37b7513d-87e6-3ce4-9898-ed8dcb356023",
                                "text": "Elizabeth accidentally left her doeskins on the pew at Sunday service."
                            }
                        ]
                    },
                    {
                        "sense_id": "15769dd2-97c9-3611-aadc-76b279fda76d",
                        "entry_id": "b00c956c-bd53-37a6-931f-258d81eb333e",
                        "glosses": [
                            "A very soft, close-napped fabric, especially of high quality."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e482be17-dc24-4110-b9b4-b59cbdfea4a1",
                                "sense_id": "15769dd2-97c9-3611-aadc-76b279fda76d",
                                "text": "In the morning Mr. Logan wore a doeskin box coat with pearl buttons nearly as large as alarm clocks in two rows on it."
                            }
                        ]
                    }
