                    {
                        "sense_id": "47eb8856-e719-3303-9c1d-6c0ebb13288f",
                        "entry_id": "d4ffdaa1-71f7-3a69-b908-0101fc158c00",
                        "glosses": [
                            "The western region or countries; the west."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e546cf85-0b1a-417e-be03-5bf2b9b04d14",
                                "sense_id": "47eb8856-e719-3303-9c1d-6c0ebb13288f",
                                "text": "I name this to explain what I said before, of Ships being embay’d and lost here: this is when, coming from the Westward, they omit to keep a good Offing, or are taken short by contrary Winds […]"
                            },
                            {
                                "example_id": "c918b2fa-8293-42a9-9769-86f458227141",
                                "sense_id": "47eb8856-e719-3303-9c1d-6c0ebb13288f",
                                "text": "You will live quietly there till I come back from my next cruise to the westward."
                            }
                        ]
                    }
                ],
