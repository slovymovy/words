                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa3ed67-d941-45a9-ae33-242706a6bb86",
                                "sense_id": "6a827a7e-792d-3961-b17a-9cd552883bb7",
                                "text": "„Wir amüsierten uns über den Buchstabensalat, der als Ergebnis der »Schnellen Post« von Ohr zu Ohr getuschelt wurde, und entzifferten mit Mühe »Wortkürzel« von SMS-Nutzern.“"
                            },
                            {
                                "example_id": "37f585f4-2c3c-4377-8a76-2eb93218d1db",
                                "sense_id": "6a827a7e-792d-3961-b17a-9cd552883bb7",
                                "text": "„Buchstabensalat ist dabei nicht gefragt.“"
                            }
                        ],
