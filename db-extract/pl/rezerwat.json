                "senses": [
                    {
                        "sense_id": "811f9ebf-d279-3581-a07f-e39d2a262c02",
                        "entry_id": "af5fe309-3304-3b4b-a562-b96bccc0eee3",
                        "glosses": [
                            "objęty ochroną ścisłą teren o szczególnych walorach przyrodniczych lub krajoznawczych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb96eb1-bb9a-47f3-a7eb-ffa4c45869b3",
                                "sense_id": "811f9ebf-d279-3581-a07f-e39d2a262c02",
                                "text": "W naszym rezerwacie żyją tak rzadkie stworzenia jak żbik czy wąż Eskulapa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "803f6c8c-a190-3cbd-a948-56bb7314e40c",
                        "entry_id": "af5fe309-3304-3b4b-a562-b96bccc0eee3",
                        "glosses": [
                            "wydzielony obszar przymusowego osiedlenia ludności rdzennej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5319234f-4cf1-422b-a09c-c35dd6ee87de",
                                "sense_id": "803f6c8c-a190-3cbd-a948-56bb7314e40c",
                                "text": "Kilkanaście lat później resztki Indian zamknięto w niewielkim rezerwacie na terenie nieprzydatnym do jakiejkolwiek uprawy, skazując ich na nędzną wegetację"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d2c76a9-2afd-413b-864a-c9b1a7ff0628",
                        "source_entry_id": "af5fe309-3304-3b4b-a562-b96bccc0eee3",
                        "source_sense_id": "811f9ebf-d279-3581-a07f-e39d2a262c02",
                        "target_lang_word": "preserve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preserve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0931c6d1-d36c-34f2-9a7a-7afc6e699875",
                                        "entry_id": "24c63487-b10d-39fe-91b3-4c69f9265c7d",
                                        "glosses": [
                                            "A sweet spread made of any of a variety of fruits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6294715f-0e1e-3819-85fb-8c87ec3c35a8",
                                        "entry_id": "24c63487-b10d-39fe-91b3-4c69f9265c7d",
                                        "glosses": [
                                            "A reservation, a nature preserve."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d41bf5-ea8d-4ace-9380-4412695fabe4",
                                                "sense_id": "6294715f-0e1e-3819-85fb-8c87ec3c35a8",
                                                "text": "Suppose Shakespeare had been knocked on the head some dark night in Sir Thomas Lucy's preserves, the world would have wagged on better or worse, the pitcher gone to the well, the scythe to the corn, and the student to his book; and no one been any the wiser of the loss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99497238-b8d7-30e7-8d21-8f848f360e15",
                                        "entry_id": "24c63487-b10d-39fe-91b3-4c69f9265c7d",
                                        "glosses": [
                                            "An activity with restricted access."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d50ccd3-8b89-498e-9690-51f9bd5ceb53",
                                                "sense_id": "99497238-b8d7-30e7-8d21-8f848f360e15",
                                                "text": "No one can argue with that—neither the Army Commander nor Zhilinsky nor even the Grand Duke. That is the Emperor’s preserve. The Emperor says France must be saved. We can only do his bidding."
                                            },
                                            {
                                                "example_id": "72dcb6eb-358e-4b46-96a0-9d78a1a3de3e",
                                                "sense_id": "99497238-b8d7-30e7-8d21-8f848f360e15",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them, which is then licensed to related businesses in high-tax countries, is often assumed to be the preserve of high-tech companies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preserve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27095be2-a594-3c88-a346-252d2cceef5c",
                                        "entry_id": "900782af-ba27-361b-8652-0384e9a34b91",
                                        "glosses": [
                                            "To protect; to keep from harm or injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3862a5e8-7099-488e-9447-c56f498818fa",
                                                "sense_id": "27095be2-a594-3c88-a346-252d2cceef5c",
                                                "text": "Every people has the right to preserve its identity and culture."
                                            },
                                            {
                                                "example_id": "09e67044-8c65-47d8-9143-5468dd7aadf0",
                                                "sense_id": "27095be2-a594-3c88-a346-252d2cceef5c",
                                                "text": "O, the Lord preserve thy good Grace! By my troth, welcome to London. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a103d5a5-d8cf-3266-b0d3-aff6ea43b944",
                                        "entry_id": "900782af-ba27-361b-8652-0384e9a34b91",
                                        "glosses": [
                                            "To save from decay by the use of some preservative substance, such as sugar or salt; to season and prepare (fruits, meat, etc.) for storage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e62bdaca-6408-4bd6-be2c-b7a2b623f03f",
                                                "sense_id": "a103d5a5-d8cf-3266-b0d3-aff6ea43b944",
                                                "text": "to preserve peaches or grapes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a1eb3c-6a19-35de-9fa1-e0d6fd3b5cf4",
                                        "entry_id": "900782af-ba27-361b-8652-0384e9a34b91",
                                        "glosses": [
                                            "To maintain throughout; to keep intact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758d15ca-9d8d-42f7-b03e-8bc3bf271f21",
                                                "sense_id": "f6a1eb3c-6a19-35de-9fa1-e0d6fd3b5cf4",
                                                "text": "to preserve appearances; to preserve silence"
                                            },
                                            {
                                                "example_id": "d38a44ed-8b7d-4380-8357-b7dcb2933fd3",
                                                "sense_id": "f6a1eb3c-6a19-35de-9fa1-e0d6fd3b5cf4",
                                                "text": "Better men than you, men who could believe and obey, twisted the entrails of iron and preserved the legend of fire."
                                            },
                                            {
                                                "example_id": "1b07fe2f-18d6-46ea-845c-cd9f4bb61cee",
                                                "sense_id": "f6a1eb3c-6a19-35de-9fa1-e0d6fd3b5cf4",
                                                "text": "O, that this good blossom could be kept from cankers! Well, there is sixpence to preserve thee."
                                            },
                                            {
                                                "example_id": "49a405d6-def6-4040-b272-ccdc2676fc35",
                                                "sense_id": "f6a1eb3c-6a19-35de-9fa1-e0d6fd3b5cf4",
                                                "text": "Among the most modern of all the Pacific stock in Great Britain is the stud of \"Merchant Navy\" and \"West Country\" Pacifics on the Southern Region, and the rebuilding which is now being carried out, preserving all the best features of the Bulleid designs—such as the free-steaming boiler—and jettisoning the features that have given trouble, in particular the chain-driven valve-motion, should give the Southern a supply of highly-competent machines able to last out the remaining life of steam on the S.R."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aac82c26-1ac6-4d83-b193-3cadfaeea6ae",
                        "source_entry_id": "af5fe309-3304-3b4b-a562-b96bccc0eee3",
