                },
                {
                    "sense_id": "5a11611e-941e-3816-8d84-a6806bcf21e8",
                    "sense_definition": "Used as an intensifier to emphasize a quality, especially a negative one.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>big</w> liar and nobody believes what he says anymore.",
                            "target_lang_translations": {
                                "ru": "Он <w>ужасный</w> лжец, и никто больше не верит тому, что он говорит."
                            }
                        },
                        {
                            "text": "I am in a <w>big</w> hurry so I cannot talk right now.",
                            "target_lang_translations": {
                                "ru": "Я <w>очень</w> спешу, поэтому не могу сейчас разговаривать."
                            }
                        }
                    ],
                    "synonyms": [
                        "total",
                        "complete",
                        "absolute"
                    ],
                    "common_phrases": [
                        "big liar",
                        "big hurry",
                        "big mistake"
                    ],
                    "traits": [
                        {
