                                        "sense_id": "7b078b7f-f8cc-33b3-8259-889659856bdd",
                                        "entry_id": "bf481227-acbe-3482-9701-682fd13039f5",
                                        "glosses": [
                                            "The highest letter grade assigned (disregarding plusses and minuses)."
