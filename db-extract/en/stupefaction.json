                        "entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                        "glosses": [
                            "The state of extreme shock or astonishment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1632c6ff-dad1-34fa-99ed-3feae5fadce5",
                        "entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                        "glosses": [
                            "A state of insensibility; stupor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "34082c01-60d3-4b17-8239-27fea3a6d7a3",
                                "sense_id": "1632c6ff-dad1-34fa-99ed-3feae5fadce5",
                                "text": "Suddenly roused from the state of stupefaction to which fear had reduced her, the female filled the air with shrieks. Disengaging herself from the officers, and rushing towards her husband, she clung with all her strength to his arm, imploring him, with frantic violence, not to let them kill her."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24ffe46e-e368-4c42-9e36-605c8789034a",
                        "source_entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                        "source_sense_description": "the state of dismay; shock",
                        "target_lang_word": "Benommenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benommenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad89a0ee-0076-3b51-b1b3-da034a6b735a",
                                        "entry_id": "587e92ef-ba85-3efe-be5b-f7f4d54cb708",
                                        "glosses": [
                                            "Zustand, Verfassung, physisch und psychisch eingeschränkt, gedämpft zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f386dc9-9653-47bd-a603-13dae323579e",
                                                "sense_id": "ad89a0ee-0076-3b51-b1b3-da034a6b735a",
                                                "text": "„Er saß da, in taumeliger Benommenheit versunken, und entschied, ein weiteres Glas Wein lieber abzulehnen.“"
                                            },
                                            {
                                                "example_id": "cf711ad5-c01a-45f9-b099-ff86cd17deec",
                                                "sense_id": "ad89a0ee-0076-3b51-b1b3-da034a6b735a",
                                                "text": "„Auch Robert spürte eine leichte Benommenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72a5eba5-8f94-4197-be1f-acf1b8a242dc",
                        "source_entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                        "source_sense_description": "the state of dismay; shock",
                        "target_lang_word": "Schock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c9ce5ed-5259-3957-8ccc-5345322d800d",
                                        "entry_id": "78296569-d787-3ae7-8e76-f1bfff0742c1",
                                        "glosses": [
                                            "plötzliche, massive, seelische oder nervliche Erschütterung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2afebdf7-c97a-425a-a4d4-d6de0934371b",
                                                "sense_id": "2c9ce5ed-5259-3957-8ccc-5345322d800d",
                                                "text": "Es war ein Schock für sie, zu erfahren, dass ihr Mann ein Zweitleben führte."
                                            },
                                            {
                                                "example_id": "e8f9b0d1-af07-4920-bfe9-a14a61ff85a2",
                                                "sense_id": "2c9ce5ed-5259-3957-8ccc-5345322d800d",
                                                "text": "„Als der Statthalter Marcus Lollius den Eindringlingen mit einer Legion entgegentritt, wird er vernichtend geschlagen und verliert sogar das Feldzeichen, den Legionsadler - ein Schock für die seit Cäsar wieder siegesgewohnten Römer.“"
                                            },
                                            {
                                                "example_id": "9b94b32c-d42a-467b-be9b-e1490bd6d4e2",
                                                "sense_id": "2c9ce5ed-5259-3957-8ccc-5345322d800d",
                                                "text": "„Der Schock angesichts der schweren Zerstörungen muss so groß gewesen sein, dass ich alle anderen visuellen Eindrücke nicht wahrnehmen konnte.“"
                                            },
                                            {
                                                "example_id": "a2987165-5a85-4b47-90f3-577b18e312e6",
                                                "sense_id": "2c9ce5ed-5259-3957-8ccc-5345322d800d",
                                                "text": "„Es war für Leo ein fürchterlicher Schock gewesen, als er erfuhr, daß Vater schon seit fast zehn Jahren eine Geliebte hat.“"
                                            },
                                            {
                                                "example_id": "0d994cb3-8284-4d81-8d6f-0a42b000f0c6",
                                                "sense_id": "2c9ce5ed-5259-3957-8ccc-5345322d800d",
                                                "text": "„Der Schock, der von den Werken de Sades noch heute auszugehen vermag, entzieht sich jeder Historisierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "316a8435-bd48-3470-83fc-83fb0a26d62f",
                                        "entry_id": "78296569-d787-3ae7-8e76-f1bfff0742c1",
                                        "glosses": [
                                            "akutes Versagen des Kreislaufsystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b45d1ba-0c7c-4ff6-b909-3d17939c9be9",
                                                "sense_id": "316a8435-bd48-3470-83fc-83fb0a26d62f",
                                                "text": "„Eleanora erleidet einen Schock und wird ins Krankenhaus gebracht, aus dem sie einen Monat später mit einem Schuldgefühl wieder herauskommt, das sie nie mehr loslassen wird.“"
                                            },
                                            {
                                                "example_id": "fb3dbd5d-63da-4f36-b397-678672c52cc1",
                                                "sense_id": "316a8435-bd48-3470-83fc-83fb0a26d62f",
                                                "text": "Bei einem Schock ist es wichtig, die Beine hochzulagern, damit das sich dort befindende Blut wieder dem Kreislauf zugeführt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8dfa9d3b-2bc7-34a9-b0eb-cb904ed3a7ed",
                                        "entry_id": "78296569-d787-3ae7-8e76-f1bfff0742c1",
                                        "glosses": [
                                            "abrupte, sich fortpflanzende Änderung von Zustandsgrößen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3d7bbb0e-66e4-390b-a687-9bcd5fcb0d4e",
                                        "entry_id": "78296569-d787-3ae7-8e76-f1bfff0742c1",
                                        "glosses": [
                                            "eine exogen erzeugte Veränderung von Größen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c5f021c-5cd1-3e5b-bee9-bcf0fd369f38",
                                        "entry_id": "7902a36b-e099-3000-afe0-b011ede64110",
                                        "glosses": [
                                            "ein altes Zählmaß, das 60 Stück entsprach"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00e6c78-3ccf-4b30-b637-4c899442dbaf",
                                                "sense_id": "8c5f021c-5cd1-3e5b-bee9-bcf0fd369f38",
                                                "text": "Sie brachte gestern ein halbes Schock frischer Eier."
                                            },
                                            {
                                                "example_id": "6c31e516-2407-45f4-ab9a-5b30c7dd9d95",
                                                "sense_id": "8c5f021c-5cd1-3e5b-bee9-bcf0fd369f38",
                                                "text": "„Von dem braunen, fleckigen Papier spricht zu ihm eine Anordnung, die verbietet, einem Dienstboten oder Instmann mehr als zwei Schock Krebse in der Woche zum Essen zu geben.“"
                                            },
                                            {
                                                "example_id": "d7cccce3-d0c2-4723-9644-b5d0a8d00807",
                                                "sense_id": "8c5f021c-5cd1-3e5b-bee9-bcf0fd369f38",
                                                "text": "„Unser Ladengeschäft ist erst eine Woche alt, und es kommt ein Mann, ein mickriges Männchen mit einem Bocksbart, aus Grodk, das sich als Besitzer eines Postkarten-Verlages ausgibt und ein halbes Schock griesgrämig gedruckter Ansichtskarten auf den Ladentisch hinbreitet.“"
                                            },
                                            {
                                                "example_id": "4f51c72e-cebe-4122-acf9-92a831cd29fe",
                                                "sense_id": "8c5f021c-5cd1-3e5b-bee9-bcf0fd369f38",
                                                "text": "„Auch ein Schock Eier, das ohne Schalenreste aus einer Speisekammer verschwunden war, konnte den alten Gandras nicht zu einer so weiten Reise bewegen.“"
                                            },
                                            {
                                                "example_id": "838ecae3-8e0c-4855-ae94-ff722d410f7f",
                                                "sense_id": "8c5f021c-5cd1-3e5b-bee9-bcf0fd369f38",
                                                "text": "„Wohl ihrer drei Schock Kugeln hatte er gegossen, Flintsteine zurechtgesplittert, Schießpulver bereitgestellt; taub gegen die Seufzer der Mutter, dachte er an nichts anderes als Kampf, Menschenjagd, Kopfhäute statt armseliger Tierfelle, Rache für den Vater, wie er sie längst erträumt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f36b1837-78eb-3e32-ac6b-050cba95d257",
                                        "entry_id": "7902a36b-e099-3000-afe0-b011ede64110",
                                        "glosses": [
                                            "eine große Zahl"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d1ad63f-766c-4041-8dd2-43d39b834e24",
                                                "sense_id": "f36b1837-78eb-3e32-ac6b-050cba95d257",
                                                "text": "Das ist wie ein Schock Tauben hüten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cc5ce81-303e-4f4b-a63b-906b04237326",
                        "source_entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                        "source_sense_description": "the state of dismay; shock",
                        "target_lang_word": "Betäubung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betäubung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cc04848-9cb4-31de-a9e2-6df761424216",
                                        "entry_id": "19ebaed0-9689-32af-a9d9-2c9f56ba5e89",
                                        "glosses": [
                                            "Handlung, jemanden schmerzunempfindlich zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c147ad91-3b36-4f8b-89ba-3c994eaa3623",
                                                "sense_id": "0cc04848-9cb4-31de-a9e2-6df761424216",
                                                "text": "Die lokale Betäubung belastet den Körper weniger."
                                            },
                                            {
                                                "example_id": "df054e17-5f63-447e-9604-a5b7f8f1fa74",
                                                "sense_id": "0cc04848-9cb4-31de-a9e2-6df761424216",
                                                "text": "„Da lag er lange, denn die verabreichte Betäubung wirkte bei ihm nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9fcf02e-7a34-324e-9b82-00dc773fbfed",
                                        "entry_id": "19ebaed0-9689-32af-a9d9-2c9f56ba5e89",
                                        "glosses": [
                                            "Zustand, nichts/wenig zu spüren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8c6920-dcb9-4583-98e8-5a599a7e3376",
                                                "sense_id": "b9fcf02e-7a34-324e-9b82-00dc773fbfed",
                                                "text": "Die leichte Betäubung setzte ihn gleich zur Ruhe."
                                            },
                                            {
                                                "example_id": "542ff373-2b95-4602-b278-d5055b161d51",
                                                "sense_id": "b9fcf02e-7a34-324e-9b82-00dc773fbfed",
                                                "text": "„Da erwachte Jón Hreggvidsson plötzlich aus seiner Betäubung, guckte nicht mehr durch die Maueröffnung, steckte die Finger in seinen Haarschopf unter dem Hut und juckte sich.“"
                                            },
                                            {
                                                "example_id": "3a13eca6-b9a3-4142-8b3d-bd7ab8f25d98",
                                                "sense_id": "b9fcf02e-7a34-324e-9b82-00dc773fbfed",
                                                "text": "„Germaine erwachte aus ihrer Betäubung und erklärte, ihr sei übel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ca730e-8964-4474-a6e5-abfa9548a7a9",
                        "source_entry_id": "585bde6a-2695-34a9-8702-7c08ea86b2a6",
                        "source_sense_description": "the state of dismay; shock",
                        "target_lang_word": "Bestürzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestürzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                        "entry_id": "9e484c61-dcc9-3eb5-8898-64cd94be0a75",
                                        "glosses": [
                                            "Gefühl zufolge einer unerwarteten schlechten Nachricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fec8d5-2549-40dd-8a9f-1240018e1627",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "Mit tiefer Bestürzung geben wir das Ableben unserer Großmutter bekannt."
                                            },
                                            {
                                                "example_id": "0b649006-37bd-43db-ab1e-59f879df1975",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Aber danach hatte sie der Frau direkt ins Gesicht und in ihre Gedanken geschaut, geübt darin, die Mimik und Gestik zu lesen, keine Bestürzung wahrgenommen oder überhaupt etwas anderes als diese normale Hausfrauenmilde.“"
                                            },
                                            {
                                                "example_id": "78cc4731-8ea6-4820-a216-b58aa94e621b",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Ihre Bestürzung wurde so stark, daß sie das Trommeln und den Tanz der anderen unterbrechen wollte.“"
                                            },
                                            {
                                                "example_id": "90bbe320-55bb-4af8-9241-9ae2b4e2de6a",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Die beiden wurden der Herrschaft gemeldet, und dann war es, als sei unter der Dienerschaft des Fürsten eine gewisse Verwirrung und Bestürzung entstanden.“"
                                            },
                                            {
                                                "example_id": "4cbf5f58-71b3-4da0-9bdd-d9e2fe9b9b69",
                                                "sense_id": "07126079-46df-359a-922b-e0093c0aee12",
                                                "text": "„Die unnennbare Angst des Kindes hatte die Anwesenden mit Verwunderung und Bestürzung erfüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
