                {
                    "sense_id": "11017f6f-fcb2-3e4f-853f-51ef6f0be712",
                    "sense_definition": "Доля, отдельный элемент или кусок, входящий в состав чего-либо целого.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "component",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Большая <w>часть</w> работы уже сделана.",
                            "target_lang_translations": {
                                "en": "A large <w>part</w> of the work is already done.",
                                "zh": "大部分工作已经完成了。"
                            }
                        },
                        {
                            "text": "Мы прошли только малую <w>часть</w> пути.",
                            "target_lang_translations": {
                                "en": "We have covered only a small <w>part</w> of the way.",
                                "zh": "我们只走完了路程的一小<w>部分</w>。"
                            }
                        }
