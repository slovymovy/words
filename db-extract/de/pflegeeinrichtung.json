                "senses": [
                    {
                        "sense_id": "657ef9f3-a5b3-3f0c-90d4-ba45ecea0cb5",
                        "entry_id": "535a0028-d661-35cb-9060-3b3ef7b8b246",
                        "glosses": [
                            "Organisation/Unternehmen zur Betreuung (Pflege) von Patienten, die besonderer Unterstützung bedürfen und nicht eigenständig in ihrem Zuhause leben und dort versorgt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842164b4-6013-43d5-96a8-f8693b55b058",
                                "sense_id": "657ef9f3-a5b3-3f0c-90d4-ba45ecea0cb5",
                                "text": "„Für Menschen im Wachkoma gibt es im Wesentlichen drei Varianten der Versorgung in einer stationären Pflegeeinrichtung.“"
                            },
                            {
                                "example_id": "40c09487-ef0c-4e25-a1a9-f7ba1040ed6a",
                                "sense_id": "657ef9f3-a5b3-3f0c-90d4-ba45ecea0cb5",
                                "text": "Die fortschreitende Demenz machte es notwendig, über eine zukünftige Unterbringung in einer Pflegeeinrichtung nachzudenken."
                            },
                            {
                                "example_id": "d6bda4d8-983c-4404-b742-52e19bb64ce1",
                                "sense_id": "657ef9f3-a5b3-3f0c-90d4-ba45ecea0cb5",
                                "text": "„Pflegeeinrichtungen werden in ihrer täglichen Arbeit mit der Fragestellung des rechtssicheren Umgangs mit Zwangsmaßnahmen konfrontiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
