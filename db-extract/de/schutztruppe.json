                "senses": [
                    {
                        "sense_id": "8fbc22d6-cf37-390f-bcd8-2201f13b8e6e",
                        "entry_id": "2d121380-0a2c-3df6-9c56-dd9d2e7b3818",
                        "glosses": [
                            "Truppe in einer Kolonie"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5645cfd3-b250-4e55-a579-139b3bd27413",
                                "sense_id": "8fbc22d6-cf37-390f-bcd8-2201f13b8e6e",
                                "text": "„Aus Wissmanns Miliz wurde die Kaiserliche Schutztruppe.“"
                            },
                            {
                                "example_id": "f8e6e00e-67ce-41e3-bffb-f4fab30a407f",
                                "sense_id": "8fbc22d6-cf37-390f-bcd8-2201f13b8e6e",
                                "text": "„Nach der Rückkehr von der Kamerun-Expedition wurde er zwischen 1891 und 1893 in der Kolonialabteilung des Auswärtigen Amtes eingesetzt, wo er an dem Projekt einer Schutztruppe für Kamerun arbeitete.“"
                            },
                            {
                                "example_id": "c717256d-f05d-4349-a793-7d34d81a1db9",
                                "sense_id": "8fbc22d6-cf37-390f-bcd8-2201f13b8e6e",
                                "text": "„Und die Schutztruppe regierte von Fort Moshi (Old Moshi-Mahoma) mit eiserner Faust über das gesamte Chagga-Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0809d886-5514-3ce5-9958-92fe07986362",
                        "entry_id": "2d121380-0a2c-3df6-9c56-dd9d2e7b3818",
                        "glosses": [
                            "Truppe im Auftrag einer übergeordneten Organisation zur Erhöhung der Sicherheit in Konfliktgebieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab60b3e-9610-4bb1-93c8-b97b099894bc",
                                "sense_id": "0809d886-5514-3ce5-9958-92fe07986362",
                                "text": "„Zur Sicherung waren etwa 400 niederländische Blauhelm-Soldaten der Schutztruppe der Vereinten Nationen (UNPROFOR) unter dem Befehl von Thomas Karremans eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
