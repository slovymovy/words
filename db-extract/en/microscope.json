                    {
                        "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                        "entry_id": "3222fb2a-7b08-3dee-be7b-b46b8e20f60a",
                        "glosses": [
                            "To examine with a microscope, to put under a microscope (literally or figuratively)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dee191b-7ca8-416b-87a5-9a1d19712c2c",
                                "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                "text": "It has a strong germicidal action, as can be verified by staining and microscoping the pus, the characteristic micro-organisms disappearing rapidly under its use."
                            },
                            {
                                "example_id": "d10c47b7-3d4a-4db2-b57d-2b999ced9a49",
                                "sense_id": "97d1127a-f8cb-32ac-8371-0be4ad0b0975",
                                "text": "Wright (1959), using the standard and less laborious technique of microscoping the centrifuged deposit of a sample of urine, found that 21.6% of males attending life insurance examinations had more than 10 red blood cells per high power field (rbc/hpf)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f0547d6-bbd7-4c89-a61f-ff696399e4f9",
