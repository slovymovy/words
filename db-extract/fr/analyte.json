                        "entry_id": "46866763-dbdc-36ca-b1e4-2c5831f2cbf9",
                        "glosses": [
                            "Espèce chimique recherchée, détectée et éventuellement dosée selon un protocole analytique."
                        ],
                        "tags": [
                            "Chimie analytique",
                            "Toxicologie"
                        ],
                        "examples": [
                            {
