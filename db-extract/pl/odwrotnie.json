                                                "sense_id": "d9384b9c-9d44-341c-a3c9-133a0dcfaf2f",
                                                "text": "Ik heb de stappen in omgekeerde volgorde uitgevoerd."
                                            },
                                            {
                                                "example_id": "f2600490-4b59-4619-a318-9079b6b881d1",
                                                "sense_id": "d9384b9c-9d44-341c-a3c9-133a0dcfaf2f",
                                                "text": "Het lijkt de omgekeerde wereld."
                                            },
                                            {
                                                "example_id": "ecd7e47b-eb11-4624-a11e-e1121a83a5ac",
                                                "sense_id": "d9384b9c-9d44-341c-a3c9-133a0dcfaf2f",
