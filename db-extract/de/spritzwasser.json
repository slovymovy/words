            {
                "entry_id": "d88d1458-355a-3f17-9876-80178e109aeb",
                "word": "Spritzwasser",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "e2a6e78f-31a0-44d4-9e45-f78c1fb0c766",
                        "entry_id": "d88d1458-355a-3f17-9876-80178e109aeb",
