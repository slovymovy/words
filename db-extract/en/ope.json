                "senses": [
                    {
                        "sense_id": "ba81dc14-a937-3d16-b187-b252e58d95c2",
                        "entry_id": "c649c518-f870-313c-8cc8-974645157f70",
                        "glosses": [
                            "An exclamation of surprise; oops."
                        ],
                        "tags": [
                            "Midwestern-US",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "882b4264-ff51-44cc-8715-6dba82eb088d",
                                "sense_id": "ba81dc14-a937-3d16-b187-b252e58d95c2",
                                "text": "Ope! Sorry about that."
                            },
                            {
                                "example_id": "b587144e-c3d3-4a7e-8d59-eea118984874",
                                "sense_id": "ba81dc14-a937-3d16-b187-b252e58d95c2",
                                "text": "Ope, let me just squeeze past ya there."
                            },
                            {
                                "example_id": "de2ec94b-4a6f-4b90-a4c2-0c675fa971ec",
                                "sense_id": "ba81dc14-a937-3d16-b187-b252e58d95c2",
                                "text": "We're Midwesterners. We like long walks through frozen cornfields. Ope! Watch out!"
                            }
                        ]
                    }
                ],
