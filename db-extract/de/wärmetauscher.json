                "senses": [
                    {
                        "sense_id": "e46ce62d-cadf-36d7-948f-b1d0520f1893",
                        "entry_id": "981b9e52-3ec8-36f8-bd52-1428cabb1b88",
                        "glosses": [
                            "Gerät zur Übertragung von Wärme zwischen Stoffströmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8440e4d3-9dca-4990-9497-9ab5be6836bf",
                                "sense_id": "e46ce62d-cadf-36d7-948f-b1d0520f1893",
                                "text": "In der Lüftungstechnik werden Wärmetauscher genutzt, um die Wärme der Abluft auf die Zuluft zu übertragen."
                            },
                            {
                                "example_id": "31fb4e19-f437-43a3-928d-0d983a64baa2",
                                "sense_id": "e46ce62d-cadf-36d7-948f-b1d0520f1893",
                                "text": "In der Verfahrenstechnik werden Wärmetauscher zur Übertragung von Wärme zur Kühlung/Aufheizung von Flüssigkeiten verwendet."
                            },
                            {
                                "example_id": "554127c5-91ab-4149-a37a-66fba388bbeb",
                                "sense_id": "e46ce62d-cadf-36d7-948f-b1d0520f1893",
                                "text": "Der Plattenheizkörper im Wohnraum ist ein einstellbarer Wärmetauscher, der die Luft durch heißes Wasser erwärmt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
