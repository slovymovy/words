{
    "word_family": [
        "flare-up",
        "flaring"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e220d71-dd01-3b62-b807-8bfa7e3dc0a8",
                    "sense_definition": "A sudden bright light.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>flare</w> of light from the match illuminated the dark room for a second.",
                            "target_lang_translations": {
                                "zh": "火柴突然发出的<w>闪光</w>照亮了黑暗的房间。"
                            }
                        },
                        {
                            "text": "The bright <w>flare</w> of the explosion could be seen from several miles away.",
                            "target_lang_translations": {
                                "zh": "几英里外都能看到爆炸产生的明亮<w>闪光</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sudden flare",
                        "flare of light"
                    ],
                    "target_lang_definitions": {
                        "zh": "突然出现的强光。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪光",
                                "target_lang_sense_clarification": "指突然发出的明亮光线。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89907acd-89f4-3ca1-be36-e8258bb6c77d",
                    "sense_definition": "A type of pyrotechnic that produces a brilliant light without an explosion, used to attract attention in an emergency or as a decoy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stranded sailors fired a distress <w>flare</w> into the night sky to signal for help.",
                            "target_lang_translations": {
                                "zh": "遇险的水手向夜空发射了一枚求救<w>信号弹</w>以寻求帮助。"
                            }
                        },
                        {
                            "text": "Police used a signal <w>flare</w> to steer the traffic away from the accident.",
                            "target_lang_translations": {
                                "zh": "警察使用<w>信号弹</w>引导车辆避开事故现场。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "distress flare",
                        "signal flare",
                        "road flare"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于发出求救信号或照明的烟火装置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "信号弹",
                                "target_lang_sense_clarification": "用于紧急情况或指示的照明装置。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47546e7b-4713-3784-833e-36029afb9d6c",
                    "sense_definition": "A source of brightly burning light or intense heat, such as a solar eruption.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A massive solar <w>flare</w> can disrupt satellite communications on Earth.",
                            "target_lang_translations": {
                                "zh": "巨大的太阳<w>耀斑</w>可能会干扰地球上的卫星通信。"
                            }
                        },
                        {
                            "text": "The scientists monitored the sun for any sign of a solar <w>flare</w>.",
                            "target_lang_translations": {
                                "zh": "科学家们监测着太阳，寻找任何太阳<w>耀斑</w>的迹象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "solar flare"
                    ],
                    "target_lang_definitions": {
                        "zh": "剧烈燃烧的光源或强烈的能量爆发，如太阳耀斑。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "耀斑",
                                "target_lang_sense_clarification": "特指太阳表面剧烈的能量爆发。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9da5c45-836e-32b6-a178-02c14f224849",
                    "sense_definition": "A widening of an object with an otherwise roughly constant width.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skirt has a slight <w>flare</w> at the bottom to allow for easier movement.",
                            "target_lang_translations": {
                                "zh": "裙子底部有轻微的<w>喇叭口</w>设计，以便于活动。"
                            }
                        },
                        {
                            "text": "The <w>flare</w> on the inside of the shoe helps to resist ankle pronation.",
                            "target_lang_translations": {
                                "zh": "鞋子内侧的<w>喇叭口</w>设计有助于防止脚踝内旋。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slight flare",
                        "skirt flare"
                    ],
                    "target_lang_definitions": {
                        "zh": "物体末端逐渐变宽的形状。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喇叭口",
                                "target_lang_sense_clarification": "指物体末端向外张开的形状。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eaef18d-5406-320d-8473-b76f736fdf69",
                    "sense_definition": "A sudden eruption or outbreak of a condition or emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outbreak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stress can often lead to a <w>flare</w> of his skin condition.",
                            "target_lang_translations": {
                                "zh": "压力往往会导致他的皮肤病<w>发作</w>。"
                            }
                        },
                        {
                            "text": "The doctor prescribed a new cream to treat episodic <w>flares</w> of the illness.",
                            "target_lang_translations": {
                                "zh": "医生开了一种新药膏来治疗这种疾病的间歇性<w>发作</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flare-up"
                    ],
                    "common_phrases": [
                        "episodic flare",
                        "flare of temper"
                    ],
                    "target_lang_definitions": {
                        "zh": "疾病或情绪的突然发作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发作",
                                "target_lang_sense_clarification": "指病情或情绪的突然加重或爆发。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8c6b20f-2f36-3c9f-94c6-422277d13314",
                    "sense_definition": "Bell-bottom trousers that widen from the knee down.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore denim <w>flares</w> and a flowered shirt to the retro-themed party.",
                            "target_lang_translations": {
                                "zh": "他穿着牛仔<w>喇叭裤</w>和花衬衫参加了复古主题派对。"
                            }
                        },
                        {
                            "text": "Fashion trends from the seventies often include high-waisted <w>flares</w>.",
                            "target_lang_translations": {
                                "zh": "七十年代的时尚潮流通常包括高腰<w>喇叭裤</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "denim flares"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "膝盖以下逐渐变宽的喇叭裤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喇叭裤",
                                "target_lang_sense_clarification": "一种裤腿下部宽大的裤子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bfe8356-a727-3dd9-b60d-afda57c0a909",
                    "sense_definition": "The transition from downward flight to level flight just before landing an aircraft.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot executed the <w>flare</w> perfectly just before the wheels touched the runway.",
                            "target_lang_translations": {
                                "zh": "飞行员在轮子触地前完美地执行了<w>拉平</w>动作。"
                            }
                        },
                        {
                            "text": "If you don't time the <w>flare</w> correctly, the landing might be quite bumpy.",
                            "target_lang_translations": {
                                "zh": "如果你没有掌握好<w>拉平</w>的时机，着陆可能会很颠簸。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "landing flare"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical aviation term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "飞机着陆前从下降转为平飞的动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拉平",
                                "target_lang_sense_clarification": "航空术语，指着陆前的平飞操作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03f5f683-7125-3c25-92e6-0060c37a8b9b",
                    "sense_definition": "A low fly ball in baseball that is hit between the infielders and the outfielders.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter hit a little <w>flare</w> to right field that dropped for a single.",
                            "target_lang_translations": {
                                "zh": "击球手打出一个落入右外野的<w>浅高飞球</w>，形成了一支一垒安打。"
                            }
                        },
                        {
                            "text": "The outfielder couldn't reach the <w>flare</w> in time to make the catch.",
                            "target_lang_translations": {
                                "zh": "外野手没能及时赶到接住那个<w>浅高飞球</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blooper",
                        "Texas leaguer"
                    ],
                    "common_phrases": [
                        "hit a flare"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "baseball terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "棒球中落在内野和外野之间的轻击球。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "浅高飞球",
                                "target_lang_sense_clarification": "棒球术语，指落点在内野与外野之间的球。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e009f831-67b5-30b7-9556-7fdc4fbe5559",
                    "sense_definition": "To open or spread outward in shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse's nostrils began to <w>flare</w> as it galloped across the field.",
                            "target_lang_translations": {
                                "zh": "马在田野上奔跑时，鼻孔开始<w>张开</w>。"
                            }
                        },
                        {
                            "text": "The designer chose to <w>flare</w> the bottom of the dress for a dramatic effect.",
                            "target_lang_translations": {
                                "zh": "设计师选择将裙摆<w>张开</w>以达到戏剧性的效果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nostrils flare",
                        "flare outward"
                    ],
                    "target_lang_definitions": {
                        "zh": "向外张开或变宽。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "张开",
                                "target_lang_sense_clarification": "指物体或部位向外扩张。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91e744b7-6cfa-3191-aa3a-f87e1ca01e57",
                    "sense_definition": "To burn or blaze with a sudden, bright, or unsteady light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The campfire would <w>flare</w> up whenever we added more dry wood.",
                            "target_lang_translations": {
                                "zh": "每当我们添加干木头时，营火就会<w>闪烁</w>变大。"
                            }
                        },
                        {
                            "text": "The match <w>flared</w> in the darkness, lighting up his face for a moment.",
                            "target_lang_translations": {
                                "zh": "火柴在黑暗中<w>闪烁</w>了一下，瞬间照亮了他的脸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flare up"
                    ],
                    "common_phrases": [
                        "flare up",
                        "flare brightly"
                    ],
                    "target_lang_definitions": {
                        "zh": "突然发出明亮而不稳定的光。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "指光线突然明亮或不稳定地跳动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97763264-d366-30e9-8a71-ab31f58fd18b",
                    "sense_definition": "To suddenly erupt in anger or intense emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tempers <w>flared</w> during the meeting as the two sides failed to reach an agreement.",
                            "target_lang_translations": {
                                "zh": "会议期间，由于双方未能达成协议，情绪开始<w>爆发</w>。"
                            }
                        },
                        {
                            "text": "He tended to <w>flare</w> up whenever someone questioned his authority.",
                            "target_lang_translations": {
                                "zh": "每当有人质疑他的权威时，他往往会<w>爆发</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flare up"
                    ],
                    "common_phrases": [
                        "tempers flare",
                        "flare up"
                    ],
                    "target_lang_definitions": {
                        "zh": "突然爆发愤怒或强烈情绪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爆发",
                                "target_lang_sense_clarification": "指情绪的突然剧烈表现。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fbd0a63-d978-3b72-b14a-644c4263a8e2",
                    "sense_definition": "To burn off excess gas, typically at an oil refinery or industrial site.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refinery had to <w>flare</w> the excess methane due to a technical issue.",
                            "target_lang_translations": {
                                "zh": "由于技术问题，炼油厂不得不将多余的甲烷进行<w>放空燃烧</w>。"
                            }
                        },
                        {
                            "text": "Environmental groups are concerned about the amount of gas the company is <w>flaring</w>.",
                            "target_lang_translations": {
                                "zh": "环保组织对该公司正在<w>放空燃烧</w>的气体量表示担忧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flaring gas"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "industrial context"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在工业现场燃烧掉多余的气体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放空燃烧",
                                "target_lang_sense_clarification": "工业术语，指燃烧处理多余气体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255e0bae-c742-3228-982d-311d3da733f8",
                    "sense_definition": "To transition an aircraft from a descent to a level flight path just before touching down.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot began to <w>flare</w> the plane as it crossed the runway threshold.",
                            "target_lang_translations": {
                                "zh": "飞机越过跑道入口时，飞行员开始<w>拉平</w>飞机。"
                            }
                        },
                        {
                            "text": "It is important to <w>flare</w> at the right height to ensure a smooth landing.",
                            "target_lang_translations": {
                                "zh": "在合适的高度<w>拉平</w>对于确保平稳着陆非常重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flare to land"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "aviation terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "飞机着陆前从下降转为平飞。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拉平",
                                "target_lang_sense_clarification": "指飞机着陆前的平飞操作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}