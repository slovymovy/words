                    {
                        "translation_id": "52108118-7be7-4f4c-802e-7269ff3a491d",
                        "source_entry_id": "eba56ecb-94fd-3d92-a514-2d7d3e4219a3",
                        "source_sense_id": "47b1d17e-975c-39bb-8b50-d98a32560cd2",
