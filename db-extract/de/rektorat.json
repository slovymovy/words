                ],
                "senses": [
                    {
                        "sense_id": "4e75111d-2baf-30eb-ab5c-e77a7bd5c5e6",
                        "entry_id": "6c4621e2-dde8-368c-b07e-fc2f6e10d1ae",
                        "glosses": [
                            "Amt und Amtszeit eines Rektors/einer Rektorin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa34df9b-15f3-4828-abea-f214527dd7a5",
                                "sense_id": "4e75111d-2baf-30eb-ab5c-e77a7bd5c5e6",
                                "text": "„Das Rektorat bekleidet immer ein Professor, aber nur auf ein halbes Jahr.“"
                            },
                            {
                                "example_id": "be721ee5-dd5a-4942-b89b-6bc1c23ef36f",
                                "sense_id": "4e75111d-2baf-30eb-ab5c-e77a7bd5c5e6",
                                "text": "„Im Sommer 1786 fiel ihm zum ersten Male das Rektorat der Universität zu; in seiner Amtszeit hatte er die Aufgabe, im Namen der Albertina dem soeben gekrönten König Friedrich Wilhelm II. die Huldigung der Universität darzubringen, als der Monarch Königsberg besuchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93a04039-6220-3ea6-a7dc-8420689f4183",
                        "entry_id": "6c4621e2-dde8-368c-b07e-fc2f6e10d1ae",
                        "glosses": [
                            "Räumlichkeit für einen Rektor/eine Rektorin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e92e3d6c-2514-4f8a-b1c5-a2d4e23b515a",
                                "sense_id": "93a04039-6220-3ea6-a7dc-8420689f4183",
                                "text": "„Als die Frankfurter Polizei um 6 Uhr in der Universität eintraf, fand sie nur noch ein verschlafenes nichtstudentisches Pärchen im Rektorat und vier Studenten im übrigen Hauptgebäude.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7e614240-973f-3a65-abd7-d9d4e78fca72",
                        "entry_id": "6c4621e2-dde8-368c-b07e-fc2f6e10d1ae",
                        "glosses": [
                            "Verwaltungsgremium einer Hochschule, das sich aus dem Rektor/der Rektorin, den beiden Prorektoren und dem Kanzler zusammensetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f48b5bc-ee5d-4722-a44f-2af7e8ce3c04",
                                "sense_id": "7e614240-973f-3a65-abd7-d9d4e78fca72",
                                "text": "„Die endgültige Entscheidung über den Widerspruch werde dann im Rektorat der Universität Heidelberg getroffen.“"
                            },
                            {
                                "example_id": "77c8276b-4e7e-448f-b2f0-92695f09e7d6",
                                "sense_id": "7e614240-973f-3a65-abd7-d9d4e78fca72",
                                "text": "„An der Unerlässlichkeit durfte ohnehin zweifeln, wer zur gleichen Zeit im Rektorat und im Hochschulrat der Universität nach Frauen suchte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
