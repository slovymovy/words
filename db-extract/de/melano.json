                "senses": [
                    {
                        "sense_id": "520b5872-e776-36a2-8f09-c74d825801db",
                        "entry_id": "a65879c3-aa4f-31ab-8513-9aecee17caf2",
                        "glosses": [
                            "Tier, dessen Pigmentierung stark schwärzlich ausgebildet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10894e80-9065-4981-93ff-45c56e861fe6",
                                "sense_id": "520b5872-e776-36a2-8f09-c74d825801db",
                                "text": "„Dennoch gibt es bestimmte auch im Freileben auftretende Farbmutationen, die so häufig sind, daß man sie mit eigenen Namen belegt hat. So z.B. die völlig Schwarzfärbung, wie sie beim Black Molly oder beim Schwarzen Panther bekannt ist. Solche Tiere nennt man Melano, das Adjektiv heißt melanistisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
