                "senses": [
                    {
                        "sense_id": "374f754e-f843-37a3-a32b-9c9193f48bbc",
                        "entry_id": "4a3d2309-4d4e-38ce-9663-7a683c0ca773",
                        "glosses": [
                            "Faire le point, faire un bilan rapide à chaud après une action, un événement, tirer la leçon des événements, des résultats de l’intervention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e14ae1b7-1c63-4a75-9163-bfbba104bdbc",
                                "sense_id": "374f754e-f843-37a3-a32b-9c9193f48bbc",
                                "text": "Ils sont une petite dizaine triés sur le volet autour d'une table de réunion à débreffer, comme chaque vendredi."
                            },
                            {
                                "example_id": "32967bfa-c0f4-4bcc-93fc-76ac221c614e",
                                "sense_id": "374f754e-f843-37a3-a32b-9c9193f48bbc",
                                "text": "Les parrains auraient apprécié plus d'occasions pour débreffer et des contacts avec des parrains expérimentés."
                            },
                            {
                                "example_id": "4d85aa07-9615-44c1-bf86-7dd8ba55f803",
                                "sense_id": "374f754e-f843-37a3-a32b-9c9193f48bbc",
                                "text": "On se restaure en communauté, ce qui permet de débreffer les plongées et de préparer les prochaines, tout en se pourléchant les babines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2efaef48-8ba5-4c8b-ab77-8c59bd2756c0",
                        "source_entry_id": "4a3d2309-4d4e-38ce-9663-7a683c0ca773",
