                    "frequency": "Middle",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un homme profondément <w>vertueux</w> qui a toujours aidé les plus démunis."
                        },
                        {
                            "text": "Elle menait une vie simple et <w>vertueuse</w> loin du tumulte des grandes villes."
                        }
