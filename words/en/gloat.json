    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7bd44b82-aaf6-3b5b-ad21-4fe9f7a2a39d",
                    "sense_definition": "To feel or express great, often malicious, satisfaction or pleasure at one's own success or another's misfortune.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malicious_satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You did well to win the game, but there is no need to <w>gloat</w> about it."
                        },
                        {
                            "text": "He tried not to <w>gloat</w> over his rival's sudden failure."
                        }
                    ],
                    "synonyms": [
                        "boast",
                        "brag",
                        "crow",
                        "revel",
                        "triumph"
                    ],
                    "antonyms": [
                        "commiserate",
                        "sympathize"
                    ],
                    "common_phrases": [
                        "gloat over",
                        "gloat about"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b83e726a-cb8d-358d-80dd-72241a55bca2",
                    "sense_definition": "An act or instance of gloating; a display of malicious or boastful pleasure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "malicious_satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She could not resist a brief <w>gloat</w> after proving all her critics wrong."
                        },
                        {
                            "text": "His quiet smile seemed less like happiness and more like an unpleasant <w>gloat</w>."
                        }
                    ]
                }
            ]
        }
    ]
