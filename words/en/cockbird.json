    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f20503d7-a95e-3f80-870d-95b4b2d5e89d",
                    "sense_definition": "The male of any bird species.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "male_bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Then the old <w>cockbird</w> - he can be distinguished by his brighter plumage - hops out into full view.",
                            "target_lang_translations": {
                                "ru": "Затем старый <w>самец</w> — его можно отличить по более яркому оперению — выпрыгивает на всеобщее обозрение."
                            }
                        },
                        {
                            "text": "The <w>cockbird</w> sang loudly to defend his territory from other males.",
                            "target_lang_translations": {
                                "ru": "<w>Самец</w> громко пел, защищая свою территорию от других мужских особей."
                            }
                        }
                    ],
                    "synonyms": [
                        "cock"
                    ],
                    "antonyms": [
                        "hen"
                    ],
                    "common_phrases": [
                        "bright cockbird plumage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец любого вида птиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самец",
                                "target_lang_sense_clarification": "общее обозначение мужской особи птицы"
                            },
                            {
                                "target_lang_word": "петух",
                                "target_lang_sense_clarification": "в широком смысле о самцах некоторых видов птиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21dc1f72-5ce1-34b5-be0a-1028bb7be1cb",
                    "sense_definition": "The male of a game bird, especially a pheasant.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "male_bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters were specifically looking for a <w>cockbird</w> during the pheasant season.",
                            "target_lang_translations": {
                                "ru": "Охотники специально искали <w>петуха</w> во время сезона охоты на фазанов."
                            }
                        },
                        {
                            "text": "A beautiful <w>cockbird</w> pheasant rose from the tall grass with a loud whirring of wings.",
                            "target_lang_translations": {
                                "ru": "Прекрасный <w>петух</w> фазана поднялся из высокой травы с громким шумом крыльев."
                            }
                        }
                    ],
                    "synonyms": [
                        "cock-pheasant"
                    ],
                    "common_phrases": [
                        "cockbird pheasant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец промысловой птицы, особенно фазана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "петух",
                                "target_lang_sense_clarification": "самец фазана или другой дичи"
                            },
                            {
                                "target_lang_word": "самец фазана",
                                "target_lang_sense_clarification": "конкретное указание на вид"
                            }
                        ]
                    }
                }
            ]
        }
    ]
