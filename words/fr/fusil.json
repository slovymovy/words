                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason de cette petite commune porte un <w>fusil</w> d'or posé en fasce."
