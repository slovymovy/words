                        "examples": [
                            {
                                "example_id": "819534bd-1134-4c83-842d-74afe6c05aa8",
                                "sense_id": "d51af710-bee9-316c-ae94-3292b1bec87c",
                                "text": "Frau Zyrus ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e735c971-4b1e-4f3d-8140-407fdbd180a2",
                                "sense_id": "d51af710-bee9-316c-ae94-3292b1bec87c",
                                "text": "Herr Zyrus wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "160f326e-4ed7-4bf2-bf40-21ea8fb8db90",
                                "sense_id": "d51af710-bee9-316c-ae94-3292b1bec87c",
                                "text": "Die Zyrus' fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "61618dff-2e50-4eb7-aac3-486b9adf3789",
                                "sense_id": "d51af710-bee9-316c-ae94-3292b1bec87c",
                                "text": "Der Zyrus trägt nie die Schals, die die Zyrus ihm strickt."
                            },
                            {
                                "example_id": "8a05e419-27c4-496c-bee3-4c715135c388",
                                "sense_id": "d51af710-bee9-316c-ae94-3292b1bec87c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zyrus kommt, geht der Herr Zyrus.“"
                            },
                            {
                                "example_id": "238bfc0e-6e05-469e-9293-dda4a5e61390",
                                "sense_id": "d51af710-bee9-316c-ae94-3292b1bec87c",
                                "text": "Zyrus kommt und geht."
                            },
                            {
                                "example_id": "84f23d04-dcda-469d-be49-a0bfed2ecdf9",
                                "sense_id": "d51af710-bee9-316c-ae94-3292b1bec87c",
                                "text": "Zyrus' kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
