                "senses": [
                    {
                        "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                        "entry_id": "d972d028-885a-365b-9646-3ed5040f0ffc",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8822ac20-ef41-4618-8d42-740c88d83053",
                                "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                                "text": "Frau Ungru ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6b86e1ae-8a9c-4a17-94c3-73b22d588d20",
                                "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                                "text": "Herr Ungru wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8c21ef50-36c9-4668-9004-886f63e3d77e",
                                "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                                "text": "Die Ungrus fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "da2b2698-fa0f-4249-bf35-fb3e332ad08e",
                                "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                                "text": "Der Ungru trägt nie die Schals, die die Ungru ihm strickt."
                            },
                            {
                                "example_id": "2faf5358-7834-42ce-a980-bcdc11ed520f",
                                "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ungru kommt, geht der Herr Ungru.“"
                            },
                            {
                                "example_id": "78723dc1-09f7-4607-b0ce-86b7b5c946a4",
                                "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                                "text": "Ungru kommt und geht."
                            },
                            {
                                "example_id": "316aa5d7-b5d3-451c-9acd-f0d12c513cc9",
                                "sense_id": "281372c6-3381-3ba6-b7f7-5b3b57b83d93",
                                "text": "Ungrus kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
