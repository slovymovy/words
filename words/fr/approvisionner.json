    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09f41ed5-a8de-36bc-b1e4-42d4b993f164",
                    "sense_definition": "Fournir à quelqu'un ou à un lieu ce qui est nécessaire à sa subsistance ou à son fonctionnement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ravitaillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce camion vient régulièrement <w>approvisionner</w> le magasin du village en fruits frais."
                        },
                        {
                            "text": "La ville a du mal à <w>approvisionner</w> les habitants en eau potable durant l'été."
                        }
                    ],
                    "synonyms": [
                        "ravitailler",
                        "fournir",
                        "alimenter"
                    ],
                    "antonyms": [
                        "démunir",
                        "priver"
                    ],
                    "common_phrases": [
                        "approvisionner le marché",
                        "approvisionner en carburant",
                        "approvisionner en eau"
                    ]
                },
                {
                    "sense_id": "1b4ba844-c19b-3098-8bb6-d3dfa61dd421",
                    "sense_definition": "Se procurer des vivres ou des ressources indispensables, faire des provisions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ravitaillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs doivent s'<w>approvisionner</w> en vivres avant de traverser la montagne."
                        },
                        {
                            "text": "Nous préférons nous <w>approvisionner</w> directement chez les petits producteurs de la région."
                        }
                    ],
                    "synonyms": [
                        "se ravitailler",
                        "se fournir"
                    ],
                    "common_phrases": [
                        "s'approvisionner en nourriture"
                    ]
                },
                {
                    "sense_id": "250c0aa6-b01e-3b46-ab9d-2319fa55a246",
                    "sense_definition": "Alimenter un compte bancaire avec une somme d'argent suffisante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>approvisionner</w> ce compte avant d'émettre un chèque important."
                        },
                        {
                            "text": "Elle a oublié d'<w>approvisionner</w> son compte bancaire avant les prélèvements automatiques."
                        }
                    ],
                    "synonyms": [
                        "alimenter",
                        "créditer"
                    ],
                    "antonyms": [
                        "débiter"
                    ],
                    "common_phrases": [
                        "approvisionner un compte",
                        "approvisionner son compte bancaire"
                    ]
                },
                {
                    "sense_id": "e0a877fb-01d2-3d3e-ba6a-af45dd0eef36",
                    "sense_definition": "Garnir une arme à feu avec ses munitions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde a reçu l'ordre formel d'<w>approvisionner</w> son arme avant la patrouille."
                        },
                        {
                            "text": "Les recrues apprennent comment <w>approvisionner</w> un fusil rapidement et en toute sécurité."
                        }
                    ],
                    "synonyms": [
                        "charger"
                    ],
                    "antonyms": [
                        "décharger",
                        "désapprovisionner"
                    ],
                    "common_phrases": [
                        "approvisionner une arme"
                    ]
                }
            ]
        }
    ]
