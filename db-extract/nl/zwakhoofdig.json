                        "examples": [
                            {
                                "example_id": "fb609237-1855-42bf-8ae3-8dcf82a2b2f7",
                                "sense_id": "c1a81ec3-9c06-3a9f-b4b8-42e91c9882c4",
                                "text": "Toegegeven: eenmaal aan het vliegen, ziet het er goed uit. Bléven ze daar maar, hoog aan de hemel, ver van ons weg. Maar nee, ze trekken een lijntje door de lucht en gaan vervolgens weer zitten lijntrekken op een daknok of een schutting. En maar zwakhoofdig door de mooiste concerten van andere vogels heenkoeren: roekoéhoehoe, roekoéhoehoe."
                            }
                        ]
                    }
