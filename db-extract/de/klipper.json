                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "958bcda0-290e-4f25-adf2-a0d5ddbe1d09",
                        "source_entry_id": "157c9e14-a525-3314-9e9e-8827c8ca91de",
                        "source_sense_id": "37f70433-f5a6-31fa-9493-b318b701a74e",
