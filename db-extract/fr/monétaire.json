                                            {
                                                "example_id": "8559801a-fb91-4804-b153-d4ee8cf712c0",
                                                "sense_id": "8c4350f0-32e2-33f6-8fad-b43a96ae024f",
                                                "text": "Monetär sieht es bei mir zur Zeit ziemlich schlecht aus."
                                            }
