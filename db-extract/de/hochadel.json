                        "sense_id": "0f5ff20e-60a2-325f-94e2-f9e6aeb5454f",
                        "entry_id": "515dd2c0-9df3-3719-9e81-63d60cf65d63",
                        "glosses": [
                            "Gesamtheit der regierenden/ehemals regierenden, höchsten Adelsgeschlechter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c587123-5e04-49cd-b5e3-5d6857abc5e1",
                                "sense_id": "0f5ff20e-60a2-325f-94e2-f9e6aeb5454f",
                                "text": "„Thurn und Taxis ist ein in den Hochadel aufgestiegenes Adelsgeschlecht, das seit 1748 in Regensburg ansässig ist und im 16. bis 18. Jahrhundert seinen Aufstieg und Reichtum als Postunternehmen erlangte.“"
                            },
                            {
                                "example_id": "8ad4a1bd-0f17-4632-bb60-bde109861b10",
                                "sense_id": "0f5ff20e-60a2-325f-94e2-f9e6aeb5454f",
                                "text": "„Zum Hochadel konnte man wohl nur durch Geburt oder Einheirat gehören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
