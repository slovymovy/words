                "senses": [
                    {
                        "sense_id": "6f6d4443-badb-3523-83aa-a56d53c08d50",
                        "entry_id": "8d92092b-55ab-3539-a946-488486ea5ac6",
                        "glosses": [
                            "жарг. человек, пьющий или способный выпить много спиртного; пьяница"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f276af55-99f8-4b76-add0-e4ca11612e20",
                                "sense_id": "6f6d4443-badb-3523-83aa-a56d53c08d50",
                                "text": "Питухи бывают двух родов: пьяницы, ничего не делающие, и выпивающие ради чего-нибудь."
                            },
                            {
                                "example_id": "08fcc63e-be50-4014-8f54-6bcb42cbeca7",
                                "sense_id": "6f6d4443-badb-3523-83aa-a56d53c08d50",
                                "text": "На другой день ― даже у крепких питухов ― жестокая головная боль."
                            }
                        ]
                    }
                ],
