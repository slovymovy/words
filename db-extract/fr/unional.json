                "senses": [
                    {
                        "sense_id": "f9eac167-21af-3119-bc24-b041da54b1a4",
                        "entry_id": "95d34bdc-0323-343a-afc1-c2129cdacbcd",
                        "glosses": [
                            "Relatif à une union."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8235ead6-786c-4019-a662-11599e34e77e",
                                "sense_id": "f9eac167-21af-3119-bc24-b041da54b1a4",
                                "text": "Grâce à l’aide de la part de l’État fédératif unional et des républiques soviétiques-sœurs la RASSM, comme tout le pays, a créé la grande production industrielle et agricole."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7d1b204-806a-3a79-9390-301fe05ad083",
                        "entry_id": "95d34bdc-0323-343a-afc1-c2129cdacbcd",
                        "glosses": [
                            "Relatif à l'Union européenne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "857f1e50-5e6b-4eb1-b241-a1adbe1d67c4",
                                "sense_id": "e7d1b204-806a-3a79-9390-301fe05ad083",
                                "text": "Ce n’est que le droit international classique qui nous intéresse ici, à l’exclusion des spécificités du droit unional européen en matière des droits fondamentaux."
                            },
                            {
                                "example_id": "eca4b41c-4947-4346-b6ba-e2e44d02e2a0",
                                "sense_id": "e7d1b204-806a-3a79-9390-301fe05ad083",
                                "text": "Ainsi, l’analyse des modalités d'insertion du droit unional dans les ordres juridiques nationaux a permis de révéler que le titre de compétence du juge national ne saurait s’appréhender indépendamment de la nature du système au sein duquel il exerce son office."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8856f386-3411-4815-9bf9-154c1c1ac02f",
                        "source_entry_id": "95d34bdc-0323-343a-afc1-c2129cdacbcd",
                        "target_lang_word": "unional",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unional",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec588bbb-9059-3245-9e3f-a3f5a452c15e",
                                        "entry_id": "27082294-bb8d-3d10-839d-647f626be697",
                                        "glosses": [
                                            "sich auf eine Union – insbesondere die Europäische Union – beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a03b6331-5a8a-4b87-a751-aee4c97f8799",
                                                "sense_id": "ec588bbb-9059-3245-9e3f-a3f5a452c15e",
                                                "text": "„Die Etablierung des unionalen Dokumentenzugangsrechts ist nicht abgeschlossen, sondern zahlreichen Konfliktlagen ausgesetzt.“"
                                            },
                                            {
                                                "example_id": "debd7d84-5471-4e28-a382-a068530315e9",
                                                "sense_id": "ec588bbb-9059-3245-9e3f-a3f5a452c15e",
                                                "text": "„Fraglich ist nun also, wann eine mitgliedstaatliche Stelle unionale Hoheitsgewalt ausübt.“"
                                            },
                                            {
                                                "example_id": "6636728b-4867-429f-9460-c0741bcb7ebe",
                                                "sense_id": "ec588bbb-9059-3245-9e3f-a3f5a452c15e",
                                                "text": "„Die bisherige Untersuchung hat im Wesentlichen zu der Erkenntnis geführt, dass erstens sowohl die unionale als auch die grundgesetzliche Verfassung kooperationsoffen konzipiert sind und dass zweitens keine der beiden Verfassungen in der Lage ist, die gesamte den Bürger betreffende Hoheitsgewalt zu begrenzen.“"
                                            },
                                            {
                                                "example_id": "cf27a428-fa4f-4d59-91f0-66e3b8892613",
                                                "sense_id": "ec588bbb-9059-3245-9e3f-a3f5a452c15e",
                                                "text": "„Im Primärrecht verankerte Schranken für die unionale Hoheitsausübung beschränken ihren Anwendungsbereich.“"
                                            },
                                            {
                                                "example_id": "36790d63-fa89-425f-9445-10a56390b50b",
                                                "sense_id": "ec588bbb-9059-3245-9e3f-a3f5a452c15e",
                                                "text": "„Dualistisch geprägte Verfassungen enthalten in ihren Verfassungen eine Verweisung auf das Unionsrecht, die im Konfliktfall einer nationalen Sachnorm mit einer unionalen Sachnorm entweder als Sachnormverweisung direkt die unionale Sachnorm zur Anwendung beruft oder als Gesamtverweisung auf den Vorrang des Unionsrechts als unionale Kollisionsnorm verweist, der seinerseits als einseitige Kollisionsnorm die unionale Sachnorm zur Anwendung beruft.“"
                                            },
                                            {
                                                "example_id": "364c51c8-1d8c-4e53-b8af-98158b67ac80",
                                                "sense_id": "ec588bbb-9059-3245-9e3f-a3f5a452c15e",
                                                "text": "„Ob es von ukrainischen oder russischen Prätendenten beansprucht werden konnte, richtete sich u.a. nach der Rechtsstellung sowjetischer Staatsbetriebe sowie den unionalen (sowjetischen) und den ukrainischen Republiksvorschriften über die Privatisierung von Staatsbetrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd168359-f102-4d52-9aac-bb286b017832",
                        "source_entry_id": "95d34bdc-0323-343a-afc1-c2129cdacbcd",
