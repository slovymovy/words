                "senses": [
                    {
                        "sense_id": "e8b8e061-d91a-35af-88f9-19bbaba4a372",
                        "entry_id": "55caa3bc-e1b2-3c59-88bb-04ce4353cc83",
                        "glosses": [
                            "Personne qui jouit d’un fonds par bail emphytéotique."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "1a0e16f1-6d29-4703-9850-8d4c4ac29c99",
                                "sense_id": "e8b8e061-d91a-35af-88f9-19bbaba4a372",
                                "text": "Déjà mademoiselle courait en bas désamorcer un conflit entre deux emphytéotes, l’un polonais, l’autre ruthène, qui se disputaient la jouissance d’une mare et des carpes qu’on y pêchait."
                            },
                            {
                                "example_id": "53b0cc97-6e27-4438-b7c7-07b917b5eefa",
                                "sense_id": "e8b8e061-d91a-35af-88f9-19bbaba4a372",
                                "text": "La vente seule fait exception ; dans ce cas, en effet, l’emphytéote doit avoir le consentement du propriétaire qui a le droit de rachat si ses offres égalent celles l’acheteur."
                            }
                        ]
                    }
                ],
