                "senses": [
                    {
                        "sense_id": "24eac5b8-2f3b-3159-8b39-3e1c74ab53ba",
                        "entry_id": "cfa72f74-67de-35b9-a09d-00feee1eddc1",
                        "glosses": [
                            "Un des espaces de la vie de l’être humain, quand on en divise tout le cours en périodes de sept ans, à compter du jour de la naissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e84ace5-72e6-4ea1-b811-33c458677f4f",
                                "sense_id": "24eac5b8-2f3b-3159-8b39-3e1c74ab53ba",
                                "text": "Premier septénaire."
                            },
                            {
                                "example_id": "b4f882a1-68e1-4e09-8b0f-6012132746ea",
                                "sense_id": "24eac5b8-2f3b-3159-8b39-3e1c74ab53ba",
                                "text": "Second septénaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b805150-5860-3276-a112-ae1638062061",
                        "entry_id": "cfa72f74-67de-35b9-a09d-00feee1eddc1",
                        "glosses": [
                            "Ensemble de sept éléments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cb4ef9d-7993-403a-81d9-04ddb8cee4e1",
                                "sense_id": "7b805150-5860-3276-a112-ae1638062061",
                                "text": "L'Apocalypse de saint Jean contient trois septénaires successifs : l'ouverture des sept sceaux, le retentissement des sept trompettes et la suite des sept coupes."
                            },
                            {
                                "example_id": "38f99c98-8a00-4397-9c78-8cce1bcf4d95",
                                "sense_id": "7b805150-5860-3276-a112-ae1638062061",
                                "text": "La confession ainsi renouvelée prend place dans une nouvelle conception des sacrements qui s'organise en septénaire à l'intérieur d'un nouveau système qui comprend aussi le septénaire des péchés capitaux et celui des dons du Saint Esprit."
                            }
                        ]
                    }
