                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd518e6-91fc-4467-875b-d3d0a9df2496",
                                                "sense_id": "2e200e60-2a5d-3e1d-aeba-638a15aa9206",
                                                "text": "Moja przyrodnia siostra, która jest Polką greckiego pochodzenia, ma na imię Kasandra."
                                            },
                                            {
                                                "example_id": "0e86f0bd-e29a-4cdd-ae1e-1efc586c192e",
                                                "sense_id": "2e200e60-2a5d-3e1d-aeba-638a15aa9206",
                                                "text": "Dziś udało nam się zamienić parę słów z zawodniczką kadry Marcina Kasprowicza, Kasandrą Parczewską"
                                            },
                                            {
                                                "example_id": "7e414f24-9c52-4902-8b16-d9d662026ff6",
                                                "sense_id": "2e200e60-2a5d-3e1d-aeba-638a15aa9206",
                                                "text": "Kasandry imieniny obchodzą 22 stycznia."
                                            }
                                        ],
