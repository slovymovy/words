    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c3e1708-3160-3b89-bf42-76c131736174",
                    "sense_definition": "myć kogoś lub zwierzę poprzez zanurzenie w wodzie, zwłaszcza w wannie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama codziennie wieczorem <w>kąpie</w> małe dziecko w wanience.",
                            "target_lang_translations": {
                                "ru": "Мама каждый вечер <w>купает</w> маленького ребёнка в ванночке."
                            }
                        },
                        {
                            "text": "Musimy dokładnie <w>kąpać</w> psa po każdym spacerze w deszczu.",
                            "target_lang_translations": {
                                "ru": "Мы должны тщательно <w>мыть</w> собаку после каждой прогулки под дождём."
                            }
                        }
                    ],
                    "synonyms": [
                        "myć"
                    ],
                    "antonyms": [
                        "brudzić"
                    ],
                    "common_phrases": [
                        "kąpać dziecko",
                        "kąpać psa"
                    ],
                    "target_lang_definitions": {
                        "ru": "мыть кого-либо (человека или животное), погружая в воду, особенно в ванну"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купать",
                                "target_lang_sense_clarification": "кого-либо (ребёнка, животное)"
                            },
                            {
                                "target_lang_word": "мыть",
                                "target_lang_sense_clarification": "проводить гигиенические процедуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1878289b-0c46-313b-951f-66263fff845a",
                    "sense_definition": "zanurzać się w wodzie w celach higienicznych lub wypoczynkowych",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mycie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Latem bardzo chętnie <w>kąpiemy</w> się w pobliskim czystym jeziorze.",
                            "target_lang_translations": {
                                "ru": "Летом мы с большим удовольствием <w>купаемся</w> в близлежащем чистом озере."
                            }
                        },
                        {
                            "text": "Po długim i męczącym dniu lubię <w>kąpać</w> się w ciepłej wodzie z pianą.",
                            "target_lang_translations": {
                                "ru": "После долгого и утомительного дня я люблю <w>купаться</w> в тёплой воде с пеной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kąpać się w wannie",
                        "kąpać się w jeziorze",
                        "kąpać się w morzu"
                    ],
                    "target_lang_definitions": {
                        "ru": "погружаться в воду в гигиенических целях или для отдыха (с возвратной частицей «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купаться",
                                "target_lang_sense_clarification": "в водоёме или в ванне"
                            },
                            {
                                "target_lang_word": "принимать ванну",
                                "target_lang_sense_clarification": "в ванне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3e4c9f8-570e-3906-ba8e-c9218ea83b96",
                    "sense_definition": "zanurzać przedmiot w cieczy w celu obróbki chemicznej, termicznej lub pokrycia go powłoką",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej fabryce robotnicy <w>kąpią</w> metalowe elementy w specjalnym roztworze kwasu.",
                            "target_lang_translations": {
                                "ru": "На этой фабрике рабочие <w>погружают</w> металлические элементы в специальный раствор кислоты."
                            }
                        },
                        {
                            "text": "Przed malowaniem należy starannie <w>kąpać</w> stalowe części w odtłuszczaczu.",
                            "target_lang_translations": {
                                "ru": "Перед покраской следует тщательно <w>вымачивать</w> стальные детали в обезжиривателе."
                            }
                        }
                    ],
                    "synonyms": [
                        "zanurzać",
                        "moczyć"
                    ],
                    "common_phrases": [
                        "kąpać w roztworze"
                    ],
                    "target_lang_definitions": {
                        "ru": "погружать предмет в жидкость для химической, термической обработки или нанесения покрытия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымачивать",
                                "target_lang_sense_clarification": "детали в растворе"
                            },
                            {
                                "target_lang_word": "погружать",
                                "target_lang_sense_clarification": "в технологическую ванну"
                            },
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "в кислоте или химическом растворе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}