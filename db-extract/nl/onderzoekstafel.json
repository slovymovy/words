                        "sense_id": "fec348c0-8835-3512-8c88-5e48c35ae194",
                        "entry_id": "12e99c4a-d264-3d57-b0ea-9b6a79e8944f",
                        "glosses": [
                            "bank waarop de patiënt ligt die door de art onderzocht en behandeld wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f594e807-f3e7-46df-8d06-3ea5d9103ab3",
                                "sense_id": "fec348c0-8835-3512-8c88-5e48c35ae194",
                                "text": "De bank op de steiger, waar mijn grootvader zijn pijp placht te roken nadat hij de botnetten had schoongemaakt, gebruik ik tegenwoordig als onderzoekstafel voor Jansson."
                            },
                            {
                                "example_id": "58c418d9-008d-4404-86f4-936381e0984b",
                                "sense_id": "fec348c0-8835-3512-8c88-5e48c35ae194",
                                "text": "Ieder bewaakt door een agent werden ze naar de Eerste Hulp overgebracht en afzonderlijk van elkaar behandeld. Vanaf de onderzoekstafel scholden ze hun arts en verpleegkundige de huid vol. \"Teksten als: 'ik weet je wel te vinden. Ik weet waar je woont. Ik krijg je wel.' Heel bedreigend\", vertelt Edwards."
                            }
                        ]
                    }
