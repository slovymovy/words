                "senses": [
                    {
                        "sense_id": "b389a944-af44-3d55-917a-b1d353fd4efd",
                        "entry_id": "afc4b721-d43a-30ad-afeb-f0030ed17be2",
                        "glosses": [
                            "Staat im südöstlichen Teil des Amerikanischen Mittelmeers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2364e1d-a53d-43e3-a769-6d0302c71317",
                                "sense_id": "b389a944-af44-3d55-917a-b1d353fd4efd",
                                "text": "„Der Karibikstaat, der auch heute noch von der tropischen Plantagenwirtschaft lebt, lockt seit dem Aufschwung der Tourismusindustrie Millionen von ausländischen Gästen an.“"
                            },
                            {
                                "example_id": "94ebed55-819a-4cc1-820e-65491e8ac009",
                                "sense_id": "b389a944-af44-3d55-917a-b1d353fd4efd",
                                "text": "„Heute ist der Karibikstaat, der 1804 als erstes Land Lateinamerikas die Unabhängigkeit erreichte, wirtschaftlich und politisch zerrüttet.“"
                            },
                            {
                                "example_id": "083fea1c-4158-448d-9800-e8a6f870cee6",
                                "sense_id": "b389a944-af44-3d55-917a-b1d353fd4efd",
                                "text": "„In vielen Karibikstaaten, aber auch z. B. in Fidschi, auf den Malediven und Seychellen ist die Volkswirtschaft einseitig auf den Tourismus ausgerichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
