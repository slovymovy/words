                "senses": [
                    {
                        "sense_id": "fb1c8fd2-35ca-33e9-88d5-d4f174bf28ec",
                        "entry_id": "fdb741df-4b1b-3b1d-b1c3-36feda8b10bd",
                        "glosses": [
                            "kraina geograficzna w południowej części Ameryki Południowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead4d83b-bc10-4ea1-8645-60740ac3d750",
                                "sense_id": "fb1c8fd2-35ca-33e9-88d5-d4f174bf28ec",
                                "text": "Jedną z twierdz odkryto w Patagonii, w Río Negro nad zatoką San Matías. Odkopano tam jej fundamenty, a także półmetrowe, symboliczne drzewo życia […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11bd4610-fb55-4cc7-91a7-8b2ebc6351d6",
                        "source_entry_id": "fdb741df-4b1b-3b1d-b1c3-36feda8b10bd",
                        "source_sense_id": "fb1c8fd2-35ca-33e9-88d5-d4f174bf28ec",
                        "target_lang_word": "Patagonia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patagonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9392b9c-706c-394d-9fdd-b3090fc9a6b4",
                                        "entry_id": "ea334141-68bd-3071-a995-98c5a656fd92",
                                        "glosses": [
                                            "A geographical region in southern South America, including the southern parts of Chile and Argentina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aab9d1e-144f-4db4-a5d6-8421779e95c1",
                                                "sense_id": "d9392b9c-706c-394d-9fdd-b3090fc9a6b4",
                                                "text": "CHILI, a province of ſouth America, bounded by Peru on the north, by the province of La Plata on the eaſt, by Patagonia on the ſouth, and by the Pacific ocean on the weſt... But ſome comprehend Patagonia in Chili, extending it to cape Horn..."
                                            },
                                            {
                                                "example_id": "b2a65403-b010-40f0-a800-4e4234285fad",
                                                "sense_id": "d9392b9c-706c-394d-9fdd-b3090fc9a6b4",
                                                "text": "The pampas of Argentina and the chilly wastes of Patagonia, like the prairies and deserts of North America, were largely shunned by Spanish settlers until the 1870s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d75aff-85a4-3e68-b25a-10a9af417305",
                                        "entry_id": "ea334141-68bd-3071-a995-98c5a656fd92",
                                        "glosses": [
                                            "A town in Arizona."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f05b58fd-b2bc-4cde-be99-36f3ce76736c",
                        "source_entry_id": "fdb741df-4b1b-3b1d-b1c3-36feda8b10bd",
                        "source_sense_id": "fb1c8fd2-35ca-33e9-88d5-d4f174bf28ec",
