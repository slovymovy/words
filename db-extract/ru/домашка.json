                "senses": [
                    {
                        "sense_id": "a2eaaa0f-710b-351e-b9f9-d30e7c6ec8c6",
                        "entry_id": "ddf43098-6fbd-3f68-8d16-fb0109ce919f",
                        "glosses": [
