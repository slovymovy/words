                "senses": [
                    {
                        "sense_id": "5a36c6f6-996f-346e-8d2d-c0b76ce14066",
                        "entry_id": "08607a05-6abf-3899-b2b1-e509e9d4ca08",
                        "glosses": [
                            "die Blätter bzw. die Belaubung der Rebstöcke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c350a33-87d9-4f4e-a02f-b7ac8a17c2f4",
                                "sense_id": "5a36c6f6-996f-346e-8d2d-c0b76ce14066",
                                "text": "Das herbstliche Weinlaub gefällt mir besonders."
                            },
                            {
                                "example_id": "16390570-74a9-4790-af06-dcd39181d394",
                                "sense_id": "5a36c6f6-996f-346e-8d2d-c0b76ce14066",
                                "text": "„Häufig sind in den Gräbern Szenen aus der Weinlese dargestellt; sehr beliebt war auch die Siesta unter Weinlaub, mit dick herabhängenden Trauben.“"
                            },
                            {
                                "example_id": "3710ae5c-d2fe-4010-83ed-9853c593a3d0",
                                "sense_id": "5a36c6f6-996f-346e-8d2d-c0b76ce14066",
                                "text": "„Weinlaub hängt herein.“"
                            },
                            {
                                "example_id": "6df00440-3b3c-4568-b685-2f978b965859",
                                "sense_id": "5a36c6f6-996f-346e-8d2d-c0b76ce14066",
                                "text": "„Direkt an der Mosel gab es das »Weinhaus Gries«, das eine schöne, offene Terrasse mit viel Weinlaub drum herum hat, hier waren noch viele Tische frei, und so setzten wir uns an einen der freien Tische und ruhten aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
