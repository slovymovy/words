                        "glosses": [
                            "A female pianist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d31e0caa-85c1-4df2-9d70-ace7658699af",
                                "sense_id": "5d8503c4-ccc5-36f5-b576-361363d8526e",
                                "text": "I have never published any of my compositions because I feel that they cannot add anything to my reputation as a pianiste, of which I am—-"
                            },
                            {
                                "example_id": "b5fc6b04-2c5e-49b7-879e-a5a6e828e79f",
                                "sense_id": "5d8503c4-ccc5-36f5-b576-361363d8526e",
                                "text": "Not only did Carré state that she could covertly contact a pianiste, but this man had also managed to evade capture by the Germans!"
                            },
                            {
                                "example_id": "71d6c0fa-56d9-490e-8dab-bb31d50a2188",
                                "sense_id": "5d8503c4-ccc5-36f5-b576-361363d8526e",
                                "text": "Margaret is in the drawing room, thumping the life from some unfortunate sonata. She is persistent, but she will never make a pianiste."
                            }
                        ]
                    }
                ],
