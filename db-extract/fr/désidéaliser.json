                "senses": [
                    {
                        "sense_id": "a74d701e-e57e-3f59-ac91-9e057ab69fa8",
                        "entry_id": "c5d3aae6-4607-356c-8f40-614ce5e7cfe2",
                        "glosses": [
                            "Faire perdre son caractère idéalisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "186e94c2-2157-414f-b3db-d4d460542e69",
                                "sense_id": "a74d701e-e57e-3f59-ac91-9e057ab69fa8",
                                "text": "Cela l'oblige à désidéaliser les images parentales."
                            },
                            {
                                "example_id": "21a69e0a-c7d4-4545-a9bb-48c04f085a0f",
                                "sense_id": "a74d701e-e57e-3f59-ac91-9e057ab69fa8",
                                "text": "Sa critique veut « désidéaliser l’auteur»."
                            },
                            {
                                "example_id": "3d64e066-d927-4f0c-9ff0-f81d4080c1fa",
                                "sense_id": "a74d701e-e57e-3f59-ac91-9e057ab69fa8",
                                "text": "Nous avons, aujourd’hui plus que jamais, à nous en prendre à la figure humaine, à la désidéaliser, la désidoliser, faire chuter son socle, briser son visage, la répandre en morceaux."
                            }
                        ]
                    }
