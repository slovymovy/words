                "senses": [
                    {
                        "sense_id": "4aff2ba5-ab46-306b-a74a-7b11f6b621d2",
                        "entry_id": "782b8d69-fc49-3ee2-b765-a58de6b244c2",
                        "glosses": [
                            "Relatif aux sondages d’opinion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "764a8a49-7a62-4a14-b8b7-7e6bd171d60a",
                                "sense_id": "4aff2ba5-ab46-306b-a74a-7b11f6b621d2",
                                "text": "Le président sera aux États-Unis lundi et mardi pour un voyage officiel, où il rencontrera Barack Obama. Un séjour attendu depuis des mois, qui tombe bien après la défaite des régionales et en plein marasme sondagier."
                            },
                            {
                                "example_id": "334ff9e9-0e26-4d9f-a7d8-733a33d998d0",
                                "sense_id": "4aff2ba5-ab46-306b-a74a-7b11f6b621d2",
                                "text": "Pour expliquer que le vote Hollande est une bulle artificielle et que la campagne du candidat socialiste est l’histoire d’un lent et inexorable déclin, notre stratège sarkozyste multiplie pourtant les références sondagières."
                            },
                            {
                                "example_id": "424a523d-0235-437b-9369-b91613d73020",
                                "sense_id": "4aff2ba5-ab46-306b-a74a-7b11f6b621d2",
                                "text": "Il faut y regarder de plus près. Et ne pas confondre la réalité sociologique des Français avec ses représentations tant sondagières, médiatiques que politiques."
                            }
                        ]
                    }
                ],
