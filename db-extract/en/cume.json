                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec906d1f-63f0-4be6-8353-43157af16daa",
                                "sense_id": "ef1f9ba5-b6ca-30c1-b86e-11a10a7cf05a",
                                "text": "With a cume so far of more than $38,000, the film has already outgrossed Godard’s previous feature, “Film socialisme” (2010), despite having opened on far fewer screens."
                            },
                            {
                                "example_id": "e4837d1b-accd-420e-a35e-85887cf5e4a7",
                                "sense_id": "ef1f9ba5-b6ca-30c1-b86e-11a10a7cf05a",
                                "text": "Taking into account the fact Wonder Woman opened lower than those other releases, these holds and its eventual $560-570+ million global cume after close of business Friday now all but assure Gal Gadot's Amazon princess will indeed finish its run north of $700 million."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bc219d1-2c49-35a6-8a29-4a83bf092751",
                        "entry_id": "89d58098-8fd2-335e-bc08-be287adae5f2",
