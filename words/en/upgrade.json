{
    "word_family": [
        "upgradable",
        "upgrader",
        "upgradability"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28faea60-33d0-36c5-803f-283bcd7865a7",
                    "sense_definition": "To improve something, especially a machine, system, or software, by adding new parts or installing a newer version.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "improvement_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>upgrade</w> my computer to run the latest video games.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>обновить</w> компьютер, чтобы запускать новейшие видеоигры.",
                                "zh": "我需要<w>升级</w>我的电脑才能运行最新的电子游戏。"
                            }
                        },
                        {
                            "text": "The company plans to <w>upgrade</w> its security system next month.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>модернизировать</w> свою систему безопасности в следующем месяце.",
                                "zh": "公司计划下个月<w>升级</w>其安全系统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "update",
                        "improve",
                        "modernize",
                        "enhance",
                        "advance"
                    ],
                    "antonyms": [
                        "downgrade"
                    ],
                    "common_phrases": [
                        "upgrade software",
                        "upgrade to",
                        "upgrade a system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать что-либо (особенно оборудование, систему или программное обеспечение) путем добавления новых компонентов или установки новой версии.",
                        "zh": "通过添加新部件或安装新版本来改进某物，特别是机器、系统或软件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновлять",
                                "target_lang_sense_clarification": "программное обеспечение, версии"
                            },
                            {
                                "target_lang_word": "модернизировать",
                                "target_lang_sense_clarification": "оборудование, системы"
                            },
                            {
                                "target_lang_word": "апгрейдить",
                                "target_lang_sense_clarification": "разговорное, компьютерный сленг"
                            },
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "升级",
                                "target_lang_sense_clarification": "系统、软件或设备的版本提升"
                            },
                            {
                                "target_lang_word": "更新",
                                "target_lang_sense_clarification": "软件或数据的版本更新"
                            },
                            {
                                "target_lang_word": "改进",
                                "target_lang_sense_clarification": "提升性能或质量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e59a98f6-c559-3e67-b758-97c1e4657dca",
                    "sense_definition": "To give someone a better seat on a plane, a better room in a hotel, or a higher status than they originally paid for or had.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "status_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were <w>upgraded</w> to a luxury suite because it was our anniversary.",
                            "target_lang_translations": {
                                "ru": "Нам <w>повысили класс</w> номера до люкса, так как у нас была годовщина.",
                                "zh": "因为是我们的结婚纪念日，酒店为我们<w>升级</w>到了豪华套房。"
                            }
                        },
                        {
                            "text": "The airline may <w>upgrade</w> you to business class if the flight is full.",
                            "target_lang_translations": {
                                "ru": "Авиакомпания может <w>пересадить</w> вас в бизнес-класс, если рейс переполнен.",
                                "zh": "如果航班客满，航空公司可能会为你<w>升舱</w>到商务舱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "elevate"
                    ],
                    "antonyms": [
                        "downgrade"
                    ],
                    "common_phrases": [
                        "upgrade to first class",
                        "get upgraded",
                        "upgrade a membership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять кому-либо место в самолете, номер в отеле или статус более высокого класса, чем было оплачено изначально.",
                        "zh": "为某人提供比其最初支付或拥有的级别更高的飞机座位、酒店房间或身份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышать класс",
                                "target_lang_sense_clarification": "обслуживания, номера"
                            },
                            {
                                "target_lang_word": "предоставлять лучшие условия",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "升舱",
                                "target_lang_sense_clarification": "飞机座位等级提升"
                            },
                            {
                                "target_lang_word": "升级",
                                "target_lang_sense_clarification": "酒店房间或服务等级提升"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e041da38-6b9b-3843-924c-e15623a05441",
                    "sense_definition": "A new and better version of a piece of equipment, software, or service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "improvement_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new phone is a significant <w>upgrade</w> over the previous model.",
                            "target_lang_translations": {
                                "ru": "Новый телефон — это значительное <w>улучшение</w> по сравнению с предыдущей моделью.",
                                "zh": "这款新手机比上一代机型有显著的<w>提升</w>。"
                            }
                        },
                        {
                            "text": "You can download the software <w>upgrade</w> for free from the website.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать <w>обновление</w> программного обеспечения бесплатно с веб-сайта.",
                                "zh": "你可以从网站免费下载软件<w>更新</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "update",
                        "enhancement",
                        "improvement"
                    ],
                    "antonyms": [
                        "downgrade"
                    ],
                    "common_phrases": [
                        "software upgrade",
                        "free upgrade",
                        "major upgrade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новая, улучшенная версия оборудования, программного обеспечения или услуги.",
                        "zh": "设备、软件或服务的新版本，且性能更好。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "программного обеспечения"
                            },
                            {
                                "target_lang_word": "апгрейд",
                                "target_lang_sense_clarification": "разговорное, замена на более мощное"
                            },
                            {
                                "target_lang_word": "модернизация",
                                "target_lang_sense_clarification": "процесс или результат улучшения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "升级",
                                "target_lang_sense_clarification": "指代升级后的版本或产品"
                            },
                            {
                                "target_lang_word": "更新",
                                "target_lang_sense_clarification": "指代软件的更新包"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9613111b-e6b4-39f2-8744-a9df52f29e1d",
                    "sense_definition": "The act of improving something or the state of being improved.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moving to a larger house was a real <w>upgrade</w> for the growing family.",
                            "target_lang_translations": {
                                "ru": "Переезд в дом побольше стал настоящим <w>улучшением</w> условий для растущей семьи.",
                                "zh": "对于不断壮大的家庭来说，搬进更大的房子确实是生活条件的<w>提升</w>。"
                            }
                        },
                        {
                            "text": "The hotel room was definitely an <w>upgrade</w> compared to where we stayed last time.",
                            "target_lang_translations": {
                                "ru": "Этот номер в отеле был определенно <w>лучше</w> того, где мы останавливались в прошлый раз.",
                                "zh": "与我们上次住的地方相比，这个酒店房间绝对是种<w>升级</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "improvement",
                        "betterment"
                    ],
                    "antonyms": [
                        "downgrade",
                        "step back"
                    ],
                    "common_phrases": [
                        "be an upgrade",
                        "need an upgrade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по улучшению чего-либо или состояние улучшения; шаг вперед по сравнению с прошлым.",
                        "zh": "改进某事物的行为，或处于被改进的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшение",
                                "target_lang_sense_clarification": "качества, условий"
                            },
                            {
                                "target_lang_word": "усовершенствование",
                                "target_lang_sense_clarification": "внесение улучшений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提升",
                                "target_lang_sense_clarification": "质量或条件的改善"
                            },
                            {
                                "target_lang_word": "改进",
                                "target_lang_sense_clarification": "状态的优化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed7939fb-5577-3790-aed0-bc8326f5dae8",
                    "sense_definition": "An upward slope on a road or railway.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy train moved slowly along the steep <w>upgrade</w>.",
                            "target_lang_translations": {
                                "ru": "Тяжелый поезд медленно двигался по крутому <w>подъёму</w>.",
                                "zh": "沉重的火车在陡峭的<w>上坡</w>上缓慢行驶。"
                            }
                        },
                        {
                            "text": "Cyclists often find the long <w>upgrade</w> to the summit very exhausting.",
                            "target_lang_translations": {
                                "ru": "Велосипедисты часто находят длинный <w>подъём</w> к вершине очень утомительным.",
                                "zh": "骑行者常觉得通往顶峰的长<w>上坡</w>非常耗费体力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incline",
                        "ascent",
                        "slope"
                    ],
                    "common_phrases": [
                        "steep upgrade",
                        "long upgrade"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in US English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок дороги или железнодорожного пути, идущий вверх; крутой склон.",
                        "zh": "道路或铁路上的上坡路段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "дороги, пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上坡",
                                "target_lang_sense_clarification": "道路的坡度"
                            },
                            {
                                "target_lang_word": "坡道",
                                "target_lang_sense_clarification": "倾斜的路径"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a73c86eb-1c39-321c-82dc-cad46d824fce",
                    "sense_definition": "Moving upwards along a slope or grade.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to walk <w>upgrade</w> for several miles to reach the peak.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось идти <w>вверх по склону</w> несколько миль, чтобы добраться до вершины.",
                                "zh": "徒步旅行者必须<w>上坡</w>走几英里才能到达顶峰。"
                            }
                        },
                        {
                            "text": "Driving <w>upgrade</w> requires more engine power than driving on a flat road.",
                            "target_lang_translations": {
                                "ru": "Езда <w>на подъём</w> требует большей мощности двигателя, чем езда по ровной дороге.",
                                "zh": "在<w>上坡</w>路段驾驶比在平路上行驶需要更大的发动机动力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uphill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение вверх по склону или уклону.",
                        "zh": "沿着斜坡或坡度向上移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вверх по склону",
                                "target_lang_sense_clarification": "направление движения"
                            },
                            {
                                "target_lang_word": "на подъём",
                                "target_lang_sense_clarification": "режим движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上坡",
                                "target_lang_sense_clarification": "向上移动的方向"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}