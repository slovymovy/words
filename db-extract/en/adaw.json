                    {
                        "sense_id": "342baa47-67e0-3626-b42d-d62fc1ab5f22",
                        "entry_id": "f5b25c0d-1107-3380-a17e-aa516162aa88",
                        "glosses": [
                            "To daunt, overcome, subdue."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "be8ec93d-09b4-4272-b0ac-eae03dc92c46",
                                "sense_id": "342baa47-67e0-3626-b42d-d62fc1ab5f22",
                                "text": "He, comming home at undertime, there found / The fayrest creature, that he euer saw, / Sitting beside his mother on the ground; / The sight whereof did greatly him adaw."
                            },
                            {
                                "example_id": "3ab69316-a1e9-423f-81d3-a5de27341bf3",
                                "sense_id": "342baa47-67e0-3626-b42d-d62fc1ab5f22",
                                "text": "But friezing colde adawes the frying heate[…]"
                            },
                            {
                                "example_id": "81c4ab53-4645-43a9-a16e-eaf139e41909",
                                "sense_id": "342baa47-67e0-3626-b42d-d62fc1ab5f22",
                                "text": "They perceiving, and being adawed at his constancy and resolution, took the advantage of a darke night, and fled every man of them, by that way out of the rock."
                            }
                        ]
                    }
                ],
