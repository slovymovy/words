                                "target_senses": [
                                    {
                                        "sense_id": "91addef9-ebdc-3c0e-8fdc-f25d883cb923",
                                        "entry_id": "7eafc0ed-16b7-379b-96c6-9bb7ebfd221b",
                                        "glosses": [
                                            "Videofilm, in elektronischer Form kodierte optische Sequenz aus wechselnden Einzelbildern (auch mit Tonspur), ursprünglich zur Übertragung im Fernsehen hergestellt"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "769b21c3-56da-4ade-9b2c-45b6c926bfa6",
                                                "sense_id": "91addef9-ebdc-3c0e-8fdc-f25d883cb923",
                                                "text": "Ich habe mir ein Video ausgeliehen."
                                            },
                                            {
                                                "example_id": "74678350-ad8c-4ba9-86fa-3c61dc3e6701",
                                                "sense_id": "91addef9-ebdc-3c0e-8fdc-f25d883cb923",
                                                "text": "„Es gibt ein Video von Donald Trump, das einen das Fürchten lehren kann; Mehr als Hunderttausend sehen es derzeit auf Youtube.“"
                                            },
                                            {
                                                "example_id": "50641a32-4763-4297-9525-0c0754462691",
                                                "sense_id": "91addef9-ebdc-3c0e-8fdc-f25d883cb923",
                                                "text": "„Das soziale Netzwerk TikTok, wo die meisten der Videos hochgeladen werden, reagiert ebenfalls auf die gefährliche Challenge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c98ac547-bc43-3c0a-bb84-c2eff1a3a53a",
                                        "entry_id": "7eafc0ed-16b7-379b-96c6-9bb7ebfd221b",
                                        "glosses": [
                                            "einen beliebigen Videodatenträger; Medium, auf dem ein elektronisch kodierter Film gespeichert oder aufgenommen ist"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "067b6cdb-43ad-47a2-a75d-722ec7ff1105",
                                                "sense_id": "c98ac547-bc43-3c0a-bb84-c2eff1a3a53a",
                                                "text": "Es wurde auf Video festgehalten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "63f54d97-f815-348a-a0a9-0b833750e723",
                                        "entry_id": "7eafc0ed-16b7-379b-96c6-9bb7ebfd221b",
                                        "glosses": [
                                            "eine Datei, die einen elektronisch aufgenommenen Film enthält, der auf dem Computerbildschirm gezeigt werden kann"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820c81f8-92bc-4bb7-b17d-7757ec2b315d",
                                                "sense_id": "63f54d97-f815-348a-a0a9-0b833750e723",
                                                "text": "Schick mir mal dieses lustige Video."
                                            },
                                            {
                                                "example_id": "32a0660a-e181-4da5-95f9-217d94a9cbe5",
                                                "sense_id": "63f54d97-f815-348a-a0a9-0b833750e723",
                                                "text": "„Ein kurzes Video über WhatsApp hatte damals genügt, um aus Deutschland Toms Zustimmung zur Anmietung zu geben, falls der Wechsel in die USA klappen würde.“"
                                            },
                                            {
                                                "example_id": "06a2f56b-a5a5-4474-bb9c-147c31bcd746",
                                                "sense_id": "63f54d97-f815-348a-a0a9-0b833750e723",
                                                "text": "„Ich war gut darin, alberne kleine Videos zu machen, zum Beispiel, wie ich den Schlüssselbund suchte, während er am eigenen Brillenbügel hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "262dd714-d6ec-38bd-ac74-b6b18a0e3f9d",
                                        "entry_id": "7eafc0ed-16b7-379b-96c6-9bb7ebfd221b",
                                        "glosses": [
                                            "Videotechnik, Technik zur elektronischen Aufzeichnung, Bearbeitung, Übertragung und Wiedergabe bewegter Bilder"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab9926b6-fbe9-4e4a-9ff1-459d9dd3ee2c",
                                                "sense_id": "262dd714-d6ec-38bd-ac74-b6b18a0e3f9d",
                                                "text": "„Bei Video und Fernsehen werden in den europäischen Verfahren PAL und SECAM 25 Bilder bzw. 50 Halbbilder pro Sekunde gezeigt, da dies der in europäischen Stromnetzen üblichen Wechselstromfrequenz von 50 Hertz entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
