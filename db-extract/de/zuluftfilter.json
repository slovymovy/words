                "senses": [
                    {
                        "sense_id": "29dfce37-a9f9-3474-9aae-8cafa54db754",
                        "entry_id": "9d5847e8-08ea-3ab1-bbc9-df0649928b90",
                        "glosses": [
                            "Filter, der unerwünschte Bestandteile aus der ihn durchströmenden Zuluft entfernt/zurückhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc318fe-4c9e-4cf9-a372-ab836e10ab8c",
                                "sense_id": "29dfce37-a9f9-3474-9aae-8cafa54db754",
                                "text": "Der Zuluftfilter im Lüftungsgerät sollte überwacht werden."
                            },
                            {
                                "example_id": "6006d38b-e028-4dbd-8993-2146813b57ed",
                                "sense_id": "29dfce37-a9f9-3474-9aae-8cafa54db754",
                                "text": "Bei den Zuluftfiltern sollte man auf den Preis achten."
                            },
                            {
                                "example_id": "05d2ff00-6473-4e48-b783-c8f3e1574cba",
                                "sense_id": "29dfce37-a9f9-3474-9aae-8cafa54db754",
                                "text": "Es ist die Aufgabe des Zuluftfilters, Schwebstoffe zurückzuhalten."
                            },
                            {
                                "example_id": "91dc8f54-ad3a-4afd-8b43-5f0315f3e267",
                                "sense_id": "29dfce37-a9f9-3474-9aae-8cafa54db754",
                                "text": "Allen Zuluftfiltern ist eines gemein, diese gehen in den Abfall."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
