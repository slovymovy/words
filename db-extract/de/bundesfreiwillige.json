                "senses": [
                    {
                        "sense_id": "c48b323d-d635-3bf8-84d9-77aed8b84a24",
                        "entry_id": "35044ef7-517a-354e-ad70-2b6267720147",
                        "glosses": [
                            "ambitionierte, jüngere Frau, die sich für 24 Monate im Rahmen des deutschen Bundesfreiwilligendienstes für soziale, ökologische oder kulturelle Aufgaben engagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9f83f2-18ae-4a4f-a204-737f99548f29",
                                "sense_id": "c48b323d-d635-3bf8-84d9-77aed8b84a24",
                                "text": "„Es ist eigentlich nicht ihre Aufgabe als Bundesfreiwillige diese Pflegeaufgaben zu übernehmen. Auf Grund des Personalmangels hat sie jedoch keine Wahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
