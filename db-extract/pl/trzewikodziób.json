                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d81a33-f5d3-4e73-8f93-342dbef58651",
                                "sense_id": "d22f9788-aeaf-30a4-8a34-43d2fa4377d9",
                                "text": "Trzewikodziób żywi się głównie rybami.",
                                "translation": "Der Schuhschnabel ernährt sich hauptsächlich von Fischen."
