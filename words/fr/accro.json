            "senses": [
                {
                    "sense_id": "7f97c1c2-7efd-3db9-b57b-82d5296d1a40",
                    "sense_definition": "Qui a une passion excessive pour quelqu'un ou quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère est complètement <w>accro</w> aux jeux vidéo et y joue tous les soirs.",
                            "target_lang_translations": {
                                "en": "My brother is completely <w>hooked</w> on video games and plays them every evening.",
                                "ru": "Мой брат совершенно <w>помешан</w> на видеоиграх и играет в них каждый вечер.",
                                "de": "Mein Bruder ist völlig <w>süchtig</w> nach Videospielen und spielt jeden Abend.",
                                "es": "Mi hermano está completamente <w>enganchado</w> a los videojuegos y juega todas las noches.",
                                "zh": "我哥哥完全<w>痴迷</w>于电子游戏，每天晚上都玩。"
                            }
                        },
                        {
                            "text": "Elle adore cette nouvelle série télévisée au point d'en être devenue totalement <w>accro</w>.",
                            "target_lang_translations": {
                                "en": "She loves this new TV series so much that she has become totally <w>hooked</w> on it.",
                                "ru": "Ей так нравится этот новый телесериал, что она стала совершенно <w>помешанной</w> на нём.",
                                "de": "Sie liebt diese neue Fernsehserie so sehr, dass sie völlig <w>süchtig</w> danach geworden ist.",
                                "es": "Le encanta esta nueva serie de televisión hasta el punto de estar totalmente <w>enganchada</w> a ella.",
                                "zh": "她太喜欢这部新的电视剧了，已经完全<w>着迷</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "passionné",
                        "mordu"
                    ],
                    "antonyms": [
                        "indifférent"
                    ],
                    "common_phrases": [
                        "être accro à",
                        "devenir accro"
                    ],
                    "traits": [
