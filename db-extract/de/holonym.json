                "senses": [
                    {
                        "sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                        "entry_id": "92962991-d092-35df-b297-0f03518db01a",
                        "glosses": [
                            "Ausdruck, der zu einem anderen Ausdruck (Wort, Phrase, Redewendung) in der Relation „ist Ganzes von“ steht, wobei Holonym das Ganze bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942149a2-2947-4048-addb-24357910679c",
                                "sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                                "text": "Der Ausdruck Fahrrad ist ein Holonym zu den Ausdrücken Fahrradkette, Lenkstange, Pedal, Sattel und anderen Ausdrücken, welche die restlichen Bestandteile des Fahrrades bezeichnen."
                            },
                            {
                                "example_id": "91e288bd-58ab-496d-b6ee-fd4fd1754c72",
                                "sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                                "text": "Computer ist ein Holonym von CPU."
                            },
                            {
                                "example_id": "18f2d301-cb2c-4525-be44-d3635b909db6",
                                "sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                                "text": "Das Holonym Demokratie umfasst das Meronym „Recht auf freie Meinungsäußerung“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d54d0588-3e7b-40d7-a749-7b71bb2d2804",
                        "source_entry_id": "92962991-d092-35df-b297-0f03518db01a",
                        "source_sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                        "source_sense_description": "Ausdruck, der zu einem anderen Ausdruck in der Relation „ist Ganzes von“ steht",
                        "target_lang_word": "holonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holonym",
