                "senses": [
                    {
                        "sense_id": "6b55b7df-2ced-304c-95fc-cd0e535eab51",
                        "entry_id": "f8cf479d-07e6-30cb-9cd9-afaefc95bbc3",
                        "glosses": [
                            "Kriegsgeschehen unter Einsatz von U-Booten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b58f518-f7cf-4525-97cc-d4acf16ba267",
                                "sense_id": "6b55b7df-2ced-304c-95fc-cd0e535eab51",
                                "text": "„Tags zuvor hatte er auf britisches Verlangen die Einstellung des U-Boot-Krieges befohlen, in dem die Kriegsmarine 782 Boote und 27000 von knapp 40000 U-Boot-Fahrern verloren hatte.“"
                            },
                            {
                                "example_id": "4cd440f9-f8af-491d-83ef-804369580b2f",
                                "sense_id": "6b55b7df-2ced-304c-95fc-cd0e535eab51",
                                "text": "„Alle waren heilfroh, dass sie den Kahn verlassen konnten. Vor allem mein Vater, der nun endgültig genug hatte vom U-Boot-Krieg und auch keine große Lust mehr verspürte, seine Abenteuer weiterhin in Wort und Bild zu erzählen.“"
                            },
                            {
                                "example_id": "e860de59-ae0d-4a9f-95a8-50dc7e899b08",
                                "sense_id": "6b55b7df-2ced-304c-95fc-cd0e535eab51",
                                "text": "„Die kleinen Ortschaften an der Küste waren verdunkelt, die Strände infolge des U-Boot-Kriegs mit Wrackteilen übersät, und überall patrouillierte die Küstenwache und suchte mit Hunden nach Nazi-Saboteuren.“"
                            },
                            {
                                "example_id": "65cefb09-855a-41a3-b1de-bec6138ef6b7",
                                "sense_id": "6b55b7df-2ced-304c-95fc-cd0e535eab51",
                                "text": "„Wie oft hatte ich während des U-Boot-Krieges geglaubt, die letzte Stunde habe geschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
