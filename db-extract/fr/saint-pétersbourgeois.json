                                                "example_id": "9e2f912c-c4b2-4d34-8299-8a76eb91ca1e",
                                                "sense_id": "79f97bb5-a06d-3171-be3c-414790aa9936",
                                                "text": "Хотя он и ездил изредка в петербургский свет, все любовные интересы его были вне света."
                                            }
                                        ]
