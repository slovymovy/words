                "senses": [
                    {
                        "sense_id": "3a20843b-5204-35f7-89fb-95a9bd88ffbe",
                        "entry_id": "3cf32fb3-bfbf-3567-a463-f2ec6f994d4d",
                        "glosses": [
                            "Annoblir."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b9b33fa9-0197-4421-8871-3c53812c8530",
                                "sense_id": "3a20843b-5204-35f7-89fb-95a9bd88ffbe",
                                "text": "Au nom de Dieu ! sire, me dit-il, dès qu’il crut pouvoir prendre la parole, si le roi n’y met bon ordre, les issues de son appartement seront encombrées à tel point par la plèbe nobilisée, que l’approche en deviendra impossible aux personnes d’un certain rang."
                            },
                            {
                                "example_id": "49ffda86-609b-4112-b260-258fc4475c2f",
                                "sense_id": "3a20843b-5204-35f7-89fb-95a9bd88ffbe",
                                "text": "le de la n'a jamais été nobilisé en Flandres, même si Jan BAERT a obtenu des titres du roi Louis le 14ème, même si il a fréquenté la cour pendant un temps ;"
                            },
                            {
                                "example_id": "8fb70145-f5cc-4362-b3b0-963b24ab9673",
                                "sense_id": "3a20843b-5204-35f7-89fb-95a9bd88ffbe",
                                "text": "[Hollande, Fabius, Cameron, Hague], ce quartet \"nobilisé\", est-ce pour terroriser les faibles?"
                            }
                        ]
                    }
                ],
