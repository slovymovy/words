                ],
                "senses": [
                    {
                        "sense_id": "dcc4ae22-2ede-3e09-9872-da72af9a36e9",
                        "entry_id": "3cdb051e-24ff-3233-9685-c05418efd5cf",
                        "glosses": [
                            "hoorbare luchttrillingen die gemaakt worden in het menselijke strottenhoofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23725c2f-e444-4719-962e-c4229d4edd83",
                                "sense_id": "dcc4ae22-2ede-3e09-9872-da72af9a36e9",
                                "text": "`Potverdomme', riep de agent met het gedempte stemgeluid van een verkoudheid, terwijl hij zijn hand voor zijn neus hield. Er liep bloed tussen zijn vingers door."
                            },
                            {
                                "example_id": "6b500f17-c747-4a8f-933f-46b19c7c0774",
                                "sense_id": "dcc4ae22-2ede-3e09-9872-da72af9a36e9",
                                "text": "Bij volwassenen is de stemspleet het nauwste deel van de hoge luchtweg. Als een patiënt in staat is om te spreken of andere stemgeluiden te maken, met een normale stem, dan is de hoge luchtweg in principe 'vrij' te verklaren. Bij zwellingen van de stembanden zal de stem veranderen en meestal hees klinken. Bij verlamming van de stembanden is spreken onmogelijk. De hoge luchtweg kan daarmee alsnog bedreigd zijn."
                            },
                            {
                                "example_id": "cd57373d-aac7-43fd-be02-444723d7084e",
                                "sense_id": "dcc4ae22-2ede-3e09-9872-da72af9a36e9",
                                "text": "De nieuwe versie van de robothond, te koop vanaf 198.000 yen (zo’n 1.500 euro), zal veel meer op een echte hond lijken dan zijn voorganger. Het diertje beweegt natuurlijk en zijn oogjes laten verschillende uitdrukkingen toe. In de neus zijn sensoren en een camera aangebracht, waarmee het zijn baasje zou moeten herkennen. Dankzij artificiële intelligentie zal het speeltje reageren op stemgeluid en zelfs nieuwe zaken kunnen aanleren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3a34830-fedc-4ea9-8367-9b64f2f29531",
                        "source_entry_id": "3cdb051e-24ff-3233-9685-c05418efd5cf",
                        "source_sense_id": "dcc4ae22-2ede-3e09-9872-da72af9a36e9",
                        "source_sense_description": "hoorbare luchttrillingen die gemaakt worden in het menselijke strottenhoofd",
                        "target_lang_word": "tone of voice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tone of voice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e09c9f86-c453-3e5e-a407-960c1d96a92e",
                                        "entry_id": "bdfa44de-f157-3339-8276-d139add03f61",
                                        "glosses": [
                                            "The quality, manner, or way someone speaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "052d5925-47fb-4ace-a198-65663ec50525",
                                                "sense_id": "e09c9f86-c453-3e5e-a407-960c1d96a92e",
                                                "text": "Something in John's tone of voice was coming back to haunt me, and at that moment I realized I'd been had."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36cbbc88-83a7-4677-93e0-4b10c91e4430",
                        "source_entry_id": "3cdb051e-24ff-3233-9685-c05418efd5cf",
                        "source_sense_id": "dcc4ae22-2ede-3e09-9872-da72af9a36e9",
                        "source_sense_description": "hoorbare luchttrillingen die gemaakt worden in het menselijke strottenhoofd",
                        "target_lang_word": "voice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "310293ae-019a-3b9b-9879-af273fee53e7",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "Sound uttered by the mouth, especially by human beings in speech or song; sound thus uttered considered as possessing some special quality or character"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e895ca9-5af4-4b9d-acb4-f0ee365d39bd",
                                                "sense_id": "310293ae-019a-3b9b-9879-af273fee53e7",
                                                "text": "His low voice allowed him to become a bass in the choir."
                                            },
                                            {
                                                "example_id": "a0aea2e4-af90-4304-8c83-dca1e8efc39f",
                                                "sense_id": "310293ae-019a-3b9b-9879-af273fee53e7",
                                                "text": "The human voice is the oldest musical instrument in history."
                                            },
                                            {
                                                "example_id": "65f22e76-67fe-4e70-a528-1703911fcc6d",
                                                "sense_id": "310293ae-019a-3b9b-9879-af273fee53e7",
                                                "text": "Stop repeating in that stupid voice what I say."
                                            },
                                            {
                                                "example_id": "6c225641-3161-4692-b91e-5e45d46d7b5e",
                                                "sense_id": "310293ae-019a-3b9b-9879-af273fee53e7",
                                                "text": "Her voice was euer ſoft,\nGentle, and low, an excellent thing in woman."
                                            },
                                            {
                                                "example_id": "eb1da1ca-e5ad-4faf-a040-250066913dcf",
                                                "sense_id": "310293ae-019a-3b9b-9879-af273fee53e7",
                                                "text": "And joyn thy voice unto the Angel Quire,"
                                            },
                                            {
                                                "example_id": "e80a163a-4a49-48cf-a400-945e99f8ebb7",
                                                "sense_id": "310293ae-019a-3b9b-9879-af273fee53e7",
                                                "text": "Villa chief executive Paul Faulkner had backed manager Houllier during the week and asked for the fans to get behind their team as they looked to steer themselves away from the relegation zone.\nTo that end, the home supporters were in good voice to begin with, but it was Newcastle who started the game in the ascendancy, with Barton putting a diving header over the top from Jose Enrique's cross."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56bf292d-e288-3c04-b151-03a10b394e79",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "Sound made through vibration of the vocal cords; sonant, or intonated, utterance; tone; — distinguished from mere breath sound as heard in whispering and voiceless consonants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d87178d1-c43b-3370-bafa-55b4f2ab4517",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "The tone or sound emitted by an object"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486956b1-dd07-4bad-a1e1-de7c51380951",
                                                "sense_id": "d87178d1-c43b-3370-bafa-55b4f2ab4517",
                                                "text": "And after the earthquake, a fire, but the Lord was not in the fire: and after the fire, a still small voice."
                                            },
                                            {
                                                "example_id": "cdf0a81b-1013-45ef-a0eb-a182aaed4166",
                                                "sense_id": "d87178d1-c43b-3370-bafa-55b4f2ab4517",
                                                "text": "Canst thou thunder with a voice like him?"
                                            },
                                            {
                                                "example_id": "c77554a5-1c33-45fd-b765-81917a5998b2",
                                                "sense_id": "d87178d1-c43b-3370-bafa-55b4f2ab4517",
                                                "text": "The floods have lifted up their voice."
                                            },
                                            {
                                                "example_id": "37484123-1185-4686-8a86-ae3f1b8496c2",
                                                "sense_id": "d87178d1-c43b-3370-bafa-55b4f2ab4517",
                                                "text": "O Marcus, I am warm’d; my heart Leaps at the trumpet’s voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72f5f5d-3864-31f3-82f7-7f0b531b2b23",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "The faculty or power of utterance"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7b9b21-783b-4290-b6a9-517f207a6f16",
                                                "sense_id": "f72f5f5d-3864-31f3-82f7-7f0b531b2b23",
                                                "text": "to cultivate the voice"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "187a7be0-6d32-3776-9043-a266fcd52e0b",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "That which is communicated; message; meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a45e7fa-6d9c-4b43-aaee-9095a83624f5",
                                                "sense_id": "187a7be0-6d32-3776-9043-a266fcd52e0b",
                                                "text": "I desire to bee present with you now, and to change my voyce, for I stand in doubt of you."
                                            },
                                            {
                                                "example_id": "3b6479a5-fff9-419d-8142-613e50e37b66",
                                                "sense_id": "187a7be0-6d32-3776-9043-a266fcd52e0b",
                                                "text": "My voice is in my sword."
                                            },
                                            {
                                                "example_id": "1f18a546-45a0-4f6b-932a-9bda358cc0c3",
                                                "sense_id": "187a7be0-6d32-3776-9043-a266fcd52e0b",
                                                "text": "17th century, John Fell, unknown work\nLet us call on God in the voice of his church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1cb1fb-0feb-348b-b83e-020bac37f6ed",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "An expressed opinion, choice, will, desire, or wish; the right or ability to make such expression or to have it considered"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c000f7-ba89-42aa-b964-3206abdaf7ff",
                                                "sense_id": "9d1cb1fb-0feb-348b-b83e-020bac37f6ed",
                                                "text": "Sicinius. How now, my masters! have you chose this man? / 1st Citizen. He has our voices, sir."
                                            },
                                            {
                                                "example_id": "e75d0b16-5ac3-4912-a937-d97094f1c1de",
                                                "sense_id": "9d1cb1fb-0feb-348b-b83e-020bac37f6ed",
                                                "text": "Some laws ordain, and some attend the choice / Of holy senates, and elect by voice."
                                            },
                                            {
                                                "example_id": "63f0df97-2af0-4cec-bae3-d63338566542",
                                                "sense_id": "9d1cb1fb-0feb-348b-b83e-020bac37f6ed",
                                                "text": "Like many of the 7 million other first time voters, she came of age during half a decade of military rule that has governed the country since former general turned Prime Minister Prayut Chan-o-cha seized power in a 2014 coup. \"We have had our voice taken away for five years,\" she says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79fde351-6174-3ebb-9b0a-a292a0cf886e",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "Command; precept."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93bcd38f-40b4-4419-ae2c-c7849bd72a83",
                                                "sense_id": "79fde351-6174-3ebb-9b0a-a292a0cf886e",
                                                "text": "As the nations which the Lord destroyeth before your face, so shall yee perish; because ye would not be obedient vnto the voice of the Lord your God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6501603f-3dd7-352d-9506-12a87bcf069f",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "One who speaks; a speaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e3bb516-0fe0-44c9-8965-d8ec2a35e29c",
                                                "sense_id": "6501603f-3dd7-352d-9506-12a87bcf069f",
                                                "text": "a potent voice of Parliament."
                                            },
                                            {
                                                "example_id": "bb5ba104-e68a-49f0-9aea-5e67a75f6ecc",
                                                "sense_id": "6501603f-3dd7-352d-9506-12a87bcf069f",
                                                "text": "The inclusion of transgender voices further disrupts the homonormalization of sex and identity evident in popular LGBTQ cinema."
                                            },
                                            {
                                                "example_id": "e7a4865d-8164-4209-a4dc-1711005f2ada",
                                                "sense_id": "6501603f-3dd7-352d-9506-12a87bcf069f",
                                                "text": "President Biden told the American public in an Oval Office address on Wednesday that he had abandoned his re-election campaign because there is “a time and a place for new voices, fresh voices — yes, younger voices.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c03d8dad-0cdc-39c6-b81b-f621e4f983a9",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "A particular style or way of writing that expresses a certain tone or feeling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1befe676-cc48-3c29-ab16-45ad14cc5e25",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "A particular way of inflecting or conjugating verbs, or a particular form of a verb, by means of which is indicated the relation of the subject of the verb to the action which the verb expresses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398492e6-552b-4aa9-b4ec-b09dd5b3c2e2",
                                                "sense_id": "1befe676-cc48-3c29-ab16-45ad14cc5e25",
                                                "text": "The verbal system of Latin has two voices, active and passive."
                                            },
                                            {
                                                "example_id": "3f409243-98f8-494a-8179-978665e18053",
                                                "sense_id": "1befe676-cc48-3c29-ab16-45ad14cc5e25",
                                                "text": "There are four tenses of the subjunctive (present, perfect, imperfect, and pluperfect) and three voices (active, passive, and deponent). [...] See 12.8 for the formation of the deponent voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bf15636-d04e-3d72-9511-04eef1d8b3bc",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "In harmony, an independent vocal or instrumental part in a piece of composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ec46fd-aa4f-4eb6-97a2-525917e7d407",
                                                "sense_id": "4bf15636-d04e-3d72-9511-04eef1d8b3bc",
                                                "text": "The theme of this piece constantly migrates between the three voice parts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07cfa808-c8d6-35c2-b024-b8f08fda8cfc",
                                        "entry_id": "484a873f-1ed2-31ea-bfdc-9fd4d35e438c",
                                        "glosses": [
                                            "A flag associated with a user on a channel, determining whether or not they can send messages to the channel."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c68fa9-3376-4d76-8b96-657ec5f0e2ce",
                                                "sense_id": "07cfa808-c8d6-35c2-b024-b8f08fda8cfc",
                                                "text": "True, better clients will remember that a person had a voice before they were opped and will return the + when they are deopped, but that doesn't solve the problem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0213c1f8-2f7e-3972-bd2e-a5a89da479fd",
                                        "entry_id": "4987b13f-b6fb-39f8-8637-27694bde2558",
                                        "glosses": [
                                            "To give utterance or expression to; to utter; to publish; to announce"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c34c817f-e972-4802-91e6-546cdb05c7b5",
                                                "sense_id": "0213c1f8-2f7e-3972-bd2e-a5a89da479fd",
                                                "text": "He voiced the sentiments of the nation."
                                            },
                                            {
                                                "example_id": "f103ac78-af0a-4f85-899a-0f7974a41bfd",
                                                "sense_id": "0213c1f8-2f7e-3972-bd2e-a5a89da479fd",
                                                "text": "How often he would voice his love of England, his admiration of her Parliament, his pride in her history."
                                            },
                                            {
                                                "example_id": "def6406b-c129-4961-b0b0-7f0d758a2a03",
                                                "sense_id": "0213c1f8-2f7e-3972-bd2e-a5a89da479fd",
                                                "text": "Rather assume thy right in silence and […] then voice it with claims and challenges."
                                            },
                                            {
                                                "example_id": "d6911597-e8f8-4f7d-87cc-cd61809c0f81",
                                                "sense_id": "0213c1f8-2f7e-3972-bd2e-a5a89da479fd",
                                                "text": "It was voiced that the king purposed to put to death Edward Plantagenet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "011a958b-f871-3419-9f5c-a352de613c92",
                                        "entry_id": "4987b13f-b6fb-39f8-8637-27694bde2558",
                                        "glosses": [
                                            "To utter audibly, with tone and not just breath."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "683e16c6-6762-3537-8636-a6c8f10ec522",
                                        "entry_id": "4987b13f-b6fb-39f8-8637-27694bde2558",
                                        "glosses": [
                                            "To fit for producing the proper sounds; to regulate the tone of"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f9da51f-98de-44a0-afc3-f1005466dde0",
                                                "sense_id": "683e16c6-6762-3537-8636-a6c8f10ec522",
                                                "text": "voice the pipes of an organ"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c35229cb-a9dc-3707-8005-f37642e4302a",
                                        "entry_id": "4987b13f-b6fb-39f8-8637-27694bde2558",
                                        "glosses": [
                                            "To vote; to elect; to appoint"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9f0d260-8a0d-34dd-b432-d6ad6bb4d2fa",
                                        "entry_id": "4987b13f-b6fb-39f8-8637-27694bde2558",
                                        "glosses": [
                                            "To clamor; to cry out"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b31cfae9-95ef-467c-9c88-3a71cb920e6c",
                                                "sense_id": "b9f0d260-8a0d-34dd-b432-d6ad6bb4d2fa",
                                                "text": "If thou wilt give me Davids heart; Ile voyce, / Great God, with David; and make Davids choyce."
                                            },
                                            {
                                                "example_id": "3f3e3c2a-b53b-43e8-b27d-298130ebeeab",
                                                "sense_id": "b9f0d260-8a0d-34dd-b432-d6ad6bb4d2fa",
                                                "text": "It is not the gift of every Perſon, nor of every Age, to harangue the multitude, to Voice it high and loud, & Dominari in Concionibus."
                                            },
                                            {
                                                "example_id": "82ef8bb3-3e70-4302-81f8-68b01a7cd43a",
                                                "sense_id": "b9f0d260-8a0d-34dd-b432-d6ad6bb4d2fa",
                                                "text": "How wou'd they voice it o're and o're for Tachmas / To come, and blunt the edge of War agen!"
                                            },
                                            {
                                                "example_id": "d7f7cbd3-efe8-4934-885a-21744490e6e8",
                                                "sense_id": "b9f0d260-8a0d-34dd-b432-d6ad6bb4d2fa",
                                                "text": "[L]ambs are glad / Nosing the mother's udder, and the bird / Makes his heart voice among the blaze of flowers: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c35913-6657-3094-b4f4-0e0df9ba9822",
                                        "entry_id": "4987b13f-b6fb-39f8-8637-27694bde2558",
                                        "glosses": [
                                            "To assign the voice flag to a user on IRC, permitting them to send messages to the channel."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34776cab-6c17-40d2-872c-654f764c6f44",
                                                "sense_id": "93c35913-6657-3094-b4f4-0e0df9ba9822",
                                                "text": "I would like this script to allow me to notice not only the ops in a channel, but also those that have been voiced by the ops, at the same time."
                                            },
                                            {
                                                "example_id": "519b54cb-8acc-4d19-b454-ee855094a941",
                                                "sense_id": "93c35913-6657-3094-b4f4-0e0df9ba9822",
                                                "text": "If you then want others to be able to talk, you can voice them (+v) or if you want everyone able to talk, you can remove the moderation flag on the channel (-m)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c883417-36ca-36f6-87e4-2a81b71deef5",
                                        "entry_id": "4987b13f-b6fb-39f8-8637-27694bde2558",
                                        "glosses": [
                                            "To act as a voice actor to portray a character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2880727-db7f-48c7-a837-c82a31d7c880",
                                                "sense_id": "2c883417-36ca-36f6-87e4-2a81b71deef5",
                                                "text": "The openly ridiculous plot has The Pirate Captain (Hugh Grant) scheming to win the Pirate Of The Year competition, even though he’s a terrible pirate, far outclassed by rivals voiced by Jeremy Piven and Salma Hayek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
