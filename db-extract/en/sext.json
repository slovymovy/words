                    {
                        "translation_id": "b658914d-72fd-4468-9cfb-35afb4414cf4",
                        "source_entry_id": "708a06f4-e3fe-30cf-a953-28729481604d",
                        "source_sense_id": "957c0f62-abc3-3df2-9e89-984aecf2a6a7",
