                "senses": [
                    {
                        "sense_id": "c35e232c-de18-378e-a65d-e1b46eae0274",
                        "entry_id": "b5a23b9d-665c-3b69-bd16-a12f6428262e",
                        "glosses": [
                            "Klärung beziehungsweise die biochemische Stabilisierung von Wein durch Ausfällen winziger Schwebeteilchen in der Flüssigkeit mittels Eiweiß oder Fischblase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ed6ed2-5a2f-40c5-8b1b-90d71e16e7d4",
                                "sense_id": "c35e232c-de18-378e-a65d-e1b46eae0274",
                                "text": "„Die Verfahren der Weinschönung lassen sich erst für die frühe Neuzeit rekonstruieren.“"
                            },
                            {
                                "example_id": "caea226b-4561-4dc2-a55d-2bf59c037d0c",
                                "sense_id": "c35e232c-de18-378e-a65d-e1b46eae0274",
                                "text": "„Eine Weinschönung bezweckt die Entfernung von solchen Stoffen aus dem Wein, die Trübungen verursachen oder Nachtrübungen in den abgefüllten Flaschen auslösen. Daneben dient die Weinschönung zur Entfernung von Geschmacksfehlern […]“"
                            },
                            {
                                "example_id": "3481bd55-d80c-4b8e-8d5d-a2a1907829cc",
                                "sense_id": "c35e232c-de18-378e-a65d-e1b46eae0274",
                                "text": "„Die schwierige technische Handhabung von Caseinaten für die Weinschönung verhinderte bisher ihren Einsatz in größerem Umfang.“"
                            },
                            {
                                "example_id": "cbe5e02d-de17-40ae-b99f-a28bbf9657f3",
                                "sense_id": "c35e232c-de18-378e-a65d-e1b46eae0274",
                                "text": "„Die während der Gärung erst gebildeten Aromastoffe werden nur durch eine Weinschönung angegriffen.“"
                            },
                            {
                                "example_id": "7747d550-db8a-428f-910c-6fab2c6e0817",
                                "sense_id": "c35e232c-de18-378e-a65d-e1b46eae0274",
                                "text": "„Bei anderen Methoden zur Weinschönung werden u. a. Gelatine, Eiereiweiß oder Bentonite zugesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
