                                    {
                                        "sense_id": "a726bca5-9af6-341f-aa20-1d1353818b24",
                                        "entry_id": "0e473297-1fd0-3f60-a95e-2adb7343f5cc",
                                        "glosses": [
                                            "The capital and largest city of Armenia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1b8dea-f73d-4647-ba25-5341ca1cb8c6",
                                                "sense_id": "a726bca5-9af6-341f-aa20-1d1353818b24",
                                                "text": "Before long Abbas Mirza suffered a succession of defeats, which culminated in the capture of Erivan, today capital of Armenia."
                                            },
                                            {
                                                "example_id": "d1a87fee-3d33-4b30-8202-5b213d6af218",
                                                "sense_id": "a726bca5-9af6-341f-aa20-1d1353818b24",
                                                "text": "Crammed to the gills with history, it nestles in the shadow of Mount Ararat and has a medieval centre but it's Yerevan's religious heritage that is its main claim to fame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "088bcd33-3d5e-4a8a-87f7-e9fce51546af",
                        "source_entry_id": "0a68705d-beb5-3a6a-8332-4def661d4871",
                        "source_sense_id": "165f7fa6-49d4-3195-84f7-893223b12deb",
                        "source_sense_description": "Hauptstadt von Armenien",
                        "target_lang_word": "Erevan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erevan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8df62bdb-e31c-3351-ad91-8767449a0dcf",
                                        "entry_id": "aab18e73-7014-373a-a3be-e46160433b40",
                                        "glosses": [
                                            "Capitale de l’Arménie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b123f3-49ec-42b4-bb7a-bd843dd329d8",
                                                "sense_id": "8df62bdb-e31c-3351-ad91-8767449a0dcf",
                                                "text": "Des milliers d’Arméniens ont défilé hier, des bougies et des fleurs è la main, à Erevan pour commémorer le 106e anniversaire des massacres d’Arméniens par l’empire ottoman pendant la première guerre mondiale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b048d1c8-328f-3e9c-a2e3-8395f4a85438",
                                        "entry_id": "aab18e73-7014-373a-a3be-e46160433b40",
                                        "glosses": [
                                            "Gouvernement arménien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf829092-da19-4b2b-8233-8dc0ddb0cdbc",
                                                "sense_id": "b048d1c8-328f-3e9c-a2e3-8395f4a85438",
                                                "text": "Mardi, Erevan (Arménie) a dénoncé une « agression » après un « bombardement intensif, contre des positions militaires arméniennes »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
