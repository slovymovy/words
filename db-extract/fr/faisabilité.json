                "senses": [
                    {
                        "sense_id": "1362672d-9b48-3e5b-a2c9-c930ec506b3f",
                        "entry_id": "54299d38-0f55-3563-811d-9a3600f2fc5f",
                        "glosses": [
                            "Possibilité de faire quelque chose en particulier de réaliser un projet technique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47de38ff-9bc6-4326-a732-0ece84e2fec9",
                                "sense_id": "1362672d-9b48-3e5b-a2c9-c930ec506b3f",
                                "text": "L’étude de faisabilité est favorable au projet de centrale nucléaire malgré les risques sismiques."
                            },
                            {
                                "example_id": "45f7debe-8239-415d-a55a-5850f921b74a",
                                "sense_id": "1362672d-9b48-3e5b-a2c9-c930ec506b3f",
                                "text": "Cependant, elles montrent d’une manière générale la faisabilité technique et l’intérêt économique de tels systèmes pour les agriculteurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ae92fb2-2c9e-4c63-8727-d6d4797ef9c2",
                        "source_entry_id": "54299d38-0f55-3563-811d-9a3600f2fc5f",
                        "source_sense_id": "1362672d-9b48-3e5b-a2c9-c930ec506b3f",
                        "source_sense_description": "État de ce qui peut être fait (1)",
                        "target_lang_word": "Machbarkeit",
