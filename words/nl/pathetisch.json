                {
                    "sense_id": "dda0a58d-d102-373d-b61c-3765373ef8c6",
                    "sense_definition": "medelijden opwekkend door een jammerlijke of hulpeloze toestand; meelijwekkend of beklagenswaardig",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medelijwekkend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>pathetisch</w> gezicht om de man zo hulpeloos in de regen te zien staan."
                        },
                        {
                            "text": "Haar wanhopige pogingen om zijn aandacht te trekken begonnen er nogal <w>pathetisch</w> uit te zien."
                        }
                    ],
                    "synonyms": [
                        "meelijwekkend",
                        "zielig",
                        "beklagenswaardig"
                    ],
                    "common_phrases": [
                        "een pathetische poging",
                        "een pathetisch gezicht"
                    ]
                },
                {
                    "sense_id": "667c4e54-690c-349e-bc83-f2959827e498",
                    "sense_definition": "overdreven emotioneel of theatraal van toon; vol bombast en hoogdravendheid",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoogdravend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De acteur sprak zijn regels op zo'n <w>pathetische</w> toon uit dat het publiek begon te lachen."
                        },
                        {
                            "text": "Zijn afscheidsrede klonk veel te <w>pathetisch</w> voor deze informele bijeenkomst van collega's."
                        }
                    ],
                    "synonyms": [
                        "hoogdravend",
                        "theatraal",
                        "bombastisch"
                    ],
                    "antonyms": [
                        "nuchter",
                        "ingetogen"
                    ],
                    "common_phrases": [
                        "op pathetische toon"
                    ]
                },
                {
                    "sense_id": "ef1f2855-8bb0-3c36-aea2-66eff22d35c6",
                    "sense_definition": "vol diepe emotie en pathos; in staat intense gevoelens van ontroering of melancholie op te wekken",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ontroering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tsjaikovski schreef een beroemde symfonie met een uitgesproken <w>pathetisch</w> karakter."
