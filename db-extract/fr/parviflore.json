                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37b490c5-0aa1-4f8c-8022-44cf5d4e03f1",
                                "sense_id": "9f1df289-60b0-3c64-82ae-4b7ab44bd026",
                                "text": "Ils marchent le long d’une grande haie de ronces parviflores parmi les tiges de houlques laineuses et les flouves douces et odorantes."
                            },
                            {
                                "example_id": "42f0ad30-0cd9-4f83-a4e9-a6a68be930fb",
                                "sense_id": "9f1df289-60b0-3c64-82ae-4b7ab44bd026",
                                "text": "La tapisserie parviflore des murs disparaissait sous une multitude de trésors à quatre sous : une citole aux cordes éclatées, des fleurs séchées sous verre, fixés à la bassorine, des fétiches des Iles, des cartes postales allemandes encadrées, des coquillages marins."
                            },
                            {
                                "example_id": "98622dc1-48f4-4ea2-8cb8-660eea8ea631",
                                "sense_id": "9f1df289-60b0-3c64-82ae-4b7ab44bd026",
                                "text": "Cette espèce a beaucoup de rapport à l’onagre parviflore."
                            }
                        ]
                    }
