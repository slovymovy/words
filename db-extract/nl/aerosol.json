                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aerosol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c570489-cce1-338e-a9c3-a5812ef1ca62",
                                        "entry_id": "46d8770b-add4-3edc-ad8a-76b908971b89",
                                        "glosses": [
                                            "Gemisch aus fein verteilten flüssigen oder festen Schwebeteilchen und Gasen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f96f55-ed0b-48b3-a26c-744865fb52c8",
                                                "sense_id": "8c570489-cce1-338e-a9c3-a5812ef1ca62",
                                                "text": "Die Auswirkung von Aerosolen auf unsere Umwelt ist noch nicht vollständig geklärt."
                                            },
                                            {
                                                "example_id": "f031c37c-9445-4e4e-8ba6-8a4278df016e",
                                                "sense_id": "8c570489-cce1-338e-a9c3-a5812ef1ca62",
                                                "text": "Aerosole befinden sich in der Küchenabluft, also in den aufsteigenden Wrasen und werden durch Aerosolabscheider in der Küchenhaube abgeschieden."
                                            },
                                            {
                                                "example_id": "18b59626-ba1d-4260-9d24-c2fba0d67544",
                                                "sense_id": "8c570489-cce1-338e-a9c3-a5812ef1ca62",
                                                "text": "„Die schwefelhaltigen Aerosole schirmten das Sonnenlicht teilweise ab.“"
                                            },
                                            {
                                                "example_id": "f6283769-3f70-42d1-8a85-faccb6e16696",
                                                "sense_id": "8c570489-cce1-338e-a9c3-a5812ef1ca62",
                                                "text": "„Doch neben den Tröpfchen, die beim Husten oder Niesen entstehen, und der sogenannten Kontaktinfektion scheint es noch eine dritte Übertragungsform des Virus geben: durch sogenannte Aerosole. Dabei handelt es sich genau genommen auch um Tröpfchen, jedoch beschreiben Aerosole sehr kleine Partikel, die so leicht sind, dass sie lange in der Luft schweben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1e2f1ad-6cb6-48c4-8f8a-d2dcb67fa222",
                        "source_entry_id": "8ddd525b-c903-347f-963d-6118e7bfe6b9",
                        "source_sense_id": "32bb2017-4c23-3406-844c-f455f0c046ba",
                        "source_sense_description": "scheikunde",
                        "target_lang_word": "aerosol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aerosol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d63ce353-5cea-33b8-a259-bf1010d88ad9",
                                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                                        "glosses": [
                                            "A mixture of fine solid particles or liquid droplets suspended in a gaseous medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5587d8ab-fe60-4b7c-8d19-a45ef50b5701",
                                                "sense_id": "d63ce353-5cea-33b8-a259-bf1010d88ad9",
                                                "text": "Examples of common aerosols are mist, fog, and smoke."
                                            },
                                            {
                                                "example_id": "b6fcaade-a97f-4615-984d-4f601bb78d97",
                                                "sense_id": "d63ce353-5cea-33b8-a259-bf1010d88ad9",
                                                "text": "The entire side of the barge chases itself inward, like the steel has become liquid and is running down a deain, and the metal turns bright as shock waves simply turn that thick layer of rust into an aerosol, blast it free from the steel borne on a wave of sound so powerful that it hurts Hiro down inside his chest and makes him feel sick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d306f4-534c-312e-8055-d10d9ab44bd0",
                                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                                        "glosses": [
                                            "An aerosol can."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a877cc48-7ce7-3778-bfb2-62897ae4d14b",
                                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                                        "glosses": [
                                            "The payload (e.g. insecticide, paint, oil, cosmetics) and propellant contained by an aerosol can."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "920f0093-781f-3f22-a9a6-4ab29418947a",
                                        "entry_id": "ec915638-183a-374e-abae-1150599fd4a4",
                                        "glosses": [
                                            "A colloidal system in which the dispersed phase is composed of either solid or liquid particles and in which the dispersal medium is some gas, usually air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aerosol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4db1cbd8-753e-3cf3-9f9f-ed72751d0e74",
                                        "entry_id": "659003ce-a390-33a5-ba45-998a55c3715f",
                                        "glosses": [
                                            "To spray with an aerosol."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d3d3e8e-e382-4e05-8e62-4ff956f9f7ee",
                                                "sense_id": "4db1cbd8-753e-3cf3-9f9f-ed72751d0e74",
                                                "text": "The door entrance and space going up the steps was aerosoled just before passengers started to enter. A second spray was given after they were aboard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c0e8aa-8ed8-47d8-96cd-c63a5a68adb4",
                        "source_entry_id": "8ddd525b-c903-347f-963d-6118e7bfe6b9",
                        "source_sense_id": "32bb2017-4c23-3406-844c-f455f0c046ba",
                        "source_sense_description": "scheikunde",
                        "target_lang_word": "aérosol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aérosol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c106a459-615b-33b2-8548-c09904b6d3f5",
                                        "entry_id": "79f83697-6946-3c30-be34-d148bb5f4e7e",
                                        "glosses": [
                                            "Ensemble de particules solides ou liquides en suspension dans un milieu gazeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ccfc70-e6ac-419f-8b04-df8f8c7c034b",
                                                "sense_id": "c106a459-615b-33b2-8548-c09904b6d3f5",
                                                "text": "Dès le début juillet, des centaines d’experts sonnaient pourtant très publiquement l’alarme auprès de l’OMS sur la propagation possible de la COVID-19 par aérosols."
                                            },
                                            {
                                                "example_id": "25f46299-19d0-4ddf-8b58-4c44032c3a76",
                                                "sense_id": "c106a459-615b-33b2-8548-c09904b6d3f5",
                                                "text": "D’après de nouvelles modélisations épidémiologiques, le nouveau coronavirus emprunterait la voie des aérosols – autrement dit l’air – dans environ 50% des infections, peut-on lire dans une étude parue le 4 février sur le site de la revue PNAS."
                                            },
                                            {
                                                "example_id": "301a17f3-ff29-47ec-a307-baf0ed9aac95",
                                                "sense_id": "c106a459-615b-33b2-8548-c09904b6d3f5",
                                                "text": "Autre enseignement de ces modèles, gouttelettes et aérosols ont concouru à parts égales aux nouvelles infections avant le début de la quarantaine."
                                            },
                                            {
                                                "example_id": "8ecd6f2a-6cce-40cc-8d97-2d22fd6c47f2",
                                                "sense_id": "c106a459-615b-33b2-8548-c09904b6d3f5",
                                                "text": "Divers aérosols naturels contribuent au cycle de l'eau et à la régulation climatique. Ce sont notamment des molécules soufrées produites par les algues océaniques, ou les particules emportées dans l'air par l'érosion éolienne naturelle des sols, ou les incendies naturels de forêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cbf6839-93ab-3d6a-8e35-12528b2355c9",
                                        "entry_id": "79f83697-6946-3c30-be34-d148bb5f4e7e",
                                        "glosses": [
                                            "Récipient contenant un principe actif projeté par un gaz sous pression (on dit plutôt généralement bombe aérosol)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c0beda-ba38-4704-890f-180e071e2928",
                                                "sense_id": "5cbf6839-93ab-3d6a-8e35-12528b2355c9",
                                                "text": "Jusqu'aux années 1980, les aérosols libéraient des CFC (chlorofluorocarbones) servant de gaz propulseurs en raison de leurs propriétés intéressantes : ils sont ininflammables, inodores et stables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aérosol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "615ac366-1433-3efc-adcc-7cf472f66c1a",
                                        "entry_id": "a1050fd4-e021-346d-bc40-6701bbdab3fb",
                                        "glosses": [
                                            "Qui a trait à un aérosol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c86f4a0-f1b7-4c19-a624-3cf17d57464d",
                                                "sense_id": "615ac366-1433-3efc-adcc-7cf472f66c1a",
                                                "text": "Il nous appartient de faire confiance aux experts du HCSP, qui ne font pas ces recommandations à la légère, et dont l’avis formel se base sur la prise en compte des effets aérosols du virus ; une donnée sur laquelle la connaissance scientifique a très fortement progressé sur les mois de juin-juillet-août."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
