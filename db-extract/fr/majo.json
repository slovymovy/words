                "senses": [
                    {
                        "sense_id": "312d2ec7-66a2-3af2-b1ae-1fed6aa25b9e",
                        "entry_id": "cb09351a-ecd6-3f10-b95d-636750c333f1",
                        "glosses": [
                            "Majorité."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8a26180c-2fdd-3e24-b4e4-18473a3f0abf",
                        "entry_id": "cb09351a-ecd6-3f10-b95d-636750c333f1",
                        "glosses": [
                            "Dans une organisation politique ou syndicale, courant ou groupe dirigeant lorsque plusieurs coexistent. Membre de ladite majorité."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "572b6999-2b45-4bee-b2c1-b52c8251e312",
                                "sense_id": "8a26180c-2fdd-3e24-b4e4-18473a3f0abf",
                                "text": "« C’est assez classique, tempère Grond, la LCR a longtemps fonctionné comme ça. En 2006 encore, la “majo” de la Ligue n’avait fait que 48 %… »"
                            }
                        ]
                    },
                    {
                        "sense_id": "3d628071-2880-3ced-8fb8-5769fb0e47fb",
                        "entry_id": "cb09351a-ecd6-3f10-b95d-636750c333f1",
                        "glosses": [
                            "Dans l’histoire de l’Unef, courant corporatiste des années 1940 et 1950. Membre dudit courant."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "92f8cc9b-d5e3-4f0b-8fb6-a41942d07df7",
                                "sense_id": "3d628071-2880-3ced-8fb8-5769fb0e47fb",
                                "text": "Représentant du courant alors minoritaire (« mino »), syndicaliste et anticolonialiste, il fut élu vice-président de l’UNEF, … au congrès de 1955 de cette organisation encore dominée par les corporatistes dits « majos »."
                            },
                            {
                                "example_id": "0d8f5735-f323-4c7d-993e-5de5cb7b3ca1",
                                "sense_id": "3d628071-2880-3ced-8fb8-5769fb0e47fb",
                                "text": "Alors même que les majos et la F.N.E.F. s’avèrent incapables de recueillir la moindre représentativité dans le milieu étudiant, la plus large publicité leur est faite."
                            }
                        ]
                    }
