                    {
                        "form_id": "658ea487-1af8-4ed2-a6b2-c250fcbba729",
                        "entry_id": "1879ec1a-6885-3b33-8cc3-60b30e96261b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "goodliest"
