                "senses": [
                    {
                        "sense_id": "b14c5d50-0a71-3ad8-964d-9e2e9b9541ee",
                        "entry_id": "b630fd2c-0133-3276-8aa5-6f8cf3528316",
                        "glosses": [
                            "Se montrer incohérent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9d791f-459b-448f-beb1-3f7540b07b3a",
                                "sense_id": "b14c5d50-0a71-3ad8-964d-9e2e9b9541ee",
                                "text": "Elles finissent par mélanger, incohérentiser, se raccrochobranchiser, pour sortir un concept difforme, (à la base produit purement marketing), que j'appelle moi, le consommateur ou encore, le joueur de merde."
                            },
                            {
                                "example_id": "4dac4ace-bf14-4a13-ae7b-4f221db01360",
                                "sense_id": "b14c5d50-0a71-3ad8-964d-9e2e9b9541ee",
                                "text": "Cela dit, j'aime bien utiliser des chemins détournés pour imposer mes trucs \"incohérents\". Parce que j'aime bien incohérentiser, au fond."
                            }
                        ]
                    },
                    {
                        "sense_id": "6017b85e-a22a-3b0d-991d-1e7fff9a5fa1",
                        "entry_id": "b630fd2c-0133-3276-8aa5-6f8cf3528316",
                        "glosses": [
                            "Se montrer incohérent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16555f13-d8bd-4756-8aec-36ce4cb5bd0a",
                                "sense_id": "6017b85e-a22a-3b0d-991d-1e7fff9a5fa1",
                                "text": "Par contre je m'inquiète dans le sens où tu incohérentises un peu ce matin, t'aurais pas tapé le parebrise ou le volant?"
                            }
                        ]
                    }
                ],
