                        "entry_id": "34f54dee-2670-33cc-bd27-6e6209849178",
                        "glosses": [
                            "Begriff im Hinduismus und Buddhismus, der den Anblick einer Gottheit oder einer heiligen Person bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01328d59-b0a7-462c-a2fa-feedf21994f2",
                                "sense_id": "b4bb031f-d2f7-3e5a-876f-f61c0e2e27c1",
                                "text": "„Shridhar Shukla war ein internationaler Swami, er aß mit Präsidenten und Premierministern zu Mittag, sagte Ministern die Zukunft voraus, und zu seinen Darshans kamen Dutzende von Filmstars.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
