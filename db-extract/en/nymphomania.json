                                        "entry_id": "8f87e2e0-009a-3c5f-904f-9e6fefc2fa53",
                                        "glosses": [
                                            "Folle passion pour les hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6efc978e-f7f2-4bf3-9e2b-fc8bd6c3b94d",
                                                "sense_id": "19e017b1-996f-39de-80c5-5951b1022d01",
                                                "text": "Sans cesse veuve d’un mari absent , elle a cherché dans la débauche une consolation de la solitude, et de débauche en débauche elle a fini par tomber dans l’andromanie."
                                            }
                                        ]
                                    }
                                ]
