                        "cross_references": [
                            {
                                "target_word": "экологический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb0b656-3b69-3ca1-9bce-72ce6004ea83",
                                        "entry_id": "a7e4dfa4-1254-3672-9ebf-9aa83c73b006",
                                        "glosses": [
                                            "соотносящийся по значению с существительным: экология (наукой, занимающейся сферой понятий и явлений, связанных с окружающей средой), связанный с ним"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "114df927-447a-42e6-893d-9389797e8e68",
                                                "sense_id": "ebb0b656-3b69-3ca1-9bce-72ce6004ea83",
                                                "text": "Понятно, что такая ситуация беспокоит конкурентов на внешних рынках, которые рассматривают естественные преимущества как недобросовестные ― исключительно на том основании, что наши издержки значительно ниже соответствующих затрат европейских производителей Поэтому ЕС и США рассматривают это как нарушение правил свободной конкуренции и предлагают включить в соглашения по ВТО положения, связывающие трудовые и экологические стандарты с ограничениями на поставки металлопродукции вплоть до полного запрета."
                                            },
                                            {
                                                "example_id": "436215a7-b929-4bba-9ac0-2e67af810855",
                                                "sense_id": "ebb0b656-3b69-3ca1-9bce-72ce6004ea83",
                                                "text": "Экологическая чистота процесса обусловлена тем, что этот растворитель практически полностью регенерируется и не образует вредных продуктов распада."
                                            },
                                            {
                                                "example_id": "741e9746-27ed-406e-aa70-44ab0567ac18",
                                                "sense_id": "ebb0b656-3b69-3ca1-9bce-72ce6004ea83",
                                                "text": "Отличительными характеристиками творений Уго Ла Пиетра, Умберто Рива и Франко Поли являются предметы домашнего обихода, сделанные из экологических материалов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b698687-1f37-361d-85c7-95060760a032",
                                        "entry_id": "a7e4dfa4-1254-3672-9ebf-9aa83c73b006",
                                        "glosses": [
                                            "свойственный экологии (совокупности понятий и явлений, связанных с окружающей средой), характерный для нее"
                                        ],
