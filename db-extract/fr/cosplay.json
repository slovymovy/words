                "entry_id": "8385e967-d2fa-371d-b406-5f5b23ae0d13",
                "word": "cosplay",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b75091d0-b0fd-49fb-8acd-415148b3518e",
                        "entry_id": "8385e967-d2fa-371d-b406-5f5b23ae0d13",
                        "tags": [
                            "plural"
                        ],
                        "form": "cosplays"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                        "entry_id": "8385e967-d2fa-371d-b406-5f5b23ae0d13",
                        "glosses": [
                            "Pratique consistant à se costumer à l’image de personnages de mangas, de jeux vidéos, etc."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f9d644a8-49ee-4fe8-a88d-da6dab953583",
                                "sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                                "text": "Au Japon, les défilés de cosplay sont très prisés par les jeunes."
                            },
                            {
                                "example_id": "554b5d9e-9269-4c6f-b969-9bb578a13c33",
                                "sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                                "text": "Dans le cadre du festival Anima se déroulait ce dimanche à Flagey, un concours de cosplay ou costume playing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef69e01f-0cf5-4658-bc42-5ecfc839fe66",
                        "source_entry_id": "8385e967-d2fa-371d-b406-5f5b23ae0d13",
                        "source_sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                        "target_lang_word": "Cosplay",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a1b203c5-a4f8-4ae9-833a-ca20cc1bacf2",
                        "source_entry_id": "8385e967-d2fa-371d-b406-5f5b23ae0d13",
                        "source_sense_id": "e6f786ed-4fde-34e4-aba3-b1cb81554c89",
                        "target_lang_word": "cosplay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosplay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45f88639-517e-31b4-9d3e-23b12d7b1d6e",
                                        "entry_id": "1e43a1b9-3c67-3ebb-ba36-99d8b2c62a94",
                                        "glosses": [
                                            "The art or practice of costuming oneself as a (usually fictional) character."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accda4b0-30b9-437b-a4b1-e86f3d81e6d5",
                                                "sense_id": "45f88639-517e-31b4-9d3e-23b12d7b1d6e",
                                                "text": "Men, of course, also participate in cosplay and all its attending events, but women make up the greater numbers."
                                            },
                                            {
                                                "example_id": "f23dccb0-d0a3-40a3-8292-55a60a3a0062",
                                                "sense_id": "45f88639-517e-31b4-9d3e-23b12d7b1d6e",
                                                "text": "The environments and spaces created for and by cosplay provide cosplayers with a variety of spaces for social interactions."
                                            },
                                            {
                                                "example_id": "ca79fd48-2789-4eb3-9dfd-b1c698906cbd",
                                                "sense_id": "45f88639-517e-31b4-9d3e-23b12d7b1d6e",
                                                "text": "It didn't take long for anime cons and cosplay to become a part of popular culture fandom in the West[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbb4f052-b7ee-333e-b4a0-2399d9bc12fb",
                                        "entry_id": "1e43a1b9-3c67-3ebb-ba36-99d8b2c62a94",
                                        "glosses": [
                                            "A skit or instance of this art or practice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50bc65e-4ad4-47b4-82f9-573e19509582",
                                                "sense_id": "bbb4f052-b7ee-333e-b4a0-2399d9bc12fb",
                                                "text": "Central to the activity of cosplay is elaborate costuming, though some cosplays are enacted using a game system."
                                            },
                                            {
                                                "example_id": "2724fe11-7f75-435f-9aca-56a7c2e24777",
                                                "sense_id": "bbb4f052-b7ee-333e-b4a0-2399d9bc12fb",
                                                "text": "According to a student from France who went to Japan to study Japanese, \"Universities in France are like Halloween when otaku students engage in these cosplays. They take Japanese language because of anime, but they see after a few classes that it's hard and not fun. Many drop out\" (author interview, 2009)."
                                            },
                                            {
                                                "example_id": "c74656ca-b6fc-4a01-adbf-95544cb82c50",
                                                "sense_id": "bbb4f052-b7ee-333e-b4a0-2399d9bc12fb",
                                                "text": "Popular cosplays include, for example, characters from the Final Fantasy range of games[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cosplay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78284e4d-5a30-3db4-be2e-edc4687de802",
                                        "entry_id": "19bd7ff9-4d83-363e-97c4-943a9cfd8cfe",
                                        "glosses": [
                                            "To costume oneself as a character."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6797e2e7-cddb-4351-9b31-d21c2a4da3e6",
                                                "sense_id": "78284e4d-5a30-3db4-be2e-edc4687de802",
                                                "text": "She cosplayed at the manga convention."
                                            },
                                            {
                                                "example_id": "02786e6a-01d6-4635-a5b3-00f81e4b50ba",
                                                "sense_id": "78284e4d-5a30-3db4-be2e-edc4687de802",
                                                "text": "Senior politicians have cosplayed as train drivers, ambulance workers, Border Force officials – the list goes on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "798dd50b-71d7-3e3b-a21d-2f88ff29ccce",
                                        "entry_id": "19bd7ff9-4d83-363e-97c4-943a9cfd8cfe",
                                        "glosses": [
                                            "To costume oneself as (a character)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c1e4fe7-1b96-4b09-977b-177aa0b5f1d7",
                                                "sense_id": "798dd50b-71d7-3e3b-a21d-2f88ff29ccce",
                                                "text": "She cosplayed Sailor Moon at the manga convention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9b4610b-25a2-3e46-ab9b-9a1a10d48963",
                                        "entry_id": "19bd7ff9-4d83-363e-97c4-943a9cfd8cfe",
                                        "glosses": [
                                            "To adopt the behavior and mannerisms of another."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d37c90b-dbe3-4d82-97ca-f07c808fcf53",
                                                "sense_id": "a9b4610b-25a2-3e46-ab9b-9a1a10d48963",
                                                "text": "On weekends, there was usually a party. Her classmates, free from their wealthy families, cosplayed as struggling intellectuals."
                                            },
                                            {
                                                "example_id": "295e7f53-be56-4991-86d1-3cf264b78e0b",
                                                "sense_id": "a9b4610b-25a2-3e46-ab9b-9a1a10d48963",
                                                "text": "Why has the Russian Federation decided to cosplay the Nazi Third Reich by attacking the peaceful neighboring state and plunging the region into war?"
                                            },
                                            {
                                                "example_id": "30f619ad-8837-4f7b-b465-602614cf5922",
                                                "sense_id": "a9b4610b-25a2-3e46-ab9b-9a1a10d48963",
                                                "text": "[…] turning conservative white men into amateur commandos cosplaying war wherever they liked and the US into a war zone."
                                            },
                                            {
                                                "example_id": "8085cd00-a961-4efa-89ff-7c5e59c65e25",
                                                "sense_id": "a9b4610b-25a2-3e46-ab9b-9a1a10d48963",
                                                "text": "Whilst their stability was generally an improvement on earlier German destroyers, as the vessels no longer displayed a strong desire to cosplay as U-boats, the main armament proved to be something of a problem."
                                            },
                                            {
                                                "example_id": "00524fca-aae1-4a20-8d96-87dbcee53176",
                                                "sense_id": "a9b4610b-25a2-3e46-ab9b-9a1a10d48963",
                                                "text": "Nigel Farage is a “political fraud and hypocrite” who is “cosplaying” as a working-class champion in order to win votes at this week’s local elections, the UK’s most senior union chief has warned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
