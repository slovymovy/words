                "forms": [],
                "senses": [
                    {
                        "sense_id": "abd0542f-ea1c-3bd1-aa84-7bd822a30b56",
                        "entry_id": "712a1a4b-8bbf-39e1-b5d4-059351995125",
                        "glosses": [
                            "Technique japonaise traditionnelle d’emballage en tissu utilisée pour transporter des objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd1c314b-5aa7-4775-a781-a5134b809843",
                                "sense_id": "abd0542f-ea1c-3bd1-aa84-7bd822a30b56",
                                "text": "Ce Noël verra-t-il le grand retour de la chaussette en laine, ou l’adoption massive du furoshiki, cet art japonais qui consiste à envelopper les objets offerts dans du tissu ?"
                            },
                            {
                                "example_id": "a1fee6b7-97b5-4d44-8d7a-bc33d6abdd53",
                                "sense_id": "abd0542f-ea1c-3bd1-aa84-7bd822a30b56",
                                "text": "La jeune femme sortit de son sac à main un foulard en soie vert tendre ; elle le plia en rectangle pour fixer ses cheveux.\n- C’est le furoshiki que tu m’as offert. Je peux m’en servir comme ça, tu vois, dit Anna en mêlant un sourire à ses larmes."
                            }
                        ]
                    }
                ],
