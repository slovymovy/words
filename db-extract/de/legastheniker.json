                "senses": [
                    {
                        "sense_id": "25179c23-ba4e-39ed-ba02-aac26aedcde1",
                        "entry_id": "d19e768d-c6c4-3d75-9a64-e02e24b7f10f",
                        "glosses": [
                            "(männliche) Person, die an Legasthenie leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8ed349-a437-47c3-b248-f967067bc80d",
                                "sense_id": "25179c23-ba4e-39ed-ba02-aac26aedcde1",
                                "text": "„Anerkannte Legastheniker sollen nach einem Erlass des bayerischen Kultusministeriums bei der Benotung nicht benachteiligt werden.“"
                            },
                            {
                                "example_id": "99679953-68f5-4282-adbd-7f057ef5aeb8",
                                "sense_id": "25179c23-ba4e-39ed-ba02-aac26aedcde1",
                                "text": "„Fast ein Drittel der Legastheniker habe sogar Selbstmordgedanken.“"
                            },
                            {
                                "example_id": "3edaaae6-f992-41f2-ad84-0a07fa325aaf",
                                "sense_id": "25179c23-ba4e-39ed-ba02-aac26aedcde1",
                                "text": "„Joshua ist Legastheniker und nicht gut in der Schule.“"
                            },
                            {
                                "example_id": "17821c2e-4f10-40c4-b819-e79884b62c8a",
                                "sense_id": "25179c23-ba4e-39ed-ba02-aac26aedcde1",
                                "text": "„Der federführende Legastheniker der kommaphoben Selbsthilfegruppe ist zu meiner Erleichterung »nach Diktat verreist«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
