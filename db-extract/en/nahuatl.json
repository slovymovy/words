                                        "entry_id": "e19dfd12-a12e-3d93-9a34-58318bc5fe27",
                                        "glosses": [
                                            "in Mexiko verbreitete indianische Sprache, die auf die Sprache der Azteken zurückgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75e99c67-e25d-4af5-b856-88409bfdd72b",
                                                "sense_id": "d0c4dcf6-85ed-3b13-a7a2-f8f96b8d53d0",
                                                "text": "Sprechen Sie Nahuatl?"
                                            },
                                            {
                                                "example_id": "12e11ca1-b7fe-4407-8ed6-b5f3990a38e8",
                                                "sense_id": "d0c4dcf6-85ed-3b13-a7a2-f8f96b8d53d0",
                                                "text": "Wie heißt das auf Nahuatl?"
                                            },
                                            {
                                                "example_id": "6375d1cd-98f0-4754-a9ab-b8e65709440d",
                                                "sense_id": "d0c4dcf6-85ed-3b13-a7a2-f8f96b8d53d0",
                                                "text": "Wie kann ich mein Nahuatl verbessern?"
                                            },
                                            {
                                                "example_id": "31b36d3e-67ca-4800-b8a4-859ac55c2615",
                                                "sense_id": "d0c4dcf6-85ed-3b13-a7a2-f8f96b8d53d0",
                                                "text": "„Spanische Geistliche waren die ersten unter den Eroberern, die über die selbst gezogenen Grenzen der Herrschaft hinwegschritten; sie lernten das Nahuatl der Mexica zu sprechen und begannen, deren Geschichte aufzuschreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
