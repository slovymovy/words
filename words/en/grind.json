{
    "word_family": [
        "grinder",
        "grindstone",
        "grinding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78f01a80-3104-341c-a165-688ac0dee093",
                    "sense_definition": "To break something into small pieces or powder by crushing it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_crush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>grind</w> the coffee beans just before brewing for the best flavor.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>помолоть</w> кофейные зерна прямо перед варкой для лучшего вкуса.",
                                "zh": "为了获得最佳风味，你应该在冲泡前现<w>磨</w>咖啡豆。"
                            }
                        },
                        {
                            "text": "The ancient mill was used to <w>grind</w> wheat into flour for the village.",
                            "target_lang_translations": {
                                "ru": "Древняя мельница использовалась, чтобы <w>молоть</w> пшеницу в муку для всей деревни.",
                                "zh": "这座古老的磨坊过去用来把小麦<w>磨</w>成面粉，供全村使用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grind coffee",
                        "grind corn",
                        "grind pepper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размельчать что-либо на мелкие кусочки или порошок путем давления или дробления.",
                        "zh": "通过压碎或碾磨把某物弄成小块或粉末。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молоть",
                                "target_lang_sense_clarification": "превращать в муку или порошок (кофе, зерно)"
                            },
                            {
                                "target_lang_word": "измельчать",
                                "target_lang_sense_clarification": "делать мелким"
                            },
                            {
                                "target_lang_word": "перемалывать",
                                "target_lang_sense_clarification": "тщательно молоть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨",
                                "target_lang_sense_clarification": "把咖啡豆、谷物等磨成粉或碎末"
                            },
                            {
                                "target_lang_word": "磨碎",
                                "target_lang_sense_clarification": "强调磨碎、研碎"
                            },
                            {
                                "target_lang_word": "研磨",
                                "target_lang_sense_clarification": "较正式，指研磨成粉末"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ee9d607-5011-323d-bc23-acb7ecfe4356",
                    "sense_definition": "To rub two surfaces together harshly, often making an unpleasant noise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "friction_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I often <w>grind</w> my teeth in my sleep when I am stressed.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>скрежещу</w> зубами во сне, когда испытываю стресс.",
                                "zh": "我压力大的时候，睡觉时常常会<w>磨</w>牙。"
                            }
                        },
                        {
                            "text": "The old truck's gears began to <w>grind</w> loudly as he shifted.",
                            "target_lang_translations": {
                                "ru": "Шестеренки старого грузовика начали громко <w>скрежетать</w>, когда он переключал передачу.",
                                "zh": "他换挡时，那辆旧卡车的齿轮开始大声<w>嘎吱作响</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grind one's teeth",
                        "gears grind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно тереть поверхности друг о друга, часто издавая неприятный звук.",
                        "zh": "使两个表面用力摩擦，通常还会发出令人不快的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрежетать",
                                "target_lang_sense_clarification": "издавать резкий звук трения (зубами, металлом)"
                            },
                            {
                                "target_lang_word": "тереть",
                                "target_lang_sense_clarification": "с силой водить по поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨",
                                "target_lang_sense_clarification": "指牙齿或金属发出的刺耳摩擦声；也可用于磨牙"
                            },
                            {
                                "target_lang_word": "嘎吱作响",
                                "target_lang_sense_clarification": "强调发出难听的摩擦声"
                            },
                            {
                                "target_lang_word": "摩擦出刺耳声",
                                "target_lang_sense_clarification": "较书面，指发出刺耳摩擦声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f526f90-80b6-3e03-84ad-2056c7779510",
                    "sense_definition": "To make something smooth or sharp by rubbing it against a hard surface.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sharpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith began to <w>grind</w> the sword to ensure it was razor-sharp.",
                            "target_lang_translations": {
                                "ru": "Кузнец начал <w>точить</w> меч, чтобы убедиться, что он острый как бритва.",
                                "zh": "铁匠开始<w>磨</w>这把剑，确保它锋利无比。"
                            }
                        },
                        {
                            "text": "He used a special tool to <w>grind</w> the rough edges off the glass.",
                            "target_lang_translations": {
                                "ru": "Он использовал специальный инструмент, чтобы <w>отшлифовать</w> неровные края стекла.",
                                "zh": "他用一种专门的工具把玻璃粗糙的边缘<w>磨光</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grind a knife",
                        "grind metal",
                        "grind a lens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо гладким или острым путем трения о твердую поверхность.",
                        "zh": "通过在坚硬表面上摩擦，使某物变得光滑或锋利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точить",
                                "target_lang_sense_clarification": "делать острым (нож, меч)"
                            },
                            {
                                "target_lang_word": "шлифовать",
                                "target_lang_sense_clarification": "делать гладким, обрабатывать абразивом"
                            },
                            {
                                "target_lang_word": "отшлифовать",
                                "target_lang_sense_clarification": "завершить шлифовку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨",
                                "target_lang_sense_clarification": "使刀、剑等变锋利"
                            },
                            {
                                "target_lang_word": "磨光",
                                "target_lang_sense_clarification": "使表面变平滑"
                            },
                            {
                                "target_lang_word": "磨削",
                                "target_lang_sense_clarification": "较正式，指用磨削方式加工表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c56bf58e-deab-3b09-b11c-a6e0e364412e",
                    "sense_definition": "To work or study very hard and for a long time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "work_hard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>grind</w> all weekend to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>пахать</w> все выходные, чтобы закончить проект вовремя.",
                                "zh": "为了按时完成项目，她整个周末都得<w>拼命干</w>。"
                            }
                        },
                        {
                            "text": "Students often <w>grind</w> in the library during finals week.",
                            "target_lang_translations": {
                                "ru": "Студенты часто <w>зубрят</w> в библиотеке во время экзаменационной недели.",
                                "zh": "考试周期间，学生们常常在图书馆里<w>苦读</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grind away",
                        "grind for exams"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in student or workplace contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень усердно работать или учиться в течение долгого времени.",
                        "zh": "长时间非常努力地工作或学习。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пахать",
                                "target_lang_sense_clarification": "разг. много и тяжело работать"
                            },
                            {
                                "target_lang_word": "зубрить",
                                "target_lang_sense_clarification": "усердно учить"
                            },
                            {
                                "target_lang_word": "вкалывать",
                                "target_lang_sense_clarification": "разг. напряженно работать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拼命干",
                                "target_lang_sense_clarification": "口语，指长时间非常辛苦地工作"
                            },
                            {
                                "target_lang_word": "苦读",
                                "target_lang_sense_clarification": "指很刻苦地学习"
                            },
                            {
                                "target_lang_word": "埋头苦干",
                                "target_lang_sense_clarification": "口语，指埋头苦干"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "386e5e5d-2908-3bd0-aac8-2dfa43857523",
                    "sense_definition": "To perform repetitive tasks in a video game to gain experience or items.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Players often <w>grind</w> for hours to unlock the best equipment.",
                            "target_lang_translations": {
                                "ru": "Игроки часто <w>гриндят</w> часами, чтобы открыть лучшее снаряжение.",
                                "zh": "玩家们常常连续几个小时<w>刷</w>，就为了获得最好的装备。"
                            }
                        },
                        {
                            "text": "I do not want to <w>grind</w> through the same level just to get more points.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>гриндить</w> один и тот же уровень только ради получения очков.",
                                "zh": "我不想为了多拿几点分数，就反复<w>刷</w>同一关。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grind for loot",
                        "grind levels",
                        "grind XP"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять повторяющиеся задачи в видеоигре для получения опыта или предметов.",
                        "zh": "在电子游戏中反复完成任务，以获得经验值或物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гриндить",
                                "target_lang_sense_clarification": "сленг геймеров"
                            },
                            {
                                "target_lang_word": "фармить",
                                "target_lang_sense_clarification": "добывать ресурсы в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刷",
                                "target_lang_sense_clarification": "游戏里反复做重复内容以获取经验、装备等"
                            },
                            {
                                "target_lang_word": "刷任务",
                                "target_lang_sense_clarification": "玩家用语，强调反复刷取资源或掉落"
