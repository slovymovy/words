                        "examples": [
                            {
                                "example_id": "391a834e-f013-4e7f-b3fc-a50345811929",
                                "sense_id": "b4fdff76-143b-39e1-bb9f-3b097f180a69",
                                "text": "„Im Sommer ging er fast täglich hin, um ein warmes Hummerbrötchen zu verspeisen, allerdings nur außerhalb der normalen Essenszeiten und nie, wenn im Linda Jean’s Hochbetrieb herrschte, denn nach seinem Sturz lebte der Richter in ständiger Angst, erkannt zu werden.“"
                            },
                            {
                                "example_id": "c3d38dce-74fb-4468-951f-3ccfbaae9196",
                                "sense_id": "b4fdff76-143b-39e1-bb9f-3b097f180a69",
                                "text": "„Shaw trank nun also sein Bier und blätterte, überwiegend aus Neugier, in der Speisekarte mit ihren Touristenpreisen - wenngleich die Gerichte für den Nob Hill durchaus angemessen waren: Manchego-Käse, Serrano-Schinken, Bruschetta, Hummerbrötchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
