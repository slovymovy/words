                        "examples": [
                            {
                                "example_id": "067b9813-1f1c-41f4-b0f7-13835734b19c",
                                "sense_id": "dd25b878-9611-3339-84b3-8f0b40c7eca4",
                                "text": "Volk van Amsterdam, wat doet gij thans om te bewijzen dat de tijd van vrijheid en geluk waarlijk is begonnen? Binnen een paar minuten komt een aantal opgeschoten jongens aandragen met een lange stam, de mast van een turfschip, die ze onder hevig protest van een schipper bij het Rokin hebben geroofd."
                            },
                            {
                                "example_id": "716ce740-51e8-4557-baff-36acd429a3cd",
                                "sense_id": "dd25b878-9611-3339-84b3-8f0b40c7eca4",
                                "text": "Ondanks hun geringe middelen streven zij toch naar dat ouderwetse meerderheidsbelang, alsof er helemaal geen beurs bestaat steken zij alles wat zij hebben in één enkele, kleine onderneming en zo eindigen zij ten slotte als eigenaar van een winkel, of een turfschip."
                            }
                        ]
                    }
