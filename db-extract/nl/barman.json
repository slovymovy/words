                "senses": [
                    {
                        "sense_id": "781fc74e-95b5-3d29-b9be-9cf131969af8",
                        "entry_id": "9452bda0-b729-3b0c-8bef-ca6468edd69e",
                        "glosses": [
                            "iemand die achter de bar staat en drankjes voor de gasten inschenkt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "1f9ffb0a-2d6a-4f03-92ed-b00ca9247ccf",
                                "sense_id": "781fc74e-95b5-3d29-b9be-9cf131969af8",
                                "text": "De anonimiteit en vluchtigheid die een verblijf in een hotel normaal gesproken kenmerken, die de sensatie van treurnis en opwinding teweegbrengen dat je tijdelijk in een niemandsland tussen vertrek van huis en thuiskomst verzeild bent geraakt, waar, omdat er niets gebeurt, net zo goed alles zou kunnen gebeuren, en die een man alleen tussen vreemde lakens na een whisky te veel, achterovergeslagen op een kruk aan de bar in de lobby met een laatste slappe grap voor de stoïcijns glazen polerende barman, op het idee kunnen brengen dat er geen haan naar zou kraaien als hij de nachtportier belde met de vraag of hij iemand kende die haar diensten aanbood, waarbij het alleen die whisky te veel is die hem ervan weerhoudt om dat ook echt te doen, zijn hier in Grand Hotel Europa bleke herinneringen aan een moderniteit die zich ver weg van hier afspeelt in een andere wereld."
                            },
                            {
                                "example_id": "2607d67a-395a-4db1-bdb0-708f92855d01",
                                "sense_id": "781fc74e-95b5-3d29-b9be-9cf131969af8",
                                "text": "Toen ik bij de barman naar de wificode informeerde, bromde hij dat het internet al een week niet werkte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55e8bab6-820e-41e0-aa3e-b89fd763fde1",
                        "source_entry_id": "9452bda0-b729-3b0c-8bef-ca6468edd69e",
                        "source_sense_id": "781fc74e-95b5-3d29-b9be-9cf131969af8",
                        "source_sense_description": "iemand die achter de bar staat en drankjes voor de gasten inschenkt",
                        "target_lang_word": "Barmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                        "entry_id": "656e66f4-77df-35b5-8f79-4f674d04d7e9",
                                        "glosses": [
                                            "männliche Person, die an einer Bar arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6265c6-285d-4f58-b570-cfcf64e899c9",
                                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                                "text": "Der Student arbeitet am Wochenende als Barmann und verdient sich so ein paar Euro dazu."
                                            },
                                            {
                                                "example_id": "7f425545-831f-4ac1-bbd2-97a6e397ee41",
                                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                                "text": "„Der Barmann goss ihm einen Doppelten ein. Er schüttete ihn rein. Der Barmann füllte nach. Er schüttete ihn rein. Der Barmann füllte nach. Er schüttete ihn rein und ließ einen Zwanziger auf die Bar fallen.“"
                                            },
                                            {
                                                "example_id": "4cb45cad-e5a9-4f83-8355-c61954ddf943",
                                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                                "text": "„Während wir reden, geht Deans Blick immer wieder an mir vorbei zur Kellnerin, die ab und zu ein paar knappe Bemerkungen mit dem Barmann wechselt und manchmal resigniert aufseufzt.“"
                                            },
                                            {
                                                "example_id": "c0a42b5d-9727-4a65-823e-3f1f7f4b7415",
                                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                                "text": "„Ich trank aus, beorderte den Barmann zu mir und bestellte nochmal dasselbe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1699c10-2c33-4ed4-a831-24299c7401a0",
                        "source_entry_id": "9452bda0-b729-3b0c-8bef-ca6468edd69e",
                        "source_sense_id": "781fc74e-95b5-3d29-b9be-9cf131969af8",
