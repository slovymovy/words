                    }
                ],
                "senses": [
                    {
                        "sense_id": "008def72-485c-303d-b539-45c9df77ae36",
                        "entry_id": "fcb7ece9-4fc1-30d4-b4cf-e0f4f1642e79",
                        "glosses": [
                            "Qui murmure."
                        ],
                        "tags": [
                            "poetic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e3437dad-641b-45cd-8b58-434fbf858b58",
                                "sense_id": "008def72-485c-303d-b539-45c9df77ae36",
                                "text": "Murmureuses fontaines."
                            },
                            {
                                "example_id": "4a991a61-0d62-4007-b135-8a91af040d10",
                                "sense_id": "008def72-485c-303d-b539-45c9df77ae36",
                                "text": "Vous, célébrez cette déesse, amants\n Des fleuves purs et des bois murmureux\n Qui couvrent le noir Érymanthe,\n Le Cragus vert, l’Algide glaceux."
                            },
                            {
                                "example_id": "fb6bdb50-47c7-406a-8305-79caf5ee8d7a",
                                "sense_id": "008def72-485c-303d-b539-45c9df77ae36",
                                "text": "Allons, de ce tombeau, recueillis et plus sages,\n Porter l’enseignement des murmureux ombrages\n Jusqu’au moindre hameau ; […]"
                            },
                            {
                                "example_id": "9b1b0eab-d13a-4659-bc7e-569b0391b45f",
                                "sense_id": "008def72-485c-303d-b539-45c9df77ae36",
                                "text": "Entre les tentures coulait un fin pinceau de lumière chaude et jaune et délicieuse, qu’elle laissait courir sur ses joues et ses paupières et ses lèvres murmureuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e309216-a6cc-4753-841f-6916e7ec5749",
                        "source_entry_id": "fcb7ece9-4fc1-30d4-b4cf-e0f4f1642e79",
                        "source_sense_id": "008def72-485c-303d-b539-45c9df77ae36",
                        "target_lang_word": "murmurous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "murmurous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                        "entry_id": "4fbfab15-f9f6-3176-9136-1dc4b8a8ed8d",
                                        "glosses": [
                                            "Low, indistinct (of a sound); reminiscent of a murmur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8fcbb3-e032-46b9-9b8b-02f9e7decfbd",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "Like as a fire, the which in hollow cave\nHath long bene underkept, and down supprest,\nWith murmurous disdaine doth inly rave,\nAnd grudge, in so streight prison to be prest,"
                                            },
                                            {
                                                "example_id": "438b8f4c-6ebd-43b4-8706-e4da3cbaafbc",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "Throughout all the isle\nThere was no covert, no retired cave\nUnhaunted by the murmurous noise of waves,\nThough scarcely heard in many a green recess."
                                            },
                                            {
                                                "example_id": "4f44c420-1049-454b-93a2-aa020f55c289",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "He felt some dark presence moving irresistably upon him from the darkness, a presence subtle and murmurous as a flood filling him wholly with itself."
                                            },
                                            {
                                                "example_id": "ee361eaf-2992-4cbe-a867-fb29473ead05",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "Waiting, with a glass in my hand\n—three girls in crimson satin\npass close before me on\nthe murmurous background of\nthe crowded opera—"
                                            },
                                            {
                                                "example_id": "b37f5cc7-53a2-4cd5-8d20-5b75d37d460c",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "Marvelling they stood, and watched the long grass swirled\nBy the May breeze, murmurous with wasp and midge,"
                                            },
                                            {
                                                "example_id": "61070da1-a900-4f1c-9dfb-e850151489d8",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "And if she speaks in her frail way,\nit is wholly to bewitch\nmy smallest thought with a most swift\nradiance wherein slowly drift\nmurmurous things divinely bright;"
                                            },
                                            {
                                                "example_id": "3e31feb8-c651-4bc0-a40b-9c63015f58dc",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "The seeming remoteness of its source was because of its murmurous indistinctness since it came from close-by, even from the men massed on the ship's open deck."
                                            },
                                            {
                                                "example_id": "0cd9a764-6a62-43a7-af0e-e2e242936b3a",
                                                "sense_id": "d0301b1d-f493-3e50-8504-247faaac836f",
                                                "text": "1959, Samuel Beckett, The Unnamable, in The Beckett Trilogy: Molloy; Malone Dies; The Unnamable, London: Calder, 1994, p. 397,\nIt will be the same silence, the same as ever, murmurous with muted lamentation, panting and exhaling of impossible sorrow, like distant laughter, and brief spells of hush, as of one buried before his time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
