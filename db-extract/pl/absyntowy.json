                                                "example_id": "5430c01c-980e-4e32-a32c-02efcdf64ccd",
                                                "sense_id": "fe6262e7-3481-3315-b294-22c8de377e47",
                                                "text": "The unfortunate dog will, dur- during ten minutes, have had an attack of intoxication and absinthian epilepsy ; but at the end of an hour he will have recovered completely."
                                            },
                                            {
                                                "example_id": "2b1c8932-e6e9-4e9a-86e3-308089665c0b",
                                                "sense_id": "fe6262e7-3481-3315-b294-22c8de377e47",
                                                "text": "The skinny shadows of symbolist poets, converts to Catholicism, linger in the absinthian green of the Boulevard trees."
                                            },
                                            {
                                                "example_id": "d9d48e27-b749-4ac9-81b0-e5dc5240081a",
                                                "sense_id": "fe6262e7-3481-3315-b294-22c8de377e47",
                                                "text": "… in the dazed course of an absinthian stupor, …"
                                            }
                                        ]
