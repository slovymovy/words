                        "glosses": [
                            "Dégât causé au blé par la nielle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d4343ba8-944f-442e-812d-7f48fcd4009d",
                                "sense_id": "1f3a29d8-4586-3612-af3e-6b618e774c6d",
                                "text": "Nous sommes à la merci du ciel inconstant qui fait pleuvoir sur le tendre épi, non seulement les eaux nourrissantes de la pluie, mais encore la rouille inhérente & consumante de la niellure."
