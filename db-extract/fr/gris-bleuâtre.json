                        "glosses": [
                            "De couleur grise qui tire sur le bleu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d566773-00eb-47cf-ac3b-ba2e583e9e0d",
                                "sense_id": "7f2b2ce9-f52b-3d59-843a-7878a44ba33e",
                                "text": "Marnes et calcaires marneux assez homogènes, gris-bleuâtre, à texture terreuse et à cassure sub-schisteuse."
                            },
                            {
                                "example_id": "65c2b7d4-edd8-4601-b9e1-2307c2297953",
                                "sense_id": "7f2b2ce9-f52b-3d59-843a-7878a44ba33e",
                                "text": "Prismatique et cylindroïde, gris-bleuâtre, cristaux entièrement recouverts de plomb phosphaté brun mamelonné ; Poullaouen, département des Côtes-du-Nord."
                            },
                            {
                                "example_id": "fe8de43b-dfa3-4d64-9198-c4c2fadfb860",
                                "sense_id": "7f2b2ce9-f52b-3d59-843a-7878a44ba33e",
                                "text": "Avant de quitter le torrent, pour monter à Dragia, on rencontre de nouveau des grès marneux, fins, gris-bleuâtres, et le coteau de Dragia se trouve composé de ces molasses couvertes d’argile marneuse jaunâtre."
                            }
                        ]
                    }
