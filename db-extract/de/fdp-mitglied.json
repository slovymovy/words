                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1518bc-f5e9-4fdb-9aec-41b2af2948e3",
                                "sense_id": "489bd251-4c54-365f-ac16-c08e9e620128",
                                "text": "„Die Tochter des ehemaligen CSU-Ministerpräsidenten Horst Seehofer, Susanne Seehofer, ist FDP-Mitglied.“"
                            },
                            {
                                "example_id": "927a9b5c-cc28-4236-9fda-a87d8462069e",
                                "sense_id": "489bd251-4c54-365f-ac16-c08e9e620128",
                                "text": "„Die Regierungsarbeit in der Ampel soll fortgesetzt werden: Dafür sprach sich nun eine knappe Mehrheit der FDP-Mitglieder aus.“"
                            }
                        ],
