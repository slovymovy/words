                    {
                        "translation_id": "e4003d86-9d30-4d78-b620-40c6a57fe926",
                        "source_entry_id": "e1df2832-a508-34ac-ad95-f32f1e78adde",
                        "source_sense_id": "7858ea1d-f847-3bdf-9eb0-281a6dccc5cc",
                        "target_lang_word": "Umweltschützer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umweltschützer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0eb2ae2-910c-31d6-83b2-1a33132aa165",
                                        "entry_id": "d1af2226-8dbe-3f01-88f4-bf4a07466140",
                                        "glosses": [
                                            "Person, die sich dezidiert für den Schutz der Umwelt einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd93b8b-e99c-4517-b02b-d1bb042abb09",
                                                "sense_id": "f0eb2ae2-910c-31d6-83b2-1a33132aa165",
                                                "text": "„Nur rund 0,35 Prozent der jährlichen CO2-Emissionen von 94 Millionen Tonnen werde in Gewächshäuser geleitet. Über die Schwefelverwendung habe man \"keine Informationen\" finden können, sagte eine Sprecherin der Umweltschützer.“"
                                            },
                                            {
                                                "example_id": "d91d903a-4f70-4814-81ad-9ff332c638b0",
                                                "sense_id": "f0eb2ae2-910c-31d6-83b2-1a33132aa165",
                                                "text": "„Am Schluss fielen alle über ihn her: Umweltschützer, Politiker, sogar die Bundeskanzlerin selbst kritisierte, dass Vattenfall völlig unzureichend auf die Serie von Pannen in den Atomkraftwerken Krümmel und Brunsbüttel reagiert hatte.“"
                                            },
                                            {
                                                "example_id": "fd29581e-392a-42bc-a9bd-b7bb74149466",
                                                "sense_id": "f0eb2ae2-910c-31d6-83b2-1a33132aa165",
                                                "text": "„Helle Aufregung um die Ostseepipeline: Ab 2010 soll sie russisches Erdgas liefern - doch um es zu verteilen, muss ein ganzes Netz neuer Leitungen entstehen. Quer durch Deutschland werden nun Röhren verlegt, auch in Naturschutzzonen. Bauern und Umweltschützer sind entsetzt.“"
                                            },
                                            {
                                                "example_id": "cc51954b-a897-4bdc-8586-a19a2570d005",
                                                "sense_id": "f0eb2ae2-910c-31d6-83b2-1a33132aa165",
                                                "text": "„Das LBT steht auf dem 3190 Meter hohen Mount Graham in Arizona. Indianer, denen der Berg heilig ist, und Umweltschützer hatten gegen das Projekt protestiert.“"
                                            },
                                            {
                                                "example_id": "5be5d3b6-8551-4052-99ef-38a604a30cf9",
                                                "sense_id": "f0eb2ae2-910c-31d6-83b2-1a33132aa165",
                                                "text": "„Die Stimmung bei den Umweltschützern ist mies, der grüne Spitzenkandidat Trittin singt seinen Schwanengesang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
