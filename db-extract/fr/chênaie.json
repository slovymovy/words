                                    {
                                        "sense_id": "6f84e0ab-3b53-39f0-858d-df692e537c37",
                                        "entry_id": "8fcc3b4d-2f0a-3ed9-a721-6ebd17c04457",
                                        "glosses": [
                                            "een bos waarin vooral eiken staan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c262806b-7b61-4bbf-b3cc-841a8cc37361",
                                                "sense_id": "6f84e0ab-3b53-39f0-858d-df692e537c37",
                                                "text": "De Raad van State schorst het ruimtelijk uitvoeringsplan voor de Closing the Circle-recyclinginstallaties ten voordele van een beschermd eikenbos. De schorsing komt er op vraag van de Limburgse Milieukoepel en buurtbewoners van domein Hoeverheide."
                                            },
                                            {
                                                "example_id": "ad94dfa5-86c1-41ec-af6a-4ceda7b72ccd",
                                                "sense_id": "6f84e0ab-3b53-39f0-858d-df692e537c37",
                                                "text": "De Raad van State heeft een streep gezet door de herplantplicht die de gemeente Tubbergen oplegde aan de eigenaar van een illegaal gekapt eikenbos aan de Noordergraafsingel in Harbrinkhoek. De hoogste bestuursrechter wil dat de gemeente een nieuw besluit neemt, omdat de opgelegde plicht volgens hem te ver gaat."
                                            },
                                            {
                                                "example_id": "c011576d-f064-4267-9cb7-9a534d3cb30b",
                                                "sense_id": "6f84e0ab-3b53-39f0-858d-df692e537c37",
                                                "text": "De gruwelen van mosterdgas en suizende granaten zijn aan het Bergherbos voorbijgegaan. Maar de anderhalve meter diepe sleuf die honderden meters door het eikenbos kronkelt, is wel degelijk een restant uit de Eerste Wereldoorlog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
