                    {
                        "sense_id": "572c0212-78ac-37a9-8a48-6661e633e46d",
                        "entry_id": "907e4340-cf76-36b2-a753-52201835e7c5",
                        "glosses": [
                            "A subsequent brief recitement or enumeration of the major points in a narrative, article, or book."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "449ae616-ad5e-4ad1-8c7b-08f097d1e556",
                                "sense_id": "572c0212-78ac-37a9-8a48-6661e633e46d",
                                "text": "The dolorous effects of the second world war on train services, and its protracted legacies of over-age equipment and shortages of material for replacement, are too fresh in memory to require recapitulation here; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "59c474c2-0001-381e-b5d0-0b7f2edd0e90",
                        "entry_id": "907e4340-cf76-36b2-a753-52201835e7c5",
                        "glosses": [
                            "The third major section of a musical movement written in sonata form, representing thematic material that originally appeared in the exposition section."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4e0c405e-4ce2-3006-833e-8f3666a3765b",
                        "entry_id": "907e4340-cf76-36b2-a753-52201835e7c5",
                        "glosses": [
                            "The reenactment of the embryonic development in evolution of the species."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b13e5a6-1961-314e-9839-925cd1a1f0ef",
                        "entry_id": "907e4340-cf76-36b2-a753-52201835e7c5",
                        "glosses": [
                            "The symmetry provided by Christ's life to the teachings of the Old Testament; the summation of human experience in Jesus Christ."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6dd9830b-0951-4d76-bb97-3dffe6a2bb87",
                                "sense_id": "7b13e5a6-1961-314e-9839-925cd1a1f0ef",
                                "text": "one would expect God's final purpose to be expressed in his created world, since the doctrine of recapitulation showed that this is where his plans had worked out before."
                            }
                        ]
                    }
                ],
