                        "sense_id": "03db74ff-bc74-3c5a-b5f7-700392ebc476",
                        "entry_id": "952002c2-5d32-3e99-b3f8-60993a7aa610",
                        "glosses": [
                            "Obsolete spelling of soil."
                        ],
