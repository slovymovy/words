                                                "sense_id": "81ea10ee-940e-3de2-8e37-4c9c0ee14ebd",
                                                "text": "„Er hatte seine Tabakdose auf den Tisch gelegt.“"
                                            },
                                            {
                                                "example_id": "70b2dea6-236a-4734-8ebd-b9aa7fa99a7c",
                                                "sense_id": "81ea10ee-940e-3de2-8e37-4c9c0ee14ebd",
                                                "text": "„Im Etui fand ich eine goldene Tabakdose; einige Spuren spanischen Tabaks darin bewiesen, daß man sie bereits benutzt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
