                "senses": [
                    {
                        "sense_id": "18d72d40-09ef-3c30-991d-18f96ed3f3e0",
                        "entry_id": "c00a5424-3964-3ac4-b689-496c0e12b38f",
                        "glosses": [
                            "Gebet, das zur Nacht gebetet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027e647f-e80f-4f67-b5d4-1a5062e9a925",
                                "sense_id": "18d72d40-09ef-3c30-991d-18f96ed3f3e0",
                                "text": "„Am späten Abend des 18. Mai 2016 spricht der pensionierte Lehrer Günter M. wie üblich ein Nachtgebet mit seiner Frau Maria.“"
                            },
                            {
                                "example_id": "9daa8072-34da-4265-84cd-512f52d60dad",
                                "sense_id": "18d72d40-09ef-3c30-991d-18f96ed3f3e0",
                                "text": "„Sie kannte niemanden, der im Ausland gewesen war, doch in jedem ihrer Nachgebete bat sie Gott um ein Wunder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
