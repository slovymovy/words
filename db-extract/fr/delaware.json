            {
                "entry_id": "e9545fe4-064c-3ae1-a472-29ce7844c1cf",
                "word": "Delaware",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2d01af5-b896-3a76-91d3-ec95a43df0f1",
                        "entry_id": "e9545fe4-064c-3ae1-a472-29ce7844c1cf",
                        "glosses": [
                            "Un des treize États de la Nouvelle-Angleterre aux États-Unis d’Amérique (code postal DE), bordé par la Pennsylvanie au nord, le New Jersey, le fleuve Delaware et l’océan Atlantique Nord à l’est, et le Maryland au sud et à l’ouest, et dont la capitale est Dover."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd73df0-4874-4cac-b368-b3deea6f59ce",
                                "sense_id": "e2d01af5-b896-3a76-91d3-ec95a43df0f1",
                                "text": "Cela ne m’empêche pas, cependant, d’observer de nombreux changements dans le comportement du politicien du Delaware."
                            },
                            {
                                "example_id": "83f1dcf8-6fe1-4661-81d2-b3649777af5b",
                                "sense_id": "e2d01af5-b896-3a76-91d3-ec95a43df0f1",
                                "text": "Alfred D. Chandler est né en 1918 dans l'État du Delaware aux États-Unis."
                            },
                            {
                                "example_id": "817716cd-388f-43da-9c14-91b9e09d3663",
                                "sense_id": "e2d01af5-b896-3a76-91d3-ec95a43df0f1",
                                "text": "« Les gens ne basculent pas tout à coup dans les comportements antisociaux. Ils vont plutôt aider leurs voisins, venir au secours d’étrangers », note Tricia Wachtendorf, chercheuse à l’université du Delaware, dans une séquence du documentaire Vers un monde altruiste de Sylvie Gilman et Thierry de Lestrade (2015) citée dans Télérama."
                            }
                        ]
                    },
                    {
                        "sense_id": "91a186db-f8d7-3620-b614-4fe63e314765",
                        "entry_id": "e9545fe4-064c-3ae1-a472-29ce7844c1cf",
                        "glosses": [
                            "Fleuve du nord-est des États-Unis qui se jette dans l'océan Atlantique."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1def9a35-3e33-4435-8149-78189efda4e1",
                        "source_entry_id": "e9545fe4-064c-3ae1-a472-29ce7844c1cf",
                        "target_lang_word": "Delaware",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Delaware",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b6d8308-e03e-35d3-90f1-033f67357d61",
                                        "entry_id": "89ec44ee-2eac-37a3-b0df-e013af3ce5cc",
                                        "glosses": [
                                            "Bundesstaat an der Ostküste der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa08813-10e4-4569-8475-d4a045ec6a5d",
                                                "sense_id": "8b6d8308-e03e-35d3-90f1-033f67357d61",
                                                "text": "„Delaware sagte sich als eine von dreizehn Kolonien von den britischen Machthabern los und schloss sich der Amerikanischen Unabhängigkeitsbewegung an.“"
                                            },
                                            {
                                                "example_id": "2f2497cb-1f91-44e7-8741-57dcb31edf31",
                                                "sense_id": "8b6d8308-e03e-35d3-90f1-033f67357d61",
                                                "text": "Der kleine Staat Delaware ist bekannt für sein liberales Unternehmensrecht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Delaware",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52bff867-1963-3d21-a007-518a59601dc3",
                                        "entry_id": "8b0a0dd1-57c6-3aa0-b56a-fda400214348",
                                        "glosses": [
                                            "Fluss im Osten der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5382dd28-ddf0-49af-981d-2b9a303a093b",
                                                "sense_id": "52bff867-1963-3d21-a007-518a59601dc3",
                                                "text": "„Die Meeresströmung dringt den Delaware weit hinauf, so dass er größeren Schiffen bis nach Philadelphia zugänglich ist.“"
                                            },
                                            {
                                                "example_id": "9534a3b4-1861-4697-88d3-156376ef116e",
                                                "sense_id": "52bff867-1963-3d21-a007-518a59601dc3",
                                                "text": "Da fließt der Delaware."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Delaware",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32285da1-d5ce-310e-ba50-decef3608ba5",
                                        "entry_id": "7d60994c-dbde-30e8-ae07-792714b4892d",
                                        "glosses": [
                                            "Angehöriger des Indianerstamms der Lenni Lenape"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8045a03a-0134-4150-b339-4a2eaf49ebcb",
                                                "sense_id": "32285da1-d5ce-310e-ba50-decef3608ba5",
                                                "text": "„Um 1970 hatten sich die Delawaren kulturell fast vollständig an den Lebensstil ihrer weißen Nachbarn angepasst.“"
                                            },
                                            {
                                                "example_id": "565ada5c-156e-4eb9-8b8e-3b18692b95ed",
                                                "sense_id": "32285da1-d5ce-310e-ba50-decef3608ba5",
                                                "text": "„Es gab mehrere mexikanische Sklaven im Lager; unter lauten spanischen Rufen rannten sie aus den Hütten, die Freischärler schlugen ihnen die Schädel ein oder schossen sie nieder, einer der Delawaren, in jeder Hand einen baumelnden Säugling, tauchte aus dem Qualm, ging vor einem Steinhaufen in die Hocke, hielt die Kinder an den Füßen fest, holte aus und knallte ihre Köpfe nacheinander gegen die Steine, die Gehirne platzten in einem Blutschwall unter der Fontanelle hervor, brennende Menschen stoben unter rasendem Gebrüll aus den Hütten, die Reiter hackten sie mit ihren riesigen Messern nieder, eine junge Frau eilte herbei und umarmte den blutigen Vorderfuß von Glantons Schlachtross.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
