                "senses": [
                    {
                        "sense_id": "0663857b-02c9-35a2-9ade-6f9ce88f0d71",
                        "entry_id": "93bf679d-0328-32bd-b262-e141a7528bbc",
                        "glosses": [
                            "innere Befriedigung und frohe Stimmung aufgrund eines harmonischen Zusammenlebens mit Partner/Partnerin und Kind(ern)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299484af-4bf7-40e9-93ae-d6b5447367bf",
                                "sense_id": "0663857b-02c9-35a2-9ade-6f9ce88f0d71",
                                "text": "Oliver hatte nie die große Karriere im Sinn. Er sehnte sich vielmehr schon immer nach dem eigenen kleinen Familienglück."
                            },
                            {
                                "example_id": "9fe6afb4-0e3e-4a8a-993f-a5962ba88709",
                                "sense_id": "0663857b-02c9-35a2-9ade-6f9ce88f0d71",
                                "text": "Ihr Familienglück endete jäh, als ihr zweijähriger Sohn bei einem Unfall starb."
                            },
                            {
                                "example_id": "0d20e0b6-1ab0-48ac-88e4-931c4095f78f",
                                "sense_id": "0663857b-02c9-35a2-9ade-6f9ce88f0d71",
                                "text": "„Es bot sich ihm daher keine Aussicht zu einem Familienleben und einem Familienglücke, nach dem jetzt im tiefsten Grunde seines Herzens eine stille Sehnsucht lebte, die er laut werden zu lassen seinem Stolze nicht vergönnte.“"
                            },
                            {
                                "example_id": "4a30bde6-0c03-4609-87ca-99a78359f683",
                                "sense_id": "0663857b-02c9-35a2-9ade-6f9ce88f0d71",
                                "text": "„Er sah das stille Leben und das ruhige Familienglück in Lysyja Gory vor sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
