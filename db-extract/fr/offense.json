                                            {
                                                "example_id": "0cb4a374-f3e0-4439-9e20-bc92c5e1aae3",
                                                "sense_id": "91faf038-6a01-3b51-a0df-cd41274baf4f",
                                                "text": "The slave fully appreciates the saying, \"where ignorance is bliss, 'tis folly to be wise.\" When old master's gestures were violent, ending with a threatening shake of the head, and a sharp snap of his middle finger and thumb, I deemed it wise to keep at a respectable distance from him; for, at such times, trifling faults stood, in his eyes, as momentous offenses; and, having both the power and the disposition, the victim had only to be near him to catch the punishment, deserved or undeserved."
                                            },
                                            {
                                                "example_id": "f2e3c3ac-04ba-4a8a-9316-7d73ebeefff2",
                                                "sense_id": "91faf038-6a01-3b51-a0df-cd41274baf4f",
                                                "text": "The popular late Middle Ages fictional character Robin Hood, dressed in green to symbolize the forest, dodged fines for forest offenses and stole from the rich to give to the poor. But his appeal was painfully real and embodied the struggle over wood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a0b148b-0f9f-3731-a5e2-55be938ab5bf",
                                        "entry_id": "c755b56f-a203-35ad-a921-64d4c5ef00d2",
                                        "glosses": [
                                            "The act of offending.",
                                            "An affront, injury, or insult."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ccad5c-fa63-4ada-9da7-96f227da96e6",
                                                "sense_id": "7a0b148b-0f9f-3731-a5e2-55be938ab5bf",
                                                "text": "Thus I have ventur'd to give my Opinion on this Subject againſt the Authority of tvvo great men, but I hope vvithout offence to either of their Memories, for I both lov'd them living, and reverence them now they are dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf916f88-249d-3f3d-8f40-c27e04cd1ed7",
                                        "entry_id": "c755b56f-a203-35ad-a921-64d4c5ef00d2",
                                        "glosses": [
                                            "The state of being offended or displeased; anger; displeasure."
