        "ru-extract.jsonl": [
            {
                "entry_id": "d167937d-8abd-3450-a838-5974a59b6c3d",
                "word": "косяком",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a55b93d0-b8dd-3470-8132-a2bf969c8429",
                        "entry_id": "d167937d-8abd-3450-a838-5974a59b6c3d",
                        "glosses": [
                            "разг. наискось"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e37390e-d709-4099-b04d-128ae3222955",
                                "sense_id": "a55b93d0-b8dd-3470-8132-a2bf969c8429",
                                "text": "В углу, между окнами, стоял косяком большой письменный стол на шкафчиках."
                            },
                            {
                                "example_id": "ce0a868b-4e17-4dfc-9ffc-9ea767e8f2fb",
                                "sense_id": "a55b93d0-b8dd-3470-8132-a2bf969c8429",
                                "text": "И дымоход от печки до чего по-уродски сложен: косяком так идет вдоль стены, камнями заложен, и пошёл косяком до потолка, ― как его чистить?"
                            },
                            {
                                "example_id": "c0ea4534-db37-41e6-ba38-b7f5f82770ed",
                                "sense_id": "a55b93d0-b8dd-3470-8132-a2bf969c8429",
                                "text": "Буран косяком шёл, под углом к полотну."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "b8d8acb1-8e16-415d-b718-09563198b370",
                        "source_entry_id": "d167937d-8abd-3450-a838-5974a59b6c3d",
                        "source_sense_ids": [
                            "a55b93d0-b8dd-3470-8132-a2bf969c8429"
                        ],
