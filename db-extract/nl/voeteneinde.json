                        "entry_id": "f28591f8-7ca3-3af5-98f0-124eecfd2a9f",
                        "glosses": [
                            "Het uiteinde van een bed of chaise longue waar de voeten gewoonlijk liggen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a69f63b-bb3a-402d-bd92-24d7f484fdff",
                                "sense_id": "df97bfc9-6b10-3431-80e7-594ead9d6615",
                                "text": "Toch staat ze nu aan het voeteneinde van de plaat waaronder haar moeders beenderen liggen, terwijl de gebrandschilderde ramen de grijze stenen begieten met lichtgeel en groen, robijnrode en paarsblauwe vlekken."
                            },
                            {
                                "example_id": "3cd22e25-cf13-4fc0-9586-2cd7c95fcb7d",
                                "sense_id": "df97bfc9-6b10-3431-80e7-594ead9d6615",
                                "text": "Aan het voeteneinde zijn prachtige blauwe ballonnen vastgemaakt."
                            }
                        ]
                    }
