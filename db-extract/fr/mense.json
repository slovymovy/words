                        "examples": [
                            {
                                "example_id": "3a2e95c8-e457-4e0c-a76a-34aded7a3b6b",
                                "sense_id": "3a1a779f-0bdc-338c-bb75-7f7a2c6d44fc",
                                "text": "Au moment où les convives alloient s’approcher de la mense hospitalière."
                            },
                            {
                                "example_id": "5eb1150a-bfbc-4f56-8bf3-a43fbcda2d4e",
                                "sense_id": "3a1a779f-0bdc-338c-bb75-7f7a2c6d44fc",
                                "text": "Des capitaines au long cours et des armateurs faisaient quelquefois figure à la mense des patrons."
                            }
                        ]
                    },
                    {
                        "sense_id": "144b1871-a35a-3bd4-b1bd-c27753cc58f7",
                        "entry_id": "b7ef8314-9b79-3d63-a8c4-fe187967b089",
                        "glosses": [
                            "Revenu d’une abbaye, d’un évêché, etc. affecté à l’entretien de la table d’une communauté religieuse, de l’abbé, de l’évêque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d2e7e6-e80c-4fe7-a737-2d3337d608b3",
                                "sense_id": "144b1871-a35a-3bd4-b1bd-c27753cc58f7",
                                "text": "Lui ! s’exclama, en riant l’abbé, mais il ne possède aucune fortune ; il touche en tout et pour tout un traitement annuel de dix mille francs car il n’y a pas de mense à Chartres […]"
                            },
                            {
                                "example_id": "e4987088-f406-466b-8b56-db42c889db67",
                                "sense_id": "144b1871-a35a-3bd4-b1bd-c27753cc58f7",
                                "text": "Mense abbatiale, conventuelle, épiscopale."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a675374-f84a-32d2-a964-e5a48aba8f5d",
                        "entry_id": "b7ef8314-9b79-3d63-a8c4-fe187967b089",
                        "glosses": [
                            "Revenu ecclésiastique, sans affectation spécifique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2ccc74bb-5ebe-491e-8515-79d926da62f9",
                                "sense_id": "8a675374-f84a-32d2-a964-e5a48aba8f5d",
                                "text": "Vous auriez part encore à la mense abbatiale et au revenu des pauvres."
                            },
                            {
                                "example_id": "f7cb75b9-5401-47ed-a33e-506355563d85",
                                "sense_id": "8a675374-f84a-32d2-a964-e5a48aba8f5d",
                                "text": "Les biens mobiliers et immobiliers des menses, fabriques, conseils presbytéraux, consistoires et autres établissements publics du culte."
                            }
                        ]
                    }
