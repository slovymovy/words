                        "glosses": [
                            "Traiter (la langue, les mots) à la manière de Jean-Pierre Brisset."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db826c2-1451-4dba-ad62-447813f64adc",
                                "sense_id": "a30c7459-3f58-3bc3-8c52-016aeff617ba",
                                "text": "Si l’on considère le mot « chandail », il est tentant de le brissétiser en « champ d’aïl ». En fait, le mot « chandail » vient de « marchand d’aïl »."
                            },
                            {
                                "example_id": "a45ff0e0-7001-47d3-975c-db0651973c44",
                                "sense_id": "a30c7459-3f58-3bc3-8c52-016aeff617ba",
                                "text": "Brissétiser la langue, c’est lui faire délibérément violence. Mais c’est une douce violence."
                            },
                            {
                                "example_id": "1e945df3-f8e4-4d81-8da0-f0049f464c21",
                                "sense_id": "a30c7459-3f58-3bc3-8c52-016aeff617ba",
                                "text": "De la même façon, l’écriture rushdienne transcrit la langue de S.S. Sisodia et la « brissétise », en recourant en permanence sur la décomposition des syntagmes pour en exploiter les ambiguïtés et les calembours jaillissant de l’homophonie."
                            }
                        ]
                    }
