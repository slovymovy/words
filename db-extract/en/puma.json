                "translations": [
                    {
                        "translation_id": "0b43d763-b357-4eeb-8c47-f560cc598d4d",
                        "source_entry_id": "0df7bdc7-0ca3-3d86-b4fe-9666bd74cf8d",
                        "source_sense_id": "69c26dd0-6275-30a5-84a2-dbf1d521397f",
                        "source_sense_description": "Zoologie: Kleinkatze",
                        "target_lang_word": "Puma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a30bfcf-a1a0-3b90-ab99-2d2848a797e9",
                                        "entry_id": "cca119ff-a864-39b9-8c8f-4746d2f71ecd",
                                        "glosses": [
                                            "große Wildkatze aus Nord- und Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf975c6f-71c4-4545-8432-ac5d931e0881",
                                                "sense_id": "9a30bfcf-a1a0-3b90-ab99-2d2848a797e9",
                                                "text": "Eigentlich wollte Warner Glenn in den Bergen Arizonas Pumas jagen, doch seine Hunde stöberten etwas anderes auf."
                                            },
                                            {
                                                "example_id": "be829f30-2b22-45ec-a3b2-2c3871ef0d4a",
                                                "sense_id": "9a30bfcf-a1a0-3b90-ab99-2d2848a797e9",
                                                "text": "Alles wirkt so natürlich friedlich, wenn man durch den Urwald läuft, man sieht keine Pumas auf der Jagd und hört auch selten einen Affen brüllen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bab3a82-f765-3cbf-a9a3-e8b93debaa83",
                                        "entry_id": "cca119ff-a864-39b9-8c8f-4746d2f71ecd",
                                        "glosses": [
                                            "argentinische Rugby-Union-Nationalmannschaft"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "993de032-9224-44b7-a5a9-fe2ce5ae999d",
                                                "sense_id": "1bab3a82-f765-3cbf-a9a3-e8b93debaa83",
                                                "text": "Der dreimalige Titelträger deklassierte die Pumas aus Südamerika mit 44:6 (20:6)."
                                            },
                                            {
                                                "example_id": "ca3cc37e-8ee6-49a1-be33-0549060d2f68",
                                                "sense_id": "1bab3a82-f765-3cbf-a9a3-e8b93debaa83",
                                                "text": "Die Pumas, einer der Gegner Frankreichs im Pool C der Rugby-WM 2019, hoffen, ihre Leistungen von 2007 wiederholen zu können (3. Platz in Frankreich)."
                                            },
                                            {
                                                "example_id": "6b0ac101-3148-4799-afa0-2bea9a567268",
                                                "sense_id": "1bab3a82-f765-3cbf-a9a3-e8b93debaa83",
                                                "text": "Ich sehe aktuell leichte Vorteile für die Pumas, allerdings haben die Japaner bei den letzten Turnieren immer wieder überrascht und haben eine ernsthafte Chance, das Spiel zu gewinnen."
                                            },
                                            {
                                                "example_id": "825fdea8-9b65-447e-92e5-bc3599f60ed1",
                                                "sense_id": "1bab3a82-f765-3cbf-a9a3-e8b93debaa83",
                                                "text": "Offloads, schnelle Hände und verdammt flinke Außendreiviertel, von den alten sturmlastigen und eindimensionalen Pumas ist nicht mehr viel übrig geblieben."
                                            },
                                            {
                                                "example_id": "e3bfcf01-149a-4646-9839-fc3bd4ab902a",
                                                "sense_id": "1bab3a82-f765-3cbf-a9a3-e8b93debaa83",
                                                "text": "Allmählich machte sich die kräftezehrende Unterzahl bei den Pumas bemerkbar, die sich mehr und mehr in der eigenen Hälfte eingeschnürt fanden und neue Kräfte in erste und zweite Reihe eintauschten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
