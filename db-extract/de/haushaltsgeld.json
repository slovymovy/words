                "senses": [
                    {
                        "sense_id": "f9b73d39-72fd-3f4a-b5ed-906444087686",
                        "entry_id": "f2a05f40-41a8-3442-bb43-8b2b6e08bd9f",
                        "glosses": [
                            "Geld, das dafür bestimmt ist, die laufenden Kosten eines Haushalts zu bestreiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743d2203-8a49-4769-8b30-17e13e979f60",
                                "sense_id": "f9b73d39-72fd-3f4a-b5ed-906444087686",
                                "text": "„Doch irgendwann konnte selbst ihr findiges und mit reichlich Haushaltsgeld ausgestattetes Personal nicht mehr einkaufen:...“"
                            },
                            {
                                "example_id": "ec59aa92-a945-4188-a89a-fb947b2f33b6",
                                "sense_id": "f9b73d39-72fd-3f4a-b5ed-906444087686",
                                "text": "„Das Haushaltsgeld des Vaters reichte nicht, um das auch noch zu bezahlen.“"
                            },
                            {
                                "example_id": "a2685068-0277-4721-b34c-74f95df02323",
                                "sense_id": "f9b73d39-72fd-3f4a-b5ed-906444087686",
                                "text": "„Nicht dass er sich betrank, aber er nahm das Geld dafür aus dem Umschlag in der Küchenschublade, in dem Henni das Haushaltsgeld aufbewahrte.“"
                            },
                            {
                                "example_id": "ef9ee026-74dd-4d9f-8c16-8ca9bee8828c",
                                "sense_id": "f9b73d39-72fd-3f4a-b5ed-906444087686",
                                "text": "„Ich fügte das Wettgeld wieder dem Haushaltsgeld hinzu und fühlte mich gelöst und gut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
