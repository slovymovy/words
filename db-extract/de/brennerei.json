                "senses": [
                    {
                        "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                        "entry_id": "90237d25-4f6a-3cc1-9514-ccd765218358",
                        "glosses": [
                            "ein Betrieb, in dem stark alkoholhaltige Getränke aus einem schwach alkoholischen Ausgangsprodukt destilliert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc9cbac4-a875-4f7a-bf20-4ac4bbe270ba",
                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                "text": "Beim Besuch der Brennerei konnte man Branntwein probieren."
                            },
                            {
                                "example_id": "5c0d187f-3168-4889-84dd-1b2c8e9cd6eb",
                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                "text": "„Zwar residiert in der Brennerei neben die Vietzkes inzwischen die Kommandantura, aber was hilft's?“"
                            },
                            {
                                "example_id": "67cb1b9c-b0fb-46a7-bb91-e474b45ae475",
                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                "text": "„Der seit Jahrzehnten für die Brennerei tätige Hans Bleibtreu und der Brennermeister Bruno Brand sorgen dafür, dass die Geschäfte solide, ehrlich und halbwegs profitabel weiterlaufen und nichts am Geheimrezept des legendären Korngeists herumgepfuscht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63f43d77-27f7-4ec1-8fcc-8600db3ab381",
                        "source_entry_id": "90237d25-4f6a-3cc1-9514-ccd765218358",
                        "source_sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                        "source_sense_description": "Betrieb, in dem stark alkoholhaltige Getränke destilliert werden",
                        "target_lang_word": "distillery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distillery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc3212bc-4e0b-3030-9b84-3c15095833be",
                                        "entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                                        "glosses": [
                                            "A place where distillation takes place, especially the distillation of alcoholic spirits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5653b8e-867b-4d1b-a9b2-271281c57b82",
                                                "sense_id": "cc3212bc-4e0b-3030-9b84-3c15095833be",
                                                "text": "It's the water that makes this area famous. […] That water is still being used to supply Blackford's two dominant industries, Tullibardine whisky distillery to the south of the village and, more significantly, Highland Spring Group's bottling plant to the north."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35731e4c-68ee-3afd-937d-f381c58b5512",
                                        "entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                                        "glosses": [
                                            "A company that distills alcohol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcd4782c-9d2d-3876-a309-1e09680eea5d",
                                        "entry_id": "82efe258-ad21-3e58-b55e-ef001af5c260",
                                        "glosses": [
                                            "The process of distilling alcohol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "876cd656-6171-4131-b4a6-8afba01fcffb",
                        "source_entry_id": "90237d25-4f6a-3cc1-9514-ccd765218358",
                        "source_sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                        "source_sense_description": "Betrieb, in dem stark alkoholhaltige Getränke destilliert werden",
                        "target_lang_word": "distillerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distillerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95168b48-bbe5-3bad-9534-05e752c97624",
                                        "entry_id": "9846bbca-ca07-39a9-ac26-1ee991f7af9c",
                                        "glosses": [
                                            "Lieu où l’on fabrique et où l’on vend des produits obtenus par la distillation."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a782b223-eb01-4dfa-87d6-a7a5f140d28b",
                                                "sense_id": "95168b48-bbe5-3bad-9534-05e752c97624",
                                                "text": "Ne peuvent être mis en oeuvre dans la distillerie que des vins, cidres ou poirés, marcs, lies, cerises, prunes et prunelles provenant de la récolte des membres de l'association."
                                            },
                                            {
                                                "example_id": "297e43b9-2a9f-4cee-b2f2-7f24b1ea30e2",
                                                "sense_id": "95168b48-bbe5-3bad-9534-05e752c97624",
                                                "text": "Inventé au XIXème siècle par Alexandre Le Grand, qui créa le Palais Bénédictine pour sa distillerie à Fécamp, le spiritourisme est en plein essor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8e4982d-91df-4f81-9dab-26dbcca0bb92",
                        "source_entry_id": "90237d25-4f6a-3cc1-9514-ccd765218358",
                        "source_sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
