                                        "glosses": [
                                            "Angehöriger des Volks der Turkmenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc1d352-2527-4ea1-94a0-29709b8f7c43",
                                                "sense_id": "82cf5a23-d90d-3216-bea2-fae3818eabb7",
                                                "text": "Die Turkmenen sind eine bedeutende Gruppe der Turkstämme, die sich im 5. Jahrhundert aus dem Altai-Gebirge in den Süden ausgebreitet hatten."
