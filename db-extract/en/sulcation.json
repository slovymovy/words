                        "entry_id": "2120b303-57a2-3ce4-ae69-9ae99d5224a6",
                        "glosses": [
                            "A channel or furrow."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c767bd78-7335-3338-9d6b-8839a98a283f",
                        "entry_id": "2120b303-57a2-3ce4-ae69-9ae99d5224a6",
                        "glosses": [
                            "Markings resembling channels or furrows, especially in shells, fossils, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4014e7ec-4660-4e7a-895d-fc4d97c53874",
                                "sense_id": "c767bd78-7335-3338-9d6b-8839a98a283f",
                                "text": "The ornamentation of the shell is a character of considerable palaeontological importance. . . . The types of ornamentation are two; longitudinal striation, and transverse sulcation conformable to the shape of the aperture."
                            },
                            {
                                "example_id": "f08a102c-84ae-42a2-9597-1a088e532713",
                                "sense_id": "c767bd78-7335-3338-9d6b-8839a98a283f",
                                "text": "[T]he presence of sulcation in the brow horns of all the Arrhinoceratops specimens known at the present time suggests a certain constancy in this genus."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ee32320-cd35-3e71-85aa-6e97c94cd308",
                        "entry_id": "2120b303-57a2-3ce4-ae69-9ae99d5224a6",
                        "glosses": [
                            "The development of or resulting formations of sulci in a brain cortex."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8492997a-7efb-465b-9142-9d47b7307aaa",
                                "sense_id": "8ee32320-cd35-3e71-85aa-6e97c94cd308",
                                "text": "Lissencephaly refers to a diffusely smooth-surfaced cerebral hemisphere without sulcation."
                            },
                            {
                                "example_id": "9992189c-480e-4fd0-be9c-9c163ea223cd",
                                "sense_id": "8ee32320-cd35-3e71-85aa-6e97c94cd308",
                                "text": "Since the appearance and development of sulci in the fetal brain follows a predictable pattern, the degree of sulcation may be used as an indicator of gestational age-related cortical development, both at autopsy and in vivo with fetal MRI."
                            },
                            {
                                "example_id": "0ca6a77e-5fdb-4b2a-a3be-32396affc4e3",
                                "sense_id": "8ee32320-cd35-3e71-85aa-6e97c94cd308",
                                "text": "Gyration and sulcation occur during neuronal migration and continue until after birth."
                            }
                        ]
                    }
                ],
