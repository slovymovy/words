                                        "sense_id": "34b2ddd2-89bf-3484-ab65-8a1077dddde1",
                                        "entry_id": "ba739271-2e32-370e-b5d1-7e954abdc17f",
                                        "glosses": [
                                            "An expanse of land."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "506538d2-a930-4938-a998-ec53107e5e54",
                                                "sense_id": "34b2ddd2-89bf-3484-ab65-8a1077dddde1",
                                                "text": "November 29, 1712, Andrew Freeport, a letter to The Spectator\nI have got a fine spread of improvable lands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44cd481b-5bd1-3ee6-82b0-94fb6c5fc65a",
                                        "entry_id": "ba739271-2e32-370e-b5d1-7e954abdc17f",
                                        "glosses": [
                                            "A large tract of land used to raise livestock; a cattle ranch."
