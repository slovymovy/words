                                    {
                                        "sense_id": "953ccb4b-ada9-3951-8127-4f0c097a1c5e",
                                        "entry_id": "4c376ddb-2689-3f89-9761-4341e9f45507",
                                        "glosses": [
                                            "Plante herbacée du genre Consolida et du genre Delphinium de la famille des Ranunculaceae (renonculacées) regroupant plus de 550 espèces (au total des 2 genres) dont certaines cultivées comme plantes ornementales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3598292-ed7c-4d82-9688-0a4e248a6390",
                                                "sense_id": "953ccb4b-ada9-3951-8127-4f0c097a1c5e",
                                                "text": "Enfin le long de la maison brillent des pieds d’alouettes bleus, des capucines aurore, des pois de senteur."
                                            },
                                            {
                                                "example_id": "2b448a8d-af69-44f5-8829-d2210947076d",
                                                "sense_id": "953ccb4b-ada9-3951-8127-4f0c097a1c5e",
                                                "text": "Les années « pluvieuses » des tapis de coquelicots, d’orchidées, de pieds d’alouettes, de verveine, primevères et tournesols fleurissent dans une farandole de couleurs et senteurs, comme un jardin sacré sur ce sol si stérile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab253d68-adce-4da7-9b7e-4eeb086524b4",
                        "source_entry_id": "98612234-f3b9-3726-80dc-b642aabb6488",
