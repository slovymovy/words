                                        "entry_id": "afa63499-c072-3283-b324-a1475641529f",
                                        "glosses": [
                                            "The quality of being hyperactive; excessive and pathological movement and restlessness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5bbd70-9aee-4344-b9dc-5cdc5eaefd50",
                                                "sense_id": "35f380bc-b218-30bd-87a3-1a8ab0f03f66",
                                                "text": "Having attention deficit hyperactivity disorder, or ADHD, is associated with a shorter life expectancy and a greater risk of mental health issues, according to a new study of more than 30,000 people with the disorder in the United Kingdom."
                                            }
                                        ]
                                    }
                                ]
