                    "sense_id": "bcafce98-2596-3516-bf76-3d2d48aa38b0",
                    "sense_definition": "bedoeld om iemand die verdrietig of neerslachtig is weer vrolijk of moedig te maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vrolijk maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het slechte nieuws stuurde mijn beste vriendin me een kaartje met <w>opbeurende</w> woorden.",
                            "target_lang_translations": {
                                "en": "After the bad news, my best friend sent me a card with <w>uplifting</w> words.",
                                "ru": "После плохих новостей моя лучшая подруга прислала мне открытку с <w>ободряющими</w> словами."
                            }
                        },
                        {
                            "text": "Het was een <w>opbeurend</w> gesprek dat me hielp om weer positief naar de toekomst te kijken.",
                            "target_lang_translations": {
                                "en": "It was a <w>cheering</w> conversation that helped me look at the future positively again.",
                                "ru": "Это был <w>подбадривающий</w> разговор, который помог мне снова позитивно смотреть в будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "opmonterend",
                        "opfleurend",
                        "opvrolijkend",
                        "bemoedigend",
                        "troostend"
                    ],
                    "antonyms": [
                        "neerslachtig",
                        "deprimerend",
                        "ontmoedigend"
