                                        "entry_id": "1651096f-87df-3cc6-a177-e847b0fb1d2b",
                                        "glosses": [
                                            "Spieler, der im Gedränge versucht, den Ball mit seinen Füßen zurückzustoßen"
                                        ],
                                        "tags": [
                                            "Rugby"
