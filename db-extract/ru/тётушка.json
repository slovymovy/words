                                    },
                                    {
                                        "sense_id": "2aabcacc-2572-3c4a-9493-46d4676f5967",
                                        "entry_id": "3dfd7542-1f66-307b-8044-0591bc661b66",
                                        "glosses": [
                                            "Term of familiarity or respect for a middle-aged or elderly woman."
                                        ],
                                        "tags": [
                                            "Africa",
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8add5ceb-e2be-31c7-9178-4e5a5b7d8e7b",
                                        "entry_id": "3dfd7542-1f66-307b-8044-0591bc661b66",
                                        "glosses": [
                                            "Female domestic helper."
                                        ],
                                        "tags": [
                                            "Hong-Kong"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee61a2a6-5711-3166-8e94-a8f4991c3082",
                                        "entry_id": "3dfd7542-1f66-307b-8044-0591bc661b66",
