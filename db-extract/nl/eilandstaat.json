                        "target_lang_word": "Inselstaat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inselstaat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef28349b-2585-36fc-a8e3-13a826abdae6",
                                        "entry_id": "38549190-9d33-3819-aa0b-3c76ce9ccea2",
                                        "glosses": [
                                            "unabhängiges Land, dessen Territorium aus einer oder mehreren Inseln besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08fe5c3b-1a59-43ce-9e75-baf4421cdf99",
                                                "sense_id": "ef28349b-2585-36fc-a8e3-13a826abdae6",
                                                "text": "Indonesien ist mit einer Größe von 1.922.570 km² wohl der weltweit größte Inselstaat, wenn man von dem noch nicht ganz unabhängigen Grönland absieht."
                                            },
                                            {
                                                "example_id": "715b93bc-9de3-4325-8c61-2b5b059d03cc",
                                                "sense_id": "ef28349b-2585-36fc-a8e3-13a826abdae6",
                                                "text": "Der kleinste Inselstaat der Welt ist Nauru mit einer Größe von 21 km²."
                                            },
                                            {
                                                "example_id": "fc5d6dac-2af7-4d31-b9c9-e6dc00377f6f",
                                                "sense_id": "ef28349b-2585-36fc-a8e3-13a826abdae6",
                                                "text": "„Der Präsident des südasiatischen Inselstaates, Maithripala Sirisena, hatte kürzlich angekündigt, dass erstmals seit 1976 in den kommenden Monaten wieder die Todesstrafe in Sri Lanka vollstreckt werde.“"
                                            }
                                        ],
