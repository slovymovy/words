                        "entry_id": "43e15664-f556-3bf2-a8b0-b1b158740457",
                        "glosses": [
                            "Appareil manuel, mécanique ou électronique permettant de composer des textes par photocomposition."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "f82cc589-b611-457f-857b-2b32c6b461ce",
                                "sense_id": "59685329-7f07-313c-b3ff-4d4a31677f3a",
                                "text": "Les photocomposeuses sont des machines complexes, coûteuses (les prix se comptent en centaines de milliers de francs), lentes et d’un maniement complexe qui en réserve l’usage à des professionnels aguerris."
                            }
                        ]
                    },
