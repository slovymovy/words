                    "frequency": "Low",
                    "semantic_group_id": "witwassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De criminelen probeerden hun criminele winsten te <w>witten</w> via buitenlandse banken.",
                            "target_lang_translations": {
                                "en": "The criminals tried to <w>launder</w> their criminal profits through foreign banks."
                            }
                        },
                        {
                            "text": "Het <w>witten</w> van geld is een ernstig misdrijf waar zware straffen op staan.",
                            "target_lang_translations": {
                                "en": "<w>Laundering</w> money is a serious crime that carries heavy penalties."
                            }
                        }
                    ],
                    "synonyms": [
                        "witwassen"
                    ],
                    "common_phrases": [
                        "geld witten"
                    ],
                    "traits": [
