{
    "word_family": [
        "biscuiting",
        "biscuity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b0d1be8-a213-3c5b-b59d-b9c0a839cdd3",
                    "sense_definition": "A small, flat, baked good which is either hard and crisp or else soft but firm; a cookie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "baked_goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually have a chocolate <w>biscuit</w> with my afternoon tea.",
                            "target_lang_translations": {
                                "ru": "Обычно я съедаю шоколадное <w>печенье</w> с послеобеденным чаем."
                            }
                        },
                        {
                            "text": "The children were happy to find a tin full of homemade <w>biscuits</w>.",
                            "target_lang_translations": {
                                "ru": "Дети были счастливы найти жестяную банку, полную домашнего <w>печенья</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chocolate biscuit",
                        "biscuit tin",
                        "digestive biscuit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое плоское выпечное изделие, твердое и хрустящее или мягкое, но плотное; печенье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печенье",
                                "target_lang_sense_clarification": "общее название для кондитерского изделия"
                            },
                            {
                                "target_lang_word": "бисквит",
                                "target_lang_sense_clarification": "сорт легкого сдобного печенья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e28f45f-3156-3fef-8fcb-ce95a80cf860",
                    "sense_definition": "A small, usually soft and flaky bread, generally made with baking soda, similar to a scone but usually not sweet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "baked_goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the South, people often serve warm <w>biscuits</w> and gravy for breakfast.",
                            "target_lang_translations": {
                                "ru": "На юге на завтрак часто подают теплые <w>булочки</w> с подливкой."
                            }
                        },
                        {
                            "text": "She baked a fresh batch of <w>biscuits</w> to go with the fried chicken.",
                            "target_lang_translations": {
                                "ru": "Она испекла свежую порцию <w>булочек</w> к жареной курице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "biscuits and gravy",
                        "homemade biscuits",
                        "buttermilk biscuit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой, обычно мягкий и слоистый хлебец, приготовленный с использованием соды, похожий на сконы, но обычно несладкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булочка",
                                "target_lang_sense_clarification": "несладкая, подаваемая к завтраку или основным блюдам"
                            },
                            {
                                "target_lang_word": "горячий хлебец",
                                "target_lang_sense_clarification": "традиционная американская выпечка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48345f95-c623-3f48-917c-a89bd1e1e9cd",
                    "sense_definition": "A thin, crisp cracker, often eaten with cheese.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "baked_goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We served a variety of cheese and <w>biscuits</w> at the end of the dinner party.",
                            "target_lang_translations": {
                                "ru": "В конце званого ужина мы подали ассорти из сыров и <w>галет</w>."
                            }
                        },
                        {
                            "text": "A plain water <w>biscuit</w> is the perfect accompaniment to a strong cheddar.",
                            "target_lang_translations": {
                                "ru": "Простая пресная <w>галета</w> — идеальное дополнение к крепкому чеддеру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheese and biscuits",
                        "water biscuit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий хрустящий крекер, который часто едят с сыром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галета",
                                "target_lang_sense_clarification": "сухое несладкое печенье"
                            },
                            {
                                "target_lang_word": "крекер",
                                "target_lang_sense_clarification": "хрустящее печенье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5bac46c-087e-3719-8739-e06705345d12",
                    "sense_definition": "A light brown or pale tan colour.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted a soft <w>biscuit</w> shade to make the room feel warmer.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в мягкий <w>бежевый</w> оттенок, чтобы в комнате стало уютнее."
                            }
                        },
                        {
                            "text": "She chose a <w>biscuit</w> colored rug that matched the neutral tones of the furniture.",
                            "target_lang_translations": {
                                "ru": "Она выбрала ковер <w>песочного</w> цвета, который сочетался с нейтральными тонами мебели."
                            }
                        }
                    ],
                    "common_phrases": [
                        "biscuit colored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светло-коричневый или бледно-желтовато-коричневый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бежевый",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "серовато-желтый",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fc41c1c-6269-306b-a188-a37bcad607bd",
                    "sense_definition": "A form of unglazed earthenware that has been fired once.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pottery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist checked the <w>biscuit</w> for cracks before applying the final glaze.",
                            "target_lang_translations": {
                                "ru": "Художник проверил <w>бисквит</w> на наличие трещин перед нанесением финальной глазури."
                            }
                        },
                        {
                            "text": "After the first firing, the clay becomes <w>biscuit</w> and is ready for decoration.",
                            "target_lang_translations": {
                                "ru": "После первого обжига глина превращается в <w>бисквит</w> и готова к декорированию."
                            }
                        }
                    ],
                    "synonyms": [
                        "biscuitware",
                        "biscuitry"
                    ],
                    "common_phrases": [
                        "biscuit state",
                        "biscuit firing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид неглазурованной керамики, прошедшей первый обжиг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бисквит",
                                "target_lang_sense_clarification": "неглазурованный фарфор или керамика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3198618f-43ea-32f3-a5b4-52ea71331666",
                    "sense_definition": "A thin oval wafer of wood inserted into slots to join pieces of material together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "woodworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a <w>biscuit</w> joiner to align the two boards perfectly.",
                            "target_lang_translations": {
                                "ru": "Он использовал ламельный фрезер, чтобы идеально выровнять две доски с помощью <w>ламелей</w>."
                            }
                        },
                        {
                            "text": "The wooden <w>biscuit</w> expands when it absorbs glue, creating a very strong joint.",
                            "target_lang_translations": {
                                "ru": "Деревянная <w>шпонка</w> расширяется при впитывании клея, создавая очень прочное соединение."
                            }
                        }
                    ],
                    "synonyms": [
                        "spline"
                    ],
                    "common_phrases": [
                        "biscuit joiner",
                        "biscuit joint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая овальная деревянная пластина, вставляемая в пазы для соединения деталей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ламель",
                                "target_lang_sense_clarification": "плоский вставной шип"
                            },
                            {
                                "target_lang_word": "шпонка",
                                "target_lang_sense_clarification": "соединительный элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c676696-b41b-38e5-909a-dc8b397163b7",
                    "sense_definition": "A hockey puck.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player managed to put the <w>biscuit</w> in the basket for the winning goal.",
                            "target_lang_translations": {
                                "ru": "Игроку удалось забросить <w>шайбу</w> в сетку, забив победный гол."
                            }
                        },
                        {
                            "text": "He has great control over the <w>biscuit</w> when he is skating at high speeds.",
                            "target_lang_translations": {
                                "ru": "Он отлично контролирует <w>шайбу</w>, когда несется на высокой скорости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "biscuit in the basket"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "ice hockey"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хоккейная шайба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шайба",
                                "target_lang_sense_clarification": "хоккейный сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac844af2-f0f4-35d1-a9b1-cdf953cdb02e",
                    "sense_definition": "The human head.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so confused he didn't know what was going on in his <w>biscuit</w>.",
                            "target_lang_translations": {
                                "ru": "Он был так растерян, что не понимал, что происходит у него в <w>башке</w>."
                            }
                        },
                        {
                            "text": "You better watch out or you might get a slap in your <w>biscuit</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе лучше поберечься, а то можешь получить по <w>кумполу</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человеческая голова."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "башка",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "котелок",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5fa798cc-4878-3ca9-b02b-acb97357be26",
                    "sense_definition": "To fire pottery in a kiln without a ceramic glaze.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pottery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The potter will <w>biscuit</w> the vases tomorrow before they are painted.",
                            "target_lang_translations": {
                                "ru": "Гончар завтра <w>обожжет</w> вазы перед тем, как их распишут."
                            }
                        },
                        {
                            "text": "It is important to <w>biscuit</w> the clay slowly to prevent it from cracking.",
                            "target_lang_translations": {
                                "ru": "Важно проводить <w>первичный обжиг</w> глины медленно, чтобы она не треснула."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать керамику первичному обжигу без глазури."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжигать на бисквит",
                                "target_lang_sense_clarification": "в гончарном деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4da1011a-2ef3-3be9-b83e-09c275421372",
                    "sense_definition": "To take part in the sport of tubing, riding down a river or behind a boat on an inner tube.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon <w>biscuiting</w> behind my uncle's motorboat.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, <w>катаясь на ватрушке</w> за моторной лодкой моего дяди."
                            }
                        },
                        {
                            "text": "They love to go <w>biscuiting</w> on the lake during the summer holidays.",
                            "target_lang_translations": {
                                "ru": "Они обожают <w>кататься на баллонах</w> на озере во время летних каникул."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal sport term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кататься на надувном круге (тюбинге) по реке или за лодкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на ватрушке",
                                "target_lang_sense_clarification": "за катером или по воде"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}