                    {
                        "translation_id": "99c92c9e-bc49-474b-9ac4-6575bf30ef4a",
                        "source_entry_id": "08fa4625-79ec-322f-9775-17bde57cd289",
                        "source_sense_id": "21742e98-5694-3e73-8cc8-a88c24dc4c6c",
                        "target_lang_word": "Geodäsie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geodäsie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                        "entry_id": "7c86af28-6939-3e30-a5cf-6e0c7ffabe88",
                                        "glosses": [
                                            "Wissenschaft von der Vermessung der Erdoberfläche und von der Technik der Vermessung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d049ff-866e-4f3e-8797-091fcaa6462d",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "Geodäsie sei weit mehr als Landvermessung und schließe die Geoinformatik, also zum Beispiel Satelliten-Navigation, mit ein."
                                            },
                                            {
                                                "example_id": "5ef07ca9-0492-443e-8e90-3714abee6fb4",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "Zwischen 1816 und 1841 vermaß er das gesamte Königreich Hannover, trotz modernster Methoden der Geodäsie ein ermüdendes Tagwerk."
                                            },
                                            {
                                                "example_id": "37516519-fccd-42a9-8bf7-13c2aba63f7d",
                                                "sense_id": "1f089eb2-82d5-3bf6-af97-c67ec0281a00",
                                                "text": "In den letzten 20 Jahren stieg der Pegel mit etwa drei Millimeter pro Jahr doppelt so schnell wie im Durchschnitt. Das berichten Forscher vom Institut für Planetare Geodäsie in Dresden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e62d9113-7040-4f72-81db-9c567a553e53",
                        "source_entry_id": "08fa4625-79ec-322f-9775-17bde57cd289",
                        "source_sense_id": "21742e98-5694-3e73-8cc8-a88c24dc4c6c",
                        "target_lang_word": "Vermessungskunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vermessungskunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb2fce3b-1d9c-3016-93f1-afe8f912a645",
                                        "entry_id": "cb743a42-9f96-3645-82ab-6ab4bb375984",
                                        "glosses": [
                                            "Wissenschaft von der Vermessung der Erdoberfläche und von der Technik der Vermessung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3198a83-43ea-4690-91e7-eccb508eacbb",
                                                "sense_id": "fb2fce3b-1d9c-3016-93f1-afe8f912a645",
                                                "text": "„In Bonn studierte er Vermessungskunde und erhielt nach dem Studium eine Anstellung als Vermessungsingenieur bei der damaligen Deutschen Reichsbahn.“"
                                            },
                                            {
                                                "example_id": "c8da7ef6-de0e-42df-8b03-d56be7e1867c",
                                                "sense_id": "fb2fce3b-1d9c-3016-93f1-afe8f912a645",
                                                "text": "„Die Vermessungskunde befasst sich mit der Messung, Zeichnung und Berechnung der Erdoberfläche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
