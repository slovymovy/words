                    {
                        "sense_id": "b6a5ac7d-8ac2-3106-84c1-30e85317986f",
                        "entry_id": "43301b1a-3588-34d6-8f52-edab8d8a502e",
                        "glosses": [
                            "synonym of aalscholver (“cormorant”)"
                        ],
