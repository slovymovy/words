                        ]
                    },
                    {
                        "translation_id": "889b266c-a383-4cba-8983-624a77c74fae",
                        "source_entry_id": "7c6f253c-9740-3227-b724-2e92b381f288",
                        "source_sense_id": "f22a7f5d-317e-3cc7-932b-04ad220cfb42",
                        "source_sense_description": "meist Singular: Eigenschaft, sich seiner Kräfte und Fähigkeiten sicher sein",
                        "target_lang_word": "aplomb",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aplomb",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Ligne perpendiculaire au plan de l’horizon indiquée par le fil à plomb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37493ca-239d-46cd-98fb-048e881fcb6e",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "Bien prendre l’aplomb."
                                            },
                                            {
                                                "example_id": "308182d4-9b95-4013-be6a-e3f951bd33ad",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "Un grondement sourd s’éleva dans le lointain, s'enfla peu à peu, fit bientôt vibrer le vitrage des ateliers : un rapide venant de Melun passait à l’aplomb du remblai, longeant le chemin du Ponceau."
                                            },
                                            {
                                                "example_id": "6b76f73f-b27c-4d12-a7f4-e6a0bb087ac5",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "[…]: un balustre portant des vases décoratifs à l’aplomb des entre-fenêtres, et des trophées opimes au-dessus des avancées qui interrompaient la monotonie du cheminement architectural et régulier."
                                            },
                                            {
                                                "example_id": "f4213689-5ea3-4c79-9866-78b238cb51d9",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "À l’aplomb du soleil, les eaux du lac avaient des lourdeurs de pétrole."
                                            },
                                            {
                                                "example_id": "dc2e0419-4ed0-47f1-9c1d-182e74984b5c",
                                                "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                                                "text": "Quand il tire le portail elle le hèle, montrant du doigt la plate-bande des petits cactus Copiapoa. Au sommet d’une courte tige, enveloppées d’une bourre blanchâtre, deux minuscules fleurs jaunes ont éclos. Pétales de soie à l’aplomb d’un coussin d’épines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7aa1b2a-3a12-35e8-8054-a33860c4da4d",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Équilibre, stabilité d’un corps solide résultant de l’utilisation du fil à plomb."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb68c6f-3ce6-4f91-8815-0528e918b4ed",
                                                "sense_id": "e7aa1b2a-3a12-35e8-8054-a33860c4da4d",
                                                "text": "Ce mur tient bien son aplomb, a perdu son aplomb. - Cette muraille, toute vieille qu’elle est, a bien gardé son aplomb, a conservé son aplomb."
                                            },
                                            {
                                                "example_id": "350d829e-21a7-4411-85bc-5db8d38e47ac",
                                                "sense_id": "e7aa1b2a-3a12-35e8-8054-a33860c4da4d",
                                                "text": "Les fauteuils étaient renversés comme après une bagarre, les tables n’étaient plus sous l’aplomb de la suspension, le pupitre à musique était cassé. […]\nTout de suite, la nonne tirait la table à son aplomb, relevait les chaises, plaçait les fauteuils, ramassait les morceaux de musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da250b2e-dd75-3cda-b03c-61e9d942621a",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Juste pondération des figures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca0a61f4-4602-4603-8f10-d0e53643a488",
                                                "sense_id": "da250b2e-dd75-3cda-b03c-61e9d942621a",
                                                "text": "Ses figures manquent d’aplomb. - Cet artiste pèche par les aplombs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e7b1253-3d29-3387-833c-4cb68a773b69",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Équilibre des parties du corps."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18824c4b-973d-44be-b0c9-5c74d946e22d",
                                                "sense_id": "5e7b1253-3d29-3387-833c-4cb68a773b69",
                                                "text": "Les aplombs d’un cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05200d4e-46bd-3b48-aa1f-cacb1d6e6df8",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Précision de la rectitude de la mesure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                        "entry_id": "50a682b9-a3fa-3578-941f-e071710183b6",
                                        "glosses": [
                                            "Certaine assurance dans la manière de se présenter, de parler, d’agir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "780f80ed-ab6f-4bea-9860-b1923d684020",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "Et bien! monsieur, lui dit cet homme, qui avait gardé son sang-froid et son aplomb, au milieu des folies de la soirée, vous avez vu nos indépendans ; qu'en pensez-vous ?"
                                            },
                                            {
                                                "example_id": "767f8ada-cf73-455e-b6f8-7d13db96529e",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "C'était un gros garçon, artiste peintre au moins médiocre, à vue très-courte, moralement s'entend, qui ne doutait de rien et parlait de tout avec un aplomb imperturbable. Il prétendait avoir une grande instruction; mais il est à croire qu'il l'avait reçue sous le sceau de la confession, car il ne révélait jamais rien. — (Émile Mathieu, L'esprit de famille, Paris : Librairie Hachette & Cie, 1863, page 114)"
                                            },
                                            {
                                                "example_id": "1ae12808-a3b2-40ed-879b-a1d91628d454",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "– Eh bien, et moi, est-ce que je ne suis pas là ?\nL’autre eut l’aplomb de lui répondre :\n– Que voulez-vous ! On est toujours mieux auprès de ses enfants."
                                            },
                                            {
                                                "example_id": "5e4d89aa-962b-4572-a7a8-38c0981ed775",
                                                "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                                                "text": "Mani portait en lui, depuis l’enfance, et même dans l’humilité de la palmeraie des Vêtements-Blancs, cet attribut éminemment royal qu’est l’aplomb, héritage manifeste des souverains parthes dont l’empire s’était autrefois étendu jusqu’à Deb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cae37977-6b3a-4d05-8995-4ca6ef7cee21",
                        "source_entry_id": "7c6f253c-9740-3227-b724-2e92b381f288",
                        "source_sense_id": "f22a7f5d-317e-3cc7-932b-04ad220cfb42",
                        "source_sense_description": "meist Singular: Eigenschaft, sich seiner Kräfte und Fähigkeiten sicher sein",
                        "target_lang_word": "assurance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assurance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c82d649b-a417-3ca1-9a09-7dd2a84ea21b",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Certitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf6b5f8-2d3e-4737-a7ef-9925d35bed91",
                                                "sense_id": "c82d649b-a417-3ca1-9a09-7dd2a84ea21b",
                                                "text": "On ne peut plus douter de cette nouvelle, on en a une entière assurance. J’ai l’assurance que cette place me sera donnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357dfd57-8c3d-3c87-b1c8-4694a0c4ce74",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Confiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d43c887b-c4a8-4064-bc80-47785d87903b",
                                                "sense_id": "357dfd57-8c3d-3c87-b1c8-4694a0c4ce74",
                                                "text": "Prenez cette étoffe avec assurance, en assurance, elle est fort bonne. En toute assurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d072636-46da-3280-a761-ac568ee1569b",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Confiance en soi-même."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ead6afef-eedc-4ed0-ba07-18eebf547394",
                                                "sense_id": "3d072636-46da-3280-a761-ac568ee1569b",
                                                "text": "Choyé par les siens, protégé par ses aînés, il avait conquis l’assurance, l’arrogance presque de ceux qui se sentent forts, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7512325b-1538-3efe-b318-c4ec8b4b444e",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Ensemble de paroles, de promesses, de protestations par lesquelles on s’efforce de donner à une personne la certitude de quelque chose, ou de lui inspirer de la confiance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7959013c-dd5c-46b4-9bcf-940f76813f86",
                                                "sense_id": "7512325b-1538-3efe-b318-c4ec8b4b444e",
                                                "text": "Ce ne sont pas là de vaines assurances, des assurances en l’air. — Donner à quelqu’un des assurances de sa fidélité, de son dévouement. — On lui a donné l’assurance qu’il serait nommé. Recevoir l’assurance d’une chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Hardiesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a91bd321-e0da-4ac0-86b9-a2900e472459",
                                                "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                                "text": "Pour accuser avec une telle assurance, il fallait qu'existât la preuve indéniable de la félonie de François."
                                            },
                                            {
                                                "example_id": "ea11693b-8b19-4a28-8bd5-25841c2c2bfb",
                                                "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                                "text": "C’est un jeune acteur, qui n’a pas encore d’assurance. Prenez de l’assurance."
                                            },
                                            {
                                                "example_id": "32f54094-ef55-4b6a-9a73-083a0fb5c99d",
                                                "sense_id": "7495403a-4654-36d6-84ef-5764823c4935",
                                                "text": "Ayez plus d’assurance. Montrez de l’assurance. Perdre son assurance. Une noble assurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b38f92eb-08fa-38a1-8bfc-8e1252e5cafe",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Sûreté ; état où l’on est hors de péril."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24b0ac9-d3ad-40ba-842d-4041f21e3923",
                                                "sense_id": "b38f92eb-08fa-38a1-8bfc-8e1252e5cafe",
                                                "text": "Je l’ai mis en lieu d’assurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dabc7d1c-0d97-3a17-af3f-18a96b0280ad",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Promesse, obligation nantissement, etc., qu’on donne pour servir de sûreté à quelqu’un avec qui l’on traite."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08da4c06-8e2e-4a8d-8f67-cd3787a25e1f",
                                                "sense_id": "dabc7d1c-0d97-3a17-af3f-18a96b0280ad",
                                                "text": "Je vous donnerai vos assurances, une bonne assurance. C’est un homme dont il est prudent d’exiger des assurances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da9d98fc-58b4-3a88-8623-06cae1f14aed",
                                        "entry_id": "70343442-20c2-3f89-a3a2-0b6a0cd51aa4",
                                        "glosses": [
                                            "Contrat par lequel on garantit contre certains risques sa personne ou son bien, ou par lequel, à de certaines conditions, on assure à soi ou à d’autres le paiement d’une somme convenue."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3651689-cf25-455b-8c8c-f04dbdb6610f",
                                                "sense_id": "da9d98fc-58b4-3a88-8623-06cae1f14aed",
                                                "text": "Les sociétaires soumis à l’assurance obligatoire auront à supporter deux tiers du montant des cotisations, l'autre tiers est à la charge du patron."
                                            },
                                            {
                                                "example_id": "ebe46351-b972-40e2-817d-124e5387ca63",
                                                "sense_id": "da9d98fc-58b4-3a88-8623-06cae1f14aed",
                                                "text": "[…] des observateurs, […] signalent chez les campagnards du Lot comme une tare tout à fait caractéristique un individualisme outrancier, féroce, têtu, rétrograde qui leur a laissé ignorer jusqu'à ce jour les bienfaits de la solidarité, de l'entr’aide et même, dans bien des cas, de l'assurance et du remembrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
