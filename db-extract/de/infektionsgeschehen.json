                        ],
                        "form": "das Infektionsgeschehen"
                    },
                    {
                        "form_id": "96205f9d-f66b-467c-bebb-14143fa760ea",
                        "entry_id": "aa262db0-a276-3208-9a27-efac7342338e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Infektionsgeschehen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                        "entry_id": "aa262db0-a276-3208-9a27-efac7342338e",
                        "glosses": [
                            "Verlauf und Ausmaß von Ansteckungen an einer Krankheit (= einer Infektion), beispielsweise während einer Pandemie oder Epidemie"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ee220ed9-2b76-43db-be7a-643158a0f6c6",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„[…] Bund und Länder [haben] Beschränkungen für Reisende aus Städten oder Landkreisen mit hohem Infektionsgeschehen beschlossen.“"
                            },
                            {
                                "example_id": "cb9a75e4-a6c2-4612-a7ca-da2501a672fc",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„»Die aktuellen Regelungen gelten zunächst bis zum 3.5.2020 und werden regelmäßig vor dem Hintergrund des dynamischen Infektionsgeschehens überprüft. […]«“"
                            },
                            {
                                "example_id": "28da7266-5d2e-4372-a3f7-673b5913e388",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„bei dem Ausbruch in dem Tönnies-Schlachthof [handelt es sich] um das bisher größte einzelne Infektionsgeschehen in Nordrhein-Westfalen und Deutschland, sagte Laschet.“"
                            },
                            {
                                "example_id": "9fdf91c6-3ecf-40f1-94d0-29b33a5a3a56",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„»Alle Funktionäre in Serbien sind dem Präsidenten loyal ergeben, auch Epidemiologen«, sagt der Journalist Tešić. »Die Vertuschung des wirklichen Infektionsgeschehens konnte ohne Vučićs Wissen nicht passieren.«“"
                            },
                            {
                                "example_id": "7fc0b27d-caa2-4357-8850-628cc79e366e",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„»Um das Infektionsgeschehen richtig einordnen zu können, müssen zunächst die Ergebnisse der Testung abgewartet werden«, sagte der Diepholzer Landrat Cord Bockhop (CDU).“"
                            },
                            {
                                "example_id": "f090091f-2ba8-4c18-9c0c-57443bf0b157",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„Mit spezifischen Gewebekulturmodellen wollen [die Forscher] das Infektionsgeschehen im Menschen realitätsgetreu im Labor nachbilden, um neuartige Angriffspunkte für innovative Antibiotika zu entdecken.“"
                            },
                            {
                                "example_id": "02fe6e8e-3324-45cb-8cf2-e0c9402eaf6b",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "[Nach den Ferien] „sollen wieder alle Schüler täglich Präsenzunterricht haben - vorausgesetzt, das Infektionsgeschehen lässt dies zu.“"
                            },
                            {
                                "example_id": "11e356ce-217f-401e-9945-2a255e40e0fb",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„Inzwischen gibt es aber etliche Forschungsprojekte, die untersuchen, welche Rolle Kinder im Infektionsgeschehen spielen.“"
                            },
                            {
                                "example_id": "fff18abd-4bbe-4e0c-b0a7-3cd337400c1b",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„Die möglichen Folgen der Feier mit Blick auf das Infektionsgeschehen in Liverpool werden wohl erst in einigen Tagen deutlich werden.“"
                            },
                            {
                                "example_id": "b67f0f0e-1a1a-47eb-bb1e-d2f62aaef28f",
                                "sense_id": "bbc51ea9-786d-3b36-a1bd-c09aa6b027ca",
                                "text": "„»[…] Wir sind im Moment am Anfang dieser Epidemie. In dieser Anfangsphase gibt es eben auch Mechanismen, die anders laufen als in einer Phase, wo das Infektionsgeschehen in der Bevölkerung mehr gesättigt ist und andere Übertragungsnetzwerke zur Verfügung stehen. […]«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
