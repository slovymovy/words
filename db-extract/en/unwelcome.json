                    }
                ],
                "senses": [
                    {
                        "sense_id": "f77ac37c-9830-30e4-b167-ff8e75105c67",
                        "entry_id": "177a17d8-3aea-3eda-8bc3-0ff4fda3331e",
                        "glosses": [
                            "Not welcome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "417595e0-edc8-4e49-983a-6b3b565cc34f",
                                "sense_id": "f77ac37c-9830-30e4-b167-ff8e75105c67",
                                "text": "This ſtraunge vnwelcome and vnhappie newes,\nOf theſe vnnaturall Rebels and vniust,\nThat threaten wracke vnto this wretched Land,\nAye me affrights my womans mazed minde,\nBurdens my heart, and interrupts my ſleepe, […]"
                            },
                            {
                                "example_id": "132b6a84-960f-4a2f-b273-56dc382f8e69",
                                "sense_id": "f77ac37c-9830-30e4-b167-ff8e75105c67",
                                "text": "Gynecomastia is estimated to affect anywhere from 30 to 70 per cent of males at some stage of their lives. And \"gyne\" or \"gyno\", as it's commonly known, is not only an unwelcome (and ironic) side-effect of anabolic-androgenic - that is, muscle-building and masculinising - steroids: it can also be caused by other hormonal disruptors such as alcohol, cigarettes, cannabis, obesity, puberty (usually temporarily) and old age. But [Tom] Powell says his gyno was \"99 percent\" likely due to steroids."
                            },
                            {
                                "example_id": "86006167-67c5-4486-9932-6680a962730e",
                                "sense_id": "f77ac37c-9830-30e4-b167-ff8e75105c67",
                                "text": "For companies such as Trans Pennine Express, it will be even harder. It has the unwelcome claim to being Britain's worst train operator, with recent statistics from the Office of Rail and Road showing it cancelled nearly a quarter of its services in February, with lack of available train crew a real problem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc95daf9-ac21-43b6-9e67-42edc36f01d2",
                        "source_entry_id": "177a17d8-3aea-3eda-8bc3-0ff4fda3331e",
                        "source_sense_id": "f77ac37c-9830-30e4-b167-ff8e75105c67",
                        "source_sense_description": "Translations",
                        "target_lang_word": "malvenu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malvenu",
