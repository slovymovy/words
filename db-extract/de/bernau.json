                ],
                "senses": [
                    {
                        "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                        "entry_id": "63f5d549-8d71-3c88-bcf7-f7cff8850bb3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba05187d-2f5a-4fb8-ab8b-1a3d9ac58c78",
                                "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                                "text": "Frau Bernau ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4fa2f865-74ec-4e53-880f-b27239073e6e",
                                "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                                "text": "Herr Bernau wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1194f3f9-7ce4-4c96-9f2b-70c4c6ae871f",
                                "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                                "text": "Die Bernaus fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "74d3e00e-25cf-494f-baec-009789d1adcb",
                                "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                                "text": "Der Bernau trägt nie die Schals, die die Bernau ihm strickt."
                            },
                            {
                                "example_id": "7b95eb75-6c12-4b50-85d8-d79f22b517c7",
                                "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bernau kommt, geht der Herr Bernau.“"
                            },
                            {
                                "example_id": "d9ba1bf3-de23-449e-b45a-003fa049c48b",
                                "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                                "text": "Bernau kommt und geht."
                            },
                            {
                                "example_id": "86cfdcd9-5ef3-42b1-8785-3c2c81a76eb4",
                                "sense_id": "12dde4d2-13e6-3eeb-a10f-ae2c7f6ece81",
                                "text": "Bernaus kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
