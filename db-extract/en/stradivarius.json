                                                "sense_id": "234736e3-31e0-387e-a780-1cfc80a28118",
                                                "text": "Die von Stradivari gebauten Geigen erlangten Weltruhm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
