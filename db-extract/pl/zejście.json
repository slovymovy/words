                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a9b0852-29f2-4f34-96a7-c59d9aa6807a",
                        "source_entry_id": "25b5cb94-3727-3b9b-9faf-f3a56c69e35d",
                        "source_sense_id": "6526d90a-4376-3868-bf3b-a08dd628fdbd",
                        "target_lang_word": "Abstieg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstieg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae467bc-ba3f-30d3-81d6-28561703aee7",
                                        "entry_id": "36cb207d-ae1a-3ccf-af13-a2539d36998c",
                                        "glosses": [
                                            "das Herunterklettern aus der Höhe in tiefere Bereiche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941ac20e-e72b-4060-a8db-1bef873100d7",
                                                "sense_id": "4ae467bc-ba3f-30d3-81d6-28561703aee7",
                                                "text": "Der Abstieg ist oft schwieriger als das Erklimmen des Gipfels."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "664266d7-2428-3907-8076-f5fd795f31b1",
                                        "entry_id": "36cb207d-ae1a-3ccf-af13-a2539d36998c",
                                        "glosses": [
                                            "die Verringerung eines Niveaus, zum Beispiel des sozialen Status"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f59893-f43a-4276-9099-dbac049b1add",
                                                "sense_id": "664266d7-2428-3907-8076-f5fd795f31b1",
                                                "text": "Durch seine Drogensucht war der gesellschaftliche Abstieg des früheren Superstars nicht mehr aufzuhalten."
                                            },
                                            {
                                                "example_id": "66e6e071-8094-406d-9e37-d6580501c114",
                                                "sense_id": "664266d7-2428-3907-8076-f5fd795f31b1",
                                                "text": "„Hier zählen auch Symbole – und da ist der Abstieg aus dem exklusiven Kreis der besten Schuldner der Erde ein Menetekel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "228976ce-50b4-3ca4-9ebd-eb91474653cc",
                                        "entry_id": "36cb207d-ae1a-3ccf-af13-a2539d36998c",
                                        "glosses": [
                                            "der Wechsel in eine niedrigere Liga oder Klasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2b69e3-6f00-419c-9185-44c9885e494d",
                                                "sense_id": "228976ce-50b4-3ca4-9ebd-eb91474653cc",
                                                "text": "Wenn sie das nächste Spiel nicht gewinnen, wird der Abstieg in die Regionalliga unvermeidlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
