                "senses": [
                    {
                        "sense_id": "2a95f516-e6ed-3e1b-9fc0-8889b6cf8e8f",
                        "entry_id": "a4bc664a-0e26-392d-9970-ad5fca96b992",
                        "glosses": [
                            "Unterricht, der in der Schule im Fach Naturkunde abgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18697485-9daf-4bb8-b859-84969a13ccf0",
                                "sense_id": "2a95f516-e6ed-3e1b-9fc0-8889b6cf8e8f",
                                "text": "„Im Naturkundeunterricht, oder war es Biologie, verflucht noch mal, in Untersekunda hatten sie das Skelett des Menschen durchgenommen, und es war ein echtes Skelett gewesen, von einem hingerichteten Raubmörder vermutlich, aber den Lehrer hatte es nicht gestört.“"
                            },
                            {
                                "example_id": "1ffe4623-e897-4ff9-bbbf-cf5f532acc04",
                                "sense_id": "2a95f516-e6ed-3e1b-9fc0-8889b6cf8e8f",
                                "text": "„Erst in der Gymnasialzeit wird Canetti im Naturkundeunterricht theoretisch zu den Tieren hingeführt und schockartig mit einer besonderen Wirklichkeit der Tiere konfrontiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
