                                        "sense_id": "354e8ddd-39ed-3f6b-8bfa-55888434bc77",
                                        "entry_id": "c777cd1f-5863-35b2-ba96-259cadf0e2f6",
                                        "glosses": [
                                            "A visual symbol or emblem that acts as a trademark or a means of identification of a company or organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a7c46fa-cd2e-42da-b85f-637253e8b7d8",
                                                "sense_id": "354e8ddd-39ed-3f6b-8bfa-55888434bc77",
                                                "text": "The unified colour palette of reds, blues, and yellows used throughout the signage matches that of the institution’s logo and letterhead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13e7bb86-608e-32e4-a18b-7d32ce03df65",
                                        "entry_id": "c777cd1f-5863-35b2-ba96-259cadf0e2f6",
                                        "glosses": [
                                            "An audio recording for the same purpose; a jingle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed3f5f63-f47b-4de5-be87-bb9d84fb6c4d",
                                                "sense_id": "13e7bb86-608e-32e4-a18b-7d32ce03df65",
                                                "text": "What about including a CD of your music or a copy of your audio logo/jingle in your promotional items […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ece3d05-5786-330c-9bfe-3eb2e53f9554",
                                        "entry_id": "c777cd1f-5863-35b2-ba96-259cadf0e2f6",
                                        "glosses": [
