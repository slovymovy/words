                    {
                        "translation_id": "57fe5676-b07a-410f-bab3-bd66107ae97d",
                        "source_entry_id": "52c34a77-5caf-36fc-b499-dcee9702e76a",
                        "source_sense_id": "b9f25342-7fbd-3c3f-b228-752fa32012aa",
                        "source_sense_description": "alkaloid found naturally in tea and coffee plants",
