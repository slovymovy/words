                                        "entry_id": "727190a3-960c-3bbc-a245-82831b3e94be",
                                        "glosses": [
                                            "Relatif à l’Acheuléen, période du Paléolithique inférieur et à l’industrie lithique caractéristique de cette période."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "741c2d6c-f527-476e-963d-faac123218d3",
                                                "sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                                                "text": "Des silex taillés datant de l'époque acheuléenne."
                                            },
                                            {
                                                "example_id": "32309ac5-ccda-4061-98db-41ef4d59f930",
                                                "sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                                                "text": "C'est un autre témoignage de la pénétration de l'acheuléen récent vers l'intérieur du pays."
                                            },
                                            {
                                                "example_id": "b3a30cdb-919d-4aba-bd05-3beed2fe81c8",
                                                "sense_id": "20563a12-7d31-3375-9f8f-7b7e86cc8438",
                                                "text": "Les premiers hominidés - vraisemblablement des Homo erectus - ayant migré hors d'Afrique maîtrisaient-ils la technique acheuléenne ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
