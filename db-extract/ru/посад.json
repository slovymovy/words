                                    {
                                        "sense_id": "7bc3c073-b45e-32af-99a3-a3c45d0b20e9",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A colony that is newly established; a place or region newly settled (even in past times)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99353b7f-dee7-4ca4-9295-75a583007fc9",
                                                "sense_id": "7bc3c073-b45e-32af-99a3-a3c45d0b20e9",
                                                "text": "Such anthropophilous behaviour makes it a good candidate for a commensal relationship with humans at the Neolithic settlements of Quanhucun, Wuzhuangguoliang and Xiawanggang, as well as other Middle and Late Neolithic settlements in China […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "022ebe24-5734-3fb5-afe2-e8bbc83f8f59",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A community of people living together, such as a hamlet, village, town, or city; a populated place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e4c22a-b501-432b-9931-71b14031c6d8",
                                                "sense_id": "022ebe24-5734-3fb5-afe2-e8bbc83f8f59",
                                                "text": "Here, after months of relative inactivity, Russian forces have drastically increased the intensity of their offensive operations targeting the villages of Staromaiorske and Urozhaine. These villages, located south of Velyka Novosilka, hold tactical and symbolic significance, as these are the last settlements that Ukrainian forces recaptured during their counteroffensive in the summer of 2023."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d107deb2-6f28-3faa-950c-b64ad3c6a856",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A site where people used to live together in ancient times; an ancient simple kind of village."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a158fb0-df3e-3004-82ae-a06b06244341",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "The gradual sinking of a building. Fractures or dislocations caused by settlement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c661886-1f33-3a06-8d30-fa9682d5a5f9",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "The delivery of goods by the seller and payment for them by the buyer, under a previously agreed trade or transaction or contract entered into."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd991fc1-6994-3e83-9369-5023e1b1fdd4",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A disposition of property, or the act of granting it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4606735-dd9d-3818-b25c-6d96af4c4601",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A settled place of abode; residence; a right growing out of legal residence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b773817a-e317-3885-a140-5b04dfdb8bea",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A resolution of a dispute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e90752fa-3a0a-3844-95d0-e686ca0a9a68",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "A mutual agreement to end a dispute without resorting to legal proceedings, also known as an out-of-court settlement or settling out of court."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab23148-f7c7-4af1-b887-0a8645a59630",
                                                "sense_id": "e90752fa-3a0a-3844-95d0-e686ca0a9a68",
                                                "text": "The family of a^([sic]) Ohio teenager who was crushed to death by the seat of a minivan after emergency responders failed to find him in time has been awarded a $6million settlement […] As part of the settlement, the city has pledged to improve its 911 call centre […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a6e51c-8738-3c01-ab80-6db8a64fdedf",
                                        "entry_id": "e9259752-c027-34ee-bcc5-51d2f81fb455",
                                        "glosses": [
                                            "An estate or district in Anglo-Indian Bengal where, instead of taking a quota of the year's produce, the government took a fixed sum several times a year from the local cultivators."
                                        ],
