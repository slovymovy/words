                                                "sense_id": "904177f3-0d0b-3bf1-8ef3-830b6990e063",
                                                "text": "„Die Probengröße wird durch deren Art und Größe, deren Handhabbarkeit und die Größe des Pyknometers bestimmt.“"
                                            },
                                            {
                                                "example_id": "b4ec511e-76c1-47c1-b894-0166f0f91aa6",
                                                "sense_id": "904177f3-0d0b-3bf1-8ef3-830b6990e063",
                                                "text": "„Für die Bestimmung der Dichte von Schichten bedient man sich oft eines Pyknometers.“"
                                            },
                                            {
                                                "example_id": "ef10767e-0139-418e-9b53-d8762cd0c0f3",
                                                "sense_id": "904177f3-0d0b-3bf1-8ef3-830b6990e063",
                                                "text": "„Die Untersuchungsprobe wird in das leere und trockene Pyknometers eingewogen und danach das Pyknometer mit Eintauchflüssigkeit befüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
