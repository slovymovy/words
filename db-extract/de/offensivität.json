                ],
                "senses": [
                    {
                        "sense_id": "7a8d82e7-dca6-3064-b83d-0808a48b161c",
                        "entry_id": "032626ec-0e07-30fc-bba1-5e9256234b34",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße aktives (offensives) Herangehen zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d462c4a0-d2a6-4963-aa51-bdd0fc2aa056",
                                "sense_id": "7a8d82e7-dca6-3064-b83d-0808a48b161c",
                                "text": "„Higgins' Modell zufolge greifen narzisstische Persönlichkeiten zumindest auf einer strategischen Handlungsebene auf eine Form der Selbstregulierung zurück, die eher von Offensivität denn Prävention geprägt ist.“"
                            },
                            {
                                "example_id": "fe21964a-4885-4dab-b034-265e3c8eb62f",
                                "sense_id": "7a8d82e7-dca6-3064-b83d-0808a48b161c",
                                "text": "„Von den sozialen Kompetenzen hat in dieser Untersuchung Offensivität (Verhaltensweisen wie Konfliktbereitschaft, Extraversion, Entscheidungsfreude) die zentrale Bedeutung für Exploitation und Exploration.“"
                            },
                            {
                                "example_id": "2fa07852-274f-4f82-abba-0f62f9bb016f",
                                "sense_id": "7a8d82e7-dca6-3064-b83d-0808a48b161c",
                                "text": "„Bereits auf dem ersten Blick merkt man die wesentlichen Eigenschaften der neuen Kriegskunst Titos: das Kombinieren der frontalen und der Partisanenform des bewaffneten Kampfes und die maximale Offensivität und Initiative auf allen Gebieten.“"
                            },
                            {
                                "example_id": "1f4c953b-092f-47b4-978c-886dc2efa7f8",
                                "sense_id": "7a8d82e7-dca6-3064-b83d-0808a48b161c",
                                "text": "„Offensivität bedeutet, daß Beteiligung weder nebenher noch ohne (Nach-)Druck betrieben werden kann. Es bedarf vielmehr expliziter Initiativen zur Entscheidung über ein partizipatives Vorgehen und deren Realisierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
