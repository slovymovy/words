                ],
                "senses": [
                    {
                        "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                        "entry_id": "93e4dec0-bbae-3e55-837f-a8a486ea6a12",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234a93c0-c158-40ea-81b4-9c786f4533e1",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "Frau Wallenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "67c7a577-97ad-4a9b-a625-501e57bb9e42",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "Herr Wallenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c66765cd-089d-4e5b-85d1-428f629d247e",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "Die Wallenbergs kommen heute aus Mannheim."
                            },
                            {
                                "example_id": "6268476f-9e23-4bfe-80a2-ef5bbd8c5cc3",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "Der Wallenberg trägt nie die Schals, die die Wallenberg ihm strickt."
                            },
                            {
                                "example_id": "ddfeb051-50bb-40d5-9e01-0229aaf67a2e",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wallenberg kommt, geht der Herr Wallenberg.“"
                            },
                            {
                                "example_id": "ed4a4442-8798-423f-8858-a1adc5bb9347",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "Wallenberg kommt und geht."
                            },
                            {
                                "example_id": "655ae6eb-2327-4110-bb33-22bfb25772a7",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "Wallenbergs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "c0ea668a-dd91-4288-8ee6-3b9ee0183a1e",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "An verregneten Herbsttagen ist Familie Wallenbergs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "76ab3bec-7d85-4172-a274-6ee34515de5b",
                                "sense_id": "970c53f8-bf74-3f27-bcbf-6b5ca772ed7e",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Wallenberg das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
