                                "target_lang_sense_clarification": "создать творчески или божественной силой"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "create",
                                "target_lang_sense_clarification": "to bring something into existence, e.g., art, a company, or a system"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "to produce or construct something new"
                            },
                            {
                                "target_lang_word": "establish",
                                "target_lang_sense_clarification": "to set up or found an organization or entity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be857e37-3b07-3850-9f8d-3bfa295222d3",
                    "sense_definition": "Doprowadzić do powstania jakiejś sytuacji, warunków lub nastroju",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creation_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego nieodpowiedzialne zachowanie może <w>stworzyć</w> poważne zagrożenie na drodze.",
                            "target_lang_translations": {
                                "ru": "Его безответственное поведение может <w>создать</w> серьезную угрозу на дороге.",
                                "en": "His irresponsible behavior could <w>pose</w> a serious danger on the road."
                            }
                        },
                        {
                            "text": "Nauczyciel starał się <w>stworzyć</w> przyjazną atmosferę w klasie.",
                            "target_lang_translations": {
                                "ru": "Учитель старался <w>создать</w> дружелюбную атмосферу в классе.",
                                "en": "The teacher tried to <w>create</w> a friendly atmosphere in the classroom."
                            }
                        }
                    ],
                    "synonyms": [
                        "wywołać",
                        "spowodować",
                        "sprawić"
                    ],
                    "antonyms": [
                        "zlikwidować",
                        "usunąć",
                        "zażegnać"
                    ],
                    "common_phrases": [
