{
    "word_family": [
        "presager",
        "presageful"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79e18584-ddcc-3593-8a5e-0274bc83e0da",
                    "sense_definition": "To portend, foreshadow, or serve as an omen of a future event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "predicting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds gathering on the horizon seemed to <w>presage</w> a severe storm.",
                            "target_lang_translations": {
                                "pl": "Ciemne chmury gromadzące się na horyzoncie zdawały się <w>zwiastować</w> gwałtowną burzę."
                            }
                        },
                        {
                            "text": "Many economists believe that these sudden market drops <w>presage</w> a major economic downturn.",
                            "target_lang_translations": {
                                "pl": "Wielu ekonomistów uważa, że te nagłe spadki na giełdzie <w>zapowiadają</w> poważne spowolnienie gospodarcze."
                            }
                        }
                    ],
                    "synonyms": [
                        "foreshadow",
                        "portend"
                    ],
                    "common_phrases": [
                        "presage a storm",
                        "presage a downturn"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zwiastować, zapowiadać lub stanowić znak (wróżbę) przyszłego wydarzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwiastować",
                                "target_lang_sense_clarification": "zapowiadać nadejście czegoś"
                            },
                            {
                                "target_lang_word": "zapowiadać",
                                "target_lang_sense_clarification": "być oznaką przyszłych wydarzeń"
                            },
                            {
                                "target_lang_word": "wróżyć",
                                "target_lang_sense_clarification": "przepowiadać, rokować"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "891a3c08-6349-3422-80ad-5cdbf75a528b",
                    "sense_definition": "To have a presentiment of; to feel or foreknow beforehand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "predicting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She could not shake the feeling that some unseen danger was about to unfold, as if her heart could <w>presage</w> the coming disaster.",
                            "target_lang_translations": {
                                "pl": "Nie mogła pozbyć się uczucia, że nadchodzi jakieś niewidzialne niebezpieczeństwo, jakby jej serce potrafiło <w>przeczuć</w> nadchodzącą katastrofę."
                            }
                        },
                        {
                            "text": "He seemed to <w>presage</w> his own misfortune, speaking of the journey with unusual dread.",
                            "target_lang_translations": {
                                "pl": "Zdawał się <w>przewidywać</w> własne nieszczęście, mówiąc o podróży z niezwykłym lękiem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or archaic contexts to describe intuitive foreknowledge."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mieć przeczucie; przeczuwać coś intuicyjnie lub wiedzieć o czymś z góry."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeczuwać",
                                "target_lang_sense_clarification": "mieć intuicyjne przeczucie"
                            },
                            {
                                "target_lang_word": "przewidywać",
                                "target_lang_sense_clarification": "intuicyjnie przeczuwać przyszłość"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ada764-e142-30ca-be3f-da6d67a9ac31",
                    "sense_definition": "To make a prediction or foretell future events.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "predicting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient seers would often <w>presage</w> based on the flight patterns of birds.",
                            "target_lang_translations": {
                                "pl": "Starożytni wróżbici często <w>przepowiadali przyszłość</w> na podstawie wzorów lotu ptaków."
                            }
                        },
                        {
                            "text": "It is difficult to <w>presage</w> with any accuracy how the political landscape will shift next year.",
                            "target_lang_translations": {
                                "pl": "Trudno jest z jakąkolwiek dokładnością <w>prognozować</w>, jak zmieni się krajobraz polityczny w przyszłym roku."
                            }
                        }
                    ],
                    "synonyms": [
                        "forespell"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przepowiadać lub prognozować przyszłe wydarzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przepowiadać",
                                "target_lang_sense_clarification": "wróżyć, ogłaszać przyszłość"
                            },
                            {
                                "target_lang_word": "prognozować",
                                "target_lang_sense_clarification": "przewidywać na podstawie danych lub znaków"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "037b74ad-f5ea-31a2-bc34-331f136666c5",
                    "sense_definition": "An omen, sign, or warning of a future event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "omen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden silence of the birds was taken as a grim <w>presage</w> of the approaching earthquake.",
                            "target_lang_translations": {
                                "pl": "Nagła cisza ptaków została uznana za ponury <w>zwiastun</w> zbliżającego się trzęsienia ziemi."
                            }
                        },
                        {
                            "text": "Some cultures view the appearance of a comet as a powerful <w>presage</w> of political change.",
                            "target_lang_translations": {
                                "pl": "Niektóre kultury postrzegają pojawienie się komety jako potężny <w>omen</w> zmian politycznych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grim presage",
                        "presage of disaster"
                    ],
                    "target_lang_definitions": {
                        "pl": "Omen, znak lub ostrzeżenie przed przyszłym wydarzeniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwiastun",
                                "target_lang_sense_clarification": "znak zapowiadający coś"
                            },
                            {
                                "target_lang_word": "omen",
                                "target_lang_sense_clarification": "wróżba, znak proroczy"
                            },
                            {
                                "target_lang_word": "zapowiedź",
                                "target_lang_sense_clarification": "oznaka nadchodzącego wydarzenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c3a337f-79ac-3c33-bc43-680ce2ac72e3",
                    "sense_definition": "An intuitive feeling or presentiment about a future event.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "omen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a sudden, uneasy <w>presage</w> that he would never return to his homeland.",
                            "target_lang_translations": {
                                "pl": "Nagle ogarnęło go niepokojące <w>przeczucie</w>, że już nigdy nie wróci do ojczyzny."
                            }
                        },
                        {
                            "text": "Despite the cheerful atmosphere, she was troubled by a dark <w>presage</w> she could not explain.",
                            "target_lang_translations": {
                                "pl": "Mimo radosnej atmosfery dręczyło ją mroczne <w>przeczucie</w>, którego nie potrafiła wyjaśnić."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dark presage"
                    ],
                    "target_lang_definitions": {
                        "pl": "Intuicyjne przeczucie dotyczące przyszłego wydarzenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeczucie",
                                "target_lang_sense_clarification": "intuicyjne odczucie przyszłości"
                            },
                            {
                                "target_lang_word": "przepowiednia",
                                "target_lang_sense_clarification": "wewnętrzne przeczucie lub wizja"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}