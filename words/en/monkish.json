{
    "word_family": [
        "monk",
        "monkishly",
        "monkishness",
        "monkhood"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e157390e-7731-3d8f-bc95-5ee4ca73e99c",
                    "sense_definition": "Relating to, characteristic of, or resembling a monk or monastic life.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monastic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar lived a quiet and <w>monkish</w> life surrounded by ancient books.",
                            "target_lang_translations": {
                                "de": "Der Gelehrte führte, umgeben von alten Büchern, ein ruhiges und <w>mönchisches</w> Leben."
                            }
                        },
                        {
                            "text": "He wore a <w>monkish</w> robe made of rough brown cloth.",
                            "target_lang_translations": {
                                "de": "Er trug eine <w>mönchische</w> Robe aus grobem braunem Stoff."
                            }
                        }
                    ],
                    "synonyms": [
                        "monastic"
                    ],
                    "common_phrases": [
                        "monkish robe",
                        "monkish habit"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf einen Mönch oder das Klosterleben bezogen, dafür charakteristisch oder daran erinnernd."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mönchisch",
                                "target_lang_sense_clarification": "einem Mönch ähnelnd oder eigen"
                            },
                            {
                                "target_lang_word": "klösterlich",
                                "target_lang_sense_clarification": "das Klosterleben betreffend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8e55b6b-8ce3-3fac-9e51-dd3d8d31da69",
                    "sense_definition": "Practicing strict self-denial or living in a very simple, disciplined way; ascetic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monastic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>monkish</w> discipline kept him working long hours without distraction.",
                            "target_lang_translations": {
                                "de": "Seine <w>mönchische</w> Disziplin ließ ihn viele Stunden lang ohne Ablenkung arbeiten."
                            }
                        },
                        {
                            "text": "She preferred a <w>monkish</w> existence, rejecting luxury and material comforts.",
                            "target_lang_translations": {
                                "de": "Sie zog ein <w>asketisches</w> Dasein vor und lehnte Luxus sowie materiellen Komfort ab."
                            }
                        }
                    ],
                    "synonyms": [
                        "ascetic",
                        "austere"
                    ],
                    "antonyms": [
                        "hedonistic"
                    ],
                    "common_phrases": [
                        "monkish devotion",
                        "monkish discipline"
                    ],
                    "target_lang_definitions": {
                        "de": "Strenge Selbstverleugnung übend oder auf sehr einfache, disziplinierte Weise lebend; asketisch."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mönchisch",
                                "target_lang_sense_clarification": "von strenger, mönchsgleicher Einfachheit"
                            },
                            {
                                "target_lang_word": "asketisch",
                                "target_lang_sense_clarification": "enthaltsam, streng diszipliniert"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}