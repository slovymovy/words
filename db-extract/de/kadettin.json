                "senses": [
                    {
                        "sense_id": "2e1e5686-ee65-3b09-b001-c4ecb7644d79",
                        "entry_id": "b54d6a00-79da-3ca8-b1b3-120bcdd1c431",
                        "glosses": [
                            "Trägerin des niedrigsten weiblichen militärischen Ranges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "701cdaad-424e-4179-9088-b0b84f2e3c9f",
                                "sense_id": "2e1e5686-ee65-3b09-b001-c4ecb7644d79",
                                "text": "„Dass Militärakademien bis in die jüngste Zeit strikt männliches Territorium waren, sieht man dieser Kadettin der Koninklijke Militaire Academie im niederländischen Breda an.“"
                            },
                            {
                                "example_id": "8c095354-90e8-42c8-a7d3-874ed8c2764b",
                                "sense_id": "2e1e5686-ee65-3b09-b001-c4ecb7644d79",
                                "text": "„Anders als Jasmin Haik, die Kadettin in Rischon, spricht sie darüber, was es für eine arabische Christin bedeutet, israelische Soldatin zu sein.“"
                            },
                            {
                                "example_id": "7595bd97-99de-414d-9035-ee00806024b7",
                                "sense_id": "2e1e5686-ee65-3b09-b001-c4ecb7644d79",
                                "text": "„Den Vorwurf, mit einer rangniedrigeren Kadettin geschlafen zu haben, hat die Universität nie wiederholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
