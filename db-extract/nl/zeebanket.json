                                                "sense_id": "f37e1a22-2a6e-3eb9-b1b6-7c3779be6e82",
                                                "text": "Ich esse keine Meeresfrüchte, davon wird mir immer schlecht."
                                            },
                                            {
                                                "example_id": "8e5fc0b5-3408-4ab1-87cb-c66a8d1ee787",
                                                "sense_id": "f37e1a22-2a6e-3eb9-b1b6-7c3779be6e82",
                                                "text": "„Immer wieder legten sie neue Muscheln auf den Stein, der zum Mittelpunkt eines Festschmauses von Meeresfrüchten wurde."
                                            },
                                            {
                                                "example_id": "ccaa55d3-edcd-49b8-b012-a64cfe91fd77",
                                                "sense_id": "f37e1a22-2a6e-3eb9-b1b6-7c3779be6e82",
                                                "text": "„\"Surimi\" darf nicht als Meeresfrucht verkauft werden“ (Überschrift)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
