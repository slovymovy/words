                ],
                "senses": [
                    {
                        "sense_id": "6880ff6a-2992-3560-8fd5-fe89203b2400",
                        "entry_id": "2d0acfb9-8e6e-329b-8519-2830b93c0ea3",
                        "glosses": [
                            "so, dass es dressiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac94a4f-5861-48c1-b6f4-24c97b841b45",
                                "sense_id": "6880ff6a-2992-3560-8fd5-fe89203b2400",
                                "text": "„Aber dieser mächtige Mäusevater erwies sich als dressierbar. Ich steckte ihn in die Hosentasche, wo er bei einem Knust Brot sich still verhielt, bis ich einen kurzen Pfiff ertönen ließ.“"
                            },
                            {
                                "example_id": "8914f400-d47d-40a0-b204-a5d934c604cb",
                                "sense_id": "6880ff6a-2992-3560-8fd5-fe89203b2400",
                                "text": "„Je mehr Körper und Seele sich passiv, leicht dressierbar und rezeptiv zeigen, desto bessere Resultate vom Gesichtspunkt der Schule aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
