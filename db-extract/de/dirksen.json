                "senses": [
                    {
                        "sense_id": "3e3e9bf5-00ef-331c-a34e-5a3db83e4bb6",
                        "entry_id": "d7d83da2-ada7-371a-9c6a-271f9d053926",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fe50dda-ddbc-4d84-9b6f-d8bd87c7b802",
                                "sense_id": "3e3e9bf5-00ef-331c-a34e-5a3db83e4bb6",
                                "text": "Sieh mal, wie gut der Sohn der Dirksens schon Rad fährt."
                            },
                            {
                                "example_id": "f33fd8a2-f983-4ce2-a97c-417cccbd74f5",
                                "sense_id": "3e3e9bf5-00ef-331c-a34e-5a3db83e4bb6",
                                "text": "Ohne die Hilfe von Herrn Dirksen und seiner Schwester wären wir nie fertig geworden."
                            },
                            {
                                "example_id": "673c22e5-8c38-4b89-be75-93e638ed7c37",
                                "sense_id": "3e3e9bf5-00ef-331c-a34e-5a3db83e4bb6",
                                "text": "Dirksen soll bloß aufpassen, dass ihre Frechheit sich nicht mal rächt."
                            },
                            {
                                "example_id": "acd9a074-c13e-4afe-b853-d170c23bcfc3",
                                "sense_id": "3e3e9bf5-00ef-331c-a34e-5a3db83e4bb6",
                                "text": "Frau Dirksens neue Schuhe waren sündteuer."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
