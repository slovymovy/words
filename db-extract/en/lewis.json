                    {
                        "sense_id": "8b55a8c2-b3c4-3ebb-ae47-8dd3f4e79c8d",
                        "entry_id": "ae27e7fb-ee4f-38fb-b18c-d08922a18484",
                        "glosses": [
                            "A male given name from Frankish."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "21349d09-9d30-42a3-bbef-c1dd87e43073",
                                "sense_id": "8b55a8c2-b3c4-3ebb-ae47-8dd3f4e79c8d",
                                "text": "And tell false Edward, thy supposed king,\nThat Lewis of France is sending over masquers,\nTo revel it with him and his new bride."
                            },
                            {
                                "example_id": "544b00b6-62e4-4a2c-b8ff-93e1da568e87",
                                "sense_id": "8b55a8c2-b3c4-3ebb-ae47-8dd3f4e79c8d",
                                "text": "They named me Lewis and called me Louie as though my name was Louis, and I never saw the difference until Sammy pointed it out. And even then, I still don't see much difference."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeeefc86-0a44-39a7-a73f-52a36aef4a26",
                        "entry_id": "ae27e7fb-ee4f-38fb-b18c-d08922a18484",
