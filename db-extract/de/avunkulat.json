                "senses": [
                    {
                        "sense_id": "a125c01f-f682-34e6-aebf-6b31a50cba22",
                        "entry_id": "c7a42ef9-5a7f-3b18-b2a0-239b87fbef0a",
                        "glosses": [
                            "Vorrecht bei manchen Kulturen mit Mutterrecht, das der Bruder der Mutter (Onkel mütterlicherseits) eines Kindes gegenüber dessen Vater genießt"
                        ],
                        "tags": [
                            "Ethnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a340df49-fcd0-4bdc-bc02-db1373b42d24",
                                "sense_id": "a125c01f-f682-34e6-aebf-6b31a50cba22",
                                "text": "„Mustert man sämtliche Avunkulate, in denen Parzival vorkommt, auf die primären Verhaltensattitüden durch, und vergleicht man diese mit den tatsächlichen Verwandtschaftsbeziehungen im Text, so wird man feststellen, daß im Parzival systematisch die Avunkulatbeziehungen mit den realen Beziehungen der Figuren zueinander identisch sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
