                        "entry_id": "a34e6dbc-2f0e-3c1d-bc7a-a61a8683e707",
                        "glosses": [
                            "Ort, an dem wesentliche Geschäftsaktivitäten stattfinden, der außerhalb der Zentrale oder eines Hauptsitzes liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8ca290e-90c9-4713-9a55-125f041238e8",
                                "sense_id": "1b98dacf-00df-3fa2-896a-76374f2cb4df",
                                "text": "Sie können auch gerne einen Beratungstermin in einer unserer Außenstellen vereinbaren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d7ae522-f114-4644-8b9e-2d3a1b60f0fa",
                        "source_entry_id": "a34e6dbc-2f0e-3c1d-bc7a-a61a8683e707",
                        "source_sense_id": "1b98dacf-00df-3fa2-896a-76374f2cb4df",
                        "source_sense_description": "Geschäftsort außerhalb der Zentrale",
                        "target_lang_word": "branch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "branch",
