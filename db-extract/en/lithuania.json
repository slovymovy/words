                        "glosses": [
                            "A country in northeastern Europe. Official name: Republic of Lithuania."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3c39b6-eadb-4a84-9053-be89ba04f30c",
                                "sense_id": "ca522e8a-7ebc-3d0e-8dd2-5a5b0d9ca1a8",
                                "text": "Taiwan's Foreign Ministry on Saturday condemned the sanctions, saying they amounted to \"irrational retaliation\" by China.\n\"Taiwan vows to continue to do its best to assist Lithuania to counter the unreasonable and arbitrary suppression of the Chinese government,\" the ministry said in a statement."
                            }
                        ]
                    }
                ],
