                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1034499e-355b-47c8-9d3e-3b28c0ef2a41",
                                "sense_id": "da44dbf3-0630-354b-942c-0c05b2c151f7",
                                "text": "- Чего рюмишь? - сказала сторожиха. - Пуще всего не впадай духом."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a98a99f-21c1-390a-8632-7b6da25faef4",
                        "entry_id": "59e3d1b7-8568-31ac-a19d-0e8fa4673e2a",
                        "glosses": [
                            "редк. издавать звуки пения зяблика"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942c3935-c801-4f79-9db7-b5af01751174",
                                "sense_id": "7a98a99f-21c1-390a-8632-7b6da25faef4",
                                "text": "Рю-рю-рю, — где-то рядом рюмил зяблик."
                            },
                            {
                                "example_id": "a8870f0e-8fdb-4b9a-a0ae-789178b69c15",
                                "sense_id": "7a98a99f-21c1-390a-8632-7b6da25faef4",
                                "text": "И коростелём умеешь кричать, и зябликом рюмить?"
                            }
                        ]
                    }
