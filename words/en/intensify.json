{
    "word_family": [
        "intense",
        "intensity",
        "intensification",
        "intensive",
        "intensifier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ed1500a-2dde-3949-aeb7-c70e27d51b9c",
                    "sense_definition": "To make something stronger, more extreme, or more forceful.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>intensify</w> the flavor of the sauce by adding more fresh herbs.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>усилить</w> вкус соуса, добавив больше свежей зелени."
                            }
                        },
                        {
                            "text": "The military decided to <w>intensify</w> the search for the missing soldiers after new evidence emerged.",
                            "target_lang_translations": {
                                "ru": "Военные решили <w>активизировать</w> поиски пропавших солдат после появления новых улик."
                            }
                        }
                    ],
                    "antonyms": [
                        "weaken",
                        "diminish",
                        "lessen"
                    ],
                    "common_phrases": [
                        "intensify the search",
                        "intensify the flavor",
                        "intensify the pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более сильным, экстремальным или мощным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать более мощным или выраженным"
                            },
                            {
                                "target_lang_word": "интенсифицировать",
                                "target_lang_sense_clarification": "книжн., увеличивать интенсивность процесса"
                            },
                            {
                                "target_lang_word": "нагнетать",
                                "target_lang_sense_clarification": "усиливать напряжение или давление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c2494c6-df00-336e-b46a-33dd67d03618",
                    "sense_definition": "To become stronger, more extreme, or more powerful.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm began to <w>intensify</w> as it moved closer to the coastal towns.",
                            "target_lang_translations": {
                                "ru": "Шторм начал <w>усиливаться</w>, приближаясь к прибрежным городам."
                            }
                        },
                        {
                            "text": "The pain in his leg started to <w>intensify</w> after he tried to walk on it.",
                            "target_lang_translations": {
                                "ru": "Боль в ноге начала <w>нарастать</w> после того, как он попытался наступить на неё."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensen"
                    ],
                    "antonyms": [
                        "subside",
                        "fade",
                        "ease"
                    ],
                    "common_phrases": [
                        "storm began to intensify",
                        "pain started to intensify",
                        "efforts will intensify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться более сильным, экстремальным или мощным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливаться",
                                "target_lang_sense_clarification": "становиться мощнее (о боли, шторме)"
                            },
                            {
                                "target_lang_word": "нарастать",
                                "target_lang_sense_clarification": "постепенно увеличиваться в силе"
                            },
                            {
                                "target_lang_word": "обостряться",
                                "target_lang_sense_clarification": "становиться более резким или критическим"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}