                                                "sense_id": "ec8a802e-8ac8-358b-a49d-edc8d915d82d",
                                                "text": "Vývoj je sexuálně diferencovaný. To znamená, že dívky biologicky dozrávají dříve než chlapci."
                                            },
                                            {
                                                "example_id": "444d49ff-aa88-45b1-b834-387985d2e3f9",
                                                "sense_id": "ec8a802e-8ac8-358b-a49d-edc8d915d82d",
                                                "text": "[Pekingská akční platforma z roku 1995] zavazuje všechny státy odstranit sexuálně diskriminační zákony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a8362da-592c-3311-b8e4-72fee188cd5c",
                                        "entry_id": "c1702847-552a-34e2-9235-851f46fcab6c",
                                        "glosses": [
                                            "v souvislosti se sexualitou, sexuálním aktem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2fe3422-feb2-4ae9-af14-781d57893a28",
                                                "sense_id": "8a8362da-592c-3311-b8e4-72fee188cd5c",
                                                "text": "Byla obviněna, že sexuálně obtěžovala svého bývalého asistenta."
                                            },
                                            {
                                                "example_id": "5341d35b-3236-4c55-883c-d7ad6be94daf",
                                                "sense_id": "8a8362da-592c-3311-b8e4-72fee188cd5c",
                                                "text": "Fyzicky, psychicky nebo sexuálně zneužívaných dětí v Česku přibývá."
                                            },
                                            {
                                                "example_id": "528be1a6-59e0-441c-bc0e-ec8917a596ed",
                                                "sense_id": "8a8362da-592c-3311-b8e4-72fee188cd5c",
                                                "text": "Nevěra je často drahým špásem, především kvůli riziku sexuálně přenosných chorob."
                                            },
                                            {
                                                "example_id": "ec3e10b1-ceea-4d18-933b-f45f3eca4896",
                                                "sense_id": "8a8362da-592c-3311-b8e4-72fee188cd5c",
                                                "text": "Sexuálně aktivní muži často trpí syndromem karpálního tunelu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d82ea7a-c4ad-4593-b998-cd3618262f45",
                        "source_entry_id": "827c1173-b97c-30f4-8c95-3b673346b627",
