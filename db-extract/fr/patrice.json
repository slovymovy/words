                    {
                        "sense_id": "94a6c938-09c5-351e-a52a-f693510ed2b9",
                        "entry_id": "53f52d66-fa24-3a78-9ab8-82994887d27f",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58d1f1f-947b-4a10-83f6-fb96939f0075",
                                "sense_id": "94a6c938-09c5-351e-a52a-f693510ed2b9",
                                "text": "Les démineurs de La Rochelle sont intervenus pour neutraliser l’engin explosif, rapporte le maire de Vaux-sur-Mer, Patrice Libelli qui s’est rendu sur place."
                            }
                        ]
                    }
                ],
