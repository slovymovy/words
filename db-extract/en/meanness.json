                                "target_senses": [
                                    {
                                        "sense_id": "03e71f98-8c50-3cb0-b55e-f8becfdf6c48",
                                        "entry_id": "898c5378-5881-3fb9-86f8-d6d2e5ef2f0f",
                                        "glosses": [
                                            "État d’abaissement qui attire le mépris de tous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b40a768-07a1-4d4f-8591-159535349d82",
                                                "sense_id": "03e71f98-8c50-3cb0-b55e-f8becfdf6c48",
                                                "text": "Vivre dans l’abjection."
                                            },
                                            {
                                                "example_id": "d30add98-5a91-415e-b817-00a40e82ec18",
                                                "sense_id": "03e71f98-8c50-3cb0-b55e-f8becfdf6c48",
                                                "text": "Il s’est relevé de l’abjection, de l’état d’abjection où il était tombé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e455fcf5-2847-3427-8d12-ea0a89ac99e4",
                                        "entry_id": "898c5378-5881-3fb9-86f8-d6d2e5ef2f0f",
                                        "glosses": [
                                            "Choses basses et méprisables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e42a94-644d-4de3-b080-2570cfbdc864",
                                                "sense_id": "e455fcf5-2847-3427-8d12-ea0a89ac99e4",
                                                "text": "[…] le Jardin de cactus. Différentes espèces, choisies pour leur morphologie répugnante, sont disposées le long d’allées pavées de pierre volcanique. Gras et piquants, les cactus symbolisent parfaitement l’abjection de la vie végétale – pour ne pas dire plus."
                                            },
                                            {
                                                "example_id": "ef5ca6e9-10a3-460c-8fe9-fba3d89a8c21",
                                                "sense_id": "e455fcf5-2847-3427-8d12-ea0a89ac99e4",
                                                "text": "Je tripote la merde et l’abjection à longueur d’année, et pourtant je bouffe des carottes râpées. Vous avez une explication à ça ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36376503-acc8-3b05-bae9-8e7cc053156a",
                                        "entry_id": "898c5378-5881-3fb9-86f8-d6d2e5ef2f0f",
                                        "glosses": [
                                            "Objet de rebut, dans cette phrase de la Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f58fa06c-d748-4aeb-a75b-6fb16c301ed8",
                                                "sense_id": "36376503-acc8-3b05-bae9-8e7cc053156a",
                                                "text": "L’opprobre des hommes et l’abjection du peuple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f03802-c8d9-34ac-9da1-9fc3de22c961",
                                        "entry_id": "898c5378-5881-3fb9-86f8-d6d2e5ef2f0f",
                                        "glosses": [
                                            "Agissements vils et méprisables."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81ae010c-26e6-4ec1-9036-2f5e845b20e0",
                                                "sense_id": "53f03802-c8d9-34ac-9da1-9fc3de22c961",
                                                "text": "Et ce n'est pas leur bore et leurs vapeurs de soufre\nQui viendront nous blanchir de nos abjections."
                                            },
                                            {
                                                "example_id": "1eac0764-910c-4ef0-8f3b-8d87f5b51245",
                                                "sense_id": "53f03802-c8d9-34ac-9da1-9fc3de22c961",
                                                "text": "Les terroristes nous ont habitués à des abjections inimaginables. Il leur arrive de tuer la mère uniquement pour piéger le fils le jour de la levée du corps […]."
                                            },
                                            {
                                                "example_id": "721c7527-baf5-4d66-b500-34f8b1c42a1f",
                                                "sense_id": "53f03802-c8d9-34ac-9da1-9fc3de22c961",
                                                "text": "Le « donneur » était pour lui, le rebut de l’espèce humaine, la trahison, la pire des abjections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
