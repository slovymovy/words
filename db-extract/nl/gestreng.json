                        ],
                        "examples": [
                            {
                                "example_id": "74ed00d0-a23a-4ef0-baf9-7143660774c4",
                                "sense_id": "bc4065af-0ae6-39a4-a847-a69833257af3",
                                "text": "Ik keek. De gestrenge gevels met de arcades stuurden de blik met majesteitelijk gezag in de richting van de basiliek van San Marco, die met haar koepels en ronde vormen een bubbelend en bijna buitenaards contrast vormde met het wereldse machtsvertoon van het plein."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e8981b0-86b0-44a4-baf2-0cf35a1bb458",
                        "source_entry_id": "c1c945fa-b45c-35fd-b24f-e6daa56a6165",
                        "source_sense_id": "bc4065af-0ae6-39a4-a847-a69833257af3",
                        "target_lang_word": "rigorous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigorous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d98385b-5d99-31bb-9533-6cb8112ae8d0",
                                        "entry_id": "2227e7e9-431e-34a8-bd03-9472a3ecaece",
                                        "glosses": [
                                            "Showing, causing, or favoring rigour/rigor; scrupulously accurate or strict; thorough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226ce0f9-fa14-4e81-a5ed-def404f19022",
                                                "sense_id": "9d98385b-5d99-31bb-9533-6cb8112ae8d0",
                                                "text": "a rigorous officer of justice"
                                            },
                                            {
                                                "example_id": "f439c82e-317d-412a-937c-73b8c503827e",
                                                "sense_id": "9d98385b-5d99-31bb-9533-6cb8112ae8d0",
                                                "text": "a rigorous execution of law"
                                            },
                                            {
                                                "example_id": "a2ee0f05-ec19-4301-952c-e50f9d5b13f3",
                                                "sense_id": "9d98385b-5d99-31bb-9533-6cb8112ae8d0",
                                                "text": "a rigorous inspection"
                                            },
                                            {
                                                "example_id": "c528e187-9c21-469b-9a4a-cab0354bc00d",
                                                "sense_id": "9d98385b-5d99-31bb-9533-6cb8112ae8d0",
                                                "text": "From this time onwards, the Westinghouse air brake literally went from strength to strength, and was triumphantly justified in the course of rigorous trials, both on the Pennsylvania Railroad and at Newark-on-Trent in this country."
                                            },
                                            {
                                                "example_id": "33395b27-d815-4ed6-bc06-695c07758b0d",
                                                "sense_id": "9d98385b-5d99-31bb-9533-6cb8112ae8d0",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1be1168d-35b2-37bc-999f-f72907908e47",
                                        "entry_id": "2227e7e9-431e-34a8-bd03-9472a3ecaece",
                                        "glosses": [
                                            "Severe; intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
