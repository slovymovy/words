                "senses": [
                    {
                        "sense_id": "2a57e26c-536d-3e5d-8b65-7b7a33b351d9",
                        "entry_id": "5d4fc499-11cc-38c3-b834-1b5a79d3928a",
                        "glosses": [
                            "sehr kurze, nicht biegbare Antenne für den Empfang von Funksignalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2879e7c7-09f7-4cff-a12b-20bfba768b5f",
                                "sense_id": "2a57e26c-536d-3e5d-8b65-7b7a33b351d9",
                                "text": "„Das nun bei eBay gehandelte Gerät verfügt neben der Stummelantenne auch über einen Steckplatz für SIM-Karten, der sich unter der Abdeckung für den (damals noch entnehmbaren) Akkusatz befindet.“"
                            },
                            {
                                "example_id": "7b6eb201-1c78-4e1c-a314-515fdbdb1c3b",
                                "sense_id": "2a57e26c-536d-3e5d-8b65-7b7a33b351d9",
                                "text": "„Die Stummelantenne mutet heute altertümlich an, damals war sie gegenüber der ausziehbaren Antenne, die manche Handys noch besaßen, immerhin ein Fortschritt.“"
                            },
                            {
                                "example_id": "8916f20b-728a-4cbd-8f62-ad38f236abe7",
                                "sense_id": "2a57e26c-536d-3e5d-8b65-7b7a33b351d9",
                                "text": "„Für den DVB-T-Empfang genügt in Deutschland meist eine kleine Stummelantenne, wie Sie in die Testgeräte eingebaut ist oder mitgeliefert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
