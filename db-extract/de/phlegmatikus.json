                                        "sense_id": "b07aa25e-24f7-3e56-8aad-68e53d8755c9",
                                        "entry_id": "025b3060-9c1e-3ca9-9b9b-f6697139b6ab",
                                        "glosses": [
                                            "Void of feeling; not susceptible of deep emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f1d9d2-1511-4f4f-b0db-e210885827e2",
                                                "sense_id": "b07aa25e-24f7-3e56-8aad-68e53d8755c9",
                                                "text": "He then added a few general offers of service, but offered as if he would be glad if they were accepted; and when Guido knelt for his parting benediction, it was given with a warmth and sincerity not often used by the apathetic and haughty minister."
                                            }
                                        ]
                                    },
