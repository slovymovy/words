                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette éponge spéciale <w>pompe</w> très rapidement tout le liquide renversé.",
                            "target_lang_translations": {
                                "en": "This special sponge <w>soaks up</w> all the spilled liquid very quickly.",
                                "ru": "Эта специальная губка очень быстро <w>впитывает</w> всю пролитую жидкость.",
                                "de": "Dieser spezielle Schwamm <w>saugt</w> die ganze verschüttete Flüssigkeit sehr schnell <w>auf</w>.",
                                "es": "Esta esponja especial <w>absorbe</w> muy rápidamente todo el líquido derramado.",
                                "zh": "这种特殊海绵能极快地<w>吸收</w>洒出的全部液体。"
                            }
                        },
                        {
                            "text": "Le sol très sec a <w>pompé</w> l'eau dès les premières gouttes de pluie.",
                            "target_lang_translations": {
                                "en": "The very dry soil <w>soaked up</w> the water as soon as the first drops of rain fell.",
                                "ru": "Очень сухая почва <w>впитала</w> воду, как только упали первые капли дождя.",
                                "de": "Der sehr trockene Boden hat das Wasser schon bei den ersten Regentropfen <w>aufgesaugt</w>.",
                                "es": "El suelo muy seco ha <w>absorbido</w> el agua en cuanto cayeron las primeras gotas de lluvia.",
                                "zh": "非常干燥的土壤，第一批雨滴刚落下就<w>吸水</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absorber"
                    ],
                    "common_phrases": [
                        "pomper l'humidité"
                    ],
                    "target_lang_definitions": {
