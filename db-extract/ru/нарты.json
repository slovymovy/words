                                        "glosses": [
                                            "voertuig dat op glij-ijzers over sneeuw of ijs wordt voortgetrokken door husky's of vergelijkbare hondenrassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b0749d-1b2d-4709-a81b-4cfdcd7e13dd",
                                                "sense_id": "ab7503ab-48e3-3c74-8d89-cbff67caf5ef",
                                                "text": "Een lang weekend ga ik met mijn zoons van 15 en 16 op huskysafari in Lapland: twee dagen met een hondenslee door de sneeuw."
