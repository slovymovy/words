                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1592d9f-7fdd-4a7c-bc3e-7b84f989ecc0",
                                                "sense_id": "b13d37de-a99e-335d-a8ee-7e7c54f34325",
                                                "text": "Too much of a coward to snuff myself\nGuess I'll just have to suffer myself"
                                            },
                                            {
                                                "example_id": "98f04d22-c714-42ad-9a2f-65d6c12374d1",
                                                "sense_id": "b13d37de-a99e-335d-a8ee-7e7c54f34325",
                                                "text": "A court yesterday rejected a challenge to the constitutionality of prohibiting same-sex marriage, snuffing hopes for marriage equality proponents to shortcut stalled legislative efforts."
