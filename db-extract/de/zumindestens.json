                                        "glosses": [
                                            "duidt een minimale voorwaarde aan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa3a7bb-0131-4216-ba07-19edcd90fe4b",
                                                "sense_id": "02e98e27-6591-38a6-b698-b6145dbee450",
                                                "text": "Als hij tenminste terugkomt."
                                            },
                                            {
                                                "example_id": "435bd0b1-b154-4238-bf0d-29010999daa7",
                                                "sense_id": "02e98e27-6591-38a6-b698-b6145dbee450",
                                                "text": "Isaac wilde De boomgaard per se zien voordat het naar Harolds kantoor in Parijs werd verscheept, want 'dan weet ik tenminste waar ik mijn naam onder zet."
                                            },
                                            {
                                                "example_id": "e2a28e9f-78b0-4a83-9e40-1ea5d757ece6",
                                                "sense_id": "02e98e27-6591-38a6-b698-b6145dbee450",
                                                "text": "Het was vooral een herinnering aan al die dingen waaraan hij vermeed te denken, de laatste jaren tenminste, aan hoe makkelijk het was geweest om van armoede tot rijkdom te komen, al hield hij niet van dat woord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1339fd47-31be-4f90-89d8-61a4e26e5c6d",
                        "source_entry_id": "36a7e924-32da-3aff-9f84-567441683f47",
                        "source_sense_id": "a05d909b-d7b9-3c3e-a90a-641fdfdc1330",
