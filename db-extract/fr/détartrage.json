        "fr-extract.jsonl": [
            {
                "entry_id": "9f50671d-836b-336a-83d5-6416fb94f73e",
                "word": "détartrage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "61c2c65c-89ea-4ce2-9847-38539bf9b1d6",
                        "entry_id": "9f50671d-836b-336a-83d5-6416fb94f73e",
                        "tags": [
                            "plural"
                        ],
                        "form": "détartrages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f32cbc89-21eb-3974-8a88-a5653687ac4c",
                        "entry_id": "9f50671d-836b-336a-83d5-6416fb94f73e",
                        "glosses": [
                            "Action de détartrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf966145-3388-49f7-9949-609967dc8979",
                                "sense_id": "f32cbc89-21eb-3974-8a88-a5653687ac4c",
                                "text": "Coralie ne veut pas entendre parler de détartrage, parce qu’elle craint que cela ne fasse bouger ses dents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b08e89f-c740-4fed-842e-9d69a37f4ff4",
                        "source_entry_id": "9f50671d-836b-336a-83d5-6416fb94f73e",
                        "source_sense_id": "f32cbc89-21eb-3974-8a88-a5653687ac4c",
                        "target_lang_word": "Zahnreinigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnreinigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb01f540-e1d6-34f0-ae9e-d140b5d7ca99",
                                        "entry_id": "7aa64d9c-6de4-3af5-bf74-ee47ee251657",
                                        "glosses": [
                                            "Maßnahme, bei der man (meist täglich mehrmals) sein Gebiss reinigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed296f78-193b-4e06-8956-97c032f03041",
                                                "sense_id": "fb01f540-e1d6-34f0-ae9e-d140b5d7ca99",
                                                "text": "„Sie brummen, rotieren und vibrieren und sorgen für eine bequeme und einfache Zahnreinigung: Elektrische Zahnbürsten gehören heute bei vielen zur Badezimmerausstattung.“"
                                            },
                                            {
                                                "example_id": "c6d682fa-620a-469b-b5b6-5840c2082858",
                                                "sense_id": "fb01f540-e1d6-34f0-ae9e-d140b5d7ca99",
                                                "text": "„Zahnbelag (Plaque) entsteht bei ungenügender Zahnreinigung innerhalb weniger Tage.“"
                                            },
                                            {
                                                "example_id": "70e51047-c216-48fb-b5ca-73fb1527a775",
                                                "sense_id": "fb01f540-e1d6-34f0-ae9e-d140b5d7ca99",
                                                "text": "„Theoretisch wäre eine einmalige Zahnreinigung pro Tag ausreichend. Wenn man damit jede Verunreinigung komplett entfernen könnte. Das ist aber nicht zu schaffen. Deshalb muss die Zahnbürste öfter zum Einsatz kommen.“"
                                            },
                                            {
                                                "example_id": "a308c693-dc47-4ba6-862c-285236dae3f1",
                                                "sense_id": "fb01f540-e1d6-34f0-ae9e-d140b5d7ca99",
                                                "text": "„Zwei ältere Damen beschenken Singh […] mit Zweigen, die zur Zahnreinigung genutzt werden können. Sie stellen eine saubere, natürliche Alternative zu einem der Hauptverursacher des indischen Plastikproblems dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                        "entry_id": "7aa64d9c-6de4-3af5-bf74-ee47ee251657",
                                        "glosses": [
                                            "Maßnahme, bei der ein Zahnarzthelfer / eine Zahnarzthelferin das Gebiss eines Kunden professionell reinigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa5ab23-8952-426f-8974-774510e68ee8",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "„[…] auch wer noch so gut putzt und mit Zahnseide vorarbeitet, sollte sich einer professionellen Zahnreinigung unterziehen.“"
                                            },
                                            {
                                                "example_id": "8d9aa994-132c-42bf-861a-dcd821700724",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "„Keine Putztechnik erspart die professionelle Zahnreinigung, die heute nicht mehr nur den Zahnstein entfernt, sondern auch Bakterienbeläge und damit zugleich Mundgeruch.“"
                                            },
                                            {
                                                "example_id": "f27e925b-dd76-426d-9757-946325792a32",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "„Zahnärzte raten dazu, ein- bis zweimal im Jahr eine professionelle Zahnreinigung durchführen zu lassen.“"
                                            },
                                            {
                                                "example_id": "6dfe3174-4266-42f7-a34f-42b19d905a1e",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "Die Zahnreinigung durch eine Zahnarzthelferin, die sich auf die Reinigung spezialisiert hat, kostet in Deutschland in 2019 ungefähr 80 Euro."
                                            },
                                            {
                                                "example_id": "2922f283-bb0d-4391-97c4-7cc066d36578",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "Die Kosten für eine Zahnreinigung wird in Deutschland für Kinder unter 14 Jahren von der Krankenkasse bezahlt."
                                            },
                                            {
                                                "example_id": "80d91504-80a3-4594-a8a0-e096b01902aa",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "„Die Deutschen putzen fleißiger, viele gehen artig zur professionellen Zahnreinigung.“"
                                            },
                                            {
                                                "example_id": "2812c828-1ade-4de4-81ed-dc59b757f63e",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "„[…] ein wenig später versuchte ich bei meinem neuen Zahnarzt einen Prophylaxe-Termin zu bekommen, zur professionellen Zahnreinigung. »Noch in diesem Jahr?« fragte die Assistentin am Telefon, »Wird schwierig.«“"
                                            },
                                            {
                                                "example_id": "6bb0ef12-e0e2-4508-9586-2aef4855a93c",
                                                "sense_id": "06cf1912-8c95-3a53-a42c-a86513980f78",
                                                "text": "„Bevor überhaupt ein Bleichen der Zähne in Angriff genommen wird, sollte sichergestellt werden, dass auf den Zähnen keine oberflächlichen Verfärbungen, Zahnstein und Plaque vorhanden sind. Dazu verhilft eine Zahnreinigung bei einer Dentalhygienikerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
