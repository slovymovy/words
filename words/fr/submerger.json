                            },
                            {
                                "target_lang_word": "inundar",
                                "target_lang_sense_clarification": "terrenos y zonas costeras"
                            },
                            {
                                "target_lang_word": "anegar",
                                "target_lang_sense_clarification": "tierras, calles o casas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淹没",
                                "target_lang_sense_clarification": "海浪、洪水覆盖陆地"
                            },
                            {
                                "target_lang_word": "浸没",
                                "target_lang_sense_clarification": "液体完全盖住物体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0a6467f-6a17-32c1-8d09-3756612259ff",
                    "sense_definition": "Déborder ou accabler quelqu'un sous une accumulation de tâches, de travail ou de demandes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche des fêtes, le service client est complètement <w>submergé</w> d'appels et de courriels.",
                            "target_lang_translations": {
                                "en": "As the holidays approach, the customer service department is completely <w>overwhelmed</w> with calls and emails.",
                                "ru": "В преддверии праздников отдел обслуживания клиентов полностью <w>завален</w> звонками и электронными письмами.",
                                "de": "Kurz vor den Feiertagen ist der Kundenservice mit Anrufen und E-Mails völlig <w>überschwemmt</w>.",
                                "es": "Con la llegada de las fiestas, el servicio de atención al cliente está completamente <w>abrumado</w> por las llamadas y los correos electrónicos.",
                                "zh": "临近节假日，客服部门被大量来电和邮件<w>淹没</w>了。"
                            }
                        },
                        {
                            "text": "Je ne pourrai pas venir ce soir car je suis <w>submergé</w> de travail au bureau.",
                            "target_lang_translations": {
                                "en": "I won't be able to come tonight because I'm <w>swamped</w> with work at the office.",
                                "ru": "Сегодня вечером не смогу прийти: в офисе я по уши <w>завален</w> работой.",
                                "de": "Ich kann heute Abend nicht kommen, weil ich im Büro mit Arbeit <w>überhäuft</w> bin.",
                                "es": "No podré venir esta noche porque estoy <w>agobiado</w> de trabajo en la oficina.",
                                "zh": "今晚我去不了了，因为在办公室里被工作<w>淹没</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accabler"
                    ],
                    "common_phrases": [
                        "submergé de travail",
                        "être submergé d'appels"
                    ],
                    "target_lang_definitions": {
                        "en": "To overwhelm someone with a build-up of tasks, work or requests.",
                        "ru": "Перегрузить кого-либо большим количеством дел, работы или просьб.",
                        "de": "Jemanden durch eine Menge an Aufgaben, Arbeit oder Anfragen stark belasten.",
                        "es": "Agobiar a alguien con una acumulación de tareas, trabajo o peticiones.",
                        "zh": "以大量工作、任务或请求使某人负担过重，难以应付。"
                    },
                    "translations": {
