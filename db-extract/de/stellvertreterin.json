                        ],
                        "form": "die Stellvertreterin"
                    },
                    {
                        "form_id": "0f105a1a-f107-418e-8ea6-57ca6773ec43",
                        "entry_id": "6e96d6ba-aeaa-3cc4-b7e7-20001221cbfb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Stellvertreterinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7dd1e1c9-9058-3a73-820f-932d5369a626",
                        "entry_id": "6e96d6ba-aeaa-3cc4-b7e7-20001221cbfb",
                        "glosses": [
                            "(weibliche) Person, die jemanden (meist für kurze Zeit) ersetzen und dessen Rolle übernehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d210e73-e49a-41f9-ae1a-9de4477617b3",
                                "sense_id": "7dd1e1c9-9058-3a73-820f-932d5369a626",
                                "text": "„Im Amt bestätigt wurde Forschungsministerin Annette Schavan, die als einzige Stellvertreterin Merkels erneut kandidierte.“"
                            },
                            {
                                "example_id": "ce5277c1-99a7-40b5-928c-819f0e05c735",
                                "sense_id": "7dd1e1c9-9058-3a73-820f-932d5369a626",
                                "text": "„Da ihre Stellvertreterin wegen Krankheit in dem schwierigen Schuljahr ausfiel, mußte sie zeitweilig alle anstehenden Aufgaben allein bewältigen.“"
                            },
                            {
                                "example_id": "e93d3b60-2d04-4466-9c98-b82d799ee199",
                                "sense_id": "7dd1e1c9-9058-3a73-820f-932d5369a626",
                                "text": "„Die Frauenbeauftragte und ihre Stellvertreterin werden in geheimer und unmittelbarer Wahl in getrennten Wahlgängen nach den Grundsätzen der Mehrheitswahl gewählt.“"
                            },
                            {
                                "example_id": "92d4793c-8e18-4e7a-91b9-76fe75539263",
                                "sense_id": "7dd1e1c9-9058-3a73-820f-932d5369a626",
                                "text": "„Im Januar 1932 wählte die Abteilung Heinrich Mann, den Großschriftsteller der bürgerlichen Linken, zum Vorsitzenden und die geschätzte Dichterin, Historikerin und Philosophin Ricarda Huch zu seiner Stellvertreterin, obgleich sie mit ihm inhaltlich und persönlich wenig gemein hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
