                                "example_id": "e6b9e6ac-426d-4c68-b6c7-60a1e8af29d7",
                                "sense_id": "87f62eb9-0615-3148-acc7-1958fa72225f",
                                "text": "Sophia, who had tottered along with much difficulty, sunk down in her chair; but by the assistance of hartshorn and water, she was prevented from fainting away..."
                            },
                            {
                                "example_id": "8e38bade-63e7-454e-90d1-3f2fb3d20620",
                                "sense_id": "87f62eb9-0615-3148-acc7-1958fa72225f",
                                "text": "Lady Teazle seeing Sir Peter in such Danger—ran out of the Room in strong Hysterics—and Charles after her calling out for Hartshorn and Water!"
                            }
                        ]
                    }
                ],
