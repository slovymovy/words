                                            {
                                                "example_id": "159383a2-e57b-4eb8-b2e0-dbf5d4134dde",
                                                "sense_id": "a937080f-3e8f-3b0c-92b3-f2c43a418932",
                                                "text": "„Die erste Verlegung des Schiffes, das im Pazifik stationiert wurde, fand 1963 statt.“"
                                            },
                                            {
                                                "example_id": "53fac064-05db-412b-85f9-9b09dc5b4243",
                                                "sense_id": "a937080f-3e8f-3b0c-92b3-f2c43a418932",
                                                "text": "„Die Verlegung des Botschaftssitzes von Tel Aviv nach Jerusalem beruht auf dem 1995 vom Kongress der Vereinigten Staaten verabschiedeten Jerusalem Embassy Act,...“"
                                            },
                                            {
                                                "example_id": "a69e5bec-a8ac-4aad-a77d-be3c6b2e2ca0",
                                                "sense_id": "a937080f-3e8f-3b0c-92b3-f2c43a418932",
                                                "text": "„Nach dem Einsatzbefehl des Flottenkommandos vom 9. März begann am 11. März die Verlegung der Boote in zwei Gruppen von Kreta nach Manama, wo sie am 4. und 19. April eintrafen.“"
                                            }
