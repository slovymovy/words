                                "example_id": "97819ebb-6b7a-465a-a128-7131796050f3",
                                "sense_id": "b9e6392c-1a9b-333b-a0b1-62044978dbb8",
                                "text": "Ce petit bijou est une magnifique petite guêpe. … C'est une Chryside."
                            },
                            {
