                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "document",
                                "target_lang_sense_clarification": "écrit officiel servant de preuve ou d'information"
                            },
                            {
                                "target_lang_word": "pièce",
                                "target_lang_sense_clarification": "acte officiel, document juridique ou administratif"
                            }
                        ]
