                "senses": [
                    {
                        "sense_id": "1e62c057-22f0-3592-beb9-5c08c9721214",
                        "entry_id": "eb6ba7b3-7082-3fc0-bfec-1a8df3e8d7b2",
                        "glosses": [
                            "Diagnostiquer moins souvent que ce qu’il faudrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73162d50-2afb-44ab-91ac-067dd49e1156",
                                "sense_id": "1e62c057-22f0-3592-beb9-5c08c9721214",
                                "text": "D'après les résultats de certaines études, le syndrome est sous-diagnostiqué dans la pratique médicale générale."
                            },
                            {
                                "example_id": "79628f99-5afa-4f4d-a670-aa0a7d6e0f3f",
                                "sense_id": "1e62c057-22f0-3592-beb9-5c08c9721214",
                                "text": "Qui plus est, la dépression est le trouble le plus sous-diagnostiqué dans la démence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebe64615-48bd-4a3e-93d8-2058a8d1ccb7",
                        "source_entry_id": "eb6ba7b3-7082-3fc0-bfec-1a8df3e8d7b2",
                        "source_sense_id": "1e62c057-22f0-3592-beb9-5c08c9721214",
                        "target_lang_word": "underdiagnose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underdiagnose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7c51a09-a915-393e-a23e-8e1471571d28",
                                        "entry_id": "df5d9ebd-3025-391b-891d-38c91e422463",
                                        "glosses": [
                                            "To diagnose something less often than it actually occurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a6d06bd-1f37-4a23-a2ad-89f8f503e071",
                                                "sense_id": "d7c51a09-a915-393e-a23e-8e1471571d28",
                                                "text": "Meanwhile, literature supports the possibility of underdiagnosing AC in the hospital setting; exponentially so when males generally have poor hospital-attending behavior."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
