                "senses": [
                    {
                        "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                        "entry_id": "446547fa-5150-3ae2-86f4-960b96d52e3e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b95c1d-1bfe-4f08-b392-7ba95d689ae1",
                                "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                                "text": "Frau Schmückle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a0774bf0-d2e2-42c7-8952-4b8bf897d2a9",
                                "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                                "text": "Herr Schmückle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "169afab8-620e-4cab-9d3c-1a3bdcc64151",
                                "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                                "text": "Die Schmückles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "0d55b5b1-8541-4543-9e87-5881203b77a8",
                                "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                                "text": "Der Schmückle trägt nie die Pullover, die die Schmückle ihm strickt."
                            },
                            {
                                "example_id": "b1f9d091-bd29-422d-b4c5-b49ebb3f9639",
                                "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmückle kommt, geht der Herr Schmückle.“"
                            },
                            {
                                "example_id": "fb8a47b3-ba19-4df7-b36a-21c387a83e72",
                                "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                                "text": "Schmückle kommt und geht."
                            },
                            {
                                "example_id": "343dfc1a-8cd3-43de-a0af-38005f802bff",
                                "sense_id": "2fd76bd6-0e60-3f38-93ba-0f1b92997980",
                                "text": "Schmückles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
