                ],
                "senses": [
                    {
                        "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                        "entry_id": "121a2c7c-64b3-38d4-9fd6-fa31444e8b3a",
                        "glosses": [
                            "slawischsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6d267c-5980-4fcc-a42a-939291cea027",
                                "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                                "text": "Frau Konopka ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0ba56038-6ef2-4d52-8604-d77d90e25f86",
                                "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                                "text": "Herr Konopka wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3e83d37f-0a4b-400e-ad63-b7d9672b0a3b",
                                "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                                "text": "Die Konopkas fahren heute nach Berlin."
                            },
                            {
                                "example_id": "6bfb119f-85f1-44e7-a745-f0ee68748671",
                                "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                                "text": "Der Konopka trägt nie die Schals, die die Konopka ihm strickt."
                            },
                            {
                                "example_id": "86966607-0345-48da-807d-169b90112056",
                                "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Konopka kommt, geht der Herr Konopka.“"
                            },
                            {
                                "example_id": "736af217-89d1-4558-b408-c5886e3e6065",
                                "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                                "text": "Konopka kommt und geht."
                            },
                            {
                                "example_id": "64bd1520-6814-428f-8d8b-588e1c3f3a1a",
                                "sense_id": "74cf4871-304f-33fc-bf26-a92cda440cc2",
                                "text": "Konopkas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
