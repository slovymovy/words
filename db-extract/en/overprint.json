                ],
                "senses": [
                    {
                        "sense_id": "5cf45763-2534-389d-9d63-e86725e554f5",
                        "entry_id": "d5a95b89-1488-3f4d-9338-f9bba4d8457a",
                        "glosses": [
                            "To print over what has already been printed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01f8d92-3e16-47c2-af2c-fd69503a4218",
                                "sense_id": "5cf45763-2534-389d-9d63-e86725e554f5",
                                "text": "This is the way overprinting works on the ZX Spectrum: two papers or two inks give a paper, one of each gives an ink. This has the interesting property that if you overprint with the same thing twice you get back what you started off with."
                            }
                        ]
                    },
                    {
                        "sense_id": "aab3fa07-603e-3428-afdc-60a321284ce3",
                        "entry_id": "d5a95b89-1488-3f4d-9338-f9bba4d8457a",
                        "glosses": [
                            "To add an overprint to (a stamp)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "110b3280-80df-3f7a-b989-e19ea00d85f2",
                        "entry_id": "d5a95b89-1488-3f4d-9338-f9bba4d8457a",
                        "glosses": [
                            "To print too many copies of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "058ed3d8-f4ca-4598-bc56-cc3a1628f9e7",
                                "sense_id": "110b3280-80df-3f7a-b989-e19ea00d85f2",
                                "text": "The unpopular comic book was overprinted, leaving many retailers with dozens of unsaleable copies."
                            }
                        ]
                    },
                    {
                        "sense_id": "19502109-7efb-3088-be6e-0de2fd584028",
                        "entry_id": "d5a95b89-1488-3f4d-9338-f9bba4d8457a",
                        "glosses": [
                            "To overlap different colours to avoid gaps."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10c06293-a386-33d9-8fe9-8e99ac2b8fca",
                        "entry_id": "d5a95b89-1488-3f4d-9338-f9bba4d8457a",
                        "glosses": [
                            "To superimpose a new set of petrological, structural, and/or mineralogical characteristics onto rock by the action of geological processes over deep time, by analogy with the original sense of the word."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "504032d8-9387-4366-bae2-37a7e496173a",
                                "sense_id": "10c06293-a386-33d9-8fe9-8e99ac2b8fca",
                                "text": "Furthermore, these rocks are overprinted by seafloor weathering, which provides a challenge to reconstructing serpentinization processes."
                            },
                            {
                                "example_id": "85c806d4-cd19-42a8-b9c3-ba81b4cd7d6b",
                                "sense_id": "10c06293-a386-33d9-8fe9-8e99ac2b8fca",
                                "text": "Dominantly dextral shearing in the Chester zone occurred during post-Acadian plate adjustments around ca. 380 Ma (Ghanem et al. 2016), coeval with initial activity along the Norumbega fault system to the southeast and the shear fabrics overprint rocks on both upper and lower plates of the original thrust."
                            },
                            {
                                "example_id": "4420f8b4-c2fc-4dc1-834e-38e53570fdb1",
                                "sense_id": "10c06293-a386-33d9-8fe9-8e99ac2b8fca",
                                "text": "Although deformation overprints volcanic construction, several structural patterns are considered to be inherited from the pre-existing volcanic architecture."
                            }
                        ]
                    }
                ],
