                                        "sense_id": "5bf707e6-37b2-376a-b9e9-2737cddb529e",
                                        "entry_id": "8ae25163-2aa8-37a2-bc0a-e4d757c9d82b",
                                        "glosses": [
                                            "The number of dead as a result of a war, natural disaster or other incident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2fd730-4cff-4a39-8cb2-b2c722d39f09",
                                                "sense_id": "5bf707e6-37b2-376a-b9e9-2737cddb529e",
                                                "text": "Food, clothing, bedding, and fire, were supplied in sufficient proportions to maintain life and health; and the three years of severe suffering passed over the cotton districts without any sensible increase of disease, and without increasing the frequency of the death toll."
                                            },
                                            {
                                                "example_id": "e47fc1c9-10ff-49cc-8f58-0a1fd42438c7",
                                                "sense_id": "5bf707e6-37b2-376a-b9e9-2737cddb529e",
                                                "text": "Fascinated by the fact that the death toll of this singular storm was the fifth highest on record as regards overall effects/death tolls for a natural disaster in the United States in the 20th century […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
