                },
                {
                    "sense_id": "01ed3315-cf24-327a-962d-7a58d9d3d85e",
                    "sense_definition": "A mowing of a crop, or the amount of crop gathered from mowing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers gathered the second <w>math</w> of hay before the rain started.",
                            "target_lang_translations": {
                                "ru": "Фермеры собрали второй <w>укос</w> сена, прежде чем начался дождь.",
                                "zh": "雨开始下之前，农民们完成了第二茬干草的<w>收割</w>。"
                            }
                        },
                        {
                            "text": "An early <w>math</w> ensures the best quality for the livestock.",
                            "target_lang_translations": {
                                "ru": "Ранний <w>покос</w> обеспечивает лучшее качество корма для скота.",
                                "zh": "尽早<w>收割</w>能确保牲畜饲料的最佳质量。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скашивание урожая или количество скошенного урожая.",
                        "zh": "指收割庄稼或牧草，或指一次收割的产量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укос",
                                "target_lang_sense_clarification": "количество скошенной травы"
                            },
                            {
                                "target_lang_word": "покос",
                                "target_lang_sense_clarification": "процесс косьбы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收割",
