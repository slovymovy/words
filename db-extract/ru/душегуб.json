                                        "sense_id": "37fdc09b-cd71-3dbc-8e90-94b6670fc492",
                                        "entry_id": "f1663c8a-ad02-3ea1-a831-0f10be95ac6e",
                                        "glosses": [
                                            "To assassinate."
                                        ],
