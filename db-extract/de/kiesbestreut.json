                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfb32079-cc21-39de-845d-d84a6feab650",
                        "entry_id": "f58355bf-c5bd-3a6a-a8f7-03b9c6176661",
                        "glosses": [
                            "mit Kies bestreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "352aab3f-ee9c-4764-858a-773cdc503332",
                                "sense_id": "dfb32079-cc21-39de-845d-d84a6feab650",
                                "text": "„Ein starker Duft nach Kiefern und Mimosen erfüllte die Luft, und die frisch gesprengten Anlagen des gegenüberliegenden Kasinos mit den kiesbestreuten Wegen und Terrassen verliehen dem Bild eine gewisse Atmosphäre, die eher zu einem Ballett als zu einem Melodrama gepasst hätte.“"
                            },
                            {
                                "example_id": "198e7b70-6300-43e8-8419-dc67ec7923b1",
                                "sense_id": "dfb32079-cc21-39de-845d-d84a6feab650",
                                "text": "„Das Haus war hoch und stattlich, mit weißen dorischen Säulen entlang der Vorderfront. An der Seite eine Wagenauffahrt. Eine kiesbestreute Zufahrt, die durch eine Wiese von totem Gras im Bogen vor das Haus führte.“"
                            },
                            {
                                "example_id": "71547bbb-2304-4147-81ec-e521cbd38c55",
                                "sense_id": "dfb32079-cc21-39de-845d-d84a6feab650",
                                "text": "„Was auch immer, Brown und Worden halten es für undenkbar, dass sie aus freiem Willen aus dem Auto stieg und mit nur einem Schuh den kiesbestreuten Parkplatz überquerte.“"
                            }
                        ],
