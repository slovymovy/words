                        {
                            "text": "An old <w>frail</w> hung on the barn wall as a relic of past farming methods.",
                            "target_lang_translations": {
                                "ru": "Старый <w>цеп</w> висел на стене амбара как реликвия прошлых методов ведения хозяйства."
                            }
                        }
                    ],
                    "synonyms": [
                        "flail"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional variant of flail"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельскохозяйственное орудие для обмолота зерна; цеп."
