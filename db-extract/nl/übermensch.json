                        "sense_id": "db3b89ee-1d62-39c7-92f1-45f9dd91a70d",
                        "entry_id": "7dc40a13-a2f1-3785-8f4d-47fb851a3ae2",
                        "glosses": [
                            "persoon met aangeboren eigenschappen die die van een gewoon mens te boven gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb196f5-0471-4d8f-af65-36bd6a1f2b13",
                                "sense_id": "db3b89ee-1d62-39c7-92f1-45f9dd91a70d",
                                "text": "Hitler wilde een ras van übermenschen scheppen."
                            },
                            {
                                "example_id": "0638962d-8e55-4dc5-8dd6-2499c7bb4276",
                                "sense_id": "db3b89ee-1d62-39c7-92f1-45f9dd91a70d",
                                "text": "Twee nachten de bak indraaien om daarna te begrijpen wat een meesterlijk leven je hebt! Dat je niet alleen een auto, een huis, een jacht en een parlementszetel kunt kopen, maar ook een mensenleven... Misschien niet God zelf zijn, maar wel een godje, een übermensch! Ja. Allemaal in de Sovjet-Unie geboren, allemaal nog van toen. Met dezelfde ziekte. Die wereld was zo naïef, ze hoopten een gelukkig mens te maken. Ze beloofden 'de mensheid met ijzeren hand naar het geluk te drijven'. Naar het aards paradijs."
                            }
                        ]
                    }
