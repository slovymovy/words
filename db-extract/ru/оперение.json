                                "target_senses": [
                                    {
                                        "sense_id": "fc98abd6-6a54-36cb-989e-f8bd69f6e845",
                                        "entry_id": "f26db4ef-ccf1-302d-be71-bc395f61298d",
                                        "glosses": [
                                            "Layer or collection of feathers covering a bird’s body; feathers used ornamentally; feathering."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "noun",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a96fa68b-b3c9-41ae-983d-5f10b120d2ca",
                                                "sense_id": "fc98abd6-6a54-36cb-989e-f8bd69f6e845",
                                                "text": "Somewhat like a heron she was, but stouter, and shorter of leg, and her beak shorter and thicker than the heron’s; and so long and delicate was her pale gray plumage that hard it was to say whether it were hair or feathers."
                                            },
                                            {
                                                "example_id": "f8eae1ea-6cd5-4a7b-a4c3-ae5d83e8ade5",
                                                "sense_id": "fc98abd6-6a54-36cb-989e-f8bd69f6e845",
                                                "text": "[Owner]: No no he's not dead, he's, he's restin'! Remarkable bird, the Norwegian Blue, idn'it, ay? Beautiful plumage!\n[Mr. Praline]: The plumage don't enter into it. It's stone dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510b4cbc-d2b6-3147-bfc6-8aec7a4ec0f3",
                                        "entry_id": "f26db4ef-ccf1-302d-be71-bc395f61298d",
                                        "glosses": [
                                            "Finery or elaborate dress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "125af77a-c11a-4903-8f48-52db91744be4",
                        "source_entry_id": "970354eb-a14b-34f4-b3e6-530cd57c0624",
                        "target_lang_word": "Gefieder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefieder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75d24e17-462a-3de5-88c1-0dd8bd079c10",
                                        "entry_id": "58f1e7f8-aa73-3ac7-9afa-66d76b9cdf12",
                                        "glosses": [
                                            "Gesamtheit der Federn, welche die Haut eines Vogels bedecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf6b3ee-bc9a-46eb-952e-bcbbb5fcbf8d",
                                                "sense_id": "75d24e17-462a-3de5-88c1-0dd8bd079c10",
                                                "text": "Der Pfauenhahn trägt ein besonders prächtiges Gefieder."
                                            },
                                            {
                                                "example_id": "7bb60369-b171-4b01-ab3e-3f736a7962a0",
                                                "sense_id": "75d24e17-462a-3de5-88c1-0dd8bd079c10",
                                                "text": "„Ein paar Hühner mit verdrecktem Gefieder stolzierten vorbei.“"
                                            },
                                            {
                                                "example_id": "978b4f8c-b57d-4aa6-9c42-24b38b78f57d",
                                                "sense_id": "75d24e17-462a-3de5-88c1-0dd8bd079c10",
                                                "text": "„Das Gefieder der Unterseite des Waldkauzes war rauchgelb, mit dunklen Streifen darin; sie hätte es gern berührt, aber sie wagte es nicht, dieser Vogel war kein Tier, das sich streicheln ließ, außer nach langer Gewöhnung.“"
                                            },
                                            {
                                                "example_id": "45f6a409-c092-4e30-9685-28bc30fad202",
                                                "sense_id": "75d24e17-462a-3de5-88c1-0dd8bd079c10",
                                                "text": "„Es war ein älteres Exemplar, das hatte Walter am Gefieder erkannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
