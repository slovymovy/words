                                "example_id": "8c4a8d6a-4c45-4107-a34f-f1f929792f39",
                                "sense_id": "119d1970-32f7-3881-aa42-e3406d547e4f",
                                "text": "Les nickélines blanches servent aux mêmes usages que le kupfernickel ou nickéline rouge."
                            }
                        ]
                    }
