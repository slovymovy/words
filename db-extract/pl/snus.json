                "senses": [
                    {
                        "sense_id": "c65f957a-f980-3dd1-b05c-b8a4af06d956",
                        "entry_id": "3612362b-9055-3bca-a014-b5e46de748b3",
                        "glosses": [
                            "używka na bazie tytoniu, zażywana doustnie przez umieszczenie jej pod dolną lub górną wargą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f5eb041-9caa-48d3-8488-671e784288ca",
                                "sense_id": "c65f957a-f980-3dd1-b05c-b8a4af06d956",
                                "text": "Są tu ludzie, którzy biorą/brali najmocniejsze snusy rzędu 50 mg itd.?"
                            },
                            {
                                "example_id": "946a4a5c-a152-4b57-8464-cf40311c3881",
                                "sense_id": "c65f957a-f980-3dd1-b05c-b8a4af06d956",
                                "text": "Sięgnięcie po snusa nie powinno mu (…) zaszkodzić, choć nie mogę wykluczyć, że dla części wyborców będzie to miało jednak spore znaczenie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
