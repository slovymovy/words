                                "example_id": "a16a8364-7eb9-4613-985e-bd526f588e13",
                                "sense_id": "ace6e4bf-086b-3cd0-bbf6-8cf8d2622e84",
                                "text": "L’hypsodontie est caractéristique d’une alimentation fibreuse."
                            },
                            {
                                "example_id": "a1dbe1c6-da29-45d5-84ea-d749c6143dcb",
                                "sense_id": "ace6e4bf-086b-3cd0-bbf6-8cf8d2622e84",
                                "text": "Les auteurs intègrent le taux d’hypsodontie (hauteur de la couronne) des molaires et la méso-usure dentaire de ces mêmes dents (par l’analyse des méso-usures dentaires), témoins du caractère abrasif du bol alimentaire."
                            }
                        ]
                    }
