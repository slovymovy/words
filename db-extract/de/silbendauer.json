                "senses": [
                    {
                        "sense_id": "c03937c5-67fa-30d3-b487-046f4dc90b3c",
                        "entry_id": "37b1d416-db7c-3c9d-8517-7d4697c0897d",
                        "glosses": [
                            "Linguistik, speziell Phonetik: Dauer (zeitliche Länge) einer Silbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3bf1a4-7b88-42a3-9f8c-6f7233af202d",
                                "sense_id": "c03937c5-67fa-30d3-b487-046f4dc90b3c",
                                "text": "„Silben- und Lautdauer werden in Millisekunden gemessen.“"
                            },
                            {
                                "example_id": "03751267-5529-4f10-b875-34f4972326a3",
                                "sense_id": "c03937c5-67fa-30d3-b487-046f4dc90b3c",
                                "text": "„Vor Allem aber regelt sich die Silbendauer zu einem grossen Theile nach der Silbenzahl der Sprechtakte, denen die betreffenden Silben angehören…“"
                            },
                            {
                                "example_id": "2c3b4536-17c2-4943-91b8-354bb7f254ce",
                                "sense_id": "c03937c5-67fa-30d3-b487-046f4dc90b3c",
                                "text": "Die Silbendauer spielt in der Quantitativen Linguistik eine große Rolle."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "58086f0f-8003-3ad1-a666-0af71ad96bc9",
                        "entry_id": "37b1d416-db7c-3c9d-8517-7d4697c0897d",
                        "glosses": [
                            "durch die Zahl der Moren bestimmte Quantität der Silbe"
                        ],
                        "tags": [
                            "Metrik"
                        ],
                        "examples": [
                            {
                                "example_id": "9ae469aa-bb8e-4f5c-801a-b36fdf6c0c3b",
                                "sense_id": "58086f0f-8003-3ad1-a666-0af71ad96bc9",
                                "text": "„Quantität (…), Silbendauer, das heißt Aussprachedauer einer sprachlichen Einheit, nicht nur des Vokals.“."
                            },
                            {
                                "example_id": "bf77a149-9d97-4c81-9610-7d4f2b3b8685",
                                "sense_id": "58086f0f-8003-3ad1-a666-0af71ad96bc9",
                                "text": "Glück definiert More wie folgt: „In der klassischen Metrik kleinste Zeiteinheit im Verstakt beziehungsweise unterschiedlich anhand des Silbenreims definiertes Maß für die Silbendauer...“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
