                    {
                        "sense_id": "e613be27-ced8-3b83-a5cc-57bca51ec01a",
                        "entry_id": "b9a6ff89-f859-3bd2-a950-268d097c5faa",
                        "glosses": [
                            "Geldsendung per Post an einen bestimmten Empfänger"
                        ],
                        "tags": [
                            "Post"
                        ],
                        "examples": [
                            {
                                "example_id": "689f2c44-d14b-44d9-a01d-945dee98aeb5",
                                "sense_id": "e613be27-ced8-3b83-a5cc-57bca51ec01a",
                                "text": "„Am 23. Dezember aus der Legion offiziell ausgeschieden, tritt er sogleich mit dem per Postanweisung erhaltenen Geld die Heimreise an.“"
                            },
                            {
                                "example_id": "7755919c-9578-42ae-a9e0-7e020a5d4dd4",
                                "sense_id": "e613be27-ced8-3b83-a5cc-57bca51ec01a",
                                "text": "„Bei den Stempeln handelte es sich um Einkreis-, Zweikreis- oder Maschinenstempel für Briefe, um Rollen- oder große Gummistempel für Pakete bzw. um Gummihandstempel für Einschreibsendungen oder Postanweisungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
