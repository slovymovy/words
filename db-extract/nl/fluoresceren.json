                "senses": [
                    {
                        "sense_id": "c2513192-968f-3454-a42c-83b8f73608f7",
                        "entry_id": "a200ee4b-1256-3f11-9ed2-e25594d753fb",
                        "glosses": [
                            "van een stof na beschenen te zijn met electromagnetische straling van een hogere frequentie later licht uitzenden met een eigen en lagere frequentie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f7d34e-bba7-4f32-b9cf-bf21fc522dcb",
                                "sense_id": "c2513192-968f-3454-a42c-83b8f73608f7",
                                "text": "De onderzoekers slaagden erin de machines te leren om woorden met de ‘vreemde’ letters te beschouwen als een instructie om een ‘onnatuurlijk’ aminozuur in het eiwit in te bouwen. Dat lukt bovendien even goed als met de ‘klassieke’ aminozuren. Hun eerste resultaat is een ‘onnatuurlijke’, fluorescerend groene kleurstof."
                            },
                            {
                                "example_id": "e32502d5-3eb6-4573-8adc-c4735054e26d",
                                "sense_id": "c2513192-968f-3454-a42c-83b8f73608f7",
                                "text": "De Wageningers maakten hun bacteriën lichtgevend door een kwallengen in te brengen waardoor ze groen kunnen fluoresceren. Ze kregen hen aan het knipperen door een genetisch feedback-circuitje in te bouwen waardoor de cellen bij een bepaalde concentratie van een signaalstof oplichten, waarna een andere stof ontstaat waardoor ze weer uitdoven."
                            }
                        ]
                    }
                ],
