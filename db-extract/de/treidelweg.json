                                        "sense_id": "080bd82b-24e7-36c5-a018-b59f84559918",
                                        "entry_id": "5f7ddbec-e5ca-3bef-bf35-87ca8fd91d72",
                                        "glosses": [
                                            "A path alongside a canal or river, originally for horses towing barges, now more often used as a footpath."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dde9572-318e-4c8e-b0e8-e857bead8e43",
                                                "sense_id": "080bd82b-24e7-36c5-a018-b59f84559918",
                                                "text": "From the 1960s, various local authorities became increasingly involved in improving the neglected waterway, and towpaths were progressively reopened as footpaths."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
