                                    },
                                    {
                                        "sense_id": "137a9c9e-95de-37c5-836b-57f8a130cf04",
                                        "entry_id": "f579f31b-a08e-3210-b1bb-c33220bce9bc",
                                        "glosses": [
                                            "A small opening; a small pit or depression, especially in bone.",
                                            "A space visible between cells, allowing free passage of light."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22a5fdcf-94f6-319d-b5a7-603a612eaa57",
                                        "entry_id": "f579f31b-a08e-3210-b1bb-c33220bce9bc",
                                        "glosses": [
                                            "A small blank space; a gap or vacancy; a hiatus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf9e6f3e-55ac-48e4-b344-1ddc9015f4ca",
                                                "sense_id": "22a5fdcf-94f6-319d-b5a7-603a612eaa57",
                                                "text": "\"Our young friend makes up for many obvious mental lacunæ by some measure of primitive common sense,\" remarked Challenger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77fde6cf-4add-3c70-8d9a-88923671f529",
                                        "entry_id": "f579f31b-a08e-3210-b1bb-c33220bce9bc",
                                        "glosses": [
                                            "A small blank space; a gap or vacancy; a hiatus.",
                                            "An absent part, especially in a book or other piece of writing, often referring to an ancient manuscript or similar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53027f7a-3aa8-49b0-b74b-c3d55a9860e3",
                                                "sense_id": "77fde6cf-4add-3c70-8d9a-88923671f529",
                                                "text": "Long lacunae in this inscription make interpretation difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "679dc911-0b70-3826-9c44-d6099e4e7d9d",
                                        "entry_id": "f579f31b-a08e-3210-b1bb-c33220bce9bc",
                                        "glosses": [
                                            "A small blank space; a gap or vacancy; a hiatus.",
                                            "Any gap, break, hole, or lack in a set of things; something missing."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afd06aff-8233-4404-904f-3eb414aa554d",
                                                "sense_id": "679dc911-0b70-3826-9c44-d6099e4e7d9d",
                                                "text": "For Beatrice Nutter, there will always be conspicuous lacunae in our mutual understanding, but after almost 30 years here, the anomalies now delight rather than confound her."
                                            },
                                            {
                                                "example_id": "8bc0ee1f-f536-4c3f-9109-5aeddd5c9085",
                                                "sense_id": "679dc911-0b70-3826-9c44-d6099e4e7d9d",
                                                "text": "If the researcher cannot adequately hear a specific conversation due to its low volume or other acoustic interference, then this data point can be passed over with the understanding that such lacunae will be randomly distributed over the data collecting period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "078785f6-e1cf-3381-ad4d-63ef6ea845c8",
                                        "entry_id": "f579f31b-a08e-3210-b1bb-c33220bce9bc",
                                        "glosses": [
                                            "A small blank space; a gap or vacancy; a hiatus.",
                                            "A language gap, which occurs when there is no direct translation in the target language for a lexical term found in the source language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb3ee1e1-0127-4b2c-908e-ae4a17f17e57",
                        "source_entry_id": "06e1b87e-08b6-3d9d-bbd6-d479e407c3e3",
                        "source_sense_id": "ab4e33ba-2a9a-393b-a17b-26cb274bb6ec",
                        "source_sense_description": "iets dat ontbreekt",
                        "target_lang_word": "lacune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lacune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2080c00c-5a7d-3a6d-a546-509b50f97b3f",
                                        "entry_id": "e8d4008a-f858-3f96-9938-71d638ebeb19",
                                        "glosses": [
                                            "Espace vide, solution de continuité dans un corps ou dans une série."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1985cd49-0383-4bab-a6a3-d95f2ea6a4b6",
                                                "sense_id": "2080c00c-5a7d-3a6d-a546-509b50f97b3f",
                                                "text": "— S’il est revenu à pied, se dit-elle, il peut lui arriver quelque accident !... On se tue en rencontrant un bout de trottoir ou en ne s’attendant pas à des lacunes."
                                            },
                                            {
                                                "example_id": "95d74ea4-72e5-45f0-b0d7-6c4d2e78d3dc",
                                                "sense_id": "2080c00c-5a7d-3a6d-a546-509b50f97b3f",
                                                "text": "Les quatre façades filaient le long des quatre rues, sans une lacune, dans leur isolement superbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a187571-cfa7-38db-a86f-1a3abb043de6",
                                        "entry_id": "e8d4008a-f858-3f96-9938-71d638ebeb19",
                                        "glosses": [
                                            "Interruption, vide dans le texte d’un auteur, dans le corps d’un ouvrage, etc.,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c694c989-4126-4492-9b7a-e69ed0684d50",
                                                "sense_id": "8a187571-cfa7-38db-a86f-1a3abb043de6",
                                                "text": "— Malvoisin, répondit Bois-Guilbert, ce sang-froid est celui d’un …\n— D’un ami, dit le précepteur se hâtant de remplir la lacune dans laquelle Bois-Guilbert aurait placé un mot beaucoup moins doux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42db0124-adfe-35d6-9711-25ff3dc3e0ee",
                                        "entry_id": "e8d4008a-f858-3f96-9938-71d638ebeb19",
                                        "glosses": [
                                            "Manque, imperfection."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31f57470-9372-44ba-a78e-4c5628d862f4",
                                                "sense_id": "42db0124-adfe-35d6-9711-25ff3dc3e0ee",
                                                "text": "Le cas de la société tibétaine d’avant 1950 illustre de façon tragique les lacunes d’une idéologie dogmatique bouddhiste gérée par de faillibles humains. Elle a conduit à une société féodale esclavagiste basée sur l’oppression de presque toute la population par les hiérarchies religieuse et aristocratique."
                                            },
                                            {
                                                "example_id": "dbeaf1df-276d-45b5-9d7e-131249d0132a",
                                                "sense_id": "42db0124-adfe-35d6-9711-25ff3dc3e0ee",
                                                "text": "Être ultra-resserré sans la balle et déployé avec, une stratégie qui permet de combler les lacunes individuelles quand le ballon est perdu."
                                            },
                                            {
                                                "example_id": "743ceda4-05b4-40df-b1f0-aaf4ca931e0b",
                                                "sense_id": "42db0124-adfe-35d6-9711-25ff3dc3e0ee",
                                                "text": "Conscient de ses lacunes, Gobert fait appel à un coach de neurotraining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ae748e-28da-342f-bcdf-9d0015edcd76",
                                        "entry_id": "e8d4008a-f858-3f96-9938-71d638ebeb19",
                                        "glosses": [
                                            "Manque de connaissances."
                                        ],
                                        "tags": [],
                                        "note": "Ce terme est généralement utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "4aa51e83-241d-4b61-9749-2726e281b7f5",
                                                "sense_id": "38ae748e-28da-342f-bcdf-9d0015edcd76",
                                                "text": "Cet élève a des lacunes en mathématiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785e7486-b8e7-31b6-8717-d260b78ad1b9",
                                        "entry_id": "e8d4008a-f858-3f96-9938-71d638ebeb19",
                                        "glosses": [
                                            "Trou dans une œuvre, que l'on peut reconstituer lors d'une restauration."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e02259f-067d-3212-8e7d-643385d2d34c",
                                        "entry_id": "e8d4008a-f858-3f96-9938-71d638ebeb19",
                                        "glosses": [
                                            "Sillon dans la face plantaire du sabot d'un cheval."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66ccb8a-9e43-48e0-b909-e0cdcfee5308",
                                                "sense_id": "0e02259f-067d-3212-8e7d-643385d2d34c",
                                                "text": "On distingue la lacune médiane et les deux lacunes latérales."
                                            },
                                            {
                                                "example_id": "4c10e780-cc66-4128-bd77-a2e430e70327",
                                                "sense_id": "0e02259f-067d-3212-8e7d-643385d2d34c",
                                                "text": "Une odeur nauséabonde provenant des lacunes indique une pourriture de la corne due à un mauvais entretien, ce qu'il faut soigner sans attendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af361a3e-2d6d-3376-9277-4d862da9ed6e",
                                        "entry_id": "e8d4008a-f858-3f96-9938-71d638ebeb19",
                                        "glosses": [
                                            "Défaut ponctuel d'un cristal consistant en l'absence d'un atome ou d'un ion."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
