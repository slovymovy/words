                    {
                        "sense_id": "e6939bea-308d-377f-922d-321bd1ca84ae",
                        "entry_id": "23d73991-f2b8-3416-b6c1-acaa879677c6",
                        "glosses": [
                            "kleine europäische Meise mit blauem Scheitel und blauen Flügeln"
                        ],
                        "tags": [
                            "Parus [Cyanistes] caerúleus"
                        ],
                        "examples": [
                            {
                                "example_id": "24d14438-7656-4cad-801f-13ddd4351e49",
                                "sense_id": "e6939bea-308d-377f-922d-321bd1ca84ae",
                                "text": "Blaumeisen nisten sogar in Laternenpfählen."
                            },
                            {
                                "example_id": "27929485-0159-48b7-8acf-7b8933e88af9",
                                "sense_id": "e6939bea-308d-377f-922d-321bd1ca84ae",
                                "text": "Blaumeisen sind gute Akrobaten"
                            },
                            {
                                "example_id": "d0164b43-b852-4e0b-8c01-d05bfcbf0a36",
                                "sense_id": "e6939bea-308d-377f-922d-321bd1ca84ae",
                                "text": "Blaumeisen setzen sich oft gegen die größeren Kohlmeisen bei der Nistplatzsuche durch"
                            },
                            {
                                "example_id": "0a6710f2-8d9f-4a12-888b-9825128fdeb7",
                                "sense_id": "e6939bea-308d-377f-922d-321bd1ca84ae",
                                "text": "Blaumeisen brüten meist in Baumhöhlen, auch Nistkästen werden häufig angenommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
