                        "entry_id": "bbb6cbd7-3046-314f-a995-b0d572544e63",
                        "glosses": [
                            "Commune française, située dans le département du Cher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8cb219-d343-4dc9-8f28-4db79d54c187",
                                "sense_id": "44cb2556-52ea-365f-9a13-2f31113d7720",
                                "text": "En 1120, le vin de Quincy est cité dans une bulle du pape Calixte II et le sauvignon y fut introduit par des moines de l'abbaye de Cîteaux."
                            },
                            {
                                "example_id": "bb69bb32-22ee-4cd5-864f-33b447109ac2",
                                "sense_id": "44cb2556-52ea-365f-9a13-2f31113d7720",
                                "text": "Pavé de morue fraîche rôti au coq et à la pomme de terre violette, petit jus réduit d'estragon au vin de Quincy et fouillis de poireaux croquants."
                            }
                        ]
                    }
