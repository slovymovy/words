                        ],
                        "form": "den Naturrechten"
                    },
                    {
                        "form_id": "4e7efbad-c4bb-458c-8739-13ba4c30e254",
                        "entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Naturrecht"
                    },
                    {
                        "form_id": "f02e2c22-8648-4c8e-a37e-e1f638a33a8f",
                        "entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Naturrechte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "280e6ef9-aefe-32e9-a5d1-770afaaebe1c",
                        "entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
                        "glosses": [
                            "unveränderliches, allgemein gültiges Recht (im objektiven Sinn), welches sich aus der Natur des Menschen ableitet und demzufolge rein aus der Vernunft erkennbar ist"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "df1ece92-19bc-46a8-a6b8-c585a8314476",
                                "sense_id": "280e6ef9-aefe-32e9-a5d1-770afaaebe1c",
                                "text": "„Das Naturrecht gründet auf der zeitlosen Vernunft des Menschen und des Universums und ändert sich deshalb nicht mit Zeit und Ort.“"
                            },
                            {
                                "example_id": "77cc75de-231f-4828-8f4f-4eb68e7838f4",
                                "sense_id": "280e6ef9-aefe-32e9-a5d1-770afaaebe1c",
                                "text": "„Für derartige Bestrebungen war offensichtlich das Naturrecht wesentlich geeigneter als das positive Recht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6acbe7aa-4de4-3cc0-9d73-6a604240a3ff",
                        "entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
                        "glosses": [
                            "auf [1] beruhendes (subjektives) Recht des Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70aa9e36-a736-44a4-afb4-c27af2b9e7b2",
                                "sense_id": "6acbe7aa-4de4-3cc0-9d73-6a604240a3ff",
                                "text": "Im Gegensatz zur Konzeption Thomas Hobbes' sind die Naturrechte bei Locke durch die Rechte anderer begrenzt."
                            },
                            {
                                "example_id": "81120a3c-7edb-4016-8b3b-efde2ebecce5",
                                "sense_id": "6acbe7aa-4de4-3cc0-9d73-6a604240a3ff",
                                "text": "„Die Achtung vor dieser allgemeinmenschlichen Natur ist naturrechtstheoretisch der Grund für die Zuerkennung von Naturrechten.“"
                            },
                            {
                                "example_id": "0cb259ac-a133-4171-b61b-39debce5c66f",
                                "sense_id": "6acbe7aa-4de4-3cc0-9d73-6a604240a3ff",
                                "text": "„Wer also den Ursprung der Naturrechte und -pflichten in das ewige Gesetz Gottes verlegt, ist gehalten, deutlich zu sagen, was die Termini ‚Natur‘ und ‚natürlich‘ bedeuten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56e2f013-c896-44b4-ba62-ee419a077034",
                        "source_entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
                        "source_sense_id": "280e6ef9-aefe-32e9-a5d1-770afaaebe1c",
                        "target_lang_word": "natural law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "natural law",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b644fc-84ee-338d-a0de-9147a09466fc",
                                        "entry_id": "7d1e6e7e-fc60-3326-8c0a-7923a3ffd459",
                                        "glosses": [
                                            "The set of universal legal or moral principles said to be discernible from nature by reason alone; one of these principles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93675377-6d30-4292-89af-df38f620726e",
                                                "sense_id": "d6b644fc-84ee-338d-a0de-9147a09466fc",
                                                "text": "Thus, for example, it is a natural law, that he who has been the author of any damage ought to repair it."
                                            },
                                            {
                                                "example_id": "624de592-07d6-4f7a-bbc8-75b1428ab0bd",
                                                "sense_id": "d6b644fc-84ee-338d-a0de-9147a09466fc",
                                                "text": "For Maritain, natural law is not a written law; it is immanent in nature."
                                            },
                                            {
                                                "example_id": "872bd039-1da8-4d59-8931-68a97a5b8812",
                                                "sense_id": "d6b644fc-84ee-338d-a0de-9147a09466fc",
                                                "text": "The content of the natural law is the substantive account of ways of living that bring humanity to its natural good. In this broad sense, the natural law is much broader than law understood as a specific human institution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c599c0c2-4b9d-34d5-959a-49c05ad02d25",
                                        "entry_id": "7d1e6e7e-fc60-3326-8c0a-7923a3ffd459",
                                        "glosses": [
                                            "A theory describing or positing such principles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97b5d101-18fc-483b-a83a-fbe0377e2ebc",
                                                "sense_id": "c599c0c2-4b9d-34d5-959a-49c05ad02d25",
                                                "text": "One of the reasons why it is sometimes felt that natural law is a predominantly rationalistic philosophy is because it has been associated with the concepts of the state of nature and of the original contract."
                                            },
                                            {
                                                "example_id": "1a442744-4072-401e-92e3-21123cc114be",
                                                "sense_id": "c599c0c2-4b9d-34d5-959a-49c05ad02d25",
                                                "text": "Another component of natural law is the view that some specific moral norms follow from these principles in such a way that it is easy for people to see their truth, even though it is possible, because of cultural distortion or personal immorality, that people be ignorant of them."
                                            },
                                            {
                                                "example_id": "68488f20-1807-4f75-a82f-2e86414a1f6b",
                                                "sense_id": "c599c0c2-4b9d-34d5-959a-49c05ad02d25",
                                                "text": "Buckle […] argues that Grotius and Pufendorf understood Natural Law as a science of morals grounded in human nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff0568e-7221-3c4f-9bd2-50c2dc28380c",
                                        "entry_id": "7d1e6e7e-fc60-3326-8c0a-7923a3ffd459",
                                        "glosses": [
                                            "A law relating to natural phenomena, a law of nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "661ae780-e549-4fc9-9fa6-076f2fd937b4",
                                                "sense_id": "4ff0568e-7221-3c4f-9bd2-50c2dc28380c",
                                                "text": "It may seem an obvious objection that many of the Natural Laws have no connection whatever with the Spiritual World, and as a matter of fact are not continued through it. Gravitation for instance—what direct application has that in the Spiritual World?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86c374d8-bc4d-4d08-b3dd-0076af8a549e",
                        "source_entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
                        "source_sense_id": "280e6ef9-aefe-32e9-a5d1-770afaaebe1c",
                        "target_lang_word": "droit naturel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "droit naturel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb620eb-3c54-3ba5-abcf-c246bafcae28",
                                        "entry_id": "1b691b46-a0aa-3c46-b58c-2f7c7d3df434",
                                        "glosses": [
                                            "Forme de droit basée sur ce qui est considéré comme la nature de l’homme, comme le fait de se nourrir."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff0eea1-aaca-41ca-bc8f-e3829057493c",
                                                "sense_id": "7bb620eb-3c54-3ba5-abcf-c246bafcae28",
                                                "text": "L’observation va d’ailleurs montrer à Pascal l’absurdité de la théorie du droit naturel ; si cette théorie était exacte, on trouverait quelques lois universellement admises ; mais des actions que nous regardons comme des crimes ont été regardées autrefois comme vertueuses : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f32044f-61a2-39df-bed2-9766c103d09c",
                                        "entry_id": "1b691b46-a0aa-3c46-b58c-2f7c7d3df434",
                                        "glosses": [
                                            "Chacun des droits élémentaires qui en dérivent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c9536d-19d4-48b1-8dec-b088076f89ef",
                                                "sense_id": "0f32044f-61a2-39df-bed2-9766c103d09c",
                                                "text": "Les droits naturels seraient inhérents à chacun, indépendamment de sa position sociale, de son ethnie, de sa nationalité, ou de toute autre considération. Les premières formulations du concept de droit naturel viennent de l’école de Salamanque, et ont ensuite été reprises et reformulées par les théoriciens du contrat social (Hobbes, Locke, Rousseau)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35048236-3312-4036-be94-8ca79375bbf2",
                        "source_entry_id": "1a8ff7fd-9d03-35fd-8b89-686be3831abb",
                        "source_sense_id": "6acbe7aa-4de4-3cc0-9d73-6a604240a3ff",
                        "target_lang_word": "natural right",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "natural right",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a637e30-1559-3a06-8fd1-00ec2886e6e7",
                                        "entry_id": "2a35c71f-c976-3f8d-92a4-8ef610a45302",
                                        "glosses": [
                                            "Any right existing by virtue of natural law, such as liberty, or security of one's person and property."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
