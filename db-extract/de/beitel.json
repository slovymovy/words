                    {
                        "translation_id": "e993cb2d-7e76-47ab-9daa-87274fdb7067",
                        "source_entry_id": "f6430828-5713-37b1-8b1a-e6a8e29e0a20",
                        "source_sense_id": "d3f35a54-4c52-3a31-aa97-bc112f55bd72",
                        "source_sense_description": "ein bestimmtes Holzbearbeitungswerkzeug",
                        "target_lang_word": "ciseau à bois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ciseau à bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8977d7af-fe38-329b-8617-61fb409ad784",
                                        "entry_id": "44a2129d-ead6-3874-bd6e-5965f3d75f49",
                                        "glosses": [
                                            "Outil composé d’une lame en acier trempé, dont une des extrémités est taillée en biseau et affûtée pour permettre le travail du bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39f6dd1-8f65-4efb-93b0-e52c9b98d908",
                                                "sense_id": "8977d7af-fe38-329b-8617-61fb409ad784",
                                                "text": "Il savait bien que plus jamais ces rabots, ces ciseaux à bois, ces burins ou ces mèches ne lui serviraient à rien, mais il continuait de les soigner comme il avait toujours fait, par habitude."
                                            },
                                            {
                                                "example_id": "86d3209a-dd38-493c-8f16-a85a1dbb0b90",
                                                "sense_id": "8977d7af-fe38-329b-8617-61fb409ad784",
                                                "text": "La coterie Iosef prit un large ciseau à bois, fendit une des pièces en plusieurs parties, égales puis, avec le même ciseau, les arrondit et les affûta d'un bout."
                                            },
                                            {
                                                "example_id": "5bb7d3eb-b1e1-49dc-9c4a-5ea111d0f436",
                                                "sense_id": "8977d7af-fe38-329b-8617-61fb409ad784",
                                                "text": "Les artisans menuisiers de Sanaa utilisent au moins deux sortes de ciseaux :\nLe minqâr, est un ciseau à bois dont le manche est presque aussi long que la lame aplatie ([…])."
                                            },
                                            {
                                                "example_id": "eb2cf24f-09a7-4420-91c7-eb0723345a0a",
                                                "sense_id": "8977d7af-fe38-329b-8617-61fb409ad784",
                                                "text": "Ces remarques, faîtes au sujet des biseaux d’affutage doubles, tels que ceux des haches, s'appliquent également, aux outils tranchants avec un seul biseau, comme les ciseaux à bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba2695e-49f5-3207-8d19-1a56a3952299",
