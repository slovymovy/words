                "translations": [
                    {
                        "translation_id": "ec5aac2e-40ec-4a3d-afcc-dfe1a4620b85",
                        "source_entry_id": "1534f5e3-781a-3cc4-8d69-912ff0ee6311",
                        "source_sense_id": "a8c597f0-ad54-3404-909b-7f686dc898e9",
                        "source_sense_description": "jurk gedragen door een bruid",
                        "target_lang_word": "Brautkleid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brautkleid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b468116a-a3aa-3a20-abc8-11797f172150",
                                        "entry_id": "4b83b804-4db4-3e2d-a138-0b06ed637b31",
                                        "glosses": [
                                            "Kleid, das die Braut zur Hochzeitszeremonie trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5afa11f7-8b3d-4085-942f-f7a4570a321a",
                                                "sense_id": "b468116a-a3aa-3a20-abc8-11797f172150",
                                                "text": "In Europa sind Brautkleider vorwiegend weiß."
                                            },
                                            {
                                                "example_id": "7d7ea12f-3f9d-4fb4-886a-23601bf935d3",
                                                "sense_id": "b468116a-a3aa-3a20-abc8-11797f172150",
                                                "text": "In diesem Brautkleid hat schon meine Ururgroßmutter geheiratet."
                                            },
                                            {
                                                "example_id": "8986c1b5-7a92-435b-b215-ecfdb8c9e8cd",
                                                "sense_id": "b468116a-a3aa-3a20-abc8-11797f172150",
                                                "text": "In diesem Brautkleid bemerkt man gar nicht die Fettleibigkeit der Braut!"
                                            },
                                            {
                                                "example_id": "1f2b68c4-1a8b-4d97-827b-b67cd4885d1b",
                                                "sense_id": "b468116a-a3aa-3a20-abc8-11797f172150",
                                                "text": "„Er wird auf Sonderurlaub geschickt, mit pommerschem Schinken und mit Würsten versehen fürs Brautkleid aus weißen Spitzen samt Schleier bringt er die schönste Friedensware mit, die sich nur denken läßt.“"
                                            },
                                            {
                                                "example_id": "686eae45-6bcf-4b4d-bc41-7b87f646900f",
                                                "sense_id": "b468116a-a3aa-3a20-abc8-11797f172150",
                                                "text": "„Sie war in ihr Brautkleid gehüllt, und vor ihr lagen alle ihre Kleider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7cc346b-090d-48f6-a1b1-88fee2676d44",
                        "source_entry_id": "1534f5e3-781a-3cc4-8d69-912ff0ee6311",
