                                            {
                                                "example_id": "94ff472c-8ef8-46f3-b5fe-0838aeffcdfc",
                                                "sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                                                "text": "… nous serions certainement amenés à jeter par-dessus bord le concept général d’« ethnie » parce que c’est un terme fourre-tout inutilisable pour une recherche véritablement exacte."
                                            },
                                            {
                                                "example_id": "2076e5f0-bc70-466b-9232-42c46c8a4a95",
                                                "sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                                                "text": "Que donc le ravitaillement en essence soit coupé ou qu’un saboteur ait fourré un morceau de sucre dans le réservoir, et on se trouve devant un tas de ferraille inutilisable."
                                            },
                                            {
                                                "example_id": "b7a0d806-295e-486c-840c-1fcb6d005746",
                                                "sense_id": "868f7d34-5182-3fe8-abc1-12c1c437b764",
                                                "text": "À peine remis sur pied, Poulidor constate que le vélo de rechange est maintenant inutilisable et qu’il doit donc reprendre sa monture d’origine."
                                            }
                                        ]
                                    }
                                ]
                            }
