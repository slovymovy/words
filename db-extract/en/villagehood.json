                    {
                        "sense_id": "f0ae918d-9879-360f-80c6-098060b476e1",
                        "entry_id": "002e5ba7-efea-34c8-9bfe-82382f9f863e",
                        "glosses": [
                            "The state of being a village."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1440af49-cc39-4414-9cf5-56b3dbd5117d",
                                "sense_id": "f0ae918d-9879-360f-80c6-098060b476e1",
                                "text": "It is, comparatively speaking, an old place, and was raised from villagehood to parochial rank by a Royal Letter of January 28th, 1752."
                            },
                            {
                                "example_id": "25e8220d-3488-43d6-a444-326d8a2d9cbc",
                                "sense_id": "f0ae918d-9879-360f-80c6-098060b476e1",
                                "text": "We drive west into the Wallachian countryside, past rows of daub- and-wattle houses, plastered with a blue wash, clustered together along the road, aspiring to villagehood."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e335806-8865-3be2-bd0b-5f8bdce14586",
                        "entry_id": "002e5ba7-efea-34c8-9bfe-82382f9f863e",
                        "glosses": [
                            "The people and culture of a village."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8267673-d67c-499c-8028-d77b670ed754",
                                "sense_id": "5e335806-8865-3be2-bd0b-5f8bdce14586",
                                "text": "They came to the school, and in due course formed part of the young villagehood."
                            },
                            {
                                "example_id": "81dbefac-adba-42a0-888e-c051ef0a779f",
                                "sense_id": "5e335806-8865-3be2-bd0b-5f8bdce14586",
                                "text": "But the practice of villagehood still remains a constant through all of this, creating Miloli'i people as opposed to just islanders."
                            }
                        ]
                    }
