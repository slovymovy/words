                "senses": [
                    {
                        "sense_id": "633e6b06-2f78-3d94-8056-be723952ea3f",
                        "entry_id": "5b535072-c7d8-3106-b052-76920916efdb",
                        "glosses": [
                            "verdecktes Angebot (der eigenen Kooperation), Anbiederung"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "52bf2cbb-f740-47e8-8a7f-a360e63d31b4",
                                "sense_id": "633e6b06-2f78-3d94-8056-be723952ea3f",
                                "text": "Der US-Präsident nahm die Avancen aus Europa zwar wahr, ignoriert sie aber."
                            },
                            {
                                "example_id": "7b0e11fc-48c1-47c9-bd0e-dee62d93e87a",
                                "sense_id": "633e6b06-2f78-3d94-8056-be723952ea3f",
                                "text": "„Sie nahm die Avancen des gutaussehenden Schumann gerne entgegen.“"
                            },
                            {
                                "example_id": "74ef6208-0c49-4fe6-b2ec-ea014f921e83",
                                "sense_id": "633e6b06-2f78-3d94-8056-be723952ea3f",
                                "text": "„Sie hatte keine Lust auf die Avancen eines der Stammkunden, in den sie nicht verliebt war.“"
                            },
                            {
                                "example_id": "b857637d-be51-4077-aa9a-21de879262b4",
                                "sense_id": "633e6b06-2f78-3d94-8056-be723952ea3f",
                                "text": "„Sie hätte, denkt sie, doch besser Jochen, den hochgewachsenen Freund von Wolfgang, nehmen sollen, der sie umgarnte, ihr Avancen machte, sie zum Essen einlud.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b960e7ad-acf6-49ac-929e-90f92af75ca2",
                        "source_entry_id": "5b535072-c7d8-3106-b052-76920916efdb",
                        "source_sense_id": "633e6b06-2f78-3d94-8056-be723952ea3f",
