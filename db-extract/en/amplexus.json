                "senses": [
                    {
                        "sense_id": "01fe9f00-99ae-35ac-9980-618e331b6558",
                        "entry_id": "dd74d707-571e-363c-8e20-4d9444744060",
                        "glosses": [
                            "A form of pseudocopulation, found chiefly in amphibians and horseshoe crabs, in which a male grasps a female with his front legs as part of the mating process."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e1c2478-4dd8-45d9-8301-a36ab009a6df",
                                "sense_id": "01fe9f00-99ae-35ac-9980-618e331b6558",
                                "text": "Finally, we came upon a pair of Panamanian robber frogs locked in amplexus—the amphibian version of sex."
                            },
                            {
                                "example_id": "fc38c66d-d450-4cca-b1b7-02b3bb13f62d",
                                "sense_id": "01fe9f00-99ae-35ac-9980-618e331b6558",
                                "text": "In the middle, just below the surface, a male and a female were locked in amplexus, a coupling that can last for days as the male waits to fertilise the eggs when they are laid."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f1f9553-2689-3f08-a9b6-b5dca4a9484e",
                        "entry_id": "dd74d707-571e-363c-8e20-4d9444744060",
                        "glosses": [
                            "In vernation, the situation where two sides of one leaf overlap the two sides of the one above it."
                        ],
