                "senses": [
                    {
                        "sense_id": "318a96ab-ba84-37ab-8861-4f2d05325d51",
                        "entry_id": "6cbaaebc-f2cf-390f-9348-6ef5001f312e",
                        "glosses": [
                            "(zur Verschönerung) mit Silber, Silberschmuck oder etwas Silberfarbenem versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5005416-60ea-4089-ac9c-2d8b04acf940",
                                "sense_id": "318a96ab-ba84-37ab-8861-4f2d05325d51",
                                "text": "„Junge Georgier in malerischen Gewändern trugen die Speisen auf; ein schlanker Armenier kredenzte in gigantischen, silbergezierten Büffelhörnern die feurigen, blutrothen Weine von Kachetos; ein persischer Sänger in blauem Talar und hochaufstrebender, pyramidenförmiger Mütze, mit einem feingeschnittenen, verschmitzten Gesichte und blaubemalten Fingerspitzen, spielte die ›Tschengjir‹ und sang dazu die lieblichsten Oden von Hafis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
