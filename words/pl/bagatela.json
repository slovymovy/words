{
    "word_family": [
        "bagatelizować",
        "zbagatelizować",
        "bagatelizowanie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fcda3655-7f2c-3e38-8dac-fc9605ee5cac",
                    "sense_definition": "rzecz lub sprawa małej wagi, pozbawiona większego znaczenia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "błahostka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dla ciebie taka kwota to zwykła <w>bagatela</w>, ale dla mnie to spory wydatek.",
                            "target_lang_translations": {
                                "ru": "Для тебя такая сумма — сущий <w>пустяк</w>, а для меня это немалые расходы."
                            }
                        },
                        {
                            "text": "Nie powinniśmy kłócić się o takie <w>bagatele</w>, kiedy mamy poważniejsze problemy do rozwiązania.",
                            "target_lang_translations": {
                                "ru": "Нам не стоит ссориться из-за таких <w>мелочей</w>, когда перед нами стоят куда более серьезные проблемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "błahostka",
                        "drobnostka",
                        "drobiazg",
                        "fraszka",
                        "szczegół"
                    ],
                    "target_lang_definitions": {
                        "ru": "незначительная вещь или пустяковое дело, не имеющее особого значения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустяк",
                                "target_lang_sense_clarification": "мелочь, нечто неважное"
                            },
                            {
                                "target_lang_word": "мелочь",
                                "target_lang_sense_clarification": "незначительное обстоятельство или дело"
                            },
                            {
                                "target_lang_word": "безделица",
                                "target_lang_sense_clarification": "пустяковое дело или предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03fb1687-4665-3a0e-b884-b0795db13b8e",
                    "sense_definition": "krótki, lekki i pogodny utwór muzyczny, najczęściej fortepianowy, lub literacki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sztuka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody pianista zagrał z wielką lekkością znaną <w>bagatelę</w> Beethovena.",
                            "target_lang_translations": {
                                "ru": "Молодой пианист с большой легкостью исполнил знаменитую <w>багатель</w> Бетховена."
                            }
                        },
                        {
                            "text": "W programie dzisiejszego koncertu znalazło się kilka uroczych <w>bagateli</w> na fortepian.",
                            "target_lang_translations": {
                                "ru": "В программу сегодняшнего концерта вошло несколько очаровательных фортепианных <w>багателей</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое, легкое и непринужденное музыкальное (чаще фортепианное) или литературное произведение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "багатель",
                                "target_lang_sense_clarification": "музыкальная или литературная миниатюра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d920e16-3d1e-3f32-b9ba-0a47184257c2",
                    "sense_definition": "niewielki pawilon ogrodowy lub pałacyk o charakterze wypoczynkowym, popularny w XVIII i XIX wieku",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architektura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Majętny teść zakupił im pod miastem gustowną <w>bagatelę</w>, gdzie odbywały się wesołe spotkania towarzyskie.",
                            "target_lang_translations": {
                                "ru": "Состоятельный тесть купил им за городом изящный <w>павильон</w>, где проходили веселые светские встречи."
                            }
                        },
                        {
                            "text": "W głębi zabytkowego parku wciąż stoi urokliwa <w>bagatela</w> wybudowana pod koniec XVIII wieku.",
                            "target_lang_translations": {
                                "ru": "В глубине старинного парка до сих пор стоит очаровательный <w>павильон</w>, построенный в конце XVIII века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой парковый павильон или загородный домик для отдыха, популярный в XVIII–XIX веках"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "багатель",
                                "target_lang_sense_clarification": "парковый павильон, дачный особняк"
                            },
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "небольшая парковая постройка для отдыха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac027ae1-c342-328c-95f1-5bc43fbb0084",
                    "sense_definition": "nieprawda, kłamstwo",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "klamstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wierz ani jednemu jego słowu, bo to zwykła <w>bagatela</w> wymyślona na poczekaniu.",
                            "target_lang_translations": {
                                "ru": "Не верь ни единому его слову, ведь это простое <w>враньё</w>, придуманное на ходу."
                            }
                        },
                        {
                            "text": "Miejscowi od razu wiedzieli, że ta dziwna opowieść to jawna <w>bagatela</w> obcego przybysza.",
                            "target_lang_translations": {
                                "ru": "Местные сразу поняли, что эта странная история — чистая <w>небылица</w> чужака."
                            }
                        }
                    ],
                    "synonyms": [
                        "brechnia"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "gwara bukowińska"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "неправда, ложь, выдумка (диалектное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враньё",
                                "target_lang_sense_clarification": "ложь, выдумка"
                            },
                            {
                                "target_lang_word": "небылица",
                                "target_lang_sense_clarification": "вымышленная история"
                            },
                            {
                                "target_lang_word": "выдумка",
                                "target_lang_sense_clarification": "неправдивая история"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "65bb916a-e80d-385a-b7e9-8adc9ab44d28",
                    "sense_definition": "wykrzyknik używany z emfazą lub ironią dla podkreślenia dużej ilości, wagi, kosztu lub trudu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wykrzyknik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupno tego nowego mieszkania kosztowało ich, <w>bagatela</w>, ponad milion złotych.",
                            "target_lang_translations": {
                                "ru": "Покупка этой новой квартиры обошлась им, <w>шутка ли</w>, более чем в миллион злотых."
                            }
                        },
                        {
                            "text": "Na sam remont zabytkowego dachu wydano, <w>bagatela</w>, kilkaset tysięcy euro.",
                            "target_lang_translations": {
                                "ru": "На один только ремонт исторической крыши ушло, <w>подумать только</w>, несколько сотен тысяч евро."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "междометие, используемое эмоционально или иронично для подчеркивания большого количества, высокой цены или масштаба чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутка ли",
                                "target_lang_sense_clarification": "для подчеркивания значительности цифры или факта"
                            },
                            {
                                "target_lang_word": "подумать только",
                                "target_lang_sense_clarification": "для выражения изумления масштабом"
                            },
                            {
                                "target_lang_word": "ни много ни мало",
                                "target_lang_sense_clarification": "для подчеркивания внушительного количества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}