                                    {
                                        "sense_id": "a63170de-118c-3f30-9452-651c67a1377a",
                                        "entry_id": "3e87a416-da3a-3f0c-8635-64aaa41a88aa",
                                        "glosses": [
                                            "The capital city of Ukraine and regional administrative centre of Kyiv Oblast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d2b2e6-903a-49ec-bcb5-a059b571beb2",
                                                "sense_id": "a63170de-118c-3f30-9452-651c67a1377a",
                                                "text": "The Ukrainian government says Kyiv, Vinnytsia, Odesa, Zaporizhzhia and other cities have suffered a barrage of drone attacks, and pleaded with Western countries to step up their assistance in the face of the new challenge."
                                            },
                                            {
                                                "example_id": "7fca374c-fe47-4a7f-aac0-73e9a07a5390",
                                                "sense_id": "a63170de-118c-3f30-9452-651c67a1377a",
                                                "text": "Zarutska graduated from Synergy College in Kyiv with a degree in art and restoration, her obituary says."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9169b9a7-b2b4-3607-a8c6-e2318139542a",
                                        "entry_id": "3e87a416-da3a-3f0c-8635-64aaa41a88aa",
                                        "glosses": [
                                            "An oblast of Ukraine. Seat: Kyiv."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca6f1737-64d3-3f68-aefa-4f21d4593e8a",
                                        "entry_id": "3e87a416-da3a-3f0c-8635-64aaa41a88aa",
                                        "glosses": [
                                            "The Ukrainian government."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81556e6-882d-4ec7-9949-7f5b782628c2",
                                                "sense_id": "ca6f1737-64d3-3f68-aefa-4f21d4593e8a",
                                                "text": "“Ukraine’s future is within the EU,” Ukrainian President Volodymyr Zelensky wrote on Twitter after the decision, describing it as a “unique and historical moment” in Kyiv’s relations with the bloc."
                                            },
                                            {
                                                "example_id": "9f44c0b5-c2b9-412b-a17a-e7a70c64b05c",
                                                "sense_id": "ca6f1737-64d3-3f68-aefa-4f21d4593e8a",
                                                "text": "After Vladimir Putin announced the annexation of four Ukrainian provinces last week, Kyiv said it was applying to join NATO, and would not negotiate with Russia as long as Putin is president."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a29d44c-d9e2-359e-aeba-78870cb1307d",
                                        "entry_id": "3e87a416-da3a-3f0c-8635-64aaa41a88aa",
                                        "glosses": [
                                            "Ellipsis of the Kyiv District, synonym of the Kyivskyi District: an urban raion of Donetsk, Donetsk Raion, Donetsk Oblast, Ukraine; under Russian occupation."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af0763e5-7b19-3abc-8244-0e19771c1105",
                                        "entry_id": "3e87a416-da3a-3f0c-8635-64aaa41a88aa",
                                        "glosses": [
                                            "Ellipsis of Kyiv Peninsula: a peninsula in Antarctic Peninsula, Antarctica."
                                        ],
                                        "tags": [
                                            "abbreviation",
