                {
                    "sense_id": "0069d279-4cdd-3d21-84dd-79445c2a7e6f",
                    "sense_definition": "zich andere kleren aandoen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kleding_wisselen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet me nog even <w>verkleden</w> voordat we naar het restaurant gaan.",
                            "target_lang_translations": {
                                "en": "I still need to <w>change</w> before we go to the restaurant."
                            }
                        },
                        {
                            "text": "Na het sporten gaat hij zich altijd direct <w>verkleden</w> in de kleedkamer.",
                            "target_lang_translations": {
                                "en": "After exercising, he always goes to <w>change clothes</w> immediately in the locker room."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkleden"
                    ],
                    "common_phrases": [
                        "zich even verkleden",
                        "snel verkleden"
                    ],
                    "target_lang_definitions": {
                        "en": "To put on different clothes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "change clothes",
                                "target_lang_sense_clarification": "to put on different clothing"
                            },
                            {
                                "target_lang_word": "get changed",
                                "target_lang_sense_clarification": "to switch from one set of clothes to another"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2933901-48f6-39cc-8165-85ec9342d28b",
                    "sense_definition": "zich vermommen door een kostuum of andere kleren aan te trekken voor een feest of toneel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kostuums",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens carnaval gaan veel mensen zich als piraat of superheld <w>verkleden</w>.",
                            "target_lang_translations": {
                                "en": "During Carnival, many people <w>dress up</w> as a pirate or superhero."
                            }
                        },
                        {
                            "text": "De kinderen wilden zich als spoken <w>verkleden</w> voor het Halloweenfeest.",
                            "target_lang_translations": {
                                "en": "The children wanted to <w>dress up</w> as ghosts for the Halloween party."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verkleed als",
                        "zich verkleden als"
                    ],
                    "target_lang_definitions": {
                        "en": "To disguise oneself by putting on a costume or other clothes for a party or play"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dress up",
                                "target_lang_sense_clarification": "to wear a costume or fancy dress"
                            },
                            {
                                "target_lang_word": "disguise oneself",
                                "target_lang_sense_clarification": "to change appearance to hide identity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38c062d7-d95c-3c56-b610-119af7b8d631",
                    "sense_definition": "de kleren van iemand anders of een pop verwisselen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kleding_wisselen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het meisje was de hele middag druk bezig met haar pop <w>verkleden</w>.",
                            "target_lang_translations": {
                                "en": "The girl was busy all afternoon <w>changing</w> her doll's clothes."
                            }
                        },
                        {
                            "text": "De moeder moet de baby <w>verkleden</w> omdat zijn kleren nat zijn geworden.",
                            "target_lang_translations": {
                                "en": "The mother has to <w>change</w> the baby because his clothes got wet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een pop verkleden"
                    ],
                    "target_lang_definitions": {
                        "en": "To change the clothes of someone else or a doll"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "change",
                                "target_lang_sense_clarification": "to replace someone's clothes, like a baby or doll"
                            },
                            {
                                "target_lang_word": "dress up",
                                "target_lang_sense_clarification": "to put a costume on someone else or a doll"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}