                        "glosses": [
                            "The palm tree Manicaria saccifera."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c865fd2-79e4-453a-a9cc-aaad45c4fb74",
                                "sense_id": "5173d493-442c-3831-b0d1-a5379d1eabd7",
                                "text": "The Bussú, like the Hemp Palm, and the Coco-nut Palm, affords an excellent, durable, ready made cloth."
                            },
                            {
                                "example_id": "d60ebd7f-607c-42f8-9b4f-95cd014bda1e",
                                "sense_id": "5173d493-442c-3831-b0d1-a5379d1eabd7",
                                "text": "For here the palms hold court; nowhere else on the broad earth is their glory unveiled as we see it: soft, plumy Jupatis dropping over the water, and fairy-light assaiso and bussús with their light-green vase-like forms, and great noble fan-leaved miritis looking down from their eighty-feet high columns, and others that we hardly notice at first, though they are nobles in their race."
                            }
                        ]
                    }
