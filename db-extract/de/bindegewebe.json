                        "source_sense_id": "8c872ad6-196f-3ba2-a404-de23c58a1647",
                        "source_sense_description": "Gewebe bei Tieren aus locker verstreuten Zellen und viel extrazellulärer Substanz",
                        "target_lang_word": "tissu conjonctif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
