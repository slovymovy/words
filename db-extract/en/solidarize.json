                                            {
                                                "example_id": "1944eead-272f-4114-8449-2f517abdfb69",
                                                "sense_id": "027b521c-9106-3112-bffe-3f5f9144152c",
                                                "text": "Le chevillage a pour but de solidariser les poutres."
                                            },
                                            {
                                                "example_id": "01851b54-754b-4689-93c4-dca4bc349fd2",
                                                "sense_id": "027b521c-9106-3112-bffe-3f5f9144152c",
                                                "text": "Se solidariser avec F.L.N., n’est-ce pas risquer de se « décitoyenniser »."
                                            },
                                            {
                                                "example_id": "23b2e06c-12a2-4c40-bc1a-6b8f5c989827",
                                                "sense_id": "027b521c-9106-3112-bffe-3f5f9144152c",
                                                "text": "D’ailleurs, quand on ne se solidarise pas, on se souvient. On commémore, on anniversairise, on se rappelle le bon vieux temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beb32b5d-c3bc-47e9-b5ff-59cfea8efa7e",
