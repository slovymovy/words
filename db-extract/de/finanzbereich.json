                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74846600-498e-4cb2-b7d2-b4918059387f",
                                "sense_id": "a4a78641-035a-3607-be59-d76277a2cd58",
                                "text": "„Ich habe festgestellt, dass der Finanzbereich einer der kritischen Funktionen im Unternehmen ist, um Innovation zu unterstützen.“"
                            },
                            {
                                "example_id": "4239ac63-4d52-4929-8d56-d1f824db8d67",
                                "sense_id": "a4a78641-035a-3607-be59-d76277a2cd58",
                                "text": "„Im Interview mit Imke Keimer erklärt Markus Zorn, warum dies so wichtig ist und welche digitalen Trends aktuell im Finanzbereich wahrgenommen werden.“"
                            },
                            {
                                "example_id": "eea9e0c3-7fc0-4d2c-ae81-c8835cfe9ea8",
                                "sense_id": "a4a78641-035a-3607-be59-d76277a2cd58",
                                "text": "„Der Finanzbereich spielt, ähnlich wie in Mumbai, mit einer Börse und vielen Vertretungen ausländischer Kreditinstitute eine wichtige Rolle.“"
                            }
                        ],
