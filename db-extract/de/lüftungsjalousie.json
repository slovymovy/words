                "senses": [
                    {
                        "sense_id": "66d458b6-8f77-3702-809c-0927699f06eb",
                        "entry_id": "e68c455e-7fd9-3a0e-978e-1aaa259bce69",
                        "glosses": [
                            "Lamellen aus Metall oder Kunststoff in einem Rahmen, durch die Luft strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa868192-8c29-45ed-a6e2-92230a23c4c3",
                                "sense_id": "66d458b6-8f77-3702-809c-0927699f06eb",
                                "text": "„Auf korrosionsbeständiger Aluminiumbasis sind verschiedene Ausführungen von Lüftungsjalousien erhältlich.“"
                            },
                            {
                                "example_id": "865899ed-ac8b-45e0-b51e-777afb69622a",
                                "sense_id": "66d458b6-8f77-3702-809c-0927699f06eb",
                                "text": "„Für freistehende Kompakt-Stationen entwickelt, hat sich die EMN-Lüftungsjalousie im langjährigen Einsatz bewährt.“"
                            },
                            {
                                "example_id": "f45f9043-4bb9-4503-b435-6f99c4008818",
                                "sense_id": "66d458b6-8f77-3702-809c-0927699f06eb",
                                "text": "„Wenn Sie die klassische Konzeption von Garderobenschränken mit Lüftungsjalousien bevorzugen, können Sie bei uns aus einer Menge Produkten wählen, die ein traditionelles Design behalten.“"
                            },
                            {
                                "example_id": "84b55279-3ce4-4219-b7af-4e5977d787a2",
                                "sense_id": "66d458b6-8f77-3702-809c-0927699f06eb",
                                "text": "„Dafür sind in der zweiten Fassade Lüftungsjalousien angebracht, die sowohl für eine Wärmeabfuhr im Sommer als auch zur Wärmepufferung im Winter dienen.“"
                            },
                            {
                                "example_id": "cf16297a-97ac-4c65-88d4-61981ca88f6d",
                                "sense_id": "66d458b6-8f77-3702-809c-0927699f06eb",
                                "text": "„Sie bestehen aus einem Flügel mit Lüftungsjalousien sowie einer Türzarge aus Stahl mit oder ohne Schwelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
