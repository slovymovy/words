                {
                    "sense_id": "99d3eaef-6c54-35a4-9c0e-541ff5dec48d",
                    "sense_definition": "niet recht, maar met een bocht of hoek",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man liep met een <w>kromme</w> rug door de smalle straat.",
                            "target_lang_translations": {
