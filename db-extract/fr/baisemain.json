        "fr-extract.jsonl": [
            {
                "entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                "word": "baisemain",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1213a8c4-4607-46c1-bc93-45f8645c26f4",
                        "entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "baisemains"
                    },
                    {
                        "form_id": "50e25146-1251-4cc3-8fe0-19b99dafb09b",
                        "entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                        "tags": [],
                        "form": "baise-main"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e504862-f9c5-37b1-b528-673b8fba3d4f",
                        "entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                        "glosses": [
                            "Hommage que le vassal rend au seigneur du fief en lui baisant la main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131f66d7-a9e0-4aff-ae17-49c9378e325b",
                                "sense_id": "2e504862-f9c5-37b1-b528-673b8fba3d4f",
                                "text": "Il ne devait que le baisemain."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e6424c9-aa57-33d3-b282-9a8a8a42a63b",
                        "entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                        "glosses": [
                            "Geste de politesse qui consiste à baiser la main d’une dame pour la saluer ou pour prendre congé d’elle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1414825-0481-4135-8305-7ad192f88272",
                                "sense_id": "7e6424c9-aa57-33d3-b282-9a8a8a42a63b",
                                "text": "Aussitôt de tous les gradins partent des viva assourdissants ; les mouchoirs s’agitent ; les chapeaux des majos volent dans l’arène, et le héros vainqueur envoie modestement des baisemains de tous les côtés."
                            },
                            {
                                "example_id": "7616d659-fa7c-42e6-ad52-8b59ff135aee",
                                "sense_id": "7e6424c9-aa57-33d3-b282-9a8a8a42a63b",
                                "text": "Le snobisme scolaire qui consiste, en poésie, à n’employer que certains mots déterminés, à la priver de certains autres, qu’ils soient techniques, médicaux, populaires ou argotiques, me fait penser au prestige du rince-doigts et du baisemain. Ce n’est pas le rince-doigts qui fait les mains propres ni le baisemain qui fait la tendresse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8288523e-e1ba-4ee9-984a-9f7abc7fa1c8",
                        "source_entry_id": "b8200310-79ab-33c6-a72d-06aaa91ce4d1",
                        "target_lang_word": "Handkuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handkuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                        "entry_id": "7d75aa21-87c6-39dc-a766-550a5efb508e",
                                        "glosses": [
                                            "das Küssen des Handrückens zur Begrüßung oder Verabschiedung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8353d861-3a74-4a47-851f-8f05a3194deb",
                                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                                "text": "Bisweilen begrüßte er die vornehmen Damen noch nach alter feiner Art mit einem Handkuss."
                                            },
                                            {
                                                "example_id": "ea5e53e2-8ae6-4ed1-9440-e07714ee7682",
                                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                                "text": "Beim Handkuss dürfen die Lippen niemals die Hände der Frau direkt berühren."
                                            },
                                            {
                                                "example_id": "12776a8f-aa37-4ef4-a91f-d9e62590f87f",
                                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                                "text": "Um einer Dame eine besondere Verehrung zu erweisen, kniet der Herr während des Handkusses vor ihr nieder."
                                            },
                                            {
                                                "example_id": "a059355f-bae7-4428-b06d-7907d9c916c3",
                                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                                "text": "Heute ist der Handkuss eher selten geworden."
                                            },
                                            {
                                                "example_id": "7b0126c9-8de9-455d-989c-1bf95eecf50c",
                                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                                "text": "Mit einem Handkuss verabschiedete sich der Herr von seiner Tanzpartnerin."
                                            },
                                            {
                                                "example_id": "32c9dc3e-e492-4349-813e-978909efd241",
                                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                                "text": "„Als Thomas sich bemerkbar machen wollte, kam ein weiterer Mann auf sie zu, der sie mit Handkuss begrüßte.“"
                                            },
                                            {
                                                "example_id": "196dac21-cd06-4322-be3c-5e4bad87bdab",
                                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                                "text": "„Unter Scherzen über das Abenteuer und Handküssen sagte ich ihr, ich sei davon überzeugt, daß ich sie von ihrer Gewitterangst geheilt hätte, daß sie aber niemandem das Geheimnis verraten werde, wem sie diese Heilung verdanke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "259c970b-5654-4be0-afce-3ceb6b4fd402",
