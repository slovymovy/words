                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made <w>lots</w> of new friends during her trip to Spain.",
                            "target_lang_translations": {
                                "ru": "Она завела <w>много</w> новых друзей во время поездки в Испанию.",
                                "zh": "她在西班牙旅行期间交了<w>许多</w>新朋友。",
                                "nl": "Ze heeft <w>veel</w> nieuwe vrienden gemaakt tijdens haar reis naar Spanje.",
                                "pl": "Podczas wyjazdu do Hiszpanii poznała <w>mnóstwo</w> nowych przyjaciół.",
                                "de": "Sie hat während ihrer Reise nach Spanien <w>viele</w> neue Freunde gefunden.",
                                "fr": "Elle s'est fait <w>beaucoup</w> de nouveaux amis pendant son voyage en Espagne.",
                                "it": "Ha fatto <w>un sacco di</w> nuovi amici durante il suo viaggio in Spagna.",
                                "cs": "Během svého výletu do Španělska si našla <w>spoustu</w> nových přátel.",
                                "tr": "İspanya gezisi sırasında <w>pek çok</w> yeni arkadaş edindi.",
                                "es": "Ella hizo <w>muchos</w> amigos nuevos durante su viaje a España."
                            }
                        },
                        {
                            "text": "Don't worry about the bill because my family has <w>lots</w> of money.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся о счете, потому что у моей семьи <w>куча</w> денег.",
                                "zh": "别担心账单，因为我家有<w>大量</w>资金。",
                                "nl": "Maak je geen zorgen over de rekening, want mijn familie heeft <w>ontzettend veel</w> geld.",
                                "pl": "Nie martw się o rachunek, bo moja rodzina ma <w>dużo</w> pieniędzy.",
                                "de": "Mach dir keine Sorgen wegen der Rechnung, denn meine Familie hat <w>eine Menge</w> Geld.",
                                "fr": "Ne t'inquiète pas pour la facture car ma famille a <w>plein d'</w>argent.",
                                "it": "Non preoccuparti del conto perché la mia famiglia ha <w>molti</w> soldi.",
                                "cs": "Nedělej si starosti s účtem, protože moje rodina má <w>hodně</w> peněz.",
                                "tr": "Hesap için endişelenme çünkü ailemin <w>bir sürü</w> parası var.",
                                "es": "No te preocupes por la cuenta porque mi familia tiene <w>mucho</w> dinero."
                            }
                        }
