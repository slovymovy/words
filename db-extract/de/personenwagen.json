                                        "glosses": [
                                            "Any vehicle designed to run on rails, especially an unpowered one towed by being connected to others.",
                                            "A passenger-carrying unit in a subway or elevated train, whether powered or not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a77528-6797-4fa7-aad9-ee5cd08e74ab",
                                                "sense_id": "d85edf85-0346-3b8d-997c-61f6eadb223c",
                                                "text": "From the frontmost car of the subway, he filmed the progress through the tunnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96395820-b671-32d4-b638-efe6ef0a3c65",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "Any vehicle designed to run on rails, especially an unpowered one towed by being connected to others.",
                                            "A rough unit of quantity approximating the amount which would fill a railroad car."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47589848-26f9-4291-bbce-a6894c8d5b5d",
                                                "sense_id": "96395820-b671-32d4-b638-efe6ef0a3c65",
                                                "text": "We ordered five hundred cars of gypsum."
                                            },
                                            {
                                                "example_id": "f4f23526-8e76-4785-b937-8ed9c1aaf614",
                                                "sense_id": "96395820-b671-32d4-b638-efe6ef0a3c65",
                                                "text": "This market reports only one or two cars per day, selling by the hundred weight, and at a price a little lower than that of Indian corn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "539b3280-42f1-3c9b-a29f-8409f0c11395",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "The moving, load-carrying component of an elevator or other cable-drawn transport mechanism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c44802-6e39-41fc-898f-1fdf2a445d2b",
                                                "sense_id": "539b3280-42f1-3c9b-a29f-8409f0c11395",
                                                "text": "Fix the car of the express elevator - the door is sticking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f4f50a-5050-3f41-a4b6-1514f91ead6b",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "The passenger-carrying portion of certain amusement park rides, such as Ferris wheels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e14ef0-8015-48a5-9ffa-1f7bd66f3c81",
                                                "sense_id": "48f4f50a-5050-3f41-a4b6-1514f91ead6b",
                                                "text": "The most exciting part of riding a Ferris wheel is when your car goes over the top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "624ea633-360b-3eb4-88d2-d2c7eda4e683",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "The part of an airship, such as a balloon or dirigible, which houses the passengers and control apparatus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a764df-a10d-4c69-8a84-d7286c1e345f",
                                                "sense_id": "624ea633-360b-3eb4-88d2-d2c7eda4e683",
                                                "text": "Everything being apparently in readiness now, I stepped into the car of the balloon, […]"
                                            },
                                            {
                                                "example_id": "6503578c-b73b-4056-b7d0-ee47a59f50cf",
                                                "sense_id": "624ea633-360b-3eb4-88d2-d2c7eda4e683",
                                                "text": "\"What about a car?\" \"The car will be my next care. I have already planned how it is to be made and attached. Meanwhile I will simply show you how capable my apparatus is of supporting the weight of each of us.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d92650-4082-3146-8b34-65953dc39c54",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A sliding fitting that runs along a track."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea829c15-e074-4346-8543-adc9131e4e2b",
                                                "sense_id": "23d92650-4082-3146-8b34-65953dc39c54",
                                                "text": "On boats 25 feet or more, it is best to mount a mast car and track on the front of the mast so you can adjust the height of the pole above the deck"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd39150b-0912-33f9-b86b-898002e263ad",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "The aggregate of desirable characteristics of a car."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6ef2c22-cfc9-4dc5-80ff-a0f2340e9101",
                                                "sense_id": "bd39150b-0912-33f9-b86b-898002e263ad",
                                                "text": "Buy now! You can get more car for your money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cbdca4c-4b07-352b-bd93-05b70b5da923",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A floating perforated box for living fish."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b0c2d57-0c54-36d1-83b0-50a81858a3c9",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "A clique or gang."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d4a2514-8782-3e9c-8abc-4c243fa478c0",
                                        "entry_id": "bd7e6d1e-016e-3058-8bef-aec63fb0b338",
                                        "glosses": [
                                            "Deliberate misspelling of cat."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "alt-of",
                                            "deliberate",
                                            "humorous",
