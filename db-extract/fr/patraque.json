                                        "sense_id": "eb3ed231-ef76-3655-b9d7-92e282105142",
                                        "entry_id": "e100e3ff-4072-3c00-8542-b3f51eeb7819",
                                        "glosses": [
                                            "Ware, die aufgrund ihrer geringen Qualität nicht verkauft, nicht abgesetzt werden konnte"
