                        ],
                        "form": "износи́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a264b75c-9138-3f9d-82c7-d4b6f1d1518e",
                        "entry_id": "2a83a262-f4d4-35bb-bd06-7b0a69928821",
                        "glosses": [
                            "привести в негодность (одежду, обувь и т. п.) в результате носки"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "27628d73-5035-3776-a75e-abe8b39e12ca",
                        "entry_id": "2a83a262-f4d4-35bb-bd06-7b0a69928821",
                        "glosses": [
                            "привести в негодность (машины, механизмы и т. п.) в процессе работы, длительного использования"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4541b69d-0df3-48fe-8798-4bc5a809dd7c",
                        "source_entry_id": "2a83a262-f4d4-35bb-bd06-7b0a69928821",
                        "source_sense_description": "привести в негодность в результате носки",
                        "target_lang_word": "wear out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wear out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40b0faec-5082-31f7-b7ff-8382ae174e14",
                                        "entry_id": "1e85d4d5-ff59-3f6c-be93-9054d803a232",
                                        "glosses": [
                                            "To cause (something) to become damaged, useless, or ineffective through continued use, especially hard, heavy, or careless use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d727878-b02e-458b-8578-c77e15aa9df6",
                                                "sense_id": "40b0faec-5082-31f7-b7ff-8382ae174e14",
                                                "text": "You're going to wear out that game if you keep playing so rough with it."
                                            },
                                            {
                                                "example_id": "305be31c-f2f7-448c-b30b-d6e6761b6056",
                                                "sense_id": "40b0faec-5082-31f7-b7ff-8382ae174e14",
                                                "text": "He wears a pair of tennis shoes out every summer."
                                            },
                                            {
                                                "example_id": "0f868dc7-f9e4-4022-aeb7-5953f808b74e",
                                                "sense_id": "40b0faec-5082-31f7-b7ff-8382ae174e14",
                                                "text": "\"You never take the trouble to see if he will go without it; your whip is always going as if you had the St. Vitus' dance in your arm; and if it does not wear you out, it wears your horse out; you know you are always changing your horses, and why? because you never give them any peace or encouragement.\""
                                            },
                                            {
                                                "example_id": "d00955b4-3a0b-43d5-a492-05dfd59aaae9",
                                                "sense_id": "40b0faec-5082-31f7-b7ff-8382ae174e14",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9379f98f-7209-35e6-a4c4-8b0880f93618",
                                        "entry_id": "1e85d4d5-ff59-3f6c-be93-9054d803a232",
                                        "glosses": [
                                            "To deteriorate or become unusable or ineffective due to continued use, exposure, or strain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "595087a8-f28c-4171-8ee1-d458985f9c66",
                                                "sense_id": "9379f98f-7209-35e6-a4c4-8b0880f93618",
                                                "text": "The old tractor finally wore out."
                                            },
                                            {
                                                "example_id": "17f7b109-092f-4b63-a4e0-7b9bc7817cee",
                                                "sense_id": "9379f98f-7209-35e6-a4c4-8b0880f93618",
                                                "text": "My shoes wear out quickly now that I walk to work."
                                            },
                                            {
                                                "example_id": "bc63cfb2-548d-47df-aed9-96e3062bcae7",
                                                "sense_id": "9379f98f-7209-35e6-a4c4-8b0880f93618",
                                                "text": "Mr. Simpson adds that the station at Stanmore appears practically unchanged from the time of its opening, even to the L.N.W.R. rubber doormat, which \"shows no signs of wearing out.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d68682-e77e-30bb-8140-fde6e7790aad",
                                        "entry_id": "1e85d4d5-ff59-3f6c-be93-9054d803a232",
                                        "glosses": [
                                            "To exhaust; to cause or contribute to another's exhaustion, fatigue, or weariness, as by continued strain or exertion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18fec1cc-81e3-4f40-a8fd-e15a5405fcf8",
                                                "sense_id": "d9d68682-e77e-30bb-8140-fde6e7790aad",
                                                "text": "You kids are wearing me out!"
                                            },
                                            {
                                                "example_id": "1aff4e38-b74d-4b48-98b3-f1ac216cf30b",
                                                "sense_id": "d9d68682-e77e-30bb-8140-fde6e7790aad",
                                                "text": "Trying to keep up with politics wears me out."
                                            },
                                            {
                                                "example_id": "4ba45a3c-918c-46ed-a847-ec34ef9ba1da",
                                                "sense_id": "d9d68682-e77e-30bb-8140-fde6e7790aad",
                                                "text": "Our physical advantage allowed us to wear the other team out and win."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2af4f1a-b4f8-395f-b1d5-b0aa94682ebd",
                                        "entry_id": "1e85d4d5-ff59-3f6c-be93-9054d803a232",
                                        "glosses": [
                                            "To become exhausted, tired, fatigued, or weary, as by continued strain or exertion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e03d617-a605-4537-ac0b-8c5cf19bc6c0",
                                                "sense_id": "c2af4f1a-b4f8-395f-b1d5-b0aa94682ebd",
                                                "text": "I'm wearing out, guys. Time to go to sleep."
                                            },
                                            {
                                                "example_id": "dc0a86e9-0e7d-4415-bf52-44fce3c03b99",
                                                "sense_id": "c2af4f1a-b4f8-395f-b1d5-b0aa94682ebd",
                                                "text": "They built our railways, but they wore themselves out in the process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f310076d-0c20-33ce-a617-575f996b81c9",
                                        "entry_id": "1e85d4d5-ff59-3f6c-be93-9054d803a232",
                                        "glosses": [
                                            "Of apparel, to display in public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7fefad3-3f29-4c3e-92be-558e5f215a1a",
                                                "sense_id": "f310076d-0c20-33ce-a617-575f996b81c9",
                                                "text": "Those sweatpants are great for loafing around the house, but they're not meant to be worn out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed58ce23-9d77-37d4-a8a8-c8c70aaed8e0",
                                        "entry_id": "1e85d4d5-ff59-3f6c-be93-9054d803a232",
                                        "glosses": [
                                            "Of a shirt, to not tuck into the pants; to wear in a casual manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c89ec9-3234-44da-be36-45ab65a0a128",
                                                "sense_id": "ed58ce23-9d77-37d4-a8a8-c8c70aaed8e0",
                                                "text": "A dress shirt should be tucked in, but a t-shirt can be worn out."
