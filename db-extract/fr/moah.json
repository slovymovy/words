                            {
                                "example_id": "690c77d7-1cfa-4a4a-ac5d-96075563e1e1",
                                "sense_id": "2859d28f-f284-3d24-b108-6fa8636b904f",
                                "text": "Pour le riz par exemple, sept marques ont été testées en France: la quantité d’huiles MOSH (hydrocarbures saturées) peut varier de 0 à 5 mg/kg, celle de MOAH (hydrocarbures aromatiques) de 0 à 1,1 mg/kg."
                            },
                            {
                                "example_id": "d632a339-af66-45af-93c9-aa062f09d94f",
                                "sense_id": "2859d28f-f284-3d24-b108-6fa8636b904f",
                                "text": "Les MOAH sont très préoccupants. Ils sont soupçonnés d'être cancérogènes et mutagènes."
                            }
                        ]
