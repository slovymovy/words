                                "example_id": "c8915e01-55a1-45a6-b459-2448875beaae",
                                "sense_id": "000b8f02-55b7-3f6d-82fb-274bc51986c7",
                                "text": "DRM can't stop piracy, but it can prevent anyone from Betamaxing another industry, commercializing disruptive technology development without content-industry sanction."
                            },
                            {
                                "example_id": "8fec5fdb-33ac-427f-bc36-839270957ac5",
                                "sense_id": "000b8f02-55b7-3f6d-82fb-274bc51986c7",
                                "text": "CRIMM RDRAM offered dramatic possibilities for high-speed PCs but ran into three roadblocks that Betamaxed it."
