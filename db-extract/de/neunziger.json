                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da2c69f4-657f-45b5-a4f1-41a1c617162b",
                                "sense_id": "82993157-08e5-3e22-bd87-a517c0f6128d",
                                "text": "„Ja, möchte man das seufzen, so waren die Neunziger, scheinbar eine Oase der sexuellen Befreiung.“"
                            },
                            {
                                "example_id": "de176083-6ff0-4fb8-802f-f85a009c091d",
                                "sense_id": "82993157-08e5-3e22-bd87-a517c0f6128d",
                                "text": "„Donnerstagnachmittags schaue ich nach dem Mann in seinen Neunzigern, bei dem immer der Fernseher läuft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
