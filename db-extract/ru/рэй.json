                ],
                "senses": [
                    {
                        "sense_id": "5ba0f599-e87b-3a01-b2e7-851aadacb3ac",
                        "entry_id": "b3001c42-51a5-3e2f-b19d-0dfd3df253e9",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c701e3ab-4cce-4f09-9cb2-407d52fb838e",
                                "sense_id": "5ba0f599-e87b-3a01-b2e7-851aadacb3ac",
                                "text": "Ребёфинг (от англ. rebirthing — второе рождение) — психотерапевтическая методика, разработанная Л. Орром и С. Рэй в 1977 г."
                            },
                            {
                                "example_id": "d52261e1-6ec2-4007-88b6-39d2b9dd5f4b",
                                "sense_id": "5ba0f599-e87b-3a01-b2e7-851aadacb3ac",
                                "text": "В одном из рассекреченных документов говорится, что в конце января 2018 года в Вашингтон должен прилететь некто (имя скрыто из документа), попросивший о встрече с директором ФБР Кристофером Рэем."
                            }
                        ]
                    }
                ],
