                "senses": [
                    {
                        "sense_id": "f588568b-31a4-33b8-980b-1f83eab3e16e",
                        "entry_id": "ea8647b9-388e-3cf6-8f6c-2d20330f5ea3",
                        "glosses": [
                            "S’adonner au téléachat."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "081be3d4-f16f-4522-b9fb-82992f0318c3",
                                "sense_id": "f588568b-31a4-33b8-980b-1f83eab3e16e",
                                "text": "Ils permettent de gérer non seulement la voie descendante mais aussi la voie remontante pour que le consommateur puisse « télévoter », « téléacheter » ou commander le visionnement d'un film à distance grâce à une télévidéothèque."
                            },
                            {
                                "example_id": "4681abdc-99eb-490e-91ac-00464ea1256c",
                                "sense_id": "f588568b-31a4-33b8-980b-1f83eab3e16e",
                                "text": "On peut se déplacer pour acheter mais aussi pour voir, toucher, goûter, sentir puis commander; on peut téléacheter complètement en se faisant livrer ou en téléchargeant les produits."
                            }
                        ]
                    }
