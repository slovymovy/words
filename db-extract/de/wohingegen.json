                                "example_id": "ceeab6cc-7439-4a4d-87bc-e434034ab740",
                                "sense_id": "90aa6cdf-9f2b-3ba4-9ef5-2fc2a39ba04a",
                                "text": "Er ging nach Hause, wohingegen sie dablieb.",
                                "translation": "Il rentra chez lui, alors qu’elle resta."
                            },
                            {
                                "example_id": "783d56d0-d2b1-4fee-905b-325dd927192a",
                                "sense_id": "90aa6cdf-9f2b-3ba4-9ef5-2fc2a39ba04a",
                                "text": "Der Sommer war dieses Jahr sehr schön, wohingegen der Frühling kalt und verregnet war.",
                                "translation": "L’été a été très beau cette année alors que le printemps était froid et pluvieux."
                            }
                        ]
