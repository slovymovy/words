                        "entry_id": "8b05154e-e740-3b72-8334-3d5dbe78d5d0",
                        "glosses": [
                            "A former French unit of length, corresponding to about 1.949 metres."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3d78c1e8-c9a6-4ba4-8361-619993c5d4ef",
                                "sense_id": "d7975a05-9d85-3dba-a989-4cf6d2b34619",
                                "text": "[…] the greater its speed, the less visible it grows, until at around a Thousand Toises per Minute, it vanishes entirely […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80dccda4-da10-415f-ac2e-d23752a4fca3",
