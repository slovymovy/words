                                "target_senses": [
                                    {
                                        "sense_id": "43289cd2-c368-3195-bb47-5dbd4dc7c0e4",
                                        "entry_id": "2ecbd77e-13bf-3dec-9df5-96d86d2d4758",
                                        "glosses": [
                                            "Humbly, of or from low social status; basely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33462114-6192-4f2b-bc70-88ef8789c2fa",
                                                "sense_id": "43289cd2-c368-3195-bb47-5dbd4dc7c0e4",
                                                "text": "Iphicrates and Marius were meanly born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1965c79a-61ba-3f94-8463-32d7cfbaecc5",
                                        "entry_id": "2ecbd77e-13bf-3dec-9df5-96d86d2d4758",
                                        "glosses": [
                                            "Poorly or inadequately."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "331f9c56-206d-3cfe-8310-10aec17acc47",
                                        "entry_id": "2ecbd77e-13bf-3dec-9df5-96d86d2d4758",
                                        "glosses": [
                                            "In a mean manner; ill-willed, nastily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9bd6d95-311f-469e-a45f-ab71221663c5",
                                                "sense_id": "331f9c56-206d-3cfe-8310-10aec17acc47",
                                                "text": "He meanly refused to ever make a charitable donation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "199f5636-13ca-46d3-89ab-4f4a71cdb777",
                        "source_entry_id": "ef516cc6-c030-3f8c-88a7-5910f53b995e",
                        "source_sense_id": "f8de4da6-b3a9-3a31-942a-8bf375c698a8",
                        "target_lang_word": "narrow-mindedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narrow-mindedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59162dae-8cb5-3f04-bf00-110eaf55ea1c",
                                        "entry_id": "331f4f93-46d8-3557-a86e-516570bc3066",
                                        "glosses": [
                                            "In a narrow-minded manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13597d39-50dd-4d13-b50d-5ac318dc8b63",
                                                "sense_id": "59162dae-8cb5-3f04-bf00-110eaf55ea1c",
                                                "text": "'Funny,' I said, 'that she should be quite so narrow-mindedly English when you think that she spent five years in India.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dac7a6c6-99e5-4816-8ad0-e5a2daeead52",
                        "source_entry_id": "ef516cc6-c030-3f8c-88a7-5910f53b995e",
                        "source_sense_id": "f8de4da6-b3a9-3a31-942a-8bf375c698a8",
                        "target_lang_word": "niggardly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niggardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36cd23c8-8d90-322f-9994-bb8147388acc",
                                        "entry_id": "665d1936-4d89-36b5-ad25-cb04a1dc0b05",
                                        "glosses": [
                                            "Withholding for the sake of meanness; stingy, miserly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a19336-efb3-4b2d-bd78-64ed82b35898",
                                                "sense_id": "36cd23c8-8d90-322f-9994-bb8147388acc",
                                                "text": "[W]here the owner of the house will be bountiful, it is not for the steward to be niggardly."
                                            },
                                            {
                                                "example_id": "bb50015a-440e-475d-b57f-54f0e7ce4b31",
                                                "sense_id": "36cd23c8-8d90-322f-9994-bb8147388acc",
                                                "text": "They were not niggardly, these tramps, and he who had money did not hesitate to share it among the rest."
                                            },
                                            {
                                                "example_id": "2772d7b8-7368-4aba-aaeb-7b40017b49a7",
                                                "sense_id": "36cd23c8-8d90-322f-9994-bb8147388acc",
                                                "text": "This manifests itself in an implacable tendency to provide an opulent supply of some things and a niggardly yield of others."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "niggardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0dab43-cee7-3397-8fb5-b694cc125012",
                                        "entry_id": "2604ce20-9fde-32d0-bde3-85cc2b4ecc5d",
                                        "glosses": [
                                            "In a parsimonious way; sparingly, stingily."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52be1865-c105-4a45-a625-269cc04ec2ef",
                                                "sense_id": "dc0dab43-cee7-3397-8fb5-b694cc125012",
                                                "text": "because many families are compelled to live niggardly, exhaust and undone by great dowers, none shall be given at all, or very little […]."
                                            }
                                        ]
                                    }
                                ]
                            }
