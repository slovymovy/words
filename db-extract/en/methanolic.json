                "senses": [
                    {
                        "sense_id": "d12250be-c647-3a1f-99f3-77df66cd99da",
                        "entry_id": "b3671a1a-bc48-3fdd-8662-ad37c1b0985e",
                        "glosses": [
                            "A compound that contains methanol."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "005f47cc-944e-459f-a352-ba10d0d1e089",
                                "sense_id": "d12250be-c647-3a1f-99f3-77df66cd99da",
                                "text": "The residue was now an amorphous powder, which could be almost completely dissolved in 250 cc. of warm methanol. This methanolic was treated with decolorizing charcoal, filtered, and concentrated, yielding small white cubic crystals, […]"
                            },
                            {
                                "example_id": "62ca25e7-06a2-4fc6-92e1-1fce5e226694",
                                "sense_id": "d12250be-c647-3a1f-99f3-77df66cd99da",
                                "text": "The isolates tested showed the highest susceptibility to the extracts with higher phenolic compounds content, ie the methanolics."
                            },
                            {
                                "example_id": "75f45aa7-8d5d-4e9b-be7d-965ee18a281a",
                                "sense_id": "d12250be-c647-3a1f-99f3-77df66cd99da",
                                "text": "Methanolics and aqueous leaf extracts revealed the presences of alkaloids, tannins, phenols and flavonoid in high amount in most of the plants."
                            },
                            {
                                "example_id": "cd72c4fc-a676-4f49-b8c7-675217f8ff39",
                                "sense_id": "d12250be-c647-3a1f-99f3-77df66cd99da",
                                "text": "The residues remaining from removal of free methanolics after the heat treatments described in above section were subjected to hydrolysis with 25 ml of alkaline solution (0.1 M NaOH; pH 12.0) at 24°C/12 hr and then subjected to centrifugation for 10 min at 10,000 × g."
                            },
                            {
                                "example_id": "666a145b-05a6-4307-bff0-a2d64bb93425",
                                "sense_id": "d12250be-c647-3a1f-99f3-77df66cd99da",
                                "text": "The P. nodiflora methanolic was studied for antidiabetic effect in streptozotocin-induced diabetic rats."
                            }
                        ]
                    }
