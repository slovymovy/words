                "senses": [
                    {
                        "sense_id": "207295fc-5ceb-322d-a944-a213c2fb9d92",
                        "entry_id": "b908f40b-768b-3dc1-ac3d-0f71f3b02736",
                        "glosses": [
                            "die unbeabsichtigte Vertauschung zweier Ziffern einer Zahlenfolge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a193e60b-6230-4a7d-bc1b-345c206c3d73",
                                "sense_id": "207295fc-5ceb-322d-a944-a213c2fb9d92",
                                "text": "Wegen eines Zahlendrehers bei der Eingabe der Kreditkartennummer wurde der Zahlungsvorgang abgebrochen."
                            },
                            {
                                "example_id": "44091d8b-e2e6-4593-83a9-43db559a47cf",
                                "sense_id": "207295fc-5ceb-322d-a944-a213c2fb9d92",
                                "text": "„Wegen eines Zahlendrehers in der Iban-Nummer, wie die Kontonummer mit 22 Stellen seit den neuen einheitlichen Richtlinien im europäischen Zahlungsverkehr heißt, kam das Geld jedoch nicht dort an, wo es hinsollte.“"
                            },
                            {
                                "example_id": "4ca848f0-b791-42ea-9678-a44ebdcb5183",
                                "sense_id": "207295fc-5ceb-322d-a944-a213c2fb9d92",
                                "text": "„Die Folge: haufenweise Zahlendreher beim Notieren von Telefonnummern, fehlerhafte Buchführung in Unternehmen.“"
                            },
                            {
                                "example_id": "35ca746e-10c0-413c-9ca0-d25dbc07ce93",
                                "sense_id": "207295fc-5ceb-322d-a944-a213c2fb9d92",
                                "text": "„Wir sprechen also Zahlendreher, haben eine verdrehte Zahlensprechweise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
