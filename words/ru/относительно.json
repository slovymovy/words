                    "sense_definition": "В некоторой степени, сравнительно с чем-либо; не абсолютно.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это было <w>относительно</w> лёгкое задание для студентов.",
                            "target_lang_translations": {
