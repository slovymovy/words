                        "examples": [
                            {
                                "example_id": "7739dbd0-23e4-48dd-af1e-11234b95702b",
                                "sense_id": "26146d7a-9f3f-3dfe-a427-0d8d7040d2fa",
                                "text": "Overbehandeling, overcapaciteit en verspilling gaan wij te lijf. Zo gaat een bezoek aan de eerste hulp meer geld kosten. Op deze manier werken wij aan kostenbewustzijn en kostenbeheersing maar ook aan een solidair stelsel voor de toekomst."
                            },
                            {
                                "example_id": "3b3986b8-fe32-4c96-8568-5c2a5a51bed5",
                                "sense_id": "26146d7a-9f3f-3dfe-a427-0d8d7040d2fa",
                                "text": "Minister Melanie Schultz van Haegen (VVD, Water) reageerde donderdag bezorgd. 'Ik maak me nog steeds zorgen. Het kostenbewustzijn moet echt omhoog.'"
                            },
                            {
                                "example_id": "087ef9ae-d186-4e32-bb69-74ce26970234",
                                "sense_id": "26146d7a-9f3f-3dfe-a427-0d8d7040d2fa",
                                "text": "„Verzekeraars meldden bijvoorbeeld dat er bij veel ziekenhuizen iets echt niet goed gaat”, aldus Wijnbeek. Ze zegt dat de toename van patiëntenmeldingen verband kan houden met een hoger kostenbewustzijn. Zorgkosten zijn tegenwoordig beter inzichtelijk. De patiënt kan ze inzien binnen de afgeschermde omgeving van de site van zijn verzekeraar."
                            }
                        ]
