                                "target_senses": [
                                    {
                                        "sense_id": "18299659-7368-3b7f-b9c3-d0034f3cb628",
                                        "entry_id": "03604b74-73bb-3d1a-b228-23c0825c3877",
                                        "glosses": [
                                            "Adjectif ordinal, correspondant au cardinal quatorze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4263ae2b-cc81-444a-9447-89d0377defa7",
                                                "sense_id": "18299659-7368-3b7f-b9c3-d0034f3cb628",
                                                "text": "L’objet que fabrique vingt-quatre heures sur vingt-quatre la presse confiée à Bernard Busard, est un carrosse Louis quatorzième, aux angles surmontés de plumets. Un jouet, qu’on peut acheter au rayon Enfants de certains magasins à succursales multiples."
                                            },
                                            {
                                                "example_id": "3e16f617-a035-4d04-8ad4-d4f375f1a721",
                                                "sense_id": "18299659-7368-3b7f-b9c3-d0034f3cb628",
                                                "text": "Le major Parker et le docteur le suivirent dans la rue, mais Aurelle, qui rimaillait encore, resta avec le Padre qui recommençait la même réussite pour la quatorzième fois de la soirée."
                                            },
                                            {
                                                "example_id": "72eef19b-c18d-4460-80d1-3ca42ae3af54",
                                                "sense_id": "18299659-7368-3b7f-b9c3-d0034f3cb628",
                                                "text": "Le quatorzième amendement de la Constitution américaine, rédigé pour exclure du Congrès les traîtres confédérés de la guerre de Sécession, est clair. Ne peut être sénateur ou représentant quiconque ayant prêté serment de soutenir la Constitution des États-Unis s’engage dans une insurrection ou une rébellion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quatorzième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e43ff2bf-13d0-3d76-af00-b7a16f0cca06",
                                        "entry_id": "5decf143-226e-396c-b615-8e8d26318a10",
                                        "glosses": [
                                            "Chaque partie d’un tout qui est ou que l’on conçoit divisé en quatorze parties égales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78161951-7631-4e3b-a5e4-5584ad5c34c7",
                                                "sense_id": "e43ff2bf-13d0-3d76-af00-b7a16f0cca06",
                                                "text": "La quatorzième partie, le quatorzième, un quatorzième."
                                            },
                                            {
                                                "example_id": "0e004dc7-71b8-44ae-a4c6-678650a4de42",
                                                "sense_id": "e43ff2bf-13d0-3d76-af00-b7a16f0cca06",
                                                "text": "Il est dans cette affaire pour un quatorzième."
                                            },
                                            {
                                                "example_id": "e23d504d-3b03-4460-bcac-6833a9f896c6",
                                                "sense_id": "e43ff2bf-13d0-3d76-af00-b7a16f0cca06",
                                                "text": "Le quatorzième de la lune, le quatorzième jour de la lune."
                                            },
                                            {
                                                "example_id": "1cf5660b-d072-4648-b1c6-eac7dc09970a",
                                                "sense_id": "e43ff2bf-13d0-3d76-af00-b7a16f0cca06",
                                                "text": "Donnez-moi le quatorzième de ces gâteaux."
                                            },
                                            {
                                                "example_id": "27af79e0-c39e-40da-aa66-80f77aa1492e",
                                                "sense_id": "e43ff2bf-13d0-3d76-af00-b7a16f0cca06",
                                                "text": "Donnez-moi le quatorzième de ce gâteau."
                                            },
                                            {
                                                "example_id": "4e7ee58b-4f4f-40d0-ac65-d95ba04d815b",
                                                "sense_id": "e43ff2bf-13d0-3d76-af00-b7a16f0cca06",
                                                "text": "Osiris est déchiré et émasculé. Le quatorzième morceau de son corps, introuvable, est son sexe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d827ce28-4479-303d-886a-83a6530d77a6",
                                        "entry_id": "5decf143-226e-396c-b615-8e8d26318a10",
                                        "glosses": [
                                            "Élément ordinal, correspondant au cardinal quatorze.\\n#* Vous êtes le quatorzième sur la liste.\\n#* Le quatorzième précède le quinzième et suit le treizième.\\n#* Donnez-moi le quatorzième gâteau."
                                        ],
