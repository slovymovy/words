                "senses": [
                    {
                        "sense_id": "add9ab3a-94a6-35c5-9f4c-f79a5eae4e48",
                        "entry_id": "cf0711ac-4894-38f5-86a2-8a1ac7bfad8e",
                        "glosses": [
                            "Unterkunft für Lehrlinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e40ef1d-5da2-4d20-80cf-1c1a3b174744",
                                "sense_id": "add9ab3a-94a6-35c5-9f4c-f79a5eae4e48",
                                "text": "„Sie wurden in einer Lehrlingsherberge untergebracht, bis geklärt war, woher sie kamen.“"
                            },
                            {
                                "example_id": "17e61b9e-f5b6-4c6f-9510-c30ed22fc233",
                                "sense_id": "add9ab3a-94a6-35c5-9f4c-f79a5eae4e48",
                                "text": "„In dem 27. Bericht der evangelischen Stadtpfarrgemeinde A.B. in Kronstadt finden wir interessante Informationen über die Lehrlingsherberge, deren Bau auch heute noch die fast ganz verbaute Schützenwiese beherrscht.“"
                            },
                            {
                                "example_id": "b896f5ce-af16-4688-a8bb-be6aeb0dfebc",
                                "sense_id": "add9ab3a-94a6-35c5-9f4c-f79a5eae4e48",
                                "text": "„Trotzdem wurden in dieser Zeit große Bauvorhaben verwirklichst: Reparaturen an der Schwarzen Kirche, Sportplatz, Lehrlingsherberge, Kindergarten.“"
                            },
                            {
                                "example_id": "7b37d2f9-6cef-4d48-a3e7-c7b5d2adf3d3",
                                "sense_id": "add9ab3a-94a6-35c5-9f4c-f79a5eae4e48",
                                "text": "„1909 beginnt der Kölner Eifelverein damit, unabhängig vom Hauptverein, Lehrlingsherbergen in der Eifel einzurichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
