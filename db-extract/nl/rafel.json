                        "target_lang_word": "effilochure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effilochure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf75efb-dc5a-3074-9144-b7c7bd2f11c8",
                                        "entry_id": "b85fa69f-1c3c-3ba6-b8db-5c01b31bfb28",
                                        "glosses": [
                                            "Bout de fil qui s’effiloche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e18ee6f9-b82e-390f-acd8-710706b78825",
                                        "entry_id": "b85fa69f-1c3c-3ba6-b8db-5c01b31bfb28",
                                        "glosses": [
                                            "Résultat de l’effilochage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848d8b0a-7ebc-445a-8ba3-03f9adc06e8b",
                                                "sense_id": "e18ee6f9-b82e-390f-acd8-710706b78825",
                                                "text": "Des coups de brise montent par moment de la vallée, ébouriffent les effilochures de la corde, remuent doucement un très vieil anneau blanchi qui achève de pourrir à l’angle proche d’un rocher."
                                            },
                                            {
                                                "example_id": "00e6da7b-298a-4fd1-9406-0afccf37bf31",
                                                "sense_id": "e18ee6f9-b82e-390f-acd8-710706b78825",
                                                "text": "Pas une tache, pas un accroc, pas une effilochure ne devaient troubler la pureté de notre travail."
                                            },
                                            {
                                                "example_id": "fd19f7bc-bb47-48b7-a3f6-53d2d6e16ae6",
                                                "sense_id": "e18ee6f9-b82e-390f-acd8-710706b78825",
                                                "text": "Il pendait en guirlandes de loques autour de moi, serré à la taille par une ficelle, frissonnant dans le lit du vent aigre de toutes ses effilochures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17218f25-995f-4489-a32b-0413e5175ccd",
                        "source_entry_id": "cd36c832-3309-3819-85b6-79821a90e825",
                        "source_sense_id": "9821f341-a4b6-306a-8374-6d747d1c9d87",
                        "source_sense_description": "een losgeraakte draad van een weefsel",
                        "target_lang_word": "éraillure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éraillure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c70d8926-f264-38d6-a841-8ce6a3cae94a",
                                        "entry_id": "8f8e38fa-6f1e-3038-be4a-71829a162221",
                                        "glosses": [
                                            "Marque qui reste à un tissu quand il est éraillé. Endroit éraillé du tissu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b628c8b-de0d-4e47-bcd5-7c64964120cd",
                                                "sense_id": "c70d8926-f264-38d6-a841-8ce6a3cae94a",
                                                "text": "Ce n'était point une linition douce, une fomentation onctueuse, mais un massage vigoureux, pratiqué à bras raccourcis, et qui rappelait plutôt les éraillures de l'étrille que les caresses de la main."
                                            },
                                            {
                                                "example_id": "408b6a6c-70e4-4277-9f86-66ff0145b3a7",
                                                "sense_id": "c70d8926-f264-38d6-a841-8ce6a3cae94a",
                                                "text": "5A - Détermination de la résistance à l'éraillure, méthode dite \"des lames de scie\"\n5B - Détermination de la résistance à l'éraillure, méthode dite \"des masselottes\" (1/3)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21fb98c6-d48e-3090-ab15-6464c9503917",
                                        "entry_id": "8f8e38fa-6f1e-3038-be4a-71829a162221",
                                        "glosses": [
                                            "Usure d'adhérence. Phénomène qui se produit lorsque des surfaces de glissement entrent en contact et que des fragments de l'une sont arrachés et se collent sur l'autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed51b7c-881d-4472-ac04-04cdcb4ddb70",
                                                "sense_id": "21fb98c6-d48e-3090-ab15-6464c9503917",
                                                "text": "La douille intérieure a été déposée, et on a observé une importante éraillure irrégulière sur toute la circonférence de la surface extérieure de la douille intérieure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
