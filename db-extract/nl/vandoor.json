                                    {
                                        "sense_id": "c6c12515-fe8d-3458-b6fd-adae21f131a3",
                                        "entry_id": "d3c3f48a-b66f-379b-bb7e-ac358947bf9a",
                                        "glosses": [
                                            "einen Ort mit einem Fahrzeug fahrend verlassen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f28b19-9e6f-48c7-a329-b00a4db13769",
                                                "sense_id": "c6c12515-fe8d-3458-b6fd-adae21f131a3",
                                                "text": "Die Nachbarin habe dann bei ihr angeklopft und dabei gesehen, dass die beiden Personen davongefahren und der Beifahrer auf der rechten Seite eine Pistole getragen habe."
                                            },
                                            {
                                                "example_id": "1fc244f0-0b8c-4237-81e5-2fc5baab3c7e",
                                                "sense_id": "c6c12515-fe8d-3458-b6fd-adae21f131a3",
                                                "text": "Der Vater hatte laut Anklageschrift im Oktober 2018 die Kinder eilends ins Auto gepackt und war mit ihnen davongefahren, ohne die Mutter oder sonst jemanden zu informieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a5ef778-526b-33cf-b8af-4b5e5b0f50da",
                                        "entry_id": "d3c3f48a-b66f-379b-bb7e-ac358947bf9a",
                                        "glosses": [
                                            "einen Verfolger beschleunigend hinter sich lassen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee231af-d63d-4328-9399-90bed4ecb43b",
                                                "sense_id": "5a5ef778-526b-33cf-b8af-4b5e5b0f50da",
                                                "text": "\"Wir sind selbst überrascht gewesen, mit welcher Leichtigkeit Max dem Rest des Feldes eineinhalb Sekunden pro Runde davongefahren ist\", sagt der Österreicher gegenüber 'ServusTV'."
                                            },
                                            {
                                                "example_id": "c2cc30d7-df7b-43bd-ae78-7667b1c0e1bf",
                                                "sense_id": "5a5ef778-526b-33cf-b8af-4b5e5b0f50da",
                                                "text": "Der Lenker hatte sich einer Polizeikontrolle entzogen und war der Exekutive davongefahren - erst nach zwei Unfällen kam das Fahrzeug des Flüchtenden zum Stillstand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
