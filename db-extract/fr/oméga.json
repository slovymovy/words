                ],
                "translations": [
                    {
                        "translation_id": "c1b4e569-3242-42f3-9796-9aabc170a37e",
                        "source_entry_id": "7a866e52-b1dc-3cd8-b704-ffcf1e5bc48b",
                        "target_lang_word": "omega",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omega",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f1ced80-69f5-33c0-8ef5-229d038b82c8",
                                        "entry_id": "abd2e511-5f65-3145-aaf7-9dd1cdb03b2b",
                                        "glosses": [
                                            "The twenty-fourth letter of the Classical and the Modern Greek alphabet, and the twenty-eighth letter of the Old and the Ancient Greek alphabet, i.e. the last letter of every Greek alphabet. Uppercase version: Ω; lowercase: ω."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bf8f436-4098-4274-a2c6-29da5f7a97ae",
                                                "sense_id": "8f1ced80-69f5-33c0-8ef5-229d038b82c8",
                                                "text": "The fact that the letter was incised above the line indicates that it is probably an omega."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9b04e2-4c83-3aec-b091-1398686e805a",
                                        "entry_id": "abd2e511-5f65-3145-aaf7-9dd1cdb03b2b",
                                        "glosses": [
                                            "The end; the final, last or ultimate in a sequence."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5144373e-fda6-4e3c-8fd9-5a5fe5143614",
                                                "sense_id": "ff9b04e2-4c83-3aec-b091-1398686e805a",
                                                "text": "alpha and omega"
                                            },
                                            {
                                                "example_id": "6f2d97b7-4994-45bc-b062-954756a6753e",
                                                "sense_id": "ff9b04e2-4c83-3aec-b091-1398686e805a",
                                                "text": "I am the Alpha and the Omega, the First and the Last, the Beginning and the End."
                                            },
                                            {
                                                "example_id": "e22f878d-744b-4f74-a047-4ba5de9d0a0f",
                                                "sense_id": "ff9b04e2-4c83-3aec-b091-1398686e805a",
                                                "text": "And there is always the Omega Option. At any time you can go to Manhome, go down to the vaults, lift the black cover on your clone's stasis chamber, and push the black button."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a679a00-88f3-3910-b7ee-4f918ba1ec46",
                                        "entry_id": "abd2e511-5f65-3145-aaf7-9dd1cdb03b2b",
                                        "glosses": [
                                            "Angular velocity; symbol: ω."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b8c625a-4740-488f-ab10-a184222ffde6",
                                                "sense_id": "7a679a00-88f3-3910-b7ee-4f918ba1ec46",
                                                "text": "The ratio between the rho and omega cross section is obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92100541-6b1b-3718-97ed-514e0804a8ae",
                                        "entry_id": "abd2e511-5f65-3145-aaf7-9dd1cdb03b2b",
                                        "glosses": [
                                            "A transfinite ordinal number referring to the next position after ordering a countably infinite set."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a9a900f-c1f4-3e5e-86a6-7c63e4ca09fe",
                                        "entry_id": "abd2e511-5f65-3145-aaf7-9dd1cdb03b2b",
                                        "glosses": [
                                            "An omega male."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c0afdd0-a78c-3dd2-a86f-2b2936bd1a37",
                                        "entry_id": "abd2e511-5f65-3145-aaf7-9dd1cdb03b2b",
                                        "glosses": [
                                            "The percentage change in an option value divided by the percentage change in the underlying asset's price."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0230c3c7-b8dc-3409-8bc6-8989d763da3a",
                                        "entry_id": "abd2e511-5f65-3145-aaf7-9dd1cdb03b2b",
                                        "glosses": [
                                            "In omegaverse fiction, a person of a submissive secondary sex driven by biology, magic, or other means to bond with an alpha, with males of this type often being able to get pregnant."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c8064fc-f8ce-4749-b66f-6ca49637ccb8",
                                                "sense_id": "0230c3c7-b8dc-3409-8bc6-8989d763da3a",
                                                "text": "Often omegas go into heat and release pheromones that drive alphas wild."
                                            },
                                            {
                                                "example_id": "33a68ed6-4892-4d22-8c92-26b2f037b032",
                                                "sense_id": "0230c3c7-b8dc-3409-8bc6-8989d763da3a",
                                                "text": "By writing a male character as an omega, experiences of being treated as other in female-coded ways are imagined to be experienced by a character who represents the male norm."
                                            },
                                            {
                                                "example_id": "99b3ed40-e7f8-43e7-8d61-fc160c8b9cf5",
                                                "sense_id": "0230c3c7-b8dc-3409-8bc6-8989d763da3a",
                                                "text": "Sweet as Peaches on the Tongue can be defined as the typical dark A/B/O story, wherein a rich alpha gentleman (Dr. Hannibal Lecter) comes across a very young, virginal omega (Will Graham) by accident."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
