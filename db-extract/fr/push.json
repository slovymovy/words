                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6b6fd07-c16a-410e-bdb4-84cc99fa8437",
                                                "sense_id": "7d7dacb0-c432-397e-9043-7aafc69440c9",
                                                "text": "I guess it's just\nthe special curse\nof working under\ndeadline's push"
                                            }
                                        ]
