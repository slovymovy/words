                    {
                        "sense_id": "7876db42-311b-3c95-bda0-cc7e53e2a76f",
                        "entry_id": "d2db075b-3a85-3c0c-a8f7-54df7605e744",
                        "glosses": [
                            "aus der chinesischen Provinz Guangdong (Kanton) stammende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbde16f-c698-403e-9b95-76bdde8beadd",
                                "sense_id": "7876db42-311b-3c95-bda0-cc7e53e2a76f",
                                "text": "„Queen Victoria stellte ihren Dealern die Royal Navy zur Seite und zeigte diesen unverschämten Kantonesen, dass britische Händler ihre Drogen verkaufen, an wen es ihnen beliebt, herzlichen Dank auch.“"
                            }
                        ],
