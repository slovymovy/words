                    "sense_id": "7f1bc925-8931-36ba-b0e6-3b76495d9430",
                    "sense_definition": "Ruban adhésif transparent utilisé pour coller ou réparer des objets légers comme le papier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passe-moi le rouleau de <w>scotch</w> pour emballer ce cadeau d'anniversaire.",
                            "target_lang_translations": {
                                "en": "Pass me the roll of <w>sticky tape</w> to wrap this birthday present.",
                                "ru": "Передай мне рулон <w>скотча</w>, чтобы упаковать этот подарок на день рождения.",
                                "de": "Gib mir die Rolle <w>Klebeband</w>, um dieses Geburtstagsgeschenk einzupacken.",
                                "es": "Pásame el rollo de <w>cinta adhesiva</w> para envolver este regalo de cumpleaños.",
                                "zh": "把那卷<w>胶带</w>递给我，我要包装这份生日礼物。"
                            }
                        },
                        {
                            "text": "J'ai réparé la page déchirée de mon livre avec un morceau de <w>scotch</w>.",
                            "target_lang_translations": {
                                "en": "I mended the torn page of my book with a piece of <w>sticky tape</w>.",
                                "ru": "Я починил порванную страницу моей книги кусочком <w>скотча</w>.",
                                "de": "Ich habe die zerrissene Seite meines Buches mit einem Stück <w>Klebeband</w> repariert.",
                                "es": "He reparado la página rasgada de mi libro con un trozo de <w>cinta adhesiva</w>.",
                                "zh": "我用一小段<w>胶带</w>修好了书上撕破的那一页。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ruban adhésif",
                        "papier collant"
