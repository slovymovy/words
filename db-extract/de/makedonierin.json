                "senses": [
                    {
                        "sense_id": "e38c2e51-21a3-3661-953a-1548880bd4fc",
                        "entry_id": "b7b7bd36-1b74-3ea2-a326-5c81d389ec66",
                        "glosses": [
                            "Staatsbürgerin von Makedonien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2922aa7-f0f6-4f54-977b-b881d53e5364",
                                "sense_id": "e38c2e51-21a3-3661-953a-1548880bd4fc",
                                "text": "„Vielleicht wird er der Makedonierin Olga Andevska begegnen, die zusammen mit Frauen aus Russland und Rumänien die Büros der Direktoren und Verwaltungsangestellten putzt, täglich vier Stunden."
                            }
                        ],
                        "sense_index_json": "\"1\""
