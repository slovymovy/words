                        "entry_id": "b0e599b1-b7ec-3f7a-b22e-2855417befa0",
                        "glosses": [
                            "физ. генератор микроволновых электромагнитных колебаний, действие которого основано на вынужденном излучении электронов, вращающихся в постоянном магнитном поле"
                        ],
                        "tags": [],
                        "examples": [
