                            {
                                "example_id": "b6cbe22f-cbd8-4595-8d57-3041f8d212d4",
                                "sense_id": "94a30219-3ef7-3d7d-9568-df6e05bd3148",
                                "text": "Cette marqueterie a une belle finition au vernis."
                            },
                            {
                                "example_id": "ae604c0a-c693-4fc9-a438-d798ef5cbdb2",
                                "sense_id": "94a30219-3ef7-3d7d-9568-df6e05bd3148",
                                "text": "Quand l’enduit fin de finition a commencé à faire sa prise, on peut le talocher en faisant des 8 vers le haut et en ré-étalant la matière qui se dépose sur la taloche-éponge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83306ca5-caf3-43b9-934b-a98cb0474108",
                        "source_entry_id": "22fa9647-ff5d-380a-9dff-6fa621e009c1",
                        "source_sense_description": "action de finir",
                        "target_lang_word": "finish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "601e18dd-c5ad-3081-afdf-bad87f268485",
                                        "entry_id": "8dc0aa16-f587-3503-b0ee-05286d2c6283",
                                        "glosses": [
                                            "An end; the end of anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "462d0a44-1b05-4bc4-8bcb-bf22ec508e0e",
                                                "sense_id": "601e18dd-c5ad-3081-afdf-bad87f268485",
                                                "text": "Noel meets a cruel finish: \"Kid,\" the government lackey who \"protects\" the clubs in the tourist belt, shoots Noel dead in an alley for stealing Pining out of the brothel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf3063a-248a-35db-8e16-40eae7817502",
                                        "entry_id": "8dc0aa16-f587-3503-b0ee-05286d2c6283",
                                        "glosses": [
                                            "A protective coating given to wood or metal and other surfaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7767b2ff-a525-4751-a756-14b5849474ad",
                                                "sense_id": "6cf3063a-248a-35db-8e16-40eae7817502",
                                                "text": "The car's finish was so shiny and new."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30b11651-5e1e-3028-9ce3-664453f479ff",
                                        "entry_id": "8dc0aa16-f587-3503-b0ee-05286d2c6283",
                                        "glosses": [
                                            "The result of any process changing the physical or chemical properties of cloth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a6c0eb4-901b-3b8a-a128-561114dbb24b",
                                        "entry_id": "8dc0aa16-f587-3503-b0ee-05286d2c6283",
                                        "glosses": [
                                            "A finishing touch; careful elaboration; polish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4160f39e-9c40-3b27-9cc5-c4308adbd27d",
                                        "entry_id": "8dc0aa16-f587-3503-b0ee-05286d2c6283",
                                        "glosses": [
                                            "A shot on goal, especially one that ends in a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ccc780-75be-4d8a-82d9-57730b3d7138",
                                                "sense_id": "4160f39e-9c40-3b27-9cc5-c4308adbd27d",
                                                "text": "The Italian opted for Bolton's Cahill alongside captain John Terry - and his decision was rewarded with a goal after only 13 minutes. Bulgaria gave a hint of defensive frailties to come when they failed to clear Young's corner, and when Gareth Barry found Cahill in the box he applied the finish past Nikolay Mihaylov."
                                            },
                                            {
                                                "example_id": "189a1078-3329-488e-8d71-1448507c801a",
                                                "sense_id": "4160f39e-9c40-3b27-9cc5-c4308adbd27d",
                                                "text": "However, Colombia broke the deadlock, Leicy Santos toying with Rachel Daly after collecting Caicedo’s pass, before sweeping a dipping effort over a caught-out Mary Earps. It was a luscious finish and the crowd enjoyed it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f8fb48-c5b7-32fb-8d3d-ab60fc7d9f82",
                                        "entry_id": "8dc0aa16-f587-3503-b0ee-05286d2c6283",
                                        "glosses": [
                                            "The ending of a match and its structure."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "finish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afbced26-d728-388c-b98a-fa342e3a81d8",
                                        "entry_id": "a5ebb127-df7d-3b20-a7de-3d3b35c20c81",
                                        "glosses": [
                                            "To complete (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3452b68a-b5d7-4f0e-9f14-904089dd1524",
                                                "sense_id": "afbced26-d728-388c-b98a-fa342e3a81d8",
                                                "text": "Be sure to finish your homework before you go to bed!"
                                            },
                                            {
                                                "example_id": "f48f489d-670e-4dbe-9b54-ee24db07f515",
                                                "sense_id": "afbced26-d728-388c-b98a-fa342e3a81d8",
                                                "text": "Why doesn't Italy finish their buildings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "187b941a-e129-32e7-8549-2a208afcf160",
                                        "entry_id": "a5ebb127-df7d-3b20-a7de-3d3b35c20c81",
                                        "glosses": [
                                            "To apply a treatment to (a surface or similar)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32a588b3-b0ce-4a0f-a15d-e2340033b9ba",
                                                "sense_id": "187b941a-e129-32e7-8549-2a208afcf160",
                                                "text": "The furniture was finished in teak veneer."
                                            },
                                            {
                                                "example_id": "9849011d-adc2-481c-9ea4-d578d8332464",
                                                "sense_id": "187b941a-e129-32e7-8549-2a208afcf160",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                                            },
                                            {
                                                "example_id": "1abacc42-216e-4986-8ddc-d570fb11084b",
                                                "sense_id": "187b941a-e129-32e7-8549-2a208afcf160",
                                                "text": "Seats are trimmed in a grey and blue moquette and tables are finished with grey Vyanide tops, gilt edging and ebony legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "828c2838-e94f-3ef1-9b4a-9498ab56bac7",
                                        "entry_id": "a5ebb127-df7d-3b20-a7de-3d3b35c20c81",
                                        "glosses": [
                                            "To change an animal's food supply in the months before it is due for slaughter, with the intention of fattening the animal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c62f643c-743b-450d-9e89-4d31da691949",
                                                "sense_id": "828c2838-e94f-3ef1-9b4a-9498ab56bac7",
                                                "text": "Due to BSE, cows in the United Kingdom must be finished and slaughtered before 30 months of age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d4cfe0-834f-3714-8574-51f8073bd464",
                                        "entry_id": "a5ebb127-df7d-3b20-a7de-3d3b35c20c81",
                                        "glosses": [
                                            "To come to an end."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9138cc72-c9f0-4669-bdcf-bbc017f166f1",
                                                "sense_id": "55d4cfe0-834f-3714-8574-51f8073bd464",
                                                "text": "We had to leave before the concert had finished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb95bb9-440a-385a-a1a2-32b1bde3eac9",
                                        "entry_id": "a5ebb127-df7d-3b20-a7de-3d3b35c20c81",
                                        "glosses": [
                                            "To put an end to; to destroy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35dbaa53-2f29-4601-8e60-83bd7495ecec",
                                                "sense_id": "ddb95bb9-440a-385a-a1a2-32b1bde3eac9",
                                                "text": "These rumours could finish your career."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14073ccf-eb29-3910-997a-f2b061bae9ec",
                                        "entry_id": "a5ebb127-df7d-3b20-a7de-3d3b35c20c81",
                                        "glosses": [
                                            "To reach orgasm."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5caedb1e-6a61-492f-a9b1-843654d1a237",
                                                "sense_id": "14073ccf-eb29-3910-997a-f2b061bae9ec",
                                                "text": "Fucked my cousin in her asshole\nBefore I finish on her tits"
                                            },
                                            {
                                                "example_id": "d874c952-2566-4771-8d97-e5f5a7cbfa57",
                                                "sense_id": "14073ccf-eb29-3910-997a-f2b061bae9ec",
                                                "text": "\"Understand the anxiety around sex and what beliefs are triggering it,\" says Van Kirk.\"Are you worried you aren't good in bed? That you'll come off as selfish? That pleasuring you will take too long? Reframe that anxiety. Your excitement needs to be louder than any anxiety\" to finish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
