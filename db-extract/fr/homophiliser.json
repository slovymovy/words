                "senses": [
                    {
                        "sense_id": "5e6f170e-f194-34e3-81c8-141e28351508",
                        "entry_id": "e14455a0-66e3-3db0-b2d2-f51e617ff2df",
                        "glosses": [
                            "Rendre homophile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13b8b37-cbba-4619-89b1-e05ca1644fc3",
                                "sense_id": "5e6f170e-f194-34e3-81c8-141e28351508",
                                "text": "Vous partez « homophiliser » les païens ?"
                            },
                            {
                                "example_id": "47cdd480-2434-4c78-8c46-49a0f736b970",
                                "sense_id": "5e6f170e-f194-34e3-81c8-141e28351508",
                                "text": "La langue française se kashèrise, s’hallalise, se ratonise et s’africanise, se romanichelise … mais principalement : se féminise, s’homophilise et se pédalophilise ^([sic : pédophilise])"
                            },
                            {
                                "example_id": "26f041dc-f651-4e81-8e68-6d06f1150a02",
                                "sense_id": "5e6f170e-f194-34e3-81c8-141e28351508",
                                "text": "Docteur ! vous me troublez à m’accuser de faire ce que les autres font, ils picolent, ils se vantent, ils draguent, s’homophilisent, s’engluent, s’homoptérisent, puis se colocalisent à deux, à trois ou quatre, pour assumer les frais, ils s’abiment tous en chœur, quel bel unisson."
                            }
                        ]
                    }
                ],
