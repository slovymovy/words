                        "form": "die Sonntagnachmittage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                        "entry_id": "0776b597-e061-3e03-8644-c821740602c7",
                        "glosses": [
                            "der Nachmittag eines Sonntages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7021bddf-9d59-4f36-8d02-dfb83e5f8bcd",
                                "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                                "text": "An Sonntagnachmittagen kann man zur Sommerszeit gut an den Strand radeln."
                            },
                            {
                                "example_id": "79efe9a1-e5ed-4d74-ae50-2581debe86b8",
                                "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                                "text": "Sonntagnachmittag beginnen wir mit den Vorbereitungen für den Umzug nach Jamaika."
                            },
                            {
                                "example_id": "7bf00189-f999-432d-ae5c-735dc3df1597",
                                "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                                "text": "„Am Sonntagnachmittag wurde in Gamprin ein Auto aufgebrochen.“"
                            },
                            {
                                "example_id": "26bcaa52-0d23-44e5-809c-becd428d97de",
                                "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                                "text": "„Zu dieser besonderen Gelegenheit hatte sich Den Haag ordentlich herausgeputzt wie eine höhere Tochter, die sich für einen Tanztee am Sonntagnachmittag feinmacht.“"
                            },
                            {
                                "example_id": "345b31c8-e2f5-4ccc-8ee6-c650c02ab6e2",
                                "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                                "text": "„Er sagte mir, ich solle nicht so traurig dreinblicken, denn das passe nicht zu mir, und wenn ich Lust hätte, solle ich zu seinem Treff am Sonntagnachmittag kommen.“"
                            },
                            {
                                "example_id": "0b938683-9039-475b-a61f-ae23898d8f9f",
                                "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                                "text": "„Der Panorama-Salon ist am Nachmittag, wenn Kaffee und Kuchen zwei Rollwagen zur Selbstbedienung angeboten wird, so gut gefüllt, dass es fast wie ein Café an einem Sonntagnachmittag wirkt.“"
                            },
                            {
                                "example_id": "ed681247-4a7d-4012-9cda-fe807a3a2bbf",
                                "sense_id": "07376d8b-e490-399c-bd69-d430a8f5f65b",
                                "text": "„Am folgenden Sonntagnachmittag war der Schachraum überfüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
