                "senses": [
                    {
                        "sense_id": "6f06400f-6052-344e-a10e-61c50cbe15e8",
                        "entry_id": "91546e7b-6955-370e-a688-7aa5d756dda7",
                        "glosses": [
                            "feste oder biegsame Druckform, auf der sich die Vorlage für die Herstellung von Drucken befindet"
                        ],
                        "tags": [
                            "Druckwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "2f7caa2f-b447-4326-ba00-9d81fbf5bab6",
                                "sense_id": "6f06400f-6052-344e-a10e-61c50cbe15e8",
                                "text": "„Im Rastertiefdruck, auch Rakeltiefdruck genannt, kommen keine Druckplatten zum Einsatz, die Zylinder selbst sind die Druckformen.“"
                            },
                            {
                                "example_id": "6487d28c-0500-4111-b541-5ead708621a3",
                                "sense_id": "6f06400f-6052-344e-a10e-61c50cbe15e8",
                                "text": "„Bei den ersten Ausgaben war der Wert in einem Feld unten auf der Marke angegeben, das auf den späteren Druckplatten von 1860 weggekratzt wurde.“"
                            },
                            {
                                "example_id": "c287d46d-8d2a-41fe-88e5-6d9d9e13bb6b",
                                "sense_id": "6f06400f-6052-344e-a10e-61c50cbe15e8",
                                "text": "„Seizinger lässt sich in Belgrad nieder und wird als Stecher bald die ersten Briefmarken in Druckplatten umsetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9bdc815-f916-44b0-921b-5dc12abdb9f1",
                        "source_entry_id": "91546e7b-6955-370e-a688-7aa5d756dda7",
                        "source_sense_id": "6f06400f-6052-344e-a10e-61c50cbe15e8",
                        "source_sense_description": "Druckform, auf der sich die Vorlage für die Herstellung von Drucken befindet",
                        "target_lang_word": "matrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b6f06c2-bb36-36f7-9c83-4030ac45f0bf",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Utérus, organe creux qui, chez les femmes et les femelles des mammifères, contient le produit de la conception jusqu’à la mise au monde."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8880643-e21e-495c-af78-f64dc0f8df4c",
                                                "sense_id": "1b6f06c2-bb36-36f7-9c83-4030ac45f0bf",
                                                "text": "Chute de la matrice, inflammation de la matrice."
                                            },
                                            {
                                                "example_id": "43978ea1-e394-45e9-b77a-616c8928b511",
                                                "sense_id": "1b6f06c2-bb36-36f7-9c83-4030ac45f0bf",
                                                "text": "Des mois elle nous parlera du fond de son lit, la matrice s’était mise à flotter dans son ventre."
                                            },
                                            {
                                                "example_id": "625e2862-2210-4433-940c-06696e26650d",
                                                "sense_id": "1b6f06c2-bb36-36f7-9c83-4030ac45f0bf",
                                                "text": "Malgré les divergences entre eux, ils en ont globalement conclu qu’il fallait déconseiller, voire interdire les pratiques sportives aux jeunes filles, dont il convenait de protéger les seins et la matrice."
                                            },
                                            {
                                                "example_id": "f1c42116-dbff-45e2-a73c-c2bdb7acde44",
                                                "sense_id": "1b6f06c2-bb36-36f7-9c83-4030ac45f0bf",
                                                "text": "Il alla engloutir son visage entre ses seins brûlants, puis il remonta vers ses aisselles qu’il inspira fiévreusement. Il plongea ensuite entre ses cuisses, là où la matrice avait le goût salé des embruns marins. Il but ses sucs à pleines gorgées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94cae02-bbba-3d17-9efe-e443188ed9c1",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Lieu ou substance dans laquelle se forment les minéraux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341c08a2-0333-494c-8c9b-564f8c476ec9",
                                                "sense_id": "a94cae02-bbba-3d17-9efe-e443188ed9c1",
                                                "text": "Les marcassites sont les matrices des métaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d2258b-467a-3edc-a3e9-c032c06af8c3",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Matériau qui en englobe un autre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc41ed4e-f406-4e05-98e0-4a535d9b84a2",
                                                "sense_id": "23d2258b-467a-3edc-a3e9-c032c06af8c3",
                                                "text": "Les trois dernières statistiques représentent les publications qui se focalisent sur les propriétés des fillers et de leur influence sur le comportement d’une matrice cimentaire."
                                            },
                                            {
                                                "example_id": "bc36ad59-3115-4225-b7c5-5ed05886fc7c",
                                                "sense_id": "23d2258b-467a-3edc-a3e9-c032c06af8c3",
                                                "text": "Les fibres sont ajoutées dans la matrice, non pour améliorer la résistance à la traction par flexion du béton, mais surtout dans le but de contrôler la fissuration, d’empêcher la coalescence des fissures et de changer le comportement du matériau renforcé de fibres en cousant les fissures [Aydin 2007]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53682a00-ae8e-309c-a9cf-e9a5e830bb99",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Follicule où se forme le poil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d0f71f-5075-4fd2-b457-30760f0fd15b",
                                                "sense_id": "53682a00-ae8e-309c-a9cf-e9a5e830bb99",
                                                "text": "Matrice des poils"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a12b4f8-343f-3c19-a2a6-616df100058a",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Outil fait d’un matériau très dur, pour former une pièce métallique en lui appliquant une forte pression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8833f27-dc23-3a71-9a3c-5929a1865fe8",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Moule, creuset où se forme quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee203c50-5681-4e9f-add3-c45f4420be9c",
                                                "sense_id": "a8833f27-dc23-3a71-9a3c-5929a1865fe8",
                                                "text": "La société médiévale, quoique radicalement distincte, n’est pas l’inverse de la société contemporaine, mais bien plutôt sa matrice, contrairement à ce que la mythographie bourgeoise du XIXᵉ siècle a laissé croire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48a7536b-32ef-323b-8650-c1d99a8a37e0",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Plaque de métal, bois, linoléum, gravée utilisée en imprimerie traditionnelle, encrée et servant à l’impression du motif par estampe."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "253090ec-b136-35d8-8728-e965aad5bbcc",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Pièce de cuivre qui a reçu en creux l’empreinte de la lettre gravée sur le poinçon, et qui en donne le relief par le moyen de la fonte."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b22f38d-11f1-3822-8b1b-8c4f5739b6de",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Coin d’une médaille ou d’une monnaie gravée avec le poinçon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0a54b1c-6f47-376e-89a6-4b4d8df32c0d",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Originaux ou étalons des poids et mesures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63a9caa8-6a7e-3d6e-8492-fefe5d913934",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Registre original où sont consignés les chiffres des rôles d’impositions directes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5715bb59-48db-47ff-9081-2a153ecb7081",
                                                "sense_id": "63a9caa8-6a7e-3d6e-8492-fefe5d913934",
                                                "text": "Entre l’ancien et le nouveau cadastre, le système de numérotation des parcelles a changé, ce qui oblige à se reporter aux tables de correspondance figurant sur les premières matrices du « nouveau cadastre » (feuillets roses), pour suivre l’identité d’une parcelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b9d098d-b265-338c-a9f4-85ccb3bc313c",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Objet mathématique se présentant sous forme de tableau de nombres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11943182-935b-4094-8b54-dbec0e8d3566",
                                                "sense_id": "5b9d098d-b265-338c-a9f4-85ccb3bc313c",
                                                "text": "Comment utiliser l’outil pour calculer le déterminant d’une matrice de n’importe quelles dimensions 3, 4 ou 5 ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbcdfaca-6a2a-384b-8085-07b0cd10f370",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Structure à deux dimensions ayant plusieurs lignes et plusieurs colonnes dont chaque intersection a un élément."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1be4dd-7cf3-487b-b973-a6c44cb88528",
                                                "sense_id": "dbcdfaca-6a2a-384b-8085-07b0cd10f370",
                                                "text": "La matrice SWOT est employée en parallèle avec d’autres outils d’audit et analyse (5 forces de Porter, PESTEL, …)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f93d1d-7902-3f8d-8f62-e21ee43e96d5",
                                        "entry_id": "6bb4270a-b65b-35db-92df-3754584dad07",
                                        "glosses": [
                                            "Planche de rédaction, ou sa copie, archivée comme élément de conservation et constituant l’élément de départ pour la préparation de nouveaux tirages ou d’éditions comportant des modifications."
                                        ],
