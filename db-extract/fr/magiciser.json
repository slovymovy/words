                "senses": [
                    {
                        "sense_id": "ebffac41-055f-39d5-bf3b-0c2e29984e50",
                        "entry_id": "f33faa9e-d222-3189-9b08-15c8b02afccf",
                        "glosses": [
                            "Donner un caractère magique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c02a43-bba7-425b-bdb1-8dd84390c411",
                                "sense_id": "ebffac41-055f-39d5-bf3b-0c2e29984e50",
                                "text": "Je crois que cette opinion a l'avantage de ne magiciser aucunement cette humanité."
                            },
                            {
                                "example_id": "d42be04f-0221-4835-b4c7-cea98f9b2124",
                                "sense_id": "ebffac41-055f-39d5-bf3b-0c2e29984e50",
                                "text": "Pour ce qui est des petits-indiens, c'est vrai que je n'ai pas songé à « magiciser » cette pratique, mais la version amagique me semblait déjà assez cruelle…"
                            },
                            {
                                "example_id": "e3c6e428-4484-40e9-9092-2f950d4bbac8",
                                "sense_id": "ebffac41-055f-39d5-bf3b-0c2e29984e50",
                                "text": "Du coup aussi beaucoup ont été \"magicisées\" avant livraison."
                            }
                        ]
                    }
