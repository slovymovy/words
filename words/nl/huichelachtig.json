                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen had door dat zijn vriendelijke glimlach volkomen <w>huichelachtig</w> was.",
                            "target_lang_translations": {
                                "en": "Everyone realized that his friendly smile was completely <w>hypocritical</w>."
                            }
                        },
                        {
                            "text": "Die <w>huichelachtige</w> opmerking veroorzaakte veel wrevel bij de aanwezigen.",
                            "target_lang_translations": {
