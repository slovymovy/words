                        "sense_id": "72983fe6-0bc9-36eb-996f-a7e639e0e012",
                        "entry_id": "6fe3f7c5-f71e-339d-ab94-330b602f8235",
                        "glosses": [
                            "Visière d'un képi ou d'une casquette."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "453f1df0-aa5b-4e21-a438-1863e76deeb9",
                                "sense_id": "72983fe6-0bc9-36eb-996f-a7e639e0e012",
                                "text": "Sous la hideuse viscope, les yeux brillaient d’un feu sombre dans les visages blêmes et rasés."
                            },
                            {
                                "example_id": "d5117131-8267-4892-b395-a69f4103609c",
                                "sense_id": "72983fe6-0bc9-36eb-996f-a7e639e0e012",
                                "text": "Quelques pantalons traînent encore parmi les mégots de la piste, rappelant les heures charmantes des pieds d’éléphant et des viscopes."
                            },
                            {
                                "example_id": "d6986191-99f0-4d58-81c1-eb0e7ecf1975",
                                "sense_id": "72983fe6-0bc9-36eb-996f-a7e639e0e012",
                                "text": "Il appela un de ses copains, un jeunot coiffé d’une gapette américaine à viscope pointée vers le ciel."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c80fdd1-d521-37d2-8f2a-42c50f71c322",
                        "entry_id": "6fe3f7c5-f71e-339d-ab94-330b602f8235",
                        "glosses": [
                            "Ce couvre-chef à visière."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3e58c30d-313a-4ba6-8049-8c4a4c90318a",
                                "sense_id": "1c80fdd1-d521-37d2-8f2a-42c50f71c322",
                                "text": "Papa n’avait plus son bandeau sur la tête, mais, pour ne pas exhiber son sparadrap et son crâne passé à la tondeuse, il avait mis sa grande viscope d’ouvrier sellier."
                            },
                            {
                                "example_id": "a95d46b6-554b-4506-9c4f-d1e48e253135",
                                "sense_id": "1c80fdd1-d521-37d2-8f2a-42c50f71c322",
                                "text": "Je me retourne et je vois Jacques Yonnet, coiffé d’une viscope à carreaux et me tendant un livre d’Ivan Chtcheglov dont la couverture est une colorisation du Paris de ma jeunesse en noir et blanc."
                            }
                        ]
                    }
