                                "target_senses": [
                                    {
                                        "sense_id": "705a7c28-7a3e-32cf-b300-062931bc00e1",
                                        "entry_id": "b39e8a6e-c1e9-3734-8d89-5ed34881ae95",
                                        "glosses": [
                                            "сокр. от Содружество Независимых Государств; региональная международная организация (международный договор), призванная регулировать отношения сотрудничества между странами, ранее входившими в состав СССР"
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebae76c2-625f-4513-bd6d-2629fade845e",
                                                "sense_id": "705a7c28-7a3e-32cf-b300-062931bc00e1",
                                                "text": "Вот такой удивительный парадокс: там, в Союзе (теперь говорят, СНГ) — поголовное хлебосольство, а страна погибает от нищеты и разрухи, здесь, в Голландии, наоборот — каждый помнит свой мелочный интерес, но при этом все вместе содержат почти миллион эмигрантов."
                                            },
                                            {
                                                "example_id": "d288c7ec-381b-4f75-b521-335800a424bd",
                                                "sense_id": "705a7c28-7a3e-32cf-b300-062931bc00e1",
                                                "text": "На экране компьютера территория СНГ была испещрена́ сеткой железных дорог с точным расстоянием между городами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759278ff-ae70-35e5-8e55-27b9fd6a2283",
                                        "entry_id": "b39e8a6e-c1e9-3734-8d89-5ed34881ae95",
                                        "glosses": [
                                            "сокр. от Содружество непризнанных государств"
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fe06c4a-88c2-3450-ac5b-d9497d468916",
                                        "entry_id": "b39e8a6e-c1e9-3734-8d89-5ed34881ae95",
                                        "glosses": [
                                            "шутл. сокр. от С Новым Годом!"
                                        ],
                                        "tags": [
                                            "abbreviation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e5c1de-40fb-44a8-9cd5-07ad547942e9",
                                                "sense_id": "7fe06c4a-88c2-3450-ac5b-d9497d468916",
                                                "text": "В лучшие времена СНГ расшифровывали только — «С Новым Годом!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
