            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0f6649dc-1d02-3d4a-854f-bde215219b25",
                    "sense_definition": "Relatif aux sentiments, en particulier à l'amour ou à l'affection ; empreint d'émotion ou de tendresse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille montre n'a pas beaucoup de prix, mais elle a une grande valeur <w>sentimentale</w> pour moi.",
                            "target_lang_translations": {
                                "en": "This old watch isn't worth much, but it has great <w>sentimental</w> value to me.",
                                "ru": "Эти старые часы стоят недорого, но для меня они имеют большую <w>сентиментальную</w> ценность.",
                                "de": "Diese alte Uhr ist nicht besonders wertvoll, aber sie hat für mich einen großen <w>ideellen</w> Wert.",
                                "es": "Este viejo reloj no vale mucho dinero, pero para mí tiene un gran valor <w>sentimental</w>.",
                                "zh": "这块旧手表不值多少钱，但对我来说它有很大的<w>纪念</w>价值。"
                            }
                        },
                        {
                            "text": "Ils aiment regarder une comédie <w>sentimentale</w> ensemble le dimanche soir.",
                            "target_lang_translations": {
                                "en": "They enjoy watching a <w>romantic</w> comedy together on Sunday evenings.",
                                "ru": "По воскресным вечерам они любят вместе смотреть <w>романтическую</w> комедию.",
                                "de": "Sonntagabends sehen sie sich gern gemeinsam eine <w>romantische</w> Komödie an.",
                                "es": "Les gusta ver juntos una comedia <w>romántica</w> los domingos por la noche.",
                                "zh": "周日晚上，他们喜欢一起看一部<w>爱情</w>喜剧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affectif",
                        "romantique"
                    ],
                    "antonyms": [
                        "rationnel"
                    ],
                    "common_phrases": [
                        "valeur sentimentale",
                        "vie sentimentale",
                        "comédie sentimentale"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to feelings, especially love or affection; full of emotion or tenderness.",
                        "ru": "Связанный с чувствами, особенно с любовью или привязанностью; полный эмоций или нежности.",
                        "de": "Auf Gefühle bezogen, besonders auf Liebe oder Zuneigung; voller Rührung oder Zärtlichkeit.",
                        "es": "Relativo a los sentimientos, sobre todo al amor o al afecto, y cargado de emoción o ternura.",
                        "zh": "与情感有关，尤指爱情或喜爱之情；充满感情或温情的。"
                    },
