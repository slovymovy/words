                            {
                                "target_word": "méditatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a76a2b-d6ae-30c9-a40d-0d18897698d3",
                                        "entry_id": "b447a665-b0a4-3ef2-9a5f-1fa9fd776d0d",
                                        "glosses": [
                                            "Qui est porté, livré, consacré à la méditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a236886a-5ea3-459f-a797-3a2b76f6f112",
                                                "sense_id": "c0a76a2b-d6ae-30c9-a40d-0d18897698d3",
                                                "text": "Il restait immobile, dans une attitude méditative, un coude sur la table et la tête appuyée sur l'une de ses mains, …."
                                            },
                                            {
                                                "example_id": "3b736f39-2dd7-4bd1-8bd0-523bab4782a6",
                                                "sense_id": "c0a76a2b-d6ae-30c9-a40d-0d18897698d3",
                                                "text": "Semblable aux hommes méditatifs qui, dans le calme de leurs rêveries, contractent l’habitude de quelque mouvement machinal, il avait la manie de jouer avec ses souliers et les détruisait en peu de temps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méditatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15e5a189-8ca7-3061-a975-517475d00af1",
                                        "entry_id": "9be5daba-bfc1-32d4-9e00-0b527f1a7c2f",
                                        "glosses": [
                                            "Personne qui médite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b592508-c19c-4195-b67e-921f86f29219",
                                                "sense_id": "15e5a189-8ca7-3061-a975-517475d00af1",
                                                "text": "Les méditatifs sont souvent distraits."
                                            },
                                            {
                                                "example_id": "d6cfa41a-d244-4b07-a0e6-648b6796d42a",
                                                "sense_id": "15e5a189-8ca7-3061-a975-517475d00af1",
                                                "text": "C’est-à- dire que le méditatif contemplatif devra avoir été plongé, de gré ou de force, dans le bain, souvent assez boueux, de cette relation sociale que son être le plus intime aura pourtant aspiré à tenir à distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
