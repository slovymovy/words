                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db4d4e8e-846b-4c60-b0e0-6fe097e8fd51",
                                                "sense_id": "15fa2e43-b5bd-3e45-a566-2fa10e1e6ce9",
                                                "text": "„Ungeachtet dieser Missbildungen war das Monster grauenhaft lebensecht.“"
                                            }
