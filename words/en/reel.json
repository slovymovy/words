{
    "word_family": [
        "reeler",
        "unreel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdf2cd0c-75a2-3e3e-86db-5fa8a30e9ffd",
                    "sense_definition": "A chronological collection of pictures or short videos published by a user on an app or website and typically only available for a short period.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media_digital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She posted a funny <w>reel</w> to share her holiday moments.",
                            "target_lang_translations": {
                                "ru": "Она опубликовала смешной <w>рилс</w>, чтобы поделиться моментами из отпуска.",
                                "zh": "她发布了一个有趣的<w>短视频</w>来分享她的度假时光。"
                            }
                        },
                        {
                            "text": "I spent an hour watching a <w>reel</w> on my phone.",
                            "target_lang_translations": {
                                "ru": "Я целый час смотрел <w>рилс</w> на телефоне.",
                                "zh": "我在手机上花了一个小时看<w>短视频</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "story",
                        "Snap",
                        "clip",
                        "video"
                    ],
                    "common_phrases": [
                        "post a reel",
                        "watch reels"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "social media feature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое видео или подборка клипов в социальных сетях, часто с музыкой и эффектами.",
                        "zh": "社交媒体上的一种短视频格式，通常配有音乐和特效。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рилс",
                                "target_lang_sense_clarification": "формат видео в Instagram/Facebook"
                            },
                            {
                                "target_lang_word": "видеоролик",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短视频",
                                "target_lang_sense_clarification": "社交媒体上的短视频内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1bd65ff-579b-349a-971c-8118c9acbe3c",
                    "sense_definition": "A kind of spool, turning on an axis, on which yarn, threads, lines, or the like, are wound.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "object_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attached a new hook to the fishing <w>reel</w>.",
                            "target_lang_translations": {
                                "ru": "Он прикрепил новый крючок к рыболовной <w>катушке</w>.",
                                "zh": "他在钓鱼<w>绕线轮</w>上系了一个新鱼钩。"
                            }
                        },
                        {
                            "text": "The firefighter pulled the heavy hose from the <w>reel</w>.",
                            "target_lang_translations": {
                                "ru": "Пожарный стянул тяжелый шланг с <w>барабана</w>.",
                                "zh": "消防员从<w>卷轴</w>上拉出了沉重的水管。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fishing reel",
                        "hose reel",
                        "cotton reel",
                        "film reel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цилиндрический предмет с бортиками, вращающийся на оси, на который наматываются нитки, леска, провода или пленка.",
                        "zh": "一种绕轴旋转的圆柱形装置，用于缠绕线、绳、电缆或胶片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кату́шка",
                                "target_lang_sense_clarification": "для ниток, лески"
                            },
                            {
                                "target_lang_word": "боби́на",
                                "target_lang_sense_clarification": "для пленки, кабеля"
                            },
                            {
                                "target_lang_word": "бараба́н",
                                "target_lang_sense_clarification": "для шланга, кабеля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卷轴",
                                "target_lang_sense_clarification": "通用的缠绕装置"
                            },
                            {
                                "target_lang_word": "线轴",
                                "target_lang_sense_clarification": "用于缠绕线材"
                            },
                            {
                                "target_lang_word": "绕线轮",
                                "target_lang_sense_clarification": "用于钓鱼线或电缆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc04d036-0617-3825-9f7b-59ba781605ba",
                    "sense_definition": "A short compilation of sample film work used as a demonstrative resume in the entertainment industry.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "media_professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor sent his demo <w>reel</w> to the casting director.",
                            "target_lang_translations": {
                                "ru": "Актер отправил свой <w>демо-ролик</w> кастинг-директору.",
                                "zh": "演员把他的<w>作品集锦</w>发给了选角导演。"
                            }
                        },
                        {
                            "text": "She needs to update her <w>reel</w> with her latest clips.",
                            "target_lang_translations": {
                                "ru": "Ей нужно обновить свой <w>шоурил</w> последними клипами.",
                                "zh": "她需要用最新的片段更新她的<w>作品集锦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "showreel"
                    ],
                    "common_phrases": [
                        "demo reel",
                        "highlight reel",
                        "sizzle reel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая видеоподборка лучших работ актера, режиссера или оператора, используемая как портфолио.",
                        "zh": "演艺人员展示其作品片段的短视频集，用作求职简历。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демо-ролик",
                                "target_lang_sense_clarification": "портфолио"
                            },
                            {
                                "target_lang_word": "шоурил",
                                "target_lang_sense_clarification": "профессиональный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作品集锦",
                                "target_lang_sense_clarification": "展示个人作品的视频"
                            },
                            {
                                "target_lang_word": "演示短片",
                                "target_lang_sense_clarification": "用于求职的视频片段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d41060f-f4f5-3c46-bc0e-fc100aa81efa",
                    "sense_definition": "A lively dance originating in Scotland.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "culture_dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests danced a traditional <w>reel</w> at the wedding.",
                            "target_lang_translations": {
                                "ru": "Гости танцевали традиционный <w>рил</w> на свадьбе.",
                                "zh": "客人们在婚礼上跳了传统的<w>里尔舞</w>。"
                            }
                        },
                        {
                            "text": "The band played a fast <w>reel</w> for the dancers.",
                            "target_lang_translations": {
                                "ru": "Группа играла быстрый <w>рил</w> для танцоров.",
                                "zh": "乐队为舞者们演奏了一首节奏轻快的<w>里尔舞</w>曲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Scottish reel",
                        "dance a reel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый народный танец шотландского происхождения.",
                        "zh": "一种源自苏格兰的轻快民间舞蹈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рил",
                                "target_lang_sense_clarification": "танец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "里尔舞",
                                "target_lang_sense_clarification": "苏格兰民间舞蹈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a26f800-32ed-316e-bd74-54edbe020b31",
                    "sense_definition": "A shaky or unsteady gait.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_gait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old sailor walked with a slight <w>reel</w>.",
                            "target_lang_translations": {
                                "ru": "Старый моряк шел с легким <w>пошатыванием</w>.",
                                "zh": "老水手走路时带着轻微的<w>踉跄</w>。"
                            }
                        },
                        {
                            "text": "His drunken <w>reel</w> made him bump into the table.",
                            "target_lang_translations": {
                                "ru": "Из-за пьяного <w>шатания</w> он врезался в стол.",
                                "zh": "他醉酒后的<w>摇晃</w>让他撞到了桌子。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шаткая, нетвердая походка или движение.",
                        "zh": "走路时摇晃、不稳的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пошатывание",
                                "target_lang_sense_clarification": "движение"
                            },
                            {
                                "target_lang_word": "шатание",
                                "target_lang_sense_clarification": "неустойчивость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踉跄",
                                "target_lang_sense_clarification": "走路不稳的样子"
                            },
                            {
                                "target_lang_word": "摇晃",
                                "target_lang_sense_clarification": "身体不稳的动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e3e6926-1cf1-39fa-b036-b6a2df17fe5b",
                    "sense_definition": "To wind on a reel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took him ten minutes to <w>reel</w> in the large fish.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось десять минут, чтобы <w>подтянуть</w> большую рыбу.",
                                "zh": "他花了十分钟才把那条大鱼<w>收</w>上来。"
                            }
                        },
                        {
                            "text": "Please <w>reel</w> up the garden hose when you are finished.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>смотай</w> садовый шланг, когда закончишь.",
                                "zh": "用完后请把花园水管<w>卷</w>起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reel in",
                        "reel out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наматывать что-либо на катушку или сматывать, подтягивать с помощью катушки.",
                        "zh": "将某物缠绕在卷轴上，或通过卷轴将其拉回。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нама́тывать",
                                "target_lang_sense_clarification": "на катушку"
                            },
                            {
                                "target_lang_word": "сматывать",
                                "target_lang_sense_clarification": "убирать, сворачивать"
                            },
                            {
                                "target_lang_word": "подтягивать",
                                "target_lang_sense_clarification": "леску, рыбу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卷",
                                "target_lang_sense_clarification": "缠绕动作"
                            },
                            {
                                "target_lang_word": "收",
                                "target_lang_sense_clarification": "通过卷轴拉回"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "804efe97-3443-3276-9a2f-8436101fc9a5",
                    "sense_definition": "To be in shock.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community is still <w>reeling</w> from the tragedy.",
                            "target_lang_translations": {
                                "ru": "Общество все еще <w>не может отойти</w> от этой трагедии.",
                                "zh": "社区至今仍因那场悲剧而感到<w>震惊</w>。"
                            }
                        },
                        {
                            "text": "She was left <w>reeling</w> by the sudden bad news.",
                            "target_lang_translations": {
                                "ru": "Она была <w>потрясена</w> внезапными плохими новостями.",
                                "zh": "突如其来的坏消息让她感到<w>不知所措</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reel from",
                        "left reeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильное потрясение, быть в шоке или замешательстве.",
                        "zh": "因突发事件而感到极度震惊或不知所措。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть потрясённым",
                                "target_lang_sense_clarification": "состояние"
                            },
                            {
                                "target_lang_word": "не отходить (от шока)",
                                "target_lang_sense_clarification": "фразовый глагол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震惊",
                                "target_lang_sense_clarification": "受到强烈冲击"
                            },
                            {
                                "target_lang_word": "不知所措",
                                "target_lang_sense_clarification": "因打击而混乱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1157a218-7851-3fae-84ed-d1e48e56d457",
                    "sense_definition": "To walk shakily or unsteadily; to stagger; move as if drunk or not in control of oneself.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_unsteady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer <w>reeled</w> back after taking a heavy punch.",
                            "target_lang_translations": {
                                "ru": "Боксер <w>пошатнулся</w> назад после тяжелого удара.",
                                "zh": "拳击手在挨了重重一拳后向后<w>踉跄</w>。"
                            }
                        },
                        {
                            "text": "He <w>reeled</w> out of the bar and onto the street.",
                            "target_lang_translations": {
                                "ru": "Он <w>вышел, шатаясь,</w> из бара на улицу.",
                                "zh": "他<w>摇晃</w>着从酒吧走到了街上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reel back",
                        "reel around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти нетвердой походкой, шататься (как пьяный или после удара); пошатнуться.",
                        "zh": "走路摇摇晃晃，像喝醉或失去平衡一样。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шата́ться",
                                "target_lang_sense_clarification": "при ходьбе"
                            },
                            {
                                "target_lang_word": "пошатнуться",
                                "target_lang_sense_clarification": "потерять равновесие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踉跄",
                                "target_lang_sense_clarification": "走路不稳"
                            },
                            {
                                "target_lang_word": "摇晃",
                                "target_lang_sense_clarification": "身体失去平衡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bad164a2-49bd-3e41-bb00-bcf9d8fdafc4",
                    "sense_definition": "To have a whirling sensation; to be giddy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sensation_dizzy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mind <w>reeled</w> at the complexity of the situation.",
                            "target_lang_translations": {
                                "ru": "У меня <w>голова шла кругом</w> от сложности ситуации.",
                                "zh": "面对局势的复杂性，我感到<w>头晕</w>。"
                            }
                        },
                        {
                            "text": "The strong fumes made her head <w>reel</w>.",
                            "target_lang_translations": {
                                "ru": "От сильных испарений у нее <w>закружилась</w> голова.",
                                "zh": "强烈的烟雾让她感到<w>天旋地转</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mind reeling",
                        "head reeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать головокружение; ощущение, что все вращается.",
                        "zh": "感到头晕目眩，仿佛周围的一切都在旋转。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружи́ться",
                                "target_lang_sense_clarification": "о голове"
                            },
                            {
                                "target_lang_word": "идти кругом",
                                "target_lang_sense_clarification": "идиома (о голове)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头晕",
                                "target_lang_sense_clarification": "感到眩晕"
                            },
                            {
                                "target_lang_word": "天旋地转",
                                "target_lang_sense_clarification": "形容极度眩晕"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "faa83bf5-1c50-390b-b43f-9a945905668c",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Reel</w> to speak at the conference.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Рила</w> выступить на конференции.",
                                "zh": "我们邀请了<w>里尔</w>先生在会议上发言。"
                            }
                        },
                        {
                            "text": "The <w>Reel</w> family has lived in this town for decades.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Рил</w> живет в этом городе десятилетиями.",
                                "zh": "<w>里尔</w>一家在这个镇上已经住了几十年了。"
                            }
                        }
                    ],
