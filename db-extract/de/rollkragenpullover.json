                                                "example_id": "5315b7ec-a2e8-4cef-99e3-a8c099ccd121",
                                                "sense_id": "6ed24922-51b0-30f6-9ee5-c88d16dd43e1",
                                                "text": "Still, Jobs became friends with fashion designer Issey Miyake, who had designed some Sony uniforms, and asked him to make some black turtlenecks that he liked."
                                            }
