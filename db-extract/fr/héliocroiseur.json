                                    {
                                        "sense_id": "4b270009-659a-399d-8ce3-79c52a6c6034",
                                        "entry_id": "f8260a1c-38c9-3a47-95e6-81d623cc5475",
                                        "glosses": [
                                            "A sungrazing comet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86548fd2-efea-4398-8adf-b221e895be15",
                                                "sense_id": "4b270009-659a-399d-8ce3-79c52a6c6034",
                                                "text": "At least one sungrazer has been observed by a spacecraft to actually be destroyed as it rammed the photosphere."
                                            },
                                            {
                                                "example_id": "6feb4e6b-79f7-4cb5-9ce2-81863d18ee1f",
                                                "sense_id": "4b270009-659a-399d-8ce3-79c52a6c6034",
                                                "text": "But Comet Howard-Koomen-Michels (Solwind-1) is apparently the only sungrazer that produced a detectable effect on the appearance of the Sun's corona (Michels et.al., 1982; Sheeley et.al., 1982)."
                                            },
                                            {
                                                "example_id": "3c7b842e-0088-4efb-b55c-c31c54525026",
                                                "sense_id": "4b270009-659a-399d-8ce3-79c52a6c6034",
                                                "text": "And there is no telling when another great sungrazer might come. But speculation about the splitting of sungrazers brings us to consider the origins of the Kreutz group."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
