                ],
                "senses": [
                    {
                        "sense_id": "eb5d0e08-a3af-34a3-8431-716290aae1da",
                        "entry_id": "bce68403-5d8f-35f6-9ae9-4f36edd7fc0a",
                        "glosses": [
                            "auditiv wahrnehmbares Schallereignis, das ein sich bewegendes Gefährt beim Fahren erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d853d3ca-d621-4678-af1b-677a6ec392e6",
                                "sense_id": "eb5d0e08-a3af-34a3-8431-716290aae1da",
                                "text": "„Dichter Nebel verschluckt die Fahrgeräusche eines herannahenden Zuges und führt zu den unangenehmsten Sinnestäuschungen.“"
                            },
                            {
                                "example_id": "cb28c913-41ce-4360-b064-d8371c391220",
                                "sense_id": "eb5d0e08-a3af-34a3-8431-716290aae1da",
                                "text": "„Da die Osterstraße nur mäßig befahren wurde, konnte sie bisweilen das zischende Fahrgeräusch der Stadtbahnzüge vernehmen.“"
                            },
                            {
                                "example_id": "a5928b53-d865-494c-b9d5-a7f37d275d33",
                                "sense_id": "eb5d0e08-a3af-34a3-8431-716290aae1da",
                                "text": "„Während der Busfahrt/Autofahrt versuchen die Kinder mit geschlossenen Augen den Fahrzeugtyp, den wir überholen, der uns überholt, aufgrund seiner Fahrgeräusche zu identifizieren (PKW, Moped, LKW, Trecker etc.).“"
                            },
                            {
                                "example_id": "506129cb-c966-42d5-81ea-a6266b4bc54e",
                                "sense_id": "eb5d0e08-a3af-34a3-8431-716290aae1da",
                                "text": "„Der Lärm des Straßenverkehrs auf dem Potsdamer Platz ist nach dem eintönigen Fahrgeräusch des Eisenbahnwaggons zuerst eine Störung, dann willkommen.“"
                            },
                            {
                                "example_id": "5c23be1d-7f6a-4226-9d1c-61be736504e9",
                                "sense_id": "eb5d0e08-a3af-34a3-8431-716290aae1da",
                                "text": "„Möglich macht das die aktuelle Rechtslage zur Messung von Fahrgeräuschen, die sich unter anderem an der Leistung und der Getriebeart des Wagens orientiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
