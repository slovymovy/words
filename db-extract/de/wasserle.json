                ],
                "senses": [
                    {
                        "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                        "entry_id": "eb50cac5-8144-3e09-a669-0a45e400ccd3",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cff6323-acad-4e29-a12e-39ea75ce9955",
                                "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                                "text": "Die Wasserles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "bf91a979-24d1-4b39-a7cd-8573aedef8f4",
                                "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                                "text": "Frau Wasserle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c030f2ec-57cb-42b7-bf9a-e3143e4d1b0d",
                                "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                                "text": "Herr Wasserle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3d03420b-e6f1-402a-a244-8f0887fbf827",
                                "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                                "text": "Der Wasserle trägt nie die Pullover, die die Wasserle ihm strickt."
                            },
                            {
                                "example_id": "03cccbb1-f999-4c4a-b29c-519103ac0028",
                                "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wasserle kommt, geht der Herr Wasserle.“"
                            },
                            {
                                "example_id": "1f85b3e6-7071-4a55-81b7-aebe8d4bdf47",
                                "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                                "text": "Wasserle kommt und geht."
                            },
                            {
                                "example_id": "23f0f0a0-926a-401a-aa82-8598baf6c50a",
                                "sense_id": "8df324c6-9ebb-3043-bcd1-d09f30779f39",
                                "text": "Wasserles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
