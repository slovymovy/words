                                        "entry_id": "fb337d44-916f-31ed-936c-3cc89c260fa6",
                                        "glosses": [
                                            "Fiebre eruptiva y contagiosa, caracterizada por un exantema difuso en la piel de color rojo, temperatura alta, y angina. Algunas veces de carácter gravísimo."
                                        ],
                                        "tags": [
                                            "enfermedades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8797391a-5d38-498d-9051-2b02b358f008",
                                                "sense_id": "ec2654da-28a7-346c-9231-83a7feea8337",
                                                "text": "Recuerdo cuando dos tercios del colegio se enfermó de escarlatina, y tuvimos que convertir en hospital el Gran Hall."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
