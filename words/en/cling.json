{
    "word_family": [
        "clinger",
        "clinging",
        "clingy",
        "clingstone"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bac78e2d-876b-3f9b-b50d-565c4c0402a5",
                    "sense_definition": "To hold onto something or someone very tightly, often to avoid falling or being separated.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small child began to <w>cling</w> to his mother's leg when the loud dog approached.",
                            "target_lang_translations": {
                                "ru": "Маленький ребенок начал <w>цепляться</w> за ногу матери, когда подошла громко лающая собака."
                            }
                        },
                        {
                            "text": "The survivors had to <w>cling</w> to the side of the boat for hours until help arrived.",
                            "target_lang_translations": {
                                "ru": "Выжившим пришлось <w>держаться</w> за борт лодки в течение нескольких часов, пока не прибыла помощь."
                            }
                        }
                    ],
                    "synonyms": [
                        "clutch",
                        "grip",
                        "hold on",
                        "hold tight"
                    ],
                    "antonyms": [
                        "release",
                        "let go"
                    ],
                    "common_phrases": [
                        "cling to life",
                        "cling to power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепко держаться за что-либо или кого-либо, часто чтобы не упасть или не разлучиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепляться",
                                "target_lang_sense_clarification": "хвататься, чтобы удержаться"
                            },
                            {
                                "target_lang_word": "вцепиться",
                                "target_lang_sense_clarification": "очень крепко схватиться"
                            },
                            {
                                "target_lang_word": "льнуть",
                                "target_lang_sense_clarification": "прижиматься к кому-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42309dec-2141-3608-96d2-f301e7a57b3c",
                    "sense_definition": "To stick or adhere closely to a surface, especially of wet or static-filled fabric following the shape of a body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet shirt started to <w>cling</w> to his back after he ran through the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Мокрая рубашка начала <w>прилипать</w> к его спине после того, как он пробежал под проливным дождем."
                            }
                        },
                        {
                            "text": "Static electricity can cause a silk dress to <w>cling</w> uncomfortably to your legs.",
                            "target_lang_translations": {
                                "ru": "Статическое электричество может привести к тому, что шелковое платье будет неприятно <w>липнуть</w> к ногам."
                            }
                        }
                    ],
                    "synonyms": [
                        "adhere",
                        "stick",
                        "cleave"
                    ],
                    "common_phrases": [
                        "cling to the skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прилегать к поверхности, особенно о мокрой или наэлектризованной ткани, повторяющей контуры тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилипать",
                                "target_lang_sense_clarification": "о ткани или материале"
                            },
                            {
                                "target_lang_word": "облегать",
                                "target_lang_sense_clarification": "плотно прилегать к телу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f996c098-fc78-3824-80b8-53d634f4a013",
                    "sense_definition": "To remain emotionally attached to an idea, hope, or person, often out of a sense of dependence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even after many years, she continued to <w>cling</w> to the hope that her brother was still alive.",
                            "target_lang_translations": {
                                "ru": "Даже спустя много лет она продолжала <w>цепляться</w> за надежду, что ее брат все еще жив."
                            }
                        },
                        {
                            "text": "It is unhealthy to <w>cling</w> to the past instead of focusing on your future goals.",
                            "target_lang_translations": {
                                "ru": "Вредно <w>держаться</w> за прошлое вместо того, чтобы сосредоточиться на будущих целях."
                            }
                        }
                    ],
                    "synonyms": [
                        "stick with",
                        "hold on"
                    ],
                    "antonyms": [
                        "abandon",
                        "reject"
                    ],
                    "common_phrases": [
                        "cling to hope",
                        "cling to the past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться эмоционально привязанным к идее, надежде или человеку, часто из чувства зависимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепляться за",
                                "target_lang_sense_clarification": "пытаться сохранить надежду или прошлое"
                            },
                            {
                                "target_lang_word": "держаться за",
                                "target_lang_sense_clarification": "не желать отпускать что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c1cd0f8-5cc1-3f70-965c-e11907a7a2ab",
                    "sense_definition": "To cause something to adhere or wrap around something else, such as by embracing or twining.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ivy began to <w>cling</w> its vines around the old stone pillars of the porch.",
                            "target_lang_translations": {
                                "ru": "Плющ начал <w>обвивать</w> своими лозами старые каменные колонны крыльца."
                            }
                        },
                        {
                            "text": "She <w>clung</w> her arms tightly around his neck in a desperate embrace.",
                            "target_lang_translations": {
                                "ru": "Она отчаянно <w>обхватила</w> его шею руками."
                            }
                        }
                    ],
                    "synonyms": [
                        "clasp",
                        "enclasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо прилипать или обвиваться вокруг чего-то другого, например, при объятиях или плетении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвивать",
                                "target_lang_sense_clarification": "о растениях или руках"
                            },
                            {
                                "target_lang_word": "обхватывать",
                                "target_lang_sense_clarification": "крепко обнимать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91c4d002-7ff7-344d-9dc5-541cd6c00969",
                    "sense_definition": "To make a high-pitched, ringing sound, similar to that of a small bell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crystal glasses would <w>cling</w> softly whenever the table was bumped.",
                            "target_lang_translations": {
                                "ru": "Хрустальные бокалы тихо <w>звенели</w> каждый раз, когда задевали стол."
                            }
                        },
                        {
                            "text": "The tiny silver bells <w>clinged</w> with every movement of the dancer's feet.",
                            "target_lang_translations": {
                                "ru": "Крошечные серебряные колокольчики <w>звенели</w> при каждом движении ног танцора."
                            }
                        }
                    ],
                    "synonyms": [
                        "ring",
                        "chime",
                        "tinkle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать высокий, звенящий звук, похожий на звон маленького колокольчика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звенеть",
                                "target_lang_sense_clarification": "издавать высокий звук"
                            },
                            {
                                "target_lang_word": "дребезжать",
                                "target_lang_sense_clarification": "о тонком стекле или металле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27b28f2e-bdef-3d0c-871a-25a486431466",
                    "sense_definition": "To dry up, wither, or shrink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wither",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wood began to <w>cling</w> and crack after being left in the desert sun.",
                            "target_lang_translations": {
                                "ru": "Старое дерево начало <w>ссыхаться</w> и трескаться после того, как его оставили на солнце в пустыне."
                            }
                        },
                        {
                            "text": "Without any water, the plants will eventually <w>cling</w> and die in this heat.",
                            "target_lang_translations": {
                                "ru": "Без воды растения в конечном итоге <w>завянут</w> и погибнут на этой жаре."
                            }
                        }
                    ],
                    "synonyms": [
                        "wither",
                        "shrivel"
                    ],
                    "antonyms": [
                        "flourish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высыхать, увядать или съеживаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссыхаться",
                                "target_lang_sense_clarification": "уменьшаться в объеме от сухости"
                            },
                            {
                                "target_lang_word": "вянуть",
                                "target_lang_sense_clarification": "о растениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33859edc-1189-33d6-809f-10226e60213b",
                    "sense_definition": "To cause something to wither or dry up, especially through hunger or lack of moisture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wither",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh winter frost will <w>cling</w> the remaining leaves on the trees.",
                            "target_lang_translations": {
                                "ru": "Суровый зимний мороз <w>иссушит</w> оставшиеся на деревьях листья."
                            }
                        },
                        {
                            "text": "The poet wrote of how famine would <w>cling</w> the skin to the bone.",
                            "target_lang_translations": {
                                "ru": "Поэт писал о том, как голод <w>прижмет</w> кожу к костям."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly found in historical literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать увядание или высыхание чего-либо, особенно из-за голода или нехватки влаги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иссушать",
                                "target_lang_sense_clarification": "лишать влаги или жизни"
                            },
                            {
                                "target_lang_word": "стягивать",
                                "target_lang_sense_clarification": "о коже на костях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c799bc1c-45d3-3e5f-bded-f89f4f550dda",
                    "sense_definition": "A decorative item, often made of thin plastic, that sticks to a window or smooth surface without adhesive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children put a colorful holiday <w>cling</w> on the front window for Christmas.",
                            "target_lang_translations": {
                                "ru": "Дети приклеили на окно яркую праздничную <w>наклейку</w> к Рождеству."
                            }
                        },
                        {
                            "text": "You can easily remove a window <w>cling</w> and move it to another glass surface.",
                            "target_lang_translations": {
                                "ru": "Вы можете легко снять оконную <w>наклейку</w> и перенести ее на другую стеклянную поверхность."
                            }
                        }
                    ],
                    "synonyms": [
                        "cling-on"
                    ],
                    "common_phrases": [
                        "window cling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный предмет, часто из тонкого пластика, который прилипает к окну или гладкой поверхности без клея."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклейка",
                                "target_lang_sense_clarification": "без клеевого слоя, статическая"
                            },
                            {
                                "target_lang_word": "стикер",
                                "target_lang_sense_clarification": "декоративный элемент для стекла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aef7fae-3982-3e28-b8e4-d8bf7efe48bc",
                    "sense_definition": "A type of fruit, particularly a peach, where the flesh sticks firmly to the central stone or pit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She preferred to buy a <w>cling</w> for canning because they often have a better texture.",
                            "target_lang_translations": {
                                "ru": "Она предпочитала покупать <w>персики с косточкой</w> для консервирования, потому что у них часто лучше текстура."
                            }
                        },
                        {
                            "text": "It is harder to slice a <w>cling</w> neatly because the fruit does not separate from the pit.",
                            "target_lang_translations": {
                                "ru": "Труднее аккуратно нарезать <w>персик</w>, у которого мякоть не отделяется от косточки."
                            }
                        }
                    ],
                    "synonyms": [
                        "clingstone"
                    ],
                    "antonyms": [
                        "freestone"
                    ],
                    "common_phrases": [
                        "yellow cling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип фрукта, особенно персика, у которого мякоть плотно прилегает к косточке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "персик с не отделяющейся косточкой",
                                "target_lang_sense_clarification": "ботаническое описание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "369ad076-4bea-3720-9b2d-a73d10b29b1b",
                    "sense_definition": "The act or state of adhering, attaching, or being devoted to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His tenacious <w>cling</w> to old traditions made it difficult for the company to modernize.",
                            "target_lang_translations": {
                                "ru": "Его упорная <w>приверженность</w> старым традициям мешала компании модернизироваться."
                            }
                        },
                        {
                            "text": "The physical <w>cling</w> of the fabric was the main complaint from the customers.",
                            "target_lang_translations": {
                                "ru": "Основной жалобой покупателей было то, как ткань <w>липнет</w> к телу."
                            }
                        }
                    ],
                    "synonyms": [
                        "adherence",
                        "attachment",
                        "devotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или состояние прилипания, привязанности или преданности чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приверженность",
                                "target_lang_sense_clarification": "верность традициям или идеям"
                            },
                            {
                                "target_lang_word": "прилипание",
                                "target_lang_sense_clarification": "физическое свойство ткани"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "386cdf71-e2e3-3743-a14d-80dbd9993e35",
                    "sense_definition": "A word representing a high-pitched ringing or metallic sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small hammer hit the anvil with a sharp <w>cling</w> that echoed through the shop.",
                            "target_lang_translations": {
                                "ru": "Маленький молоток ударил по наковальне с резким <w>звоном</w>, который эхом разнесся по мастерской."
                            }
                        },
                        {
                            "text": "As the coins fell onto the marble floor, they made a distinct <w>cling</w> sound.",
                            "target_lang_translations": {
                                "ru": "Когда монеты упали на мраморный пол, они издали отчетливый <w>дзынь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clink",
                        "ting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, представляющее высокий звенящий или металлический звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дзынь",
                                "target_lang_sense_clarification": "звукоподражание звону"
                            },
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "металлический звук"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}