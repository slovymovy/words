                    "frequency": "Low",
                    "semantic_group_id": "urbanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les promeneurs arpentaient la célèbre <w>perspective</w> bordée de somptueux palais anciens."
