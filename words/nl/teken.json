                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De letters van het alfabet zijn <w>tekens</w> die samen woorden vormen.",
                            "target_lang_translations": {
                                "en": "The letters of the alphabet are <w>characters</w> that form words together.",
                                "ru": "Буквы алфавита — это <w>знаки</w>, которые вместе образуют слова.",
                                "pl": "Litery alfabetu to <w>znaki</w>, które razem tworzą słowa.",
                                "fr": "Les lettres de l'alphabet sont des <w>signes</w> qui forment ensemble des mots."
                            }
                        },
                        {
                            "text": "Op het toetsenbord vind je naast letters ook allerlei andere <w>tekens</w>.",
                            "target_lang_translations": {
                                "en": "On the keyboard you will find all kinds of other <w>characters</w> besides letters.",
                                "ru": "На клавиатуре, помимо букв, вы найдете множество других <w>знаков</w>.",
                                "pl": "Na klawiaturze, oprócz liter, znajdziesz też wiele innych <w>znaków</w>.",
                                "fr": "Sur le clavier, vous trouverez outre les lettres divers autres <w>caractères</w>."
                            }
                        }
