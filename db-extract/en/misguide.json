                    {
                        "sense_id": "98db5f97-d7d7-3e52-a7f7-71d4441ada6c",
                        "entry_id": "a1c276f5-0bcf-3433-9f05-010b1db7b7f6",
                        "glosses": [
                            "To guide poorly or incorrectly; to lead astray or into error."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "411720c5-b362-4e7a-9a80-13647f6519d8",
                                "sense_id": "98db5f97-d7d7-3e52-a7f7-71d4441ada6c",
                                "text": "On the whole it were better to misguide a child in knowledge, which it can remedy later, than to mistone it in feeling, for which there is no remedy. A jarring note implanted in its nature might spoil the music of its life […]"
                            },
                            {
                                "example_id": "255638f2-bd54-41eb-b171-c3ea85016b46",
                                "sense_id": "98db5f97-d7d7-3e52-a7f7-71d4441ada6c",
                                "text": "1988, Michael Weikath, \"Keeper of the Seven Keys\", Helloween, Keeper of the Seven Keys: Part II.\nWill o' the wisps / Misguiding your path / You can't throw a curse / Without takin' their wrath"
                            }
                        ]
                    }
                ],
