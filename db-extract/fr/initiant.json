                    {
                        "sense_id": "807959fa-6966-3316-9bf6-84571a163846",
                        "entry_id": "28cf2355-7b0e-38a1-9f73-90c57b8a3490",
                        "glosses": [
                            "Personne qui lance une initiative populaire."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "d8cf0073-008b-4eed-b141-9b84f6bfe2e2",
                                "sense_id": "807959fa-6966-3316-9bf6-84571a163846",
                                "text": "Selon les initiants, cette situation serait due à la fois à une immigration provenant de pays et de cultures lointains et à un certain laxisme dans l'application des peines prévues."
                            },
                            {
                                "example_id": "edeaea80-4915-4e8d-8b77-d11b19af005d",
                                "sense_id": "807959fa-6966-3316-9bf6-84571a163846",
                                "text": "Les initiants ont déposé une initiative."
                            },
                            {
                                "example_id": "05a14fc6-34f2-4d9b-8bda-5f515f27ada6",
                                "sense_id": "807959fa-6966-3316-9bf6-84571a163846",
                                "text": "L’initiative populaire voulait tirer la prise des centrales au bout de 45 ans et remplacer l’atome par du courant vert. […] Les initiants auraient voulu mettre un terme rapide à une énergie nucléaire qu’ils jugent dépassée et dangereuse."
                            }
                        ]
                    }
