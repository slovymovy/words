                                        "sense_id": "e559f8d3-491f-3780-a505-2aa47af5b524",
                                        "entry_id": "81dba92d-0d64-3dda-8a28-b238b4d3b9bb",
                                        "glosses": [
                                            "tiefes, vibrierendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1695baff-ae2f-4910-b76f-2a6e657f11d6",
                                                "sense_id": "e559f8d3-491f-3780-a505-2aa47af5b524",
                                                "text": "Als sie das Brummen der Motoren hörte, wusste sie, was jetzt auf sie zukam."
                                            },
                                            {
                                                "example_id": "f4e457c2-ddd3-4806-9b9d-2b0b0b28fcc3",
                                                "sense_id": "e559f8d3-491f-3780-a505-2aa47af5b524",
