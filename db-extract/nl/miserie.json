                        "examples": [
                            {
                                "example_id": "fb51bb50-9a3b-4da3-9284-7eda5c061f83",
                                "sense_id": "c2fd3e67-2b99-37d1-aee1-51589259f123",
                                "text": "De Slowaak Peter Sagan won de 75ste editie van Gent-Wevelgem. Vanwege het winterweer werd de klassieker ingekort. „Het is overal dikke miserie.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a7dd191-aa81-3ebc-8263-11140d812ce7",
                        "entry_id": "bce8146d-898c-3b84-9ee5-0e75f42f7746",
                        "glosses": [
                            "grote armoede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "074bf61a-890f-4862-8dfe-4ca347adafe9",
                                "sense_id": "3a7dd191-aa81-3ebc-8263-11140d812ce7",
                                "text": "Knutselaars worden niet gedwongen of bedreigd door professionele criminelen, zeggen Jonkergouw en Bos. Het zijn geen zielepieten, zegt Bos. „Het zijn mensen die voor duizenden euro’s aan professionele apparatuur in hun woning zetten, of laten zetten. Ze hebben het doel elke acht tot tien weken vele duizenden euro’s te verdienen. En ze werken hoe dan ook samen met mensen die dieper in de hennepwereld zitten.” Volgens Jonkergouw zijn knutselaars mensen met problemen die, als ze gepakt worden, nog dieper in de miserie zakken."
                            }
                        ]
                    }
