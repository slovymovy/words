                ],
                "senses": [
                    {
                        "sense_id": "1aa9434b-5651-3025-8255-abbc5cc94763",
                        "entry_id": "b383632c-fd84-3c07-976a-f85162f84ce2",
                        "glosses": [
                            "Schusstechnik, bei der man mit einem Bein abspringt, gleichzeitig das andere anhebt und mit dem Schussbein nach dem Ball tritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26cbe6a7-9503-43e5-adbc-3c3fdb0a7690",
                                "sense_id": "1aa9434b-5651-3025-8255-abbc5cc94763",
                                "text": "„Geht der Ball dabei ins Tor, ist das nicht weniger wert als ein spektakulärer Flugkopfball oder ein Scherenschlag.“"
                            },
                            {
                                "example_id": "19415fa5-aa61-4ed0-b0df-cbb6759fa77a",
                                "sense_id": "1aa9434b-5651-3025-8255-abbc5cc94763",
                                "text": "„Der Ball kommt näher und mit einem Scherenschlag katapultiert der Spieler des FC Chelsea das Ding als Aufsetzer in die untere rechte Torecke.“"
                            },
                            {
                                "example_id": "3c2c94d9-aa71-46a3-a706-114a85688009",
                                "sense_id": "1aa9434b-5651-3025-8255-abbc5cc94763",
                                "text": "„Ich erinnere mich gut an einige herrliche Scherenschläge in die Waden der Gegenspieler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f56c966a-14a1-3276-8853-74aa13d324ce",
                        "entry_id": "b383632c-fd84-3c07-976a-f85162f84ce2",
                        "glosses": [
                            "nicht symmetrisch ausgeführter Beinschlag beim Brustschwimmen"
                        ],
                        "tags": [
                            "Schwimmen"
                        ],
                        "examples": [
                            {
                                "example_id": "687a8ac3-0c26-48e2-9a1b-6449ca8f386f",
                                "sense_id": "f56c966a-14a1-3276-8853-74aa13d324ce",
                                "text": "„Bis dahin hatte ich mich mit einer Kombination aus Brustschwimmen und Seitenschwimmen mit einem Scherenschlag über Wasser gehalten.“"
                            },
                            {
                                "example_id": "97713cca-204a-41dc-a98a-b6aa2b261b67",
                                "sense_id": "f56c966a-14a1-3276-8853-74aa13d324ce",
                                "text": "„Brustschwimmen ist von der Atemtechnik am einfachsten, kann aber Rückenbeschwerden verstärken, weil das Hohlkreuz verstärkt und die Knie beim Scherenschlag belastet werden.“"
                            },
                            {
                                "example_id": "aa092968-1001-411d-8f85-7b6d6c2b012c",
                                "sense_id": "f56c966a-14a1-3276-8853-74aa13d324ce",
                                "text": "„Mit einem seitlichen Kopfrucken und einem Scherenschlag seiner langen weißen Schienbeine tauchte er unter, kam dann wieder an die Oberfläche und ließ sich eine Weile auf dem Rücken treiben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9775ad6b-32ac-3f02-8f1e-c0e6400b7257",
                        "entry_id": "b383632c-fd84-3c07-976a-f85162f84ce2",
                        "glosses": [
                            "operationelle Entfernung von Gewebe"
                        ],
                        "tags": [
                            "Chirurgie"
                        ],
                        "examples": [
                            {
                                "example_id": "f891ff37-71d2-40a8-a764-6a3bdd29a8c7",
                                "sense_id": "9775ad6b-32ac-3f02-8f1e-c0e6400b7257",
                                "text": "„Man zieht die Fibrome mit der Pinzette hoch, um den Stiel möglichst lange und dünn zu machen, und trägt dann mit einem Scherenschlag das kleine Ding ab. Die Blutung ist meistens kaum sichtbar.“"
                            },
                            {
                                "example_id": "9565f959-d597-478d-a824-fa0a6c349dde",
                                "sense_id": "9775ad6b-32ac-3f02-8f1e-c0e6400b7257",
                                "text": "„Es gelingt, eine breite Irisfalte zu fassen, herauszuleiten und mit einem Scherenschlag abzuschneiden.“"
                            },
                            {
                                "example_id": "946199cd-a11d-4496-8a22-fb1fdd1e28fa",
                                "sense_id": "9775ad6b-32ac-3f02-8f1e-c0e6400b7257",
                                "text": "„Bleibt trotz dieser Behandlung die Eiterung bestehen, so werden unter Äthylchlorid die Vorhaut durch einen Scherenschlag gespalten, die freigelegten ulcera wie üblich behandelt.“"
                            },
                            {
                                "example_id": "cdbdd474-cb61-4af2-9586-fc855409fbbc",
                                "sense_id": "9775ad6b-32ac-3f02-8f1e-c0e6400b7257",
                                "text": "„Die Regenbogenhaut fasse ich mit einer Liebreich'schen Pincette genau in der Mitte der Wunde und schneide ein kleines Stück mit einem Scherenschlage aus.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
