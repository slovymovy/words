                                                "sense_id": "71beb4dc-2907-397b-b327-44acd30f01b4",
                                                "text": "„Angebot und Nachfrage regelten die Wirtschaft.“"
                                            },
                                            {
                                                "example_id": "cf3c73cf-cf9e-4f13-b73a-6034eb82080a",
                                                "sense_id": "71beb4dc-2907-397b-b327-44acd30f01b4",
                                                "text": "„Hier regelten Angebot und Nachfrage die Preise.“"
                                            },
