                "senses": [
                    {
                        "sense_id": "798a0cf5-ba6b-3e0b-86bb-21bb35f98cb7",
                        "entry_id": "5c250e16-ed7c-3f08-8601-005c65c248e5",
                        "glosses": [
                            "der Osten Grönlands; Verwaltungsbezirk"
                        ],
                        "tags": [
                            "historisch (1940–2009)"
                        ],
                        "examples": [
                            {
                                "example_id": "59cc1c6a-cf38-4df8-aedc-29361d8aeab3",
                                "sense_id": "798a0cf5-ba6b-3e0b-86bb-21bb35f98cb7",
                                "text": "„Vom frühen Paleozän zum frühen Eozän verstärkte sich die Spaltenbildung auf der Rockall-Färöer-Bank und in Ostgrönland.“"
                            },
                            {
                                "example_id": "0621da08-4c67-4a6a-bc45-b023fadfb7f1",
                                "sense_id": "798a0cf5-ba6b-3e0b-86bb-21bb35f98cb7",
                                "text": "„Die zweite Gruppe der Paläo-Eskimos, die Saqqaq-Kultur, erreicht Grönland und zieht die Westküste entlang bis in den Süden. Einige wandern von dort weiter bis nach Ostgrönland.“"
                            },
                            {
                                "example_id": "7a832473-321a-45d1-848c-cab84b62b8d2",
                                "sense_id": "798a0cf5-ba6b-3e0b-86bb-21bb35f98cb7",
                                "text": "„Das Sea Ice Exhibition Cenre […] im ältesten Holzhändlerhaus Islands beschäftigt sich mit der Entstehung und den verschiedenen Arten von Meereis, dem Wettergeschehen, den frühen isländischen Siedlern und dem Eis im nahen Ostgrönland.“"
                            },
                            {
                                "example_id": "292cfcca-27f4-4964-ba48-6bba55ae3634",
                                "sense_id": "798a0cf5-ba6b-3e0b-86bb-21bb35f98cb7",
                                "text": "„Das eisfreie Gebiet (119100 qkm in Westgrönland, 115900 qkm in Ostgrönland und 106700 qkm in Nordgrönland) befindet sich längs den Küsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
