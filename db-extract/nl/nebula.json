                                "target_senses": [
                                    {
                                        "sense_id": "4ef7f61f-35e3-3148-bb29-bc9b19c054a3",
                                        "entry_id": "219257d6-b0e1-355f-8c16-5f13fc5ac167",
                                        "glosses": [
                                            "A cloud in outer space consisting of gas or dust (e.g. a cloud formed after a star explodes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdea07c6-a1e3-46e5-a313-16d8e530a1d4",
                                                "sense_id": "4ef7f61f-35e3-3148-bb29-bc9b19c054a3",
                                                "text": "Approximately 5 billion years ago, our solar nebula was formed as gravitational forces pulled interstellar gas and dust into a swirling mass around out newly formed sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d37fb8-657e-3eee-a579-80dd1b065679",
