                "senses": [
                    {
                        "sense_id": "b4a1d69b-fc6d-3e34-9726-e5239fff6c8a",
                        "entry_id": "bf74afe7-8b1d-3128-a942-82dddc894036",
                        "glosses": [
                            "gourmet"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "671008e7-d152-4ef6-848a-4a5b4d918c4d",
                                "sense_id": "b4a1d69b-fc6d-3e34-9726-e5239fff6c8a",
                                "text": "Als der Kalif darüber lachte, sagte jener: »Ich will dir meine Worte durch die Geschichte von dem Feinschmecker und dem Koch klar machen. Wisse, mein Herr!"
                            },
                            {
                                "example_id": "34d9b422-b87b-4699-808d-65117ca185ec",
                                "sense_id": "b4a1d69b-fc6d-3e34-9726-e5239fff6c8a",
                                "text": "Die praktische Seite des römischen Priestertums war die priesterliche Küche; die Augural- und Pontifikalschmäuse waren gleichsam die offiziellen Silberblicke eines römischen Feinschmeckerlebens und manche derselben machten Epoche in der Geschichte der Gastronomie, wie zum Beispiel die Antrittsmahlzeit des Augurs Quintus Hortensius die Pfauenbraten aufgebracht hat.",
                                "translation": "The History of Rome",
                                "english": "The History of Rome"
                            }
                        ]
                    }
                ],
