                                        "entry_id": "14c3f800-7fad-3be4-a62d-31706f9c8a1b",
                                        "glosses": [
                                            "In a manner suitable for some particular purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df288ff5-c4a7-42e2-ad8e-451caf0729cc",
                                                "sense_id": "7712b85a-aa9f-37e6-b5d5-c4b6d2c6e1bf",
                                                "text": "Amongst this number of cordials and alteratives I do not find a more present remedy than a cup of wine or strong drink, if it be soberly and opportunely used."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5983c7a-bb2f-37cd-a56d-181f9778b5d6",
                                        "entry_id": "14c3f800-7fad-3be4-a62d-31706f9c8a1b",
                                        "glosses": [
                                            "In a manner convenient or advantageous at some particular time."
                                        ],
