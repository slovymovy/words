                "senses": [
                    {
                        "sense_id": "9adddd2d-1402-3810-9567-7bd410e57ec1",
                        "entry_id": "4a99f1c4-2bd6-3e27-ac42-10bfa55d2fe4",
                        "glosses": [
                            "лишить доброго имени, хорошей репутации; опорочить, опозорить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88534d65-7e84-4cf7-aa6c-bc013ef7550f",
                                "sense_id": "9adddd2d-1402-3810-9567-7bd410e57ec1",
                                "text": "Князь Игорь ответствовал: «Я мог уйти во время битвы, но не хотел обесславить себя бегством; не хочу и теперь»."
                            },
                            {
                                "example_id": "9d3058eb-0695-4c3a-8de3-90f83b96d15e",
                                "sense_id": "9adddd2d-1402-3810-9567-7bd410e57ec1",
                                "text": "Одним словом, нет мысли, которой наши вислоухие не обесславили бы, нет дела, которого они не засидели бы."
                            },
                            {
                                "example_id": "e5ed4323-8866-4400-b97e-057dbbffe762",
                                "sense_id": "9adddd2d-1402-3810-9567-7bd410e57ec1",
                                "text": "Да ведь его превосходительству что стоит девушку благороднейшую осрамить или чужую жену обесславить, подобно тому как тогда со мной казус вышел-с?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d3892d3-d1a3-4bc6-9fec-2168ed87e000",
                        "source_entry_id": "4a99f1c4-2bd6-3e27-ac42-10bfa55d2fe4",
                        "source_sense_id": "9adddd2d-1402-3810-9567-7bd410e57ec1",
                        "target_lang_word": "defame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3990911-6d65-3057-9464-431169578a9a",
                                        "entry_id": "aa1d7bb5-c98b-3346-a37c-b0b7a24619ea",
                                        "glosses": [
                                            "To disgrace; to bring into disrepute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42e7578-47ee-4a83-8310-afd7d43f5278",
                                                "sense_id": "c3990911-6d65-3057-9464-431169578a9a",
                                                "text": "My guilt thy growing virtues did defame; / My blackness blotted thy unblemish'd name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe602b6-2572-344c-b7be-3ed01049ec74",
                                        "entry_id": "aa1d7bb5-c98b-3346-a37c-b0b7a24619ea",
                                        "glosses": [
                                            "To charge; to accuse (someone) of an offence."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98fea6b9-cb91-4fc7-b168-819a4e288233",
                                                "sense_id": "7fe602b6-2572-344c-b7be-3ed01049ec74",
                                                "text": "Rebecca is […] defamed of sorcery practised on the person of a noble knight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "656dd4f9-cd08-3620-b24d-412939b38f62",
                                        "entry_id": "aa1d7bb5-c98b-3346-a37c-b0b7a24619ea",
                                        "glosses": [
                                            "To harm or diminish the reputation of; to disparage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13d76f02-9e8e-43ee-b445-32975a96e149",
                                                "sense_id": "656dd4f9-cd08-3620-b24d-412939b38f62",
                                                "text": "to defame somebody"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "defame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac0af73-f927-3535-a347-7635017e049d",
                                        "entry_id": "da8c3519-9d41-3518-9b0e-35bdff4f7a9f",
                                        "glosses": [
                                            "Disgrace, dishonour."
                                        ],
                                        "tags": [
