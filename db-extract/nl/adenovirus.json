                        "sense_id": "1d17bf67-1b1b-31d8-9286-4ce62bd05cbf",
                        "entry_id": "445c57d0-a619-3a05-8ac1-088f6f156e83",
                        "glosses": [
                            "familie van virussen die verkoudheden veroorzaken"
                        ],
