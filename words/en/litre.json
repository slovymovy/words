    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58572394-a14e-3412-81d8-73713e6ca0cf",
                    "sense_definition": "A metric unit of volume or capacity, equal to one cubic decimetre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should be able to fill four cups with one <w>litre</w> of water.",
                            "target_lang_translations": {
                                "ru": "Одним <w>литром</w> воды можно наполнить четыре чашки."
                            }
                        },
                        {
                            "text": "The car's engine has a capacity of two <w>litres</w> and is very efficient.",
                            "target_lang_translations": {
                                "ru": "Двигатель автомобиля имеет объем два <w>литра</w> и очень экономичен."
                            }
                        }
                    ],
                    "synonyms": [
                        "liter"
                    ],
                    "common_phrases": [
                        "litre of water",
                        "litre of milk",
                        "per litre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метрическая единица объема или вместимости, равная одному кубическому дециметру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "литр",
                                "target_lang_sense_clarification": "единица измерения объема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31db3f25-d5b8-3f45-a367-e042db169deb",
                    "sense_definition": "A Chilean tree or bush, Lithraea caustica, known for causing skin irritation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>litre</w> is a common evergreen tree found in the Chilean matorral ecosystem.",
                            "target_lang_translations": {
                                "ru": "<w>Литре</w> — это обычное вечнозеленое дерево, встречающееся в экосистеме чилийского маторраля."
                            }
                        },
                        {
                            "text": "Hikers are warned not to touch the leaves of the <w>litre</w> to avoid a rash.",
                            "target_lang_translations": {
                                "ru": "Туристов предупреждают не трогать листья <w>литре</w>, чтобы избежать сыпи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chile"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чилийское дерево или кустарник (Lithraea caustica), известное тем, что вызывает раздражение кожи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "литре",
                                "target_lang_sense_clarification": "чилийское растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38d2a587-c347-3bf2-b1d8-fa4bcbfaa464",
                    "sense_definition": "An alternative spelling of <w>litter</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some historical texts, you might find the word <w>litre</w> used instead of litter.",
                            "target_lang_translations": {
                                "ru": "В некоторых исторических текстах можно встретить слово <w>litre</w>, используемое вместо «litter»."
                            }
                        },
                        {
                            "text": "The old manuscript referred to the animal's <w>litre</w> in an unusual way.",
                            "target_lang_translations": {
                                "ru": "В старой рукописи необычным образом упоминался <w>помет</w> животного."
                            }
                        }
                    ],
                    "synonyms": [
                        "litter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревший или альтернативный вариант написания слова «litter» (подстилка, помет или носилки)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помет",
                                "target_lang_sense_clarification": "о потомстве животных"
                            },
                            {
                                "target_lang_word": "подстилка",
                                "target_lang_sense_clarification": "солома для животных"
                            },
                            {
                                "target_lang_word": "носилки",
                                "target_lang_sense_clarification": "паланкин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
