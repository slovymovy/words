                "senses": [
                    {
                        "sense_id": "4ed326ac-cfc3-35d9-aa46-53b4d2c5861d",
                        "entry_id": "fe96e63a-77cd-3420-abd6-2f14a58a3028",
                        "glosses": [
                            "еврейская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c075562-ec78-430f-bb93-d7785bebdfb0",
                                "sense_id": "4ed326ac-cfc3-35d9-aa46-53b4d2c5861d",
                                "text": "Есть такой кластер, группа людей, она замыкается также на журнал Nation, который до своей кончины вел и редактировал Стивен Коэн, известный левый историк с пиететом к советскому прошлому России."
                            }
                        ]
                    }
                ],
