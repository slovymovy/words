                "senses": [
                    {
                        "sense_id": "65af3636-9ed8-3065-9b33-53008a79e2cc",
                        "entry_id": "6d20bb1a-0a7a-3dd2-a415-27180db1ecc2",
                        "glosses": [
                            "Relatif à Hongkong."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4761d041-a1a1-49a0-880d-6a66e7d60618",
                                "sense_id": "65af3636-9ed8-3065-9b33-53008a79e2cc",
                                "text": "Accusé de vandalisme, l’artiste devrait payer 6,7 millions de dollars hongkongais (soit près de 612 000 euros) pour que la façade soit remise en état, selon Fashionmag."
                            },
                            {
                                "example_id": "3e1f9696-cf8a-4f2d-863c-30c795554eef",
                                "sense_id": "65af3636-9ed8-3065-9b33-53008a79e2cc",
                                "text": "Les producteurs virtuels se verront proposer par cette société hongkongaise sous licence d’exploitation anglaise des photos du film, auront la joie de lire leur nom au générique, pourront mettre leur grain de sel dans le scénario, participer à la soirée de lancement voire à une scène du film."
                            },
                            {
                                "example_id": "79c4c38b-8539-475c-984a-c1e74362bd1c",
                                "sense_id": "65af3636-9ed8-3065-9b33-53008a79e2cc",
                                "text": "ANA a elle-même noué un accord stratégique avec un groupe d’investissement hongkongais pour former la première compagnie low-cost japonaise."
                            },
                            {
                                "example_id": "ae4bb98e-dcfe-4b28-92b2-0826b95cc06d",
                                "sense_id": "65af3636-9ed8-3065-9b33-53008a79e2cc",
                                "text": "Dans le sud de la Chine, des manifestants s’en sont pris à des bâtiments officiels pour protester contre la vente de terrains en propriété collective, rapporte vendredi 23 septembre le journal hongkongais South China Morning Post (SCMP)."
                            },
                            {
                                "example_id": "8ebfcd23-2463-4d97-a297-794b94ffcfbe",
                                "sense_id": "65af3636-9ed8-3065-9b33-53008a79e2cc",
                                "text": "« La Chine ne deviendra jamais une démocratie pluraliste, à l’image des démocraties occidentales », estime le journaliste hongkongais Lam Wo-lap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8424c2b0-ad33-4687-8a6a-5de3eea88b62",
                        "source_entry_id": "6d20bb1a-0a7a-3dd2-a415-27180db1ecc2",
