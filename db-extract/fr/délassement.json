        "fr-extract.jsonl": [
            {
                "entry_id": "a4756fa7-2cd8-379a-ab04-5ab467f240ae",
                "word": "délassement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ce55595-e68b-4718-a78f-c636a5e5edff",
                        "entry_id": "a4756fa7-2cd8-379a-ab04-5ab467f240ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "délassements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b68bcd95-2454-3bf4-8914-977b2df1612d",
                        "entry_id": "a4756fa7-2cd8-379a-ab04-5ab467f240ae",
                        "glosses": [
                            "Action de délasser, de se délasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49764392-c3c5-442b-b50d-c66d595b81e3",
                                "sense_id": "b68bcd95-2454-3bf4-8914-977b2df1612d",
                                "text": "Sans cesse en alerte, en constante défiance, les habitants de ces cavernes de pierre, n'avaient comme délassement que de basses orgies et le troussement crapuleux des maritornes."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ba78ace-f108-3fda-b3c1-a3ab926a8bfa",
                        "entry_id": "a4756fa7-2cd8-379a-ab04-5ab467f240ae",
                        "glosses": [
                            "Exercice agréable qui repose de travaux sérieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19026f9d-af35-4e1e-8884-4ad9d87e2695",
                                "sense_id": "8ba78ace-f108-3fda-b3c1-a3ab926a8bfa",
                                "text": "Le délassement de la pêche, de la chasse."
                            },
                            {
                                "example_id": "6b0ac810-ae4a-4dc8-b4e6-5ad1399a94c5",
                                "sense_id": "8ba78ace-f108-3fda-b3c1-a3ab926a8bfa",
                                "text": "Annette, envoyée à la découverte, revint en annonçant qu'on préparait chez le maréchal une somptueuse fête, et que ce délassement aurait lieu dans trois jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b65fbdc2-eddd-4704-8253-fb4aeef1db9d",
                        "source_entry_id": "a4756fa7-2cd8-379a-ab04-5ab467f240ae",
                        "target_lang_word": "Entspannung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entspannung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8da6d32-62fa-39c9-829e-76b53704f4ef",
                                        "entry_id": "18ec2879-d73c-3e64-abec-692100698058",
                                        "glosses": [
                                            "Befreiung, Beendigung von Anstrengung, Anspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c192fd-b2af-4e85-aa28-aa9b1499d616",
                                                "sense_id": "b8da6d32-62fa-39c9-829e-76b53704f4ef",
                                                "text": "Nach dieser Anstrengung brauchten wir dringend eine kurze Entspannung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9eefb5f1-e4d9-36e7-97ac-a0789f8acb73",
                                        "entry_id": "18ec2879-d73c-3e64-abec-692100698058",
                                        "glosses": [
                                            "Verminderung oder Beendigung von Konflikten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "956c8f5f-119a-477a-bbd0-9357ef1644e1",
                                                "sense_id": "9eefb5f1-e4d9-36e7-97ac-a0789f8acb73",
                                                "text": "„In der Folge trat eine Entspannung um West-Berlin ein, wenn auch der Grundkonflikt um den Viermächte-Status Berlins weiterbestand.“"
                                            },
                                            {
                                                "example_id": "e8b21500-e08a-411c-83d3-77b8631744e1",
                                                "sense_id": "9eefb5f1-e4d9-36e7-97ac-a0789f8acb73",
                                                "text": "„Für eine erste Entspannung sorgten dann ausgerechnet die militärischen Rückschläge in Ostpreußen, denn die Heeresverwaltung brauchte dringend Helfer für einfache Festungsbauarbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "457eddbe-ae53-4650-8fd2-f6bfed46be04",
                        "source_entry_id": "a4756fa7-2cd8-379a-ab04-5ab467f240ae",
                        "target_lang_word": "Zeitvertreib",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitvertreib",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                        "entry_id": "be2330b3-3529-3dd5-a73f-05dd07e3331b",
                                        "glosses": [
                                            "Tätigkeit, die man tut, um sich die Zeit zu vertreiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df26c8a-880e-4fbc-8bd8-c96ca1d1cc22",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "Zum Zeitvertreib schaute er sich im Fernsehen die Nachrichten an."
                                            },
                                            {
                                                "example_id": "da83bc52-8fcc-43ea-b60e-3adeeec6d78f",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Sobald wir mit dem Begriff Zeit zu experimentieren beginnen, und sei es auch nur als Gedankenexperiment oder zum rein intellektuellen Zeitvertreib, müssen wir feststellen, daß unsere Sprache und mit ihr unsere Denkprozesse uns sehr bald im Stich lassen.“"
                                            },
                                            {
                                                "example_id": "aa418205-367c-43d9-9dea-2be45219c2e8",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Für die Kinder wurde das zu einem Zeitvertreib.“"
                                            },
                                            {
                                                "example_id": "d602e5da-748b-4815-b113-c321ce4dbf38",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Diese nächtliche Szene, eigentlich bloß als Zeitvertreib gedacht, hat unerwartete Folgen.“"
                                            },
                                            {
                                                "example_id": "721a811d-fc3d-44eb-b0e5-6b6f3035b85f",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Ich ließ alle meine Papiere und alle verbotenen Bücher, die ich besaß, bei Signora Manzoni, die zwanzig Jahre älter war als ich, daran glaubte, daß alles Geschehen vorherbestimmt sei, und zu ihrem Zeitvertreib in dem großen Schicksalsbuch blätterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efa16936-64a4-4328-8e5f-1734597a8cb8",
