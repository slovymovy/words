                        "ranger les courses"
                    ]
                },
                {
                    "sense_id": "71164c5a-ad9a-3bdc-a6a0-40f417e5ec4c",
                    "sense_definition": "Classer ou disposer des éléments selon une suite ou un critère déterminé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bibliothécaire doit <w>ranger</w> tous ces livres par ordre alphabétique d'auteur."
                        },
                        {
                            "text": "Elle a décidé de <w>ranger</w> ses photos de vacances par année dans des albums."
