                    },
                    {
                        "translation_id": "adae4ff8-3422-4bd0-a0a5-7d018ad8e9f6",
                        "source_entry_id": "3aaccdff-716f-3230-bf24-01a24d67b6bc",
                        "source_sense_id": "06a2e7cc-1823-3329-bc68-dbc4b15a63b2",
                        "target_lang_word": "Tornado",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tornado",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                        "entry_id": "5688bc98-c509-3be7-82ff-1e6c99955428",
                                        "glosses": [
                                            "kleinräumiger Wirbelsturm, der in einer Superzelle entstehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbfff7dc-e74d-42b2-8b14-6c1f261e414f",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "Der letzte Tornado zerstörte viele Häuser."
                                            },
                                            {
                                                "example_id": "4d386fe9-4646-4460-acf2-b88c86ca21a4",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "„Wasserhosen sind Luftwirbel, ähnlich wie Tornados, aber kleiner und nicht so zerstörerisch.“"
                                            },
                                            {
                                                "example_id": "e482e4a7-e5c2-4396-8f98-529710d1152c",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "„Nun kroch ich auf der Oberseite des Schanzkleids nach achtern, inmitten eines unglaublich schrecklichen und höllischen Getöses aus Donner und Geschrei und grellen Blitzen, während der Wind die ganze Zeit wie ein Tornado blies.“"
                                            },
                                            {
                                                "example_id": "c5fa7107-ca65-4e56-828f-f8d08fbdbd84",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "„Tornados ebneten weite Landstriche ein, Tausende von Menschen kamen zu Land und zu Wasser um.“"
