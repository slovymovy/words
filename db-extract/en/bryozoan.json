                                        "sense_id": "6b393d80-4703-3b5c-8131-14c6392c2075",
                                        "entry_id": "222304ca-e2a5-3639-9dbd-3ac4fea3b168",
                                        "glosses": [
                                            "ботан. род цветковых растений семейства гвоздичных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a1f7c0f-e027-4cd9-af13-1df02a1cb0d0",
                                                "sense_id": "6b393d80-4703-3b5c-8131-14c6392c2075",
                                                "text": "Мы использовали мшанку, тимьян ползучий, камнеломки, веронику распростёртую и др."
                                            }
