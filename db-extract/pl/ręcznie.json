                                        "examples": [
                                            {
                                                "example_id": "ad9bb0b7-8827-4c30-a059-cbcc97073ab7",
                                                "sense_id": "26ce847a-45e0-3304-b7a8-06c3ec90b88d",
                                                "text": "Es de sitio llano y en la parte, que es marítima es fortísima, no tiene río natural sino hecho a mano, que es Fosa"
