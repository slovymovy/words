                    "antonyms": [
                        "opposition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "astronomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выравнивание двух небесных тел так, что они находятся близко друг к другу при наблюдении с Земли.",
                        "nl": "De stand van twee hemellichamen waarbij ze vanaf de aarde gezien dicht bij elkaar lijken te staan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединение",
                                "target_lang_sense_clarification": "астрономия"
                            },
