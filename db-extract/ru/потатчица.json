                        "entry_id": "4221f32c-b227-3be7-8f04-26d4e30ce3e0",
                        "glosses": [
                            "разг. женск. к потатчик; та, кто потакает кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea7c1b49-209e-4439-b589-f2e83fc65dac",
                                "sense_id": "b2fde007-fd66-38cb-87e4-7c28251e43c5",
                                "text": "Я злым делам и не рукодельница и не потатчица."
                            },
                            {
                                "example_id": "2cc1df6c-3a07-4676-ad6e-76fe51f83e0d",
                                "sense_id": "b2fde007-fd66-38cb-87e4-7c28251e43c5",
                                "text": "― Уж дура ли, умная ли, а такому греху не потатчица."
                            }
                        ]
                    }
