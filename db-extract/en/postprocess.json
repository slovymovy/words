                "senses": [
                    {
                        "sense_id": "e34a797c-3a74-3289-9857-bbc7b4703b92",
                        "entry_id": "1a7bce01-6513-3528-b89c-b7de798692c1",
                        "glosses": [
                            "To process after other processing has been completed."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e16ec1b3-6aae-4864-8b5e-7be6aa7b39b6",
                                "sense_id": "e34a797c-3a74-3289-9857-bbc7b4703b92",
                                "text": "He's been postprocessing all morning. He hopes to finish today."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                        "entry_id": "1a7bce01-6513-3528-b89c-b7de798692c1",
                        "glosses": [
                            "To subject to postprocessing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "40f84c67-cd7a-4aff-8db2-ef60e3e95890",
                                "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                                "text": "He's been postprocessing the 3D-printed housing by doing certain grinding and polishing steps."
                            },
                            {
                                "example_id": "d7a00991-9402-4872-9157-a278844e0f93",
                                "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                                "text": "She has to postprocess the CAD/CAM file, to prepare it for the relevant machine, before she can post it."
                            },
                            {
                                "example_id": "7cf1999d-9d2c-4c16-96e4-d967215b15b9",
                                "sense_id": "d8e0269d-1838-3789-beef-09d8125a5650",
                                "text": "We postprocess three-dimensional GRMHD models of a jet-producing radiatively inefficient accretion flow around a spinning black hole using relativistic radiative transfer and ray-tracing to produce model spectra and images."
                            }
                        ]
                    }
                ],
