                "senses": [
                    {
                        "sense_id": "30bf4bf3-299d-319b-bad3-6bb680fbe24e",
                        "entry_id": "dd7dcb02-1f60-3597-a7c6-37172e066375",
                        "glosses": [
                            "von 1931 bis 1948 bestehende zionistische paramilitärische Untergrundorganisation im britischen Mandatsgebiet Palästina"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf1eab3-8e77-4264-9e39-cf77649d6d31",
                                "sense_id": "30bf4bf3-299d-319b-bad3-6bb680fbe24e",
                                "text": "„Die Irgun hatte sich 1931 von der Hagana abgespalten und stand in den 1940er Jahren unter der Führung Menachem Begins.“"
                            },
                            {
                                "example_id": "49887baa-c45c-4c7e-b677-69c09d92633a",
                                "sense_id": "30bf4bf3-299d-319b-bad3-6bb680fbe24e",
                                "text": "„In diesen Monaten standen die schlecht bewaffneten, ungenügend organisierten Palästinenser und die arabischen Freiwilligen, die ihnen zu Hilfe gekommen waren, den paramilitärischen Gruppen der Zionisten, darunter die Haganah und die Irgun, gegenüber und wurden immer wieder besiegt.“"
                            },
                            {
                                "example_id": "ff8bccab-8499-413b-9a83-7f4c3d5fcb37",
                                "sense_id": "30bf4bf3-299d-319b-bad3-6bb680fbe24e",
                                "text": "„Als besonders grausames Massaker an der Zivilbevölkerung ging der Angriff der zionistischen Gruppen Irgun (Etzel) und Lechi auf den arabischen Ort Deir Jassin im Nordwesten Jerusalems am 9. April 1948 in die Geschichte ein.“"
                            },
                            {
                                "example_id": "3f54ae98-51a1-49fa-9571-3626b0597e91",
                                "sense_id": "30bf4bf3-299d-319b-bad3-6bb680fbe24e",
                                "text": "„Shmuel Tamir, ein ehemaliges Mitglied der militanten zionistischen Gruppierung Irgun, vertrat Grünwald vor Gericht.“"
                            },
                            {
                                "example_id": "b41c6817-081f-4245-b29b-97b2720b5706",
                                "sense_id": "30bf4bf3-299d-319b-bad3-6bb680fbe24e",
                                "text": "„Viele von ihnen waren zur Zeit des Unabhängigkeitskrieges von 1948 als Nachrichtenoffiziere für die Haganah, die Lehi oder Irgun tätig gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
