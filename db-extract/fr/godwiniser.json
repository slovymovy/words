                "senses": [
                    {
                        "sense_id": "86986182-c854-3922-85dd-907c268e56a9",
                        "entry_id": "f4e40c56-6ee0-3dc0-9a8c-8b99db84aad7",
                        "glosses": [
                            "Évoquer Hitler ou le nazisme à propos de ce que dit un contradicteur, même s’il n’y a pas de rapport évident."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17eef105-4dbe-4a38-bf06-62db4c6c01e2",
                                "sense_id": "86986182-c854-3922-85dd-907c268e56a9",
                                "text": "Pourquoi se faire bhliser, godwiniser, shoatiser en plateau ?"
                            },
                            {
                                "example_id": "d90cfdc2-888e-491e-80e6-32319f17d0c1",
                                "sense_id": "86986182-c854-3922-85dd-907c268e56a9",
                                "text": "Et si on jouait à Doc-et-ses-copines-ont-dit et les Nazis-ont-dit ? Ohhhh…ça va être supermégaFUN, on va godwiniser à gogo !!!…."
                            },
                            {
                                "example_id": "b2db730f-1426-4dfd-a678-f00754c48a35",
                                "sense_id": "86986182-c854-3922-85dd-907c268e56a9",
                                "text": "Cette méthode rapide consiste à \"godwiniser\" chaque page du wiki."
                            },
                            {
                                "example_id": "d6d44ff7-3a28-4579-98ba-165956793e13",
                                "sense_id": "86986182-c854-3922-85dd-907c268e56a9",
                                "text": "Tiens, il aura fallu attendre le 5ème post pour qu'un guignol arrive à godwiniser le débat."
                            }
                        ]
                    }
