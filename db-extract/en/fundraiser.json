                    {
                        "translation_id": "80d0378a-f9b2-43b1-b77a-045d76ade2cb",
                        "source_entry_id": "f822cf94-684a-3058-9843-3fcc0d8e5f52",
                        "source_sense_description": "event undertaken to get money",
                        "target_lang_word": "Spendenaktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spendenaktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "903349f3-5d1f-3f0d-9170-90dc312e352b",
                                        "entry_id": "9866965e-cf6d-3c27-b3bf-c8e4ec822f25",
                                        "glosses": [
                                            "Maßnahme, um Spenden für einen bestimmten Zweck einzusammeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1be2a78-f9a2-4bbc-afe5-88f21f752b0f",
                                                "sense_id": "903349f3-5d1f-3f0d-9170-90dc312e352b",
                                                "text": "„Da versprach ich ihm, ich wolle mich bei Freunden und Gönnern um eine Spendenaktion für ihn einsetzen.“"
                                            },
                                            {
                                                "example_id": "005d70dc-fc64-41d8-9e6e-2ff890552113",
                                                "sense_id": "903349f3-5d1f-3f0d-9170-90dc312e352b",
                                                "text": "„Noch einige Wochen kann er dem Druck der eigenen Bedenken standhalten, dann entschließt er sich doch, die Spendenaktion abzubrechen.“"
                                            },
                                            {
                                                "example_id": "5e9efc80-2b4a-4495-89cf-af3357e762c2",
                                                "sense_id": "903349f3-5d1f-3f0d-9170-90dc312e352b",
                                                "text": "„Durch die Spendenaktion kommen mehrere tausend Reichsmark zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
