                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c593fa-d042-4df1-a2f6-cf3f2074af6d",
                                "sense_id": "8161649b-10d6-34f6-92c8-80c4e883db48",
                                "text": "In ihrem kleinen Altstadtquartier richtete sie sich ein Atelier mit dem Blick auf den Dom ein."
                            }
