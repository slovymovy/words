                        "glosses": [
                            "To flow over the brim of; to overflow."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f69cd475-a251-45c7-95ea-88976f6d9ce1",
                                "sense_id": "9f21512b-9aa9-38cb-bd36-759ee750ba6f",
                                "text": "And still more, later flowers for the bees,\nUntil they think warm days will never cease,\nFor Summer has o'er-brimm'd their clammy cells."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fa2df81-2376-3617-a599-5aa249de8e41",
                        "entry_id": "2de9ac08-130d-3d84-b5ee-99f2e230d6a1",
                        "glosses": [
                            "To be so full as to overflow."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b9cfb973-69a8-43cc-b351-9b6b756dc239",
                                "sense_id": "9fa2df81-2376-3617-a599-5aa249de8e41",
                                "text": "And all the while, methought, his voice did swim,\nAs if it drowned in remembrance were\nOf thoughts which make the moist eyes overbrim: […]"
                            }
                        ]
                    }
