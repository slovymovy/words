                    },
                    {
                        "form_id": "db46719a-9a2b-46ba-9e0d-550f1f00ea30",
                        "entry_id": "7221fa96-66e7-34c0-8752-c2b3b6a21e78",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Whataboutismus"
                    },
                    {
                        "form_id": "5c861ae1-f1ad-4908-87b1-29b9a3398765",
                        "entry_id": "7221fa96-66e7-34c0-8752-c2b3b6a21e78",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Whataboutismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06320758-c18f-3792-bde2-f91c3833dc6e",
                        "entry_id": "7221fa96-66e7-34c0-8752-c2b3b6a21e78",
                        "glosses": [
                            "Argumentationstechnik, bei der man auf einen kritischen Vorwurf über ein Versagen mit einem Verweis auf ein Fehlverhalten oder einen Missstand auf der anderen Seite, zum Beispiel der des Gesprächspartners, verweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a16e11a-6fcf-4fef-a4c4-0388a662c99e",
                                "sense_id": "06320758-c18f-3792-bde2-f91c3833dc6e",
                                "text": "„Kürzlich wurde mir im Netz \"Whataboutismus\" vorgeworfen. Ich hatte keine Ahnung, was das ist, obwohl es nur zwei Monate vorher in einem Leitartikel der ZEIT erklärt worden war.“"
                            },
                            {
                                "example_id": "36daedda-bc5b-4218-ab96-ffc25d811378",
                                "sense_id": "06320758-c18f-3792-bde2-f91c3833dc6e",
                                "text": "„Martenstein berichtet über Whataboutismus. Dieser neudeutsche Begriff beschreibt eine beliebte Ablenkung in Debatten: Sobald eine Diskussions-Partei einer anderen eine Verfehlung vorwirft, kontert diese mit dem Argument „aber was ist denn mit XY.“ XY steht dabei für einen beliebigen Fehltritt des Gesprächspartners.“"
                            },
                            {
                                "example_id": "961fbbe3-1641-4112-92b6-9a670ee99710",
                                "sense_id": "06320758-c18f-3792-bde2-f91c3833dc6e",
                                "text": "„Genannt wird dieses Muster \"Whataboutismus\". Der Begriff stammt von der englischen Frage \"What about…?\", was auf Deutsch bedeutet: \"Und was ist mit…?\" Beklagt jemand zum Beispiel die Zunahme von Rechtsextremismus, heißt es nur allzu oft: \"Und was ist mit den Linken?\" – als ob das rechtsextreme Gewalt irgendwie besser machen würde.“"
                            },
                            {
                                "example_id": "29d0a421-6dcd-4463-bd87-cb4b6d930f2e",
                                "sense_id": "06320758-c18f-3792-bde2-f91c3833dc6e",
                                "text": "„„Guck mal, Dresden, Hauptstadt des Whataboutismus: Das ist Köln 1945. 70% kaputt. 20.000 Tote allein durch Luftangriffe. Und keiner jammert“, schrieb der 35-Jährige am Montag zu einem Foto des von Bomben zerstörten Köln.“"
                            },
                            {
                                "example_id": "ed6ad1ff-de4b-4079-87b1-971c3cb60226",
                                "sense_id": "06320758-c18f-3792-bde2-f91c3833dc6e",
                                "text": "„Das, was ich hier tue, nennt man Whataboutismus. Auf eine Frage gibt es eine Gegenfrage, ein what about, ein was ist mit, sozusagen ein Ausweichmanöver, das von der Ausgangsfrage ablenken soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cd4c41f-ff40-42c3-8fa5-142fac49ee19",
                        "source_entry_id": "7221fa96-66e7-34c0-8752-c2b3b6a21e78",
                        "source_sense_id": "06320758-c18f-3792-bde2-f91c3833dc6e",
                        "target_lang_word": "whataboutism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whataboutism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd60ccf2-cd0c-39ac-8b04-c4f2f4c0d716",
                                        "entry_id": "3409084c-35e2-3eb5-8f9d-082468862bfd",
                                        "glosses": [
                                            "A logical fallacy where criticisms are deflected by raising unrelated criticisms of the opposite side."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d7fdf61-1068-49ad-b0ca-7262c86b6f03",
                                                "sense_id": "cd60ccf2-cd0c-39ac-8b04-c4f2f4c0d716",
                                                "text": "And I'd no time at all for 'What aboutism' - you know, people who said 'Yes, but what about what's been done to us? ... That had nothing to do with it, and if you got into it you were defending the indefensible."
                                            },
                                            {
                                                "example_id": "6936ba8e-53c7-47e1-97b0-e0572281ff92",
                                                "sense_id": "cd60ccf2-cd0c-39ac-8b04-c4f2f4c0d716",
                                                "text": "Soviet propagandists during the cold war were trained in a tactic that their western interlocutors nicknamed 'whataboutism'."
                                            },
                                            {
                                                "example_id": "e82155b1-b1ef-46e1-9682-b035939d962c",
                                                "sense_id": "cd60ccf2-cd0c-39ac-8b04-c4f2f4c0d716",
                                                "text": "'Whataboutism' was a favourite tactic of Soviet propagandists during the old Cold War. Any criticism of the Soviet Union’s internal aggression or external repression was met with a 'what about?' some crime of the West, from slavery to the Monroe doctrine."
                                            },
                                            {
                                                "example_id": "3b489902-de8b-4bee-b226-40f67208cba8",
                                                "sense_id": "cd60ccf2-cd0c-39ac-8b04-c4f2f4c0d716",
                                                "text": "There's another attitude ... that many Russians seem to share, what used to be called in the Soviet Union 'whataboutism,' in other words, 'who are you to call the kettle black?'"
                                            },
                                            {
                                                "example_id": "35fb3f13-6c7b-4ebe-8ef4-c71b8fc9ce1b",
                                                "sense_id": "cd60ccf2-cd0c-39ac-8b04-c4f2f4c0d716",
                                                "text": "what was known during Soviet times, as 'whataboutism'"
                                            },
                                            {
                                                "example_id": "561df645-2122-4782-bc19-f7c1a068ec2e",
                                                "sense_id": "cd60ccf2-cd0c-39ac-8b04-c4f2f4c0d716",
                                                "text": "This particular brand of changing the subject is called 'whataboutism' — a simple rhetorical tactic heavily used by the Soviet Union and, later, Russia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
