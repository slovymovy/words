                ],
                "senses": [
                    {
                        "sense_id": "b534bc26-ac12-30b2-ad0a-1fa87e5b3bf0",
                        "entry_id": "39f57691-ed6c-3536-b3d3-d45f2c9216fe",
                        "glosses": [
                            "Considérer d’un point de vue herméneutique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a96f42e-0dd8-4481-ae7a-4cebc6e7dd9e",
                                "sense_id": "b534bc26-ac12-30b2-ad0a-1fa87e5b3bf0",
                                "text": "Il faut donc rejeter le conciliabule sans l'herméneutiser, comme il faut rejeter la déclaration des droits de l'homme."
                            },
                            {
                                "example_id": "2ebde6ab-427d-46fc-9541-6fe570c83037",
                                "sense_id": "b534bc26-ac12-30b2-ad0a-1fa87e5b3bf0",
                                "text": "L'école de Francfort s'est chargée d'herméneutiser le marxisme et le freudisme (rejoint sur Freud par Ricoeur)."
                            },
                            {
                                "example_id": "046be1ec-83e7-402c-8a8a-5839fb6f79fc",
                                "sense_id": "b534bc26-ac12-30b2-ad0a-1fa87e5b3bf0",
                                "text": "Dès qu’elle commence à s’herméneutiser, l’ontologie, sous les espèces de la phénoménologie-herméneutique s’oriente vers une métamorphose radicale, puisqu’au lieu de demeurer le logos descriptif de la réalité extralinguistique la plus fondamentale, elle se fait quête du sens."
                            }
                        ]
                    }
                ],
