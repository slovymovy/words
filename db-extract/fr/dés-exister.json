                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f64ce9b8-cf9a-4c54-974e-a58f4d661c0e",
                                "sense_id": "0baa6522-bc9e-3f89-b43a-71f67357cd7a",
                                "text": "Mourir, puis renaître, revenir à cet état qui précède la naissance et suit la mort. Il aurait voulu dés-exister. Devenir un autre."
                            },
                            {
                                "example_id": "fa36366e-e2f8-46ea-b6f6-4aa104f04335",
                                "sense_id": "0baa6522-bc9e-3f89-b43a-71f67357cd7a",
                                "text": "Mais on peut au moins essayer de ne pas se faire le prisonnier, de ne pas se rendre le complice actif de tels mécanismes et, au-delà, de commencer à faire dés-exister ce type d’objet et de relations molaires !"
                            }
                        ]
