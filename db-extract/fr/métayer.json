                        "entry_id": "ba41ef05-e7aa-3c2e-91a4-85d455a57024",
                        "glosses": [
                            "Naturalpächter, Halbpächter"
                        ],
                        "tags": [
                            "Pachtbauer",
                            "der seinen Zins in Naturalabgaben (Früchten",
