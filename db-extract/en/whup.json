                "senses": [
                    {
                        "sense_id": "9ce8686d-faa7-38bf-a575-f97273c9f3e2",
                        "entry_id": "56135088-5ccb-3f49-9985-0b1852b930f3",
                        "glosses": [
                            "Alternative form of whoop (“to whip, thrash, or defeat”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "colloquial",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "9934589e-2011-486c-9c7f-b925a9541d30",
                                "sense_id": "9ce8686d-faa7-38bf-a575-f97273c9f3e2",
                                "text": "We had him stopped the year before, the time we whupped him at Stone's River at the end of Sixty-two: we tarred him out so bad he had to wait."
                            },
                            {
                                "example_id": "30bf3e5e-ca5d-4c31-aef4-77b2240deb96",
                                "sense_id": "9ce8686d-faa7-38bf-a575-f97273c9f3e2",
                                "text": "Whyn't ya whup her, Ma? […] Go on, give her a whup."
                            },
                            {
                                "example_id": "3ca05380-b8b7-4a45-8bb0-7080103a365e",
                                "sense_id": "9ce8686d-faa7-38bf-a575-f97273c9f3e2",
                                "text": "He might have come after Bart […] because he wanted to whup a nigger?"
                            },
                            {
                                "example_id": "c6d24ba6-f733-4de6-a0b7-bf651a97d267",
                                "sense_id": "9ce8686d-faa7-38bf-a575-f97273c9f3e2",
                                "text": "I used to whup you four games out of five.\nWhat you gonna do ... give me a whupping? You can't whup me no more. You're too old."
                            }
                        ]
                    }
                ],
