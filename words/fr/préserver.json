                {
                    "sense_id": "3fca9200-bfae-338b-b1c5-cdcc01390114",
                    "sense_definition": "Protéger ou mettre à l'abri quelqu'un ou quelque chose contre un danger ou un mal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce manteau très chaud permet de se <w>préserver</w> du froid en hiver.",
                            "target_lang_translations": {
                                "en": "This very warm coat lets you <w>protect</w> yourself from the cold in winter.",
                                "ru": "Это очень тёплое пальто позволяет <w>уберечься</w> от холода зимой.",
                                "nl": "Met deze zeer warme jas kun je je in de winter tegen de kou <w>beschermen</w>.",
                                "de": "Mit diesem sehr warmen Mantel kann man sich im Winter vor der Kälte <w>schützen</w>.",
                                "pl": "Ten bardzo ciepły płaszcz pozwala <w>ochronić się</w> przed zimnem zimą.",
                                "it": "Questo cappotto molto caldo permette di <w>ripararsi</w> dal freddo in inverno.",
                                "cs": "Tento velmi teplý kabát vás v zimě <w>uchrání</w> před chladem.",
                                "tr": "Bu çok sıcak mont sayesinde kışın soğuktan <w>korunabilirsiniz</w>.",
                                "es": "Este abrigo muy cálido permite <w>resguardarse</w> del frío en invierno.",
                                "zh": "这件很暖和的大衣能让你在冬天<w>抵御</w>寒冷。"
                            }
                        },
                        {
                            "text": "Les pompiers ont lutté toute la nuit pour <w>préserver</w> les maisons du feu.",
                            "target_lang_translations": {
                                "en": "The firefighters fought all night to <w>save</w> the houses from the fire.",
                                "ru": "Пожарные боролись всю ночь, чтобы <w>уберечь</w> дома от огня.",
                                "nl": "De brandweerlieden vochten de hele nacht om de huizen tegen het vuur te <w>beschermen</w>.",
                                "de": "Die Feuerwehrleute kämpften die ganze Nacht darum, die Häuser vor dem Feuer zu <w>schützen</w>.",
                                "pl": "Strażacy walczyli całą noc, by <w>uchronić</w> domy przed ogniem.",
                                "it": "I pompieri hanno lottato tutta la notte per <w>proteggere</w> le case dal fuoco.",
                                "cs": "Hasiči bojovali celou noc, aby <w>uchránili</w> domy před ohněm.",
                                "tr": "İtfaiyeciler evleri yangından <w>korumak</w> için bütün gece mücadele etti.",
                                "es": "Los bomberos lucharon toda la noche para <w>proteger</w> las casas del fuego.",
                                "zh": "消防员奋战了一整夜，以<w>保护</w>房屋免受大火侵害。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abriter",
                        "garantir",
                        "prémunir"
                    ],
                    "antonyms": [
                        "exposer"
                    ],
                    "common_phrases": [
                        "se préserver du froid",
                        "préserver du danger"
                    ],
                    "target_lang_definitions": {
                        "en": "To protect someone or something from danger or harm, or shelter them from it.",
                        "ru": "Защищать кого-либо или что-либо от опасности или вреда либо укрывать их от этого.",
                        "nl": "Iemand of iets beschermen tegen gevaar of schade, of er voor afschermen.",
                        "de": "Jemanden oder etwas vor Gefahr oder Schaden schützen oder abschirmen.",
                        "pl": "Chronić kogoś lub coś przed niebezpieczeństwem lub szkodą albo osłaniać ich przed nimi.",
                        "it": "Proteggere qualcuno o qualcosa da un pericolo o un danno, oppure metterlo al riparo.",
                        "cs": "Chránit někoho nebo něco před nebezpečím či újmou, případně je ukrýt před nimi.",
                        "tr": "Birini ya da bir şeyi tehlike veya zarara karşı korumak ya da bunlardan uzak tutmak.",
                        "es": "Proteger o resguardar a alguien o algo de un peligro o un daño.",
                        "zh": "使某人或某物免受危险或伤害，或为其遮挡寒冷等侵害。"
                    },
