                    {
                        "translation_id": "169c9a72-acc1-4d66-8560-7ffc0109e2c6",
                        "source_entry_id": "23728a50-fac4-3e78-bde9-61a6f758333c",
                        "target_lang_word": "Anflug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anflug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "680d7106-86b7-3e31-af49-ee728cb91f66",
                                        "entry_id": "31dcfba3-bf46-3716-823e-c918633fdcef",
                                        "glosses": [
                                            "Landen eines Flugzeugs (oder Flugtieres)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b5c830-a3d6-4a05-95ac-2e36819f3339",
                                                "sense_id": "680d7106-86b7-3e31-af49-ee728cb91f66",
                                                "text": "Der Anflug gelang trotz des Sturmes gleich beim ersten Mal."
                                            },
                                            {
                                                "example_id": "ba8ee59d-8b6c-402f-97c4-93d76f022225",
                                                "sense_id": "680d7106-86b7-3e31-af49-ee728cb91f66",
                                                "text": "„Das Projektil blieb weiterhin im Anflug auf den Nordpol und hatte das Mondzentrum weit hinter sich gelassen.“"
                                            },
                                            {
                                                "example_id": "ad72a706-cbfa-419e-8a45-ac61e535aaa9",
                                                "sense_id": "680d7106-86b7-3e31-af49-ee728cb91f66",
                                                "text": "„Zu gefährlichen Jagdszenen in der Luft kam es am Sonntag über Oberammergau. Ein Gleitschirmpilot befand sich im Anflug auf eine Oberammergauer Landeplatz, als ihn das ferngesteuerte Flugobjekt fast zum Absturz brachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d0b8b22-3c33-3675-95da-3ed99836fb4a",
                                        "entry_id": "31dcfba3-bf46-3716-823e-c918633fdcef",
                                        "glosses": [
                                            "schwache Ausprägung einer Reaktion oder eines Verhaltens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4cb67a-f072-4cdf-a130-02eb51240300",
                                                "sense_id": "7d0b8b22-3c33-3675-95da-3ed99836fb4a",
                                                "text": "Ihr Gesicht zeigte einen Anflug von Verlegenheit."
                                            },
                                            {
                                                "example_id": "08431991-00d9-4496-b40b-ba12cfe24e56",
                                                "sense_id": "7d0b8b22-3c33-3675-95da-3ed99836fb4a",
                                                "text": "„Ein Anflug von Verbissenheit fiel mir jetzt auf.“"
                                            },
                                            {
                                                "example_id": "f4720cdb-5a7c-459d-bc17-8955c2044882",
                                                "sense_id": "7d0b8b22-3c33-3675-95da-3ed99836fb4a",
                                                "text": "„Diese litt es aber nicht, sondern umarmte sie mit einem Anflug von Verlegenheit, zugleich sichtlich bewegt durch diese Huldigung einer heiteren und liebenswürdigen Natur.“"
                                            },
                                            {
                                                "example_id": "742d47ea-8882-41bd-9c98-acfab0c3e15f",
                                                "sense_id": "7d0b8b22-3c33-3675-95da-3ed99836fb4a",
                                                "text": "„Es muß nicht immer Lessing sein. Obwohl natürlich, wie Sie schon gelesen haben (…), eine Berufung auf die klangvollen Namen unserer Geistesgeschichte sich in hervorragender Weise dazu eignet, jeden Widerspruch oder auch nur den Anflug eines Zweifels von vornherein zu unterbinden.“"
                                            },
                                            {
                                                "example_id": "e13c0865-e596-493a-ab62-c3591787f67a",
                                                "sense_id": "7d0b8b22-3c33-3675-95da-3ed99836fb4a",
                                                "text": "„Ich glaubte, einen Anflug von Skepsis in Bens Gesicht zu entdecken, während ich versuchte, Lady Catherine, Reitpferde und den in Saffron Walden ansässigen Teil einer weitverzeigten adeligen Familie zu googeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d19653e2-6f86-32bf-ab5a-3d8c7ddd5eef",
                                        "entry_id": "31dcfba3-bf46-3716-823e-c918633fdcef",
                                        "glosses": [
                                            "Verbreitung von Samen durch den Wind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7880822d-68a4-44ee-9dbf-a937ffd7c648",
                                                "sense_id": "d19653e2-6f86-32bf-ab5a-3d8c7ddd5eef",
                                                "text": "Die meisten Baumbestände wurden durch Anflug gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8abdb76c-c5d4-4359-a06a-9961ee39b581",
                        "source_entry_id": "23728a50-fac4-3e78-bde9-61a6f758333c",
                        "target_lang_word": "Anlauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anlauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7474f7f9-b0f0-39c4-a8d7-48d96c61a47f",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "das Laufen vor einem Sprung oder Stoß, um Schwung zu holen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e14f83-8237-41bf-bc35-568aba751a55",
                                                "sense_id": "7474f7f9-b0f0-39c4-a8d7-48d96c61a47f",
                                                "text": "Wenn du ein bisschen mehr Anlauf nimmst, kannst du weiter springen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "Versuch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d46c5b5-eff1-4f10-9af3-f919c8d9b1b4",
                                                "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                                "text": "Er hat es sofort beim ersten Anlauf geschafft."
                                            },
                                            {
                                                "example_id": "560dba9c-8293-4ef8-abd2-eb564a85bf89",
                                                "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                                "text": "„Nun hat es doch geklappt: Friedrich Merz ist im zweiten Anlauf zum Bundeskanzler gewählt worden.“"
                                            },
                                            {
                                                "example_id": "9d06c92b-5c43-4149-a29c-75ce89138d02",
                                                "sense_id": "9a01fbe0-f0d5-328b-926d-0a9d3ff7b278",
                                                "text": "„Nachdem in mehreren Anläufen die zweifelsfrei höchste Stelle des Kibo ermittelt werden konnte, kommt es am 6. Oktober 1889 endlich und ohne weitere Umstände zur Erstbesteigung der höchsten Erhebung des Kilimandscharo-Massivs durch Meyer und Putscheller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "72b7ad03-7c9f-3b7f-901c-172d9f83ae65",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "„Verbindungsglied zwischen einer waagerechten Platte und einer Wand in der Architektur“"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "das Anfahren eines Hafens"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3090537d-1dea-475c-afd6-9eb2c8dc8ecd",
                                                "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                                "text": "„Neben den reinen Liegeplatzgebühren addieren sich andere Gebühren und Dienstleistungen für einen Anlauf zu einer Gesamtkalkulation.“"
                                            },
                                            {
                                                "example_id": "11c795c4-0c8a-48e0-9bf8-8065935d3ea0",
                                                "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                                "text": "„Anlässlich des 100. Anlaufs eines MSC-Kreuzfahrtschiffes in Hamburg, kam der Chef selbst nach Hamburg.“"
                                            },
                                            {
                                                "example_id": "b3549b79-2399-4db5-900e-c25f841ef1b4",
                                                "sense_id": "0d1b2847-5444-35f0-9480-a5f29484ecc1",
                                                "text": "„Nach dem ersten Anlauf stach das 293 Meter lange und für 3223 Passagiere sowie 1000 Besatzungsmitglieder ausgelegte Schiff abends zur zwölftägigen Ostsee- und Baltikumreise in See.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "01df44ec-d63c-30c8-aec1-323f03d640bc",
                                        "entry_id": "7e46836c-5142-3b91-9b17-a5dbce09c936",
                                        "glosses": [
                                            "„das langsame Steigern der Betriebsgeschwindigkeit einer Maschine“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97fbc83-b7bd-4a71-9c1a-307c7877e92c",
                                                "sense_id": "01df44ec-d63c-30c8-aec1-323f03d640bc",
                                                "text": "„Wollte man den laufenden Motor mit dem beim Anlauf benutzten Sättigungsgrad dauernd arbeiten lassen, so verbrauchte die Erregung unverhältnismäßig viel Energie […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
