        "fr-extract.jsonl": [
            {
                "entry_id": "91ff2ab9-c859-30e3-af40-326114e2a14b",
                "word": "Pauline",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f9715710-e2c2-42e6-9635-a52ff60e8fbe",
                        "entry_id": "91ff2ab9-c859-30e3-af40-326114e2a14b",
                        "tags": [
