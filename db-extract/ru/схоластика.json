                                "target_senses": [
                                    {
                                        "sense_id": "05754b4c-416a-379d-aa93-89d27625e890",
                                        "entry_id": "27be4f8f-f75a-34ff-af7a-bb80d52e27e2",
                                        "glosses": [
                                            "de middeleeuwse academische filosofie die van universiteiten uitgaat, in tegenstelling tot de monastieke filosofie van de Kerk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e0f799-f007-4482-8596-7e535327a48e",
                                                "sense_id": "05754b4c-416a-379d-aa93-89d27625e890",
                                                "text": "In de scholastiek is het gezag van vroegere auteurs uitgangspunt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cac8cbd2-3576-324f-85c4-dfaa6a951944",
                                        "entry_id": "27be4f8f-f75a-34ff-af7a-bb80d52e27e2",
                                        "glosses": [
                                            "geheel van samenhangende opvattingen waarvan de schijnbare logica berust op het aanvaarden van traditionele autoriteit"
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a01274-cc0d-4250-9cea-b720e6839c80",
                                                "sense_id": "cac8cbd2-3576-324f-85c4-dfaa6a951944",
                                                "text": "Het Marxisme verwerd tot een onvruchtbare scholastiek door communistische dogma's."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scholastiek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9453fc-4214-3733-8328-853f32fcdeae",
                                        "entry_id": "c5abefde-4e4f-38bd-98ce-73ddc270d441",
                                        "glosses": [
                                            "stu­de­ren­de jon­ge kloos­ter­ling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d40a813e-a9c4-4def-9a30-36a28eaf9391",
                                                "sense_id": "ab9453fc-4214-3733-8328-853f32fcdeae",
                                                "text": "De scholastieken probeerden de kennis uit de Oudheid en de boodschap uit de Bijbel met elkaar in overeenstemming te brengen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa3e1e0-e3ef-390c-900f-1e58ef56450a",
                                        "entry_id": "c5abefde-4e4f-38bd-98ce-73ddc270d441",
                                        "glosses": [
                                            "jonge monnik die zich in de christelijke leer verdiept"
                                        ],
                                        "tags": [
                                            "rooms-katholiek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55e2e865-0523-4415-855e-f259601837f6",
                                                "sense_id": "aaa3e1e0-e3ef-390c-900f-1e58ef56450a",
                                                "text": "Op de school van de jezuïeten gaven ook scholastieken les."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scholastiek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "99b5c98d-a64b-3397-b71a-c1d4cc67f94f",
