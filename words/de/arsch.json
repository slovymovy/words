                {
                    "sense_id": "cc868414-715a-3f59-9ef5-3b7e35c5f703",
                    "sense_definition": "eine verachtenswerte, rücksichtslose oder gemeine Person",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schimpfwort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warum musst du zu deinen Kollegen immer so ein blöder <w>Arsch</w> sein?",
                            "target_lang_translations": {
                                "en": "Why do you always have to be such a dumb <w>jerk</w> to your colleagues?",
                                "ru": "Почему ты вечно должен быть таким тупым <w>козлом</w> по отношению к своим коллегам?",
                                "nl": "Waarom moet je tegen je collega's altijd zo'n stomme <w>lul</w> zijn?",
                                "pl": "Dlaczego musisz być zawsze takim głupim <w>dupkiem</w> wobec swoich kolegów?",
                                "fr": "Pourquoi dois-tu toujours être un sale <w>connard</w> avec tes collègues ?",
                                "it": "Perché devi essere sempre un tale <w>stronzo</w> con i tuoi colleghi?",
                                "cs": "Proč musíš být ke svým kolegům pořád takový blbý <w>hajzl</w>?",
                                "tr": "Neden iş arkadaşlarına karşı her zaman böyle aptal bir <w>pislik</w> olmak zorundasın?",
                                "es": "¿Por qué tienes que ser siempre un <w>capullo</w> tan insoportable con tus compañeros?",
                                "zh": "为什么你对同事总要当个讨厌的<w>混蛋</w>？"
                            }
                        },
                        {
                            "text": "Dieser arrogante <w>Arsch</w> hat uns gestern einfach mitten im Regen stehen lassen.",
                            "target_lang_translations": {
                                "en": "That arrogant <w>asshole</w> just left us standing in the middle of the rain yesterday.",
                                "ru": "Этот высокомерный <w>мудак</w> вчера просто оставил нас стоять под дождём.",
                                "nl": "Die arrogante <w>klootzak</w> heeft ons gisteren gewoon midden in de regen laten staan.",
                                "pl": "Ten arogancki <w>dupek</w> po prostu zostawił nas wczoraj na środku deszczu.",
                                "fr": "Ce <w>connard</w> arrogant nous a tout simplement laissés en plan sous la pluie hier.",
                                "it": "Quello <w>stronzo</w> arrogante ieri ci ha semplicemente lasciati lì sotto la pioggia.",
                                "cs": "Ten arogantní <w>hajzl</w> nás včera prostě nechal stát na dešti.",
                                "tr": "Bu kibirli <w>pislik</w> dün bizi öylece yağmurun ortasında bıraktı.",
                                "es": "Ese <w>cabrón</w> arrogante nos dejó ayer tirados en medio de la lluvia sin más.",
                                "zh": "那个傲慢的<w>混蛋</w>昨天竟然把我们直接丢在大雨中不管。"
                            }
                        }
