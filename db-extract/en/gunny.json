                ],
                "senses": [
                    {
                        "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                        "entry_id": "6923a567-a11d-34e2-97da-3b03182c4f08",
                        "glosses": [
                            "A gunnery sergeant."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f7511dce-d46b-4c29-8a90-2ac62d322235",
                                "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                                "text": "The gunny's voice reverberated between the barracks as we marched, “Ya left right . . . left right . . . left right left. […] Then the gunny unexpectedly stopped our forward movement. “Company, halt!”"
                            },
                            {
                                "example_id": "394c74bb-7a8e-4d1f-b976-e9569051cdae",
                                "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                                "text": "“As a rule of thumb, Marine corporals, when a gunny asks a question, answer it,”"
                            },
                            {
                                "example_id": "928980e7-65e8-4f93-85a8-7b38bde133cf",
                                "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                                "text": "Alongside even' officer chain of command is an enlisted one, and the company gunnery sergeant (\"gunny\" for short) is the enlisted counterpart […] Without a gunny, the day-to-day operations of the infantry would likely grind to a halt."
                            }
                        ]
                    }
