                        "glosses": [
                            "S’infliger à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24eb7c90-2236-459e-bfbb-8780f72c7698",
                                "sense_id": "ec82e439-112c-3e9d-adb9-02cae31bbea7",
                                "text": "C’est plus intéressant que de venir s’auto-infliger une dette dont on n'est pas vraiment responsable."
                            },
                            {
                                "example_id": "2fdf309e-c8a9-4e7c-af13-5232f120ddad",
                                "sense_id": "ec82e439-112c-3e9d-adb9-02cae31bbea7",
                                "text": "Bien sûr, ce n’est pas à cause de ça, mais Lyon n’avait pas besoin de s’auto-infliger des handicaps."
                            },
                            {
                                "example_id": "95c2512d-0b08-4c18-b3c0-2975c8997998",
                                "sense_id": "ec82e439-112c-3e9d-adb9-02cae31bbea7",
                                "text": "La stupidité de cette blessure auto-infligée le fit sourire, comme le plaisir enivrant d’avoir survécu au premier assaut."
                            }
                        ]
                    }
                ],
