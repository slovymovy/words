        "magnetosphere"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "694fcbba-ce5b-3cef-94ff-66cdfbd3b1b4",
                    "sense_definition": "A piece of material that attracts some metals by magnetism.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child used a small <w>magnet</w> to pick up the paperclips from the floor.",
                            "target_lang_translations": {
                                "ru": "Ребенок использовал маленький <w>магнит</w>, чтобы собрать скрепки с пола."
                            }
                        },
                        {
                            "text": "A refrigerator <w>magnet</w> is often used to hold notes and photos on the door.",
                            "target_lang_translations": {
                                "ru": "<w>Магнит</w> на холодильник часто используют, чтобы закрепить записки и фотографии на дверце."
                            }
                        }
                    ],
                    "synonyms": [
                        "lodestone"
                    ],
                    "common_phrases": [
                        "refrigerator magnet",
                        "bar magnet",
                        "horseshoe magnet",
                        "strong magnet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок материала, обладающий свойством притягивать некоторые металлы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магнит",
                                "target_lang_sense_clarification": "физический объект"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09432cea-367f-352e-b290-ba3fd48c3c44",
                    "sense_definition": "An alluring or attractive person or thing that draws others toward it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vibrant city center is a <w>magnet</w> for tourists during the summer months.",
                            "target_lang_translations": {
                                "ru": "Оживленный центр города — настоящий <w>магнит</w> для туристов в летние месяцы."
                            }
                        },
                        {
                            "text": "He seems to be a <w>magnet</w> for trouble no matter where he goes.",
                            "target_lang_translations": {
                                "ru": "Кажется, он притягивает неприятности как <w>магнит</w>, куда бы он ни пошел."
                            }
                        }
                    ],
                    "synonyms": [
                        "draw",
                        "attraction",
                        "lure"
                    ],
                    "common_phrases": [
                        "magnet for trouble",
                        "tourist magnet",
                        "talent magnet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, обладающие притягательной силой и привлекающие других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магнит",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "центр притяжения",
                                "target_lang_sense_clarification": "о месте или событии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e411be5b-1809-316f-bd5b-e89eec137aea",
                    "sense_definition": "A shortened term for a <w>magnet</w> link used in file sharing to identify files by content.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of downloading a torrent file, you can just click the <w>magnet</w> to start the transfer.",
                            "target_lang_translations": {
                                "ru": "Вместо загрузки торрент-файла можно просто нажать на <w>магнит</w>, чтобы начать передачу."
                            }
                        },
                        {
                            "text": "The website provides <w>magnet</w> links for all its open-source software downloads.",
                            "target_lang_translations": {
                                "ru": "Сайт предоставляет <w>магнит-ссылки</w> для скачивания всего своего программного обеспечения с открытым исходным кодом."
                            }
                        }
                    ],
                    "synonyms": [
                        "magnet link"
                    ],
                    "common_phrases": [],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "ellipsis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название магнит-ссылки, используемой в файлообменных сетях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магнит",
                                "target_lang_sense_clarification": "жаргон в файлообмене"
                            },
                            {
                                "target_lang_word": "магнит-ссылка",
                                "target_lang_sense_clarification": "полный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}