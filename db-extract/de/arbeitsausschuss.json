                ],
                "senses": [
                    {
                        "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                        "entry_id": "002dac19-3965-3af7-abea-042277b00b36",
                        "glosses": [
                            "Gruppe von Personen (häufig aus einer Organisation, beispielsweise einem Parlament, einer Partei, einem Wirtschaftsverband), die sich mit einem Thema befassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b649eb-4e66-4fbf-ad53-492c213c2c37",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Hans-Georg Niedermeyer leitet im Bayerischen Arbeitsministerium den Arbeitsausschuss Marktüberwachung.“"
                            },
                            {
                                "example_id": "9cd10a7b-f201-444f-8b94-b1897b5409a3",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Was war am 29. Jan. 1931? – Der Arbeitsausschuss des Verwaltungsrates der Deutschen Reichspost beschließt, Personen mit einer mindestens halbjährigen Arbeitslosigkeit die Zahlung der Rundfunkgebühren zu erlassen.“"
                            },
                            {
                                "example_id": "7767fb37-bf7f-46f1-aa14-b11d0a6f16c3",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Was war am 19. Jun. 1945? – Die Kommunistische Partei Deutschlands (KPD) und die Sozialdemokratische Partei Deutschlands (SPD) bilden in Berlin einen gemeinsamen Arbeitsausschuss der die weitere Zusammenarbeit der Parteien koordinieren soll.“"
                            },
                            {
                                "example_id": "109ae21c-64d4-4d57-bc91-ace4d2e7fabe",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Was war am 7. Mrz. 1958? – 40 Persönlichkeiten aus dem politischen , kulturellen und kirchlichen Leben der Bundesrepublik gründen in Frankfurt am Main den Arbeitsausschuss \"Kampf dem Atomtod\".“"
                            },
                            {
                                "example_id": "57aef4f1-7bfa-4d42-93e5-a369589b268f",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Der wohlhabende Fürst zu Fürstenberg förderte das Projekt, woraufhin ein dreiköpfiger Arbeitsausschuss eingerichtet wurde.“"
                            },
                            {
                                "example_id": "3c95eecc-ad03-459c-89ff-0170fce673e7",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„»Auf ein Siegel vertraue ich tatsächlich und das ist Spielgut. Spielgut ist ein Arbeitsausschuss, der 500 Artikel im Jahr überprüft und nur 250 erhalten dieses Zeichen.«“ […]"
                            },
                            {
                                "example_id": "93d3305f-4a73-4436-bfd0-8c2593d66713",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Auch Mirko Rüsing vom Arbeitsausschuss Innenstadt in Braunschweig sagte auf NDR Anfrage: »Wir gehen davon aus, dass das noch ein gutes Shopping-Erlebnis wird in der Innenstadt.«“"
                            },
                            {
                                "example_id": "6d902d56-2f72-48ea-a6aa-a845b828c80c",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Im Anschluss an die konstituierende Sitzung des Rundfunkrats haben sich die künftig drei Arbeitsausschüsse des Rundfunkrats konstituiert:“ […]"
                            },
                            {
                                "example_id": "4619afff-8624-4666-ad42-2b5911cc2ab9",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Der Vorsitzende von IPN Leon Kieres wird im Institut einen speziellen Arbeitsausschuss aus Historikern und Archivaren gründen, der alle Umstände im Zusammenhang mit der Arbeit des Ost-Instituts klären soll.“"
                            },
                            {
                                "example_id": "5bfe827d-a375-44c5-9b2e-11d8f1f62def",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Seit Januar 2020 leitet Klaus Bogenberger an der Technischen Universität München den Lehrstuhl für Verkehrstechnik. Und er steht dem Arbeitsausschuss für theoretische Grundlagen des Straßenverkehrs der Forschungsgesellschaft für Straßen- und Verkehrswesen vor.“"
                            },
                            {
                                "example_id": "de3e6d85-8557-44fa-8356-c7a9ac6574de",
                                "sense_id": "d7fbddaf-5401-3dda-8fa1-2d15e5a6d9ba",
                                "text": "„Doch die Änderung von Industrienormen ist extrem zeitaufwendig. Zunächst muss der Arbeitsausschuss für Endoprothetik des Deutschen Instituts für Normierung (DIN) eine einstimmige Entscheidung treffen, dann müssen die neuen Normen international von allen anderen Ländern im ISO-Ausschuss bestätigt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
