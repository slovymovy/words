                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ea9e4a4-0218-3748-98b9-762336971fef",
                        "entry_id": "3ab18df1-ce6d-3bdc-ba47-5737c8d268f6",
                        "glosses": [
                            "Bienveillance, disposition à vouloir le bien d’autrui, volonté de le rendre heureux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ac8b0a3d-fcc7-4273-a1cd-916aca501cdd",
                                "sense_id": "0ea9e4a4-0218-3748-98b9-762336971fef",
                                "text": "Je comprends, je comprends, pourquoi il m’en veut, il est jaloux ;il a vu, peut-être, les marques toutes particulières de bénévolence qui me sont octroyées."
                            },
                            {
                                "example_id": "e259144c-7526-407a-81a8-8665c83e652f",
                                "sense_id": "0ea9e4a4-0218-3748-98b9-762336971fef",
                                "text": "Mon Dieu, mon Dieu, pitié ! Mes péchés pénitents\nLèvent leurs pauvres bras vers ta bénévolence,\nÔ ne les souffre pas criant en vain !"
                            },
                            {
                                "example_id": "ff8abac7-4ffe-44f0-9192-eb3c290a4639",
                                "sense_id": "0ea9e4a4-0218-3748-98b9-762336971fef",
                                "text": "Le chauffeur jouait les caïds : il jetait les colis comme des aumônes, et leur distribution ne paraissait dépendre que de sa bénévolence et de son arbitraire."
                            },
                            {
                                "example_id": "08feb475-d2b5-40d9-a027-1cd3ca610d2d",
                                "sense_id": "0ea9e4a4-0218-3748-98b9-762336971fef",
                                "text": "« Cela le mit d’autant meilleure humeur que chaque instant le rapprochait du moment où le repas allait pour de bon commencer. Aussi accueillit-il avec bénévolence un personnage qui avait l’air de qualité… »."
                            },
                            {
                                "example_id": "54abf196-558f-4801-91a2-6cdcf61f14f6",
                                "sense_id": "0ea9e4a4-0218-3748-98b9-762336971fef",
                                "text": "Entre village et château se tissent des fils de rancune, de haine […], parfois aussi d’intérêt, de bénévolence, voire d’une sympathie qui passe les bornes des castes."
                            }
                        ]
                    }
                ],
