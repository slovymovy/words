                                "target_senses": [
                                    {
                                        "sense_id": "99bd733c-944a-3b4b-831a-69787b9987ee",
                                        "entry_id": "08dad48c-b70c-35fd-9e4d-f32d46c9675b",
                                        "glosses": [
                                            "Computer, der aktuell an der Spitze der leistungsfähigsten Computer steht, besonders im Bereich der Verarbeitungskapazität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032970b8-ff8d-421c-ba48-dd6d98341546",
                                                "sense_id": "99bd733c-944a-3b4b-831a-69787b9987ee",
                                                "text": "Die ersten Supercomputer berechneten ballistische Tabellen."
                                            },
                                            {
                                                "example_id": "aab8f857-507e-4db9-875c-5db6a42d4a70",
                                                "sense_id": "99bd733c-944a-3b4b-831a-69787b9987ee",
                                                "text": "Moderne Supercomputer arbeiten mit tausenden von Prozessoren."
                                            },
                                            {
                                                "example_id": "da52a044-654a-4dbe-b1a2-bc805f413ea0",
                                                "sense_id": "99bd733c-944a-3b4b-831a-69787b9987ee",
                                                "text": "Genaue Klimasimulationen sind selbst für die schnellsten Supercomputer zu komplex."
                                            },
                                            {
                                                "example_id": "8cc30345-b72b-4871-9b7e-40c3c73226c3",
                                                "sense_id": "99bd733c-944a-3b4b-831a-69787b9987ee",
                                                "text": "Forscher aller Fachrichtungen nutzen Supercomputer, um zu klären, wie das Klima sich wandelt, wie sich Proteine in Zellen falten, wie neue Halbleiter funktionieren oder wie Brennstoffzellen zu verbessern sind."
                                            },
                                            {
                                                "example_id": "e02834b5-df7e-4e34-a798-1b88edd2172b",
                                                "sense_id": "99bd733c-944a-3b4b-831a-69787b9987ee",
                                                "text": "„Auch andere Fachleute warfen zur gleichen Zeit ihre Supercomputer an, führten komplizierte Rechnungen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
