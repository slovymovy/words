                    },
                    {
                        "form_id": "2cd14b55-6969-4f43-a2e4-790d36a5050e",
                        "entry_id": "9b343520-03ac-37d3-a1c8-90264e83c8b9",
                        "tags": [
                            "vocative",
                            "plural",
                            "nonvirile"
                        ],
                        "form": "najzawołańsze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80c1df2c-e5e8-391d-b281-77ab3f3cd066",
                        "entry_id": "9b343520-03ac-37d3-a1c8-90264e83c8b9",
                        "glosses": [
                            "zajmujący się czym z talentem i zapałem"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "35bafede-cfea-492c-8419-2629ebc0441b",
                                "sense_id": "80c1df2c-e5e8-391d-b281-77ab3f3cd066",
                                "text": "Drugi, Leon, ogromnie zdolny, zawołany, i fachowy gospodarz, dobroczyńca i przyjaciel ludu, był już od młodych lat towarzyszem wielu robót i poczynań ojcowskich, zwłaszcza w sprawach ruskich"
                            },
                            {
                                "example_id": "a7125a73-e39d-4403-864b-962893647244",
                                "sense_id": "80c1df2c-e5e8-391d-b281-77ab3f3cd066",
                                "text": "Znać było jednak, że to żołnierze zawołani: miny rzęsiste i harde, prawe ręce wparte w boki, głowy podniesione"
                            },
                            {
                                "example_id": "d11d01d7-5061-4249-9345-cf4cce4b7ed0",
                                "sense_id": "80c1df2c-e5e8-391d-b281-77ab3f3cd066",
                                "text": "On jest jeden z najzawołańszych ptaszników. Niechże mu Pan pokaże swój zbiór ptaków; poradzi nawet, jeżeli któremu co brakuje — przekłuć umie, gdy tam co trzeba"
                            },
                            {
                                "example_id": "9cfcf84d-08c9-45db-87a0-8bd7b75003ba",
                                "sense_id": "80c1df2c-e5e8-391d-b281-77ab3f3cd066",
                                "text": "Zawołanym tancerzem był mąż praczki, późniejszej naszej ukochanej gosposi, Wróblewski, starszy już człowiek z sumiastym białym wąsem. Tańczył, jak to się mówi, do upadłego, a tak zgrabnie; teraz na wsi nikt tak nie potrafi"
                            },
                            {
                                "example_id": "e9722c6c-49fe-4b5f-a2a1-5e882d7fdcfa",
                                "sense_id": "80c1df2c-e5e8-391d-b281-77ab3f3cd066",
                                "text": "Niektórzy z zawołanych hazardzistów karcianych przeszli nawet do historii. W końcu XVIII wieku głośno było o kanoniku przemyskim [Michale] Romanie Sierakowskim [herbu Dołęga]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3f6172b0-fca4-30cb-988f-5cf0250453a9",
                        "entry_id": "9b343520-03ac-37d3-a1c8-90264e83c8b9",
                        "glosses": [
                            "głośny, sławny, znany"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "31b2fd12-9e19-482a-a3f9-bf889645c081",
                                "sense_id": "3f6172b0-fca4-30cb-988f-5cf0250453a9",
                                "text": "W tej zawołanej ziemiańskiej stolicy / Wielebne głupstwo od wieków siedziało: / Pod starożytnym schronieniem świątnicy / Prawych czcicielów swoich utuczało"
                            },
                            {
                                "example_id": "14adc473-5aba-405b-b61b-289be43ac109",
                                "sense_id": "3f6172b0-fca4-30cb-988f-5cf0250453a9",
                                "text": "Sokrates, zawołany Mędrzec na Ateny / Nigdy słowom nie dawał bez dowodów ceny"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
