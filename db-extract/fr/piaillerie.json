                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c4e7cd19-fdae-4456-ba11-a2e0b27c0446",
                        "entry_id": "ef33e08b-052a-39bc-8646-882ed867f34f",
                        "tags": [
                            "plural"
                        ],
                        "form": "piailleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f87760c2-61db-32c2-aaea-19295eb801be",
                        "entry_id": "ef33e08b-052a-39bc-8646-882ed867f34f",
                        "glosses": [
                            "Action de piailler."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "56499f54-f3e1-4e25-8a91-b918d8872a3d",
                                "sense_id": "f87760c2-61db-32c2-aaea-19295eb801be",
                                "text": "Dans cette maison, c’est une piaillerie perpétuelle."
                            },
                            {
                                "example_id": "1efab9e7-a2a6-4a72-b2d4-ad614a84b232",
                                "sense_id": "f87760c2-61db-32c2-aaea-19295eb801be",
                                "text": "Aux coups violents frappés à la porte, se mêlaient des trépignements sourds, des jurons d'hommes et des piailleries de femmes."
                            },
                            {
                                "example_id": "6957e88c-4b5f-44bc-ad9a-7e8402d1e8ce",
                                "sense_id": "f87760c2-61db-32c2-aaea-19295eb801be",
                                "text": "À cet endroit, l’air plus léger portait le grésillement d’une sorte de piaillerie qu’on aurait pu prendre pour celle de certains oiseaux."
                            },
                            {
                                "example_id": "523f200f-44d8-4ab7-8957-b98e5ee0ce58",
                                "sense_id": "f87760c2-61db-32c2-aaea-19295eb801be",
                                "text": "Il grimpait les marches, quand une forte secousse ébranla la bâtisse. Les hommes se tassèrent davantage, le cou rentré, les yeux fixes et retinrent leurs piailleries."
                            },
                            {
                                "example_id": "3ff26ca8-f451-447f-843d-2d96d2f58569",
                                "sense_id": "f87760c2-61db-32c2-aaea-19295eb801be",
                                "text": "Oui, c’est à cela que Frédéric devait se consacrer : faire revivre ces minutes privilégiées où son oncle et lui conversaient sous les marronniers du square, indifférents aux piailleries des brèche-dents, et pleins de la fierté secrète de partager ce que nul ne pourrait leur ôter."
                            }
                        ]
                    }
                ],
