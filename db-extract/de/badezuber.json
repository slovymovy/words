                        "examples": [
                            {
                                "example_id": "3bb3ee3a-dfe2-4572-9275-4fe8215bd6da",
                                "sense_id": "ecdea6c8-12dd-303c-abb1-7d65140bcd76",
                                "text": "„Goldlotos hielt, um ihr Haar nicht ins Wasser gleiten zu lassen, mit einer Hand ihren Haarknoten und klammerte sich mit der andern am Rande des Badezubers fest.“"
                            },
                            {
                                "example_id": "566c0b57-9260-4408-b0d5-f40e374a3c0b",
                                "sense_id": "ecdea6c8-12dd-303c-abb1-7d65140bcd76",
                                "text": "„Dort wies sie auf den bereitstehenden Badezuber und auf den Kessel mit dem dampfenden Wasser über dem Herdfeuer.“"
                            }
                        ],
