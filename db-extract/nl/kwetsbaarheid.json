            {
                "entry_id": "e214e979-78f2-3b6e-987a-560a889cf84e",
                "word": "kwetsbaarheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "09a8fa42-4696-406f-97df-9b53c88a9fcc",
                        "entry_id": "e214e979-78f2-3b6e-987a-560a889cf84e",
                        "tags": [
                            "plural"
                        ],
                        "form": "kwetsbaarheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd8ce995-0e83-3904-b6f1-1fb3d2ced9ef",
                        "entry_id": "e214e979-78f2-3b6e-987a-560a889cf84e",
                        "glosses": [
                            "de zwakke, kwetsbare plek van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ef1e3e-8044-432b-90e6-c3d70252058e",
                                "sense_id": "bd8ce995-0e83-3904-b6f1-1fb3d2ced9ef",
                                "text": "Zijn kinderen zijn zijn enige kwetsbaarheid."
                            },
                            {
                                "example_id": "c8f6add3-ebbd-40fb-a6fc-96e9c70e5519",
                                "sense_id": "bd8ce995-0e83-3904-b6f1-1fb3d2ced9ef",
                                "text": "In 2011 muntte academicus Robin DiAngelo de term ‘witte kwetsbaarheid’ om de defensieve reacties van witte mensen te beschrijven als racisme ter sprake wordt gebracht. Witte mensen zijn grootgebracht met het idee geen onderscheid te maken en kleurenblind te zijn, schreef zij in het boek White Fragility. Geen slecht beginsel, maar onmogelijk als je zwart bent en geconfronteerd wordt met je huidskleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "741a806d-4030-301a-85fc-f95f4d7a7eb8",
                        "entry_id": "e214e979-78f2-3b6e-987a-560a889cf84e",
                        "glosses": [
                            "het breekbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0070d023-7d90-4689-a839-1169e0b2afe0",
                                "sense_id": "741a806d-4030-301a-85fc-f95f4d7a7eb8",
                                "text": "Haar komische timing is waanzinnig, de kwetsbaarheid die ze eronder legt is zo mogelijk nog indrukwekkender. Haar koningin Anne is als de film zelf: verschrikkelijk grappig en oneindig tragisch. Wereldvreemd, en daarmee juist zo menselijk."
                            },
                            {
                                "example_id": "a9fdad7b-43ed-4774-be9a-4ca34ae85481",
                                "sense_id": "741a806d-4030-301a-85fc-f95f4d7a7eb8",
                                "text": "Kardashian droeg de originele jurk overigens alleen op de rode loper; eenmaal binnen trok de realityster een replica van de jurk aan. Toch kwam er vandaag kritiek vanuit de museumwereld: conservatoren wezen op de kwetsbaarheid van historische kledingstukken en vrezen dat Kardashian met haar keuze anderen aanspoort om ontwerpen te dragen die achter glas thuishoren."
                            }
                        ]
                    },
                    {
                        "sense_id": "105f7fb1-b3f6-3cd0-bb25-c336c7f16446",
                        "entry_id": "e214e979-78f2-3b6e-987a-560a889cf84e",
                        "glosses": [
                            "een fout in een toegangsbeveiliging waardoor onbevoegden (hackers) meer dan gewenste handelingsvrijheid kunnen krijgen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fac0e12-e6a6-4a55-818d-a4563d8f66d6",
                        "source_entry_id": "e214e979-78f2-3b6e-987a-560a889cf84e",
                        "target_lang_word": "vulnerability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulnerability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                        "entry_id": "9af64d50-4bcd-31ab-8535-43502d909f73",
                                        "glosses": [
                                            "The state of being vulnerable; susceptibility to attack or injury, either physical or emotional; the state or condition of being weak or poorly defended."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "033a5f42-4db2-4b1b-bf8b-77d3021be624",
                                                "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                                "text": "The country recognized their defence vulnerability after an airplane landed in front of the central square without any consequences."
                                            },
                                            {
                                                "example_id": "57c4897e-ef3b-4500-96a6-1a1f33def1e2",
                                                "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                                "text": "Though scientists do not know how stress affects gestation, Fukuda theorizes that the vulnerability of Y-bearing sperm cells, male embryos and/or male fetuses to stress is why “subtle significant changes in sex ratios” occur."
                                            },
                                            {
                                                "example_id": "3312c718-2bde-4e94-a6dc-e1cce93d5b2b",
                                                "sense_id": "704fab70-5135-3bcd-8e3b-b17f89a50a57",
                                                "text": "Again, voice change is not easy and vulnerability plays a big part, but if choral teachers and adolescent singers approach it with the right mindframe, the experience can be empowering, enlightening, and restorative for all involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e28c4723-1864-3b5b-9e94-b0082d6763c3",
                                        "entry_id": "9af64d50-4bcd-31ab-8535-43502d909f73",
                                        "glosses": [
                                            "A specific weakness in the protections or defences surrounding someone or something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dca002a7-eddc-3b56-9bb8-87d7eae5378c",
                                        "entry_id": "9af64d50-4bcd-31ab-8535-43502d909f73",
                                        "glosses": [
                                            "A weakness which allows an attacker to reduce a system's security."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e82f56-7929-4e88-9a21-b66f51de154b",
                                                "sense_id": "dca002a7-eddc-3b56-9bb8-87d7eae5378c",
                                                "text": "Experts told CNN it could take weeks to address the vulnerabilities and that suspected Chinese hackers are already attempting to exploit it."
                                            }
