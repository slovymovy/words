                        "entry_id": "3c2f805d-e66f-3e8a-8e5f-4bead083c133",
                        "glosses": [
                            "Like or resembling a raptor; seizing or plundering, like a bird of prey."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48929cc-e7ca-4f40-8647-839984df147f",
                                "sense_id": "7b2ea590-e037-3288-ad8e-31224573a86a",
                                "text": "When its legs are extended, it measures one and a half inches wide, and the raptorial claws hint that it is a fierce predator."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e8f825f-aed2-4903-9e21-7839449e15fc",
                        "source_entry_id": "3c2f805d-e66f-3e8a-8e5f-4bead083c133",
                        "source_sense_id": "7b2ea590-e037-3288-ad8e-31224573a86a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "rapace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapace",
