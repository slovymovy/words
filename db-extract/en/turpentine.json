                        "entry_id": "0d99bd76-abb0-3b83-92fe-99a9cecc7da2",
                        "glosses": [
                            "A turpentine tree (genus Syncarpia)."
                        ],
                        "tags": [
                            "Australia",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f6c52ae-8ff9-4aa6-999b-ba836c32cdbe",
                                "sense_id": "a94ea839-7e14-3011-905b-bb34c8838910",
                                "text": "Turpentine timber was obtained from the forests outside Maryborough and Townsville, and shipped by rail and landing craft to Hayman Island."
                            }
                        ]
