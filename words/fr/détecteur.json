    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1bcb7e8-0523-3534-a889-c3d464e0e7cd",
                    "sense_definition": "Dispositif destiné à déceler ou mesurer la présence d'un phénomène physique, d'une substance ou d'un objet difficilement perceptible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appareil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La loi oblige chaque propriétaire à installer un <w>détecteur</w> de fumée dans son logement."
                        },
                        {
                            "text": "Les agents de sécurité utilisent un <w>détecteur</w> de métaux à l'entrée du musée."
                        }
                    ],
                    "synonyms": [
                        "capteur",
                        "sonde"
                    ],
                    "common_phrases": [
                        "détecteur de fumée",
                        "détecteur de métaux",
                        "détecteur de mensonges",
                        "détecteur de mouvement"
                    ]
                },
                {
                    "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                    "sense_definition": "Dispositif électronique qui transforme un signal électromagnétique en vue d'extraire l'information qu'il transporte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electronique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ingénieur a remplacé le <w>détecteur</w> défectueux pour améliorer la réception du signal radio."
                        },
                        {
                            "text": "Ce récepteur utilise un <w>détecteur</w> synchrone pour isoler l'onde porteuse."
                        }
                    ],
                    "synonyms": [
                        "démodulateur"
                    ],
                    "common_phrases": [
                        "détecteur synchrone"
                    ]
                },
                {
                    "sense_id": "c1d43543-b242-3887-82a5-d588ba1ad585",
                    "sense_definition": "Personnel militaire ou marin qualifié pour l'utilisation et la surveillance d'un radar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À bord de la frégate, le <w>détecteur</w> scrute attentivement les échos sur son écran."
                        },
                        {
                            "text": "Le jeune marin a obtenu son brevet de <w>détecteur</w> après plusieurs mois d'entraînement."
                        }
                    ],
                    "synonyms": [
                        "opérateur radar"
                    ],
                    "common_phrases": [
                        "détecteur radar"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "223c593d-38b9-3002-9556-6198144fa2eb",
                    "sense_definition": "Qui a la fonction de déceler ou de capter un élément ou un phénomène.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'appareil photo intègre une cellule <w>détectrice</w> pour adapter la luminosité automatiquement."
                        },
                        {
                            "text": "Les chercheurs ont mis au point une sonde <w>détectrice</w> très sensible aux variations thermiques."
                        }
                    ],
                    "common_phrases": [
                        "cellule détectrice"
                    ]
                }
            ]
        }
    ]
