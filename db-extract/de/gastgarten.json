                            {
                                "example_id": "cd9f3f51-7581-479d-91d2-d9031f2d761d",
                                "sense_id": "177e85fa-3da1-353d-a8ec-f85e773d02a7",
                                "text": "„Also, Haus und Hof sind herzlich gut in Schuss, der Gastgarten mit Kastanien bestellt und die gute Stube unten prall gefüllt, deswegen findet sich nur noch ein Platz im Oberstübchen.“"
                            },
                            {
                                "example_id": "cc58ad4a-a5e3-4d2a-b9be-d45897808685",
                                "sense_id": "177e85fa-3da1-353d-a8ec-f85e773d02a7",
                                "text": "„Ried hatte […] den Garten in einen Gastgarten mit Arkaden und Lindenallee verwandelt und um Pavillons bereichert.“"
                            }
                        ],
