                "senses": [
                    {
                        "sense_id": "403c1600-c9c8-31b4-bad6-37d25c80f2c1",
                        "entry_id": "1f59515c-6d0c-363c-8016-5fc9b43da511",
                        "glosses": [
                            "het opnemen van een vreemd kind als het eigene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fac32c8-3462-4256-946b-7100eb6a2fdf",
                                "sense_id": "403c1600-c9c8-31b4-bad6-37d25c80f2c1",
                                "text": "Het duurde lang voordat de adoptie juridisch geregeld was."
                            },
                            {
                                "example_id": "49dae9bd-dfb9-4ac1-a654-dde2027e8702",
                                "sense_id": "403c1600-c9c8-31b4-bad6-37d25c80f2c1",
                                "text": "\"De gedwongen adoptie van weeskinderen uit Oekraïne is een oorlogsmisdaad\", zegt Michael Kemper. Hij is als Ruslandexpert verbonden aan de Universiteit van Amsterdam. \"Dat deze actie al vóór de Russische invasie van Oekraïne voorbereid werd, laat zien dat dit niet een bijzaak is maar centraal staat in Ruslands oorlog.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "963992cf-3700-30dd-9233-66c5018fa1eb",
                        "entry_id": "1f59515c-6d0c-363c-8016-5fc9b43da511",
                        "glosses": [
                            "het aannemen van een bepaald besluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c895dc-b724-4a5d-9ec6-f9e4d359bacb",
                                "sense_id": "963992cf-3700-30dd-9233-66c5018fa1eb",
                                "text": "De adoptie van die maatregel had veel voeten in de aarde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b119826-4a9a-4eca-8050-7441e59fa83e",
                        "source_entry_id": "1f59515c-6d0c-363c-8016-5fc9b43da511",
                        "target_lang_word": "Adoption",
