                "senses": [
                    {
                        "sense_id": "bc51c606-e151-3008-9c07-05a5e529c5a7",
                        "entry_id": "412df6ee-62ab-38a6-b55e-41f499abd819",
                        "glosses": [
                            "анат. связанный, соотносящийся по значению с существительным жёлчь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9254dc-6cbe-4e2f-a436-1708b769bf6f",
                                "sense_id": "bc51c606-e151-3008-9c07-05a5e529c5a7",
                                "text": "Жёлчный пузырь располагается в передней части правой продольной борозды печени."
                            }
                        ]
                    },
                    {
                        "sense_id": "e214f74d-ab9a-3783-9684-d8586c23fb14",
                        "entry_id": "412df6ee-62ab-38a6-b55e-41f499abd819",
                        "glosses": [
                            "хим. входящий в состав жёлчи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9905334-6f34-4a48-93c1-2264de50a0d2",
                                "sense_id": "e214f74d-ab9a-3783-9684-d8586c23fb14",
                                "text": "Это, во-первых, парные жёлчные кислоты: гликохолевая и таурохолевая; затем жёлчные пигменты: билирубин и биливердин."
                            }
                        ]
                    },
                    {
                        "sense_id": "649a6064-7d01-3e67-a998-1157c5cf255d",
                        "entry_id": "412df6ee-62ab-38a6-b55e-41f499abd819",
                        "glosses": [
                            "перен., книжн. раздражительный, злобный, язвительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8345149b-fd15-4824-978e-edc23feb98f6",
                                "sense_id": "649a6064-7d01-3e67-a998-1157c5cf255d",
                                "text": "А так он был резкий, вспыльчивый, жёлчный"
                            }
                        ]
                    }
                ],
