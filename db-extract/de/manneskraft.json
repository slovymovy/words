                ],
                "senses": [
                    {
                        "sense_id": "73281700-a7f9-3246-8662-34dc2cfdb4d0",
                        "entry_id": "fd652588-dbe5-3923-b605-684720c37784",
                        "glosses": [
                            "physische Kraft eines Mannes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1fe563-edd6-4e8c-b7dd-2caf2e1e8d65",
                                "sense_id": "73281700-a7f9-3246-8662-34dc2cfdb4d0",
                                "text": "„Und was tut ein Mann, wenn er seine überschüssige Manneskraft nicht loswird?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6561628-15c4-33ab-b3ea-f5910cbe8627",
                        "entry_id": "fd652588-dbe5-3923-b605-684720c37784",
                        "glosses": [
                            "sexuelle Potenz eines Mannes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e124ee0-b7dd-46c8-bc89-f5eb6f81fee8",
                                "sense_id": "e6561628-15c4-33ab-b3ea-f5910cbe8627",
                                "text": "Ein Arzt kann verschiedene Mittel zur Stärkung der Manneskraft einsetzen."
                            },
                            {
                                "example_id": "1cc38e7a-bcf5-47d5-b168-ecb262a8cada",
                                "sense_id": "e6561628-15c4-33ab-b3ea-f5910cbe8627",
                                "text": "„Er hatte zugenommen, aber seine Muskeln waren noch straff, seine Lebenssäfte flossen noch, seine Manneskraft lauerte auf ihre Wiederkehr.“"
                            },
                            {
                                "example_id": "3dfbda12-8682-4584-819d-f210e580f82b",
                                "sense_id": "e6561628-15c4-33ab-b3ea-f5910cbe8627",
                                "text": "„Er braucht gern Stärkungsmittel, um seine Manneskraft zu erhalten, und ist gewöhnt, Reizmittel anzuwenden.“"
                            },
                            {
                                "example_id": "2e81e35e-b67b-4b01-9b56-e78d305f0b89",
                                "sense_id": "e6561628-15c4-33ab-b3ea-f5910cbe8627",
                                "text": "„Beim ersten Morgengrauen mußte ich sie verlassen, um nach Govino zu fahren; sie weinte vor Freude, als sie sah, daß ich sie mit den Zeichen der Manneskraft verließ.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
