            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01875f62-2963-3689-a4a4-95fbd0db644b",
                    "sense_definition": "Een groot stuk bestek dat wordt gebruikt om vloeibaar voedsel zoals soep te eten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bestek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leg de <w>eetlepel</w> aan de rechterkant van het bord naast het mes.",
                            "target_lang_translations": {
                                "en": "Place the <w>tablespoon</w> on the right side of the plate next to the knife."
                            }
                        },
                        {
                            "text": "Met een grote <w>eetlepel</w> kun je de warme soep makkelijker opeten.",
                            "target_lang_translations": {
                                "en": "With a large <w>tablespoon</w>, you can eat the hot soup more easily."
                            }
                        }
                    ],
                    "synonyms": [
                        "soeplepel"
                    ],
                    "common_phrases": [
                        "grote eetlepel",
                        "zilveren eetlepel"
                    ],
                    "target_lang_definitions": {
                        "en": "A large piece of cutlery used for eating liquid food such as soup."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tablespoon",
                                "target_lang_sense_clarification": "a large spoon used for eating"
                            },
                            {
                                "target_lang_word": "soup spoon",
                                "target_lang_sense_clarification": "specifically for eating soup"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "204325e7-530a-35ac-ba85-c32dd0618af6",
                    "sense_definition": "Een inhoudsmaat die in de keuken wordt gebruikt, gelijk aan ongeveer 15 milliliter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voeg voor dit recept precies één <w>eetlepel</w> suiker toe aan het beslag.",
                            "target_lang_translations": {
                                "en": "For this recipe, add exactly one <w>tablespoon</w> of sugar to the batter."
                            }
                        },
                        {
                            "text": "Je moet elke ochtend een <w>eetlepel</w> olijfolie nemen voor je gezondheid.",
                            "target_lang_translations": {
                                "en": "You should take a <w>tablespoon</w> of olive oil every morning for your health."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eetlepel suiker",
                        "afgestreken eetlepel"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of volume used in cooking, equal to approximately 15 milliliters."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tablespoon",
                                "target_lang_sense_clarification": "a unit of measurement in recipes"
                            },
                            {
                                "target_lang_word": "tbsp",
                                "target_lang_sense_clarification": "abbreviation used in cooking"
                            }
                        ]
                    }
                }
            ]
        }
    ]
