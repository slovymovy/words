                        "glosses": [
                            "het recht van een persoon met een andere nationaliteit om in een bepaald land te verblijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf06d56-1a6f-4aa2-80b6-53f575237356",
                                "sense_id": "10113d61-70a0-3047-aa9f-cb01f6977b36",
                                "text": "Zo wil premier Mark Rutte de urgentieregeling voor woonruimte voor vluchtelingen met een verblijfstatus zo snel mogelijk uit de wet schrappen. De PvdA stemt ermee in, maar wil wel dat er voldoende noodwoningen worden bijgebouwd. De partij vreest dat vluchtelingen met een status anders langer in een asielzoekerscentra blijven dan nodig."
                            },
                            {
                                "example_id": "d21cae55-8d6b-44ff-918a-7b968f24338d",
                                "sense_id": "10113d61-70a0-3047-aa9f-cb01f6977b36",
                                "text": "Toch zijn er ook partijen die verdienen aan het opvangen van vluchtelingen. Het Centraal Orgaan opvang asielzoekers is hard op zoek naar opvangplekken voor vluchtelingen en asielzoekers met een verblijfstatus."
                            }
                        ]
                    }
