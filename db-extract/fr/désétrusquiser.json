                "senses": [
                    {
                        "sense_id": "424848d9-71a5-3d0e-8744-c0d333426fc2",
                        "entry_id": "f16d2000-47cf-3832-8d35-19d26e94768b",
                        "glosses": [
                            "Faire perdre son caractère étrusque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e5cb3d-0124-4668-9419-8ac769f71ef8",
                                "sense_id": "424848d9-71a5-3d0e-8744-c0d333426fc2",
                                "text": "On assiste depuis quelque temps (par exemple F. Zevi, Demarato, 1994, p. 291 - 314 ; T.J. Cornell, Beginnings, 1995, p. 151-172) à une tentative de « désétrusquiser » la seconde partie de la royauté romaine ; il s’agit de réduire le rôle des Étrusques pour valoriser celui des Grecs."
                            },
                            {
                                "example_id": "98bac561-5544-49a1-acca-dff47ab0dff6",
                                "sense_id": "424848d9-71a5-3d0e-8744-c0d333426fc2",
                                "text": "Il faut chercher dans ce transfert une autre raison que le désir de « désétrusquiser » l’histoire primitive des origines de Rome."
                            },
                            {
                                "example_id": "9ab356d4-321f-4c33-ac2c-a7e94d4a6315",
                                "sense_id": "424848d9-71a5-3d0e-8744-c0d333426fc2",
                                "text": "Il n’est dit nulle part dans l’annalistique que les Romains ont chassé les Étrusques et « désétrusquisé » Rome vers 500."
                            }
                        ]
                    }
                ],
