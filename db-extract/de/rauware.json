                        "glosses": [
                            "Textil, das durch die Behandlung mit Karden seine Glattheit verloren hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b594aba6-39a1-4ba9-b1f9-235dde8372b6",
                                "sense_id": "417f6840-3838-3817-bcbd-79274e82b3c3",
                                "text": "„Natürlich müssen verbrauchte Naturkarden rechtzeitig gewechselt werden, da sonst ungleichmäßige Rauhung sowie Beschädigung der Rauhware oder Gummiwalzen zu befürchten sind.“"
                            }
