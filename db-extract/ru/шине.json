                        "translation_id": "a5d6984e-0781-46a9-bc3f-71955e6c50fd",
                        "source_entry_id": "57e260ce-8fa3-308a-9868-1d4b785f55c3",
                        "target_lang_word": "chiné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9241e3ab-2158-36f6-9966-d66fb7605f09",
                                        "entry_id": "7e122570-ec0d-3cc1-b305-e48596376287",
                                        "glosses": [
                                            "Dessin irrégulier formé par la juxtaposition aléatoire de deux couleurs différentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0251891c-d288-49e2-a072-ede6a6991f93",
                                                "sense_id": "9241e3ab-2158-36f6-9966-d66fb7605f09",
                                                "text": "Caractérisé par ses couleurs pastel clair et sa texture duveteuse, le chiné est surtout appliqué sur du taffetas de soie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f0e377-225e-3cfc-9618-a55569d23b6f",
                                        "entry_id": "024cb0d9-7048-3c15-8136-30b6e9495fc1",
                                        "glosses": [
                                            "En parlant des tissus, dont le motif a été créé par chinage, en alternant les couleurs des fils de chaîne avant le tissage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62d9379-fd9e-4eb0-93f0-2e782f8c6dae",
                                                "sense_id": "a3f0e377-225e-3cfc-9618-a55569d23b6f",
                                                "text": "Étoffe chinée."
                                            },
                                            {
                                                "example_id": "79889e5f-b99f-42b7-9f94-4d3764007ab9",
                                                "sense_id": "a3f0e377-225e-3cfc-9618-a55569d23b6f",
                                                "text": "Monsieur Guillaume portait de larges culottes de velours noir, des bas chinés et des souliers carrés à boucles d’argent."
                                            },
                                            {
                                                "example_id": "a2a788d7-ddf6-49c4-a1ae-1933363d4c0f",
                                                "sense_id": "a3f0e377-225e-3cfc-9618-a55569d23b6f",
                                                "text": "Un mulâtre en chandail chiné de rouge et vert, en casquette de toile blanche, était entré derrière elle et refermait la porte."
                                            },
                                            {
                                                "example_id": "45f29ef0-539b-42fd-b35e-4a5f8b861da9",
                                                "sense_id": "a3f0e377-225e-3cfc-9618-a55569d23b6f",
                                                "text": "En dépit de ses cheveux rejetés en arrière, de son costume chiné, de sa chemise de soie grise, son visage gardait quelque chose de 1900, de sa jeunesse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
