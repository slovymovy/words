                        ]
                    },
                    {
                        "translation_id": "7c7c22e6-32f8-48d6-be8f-b9aead0e2d1b",
                        "source_entry_id": "1c8bd1c8-c9f5-39d3-ba4b-2df9f16b5324",
                        "source_sense_id": "9d930ac6-b643-3f97-9fee-71251f8fbc0e",
                        "target_lang_word": "ardennais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ardennais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "266d5a67-9c5e-3dab-bf04-d8eb31daadef",
                                        "entry_id": "14c6bb49-0a2f-3427-899e-e825f99a8ccc",
                                        "glosses": [
                                            "Relatif à l’Ardenne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a031cfac-21db-4770-bdbc-b2325a64c329",
                                                "sense_id": "266d5a67-9c5e-3dab-bf04-d8eb31daadef",
                                                "text": "En Belgique, les chèvres étaient assez nombreuses et jouissaient d'une certaine faveur auprès des campagnards, surtout dans les pays ardennais."
                                            },
                                            {
                                                "example_id": "648553b7-52fd-4d20-9577-589798e69330",
                                                "sense_id": "266d5a67-9c5e-3dab-bf04-d8eb31daadef",
                                                "text": "Le massif ardennais ne représente en France que 20 % d'un massif beaucoup plus vaste qui s'étend pour sa part la plus importante en Belgique et au Luxembourg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "198007dd-3f34-317f-b020-d81df189490b",
                                        "entry_id": "14c6bb49-0a2f-3427-899e-e825f99a8ccc",
                                        "glosses": [
                                            "Relatif au département français des Ardennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810b41f8-33d2-44bf-b7a2-b44e16509bb6",
                                                "sense_id": "198007dd-3f34-317f-b020-d81df189490b",
                                                "text": "Cela est d'autant plus problématique lorsqu'on a affaire à des relations de client à fournisseur ou sous-traitant, comme c'est le cas pour la majorité de l'industrie ardennaise."
                                            },
                                            {
                                                "example_id": "a234f7d2-c23b-4df7-856f-78f3c13915c6",
                                                "sense_id": "198007dd-3f34-317f-b020-d81df189490b",
                                                "text": "Seul témoin de cette époque révolue où la forge de Vendresse sortait 3 tonnes de fonte par jour, rugissant jour et nuit, où la sidérurgie ardennaise battait son plein, son haut-fourneau est d'ailleurs un lieu incontournable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ardennais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "043f2748-8dd6-3b54-996e-a79f13ae2a1d",
                                        "entry_id": "0b7a114b-af5c-368c-9284-652b3b033233",
                                        "glosses": [
                                            "Race rustique de cheval de trait, très ancienne, dont la taille au garrot est de 1,50 à 1,65 m, à la robe généralement baie ou rouanne, principalement élevé dans la région des Ardennes, dans tout le quart nord-est de la France, et aussi en Belgique et au Luxembourg : attelage, débardage, entretien des espaces verts et production de viande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fba21bd-91b3-45c7-b586-71cac9f7d2fb",
                                                "sense_id": "043f2748-8dd6-3b54-996e-a79f13ae2a1d",
                                                "text": "Même si l’auxois revendique son identité bourguignonne, le sang du Nord coule aussi dans ses veines, et c’est un proche cousin de l’ardennais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e53f0856-b46e-466b-8fde-18de52d9a546",
                        "source_entry_id": "1c8bd1c8-c9f5-39d3-ba4b-2df9f16b5324",
                        "source_sense_id": "9d930ac6-b643-3f97-9fee-71251f8fbc0e",
