                "senses": [
                    {
                        "sense_id": "704f421c-0a47-3178-b17f-606b4476cc50",
                        "entry_id": "70a14922-3555-33e1-83ad-53a438a87c3d",
                        "glosses": [
                            "Gelbfärbung; charakteristische gelbliche Verfärbung der Gehirn-Rückenmarks-Flüssigkeit (Liquor cerebrospinalis) durch Blutfarbstoffe"
                        ],
                        "tags": [
                            "Neurologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fa74d87b-f8a5-48b6-a325-e3e59931351e",
                                "sense_id": "704f421c-0a47-3178-b17f-606b4476cc50",
                                "text": "Sollte der Liquorbefund eine Xanthochromie bestätigen, hat sich der Verdacht auf Icterus catarrhalis erhärtet."
                            },
                            {
                                "example_id": "ab6e92ce-3811-4053-94c7-c4bd58ef1067",
                                "sense_id": "704f421c-0a47-3178-b17f-606b4476cc50",
                                "text": "Xanthochromie liegt vor, wenn die Liquorflüssigkeit nicht klar und farblos, sonder gelblich verfärbt ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95899173-a3f8-3e78-8b14-b6b1e95c8a0c",
                        "entry_id": "70a14922-3555-33e1-83ad-53a438a87c3d",
                        "glosses": [
                            "Gelbfärbung; gelbliche Verfärbung der Haut"
                        ],
                        "tags": [
                            "Dermatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5e1ef114-ab4f-424f-99c2-6bb5cedc9bea",
                                "sense_id": "95899173-a3f8-3e78-8b14-b6b1e95c8a0c",
                                "text": "Über das Normalmaß hinausgehende Aufnahme von Carotinoiden und anderen Lipochromen, über einen längeren Zeitraum hinweg, kann zu Xanthochromien an exponierten Hautflächen führen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
