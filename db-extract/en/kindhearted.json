                                    {
                                        "sense_id": "203700a1-3c5d-3ec4-bfbf-6637a1d8fdd4",
                                        "entry_id": "9a82e284-b6ea-3ff5-8433-d1c1e337d4fd",
                                        "glosses": [
                                            "Qualifie ceux que l’on aime le plus tendrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9803237-6ff4-4d89-aed0-e25db885773f",
                                                "sense_id": "203700a1-3c5d-3ec4-bfbf-6637a1d8fdd4",
                                                "text": "Passer de l’état d’ami de cœur à amant de cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51cbd2f-0067-3feb-90fb-c86119db4db7",
                                        "entry_id": "9a82e284-b6ea-3ff5-8433-d1c1e337d4fd",
                                        "glosses": [
                                            "Qualifie une personne avec qui on a des liens affectueux et quasi-parentaux sans avoir de lien biologique avec elle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "155a74f9-3c5d-4f18-8e3b-e5b5f05b3adf",
                                                "sense_id": "d51cbd2f-0067-3feb-90fb-c86119db4db7",
                                                "text": "Il n’a aucun doute. Michael Ketcham Hally­day, cousin et « frère de cœur » de Johnny Hally­day, a confié à RTL ce 12 mars son senti­ment sur la polé­mique de l’héri­tage, qui déchire Laeti­cia, David, et Laura Smet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6456395a-d0d3-38da-a6f9-ae36c07b58a8",
                                        "entry_id": "9a82e284-b6ea-3ff5-8433-d1c1e337d4fd",
                                        "glosses": [
                                            "Préféré."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2007bc-3cb5-4d44-861c-702ed6e4a3d8",
                                                "sense_id": "6456395a-d0d3-38da-a6f9-ae36c07b58a8",
                                                "text": "Pour ce créateur profondément parisien, être ultralocal, c’est d’abord composer avec sa ville de cœur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f3c711f-a6a1-4290-a173-ce5e6167eb86",
                        "source_entry_id": "a637a04b-cf07-3449-9ba6-9a2d9b4b6e36",
                        "source_sense_id": "9b6479c7-b30a-3e72-a0ac-9a7f85b52ec3",
                        "source_sense_description": "having an innately kind disposition or character",
                        "target_lang_word": "de bon cœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de bon cœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e063218-72e6-3515-99bb-82e9a1b456b3",
                                        "entry_id": "4cf09aec-3879-3b15-a3ab-56301c8f7f25",
                                        "glosses": [
                                            "Volontiers, avec plaisir."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db61a192-033a-4627-9d65-31ea852a0afd",
                                                "sense_id": "6e063218-72e6-3515-99bb-82e9a1b456b3",
                                                "text": "Nous ne louons d’ordinaire de bon cœur que ceux qui nous admirent."
                                            },
                                            {
                                                "example_id": "350e0c15-dc43-4e41-a6c1-ffc20c83406f",
                                                "sense_id": "6e063218-72e6-3515-99bb-82e9a1b456b3",
                                                "text": "Je les aimais de très bon cœur ; pour eux, je me serais fait couper en quatre, et m’imaginais vraiment que cela durerait ainsi toute la vie."
                                            },
                                            {
                                                "example_id": "b8673180-0bd9-4aa9-a946-311665408171",
                                                "sense_id": "6e063218-72e6-3515-99bb-82e9a1b456b3",
                                                "text": "Apparemment, le père avait raconté une blague et ils riaient tous de bon cœur."
                                            },
                                            {
                                                "example_id": "8f536c8b-d208-432f-8ffc-1e198ae2c904",
                                                "sense_id": "6e063218-72e6-3515-99bb-82e9a1b456b3",
                                                "text": "Le vendeur trouve la boutade drôle, il rigole de bon cœur."
                                            },
                                            {
                                                "example_id": "f7f463c8-2ec6-4cbe-abf4-e0ed053a0501",
                                                "sense_id": "6e063218-72e6-3515-99bb-82e9a1b456b3",
                                                "text": "Il se précipita à l’intérieur de l’habitacle, mais fut copieusement éclaboussé d’eau et de mousse. Lorsque la fille le vit, elle rit de bon cœur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1382330b-ebe8-4807-81d6-e84e68604c15",
                        "source_entry_id": "a637a04b-cf07-3449-9ba6-9a2d9b4b6e36",
