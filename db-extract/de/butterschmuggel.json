                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77fa7a20-b1e9-46ca-977f-bd39c07011ea",
                                "sense_id": "d84b2e2d-3268-3c93-b8e9-871adddf8751",
                                "text": "„Der Kaffee-, Zigaretten- und Butterschmuggel in den Grenzgebieten und die Auseinandersetzungen mit manchmal tödlichem Ausgang sind es nicht.“"
                            },
                            {
                                "example_id": "9fb0779a-9a6c-47f7-893b-0f22ad167823",
                                "sense_id": "d84b2e2d-3268-3c93-b8e9-871adddf8751",
                                "text": "„Zwischen 1952 und 1962 war vor allem der Butterschmuggel sehr beliebt.“"
                            },
                            {
                                "example_id": "5005e463-5a11-42a1-8068-18942c8fdab5",
                                "sense_id": "d84b2e2d-3268-3c93-b8e9-871adddf8751",
                                "text": "„Das war für lange Zeit mein letzter Aufenthalt am Grenzübergang und mein letzter Butterschmuggel.“"
                            },
                            {
                                "example_id": "132316fb-2697-4954-8d64-3c32111f5266",
                                "sense_id": "d84b2e2d-3268-3c93-b8e9-871adddf8751",
                                "text": "„Während die Regierung Zölle auf Butter um mehr als 80 Prozent senkte, um die Versorgung wieder herzustellen, blüht der Schwarzmarkt und der Butterschmuggel aus dem Nachbarland Schweden.“"
                            },
                            {
                                "example_id": "e4b7985d-fb18-457e-9bf1-fb7194e31068",
                                "sense_id": "d84b2e2d-3268-3c93-b8e9-871adddf8751",
                                "text": "„Ein Butterschmuggel in grossem Stil kommt einen Lebensmittelhändler aus Sri Lanka teuer zu stehen.“"
                            }
                        ],
