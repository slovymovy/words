                                                "sense_id": "6d8e303b-3e4e-3581-b9b9-0d4a5a9dc438",
                                                "text": "Die Motorhaube war voller Nadelstiche, also musste der Azubi die Lackierung wiederholen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5f01d68a-da98-3b08-be03-378b43299ec8",
                                        "entry_id": "1c06c0e3-2089-3280-b4e3-f9e0aec13b2b",
                                        "glosses": [
                                            "eine Boshaftigkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299f35af-0246-44ff-8776-c9e4aea399e6",
                                                "sense_id": "5f01d68a-da98-3b08-be03-378b43299ec8",
                                                "text": "Immer wenn du den Toilettensitz absichtlich oben lässt, ist das ein kleiner Nadelstich für mich!"
                                            },
                                            {
                                                "example_id": "5b2a2b8e-5969-4dcd-8038-20a7778d1484",
                                                "sense_id": "5f01d68a-da98-3b08-be03-378b43299ec8",
                                                "text": "„Die Nadelstiche gegen die Nazibesatzer gingen weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
