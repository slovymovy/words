        "fr-extract.jsonl": [
            {
                "entry_id": "19c5040b-749d-3d58-9380-4ea2cf2ba13f",
                "word": "exobiologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
                        "entry_id": "19c5040b-749d-3d58-9380-4ea2cf2ba13f",
                        "glosses": [
                            "Science qui a pour objet l’étude des possibilités d’apparition et d’existence de formes de vie dans l’Univers, y compris sur Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ddd732f-8018-4981-9365-481610e16c1a",
                                "sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
                                "text": "L’exobiologie se présente comme un ensemble de recherches multidisciplinaires sur les origines de la Vie, son évolution et sa distribution éventuelle dans l’Univers."
                            },
                            {
                                "example_id": "dcb3712c-7f23-4659-ac50-141905dbbb51",
                                "sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
                                "text": "Il se tourna vers Alvare, la jeune femme qui l’accompagnait, responsable scientifique de la mission, spécialiste en exobiologie et terraformation. Une belle femme brune d’ailleurs, qui, les derniers temps du voyage, n’était jamais sortie de sa réserve glaciale, comme si son cerveau et son corps n’étaient pas parvenus à se remettre de la stase cryogénique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edaadca5-a11e-47e8-a010-3efda0c4d203",
                        "source_entry_id": "19c5040b-749d-3d58-9380-4ea2cf2ba13f",
                        "source_sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
                        "target_lang_word": "Exobiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exobiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                        "entry_id": "ed3562d0-accf-37d4-8873-11388bdc3bd1",
                                        "glosses": [
                                            "Wissenschaftszweig, der sich mit der Entstehung des Lebens im Universum beschäftigt"
                                        ],
                                        "tags": [
                                            "Astrophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f14afbb-2ab2-4390-9493-c26000cdc93c",
                                                "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                                "text": "„Ein wirkliches Hauptproblem der Exobiologie ist allerdings, dass es keine allgemein anerkannte Definition von Leben gibt.“"
                                            },
                                            {
                                                "example_id": "3b768f0f-39ad-4d82-84ba-a7d26077a826",
                                                "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                                "text": "„Mit der von mir gefundenen Prä-RNA erklärt die Exobiologie die vorvorletzte Stufe vor der Urzelle. Was ist komplexer als Prä-RNA und simpler als Bakterien, verfügt aber über elementare Lebensqualität?“"
                                            },
                                            {
                                                "example_id": "72d08cdf-0b89-4c75-b925-b7e40144287d",
                                                "sense_id": "c69dc17f-641f-3ba8-99fa-2dba0776c8fb",
                                                "text": "„In den Biowissenschaften steht neben der Grundlagenforschung auf den Gebieten der Strahlen-, Gravitations- und Exobiologie die Aufklärung der wissenschaftlichen Voraussetzungen und die Entwicklung und Erprobung von Methoden und Technologien für Langzeitaufenthalte vom Menschen im Weltraum im Brennpunkt des Interesses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cb5c647-b6a5-4d19-83b2-1f39678a6fba",
                        "source_entry_id": "19c5040b-749d-3d58-9380-4ea2cf2ba13f",
                        "source_sense_id": "54d45472-f089-3ad6-b793-189fe5292faa",
