                        "sense_id": "5688d93a-3c16-34f6-bd8c-4990708b7eaa",
                        "entry_id": "38909587-3f17-39aa-93b2-bb7a7ddc87c9",
                        "glosses": [
                            "Corporal punishment at school."
                        ],
                        "tags": [
