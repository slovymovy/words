        "de-extract.jsonl": [
            {
                "entry_id": "1054cef8-7c3c-3b43-b3b1-2dc4d7597389",
                "word": "laceration",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9de75f4a-f004-3751-88a4-96df6615e604",
                        "entry_id": "1054cef8-7c3c-3b43-b3b1-2dc4d7597389",
                        "glosses": [
                            "langförmige Verletzung der Haut und des Fleisches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc4f0cc-46bf-4e1c-b0a1-a09f0847d138",
                                "sense_id": "9de75f4a-f004-3751-88a4-96df6615e604",
                                "text": "\"A laceration is a tear in tissue caused by either a shearing or a crushing force (Figure 4.8). Just as with contusions, one can have lacerations of internal organs as well as the skin.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e95eb14-0398-4d46-948f-d6e7939f2e3c",
                        "source_entry_id": "1054cef8-7c3c-3b43-b3b1-2dc4d7597389",
                        "source_sense_id": "9de75f4a-f004-3751-88a4-96df6615e604",
                        "source_sense_description": "Medizin: langförmige Verletzung der Haut und des Fleisches",
                        "target_lang_word": "Verletzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verletzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "eine Beschädigung von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91166979-0281-4914-acc6-3ea838d69718",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "„Bei den von mir untersuchten Wagnissportarten Bergsteigen, Fallschirmspringen, Gleitschirm-, Drachen-, Segelfliegen und Bungeespringen wird – gemessen an der Anzahl der Einzelaktionen, der Betätigungsdauer und der Schwere der Verletzungen – ein Gefährdungslevel unterschritten, der in anderen gesellschaftlichen Bereichen (z.B. dem Straßenverkehr) und in Volkssportarten (Fußball, Abfahrtski) allgemein toleriert wird.“"
                                            },
                                            {
                                                "example_id": "43baee43-193d-45a1-b6b7-5bde7cfec572",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "Ich habe mir gestern eine Verletzung der Milz zugezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "das Übertreten eines Gebotes, einer Grenze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e952727-0649-45db-914d-094ff0f1efb3",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "Es war eine schwere Verletzung der Aufsichtspflicht."
                                            },
                                            {
                                                "example_id": "b0c6ccb7-14cc-48a6-9b19-d9a5ae287a67",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "„Wir glauben kaum nötig zu haben, unsern Lesern die Tatsache zu bestätigen, die der Squire soeben erzählte und die, wie wir wissen, genau dahin ging, daß der berühmte Sieger wirklich zu dieser Geldstrafe wegen Verletzung der Habeascorpusakte während seines Oberbefehls verurteilt wurde: eine Strafe, der er sich auch willig unterzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4d6d0a6-a9ac-4572-a469-898e399a08d2",
                        "source_entry_id": "1054cef8-7c3c-3b43-b3b1-2dc4d7597389",
                        "source_sense_id": "9de75f4a-f004-3751-88a4-96df6615e604",
                        "source_sense_description": "Medizin: langförmige Verletzung der Haut und des Fleisches",
                        "target_lang_word": "Wunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                        "entry_id": "30d35b71-61ef-3f33-a959-52c1bc3bfd02",
                                        "glosses": [
                                            "offene Verletzung in der Haut oder im tieferliegenden Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7411c44-db25-4e9a-8bbc-8590c907dd3a",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "Die Kontrahenten fügten sich mit dem Schwert gegenseitig tiefe Wunden zu."
                                            },
                                            {
                                                "example_id": "f730ab40-ca88-4060-af5a-0b630dd8a9b7",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Was er eine ernste Wunde nannte, wußte sie aus seiner Vergangenheit.“"
                                            },
                                            {
                                                "example_id": "6f0bbbdd-4766-4025-adaf-3db081c4b871",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Die Wunde schlug eine Gürtelschnalle.“"
                                            },
                                            {
                                                "example_id": "62734791-d925-4f2e-94e8-b16e6837d955",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Und der Geruch aus seinen Wunden lockte zahllose Fliegen herbei.“"
                                            },
                                            {
                                                "example_id": "7bda8dd9-571d-484b-a8b7-1236c97540bd",
                                                "sense_id": "03330a64-2ed9-3e97-b8d9-3a77e69fbea5",
                                                "text": "„Auch in dieser Situation hatte er eine gute Figur gemacht, hatte die Wunde gereinigt, einbalsamiert und verbunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53ff5459-82fc-336b-bc11-04ef172b7f74",
                                        "entry_id": "30d35b71-61ef-3f33-a959-52c1bc3bfd02",
                                        "glosses": [
                                            "psychische Verletzung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc8fe59-65b5-425a-ae32-86ff893645db",
                                                "sense_id": "53ff5459-82fc-336b-bc11-04ef172b7f74",
                                                "text": "Die Zeit im Krisengebiet hatte Wunden in ihrer Seele hinterlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
