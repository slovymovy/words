                "senses": [
                    {
                        "sense_id": "02afb78e-38e8-3f16-8536-7eaa799b0ca1",
                        "entry_id": "190ff631-2570-3a3e-939a-c8f208424f1e",
                        "glosses": [
                            "Écraser, broyer, émietter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccfc1e92-d716-48d7-8f4d-bd5bcb7f481b",
                                "sense_id": "02afb78e-38e8-3f16-8536-7eaa799b0ca1",
                                "text": "Claque un peu ton bec mon Golgotheau, t’as rien vécu t’as juste de la gueule, le premier furvent t’étais raclé devant papa-maman, alors laisse-moi faire, tu me dois tout, je vais lui grémir les vertèbres, à la Traceuse, et te la basculer latéral, d'un coup de reins comme t’en as jamais vu frangin, à se déboîter le tronc, chuis le meilleur, ancre ça, le premier du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "188a270b-b1ae-3289-ae1e-f561531f3067",
                        "entry_id": "190ff631-2570-3a3e-939a-c8f208424f1e",
                        "glosses": [
                            "Frissonner."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "f2081791-3730-4965-85ae-a9079115377c",
                                "sense_id": "188a270b-b1ae-3289-ae1e-f561531f3067",
                                "text": "Et c'était çà qui mariait le monde ! Ça fait grémir !"
                            }
                        ]
                    }
