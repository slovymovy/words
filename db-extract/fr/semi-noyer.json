                        "glosses": [
                            "Noyer incomplètement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5899e52c-9d8e-4c2e-afaf-550f9e4cc7f6",
                                "sense_id": "06ce99f1-847a-3a18-b80f-cd91c88cfcf9",
                                "text": "Ça faisait huit mois à présent qu’ils avaient emménagé à quatre dans cette baraque, à quatre hommes semi-noyés dans la déroute économique, avec pour objectif improbable d’unir leurs efforts pour tâcher de se tirer de là."
                            },
                            {
                                "example_id": "f3a1b93a-0035-4dcb-b03c-ad24a234cc62",
                                "sense_id": "06ce99f1-847a-3a18-b80f-cd91c88cfcf9",
                                "text": "Puis quelques jours après, je prépare une solution sucrée à base d’eau et de sucre dans laquelle je les fais toutes tremper et que je touille pour bien les imprégner, voire les semi-noyer (oui oui pas sympa je sais mais c’est pour leur bien)."
                            },
                            {
                                "example_id": "e1b3d551-39f3-4101-808c-3238cc54d865",
                                "sense_id": "06ce99f1-847a-3a18-b80f-cd91c88cfcf9",
                                "text": "Ce qui revient à semi-noyer la voie."
                            },
                            {
                                "example_id": "5449d65c-b99a-4905-b843-7e0d051365ad",
                                "sense_id": "06ce99f1-847a-3a18-b80f-cd91c88cfcf9",
                                "text": "Pour l’instant on en est là, et c'est moche, mais peut-être que je tortillerai du ruban autour avant de le semi-noyer dans la résine."
                            }
                        ]
                    }
