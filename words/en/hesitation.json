{
    "word_family": [
        "hesitate",
        "hesitant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1739e8f-50a6-3168-af5d-49adc61bcb06",
                    "sense_definition": "The act of pausing before doing something, often due to uncertainty or fear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a slight <w>hesitation</w> in his voice before he answered the difficult question.",
                            "target_lang_translations": {
                                "es": "Hubo una ligera <w>vacilación</w> en su voz antes de responder a la difícil pregunta."
                            }
                        },
                        {
                            "text": "After a brief <w>hesitation</w>, she decided to accept the job offer.",
                            "target_lang_translations": {
                                "es": "Tras un breve <w>titubeo</w>, decidió aceptar la oferta de trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "delay"
                    ],
                    "common_phrases": [
                        "moment of hesitation"
                    ],
                    "target_lang_definitions": {
                        "es": "Acción de pausar antes de hacer algo, a menudo por incertidumbre o temor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vacilación",
                                "target_lang_sense_clarification": "pausa o indecisión antes de actuar"
                            },
                            {
                                "target_lang_word": "titubeo",
                                "target_lang_sense_clarification": "pausa o falta de firmeza momentánea"
                            },
                            {
                                "target_lang_word": "hesitación",
                                "target_lang_sense_clarification": "acto de hesitar; uso más formal o literario"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0b6a23f-dbd6-32fb-8749-525574a1defc",
                    "sense_definition": "A feeling of doubt or lack of confidence that causes someone to delay making a decision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carried out the order without <w>hesitation</w>.",
                            "target_lang_translations": {
                                "es": "Cumplió la orden sin <w>vacilación</w>."
                            }
                        },
                        {
                            "text": "He agreed to help his friend without any <w>hesitation</w>.",
                            "target_lang_translations": {
                                "es": "Aceptó ayudar a su amigo sin ninguna <w>duda</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "irresolution",
                        "wavering"
                    ],
                    "common_phrases": [
                        "without hesitation"
                    ],
                    "target_lang_definitions": {
                        "es": "Sentimiento de duda o falta de confianza que hace que alguien tarde en tomar una decisión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "duda",
                                "target_lang_sense_clarification": "falta de certeza o indecisión"
                            },
                            {
                                "target_lang_word": "vacilación",
                                "target_lang_sense_clarification": "irresolución o perplejidad"
                            },
                            {
                                "target_lang_word": "titubeo",
                                "target_lang_sense_clarification": "indecisión o inseguridad al decidir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b336d20-01ba-33c7-87d6-58f87a9917bd",
                    "sense_definition": "A temporary stop or faltering in speech, often characterized by stammering.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech_pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker had a noticeable <w>hesitation</w> whenever he had to pronounce complex technical terms.",
                            "target_lang_translations": {
                                "es": "El orador tenía un <w>titubeo</w> evidente cada vez que tenía que pronunciar términos técnicos complejos."
                            }
                        },
                        {
                            "text": "Her speech was marked by frequent <w>hesitation</w> due to her nervousness.",
                            "target_lang_translations": {
                                "es": "Su discurso estuvo marcado por frecuentes <w>vacilaciones</w> debido a sus nervios."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pausa temporal o tropiezo al hablar, caracterizado con frecuencia por titubeos o tartamudeo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "titubeo",
                                "target_lang_sense_clarification": "tropiezo o vacilación en el habla"
                            },
                            {
                                "target_lang_word": "vacilación",
                                "target_lang_sense_clarification": "pausa o falta de fluidez al hablar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}