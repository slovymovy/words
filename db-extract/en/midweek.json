    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f67004af-b468-3372-bc08-df620f604807",
                "word": "midweek",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e81abade-e694-3548-84fd-5860e2d36308",
                        "entry_id": "f67004af-b468-3372-bc08-df620f604807",
                        "glosses": [
                            "That happens in the middle of the week."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fbe4828f-0c4e-408c-91b7-c2b765d47334",
                                "sense_id": "e81abade-e694-3548-84fd-5860e2d36308",
                                "text": "Cheap mid-week return tickets were reintroduced by British Railways on May 7, to encourage holiday travel during the week rather than at weekends."
                            },
                            {
                                "example_id": "da000cd0-c39e-4fdb-85a8-a67572b4cf2d",
                                "sense_id": "e81abade-e694-3548-84fd-5860e2d36308",
                                "text": "I did not really wonder, after sampling the \"Settebello's\" standards of comfort and service, that even on a midweek day in autumn there was not a seat to spare, despite the cost."
                            },
                            {
                                "example_id": "1de43581-bbf3-445e-81d7-f21ea8a1d6bb",
                                "sense_id": "e81abade-e694-3548-84fd-5860e2d36308",
                                "text": "Peter Dods was captain in the midweek games but, like Sole, the Gala fullback has also hung up his boots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e542c76-1ffb-4ce8-bc8b-a7e3ccff4416",
                        "source_entry_id": "f67004af-b468-3372-bc08-df620f604807",
                        "source_sense_id": "e81abade-e694-3548-84fd-5860e2d36308",
                        "source_sense_description": "That happens in the middle of the week",
                        "target_lang_word": "Mittwoch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittwoch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12fda893-46b8-39bc-8f4d-928f3ebb9478",
                                        "entry_id": "06c1e29d-398b-3242-8d9d-916a417f501c",
                                        "glosses": [
                                            "dritter Wochentag gemäß ISO 8601; vierter Wochentag nach jüdischer, christlicher und islamischer Zählung; Tag zwischen Dienstag und Donnerstag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec441e5d-7101-4c0c-bd77-08cbe5e831f1",
                                                "sense_id": "12fda893-46b8-39bc-8f4d-928f3ebb9478",
                                                "text": "Der Mittwoch ist der klassische Ausgehtag der Deutschen."
                                            },
                                            {
                                                "example_id": "d15ea428-19d8-4313-98f8-8a44b5d8a3e2",
                                                "sense_id": "12fda893-46b8-39bc-8f4d-928f3ebb9478",
                                                "text": "Wenn heute Mittwoch ist, ist morgen Donnerstag."
                                            },
                                            {
                                                "example_id": "eb4fbaec-968a-41a4-954c-9beefeb0b652",
                                                "sense_id": "12fda893-46b8-39bc-8f4d-928f3ebb9478",
                                                "text": "Diesen Mittwoch fällt der Tanzkurs aus."
                                            },
                                            {
                                                "example_id": "b3a628c3-d053-4e5e-98ee-843c0d3ccf5b",
                                                "sense_id": "12fda893-46b8-39bc-8f4d-928f3ebb9478",
                                                "text": "„Siemens plant einem Medienbericht zufolge den Abbau von 11.600 Stellen.Dies habe Konzernchef Joe Kaeser in einer Webcast-Konferenz am Mittwoch gesagt, meldete die Nachrichtenagentur Bloomberg am Freitag.“"
                                            },
                                            {
                                                "example_id": "d0205099-5a3b-49af-9d4e-e243339217c0",
                                                "sense_id": "12fda893-46b8-39bc-8f4d-928f3ebb9478",
                                                "text": "„Des Mittwochens den 24, raseten des Feindes Bomben und Stincktöpffe mit Menge in die Statt hinein, und tähten an den Häusern sehr grossen Schaden; doch blieben die darinnen nichts schuldig."
                                            },
                                            {
                                                "example_id": "fced4e74-75f4-4462-beac-f8549e181616",
                                                "sense_id": "12fda893-46b8-39bc-8f4d-928f3ebb9478",
                                                "text": "„Der Mittwoch kam und ging, ohne daß ein Brief Schachs oder gar die geforderte Verlobungsankündigung erschienen wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mittwoch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                        "entry_id": "04ffa50d-9137-3577-a92b-0938ddb358be",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa86483-d79e-40e4-90de-3268e6290e99",
                                                "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                                "text": "Frau Mittwoch ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "2f9eb801-0dde-47c5-bbeb-8eaf010ed310",
                                                "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                                "text": "Herr Mittwoch wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "2da340ce-8135-4188-bebe-a29651fa5350",
                                                "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                                "text": "Die Mittwochs fahren heute in die Lüneburger Heide."
                                            },
                                            {
                                                "example_id": "f8c19269-3cc9-4789-b6fa-b1a10e230681",
                                                "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                                "text": "Der Mittwoch trägt nie die Schals, die die Mittwoch ihm strickt."
                                            },
                                            {
                                                "example_id": "baec5891-f4a8-4490-897c-f43a020e9601",
                                                "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mittwoch kommt, geht der Herr Mittwoch.“"
                                            },
                                            {
                                                "example_id": "373233ea-0dc4-474d-b98a-00f5ea3a6392",
                                                "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                                "text": "Mittwoch kommt und geht."
                                            },
                                            {
                                                "example_id": "cc37ad96-a6a0-402c-af4a-7fb18f6ffc4e",
                                                "sense_id": "e070ee27-c616-3e6f-b665-e5e23f0213ce",
                                                "text": "Mittwochs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
