                    "semantic_group_id": "taille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>énorme</w> camion bloque complètement le passage au bout de la rue.",
                            "target_lang_translations": {
                                "en": "A <w>huge</w> truck completely blocks the way at the end of the street.",
                                "ru": "<w>Огромный</w> грузовик полностью перекрывает проезд в конце улицы.",
                                "nl": "Een <w>enorme</w> vrachtwagen blokkeert helemaal de doorgang aan het eind van de straat.",
                                "de": "Ein <w>riesiger</w> Lastwagen blockiert am Ende der Straße vollständig die Durchfahrt.",
                                "pl": "<w>Ogromna</w> ciężarówka całkowicie blokuje przejazd na końcu ulicy.",
                                "it": "Un <w>enorme</w> camion blocca completamente il passaggio in fondo alla strada.",
                                "cs": "<w>Obrovský</w> nákladní vůz zcela blokuje průjezd na konci ulice.",
                                "tr": "Sokağın sonunda <w>kocaman</w> bir kamyon geçişi tamamen tıkıyor.",
                                "es": "Un camión <w>enorme</w> bloquea por completo el paso al final de la calle.",
                                "zh": "一辆<w>巨大</w>的卡车完全堵住了街道尽头的通道。"
                            }
                        },
                        {
                            "text": "Les marins ont dû affronter d'<w>énormes</w> vagues pendant toute la tempête.",
                            "target_lang_translations": {
                                "en": "The sailors had to face <w>huge</w> waves throughout the storm.",
                                "ru": "Всю бурю морякам пришлось противостоять <w>огромным</w> волнам.",
                                "nl": "De zeelieden moesten tijdens de hele storm het hoofd bieden aan <w>enorme</w> golven.",
                                "de": "Die Seeleute mussten während des ganzen Sturms gegen <w>riesige</w> Wellen ankämpfen.",
                                "pl": "Przez całą burzę marynarze musieli walczyć z <w>ogromnymi</w> falami.",
                                "it": "I marinai hanno dovuto affrontare delle <w>enormi</w> onde per tutta la durata della tempesta.",
                                "cs": "Námořníci museli během celé bouře čelit <w>obrovským</w> vlnám.",
                                "tr": "Denizciler fırtına boyunca <w>devasa</w> dalgalarla mücadele etmek zorunda kaldı.",
                                "es": "Los marineros tuvieron que afrontar olas <w>enormes</w> durante toda la tormenta.",
                                "zh": "在整个暴风雨中，水手们都不得不面对<w>巨大</w>的海浪。"
                            }
                        }
