                    {
                        "translation_id": "304871d1-6b91-423b-8e03-51e69dff663a",
                        "source_entry_id": "a96fbcdc-5606-31b3-a374-374e780c4c97",
                        "source_sense_description": "pertaining to space",
                        "target_lang_word": "spatial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spatial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac1837b-a770-3c4b-b86b-4027d21c419b",
                                        "entry_id": "5100ae5c-983e-3ba1-b97a-c6547bd8eb75",
                                        "glosses": [
                                            "Relatif à l’espace, au volume, aux trois dimensions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484941c3-13d1-40e7-835b-3bcb1213e752",
                                                "sense_id": "6ac1837b-a770-3c4b-b86b-4027d21c419b",
                                                "text": "Je cherchai donc à me représenter la dualité onde-corpuscule par une image spatiale où le corpuscule serait le centre d'un phénomène ondulatoire étendu."
                                            },
                                            {
                                                "example_id": "092ed1d4-3081-4909-8347-32f6617129ff",
                                                "sense_id": "6ac1837b-a770-3c4b-b86b-4027d21c419b",
                                                "text": "L’objectif majeur de cette étude était d’identifier l’influence de différents facteurs dynamiques sur la distribution spatiale des matières en suspension dans une région côtière macrotidale et fortement influencée par les apports fluviaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1667bcbd-a7d8-3d77-86ff-696a0acf8d5a",
                                        "entry_id": "5100ae5c-983e-3ba1-b97a-c6547bd8eb75",
                                        "glosses": [
                                            "Relatif à l’espace, à la place, à l’étalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a5e45d-f9d2-4d1d-a6de-3aa3e38ce61f",
                                                "sense_id": "1667bcbd-a7d8-3d77-86ff-696a0acf8d5a",
                                                "text": "Au contraire, une ville dans laquelle dominent les allophobes, ceux qui cherchent à habiter dans des unités spatiales dont les habitants leur ressemblent, cesse d'être une ville pour devenir une constellation de quartiers périurbains homogènes et séparés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9906ff2e-a677-3fe8-be43-c1b250e95858",
                                        "entry_id": "5100ae5c-983e-3ba1-b97a-c6547bd8eb75",
                                        "glosses": [
                                            "Relatif à l’espace, la zone hors de l’atmosphère terrestre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16fa10f-0e2b-45e1-831a-eee854f8e5cb",
                                                "sense_id": "9906ff2e-a677-3fe8-be43-c1b250e95858",
                                                "text": "Un homme aurait résisté dès le mois d'août dernier aux épreuves physiques de vol spatial, y compris l’impondérabilité, les accélérations et les décélérations de la mise à feu des divers étages de la fusée […]."
                                            },
                                            {
                                                "example_id": "8138a66f-047a-442e-9e9a-68c65ee73a96",
                                                "sense_id": "9906ff2e-a677-3fe8-be43-c1b250e95858",
                                                "text": "Rappelons qu’aucune des nombreuses missions spatiales américaines n’a rapporté d’inexplicables observations d’ovnis."
                                            },
                                            {
                                                "example_id": "38184795-6606-493a-a9ea-ed6d750e80eb",
                                                "sense_id": "9906ff2e-a677-3fe8-be43-c1b250e95858",
                                                "text": "Quand le monde apprend que les Soviétiques ont lancé, le 4 octobre 1957, un satellite artificiel de la Terre, c'est l’étonnement et l’admiration chez beaucoup, qui prennent conscience que l’ère spatiale commence vraiment, et c’est la panique chez les Américains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spatial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9037b8d8-e8b4-3e4f-8375-f80d600938ad",
                                        "entry_id": "f9fb7605-cd90-301b-bcb4-c40032f70278",
                                        "glosses": [
                                            "L'industrie des satellites spatiaux."
                                        ],
                                        "tags": [
                                            "collectively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c295e9d6-862a-47c4-b40f-237ee8b8450e",
                                                "sense_id": "9037b8d8-e8b4-3e4f-8375-f80d600938ad",
                                                "text": "Le monde du spatial a été surpris par la défaite d'EADS-Astrium dans l'attribution des 14 satellites du système Galiléo, remportée par l'allemand OHB. Le numéro 1 européen du spatial s'est consolé avec des prises de commandes plus que doublées en 2009, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62fea3f2-3ba0-4421-bd40-028c097d2deb",
                        "source_entry_id": "a96fbcdc-5606-31b3-a374-374e780c4c97",
                        "source_sense_description": "pertaining to space",
                        "target_lang_word": "räumlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "räumlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                        "entry_id": "9f74ce48-5ad8-324a-965c-54de5b168372",
                                        "glosses": [
                                            "auf den Raum bezüglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df037f4-03ca-4c5e-a118-86ca55889f0a",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "Die Zimmer werden demnächst räumlicher eingerichtet."
                                            },
                                            {
                                                "example_id": "a66c1b2f-8b7f-4460-a44c-d20ec9931340",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "Dein Pappkarton ist innen räumlich und bietet für die Gegenstände viel Raum."
                                            },
                                            {
                                                "example_id": "4f35048a-0ea2-48ea-bcee-ef0fffdcf277",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "Der Ursprung ist der räumliche oder zeitliche Ausgangs- oder Referenzpunkt eines Ereignisses oder Systems."
                                            },
                                            {
                                                "example_id": "395e1730-2e78-4c99-9c49-3ec97f577bdd",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "„Vielmehr sind die USA sowohl, was die Bevölkerung als auch was die räumliche Ausdehnung angeht, das drittgrößte Land der Erde.“"
                                            },
                                            {
                                                "example_id": "10d460f1-5b7e-4e32-9c67-1f53cc9eec16",
                                                "sense_id": "8704035f-9750-36a9-a41a-925cacb38a94",
                                                "text": "„Dem Bericht zufolge plante die renommierte Lehranstalt in den späten Neunzigerjahren eine räumliche Erweiterung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
