            "senses": [
                {
                    "sense_id": "37f4869a-0fa5-3ae2-a248-c5ed756f89da",
                    "sense_definition": "Nach dem Tod einer Person deren Vermögen, Besitz oder Rechte rechtmäßig erhalten.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "Besitz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem überraschenden Tod seiner Tante wird er ihr gesamtes Vermögen <w>erben</w>."
                        },
                        {
                            "text": "Sie hat von ihren Großeltern ein wunderschönes Haus auf dem Land <w>geerbt</w>."
                        }
                    ],
                    "synonyms": [
                        "erhalten",
                        "übernehmen"
                    ],
                    "antonyms": [
                        "vererben",
                        "hinterlassen"
                    ],
                    "common_phrases": [
                        "ein Haus erben",
                        "ein Vermögen erben"
                    ]
                },
                {
                    "sense_id": "8d79c131-060f-319a-99b1-ae44fe108d89",
                    "sense_definition": "Bestimmte körperliche Merkmale, Charaktereigenschaften oder Begabungen von den biologischen Vorfahren mitbekommen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat die dunklen Locken und das musikalische Talent von seiner Mutter <w>geerbt</w>."
                        },
                        {
                            "text": "Manche Kinder <w>erben</w> die Geduld ihres Vaters, andere seine Nervosität."
                        }
                    ],
                    "synonyms": [
