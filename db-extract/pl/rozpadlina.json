                "senses": [
                    {
                        "sense_id": "f55a9ba0-d2a4-3414-8e6f-627aa168b504",
                        "entry_id": "2c3908d2-95d4-398f-8d87-29a697c3e503",
                        "glosses": [
                            "szeroko rozwarta i często głęboka szczelina powstała w ziemi lub w skale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da79f7a-c442-4fb8-b470-85f0e493d5e3",
                                "sense_id": "f55a9ba0-d2a4-3414-8e6f-627aa168b504",
                                "text": "Jednak łagodne i wdzięczne zakręty łąki zwężały się coraz, aż ustąpiły miejsca wąskiej rozpadlinie, a ścieżki w głąb parowu prowadzące zaczęły piąć się po stokach gór; to nagie, skaliste, ostrymi rozpęknięciami poprzerywane i kolczystą wikliną zjeżone, to zielone i tajemniczo pod sklepieniami liściastej zarośli przepadające."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3679e9a2-a256-3baf-b47b-63f27a13573e",
                        "entry_id": "2c3908d2-95d4-398f-8d87-29a697c3e503",
                        "glosses": [
                            "głęboki linijny ubytek w naskórku i w skórze właściwej, dochodzący do głębszych jej warstw"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6059c633-3e27-4fa7-a443-9515bb917b61",
                        "source_entry_id": "2c3908d2-95d4-398f-8d87-29a697c3e503",
                        "source_sense_id": "f55a9ba0-d2a4-3414-8e6f-627aa168b504",
                        "target_lang_word": "fissure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
