            {
                "entry_id": "d90c3d18-6a1f-3295-aa1f-21c7534ae65e",
                "word": "Galate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "82dfa73f-db2a-45b2-910b-370cca06bdc8",
                        "entry_id": "d90c3d18-6a1f-3295-aa1f-21c7534ae65e",
                        "tags": [
