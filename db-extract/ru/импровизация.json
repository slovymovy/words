                        "source_entry_id": "e01b9a5e-608f-35d1-a662-6a994ead36b9",
                        "source_sense_description": "действие",
                        "target_lang_word": "Improvisation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Improvisation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9fe7f09-a157-3f3d-8acc-57f89d18f421",
                                        "entry_id": "0fa28213-92d4-363e-9a72-b35feef9197a",
                                        "glosses": [
                                            "die Kunst, unvorbereitet, unmittelbar und spontan etwas darzubieten oder herzustellen, meist im Theater, in der Musik, oder beim Tanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aed8d5f-c7d5-4349-8b91-bfcedb398ffb",
                                                "sense_id": "d9fe7f09-a157-3f3d-8acc-57f89d18f421",
                                                "text": "Im Jazz werden sehr oft Improvisationen gespielt."
                                            },
                                            {
                                                "example_id": "b11fd8f7-c1fe-4b35-94cd-60c317a809d1",
                                                "sense_id": "d9fe7f09-a157-3f3d-8acc-57f89d18f421",
                                                "text": "„Heute kann ich mich nicht zurücklehnen und den tonreichen Improvisationen unseres besten Saxophonisten lauschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaeaf1fc-4b80-4eed-8ca9-9016fbcec343",
                        "source_entry_id": "e01b9a5e-608f-35d1-a662-6a994ead36b9",
                        "source_sense_description": "действие",
                        "target_lang_word": "improvisatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improvisatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1afa1005-cef0-3960-bfc5-a70fcbebe05b",
                                        "entry_id": "3cd76742-efe9-3747-b91e-bbac58268c2c",
                                        "glosses": [
                                            "ter plekke verzonnen versie van een muziekstuk, voorlezing, enz. die niet van te voren bedacht is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c2ba83-83a1-4523-99df-8c52c18336ca",
                                                "sense_id": "1afa1005-cef0-3960-bfc5-a70fcbebe05b",
                                                "text": "Een improvisatie spelen."
                                            },
                                            {
                                                "example_id": "52f5256c-358b-4b9f-8e1b-74667872b91a",
                                                "sense_id": "1afa1005-cef0-3960-bfc5-a70fcbebe05b",
                                                "text": "Moeiteloos liet ik me gaan in muzikale improvisaties. Wat een klank, wat een heerlijkheid gaf deze Bechstein ons."
                                            },
                                            {
                                                "example_id": "c4f0405d-be26-400b-9d92-81b484e14263",
                                                "sense_id": "1afa1005-cef0-3960-bfc5-a70fcbebe05b",
                                                "text": "De hele schouderpartij was een soort modernistische improvisatie, heel ver verwijderd van de wiskundige regelmaat van de lokale kunst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "141b5c47-338d-4eb1-b365-795b263b6e83",
                        "source_entry_id": "e01b9a5e-608f-35d1-a662-6a994ead36b9",
                        "source_sense_description": "действие",
                        "target_lang_word": "emprovizasyon",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
