                        "entry_id": "0d33c9e6-4bc1-3fbe-a6fc-a1ec5454a1d0",
                        "glosses": [
                            "Qui déshabille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f577a93b-ea26-4ebc-9615-455103ce6a29",
                                "sense_id": "e382a02f-850b-32e6-9533-56be8543c7bb",
                                "text": "Il se mit à lui faire de l’œil. Et quel œil ! Son plus déshabilleur, son plus lubrique, son mieux promettant !"
                            },
                            {
                                "example_id": "d07d564f-2b8f-4228-aab2-9d66f5ed9d9d",
                                "sense_id": "e382a02f-850b-32e6-9533-56be8543c7bb",
                                "text": "La terre tremble et se mutine\nCar l'automne déshabilleur\nA glissé sa main libertine\nSous son feuillage gazouilleur."
                            },
                            {
                                "example_id": "93947b32-a08a-4ca3-a0b3-a27064a98daf",
                                "sense_id": "e382a02f-850b-32e6-9533-56be8543c7bb",
                                "text": "Il enveloppe Hélène d’un regard connaisseur, de la pointe de ses chaussures à la racine de ses cheveux, en un aller-retour déshabilleur."
                            }
                        ]
                    }
                ],
