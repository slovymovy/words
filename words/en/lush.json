    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6895d3c9-15f1-3105-963e-48e28e4817e4",
                    "sense_definition": "Dense, teeming with life; luxuriant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers walked through the <w>lush</w> green forest after the heavy rain.",
                            "target_lang_translations": {
                                "it": "Gli escursionisti hanno camminato attraverso la <w>rigogliosa</w> foresta verde dopo la forte pioggia.",
                                "fr": "Les randonneurs ont traversé la forêt verte et <w>luxuriante</w> après la forte pluie."
                            }
                        },
                        {
                            "text": "Many rare birds live in the <w>lush</w> tropical jungle.",
                            "target_lang_translations": {
                                "it": "Molti uccelli rari vivono nella <w>lussureggiante</w> giungla tropicale.",
                                "fr": "De nombreux oiseaux rares vivent dans la jungle tropicale <w>luxuriante</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdant"
                    ],
                    "common_phrases": [
                        "lush green forest",
                        "lush tropical vegetation"
                    ],
                    "target_lang_definitions": {
                        "it": "Denso, ricco di vegetazione; rigoglioso.",
                        "fr": "Dense, abondant et plein de vie ; luxuriant."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "rigoglioso",
                                "target_lang_sense_clarification": "riferito a vegetazione in pieno sviluppo"
                            },
                            {
                                "target_lang_word": "lussureggiante",
                                "target_lang_sense_clarification": "riferito a vegetazione abbondante e rigogliosa"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "luxuriant",
                                "target_lang_sense_clarification": "se dit d'une végétation très riche et abondante"
                            },
                            {
                                "target_lang_word": "verdoyant",
                                "target_lang_sense_clarification": "couvert d'une végétation verte et fraîche"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dcc0c88-c628-360b-9b11-5a36d2fa0790",
                    "sense_definition": "Savoury, delicious.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That homemade chocolate cake was absolutely <w>lush</w>.",
                            "target_lang_translations": {
                                "it": "Quella torta al cioccolato fatta in casa era assolutamente <w>deliziosa</w>.",
                                "fr": "Ce gâteau au chocolat maison était absolument <w>délicieux</w>."
                            }
                        },
                        {
                            "text": "We enjoyed a <w>lush</w> meal at the new bistro downtown.",
                            "target_lang_translations": {
                                "it": "Abbiamo gustato un <w>squisito</w> pasto al nuovo bistrot in centro.",
                                "fr": "Nous avons savouré un repas <w>succulent</w> au nouveau bistrot du centre-ville."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lush meal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English, especially Wales and South West England."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Saporito, delizioso.",
                        "fr": "Savoureux, délicieux."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "delizioso",
                                "target_lang_sense_clarification": "riferito a cibo molto buono"
                            },
                            {
                                "target_lang_word": "squisito",
                                "target_lang_sense_clarification": "riferito a un pasto di alta qualità"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "délicieux",
                                "target_lang_sense_clarification": "très agréable au goût"
                            },
                            {
                                "target_lang_word": "succulent",
                                "target_lang_sense_clarification": "extrêmement savoureux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c862d64a-b0fc-3c38-95c6-63ad1db38ff8",
                    "sense_definition": "Amazing, cool, fantastic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "positive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your new car is <w>lush</w>!",
                            "target_lang_translations": {
                                "it": "La tua nuova auto è <w>fantastica</w>!",
                                "fr": "Ta nouvelle voiture est <w>géniale</w> !"
                            }
                        },
                        {
                            "text": "The music at the concert was <w>lush</w>.",
                            "target_lang_translations": {
                                "it": "La musica al concerto era <w>eccezionale</w>.",
                                "fr": "La musique au concert était <w>superbe</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Fantastico, eccezionale.",
                        "fr": "Formidable, génial, fantastique."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fantastico",
                                "target_lang_sense_clarification": "usato colloquialmente per descrivere qualcosa di ottimo"
                            },
                            {
                                "target_lang_word": "eccezionale",
                                "target_lang_sense_clarification": "usato per descrivere qualcosa di qualità superiore"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "génial",
                                "target_lang_sense_clarification": "familier pour exprimer l'enthousiasme"
                            },
                            {
                                "target_lang_word": "superbe",
                                "target_lang_sense_clarification": "magnifique ou très réussi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce7adbc-de08-3763-9c1b-7809f00f513f",
                    "sense_definition": "Drunk; inebriated.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was too <w>lush</w> to stand up straight after the party.",
                            "target_lang_translations": {
                                "it": "Era troppo <w>ubriaco</w> per stare dritto dopo la festa.",
                                "fr": "Il était trop <w>bourré</w> pour tenir debout après la fête."
                            }
                        },
                        {
                            "text": "The man was clearly <w>lush</w> and causing a scene at the bar.",
                            "target_lang_translations": {
                                "it": "L'uomo era chiaramente <w>ubriaco</w> e stava facendo una scenata al bar.",
                                "fr": "L'homme était visiblement <w>ivre</w> et faisait un scandale au bar."
                            }
                        }
