{
    "word_family": [
        "plat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68c6c60e-e4d0-3983-9452-536f57dfac3e",
                    "sense_definition": "A largely level expanse of land at a high elevation; tableland.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expedition crossed a vast <w>plateau</w> before reaching the mountain range.",
                            "target_lang_translations": {
                                "zh": "探险队在到达山脉前穿过了一片广阔的<w>高原</w>。"
                            }
                        },
                        {
                            "text": "High <w>plateau</w> regions often have unique climates compared to the surrounding lowlands.",
                            "target_lang_translations": {
                                "zh": "与周围低地相比，高<w>高原</w>地区通常具有独特的气候。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tableland"
                    ],
                    "common_phrases": [
                        "high plateau"
                    ],
                    "target_lang_definitions": {
                        "zh": "高海拔地区平坦的广阔土地；高原。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高原",
                                "target_lang_sense_clarification": "地理学意义上的高地。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca48d435-c2c2-38f3-8fa7-0eab447c792a",
                    "sense_definition": "A comparatively stable level after a period of increase.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of rapid growth, the company's sales reached a <w>plateau</w>.",
                            "target_lang_translations": {
                                "zh": "经过几个月的快速增长，该公司的销售额进入了<w>平台期</w>。"
                            }
                        },
                        {
                            "text": "The infection rate hit a <w>plateau</w> after the new health measures were implemented.",
                            "target_lang_translations": {
                                "zh": "实施新的卫生措施后，感染率<w>趋于平稳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leveling off"
                    ],
                    "common_phrases": [
                        "hit a plateau"
                    ],
                    "target_lang_definitions": {
                        "zh": "增长期后相对稳定的水平。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "平台期",
                                "target_lang_sense_clarification": "指发展或增长停滞在某一水平。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae94bf60-c5c0-3b35-9d86-0b1a516a9b45",
                    "sense_definition": "A notable level of attainment or achievement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete felt she had reached a <w>plateau</w> in her training and needed a new coach.",
                            "target_lang_translations": {
                                "zh": "这位运动员觉得她的训练遇到了<w>瓶颈期</w>，需要一位新教练。"
                            }
                        },
                        {
                            "text": "Learning a language often involves hitting a <w>plateau</w> where progress seems to stop.",
                            "target_lang_translations": {
                                "zh": "学习语言通常会经历一个进步似乎停滞的<w>瓶颈期</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "显著的成就或达到某种水平。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瓶颈期",
                                "target_lang_sense_clarification": "指进步停滞、难以突破的阶段。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "693836b6-c09d-385e-8920-647c554ae5f3",
                    "sense_definition": "An ornamental dish for the table; a tray or salver.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silver <w>plateau</w> held the centerpiece of flowers in the middle of the dining table.",
                            "target_lang_translations": {
                                "zh": "银质<w>托盘</w>上放着餐桌中央的花卉装饰。"
                            }
                        },
                        {
                            "text": "Antique shops often display a decorative <w>plateau</w> used for serving tea.",
                            "target_lang_translations": {
                                "zh": "古董店经常展示用于上茶的装饰性<w>托盘</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tray",
                        "salver"
                    ],
                    "target_lang_definitions": {
                        "zh": "餐桌上的装饰性盘子；托盘。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "托盘",
                                "target_lang_sense_clarification": "用于盛放物品的平底器皿。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "708b2eae-b06b-3306-b59d-90e2b4fd14d1",
                    "sense_definition": "Any of several distinct, dose-dependent stages of a dextromethorphan trip.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Users often describe the different <w>plateau</w> levels experienced during the drug's effects.",
                            "target_lang_translations": {
                                "zh": "使用者经常描述药物作用期间所经历的不同<w>阶段</w>。"
                            }
                        },
                        {
                            "text": "Reaching a higher <w>plateau</w> significantly increases the intensity of the experience.",
                            "target_lang_translations": {
                                "zh": "达到更高的<w>阶段</w>会显著增加体验的强度。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in the context of drug culture."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "右美沙芬药物作用的不同阶段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阶段",
                                "target_lang_sense_clarification": "指药物作用的不同强度等级。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e896a719-1edf-317c-8161-f8090d5b874d",
                    "sense_definition": "To reach a stable level after a period of increase; to level off.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The number of new cases began to <w>plateau</w> after the lockdown started.",
                            "target_lang_translations": {
                                "zh": "封锁开始后，新增病例数开始<w>趋于平稳</w>。"
                            }
                        },
                        {
                            "text": "Economic growth is expected to <w>plateau</w> by the end of the year.",
                            "target_lang_translations": {
                                "zh": "预计经济增长将在年底<w>趋于平稳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "level off",
                        "stabilize"
                    ],
                    "common_phrases": [
                        "growth plateaus"
                    ],
                    "target_lang_definitions": {
                        "zh": "在增长后达到稳定水平；趋于平稳。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "趋于平稳",
                                "target_lang_sense_clarification": "指增长速度放缓并保持稳定。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d978f384-b788-370d-9e6e-922c892ed5d3",
                    "sense_definition": "A state of Nigeria in the North Central geopolitical zone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The city of Jos is the capital of <w>Plateau</w> State.",
                            "target_lang_translations": {
                                "zh": "乔斯市是<w>高原州</w>的首府。"
                            }
                        },
                        {
                            "text": "Many tourists visit <w>Plateau</w> for its cooler climate and scenic hills.",
                            "target_lang_translations": {
                                "zh": "许多游客因其凉爽的气候和风景优美的山丘而造访<w>高原州</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "尼日利亚的一个州。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高原州",
                                "target_lang_sense_clarification": "尼日利亚行政区划名称。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "206b071b-499e-33f1-885b-34073f0eb475",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The researcher <w>Plateau</w> published a study on visual persistence.",
                            "target_lang_translations": {
                                "zh": "研究员<w>普拉托</w>发表了一项关于视觉暂留的研究。"
                            }
                        },
                        {
                            "text": "Joseph <w>Plateau</w> was a famous Belgian physicist.",
                            "target_lang_translations": {
                                "zh": "约瑟夫·<w>普拉托</w>是一位著名的比利时物理学家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "普拉托",
                                "target_lang_sense_clarification": "音译姓氏。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36c7e694-7a62-3871-b87f-79cf46b6efe5",
                    "sense_definition": "Former name of Lusong: a barangay of Buenavista, Bohol, Philippines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The area now known as Lusong was historically called <w>Plateau</w>.",
                            "target_lang_translations": {
                                "zh": "现在被称为卢松的地区历史上曾被称为<w>普拉托</w>。"
                            }
                        },
                        {
                            "text": "Local records mention <w>Plateau</w> as the original name of the barangay.",
                            "target_lang_translations": {
                                "zh": "当地记录提到<w>普拉托</w>是该社区的原始名称。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specific to a location in the Philippines."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "菲律宾的一个地名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "普拉托",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}