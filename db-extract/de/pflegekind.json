                "senses": [
                    {
                        "sense_id": "b33e38ad-ac7e-3598-a6d4-3b685957f4fb",
                        "entry_id": "7e017bfd-b1b6-3aab-ae31-94ebc375c1fb",
                        "glosses": [
                            "zur Betreuung und Erziehung von einer fremden Familie aufgenommenes Kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f437536-098e-4b24-821a-c2f27cb2ab22",
                                "sense_id": "b33e38ad-ac7e-3598-a6d4-3b685957f4fb",
                                "text": "„Ein Regelwerk der Familienbehörde soll nun Schutzlosigkeit weiterer Pflegekinder verhindern.“"
                            },
                            {
                                "example_id": "d088a6ca-7aef-435b-a2a3-a4cc91ade4e6",
                                "sense_id": "b33e38ad-ac7e-3598-a6d4-3b685957f4fb",
                                "text": "„Alles, was man von ihm erfuhr, war die Vermutung, daß sein Pflegekind wahrscheinlich einer spanischen oder französischen Pflanzerfamilie am Mississippi angehöre.“"
                            },
                            {
                                "example_id": "70c82f2f-a03c-4a21-b0f2-3f1f3d3f3465",
                                "sense_id": "b33e38ad-ac7e-3598-a6d4-3b685957f4fb",
                                "text": "„Das Pflegekind der Köchin hatte es sich zur Gewohnheit gemacht, zu schimpfen und zu fluchen, sobald sie von der Köchin nicht gehört werden konnte: das war gewissermaßen ein Gegengewicht zum Worte Gottes.“"
                            },
                            {
                                "example_id": "3f8af20e-4a07-4682-ba8d-a797c8009c4c",
                                "sense_id": "b33e38ad-ac7e-3598-a6d4-3b685957f4fb",
                                "text": "„Ihr Sohn wird Pflegekind bei einer konservativen Familie auf der Schwäbischen Alb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
