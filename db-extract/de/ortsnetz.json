                        "sense_id": "eebe8b79-c5d0-3e64-a385-4c7d7370fb16",
                        "entry_id": "0ef29ac1-98f0-3b7f-b06f-d2b62d664fdf",
                        "glosses": [
                            "Gesamtheit aller Anschlüsse, die unter derselben Vorwahl zu erreichen sind"
                        ],
                        "tags": [
                            "Telefonie"
                        ],
                        "examples": [
                            {
                                "example_id": "fb62ff7a-cad2-488c-8892-a170ba398968",
                                "sense_id": "eebe8b79-c5d0-3e64-a385-4c7d7370fb16",
                                "text": "Gespräche im Ortsnetz nennt man Ortsgespräche."
                            },
                            {
                                "example_id": "50b5f022-fe9b-41c6-ac7a-f75bbd24f868",
                                "sense_id": "eebe8b79-c5d0-3e64-a385-4c7d7370fb16",
                                "text": "„Kaum ist er dem Ortsnetz angeklemmt und fernmündlich erreichbar, schon füllt sich sein Briefkasten mit Drucksachen voll zwingender Fürsorglichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
