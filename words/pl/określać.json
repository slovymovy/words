{
    "word_family": [
        "określenie",
        "określony",
        "określnik",
        "nieokreślony",
        "określoność"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bcf2da87-7300-3430-838d-272f54e76bb4",
                    "sense_definition": "podawać cechy, właściwości lub znaczenie czegoś; charakteryzować lub definiować",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "charakteryzowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uczeń dokładnie <w>określa</w> skład chemiczny badanej substancji podczas lekcji.",
                            "target_lang_translations": {
                                "ru": "Ученик на уроке точно <w>определяет</w> химический состав исследуемого вещества."
                            }
                        },
                        {
                            "text": "Słownik jasno <w>określa</w> znaczenie tego rzadko używanego wyrazu.",
                            "target_lang_translations": {
                                "ru": "Словарь ясно <w>определяет</w> значение этого редко используемого слова."
                            }
                        }
                    ],
                    "synonyms": [
                        "definiować"
                    ],
                    "common_phrases": [
                        "określać mianem",
                        "dokładnie określać",
                        "określać znaczenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "указывать признаки, свойства или значение чего-либо; давать определение, характеризовать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "значение, сущность или состав чего-либо"
                            },
                            {
                                "target_lang_word": "давать определение",
                                "target_lang_sense_clarification": "словесно формулировать понятие"
                            },
                            {
                                "target_lang_word": "характеризовать",
                                "target_lang_sense_clarification": "описывать отличительные свойства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bff2870f-e6af-3ece-900e-5d81cfa2aaa4",
                    "sense_definition": "wyznaczać lub precyzować szczegóły, warunki, granice lub wielkości",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wyznaczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowy regulamin precyzyjnie <w>określa</w> zasady korzystania ze sprzętu biurowego.",
                            "target_lang_translations": {
                                "ru": "Новый регламент точно <w>устанавливает</w> правила пользования офисной техникой."
                            }
                        },
                        {
                            "text": "Lekarz <w>określa</w> dawkę leku na podstawie masy ciała pacjenta.",
                            "target_lang_translations": {
                                "ru": "Врач <w>определяет</w> дозировку лекарства на основе массы тела пациента."
                            }
                        }
                    ],
                    "synonyms": [
                        "ustalać",
                        "wyznaczać"
                    ],
                    "common_phrases": [
                        "określać zasady",
                        "określać warunki",
                        "określać termin"
                    ],
                    "target_lang_definitions": {
                        "ru": "устанавливать или уточнять детали, условия, рамки либо величины"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "правила, сроки, величины"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "правила, порядок, параметры"
                            },
                            {
                                "target_lang_word": "обозначать",
                                "target_lang_sense_clarification": "указывать границы, рамки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7768694d-dbe7-3196-b663-e0199adbfc99",
                    "sense_definition": "przedstawiać siebie w określony sposób, ujawniać swoją tożsamość, poglądy lub przynależność (z zaimkiem „się”)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tozsamosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor w wywiadzie <w>określa</w> się jako zwolennik tradycyjnego podejścia do sztuki.",
                            "target_lang_translations": {
                                "ru": "В интервью автор <w>позиционирует себя</w> как сторонник традиционного подхода к искусству."
                            }
                        },
                        {
                            "text": "Wielu młodych ludzi jednoznacznie <w>określa</w> się dopiero po ukończeniu studiów.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди однозначно <w>определяются</w> только после окончания университета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "określać się jako",
                        "jednoznacznie się określać"
                    ],
                    "target_lang_definitions": {
                        "ru": "заявлять о себе, выражать свою идентичность, взгляды или принадлежность (с частицей «się»)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позиционировать себя",
                                "target_lang_sense_clarification": "представлять себя кем-либо"
                            },
                            {
                                "target_lang_word": "определяться",
                                "target_lang_sense_clarification": "делать выбор относительно взглядов или идентичности"
                            },
                            {
                                "target_lang_word": "называть себя",
                                "target_lang_sense_clarification": "характеризовать себя кем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}