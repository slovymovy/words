                "senses": [
                    {
                        "sense_id": "850bf035-5e30-3375-a7b7-d13ceb32e2e0",
                        "entry_id": "d4b5b016-69db-3a78-b4cd-5e5d5899d261",
                        "glosses": [
                            "The sound produced when someone or something bellows"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ab6316-db2d-4f28-99b6-e2a2755c1d46",
                                "sense_id": "850bf035-5e30-3375-a7b7-d13ceb32e2e0",
                                "text": "The cries of applause and derision from the spectators, and the formidable bellowings of the exasperated monks who surrounded Pachymius, did not tend to steady his nerves, or render the task of critical discrimination the easier."
                            },
                            {
                                "example_id": "e175e7ec-8bc3-4c46-86f8-78b232533069",
                                "sense_id": "850bf035-5e30-3375-a7b7-d13ceb32e2e0",
                                "text": "Incessant bellowings fill all the earth, Mingled with inextinguishable mirth."
                            },
                            {
                                "example_id": "a1afc432-7093-41a6-9a7b-330387714579",
                                "sense_id": "850bf035-5e30-3375-a7b7-d13ceb32e2e0",
                                "text": "With great heavings and throes, with snortings and bellowings, with scratchings and tearings of its great claws and lashings of its terrible tail, it writhed and fought to be free, and the light of thousands of fireworks illuminated the gigantic struggle."
                            }
                        ]
                    }
                ],
