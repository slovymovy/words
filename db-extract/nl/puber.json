                "translations": [
                    {
                        "translation_id": "0f63ef3c-d82c-441b-b681-e84d304ff9c5",
                        "source_entry_id": "6f5d143c-27f5-31c4-b3e7-8c286f0da55a",
                        "source_sense_id": "5587bb15-7a96-31ce-99e1-6d9a24ed98d2",
                        "target_lang_word": "adolescent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adolescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "012d053d-7229-32a8-b9f0-d5f38ada8159",
                                        "entry_id": "fec9bc46-655a-3ab9-8ec5-97ba68e5c584",
                                        "glosses": [
                                            "Of, relating to, or at the age of adolescence; at the stage between being a child and an adult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79d1cd8-1658-49f9-ae9c-b8a9b4ee0e02",
                                                "sense_id": "012d053d-7229-32a8-b9f0-d5f38ada8159",
                                                "text": "Schools, unless discipline were doubly strong, / Detain their adolescent charge too long."
                                            },
                                            {
                                                "example_id": "666a7113-1f90-4a3d-be87-964b74a09cb7",
                                                "sense_id": "012d053d-7229-32a8-b9f0-d5f38ada8159",
                                                "text": "Again, voice change is not easy and vulnerability plays a big part, but if choral teachers and adolescent singers approach it with the right mindframe, the experience can be empowering, enlightening, and restorative for all involved."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adolescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aab9c6c-53ab-3eb2-9af2-ad64d596dcdf",
                                        "entry_id": "dbd7e257-0eeb-3f05-8bf3-50928b4e1cff",
                                        "glosses": [
                                            "A person who is in adolescence; someone who has reached puberty but is not yet an adult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7d37ad-1944-4ff7-ad80-a5f32c2f45be",
                                                "sense_id": "8aab9c6c-53ab-3eb2-9af2-ad64d596dcdf",
                                                "text": "Besides, there are a great many of these accusers, and they have been accusing me now for a great many years; and what is more, they approached you at the most impressionable age, when some of you were children or adolescents; and they literally won their case by default, because there was no one to defend me."
                                            },
                                            {
                                                "example_id": "758ab590-903d-485d-8265-d2cd1292a850",
                                                "sense_id": "8aab9c6c-53ab-3eb2-9af2-ad64d596dcdf",
                                                "text": "‘A healthy adolescent might be expected to produce five hundred billion blood cells a day.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cde8e744-706c-4270-9541-ecabdb00b2cb",
                        "source_entry_id": "6f5d143c-27f5-31c4-b3e7-8c286f0da55a",
