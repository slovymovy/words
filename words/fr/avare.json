                },
                {
                    "sense_id": "5bb49942-860c-3964-a998-1c8e55831160",
                    "sense_definition": "Qui dispense quelque chose avec parcimonie ou retenue, qui n'accorde pas facilement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retenue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur est particulièrement <w>avare</w> de compliments envers ses employés les plus dévoués."
                        },
                        {
                            "text": "Ce chercheur renommé reste toujours très <w>avare</w> de son temps."
                        }
                    ],
                    "synonyms": [
