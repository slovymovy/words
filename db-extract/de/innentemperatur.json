                "senses": [
                    {
                        "sense_id": "27ead285-f91e-3559-8595-0982b9db8e0f",
                        "entry_id": "d7a93b28-89fc-336c-824b-edef19e1573f",
                        "glosses": [
                            "Temperatur innerhalb von etwas (Gebäude, Fahrzeug oder Ähnlichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dafc6b4c-5c70-4e90-88e2-1a62a682653f",
                                "sense_id": "27ead285-f91e-3559-8595-0982b9db8e0f",
                                "text": "„Wer im Winter fröstelt, kann sich darauf freuen, dass die Heizung den Innenraum um 40 Prozent schneller als zuvor aufwärmt und in ungastlichen Gegenden eine um 12 Grad höhere Innentemperatur erreicht.“"
                            },
                            {
                                "example_id": "f2850ed0-0626-4fea-b7b6-695a92bf301f",
                                "sense_id": "27ead285-f91e-3559-8595-0982b9db8e0f",
                                "text": "„Auch die Schräge einer Scheibe und die Größe der Glasfläche sind entscheidend, welche Innentemperaturen erreicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
