                        "target_lang_word": "menschenleer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menschenleer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74d3a897-970f-3d12-bcb6-e0fa84cff3c3",
                                        "entry_id": "99e59762-a6bc-35df-9137-7999737cb038",
                                        "glosses": [
                                            "ohne anwesende Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f3738e-4941-4b8c-a8a1-6e768639e751",
                                                "sense_id": "74d3a897-970f-3d12-bcb6-e0fa84cff3c3",
                                                "text": "Am Sonntag war die Einkaufsstraße menschenleer."
                                            },
                                            {
                                                "example_id": "50555fd7-8418-42f0-9c8e-83efc364b881",
                                                "sense_id": "74d3a897-970f-3d12-bcb6-e0fa84cff3c3",
                                                "text": "„Der Strand war menschenleer und öde.“"
                                            },
                                            {
                                                "example_id": "cc24c2cc-6e90-4b5f-99ce-c75d46bf34b2",
                                                "sense_id": "74d3a897-970f-3d12-bcb6-e0fa84cff3c3",
                                                "text": "„Darum sind die Darstellungen von Entdeckerreisen ins Innere Afrikas und die ihnen folgenden kolonialen Eroberungszüge häufig durch eigentümlich menschenleere Szenarien geprägt.“"
                                            },
                                            {
                                                "example_id": "9387a379-4e8e-46dc-9bbc-87cd0797a657",
                                                "sense_id": "74d3a897-970f-3d12-bcb6-e0fa84cff3c3",
                                                "text": "„Hoch zu Ross verließen sie die schützenden Hänge der Rocky Mountains und drangen in die lebensfeindlichen und fast menschenleeren Great Plains ein.“"
                                            },
                                            {
                                                "example_id": "d2ea5910-94c7-47a2-abb2-2c1ef3e6996f",
                                                "sense_id": "74d3a897-970f-3d12-bcb6-e0fa84cff3c3",
                                                "text": "„Sie stehen beide früh auf, und während Myriam und die Kinder am Pool der Pension bleiben, gehen Paul und Louise hinunter an den noch menschenleeren Strand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
