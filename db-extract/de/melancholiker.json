                                    {
                                        "sense_id": "8013f1e5-bc0c-3aa1-8c30-88d79551da16",
                                        "entry_id": "2b56e615-2522-30e0-91af-503d44d1496c",
                                        "glosses": [
                                            "Filled with or affected by melancholy—great sadness or depression, especially of a thoughtful or introspective nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "436d42eb-e923-4ec1-b81b-d44097625193",
                                                "sense_id": "8013f1e5-bc0c-3aa1-8c30-88d79551da16",
                                                "text": "Just as the melancholic eye / Sees fleets and armies in the sky."
                                            },
                                            {
                                                "example_id": "caf77d12-88bf-4e04-9ab6-bf0be2509762",
                                                "sense_id": "8013f1e5-bc0c-3aa1-8c30-88d79551da16",
                                                "text": "But he was also a natural chronicler: one senses that, even as his schemes collapsed, this aesthetic Arab Quixote knew the stories would make great material for his witty, sharp, melancholic writings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d709af4-216b-34ee-bf8c-e1c5a5dd386f",
                                        "entry_id": "2b56e615-2522-30e0-91af-503d44d1496c",
                                        "glosses": [
                                            "Pertaining to black bile (melancholy)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fdb0d28-0662-364b-8f1c-9da8f4fe384a",
                                        "entry_id": "2b56e615-2522-30e0-91af-503d44d1496c",
                                        "glosses": [
                                            "Pertaining to the melancholic temperament or its associated personality traits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "melancholic",
