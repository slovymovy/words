                ],
                "translations": [
                    {
                        "translation_id": "10ab1719-43a1-47d8-a491-44da0ab35d30",
                        "source_entry_id": "344c2cfa-5779-312f-ac1a-8cd930313058",
                        "source_sense_id": "440f4b3e-7a87-3457-b4e6-a317328e2456",
                        "source_sense_description": "auf das Beste, sehr gut, ausgezeichnet, hervorragend",
                        "target_lang_word": "perfectly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfectly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d019e1d9-3adc-3d0f-97a1-09a105b2e3af",
                                        "entry_id": "4a652602-1ad3-3061-933b-044aebeb7602",
                                        "glosses": [
                                            "With perfection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dd76b2-a54d-448e-9325-b5429e858a7a",
                                                "sense_id": "d019e1d9-3adc-3d0f-97a1-09a105b2e3af",
                                                "text": "They completed the first series perfectly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                        "entry_id": "4a652602-1ad3-3061-933b-044aebeb7602",
                                        "glosses": [
                                            "Wholly, completely, totally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9de5bb-1a63-4a25-849e-3b66518fc08c",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "Their performance was perfectly fine."
                                            },
                                            {
                                                "example_id": "de371d47-7510-4ca2-8c39-522d8dc11d9a",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "The Gentiles would not perfectly relinquish all their Idols; so, they were persuaded to turne the Image of Jupiter with his thunderbolt to Christus crucifixus, and Venus and Cupid to the Madonna and her Babe."
                                            },
                                            {
                                                "example_id": "4838019d-2f4f-49c2-ad61-ae011564f221",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "I was perfectly stunned. I sat and moistened my lips a little, but otherwise made no effort to do anything: my chest was in a pitiful state."
                                            },
                                            {
                                                "example_id": "435b9b1e-af78-427a-91d9-c92262fbc2b0",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "James Milner's angled free-kick was headed on to the post by the tireless [Darren] Bent and [Frank] Lampard the opportunist was perfectly placed to stoop and head in from virtually on the goal-line."
                                            },
                                            {
                                                "example_id": "78d2a611-4fd8-4d42-a8d1-cefc22805a42",
                                                "sense_id": "e8c1b54f-bc99-34bc-89e7-9fef05bd65dd",
                                                "text": "The route taken does not have to be a perfectly straight line, just so long as it is linear and is followed consistently for each transect taken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ce5c56d-2f2c-43f4-ada4-a33394355b8c",
                        "source_entry_id": "344c2cfa-5779-312f-ac1a-8cd930313058",
                        "source_sense_id": "440f4b3e-7a87-3457-b4e6-a317328e2456",
                        "source_sense_description": "auf das Beste, sehr gut, ausgezeichnet, hervorragend",
                        "target_lang_word": "parfaitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parfaitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "D’une manière parfaite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2127149-882c-4598-a3ee-42b83d236f7a",
                                                "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                                "text": "Comme je vous aime parfaitement, je pense être aimé de vous de la même sorte."
                                            },
                                            {
                                                "example_id": "0d30b822-ccc8-4a66-9b8d-1359b4cdaf74",
                                                "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                                "text": "Cette Alerac est aimable de me regretter comme elle fait ; mais ne me souhaitez jamais rien que vous ; vous êtes pour moi toutes choses, et jamais on n’a été aimée si parfaitement d’une fille bien-aimée que je le suis de vous."
                                            },
                                            {
                                                "example_id": "d7ea1760-281b-4125-b620-9aa92bac4438",
                                                "sense_id": "ee38e9d6-a608-38b9-9f79-7371d839fb1d",
                                                "text": "Il ne faut rien exagérer, ni dire des cours le mal qui n’y est point : l’on n’y attente rien de pis contre le vrai mérite que de le laisser quelquefois sans récompense ; on ne l’y méprise pas toujours, quand on a pu une fois le discerner ; on l’oublie, et c’est là où l’on sait parfaitement ne faire rien, ou faire très peu de chose, pour ceux que l’on estime beaucoup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8abb294-ec33-39a4-96a4-d3829441ff34",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "D’une manière exacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e0e5b7-a498-4ec1-891e-c6f3ba094801",
                                                "sense_id": "e8abb294-ec33-39a4-96a4-d3829441ff34",
                                                "text": "Paolo m’attend déjà devant les portes tournantes pour la pause-déjeuner. Il a son regard agacé des jours où je ne suis pas parfaitement à l’heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "D’une manière complète ou totale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19befff1-01ef-46f6-8d62-6e10eb241b85",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "En outre, la conception de l’autodéschisteur doit être telle que le blocage des dispositifs d’évacuation par la matière à éliminer soit impossible. Il doit être parfaitement automatique."
                                            },
                                            {
                                                "example_id": "5f5a81d3-76cc-4767-a8a4-46a59fb8e042",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Depuis des mois on savait parfaitement à Paris que la dénonciation par Hitler des accords de Locarno et la remilitarisation de la Rhénanie pouvaient survenir d'un moment à l'autre."
                                            },
                                            {
                                                "example_id": "5a17ba8e-5209-4634-a8fb-44bd290da883",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Le diaspore, de structure analogue (l'aluminium remplaçant le fer), se présente en cristaux lamellaires parfaitement clivables (parfois taillés pour la bijouterie, malgré leur fragilité) donnant des lamelles flexibles, et en agrégats écailleux."
                                            },
                                            {
                                                "example_id": "6104806c-2c35-4439-a422-8fbb82ad8d7b",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Elle [Mme de Longueval] haïssait bien parfaitement notre Montataire."
                                            },
                                            {
                                                "example_id": "53497684-fb11-4d8c-a20a-3f8f2ea63024",
                                                "sense_id": "2b03803b-b7ac-350e-8fe3-3ba2941ef5b5",
                                                "text": "Aussi impossible, lui répliqua l’autre, que d’être parfaitement habile, parfaitement fort, parfaitement puissant, parfaitement heureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c9dcea-8a4a-3556-99c7-97e9c265a59e",
                                        "entry_id": "ea115cf5-1015-3e69-9e6d-14c29ae60641",
                                        "glosses": [
                                            "Oui."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "note": "Se dit comme réponse affirmative, en insistant sur l’affirmation",
                                        "examples": [
                                            {
                                                "example_id": "10ceb3f0-08d4-432e-8c4d-fa2f9c340338",
                                                "sense_id": "d7c9dcea-8a4a-3556-99c7-97e9c265a59e",
                                                "text": "La proposition vous convient-elle ? — Parfaitement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b171c3be-5fc5-4839-9bfc-8091461a2060",
                        "source_entry_id": "344c2cfa-5779-312f-ac1a-8cd930313058",
                        "source_sense_id": "440f4b3e-7a87-3457-b4e6-a317328e2456",
                        "source_sense_description": "auf das Beste, sehr gut, ausgezeichnet, hervorragend",
                        "target_lang_word": "impeccablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impeccablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                        "entry_id": "4c66a1f3-9272-32a3-8ff6-f21cb7d82fb2",
                                        "glosses": [
                                            "D’une manière impeccable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e574e8f0-3fc9-470b-bcef-859bf55915c2",
                                                "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                                "text": "Elle regardait l’agitation sans broncher, sans que son visage sec et ridé ne trahisse le moindre sentiment : un masque de pâte durcie et craquelée coiffé de cheveux blancs impeccablement tirés sur sa nuque et noués en un petit chignon rachitique."
                                            },
                                            {
                                                "example_id": "7d359ef7-3e74-4289-b2f2-de920851a5d6",
                                                "sense_id": "6a690afb-0a26-38ac-b9b0-b510de21a9ea",
                                                "text": "D'un côté, vous aviez le taulard, vêtu du droguet réglementaire, chaussé de sabots et tondu à ras. De l'autre, le surveillant, impeccablement sanglé dans son uniforme, casquetté de frais, astiqué du ceinturon, agitant des clés nickelées, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
