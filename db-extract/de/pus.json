                "senses": [
                    {
                        "sense_id": "f71e9533-fc02-3517-9539-5e2d2889249b",
                        "entry_id": "0bd904da-3a4c-3122-b7bb-ee2ca929da8d",
                        "glosses": [
                            "viskoses, gelbliches Exsudat von Wirbeltieren zumeist bei Entzündungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdc8d2e-a051-4f7e-af8d-61ee86dc2e38",
                                "sense_id": "f71e9533-fc02-3517-9539-5e2d2889249b",
                                "text": "Eine submuköse entzündliche Flüssigkeitskollektion (Pus) entspricht einem Epiglottisabszess."
                            },
                            {
                                "example_id": "c23e18e9-f600-406d-b0ba-a148542fe6a2",
                                "sense_id": "f71e9533-fc02-3517-9539-5e2d2889249b",
                                "text": "Die alte, vielverlachte Lehre von dem Pus bonum et laudabile entbehrt also keineswegs ganz der Begründung."
                            },
                            {
                                "example_id": "ca989987-73dd-40de-9385-52096de5dc94",
                                "sense_id": "f71e9533-fc02-3517-9539-5e2d2889249b",
                                "text": "„Pus“ ist meist schon am ersten postoperativen Tag an einem Hypopyon oder nach Amotio-Operationen an einer diffusen Infiltration des Glaskörpers zu erkennen (…)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
