                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bacon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0ae7a4c-9bad-3e7c-b6a3-073c60c0bee5",
                                        "entry_id": "4d4f1845-da26-30ca-9483-57cbedaa832b",
                                        "glosses": [
                                            "Cured meat from the sides, belly, or back of a pig."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395c5632-ca2f-4505-83d7-469a78c4b1da",
                                                "sense_id": "c0ae7a4c-9bad-3e7c-b6a3-073c60c0bee5",
                                                "text": "They fried the fish with bacon and were astonished, for no fish had ever seemed so delicious before."
                                            },
                                            {
                                                "example_id": "51d9fc87-1581-4082-aa99-eca469010448",
                                                "sense_id": "c0ae7a4c-9bad-3e7c-b6a3-073c60c0bee5",
                                                "text": "For us the pig's the means, while bacon is the end / Providing gustatory heights to which we can ascend."
                                            },
                                            {
                                                "example_id": "966ec18a-868c-44eb-9e62-b087e263ce63",
                                                "sense_id": "c0ae7a4c-9bad-3e7c-b6a3-073c60c0bee5",
                                                "text": "Bacon is something that everybody is familiar with and most people grew up eating. It has a comfort aspect to it and a familiarity. It's also got an addictive aspect to it - that sweet and salty combination of flavors. And it's probably just a little bit unhealthy for you. When you get to have bacon, it's exciting and something you look forward to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec9cd7e0-2788-3013-8e08-b479d4affe25",
                                        "entry_id": "4d4f1845-da26-30ca-9483-57cbedaa832b",
                                        "glosses": [
                                            "Thin slices of the above in long strips."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03a8dbb2-c8cc-4170-9496-cfb63e79cab8",
                                                "sense_id": "ec9cd7e0-2788-3013-8e08-b479d4affe25",
                                                "text": "As mesmerizing as it is to watch Kristen Kish whip up bacon and cinnamon waffles with boysenberry and strawberry jam, imagine playing poker with Hosea Rosenberg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3270c39b-4a58-3169-8d7b-2fd2160bfc5d",
                                        "entry_id": "4d4f1845-da26-30ca-9483-57cbedaa832b",
                                        "glosses": [
                                            "The police or spies."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f66db11e-b8c4-49e9-9f24-6b59495b87ee",
                                                "sense_id": "3270c39b-4a58-3169-8d7b-2fd2160bfc5d",
                                                "text": "Run! It's the bacon!"
                                            }
                                        ]
                                    },
