                    "sense_definition": "Used to express approval, satisfaction, or delight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That's an amazing idea! <w>Capital</w>!",
                            "target_lang_translations": {
                                "ru": "Это потрясающая идея! <w>Превосходно</w>!",
                                "tr": "Bu harika bir fikir! <w>Şahane</w>!",
                                "zh": "那真是个好主意！<w>太好了</w>！"
                            }
                        },
                        {
                            "text": "He rubbed his hands together and exclaimed, \"<w>Capital</w>!\"",
                            "target_lang_translations": {
                                "ru": "Он потер руки и воскликнул: «<w>Отлично</w>!»",
                                "tr": "Ellerini birbirine sürttü ve \"<w>Harika</w>!\" diye haykırdı.",
                                "zh": "他搓着手惊呼道：“<w>妙极了</w>！”"
                            }
                        }
                    ],
                    "traits": [
