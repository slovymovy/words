                            {
                                "example_id": "31faae78-efb0-43d9-ba8b-6e697aa340ea",
                                "sense_id": "baa9ff4f-2f08-3bd9-a77b-7169438afecf",
                                "text": "In Figure 47, a doodle of a cat has been added to a commissioned mural, and subsequently covered by a poster."
                            },
