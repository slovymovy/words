                    },
                    {
                        "translation_id": "de19b280-9a9c-4efd-87d4-8c273cd81eeb",
                        "source_entry_id": "5db917a9-b810-3683-94f8-3b281d4f352b",
                        "source_sense_id": "50d755b8-0b28-3a44-980d-fd74698cd162",
