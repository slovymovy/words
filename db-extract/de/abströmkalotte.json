                ],
                "senses": [
                    {
                        "sense_id": "43063ef7-6eb0-30d0-b2e3-85c6349c89fb",
                        "entry_id": "72de1a0b-af05-36dd-84e4-0b04c27632a6",
                        "glosses": [
                            "halbrundes bis spitz zulaufendes (die Strömung begünstigendes) Teil, an dem etwas abströmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af9249a-b88d-4532-8f43-c55a2ce0f9f2",
                                "sense_id": "43063ef7-6eb0-30d0-b2e3-85c6349c89fb",
                                "text": "„Der Einsatz von halbkreisförmigen An- bzw. Abströmkalotten bringt eine Verbesserung von ca. 20 %, bei anströmseitigem Einsatz bis zu 40 % bei beidseitigem Einsatz am Schalldämpfer mit sich.“"
                            },
                            {
                                "example_id": "64101a1c-7104-4a85-9bb8-0102f3ae08b2",
                                "sense_id": "43063ef7-6eb0-30d0-b2e3-85c6349c89fb",
                                "text": "„Auf Wunsch können Kulissen mit An- und/oder Abströmkalotten, zusätzlichen Lochblechabdeckungen der Absorberflächen sowie in Aluminium oder Edelstahlblech geliefert werden.“"
                            },
                            {
                                "example_id": "09f89ef7-4bb2-4127-a93c-4e7980d70d78",
                                "sense_id": "43063ef7-6eb0-30d0-b2e3-85c6349c89fb",
                                "text": "„Zur Herabsetzung des Druckverlustes können Kulissen mit An- und Abströmkalotten gefertigt werden.“"
                            },
                            {
                                "example_id": "8a3e0777-9327-4d1e-b26a-74a7059845fa",
                                "sense_id": "43063ef7-6eb0-30d0-b2e3-85c6349c89fb",
                                "text": "„Rohrschalldämpfer RSD-K entspricht der Ausführung des RSD-E, hat jedoch einen zusätzlichen zentrisch eingebauten schallabsorbierenden Kern aus verzinktem Lochblech mit An- und Abströmkalotten.“"
                            },
                            {
                                "example_id": "01cde258-3641-4bd6-b1bc-c0aedff364fc",
                                "sense_id": "43063ef7-6eb0-30d0-b2e3-85c6349c89fb",
                                "text": "„An- und Abströmkalotten sowie Lochblechabdeckung (noch mehr Stabilität für höhere Luftgeschwindigkeit und höhere Temperaturen) können montiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
