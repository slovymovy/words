                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99647789-92b6-4463-87f4-28ea6267c818",
                                "sense_id": "261a02b4-2a02-347f-b8d4-1376afb5379e",
                                "text": "„Es ist die schlimmste Fußball-Tragödie seit dem 16. Oktober 1996, als bei einem WM-Qualifikationsspiel zwischen Guatemala und Costa Rica in Guatemala City bei Krawallen 78 Menschen ums Leben kamen. Inzwischen hat Ägyptens Regierung eine dreitägige Staatstrauer angekündigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
