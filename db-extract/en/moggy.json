                        "cross_references": [
                            {
                                "target_word": "chat de gouttière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e40db5bc-7a0b-3f5c-8b3a-aa5b2332d8f7",
                                        "entry_id": "6c8c89ed-d083-3563-a228-0ef858f4f9c0",
                                        "glosses": [
                                            "Chat de race indéterminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc207501-560f-4c2b-af29-63b7b07b56d6",
                                                "sense_id": "e40db5bc-7a0b-3f5c-8b3a-aa5b2332d8f7",
                                                "text": "[…], cela me serait insupportable, d’autant plus que, la nuit venue, je ne verrai rien, n’étant point nyctalope comme les hiboux, les chouettes, les hulottes et les chats de gouttière."
                                            },
                                            {
                                                "example_id": "25cfc608-f010-4c82-b909-7d12ef8e5169",
                                                "sense_id": "e40db5bc-7a0b-3f5c-8b3a-aa5b2332d8f7",
                                                "text": "Le meilleur préservatif contre les souris est un chat, non pas un chat angora, mais un chat à poil lisse et ras, rayé de gris et de brun, de la race commune appelée chat de gouttière."
                                            },
                                            {
                                                "example_id": "56f46762-a18f-4112-a96b-d35062e32a93",
                                                "sense_id": "e40db5bc-7a0b-3f5c-8b3a-aa5b2332d8f7",
                                                "text": "— Les gens ont déjà abattu animaux domestiques et chats de gouttière, des familles entières errent nuit et jour dans les rues à la recherche d’une grenade rabougrie, d’un reste de pain de Barbari égaré dans un caniveau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "177bc84e-ada1-3781-be16-79e574458feb",
                                        "entry_id": "6c8c89ed-d083-3563-a228-0ef858f4f9c0",
                                        "glosses": [
                                            "Synonyme d’européen (race de chat)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90f71a68-20ff-3cbd-aaa3-ae95b5a45f87",
                                        "entry_id": "6c8c89ed-d083-3563-a228-0ef858f4f9c0",
                                        "glosses": [
                                            "Chat errant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a99fd1a-6219-4a22-8dfe-72128a8b8ac1",
                        "source_entry_id": "b87295db-7e0b-3583-9458-14a5b59ca94a",
