                        "entry_id": "b4e3557f-17b0-357a-bb26-6ef8aae0d512",
                        "glosses": [
                            "Se dit des substances composées du mercure monovalent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e416ef7-d1f5-404d-bede-b890847072b9",
                                "sense_id": "10192e37-7ca4-3613-842e-04326f9563db",
                                "text": "On devrait pouvoir, par simple mise en tension du laiton, lors de lʼimmersion dans la solution mercureuse, provoquer des ruptures analogues à celles quʼon observe sur les tubes écrouis."
                            },
                            {
                                "example_id": "bc078a2d-04b1-42f2-a6f5-8b911db1b9b7",
                                "sense_id": "10192e37-7ca4-3613-842e-04326f9563db",
                                "text": "Dʼune forme extérieure identique à lʼélectrode au calomel, lʼélectrode à sulfate mercureux permet dʼéviter une contamination de lʼélectrolyte par des ions chlorures."
                            }
                        ]
                    }
