                                        "sense_id": "df0e895b-e45f-3365-95ca-59724d7bf2cf",
                                        "entry_id": "4dab03cc-bbcf-305d-9c48-3dc89d7ba382",
                                        "glosses": [
                                            "A triumphant shouting; rejoicing; exultation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b94fa1-d769-42a9-bb2b-b04adb0d526f",
                                                "sense_id": "df0e895b-e45f-3365-95ca-59724d7bf2cf",
                                                "text": "The final whistle triggered scenes of wild jubilation at Eden Park as a nation celebrated a repeat of the outcome from the very first World Cup final in 1987."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78134c60-c232-4091-a969-148d6dc84983",
                        "source_entry_id": "04d70add-6699-3abd-945c-eb1de035c9fa",
                        "source_sense_id": "ddcf40f3-066f-3374-bf94-71f5348a2240",
