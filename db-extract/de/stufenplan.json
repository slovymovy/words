                "senses": [
                    {
                        "sense_id": "5b5a5405-98a9-322b-a3ac-4872246bf590",
                        "entry_id": "0a66a0d0-6167-314e-879c-9f089dca8f47",
                        "glosses": [
                            "Konzept (Plan) der Herangehensweise, das in einzelne, aufeinanderfolgende Schritte untergliedert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab254434-2d97-483f-9002-6faee3c81cb5",
                                "sense_id": "5b5a5405-98a9-322b-a3ac-4872246bf590",
                                "text": "„Abb. 18.1 gibt einen Überblick über den Stufenplan der Therapie des Typ-2-Diabetes (Deutsche Diabetesgesellschaft 2002 [4]).“"
                            },
                            {
                                "example_id": "2eed2c98-e5e1-4e57-954a-40ee4676c408",
                                "sense_id": "5b5a5405-98a9-322b-a3ac-4872246bf590",
                                "text": "„Zusammen mit Fachleuten aus mehreren Ressorts wurde ein Stufenplan erarbeitet: der „Niedersächsische Weg in einen neuen Alltag mit Corona“. Es handelt sich um das bundesweit erste Gesamtkonzept dieser Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
