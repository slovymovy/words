                        "cross_references": [
                            {
                                "target_word": "DGSE",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e9035b6-a61c-3aca-980b-80636bec9ee5",
                                        "entry_id": "b4ee0fe6-4618-3534-9fd7-cabaf3c1e1a7",
                                        "glosses": [
                                            "Service de renseignement extérieur, organisme d’État placé sous l’autorité du ministre de la Défense, et dont les missions étaient remplies jusqu’à 1982 par le Service de documentation extérieure et de contre-espionnage (SDECE)."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabf2091-af95-435b-83c6-aa284a176bb3",
                                                "sense_id": "8e9035b6-a61c-3aca-980b-80636bec9ee5",
                                                "text": "Censée travailler uniquement à l’étranger, la DGSE s’affranchit des textes qui ne s’appliquent que sur le territoire national. Ses agents ne se gênent donc pas pour enregistrer des données émises par des citoyens français quand celles-ci transitent par des serveurs situés à l’autre bout du monde."
                                            },
                                            {
                                                "example_id": "db6ba00a-82a5-414a-9315-5667f9a5beac",
                                                "sense_id": "8e9035b6-a61c-3aca-980b-80636bec9ee5",
                                                "text": "« On est dans un état de droit, il n’existe pas de crime ou de délit d’intention, il n’était guère possible de faire plus », analyse Alain Chouet, ancien chef du service de sécurité de la Direction générale de la sécurité extérieure (DGSE), pour qui surveiller « un loup solitaire » est toujours délicat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
