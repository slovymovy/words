                ],
                "senses": [
                    {
                        "sense_id": "4c673bb5-9899-33cb-b7ee-a526288aea17",
                        "entry_id": "591582fc-dc05-398a-bb14-cd88d454be44",
                        "glosses": [
                            "twee verschillende waarden of mogelijkheden hebbende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "032d9ceb-8cd8-4959-b6ee-51bbffc28777",
                                "sense_id": "4c673bb5-9899-33cb-b7ee-a526288aea17",
                                "text": "Behalve die paar seconden, en nu komen we bij de ambivalentie, voelt Mia vooral weerzin."
                            },
                            {
                                "example_id": "09af2f37-ebf5-47c4-810d-183c175b09a7",
                                "sense_id": "4c673bb5-9899-33cb-b7ee-a526288aea17",
                                "text": "In Representations and Contradictions uit 1997 schrijft hij dat de polariteit binnen een cultuur geen recht doet aan de 'ambivalentie en tegenstelling [die] in het centrum van de communicatieve en cognitieve processen besloten zitten'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad7bf936-1ee3-4348-853b-a6cbf170a8c7",
                        "source_entry_id": "591582fc-dc05-398a-bb14-cd88d454be44",
                        "source_sense_id": "4c673bb5-9899-33cb-b7ee-a526288aea17",
                        "target_lang_word": "Ambivalenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ambivalenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf89c2b4-4372-3b43-a93f-727338242f78",
                                        "entry_id": "4bb056c3-53cc-3047-8a3b-fd6b5d7871ab",
                                        "glosses": [
                                            "Doppeldeutigkeit, Zwiespältigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30370ca7-93cf-4d6c-a18f-c00c6725f27c",
                                                "sense_id": "cf89c2b4-4372-3b43-a93f-727338242f78",
                                                "text": "Sein Verhalten war von einer unerwarteten Ambivalenz geprägt."
                                            },
                                            {
                                                "example_id": "e8342302-4c87-4b35-af96-c1a4236b3ef8",
                                                "sense_id": "cf89c2b4-4372-3b43-a93f-727338242f78",
                                                "text": "„Die Ambivalenz menschlichen Handelns war thematisiert – erst der Verlust des Sohns ließ die Quangels Widerständler werden, in den Jahren davor hatten sie sich dem Nazi-Regime angepasst wie andere auch.“"
                                            },
                                            {
                                                "example_id": "ebc32447-b4e8-4246-80f2-d7deff6f333d",
                                                "sense_id": "cf89c2b4-4372-3b43-a93f-727338242f78",
                                                "text": "„In dieser Ambivalenz unterscheiden sich die Deutschen von ihren meisten Nachbarn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61e99f23-6bbb-3d3e-a5b1-fb0e67e1297d",
                                        "entry_id": "4bb056c3-53cc-3047-8a3b-fd6b5d7871ab",
                                        "glosses": [
                                            "Erleben von Wünschen, Gefühlen, Vorstellungen, die gegensätzlich sind, jedoch nebeneinander bestehen und daher zu inneren Spannungen führen"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be257fa2-b7d6-40fe-af0e-ded56bd68f4f",
                                                "sense_id": "61e99f23-6bbb-3d3e-a5b1-fb0e67e1297d",
                                                "text": "Diese Ambivalenz entsteht, weil eben beide Gefühle zur selben Zeit auftreten, die Liebe und der Hass. Ja, sie liebt diesen Mann und hasst ihn gleichzeitig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79bf2565-e954-4dbf-aaa4-f87fa7c869fd",
                        "source_entry_id": "591582fc-dc05-398a-bb14-cd88d454be44",
                        "source_sense_id": "4c673bb5-9899-33cb-b7ee-a526288aea17",
                        "target_lang_word": "ambivalence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambivalence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07005b19-6904-38c5-8147-019ec1bd1f33",
                                        "entry_id": "3b343b75-2ba1-34fc-8371-560e5b41e870",
                                        "glosses": [
                                            "The coexistence of opposing attitudes or feelings (such as love and hate) towards a person, object or idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3b76fb8-e46a-402a-9bb4-0478def37242",
                                                "sense_id": "07005b19-6904-38c5-8147-019ec1bd1f33",
                                                "text": "\"I dearly loved my master, son,\" she said.\n\"You should have hated him,\" I said.\n\"He gave me several sons,\" she said, \"and because I loved my sons I learned to love their father though I hated him too.\"\n\"I too have become acquainted with ambivalence, I said."
                                            },
                                            {
                                                "example_id": "0588889b-2e17-42f1-bfeb-98a12283be58",
                                                "sense_id": "07005b19-6904-38c5-8147-019ec1bd1f33",
                                                "text": "The great sociologist Zygmunt Bauman argued that philo-Semitism and anti-Semitism both fall under “allosemitism”: literally Othering the Jew. He defined it not as resentment of what is different, which is xenophobia, but rather of what defies order and clear categories. In 1997, he wrote, “The Jew is ambivalence incarnate. And ambivalence is ambivalence mostly because it cannot be contemplated without ambivalent feeling: it is simultaneously attractive and repelling.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30a6e513-2f6f-31a8-9e1b-465e924cde9d",
                                        "entry_id": "3b343b75-2ba1-34fc-8371-560e5b41e870",
                                        "glosses": [
                                            "A state of uncertainty or indecisiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a37488f8-b531-471c-9400-036d35596f63",
                        "source_entry_id": "591582fc-dc05-398a-bb14-cd88d454be44",
                        "source_sense_id": "4c673bb5-9899-33cb-b7ee-a526288aea17",
                        "target_lang_word": "ambivalence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambivalence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca79009b-865e-3b97-ac6c-0572ef7461a4",
                                        "entry_id": "9394f93d-5b29-3396-a57a-87bed6aceacf",
                                        "glosses": [
                                            "Apparition simultanée de deux sentiments opposés : l’amour et la haine, ou encore désirer une chose et son contraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3680079b-fa14-41a1-9f18-94619af8629a",
                                                "sense_id": "ca79009b-865e-3b97-ac6c-0572ef7461a4",
                                                "text": "Là encore, la relation à Shakespeare se joue sur un mode de l’ambivalence en ce qu’elle s’inscrit dans une tension entre une vénération à laquelle l’écrivain américain cherche à imprimer son propre rite ([…]) et une tentative d’inscrire le barde dans un processus historique en faisant référence à la Déclaration d’indépendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e28a265-4ec3-3fa6-bee1-b8742a9de446",
                                        "entry_id": "9394f93d-5b29-3396-a57a-87bed6aceacf",
                                        "glosses": [
                                            "Caractère de ce qui a deux aspects, deux propriétés opposées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "730b7f1f-9b82-452a-9c4c-01c217e2e696",
                                                "sense_id": "6e28a265-4ec3-3fa6-bee1-b8742a9de446",
                                                "text": "L’ambivalence du jugement de Goldsmith, globalement élogieux mais sévère sur un aspect bien spécifique de l’écriture haendélienne, est particulièrement représentative."
                                            },
                                            {
                                                "example_id": "6d182f22-47e6-4e68-ad39-33d74d7d9093",
                                                "sense_id": "6e28a265-4ec3-3fa6-bee1-b8742a9de446",
                                                "text": "L’ambivalence du numérique nécessite de repenser la protection des droits fondamentaux."
                                            },
                                            {
                                                "example_id": "30f6aae9-b1a6-4e26-b01f-b18d715b30f8",
                                                "sense_id": "6e28a265-4ec3-3fa6-bee1-b8742a9de446",
                                                "text": "La conséquence de ce complexe d’ambivalences est une série d’ambiguïtés aux niveaux différents du statut du texte littéraire, du traitement didactique de ce texte, et des fonctions de l'enseignant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
