                                    {
                                        "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                        "entry_id": "38e42d31-3d09-34aa-aab8-b0a590266ff5",
                                        "glosses": [
                                            "To call (someone) using a telephone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377ecea2-32e1-47b1-8fcd-133a9cdd060a",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "Phone me as soon as you land at the airport."
                                            },
                                            {
                                                "example_id": "51471a3c-1670-4233-80ff-420184db114f",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "Her father told her to phone him to pick her up in case it started raining heavily."
                                            },
                                            {
                                                "example_id": "1ed1f5fb-6e8c-49e6-b0a1-5f3d2320eb60",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "It wasn’t like he was dying to get it off his chest. I think he only phoned because he knew how excited I’d be to hear about it."
                                            }
                                        ]
                                    }
