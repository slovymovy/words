                ],
                "senses": [
                    {
                        "sense_id": "e679808b-3418-3986-83c3-11c421a26cda",
                        "entry_id": "e5f4e241-bb0a-3194-8445-048fdccb776d",
                        "glosses": [
                            "Plante possédant des tissus conducteurs différenciés, des vaisseaux (xylème et phloème) assurant la circulation de la sève et possédant des racines vraies (sauf chez les psilophytes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434a8b42-7daa-4f40-b492-f90bff5f31d3",
                                "sense_id": "e679808b-3418-3986-83c3-11c421a26cda",
                                "text": "[La vascularisation] s’est poursuivie avec les Trachéophytes regroupant les lycopodes, les psilotes et les sphaignes puis avec les Ptéridophytes (fougères) puis grandement perfectionnée avec les plantes vasculaires supérieures les Gymnospermes qui sont des plantes à graines à ovules nus et les Angiospermes ou plantes à fleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "532a64dc-2a52-4fc5-ac6e-d8218f81b9bc",
                        "source_entry_id": "e5f4e241-bb0a-3194-8445-048fdccb776d",
                        "source_sense_id": "e679808b-3418-3986-83c3-11c421a26cda",
                        "target_lang_word": "tracheophyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tracheophyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f62aff0-a336-3c37-ba37-d3cbef2907a4",
                                        "entry_id": "d763e78d-6fdc-30d9-b187-74b008b27488",
                                        "glosses": [
                                            "Any plant possessing vascular tissue (xylem and phloem), including ferns, conifers, and flowering plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc0232b3-829d-46ec-8dee-0adac93c8f3f",
                                                "sense_id": "5f62aff0-a336-3c37-ba37-d3cbef2907a4",
                                                "text": "By virtue of the presence and absence of vascular tissues, the tracheophytes and the bryophytes were also considered two distinctly different levels of anatomical organization. Largely for these reasons, the bryophytes and the tracheophytes are traditionally viewed as two distinct lineages, though they trace their evolutionary history back to a common ancestor."
                                            },
                                            {
                                                "example_id": "02477c6a-d43d-4742-b90a-e7a9b4de9ecd",
                                                "sense_id": "5f62aff0-a336-3c37-ba37-d3cbef2907a4",
                                                "text": "The tracheophytes (vascular land plants) have a fossil record beginning in the Wenlock (Edwards et al. 1983)."
                                            },
                                            {
                                                "example_id": "5af35ed5-0c97-4e13-b8fb-a5726982988e",
                                                "sense_id": "5f62aff0-a336-3c37-ba37-d3cbef2907a4",
                                                "text": "There is a clear relationship between tracheophytes and trilete spores, but not with cryptospores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
