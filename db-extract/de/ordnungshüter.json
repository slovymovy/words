                "senses": [
                    {
                        "sense_id": "1e9e6efb-97ed-3172-b6de-9ba5515d4345",
                        "entry_id": "de996744-1dd6-3049-bb0a-ea554329f6a3",
                        "glosses": [
                            "jemand, der in einem bestimmten Bereich für Ordnung sorgen soll; scherzhaft vor allem für Polizist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54879c35-c54a-4d82-8bc9-806da8ee59a3",
                                "sense_id": "1e9e6efb-97ed-3172-b6de-9ba5515d4345",
                                "text": "„Der Wächter des Platzes wechselte häufig, weil kein halbwegs normaler Ordnungshüter dieses Zentrum einer entfesselten Jugend länger als höchstens ein Vierteljahr ertragen konnte.“"
                            },
                            {
                                "example_id": "bef37a31-e4f5-4235-82f5-fef3c2201490",
                                "sense_id": "1e9e6efb-97ed-3172-b6de-9ba5515d4345",
                                "text": "„Südafrika wird zu einem Polizeistaat, in dem Ordnungshüter willkürliche Verhaftungen vornehmen, Generäle und Geheimdienst immer mehr Einfluss gewinnen.“"
                            },
                            {
                                "example_id": "997f1a8d-b008-4f3c-8675-7dde4196fbb0",
                                "sense_id": "1e9e6efb-97ed-3172-b6de-9ba5515d4345",
                                "text": "„Zivile Ordnungshüter kontrollieren die Seitenstreifen mit den Würstchen- und Bierbuden.“"
                            },
                            {
                                "example_id": "063fd3d8-e270-4bd2-871e-9fc0918bdad7",
                                "sense_id": "1e9e6efb-97ed-3172-b6de-9ba5515d4345",
                                "text": "„Sicher wird der Zauber der Romantik bald auch in den Uniformen unserer Ordnungshüter Ausdruck finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
