                                "example_id": "8c6e1565-505d-475f-a401-0bc1c08df443",
                                "sense_id": "30e74f89-2608-396b-9685-c87d4eb0949d",
                                "text": "Zijn adeldom werd erkend door de koning.",
                                "translation": "His nobility was recognized by the king.",
                                "english": "His nobility was recognized by the king."
                            },
                            {
                                "example_id": "919989a0-340a-4c26-9f40-ded392935352",
                                "sense_id": "30e74f89-2608-396b-9685-c87d4eb0949d",
                                "text": "De adeldom bracht zowel privileges als verantwoordelijkheden met zich mee.",
                                "translation": "The nobility came with both privileges and responsibilities.",
                                "english": "The nobility came with both privileges and responsibilities."
                            },
                            {
                                "example_id": "2b162e3c-6e6e-4e67-ae2d-e635bd6bcb57",
                                "sense_id": "30e74f89-2608-396b-9685-c87d4eb0949d",
                                "text": "Velen streven naar adeldom en de eer die het met zich meebrengt.",
                                "translation": "Many aspire to nobility and the honor it carries.",
                                "english": "Many aspire to nobility and the honor it carries."
                            }
                        ]
                    }
