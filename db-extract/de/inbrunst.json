                                    },
                                    {
                                        "sense_id": "e6178dd4-cdb3-3592-861f-ee3dbd0bb444",
                                        "entry_id": "ea164d3d-4054-3428-91b8-de2f38a58525",
                                        "glosses": [
                                            "Celo ardiente y afectuoso hacia las cosas de piedad y religión."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c4423a6-9cb4-44b0-acac-e9ef36612249",
                                                "sense_id": "e6178dd4-cdb3-3592-861f-ee3dbd0bb444",
                                                "text": "«Con esto no digo que estés haciendo algo malo, pero tampoco quiero mentirte: ese fervor por seguir a la iglesia y sus enseñanzas todavía no fluye de mi espíritu»."
                                            }
                                        ],
