                ],
                "translations": [
                    {
                        "translation_id": "16fd6383-15f7-4e22-841e-e647d358eef0",
                        "source_entry_id": "d307bac9-b647-3354-967c-bbef34ac1f9d",
                        "source_sense_id": "aa686e87-1abc-337f-a2f2-1d31d24a4577",
                        "target_lang_word": "convention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82afcdb9-1e23-31ad-a411-798d28c3d652",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A meeting or gathering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d244f79a-f081-47f2-8013-7b7be8e9085a",
                                                "sense_id": "82afcdb9-1e23-31ad-a411-798d28c3d652",
                                                "text": "The convention was held in Geneva."
                                            },
                                            {
                                                "example_id": "6c34f806-827a-416c-a28e-66d8f8ecb405",
                                                "sense_id": "82afcdb9-1e23-31ad-a411-798d28c3d652",
                                                "text": "The CEF and the legal advocacy groups that have been responsible for its tremendous success over the past ten years are determined to \"Knock down all doors, all the barriers, to all 65,000 public elementary schools in America and take the Gospel to this open mission field now! Not later, now!\" in the words of a keynote speaker at the CEF's national convention in 2010."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2969ed54-185b-3167-9080-431696635162",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A formal deliberative assembly of mandated delegates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dbdee1e-6526-4b32-bd84-67ad79f26a1c",
                                                "sense_id": "2969ed54-185b-3167-9080-431696635162",
                                                "text": "The EU installed an inter-institutional Convention to draft a European constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683787d3-702c-39b1-8f65-9cbae5d8818c",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "The convening of a formal meeting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f71d6cc-cabd-37fe-823d-288e81c3fcc9",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A formal agreement, contract, rule, or pact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe5fda17-5dfe-3977-9712-8a179c01d019",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A treaty or supplement to such."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada51223-45a5-4b65-b2a4-38c46e30b029",
                                                "sense_id": "fe5fda17-5dfe-3977-9712-8a179c01d019",
                                                "text": "The Vienna convention at the Vienna Congress (1814-15) standardized most of diplomatic conduct for generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                        "entry_id": "f1e6f476-1939-3e95-8f05-24bdec07646a",
                                        "glosses": [
                                            "A practice or procedure widely observed in a group, especially to facilitate social interaction; a custom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1415d901-c56f-4058-bb8b-dffdc99b91d4",
                                                "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                                "text": "Table seatings are generally determined by tacit convention, not binding formal protocol."
                                            },
                                            {
                                                "example_id": "e835b568-7b6f-4a12-8a9e-de5949f9bb77",
                                                "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                                "text": "The convention of driving on the right is reinforced by law."
                                            },
                                            {
                                                "example_id": "fe3f56b1-60c8-4719-9465-f1615e3f2bf1",
                                                "sense_id": "496b17ef-8560-34b6-a0f7-f059180afb89",
                                                "text": "In order to account for this, we might propose to make the Prepositional Phrase an optional constituent of the Verb Phrase: this we could do by re-\n placing rule (28) (ii) by rule (40) below:\n(40) VP → V AP (PP)\n(Note that a constituent in parentheses is, by convention, taken to be\n optional.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50943039-3cbd-46a8-9003-a0a8dfe9db7c",
                        "source_entry_id": "d307bac9-b647-3354-967c-bbef34ac1f9d",
                        "source_sense_id": "aa686e87-1abc-337f-a2f2-1d31d24a4577",
                        "target_lang_word": "convenance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convenance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c0a189e-1669-38b5-8275-6e7802a0250f",
                                        "entry_id": "19c5e9d7-267d-3531-992f-4ea00bd4cbb1",
                                        "glosses": [
                                            "Conformité, accord d’une chose avec une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce08d2a8-226c-40b8-9a45-893ee4325182",
                                                "sense_id": "7c0a189e-1669-38b5-8275-6e7802a0250f",
                                                "text": "Ces choses-là n’ont point de convenance l’une avec l’autre, entre elles."
                                            },
                                            {
                                                "example_id": "240c6fd2-12c8-411b-9873-94191971bced",
                                                "sense_id": "7c0a189e-1669-38b5-8275-6e7802a0250f",
                                                "text": "Il y a entre ces deux fiancés une parfaite convenance de fortune, de condition."
                                            },
                                            {
                                                "example_id": "842d52af-8079-4748-bbc4-6eb795f2911e",
                                                "sense_id": "7c0a189e-1669-38b5-8275-6e7802a0250f",
                                                "text": "Il y a convenance d’humeur, de caractère, de goût entre ces deux amis."
                                            },
                                            {
                                                "example_id": "77eb4b1a-059f-4190-8b3e-92dc5de2ed61",
                                                "sense_id": "7c0a189e-1669-38b5-8275-6e7802a0250f",
                                                "text": "Quand la directrice siège dans le préau et qu’il ne s’agit pas de faits très graves, les parents conversent avec elle, sur place, au-dessus de la barrière, au lieu d’aller dans son cabinet. Si je me trouve occupée à attifer des enfants, je ne me dérange pas ; car, — par l’excès même de mon anxiété observatrice, — j’ai pris un visage mort, un air de stupidité laborieuse, tout à fait en convenance avec ma fonction, — aussi puis-je, sans indiscrétion, rester près de la directrice : « Je n’existe pas »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e311520-422f-3bc3-8ef0-97ad60777b5b",
                                        "entry_id": "19c5e9d7-267d-3531-992f-4ea00bd4cbb1",
                                        "glosses": [
                                            "Commodité ; utilité particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "789f5392-d9b2-4bed-b8e7-82cee9eaabf2",
                                                "sense_id": "8e311520-422f-3bc3-8ef0-97ad60777b5b",
                                                "text": "On sentait qu’il ne demandait rien à personne, qu’il travaillait à sa convenance, et que, dans ce monde, sa philosophie ne pouvait être ni étonnée ni troublée."
                                            },
                                            {
                                                "example_id": "9d06db07-8cda-4344-ae5c-b6dacb6ef553",
                                                "sense_id": "8e311520-422f-3bc3-8ef0-97ad60777b5b",
                                                "text": "Mais il y a folkloristes et folkloristes. J'en ai vu de singuliers, quelques-uns d’effarants. On se fait un folklore à sa convenance. On attend des fées. On part à leur rencontre, le bâton de pèlerin à la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                        "entry_id": "19c5e9d7-267d-3531-992f-4ea00bd4cbb1",
                                        "glosses": [
                                            "Ce qui est conforme aux règles, aux usages de la société."
                                        ],
                                        "tags": [
                                            "especially",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70a7d40d-4fc5-4b3c-89f9-e2d812beb0eb",
                                                "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                                "text": "Il alla remercier le lieutenant-colonel Filloteau et s’informer des petits devoirs de convenance qui doivent occuper la première journée d’un sous-lieutenant arrivant au régiment."
                                            },
                                            {
                                                "example_id": "d46017c6-d0bd-43c4-8735-7f78bb1593e9",
                                                "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                                "text": "Croyez-moi, pour une fille, comme pour une femme, la gloire sera toujours d’enfermer dans la sphère des convenances les plus serrées, ses ardents caprices."
                                            },
                                            {
                                                "example_id": "ff3ab9e6-e3e1-4730-8097-5fdf9d6c9469",
                                                "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                                "text": "— M. de Sainte-Austreberthe est ici pour me plaire, dit-elle ; il ne me plaît point, je le lui montre.\n— Encore faut-il le faire avec convenance.\n— En quoi ai-je manqué aux convenances ?"
                                            },
                                            {
                                                "example_id": "1d13dcfc-2c54-48c2-8846-78e4abbfafd4",
                                                "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                                "text": "J’ai, comme tous les honnêtes gens, transgressé quelques-unes des lois humaines ; et je n’en ai point de repentir. Mais certaines actions de ma vie, qui se sont trouvées contraires à ces délicatesses imperceptibles et supérieures, qu’on nomme les convenances, m’ont laissé des regrets cuisants et une sorte de remords."
                                            },
                                            {
                                                "example_id": "018dbb69-1172-4a85-b26a-97a09393b61c",
                                                "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                                "text": "Ce fut la veuve qui nous tira d’embarras ; elle parlait d’une voix vive, légère, qui baissait parfois par décence, puis, les convenances satisfaites, reprenait avec un nouvel entrain."
                                            },
                                            {
                                                "example_id": "6e1e8726-e1e1-42d1-82e8-4d8394a23805",
                                                "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                                "text": "Mais le maître des Hautes Héez dédaigne toute convenance. Qu'il garde sa barbe toute entière, mais qu'il la cultive. Elle lui donne l'air d'un Robinson, d'un homme des cavernes, voire d'un hors-la-loi:"
                                            },
                                            {
                                                "example_id": "0072af7e-18e1-4e0d-be06-7ec0aed36b3f",
                                                "sense_id": "0f3408da-d0a6-3c2e-beb3-ccf65523a12f",
                                                "text": "De même que les enfants flairent sous l’écorce des convenances la vraie étoffe dont sont faits les êtres, mon radar interne, s’affolant subitement, m’apprenait que M. Ozu me considérait avec une patiente attention."
