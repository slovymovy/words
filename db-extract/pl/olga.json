                        ]
                    },
                    {
                        "translation_id": "63737b81-ec5f-4ea9-b046-cd840f561dec",
                        "source_entry_id": "72ce86b6-4f5f-38cf-a3b6-8a4412bb895a",
                        "source_sense_id": "ea1698c1-a348-3576-aa17-d353bbc0d663",
                        "target_lang_word": "Olga",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olga",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b825fd2-aace-3d9c-8d5b-6678e690c568",
                                        "entry_id": "e6981158-fc1a-3489-b1a6-9ea35073cb6d",
                                        "glosses": [
                                            "Prénom féminin slave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1446c470-70d6-4f5e-879c-05af63af374c",
                                                "sense_id": "7b825fd2-aace-3d9c-8d5b-6678e690c568",
                                                "text": "Un soir, j’aperçus, dans un coin du Stryx, Riquet, Riaucourt et son amie Olga que je trouvai très élégante."
                                            },
                                            {
                                                "example_id": "e6e1cb71-30db-4a6f-951d-4810b79edde8",
                                                "sense_id": "7b825fd2-aace-3d9c-8d5b-6678e690c568",
                                                "text": "Notre Grec, d'après ce que tu me dis, paraît être à voile et à vapeur, car il n'empêche pas qu'il est l’amant en titre de la belle Olga !…"
                                            },
                                            {
                                                "example_id": "c954ab0f-d5b2-46fc-985e-b68227571af3",
                                                "sense_id": "7b825fd2-aace-3d9c-8d5b-6678e690c568",
                                                "text": "Un concert unique en son genre, intitulé « Voix d’or slaves », où Olga Stolyarova, Valéry Orlov et Nikolay Sherstyakov emmènent leur public dans un voyage musical inoubliable."
                                            },
                                            {
                                                "example_id": "38541c39-abdb-4afa-a3aa-426cf3abce10",
                                                "sense_id": "7b825fd2-aace-3d9c-8d5b-6678e690c568",
                                                "text": "Datée de 1915, cette photo d’archives montre le dernier tsar de Russie, Nicolas II (à gauche), son épouse, la tsarine Alexandra Feodorovna (2ᵉ à partir de la droite), le prince Alexis et les princesses Olga, Tatyana, Maria et Anastasia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
