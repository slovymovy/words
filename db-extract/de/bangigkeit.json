                ],
                "senses": [
                    {
                        "sense_id": "48ea3eba-713c-3f73-88f6-94eb8edb1774",
                        "entry_id": "10967173-3295-389f-a0a3-1040c7c19b64",
                        "glosses": [
                            "Zustand einer Person, ängstlich/beunruhigt/sorgenvoll zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56dd81b3-c0d6-41ba-93d5-2cf37b38e5bc",
                                "sense_id": "48ea3eba-713c-3f73-88f6-94eb8edb1774",
                                "text": "„Bangigkeit ist keine gute Grundlage für Sicherheit.“"
                            },
                            {
                                "example_id": "5ca43727-a78f-4bf0-abb1-41fa4e3587e3",
                                "sense_id": "48ea3eba-713c-3f73-88f6-94eb8edb1774",
                                "text": "„Alles Zureden Landolts und seiner Eltern half nichts; diejenigen des verzweifelten Fräuleins aber schienen eher ihre Bangigkeiten zu teilen und beschleunigten sorglich den Rückzug.“"
                            },
                            {
                                "example_id": "c1ff5abe-293c-4b2b-9b8b-4cf03b181c65",
                                "sense_id": "48ea3eba-713c-3f73-88f6-94eb8edb1774",
                                "text": "„Rostow trabte an, um alle diese leidenden Menschen nicht länger sehen zu müssen, und eine plötzliche Bangigkeit überkam ihn.“"
                            },
                            {
                                "example_id": "ecd4d42a-b707-4ca2-87fc-d7000f092c47",
                                "sense_id": "48ea3eba-713c-3f73-88f6-94eb8edb1774",
                                "text": "„Die Menge hörte finster und schweigend in ängstlicher Bangigkeit zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
