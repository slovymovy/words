                                        "glosses": [
                                            "гастрон. икра лососёвых видов рыб, употребляемая в пищу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845f0cf5-efb2-4929-a6a8-0f7f5fa033a7",
                                                "sense_id": "f0ab4590-657b-3bd3-aa91-9d3510026ed5",
                                                "text": "За обедом были блины с красной икрой."
                                            },
                                            {
                                                "example_id": "52465b02-1b1b-4408-9910-4c5ce320692b",
                                                "sense_id": "f0ab4590-657b-3bd3-aa91-9d3510026ed5",
                                                "text": "Сейчас на Дальнем Востоке путина — заготавливается красная икра."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
