                    {
                        "form_id": "fce45d3b-bdfa-471d-8ad2-43d2991ac97a",
                        "entry_id": "a518e8b9-54e3-3393-9e64-1e1d7569d3ac",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Publicity"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bb3a437-2d3c-3b5a-a906-433a2ec1307b",
                        "entry_id": "a518e8b9-54e3-3393-9e64-1e1d7569d3ac",
                        "glosses": [
                            "durch mediale Berichterstattung verursachtes Bekanntwerden einer Thematik oder Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4911195-8041-4475-ad04-170c8b2a9e27",
                                "sense_id": "5bb3a437-2d3c-3b5a-a906-433a2ec1307b",
                                "text": "„Hätte er sich als widerborstiges Individuum entpuppt und Einwände erhoben, hätten wir mit einer Menge unliebsamer Publicity rechnen dürfen.“"
                            },
                            {
                                "example_id": "4fb969f2-9c2f-4e9b-80a5-db49a72ffc44",
                                "sense_id": "5bb3a437-2d3c-3b5a-a906-433a2ec1307b",
                                "text": "„Shaw musste Avon zugutehalten, dass die ersten Worte aus dessen Mund nicht die Befürchtung äußerten, der Vorfall könne noch mehr schlechte Publicity für ihn und sein Spiel bedeuten.“"
                            },
                            {
                                "example_id": "4a5a56fe-5fb4-4800-9597-6c629eab5753",
                                "sense_id": "5bb3a437-2d3c-3b5a-a906-433a2ec1307b",
                                "text": "„Zwar gab es einige Spekulationen, aber schon bald fand sich eine Erklärung für das rätselhafte Verschwinden. Man ging davon aus, Undercliffe sei lediglich ›verschwunden‹, um Publicity zu erlangen.“"
                            },
                            {
                                "example_id": "b049f74f-325f-4af3-ad98-2b0ab83c30d9",
                                "sense_id": "5bb3a437-2d3c-3b5a-a906-433a2ec1307b",
                                "text": "„Sosehr mir unser Plan auch auf der Seele lag, stellte er doch unsere beste Chance dar, und ich versuchte, Mr. Smith zu versichern, dass Sharis Mörder ein Feigling war und sich wegen der Publicity und der intensiven Ermittlungen nicht an Dawn heranmachen würde.“"
                            },
                            {
                                "example_id": "8c952e79-b6b1-402f-8c2d-df0135e0d83e",
                                "sense_id": "5bb3a437-2d3c-3b5a-a906-433a2ec1307b",
                                "text": "„›Gerichtsverfahren sind teuer. Ich könnte verlieren. Das ist mir klar. Aber die werden eine Menge schlechte Publicity und öffentliche Verachtung ertragen müssen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b9297633-1218-30a0-964a-741434cf4ffe",
