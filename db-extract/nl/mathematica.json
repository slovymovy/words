                    }
                ],
                "translations": [
                    {
                        "translation_id": "1da4f9ef-7c66-4c53-80f2-0a9369d046bc",
                        "source_entry_id": "aa210332-3f48-3492-90b7-172c58ab89bc",
                        "source_sense_id": "622576ff-a0e8-30bd-8558-0e57eeac7dee",
                        "source_sense_description": "Mathematik",
                        "target_lang_word": "Mathematik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mathematik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3c4b65-6f40-3c6f-bfa9-18f92d0cb393",
                                        "entry_id": "aeb2ab7f-8439-396b-92a3-e8a0301b37c2",
                                        "glosses": [
                                            "Wissenschaft, die selbstgeschaffene abstrakte Strukturen auf ihre Eigenschaften und Muster untersucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f7f38a-cccc-4a57-bffb-e81c22b83570",
                                                "sense_id": "3b3c4b65-6f40-3c6f-bfa9-18f92d0cb393",
                                                "text": "Wichtige Teilgebiete der Mathematik sind die Geometrie, die Arithmetik, die Algebra und die Stochastik."
                                            },
                                            {
                                                "example_id": "89fbd279-3e12-45f1-9583-3e3b71ff701d",
                                                "sense_id": "3b3c4b65-6f40-3c6f-bfa9-18f92d0cb393",
                                                "text": "„Sein Großvater, der kaum eine Schule besucht hatte, liebte es seit jeher, sich mit Naturwissenschaft und Mathematik zu beschäftigen, und machte beides für Eiríkur zu einem Spiel.“"
                                            },
                                            {
                                                "example_id": "2d735363-c386-4846-8486-7a5e62b820f8",
                                                "sense_id": "3b3c4b65-6f40-3c6f-bfa9-18f92d0cb393",
                                                "text": "„Mein Bruder ist ein Rechengenie, er hat später sogar Mathematik studiert – darum war ich in Mathe immer schlecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ab72d39-0815-3b5c-87b9-20cd7b57a34b",
                                        "entry_id": "aeb2ab7f-8439-396b-92a3-e8a0301b37c2",
                                        "glosses": [
                                            "Studien- oder Schulfach, in dem diese Wissenschaft gelehrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c560baf-1c09-481e-b1d7-abf8079511c2",
                                                "sense_id": "6ab72d39-0815-3b5c-87b9-20cd7b57a34b",
                                                "text": "„Mein Bruder ist ein Rechengenie, er hat später sogar Mathematik studiert – darum war ich in Mathe immer schlecht.“"
                                            },
                                            {
                                                "example_id": "497eba57-cb41-4ccb-a24f-12eeb3353eaa",
                                                "sense_id": "6ab72d39-0815-3b5c-87b9-20cd7b57a34b",
                                                "text": "„Es ist nicht Aufgabe einer Lehrkraft im Fach Mathematik, den Schüler/innen ungenügende Deutschkenntnisse vorzuwerfen, und zwar insbesondere dann nicht, wenn ein/e Schüler/in eine Frage zum Fach stellt, vielmehr hat sie diese Frage nach bestmöglichem Wissen zu beantworten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f42181c6-9cba-4ea4-9cc3-f86edd0a0f87",
                        "source_entry_id": "aa210332-3f48-3492-90b7-172c58ab89bc",
                        "source_sense_id": "622576ff-a0e8-30bd-8558-0e57eeac7dee",
                        "source_sense_description": "Mathematik",
                        "target_lang_word": "mathematics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mathematics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5a22d2f-5583-3211-9f65-008c0b1e6424",
                                        "entry_id": "d4e2007f-916b-3edd-ad15-1a88f20460b7",
                                        "glosses": [
                                            "An abstract representational system studying numbers, shapes, structures, quantitative change and relationships between them."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377c682f-9bab-49e6-a4d3-2412e54cb121",
                                                "sense_id": "f5a22d2f-5583-3211-9f65-008c0b1e6424",
                                                "text": "Next to Mathematics, the study of natural philosophy tends to have anti-aphrodisiac effects."
                                            },
                                            {
                                                "example_id": "7b17e91b-c952-432b-a536-2e08175ee3ac",
                                                "sense_id": "f5a22d2f-5583-3211-9f65-008c0b1e6424",
                                                "text": "Looking at the Leibniz series, you feel the independence of mathematics from human culture. Surely, on any world that knows pi the Leibniz series will also be known... Nilakantha, an astronomer, grammarian, and mathematician who lived on the Kerala coast of India, described the formula in Sanskrit poetry around the year 1500."
                                            },
                                            {
                                                "example_id": "a782eb0e-7ec4-43b2-8f69-c2b09acf3e17",
                                                "sense_id": "f5a22d2f-5583-3211-9f65-008c0b1e6424",
                                                "text": "The answer is 'yes', and the mathematics needed is the theory of probability and its applied cousin, statistics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "449a8594-3e10-3ee2-93c5-f5cb32f16c58",
                                        "entry_id": "d4e2007f-916b-3edd-ad15-1a88f20460b7",
                                        "glosses": [
                                            "A person's ability to count, calculate, and use different systems of mathematics at differing levels."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cbdb9e3-41c2-41fc-980e-514b2cefe4dd",
                                                "sense_id": "449a8594-3e10-3ee2-93c5-f5cb32f16c58",
                                                "text": "My mathematics is always improving."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c073454-1fcd-42f1-a54d-203a57ceec4a",
                        "source_entry_id": "aa210332-3f48-3492-90b7-172c58ab89bc",
                        "source_sense_id": "622576ff-a0e8-30bd-8558-0e57eeac7dee",
                        "source_sense_description": "Mathematik",
                        "target_lang_word": "mathématiques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mathématiques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80f77273-8470-35d3-a3d4-9e4a4b07e7c5",
                                        "entry_id": "f974044b-2867-303a-8ee9-e821e97619f8",
                                        "glosses": [
                                            "Science du raisonnement déductif et de l’étude de concepts abstraits (comme les nombres ou les figures géométriques), à travers des structures et des modèles."
                                        ],
                                        "tags": [],
                                        "note": "on trouve aussi le mot au singulier dans ce sens → voir mathématique",
                                        "examples": [
                                            {
                                                "example_id": "2511f2a7-c6b8-4c7c-88bf-daa320696c3d",
                                                "sense_id": "80f77273-8470-35d3-a3d4-9e4a4b07e7c5",
                                                "text": "En effet le mot mathématiques ne signifiant que science, celles que j’ai nommées ont autant de droit que la géométrie à être appelées mathématiques ; et cependant il n’est personne qui, pour peu qu’il soit entré dans une école, ne puisse distinguer sur-le-champ ce qui se rattache aux mathématiques proprement dites, d’avec ce qui appartient aux autres sciences."
                                            },
                                            {
                                                "example_id": "cedc3c25-c996-4ae3-88fc-59e4e2b2647a",
                                                "sense_id": "80f77273-8470-35d3-a3d4-9e4a4b07e7c5",
                                                "text": "Très souvent, en économie, les mathématiques ne sont rien de plus qu'une sophistication inutile (que Keynes avait su dénoncer - il parlait à leur propos de niaiseries formalisées), du merdouillage. Ici, je crois qu'il faut être absolument net. Mathématiser l'économie, ça n'a rien à voir avec forger un concept économique qui aurait sa valeur propre."
                                            },
                                            {
                                                "example_id": "51c6be13-9d82-4e96-9bf3-6d517350d522",
                                                "sense_id": "80f77273-8470-35d3-a3d4-9e4a4b07e7c5",
                                                "text": "Passionné de mathématiques dès mon plus jeune âge, j'ai toujours voulu comprendre le pourquoi et le comment du monde qui nous entoure."
                                            },
                                            {
                                                "example_id": "21be15c6-6226-4b68-8ea1-ee0fd7a4e8a3",
                                                "sense_id": "80f77273-8470-35d3-a3d4-9e4a4b07e7c5",
                                                "text": "La géométrie, l’algèbre, etc., appartiennent aux mathématiques pures ; l’astronomie, la mécanique font partie des mathématiques appliquées."
                                            },
                                            {
                                                "example_id": "bafe3557-e631-4703-a838-40ba63c5f92b",
                                                "sense_id": "80f77273-8470-35d3-a3d4-9e4a4b07e7c5",
                                                "text": "On trouve souvent dans le même texte un mélange d’écriture idéographique sumérienne et d’écriture phonétique akkadienne, dans une proportion variable selon le genre et le lieu : la majorité des textes de problème sont rédigés en akkadien, avec un usage plus ou moins abondant d’idéogrammes sumériens pour désigner des objets mathématiques (longueur, surface, multiplication arithmétique…). Certains textes du sud sont rédigés complètement en sumérien ; certains textes du nord sont rédigés complètement en akkadien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63755992-61da-33e7-8f1a-b646d53d21dc",
                                        "entry_id": "f974044b-2867-303a-8ee9-e821e97619f8",
                                        "glosses": [
                                            "Dans les établissements d’instruction publique, les cours qui traitent de cette matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d80712b-b9fe-4cf4-9213-d2835d27930a",
                                                "sense_id": "63755992-61da-33e7-8f1a-b646d53d21dc",
                                                "text": "Cours de mathématiques."
                                            },
                                            {
                                                "example_id": "f7b3c1c0-bd4f-43a9-884f-f2759f83bc98",
                                                "sense_id": "63755992-61da-33e7-8f1a-b646d53d21dc",
                                                "text": "Les mathématiques élémentaires"
                                            },
                                            {
                                                "example_id": "c2cd8cc0-a6de-47f3-85c7-044fbee6abf3",
                                                "sense_id": "63755992-61da-33e7-8f1a-b646d53d21dc",
                                                "text": "Les mathématiques spéciales, servant à la préparation des grandes écoles."
                                            },
                                            {
                                                "example_id": "a7238f17-cce9-4f8f-971a-842b7759c5b9",
                                                "sense_id": "63755992-61da-33e7-8f1a-b646d53d21dc",
                                                "text": "J'ai connu un grand professeur de mathématiques qui est mort à la suite d'une petite opération. On finit toujours par être rattrapé par son destin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mathématiques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad8246f9-987f-3c2f-baaa-cfd6a6626be6",
                                        "entry_id": "ea50c667-f625-31d9-b00c-5eacd4abbc4d",
                                        "glosses": [
                                            "Pluriel de mathématique."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd7f8a55-cdd8-4a21-ac2a-962b95d2895f",
                                                "sense_id": "ad8246f9-987f-3c2f-baaa-cfd6a6626be6",
                                                "text": "Des écritures mathématiques se font axiomatiser, c’est-à-dire re-stratifier, re-sémiotiser ; des flux matériels se font rephysicaliser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
