                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ticket",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa7b639e-8cef-37f7-9be7-0910a0409055",
                                        "entry_id": "a0abcc4d-5925-3605-9077-eb367c67ecdf",
                                        "glosses": [
                                            "Flugkarte, Fahrschein, Eintrittskarte und Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643c7587-053d-4ab9-98dd-ad3c36becb8e",
                                                "sense_id": "aa7b639e-8cef-37f7-9be7-0910a0409055",
                                                "text": "Was haben die Tickets für das Konzert gekostet?"
                                            },
                                            {
                                                "example_id": "d99e2983-5de7-438e-a1e3-e985cec9ff93",
                                                "sense_id": "aa7b639e-8cef-37f7-9be7-0910a0409055",
                                                "text": "Hier kann man das Ticket entwerten."
                                            },
                                            {
                                                "example_id": "23f01013-3b20-4e7a-89dc-9d3a54a3f5e8",
                                                "sense_id": "aa7b639e-8cef-37f7-9be7-0910a0409055",
                                                "text": "„Mit einem Teil ihres Geldes kaufen sie weder Blech noch Beton, sondern so federleichte Sachen wie ein Ticket.“"
                                            },
                                            {
                                                "example_id": "6c1edab8-2cad-4d84-9732-fb13b05980ba",
                                                "sense_id": "aa7b639e-8cef-37f7-9be7-0910a0409055",
                                                "text": "„Das Ticket befestigte ich mit einem Magneten am Kühlschrank, und jedes Mal, wenn mein Blick es in den vergangenen Wochen streifte, wuchs die Vorfreude.“"
                                            },
                                            {
                                                "example_id": "6e0b2280-ff3b-4940-ae01-5077082ed270",
                                                "sense_id": "aa7b639e-8cef-37f7-9be7-0910a0409055",
                                                "text": "„Ein Firmenleiter besaß ein Ticket für ein Symphoniekonzert mit Schuberts ‚Unvollendeter‘ auf dem Programm.“"
                                            },
                                            {
                                                "example_id": "93157b0f-1779-44fe-9e63-c7fcb6be60ea",
                                                "sense_id": "aa7b639e-8cef-37f7-9be7-0910a0409055",
                                                "text": "„Das einzige noch verfügbare Ticket gab es in der Businessclass, teuer wie der Tod, dachte Eiríkur unwillkürlich, und schickte seinem Großvater im Zug zum Flughafen eine SMS, dass er unterwegs sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4869e3af-f054-3b5d-92ad-68a7173b5fa8",
                                        "entry_id": "a0abcc4d-5925-3605-9077-eb367c67ecdf",
                                        "glosses": [
                                            "Strafzettel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b97fab0b-5782-43e2-b087-2706863f9f51",
                                                "sense_id": "4869e3af-f054-3b5d-92ad-68a7173b5fa8",
                                                "text": "Er hat kurz auf dem Gehweg geparkt und prompt ein Ticket bekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
