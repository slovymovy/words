                "senses": [
                    {
                        "sense_id": "48b5caef-9cbe-3f69-9e12-ba56a4e3b0c8",
                        "entry_id": "747017bd-50c5-3df7-9c94-9c1dd5e11872",
                        "glosses": [
                            "Habitant de la Gironde, département français (33)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "092331ab-a279-4a10-8451-3a0393903784",
                                "sense_id": "48b5caef-9cbe-3f69-9e12-ba56a4e3b0c8",
                                "text": "L’heure n’est donc plus à la concurrence entre les deux ouvreurs, ni à l’association Jalimack, avec le Girondin en 10 et le Haut-Garonnais au centre."
                            },
                            {
                                "example_id": "bc681735-80b0-4101-a234-81c573da0b71",
                                "sense_id": "48b5caef-9cbe-3f69-9e12-ba56a4e3b0c8",
                                "text": "À 32 ans, le Girondin Kévin Cembellin prépare le marathon de Paris, qui se tiendra le 2 avril."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
