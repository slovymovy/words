{
    "word_family": [
        "tourment",
        "tourmente",
        "tourmenteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "677a1ab4-cbbf-390d-acaf-2590425357d6",
                    "sense_definition": "Causer de l'inquiétude, de l'angoisse ou des soucis à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inquiétude_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette sombre perspective d'avenir recommençait à <w>tourmenter</w> son esprit jour et nuit."
                        },
                        {
                            "text": "Une lancinante question sans réponse le <w>tourmentait</w> depuis plusieurs jours."
                        }
                    ],
                    "synonyms": [
                        "inquiéter",
                        "préoccuper",
                        "tarauder"
                    ],
                    "common_phrases": [
                        "tourmenter l'esprit"
                    ]
                },
                {
                    "sense_id": "412ba61b-fe81-3be9-aad1-41eb6872be00",
                    "sense_definition": "S'inquiéter excessivement, se faire du souci pour quelque chose ou quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inquiétude_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas se <w>tourmenter</w> pour des détails sans importance."
                        },
                        {
                            "text": "Elle passe des nuits blanches à se <w>tourmenter</w> au sujet de ses examens."
                        }
                    ],
                    "common_phrases": [
                        "se tourmenter pour"
                    ]
                },
                {
                    "sense_id": "747e287d-616d-33f9-9b83-c58a7c55b18d",
                    "sense_definition": "Importuner, harceler ou agacer sans cesse par des demandes ou des reproches.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harcèlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ne cessent de <w>tourmenter</w> leur camarade avec des plaisanteries cruelles."
                        },
                        {
                            "text": "Je vous demande de cesser de <w>tourmenter</w> ce témoin avec vos questions insistantes."
                        }
                    ],
                    "synonyms": [
                        "harceler"
                    ]
                },
                {
                    "sense_id": "1aa0c22c-fee4-3234-ab38-8aff171154cc",
                    "sense_definition": "Faire subir de vives souffrances corporelles, infliger des tortures physiques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souffrance_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gardes ont fini par <w>tourmenter</w> le captif pour lui arracher des aveux."
                        },
                        {
                            "text": "Ce tyran sanguinaire aimait <w>tourmenter</w> ses opposants dans les cachots du château."
                        }
                    ],
                    "synonyms": [
                        "supplicier",
                        "torturer"
                    ]
                },
                {
                    "sense_id": "3ce88e58-299f-3afc-8434-2d7082f54fb3",
                    "sense_definition": "Faire souffrir physiquement de manière continue, en parlant d'un mal ou d'une douleur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souffrance_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux marin était constamment <w>tourmenté</w> par des crises aiguës de rhumatisme."
                        },
                        {
                            "text": "La fièvre et la soif intense ont continué de le <w>tourmenter</w> toute la nuit."
                        }
                    ],
                    "common_phrases": [
                        "tourmenté par la douleur"
                    ]
                },
                {
                    "sense_id": "c8e83ee1-02c1-3138-bad0-d5c8984ae801",
                    "sense_definition": "Remuer, manipuler ou triturer un objet de façon nerveuse ou désordonnée.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Assis près de l'âtre, il <w>tourmentait</w> nerveusement les braises avec une longue tige métallique."
                        },
                        {
                            "text": "Pendant tout l'entretien, l'accusé <w>tourmentait</w> le coin de sa veste sans lever les yeux."
                        }
                    ]
                }
            ]
        }
    ]
}