{
    "word_family": [
        "возможность",
        "возможный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5c8d60db-bbff-3ed5-9c7e-60a09333813a",
                    "sense_definition": "Вводное слово, выражающее вероятность, допущение или неуверенность в чем-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Возможно</w>, мы поедем на море летом.",
                            "target_lang_translations": {
                                "en": "<w>Perhaps</w> we will go to the sea in the summer.",
                                "zh": "<w>可能</w>我们夏天会去海边。"
                            }
                        },
                        {
                            "text": "Завтра, <w>возможно</w>, будет хорошая погода.",
                            "target_lang_translations": {
                                "en": "Tomorrow, <w>possibly</w>, the weather will be good.",
                                "zh": "明天<w>也许</w>天气会很好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вероятно",
                        "видимо",
                        "пожалуй"
                    ],
                    "antonyms": [
                        "вряд ли"
                    ],
                    "common_phrases": [
                        "вполне возможно",
                        "очень возможно"
                    ],
                    "target_lang_definitions": {
                        "en": "An introductory word expressing probability, assumption, or uncertainty about a statement.",
                        "zh": "用于句首或句中，表示对某事发生的可能性、推测或不确定性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "possibly",
                                "target_lang_sense_clarification": "adverb indicating something is possible but not certain"
                            },
                            {
                                "target_lang_word": "perhaps",
                                "target_lang_sense_clarification": "used to express uncertainty or possibility"
                            },
                            {
                                "target_lang_word": "maybe",
                                "target_lang_sense_clarification": "informal adverb expressing possibility"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可能",
                                "target_lang_sense_clarification": "表示事情发生的概率"
                            },
                            {
                                "target_lang_word": "也许",
                                "target_lang_sense_clarification": "表示不确定或推测"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4bb8558-55b2-37bd-be26-84db1112b6d8",
                    "sense_definition": "Предикатив, обозначающий, что что-то осуществимо, допустимо или может произойти.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feasibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сделать это <w>возможно</w> за один день.",
                            "target_lang_translations": {
                                "en": "It is <w>possible</w> to do this in one day.",
                                "zh": "这件事在一天内完成是<w>可能</w>的。"
                            }
                        },
                        {
                            "text": "Всё <w>возможно</w>, если очень захотеть.",
                            "target_lang_translations": {
                                "en": "Everything is <w>possible</w> if you really want it.",
                                "zh": "只要真心想做，一切皆有<w>可能</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "можно",
                        "реально"
                    ],
                    "antonyms": [
                        "невозможно",
                        "нельзя"
                    ],
                    "common_phrases": [
                        "это возможно",
                        "всё возможно"
                    ],
                    "target_lang_definitions": {
                        "en": "A predicative word indicating that something is feasible, permissible, or capable of happening.",
                        "zh": "表示某事是可行的、允许的或能够发生的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "possible",
                                "target_lang_sense_clarification": "capable of being done or achieved"
                            },
                            {
                                "target_lang_word": "it is possible",
                                "target_lang_sense_clarification": "phrase indicating feasibility"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可能",
                                "target_lang_sense_clarification": "表示具备发生的条件"
                            },
                            {
                                "target_lang_word": "可以",
                                "target_lang_sense_clarification": "表示允许或可行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac6dd85f-816d-365c-ab55-bb94d3ed8fb8",
                    "sense_definition": "Наречие, используемое перед сравнительной степенью прилагательных или наречий для обозначения предельной меры.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я прошу тебя прийти <w>возможно</w> скорее.",
                            "target_lang_translations": {
                                "en": "I ask you to come as soon as <w>possible</w>.",
                                "zh": "我请求你<w>尽可能</w>快地过来。"
                            }
                        },
                        {
                            "text": "Напишите этот текст <w>возможно</w> короче.",
                            "target_lang_translations": {
                                "en": "Write this text as short as <w>possible</w>.",
                                "zh": "请把这段文字写得<w>尽可能</w>简短。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "возможно скорее",
                        "возможно больше"
                    ],
                    "target_lang_definitions": {
                        "en": "An adverb used before a comparative adjective or adverb to indicate the maximum degree possible.",
                        "zh": "用于形容词或副词比较级前，表示达到最大限度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as ... as possible",
                                "target_lang_sense_clarification": "used in comparisons to indicate the maximum extent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尽可能",
                                "target_lang_sense_clarification": "表示达到最大程度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad629e52-bf40-3960-8f40-c98812d66fb5",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>возможный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Такое решение было единственно <w>возможно</w> в той ситуации.",
                            "target_lang_translations": {
                                "en": "Such a decision was the only one <w>possible</w> in that situation.",
                                "zh": "在那种情况下，那个决定是唯一<w>可能</w>的选择。"
                            }
                        },
                        {
                            "text": "Это дело <w>возможно</w> только при вашей поддержке.",
                            "target_lang_translations": {
                                "en": "This matter is <w>possible</w> only with your support.",
                                "zh": "这件事只有在您的支持下才<w>可能</w>实现。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective describing something that can exist, happen, or be done.",
                        "zh": "形容词“可能的”的短尾形式，描述某事是可以存在、发生或完成的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "possible",
                                "target_lang_sense_clarification": "adjective describing feasibility"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可能",
                                "target_lang_sense_clarification": "描述可行性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}