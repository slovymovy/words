                                                "example_id": "6cf7d39e-1e5b-4e05-b73c-29c70a4b8290",
                                                "sense_id": "c162601c-a5d6-390e-b031-7c30edd21074",
                                                "text": "どうしようもない。"
                                            }
                                        ]
