    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c99b956e-d9ec-3d4d-8fd6-1d3479e51468",
                    "sense_definition": "Se défendre contre un agresseur ou opposer une force à une attaque.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "combat_opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont réussi à <w>résister</w> à l'attaque pendant plusieurs heures."
                        },
                        {
                            "text": "La petite troupe tente de <w>résister</w> avec courage face aux assaillants."
                        }
                    ],
                    "synonyms": [
                        "faire face",
                        "faire front"
                    ],
                    "antonyms": [
                        "céder",
                        "succomber"
                    ],
                    "common_phrases": [
                        "résister à l'ennemi",
                        "résister à l'attaque"
                    ]
                },
                {
                    "sense_id": "68d403e4-b3ed-3810-b348-596528c1e224",
                    "sense_definition": "Ne pas céder à une envie, un attrait ou une impulsion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "volonte_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne peux pas <w>résister</w> à la tentation de manger ce délicieux gâteau."
                        },
                        {
                            "text": "Elle a fait de gros efforts pour <w>résister</w> à l'envie d'acheter ces chaussures."
                        }
                    ],
                    "synonyms": [
                        "tenir le coup"
                    ],
                    "antonyms": [
                        "céder",
                        "succomber"
                    ],
                    "common_phrases": [
                        "résister à la tentation",
                        "résister au désir"
                    ]
                },
                {
                    "sense_id": "32d851e4-d29b-36d8-bfcc-c703dc855fae",
                    "sense_definition": "Ne pas se rompre ni se déformer sous l'effet d'une force ou des intempéries.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille maison a su <w>résister</w> au vent violent de la dernière tempête."
                        },
                        {
                            "text": "Ce matériau moderne peut <w>résister</w> à de très hautes températures sans brûler."
                        }
                    ],
                    "synonyms": [
                        "tenir le coup"
                    ],
                    "antonyms": [
                        "céder",
                        "fléchir"
                    ],
                    "common_phrases": [
                        "résister au temps",
                        "résister au vent"
                    ]
                },
                {
                    "sense_id": "c1d13075-5b9e-3ed5-8807-bcb3c59dd943",
                    "sense_definition": "S'opposer fermement à l'autorité ou à la volonté d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "combat_opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune employé a osé <w>résister</w> aux ordres injustes de son supérieur."
                        },
                        {
                            "text": "Ils refusent de baisser les bras et continuent de <w>résister</w> au pouvoir en place."
                        }
                    ],
                    "synonyms": [
                        "tenir tête"
                    ],
                    "antonyms": [
                        "céder",
                        "fléchir"
                    ],
                    "common_phrases": [
                        "résister aux ordres",
                        "résister à la pression"
                    ]
                },
                {
                    "sense_id": "11ebbe1f-9c76-3432-be22-5126e966fa31",
                    "sense_definition": "Supporter une maladie, la fatigue ou un climat rigoureux sans faiblir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces plantes sauvages parviennent facilement à <w>résister</w> au froid intense des montagnes."
                        },
                        {
                            "text": "Son organisme affaibli a désormais beaucoup de mal à <w>résister</w> à la fatigue."
                        }
                    ],
                    "synonyms": [
                        "tenir le coup"
                    ],
                    "antonyms": [
                        "faiblir",
                        "succomber"
                    ],
                    "common_phrases": [
                        "résister au froid",
                        "résister à la maladie"
                    ]
                }
            ]
        }
    ]
}