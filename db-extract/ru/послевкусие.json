                                    {
                                        "sense_id": "2576475a-4927-37fc-8e9a-24922d435d14",
                                        "entry_id": "0e4178a9-09f1-3df9-a57b-88ea83f24439",
                                        "glosses": [
                                            "Gout que laissent dans la bouche certains aliments ou certaines liqueurs, différent de celui qu’on avait éprouvé d’abord. Il se prend le plus souvent en mauvaise part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2821e04e-1b35-433f-8024-592ca0896c55",
                                                "sense_id": "2576475a-4927-37fc-8e9a-24922d435d14",
                                                "text": "Ce vin laisse un arrière-gout boisé."
                                            }
                                        ]
