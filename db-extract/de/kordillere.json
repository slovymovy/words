                        "examples": [
                            {
                                "example_id": "d51e7d36-f180-4398-8f36-77d953d78f5a",
                                "sense_id": "8ecd9ae1-7402-332f-9384-62ba04675756",
                                "text": "„Im Süden schließen sich die von der amerikanischen Kordillere geprägten Hochländer von Chiapas, Guatemala, El Salvador und Honduras an und stellen die Landverbindungen ins nördliche Mesoamerika und nach Zentralamerika her.“"
                            }
                        ],
