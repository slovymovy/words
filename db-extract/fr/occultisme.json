        "fr-extract.jsonl": [
            {
                "entry_id": "b8aa44fb-fe13-3516-be07-ac46ac917be6",
                "word": "occultisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "14cc3d03-b4e4-41d6-aef2-676f51646c0c",
                        "entry_id": "b8aa44fb-fe13-3516-be07-ac46ac917be6",
                        "tags": [
                            "plural"
                        ],
                        "form": "occultismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aeceb017-13e2-3cc8-b25e-c9f04eb830f4",
                        "entry_id": "b8aa44fb-fe13-3516-be07-ac46ac917be6",
                        "glosses": [
                            "Ensemble des arts et sciences occultes (alchimie, astrologie, magie, divination, médecine occulte) touchant aux secrets de la nature, à ce qui est non visible"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264781ed-d38b-49c4-b9f1-2f43fb8978df",
                                "sense_id": "aeceb017-13e2-3cc8-b25e-c9f04eb830f4",
                                "text": "On a discuté sur des phénomènes d’occultisme, sur l’au-delà : « Qui sait ! » a-t-on dit ; puis on a parlé de la mort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "932ef753-744f-47a4-ba51-ab87535e1dbb",
                        "source_entry_id": "b8aa44fb-fe13-3516-be07-ac46ac917be6",
                        "source_sense_id": "aeceb017-13e2-3cc8-b25e-c9f04eb830f4",
                        "target_lang_word": "occult",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "occult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b72d6fc-852b-3ebc-8950-14990497d3d3",
                                        "entry_id": "788a9bba-e5c2-3334-8437-e0916ea1832d",
                                        "glosses": [
                                            "To cover or hide from view."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a82bcc8-0564-4290-9f05-a2e773e4ea11",
                                                "sense_id": "5b72d6fc-852b-3ebc-8950-14990497d3d3",
                                                "text": "The Earth occults the Moon during a lunar eclipse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "360e4589-2ea3-3e6c-b61c-28dbf74a2b93",
                                        "entry_id": "788a9bba-e5c2-3334-8437-e0916ea1832d",
                                        "glosses": [
                                            "To dissimulate, conceal, or obfuscate."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d01164b-f8bb-42e0-9c38-947c637cd3c5",
                                                "sense_id": "360e4589-2ea3-3e6c-b61c-28dbf74a2b93",
                                                "text": "[…]to do so would occult rather than illuminate the utterly unexpected and surprising character of his coming and of his reign."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "occult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bad3234e-9a96-303e-994b-dfd7eaa494cc",
                                        "entry_id": "461b64c6-39e9-3123-af55-fe951e45a7e1",
                                        "glosses": [
                                            "Secret; hidden from general knowledge; undetected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11bfdc90-81b8-4ed6-a331-873d37f6ec2a",
                                                "sense_id": "bad3234e-9a96-303e-994b-dfd7eaa494cc",
                                                "text": "occult blood loss; occult cancer"
                                            },
                                            {
                                                "example_id": "d1dcd7ac-f64e-4739-b16c-bdf12be326d8",
                                                "sense_id": "bad3234e-9a96-303e-994b-dfd7eaa494cc",
                                                "text": "This counter-influence is so much more conclusive[…] because it is of an occult kind, and is so insensible in its advances as to escape observation."
                                            },
                                            {
                                                "example_id": "c9787ad8-6ddc-41d6-a4d8-e9f00516130f",
                                                "sense_id": "bad3234e-9a96-303e-994b-dfd7eaa494cc",
                                                "text": "One of our dogs with PHPTH [primary hyperparathyroidism] had lucent lesions in the long bones, but this is extremely uncommon. Concurrent hyperproteinemia is supportive of myeloma. Solid tumors with metastasis to bone are more likely if lytic bone lesions and normoproteinemia (especially a normal serum globulin concentration) are present. A core biopsy of a lytic lesion may be necessary to establish a definitive diagnosis of neoplasia, especially in a dog with occult neoplasia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e27908-4a68-3f27-b03e-e8fd92f8eeca",
                                        "entry_id": "461b64c6-39e9-3123-af55-fe951e45a7e1",
                                        "glosses": [
                                            "not visible, but chemically detectable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ac15d4-cd5b-4466-98af-2e6d91bdf2a5",
                                                "sense_id": "63e27908-4a68-3f27-b03e-e8fd92f8eeca",
                                                "text": "occult blood in the urine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c0e7235-8410-32d3-ac82-0d6bb7641451",
                                        "entry_id": "461b64c6-39e9-3123-af55-fe951e45a7e1",
                                        "glosses": [
                                            "Related to the occult; pertaining to mysticism, magic, or astrology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fb23266-3127-456d-b361-360149096474",
                                                "sense_id": "5c0e7235-8410-32d3-ac82-0d6bb7641451",
                                                "text": "The concoctions contrived by Italians were particularly in clamant demand, while the occult sciences of astrology and alchemy lent their support[.]"
                                            },
                                            {
                                                "example_id": "b1a1713c-c3b0-4976-a2f5-11ed6349c7d7",
                                                "sense_id": "5c0e7235-8410-32d3-ac82-0d6bb7641451",
                                                "text": "Be aware that occult knowledge can be used for good or evil purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412a1864-f20b-3712-88cf-b1156fc43b92",
                                        "entry_id": "461b64c6-39e9-3123-af55-fe951e45a7e1",
                                        "glosses": [
                                            "Esoteric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf06c45-ce51-407d-8864-b29e0bf874fa",
                                                "sense_id": "412a1864-f20b-3712-88cf-b1156fc43b92",
                                                "text": "Elbows almost touching they leaned at ease, idly reading the almost obliterated lines engraved there. ¶ \"I never understood it,\" she observed, lightly scornful. \"What occult meaning has a sun-dial for the spooney? I'm sure I don't want to read riddles in a strange gentleman's optics.\""
                                            }
                                        ]
                                    }
                                ]
                            },
