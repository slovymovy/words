        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "706e56d9-04bf-3173-a00d-909513a22d4e",
                    "sense_definition": "To be physically close or conceptually akin to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His behavior <w>borderlines</w> on being completely unacceptable.",
                            "target_lang_translations": {
                                "ru": "Его поведение <w>граничит</w> с абсолютно неприемлемым."
                            }
