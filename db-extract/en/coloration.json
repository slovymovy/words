                    {
                        "sense_id": "cf983eb4-1615-39fe-88ed-fe65f51e4df9",
                        "entry_id": "8de07da7-a89f-3ec2-a2ed-1382ff414ed5",
                        "glosses": [
                            "The quality of being colored."
                        ],
