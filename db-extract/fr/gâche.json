                ],
                "senses": [
                    {
                        "sense_id": "ebfd66d0-d6c3-33c5-8d79-a76313a4c96c",
                        "entry_id": "28e730c7-e6c7-392d-be04-7073093e15a4",
                        "glosses": [
                            "Partie d’une serrure dans laquelle le pêne s’insère pour maintenir une porte fermée."
                        ],
                        "tags": [
                            "Serrurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "21bb41a1-3867-4f56-bed1-67424c076706",
                                "sense_id": "ebfd66d0-d6c3-33c5-8d79-a76313a4c96c",
                                "text": "J'allai immédiatement à la porte : la porte était refermée ; les verrous semblaient n'être point sortis de leur gâche ; […]."
                            },
                            {
                                "example_id": "e37e2c86-ac17-48cf-b305-dcceca5087e7",
                                "sense_id": "ebfd66d0-d6c3-33c5-8d79-a76313a4c96c",
                                "text": "Il tira le premier tiroir du meuble, et le sortit entièrement de sa gâche."
                            },
                            {
                                "example_id": "d30b94f0-1a17-4a30-a193-340e3bbae934",
                                "sense_id": "ebfd66d0-d6c3-33c5-8d79-a76313a4c96c",
                                "text": "Arrivé sur le palier, il frotta son badge sur le lecteur accroché à droite de la double porte et, en entendant le son de la gâche, poussa le lourd battant qui s’ouvrait sur la salle des archives."
                            }
                        ]
                    },
                    {
                        "sense_id": "854106bb-d832-3a29-8745-d1001ebb8a39",
                        "entry_id": "28e730c7-e6c7-392d-be04-7073093e15a4",
                        "glosses": [
                            "Anneau de fer qui est scellé dans un mur pour soutenir et attacher un tuyau de descente, etc."
                        ],
