        "fr-extract.jsonl": [
            {
                "entry_id": "9c39f6d3-a362-3180-8bf4-8ec093d65d3e",
                "word": "rhéteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b00009f-49fa-4a4d-bf1d-d2eb71d86d1b",
                        "entry_id": "9c39f6d3-a362-3180-8bf4-8ec093d65d3e",
                        "tags": [
                            "plural"
                        ],
                        "form": "rhéteurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c96d9164-dd4b-35ca-8bee-06058cee16b2",
                        "entry_id": "9c39f6d3-a362-3180-8bf4-8ec093d65d3e",
                        "glosses": [
                            "Celui qui enseignait la rhétorique et qui ordinairement faisait profession de donner des règles et des préceptes d’éloquence, soit de vive voix, soit par écrit."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "6e9182ab-346b-4a71-b515-566f3d4d03c3",
                                "sense_id": "c96d9164-dd4b-35ca-8bee-06058cee16b2",
                                "text": "Parmi les plus célèbres rhéteurs de la Grèce, on compte Isocrate et Longin."
                            },
                            {
                                "example_id": "28c3143f-4c20-4e32-aa9b-fabc3c7b5051",
                                "sense_id": "c96d9164-dd4b-35ca-8bee-06058cee16b2",
                                "text": "[La rhétorique] est un savoir-faire nouveau […] instituant un rapport original au savoir : sa transmission au sein d’écoles où enseignent des maîtres en la matière, les rhéteurs."
                            },
                            {
                                "example_id": "e6423111-d8ba-4063-941a-b96cb4b4aa4b",
                                "sense_id": "c96d9164-dd4b-35ca-8bee-06058cee16b2",
                                "text": "Ce nom surgi de l'Antiquité m'a donné un soupçon d'espoir : à Rome, l'Athenæum était une académie hautement réputée, où les rhéteurs discutaient de lettres et de philosophie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2af2c5d0-1446-3f19-b8f5-0df4cceae00b",
                        "entry_id": "9c39f6d3-a362-3180-8bf4-8ec093d65d3e",
                        "glosses": [
                            "Orateur éloquent, qui maîtrise consciemment ou non la rhétorique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e8d231-13e5-49de-b6ba-08faaa92c4d4",
                                "sense_id": "2af2c5d0-1446-3f19-b8f5-0df4cceae00b",
                                "text": "Au reste les gestes de l’humanité ne furent jamais que des bouffonneries lugubres, et les historiens qui découvrent quelque ordre dans la suite des événements sont de grands rhéteurs."
                            },
                            {
                                "example_id": "6657906d-d891-4d5e-96cb-b413dcfecd7d",
                                "sense_id": "2af2c5d0-1446-3f19-b8f5-0df4cceae00b",
                                "text": "Les citoyens doivent être prêts à entendre les messages des rhéteurs en tout genre avec une certaine ouverture d'esprit, mais aussi avec un sain scepticisme, des capacités d'analyse, la volonté de suspendre leur jugement au besoin, de vérifier des faits et tout ce qui permet une plus grande rigueur."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fb5ec53-e5a3-3ed7-a42e-e3baf8b10888",
                        "entry_id": "9c39f6d3-a362-3180-8bf4-8ec093d65d3e",
                        "glosses": [
                            "Personne dont l’éloquence consiste en un style apprêté, emphatique et déclamatoire."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "72a3b7b6-156e-4816-80b2-1e5c3c76eefa",
                                "sense_id": "5fb5ec53-e5a3-3ed7-a42e-e3baf8b10888",
                                "text": "N’attendez de moi ni définition, ni division de rhéteur. Rien ne serait plus déplacé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "499ee67c-42ab-4041-a9e0-92d0e721c69c",
                        "source_entry_id": "9c39f6d3-a362-3180-8bf4-8ec093d65d3e",
                        "target_lang_word": "rhetorician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhetorician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c28b8ca-3fd0-3f17-a3a4-6d35aa3ee18c",
                                        "entry_id": "63bdd9d8-e01a-35ec-b879-b2619500c737",
                                        "glosses": [
                                            "An expert or student of rhetoric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff8d22d-aa2f-4a64-b92c-5b78c91aa04b",
                                                "sense_id": "2c28b8ca-3fd0-3f17-a3a4-6d35aa3ee18c",
                                                "text": "Themistocles was a rhetorician."
                                            },
                                            {
                                                "example_id": "e26d4e82-e6ec-4aba-a585-9fccb5cdc429",
                                                "sense_id": "2c28b8ca-3fd0-3f17-a3a4-6d35aa3ee18c",
                                                "text": "As I showed, although some rhetoricians, such as Mesmer and Erb, claimed that their interventions were medical treatments, others, such as Freud and Jung, claimed that their interventions were both medical curings and spiritual carings."
                                            },
                                            {
                                                "example_id": "629388f3-3756-432c-bac0-7443e72de2ed",
                                                "sense_id": "2c28b8ca-3fd0-3f17-a3a4-6d35aa3ee18c",
                                                "text": "In his classicising Troilus and Criseyde, set with pagan aplomb in ancient Troy, he approvingly quotes the rhetorician Geoffrey of Vinsauf’s New Poetics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dab9c90-1232-309c-8ec2-f47178372402",
                                        "entry_id": "63bdd9d8-e01a-35ec-b879-b2619500c737",
                                        "glosses": [
                                            "An orator or eloquent public speaker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
