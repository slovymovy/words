                ],
                "senses": [
                    {
                        "sense_id": "682ac937-a6dd-3452-a5ba-0a6a1000c691",
                        "entry_id": "1f712d06-e7d7-3f03-96fd-e458c81c6409",
                        "glosses": [
                            "Celui qui triche, qui trompe au jeu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f863a7c3-5402-43e8-8158-40c5d75d7eef",
                                "sense_id": "682ac937-a6dd-3452-a5ba-0a6a1000c691",
                                "text": "Jeannin était joueur et même tricheur, entraîné à cela par un autre ; et insensiblement ils se mirent à tenir tripot, entendez qu'ils attiraient des inconnus à la table de nuit ; on passait du tarot au baccara pendant que nous dormions, et les étrangers étaient plumés."
                            },
                            {
                                "example_id": "15d69041-af43-4971-95ac-bbfae6844e2e",
                                "sense_id": "682ac937-a6dd-3452-a5ba-0a6a1000c691",
                                "text": "Le dessin datait de ses années d’internat. Je reconnus sa face mince et tricheuse, ses yeux vifs, à fleur de tête. L’artiste lui avait donné un sourire de cruauté maniaque."
                            },
                            {
                                "example_id": "99a66933-dee4-47f0-bcc5-42c288d849dc",
                                "sense_id": "682ac937-a6dd-3452-a5ba-0a6a1000c691",
                                "text": "Certes Don Juan est un tricheur, et même il ne vit que de cela ([…]). Mais une tricherie constante est moins dangereuse que les faiblesses subites d'un honnête homme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74ac246c-527f-4860-a8a4-ee325f4941e3",
                        "source_entry_id": "1f712d06-e7d7-3f03-96fd-e458c81c6409",
                        "source_sense_id": "682ac937-a6dd-3452-a5ba-0a6a1000c691",
                        "target_lang_word": "Falschspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falschspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7aa5f1dc-30e9-398d-a1a5-c0e597037efd",
                                        "entry_id": "d98b9c09-a9f7-3817-a495-af8009117992",
                                        "glosses": [
                                            "Person, die alles daran setzt, ihre Spielpartner zu übervorteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12846c43-e205-4f82-b527-a418bd2655ed",
                                                "sense_id": "7aa5f1dc-30e9-398d-a1a5-c0e597037efd",
                                                "text": "„Während des heiteren Mahls sagte er mir, er kenne mich seit siebzehn Jahren auf Grund einer Affäre, die ich bei der Cascina de'Pomi mit dem angeblichen Grafen Celi gehabt hätte, einem Falschspieler, dem ich eine Tänzerin ausgespannt und nach Mantua mitgenommen hatte.“"
                                            },
                                            {
                                                "example_id": "4c1c7e0b-d9b9-4424-8250-56b621491f9c",
                                                "sense_id": "7aa5f1dc-30e9-398d-a1a5-c0e597037efd",
                                                "text": "„Der Falschspieler übergab ihm das Spiel Karten und blickte prüfend in die Kerzenflamme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
