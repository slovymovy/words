                "senses": [
                    {
                        "sense_id": "d544b0f9-e056-3124-8b90-223eafdb970b",
                        "entry_id": "bce8dbf1-aebd-33fa-9413-60437b24ad52",
                        "glosses": [
                            "Unterstellplatz und Werkstatt für Lokomotiven"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "3306177a-4bcb-48ee-898c-ceb82ce5a89d",
                                "sense_id": "d544b0f9-e056-3124-8b90-223eafdb970b",
                                "text": "Thomas fuhr über die Drehscheibe in den Lokschuppen und schloss die Ventile des Kessels."
                            },
                            {
                                "example_id": "b99b2613-0d8b-41a6-9799-aa4ddf063fc1",
                                "sense_id": "d544b0f9-e056-3124-8b90-223eafdb970b",
                                "text": "„Der Lokschuppen der historischen Anlage des Bahnhofs Schwedt ist verkauft. Ein privater Käufer ersteigerte das Gebäude samt Sozialgebäude der früheren Transportpolizei und einem 5800 Quadratmeter großen Grundstück mit ehemaliger Laderampe während einer öffentlichen Auktion.“"
                            },
                            {
                                "example_id": "b007fe87-3c64-4887-8328-a36cda3591ff",
                                "sense_id": "d544b0f9-e056-3124-8b90-223eafdb970b",
                                "text": "„Nicht nur der Bogenbach in Deggendorf ist mittlerweile in die Modellbahnanlage samt installierter Eisenbahnbrücke angelegt, auch der Lokschuppen ist fertig, nur an dessen Innenausstattung werde noch gearbeitet.“"
                            },
                            {
                                "example_id": "a366bb8d-07fc-46e4-a505-27732c5758ab",
                                "sense_id": "d544b0f9-e056-3124-8b90-223eafdb970b",
                                "text": "„Im Freigelände stehen zahlreiche Eisenbahnfahrzeuge aus verschiedenen Epochen herum, die im ehemaligen Lokschuppen eingerichtete Ausstellung zeigt die unterschiedlichsten Exponate aus der Eisenbahnwelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
