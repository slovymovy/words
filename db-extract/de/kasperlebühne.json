                "senses": [
                    {
                        "sense_id": "f55fbf30-6e73-398c-8cf6-0f6a6c426917",
                        "entry_id": "7866e95a-7624-3a6a-a56a-8667c8d2dd42",
                        "glosses": [
                            "Forum, auf dem die Puppenspielfigur des Kasper vor Zuschauern agiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1561b91f-6949-4349-adeb-40c327713b19",
                                "sense_id": "f55fbf30-6e73-398c-8cf6-0f6a6c426917",
                                "text": "„Das epische Theater ist also vorhanden, tritt aber nicht in Erscheinung, was offenbar das Antiillusionistische auf der Kasperlebühne· ausmacht.“"
                            },
                            {
                                "example_id": "ceb961e1-d44c-4406-85d3-d911aeb8bca8",
                                "sense_id": "f55fbf30-6e73-398c-8cf6-0f6a6c426917",
                                "text": "„Witzige, skurrile, lustige, auch ironische Züge gehören zur Fabel, deren Zuordnung eher zufällig, aber einmal festgelegt, sehr dauerhaft ist, -ähnlich den Figuren der Kasperlebühne.“"
                            },
                            {
                                "example_id": "8676cdf3-bb20-41db-88e6-9ea2d65cc75c",
                                "sense_id": "f55fbf30-6e73-398c-8cf6-0f6a6c426917",
                                "text": "„Sylvia und Ute beschäftigen sich im vorderen Raum mit Legosteinen und ihrer mitgebrachten Kasperlebühne.“"
                            },
                            {
                                "example_id": "99b5e174-dd5d-4d92-90fc-31b8afbc8f03",
                                "sense_id": "f55fbf30-6e73-398c-8cf6-0f6a6c426917",
                                "text": "„Die Kindergärtnerin stellte sich vor die Kasperlebühne, schaute uns an und beugte sich vor. Sie hielt ihren Finger vor den Mund und machte leise: Pscht, pscht, pscht!“"
                            },
                            {
                                "example_id": "f93a212b-f9e7-4233-9587-254eec5fa942",
                                "sense_id": "f55fbf30-6e73-398c-8cf6-0f6a6c426917",
                                "text": "„Die Kasperlebühne erfordert eine Raumhöhe von mindestens 2,60 Meter!“"
                            },
                            {
                                "example_id": "4b4fc6db-5a22-4820-881c-13ff27fd7400",
                                "sense_id": "f55fbf30-6e73-398c-8cf6-0f6a6c426917",
                                "text": "„Und auch dieses Jahr hat die Alola Kasperlebühne wieder ein neues Stück einstudiert: König – Kasperl - Teufel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
