                    {
                        "sense_id": "251d2eaf-605b-3649-9e1d-2a8d9a3e09b1",
                        "entry_id": "0bf6472d-ee74-3116-af55-97698df8a357",
                        "glosses": [
                            "kopia zapasowa danych sporządzona dla ich zabezpieczenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3f3ea0-6815-4d20-a400-69a94fc4bdd0",
                                "sense_id": "251d2eaf-605b-3649-9e1d-2a8d9a3e09b1",
                                "text": "W domowych warunkach przydatność takiego „całościowego” backupu jest nieco ograniczona – napędy taśmowe nie stanowią standardowego wyposażenia komputerów"
                            }
                        ],
