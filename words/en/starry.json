    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d0172527-70b1-34eb-8141-66549bc7f65c",
                    "sense_definition": "Full of or lit by visible stars.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "celestial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat outside and gazed up at the clear, <w>starry</w> sky.",
                            "target_lang_translations": {
                                "es": "Nos sentamos afuera y contemplamos el cielo despejado y <w>estrellado</w>."
                            }
                        },
                        {
                            "text": "They decided to go for a long walk on a cold, <w>starry</w> night.",
                            "target_lang_translations": {
                                "es": "Decidieron dar un largo paseo en una noche fría y <w>estrellada</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stelliferous"
                    ],
                    "antonyms": [
                        "starless",
                        "unstarry"
                    ],
                    "common_phrases": [
                        "starry night",
                        "starry sky"
                    ],
                    "target_lang_definitions": {
                        "es": "Lleno de estrellas o iluminado por ellas visiblemente en el cielo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "estrellado",
                                "target_lang_sense_clarification": "cielo o noche con estrellas visibles"
                            },
                            {
                                "target_lang_word": "estelífero",
                                "target_lang_sense_clarification": "literario, lleno de estrellas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "196dd66d-1131-3ee6-b389-642873d95817",
                    "sense_definition": "Resembling or shaped like a star.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with tiny plants bearing white, <w>starry</w> flowers.",
                            "target_lang_translations": {
                                "es": "El jardín estaba lleno de pequeñas plantas con flores blancas <w>estrelladas</w>."
                            }
                        },
                        {
                            "text": "Frost had left delicate, <w>starry</w> patterns across the window pane.",
                            "target_lang_translations": {
                                "es": "La escarcha había dejado delicados patrones <w>en forma de estrella</w> por todo el cristal de la ventana."
                            }
                        }
                    ],
                    "common_phrases": [
                        "starry shape",
                        "starry flowers"
                    ],
                    "target_lang_definitions": {
                        "es": "Que tiene forma o aspecto similar al de una estrella."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "estrellado",
                                "target_lang_sense_clarification": "con forma de estrella"
                            },
                            {
                                "target_lang_word": "en forma de estrella",
                                "target_lang_sense_clarification": "diseño o figura con puntas como estrella"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2183461-0890-3ce4-83b2-071946ecb032",
                    "sense_definition": "Featuring many famous performers or celebrities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite boasting an exceptionally <w>starry</w> cast, the new drama failed to impress critics.",
                            "target_lang_translations": {
                                "es": "A pesar de presumir de un elenco excepcionalmente <w>repleto de estrellas</w>, el nuevo drama no logró impresionar a la crítica."
                            }
                        },
                        {
                            "text": "The charity gala attracted a <w>starry</w> crowd of actors and musicians.",
                            "target_lang_translations": {
                                "es": "La gala benéfica atrajo a una multitud de actores y músicos <w>llena de estrellas</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "star-studded"
                    ],
                    "common_phrases": [
                        "starry cast",
                        "starry lineup"
                    ],
                    "target_lang_definitions": {
                        "es": "Que cuenta con la presencia de muchos artistas o personajes famosos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "repleto de estrellas",
                                "target_lang_sense_clarification": "elenco, evento o cartelera con muchas celebridades"
                            },
                            {
                                "target_lang_word": "lleno de estrellas",
                                "target_lang_sense_clarification": "con abundancia de figuras famosas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bfbf5245-bb83-3fbc-a6be-e3e50718fc61",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Dr. <w>Starry</w> published several influential research papers on local history.",
                            "target_lang_translations": {
                                "es": "El Dr. <w>Starry</w> publicó varios artículos de investigación influyentes sobre la historia local."
                            }
                        },
                        {
                            "text": "The old property has belonged to the <w>Starry</w> family for several generations.",
                            "target_lang_translations": {
                                "es": "La antigua propiedad ha pertenecido a la familia <w>Starry</w> durante varias generaciones."
                            }
                        }
                    ],
                    "traits": [
