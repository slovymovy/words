                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3023f1-414d-4110-b5b0-ae9b081c182c",
                                "sense_id": "1b25ed77-7cc3-3aa1-8082-c73ea1a7d36e",
                                "text": "„Solche Waffen waren den hundeähnlichen Kreaturen fremd, doch wegen ihrer relativ einfachen Handhabung lernten sie schon nach einigen Anweisungen mit ihnen umzugehen.“"
                            },
                            {
                                "example_id": "23f4973b-1b23-4e20-96ab-5ba442f8a2fc",
                                "sense_id": "1b25ed77-7cc3-3aa1-8082-c73ea1a7d36e",
                                "text": "„Sein zusammengekauerter Körper war anthropomorph aber auch hundeähnlich.“"
                            }
                        ],
