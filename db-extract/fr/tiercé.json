            {
                "entry_id": "c182c9ef-e4dc-3b86-91a9-74f5e0d6ef87",
                "word": "tiercé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8f70201-b085-40e7-8614-1ecbbf95ec83",
                        "entry_id": "c182c9ef-e4dc-3b86-91a9-74f5e0d6ef87",
                        "tags": [
                            "plural"
                        ],
                        "form": "tiercés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2cb02e5e-800d-3bf9-9fc9-f9b241d97aa7",
                        "entry_id": "c182c9ef-e4dc-3b86-91a9-74f5e0d6ef87",
                        "glosses": [
                            "Dans une course hippique, pari dans lequel le parieur mise sur l'ordre d’arrivée des trois premiers chevaux."
                        ],
                        "tags": [
                            "Sports hippiques"
                        ],
                        "examples": [
                            {
                                "example_id": "0604ac44-ef3a-46ba-99de-3bfc041dd5cf",
                                "sense_id": "2cb02e5e-800d-3bf9-9fc9-f9b241d97aa7",
                                "text": "La carotte du tiercé se promenait ainsi chaque dimanche sous le nez de la France éblouie, projetant aux yeux de tout un peuple la poudre de ses mille facettes de miroir aux alouettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6017b12-1d54-3b9d-ac7a-646df60f2161",
                        "entry_id": "c182c9ef-e4dc-3b86-91a9-74f5e0d6ef87",
                        "glosses": [
                            "Trio."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a6bd6840-7d9e-4dd4-8b59-14538c00b0e1",
                                "sense_id": "f6017b12-1d54-3b9d-ac7a-646df60f2161",
                                "text": "Notre amour pour la viande a cependant un prix. Les viandes coûtent de plus en plus cher. Les prix des trois composants du tiercé [porcin, bovin et avicole] des viandes ont augmenté en 2020, ce qui est très rare."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c305715a-0f5a-4e33-9c79-44e8a62a43e4",
                        "source_entry_id": "c182c9ef-e4dc-3b86-91a9-74f5e0d6ef87",
                        "source_sense_description": "pari sur l'ordre d’arrivée des trois premiers chevaux",
                        "target_lang_word": "trifecta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trifecta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdeca718-296a-376f-a57d-3093e37b04f5",
                                        "entry_id": "d806ec82-f461-3912-8e01-a4b658223b92",
                                        "glosses": [
                                            "A bet in which the bettor must select the first three placegetters of a race in the order in which they finish."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c362405-23f7-4e7c-a9b4-b32125f8ca33",
                                                "sense_id": "cdeca718-296a-376f-a57d-3093e37b04f5",
                                                "text": "The conservative player will play the exacta box bet and the occasional trifecta box wager."
                                            },
                                            {
                                                "example_id": "2b25b448-00dd-4e5b-a504-0c65c8bd51c8",
                                                "sense_id": "cdeca718-296a-376f-a57d-3093e37b04f5",
                                                "text": "In a trifecta, you must wager on three horses: the one that finishes first (win), the one that finishes second (place), and the one that finishes third (show) in order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5998d134-288a-33fd-9efd-9c77ae8e9c93",
                                        "entry_id": "d806ec82-f461-3912-8e01-a4b658223b92",
                                        "glosses": [
                                            "The attainment of three important achievements, qualities, etc."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c0f64dc-cc48-4240-885e-87f7992d0d78",
                                                "sense_id": "5998d134-288a-33fd-9efd-9c77ae8e9c93",
                                                "text": "The money picture for Santorum could change after his trifecta win in Colorado, Minnesota, and Missouri Tuesday night."
                                            },
                                            {
                                                "example_id": "60f6a734-f16a-4a66-a345-1b6dc95f4bbb",
                                                "sense_id": "5998d134-288a-33fd-9efd-9c77ae8e9c93",
                                                "text": "At the same time, he said, it could be that Mr. Netanyahu is “seeking a trifecta” with the strikes on Monday: pushing Hamas to give in, showing the Israeli public that he did hit Rafah as promised and getting credit from the Biden administration for not mounting the full-scale assault that Washington fears would result in a civilian catastrophe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3298211-d5ca-35d4-9ca2-c33ef788c0de",
                                        "entry_id": "d806ec82-f461-3912-8e01-a4b658223b92",
                                        "glosses": [
                                            "A set of three related things, often things that cause problems."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7948796b-300b-4336-8a2e-f46cd30ab6c7",
                                                "sense_id": "f3298211-d5ca-35d4-9ca2-c33ef788c0de",
                                                "text": "Along with runtime errors, two other errors we saw earlier round out the JavaScript bug trifecta: syntax errors, logic errors, and runtime errors."
                                            },
                                            {
                                                "example_id": "0cfcf306-8a81-4bd1-a9d7-51637ccc8263",
                                                "sense_id": "f3298211-d5ca-35d4-9ca2-c33ef788c0de",
                                                "text": "I might never have learned my name or met my birth family if I hadn't ended up in the hospital in Rhode Island in 2007, after traveling to a trifecta of malaria hotspots: Mali, Egypt and Colombia."
                                            },
                                            {
                                                "example_id": "669cd4d0-7712-49bf-b3b6-5bca3aa3e035",
                                                "sense_id": "f3298211-d5ca-35d4-9ca2-c33ef788c0de",
                                                "text": "And the Amy Schumer, Wanda Sykes, and Regina Hall trifecta stumbled through inconsistent chemistry as they, too, attempted to insult their peers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11877e20-2b14-38eb-977b-b053fba41f3d",
                                        "entry_id": "d806ec82-f461-3912-8e01-a4b658223b92",
                                        "glosses": [
                                            "The complete legislative and executive control of state or federal government by one party: governorship, the upper house, and the lower house of state or federal legislatures."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ff95a1-528e-4821-a5bf-36895a1d77c2",
                                                "sense_id": "11877e20-2b14-38eb-977b-b053fba41f3d",
                                                "text": "In fact, there are about a dozen states, including California, Massachusetts, Washington, and Illinois, where Democrats have won the trifecta—they control the governor's seat as well as both houses of the state legislature."
                                            },
                                            {
                                                "example_id": "fb661992-2c52-49e3-a657-8a6872ff5322",
                                                "sense_id": "11877e20-2b14-38eb-977b-b053fba41f3d",
                                                "text": "It’s not just Florida, of course. Republican trifectas in states across the country have introduced and passed dozens of bills aimed at the public existence of trans and other gender-nonconforming people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
