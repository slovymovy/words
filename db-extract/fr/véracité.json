        "fr-extract.jsonl": [
            {
                "entry_id": "ac9b0f56-7af9-31e3-960c-db3b5ef96033",
                "word": "véracité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bd0dbdd0-96c5-4f93-88dd-9298faaf8f28",
                        "entry_id": "ac9b0f56-7af9-31e3-960c-db3b5ef96033",
                        "tags": [
                            "plural"
                        ],
                        "form": "véracités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "525fac8b-88e7-3b06-ab5e-a405372e035c",
                        "entry_id": "ac9b0f56-7af9-31e3-960c-db3b5ef96033",
                        "glosses": [
                            "Qualité de celui qui dit la vérité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e299c684-3150-4fdd-81b6-ef7e6d44e4fc",
                                "sense_id": "525fac8b-88e7-3b06-ab5e-a405372e035c",
                                "text": "Tel est le jugement porté par la dame du palais de l'impératrice Marie-Louise sur mon grand-père. Le jugement de [la générale] Durand [1772-1850] a été ratifié à peu près par tous les contemporains de cet homme de bien, et par la postérité. Sa véracité bien connue semble un sûr garant de l'authenticité de tous les incidents qu'il rapporte."
                            }
                        ]
                    },
                    {
                        "sense_id": "7db2aca4-3731-3c59-9599-d5863b497f06",
                        "entry_id": "ac9b0f56-7af9-31e3-960c-db3b5ef96033",
                        "glosses": [
                            "Caractère de vérité qu’il y a dans un récit, dans un témoignage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c185d21-b1de-46b9-a225-62dd83ab0bd1",
                                "sense_id": "7db2aca4-3731-3c59-9599-d5863b497f06",
                                "text": "Certains conspirationnistes soutiennent que la véracité de chacun des éléments clés de la thèse officielle doit être démontrée hors de tout doute."
                            },
                            {
                                "example_id": "f8fc39fd-d64f-4f60-907a-f74bc17534fd",
                                "sense_id": "7db2aca4-3731-3c59-9599-d5863b497f06",
                                "text": "Par ailleurs, l’assignation devant le tribunal de commerce de Paris, et non devant un tribunal correctionnel, souligne la volonté de Vincent Bolloré de défendre son image, et non pas de contester la véracité des allégations portées dans le documentaire de France 2."
                            },
                            {
                                "example_id": "97be2b1c-c108-4e42-88d4-21192a9ac5db",
                                "sense_id": "7db2aca4-3731-3c59-9599-d5863b497f06",
                                "text": "Vérifiez la véracité de toute opportunité."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d3b4b9-97d4-3f24-818a-f880580024af",
                        "entry_id": "ac9b0f56-7af9-31e3-960c-db3b5ef96033",
                        "glosses": [
                            "Attribut de la Divinité et signifie que Dieu ne peut jamais tromper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "194d2a9c-deba-40ad-873b-c42ed704240d",
                                "sense_id": "c3d3b4b9-97d4-3f24-818a-f880580024af",
                                "text": "La véracité divine est un des principes de la philosophie de Descartes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84910fcf-f61f-4f05-b417-1fd6544021dc",
                        "source_entry_id": "ac9b0f56-7af9-31e3-960c-db3b5ef96033",
                        "target_lang_word": "veracity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veracity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe01a31-6058-3ad4-ba01-181e0b3639ed",
                                        "entry_id": "6c981f05-502e-37a1-ad36-91b719771caf",
                                        "glosses": [
                                            "The quality of speaking or stating the truth; truthfulness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bdefbf8-49ce-44a7-8c05-aa1786efd56a",
                                                "sense_id": "bfe01a31-6058-3ad4-ba01-181e0b3639ed",
                                                "text": "Of course if you don't accept Conway's story, it means that you doubt either his veracity or his sanity—one may as well be frank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20cc329-fbba-3037-835a-be77e3dcc226",
                                        "entry_id": "6c981f05-502e-37a1-ad36-91b719771caf",
                                        "glosses": [
                                            "Something that is true; a truthful statement; a truth."
                                        ],
