                    {
                        "sense_id": "818b8a27-94dd-3bb3-b6a5-8640640a5f3e",
                        "entry_id": "091d6267-c9c4-3241-a937-c962b256dc32",
                        "glosses": [
                            "Gesicht eines Babys"
                        ],
                        "tags": [],
