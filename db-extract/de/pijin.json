                        "sense_id": "a193b2f9-627c-3cf6-8a71-8bbc07a12e60",
                        "entry_id": "ee8c6d40-c6cc-39c9-a096-c676cc88c8f4",
                        "glosses": [
                            "eine auf den Salomonen gesprochene Sprache, die auf Englisch basiert"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6491934a-72e8-4a42-a42e-741ae577e29f",
                                "sense_id": "a193b2f9-627c-3cf6-8a71-8bbc07a12e60",
                                "text": "„Die Missionare fundamentalistischer Sekten haben einesteils für die Verbreitung des Pijin gesorgt, diese lingua franca an ihren Missionsschulen dann aber auch wieder verboten und reines Englisch gefordert.“"
                            },
                            {
                                "example_id": "ced6c0e5-fe7f-4710-8b3a-335b2a0ded06",
                                "sense_id": "a193b2f9-627c-3cf6-8a71-8bbc07a12e60",
                                "text": "„Die Solomon Islands Broadcasting Corporation (SIBC) gehört der Regierung und sendet als einzige Station Landesweit und auch in Pijin.“"
                            },
                            {
                                "example_id": "2284899e-455b-4bf5-a34c-1193cb84a1cb",
                                "sense_id": "a193b2f9-627c-3cf6-8a71-8bbc07a12e60",
                                "text": "„Afrikaans und Slovenisch sind hier Ausnahmen neben Lobiri, Pijin, Maori, Oromo etc.“"
                            }
                        ],
