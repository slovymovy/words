                ],
                "senses": [
                    {
                        "sense_id": "3a2063b9-c96a-33df-ac54-8f8c397dd8d4",
                        "entry_id": "29f6b957-56ca-3c80-8a85-462e6b02baf8",
                        "glosses": [
                            "Baver."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ffda6b96-52a2-41e0-b818-4d94eb31930b",
                                "sense_id": "3a2063b9-c96a-33df-ac54-8f8c397dd8d4",
                                "text": "Fasciné par la merveillosité de Madeleine Havouable, il bavouille et bafouille."
                            },
                            {
                                "example_id": "232c93b0-bf38-43bf-a9f5-0164831b9433",
                                "sense_id": "3a2063b9-c96a-33df-ac54-8f8c397dd8d4",
                                "text": "Gonzalo, lui-même, consent à agiter ses pieds chaussés de laine bleue, et à bavouiller un sourire en mon honneur."
                            },
                            {
                                "example_id": "f84b0bb2-1a92-4d4c-8447-7212c6aae38f",
                                "sense_id": "3a2063b9-c96a-33df-ac54-8f8c397dd8d4",
                                "text": "Jean-Edouard, qui assistait à la scène, n’ouvrit pas la bouche pour le faire taire mais sa colère se déversa brutalement sur Abel, ce sinistre crétin, qui lapait sa soupe en bout de table et qui avait le culot de ricaner en bavouillant."
                            }
                        ]
                    }
