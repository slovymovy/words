            {
                "entry_id": "24b47501-0060-3654-9559-d065e746166d",
                "word": "wyvern",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9edb23fb-63b8-4f87-ad3b-35f62759950f",
                        "entry_id": "24b47501-0060-3654-9559-d065e746166d",
                        "tags": [
                            "plural"
                        ],
                        "form": "wyverns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b0af5ff-fc30-37f3-b90d-ba15f84efce4",
                        "entry_id": "24b47501-0060-3654-9559-d065e746166d",
                        "glosses": [
                            "A draconian creature possessing wings, only two legs and usually a barbed tail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6eae8e1-cb81-40c1-874a-c663d5becebb",
                                "sense_id": "0b0af5ff-fc30-37f3-b90d-ba15f84efce4",
                                "text": "The jargon of heraldry, its griffins, its moldwarps, its wyverns, and its dragons."
                            },
                            {
                                "example_id": "0c069531-9c85-407f-ae36-198023506279",
                                "sense_id": "0b0af5ff-fc30-37f3-b90d-ba15f84efce4",
                                "text": "Notions of freedom are tied up in drink / Our ideal life contains a tavern / Where man may sit and talk of or just think / All without fear of the nighted wyvern, / Or yet another tavern where it appears."
                            },
                            {
                                "example_id": "925ad5b1-47d3-495b-9a3e-ab401936dccd",
                                "sense_id": "0b0af5ff-fc30-37f3-b90d-ba15f84efce4",
                                "text": "Above the shield was the well-known Midland crest of a legless wyvern (a wyvern normally has two legs)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e043496-d077-4dcc-bb1d-e96c5227d727",
                        "source_entry_id": "24b47501-0060-3654-9559-d065e746166d",
