                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwamvlok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "42919cc8-a5c0-382d-899a-299fd5173479",
                                        "entry_id": "f7d6e1be-7e65-3307-ab11-464c79d721dd",
                                        "glosses": [
                                            "netwerk van schimmeldraden"
                                        ],
                                        "tags": [
                                            "schimmels"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5517393-b791-4e42-a648-1ddda418f747",
                                                "sense_id": "42919cc8-a5c0-382d-899a-299fd5173479",
                                                "text": "Een drone is hartstikke handig om spionage mee te plegen, maar als hij in vijandelijke handen valt, is de tegenstander een drone rijker. Knappe koppen bij NASA hebben een exemplaar ontwikkeld van schimmel. Het apparaat bestaat om precies te zijn uit zwamvlok, een netwerk van schimmeldraden."
                                            },
                                            {
                                                "example_id": "fe3fb44b-859e-490c-9936-f7d7b783400a",
                                                "sense_id": "42919cc8-a5c0-382d-899a-299fd5173479",
                                                "text": "De paddenstoelen die nu al plots overal opduiken, is dan weer een reactie van de natuur op de aanhoudende regen van de voorbije dagen en weken. Net onder het aardoppervlakte zitten heel het jaar door zwamvlokken klaar, wachtend op de combinatie van aangename temperaturen en voldoende regen. Dat hebben we nu. Dus schieten overal paddenstoelen uit de grond.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4df8d5d1-2d2c-4164-b339-35623246141b",
                        "source_entry_id": "204429b9-8339-3284-bf73-d317d3452c0c",
                        "source_sense_id": "668f67ee-63e7-37d0-a504-0b6e628d85e9",
