                "senses": [
                    {
                        "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                        "entry_id": "94b91c83-6e9c-320e-a890-f32131b69987",
                        "glosses": [
                            "Zusammenschluss von Einzelgewerkschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b61aee5-b7aa-43b9-a80d-f2dad0f272e8",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Maradona ist Präsident des Gewerkschaftsverbands der Fußball-Profis und will sich als solcher selbst aufstellen.“"
                            },
                            {
                                "example_id": "2f050719-2a1e-46cb-98fa-7b95e7b1f395",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Denn diese Standards sollen erst nach und nach zwischen Arbeitgeber- und Gewerkschaftsverbänden erarbeitet werden.“"
                            },
                            {
                                "example_id": "ea1138d1-3baf-4cde-a76c-1d0b5010e30d",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Nachdem in den anderen Bundesländern Gehaltserhöhungen von 2,9 Prozent sowie dreimal 300 Euro vereinbart worden waren, haben mehrere Berliner Gewerkschaftsverbände den Tarifvertrag gekündigt und Innensenator Ehrhart Körting (SPD) zu Verhandlungen aufgefordert.“"
                            },
                            {
                                "example_id": "b6600e6b-084d-4ba8-b995-b24215971f3f",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Der Generalsekretär des großen portugiesischen Gewerkschaftsverband CGTP hatte am vergangenen Samstag in Lissabon einen Generalstreik angekündigt.“"
                            },
                            {
                                "example_id": "167219f6-e448-4912-87c1-1ed33278fe80",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Sowohl Boliviens Gewerkschaftsverband als auch die Arbeitgeber haben die Alterssenkung klar abgelehnt und kritisiert, dass die Regierung sie dazu nicht konsultiert habe.“"
                            },
                            {
                                "example_id": "d2182148-fbde-4296-9b39-0733b1752f2a",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Zu dem Protest hatten die italienischen Gewerkschaftsverbände aufgerufen.“"
                            },
                            {
                                "example_id": "4fb5432b-cdf2-416d-9d76-0ed84db6927c",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Neben dem Hüfinger Rathaus wurde nach dieser Entscheidung auch das Furtwanger Rathaus von Vertretern verschiedener Gewerkschaftsverbände angeschrieben.“"
                            },
                            {
                                "example_id": "71ed788a-6687-4e78-b018-7c36ba06d4c6",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„Einige Energiepolitiker der SP und der Präsident des Gewerkschaftsverbandes Travail Suisse sind darauf bereits eingegangen und haben sich für das Abkommen ausgesprochen.“"
                            },
                            {
                                "example_id": "0e788573-f4f5-4b2b-b8a2-19bcb96be970",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„In Blackpool beschließt der britische Gewerkschaftsverband TUC, Lohnforderungen in den kommenden zwölf Monaten auf 10% zu begrenzen.“"
                            },
                            {
                                "example_id": "af1093dd-17c3-4958-b707-21907e2d0dc0",
                                "sense_id": "7e7d12e0-5f5a-3b8e-bb6c-e143942c8ba9",
                                "text": "„In Paris veröffentlichen die Sozialistische und die Kommunistische Partei sowie die drei Gewerkschaftsverbände Aufrufe, in denen sie zur Verteidigung der Republik aufrufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
