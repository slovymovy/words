    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "26775569-8a85-351a-b7c9-fe7902a09ff5",
                    "sense_definition": "Being in a state of matter that is firm and keeps its shape, rather than being a liquid or gas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water becomes <w>solid</w> ice when the temperature drops below freezing.",
                            "target_lang_translations": {
                                "ru": "Вода превращается в <w>твёрдый</w> лёд, когда температура падает ниже нуля.",
                                "tr": "Sıcaklık donma noktasının altına düştüğünde su <w>katı</w> buz haline gelir.",
                                "zh": "当温度降至冰点以下时，水会变成<w>固体</w>冰。"
                            }
                        },
                        {
                            "text": "Almost all metals are <w>solid</w> at room temperature.",
                            "target_lang_translations": {
                                "ru": "Почти все металлы являются <w>твёрдыми</w> при комнатной температуре.",
                                "tr": "Neredeyse tüm metaller oda sıcaklığında <w>katı</w> haldedir.",
                                "zh": "几乎所有的金属在室温下都是<w>固体</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "liquid",
                        "gaseous"
                    ],
                    "common_phrases": [
                        "solid ice",
                        "solid rock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в агрегатном состоянии, которое является твердым и сохраняет свою форму, а не является жидкостью или газом.",
                        "tr": "Sıvı veya gaz olmak yerine, biçimini koruyan ve sert olan madde hali.",
                        "zh": "处于物质状态，坚硬且保持其形状，而不是液体或气体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твёрдый",
                                "target_lang_sense_clarification": "физическое состояние"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "katı",
                                "target_lang_sense_clarification": "maddenin hali"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "固体",
                                "target_lang_sense_clarification": "物理状态"
                            },
                            {
                                "target_lang_word": "固态",
                                "target_lang_sense_clarification": "物理状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "088b6e0e-350c-3b93-99df-2e35ede9d8f2",
                    "sense_definition": "Made of the same material throughout, without any holes or empty spaces inside.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a necklace made of <w>solid</w> gold.",
                            "target_lang_translations": {
                                "ru": "На ней было ожерелье из <w>чистого</w> золота.",
                                "tr": "<w>Som</w> altından yapılmış bir kolye takıyordu.",
                                "zh": "她戴着一条<w>纯</w>金项链。"
                            }
                        },
                        {
                            "text": "The table was heavy because it was made of <w>solid</w> wood.",
                            "target_lang_translations": {
                                "ru": "Стол был тяжелым, потому что был сделан из <w>цельного</w> дерева.",
                                "tr": "Masa ağırdı çünkü <w>masif</w> ahşaptan yapılmıştı.",
                                "zh": "这张桌子很重，因为它是用<w>实心</w>木头做的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "massive"
                    ],
                    "antonyms": [
                        "hollow"
                    ],
                    "common_phrases": [
                        "solid gold",
                        "solid wood",
                        "solid silver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготовленный полностью из одного и того же материала, без отверстий или пустых пространств внутри.",
                        "tr": "İçinde boşluk veya delik bulunmayan, tamamen aynı malzemeden yapılmış.",
                        "zh": "通体由同一种材料制成，内部没有任何孔洞或空隙。"
                    },
                    "translations": {
                        "ru": [
