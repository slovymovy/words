                "senses": [
                    {
                        "sense_id": "6970dba0-495f-3270-885b-7babe939bfae",
                        "entry_id": "f8f16946-4ab8-330d-a983-9ea0a48856c3",
                        "glosses": [
                            "działanie z zastosowaniem przemocy mające na celu zastraszenie drugiego człowieka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f0312c-e10b-4663-9aff-5633d68b1310",
                                "sense_id": "6970dba0-495f-3270-885b-7babe939bfae",
                                "text": "Uzurpator utrzymał się na tronie pięć lat, szerząc w państwie terror, opierając się na potędze Asyrii."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c569c26e-d460-496f-a336-b5cb93f092d1",
                        "source_entry_id": "f8f16946-4ab8-330d-a983-9ea0a48856c3",
                        "source_sense_id": "6970dba0-495f-3270-885b-7babe939bfae",
                        "target_lang_word": "terror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Intense dread, fright, or fear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabdba5a-06db-4876-9ad2-c79a34c27a6d",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "\"How thinkest thou that I rule this people? I have but a regiment of guards to do my bidding, therefore it is not by force. It is by terror. My empire is of the imagination.\""
                                            },
                                            {
                                                "example_id": "020f42f0-0214-4fab-9570-ba2c04d09bef",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "The terrors with which I was seized […] were extreme."
                                            },
                                            {
                                                "example_id": "04080c1a-eb8b-4907-b683-0bc067a17f49",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "Fear of their cargo bred a savage cruelty into the crew. One captain, to strike terror into the rest, killed a slave and dividing heart, liver and entrails into 300 pieces made each of the slaves eat one, threatening those who refused with the same torture. Such incidents were not rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70f8dd0-2847-32dd-a3ee-ce3810211a8b",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "The action or quality of causing dread; terribleness, especially such qualities in narrative fiction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Something or someone that causes such fear."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35afdbab-ad88-419c-b67d-cb5c2315f934",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "The Begums' ministers, on the contrary, to extort from them the disclosure of the place which concealed the treasures, were, […] after being fettered and imprisoned, led out on to a scaffold, and this array of terrours proving unavailing, the meek tempered Middleton, as a dernier resort, menaced them with a confinement in the fortress of Chunargar. Thus, my lords, was a British garrison made the climax of cruelties!"
                                            },
                                            {
                                                "example_id": "dc3f0cd8-2604-489c-aa2a-d410ed687f85",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "The terrors of the storm"
                                            },
                                            {
                                                "example_id": "923288e4-79e1-4dc4-a16c-beb35aecea83",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "A chap named Eleazir Kendrick and I had chummed in together the summer afore and built a fish-weir and shanty at Setuckit Point, down Orham way. For a spell we done pretty well. Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Terrorism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73de9df-6d74-4d6e-ae2d-964f74fd4691",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "a terror attack"
                                            },
                                            {
                                                "example_id": "86bffb05-5e79-4808-b0af-e1fb163f71ef",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "the War on Terror"
                                            },
                                            {
                                                "example_id": "8b4cc247-41ab-4a15-802e-4bfcc9e51db4",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "Rank-and-file progressives don’t usually think of the immigration policies they support—expanding refugee quotas, easing restrictions on some classes of immigrants, and ending family separation—as an endorsement of detention, deportation, and racialized terror."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd089fd2-98ca-3087-b19b-71216dd6ff52",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "A night terror."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "terror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc657e79-8ced-3f1f-9757-2f7ae7bf0705",
                                        "entry_id": "7662ffa1-702a-3444-94bd-a1d9cefd81d0",
                                        "glosses": [
                                            "A strict teacher who fails most of the students."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2354b730-5a18-46ff-a943-baf3be40d4ab",
                                                "sense_id": "fc657e79-8ced-3f1f-9757-2f7ae7bf0705",
                                                "text": "I have a terror math teacher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6c1f55d-368b-4235-a710-4a56ec5d93a2",
                        "source_entry_id": "f8f16946-4ab8-330d-a983-9ea0a48856c3",
                        "source_sense_id": "6970dba0-495f-3270-885b-7babe939bfae",
                        "target_lang_word": "террор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "террор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "03e7aef9-0674-3fc0-b5b5-eb96fd3bb522",
                                        "entry_id": "28619e3e-6e01-355e-b86a-a0d70a4ea7ac",
                                        "glosses": [
                                            "применение силы или угроза её применения в политических целях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9018955c-07aa-4fed-934b-34ef35cb9625",
                                                "sense_id": "03e7aef9-0674-3fc0-b5b5-eb96fd3bb522",
                                                "text": "Советская опричнина убивала и мучила всех не столько в силу звериного ожесточения, непосредственно появлявшегося во время боя, сколько под влиянием направляющей сверху руки, возводившей террор в систему и видевшей в нём единственное средство сохранить своё существование и власть над страной. Террор у них не прятался стыдливо за «стихию», «народный гнев» и прочие безответственные элементы психологии масс — он шествовал нагло и беззастенчиво."
                                            },
                                            {
                                                "example_id": "696124a4-5df9-42a8-9235-f96f1da1f6d4",
                                                "sense_id": "03e7aef9-0674-3fc0-b5b5-eb96fd3bb522",
                                                "text": "Когда деспоты возвращаются к террору, можно спать спокойно. Тут уж точно нет никакого подвоха."
                                            },
                                            {
                                                "example_id": "f1b1d35b-a7fa-4a34-b39a-f95f075c1a1e",
                                                "sense_id": "03e7aef9-0674-3fc0-b5b5-eb96fd3bb522",
                                                "text": "Сильная власть не боится собственных граждан, не насаждает атмосферу всеобщей подозрительности и доносов, не устраняет путем тотального террора любое свободное изъявление мысли. Вообще террор в любом проявлении является наиболее простым и грубым, но при этом крайне неэффективным и бесперспективным способом регулирования общественной жизни, в конечном счёте проявлением слабости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081dd097-7829-3734-a0d6-eea390935cea",
                                        "entry_id": "28619e3e-6e01-355e-b86a-a0d70a4ea7ac",
                                        "glosses": [
                                            "убийства, похищения, диверсии как средство достижения каких-либо целей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7b85806-4544-4588-88d8-67b542922cef",
                                                "sense_id": "081dd097-7829-3734-a0d6-eea390935cea",
                                                "text": "И никогда зло не было истреблено, как уже указано, никакими карами и насилиями; напротив, всегда, когда насилие мнит себя всемогущим и мечтает действительно уничтожить зло (а не только обуздать его, оградить жизнь от него), оно всегда плодит и умножает зло; свидетельство тому — действие всякого террора (откуда бы он ни исходил и во имя чего бы ни совершался), всякой фанатической попытки истребить зло в лице самих злодеев; такой террор рождает вокруг себя новое озлобление, слепые страсти мести и ненависти."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
