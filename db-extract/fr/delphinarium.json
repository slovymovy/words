                        "entry_id": "4bfa26f7-9df9-32a9-a495-1746ff6ff576",
                        "glosses": [
                            "Aquarium d’eau de mer dans lequel sont placés, élevés et présentés des dauphins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a7281f-0776-43bb-a2c2-f40e13839cf5",
                                "sense_id": "067f3e40-eff7-39b7-a60f-86457e84e2d8",
                                "text": "Un delphinarium dans lequel nagent des grands dauphins et leurs delphineaux."
                            },
                            {
                                "example_id": "89f04116-1244-49bd-8e4a-e013ec4dbb89",
                                "sense_id": "067f3e40-eff7-39b7-a60f-86457e84e2d8",
                                "text": "Sur la place centrale du parc zoologique seront situés un delphinarium, un musée paléontologique et une arène pour 10 000 spectateurs."
                            }
                        ]
                    }
                ],
