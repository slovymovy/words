                "translations": [
                    {
                        "translation_id": "c2596309-eebd-4a37-8412-e04832bc7ec9",
                        "source_entry_id": "8d90656f-fa02-3831-ba4b-d427ac28b2d0",
                        "source_sense_id": "b4760bc8-dcea-3ee8-adfc-f898729b7a36",
                        "target_lang_word": "ricer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ricer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b208a154-8c1f-3a23-8a8c-5d50ea42c6cd",
                                        "entry_id": "67e8ee52-ae5d-39e4-a8d6-0fdffac187a1",
                                        "glosses": [
                                            "A person, especially a Native American, who cultivates and harvests rice."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f4b622-84f2-4d73-bf19-0a0e95d9b917",
                                                "sense_id": "b208a154-8c1f-3a23-8a8c-5d50ea42c6cd",
                                                "text": "He opened the cashbox and counted out the money, and Martin handed it on to one of the ricers.\n\"Where are you guys ricing tomorrow?\" he said.\n\"Down in the Refuge,\" the ricer with the money said."
                                            },
                                            {
                                                "example_id": "8b15da20-c35b-4b7b-ae32-0bac67d2f4b3",
                                                "sense_id": "b208a154-8c1f-3a23-8a8c-5d50ea42c6cd",
                                                "text": "In exchange for use of a buyer's boat, the ricers were to sell what they harvested exclusively to him."
                                            },
                                            {
                                                "example_id": "89af3792-b359-4389-8e87-f18668ccb1c5",
                                                "sense_id": "b208a154-8c1f-3a23-8a8c-5d50ea42c6cd",
                                                "text": "There are also lots of ricers. By two weeks into ricing season, Native Harvest bought from 30 or 40 ricers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "466f3d9a-fd45-33a3-9c41-589207cffaf4",
                                        "entry_id": "67e8ee52-ae5d-39e4-a8d6-0fdffac187a1",
                                        "glosses": [
                                            "A utensil used to extrude soft foods (especially, cooked potato) through holes about the diameter of a grain of rice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44eab438-c820-4ff3-8885-81a3531a4814",
                                                "sense_id": "466f3d9a-fd45-33a3-9c41-589207cffaf4",
                                                "text": "He cooked a roast, made applesauce with the ricer and used every size pan he could find to cook vegetables."
                                            },
                                            {
                                                "example_id": "e21051db-ec45-442f-b3af-4fdef26b3b55",
                                                "sense_id": "466f3d9a-fd45-33a3-9c41-589207cffaf4",
                                                "text": "Ricers can also be used for mashing other root vegetables, as well as starchy ones like broad (fava) beans and peas."
                                            },
                                            {
                                                "example_id": "1498528d-50fd-449a-bc5d-5e4b2991ccc1",
                                                "sense_id": "466f3d9a-fd45-33a3-9c41-589207cffaf4",
                                                "text": "Passing cooked chunks through a basic, inexpensive handheld ricer maximizes their texture, which is less starchy than their russet brethren, and makes a soft, dry pile that simply stirs into creamy, smooth mounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41f43316-566f-3718-92db-5f88e93a8ba6",
                                        "entry_id": "67e8ee52-ae5d-39e4-a8d6-0fdffac187a1",
                                        "glosses": [
                                            "An automobile, especially one imported from an Oriental country, deemed inferior or cheap, that has been modified with after-market parts in order to appear more powerful or sporty."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3fd5150-fc20-3518-9738-76d99890cec3",
                                        "entry_id": "67e8ee52-ae5d-39e4-a8d6-0fdffac187a1",
                                        "glosses": [
                                            "A person who drives such an automobile."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
