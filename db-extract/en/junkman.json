                                        "glosses": [
                                            "Person, die mit alten, nicht wertvollen Sachen/Trödel handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bf2eedb-cf49-41f4-8937-fcfbeead7241",
                                                "sense_id": "4e18cc84-070a-3a8a-8623-c4dc3da2ef5b",
                                                "text": "„Neulich hielt ich vor dem Ausstellungsgelände eines Trödlers in der Nähe von Sag Harbor.“"
                                            },
                                            {
                                                "example_id": "6556c8eb-252d-4a2f-8293-fa92942218dc",
                                                "sense_id": "4e18cc84-070a-3a8a-8623-c4dc3da2ef5b",
                                                "text": "„Der Trödler fragte mich, ob ich alte oder ganz neue Kleider haben wollte.“"
                                            },
                                            {
                                                "example_id": "11689490-c7f0-41a5-a37b-5b4ccb86184f",
                                                "sense_id": "4e18cc84-070a-3a8a-8623-c4dc3da2ef5b",
                                                "text": "„Der Trödler, der zunächst gleichgültig über das gestempelte Papier hinweggeschielt hatte, schien plötzlich zu begreifen, was es damit für eine Bewandtnis hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dfd0ed7d-33bf-3dba-8ff8-0b779e3db722",
                                        "entry_id": "03ead5ce-2ae9-34a0-a518-09f1a2138f0a",
                                        "glosses": [
                                            "Person, die übermäßig viel Zeit für etwas benötigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
