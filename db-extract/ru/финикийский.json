                    },
                    {
                        "translation_id": "679e3564-ccd6-4580-8640-94ca7b38879e",
                        "source_entry_id": "aa567f71-32eb-32c7-abe3-7b57f2c98fd8",
                        "target_lang_word": "phönizisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phönizisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f89a01c-7a6b-3532-81e8-e08b325c52be",
                                        "entry_id": "fd9490bf-962b-3136-960a-326acfe0541f",
                                        "glosses": [
                                            "die Phönizier, Phönizien betreffend; zu den Phöniziern, zu Phönizien gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad37ff09-fdd8-4ffe-97a4-ec4fb90b8066",
                                                "sense_id": "0f89a01c-7a6b-3532-81e8-e08b325c52be",
                                                "text": "Karthago wurde im 8. oder 9. Jahrhundert v. Chr. von phönizischen Siedlern aus Tyros gegründet."
                                            },
                                            {
                                                "example_id": "04132618-e675-47e9-a7f5-1753dd3ad6e2",
                                                "sense_id": "0f89a01c-7a6b-3532-81e8-e08b325c52be",
                                                "text": "Karthago befand sich an der wichtigsten phönizischen Handelsroute zwischen der Levante und Gibraltar."
                                            },
                                            {
                                                "example_id": "06efa136-b6cb-4732-a3da-0defad448fca",
                                                "sense_id": "0f89a01c-7a6b-3532-81e8-e08b325c52be",
                                                "text": "Leptis Magna, ursprünglich Lepcis Magna geschrieben, scheint die Erste der phönizischen Stadtgründungen im späteren Tripolitanien gewesen zu sein, auch wenn kein konkretes Baudatum überliefert ist."
                                            },
                                            {
                                                "example_id": "cbffa2d1-e271-4b3e-91ed-d44787330a38",
                                                "sense_id": "0f89a01c-7a6b-3532-81e8-e08b325c52be",
                                                "text": "Besonders wichtig ist die Ankunft des Kadmus, phönizischen Ursprungs, mit dem die Buchstabenschrift nach Griechenland gekommen sein soll; von ihr sagt Herodot, daß sie phönizisch gewesen sei, und alte, damals noch vorhandene Inschriften werden angeführt, um die Behauptung zu unterstützen."
                                            },
                                            {
                                                "example_id": "4ec2345e-e8e8-4f3b-b776-3e0e6d4260ff",
                                                "sense_id": "0f89a01c-7a6b-3532-81e8-e08b325c52be",
                                                "text": "Die Constitution der Polis ist eine phönizische Erfindung: selbst dies haben die Hellenen nachgemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
