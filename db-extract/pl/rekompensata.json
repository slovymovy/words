                "senses": [
                    {
                        "sense_id": "a865f05c-2f54-3d25-8251-daaafabea578",
                        "entry_id": "38c99737-e7ff-3ae7-90cc-088bf398d942",
                        "glosses": [
                            "wyrównanie poniesionych strat czy szkód"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd81bfe-387b-4031-a56e-d371da5c2f2f",
                                "sense_id": "a865f05c-2f54-3d25-8251-daaafabea578",
                                "text": "W ramach rekompensaty zabiorę was do akwaparku."
                            },
                            {
                                "example_id": "73ff7f71-8c62-487e-b60e-1a35e5e6ec3d",
                                "sense_id": "a865f05c-2f54-3d25-8251-daaafabea578",
                                "text": ", Gazeta Wyborcza, 21.08.1998."
                            },
                            {
                                "example_id": "bf10d805-2f6b-41b5-ad8f-27980ded7d8f",
                                "sense_id": "a865f05c-2f54-3d25-8251-daaafabea578",
                                "text": "Polska będzie ubiegać się o rekompensatę od Unii Europejskiej za czołgi, które zamierza przekazać w ramach pomocy Ukrainie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f8c23e4-bca9-4aae-981b-d21688bd717e",
                        "source_entry_id": "38c99737-e7ff-3ae7-90cc-088bf398d942",
                        "source_sense_id": "a865f05c-2f54-3d25-8251-daaafabea578",
                        "target_lang_word": "compensation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compensation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "660eff43-db2c-387b-871b-f002215de9de",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The act or principle of compensating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e25132c-91f7-4b14-a46f-194bf81804d9",
                                                "sense_id": "660eff43-db2c-387b-871b-f002215de9de",
                                                "text": "Human labor, through all its forms, from the sharpening of a stake to the construction of a city or an epic, is one immense illustration of the perfect compensation of the universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56288dae-ba36-33d3-80a1-ef200e3bbda8",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "Something which is regarded as an equivalent; something which compensates for loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e057567-a91d-4e62-aae3-193302460541",
                                                "sense_id": "56288dae-ba36-33d3-80a1-ef200e3bbda8",
                                                "text": "The parliament which dissolved the monastic foundations […] vouchsafed not a word toward securing the slightest compensation to the dispossessed owners."
                                            },
                                            {
                                                "example_id": "c39a795f-5bd2-4b9b-96ac-6d01ded75b6b",
                                                "sense_id": "56288dae-ba36-33d3-80a1-ef200e3bbda8",
                                                "text": "No pecuniary compensation can possibly reward them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8069b45b-f696-31fd-ad7b-e9d7e5355639",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The extinction of debts of which two persons are reciprocally debtors by the credits of which they are reciprocally creditors; the payment of a debt by a credit of equal amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df6d9c09-8c2a-30ea-a4cc-32558a684ce0",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "A recompense or reward for service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ea090c9-babd-332a-9aa1-08fa55e3dbde",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "An equivalent stipulated for in contracts for the sale of real estate, in which it is customary to provide that errors in description, etc., shall not avoid, but shall be the subject of compensation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d24f41c5-5a60-31ed-b6d6-1b0303287411",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The relationship between air temperature outside a building and a calculated target temperature for provision of air or water to contained rooms or spaces for the purpose of efficient heating. In building control systems, the compensation curve is defined to a compensator for this purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9a2cb70-dac7-3e71-a05c-7399dfe3ae5e",
                                        "entry_id": "7c51177e-2232-3063-a702-91ac60b8b7c8",
                                        "glosses": [
                                            "The ability of one part of the brain to overfunction in order to take over the function of a damaged part (e.g. following a stroke)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3bcf0bf-029e-490a-94c7-01e8c612c4ac",
                        "source_entry_id": "38c99737-e7ff-3ae7-90cc-088bf398d942",
                        "source_sense_id": "a865f05c-2f54-3d25-8251-daaafabea578",
                        "target_lang_word": "reparation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reparation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                        "entry_id": "c3afe225-785b-375e-a253-464c26832b13",
                                        "glosses": [
                                            "A payment of time, effort or money to compensate for past transgression(s)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6b4d83c-20ff-46a4-8e08-1012936a96cd",
                                                "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                                "text": "I am sensible of the scandal I have given by my loose writings, and make what reparation I am able."
                                            },
                                            {
                                                "example_id": "4a411a7e-a015-4bc5-bffa-4300ee67561a",
                                                "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                                "text": "A feature of locomotive operation on the Region de l'Est of the French National Railways, not only on the old Alsace-Lorraine lines, but also on the Est proper, is the wide use still made of ex-German engines received as reparations after the 1914-19 war."
                                            },
                                            {
                                                "example_id": "06530aab-00cb-4f8c-924e-667434bdd839",
                                                "sense_id": "f00e9f92-a618-3fce-b23a-14a6e0050deb",
                                                "text": "Biotic Leader: So how about if I kill Chairman Burns and finish this charade?\nChairman Burns: Please! I was trying to help you people!\nShepard: Let's not do anything we're all going to regret.\nBiotic Leader: Why not? What have we got to lose?\nBiotic Leader: Since the chairman here decided we didn't get reparations, we've got nothing left to live for!\nChairman Burns: But I've changed my mind! Seeing y-you all, it's c-clear that you all d-deserve...\nBiotic Leader: You had your chance! Some L2s are nearly crippled from side effects of the implants, but you voted against reparations!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c83cf2-c898-350a-9938-83e702a5f217",
                                        "entry_id": "c3afe225-785b-375e-a253-464c26832b13",
                                        "glosses": [
                                            "The act of renewing, restoring, etc., or the state of being renewed or repaired."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b1a92c-53d9-476a-b88e-f59e9ede28d8",
                                                "sense_id": "06c83cf2-c898-350a-9938-83e702a5f217",
                                                "text": "the reparation of a bridge or of a highway"
                                            },
                                            {
                                                "example_id": "1a1eeb24-cd3d-454e-a4f4-19c3467b1b94",
                                                "sense_id": "06c83cf2-c898-350a-9938-83e702a5f217",
                                                "text": "The church at Lichfield, in which we had a seat, wanted reparation, so I was to go and find a seat in other churches; and having bad eyes, and being awkward about this, I used to go and read in the fields on Sunday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c98674bc-5ae8-403a-90db-4fd11a25a2ff",
                        "source_entry_id": "38c99737-e7ff-3ae7-90cc-088bf398d942",
                        "source_sense_id": "a865f05c-2f54-3d25-8251-daaafabea578",
                        "target_lang_word": "indemnité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indemnité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                        "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                                        "glosses": [
                                            "Ce qu’on alloue à quelqu’un en vue de l’indemniser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57764311-45c3-4fb7-a9e3-585e8372ea09",
                                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                                "text": "Le ministre du Travail, Olivier Dussopt, a annoncé sur France 3 que la concertation sur la réforme de l’assurance-chômage, qui doit faire varier les indemnités versées en fonction de la conjoncture, sera ouverte « dans une dizaine de jours »."
                                            },
                                            {
                                                "example_id": "6c35c7c7-8223-493b-a286-efec77bcc263",
                                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                                "text": "Une indemnité d'encouragement fut votée, séance tenante, en faveur du docteur Fergusson, et s'éleva au chiffre de deux mille cinq cents livres."
                                            },
                                            {
                                                "example_id": "a4cbd59f-f231-4031-a5d3-f2d33b4cc7e4",
                                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                                "text": "Mouley El Hassan avait achevé de payer à l’Espagne 120 millions de pesetas d’indemnité de guerre pour les campagnes de Tetuan (1859-60) et de Melilla (1893) et avait laissé à son fils un bit el-mal contenant 60 millions."
                                            },
                                            {
                                                "example_id": "f393bdc7-7ec3-4622-88c8-1a295e1fc72e",
                                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                                "text": "En cas de cessation de ses relations avec le mandant, l’agent commercial a droit à une indemnité compensatrice en réparation du préjudice subi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4033821f-b068-3499-97f1-5d839d2eb77b",
                                        "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                                        "glosses": [
                                            "Sommes allouées à certains fonctionnaires et qui ne sont pas soumises à la retenue pour la retraite."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce5a9a6c-405f-4f91-bf94-e81b1a6515f6",
                                                "sense_id": "4033821f-b068-3499-97f1-5d839d2eb77b",
                                                "text": "Il avait vingt mille francs d’appointements et cinq mille francs d’indemnité."
                                            },
                                            {
                                                "example_id": "d7c6def0-768b-4019-824f-537daf6b7d01",
                                                "sense_id": "4033821f-b068-3499-97f1-5d839d2eb77b",
                                                "text": "Note : C’est dans ce sens qu’on dit également Indemnité de résidence, indemnité de vie chère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bbc46b7-d1ee-37ee-8c5b-19c4ec7bdeb2",
                                        "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                                        "glosses": [
