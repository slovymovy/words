                        "sense_id": "365ce65b-26d5-3973-8c5d-ceee1094f63a",
                        "entry_id": "ac263d21-c391-3111-9e99-b47b2855cf9d",
                        "glosses": [
                            "Personne qui vit seule dans la nature, à l'écart du monde, hermite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2dee721-f74a-4ac0-99b5-2eb37c81b9ee",
                                "sense_id": "365ce65b-26d5-3973-8c5d-ceee1094f63a",
                                "text": "Ils auraient voulu, comme deux Robinsons, vivre perpétuellement dans ce petit endroit, qui leur semblait, en leur béatitude, le plus magnifique de la terre."
                            },
                            {
                                "example_id": "b8bb10b9-4f82-452d-9311-ca5a1a17c2a6",
                                "sense_id": "365ce65b-26d5-3973-8c5d-ceee1094f63a",
                                "text": "Une île déserte ! Nous sommes deux Robinsons !"
                            }
                        ]
                    }
                ],
