                        "form": "das Postamt"
                    },
                    {
                        "form_id": "89024163-9ca6-44cb-9617-e0c8f5b2b6fa",
                        "entry_id": "30585712-0102-32be-9d1b-3c01f214c88b",
                        "tags": [
                            "accusative",
