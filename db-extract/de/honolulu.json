                ],
                "senses": [
                    {
                        "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                        "entry_id": "1801287c-f390-3535-b369-61d994956d00",
                        "glosses": [
                            "auf der Insel Oʻahu gelegene Hauptstadt des US-Bundesstaats Hawaii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a8b01aa-54e6-47bb-910c-c26f6ea48ead",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "Vor seiner Abreise nach Honolulu bekam Jan überraschend Besuch von den Feldjägern der Bundeswehr."
                            },
                            {
                                "example_id": "254ae545-cfdc-4835-a9ed-98422063677e",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "Herr Lotze verliebte sich unmittelbar nach seiner Ankunft am Honolulu International Airport in das bezaubernde Honolulu und weigert sich seitdem standhaft, es wieder zu verlassen."
                            },
                            {
                                "example_id": "8a4d372e-8b33-4abd-8860-098639acdb7a",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "„2225 Seemeilen Abenteuer lagen hinter ihm, doch wirklich freuen konnte er sich nicht, denn was er auf dem Rückweg von Honolulu zu Gesicht bekam, ließ ihn erschaudern. Eine schwimmende Müllkippe auf dem offenen Ozean.“"
                            },
                            {
                                "example_id": "44fff82a-15d3-4216-9957-b02d2c938f9e",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "Harald und seine Tante Marie bewohnen eine großzügige Villa bei Honolulu, die Marie vor Jahren in einem Preisausschreiben gewonnen hat."
                            },
                            {
                                "example_id": "fb09bf43-8da3-4c15-be66-7e956ca6ee6f",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "Honolulu hat viele Sehenswürdigkeiten zu bieten, die jeden Reisenden verzücken."
                            },
                            {
                                "example_id": "bfee45ef-555f-4e06-acfb-12dddb579c8c",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "„Das Weiße Haus machte am Mittwoch erstmals eine Kopie der vollständigen Urkunde öffentlich, aus der hervorgeht, dass Obama am 4. August 1961 um 19.24 Uhr in Honolulu im US-Staat Hawaii das Licht der Welt erblickte.“"
                            },
                            {
                                "example_id": "70cc5e1a-f1bc-4771-80ee-28bb383e39c7",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "Brians und Nicoles Spaziergang durch Honolulus Innenstadt geriet zum Fiasko, nachdem Nicole schon nach wenigen Metern mit einem ihrer Flipflops in einem Gully hängen blieb, ihn nicht mehr herausbekam und sich daraufhin trotzig und schmollend auf den Boden setzte, bis Brian sie ins Hotel zurücktrug."
                            },
                            {
                                "example_id": "f5e9c59a-16ea-4ec7-9839-7428cb3df54c",
                                "sense_id": "6a1e6e65-070c-3895-9b00-727e2703ce17",
                                "text": "In seinem Sommerurlaub bestaunt Werner alljährlich den Nachthimmel über Honolulu und ist zu Tränen gerührt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
