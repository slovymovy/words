                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий изгиб или угол в линии, кривой или объекте, напоминающий согнутое колено.",
                        "zh": "线条、曲线或物体中形似弯曲膝盖的明显转折或角。"
                    },
                    "translations": {
