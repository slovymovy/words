                    {
                        "sense_id": "c0bcbb51-1f7e-3f24-b5cc-6cc5fdc707b9",
                        "entry_id": "4c180feb-aee6-3404-88f8-5220f3452121",
                        "glosses": [
                            "geluid gemaakt door een orgel"
