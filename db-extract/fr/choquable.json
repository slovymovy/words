                        "sense_id": "56c9d227-9d70-3e33-ad16-7c4e48cd0b9c",
                        "entry_id": "c13b203c-d3ca-38a1-9934-44ebde0e1b89",
                        "glosses": [
                            "À quoi l’on peut appliquer un choc physique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5839b62-7d94-4a6a-b63f-386527937231",
                                "sense_id": "56c9d227-9d70-3e33-ad16-7c4e48cd0b9c",
                                "text": "Pour donner à la bille 2 une impulsion équivalente à la moitié de celle qu’a reçue la bille 1, il faut prendre le point de choc à la moitié de la partie choquable; …"
                            }
                        ]
                    },
                    {
                        "sense_id": "d3ca7c7a-bb43-32e3-b307-7ef6b04168a8",
                        "entry_id": "c13b203c-d3ca-38a1-9934-44ebde0e1b89",
                        "glosses": [
                            "Que l’on peut choquer moralement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac81b81a-49f7-4172-a2e8-f7cbc44e235e",
                                "sense_id": "d3ca7c7a-bb43-32e3-b307-7ef6b04168a8",
                                "text": "Je ne suis pas beaucoup choquable, et cependant je me trouvai choqué d’être si mal reçu, et m’en fus chez nous remiser ma carriole et m’informer de ma famille."
                            },
                            {
                                "example_id": "0dedad19-adee-4046-91bd-0bd4653cbd8e",
                                "sense_id": "d3ca7c7a-bb43-32e3-b307-7ef6b04168a8",
                                "text": "Mais non, je vous assure, disait Odette, je suis au fond une petite bourgeoise très choquable, pleine de préjugés, vivant dans son trou, surtout très ignorante."
                            }
                        ]
                    },
                    {
                        "sense_id": "209cc4bf-cd67-374a-901f-0cfdffaae7e5",
                        "entry_id": "c13b203c-d3ca-38a1-9934-44ebde0e1b89",
                        "glosses": [
                            "Qui peut être traité par choc électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a088ba09-c27b-4d92-bbb2-32f86766da9b",
                                "sense_id": "209cc4bf-cd67-374a-901f-0cfdffaae7e5",
                                "text": "La défibrillation correspond à l’application d’un choc électrique externe, …. La défibrillation est proposée pour les rythmes dits « choquables » (fibrillation ventriculaire ou tachycardie ventriculaire sans pouls) …. Elle n’a aucun intérêt et ne doit pas être réalisée si le rythme cardiaque est « non choquable » (asystolie, dissociation électromécanique)."
                            }
                        ]
                    }
