                "translations": [
                    {
                        "translation_id": "31ef16af-3e97-475d-827b-f18a98178b4c",
                        "source_entry_id": "3135aa6c-ee28-3e73-b54d-c8bfd8ef2f8c",
                        "target_lang_word": "gargoyle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gargoyle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d04ac34f-15bf-33e8-94d8-0ad6970cf4d0",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "A carved grotesque figure on a spout which conveys water away from the gutters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e8f946-5759-443d-a142-7c97f6160c62",
                                                "sense_id": "d04ac34f-15bf-33e8-94d8-0ad6970cf4d0",
                                                "text": "As we went, however, I took the precaution of noting our route as well as I could; and this was not so very difficult, owing to the extraordinary and most fantastic shape of the rocks that were strewn about, many of which in that dim light looked more like the grim faces carven upon mediæval gargoyles than ordinary boulders."
                                            },
                                            {
                                                "example_id": "1bc3dd15-0361-4b6f-9d5d-8a211eeb914a",
                                                "sense_id": "d04ac34f-15bf-33e8-94d8-0ad6970cf4d0",
                                                "text": "From between set teeth came now a flow of oaths and imprecations as steady as the flow of water from the gargoyle overhead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5eaea0-7c29-3c82-8e6b-ec5537568d83",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "Any decorative carved grotesque figure on a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e32f4bc-de13-42a3-83ca-19851038dea5",
                                                "sense_id": "6f5eaea0-7c29-3c82-8e6b-ec5537568d83",
                                                "text": "The long-closed G.W.R. station alongside has a decidedly derelict-looking frontage, with eight gargoyles or figureheads still clinging to the portico."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7506901-6745-3997-86b4-115b263255f7",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "A fictional winged monster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d6c86d-2e24-4efb-9dfd-a7d2aca7beb1",
                                                "sense_id": "d7506901-6745-3997-86b4-115b263255f7",
                                                "text": "Almost immediately one of the gargoyles swept down from the sky and attacked him. The gargoyle's momentum drove them both over the side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24cb43c-c9dd-30bf-84fe-e980f133ba1b",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "An ugly woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a46520-84ad-4955-b7e5-a0d27aaa63df",
                                                "sense_id": "b24cb43c-c9dd-30bf-84fe-e980f133ba1b",
                                                "text": "Above all, in what reckless moment had she encouraged that person and her gargoyle of a mother to move to Mayfair, and set up house around the corner?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
