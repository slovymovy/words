                ],
                "senses": [
                    {
                        "sense_id": "4edce408-347c-3b15-b87c-dbf0a421eee4",
                        "entry_id": "862f046c-63de-34e2-9e46-9c162607f411",
                        "glosses": [
                            "совер. к гудеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8a546e-fe8b-4ecc-a5c3-35f8c4e75e9d",
                                "sense_id": "4edce408-347c-3b15-b87c-dbf0a421eee4",
                                "text": "Гудок прогудел на работу. Прогудел басом над самым ухом."
                            },
                            {
                                "example_id": "93692187-78e7-4451-923e-378ba804db48",
                                "sense_id": "4edce408-347c-3b15-b87c-dbf0a421eee4",
                                "text": "А я как котец стал — слепенький, глухонький. Бывает, что нет сил даже заснуть, — прогудел старик в ответ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c05502a-caa0-3db4-806c-39c9f52b5f2c",
                        "entry_id": "862f046c-63de-34e2-9e46-9c162607f411",
                        "glosses": [
                            "разг. утомить шумом, надоесть разговорами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7000c8-7a94-4e51-97f2-8bd82e92538a",
                                "sense_id": "5c05502a-caa0-3db4-806c-39c9f52b5f2c",
                                "text": "Ты мне все уши прогудел."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe2fee8b-3f45-3e92-ba5d-5f494ef30d49",
                        "entry_id": "862f046c-63de-34e2-9e46-9c162607f411",
                        "glosses": [
                            "провести какое-нибудь определенное время, гудя."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7cd1288-3bd1-4f46-87c0-05849aaa65b7",
                                "sense_id": "fe2fee8b-3f45-3e92-ba5d-5f494ef30d49",
                                "text": "Гудок прогудел две минуты."
                            }
                        ]
                    }
