                                        "entry_id": "d30ea72c-7fbb-330d-a05e-83dde0683eaa",
                                        "glosses": [
                                            "klein glaasje met sterke drank, gedistilleerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1459d172-a895-47d5-b361-b682c582c031",
                                                "sense_id": "dc554e0a-acb5-3156-8d20-7bab74e6c892",
                                                "text": "Jenever is een bekende borrel in Nederland."
                                            },
                                            {
                                                "example_id": "aebddc0a-e693-416d-b841-c565ed225754",
                                                "sense_id": "dc554e0a-acb5-3156-8d20-7bab74e6c892",
                                                "text": "Het was heerlijk om weer eens met anderen een borrel te drinken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "476c2781-b659-3aeb-be23-b7a012414586",
                                        "entry_id": "d30ea72c-7fbb-330d-a05e-83dde0683eaa",
                                        "glosses": [
                                            "gezellige samenkomst waar ook alcoholische dranken worden geschonken, meestal vergezeld van een hapje"
                                        ],
                                        "tags": [
                                            "metonymisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ffd5d9b-1df6-49af-9eb3-9408c6ee1b92",
                                                "sense_id": "476c2781-b659-3aeb-be23-b7a012414586",
                                                "text": "Na het werk is er vrijdagmiddag een borrel van de zaak."
                                            },
                                            {
                                                "example_id": "01739a1a-bdba-435e-9147-ae0a4a7e4939",
                                                "sense_id": "476c2781-b659-3aeb-be23-b7a012414586",
                                                "text": "De kwestie draait om verschillende feestjes en borrels van de overheid die plaatsvonden op het moment dat er strenge coronaregels golden in Engeland. Sommige medewerkers kregen meerdere boetes. Om hoeveel personeelsleden het gaat is niet bekendgemaakt."
                                            }
                                        ]
                                    }
                                ]
                            },
