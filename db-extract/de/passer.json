                                    },
                                    {
                                        "sense_id": "a13e5e09-09a9-3ea3-a764-2e3ae3a025da",
                                        "entry_id": "3997d807-64af-3d93-b1a2-735832159714",
                                        "glosses": [
                                            "One who passes; a passer-by."
