                {
                    "sense_id": "c270824c-5b51-3122-8886-ec20edd60829",
                    "sense_definition": "Общественное объединение, государственное учреждение или частная компания.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта благотворительная <организация> помогает бездомным животным найти новый дом.",
                            "target_lang_translations": {
                                "en": "This charity <w>organization</w> helps homeless animals find a new home.",
                                "zh": "这家慈善<w>组织</w>正在帮助流浪动物寻找新家。"
                            }
                        },
                        {
                            "text": "Наша <организация> занимается разработкой программного обеспечения для банков.",
                            "target_lang_translations": {
                                "en": "Our <w>organization</w> develops software for banks.",
                                "zh": "我们<w>机构</w>专门从事银行业软件的开发。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "международная организация",
                        "общественная организация",
                        "коммерческая организация",
                        "бюджетная организация"
                    ],
                    "target_lang_definitions": {
                        "en": "A group of people who work together in an organized way for a shared purpose, such as a business, government department, or charity.",
                        "zh": "为实现共同目标而以有组织的方式共同工作的人群，例如企业、政府部门或慈善机构。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "organization",
                                "target_lang_sense_clarification": "entity or company"
                            },
                            {
                                "target_lang_word": "institution",
                                "target_lang_sense_clarification": "public or state body"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "组织",
                                "target_lang_sense_clarification": "指为了特定目标而组成的团体"
                            },
                            {
                                "target_lang_word": "机构",
                                "target_lang_sense_clarification": "指具有独立架构的公共团体或单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4454b5b3-2f16-392c-82aa-f72763b94c9b",
                    "sense_definition": "Процесс подготовки, налаживания и управления какой-либо деятельностью.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хорошая <организация> рабочего места помогает выполнять задачи быстрее.",
