                ],
                "senses": [
                    {
                        "sense_id": "0542fea8-e0f1-31cd-8df3-9cb0dd88405c",
                        "entry_id": "4d5fb64c-8276-3581-8378-5cf093c45f22",
                        "glosses": [
                            "Qui entoure, qui circule autour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef22525-9827-4540-9a96-28768c50c745",
                                "sense_id": "0542fea8-e0f1-31cd-8df3-9cb0dd88405c",
                                "text": "Cette vue a cela de particulier, qu’elle est entièrement privée d’air ambiant et de ce brouillard qui, chez nous, baigne toujours les larges perspectives ; la transparence de l’atmosphère laisse toute leur netteté aux lignes, et permet de discerner le moindre détail à des distances considérables."
                            },
                            {
                                "example_id": "56cd124b-449e-424e-abdf-d871ab0abc7e",
                                "sense_id": "0542fea8-e0f1-31cd-8df3-9cb0dd88405c",
                                "text": "Le verre est le plus souvent diamagnétique, mais quelquefois magnétique à la température ambiante, cela dépend évidemment de la proportion d’oxydes magnétiques qui entrent dans sa composition."
                            },
                            {
                                "example_id": "9d58f3e9-1882-4a38-bfef-ee6291db694f",
                                "sense_id": "0542fea8-e0f1-31cd-8df3-9cb0dd88405c",
                                "text": "À la fin de la huitième lune, une chaleur lourde s'étendit sur la vieille cité et ramena avec elle une effrayante recrudescence de puanteur ambiante."
                            }
                        ]
                    },
                    {
                        "sense_id": "e714b749-9cac-392e-9110-9185376d31dd",
                        "entry_id": "4d5fb64c-8276-3581-8378-5cf093c45f22",
                        "glosses": [
                            "Qualifie les influences, les contraintes, du milieu intellectuel, politique, moral ou religieux dans lequel nous vivons."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "51156fbc-9170-4977-bba6-107bc4f33164",
                                "sense_id": "e714b749-9cac-392e-9110-9185376d31dd",
                                "text": "À force de vouloir tout corriger, tout réguler, tout condamner, ces autorités langagières sont perçues au mieux comme un bruit ambiant, au pire comme un vecteur d'insécurité linguistique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65002f3f-c868-4cc9-b2a8-a5059252b225",
                        "source_entry_id": "4d5fb64c-8276-3581-8378-5cf093c45f22",
                        "target_lang_word": "ambient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73fa551f-4767-373f-82c3-086bd85a9177",
                                        "entry_id": "13592cc1-4aa3-3456-bbc8-759c46f0f765",
                                        "glosses": [
                                            "Encompassing on all sides; surrounding; encircling; enveloping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55dd1776-b897-4b71-9328-5cb1a050b843",
                                                "sense_id": "73fa551f-4767-373f-82c3-086bd85a9177",
                                                "text": "A cup of warm tea eventually cools to the ambient temperature."
                                            },
                                            {
                                                "example_id": "a4789326-990e-4bc7-bb5a-7b7b4f1f2635",
                                                "sense_id": "73fa551f-4767-373f-82c3-086bd85a9177",
                                                "text": "This which yields or fills all space / The ambient air wide interfused"
                                            },
                                            {
                                                "example_id": "529a3f26-4b64-42bc-bfc7-79b1b898df4f",
                                                "sense_id": "73fa551f-4767-373f-82c3-086bd85a9177",
                                                "text": "Then gazing up, a glorious Pile beheld, / VVhoſe tovv'ring Summit ambient Clouds conceal'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9ba856-7b9a-3f11-9339-5cd9b4125bf7",
                                        "entry_id": "13592cc1-4aa3-3456-bbc8-759c46f0f765",
                                        "glosses": [
                                            "Evoking or creating an atmosphere: atmospheric."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b807f035-edd8-39f0-bc52-467266cb64c8",
                                        "entry_id": "13592cc1-4aa3-3456-bbc8-759c46f0f765",
                                        "glosses": [
                                            "Relating to, or suitable for, storage at room temperature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0079614a-821e-4437-b7d1-714f1c752982",
                                                "sense_id": "b807f035-edd8-39f0-bc52-467266cb64c8",
                                                "text": "ambient food"
                                            },
                                            {
                                                "example_id": "f974d340-0aa3-455a-982f-7efd3c35b9fb",
                                                "sense_id": "b807f035-edd8-39f0-bc52-467266cb64c8",
                                                "text": "ambient warehousing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a8dc64f-550f-3746-a1b3-4f16795aa851",
                                        "entry_id": "13592cc1-4aa3-3456-bbc8-759c46f0f765",
                                        "glosses": [
                                            "Containing objects or describing a setting that one is interested in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42ee0f2-0498-4a11-954d-f87d0d4e3109",
                                                "sense_id": "5a8dc64f-550f-3746-a1b3-4f16795aa851",
                                                "text": "These, then, are characterizations of the system of natural numbers within an ambient set theory. And they seem to work, in the sense that in a sufficiently strong set theory it can be shown that Peano's axioms have (up to isomorphism) a unique model (cf. Rem. 6.1.8)."
                                            },
                                            {
                                                "example_id": "e91aea7f-00b0-48bd-844a-c4c42bbfd4d5",
                                                "sense_id": "5a8dc64f-550f-3746-a1b3-4f16795aa851",
                                                "text": "As much of the work in determinacy must proceed without AC, ZF serves as the ambient theory for this section, and uses of AC will be explicitly noted, reversing the usual procedure."
                                            },
                                            {
                                                "example_id": "3e0aaa80-c85e-4f00-848b-63fd06a0e6e2",
                                                "sense_id": "5a8dc64f-550f-3746-a1b3-4f16795aa851",
                                                "text": "A point in the manifold is classically represented by a vector in the ambient space."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ambient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64d8815a-1674-3367-a276-2394578ae1fd",
                                        "entry_id": "14e4c611-060d-3783-bc09-1b6e45daaf45",
                                        "glosses": [
                                            "Something that surrounds; encompassing material, substance or shape."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f38706e-3753-4b03-9bd3-6f99c3dd23f7",
                                                "sense_id": "64d8815a-1674-3367-a276-2394578ae1fd",
                                                "text": "Much after this same manner, when the Air is exceeding cold through which it passes; do we find the drops of Rain, falling from the Clouds, congealed into round Hail-stones by the freezing Ambient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6454d43-2bfb-3b89-8c55-000812f602a0",
                                        "entry_id": "14e4c611-060d-3783-bc09-1b6e45daaf45",
                                        "glosses": [
                                            "The atmosphere; the surrounding air or sky; atmospheric components collectively such as air, clouds, water vapour, hail, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bffa4fc0-e4a4-4c2e-aff4-a5c7323e2f4c",
                                                "sense_id": "d6454d43-2bfb-3b89-8c55-000812f602a0",
                                                "text": "It might be also, that attracted by that great void Vacuum ... all the ambients would be rarified, and particularly, the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68efa9ce-58f0-3e5d-b2d9-a642e0f4a6e0",
                                        "entry_id": "14e4c611-060d-3783-bc09-1b6e45daaf45",
                                        "glosses": [
                                            "A type of modern music that creates a relaxing and peaceful atmosphere."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c598495f-e9bf-4a47-ad4b-4556c5fe1170",
                                                "sense_id": "68efa9ce-58f0-3e5d-b2d9-a642e0f4a6e0",
                                                "text": "Ambient can be flabby synth mulch that needs to access cyberism and external philosophies to convince you you're not being scammed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
