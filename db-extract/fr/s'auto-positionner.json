                "senses": [
                    {
                        "sense_id": "ae6c358f-9d29-3cfe-b3d5-67f4511c45d1",
                        "entry_id": "55b53853-bed1-3c51-a712-a4953cf4aa10",
                        "glosses": [
                            "Se positionner tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b42982d-061a-455c-9887-5c1f4ae9d5d6",
                                "sense_id": "ae6c358f-9d29-3cfe-b3d5-67f4511c45d1",
                                "text": "Ce qui nous intéresse ici, c'est de savoir dans quelle mesure l'étiquette choisie par le pasteur pour s'auto-positionner introduit des discriminations sensibles d'opinions et d'attitudes."
                            },
                            {
                                "example_id": "31521b71-ed8d-4121-9d2e-78868a517669",
                                "sense_id": "ae6c358f-9d29-3cfe-b3d5-67f4511c45d1",
                                "text": "Il a non seulement la faculté de s'auto-positionner face à une situation qui l'interpelle, mais aussi la capacité de se placer au-dessus de toute détermination qui l'aliène."
                            }
                        ]
                    }
