            "senses": [
                {
                    "sense_id": "cc0e52dc-dc12-3a26-8e6e-504d5a829410",
                    "sense_definition": "A metal band, chain, or shackle fastened around a person's wrist or ankle to restrict movement; a handcuff or fetter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard unlocked the heavy iron <w>manacles</w> around the prisoner's wrists."
                        },
                        {
                            "text": "He struggled in vain against the cold steel <w>manacles</w> that held him securely to the wall."
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "fetter",
                        "shackle"
                    ],
                    "common_phrases": [
                        "iron manacles"
                    ]
                },
                {
                    "sense_id": "21677119-6f4b-3d14-a8d6-ed4f0a2c577e",
                    "sense_definition": "Something that restricts or hinders freedom, thought, or action; a constraint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author sought to free society from the outdated <w>manacles</w> of tradition."
                        },
                        {
                            "text": "Economic despair acted as a psychological <w>manacle</w> on the nation's creative energy."
                        }
                    ],
                    "synonyms": [
                        "constraint",
                        "restriction"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8214c33b-53bd-31fe-889c-74fad72ba589",
                    "sense_definition": "To fasten handcuffs or shackles on someone; to restrict someone's movement using physical bonds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officers immediately <w>manacled</w> the suspect before leading him out."
                        },
                        {
                            "text": "They threatened to <w>manacle</w> his hands and feet if he continued to resist."
                        }
                    ],
                    "synonyms": [
                        "handcuff",
                        "shackle",
                        "fetter"
                    ]
                }
            ]
        }
