{
    "word_family": [
        "discretely",
        "discreteness",
        "discretize",
        "discretization",
        "discretion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "971638ea-bd3d-3dfa-a5e0-b3231d63570d",
                    "sense_definition": "Separate, distinct, and individual rather than attached or continuous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distinctness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is organized into three <w>discrete</w> divisions to ensure a balance of power.",
                            "target_lang_translations": {
                                "ru": "Правительство разделено на три <w>отдельных</w> подразделения для обеспечения баланса властей."
                            }
                        },
                        {
                            "text": "The study broke the data down into <w>discrete</w> units for easier analysis.",
                            "target_lang_translations": {
                                "ru": "В исследовании данные были разбиты на <w>дискретные</w> единицы для облегчения анализа."
                            }
                        }
                    ],
                    "synonyms": [
                        "separate",
                        "distinct",
                        "individual",
                        "detached"
                    ],
                    "antonyms": [
                        "continuous"
                    ],
                    "common_phrases": [
                        "discrete units",
                        "discrete categories",
                        "discrete entities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный, обособленный и индивидуальный, а не присоединенный или непрерывный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдельный",
                                "target_lang_sense_clarification": "существующий сам по себе"
                            },
                            {
                                "target_lang_word": "обособленный",
                                "target_lang_sense_clarification": "стоящий особняком"
                            },
                            {
                                "target_lang_word": "дискретный",
                                "target_lang_sense_clarification": "состоящий из отдельных частей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3bc253e-e101-322b-b2fb-2692be7eb799",
                    "sense_definition": "Consisting of distinct values from a finite or countable set, rather than a continuous range.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematical_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In mathematics, a <w>discrete</w> variable can only take specific, isolated values.",
                            "target_lang_translations": {
                                "ru": "В математике <w>дискретная</w> переменная может принимать только определенные, изолированные значения."
                            }
                        },
                        {
                            "text": "The computer scientist explained how <w>discrete</w> mathematics is essential for algorithm design.",
                            "target_lang_translations": {
                                "ru": "Специалист по компьютерным наукам объяснил, почему <w>дискретная</w> математика важна для разработки алгоритмов."
                            }
                        }
                    ],
                    "synonyms": [
                        "discontinuous",
                        "countable"
                    ],
                    "antonyms": [
                        "continuous"
                    ],
                    "common_phrases": [
                        "discrete mathematics",
                        "discrete variables",
                        "discrete values"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из отдельных значений из конечного или счетного набора, а не из непрерывного диапазона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискретный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cb2f8b7-3155-3f8c-841b-59441db48777",
                    "sense_definition": "Composed of separate electronic components like resistors and transistors, rather than being part of an integrated circuit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old amplifier was built using <w>discrete</w> components instead of modern microchips.",
                            "target_lang_translations": {
                                "ru": "Старый усилитель был построен на <w>дискретных</w> компонентах вместо современных микросхем."
                            }
                        },
                        {
                            "text": "Engineers sometimes prefer <w>discrete</w> circuitry for high-power applications where heat dissipation is critical.",
                            "target_lang_translations": {
                                "ru": "Инженеры иногда предпочитают <w>дискретные</w> схемы для мощных устройств, где критически важен отвод тепла."
                            }
                        }
                    ],
                    "antonyms": [
                        "integrated"
                    ],
                    "common_phrases": [
                        "discrete components",
                        "discrete circuitry"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из отдельных электронных компонентов, таких как резисторы и транзисторы, а не являющийся частью интегральной схемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискретный",
                                "target_lang_sense_clarification": "о компонентах электроники"
                            },
                            {
                                "target_lang_word": "на дискретных элементах",
                                "target_lang_sense_clarification": "техническое описание схемы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25a2081a-d691-34c4-9c6b-f5a1e51fc1ff",
                    "sense_definition": "Having separate and independent channels of audio, rather than being combined or multiplexed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The home theater system provides <w>discrete</w> channels for a truly immersive surround sound experience.",
                            "target_lang_translations": {
                                "ru": "Система домашнего кинотеатра обеспечивает <w>дискретные</w> каналы для по-настоящему захватывающего объемного звука."
                            }
                        },
                        {
                            "text": "Unlike older systems, this format uses <w>discrete</w> audio tracks for each speaker.",
                            "target_lang_translations": {
                                "ru": "В отличие от старых систем, этот формат использует <w>раздельные</w> аудиодорожки для каждого динамика."
                            }
                        }
                    ],
                    "antonyms": [
                        "multiplexed"
                    ],
                    "common_phrases": [
                        "discrete channels",
                        "discrete audio"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий раздельные и независимые аудиоканалы, а не комбинированные или мультиплексированные."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискретный",
                                "target_lang_sense_clarification": "о независимых каналах звука"
                            },
                            {
                                "target_lang_word": "раздельный",
                                "target_lang_sense_clarification": "независимый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe8bcb3e-2ec6-37b4-a0fc-9858ed5cd89d",
                    "sense_definition": "Describing a topological space where every subset is open.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Any set can be given a <w>discrete</w> topology by defining every subset as an open set.",
                            "target_lang_translations": {
                                "ru": "Любому множеству можно задать <w>дискретную</w> топологию, определив каждое подмножество как открытое множество."
                            }
                        },
                        {
                            "text": "In a <w>discrete</w> space, every point is isolated from the others.",
                            "target_lang_translations": {
                                "ru": "В <w>дискретном</w> пространстве каждая точка изолирована от других."
                            }
                        }
                    ],
                    "common_phrases": [
                        "discrete topology",
                        "discrete space"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий топологическое пространство, в котором каждое подмножество является открытым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискретный",
                                "target_lang_sense_clarification": "в топологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1208e25-e72a-34c0-a315-c7990c2895b8",
                    "sense_definition": "An archaic spelling of <w>discreet</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older texts, you might see the word <w>discrete</w> used where we would now use 'discreet'.",
                            "target_lang_translations": {
                                "ru": "В старых текстах можно встретить написание <w>discrete</w> там, где сейчас мы бы использовали «discreet»."
                            }
                        },
                        {
                            "text": "The author used the <w>discrete</w> spelling to maintain the historical feel of the prose.",
                            "target_lang_translations": {
                                "ru": "Автор использовал написание <w>discrete</w>, чтобы сохранить исторический дух прозы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичное написание слова discreet (осмотрительный, тактичный)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмотрительный",
                                "target_lang_sense_clarification": "устаревшее написание"
                            },
                            {
                                "target_lang_word": "тактичный",
                                "target_lang_sense_clarification": "устаревшее написание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}