                        "glosses": [
                            "Becher aus Leder oder Kunststoff, in dem Würfel vor dem Wurf durcheinandergeschüttelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17462e5c-03d8-4ddc-8a01-96ea3bb38e4a",
                                "sense_id": "304db5ea-7ebb-3c45-bc0c-467cac2cd0bb",
                                "text": "„Menschen schütteln den Würfelbecher kräftiger, wenn sie eine hohe Zahl brauchen.“"
                            },
