                                        "entry_id": "2dcf490a-6fec-3e34-80f3-642b9982573e",
                                        "glosses": [
                                            "A specific such theory, advocated by a particular philosopher or school of thought."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75b8de0-f9aa-4d26-bfb8-d75d1ff5cb4a",
                                                "sense_id": "588c9232-ad18-34a7-81ea-4198943ded01",
                                                "text": "Following Gilbert Harman’s lead, my own formulation of relativism about the normative domain was based on the classic examples of thoroughgoing relativisms drawn from physics."
                                            }
                                        ]
                                    }
