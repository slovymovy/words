                    "sense_definition": "een berg met een opvallend platte bovenkant en steile wanden",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wandelaars genoten van het prachtige uitzicht vanaf de <w>tafelberg</w>.",
                            "target_lang_translations": {
