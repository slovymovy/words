                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51226cad-e82c-41ba-b7bc-1f3dd7094c47",
                                "sense_id": "fa5be00a-4ce0-3731-bcd4-108745a54169",
                                "text": "Trenerka nie była zadowolona z występu swojej zawodniczki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c891c574-122e-4625-a528-c6edd50b595d",
                        "source_entry_id": "8bcf2cf6-713d-3f52-8152-5dc7319e51a3",
                        "source_sense_id": "fa5be00a-4ce0-3731-bcd4-108745a54169",
                        "target_lang_word": "entraîneuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entraîneuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3282494-e90e-3fcb-9ab3-34fc70476e87",
                                        "entry_id": "302ec2e2-2cbd-3854-9766-617ab65eae5a",
                                        "glosses": [
                                            "Celle qui entraîne (en particulier un animal de course, comme un cheval, ou de cirque)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c97c67e-c30a-4ce8-b119-3ed32841e6de",
                                                "sense_id": "c3282494-e90e-3fcb-9ab3-34fc70476e87",
                                                "text": "« C’est la première fois que je viens à Châteaubriant, s’enchante l’entraîneuse, driver et copropriétaire avec Christian Boisnard, éleveur à côté de Janzé (Ille-et-Vilaine)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b953a7b0-aac1-3387-930a-542a0bf2bb24",
                                        "entry_id": "302ec2e2-2cbd-3854-9766-617ab65eae5a",
                                        "glosses": [
                                            "Femme chargée de la préparation physique, technique, tactique et mentale d’un sportif, d’une sportive ou d’une équipe sportive."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af89c508-0757-46c6-8483-f978821eb99c",
                                                "sense_id": "b953a7b0-aac1-3387-930a-542a0bf2bb24",
                                                "text": "À ses côtés, les gardes du corps ont été avantageusement remplacés par une jolie Coach, ancienne gymnaste reconvertie en entraîneuse personnelle des people."
                                            },
                                            {
                                                "example_id": "1567fe98-990f-48ff-8668-8d2934a809d5",
                                                "sense_id": "b953a7b0-aac1-3387-930a-542a0bf2bb24",
                                                "text": "Au Club GYM TRM, l’entraîneuse Kathleen Rudisel est derrière les routines des jeunes athlètes qui s’entraînent au Complexe sportif Alphonse-Desjardins."
                                            },
                                            {
                                                "example_id": "21e6e93c-d7d8-4170-9200-2ba3a1e83c11",
                                                "sense_id": "b953a7b0-aac1-3387-930a-542a0bf2bb24",
                                                "text": "« Des sports d’hiver chez nous, conteste l’entraîneuse russe. On les pratique en salle dès que le froid nous empêche de sortir ! »"
                                            },
                                            {
                                                "example_id": "31e46a2a-5bfc-4d62-aa6f-70ea1fbcb7d5",
                                                "sense_id": "b953a7b0-aac1-3387-930a-542a0bf2bb24",
                                                "text": "« […] Maintenant c’est la suite qui compte. Le club est structuré, il y a un staff pour entraîner les joueurs. On trouvera un autre entraîneur, ou une entraîneuse », a poursuivi Michy."
                                            },
                                            {
                                                "example_id": "68137184-52c3-456f-9700-a18cca8b3f5f",
                                                "sense_id": "b953a7b0-aac1-3387-930a-542a0bf2bb24",
                                                "text": "Qui verrait un tripot mal famé dans une phrase comme « L’entraîneuse du FC Nantes menace de démissionner » n’aurait assurément pas toute sa tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30629ca6-d775-356f-8991-7212853d8ef1",
                                        "entry_id": "302ec2e2-2cbd-3854-9766-617ab65eae5a",
                                        "glosses": [
                                            "Femme dont le rôle est de pousser à la consommation les clients de bars ou de discothèques."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0330398-7bab-4276-a76b-68741928b132",
                                                "sense_id": "30629ca6-d775-356f-8991-7212853d8ef1",
                                                "text": "Là, nous lions connaissance avec une petite entraîneuse blondasse."
                                            },
                                            {
                                                "example_id": "9397a436-fce8-47e5-91cf-33969bf27b9e",
                                                "sense_id": "30629ca6-d775-356f-8991-7212853d8ef1",
                                                "text": "En effet, alors que Rita Verstraeten, après avoir hérité de l’immense fortune du magnat de la cigarette, vivait séparée de son époux, ce dernier s’était installé depuis deux ans avec Aïn Bakkali, jeune femme ravissante et ancienne entraîneuse dans des bars."
                                            },
                                            {
                                                "example_id": "8a5ddc02-3e2c-4e80-bea4-0f7e650c8954",
                                                "sense_id": "30629ca6-d775-356f-8991-7212853d8ef1",
                                                "text": "Le personnage central de Party Girl, Angélique, est entraîneuse."
                                            },
                                            {
                                                "example_id": "f5b17df1-1f3f-4970-96ec-93bc5f41fe82",
                                                "sense_id": "30629ca6-d775-356f-8991-7212853d8ef1",
                                                "text": "Dans la vie, si tant est qu’un communiqué de presse fasse partie de la réalité, Angélique est effectivement sa mère et a travaillé comme entraîneuse dans un cabaret."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entraîneuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b04afdd-79de-3da6-83b2-603b08fdc6aa",
                                        "entry_id": "c12cbc7d-b2ee-3f6f-9ca2-cb34dd9f55fb",
                                        "glosses": [
                                            "Féminin singulier de entraîneur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "110f43fd-36ca-4d02-af93-dcbaa340ce23",
                                                "sense_id": "3b04afdd-79de-3da6-83b2-603b08fdc6aa",
                                                "text": "Armés par leur appui contre l’axe de pivotement de la bascule, ils maintiennent les « becs » des cliquets en contact avec les dents triangulaires de la roue entraîneuse de roue de couronne (B″)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
