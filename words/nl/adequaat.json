            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d5889550-d0e7-3d08-9fa4-eda6a78e749e",
                    "sense_definition": "op een correcte en passende manier reagerend of handelend in een bepaalde situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De piloot reageerde <w>adequaat</w> toen de motoren van het vliegtuig plotseling uitvielen.",
                            "target_lang_translations": {
                                "en": "The pilot reacted <w>appropriately</w> when the plane's engines suddenly failed."
                            }
                        },
                        {
                            "text": "Het is belangrijk om <w>adequaat</w> te reageren op de behoeften van de klant.",
                            "target_lang_translations": {
                                "en": "It is important to respond <w>adequately</w> to the customer's needs."
                            }
                        }
                    ],
