        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6effacc8-1295-3149-bdf6-ac1599d7018c",
                    "sense_definition": "iemand of iets zorgvuldig begeleiden naar een bestemming of door een proces",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "begeleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bodyguards <w>loodsen</w> de filmster langs alle verzamelde media naar de auto.",
                            "target_lang_translations": {
                                "en": "The bodyguards <w>guide</w> the movie star past all the gathered media to the car.",
                                "ru": "Телохранители <w>проводят</w> кинозвезду мимо всех собравшихся СМИ к машине."
                            }
                        },
                        {
                            "text": "De minister probeert het nieuwe wetsvoorstel veilig door de Tweede Kamer te <w>loodsen</w>.",
                            "target_lang_translations": {
                                "en": "The minister is trying to <w>steer</w> the new bill safely through the House of Representatives.",
                                "ru": "Министр пытается благополучно <w>провести</w> новый законопроект через Палату представителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "begeleiden",
                        "gidsen",
                        "leiden"
                    ],
                    "common_phrases": [
