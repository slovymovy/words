                "senses": [
                    {
                        "sense_id": "59a40d99-a1e9-38c3-bac5-7dafe48a0cc7",
                        "entry_id": "c0fe0056-bbce-3b56-a3f4-1218ef4d2118",
                        "glosses": [
                            "Se différencier sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91587818-bf98-46b1-af45-f82c8df00b37",
                                "sense_id": "59a40d99-a1e9-38c3-bac5-7dafe48a0cc7",
                                "text": "Une cellule déterminée est capable de s'autodifférencier quand elle se trouve dans des conditions favorables."
                            },
                            {
                                "example_id": "532bef2f-9df4-42bb-94a6-172579e494ae",
                                "sense_id": "59a40d99-a1e9-38c3-bac5-7dafe48a0cc7",
                                "text": "Les transplants d'ectoderme de la moitié dorsale de l'embryon vont s'autodifférencier en épiderme s'ils sont enlevés avant qu'ils ne soient couverts par le dessous du mésoderme en formation."
                            }
                        ]
                    }
