                    {
                        "translation_id": "490da454-5d08-407f-a85a-56e3f90cfbab",
                        "source_entry_id": "dbecab5e-2699-3e3f-a843-e39955a2d9aa",
                        "source_sense_id": "3d874f7d-d3ed-3b8f-8bee-bb8ec4d165e4",
                        "target_lang_word": "πολυτέλεια",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "πολυτέλεια",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "57c41b26-4c53-323e-8d35-64c170a0c161",
                                        "entry_id": "e1dce644-833e-3eb8-8b7c-eed8a3da2978",
                                        "glosses": [
                                            "η δαπάνη χρηματικών ποσών και η χρήση αντικειμένων και υπηρεσιών πέρα από την κάλυψη των βασικών αναγκών και πάνω από το μέσο βιοτικό επίπεδο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5285f7d-8959-47dd-a64b-10e66bd8c49c",
                                                "sense_id": "57c41b26-4c53-323e-8d35-64c170a0c161",
                                                "text": "Απίστευτη πολυτέλεια και μανία με το θεαθήναι. Πισίνα όταν το σπίτι τους είναι 200 μέτρα από τη θάλασσα; Στο Τέξας νομίζει ότι ζει ο άνθρωπος;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "098a0d12-e172-37fe-b84e-113fe6418355",
                                        "entry_id": "e1dce644-833e-3eb8-8b7c-eed8a3da2978",
                                        "glosses": [
                                            "σπατάλη που δεν θεωρείται άμεσα απαραίτητη, περιττό έξοδο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3a7c20-ccf5-453e-b7d0-b6b27fd3bc02",
                                                "sense_id": "098a0d12-e172-37fe-b84e-113fe6418355",
                                                "text": "Ωραίο είναι και το νέο μοντέλο, αλλά μια χαρά είναι και το κινητό που έχεις, δεν είμαστε τώρα για πολυτέλειες."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c8d4aad-ace9-3a64-84c2-7e2a7d8cdb1e",
                                        "entry_id": "e1dce644-833e-3eb8-8b7c-eed8a3da2978",
                                        "glosses": [
                                            "χλιδή, μεγαλοπρέπεια, πλούτος"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b72531-4432-4e36-b885-b1a696214c21",
                                                "sense_id": "9c8d4aad-ace9-3a64-84c2-7e2a7d8cdb1e",
                                                "text": "Πήγα στο σπίτι τους και έμεινα άλαλη. Πολυτέλεια να δουν τα μάτια σου! Πού τα βρήκαν τα λεφτά βρε παιδί μου αφού πάντα κλαίγονταν;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a424944-0fee-3d60-8bdb-b4c16ae21845",
                                        "entry_id": "e1dce644-833e-3eb8-8b7c-eed8a3da2978",
                                        "glosses": [
                                            "ευχέρεια, άνεση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687f298d-e26a-4b79-acec-17e29dc9fd25",
                                                "sense_id": "2a424944-0fee-3d60-8bdb-b4c16ae21845",
                                                "text": "Εχει την πολύτέλεια να πηγαίνει διακοπές ένα ολόκληρο μήνα, όπως εμείς οι υπόλοιποι πηγαίναμε μόνο όταν είμαστε παιδιά."
                                            },
                                            {
                                                "example_id": "e16ab0cf-43e3-480b-bed0-fa9e5e4d0000",
                                                "sense_id": "2a424944-0fee-3d60-8bdb-b4c16ae21845",
                                                "text": "※ Καμιά φορά αναφέρεται ο όρος πόρτεγο, που ήταν το σημερινό καθιστικό ή σαλόνι. Πόρτεγο δε φαίνεται να διέθεταν όλα τα νοικοκυριά, η ύπαρξή του δήλωνε πολυτέλεια ... Τα κυρίως δωμάτια που συνήθως διέθετε ένα νοικοκυριό ήταν το πόρτεγο και το υπνοδωμάτιο. (Πεπραγμένα Ένατου Διεθνούς Κρητολογικού Συνεδρίου, Εταιρεία Κρητικών Ιστορικών Μελετών, 2004, σελ. 241)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ebb937-9028-36ed-899d-26f14bc3390f",
                                        "entry_id": "e1dce644-833e-3eb8-8b7c-eed8a3da2978",
                                        "glosses": [
                                            ", προσδιοριστική ακριβών προϊόντων και υπηρεσιών ανώτερης ποιότητας"
                                        ],
                                        "tags": [
                                            "γενική της ιδιότητας"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21d799aa-af44-4bdb-b711-e8515abc0829",
                                                "sense_id": "55ebb937-9028-36ed-899d-26f14bc3390f",
                                                "text": "Σιγά μην αγοράσω κεράσια με 4,80 το κιλό. Κατάντησε και το φρούτο είδος πολυτελείας."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
