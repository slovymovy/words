                        "entry_id": "67211445-ff66-3c9f-9fda-640050b1ea4e",
                        "glosses": [
                            "Orifice inférieur de l’estomac, par lequel les aliments entrent dans les intestins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b530ce7-3164-47f7-b5c4-0967d8fd1f57",
                                "sense_id": "695e4acb-4769-397e-9319-97902fe1f929",
                                "text": "Obstruction du pylore."
                            },
                            {
                                "example_id": "cf300b9a-0ab8-483d-9ee4-c92e46fb5e79",
                                "sense_id": "695e4acb-4769-397e-9319-97902fe1f929",
                                "text": "Ce pauvre Alfred a sa crampe au pylore."
                            }
                        ]
                    },
                    {
                        "sense_id": "3525cda1-ffde-35e5-afc3-c6d277d16df7",
                        "entry_id": "67211445-ff66-3c9f-9fda-640050b1ea4e",
                        "glosses": [
                            "Le sphincter qui ouvre ou ferme cet orifice."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b50d4e7f-8740-4850-9c9c-19c7604601c7",
                                "sense_id": "3525cda1-ffde-35e5-afc3-c6d277d16df7",
                                "text": "Simon avait beau se dire qu’après tout, ils ne pouvaient rien y changer, la perspective de l’explication lui contractait le pylore."
                            },
                            {
                                "example_id": "13ca150d-04f8-44b0-ab3d-d9364d8b8614",
                                "sense_id": "3525cda1-ffde-35e5-afc3-c6d277d16df7",
                                "text": "Contribution à l’étude des fonctions de l’estomac étudiées sur un malade atteint de cancer du pylore et gastroentérostomisé, par MM. Dehove et Soupault."
                            }
                        ]
                    }
