                            {
                                "example_id": "52fd5c5b-3d39-4e47-86ed-7781b14315bc",
                                "sense_id": "76581df5-1437-3a81-90f7-2299a6304c1f",
                                "text": "Kilka miesięcy temu Francuzi zagrozili, że nie będą stosować obowiązującego prawa UE, jeśli nie zostanie zmienione zgodnie z ich życzeniami"
                            }
