                {
                    "sense_id": "ab4cce9d-e9bc-31c5-bf1b-a43527e97afc",
                    "sense_definition": "Qui manque d'équilibre physique, qui risque de vaciller ou de tomber.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention en montant sur cette échelle, elle est particulièrement <w>instable</w>.",
                            "target_lang_translations": {
                                "en": "Be careful when climbing this ladder; it is particularly <w>unsteady</w>.",
                                "ru": "Будь осторожен, поднимаясь по этой лестнице: она особенно <w>шаткая</w>.",
                                "de": "Pass beim Hinaufsteigen auf diese Leiter auf, sie ist besonders <w>wackelig</w>.",
                                "es": "Ten cuidado al subirte a esta escalera, es especialmente <w>inestable</w>.",
                                "zh": "爬这个梯子时要小心，它特别<w>不稳</w>。"
                            }
                        },
                        {
                            "text": "Après les pluies torrentielles, le terrain boueux est devenu très <w>instable</w>.",
                            "target_lang_translations": {
                                "en": "After the torrential rain, the muddy ground has become very <w>unstable</w>.",
                                "ru": "После проливных дождей грязный грунт стал очень <w>неустойчивым</w>.",
                                "de": "Nach dem Starkregen ist der schlammige Boden sehr <w>instabil</w> geworden.",
                                "es": "Después de las lluvias torrenciales, el terreno fangoso se ha vuelto muy <w>inestable</w>.",
                                "zh": "暴雨过后，泥泞的地面变得非常<w>不稳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chancelant",
                        "vacillant"
                    ],
                    "antonyms": [
                        "stable",
                        "solide"
                    ],
                    "common_phrases": [
                        "équilibre instable",
                        "terrain instable"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking physical balance, likely to wobble or fall.",
                        "ru": "Не имеющий физического равновесия, способный качнуться или упасть.",
                        "de": "Ohne festen Stand, das leicht ins Wanken gerät oder umzufallen droht.",
                        "es": "Que carece de equilibrio físico y puede tambalearse o caerse.",
                        "zh": "缺乏身体平衡，容易摇晃或倒下的。"
                    },
