                "senses": [
                    {
                        "sense_id": "6c43611a-3048-32ab-956c-d65b74d5006a",
                        "entry_id": "653b8588-e128-39ce-8ede-66d54fd36c96",
                        "glosses": [
                            "Person, welche den Großteil der Folgen eines negativen Ereignisses ertragen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a602a1f5-9829-4160-b935-01bf72bfd1bc",
                                "sense_id": "6c43611a-3048-32ab-956c-d65b74d5006a",
                                "text": "„Wer nicht fliehen konnte, waren dagegen die schwarzen Farmarbeiter, die die Hauptleidtragenden waren.“"
                            },
                            {
                                "example_id": "79c4d525-6fe8-49ac-9510-8c3eb7e936f3",
                                "sense_id": "6c43611a-3048-32ab-956c-d65b74d5006a",
                                "text": "„Die Ergebnisse des Untersuchungsausschusses — dem zwei Generäle, ein Oberst und ein juristischer Berater angehörten — überraschten niemanden, der zum Zeitpunkt der Unruhen in Jerusalem gewesen war: Die Sicherheitskräfte waren unvorbereitet gewesen, und die Hauptleidtragenden waren die Juden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
