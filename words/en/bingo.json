{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fd1afa8c-0fb9-3df8-af87-fbe8d3bec9df",
                    "sense_definition": "Used as an exclamation to announce a win in the game of bingo.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "game_exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She shouted <w>bingo</w> as soon as the final number was called.",
                            "target_lang_translations": {
                                "ru": "Она закричала \"<w>бинго</w>\", как только назвали последний номер.",
                                "zh": "最后一个数字一报出来，她就大喊了一声“<w>宾果</w>”。"
                            }
                        },
                        {
                            "text": "If you fill your card first, you must yell <w>bingo</w> to stop the game.",
                            "target_lang_translations": {
                                "ru": "Если вы первым заполните карточку, нужно крикнуть \"<w>бинго</w>\", чтобы остановить игру.",
                                "zh": "如果你先填满卡片，必须大喊“<w>宾果</w>”来停止游戏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "house!"
                    ],
                    "common_phrases": [
                        "call bingo",
                        "shout bingo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возглас, используемый для объявления о победе в игре бинго.",
                        "zh": "用于宣布在宾果游戏中获胜的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "би́нго",
                                "target_lang_sense_clarification": "возглас победы в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾果",
                                "target_lang_sense_clarification": "游戏获胜时的呼喊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b87b231-4958-3a72-9467-b58e75595249",
                    "sense_definition": "Used to express excitement or satisfaction when suddenly finding something, remembering something, or successfully completing a task.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "success_exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I looked everywhere for my keys, and then <w>bingo</w>, I found them in the fridge.",
                            "target_lang_translations": {
                                "ru": "Я везде искал ключи, и тут — <w>бинго</w>, я нашел их в холодильнике.",
                                "zh": "我到处找钥匙，结果<w>宾果</w>，在冰箱里找到了。"
                            }
                        },
                        {
                            "text": "Just add a little bit of salt to the sauce, and <w>bingo</w>, it tastes perfect.",
                            "target_lang_translations": {
                                "ru": "Просто добавь немного соли в соус, и <w>бинго</w> — вкус идеальный.",
                                "zh": "往酱汁里加点盐，<w>宾果</w>，味道完美了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aha!",
                        "eureka!",
                        "got it!",
                        "that's it!",
                        "yes!"
                    ],
                    "common_phrases": [
                        "and bingo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения радости или удовлетворения при внезапной находке, догадке или успешном завершении дела.",
                        "zh": "用于表达突然发现某物、想起某事或成功完成任务时的兴奋或满足感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "би́нго",
                                "target_lang_sense_clarification": "выражение успеха"
                            },
                            {
                                "target_lang_word": "есть!",
                                "target_lang_sense_clarification": "выражение удовлетворения"
                            },
                            {
                                "target_lang_word": "нашёл!",
                                "target_lang_sense_clarification": "при обнаружении чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾果",
                                "target_lang_sense_clarification": "表达成功或发现"
                            },
                            {
                                "target_lang_word": "找到了",
                                "target_lang_sense_clarification": "发现某物"
                            },
                            {
                                "target_lang_word": "成了",
                                "target_lang_sense_clarification": "任务完成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1c613d9-2f31-3ce4-a0a5-0ffca66b07a9",
                    "sense_definition": "Used to enthusiastically confirm that another speaker's point is exactly correct.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "success_exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When he said the problem was in the wiring, I said <w>bingo</w> because that was my thought exactly.",
                            "target_lang_translations": {
                                "ru": "Когда он сказал, что проблема в проводке, я сказал \"<w>в точку</w>\", потому что именно так я и думал.",
                                "zh": "当他说问题出在电线上时，我说“<w>说对了</w>”，因为我正是这么想的。"
                            }
                        },
                        {
                            "text": "You guessed the secret ingredient on the first try, <w>bingo</w>!",
                            "target_lang_translations": {
                                "ru": "Ты угадал секретный ингредиент с первой попытки, <w>бинго</w>!",
                                "zh": "你第一次就猜中了秘方配料，<w>宾果</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "that's it!",
                        "yes!"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подтверждения того, что слова собеседника абсолютно верны или его догадка точна.",
                        "zh": "用于热情地确认对方的观点完全正确。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в точку",
                                "target_lang_sense_clarification": "подтверждение правоты"
                            },
                            {
                                "target_lang_word": "точно",
                                "target_lang_sense_clarification": "согласие"
                            },
                            {
                                "target_lang_word": "би́нго",
                                "target_lang_sense_clarification": "подтверждение догадки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说对了",
                                "target_lang_sense_clarification": "确认对方正确"
                            },
                            {
                                "target_lang_word": "宾果",
                                "target_lang_sense_clarification": "确认猜测准确"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cb571ca-e0be-3b0b-b43e-600ebf0b2fba",
                    "sense_definition": "A game of chance in which players mark off numbers on a grid as they are announced by a caller, winning by being the first to complete a specific pattern.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "game_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother goes to the community center every Tuesday to play <w>bingo</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка ходит в общественный центр каждый вторник играть в <w>бинго</w>.",
                                "zh": "我祖母每周二都去社区中心玩<w>宾果</w>。"
                            }
                        },
                        {
                            "text": "We organized a night of <w>bingo</w> to raise money for the local charity.",
                            "target_lang_translations": {
                                "ru": "Мы организовали вечер игры в <w>бинго</w>, чтобы собрать деньги для местной благотворительности.",
                                "zh": "我们组织了一个<w>宾果</w>之夜，为当地慈善机构筹款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lotto"
                    ],
                    "common_phrases": [
                        "play bingo",
                        "bingo night",
                        "bingo card",
                        "bingo hall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Азартная игра, в которой игроки отмечают числа на карточках по мере их объявления ведущим.",
                        "zh": "一种机会游戏，玩家在主持人宣布数字时在网格上标记数字，最先完成特定图案者获胜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "би́нго",
                                "target_lang_sense_clarification": "игра"
                            },
                            {
                                "target_lang_word": "лото",
                                "target_lang_sense_clarification": "похожая игра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾果游戏",
                                "target_lang_sense_clarification": "游戏名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "416a5ab9-b038-3c5a-9300-10b73ca52123",
                    "sense_definition": "A sudden, unexpected success or a large prize.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "success_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new marketing strategy was a box office <w>bingo</w> for the movie studio.",
                            "target_lang_translations": {
                                "ru": "Новая маркетинговая стратегия обернулась кассовым <w>успехом</w> для киностудии.",
                                "zh": "新的营销策略让电影制片厂在票房上<w>大获成功</w>。"
                            }
                        },
                        {
                            "text": "Finding that rare coin in the collection was absolute <w>bingo</w> for the amateur numismatist.",
                            "target_lang_translations": {
                                "ru": "Находка этой редкой монеты в коллекции стала настоящей <w>удачей</w> для нумизмата-любителя.",
                                "zh": "在收藏中发现那枚稀有硬币对这位业余钱币学家来说简直是<w>中大奖</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, неожиданный успех или крупный выигрыш.",
                        "zh": "突然的、意想不到的成功或大奖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́ча",
                                "target_lang_sense_clarification": "успех"
                            },
                            {
                                "target_lang_word": "куш",
                                "target_lang_sense_clarification": "крупный выигрыш"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大获成功",
                                "target_lang_sense_clarification": "意外的成功"
                            },
                            {
                                "target_lang_word": "中大奖",
                                "target_lang_sense_clarification": "获得意外之财"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc6db587-e838-31c0-bf06-cb95bf6466a9",
                    "sense_definition": "A move in word games like Scrabble where a player uses all seven letter tiles in a single turn, earning bonus points.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "game_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She scored a <w>bingo</w> by playing the word \"QUIZZED\" on a triple word score.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>бинго</w>, выложив слово \"QUIZZED\" на клетке тройного счета слов.",
                                "zh": "她通过在三倍词分格上拼出“QUIZZED”一词，打出了一个<w>宾果</w>。"
                            }
                        },
                        {
                            "text": "Getting a <w>bingo</w> is often the deciding factor in high-level word game tournaments.",
                            "target_lang_translations": {
                                "ru": "Получение <w>бинго</w> часто становится решающим фактором в турнирах высокого уровня по играм со словами.",
                                "zh": "在高级别拼字游戏比赛中，打出<w>宾果</w>往往是决定胜负的关键。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ход в играх со словами (например, в Скрэббле), когда игрок использует все семь фишек за один ход.",
                        "zh": "在拼字游戏（如Scrabble）中的一种走法，玩家在单次出牌中用完所有七个字母牌，获得额外分数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "би́нго",
                                "target_lang_sense_clarification": "ход в скрэббле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾果",
                                "target_lang_sense_clarification": "拼字游戏中的特殊走法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98c46047-ccda-3329-9b6b-62e58195be30",
                    "sense_definition": "To play the game of bingo.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "play_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly group <w>bingos</w> every Friday night at the local hall.",
                            "target_lang_translations": {
                                "ru": "Группа пожилых людей <w>играет в бинго</w> каждую пятницу в местном зале.",
                                "zh": "老年团体每周五晚上都会在当地大厅<w>玩宾果</w>。"
                            }
                        },
                        {
                            "text": "We spent the evening <w>bingoing</w> and chatting with friends.",
                            "target_lang_translations": {
                                "ru": "Мы провели вечер, <w>играя в бинго</w> и болтая с друзьями.",
                                "zh": "我们花了一晚上<w>玩宾果</w>并和朋友聊天。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть в игру бинго.",
                        "zh": "玩宾果游戏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игра́ть в би́нго",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玩宾果",
                                "target_lang_sense_clarification": "进行游戏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95e3bf2c-3f5d-3078-b906-5cbe03e4403a",
                    "sense_definition": "To play all of one's seven tiles in a single move in the game of Scrabble.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "play_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>bingoed</w> with a seven-letter word that used the letter Z.",
                            "target_lang_translations": {
                                "ru": "Он <w>сделал бинго</w>, составив слово из семи букв, в котором была буква Z.",
                                "zh": "他用一个包含字母Z的七字母单词<w>打出了宾果</w>。"
                            }
                        },
                        {
                            "text": "It is difficult to catch up once your opponent has <w>bingoed</w> twice in a row.",
                            "target_lang_translations": {
                                "ru": "Трудно догнать соперника, если он <w>сделал бинго</w> два раза подряд.",
                                "zh": "一旦对手连续两次<w>打出宾果</w>，就很难追上了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать все семь фишек за один ход в игре Скрэббл.",
                        "zh": "在拼字游戏Scrabble中，单次出牌用掉所有七个字母牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сде́лать би́нго",
                                "target_lang_sense_clarification": "использовать все фишки"
                            },
                            {
                                "target_lang_word": "собра́ть би́нго",
                                "target_lang_sense_clarification": "в скрэббле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打出宾果",
                                "target_lang_sense_clarification": "拼字游戏动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "798a59bf-454b-3f33-bd16-a16df0ebe0c8",
                    "sense_definition": "Having just enough fuel remaining to return to base or reach an alternative airfield.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fuel_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot announced he was <w>bingo</w> fuel and had to turn back immediately.",
                            "target_lang_translations": {
                                "ru": "Пилот сообщил, что у него <w>минимальный остаток топлива</w>, и ему пришлось немедленно повернуть назад.",
                                "zh": "飞行员宣布燃油已达<w>最低油量</w>，必须立即返航。"
                            }
                        },
                        {
                            "text": "We cannot stay in the holding pattern any longer because we are approaching <w>bingo</w> state.",
                            "target_lang_translations": {
                                "ru": "Мы не можем больше оставаться в зоне ожидания, так как приближаемся к состоянию <w>бинго</w>.",
                                "zh": "我们不能再在等待航线盘旋了，因为我们正接近<w>最低油量</w>状态。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bingo fuel"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military aviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, когда топлива осталось ровно столько, чтобы вернуться на базу (авиационный термин).",
                        "zh": "指剩余燃料仅够返回基地或到达备降机场的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крити́ческий оста́ток то́плива",
                                "target_lang_sense_clarification": "авиационный термин"
                            },
                            {
                                "target_lang_word": "би́нго",
                                "target_lang_sense_clarification": "код возврата на базу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最低油量",
                                "target_lang_sense_clarification": "航空术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "87607eec-fc8e-3a87-bf4a-da3e31703759",
                    "sense_definition": "A name, famously used for a dog in a traditional children's song.",
                    "learner_level": "A1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The farmer had a dog and <w>Bingo</w> was his name-o.",
                            "target_lang_translations": {
                                "ru": "У фермера был пёс, и звали его <w>Бинго</w>.",
                                "zh": "农夫有一条狗，它的名字叫<w>宾果</w>。"
                            }
                        },
                        {
                            "text": "We decided to name our new puppy <w>Bingo</w> because he is full of energy.",
                            "target_lang_translations": {
                                "ru": "Мы решили назвать нашего нового щенка <w>Бинго</w>, потому что он полон энергии.",
                                "zh": "我们决定给新买的小狗取名叫<w>宾果</w>，因为它精力充沛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя, известное по детской песенке про собаку.",
                        "zh": "一个名字，因传统童谣中的狗而闻名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Би́нго",
                                "target_lang_sense_clarification": "кличка собаки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾果",
                                "target_lang_sense_clarification": "宠物名字"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}