                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a88e969-406a-4c33-aa2c-25f0e2004e80",
                        "source_entry_id": "69747687-8f7e-371c-9956-cdacc91d78b8",
                        "source_sense_description": "navigable body of water",
                        "target_lang_word": "waterweg",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waterweg",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "80b10ca7-2085-3a5d-9ed0-700c1f50952e",
                                        "entry_id": "533ed6af-d753-3152-a74a-3d3fab26860f",
                                        "glosses": [
                                            "een water dat kan worden bevaren. Dit kan een rivier of kanaal zijn of een aangelegde geul in een verder ondiep water. Zeeën en diepe meren zijn ook vaarwegen, al worden ze in het algemeen niet zo genoemd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc2a42a-aac7-4c99-8e04-7ece0c7364b7",
                                                "sense_id": "80b10ca7-2085-3a5d-9ed0-700c1f50952e",
                                                "text": "Als een slordige s in spiegelbeeld was het kanaal over de stadsplattegrond gekalkt door een dronken ontwerper die sadistisch lachte toen hij zag hoe zijn ingreep de stad zo goed als onbegaanbaar had gemaakt voor de flanerende edelen met hun satijnen schoentjes en die pas de volgende dag, weer nuchter, besefte dat hij geheel tegen zijn bedoeling in een magnifieke waterweg had geschapen die alle delen van de stad op een mooie, trage manier met elkaar verbond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e3a7283-0da0-4078-a01e-855029efd14e",
                        "source_entry_id": "69747687-8f7e-371c-9956-cdacc91d78b8",
                        "source_sense_description": "navigable body of water",
                        "target_lang_word": "vaarwater",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaarwater",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bd55b3f4-ab62-3fcc-8edc-5bd502ddec1b",
                                        "entry_id": "1989e2d3-22a7-3951-a34b-260f5836b6ae",
                                        "glosses": [
                                            "dat gedeelte van een water waar een vaartuig, hoe klein ook, kan varen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f64e43-a78d-46b7-b9bf-a18db7ce8333",
                                                "sense_id": "bd55b3f4-ab62-3fcc-8edc-5bd502ddec1b",
                                                "text": "Omdat het gedrag van een netwerk bepaald wordt door de som van de gedragingen van de delen en de relaties tussen die delen, is bij Rijkswaterstaat kennis verdwenen over het gedrag van de netwerken. Geen wonder dat niemand meer weet dat als de stuw bij Grave het begeeft, er bij Heumen iets moet gebeuren om nog wat vaarwater in het Maas-Waal-kanaal te houden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8352e198-88e9-458e-a218-6bed4dfa8fa2",
                        "source_entry_id": "69747687-8f7e-371c-9956-cdacc91d78b8",
                        "source_sense_description": "navigable body of water",
                        "target_lang_word": "voie navigable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voie navigable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "164456c7-251b-3f09-a178-9d1e6924dd89",
                                        "entry_id": "3c89067d-3e95-31a1-94ca-500188bdf0b6",
                                        "glosses": [
                                            "Cours d’eau ouvert à la navigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d12b5fb-61b0-4176-820b-ab0b67121cfa",
                                                "sense_id": "164456c7-251b-3f09-a178-9d1e6924dd89",
                                                "text": "Autrefois le Lot était une voie navigable : ses écluses, ses relais faisaient vivre un peuple de mariniers. On a déclassé le Lot."
                                            },
                                            {
                                                "example_id": "da98355d-4ff4-40f8-a47b-c102aaf39138",
                                                "sense_id": "164456c7-251b-3f09-a178-9d1e6924dd89",
                                                "text": "En l'an 2000, le transport par voie navigable sera libéralisé, afin d’instaurer un véritable marché intérieur européen sans frontières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aea6f9b3-9c5c-4831-97b4-21848e473ef4",
                        "source_entry_id": "69747687-8f7e-371c-9956-cdacc91d78b8",
                        "source_sense_description": "navigable body of water",
                        "target_lang_word": "Wasserstraße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserstraße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8243a1d7-8fa6-3307-908f-93252b077395",
                                        "entry_id": "a6258a44-9f96-37d6-bbfb-6fa45986ab8f",
                                        "glosses": [
                                            "Gewässer, das von Schiffen befahren wird"
                                        ],
                                        "tags": [
                                            "Verkehrsinfrastruktur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c66d9299-3d86-4571-866f-db29f6dc6f95",
                                                "sense_id": "8243a1d7-8fa6-3307-908f-93252b077395",
                                                "text": "Der Rhein ist eine wichtige Wasserstraße in Mitteleuropa."
                                            },
                                            {
                                                "example_id": "d2f7ce9f-2933-4c6e-9673-43bea0d40694",
                                                "sense_id": "8243a1d7-8fa6-3307-908f-93252b077395",
                                                "text": "„Der Nord-Ostsee-Kanal ist die meistbefahrene künstliche Wasserstraße der Welt; ihn passieren mehr Schiffe als Panama- und Sueskanal zusammen.“"
                                            },
                                            {
                                                "example_id": "d8bf1849-a3ba-4c68-9ca3-3fbecacb14d2",
                                                "sense_id": "8243a1d7-8fa6-3307-908f-93252b077395",
                                                "text": "„Die schmale Wasserstraße zwischen dem grauen Fels von Gibraltar am südwestlichen Zipfel Europas und den dunklen marokkanischen Hügeln an der Spitze Afrikas ist ein magischer Ort.“"
                                            },
                                            {
                                                "example_id": "7584f691-e153-4b32-a84c-118d755bafa5",
                                                "sense_id": "8243a1d7-8fa6-3307-908f-93252b077395",
                                                "text": "„Auf den Wasserstraßen ist kein Verkehr, es entfällt, was die Inseln zum Sportfeld machte: touristischer Massenluxus der nördlichen Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15a82905-fa6f-4d05-827b-44ee4f664f1c",
                        "source_entry_id": "69747687-8f7e-371c-9956-cdacc91d78b8",
                        "source_sense_description": "navigable body of water",
                        "target_lang_word": "Wasserweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75d9d4ea-8570-36b8-861d-dd03433b1c12",
                                        "entry_id": "95749e78-6605-390f-b698-eb7688fd6caa",
                                        "glosses": [
                                            "Gewässer, das als Verkehrsweg genutzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d32245a-5114-4d01-b426-692a17e54176",
                                                "sense_id": "75d9d4ea-8570-36b8-861d-dd03433b1c12",
                                                "text": "Schiffbare Flüsse und Kanäle sind Wasserwege."
                                            },
                                            {
                                                "example_id": "f3f566e5-634d-416a-a71e-eb25463dc3e0",
                                                "sense_id": "75d9d4ea-8570-36b8-861d-dd03433b1c12",
                                                "text": "„Ein halbwegs bequemer und gerader Wasserweg ist der Rhein freilich nicht immer gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0bbfaf4c-f18d-3cb0-ab82-de18f9f3b307",
                                        "entry_id": "95749e78-6605-390f-b698-eb7688fd6caa",
                                        "glosses": [
                                            "Transportweg auf dem Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02cb3706-bde0-466c-b713-3092cd9f293d",
                                                "sense_id": "0bbfaf4c-f18d-3cb0-ab82-de18f9f3b307",
                                                "text": "Große Güter können günstig auf dem Wasserweg befördert werden."
                                            },
                                            {
                                                "example_id": "6d8fc4bb-ca77-4749-a0d3-6c4f1f87858a",
                                                "sense_id": "0bbfaf4c-f18d-3cb0-ab82-de18f9f3b307",
                                                "text": "„Der Warentransport erfolgte in erster Linie auf dem Wasserweg.“"
                                            },
                                            {
                                                "example_id": "8b22f634-8ea6-4bd1-9d61-6268b3ea46d4",
                                                "sense_id": "0bbfaf4c-f18d-3cb0-ab82-de18f9f3b307",
                                                "text": "„Gestern Nacht steuerten wir auf die afrikanische Küste zu, schwenkten jedoch in der Morgendämmerung um und fuhren denselben Wasserweg wieder zurück.“"
                                            },
                                            {
                                                "example_id": "707ce61c-88af-411c-903d-e1df50bea7ff",
                                                "sense_id": "0bbfaf4c-f18d-3cb0-ab82-de18f9f3b307",
                                                "text": "„Wir wurden nun auf ein Küstenschiff verfrachtet und auf dem Wasserweg nach Halifax gebracht.“"
                                            },
                                            {
                                                "example_id": "67d66820-a0fb-4d08-b8fb-3d4d7af68c9f",
                                                "sense_id": "0bbfaf4c-f18d-3cb0-ab82-de18f9f3b307",
                                                "text": "„Der Landrat war inzwischen zum Randstützpunktkommissar für den Bezirk Jändschou in der Provinz Tschekiang befördert worden und hatte sich auf dem Wasserwege in sein neues Amt begeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c22beb4-4aa1-4fe0-9443-0ad659ae08ad",
                        "source_entry_id": "69747687-8f7e-371c-9956-cdacc91d78b8",
                        "source_sense_description": "navigable body of water",
                        "target_lang_word": "Fahrwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "881330a6-85d2-37dd-abf7-addd9aa0b514",
                                        "entry_id": "fcde06aa-2dcf-3dff-8fbb-be3c9786e4da",
                                        "glosses": [
                                            "durch Seezeichen markierter Weg in einem flachen Gewässer, der den Schiffsverkehr entlang der sichersten oder der tiefsten Route leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef2c823-868d-4b93-9211-1d1299c4cabb",
                                                "sense_id": "881330a6-85d2-37dd-abf7-addd9aa0b514",
                                                "text": "Der Kapitän war glücklich, als er in tieferes Fahrwasser gelangte."
                                            },
                                            {
                                                "example_id": "dd9e58da-b957-4336-9994-8e0031be1fb0",
                                                "sense_id": "881330a6-85d2-37dd-abf7-addd9aa0b514",
                                                "text": "„Aber auch für die Einwanderer, die es bei früheren Überfahrten in das ruhige Fahrwasser hinter Nova Scotia geschafft hatten, war der erste Eindruck der neuen Heimat enttäuschend.“"
                                            },
                                            {
                                                "example_id": "f9089048-29f5-40de-9a3c-398a8f0c6785",
                                                "sense_id": "881330a6-85d2-37dd-abf7-addd9aa0b514",
                                                "text": "„Die eigentliche Strömung und das Fahrwasser des Mississippi lagen auf der rechten Seite der Insel; die Entfernung zwischen dem schmalen Zwischenstreifen und Arkansas betrug eine Meile, der Raum zwischen Einundsechzig und dem Staat Mississippi kaum die Hälfte.“"
                                            },
                                            {
                                                "example_id": "611e8852-7061-49af-b159-e3518890c0c7",
                                                "sense_id": "881330a6-85d2-37dd-abf7-addd9aa0b514",
                                                "text": "„Damit war aber der Steuermann nicht einverstanden; er meinte, sie hätten nicht weit von Helena eine Insel mit ziemlich schmalem Fahrwasser zu passieren, durch das sie aber acht Meilen Biegung abschnitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc726ea9-cf52-34df-8afa-dafdfd9c73bb",
                                        "entry_id": "fcde06aa-2dcf-3dff-8fbb-be3c9786e4da",
                                        "glosses": [
                                            "Spur, welche ein Schiff in der Vorwärtsbewegung auf der Fläche des Wassers zurücklässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d749f75e-ac3c-4481-b32b-d900d1ddb9a6",
                                                "sense_id": "bc726ea9-cf52-34df-8afa-dafdfd9c73bb",
                                                "text": "Ein Schiff legt sich in den Sog oder das Fahrwasser eines anderen Schiffes, wenn es dessen Spur nachfährt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
