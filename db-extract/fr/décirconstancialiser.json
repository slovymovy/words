                "senses": [
                    {
                        "sense_id": "410f5db5-01c7-39bf-8ae4-80522f3dd901",
                        "entry_id": "e38693bb-fd5d-3a4f-a1cd-8a96f2d7c500",
                        "glosses": [
                            "Faire perdre son caractère circonstanciel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0da3a0-bf42-49bf-821f-6ad8eb0dca0f",
                                "sense_id": "410f5db5-01c7-39bf-8ae4-80522f3dd901",
                                "text": "Cette éversion de la représentation décirconstancialise le récit et empêche que le fait de course qu’il rapporte soit une simple péripétie bientôt noyée dans l’immensurable statistique et palmarès du sport."
                            },
                            {
                                "example_id": "24875623-9374-4f42-a3c9-1930379993df",
                                "sense_id": "410f5db5-01c7-39bf-8ae4-80522f3dd901",
                                "text": "Est hypothèse valable toute construction intellectuelle qui découvre dans la réalité présente une autre réalité plus ou moins cachée, et qui, décirconstancialisée, a valeur de certitude pour l’avenir."
                            }
                        ]
                    }
