                "senses": [
                    {
                        "sense_id": "c0e343f6-0361-3b1b-b72f-424c1d9a6e0b",
                        "entry_id": "08b6e680-549d-3b67-b102-6aeaea826a62",
                        "glosses": [
                            "Acteur du réseau Internet impliqué dans ses aspects citoyens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed64f8ac-fa90-4072-a4f3-7a1cc86614ec",
                                "sense_id": "c0e343f6-0361-3b1b-b72f-424c1d9a6e0b",
                                "text": "« J’ai des doutes sur l’indépendance de la Justice en Chine », a confié le cybercitoyen Dianfuzishangwudeguairen sur le service de microblogs de Sina.com."
                            },
                            {
                                "example_id": "1d86b643-0ad8-4678-8060-22ce4a95a1b9",
                                "sense_id": "c0e343f6-0361-3b1b-b72f-424c1d9a6e0b",
                                "text": "Le résident branché est un internaute qui utilise le Web pour s’informer et accéder aux services sans s’impliquer dans les affaires du milieu, tandis que le cybercitoyen est un citoyen actif et bien branché qui, outre le fait qu’il accède aux services en ligne, ne manque pas une occasion de participer à des consultations en ligne ou à prendre part à des communautés virtuelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1d41742-8f71-4b74-b302-e3135a46e8ee",
                        "source_entry_id": "08b6e680-549d-3b67-b102-6aeaea826a62",
                        "source_sense_id": "c0e343f6-0361-3b1b-b72f-424c1d9a6e0b",
                        "target_lang_word": "Netizen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Netizen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c03a8822-7f59-31e5-8fe8-ec7807cf013b",
                                        "entry_id": "af8d2481-971c-31eb-8884-186a560e746d",
                                        "glosses": [
                                            "Person, die im Internet agiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be373823-c316-4eb0-ab5b-55a1fd029ca2",
                                                "sense_id": "c03a8822-7f59-31e5-8fe8-ec7807cf013b",
                                                "text": "Damit spielt sie zu Recht auf die Tatsache an, dass engagierte Netizen nie nur ›neutrale‹ Technik einrichten und verwalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3b0ecfd-7ec6-46ad-8474-d22f982d1a3f",
