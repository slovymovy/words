                "senses": [
                    {
                        "sense_id": "75d5e0d9-5941-37da-a660-0219e1392df9",
                        "entry_id": "ec8f80ab-74e4-3e21-b6c2-ab637a266125",
                        "glosses": [
                            "erster Teil eines Studiums – bis zur Zwischenprüfung/bis zum Vordiplom – an einer Hochschule/Universität, das mit einem Magister- oder Staatsexamen oder Diplom endet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9cdba5-8a68-4394-9e92-9cbfd2763b90",
                                "sense_id": "75d5e0d9-5941-37da-a660-0219e1392df9",
                                "text": "„Es soll eine Art G r u n d w i s s e n über die heutigen sechs nordgermanischen Sprachen (Schwedisch, Dänisch, Norwegisch: Bokmål und Nynorsk, Isländisch sowie Färöisch) vermitteln, so daß es als sprachübergreifendes Lehrbuch bereits im Grundstudium des Faches Skandinavistik/Nordistik/Nordische Philologie benutzt werden kann.“"
                            },
                            {
                                "example_id": "3eae5991-a2b7-448e-b097-e16934aad9eb",
                                "sense_id": "75d5e0d9-5941-37da-a660-0219e1392df9",
                                "text": "„In dem bunten Völkchen, das sich da zum Grundstudium versammelt hatte, gewann Sung zum ersten Mal in seinem Leben Freunde.“"
                            },
                            {
                                "example_id": "45910931-346e-42ba-96ed-0cb40064ae2c",
                                "sense_id": "75d5e0d9-5941-37da-a660-0219e1392df9",
                                "text": "„Während des Grundstudiums hatte Carolyn sich ihr Zimmer mit einer der Unruhestifterinnen der Universität geteilt, einer charismatischen Rebellin à la Abbie Hoffmann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
