                                "example_id": "cefb0a9e-2ce7-47b0-89f6-b02e49f21af0",
                                "sense_id": "90d68113-ca4a-3070-a787-832154309a14",
                                "text": "Die Katze Tiffy wurde von ihren Haltern nach der Zwangsräumung einfach in Flensburg auf der Straße ausgesetzt."
                            },
                            {
                                "example_id": "56f6729d-9aac-4f4d-ac62-082ee58614a6",
                                "sense_id": "90d68113-ca4a-3070-a787-832154309a14",
                                "text": "„In Karlsruhe wurde am Mittwoch ein 47-jähriger Gerichtsvollzieher bei einer Zwangsräumung erschossen.“"
                            },
                            {
                                "example_id": "2a6a4951-fb98-4958-8a2e-1cb65bb71a43",
                                "sense_id": "90d68113-ca4a-3070-a787-832154309a14",
                                "text": "Nachdem die Mieterin ein Jahr lang keine Miete gezahlt hatte, kam es nun zur Zwangsräumung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
