                        "sense_id": "3dbbe687-2195-31fd-accb-3c166556f9ab",
                        "entry_id": "54fef9e3-b77e-3c57-af75-406370e588f6",
                        "glosses": [
                            "een chemische verbinding met twee koolstofatomen en een alcoholgroep"
                        ],
                        "tags": [
                            "IUPAC-naam"
                        ],
                        "examples": [
                            {
                                "example_id": "50b841d2-9284-43bc-9f7a-102ee0fb24b8",
                                "sense_id": "3dbbe687-2195-31fd-accb-3c166556f9ab",
                                "text": "De meest bekende alcohol en de enige die drinkbaar is, is ethanol."
                            }
