                "senses": [
                    {
                        "sense_id": "b2267f52-9434-3b0b-a716-eab89bc3cac2",
                        "entry_id": "efc4503b-1028-3646-90c1-5e9e692d6ff2",
                        "glosses": [
                            "свойство по значению прилагательного сознательный; чувство долга, ответственности; способность отдавать себе отчет в окружающей действительности и в том, как следует действовать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d2530cfa-ae44-3802-9511-4a441345b08d",
                        "entry_id": "efc4503b-1028-3646-90c1-5e9e692d6ff2",
                        "glosses": [
                            "обдуманность, намеренность"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea051fe1-abbb-442a-a0e6-d8e474fc9c03",
                        "source_entry_id": "efc4503b-1028-3646-90c1-5e9e692d6ff2",
                        "source_sense_description": "чувство долга, ответственности",
                        "target_lang_word": "consciousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consciousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec0b5bff-dc49-3042-97a0-664494cd85bc",
                                        "entry_id": "0bd91299-0d90-346d-8093-6a7d948c6a91",
                                        "glosses": [
                                            "The state of being conscious or aware; awareness.",
                                            "The state or trait of having cognition and sensation; cognition and sensation themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deb18b46-e10e-480c-a194-989f66d6bf70",
                                                "sense_id": "ec0b5bff-dc49-3042-97a0-664494cd85bc",
                                                "text": "To lose consciousness after striking one's head"
                                            },
                                            {
                                                "example_id": "61ab6081-0c6c-4c9c-86b9-255407c9a338",
                                                "sense_id": "ec0b5bff-dc49-3042-97a0-664494cd85bc",
                                                "text": "Consciousness is universal and precedes even the formation of our solar system."
                                            },
                                            {
                                                "example_id": "8de8423a-b164-44e0-a843-061e373775a2",
                                                "sense_id": "ec0b5bff-dc49-3042-97a0-664494cd85bc",
                                                "text": "Yet this is the level of organisation that does the actual thinking—and is, presumably, the seat of consciousness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cce1b155-99ef-3d8b-b907-4aa2de152d15",
                                        "entry_id": "0bd91299-0d90-346d-8093-6a7d948c6a91",
                                        "glosses": [
                                            "The state of being conscious or aware; awareness.",
                                            "The fact of having knowledge of a particular fact or matter; cognizance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00dc0d7c-8a5e-4b39-b1d1-385813cca886",
                                                "sense_id": "cce1b155-99ef-3d8b-b907-4aa2de152d15",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "490efe49-7771-4118-b830-b471d6552f63",
                                                "sense_id": "cce1b155-99ef-3d8b-b907-4aa2de152d15",
                                                "text": "The solitude and the savage freedom filled his heart with life and buoyancy. Again he was Tarzan of the Apes—every sense alert against the chance of surprise by some jungle enemy—yet treading lightly and with head erect, in proud consciousness of his might."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9413e0d-752c-3372-bd8d-e5dcd4d7a539",
                                        "entry_id": "0bd91299-0d90-346d-8093-6a7d948c6a91",
                                        "glosses": [
                                            "The state of being conscious or aware; awareness.",
                                            "Acute awareness (of something) and belief in its communal relevance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b51cbda-deeb-4259-ae49-004cac8100b7",
                                                "sense_id": "f9413e0d-752c-3372-bd8d-e5dcd4d7a539",
                                                "text": "the development of a feminist consciousness"
                                            },
                                            {
                                                "example_id": "13768939-266f-467d-b2bc-a4e2149a3f9c",
                                                "sense_id": "f9413e0d-752c-3372-bd8d-e5dcd4d7a539",
                                                "text": "This new anti-military consciousness surfaced at the Gay Academic Union Conference held last month in New York, where two broadsides and a meeting were held to discuss the situation. And in San Francisco, after a stormy meeting of Bay Area Gay Liberation (BAGEL), the group refused to co-sponsor a fund-raising event for former T/Sgt. Leonard Matlovich."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57ded53-55f5-34be-ba48-748bff1e9f55",
                                        "entry_id": "0bd91299-0d90-346d-8093-6a7d948c6a91",
                                        "glosses": [
                                            "A being with cognition."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3822965a-8060-424a-a8e4-c208f3e9300b",
                                                "sense_id": "f57ded53-55f5-34be-ba48-748bff1e9f55",
                                                "text": "The pantheistic mainstream asari religion is siari, which translates roughly as \"All is one.\" The faithful agree on certain core truths: the universe is a consciousness, every life within it is an aspect of the greater whole, and death is a merging of one's spiritual energy back into the greater universal consciousness. Siarists don't specifically believe in reincarnation; they believe that spiritual energy returned to the universal consciousness upon death will eventually be used to fill new mortal vessels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
