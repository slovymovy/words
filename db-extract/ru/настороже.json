        "ru-extract.jsonl": [
            {
                "entry_id": "9390ec69-de7c-38b2-9387-69924d0a88b5",
                "word": "настороже",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da6827db-a6ae-320b-80e5-0edb464cef26",
                        "entry_id": "9390ec69-de7c-38b2-9387-69924d0a88b5",
                        "glosses": [
                            "в состоянии напряжённого ожидания чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f345461a-b097-419b-8c65-90602ff26557",
                                "sense_id": "da6827db-a6ae-320b-80e5-0edb464cef26",
                                "text": "Не бойтесь, барышня, подойдите к нему; я буду настороже…"
                            },
                            {
                                "example_id": "a8b3fbe8-7c49-41dd-b9eb-c07386074322",
                                "sense_id": "da6827db-a6ae-320b-80e5-0edb464cef26",
                                "text": "Пьер чувствовал себя особенно дружелюбно расположенным ко всем людям, которых он встречал; но невольно теперь он держал себя со всеми людьми настороже, так, чтобы не связать себя чем-нибудь."
                            },
                            {
                                "example_id": "5f39f57a-45f8-4e1c-adea-b14f45df122d",
                                "sense_id": "da6827db-a6ae-320b-80e5-0edb464cef26",
                                "text": "В городе же он постоянно казался беспокоен и настороже, как будто боясь, чтобы кто-нибудь не обидел его и, главное, её."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5221ea4c-c86e-4f8d-a2d5-c1fff21416f4",
                        "source_entry_id": "9390ec69-de7c-38b2-9387-69924d0a88b5",
                        "source_sense_id": "da6827db-a6ae-320b-80e5-0edb464cef26",
                        "target_lang_word": "on the alert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
