                    {
                        "sense_id": "a56d3023-578c-36d8-a1ee-9470e89883db",
                        "entry_id": "8da6f22a-a60b-33b2-856b-63275831b36f",
                        "glosses": [
                            "north wind"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ac7b5555-f237-425e-b8fd-05ca4a9d8c73",
                                "sense_id": "a56d3023-578c-36d8-a1ee-9470e89883db",
                                "text": "D'un souffle l'aquilon écarte les nuages,",
                                "translation": "In a breath the north wind dispels the clouds,\nand drive the lightning and storm far away.",
                                "english": "In a breath the north wind dispels the clouds,\nand drive the lightning and storm far away."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed3707f8-367b-3fd2-a661-59e3036b9f39",
                        "entry_id": "8da6f22a-a60b-33b2-856b-63275831b36f",
                        "glosses": [
                            "strong wind, gale"
                        ],
                        "tags": [
                            "literary",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "60f54d02-201c-4c8c-b6a2-54adcd2cbfe8",
                                "sense_id": "ed3707f8-367b-3fd2-a661-59e3036b9f39",
                                "text": "Et moi, je suis semblable à la feuille flétrie :",
                                "translation": "As for me, I am like a withered leaf.\nCarry me like a leaf, stormy gale!",
                                "english": "As for me, I am like a withered leaf.\nCarry me like a leaf, stormy gale!"
                            }
                        ]
                    }
                ],
