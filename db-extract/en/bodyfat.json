                                                "sense_id": "bd4b8948-80f5-3d8b-b3e1-a7f8839d4df9",
                                                "text": "„Durch ihren geringen Anteil an Körperfett und Knochenmasse bestehen Kleinkinder zu mehr als 70 Prozent aus Wasser.“"
                                            },
                                            {
                                                "example_id": "4a8e84a2-41c6-43c6-a43f-d338d073ef31",
                                                "sense_id": "bd4b8948-80f5-3d8b-b3e1-a7f8839d4df9",
                                                "text": "„Bei einem jungen erwachsenen Mann beträgt der Wasseranteil noch etwa 60 Prozent gegenüber nur 50 Prozent bei einer jungen Frau, da der weibliche Körper typischerweise mehr Körperfett und weniger Muskelmasse als der männliche besitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
