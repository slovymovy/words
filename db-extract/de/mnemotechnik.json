                    {
                        "translation_id": "f486423b-772b-46df-844c-7b3b321e474d",
                        "source_entry_id": "77fa4a19-171d-3e63-b082-a0c29e94368f",
                        "source_sense_id": "336d0cf9-d3e9-37d9-829d-ff379a0f2593",
