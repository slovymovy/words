                ],
                "senses": [
                    {
                        "sense_id": "8c2ae077-a72f-3fd9-8c69-a5117bb6ee9a",
                        "entry_id": "25b53392-308d-3512-9699-f2c39e689aac",
                        "glosses": [
                            "(im Winter) die nackten Knöchel sehen lassen"
                        ],
                        "tags": [
                            "Mode",
                            "Trend"
                        ],
                        "examples": [
                            {
                                "example_id": "5c8b1b75-9806-4bc3-9dcf-7ff36cff8621",
                                "sense_id": "8c2ae077-a72f-3fd9-8c69-a5117bb6ee9a",
                                "text": "„Denn der ‚Knöchel-Exhibitionismus‘ ist bereits drei Winter alt. Seitdem geht das schon so mit dem Flanking und ungefähr so lange wundert sich ein Teil der Bevölkerung darüber, dass die anderen nicht frieren.“"
                            },
                            {
                                "example_id": "b447f41e-de5f-446a-87cc-72485f034b27",
                                "sense_id": "8c2ae077-a72f-3fd9-8c69-a5117bb6ee9a",
                                "text": "„Von Flanking hat er zwar noch nie gehört, einem Kunstwort zusammengesetzt aus 'flashing', also 'aufblitzen' und 'ankle', dem Knöchel. Aber er kennt einen Düsseldorfer Geschäftsmann, der seit Jahren - auch im Winter - im Anzug mit Krawatte, aber ohne Schuhe durch die Stadt läuft.“"
                            },
                            {
                                "example_id": "292c2dab-962f-4569-8a5c-e5cf4cd25e5e",
                                "sense_id": "8c2ae077-a72f-3fd9-8c69-a5117bb6ee9a",
                                "text": "„Wer schön sein will, muss leiden. Der Trend der nackten Fesseln, auch ‚Flanking‘ genannt, macht es vor – auch bei Eiseskälte.“"
                            },
                            {
                                "example_id": "e1b4986d-daf3-4d8d-a852-ce4174397525",
                                "sense_id": "8c2ae077-a72f-3fd9-8c69-a5117bb6ee9a",
                                "text": "„Beim Flanking lässt man auch im Winter die Wollsocken weg und zeigt Knöchel.“"
                            },
                            {
                                "example_id": "95f86e0d-711f-4d74-86dc-514943619456",
                                "sense_id": "8c2ae077-a72f-3fd9-8c69-a5117bb6ee9a",
                                "text": "„‚Flanking‘ heißt ein kurioser Modetrend, der auch im tiefsten Winter auf entblößte Knöchel setzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
