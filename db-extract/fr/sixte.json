            {
                "entry_id": "af770ed8-d418-3026-88a9-223fc437f4e3",
                "word": "sixte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "901853d8-7de2-4548-be52-fa61f77b5f5d",
                        "entry_id": "af770ed8-d418-3026-88a9-223fc437f4e3",
