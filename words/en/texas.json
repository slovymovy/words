                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain stood on the <w>texas</w> to get a better view of the river ahead.",
                            "target_lang_translations": {
                                "ru": "Капитан стоял на <w>техасе</w>, чтобы лучше видеть реку впереди.",
                                "zh": "船长站在<w>顶层甲板舱</w>上，以便更好地看清前方的河道。"
                            }
                        },
                        {
                            "text": "Smoke from the chimneys drifted past the <w>texas</w> as the boat accelerated.",
                            "target_lang_translations": {
                                "ru": "Дым из труб проплывал мимо <w>техаса</w>, когда пароход набирал скорость.",
                                "zh": "当轮船加速时，烟囱冒出的烟飘过了<w>顶层舱室</w>。"
                            }
                        }
