        "fr-extract.jsonl": [
            {
                "entry_id": "40e9be67-c560-34b4-abe0-e04b8e12ca31",
                "word": "objurgation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2c95643b-2cad-4ca9-a70f-0d4dd5736a66",
                        "entry_id": "40e9be67-c560-34b4-abe0-e04b8e12ca31",
                        "tags": [
                            "plural"
                        ],
                        "form": "objurgations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43447427-1403-3b5b-9c28-98dcf17b17da",
                        "entry_id": "40e9be67-c560-34b4-abe0-e04b8e12ca31",
                        "glosses": [
                            "Action d’objurguer."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "197d8b33-74fb-4e79-b1e6-cd875f23a5cf",
                                "sense_id": "43447427-1403-3b5b-9c28-98dcf17b17da",
                                "text": "Antonia se cantonna dans son veuvage, malgré les objurgations d’Auguste."
                            }
                        ]
                    },
                    {
                        "sense_id": "586420de-fdb2-31e6-87dc-4cbef6d0ca7d",
                        "entry_id": "40e9be67-c560-34b4-abe0-e04b8e12ca31",
                        "glosses": [
                            "Paroles vives par lesquelles on essaie de détourner quelqu’un d’agir comme il se propose de le faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfad3f73-38e1-41cb-bb79-aa6ba8870e65",
                                "sense_id": "586420de-fdb2-31e6-87dc-4cbef6d0ca7d",
                                "text": "Ni les objurgations de ses amis, ni les pleurs de Miriota, n’avaient pu influencer le forestier. D’ailleurs, cela ne surprit personne. On connaissait son caractère indomptable, sa ténacité, disons son entêtement."
                            },
                            {
                                "example_id": "c768a342-1620-4040-95d2-e4ddda9fb07c",
                                "sense_id": "586420de-fdb2-31e6-87dc-4cbef6d0ca7d",
                                "text": "Au milieu de ses faiblesses, il avait des accès de révolte, des sursauts d’indignation, sous l’impulsion des personnalités honnêtes qui se rencontrèrent toujours parmi ses membres et dont les objurgations véhémentes lui faisaient honte de lui-même."
                            },
                            {
                                "example_id": "a81509bc-0631-4c94-ad20-691f049651b5",
                                "sense_id": "586420de-fdb2-31e6-87dc-4cbef6d0ca7d",
                                "text": "Il empoigna Bert par l’épaule, et le secoua vigoureusement, accompagnant ses gourmades d’objurgations irritées et le repoussant avec violence en arrière."
                            },
                            {
                                "example_id": "f047efeb-df52-460f-a201-9c5233450c61",
                                "sense_id": "586420de-fdb2-31e6-87dc-4cbef6d0ca7d",
                                "text": "Philippe-Auguste resta sourd à ces objurgations, car il avait trop besoin des juifs."
                            },
                            {
                                "example_id": "8455915a-bead-4659-a47a-0a3bf750486e",
                                "sense_id": "586420de-fdb2-31e6-87dc-4cbef6d0ca7d",
                                "text": "Aux tendres invites de ma mère, aux objurgations bourrues de mon père j’opposais la force d’inertie."
                            },
                            {
                                "example_id": "293ea43f-47ec-4a18-b059-552436a5fcac",
                                "sense_id": "586420de-fdb2-31e6-87dc-4cbef6d0ca7d",
                                "text": "Comme j’étais profondément têtue, mais superficiellement très influençable, ses objurgations, s’ajoutant à celles que m’avaient discrètement prodiguées Mademoiselle Lambert et Suzanne Boigue, me fournirent un prétexte à m’agiter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39c29d04-e032-4e8b-8e98-5c3f6f6013e7",
                        "source_entry_id": "40e9be67-c560-34b4-abe0-e04b8e12ca31",
                        "target_lang_word": "objurgation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objurgation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a31dc28d-7da0-3a56-b795-94f57ba2d57c",
                                        "entry_id": "308c74ac-6b79-3d5d-84b4-c4a7ad1c5bf3",
                                        "glosses": [
                                            "A strong rebuke or scolding."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f78f6cc-becb-4ce6-894e-e03902b1478d",
                                                "sense_id": "a31dc28d-7da0-3a56-b795-94f57ba2d57c",
                                                "text": "Nevertheless, spite of this imperial objurgation, the short cloaks continued in fashion down to the time of which we treat, and particularly among the princes of the House of Anjou."
                                            },
                                            {
                                                "example_id": "1ae13b5e-7011-4533-b59f-11e70cd6caac",
                                                "sense_id": "a31dc28d-7da0-3a56-b795-94f57ba2d57c",
                                                "text": "The tipsy drivers dashed gallantly over the turf, amidst the admiration of foot-passengers, the ironical cheers of the little donkey-carriages and spring vans, and the loud objurgations of horse-and-chaise men, with whom the reckless post-boys came in contact."
                                            },
                                            {
                                                "example_id": "3fb62523-0e32-4113-a790-8c780a90a0fb",
                                                "sense_id": "a31dc28d-7da0-3a56-b795-94f57ba2d57c",
                                                "text": "And what mean these outbursts and objurgations of his, you will ask; these suggestions, furtive, rhapsodical, mystical; this furibund allegro about Money, Mediums, and Bohemia; [...]"
                                            },
                                            {
                                                "example_id": "e0d91686-a0f4-456c-bfb6-37ebfbf1142a",
                                                "sense_id": "a31dc28d-7da0-3a56-b795-94f57ba2d57c",
                                                "text": "Wild man Murphy, said, \"that the people of the 'Mormon' Church did not regard the objurgation of 'damn' as swearing, but only as common-place slang.\""
                                            },
                                            {
                                                "example_id": "36436ca8-a3aa-4b89-a7a6-a66d3e27bf1c",
                                                "sense_id": "a31dc28d-7da0-3a56-b795-94f57ba2d57c",
                                                "text": "Unknown fronds of trees arched over him, brushing his face, while cobbles punctuated the rubber wheels of some dark ambulance full of metal and other dark bodies, whose talk was of limbo — a repulsive yelping streaked with Arabic objurgations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "213747b9-8db9-4c25-9a6d-f3177e278eb8",
                        "source_entry_id": "40e9be67-c560-34b4-abe0-e04b8e12ca31",
                        "target_lang_word": "vermaning",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermaning",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                                        "entry_id": "fa827805-5a24-37c5-9951-8910cd4d77b2",
                                        "glosses": [
                                            "met veel nadruk zeggen dat iemand zijn leven moet beteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313a960a-b668-4a06-84c4-efc34a8e8a32",
                                                "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                                                "text": "1.280 varkens in nood en dan wegkomen met een vermaning."
                                            },
                                            {
                                                "example_id": "613299eb-9fe3-46aa-bb11-e4ea4faf05f5",
                                                "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                                                "text": "Nogal onbeleefd in de ogen van Afrikaanse gezagsdragers, maar hij deed er de studenten in het warme zaaltje een plezier mee. Wie als gelijke wil worden behandeld, moet tegen een geintje en een stootje kunnen, is Macrons impliciete vermaning."
                                            },
                                            {
                                                "example_id": "1c860d85-5285-49f4-8b24-48b70ca13016",
                                                "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                                                "text": "Vanaf Sociale Zaken meldde zich staatssecretaris Tamara van Ark met een vermaning aan het adres van de gemeenten: hoogste tijd dat zij nu echt eens de 'taaleis'gaan handhaven in de bijstand. Dat betekent dat bijstandsgerechtigden de Nederlandse taal moeten beheersen of die snel moeten gaan leren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d878327-09dc-36cc-adce-766e0eacaf91",
                                        "entry_id": "fa827805-5a24-37c5-9951-8910cd4d77b2",
                                        "glosses": [
                                            "doopsgezinde kerk"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e164b06-db7f-43fa-a989-9de6c35039a8",
                        "source_entry_id": "40e9be67-c560-34b4-abe0-e04b8e12ca31",
                        "target_lang_word": "waarschuwing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waarschuwing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                        "entry_id": "226d3bcf-89b9-3a20-8db3-fd61f88f9160",
                                        "glosses": [
                                            "een mededeling dat er onaangename of gevaarlijke gevolgen op til zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce4fc29-964e-4378-95de-4bb92014c0ab",
                                                "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                                "text": "Iemand heeft deze waarschuwing pas kortgeleden met geweld omvergeduwd, waardoor de poot knakte."
                                            },
                                            {
                                                "example_id": "217a0345-4ac5-4508-b68e-30e606c93b1b",
                                                "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                                "text": "Als dat wordt verkocht, moet er op de verpakking een waarschuwing staan voor mensen met een schaaldierenallergie."
                                            },
                                            {
                                                "example_id": "85444332-a188-4b7a-9a56-f13eceae3361",
                                                "sense_id": "f5d5e306-b199-354c-8e6c-8c47edf69174",
                                                "text": "Ook werden er waarschuwingen bij specifieke stukken trail achtergelaten, zoals bijvoorbeeld op welke plek men het best een gevaarlijke rivier in de bergen kon oversteken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
