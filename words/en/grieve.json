{
    "word_family": [
        "grief",
        "grievance",
        "grievous",
        "grievously"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a9a6526-8e98-3567-8d2a-c6490b388cc6",
                    "sense_definition": "To feel deep sadness or sorrow, especially over someone's death.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sorrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire family gathered to <w>grieve</w> after the sudden loss of their grandmother.",
                            "target_lang_translations": {
                                "ru": "Вся семья собралась, чтобы <w>поскорбеть</w> после внезапной кончины бабушки."
                            }
                        },
                        {
                            "text": "Everyone needs enough time to <w>grieve</w> properly after experiencing a tragic event.",
                            "target_lang_translations": {
                                "ru": "Каждому нужно достаточно времени, чтобы как следует <w>пережить горе</w> после трагического события."
                            }
                        }
                    ],
                    "synonyms": [
                        "mourn",
                        "sorrow"
                    ],
                    "antonyms": [
                        "rejoice"
                    ],
                    "common_phrases": [
                        "grieve for",
                        "grieve over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать глубокую печаль, скорбь, особенно из-за чьей-либо смерти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорбеть",
                                "target_lang_sense_clarification": "испытывать глубокую скорбь, переживать утрату"
                            },
                            {
                                "target_lang_word": "горевать",
                                "target_lang_sense_clarification": "испытывать горе, тяжело переживать"
                            },
                            {
                                "target_lang_word": "оплакивать",
                                "target_lang_sense_clarification": "предаваться горю, горевать о потере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4b52ec6-1c90-3d11-af58-3507acf335df",
                    "sense_definition": "To feel profound sorrow or sadness about a particular person, thing, or loss.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sorrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She continued to <w>grieve</w> her departed friend for many years.",
                            "target_lang_translations": {
                                "ru": "Она продолжала <w>оплакивать</w> ушедшего друга долгие годы."
                            }
                        },
                        {
                            "text": "Many citizens still <w>grieve</w> the loss of their historic town hall.",
                            "target_lang_translations": {
                                "ru": "Многие горожане до сих пор <w>горюют</w> из-за утраты исторического здания ратуши."
                            }
                        }
                    ],
                    "synonyms": [
                        "mourn",
                        "lament",
                        "bemoan"
                    ],
                    "common_phrases": [
                        "grieve the loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать глубокую печаль или скорбь о конкретном человеке, вещи или утрате."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплакивать",
                                "target_lang_sense_clarification": "тяжело переживать конкретную утрату кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "скорбеть",
                                "target_lang_sense_clarification": "тосковать и грустить по поводу утраты"
                            },
                            {
                                "target_lang_word": "горевать",
                                "target_lang_sense_clarification": "сожалеть и тосковать о чём-либо или ком-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21ae99bc-cbe5-3924-a8e6-b53e99794ac1",
                    "sense_definition": "To cause sorrow, deep distress, or emotional pain to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sorrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>grieves</w> me deeply to see so many families struggling without adequate shelter.",
                            "target_lang_translations": {
                                "ru": "Меня глубоко <w>печалит</w> видеть столько семей, страдающих без нормального жилья."
                            }
                        },
                        {
                            "text": "His unkind words <w>grieved</w> her more than she cared to admit.",
                            "target_lang_translations": {
                                "ru": "Его злые слова <w>ранили</w> её сильнее, чем она готова была признать."
                            }
                        }
                    ],
                    "synonyms": [
                        "sadden",
                        "distress"
                    ],
                    "antonyms": [
                        "gladden",
                        "delight"
                    ],
                    "common_phrases": [
                        "it grieves me to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять кому-либо печаль, душевную боль или глубокое огорчение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огорчать",
                                "target_lang_sense_clarification": "причинять душевную боль, расстраивать"
                            },
                            {
                                "target_lang_word": "печалить",
                                "target_lang_sense_clarification": "вызывать грусть, опечаливать"
                            },
                            {
                                "target_lang_word": "тяготить",
                                "target_lang_sense_clarification": "причинять душевную боль, ранить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9c2a6de-8ab8-3cbb-9b15-6154beaa4c97",
                    "sense_definition": "To formally submit or file a complaint through a grievance procedure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The union decided to <w>grieve</w> the dismissal of the worker under the collective bargaining agreement.",
                            "target_lang_translations": {
                                "ru": "Профсоюз решил <w>обжаловать</w> увольнение работника в соответствии с коллективным договором."
                            }
                        },
                        {
                            "text": "Employees have the legal right to <w>grieve</w> unsafe working conditions immediately.",
                            "target_lang_translations": {
                                "ru": "Работники имеют законное право незамедлительно <w>подать жалобу</w> на небезопасные условия труда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grieve a decision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально подавать трудовую жалобу или претензию через установленную процедуру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обжаловать",
                                "target_lang_sense_clarification": "подавать жалобу в рамках установленного порядка"
                            },
                            {
                                "target_lang_word": "подавать жалобу",
                                "target_lang_sense_clarification": "оспаривать решение через трудовой спор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76d06197-99f1-354b-80c3-d71b64f39c9c",
                    "sense_definition": "To inflict bodily injury, damage, or harm upon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel blow did <w>grieve</w> the fallen knight grievously during the skirmish.",
                            "target_lang_translations": {
                                "ru": "Жестокий удар тяжело <w>ранил</w> павшего рыцаря во время стычки."
                            }
                        },
                        {
                            "text": "Ancient weapons could severely <w>grieve</w> soldiers on the battlefield.",
                            "target_lang_translations": {
                                "ru": "Древнее оружие могло жестоко <w>калечить</w> воинов на поле боя."
                            }
                        }
                    ],
                    "synonyms": [
                        "harm",
                        "injure",
                        "wound"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять телесные повреждения, вред или ранения (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ранить",
                                "target_lang_sense_clarification": "наносить телесное повреждение (устар.)"
                            },
                            {
                                "target_lang_word": "уязвлять",
                                "target_lang_sense_clarification": "наносить вред или рану (устар.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e77dd7c3-6ba2-376d-878f-accc64de02a6",
                    "sense_definition": "A manager, overseer, or farm steward, especially in Scotland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landowner appointed a new <w>grieve</w> to supervise the seasonal workers.",
                            "target_lang_translations": {
                                "ru": "Землевладелец назначил нового <w>управляющего</w>, чтобы присматривать за сезонными рабочими."
                            }
                        },
                        {
                            "text": "Every morning the estate <w>grieve</w> assigned tasks to the agricultural laborers.",
                            "target_lang_translations": {
                                "ru": "Каждое утро <w>приказчик</w> поместья раздавал задания батракам."
                            }
                        }
                    ],
                    "synonyms": [
                        "overseer",
                        "steward",
                        "bailiff"
                    ],
                    "common_phrases": [
                        "farm grieve"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly Scottish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Управляющий, надзиратель или приказчик (особенно в Шотландии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управляющий",
                                "target_lang_sense_clarification": "надзиратель за сельскохозяйственными работами"
                            },
                            {
                                "target_lang_word": "приказчик",
                                "target_lang_sense_clarification": "надсмотрщик, надзиратель в поместье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8b9b0d6-fabe-3060-86bf-cab507b39a2e",
                    "sense_definition": "A governor or magistrate of a town or province.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic documents were certified directly by the town <w>grieve</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические документы были заверены непосредственно городским <w>наместником</w>."
                            }
                        },
                        {
                            "text": "In medieval times, the local <w>grieve</w> settled minor disputes between citizens.",
                            "target_lang_translations": {
                                "ru": "В средневековые времена местный <w>судья</w> разрешал мелкие споры между гражданами."
                            }
                        }
                    ],
                    "synonyms": [
                        "governor",
                        "reeve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Правитель, судебный чиновник или наместник города или провинции (историческое)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наместник",
                                "target_lang_sense_clarification": "городской глава или управляющий"
                            },
                            {
                                "target_lang_word": "судья",
                                "target_lang_sense_clarification": "городской магистрат"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1e7478c5-e977-3581-a375-336d079d2e24",
                    "sense_definition": "A surname transferred from the occupational name for a steward or overseer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Grieve</w> will be delivering the opening remarks at tomorrow's conference.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Грив</w> выступит со вступительным словом на завтрашней конференции."
                            }
                        },
                        {
                            "text": "The local library was named in honor of Professor <w>Grieve</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь профессора <w>Грива</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия профессии управляющего или надзирателя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грив",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}