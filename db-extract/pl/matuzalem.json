                    },
                    {
                        "translation_id": "532278cd-ef8c-462f-aaa5-dd241282c6ec",
                        "source_entry_id": "d025ac5e-d0a3-3dc4-a4de-4e79aff5a836",
                        "source_sense_id": "de648325-2532-3638-ac1f-c114cce98da2",
                        "target_lang_word": "Mathusalem",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mathusalem",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e53516d-98a9-3bb8-88fd-5a7b410f80f6",
                                        "entry_id": "60d41c8e-ca17-3fd7-b3ef-2f0c464c4d55",
                                        "glosses": [
                                            "Personnage biblique, célèbre notamment pour le très grand âge qu'il aurait atteint."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2af47978-8f22-478f-9819-dd1f9a4dfb67",
                                                "sense_id": "8e53516d-98a9-3bb8-88fd-5a7b410f80f6",
                                                "text": "Il ne bougeait plus, mais il avait les yeux ouverts et, le regard de ces yeux, je ne l’oublierai jamais plus, même si je dure autant que Mathusalem."
                                            },
                                            {
                                                "example_id": "e88d102b-2ee4-4554-b8a5-437cc4db3e66",
                                                "sense_id": "8e53516d-98a9-3bb8-88fd-5a7b410f80f6",
                                                "text": "Il était perçu comme bonhomme modéré en toute chose et présent dans l’espace public depuis Mathusalem ; l’extrême prévisibilité du Corrézien jouait à son avantage."
                                            },
                                            {
                                                "example_id": "feaad68a-69ca-4122-93c0-c76a10504d62",
                                                "sense_id": "8e53516d-98a9-3bb8-88fd-5a7b410f80f6",
                                                "text": "Des tours archi connus qui datent de l'époque de Mathusalem."
                                            },
                                            {
                                                "example_id": "e5929f6a-5fe1-46cc-99e9-58afec470c34",
                                                "sense_id": "8e53516d-98a9-3bb8-88fd-5a7b410f80f6",
                                                "text": "Avec cela, Kobus, j’ose te prédire que tu deviendras vieux comme Mathusalem ; ceux qui te suivront diront : « C’était un homme d’esprit, un homme de bon sens, un joyeux compère ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
