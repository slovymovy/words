                        ],
                        "form": "dem Mainstream"
                    },
                    {
                        "form_id": "5d4dce4c-3d70-4f2d-afba-1912cd740199",
                        "entry_id": "2bc9940d-40c0-3646-bdb5-9439b58ab32e",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Mainstream"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fdf6438-e5eb-3d90-b0f2-6c5f87afac30",
                        "entry_id": "2bc9940d-40c0-3646-bdb5-9439b58ab32e",
                        "glosses": [
                            "Sammelbegriff für Kultur oder Einstellungen, die einem Großteil der Bevölkerung (oder einer bestimmten Gruppe) zugänglich und verständlich oder zu eigen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6650c7ae-19c4-4441-a0d1-8cb513b6a875",
                                "sense_id": "1fdf6438-e5eb-3d90-b0f2-6c5f87afac30",
                                "text": "Mir wird ganz übel, wenn ich mir soviel niveaulosen Mainstream-Pop anhören muss."
                            },
                            {
                                "example_id": "154140db-5c6d-4f21-9451-cb1dedb06023",
                                "sense_id": "1fdf6438-e5eb-3d90-b0f2-6c5f87afac30",
                                "text": "„Abweichler vom Mainstream haben weniger Möglichkeiten zu publizieren.“"
                            },
                            {
                                "example_id": "9c72df64-5a3b-41fc-8710-f06d3c6bd075",
                                "sense_id": "1fdf6438-e5eb-3d90-b0f2-6c5f87afac30",
                                "text": "„Neben diesen eher säkularen Parteien des Mainstreams gibt es einige islamische Parteien, die traditionell an Regierungskoalitionen auf nationaler wie auf Provinzebene beteiligt sind.“"
                            },
                            {
                                "example_id": "bd4d219f-ba61-4ee0-89ed-910f55b01a08",
                                "sense_id": "1fdf6438-e5eb-3d90-b0f2-6c5f87afac30",
                                "text": "„Die Spinner am Rande und die Migranten müssen sich nicht dem Mainstream anpassen, im Gegenteil, es ist erlaubt, dass sie ihn ändern.“"
                            },
                            {
                                "example_id": "c941953f-e706-4dea-a73e-ad00a2efd9ee",
                                "sense_id": "1fdf6438-e5eb-3d90-b0f2-6c5f87afac30",
                                "text": "„Es dauerte eine Weile, aber spätestens in der zweiten Hälfte der 1960er Jahre wurden derartige Mahnungen zum Mainstream, zunächst nur im linksliberalen Spektrum der Bundesrepublik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b20ff7dc-d94e-4ea4-bfdb-3b2142681ebb",
                        "source_entry_id": "2bc9940d-40c0-3646-bdb5-9439b58ab32e",
                        "source_sense_id": "1fdf6438-e5eb-3d90-b0f2-6c5f87afac30",
                        "source_sense_description": "Hauptströmung",
                        "target_lang_word": "mainstream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mainstream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a4cf800-4f86-3981-868b-fd49e4811133",
                                        "entry_id": "604b24ea-9397-3e91-ae36-82c6933c7c55",
                                        "glosses": [
                                            "Used or accepted broadly rather than by small portions of population, market, scientific community, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1a434c-77f2-4f0c-8b25-ff7e194e1f59",
                                                "sense_id": "9a4cf800-4f86-3981-868b-fd49e4811133",
                                                "text": "They often carry stories you won't find in the mainstream media."
                                            },
                                            {
                                                "example_id": "dfa60859-5c9f-42eb-882d-dcfef619a027",
                                                "sense_id": "9a4cf800-4f86-3981-868b-fd49e4811133",
                                                "text": "As unsubstantiated claims receive significant backing, skeptics and defenders of mainstream science enter the fray."
                                            },
                                            {
                                                "example_id": "2b8daf1d-3e94-44c2-b972-9e1e375ace1b",
                                                "sense_id": "9a4cf800-4f86-3981-868b-fd49e4811133",
                                                "text": "The mainstream media hones in on bad news stories where UK railways are concerned, yet gives scant attention to the many items of good news emerging from the network."
                                            },
                                            {
                                                "example_id": "ed7ba624-cd0d-44a9-a30e-5bcd714e9554",
                                                "sense_id": "9a4cf800-4f86-3981-868b-fd49e4811133",
                                                "text": "If Ms. Le Pen looks more mainstream now, it’s because the mainstream looks more like her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mainstream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10bcb8f3-1c0b-3fbd-8134-41566e4a1f32",
                                        "entry_id": "b97d3e4a-0dc5-3642-8b30-11293c533e79",
                                        "glosses": [
                                            "The principal current in a flow, such as a river or flow of air"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44fc0f8d-5779-3cec-8ce7-f8bbf8383c21",
                                        "entry_id": "b97d3e4a-0dc5-3642-8b30-11293c533e79",
                                        "glosses": [
                                            "That which is common; the norm."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4008c492-9be7-479b-b4bd-08744be2196b",
                                                "sense_id": "44fc0f8d-5779-3cec-8ce7-f8bbf8383c21",
                                                "text": "ideas outside of the mainstream"
                                            },
                                            {
                                                "example_id": "1d016629-4cfa-4ff5-95c6-e0855f41cf64",
                                                "sense_id": "44fc0f8d-5779-3cec-8ce7-f8bbf8383c21",
                                                "text": "George Herbert Walker Bush of Phillips Andover Academy and Yale University proclaimed in the first Presidential candidates' debate that he was “in touch with the mainstream of America.”"
                                            },
                                            {
                                                "example_id": "07190de6-a914-45e1-a577-d50253a682d7",
                                                "sense_id": "44fc0f8d-5779-3cec-8ce7-f8bbf8383c21",
                                                "text": "Long content with being the BMW of the computer industry, suppying finely crafted machines to a relatively small number of fanatic customers, Apple now wants to become a Ford or Toyota, to move into the mainstream."
                                            },
                                            {
                                                "example_id": "002eec2b-5cfb-469f-bd6f-56496da15ba3",
                                                "sense_id": "44fc0f8d-5779-3cec-8ce7-f8bbf8383c21",
                                                "text": "\"Railways seldom slavishly followed styles to be seen in the mainstream of contemporary architecture,\" HE [Historic England] explains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mainstream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cff3378-f4ac-3698-a60e-918c2e785797",
                                        "entry_id": "fc88ad91-4ce3-313c-8d25-4d08a35443f3",
                                        "glosses": [
                                            "To popularize, to normalize, to render mainstream."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a07976a9-e6ec-4144-819b-d5286192d398",
                                                "sense_id": "3cff3378-f4ac-3698-a60e-918c2e785797",
                                                "text": "Acknowledging the role X plays in mainstreaming the worst constituencies makes for awkward conversations with those who continue to use it."
                                            },
                                            {
                                                "example_id": "7f7bdc2e-1865-4faf-ae39-090cd2ed2497",
                                                "sense_id": "3cff3378-f4ac-3698-a60e-918c2e785797",
                                                "text": "Just as the gang peace movement desired to mainstream hardcore bangers into civic society, The Chronic wanted to drive hardcore rap into the popstream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bac9c295-4002-3955-a209-03300b8cd131",
                                        "entry_id": "fc88ad91-4ce3-313c-8d25-4d08a35443f3",
                                        "glosses": [
                                            "To become mainstream."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b9b6e9-48b4-446e-b36e-0d3d6f3fefc9",
                                                "sense_id": "bac9c295-4002-3955-a209-03300b8cd131",
                                                "text": "In a nonchurch context, we can look more explicitly at formerly New Age practices to see if and how they have mainstreamed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c0b951-dfc5-3c1f-b347-6195e4d82089",
                                        "entry_id": "fc88ad91-4ce3-313c-8d25-4d08a35443f3",
                                        "glosses": [
                                            "To educate (a disabled student) together with non-disabled students."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d6a28b-cbde-4dbc-8b18-737af7eed9e9",
                                                "sense_id": "35c0b951-dfc5-3c1f-b347-6195e4d82089",
                                                "text": "Despite these beliefs, the decision to send my son to a regular school was not made easily. I didn't know of any child as disabled as he who had been mainstreamed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
