                    "sense_id": "74d7ace5-c702-3976-b6b3-e1313a0f4f91",
                    "sense_definition": "Zonder tussenkomst van anderen of zonder omwegen; rechtstreeks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_relational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben een <w>directe</w> trein naar het centrum van de stad genomen.",
                            "target_lang_translations": {
                                "ru": "Мы сели на <w>прямой</w> поезд до центра города.",
                                "en": "We took a <w>direct</w> train to the city center.",
                                "pl": "Wsiedliśmy w <w>bezpośredni</w> pociąg do centrum miasta.",
                                "de": "Wir haben einen <w>direkten</w> Zug ins Stadtzentrum genommen.",
                                "fr": "Nous avons pris un train <w>direct</w> pour le centre-ville.",
                                "it": "Abbiamo preso un treno <w>diretto</w> per il centro della città.",
                                "cs": "Vzali jsme si <w>přímý</w> vlak do centra města.",
                                "tr": "Şehir merkezine giden <w>direkt</w> bir trene bindik.",
                                "es": "Tomamos un tren <w>directo</w> al centro de la ciudad."
                            }
                        },
                        {
                            "text": "Er is geen <w>direct</w> bewijs gevonden voor zijn betrokkenheid bij de zaak.",
                            "target_lang_translations": {
                                "ru": "Не было найдено <w>прямых</w> доказательств его причастности к делу.",
                                "en": "No <w>direct</w> evidence was found for his involvement in the case.",
                                "pl": "Nie znaleziono żadnego <w>bezpośredniego</w> dowodu na jego udział w tej sprawie.",
                                "de": "Es wurde kein <w>direkter</w> Beweis für seine Beteiligung an dem Fall gefunden.",
                                "fr": "Aucune preuve <w>directe</w> de son implication dans l'affaire n'a été trouvée.",
                                "it": "Non è stata trovata alcuna prova <w>diretta</w> del suo coinvolgimento nel caso.",
                                "cs": "Nenašel se žádný <w>přímý</w> důkaz o jeho zapojení do tohoto případu.",
                                "tr": "Onun olayla ilişkisine dair <w>doğrudan</w> bir kanıt bulunamadı.",
                                "es": "No se han encontrado pruebas <w>directas</w> de su implicación en el caso."
                            }
                        }
