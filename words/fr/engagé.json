                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux <w>engagés</w> venus d'Inde travaillaient dans les plantations de canne à sucre."
