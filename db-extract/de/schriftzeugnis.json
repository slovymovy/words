                "senses": [
                    {
                        "sense_id": "9b475d49-e24f-3270-b991-a7dec7a4de52",
                        "entry_id": "3fb775b0-a7a3-33da-b5c3-a1937b404451",
                        "glosses": [
                            "schriftlicher Text, der etwas dokumentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4cb3483-f3b5-4652-ad10-45855b47678d",
                                "sense_id": "9b475d49-e24f-3270-b991-a7dec7a4de52",
                                "text": "„Nun nimmt er wohl selbst sein Messer, ritzt seinen Namen - Harja - in den Kamm und hinterlässt mit dieser Runen-Inschrift um 160 nach Christus das älteste erhaltene Schriftzeugnis eines Germanen.“"
                            },
                            {
                                "example_id": "6598dcd1-ebf9-491d-bd97-fecd5029bb33",
                                "sense_id": "9b475d49-e24f-3270-b991-a7dec7a4de52",
                                "text": "Das früheste Schriftzeugnis ist ein Fragment des Aristophanes."
                            },
                            {
                                "example_id": "6ac601a8-70c5-4af4-8bc8-f10a72ed109b",
                                "sense_id": "9b475d49-e24f-3270-b991-a7dec7a4de52",
                                "text": "„Eine Vorstellung vom altägyptischen Leben kann man sich am besten anhand der zahlreichen Schriftzeugnisse machen, die uns aus dem antiken Alltag erhalten geblieben sind.“"
                            },
                            {
                                "example_id": "44a412e3-f011-4214-9efb-450d40b39ef8",
                                "sense_id": "9b475d49-e24f-3270-b991-a7dec7a4de52",
                                "text": "„Man schrieb in Manching; was an Schriftzeugnissen entdeckt wurde, verwendete lateinische Buchstaben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
