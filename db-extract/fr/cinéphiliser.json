                        "glosses": [
                            "Donner un caractère cinéphilique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e215f8-e687-4921-8b1c-313cef0c51e5",
                                "sense_id": "5137ce06-7cd9-343b-a977-feaf8efb33b1",
                                "text": "Cinéphiliser sa vie, écrire des films, en vrai ou en pointillés, ça allait de soi."
                            },
                            {
                                "example_id": "dabc59f8-94f9-4ef3-8c18-7bd14074c9a8",
                                "sense_id": "5137ce06-7cd9-343b-a977-feaf8efb33b1",
                                "text": "Et 47 qui essaie désespérément de me cinéphiliser.. !"
                            },
                            {
                                "example_id": "847f0698-f902-402c-8111-b38c235e667e",
                                "sense_id": "5137ce06-7cd9-343b-a977-feaf8efb33b1",
                                "text": "Le DVD est accrocheur, parce qu’il vous permet, si vous choisissez bien l’édition que vous allez acheter, de vous cinéphiliser ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "ffae7b84-6146-3ed9-8787-0bd2d8c8fa9e",
                        "entry_id": "e42f6214-ddec-38d2-89ab-c24f9d9b1fe7",
                        "glosses": [
                            "Exercer une activité liée à la cinéphilie."
