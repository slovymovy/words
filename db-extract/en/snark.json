                                                "example_id": "5f454c0b-1ce1-4e34-9fb4-0bd21ba0d614",
                                                "sense_id": "77cb89e9-b510-3080-8dfc-f803304cac50",
                                                "text": "Elisabeth trug einen schönen Schnatz auf ihrer Hochzeit.",
