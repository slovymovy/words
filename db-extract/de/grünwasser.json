                "senses": [
                    {
                        "sense_id": "3076b9df-bd7e-3617-8ce2-f3cfb9b2a66c",
                        "entry_id": "87bc075f-c655-39e8-8f25-6884d03fa1ad",
                        "glosses": [
                            "deutscher Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c9e679-809a-4c14-bd47-81d0b10b7fa5",
                                "sense_id": "3076b9df-bd7e-3617-8ce2-f3cfb9b2a66c",
                                "text": "„Der Gründer Heinz Grünwasser geht in den Ruhestand.“"
                            },
                            {
                                "example_id": "9956dd3b-19b8-4583-b772-5d4565605514",
                                "sense_id": "3076b9df-bd7e-3617-8ce2-f3cfb9b2a66c",
                                "text": "„Einen Wunsch hat Krankenschwester Martina Grünwasser: „Ich möchte mal einen Herrn im Nadelstreifenanzug aus dem Landtag oder Bundestag einen Tag lang mit auf Tour nehmen, damit der sieht, wie Menschen leben und wie wir arbeiten.“ “"
                            },
                            {
                                "example_id": "834e48a9-9884-48c2-9eff-34ab566f5a5a",
                                "sense_id": "3076b9df-bd7e-3617-8ce2-f3cfb9b2a66c",
                                "text": "„Die Verleihung der in diesem Jahr abgelegten Sportabzeichen nahmen Ulla Pid und Thomas Grünwasser vor.“"
                            },
                            {
                                "example_id": "64f6d552-a069-4a4d-8461-dcbf1dac1bbf",
                                "sense_id": "3076b9df-bd7e-3617-8ce2-f3cfb9b2a66c",
                                "text": "„Starke Leitung auch von Tom Grünwasser, der als 21. in Ziel kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
