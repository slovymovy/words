                "senses": [
                    {
                        "sense_id": "75838a03-3998-3623-867c-640e1f9a8bbc",
                        "entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "glosses": [
                            "A primitive trombone having wide tubes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4463ff2-4767-38e5-8974-54fbe8c6189f",
                        "entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "glosses": [
                            "A shoulder-held rocket launcher used as an antitank weapon, developed by America during World War II and so-called from its resemblance to the bazooka musical instrument."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5be7c961-e615-3443-b51c-22fe5ee19214",
                        "entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "glosses": [
                            "Any shoulder-fired rocket grenade launcher."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cbdf0615-bbf7-361f-a69b-a79e24bed899",
                        "entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "glosses": [
                            "A woman's breast, especially a large one."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "eb3455a1-a4d0-3894-8ff9-c054414e8a08",
                        "entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "glosses": [
                            "A large rescue or stimulus package."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fc4f99b0-62fc-4fca-ac0a-f1bee745d9df",
                                "sense_id": "eb3455a1-a4d0-3894-8ff9-c054414e8a08",
                                "text": "Suppose the EFSF buys some bonds. That will push down yields for awhile.^([sic]) But what happens when the money starts to run out? Yields will go back up. A firebreak/firewall/bazooka needs unlimited funds to work."
                            },
                            {
                                "example_id": "4cce4cd6-0eb6-4d51-88f6-0196ff6e1963",
                                "sense_id": "eb3455a1-a4d0-3894-8ff9-c054414e8a08",
                                "text": "“I don’t think [policymakers]^([sic]) realise it’s not enough,” said a veteran fixed-income investor in Hong Kong. “You need some big bazooka action to improve sentiment as a whole.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81487b71-6d73-4f8e-b66a-7ff85cba7b2c",
                        "source_entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "source_sense_description": "American shoulder fired rocket grenade launcher",
                        "target_lang_word": "bazooka",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bazooka",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "782a9ce8-27d2-3f35-98a6-c815b7d6dcd9",
                                        "entry_id": "be69ccbc-a65e-3f8b-92ba-2893d7357da5",
                                        "glosses": [
                                            "buisvormige raketwerper dienend als anti-tankwapen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a60dc69-542d-4c8b-9dce-88e77abe85b3",
                                                "sense_id": "782a9ce8-27d2-3f35-98a6-c815b7d6dcd9",
                                                "text": "De drie mannen met de grootste camera’s, denk: maatje bazooka, hebben vandaag géén trapje bij zich. „Geen plek in de auto”, zegt Jeroen van Veenendaal (31) uit Veenendaal. „Wij hadden onze Taiwanese vriend mee.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae07f54a-8836-49a8-a178-e5fa467eaf2e",
                        "source_entry_id": "ac391acf-9234-3988-b35f-92e11ffdba67",
                        "source_sense_description": "American shoulder fired rocket grenade launcher",
                        "target_lang_word": "bazooka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bazooka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb19e208-27eb-3809-8f76-2fb1a6b32101",
                                        "entry_id": "ad59e268-36fa-37f5-b802-39a9c56dd9bb",
                                        "glosses": [
                                            "Lance-roquettes antichar de courte portée."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20afaf63-9ecc-49b5-b549-07b8aefc1e59",
                                                "sense_id": "cb19e208-27eb-3809-8f76-2fb1a6b32101",
                                                "text": "Moins de cinq cents combattants. L’armement qui attend leurs compagnons ne comprend que des armes légères. Contre l’artillerie divisionnaire allemande et les automitrailleuses, pas un canon, pas un bazooka."
                                            },
                                            {
                                                "example_id": "3644cf1e-ff74-423d-8484-33ed183f648e",
                                                "sense_id": "cb19e208-27eb-3809-8f76-2fb1a6b32101",
                                                "text": "Ce soudain branle-bas de combat gagna jusqu’à l’intendance. On vit des secrétaires, cuisiniers et autres non-combattants entourer les instructeurs pour s’initier rapidement au maniement du bazooka et du mortier de tranchée, et apprendre l’art de poser une mine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd6cc426-ae40-378a-8b03-787362c9e379",
                                        "entry_id": "ad59e268-36fa-37f5-b802-39a9c56dd9bb",
                                        "glosses": [
                                            "Sorte d’engin d’effarouchement qui envoie des détonations répétées pour faire fuir les corbeaux, corneilles ou étourneaux."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd26d233-9d18-4609-9973-babe7250a475",
                                                "sense_id": "dd6cc426-ae40-378a-8b03-787362c9e379",
                                                "text": "Jean-Pierre Paris a lui aussi installé un « bazooka ». Toutes les 3/4 minutes, il tire un coup de canon. Censé effrayer les bestioles. Son engin lui a surtout permis de récolter une plainte. « Du côté de Mortagne, ça dérangeait des voisins ». Les corbeaux, eux, viennent toujours picorer ses semis de tournesol et de maïs."
                                            },
                                            {
                                                "example_id": "0aa66730-4782-4a38-9efa-c7c0a112df2c",
                                                "sense_id": "dd6cc426-ae40-378a-8b03-787362c9e379",
                                                "text": "Des centaines d’étourneaux envahissent par nuées les champs et s’en mettent plein le bec. « Il va falloir sortir le bazooka », déclare l’agriculteur, occupé à peser les paniers. Gloups ! Ça s’appelle la manière forte ! Rassurez-vous, le bazooka en question n’est destiné qu’à en imiter le bruit pour effrayer les oiseaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13fcf262-7def-3be4-b3c7-0bec687073b4",
                                        "entry_id": "ad59e268-36fa-37f5-b802-39a9c56dd9bb",
                                        "glosses": [
                                            "Moyen extrême."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88b2e2ca-8563-4f60-8253-d3eb280bfad2",
                                                "sense_id": "13fcf262-7def-3be4-b3c7-0bec687073b4",
                                                "text": "La crise des subprimes (2007-2008) puis celle des dettes souveraines (2010) ne nous ont finalement pas emportés, mais c'est seulement grâce à l'action de la Banque centrale européenne (BCE), qui a sorti le bazooka pour sauver la zone euro."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bazooka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a098a0b-3e46-3930-9332-583cbb446a8e",
                                        "entry_id": "40429f8b-7bd9-3ef3-9e3c-24b589992182",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple de bazooker."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
