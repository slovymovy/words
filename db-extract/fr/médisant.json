                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "010b9cd8-dd54-4652-be9a-5aad46c24944",
                                "sense_id": "85d2d880-b16c-3682-8c70-a5289c445d14",
                                "text": "On est d’ordinaire plus médisant par vanité que par malice."
                            },
                            {
                                "example_id": "8315bd0a-5b80-4f26-b20e-a7aab67d32ca",
                                "sense_id": "85d2d880-b16c-3682-8c70-a5289c445d14",
                                "text": "La chanteuse regrettait Paris, sa petite cour d’amies potinières et d’anciens admirateurs, vieux rats de coulisses aussi médisants que les femmes de leur âge."
                            }
                        ]
                    }
