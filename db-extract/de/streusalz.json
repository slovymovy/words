                    },
                    {
                        "translation_id": "272e9b0f-5906-4f10-a7dd-13bf411a1c97",
                        "source_entry_id": "883c9f32-10b3-391d-8933-be7b0ee1714b",
                        "source_sense_id": "9f02dfb4-6dbf-3bcd-8fa4-366dcaa4b852",
                        "source_sense_description": "Salz, das als Streumittel bei der Glatteisbekämpfung verwendet wird",
                        "target_lang_word": "strooizout",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strooizout",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f1972cf7-b417-3c58-8bd7-2a4608005617",
                                        "entry_id": "b726c504-5777-31f8-b3f8-8b13bb590e22",
                                        "glosses": [
                                            "zout dat men kan gebruiken om een bevroren weg of pad minder glad te maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e5ef4c-945d-4036-9ae9-0563f0d7e391",
                                                "sense_id": "f1972cf7-b417-3c58-8bd7-2a4608005617",
                                                "text": "Als we dit jaar ineens een strenge winter krijgen, moet de gemeente Hellendoorn rekening houden met een flinke financiële tegenvaller. De prijs voor het strooizout is namelijk flink gestegen, van 48 naar maar liefst 69 euro per ton zout."
                                            },
                                            {
                                                "example_id": "669c7bd1-7664-4b3d-b59e-17851aa80970",
                                                "sense_id": "f1972cf7-b417-3c58-8bd7-2a4608005617",
                                                "text": "Problemen kunnen ontstaan omdat de uitvoering van naoorlogse gebouwen slechter was, er toch structureel te veel gewicht op de vloer komt (bijvoorbeeld door het balkon zwaar te betegelen) of doordat de betonwapening wordt aangetast door strooizout."
                                            },
                                            {
                                                "example_id": "1b88dabb-ee51-4383-bf32-1d7fe8ded92c",
                                                "sense_id": "f1972cf7-b417-3c58-8bd7-2a4608005617",
                                                "text": "Het was een mooie zomer, die volgens de laatste verwachtingen nog niet ten einde is. Toch komt de winter eraan, onherroepelijk. Sterker nog: het strooizout ligt al klaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
