                                                "example_id": "c07a6a47-bbc5-4980-8887-9304d158811d",
                                                "sense_id": "2cd98335-2a13-3246-8c5d-2a369c6a1ab2",
                                                "text": "Mettre en compromis."
                                            },
                                            {
                                                "example_id": "05eed951-c507-45af-9579-70b13a429b7b",
                                                "sense_id": "2cd98335-2a13-3246-8c5d-2a369c6a1ab2",
                                                "text": "On ne met en compromis que les affaires douteuses et litigieuses."
                                            },
                                            {
                                                "example_id": "a24e02e3-d4c4-4b56-9d84-10552e10e4f4",
                                                "sense_id": "2cd98335-2a13-3246-8c5d-2a369c6a1ab2",
                                                "text": "Ce n’est pas là une chose qu’on doive mettre en compromis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "238835ad-3723-3e24-b6ef-39e7a33d6a97",
                                        "entry_id": "4c746f60-58e0-3753-b642-1d969074667d",
                                        "glosses": [
                                            "Transaction où les diverses parties se font des concessions les unes aux autres pour clore un désaccord."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51130250-7737-48c5-b7ea-916c23792f12",
                                                "sense_id": "238835ad-3723-3e24-b6ef-39e7a33d6a97",
                                                "text": "Un compromis n'a pu être trouvé à l'issue de négociations qui se sont achevées dans la nuit de mercredi à jeudi. Les deux camps, flamand et francophone, se sont rejetés la responsabilité de l'impasse."
                                            },
                                            {
                                                "example_id": "2f7f0846-b68b-4b5b-90c0-42e822353ff4",
                                                "sense_id": "238835ad-3723-3e24-b6ef-39e7a33d6a97",
                                                "text": "Deux heures de débats intenses nous ont permis d'aboutir à un bon compromis."
                                            },
                                            {
                                                "example_id": "3aec157b-bbbb-43fa-80c3-25a14dc08a74",
                                                "sense_id": "238835ad-3723-3e24-b6ef-39e7a33d6a97",
                                                "text": "Loin de paraître comme inconciliables avec la piété, les commentaires nouveaux pouvaient sembler à certains mystiques parisiens un compromis heureux entre le néoplatonisme augustinien, l’abélardisme aristotélicien et l’esprit positif des savants ou des astrologues."
                                            },
                                            {
                                                "example_id": "65f1662b-e693-471f-bcea-b37f5d590fb8",
                                                "sense_id": "238835ad-3723-3e24-b6ef-39e7a33d6a97",
                                                "text": "Il y a de la place pour les compromis, mais pas pour la compromission."
                                            },
                                            {
                                                "example_id": "198f609b-c8a4-49da-a00c-ae7d64e56a45",
                                                "sense_id": "238835ad-3723-3e24-b6ef-39e7a33d6a97",
                                                "text": "Pour des observateurs français habitués aux majorités claires ayant les coudées franches pour mener une politique, c’est effectivement déroutant de constater qu’au niveau européen, il faut sans cesse trouver des compromis pour bâtir une coalition\", analyse Francisco Roa Bastos."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compromis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70da77f9-c278-3bef-8078-b4f261ca39cf",
                                        "entry_id": "1cf3fcfc-ab01-3c04-8cd8-c649e389387f",
                                        "glosses": [
                                            "Participe passé masculin (singulier ou pluriel) du verbe compromettre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0107619-417d-45d7-8fba-b5a0c90317ad",
                                                "sense_id": "70da77f9-c278-3bef-8078-b4f261ca39cf",
                                                "text": "Or, je ne voulus pas qu’en se décompromettant, il pût me laisser compromis à sa place : je lui adressai donc, le 13 juin dernier, la lettre que voici : (…)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e05c2471-ab7c-3763-838c-75fd8d4450e4",
                                        "entry_id": "1cf3fcfc-ab01-3c04-8cd8-c649e389387f",
                                        "glosses": [
                                            "Première personne du singulier du passé simple du verbe compromettre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "673183a2-8de3-36b6-b644-792120ace8fd",
                                        "entry_id": "1cf3fcfc-ab01-3c04-8cd8-c649e389387f",
                                        "glosses": [
                                            "Deuxième personne du singulier du passé simple du verbe compromettre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
