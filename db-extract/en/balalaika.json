                    {
                        "translation_id": "abb1ae02-e7f8-4c4a-9f3d-4d96817feeea",
                        "source_entry_id": "ac65726c-bd3a-3412-abd5-42de8f2b11a5",
                        "source_sense_id": "ec53ca33-c481-37ff-a7c2-83451c3cdf0f",
                        "source_sense_description": "Russian instrument",
                        "target_lang_word": "balalaïka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balalaïka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99dcd069-8b06-316d-b165-31a1af2c1da9",
                                        "entry_id": "68d046b5-43dd-3ecd-b012-898566855977",
                                        "glosses": [
                                            "Instrument de musique à cordes russe, de la catégorie des luths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bce19bf-85ed-48a0-a3d2-9acd1d1b09c8",
                                                "sense_id": "99dcd069-8b06-316d-b165-31a1af2c1da9",
                                                "text": "[…] une courge de Moldavie, une de ces calebasses dont on fait en Russie les balalaïkas, légers instruments à cordes, joie et orgueil des casse-cœurs de vingt ans qui les pincent doucement."
                                            },
                                            {
                                                "example_id": "98189778-d01c-45bb-8e87-a9e92a65d3c4",
                                                "sense_id": "99dcd069-8b06-316d-b165-31a1af2c1da9",
                                                "text": "Il y baigne dans ses souvenirs du Quartier latin, et nous dans l’odeur de chou. On nous y sert un bortch où de rares légumes nagent dans l’eau chaude et des pirojkis rassis, mais au son des balalaïkas, dans un décor à la Boris Godounov."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37e6f3e4-0804-41cb-8e93-fe128aa21a06",
                        "source_entry_id": "ac65726c-bd3a-3412-abd5-42de8f2b11a5",
                        "source_sense_id": "ec53ca33-c481-37ff-a7c2-83451c3cdf0f",
                        "source_sense_description": "Russian instrument",
                        "target_lang_word": "Balalaika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balalaika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                        "entry_id": "cba420bc-6d77-3f46-8d5b-0df613f0ff0f",
                                        "glosses": [
                                            "dreisaitiges, russisches Zupfinstrument mit einem dreieckigem Resonanzkörper aus Holz und einem langen Hals mit Bünden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35df8c1c-7939-47de-8656-dc71fbb470af",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "Die Balalaika ist im Klang der Mandoline verwandt."
                                            },
                                            {
                                                "example_id": "cff816b7-0d6a-421b-8aea-9a928c768384",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "„Wir hatten, wenn überhaupt, unterwegs nur sehr leise miteinander gesprochen, nicht mit Wodkaflaschen gewunken und weder Matroschkas noch Balalaikas in den Händen.“"
                                            },
                                            {
                                                "example_id": "8cfe1d1d-ab4a-4900-8728-476f9e104c13",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "„In weiser Voraussicht hat er seine Balalaika mitgebracht und begleitet sich selbst zum wehmütigen Gesang.“"
                                            },
                                            {
                                                "example_id": "cdd90899-65df-40cf-92bb-1fbcd9abb664",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "„Jetzt kamen deutlich vernehmbar die Töne einer Balalaika aus dem Korridor, und offenbar wurde dieses Instrument von der Hand eines Meisters gespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
