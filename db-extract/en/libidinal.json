                                        "examples": [
                                            {
                                                "example_id": "8aa778bb-0fce-47db-927e-4fb02ebed2da",
                                                "sense_id": "336b99e0-6d8a-3b29-8631-bbc5874b9162",
                                                "text": "L’indéninition de mécanismes sociaux perturbe, réactionnellement, la formation de la personnalité de bien des individus. Du point de vue de la fixation libidinale, L'État des monopoles ne vaut pas un clou."
                                            },
                                            {
                                                "example_id": "647f8024-cb52-45be-b1d4-0d8af49d86c8",
                                                "sense_id": "336b99e0-6d8a-3b29-8631-bbc5874b9162",
                                                "text": "Il n’y a plus de place pour l’autocritique, comme si le rétrécissement du champ de la pensée se résumait dans une poussée libidinale."
                                            },
                                            {
                                                "example_id": "26c50540-4ae6-4824-a675-fc52b7dbc179",
                                                "sense_id": "336b99e0-6d8a-3b29-8631-bbc5874b9162",
                                                "text": "Il faut croire que décidément cette plasticité appartient à mon économie libidinale…"
                                            }
                                        ]
