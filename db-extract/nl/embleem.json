                                    {
                                        "sense_id": "24730551-d741-31dc-ab47-07a859baaa67",
                                        "entry_id": "edbfe8a2-d470-3eb9-b303-2371cc549a45",
                                        "glosses": [
                                            "Sinnbild, Symbol, Wahrzeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35ff81e-031d-4b74-8170-8c7fabaf81c6",
                                                "sense_id": "24730551-d741-31dc-ab47-07a859baaa67",
                                                "text": "Der Ölzweig ist das Emblem des Friedens."
                                            },
                                            {
                                                "example_id": "7bf2381a-ec10-4e41-9ea8-90d15a94ef3a",
                                                "sense_id": "24730551-d741-31dc-ab47-07a859baaa67",
                                                "text": "„Im ersten Ligaspiel der Vereinsgeschichte wird RB Leipzig nun ohne Emblem auf dem Trikot antreten.“"
                                            },
                                            {
                                                "example_id": "401fc013-0c95-4ccd-bfcc-fe1d85be7323",
                                                "sense_id": "24730551-d741-31dc-ab47-07a859baaa67",
                                                "text": "„Bekleidet war er mit einer Baseballkappe mit auffälligem X-Emblem, einem schwarzen T-Shirt und einer schwarzen Hose, er trug einen roten Aktenkoffer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae254538-4b9c-31e4-9b7a-8a53d1994d79",
                                        "entry_id": "edbfe8a2-d470-3eb9-b303-2371cc549a45",
