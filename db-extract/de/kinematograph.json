                "senses": [
                    {
                        "sense_id": "4813feae-5662-3e67-87f3-9ead50cafbc8",
                        "entry_id": "6508bf8e-216f-3724-9572-4ab9a1dc3b98",
                        "glosses": [
                            "cinematograph"
                        ],
                        "tags": [
                            "dated",
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "6165bad5-3149-4afc-8d82-1f7c07367843",
                                "sense_id": "4813feae-5662-3e67-87f3-9ead50cafbc8",
                                "text": "Daher war beständig eine rastlose Unruhe in ihm, wie man sie vor einem Kinematographen empfindet, wenn man neben der Illusion des Ganzen doch eine vage Wahrnehmung nicht loswerden kann, daß hinter dem Bilde, das man empfängt, hunderte von – für sich betrachtet ganz anderen – Bildern vorbeihuschen.",
                                "translation": "The Confusions of Young Törless",
                                "english": "The Confusions of Young Törless"
                            },
                            {
                                "example_id": "2f1c9422-3fc5-4a60-adf8-fa8bc9af6641",
                                "sense_id": "4813feae-5662-3e67-87f3-9ead50cafbc8",
                                "text": "»Da ich kein Tagebuch führe,« sagte Dr. Deruga laut, »noch meine täglichen Verrichtungen durch einen Kinematographen oder ein Grammophon aufnehmen lasse, ist es mir leider unmöglich, Ihnen den Verlauf des Tages mit mathematischer Genauigkeit wiederzugeben.[…]«",
                                "translation": "The Deruga Case",
                                "english": "The Deruga Case"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
