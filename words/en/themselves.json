                    "sense_id": "29db788a-2854-3949-9732-ca316c787d39",
                    "sense_definition": "The reflexive form of <w>they</w> referring to a group of people, animals, or things previously mentioned.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children dressed <w>themselves</w> before going to school.",
                            "target_lang_translations": {
                                "ru": "Дети оделись <w>сами</w> перед тем, как пойти в школу.",
                                "pl": "Dzieci ubrały <w>się</w> przed pójściem do szkoły.",
                                "es": "Los niños <w>se</w> vistieron antes de ir a la escuela."
                            }
                        },
                        {
                            "text": "They decided to see the new house for <w>themselves</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили осмотреть новый дом <w>сами</w>.",
                                "pl": "Zdecydowali, że <w>sami</w> obejrzą nowy dom.",
                                "es": "Decidieron ver la casa nueva por <w>sí mismos</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "by themselves",
                        "for themselves",
                        "among themselves",
                        "to themselves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвратная форма местоимения they (они), относящаяся к группе ранее упомянутых людей, животных или предметов.",
                        "pl": "Forma zwrotna zaimka \"they\" (oni, one), odnosząca się do wcześniej wspomnianej grupy ludzi, zwierząt lub rzeczy.",
                        "es": "Forma reflexiva del pronombre 'they' (ellos/ellas), que se refiere a un grupo de personas, animales o cosas mencionadas anteriormente."
                    },
