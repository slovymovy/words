        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d9dc2a5-945a-34ea-ab2c-656074409a2f",
                    "sense_definition": "Petit mammifère rongeur montagnard de la famille des sciuridés, réputé pour son long sommeil hivernal.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "rongeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant notre randonnée dans les Alpes, nous avons aperçu une <w>marmotte</w> sur un rocher."
                        },
                        {
                            "text": "À l'approche du mauvais temps, la <w>marmotte</w> regagne son terrier pour hiberner paisiblement."
                        }
                    ],
                    "synonyms": [
                        "siffleux"
                    ],
                    "common_phrases": [
                        "terrier de marmotte"
                    ]
                },
                {
                    "sense_id": "24368110-67fb-367e-acb2-05c3a4a91ab1",
                    "sense_definition": "Personne qui a un sommeil très profond ou qui aime dormir longtemps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon fils est une vraie <w>marmotte</w>, il est impossible de le réveiller avant midi le week-end."
                        },
                        {
                            "text": "Pendant les vacances, elle a décidé de faire la <w>marmotte</w> pour récupérer des forces."
                        }
                    ],
                    "common_phrases": [
                        "dormir comme une marmotte",
                        "faire la marmotte"
                    ],
                    "traits": [
