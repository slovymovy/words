                        "examples": [
                            {
                                "example_id": "e16d58a6-741f-46d1-95c1-1111c82adde7",
                                "sense_id": "70d95046-7037-30ac-8089-a59e5c08352b",
                                "text": "она́ пошатну́лась и упа́ла",
                                "translation": "she staggered and fell",
                                "english": "she staggered and fell"
                            }
                        ]
                    },
                    {
