                        {
                            "text": "De hitte in de kleine kamer werd na een paar uur echt <w>ondraaglijk</w>.",
                            "target_lang_translations": {
                                "en": "The heat in the small room became truly <w>unbearable</w> after a few hours."
                            }
                        },
                        {
                            "text": "Hij had een <w>ondraaglijke</w> pijn in zijn rug en kon nauwelijks meer lopen.",
                            "target_lang_translations": {
