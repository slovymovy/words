                                        "glosses": [
                                            "mehrere/viele Handlungen, bei denen jemand/andere hinters Licht geführt und um rechtmäßigen Besitz gebracht wird/werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da65e6a9-252d-4c33-9502-008cb3ddca8a",
                                                "sense_id": "98f04729-5f61-3633-93e7-c94cd859ba5e",
                                                "text": "„Er hatte viel mehr Glück als sein Bruder Ludwig, der wegen Betrügereien im Bergwerk ins Gefängnis kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
