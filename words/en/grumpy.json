                            }
                        },
                        {
                            "text": "She felt <w>grumpy</w> after a long day of work.",
                            "target_lang_translations": {
                                "fr": "Elle se sentait <w>grognon</w> après une longue journée de travail."
                            }
                        }
                    ],
                    "synonyms": [
