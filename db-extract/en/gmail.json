                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "032ac3a7-7b75-3244-b42f-17f0dcc11eab",
                        "entry_id": "2ffc5276-e5f3-3828-860f-38b7c6354290",
                        "glosses": [
                            "A web-based e-mail system provided by Google (trademarked Gmail)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561ca1d1-d112-4494-bed6-48978370bd60",
                                "sense_id": "032ac3a7-7b75-3244-b42f-17f0dcc11eab",
                                "text": "He has a Gmail account."
                            },
                            {
                                "example_id": "5c759d39-3945-4d0a-a09e-66705ab30a8e",
                                "sense_id": "032ac3a7-7b75-3244-b42f-17f0dcc11eab",
                                "text": "For now, it’s hard to conclude that Sunak will succeed in rebooting a government that’s been reset more times than most people’s Gmail passwords."
                            }
                        ]
                    }
                ],
