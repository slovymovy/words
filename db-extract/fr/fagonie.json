                            {
                                "example_id": "5ac42b06-a0fd-4da6-a9ac-c8910c9fdca3",
                                "sense_id": "fe75a665-9612-3353-99fd-c7ff0bfa316b",
                                "text": "La fagonie de Crête est une petite fleur de couleur pourpre."
                            },
                            {
                                "example_id": "9630fbe1-db16-450a-9b20-94c45d072231",
                                "sense_id": "fe75a665-9612-3353-99fd-c7ff0bfa316b",
                                "text": "J’ai cueilli une fagonie ou bien une lavatère, un ciste, une véronique : bref elle était mauve, munie de quatre ou cinq pétales séparés, d’étamines vives, frêle, incapable de s’échapper de ces cailloux déjà secs, avec une tige verte et amère que j’ai coincée entre mes incisives."
                            }
                        ]
                    }
