                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31a0c84-fdc9-45f2-909a-78f28c862e9e",
                                                "sense_id": "3b0a2dd3-9b06-34ea-b49f-6c5ea27eba7e",
                                                "text": "El tubo de ventilación está obstruido."
