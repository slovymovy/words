                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "97b8d628-60dd-4386-a280-dc90666ef20f",
                        "entry_id": "34bfd2ce-73ac-3118-bc7c-bba958bc39d6",
                        "tags": [
                            "plural"
