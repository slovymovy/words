                                "sense_id": "3c427b7d-ba0f-3af8-982a-b9b0233b751b",
                                "text": "заку́сывать на́скоро",
                                "translation": "to snatch a quick bite",
                                "english": "to snatch a quick bite"
                            }
                        ]
                    },
                    {
                        "sense_id": "94a8ade7-86e6-3e08-93fe-84f12025d382",
                        "entry_id": "7c25e5c5-17fe-397c-a7d8-4429156969c9",
