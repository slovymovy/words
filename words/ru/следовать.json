                    ],
                    "common_phrases": [
                        "отсюда следует",
                        "из этого следует",
                        "как следует из"
                    ],
                    "target_lang_definitions": {
                        "en": "To be a logical conclusion or result of something",
                        "de": "Die logische Schlussfolgerung oder das Ergebnis von etwas sein"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "follow",
                                "target_lang_sense_clarification": "be a logical consequence"
                            },
                            {
                                "target_lang_word": "result",
                                "target_lang_sense_clarification": "occur as an outcome"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "folgen",
                                "target_lang_sense_clarification": "eine logische Konsequenz sein"
                            },
                            {
                                "target_lang_word": "sich ergeben",
                                "target_lang_sense_clarification": "als Folge herauskommen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "600a56eb-3821-3214-8c2f-c303a19c35ab",
                    "sense_definition": "Причитаться к уплате или получению",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите, пожалуйста, сколько с меня <следует> за проезд?",
                            "target_lang_translations": {
                                "en": "Tell me, please, how much do I <owe> for the fare?",
                                "de": "Sagen Sie mir bitte, wie viel <kostet> die Fahrt?"
