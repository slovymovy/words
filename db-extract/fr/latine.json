                    {
                        "sense_id": "ea378534-e198-39d0-b2ee-46b107f054e3",
                        "entry_id": "9dff7c8c-56b4-3208-8c90-1d118a99a3af",
                        "glosses": [
                            "Féminin singulier de latin."
                        ],
