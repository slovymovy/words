                ],
                "senses": [
                    {
                        "sense_id": "83c59e2b-dc2d-3cbd-b5dd-07fe88dcdb1c",
                        "entry_id": "6da2bc2e-2404-363b-a247-fc3431db4f83",
                        "glosses": [
                            "предприятие, на котором производится забой скота и первичная обработка туш"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f516f47a-4a19-3284-9cbd-38c71b8131da",
                        "entry_id": "6da2bc2e-2404-363b-a247-fc3431db4f83",
                        "glosses": [
                            "перен. кровопролитный бой; массовое убийство людей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6838496d-ecf9-4b2f-a7bc-915f6e8aa3dd",
                                "sense_id": "f516f47a-4a19-3284-9cbd-38c71b8131da",
                                "text": "Майский расстрел безоружных демонстрантов в Андижане был настолько массовым и неоправданным, что его можно назвать бойней."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4de51649-8684-4839-bf3c-45f79036beed",
                        "source_entry_id": "6da2bc2e-2404-363b-a247-fc3431db4f83",
                        "target_lang_word": "butchery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "butchery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abe582f3-4897-304b-9e51-1aac813e59c5",
                                        "entry_id": "62ad519d-8a5b-3dad-aef3-a4c7dfb542e7",
                                        "glosses": [
                                            "The cruel, ruthless killings of humans, as at a slaughterhouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78132e9e-21d3-4b7c-90fd-f363ccaa7dfb",
                                                "sense_id": "abe582f3-4897-304b-9e51-1aac813e59c5",
                                                "text": "The tyrannous and bloody act is done,—\nThe most arch deed of piteous massacre\nThat ever yet this land was guilty of.\nDighton and Forrest, who I did suborn\nTo do this piece of ruthless butchery"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10bedbe5-cac1-3849-92a0-29e7c8bcfd41",
                                        "entry_id": "62ad519d-8a5b-3dad-aef3-a4c7dfb542e7",
                                        "glosses": [
                                            "An abattoir, a slaughterhouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68a1a30c-de13-4133-a1c0-f32969480e03",
                                                "sense_id": "10bedbe5-cac1-3849-92a0-29e7c8bcfd41",
                                                "text": "1901 There was good grass on the selection all the year. I’d picked up a small lot—about twenty head—of half-starved steers for next to nothing, and turned them on the run; they came on wonderfully, and my brother-in-law (Mary’s sister’s husband), who was running a butchery at Gulgong, gave me a good price for them. — Henry Lawson, A Double Buggy at Lahey Creek."
                                            },
                                            {
                                                "example_id": "b60fb5a6-e8fe-42e8-9ff9-b6ebffe54853",
                                                "sense_id": "10bedbe5-cac1-3849-92a0-29e7c8bcfd41",
                                                "text": "1899 On the third Friday Jimmie was dropped at the door of the school from the doctor's buggy. The other children, notably those who had already passed over the mountain of distress, looked at him with glee, seeing in him another lamb brought to butchery. — Stephen Crane, Making an Orator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af757aba-05ba-3bd7-bdc8-40ad5f58f719",
                                        "entry_id": "62ad519d-8a5b-3dad-aef3-a4c7dfb542e7",
                                        "glosses": [
                                            "The butchering of meat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f23ac0bf-dd6c-4b19-9d9f-206aa4e82290",
                                                "sense_id": "af757aba-05ba-3bd7-bdc8-40ad5f58f719",
                                                "text": "This butchery begins in the first Japanese month. For this purpose they put the animal's head between two long poles, which are squeezed together by fifty or sixty people, both men and women. When the bear is dead they eat his flesh, keep the liver as a medicine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58103cfc-b6e0-315a-8b50-49b81d1b0900",
                                        "entry_id": "62ad519d-8a5b-3dad-aef3-a4c7dfb542e7",
                                        "glosses": [
                                            "A disastrous effort, an atrocious failure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "686ba252-c32a-4a2b-ba28-4739812bf7dc",
                                                "sense_id": "58103cfc-b6e0-315a-8b50-49b81d1b0900",
                                                "text": "I often wondered how Walcott the director could stand listening to some of his marvelous words and phrases being subjected to verbal butchery as sometimes occurred when a player did not understand what he was speaking or reading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93fa01c0-4639-3f79-a044-30e88fc21182",
                                        "entry_id": "62ad519d-8a5b-3dad-aef3-a4c7dfb542e7",
                                        "glosses": [
                                            "A meat market."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
