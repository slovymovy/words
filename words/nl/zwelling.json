                            "target_lang_translations": {
                                "en": "After the fall, he had a substantial <w>swelling</w> on his knee."
                            }
                        },
                        {
                            "text": "De arts adviseerde om ijs op de <w>zwelling</w> te leggen om de pijn te verzachten.",
                            "target_lang_translations": {
                                "en": "The doctor advised putting ice on the <w>swelling</w> to ease the pain."
