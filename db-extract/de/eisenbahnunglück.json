                            {
                                "example_id": "c88acff8-f89a-47bc-a4f8-ef585f33d964",
                                "sense_id": "1b122549-5ad5-385c-a505-70b6f89a3361",
                                "text": "„Im Februar 2002 waren beim schlimmsten Eisenbahnunglück in Ägypten ebenfalls in Al-Ajat 361 Menschen ums Leben gekommen.“"
                            },
                            {
                                "example_id": "32575b4c-6186-4c9b-b802-563aa7ab5152",
                                "sense_id": "1b122549-5ad5-385c-a505-70b6f89a3361",
                                "text": "„In dem kleinen Hotel, in dem ich zu Abend aß, wurde über nichts anderes als das Eisenbahnunglück gesprochen.“"
                            }
                        ],
