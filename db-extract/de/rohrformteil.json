                "senses": [
                    {
                        "sense_id": "ccfe08c8-9379-3814-a6da-7803be9ac90d",
                        "entry_id": "cc29fd76-3336-3991-896f-24723090c454",
                        "glosses": [
                            "Gegenstand von besonderer Gestalt der nur in Rohrleitungen eingebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4797bb37-e483-41f7-bcdc-03f400f51482",
                                "sense_id": "ccfe08c8-9379-3814-a6da-7803be9ac90d",
                                "text": "„Zu jedem Rohrleitungssystem gehören auch Rohrformteile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "64ce2a04-30eb-3f49-9206-8f4e739f3cfe",
                        "entry_id": "cc29fd76-3336-3991-896f-24723090c454",
                        "glosses": [
                            "gebogenes oder geformtes Röhrchen von besonderer Gestalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b69222ff-8bea-4969-b938-78622463a91e",
                                "sense_id": "64ce2a04-30eb-3f49-9206-8f4e739f3cfe",
                                "text": "„Wir fertigen und biegen Rohrformteile aus Stahl, Edelstahl, Messing, Kupfer, Aluminium und anderen Materialien nach Ihrem Wunsch.“"
                            },
                            {
                                "example_id": "b094e5b7-31bf-40ae-a123-6adbf5b5ff37",
                                "sense_id": "64ce2a04-30eb-3f49-9206-8f4e739f3cfe",
                                "text": "„Wir haben vielfältige Produktionsmöglichkeiten für Rohrformteile wie zum Beispiel: Sickenröhrchen, Steckerstifte, Aufgeweitete Rohre, Eingezogene Rohre, Gestauchte Rohre, Rollierde Rohre, Geplättete Rohre.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
