                                        "examples": [
                                            {
                                                "example_id": "6c9ad383-508d-43be-bc30-6efdf81a7b93",
                                                "sense_id": "e19b258a-2d16-33ad-9d75-a61114fe73ad",
                                                "text": "Have you found the canonical list of dumb blonde jokes on the Internet yet?"
