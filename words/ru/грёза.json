{
    "word_family": [
        "грезить"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d92db99c-9708-3a23-94d5-6afcc05a8197",
                    "sense_definition": "Светлая мечта, плод воображения, воздушный замок",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dream",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Юноша часами сидел у окна, погружённый в сладкие юношеские <w>грёзы</w> о славе.",
                            "target_lang_translations": {
                                "pl": "Młodzieniec godzinami siedział przy oknie, pogrążony w słodkich młodzieńczych <w>marzeniach</w> o sławie."
                            }
                        },
                        {
                            "text": "Её давняя <w>грёза</w> о путешествии в далёкие страны наконец-то начала осуществляться.",
                            "target_lang_translations": {
                                "pl": "Jej dawne <w>marzenie</w> o podróży do dalekich krajów w końcu zaczęło się spełniać."
                            }
                        }
                    ],
                    "synonyms": [
                        "мечта"
                    ],
                    "antonyms": [
                        "реальность",
                        "действительность"
                    ],
                    "common_phrases": [
                        "девичьи грёзы",
                        "сладкие грёзы",
                        "погрузиться в грёзы"
                    ],
                    "target_lang_definitions": {
                        "pl": "Jasne, romantyczne marzenie, wytwór wyobraźni, mrzonka"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "marzenie",
                                "target_lang_sense_clarification": "pragnienie, snucie marzeń"
                            },
                            {
                                "target_lang_word": "mrzonka",
                                "target_lang_sense_clarification": "nierealne, ulotne marzenie"
                            },
                            {
                                "target_lang_word": "rojeni",
                                "target_lang_sense_clarification": "poetycko: wyobrażenia, marzenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14b47082-5164-30c2-b290-56b4f4b80a2f",
                    "sense_definition": "Сновидение или видение в полусне, в состоянии забытья или бреда",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dream",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Больной лежал в тяжёлом жару, и смутные тревожные <w>грёзы</w> не давали ему покоя всю ночь.",
                            "target_lang_translations": {
                                "pl": "Chory leżał w ciężkiej gorączce, a mętne, niepokojące <w>mary</w> nie dawały mu spokoju przez całą noc."
                            }
                        },
                        {
                            "text": "От усталости путник задремал, и реальные звуки леса стали плавно переходить в туманные <w>грёзы</w>.",
                            "target_lang_translations": {
                                "pl": "Ze zmęczenia wędrowiec zdrzemnął się, a realne dźwięki lasu zaczęły płynnie przechodzić w mgliste <w>senne rojenia</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сновидение",
                        "видение",
                        "дрёма"
                    ],
                    "antonyms": [
                        "реальность",
                        "действительность"
                    ],
                    "common_phrases": [
                        "в полусне и грёзах",
                        "туманные грёзы"
                    ],
                    "target_lang_definitions": {
                        "pl": "Sen lub widzenie w półśnie, w stanie majaczenia lub zapomnienia"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "mara",
                                "target_lang_sense_clarification": "widziadło, zjawa, senne przywidzenie"
                            },
                            {
                                "target_lang_word": "przywidzenie",
                                "target_lang_sense_clarification": "halucynacja w półśnie lub gorączce"
                            },
                            {
                                "target_lang_word": "sen",
                                "target_lang_sense_clarification": "widzenie senne, półsen"
                            },
                            {
                                "target_lang_word": "widzenie",
                                "target_lang_sense_clarification": "obraz pojawiający się w stanie majaczenia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}