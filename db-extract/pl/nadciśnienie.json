                            {
                                "example_id": "8b68a480-0011-49f7-a4be-c4fe61596b03",
                                "sense_id": "504423d2-55ff-39ea-8702-2014a50eeb08",
                                "text": "Dieta roślinna jest pozytywnie skorelowana z niższym ryzykiem cukrzycy, nadciśnienia, chorób serca, udaru i śmierci z jakiejkolwiek przyczyny."
                            }
