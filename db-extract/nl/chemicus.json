                        ],
                        "form": "chemicusjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0526dd2-4ee3-30d0-8ca6-5f9252f048c4",
                        "entry_id": "f0faf5d6-f983-3eb0-8e5e-9b83c623cd81",
                        "glosses": [
                            "iemand die scheikunde beoefent op een wetenschappelijke manier"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "08f8ae28-7a3f-4608-9fef-8a6d14b28cd5",
                                "sense_id": "d0526dd2-4ee3-30d0-8ca6-5f9252f048c4",
                                "text": "Ik ben opgeleid als chemicus en dan is het laboratorium nooit ver weg, en ik vond het leuk om die achtergrond mee te nemen naar de geesteswetenschappen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "514e0d5d-767c-41ae-8209-428a8234d1c9",
                        "source_entry_id": "f0faf5d6-f983-3eb0-8e5e-9b83c623cd81",
                        "source_sense_id": "d0526dd2-4ee3-30d0-8ca6-5f9252f048c4",
                        "target_lang_word": "Chemiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chemiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62995263-e948-3391-95be-d1c9ee654620",
                                        "entry_id": "98d3a57c-c1bb-373d-9279-586922f490b0",
                                        "glosses": [
                                            "auf einer Hochschule ausgebildeter Fachmann auf dem Gebiet der Chemie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c27ef03-e7eb-43f9-afec-c1dc6a7c4445",
                                                "sense_id": "62995263-e948-3391-95be-d1c9ee654620",
                                                "text": "Wir müssen noch einen Chemiker und zwei Laboranten einstellen."
                                            },
                                            {
                                                "example_id": "6a805cd8-a48d-418c-8f44-710afe48f109",
                                                "sense_id": "62995263-e948-3391-95be-d1c9ee654620",
                                                "text": "„Vor über 50 Jahren führte der amerikanische Chemiker Stanley Miller ein Experiment durch, um die Bedingungen auf der frühen Erde zu imitieren.“"
                                            },
                                            {
                                                "example_id": "40cd6cb7-9dad-4468-8099-1b673ef5cd59",
                                                "sense_id": "62995263-e948-3391-95be-d1c9ee654620",
                                                "text": "„Er ist Chemiker und soll eine Bombe gelegt haben, dehalb wird er higerichtet.“"
                                            },
                                            {
                                                "example_id": "7c9b563c-a16c-42d0-8b6f-c2324a84063f",
                                                "sense_id": "62995263-e948-3391-95be-d1c9ee654620",
                                                "text": "„Er studiert zwar noch Chemie, hat aber nicht vor, jemals als Chemiker zu arbeiten.“"
                                            },
                                            {
                                                "example_id": "42de87b6-1f51-41e4-bc05-12f15f672db2",
                                                "sense_id": "62995263-e948-3391-95be-d1c9ee654620",
                                                "text": "„Der Chemiker sagt mit seinen Formeln, daß alles nacheinander greift und sich in Systemen ordnet, die ein Ausgleich nach vorhandenem Kampfe sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8e8488e-635b-4284-8db4-77de793c2ab1",
                        "source_entry_id": "f0faf5d6-f983-3eb0-8e5e-9b83c623cd81",
                        "source_sense_id": "d0526dd2-4ee3-30d0-8ca6-5f9252f048c4",
                        "target_lang_word": "chemist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chemist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67609533-8f4e-3186-8207-bb0051b72c88",
                                        "entry_id": "e0f9ede5-5bcc-3463-a8f7-b43a87f7bb1e",
                                        "glosses": [
                                            "A person who specializes in the science of chemistry, especially at a professional level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6493f0b-da31-41f4-b626-619bf5e30414",
                                                "sense_id": "67609533-8f4e-3186-8207-bb0051b72c88",
                                                "text": "It was Oxford now—the matriculation photograph, posed in the stony front quad at Corpus, the pelican on top of the sundial appearing to sit on the head of the lanky, begowned chemist at the centre of the back row."
                                            },
                                            {
                                                "example_id": "36db7a5c-29b2-43e2-a252-0f0d0dbeff62",
                                                "sense_id": "67609533-8f4e-3186-8207-bb0051b72c88",
                                                "text": "As the world's drug habit shows, governments are failing in their quest to monitor every London window-box and Andean hillside for banned plants. But even that Sisyphean task looks easy next to the fight against synthetic drugs. No sooner has a drug been blacklisted than chemists adjust their recipe and start churning out a subtly different one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce694a57-d232-3148-83e1-30e7de467557",
                                        "entry_id": "e0f9ede5-5bcc-3463-a8f7-b43a87f7bb1e",
                                        "glosses": [
                                            "Synonym of pharmacist."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c91cb05e-926b-35e0-aa59-833f2d021422",
                                        "entry_id": "e0f9ede5-5bcc-3463-a8f7-b43a87f7bb1e",
                                        "glosses": [
                                            "Synonym of pharmacy, especially as a standalone shop or general store."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand",
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65fbf97a-3c7c-3585-aa30-7d731e44dd46",
                                        "entry_id": "e0f9ede5-5bcc-3463-a8f7-b43a87f7bb1e",
                                        "glosses": [
                                            "An alchemist."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6cd3de2-3e0c-4438-a0a8-4702e40b73f0",
                        "source_entry_id": "f0faf5d6-f983-3eb0-8e5e-9b83c623cd81",
                        "source_sense_id": "d0526dd2-4ee3-30d0-8ca6-5f9252f048c4",
                        "target_lang_word": "chimiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chimiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28d2bb49-77de-3886-9022-882c16d7733f",
                                        "entry_id": "560b21b2-943b-3d69-9f63-9fa67023fbd7",
                                        "glosses": [
                                            "Celui, celle qui s’occupe de chimie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1521c456-2a52-4899-88a4-d0412f3ec8b7",
                                                "sense_id": "28d2bb49-77de-3886-9022-882c16d7733f",
                                                "text": "Il n’est pas possible, disent ces chimistes, d’entamer un morceau de verre trempé, à l’aide de la scie, du foret ou de la lime, sans que ce verre éclate, à la façon des larmes bataviques."
                                            },
                                            {
                                                "example_id": "bbdac754-5ebb-4606-ab1a-23c047531a74",
                                                "sense_id": "28d2bb49-77de-3886-9022-882c16d7733f",
                                                "text": "Les chimistes organiciens, conscient de l’aspect ludique propre aux synthèses chimiques -[…]- se sont attelés par défi à la création d’hydrocarbures dont le squelette carboné correspond aux polyèdres régulier que sont les solides platoniques."
                                            },
                                            {
                                                "example_id": "3ca4e515-6b07-447f-86e7-e8beee4d902e",
                                                "sense_id": "28d2bb49-77de-3886-9022-882c16d7733f",
                                                "text": "Le glucose fut pendant quelque temps synonyme de sucre de raisin et du genre féminin ; dans son fameux '''Dictionnaire de chimie pure et appliquée, bible du ''chimiste des années 1870-1900, Charles Adolphe Würtz note : « […] »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
