{
    "word_family": [
        "biec",
        "bieg",
        "ubiegać",
        "ubiegły"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b898cca-dcf4-311b-a496-6d04d2b34805",
                    "sense_definition": "zrobić coś wcześniej niż ktoś inny, uprzedzić czyjeś działanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uprzedzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałem kupić ten rzadki obraz, ale inny kolekcjoner mnie <w>ubiegł</w>.",
                            "target_lang_translations": {
                                "ru": "Я хотел купить эту редкую картину, но другой коллекционер меня <w>опередил</w>."
                            }
                        },
                        {
                            "text": "Musimy działać szybko, aby konkurencja nie <w>ubiegła</w> nas z nowym produktem.",
                            "target_lang_translations": {
                                "ru": "Мы должны действовать быстро, чтобы конкуренты не <w>опередили</w> нас с новым продуктом."
                            }
                        }
                    ],
                    "synonyms": [
                        "uprzedzić",
                        "wyprzedzić",
                        "prześcignąć"
                    ],
                    "common_phrases": [
                        "ubiec konkurencję"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать что-либо раньше другого, опередить чьи-либо действия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опередить",
                                "target_lang_sense_clarification": "сделать что-то раньше других"
                            },
                            {
                                "target_lang_word": "предупредить",
                                "target_lang_sense_clarification": "опередить чьи-либо действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84ee3f7f-ecf7-3428-8a2a-dc8a42222cbf",
                    "sense_definition": "o czasie: upłynąć, przeminąć",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nim się zorientował, <w>ubiegło</w> kilka lat spędzonych na obczyźnie.",
                            "target_lang_translations": {
                                "ru": "Прежде чем он успел опомниться, <w>прошло</w> несколько лет, проведённых на чужбине."
                            }
                        },
                        {
                            "text": "Szybko <w>ubiegł</w> kolejny miesiąc wytężonej pracy nad ważnym projektem.",
                            "target_lang_translations": {
                                "ru": "Быстро <w>пролетел</w> очередной месяц напряжённой работы над важным проектом."
                            }
                        }
                    ],
                    "synonyms": [
                        "minąć"
                    ],
                    "target_lang_definitions": {
                        "ru": "о времени: пройти, истечь"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пройти",
                                "target_lang_sense_clarification": "о времени"
                            },
                            {
                                "target_lang_word": "минуть",
                                "target_lang_sense_clarification": "о времени"
                            },
                            {
                                "target_lang_word": "истечь",
                                "target_lang_sense_clarification": "о сроке или времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41020d36-8e9d-3d92-a3e0-1c5d7a58a503",
                    "sense_definition": "pokonać pewną odległość, biegnąc",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Choć był już bardzo zmęczony, <w>ubiegł</w> jeszcze kilometr leśną ścieżką.",
                            "target_lang_translations": {
                                "ru": "Хотя он уже очень устал, он <w>пробежал</w> ещё километр по лесной тропинке."
                            }
                        },
                        {
                            "text": "Zawodniczka z trudem <w>ubiegła</w> wyznaczony odcinek przed zapadnięciem zmroku.",
                            "target_lang_translations": {
                                "ru": "Спортсменка с трудом <w>пробежала</w> положенный отрезок до наступления темноты."
                            }
                        }
                    ],
                    "synonyms": [
                        "przebiec"
                    ],
                    "target_lang_definitions": {
                        "ru": "преодолеть бегом определенное расстояние"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробежать",
                                "target_lang_sense_clarification": "преодолеть дистанцию бегом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34ffd0b2-3966-3f21-bf10-b6e6ed5ab2b0",
                    "sense_definition": "uciec potajemnie skądś lub przed kimś",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ucieczka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Więzień sprytnie wykorzystał zamieszanie w celi i niepostrzeżenie <w>ubiegł</w> strażnikom.",
                            "target_lang_translations": {
                                "ru": "Заключённый ловко воспользовался суматохой в камере и незаметно <w>сбежал</w> от охранников."
                            }
                        },
                        {
                            "text": "Dawno temu młody szlachcic <w>ubiegł</w> z domu z ukochaną kobietą.",
                            "target_lang_translations": {
                                "ru": "Давным-давно молодой дворянин <w>бежал</w> из дома с любимой женщиной."
                            }
                        }
                    ],
                    "synonyms": [
                        "uciec",
                        "zbiec"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тайно убежать откуда-либо или от кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбежать",
                                "target_lang_sense_clarification": "совершить побег"
                            },
                            {
                                "target_lang_word": "убежать",
                                "target_lang_sense_clarification": "скрыться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}