            {
                "entry_id": "c0f72d4e-2797-3e99-ace3-e4fea4510574",
                "word": "Yuri",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "43448f1f-32f4-3f31-b4e9-8ac8170576ea",
                        "entry_id": "c0f72d4e-2797-3e99-ace3-e4fea4510574",
                        "glosses": [
                            "A transliteration of the Russian male given name Ю́рий (Júrij), equivalent to George."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8012e2-52e0-41a7-8ff3-e161484252a0",
                                "sense_id": "43448f1f-32f4-3f31-b4e9-8ac8170576ea",
                                "text": "Khrushchev’s answer came 60 years ago, on April 12, 1961, when Soviet cosmonaut Yuri Gagarin circled the Earth aboard a spacecraft called Vostok 1."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1b16f43-e885-4243-b28e-223e42cee338",
                        "source_entry_id": "c0f72d4e-2797-3e99-ace3-e4fea4510574",
                        "source_sense_id": "43448f1f-32f4-3f31-b4e9-8ac8170576ea",
                        "source_sense_description": "Male given name originating from Russian",
                        "target_lang_word": "Youri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Youri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b343efd6-2571-3e4f-a9b2-e3fdd64d0718",
                                        "entry_id": "4bf482b6-f594-3014-9dc6-025be9f16397",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e2a7f2-1c3b-44d2-b22d-395fd88fefb4",
                                                "sense_id": "b343efd6-2571-3e4f-a9b2-e3fdd64d0718",
                                                "text": "L'année suivante [1983], la diffusion dans les pays occidentaux du téléfilm Le Jour d'après (The Day After) marque les esprits, alors que la tension est vive entre les gouvernements de Ronald Reagan et de Youri Andropov."
                                            },
                                            {
                                                "example_id": "ce16b129-41f6-46a5-867d-2b14e26e54b2",
                                                "sense_id": "b343efd6-2571-3e4f-a9b2-e3fdd64d0718",
                                                "text": "« J’aimerais changer mon téléphone depuis des mois. S’il y a une bonne offre, ce sera l’occasion, sinon on attendra », explique Youri."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
