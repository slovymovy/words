                "senses": [
                    {
                        "sense_id": "dcca0d7b-44b5-3e9d-93b9-80cee9dcc670",
                        "entry_id": "5b8a0402-362c-3e51-9b45-b92c4b07cfa2",
                        "glosses": [
                            "Person, die ihre eigenen Leistungen stark übertreibend und unaufgefordert in den Vordergrund stellt"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "76fecc47-9ff3-4afe-8336-7ba5a94665b3",
                                "sense_id": "dcca0d7b-44b5-3e9d-93b9-80cee9dcc670",
                                "text": "„Gerd spielte aber weiter den Großkotz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e1b358e-4da2-4128-9392-9df1651a0940",
                        "source_entry_id": "5b8a0402-362c-3e51-9b45-b92c4b07cfa2",
                        "source_sense_id": "dcca0d7b-44b5-3e9d-93b9-80cee9dcc670",
                        "target_lang_word": "bighead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bighead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c891ec85-67b9-3044-9b11-ef02081ae422",
                                        "entry_id": "211d7019-2299-3659-a6ff-b96a562f6398",
                                        "glosses": [
                                            "A person with an inflated opinion of themselves; a conceited or arrogant person."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37516408-2f1a-41dd-a44e-ae93ff79e030",
                                                "sense_id": "c891ec85-67b9-3044-9b11-ef02081ae422",
                                                "text": "'But there are too many egos, way too many. I mean bigheads who are sidetracked by stuff away from football.'"
                                            },
                                            {
                                                "example_id": "9d106cbf-dbcf-4bed-994c-7dbe00dc2215",
                                                "sense_id": "c891ec85-67b9-3044-9b11-ef02081ae422",
                                                "text": "I'm not such a bighead that I think I can do better than Hugh and Hereman at reclaiming the main island."
                                            },
                                            {
                                                "example_id": "0ae2ad04-744d-429e-ae39-fe2f5221f0b9",
                                                "sense_id": "c891ec85-67b9-3044-9b11-ef02081ae422",
                                                "text": "He is such a bighead and so lazy that I don't know how far he will go. He can read and write English a little bit and he thinks that is enough for him to know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4a97ca0-5c2a-3e61-b21b-579d80883bc1",
                                        "entry_id": "211d7019-2299-3659-a6ff-b96a562f6398",
                                        "glosses": [
                                            "Any of several species of fish having a large head."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2cfff24-a8b9-36fb-8045-568dcd7255b3",
                                        "entry_id": "211d7019-2299-3659-a6ff-b96a562f6398",
                                        "glosses": [
                                            "Any of several animal diseases that cause swelling of the head."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fec6e79e-2718-48f9-b351-51c956d0e11f",
                        "source_entry_id": "5b8a0402-362c-3e51-9b45-b92c4b07cfa2",
                        "source_sense_id": "dcca0d7b-44b5-3e9d-93b9-80cee9dcc670",
                        "target_lang_word": "prétentiard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prétentiard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61cede64-9368-3dce-a011-0239aa835a6a",
                                        "entry_id": "b191d4ec-5c32-3da4-8a6d-95d5b303d563",
                                        "glosses": [
                                            "Prétentieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd640ea-a13b-4b37-8873-2ce49d4e569b",
                                                "sense_id": "61cede64-9368-3dce-a011-0239aa835a6a",
                                                "text": "La maison est une construction de deux étages, bâtie pour un ancien B.O.F. prétentiard qui a voulu une tour, histoire de se donner des idées de noblesse."
                                            },
                                            {
                                                "example_id": "d4c4be1b-50b2-4cde-b07b-817c1b365422",
                                                "sense_id": "61cede64-9368-3dce-a011-0239aa835a6a",
                                                "text": "Sauveur apprit aussi qu’Anne Lechat était la nièce du premier mari de Mme Compain « un tordu que le soleil d’Afrique n’avait pas arrangé », qu’elle avait trente-cinq ans (fortiche le commissaire…) qu’elle vivait près de « La Grande Maison », un peu à l’écart, qu’elle était timide et effacée mais « bonne comme le pain, toujours prête à rendre service sans se faire valoir, pas prétentiarde et pas ramenarde. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prétentiard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca8d4118-7865-316a-a5d8-2e316d2566bd",
                                        "entry_id": "b613e8e9-96ea-3eab-93f0-989bba2162f8",
                                        "glosses": [
                                            "Personne prétentieuse."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3b1e02-61d5-49c7-b292-495358c9b0c1",
                                                "sense_id": "ca8d4118-7865-316a-a5d8-2e316d2566bd",
                                                "text": "Elle sentait bien que Tim s'efforçait de refroidir son amitié pour celui qu'il considérait comme un \"prétentiard de première\". Mais elle ne considérait pas Poirot comme un prétentiard."
                                            },
                                            {
                                                "example_id": "f6d9d2fc-0201-4101-9bfe-36242f32c93a",
                                                "sense_id": "ca8d4118-7865-316a-a5d8-2e316d2566bd",
                                                "text": "Ce prétentiard se mit à râler parce qu’un vieux con lui piétinait les panards avec une fureur sénile […]"
                                            },
                                            {
                                                "example_id": "24ccc08b-1495-4819-8924-1f13b0843c52",
                                                "sense_id": "ca8d4118-7865-316a-a5d8-2e316d2566bd",
                                                "text": "De leur côté, les « vieux » de Marbot considéraient leurs collègues des Récollets comme des intellectuels et des « prétentiards ». Moins doués en général, ils trouvaient une supériorité dans leur force physique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
