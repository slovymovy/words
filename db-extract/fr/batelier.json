                    },
                    {
                        "form_id": "cd3896c9-f036-4661-8571-1a3a36297974",
                        "entry_id": "81905102-9ba7-3c56-b884-602b33b924ac",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "batelières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8375b5ed-ad40-3d9a-a743-e5b69fbcc79e",
                        "entry_id": "81905102-9ba7-3c56-b884-602b33b924ac",
                        "glosses": [
                            "Relatif aux bateliers et batelières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec94986-a8ac-4991-9ea4-be1d97eea72d",
                                "sense_id": "8375b5ed-ad40-3d9a-a743-e5b69fbcc79e",
                                "text": "Au midi, le faubourg batelier du Portereau, avec l’église et le couvent des Augustins, s’étendait le long du fleuve, au pied des vignobles de Saint-Jean-le-Blanc qui mûrissaient le meilleur vin du pays."
                            },
                            {
                                "example_id": "d71cddb5-a120-4df1-a603-79c4ebfbc746",
                                "sense_id": "8375b5ed-ad40-3d9a-a743-e5b69fbcc79e",
                                "text": "Elle tient dans une main une rame qui rappelle la vocation batelière de ce port fluvial situé au confluent de trois canaux et d’une rivière ; de l’autre, elle porte une corne d’abondance."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c3c7acda-4a81-326c-b089-686e5f53aa08",
                "word": "batelier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0702fb15-d0af-4c33-b7aa-0672644a4a77",
                        "entry_id": "c3c7acda-4a81-326c-b089-686e5f53aa08",
                        "tags": [
                            "plural"
                        ],
                        "form": "bateliers"
                    },
                    {
                        "form_id": "ffacdabc-a3d4-4651-81b6-707acdb26e8f",
                        "entry_id": "c3c7acda-4a81-326c-b089-686e5f53aa08",
                        "tags": [
                            "feminine"
                        ],
                        "form": "batelière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db1a5558-a9ea-344d-bfcd-2ddd0c611190",
                        "entry_id": "c3c7acda-4a81-326c-b089-686e5f53aa08",
                        "glosses": [
                            "Personne dont la profession est de conduire un bateau, principalement sur une rivière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1510b3-52b8-4cdb-8e53-aa7c42d05136",
                                "sense_id": "db1a5558-a9ea-344d-bfcd-2ddd0c611190",
                                "text": "En l’absence de pareille clause, le batelier doit se rendre compte par lui-même si l’emplacement proposé à son libre choix répond aux exigences de son bateau et si ce bateau peut y séjourner sans avaries."
                            },
                            {
                                "example_id": "3b2085fe-423d-4d51-bb6b-d17050ea2cce",
                                "sense_id": "db1a5558-a9ea-344d-bfcd-2ddd0c611190",
                                "text": "Même s'ils sont des « marins d’eau douce », les bateliers et mariniers sont aussi seuls, isolés dans leur corporation, que ceux de la marine marchande de Marseille ou de La Rochelle. Ils ne se connaissent qu'entre eux, […]."
                            },
                            {
                                "example_id": "cc2beba2-75e1-4e6e-a7aa-34f194df3234",
                                "sense_id": "db1a5558-a9ea-344d-bfcd-2ddd0c611190",
                                "text": "… cependant le batelier nous attendait, la marée était haute, il fallait partir."
                            },
                            {
                                "example_id": "da12cd6d-decf-49e2-b7dc-2ea113233220",
                                "sense_id": "db1a5558-a9ea-344d-bfcd-2ddd0c611190",
                                "text": "On nous descendit un à un et l’on nous fit entrer dans la cabine commune : il n’y avait d’alcôves que pour le personnel, et rien pour nous asseoir. Les bateliers étaient visiblement ennuyés de cette marmaille qui pleurait, faisait pipi… et le reste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf97b145-5f47-4c31-9622-650867c9c06c",
                        "source_entry_id": "c3c7acda-4a81-326c-b089-686e5f53aa08",
                        "source_sense_id": "db1a5558-a9ea-344d-bfcd-2ddd0c611190",
                        "source_sense_description": "Conducteur de bateau",
                        "target_lang_word": "Schiffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                        "entry_id": "7739d886-85ca-3fd4-b3d9-aa3e7a62bd7f",
                                        "glosses": [
                                            "eine in der Binnenschifffahrt tätige Person"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d053e595-46a9-4735-8517-ee19cf238228",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "Er hat viele Jahre als Schiffer in der Binnenschifffahrt gearbeitet."
                                            },
                                            {
                                                "example_id": "5f286afe-a0e3-4d7f-b91f-e0a2e86e13e9",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„Flößer und Schiffer manövrierten in mühseliger Arbeit durch die gefährlichen Stellen.“"
                                            },
                                            {
                                                "example_id": "24b0406e-490c-4bdc-ad06-af5e242287db",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„In der Familie Kokot fuhren die Männer seit Generationen als Schiffer auf der Oder.“"
                                            },
                                            {
                                                "example_id": "3d4ac4a5-8dc1-43be-a88b-8cc496381443",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„Die Schiffer waren darüber wütend und schimpften.“"
                                            },
                                            {
                                                "example_id": "20a10fa9-c6c1-454b-a0b8-a2aead82a851",
                                                "sense_id": "736cddbd-a9be-3237-a4e4-27d7b1ae6785",
                                                "text": "„Er sprach es nicht aus, plante aber im Herzen, irgendwie mit den Schiffern gemeinsame Sache zu machen, um seinen Herrn ins Wasser zu stoßen und so ums Leben zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e6b32a7-23b6-325a-b83b-078d8713d2b9",
                                        "entry_id": "7739d886-85ca-3fd4-b3d9-aa3e7a62bd7f",
                                        "glosses": [
                                            "der Führer eines Schiffes"
                                        ],
                                        "tags": [
                                            "Seerecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efaefe10-f1d3-4770-8bb2-ad3e836cc0db",
                                                "sense_id": "9e6b32a7-23b6-325a-b83b-078d8713d2b9",
                                                "text": "„Kurz bevor ich mich zu Tich setzte, kam der Schiffer selbst mit einem Matrosen, um mein Gepäck zu holen; ich gab ihm den fertigen Koffer und sagte, den Rest würde ich selbst zur Abfahrtszeit an Bord bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d469ed7-46c6-4ab6-bb0b-1eba7cacdd6c",
                        "source_entry_id": "c3c7acda-4a81-326c-b089-686e5f53aa08",
                        "source_sense_id": "db1a5558-a9ea-344d-bfcd-2ddd0c611190",
                        "source_sense_description": "Conducteur de bateau",
                        "target_lang_word": "Flussschiffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flussschiffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15867091-7b12-3611-8a20-e459a11448c1",
                                        "entry_id": "fa705349-9af9-3c55-b51b-c819dc41ef61",
                                        "glosses": [
                                            "in der Flussschifffahrt tätige Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb568ce-c154-4cd6-a575-fae8c3922002",
                                                "sense_id": "15867091-7b12-3611-8a20-e459a11448c1",
                                                "text": "„Er hielt sich kurz in Washington auf, wo er in dem mückenverpesteten, als George Town bekannten Slum hauste, dann – noch kürzer – in Pennsylvania und landete schließlich in Buffalo, wo er sich vom Farmer zum Flussschiffer wandelte.“"
                                            },
                                            {
                                                "example_id": "eeb06dc1-499d-46c3-bb5f-80bc9d8909bb",
                                                "sense_id": "15867091-7b12-3611-8a20-e459a11448c1",
                                                "text": "„Bei diesen Rum schmuggelnden Flussschiffern kann ein Mann einen Haufen Kohle machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
