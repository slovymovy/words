                ],
                "senses": [
                    {
                        "sense_id": "617c3fd8-1f96-31bd-a55f-abe4ef29dc6f",
                        "entry_id": "d48682da-bee7-3d1d-9474-897514218613",
                        "glosses": [
                            "Schwäche des Immunsystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd8347d3-622e-4ea2-a478-aeb59e06afe7",
                                "sense_id": "617c3fd8-1f96-31bd-a55f-abe4ef29dc6f",
                                "text": "„Bei Patienten mit Immundefizit oder mit unzureichendem Ansprechen auf die Therapie können höhere Dosierungen und eine längere Therapiedauer erforderlich sein.“"
                            },
                            {
                                "example_id": "d3d7dd29-87b8-487a-97dc-9bbbb9674578",
                                "sense_id": "617c3fd8-1f96-31bd-a55f-abe4ef29dc6f",
                                "text": "„Nacktmäuse haben eine spontane Deletion im FOXN1-Gen. Menschen mit Mutationen in FOXN1 sind ebenfalls athymisch und haben ein Immundefizit.“"
                            },
                            {
                                "example_id": "918344b8-a8c9-40c6-b373-2bac6ffc45cc",
                                "sense_id": "617c3fd8-1f96-31bd-a55f-abe4ef29dc6f",
                                "text": "„Die Komplikationsfrequenz nach Milzeingriffen wird im Wesentlichen durch die vorbestehende Grundkrankheit […] und das damit bestehende Immundefizit bestimmt.“"
                            },
                            {
                                "example_id": "c4204c9c-c243-4b79-9093-02294f15b091",
                                "sense_id": "617c3fd8-1f96-31bd-a55f-abe4ef29dc6f",
                                "text": "„Ein Immundefizit ist die Hauptursache und muss vorhanden sein, bevor eine Infektion stattfindet, da diese Mikroorganismen nicht hochkontagiös [hochansteckend] sind.“"
                            },
                            {
                                "example_id": "3a266685-c622-4429-940e-c21ec248d9c3",
                                "sense_id": "617c3fd8-1f96-31bd-a55f-abe4ef29dc6f",
                                "text": "„Bei Patienten mit Immundefizit, z. B. durch Aids, sollte die CD4/CD8-Ratio bestimmt werden, um den Immunstatus näher beurteilen zu können[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
