                    {
                        "translation_id": "c81fe0ff-4d15-4022-b676-11bf25bba313",
                        "source_entry_id": "7456c820-bbc7-3287-a598-1519b842389e",
                        "source_sense_id": "c26f4500-fbce-388f-9f4a-d40cae14e512",
                        "source_sense_description": "aanvullend",
