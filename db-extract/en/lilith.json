                                        "sense_id": "1d94934f-693b-36ec-b57f-e284cc026583",
                                        "entry_id": "c47bffda-7a57-3925-ab53-cc0e1af09114",
                                        "glosses": [
                                            "Démon féminin de la tradition juive, présentée depuis le Moyen Âge comme la première compagne d’Adam, avant Ève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01ab9f7-2b69-4d08-aca8-ec61f12ee4f6",
                                                "sense_id": "1d94934f-693b-36ec-b57f-e284cc026583",
                                                "text": "Étrangement, on trouve également en bonne place une « démone », Lilith (Is 34,14), ce qui est curieux quand on songe que les anges ne sont pas censés avoir de sexe, mais qui est compréhensible quand on sait que ces noms attribués à certains anges sont empruntés à des divinités païenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebc779e2-9749-4bf8-a74e-850f8c467a07",
                        "source_entry_id": "1afd5de4-5baf-3941-9f4d-0dcf6fe38689",
                        "source_sense_description": "mythological demon",
                        "target_lang_word": "Lilith",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lilith",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                        "entry_id": "445260cb-eea0-3126-8300-18b94e4143a6",
                                        "glosses": [
                                            "weiblicher Dämon sumerischer Herkunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "907a1847-305a-41bc-ba06-6ee5404a5b21",
                                                "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                                "text": "„Der Satan hielt hier seinen babylonischen Hof, und mit dem Blut unbefleckter Kindheit wurden die leprösen Glieder Liliths gewaschen.“"
                                            },
                                            {
                                                "example_id": "0db23929-066d-4b87-ada8-68b8a0c6dfdf",
                                                "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                                "text": "„Auch sie war böse und ihre Schönheit war die Schönheit der Lilith.“"
                                            },
                                            {
                                                "example_id": "2fab2249-c34d-4caa-9a66-0bb3be8b63fc",
                                                "sense_id": "5aa5fdd0-3653-3845-a98a-2800f2f7ca6d",
                                                "text": "„Wir folgen dem geschlängelten Weg, und Leonard zählt noch immer Dämonen auf, denen wir begegnen könnten: Mevet, der judaische Totengott; Lilith, die Kinder stiehlt; Reshef, der Dämon der Plagen; Azazel, Dämon der Wüsten; Astaroth ... Robert Mapplethorpe ... Luzifer ... Behemoth ...“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
