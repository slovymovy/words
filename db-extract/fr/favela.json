                "senses": [
                    {
                        "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                        "entry_id": "2dcab1fc-84ce-30de-b762-1090697e7b0b",
                        "glosses": [
                            "Bidonville brésilien."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "25645734-144b-41e0-82a8-e36625b6cb42",
                                "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                "text": "Dans la perspective des Jeux olympiques, Rio de Janeiro « pacifie » ses favelas, un euphémisme qui masque la nature ambiguë d’une politique conduite à la pointe du fusil."
                            },
                            {
                                "example_id": "920db013-2266-4662-af57-a7e664e34b27",
                                "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                "text": "Le Brésil, où la violence et la corruption règnent en maîtres, réussira-t-il à se distinguer autrement que par le futebol et ses favelas?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4b91347-1999-4894-82d2-a90102c23143",
                        "source_entry_id": "2dcab1fc-84ce-30de-b762-1090697e7b0b",
                        "source_sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
