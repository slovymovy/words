                            },
                            {
                                "example_id": "58d96edb-0c5e-46f9-90d0-0f881d1ea369",
                                "sense_id": "fb2321ff-a332-3674-bb7a-dc7ec46b4a48",
                                "text": "внуша́ть кому́-либо уваже́ние",
                                "translation": "to command someone's respect",
                                "english": "to command someone's respect"
                            }
                        ]
                    },
                    {
                        "sense_id": "e432e636-8651-3021-8d02-197cd5534360",
                        "entry_id": "65db380e-d0dd-3e67-b74c-5d323ab4e2c5",
                        "glosses": [
                            "to convince, to suggest"
                        ],
                        "tags": [],
                        "examples": [
                            {
