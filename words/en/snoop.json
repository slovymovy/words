        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0066141d-cbd8-3e5d-b1e9-ff438ef78c8d",
                    "sense_definition": "A person who secretly spies on others or pries into their business.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful what you say around Gene because he's the bosses' <w>snoop</w>.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен в словах при Джине, потому что он — <w>ищейка</w> босса.",
                                "tr": "Gene'in yanında ne söylediğine dikkat et çünkü o patronun <w>hafiyesi</w>.",
                                "pl": "Uważaj na to, co mówisz przy Gene'ie, bo to <w>szpicel</w> szefostwa."
                            }
                        },
                        {
                            "text": "The neighborhood <w>snoop</w> is always watching from behind her curtains.",
                            "target_lang_translations": {
                                "ru": "Местная <w>любопытная особа</w> вечно следит за всеми из-за своих штор.",
                                "tr": "Mahallenin <w>meraklısı</w> her zaman perdelerin arkasından gözetliyor.",
                                "pl": "Osiedlowa <w>wścibska sąsiadka</w> bez przerwy obserwuje wszystkich zza firanek."
                            }
                        }
                    ],
                    "synonyms": [
                        "busybody",
                        "nosy parker",
                        "spy"
                    ],
                    "common_phrases": [
                        "neighborhood snoop"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a prying person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который тайно следит за другими или вмешивается в их дела.",
                        "tr": "Başkalarının işlerini gizlice gözetleyen veya özel hayatlarına burnunu sokan kimse.",
                        "pl": "Osoba, która węszy, szpieguje lub wtrąca się w cudze sprawy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ищейка",
                                "target_lang_sense_clarification": "о человеке, который всё вынюхивает"
                            },
                            {
                                "target_lang_word": "любопытный",
                                "target_lang_sense_clarification": "человек, сующий нос в чужие дела"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "meraklı",
                                "target_lang_sense_clarification": "başkalarının işlerine burnunu sokan kişi"
                            },
                            {
                                "target_lang_word": "gammaz",
                                "target_lang_sense_clarification": "başkalarının sırlarını taşıyan kişi"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wścibska osoba",
                                "target_lang_sense_clarification": "ktoś, kto wtrąca się w prywatne sprawy innych"
                            },
                            {
                                "target_lang_word": "szpicel",
                                "target_lang_sense_clarification": "tajny obserwator, donosiciel"
                            },
                            {
                                "target_lang_word": "węszyciel",
                                "target_lang_sense_clarification": "ktoś, kto usiłuje wywęszyć sekrety"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa3ff138-5377-35c7-94d8-e650461ea20d",
                    "sense_definition": "The act of spying or prying into someone's private affairs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I caught him having a quick <w>snoop</w> through my desk drawers.",
                            "target_lang_translations": {
                                "ru": "Я поймал его за быстрым <w>осмотром</w> ящиков моего стола.",
                                "tr": "Onu çalışma masamın çekmecelerini hızlıca <w>karıştırırken</w> yakaladım.",
                                "pl": "Przyłapałem go na szybkim <w>myszkowaniu</w> po szufladach mojego biurka."
                            }
                        },
                        {
                            "text": "She went for a <w>snoop</w> around the house while the owners were away.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>пошпионить</w> в доме, пока хозяева отсутствовали.",
                                "tr": "Ev sahipleri yokken evin içinde <w>gizlice dolaşmaya</w> gitti.",
                                "pl": "Poszła na <w>myszkowanie</w> po domu pod nieobecność właścicieli."
                            }
                        }
                    ],
                    "synonyms": [
                        "look-around",
                        "prying"
                    ],
                    "common_phrases": [
                        "have a snoop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт слежки или вмешательства в чьи-либо частные дела.",
                        "tr": "Başkalarının özel hayatını gizlice gözetleme veya araştırma eylemi.",
                        "pl": "Akt węszenia, szpiegowania lub zaglądania w cudze prywatne sprawy."
                    },
