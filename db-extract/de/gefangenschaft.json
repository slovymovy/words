                                    {
                                        "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                        "entry_id": "fe5aedf6-b95e-3f90-8902-576163ce428b",
                                        "glosses": [
                                            "A confinement in a place, especially a prison or a jail, especially as punishment for a crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703723e8-a699-43b7-b7e0-5522de697c08",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "His sinews woxen weake and raw / Through long emprisonment and hard constraint."
                                            },
                                            {
                                                "example_id": "3ac79ea7-a2c2-47f0-8141-7d1d309527b4",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Every confinement of the person is an imprisonment, whether it be in a common prison, or in a private house, or even by forcibly detaining one in the public streets."
                                            },
                                            {
                                                "example_id": "567f1ae2-8bd0-4bd3-9da4-3a7859e2107d",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e48dd4c-d0a4-44ea-a19a-9695eb28a899",
                        "source_entry_id": "d0ba3f84-f808-37c6-9986-39777e04feb8",
                        "source_sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                        "source_sense_description": "meist Singular: Zustand, in dem jemand oder etwas gefangen gehalten wird",
                        "target_lang_word": "emprisonnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emprisonnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                                        "entry_id": "baa38187-1fa1-34b0-9848-5e9c805786f3",
                                        "glosses": [
                                            "Action d’emprisonner."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad263bc9-47be-4178-914d-d7d529eb60e9",
                                                "sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                                                "text": "La première sensation, poignante jusqu’à l’angoisse, fut pour Jacques celle de l’emprisonnement dans tout ce sable, derrière toutes ces solitudes, …."
                                            },
                                            {
                                                "example_id": "c85d42ff-27af-4781-bd0b-3e9e3bd10f79",
                                                "sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                                                "text": "Le fait d’obtenir d’une personne l’un de ses organes contre un paiement, quelle qu’en soit la forme, est puni de sept ans d’emprisonnement et de 100000 euros d’amende."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e186b2fc-cc19-4f5f-9ef4-e6bbebc06e60",
                        "source_entry_id": "d0ba3f84-f808-37c6-9986-39777e04feb8",
