                {
                    "sense_id": "da982ea3-3e2b-3efd-8ac3-cbdc05cf2a95",
                    "sense_definition": "In a fundamental, essential, or basic manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two political parties are <w>basically</w> different in their approach to the economy.",
                            "target_lang_translations": {
                                "ru": "Эти две политические партии <w>принципиально</w> отличаются в своём подходе к экономике.",
                                "zh": "这两个政党在经济处理方式上<w>本质上</w>是不同的。",
                                "pl": "Te dwie partie polityczne <w>zasadniczo</w> różnią się podejściem do gospodarki.",
                                "tr": "İki siyasi parti, ekonomiye yaklaşımları konusunda <w>temelde</w> farklıdır.",
                                "nl": "De twee politieke partijen zijn <w>fundamenteel</w> verschillend in hun benadering van de economie.",
                                "de": "Die beiden politischen Parteien unterscheiden sich in ihrem Ansatz zur Wirtschaft <w>grundlegend</w>.",
                                "fr": "Les deux partis politiques sont <w>fondamentalement</w> différents dans leur approche de l'économie.",
                                "it": "I due partiti politici sono <w>fondamentalmente</w> diversi nel loro approccio all'economia.",
                                "cs": "Tyto dvě politické strany se ve svém přístupu k ekonomice <w>zásadně</w> liší.",
                                "es": "Los dos partidos políticos son <w>fundamentalmente</w> diferentes en su enfoque de la economía."
                            }
                        },
                        {
                            "text": "Human beings are <w>basically</w> social creatures who need interaction.",
                            "target_lang_translations": {
                                "ru": "Люди — <w>в своей основе</w> социальные существа, которым необходимо общение.",
                                "zh": "人类<w>本质上</w>是需要社交互动的生物。",
                                "pl": "Ludzie są <w>z natury</w> istotami społecznymi, które potrzebują interakcji.",
                                "tr": "İnsanlar <w>doğası gereği</w> etkileşime ihtiyaç duyan sosyal varlıklardır.",
                                "nl": "Mensen zijn <w>in wezen</w> sociale wezens die interactie nodig hebben.",
                                "de": "Menschen sind <w>von Natur aus</w> soziale Wesen, die Interaktion brauchen.",
                                "fr": "Les êtres humains sont <w>foncièrement</w> des créatures sociales qui ont besoin d'interactions.",
                                "it": "Gli esseri umani sono <w>fondamentalmente</w> creature sociali che hanno bisogno di interazione.",
                                "cs": "Lidé jsou <w>v jádru</w> společenští tvorové, kteří potřebují kontakt.",
                                "es": "Los seres humanos son <w>por naturaleza</w> criaturas sociales que necesitan interacción."
                            }
                        }
                    ],
