                        "source_sense_id": "0a02eb2c-76f4-35b4-85b1-14fffd254cbe",
                        "target_lang_word": "branding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "branding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74375365-3a43-3de6-bed4-57ed659b2947",
                                        "entry_id": "7e5a9551-9fce-3ea5-bcdb-6e493dd4a486",
                                        "glosses": [
                                            "The process in which a mark, usually a symbol or ornamental pattern, is burned into the skin of a living animal or person (usually a livestock animal)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b55103e-7af2-4285-861d-7b154ca447ad",
                                                "sense_id": "74375365-3a43-3de6-bed4-57ed659b2947",
                                                "text": "Punishment for theft was inflicted, either by fine, imprisonment, or hard labour, or by branding."
                                            },
                                            {
                                                "example_id": "f670315e-f273-43a2-b716-ad83f11d4ab4",
                                                "sense_id": "74375365-3a43-3de6-bed4-57ed659b2947",
                                                "text": "Tattoos, in particular, are not the radical brandings, the bold violations of flesh and propriety, they once were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0809bd-1152-39a7-b3ed-717e9777c217",
                                        "entry_id": "7e5a9551-9fce-3ea5-bcdb-6e493dd4a486",
                                        "glosses": [
                                            "The promotion of a commercial brand of product or service in order to give it greater public awareness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88de9b53-2ace-4c12-afd5-d49a7be0eb7e",
                                                "sense_id": "1a0809bd-1152-39a7-b3ed-717e9777c217",
                                                "text": "Near-synonyms: marketing, promotion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847b9a63-8954-39f6-bbdd-a839d0045c6c",
                                        "entry_id": "7e5a9551-9fce-3ea5-bcdb-6e493dd4a486",
                                        "glosses": [
                                            "The trade dress thus presented (trademarks, wordmarks, colorways, liveries, and so on)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6986cd6e-1954-4bc6-a043-fdfb766f69d2",
                                                "sense_id": "847b9a63-8954-39f6-bbdd-a839d0045c6c",
                                                "text": "Near-synonym: labeling"
                                            },
                                            {
                                                "example_id": "84741697-4c33-4b0c-88f4-68cdb5429a9e",
                                                "sense_id": "847b9a63-8954-39f6-bbdd-a839d0045c6c",
                                                "text": "They are contractually obligated to remove all of our branding from the merchandise if they sell it to anyone else. That means they have to cut open the packages and then either sell the kitchenware in bulk or repackage it."
                                            }
                                        ]
                                    }
                                ]
                            },
