                "senses": [
                    {
                        "sense_id": "1879f2e6-dddf-3d60-8c4c-8b5d8e290151",
                        "entry_id": "c5fe064b-2e17-3ad1-9d8d-0f2edf08efb8",
                        "glosses": [
                            "S’admirer mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d24b8a7-a612-4f90-a826-782751fca20c",
                                "sense_id": "1879f2e6-dddf-3d60-8c4c-8b5d8e290151",
                                "text": "Le résultat joyeusement grotesque ! indescriptible ! S’écarquiller ! époustoufarès ! On s’entradmire ! — (Alphonse Boudard, Bleubite, La Table ronde, Paris, 1975)"
                            },
                            {
                                "example_id": "b74cd49e-0866-4db6-ae87-68a3b5b3bc1d",
                                "sense_id": "1879f2e6-dddf-3d60-8c4c-8b5d8e290151",
                                "text": "Voyez-les alors s’entradmirer, s’entrenvoyer des fleurs, voyez-les s’entrecrier au chef-d’œuvre dès que l’un ou l’autre d’entre eux a pondu son œuf tout chaud teinté si possible d’hilarante ou grave misogynie « pas méchante pour un sou », entre deux feuilles blanches ou sur un carton noir, et les avez-vous écoutés ?"
                            },
                            {
                                "example_id": "2785d912-888e-41b4-8afe-cf2fbdb8d4cf",
                                "sense_id": "1879f2e6-dddf-3d60-8c4c-8b5d8e290151",
                                "text": "Entre Merville et Lille, à certaines heures, les pare-chocs apprenaient à s’entradmirer."
                            }
                        ]
                    }
                ],
