{
    "word_family": [
        "clench"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "99b8b014-e627-3b8e-a66f-a8561b6c809a",
                    "sense_definition": "Closed or pressed together tightly, often indicating tension or anger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held a <w>clenched</w> fist during the argument.",
                            "target_lang_translations": {
                                "cs": "Během hádky držel <w>zaťatou</w> pěst."
                            }
                        },
                        {
                            "text": "She spoke through <w>clenched</w> teeth because she was so angry.",
                            "target_lang_translations": {
                                "cs": "Mluvila přes <w>zaťaté</w> zuby, protože byla tak rozzlobená."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight",
                        "firm"
                    ],
                    "antonyms": [
                        "unclenched"
                    ],
                    "common_phrases": [
                        "clenched fist",
                        "clenched teeth"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pevně sevřený nebo stisknutý, často vyjadřující napětí nebo hněv."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sevřený",
                                "target_lang_sense_clarification": "obecně pro části těla nebo předměty"
                            },
                            {
                                "target_lang_word": "zaťatý",
                                "target_lang_sense_clarification": "zejména pro pěsti nebo zuby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca058252-d4f2-3c1c-8066-79897405334d",
                    "sense_definition": "Simple past and past participle of <w>clench</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>clenched</w> his hands when he heard the bad news.",
                            "target_lang_translations": {
                                "cs": "Když uslyšel špatné zprávy, <w>sevřel</w> ruce v pěsti."
                            }
                        },
                        {
                            "text": "The athlete had <w>clenched</w> his muscles before the race started.",
                            "target_lang_translations": {
                                "cs": "Sportovec před začátkem závodu <w>zatnul</w> svaly."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb clench."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa clench (sevřít, zaťat)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sevřel",
                                "target_lang_sense_clarification": "minulý čas slovesa sevřít"
                            },
                            {
                                "target_lang_word": "zaťal",
                                "target_lang_sense_clarification": "minulý čas slovesa zaťat"
                            }
                        ]
                    }
                }
            ]
        }
