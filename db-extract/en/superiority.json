                    {
                        "translation_id": "41a3d842-19bb-4fba-a082-da0fc58b4761",
                        "source_entry_id": "b4436663-423e-3b72-b7c2-acddef4dbe5c",
                        "source_sense_description": "the state of being superior",
                        "target_lang_word": "supériorité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supériorité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                        "entry_id": "54c272ca-4291-3880-9d0b-990a926cc90d",
                                        "glosses": [
                                            "Prééminence, autorité, excellence au-dessus des autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e676b814-42af-41d5-8453-bb1238957bfa",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "Mais il était modeste au logis, il y sentait instinctivement la supériorité de sa femme, quelque jeune qu'elle fût ; […]."
                                            },
                                            {
                                                "example_id": "29ad5f1f-cbdf-4c90-b684-830edfa71e78",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "Gross-Aspern est attaqué par le général Hiller avec une étonnante vigueur et une grande supériorité de forces."
                                            },
                                            {
                                                "example_id": "87992fb7-908d-4625-9d76-288740205722",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "Elle est franchement bébête, d'ailleurs, et n'affirme sa supériorité que dans la gymnastique amoureuse. Elle excelle aux tortillements, […]."
                                            },
                                            {
                                                "example_id": "79c62594-fa5e-471e-af68-fa92138e5347",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "À noter l'insistance mise par Nadvi sur la supériorité et l'exclusivisme de l'islam vis-à-vis de toutes les autres religions et de tous les autres systèmes."
                                            },
                                            {
                                                "example_id": "a816335b-1b8c-4de8-8c31-217806a1624a",
                                                "sense_id": "a9c26b11-0fbe-380c-950d-2445ff800b5e",
                                                "text": "La supériorité militaire écrasante de l’hyperpuissance américaine lui permet certes d’organiser ses expéditions sans l’aide de personne. Mais ces opérations punitives ne peuvent fonder un nouvel ordre du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f7cdee-1f6f-35c4-9218-c40c85ce7402",
                                        "entry_id": "54c272ca-4291-3880-9d0b-990a926cc90d",
                                        "glosses": [
                                            "Sentiment d’avoir une valeur supérieure aux autres ; comportement qui découle de ce sentiment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ab106f3-3b95-4bb5-8904-2dbf4e2df80e",
                        "source_entry_id": "b4436663-423e-3b72-b7c2-acddef4dbe5c",
                        "source_sense_description": "the state of being superior",
                        "target_lang_word": "Überlegenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überlegenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "900fbcb5-3af6-329d-bb75-7046fd415789",
                                        "entry_id": "cb450b24-75f4-35ca-a7a7-561131d5da76",
                                        "glosses": [
                                            "Zustand oder Eigenschaft, in einer bestimmten Sache überlegen zu sein"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6776afbe-e362-4599-93fa-2971b71e89f4",
                                                "sense_id": "900fbcb5-3af6-329d-bb75-7046fd415789",
                                                "text": "„Daneben wird eine Schlacht gegen die Daker dargestellt, die durch die Überlegenheit der römischen Soldaten siegreich endet.“"
                                            },
                                            {
                                                "example_id": "e2f8cc0e-3abd-48ba-87a4-d070e3bb4821",
                                                "sense_id": "900fbcb5-3af6-329d-bb75-7046fd415789",
                                                "text": "„Wo sie sich die ökonomische Herrschaft erschwindelt haben, zeigen sie unter anderem ihre große Überlegenheit dadurch, daß sie den Gruß eines armen vorübergehenden Muselmanen nicht beantworten.“"
                                            },
                                            {
                                                "example_id": "ea8d6a3d-eedb-4815-a899-15a872129c3b",
                                                "sense_id": "900fbcb5-3af6-329d-bb75-7046fd415789",
                                                "text": "„Das Deprimierendste am September 1938 ist die Überlegenheit der skrupellosen (und zur Zerschlagung der Tschechoslowakei längst fest entschlossenen) Naziregierung in Deutschland.“"
                                            },
                                            {
                                                "example_id": "929200cf-676c-4bbe-b609-001d1155babf",
                                                "sense_id": "900fbcb5-3af6-329d-bb75-7046fd415789",
                                                "text": "„So wird Rauchen zum Beispiel mit Eigenschaften wie Coolness und Überlegenheit assoziiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
