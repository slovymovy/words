                        ],
                        "form": "die Habseligkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e78c717e-a595-3da8-b634-6e569eec35e1",
                        "entry_id": "270d94ae-f13b-38d6-b9e2-8fb65e5acc29",
                        "glosses": [
                            "unmittelbarer, meist geringer Besitzstand eines Menschen, Besitz zum täglichen Leben gehörig"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "e13453ae-0354-4747-bafc-d5d5c8cc4446",
                                "sense_id": "e78c717e-a595-3da8-b634-6e569eec35e1",
                                "text": "Sie rafften ihre Habseligkeiten zusammen."
                            },
                            {
                                "example_id": "0ce5ec27-18f1-4bed-a98a-44ef24f4191e",
                                "sense_id": "e78c717e-a595-3da8-b634-6e569eec35e1",
                                "text": "„Die Habseligkeiten der Sträflinge mussten zwischen den Beinen auf dem Boden gestapelt werden.“"
                            },
                            {
                                "example_id": "4d883f18-6442-4248-925c-b96553fc9a88",
                                "sense_id": "e78c717e-a595-3da8-b634-6e569eec35e1",
                                "text": "„Nachts schleichen sie sich auf die Schiffe und brechen die Schlösser der Seekisten auf, in denen die Händler ihre Habseligkeiten verstauen.“"
                            },
                            {
                                "example_id": "9b00cef5-7567-45a6-b063-66f57917df4f",
                                "sense_id": "e78c717e-a595-3da8-b634-6e569eec35e1",
                                "text": "„Seine gesamten Habseligkeiten passen in eine einzige Tasche.“"
                            },
                            {
                                "example_id": "db0d8059-caf2-47c2-bd0e-62612e397b21",
                                "sense_id": "e78c717e-a595-3da8-b634-6e569eec35e1",
                                "text": "„Mancher hatte sich nicht einmal die Mühe genommen, seine Habseligkeiten aus Kellern und Wirtschaftsgebäuden zu entfernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
