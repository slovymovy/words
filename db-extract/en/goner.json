                        "source_sense_description": "someone doomed, a hopeless case",
                        "target_lang_word": "homme mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85704d21-af9f-38f0-87d5-35037f329b8a",
                                        "entry_id": "2894aaad-57d6-36e5-b309-17d8d90cf9d8",
                                        "glosses": [
                                            "Dispositif provoquant l’arrêt d’une machine en cas de défaillance de son conducteur."
                                        ],
                                        "tags": [
                                            "Sécurité",
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075f3e0a-0f7a-4537-9424-f863eac171ae",
                                                "sense_id": "85704d21-af9f-38f0-87d5-35037f329b8a",
                                                "text": "Un dispositif homme mort est avant tout destiné à la protection des travailleurs isolés, qui sont exposés à des risques supplémentaires par rapport aux employés opérant en équipe.\nEn cas de chute, d’agression, ou de malaise, impossible pour eux de donner l’alerte, ou de stopper l’éventuelle machine qu’ils utilisent. Le dispositif homme mort va donc s’en charger à leur place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
