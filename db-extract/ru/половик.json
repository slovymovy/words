                    },
                    {
                        "form_id": "700a37ef-0dc4-4e3b-9c96-ecd94367a142",
                        "entry_id": "469f05f1-7745-3df9-a331-c2495b207a15",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "половика́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f73d645a-407a-390c-82bd-dbe1c26b891e",
                        "entry_id": "469f05f1-7745-3df9-a331-c2495b207a15",
                        "glosses": [
                            "плетёный, тканый или сшитый из разноцветных обрезков ткани узкий длинный коврик, расстилаемый на полу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62dc78b-9b9d-4210-b7f1-d3aff84f7d1b",
                                "sense_id": "f73d645a-407a-390c-82bd-dbe1c26b891e",
                                "text": "В тихих коридорах потухли матовые белые лампы, и вместо них согласно распорядку зажглись слабые голубые ночники, и всё реже за дверями слышались осторожные шажки фельдшериц на резиновых половиках коридора."
                            },
                            {
                                "example_id": "8d9fd97d-8e09-441e-8c8a-9fa16c556398",
                                "sense_id": "f73d645a-407a-390c-82bd-dbe1c26b891e",
                                "text": "Он отворил дверь и через чистенькие сени и переднюю, по чистому полотняному половику, провел меня в келью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a68389bb-d22e-4af8-b385-b565601d53a4",
                        "source_entry_id": "469f05f1-7745-3df9-a331-c2495b207a15",
                        "source_sense_id": "f73d645a-407a-390c-82bd-dbe1c26b891e",
                        "target_lang_word": "clippy mat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0192b458-084f-4af7-8896-95d99d35c952",
                        "source_entry_id": "469f05f1-7745-3df9-a331-c2495b207a15",
                        "source_sense_id": "f73d645a-407a-390c-82bd-dbe1c26b891e",
                        "target_lang_word": "carpette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carpette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c392ed32-e3cc-3182-a249-08007ad0ee55",
                                        "entry_id": "7af26e5a-f1d4-354c-8b68-934b4ba2a278",
                                        "glosses": [
                                            "Tapis mobile qui ne recouvre qu’une partie du parquet d’une chambre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e3ef9a-2b7b-4d7a-8544-3720de640037",
                                                "sense_id": "c392ed32-e3cc-3182-a249-08007ad0ee55",
                                                "text": "Il était alors plus amoureux de moi que jamais. Il prenait mes carpettes pour tapis de prière et gerçait la peau de mon poignet à force de le baiser…"
                                            },
                                            {
                                                "example_id": "fc941087-49f6-48a6-9252-20c551412c9d",
                                                "sense_id": "c392ed32-e3cc-3182-a249-08007ad0ee55",
                                                "text": "Elle ouvrit la fenêtre pour secouer la carpette où un infirmer avait laissé des traces de pas."
                                            },
                                            {
                                                "example_id": "3da579b7-114b-4abd-a12f-679d494be6a4",
                                                "sense_id": "c392ed32-e3cc-3182-a249-08007ad0ee55",
                                                "text": "Depuis Jacquart, le tissage mécanique permet la fabrication des moquettes et carpettes, du « haute laine » (ou chenille) et du « point noué mécanique »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546982b0-6521-3843-a2e5-e9618db13c41",
                                        "entry_id": "7af26e5a-f1d4-354c-8b68-934b4ba2a278",
                                        "glosses": [
                                            "Personne qui se laisse subordonner sans réagir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c33c7ebd-3dd1-43a8-b2bf-b12c2e17b593",
                                                "sense_id": "546982b0-6521-3843-a2e5-e9618db13c41",
                                                "text": "[…] ; mais enfin, Fénelon luttait contre l’autocratie royale. Et Bossuet qui était un homme rampant, vous savez, c'était une carpette à l’égard du Roi, Bossuet avait considéré que Fénelon était un homme extrêmement dangereux politiquement."
                                            },
                                            {
                                                "example_id": "81d4f14c-54fd-427a-a02f-0a89b77cb486",
                                                "sense_id": "546982b0-6521-3843-a2e5-e9618db13c41",
                                                "text": "Mince à la fin, ce n'est pas parce que ta mère est accro aux médocs et t’oblige à te tenir à carreau et que ton père est une carpette, que tu dois les laisser tomber."
                                            },
                                            {
                                                "example_id": "20b5affa-013a-479b-9a47-fb5ac1424461",
                                                "sense_id": "546982b0-6521-3843-a2e5-e9618db13c41",
                                                "text": "Quant aux libéraux, ils démontrent ces derniers jours, comme l’a si bien nommé le collègue Richard Martineau, qu’ils sont la carpette d’Ottawa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a948c921-75ab-3321-a211-bd4b8365b686",
                                        "entry_id": "7af26e5a-f1d4-354c-8b68-934b4ba2a278",
                                        "glosses": [
                                            "Drap grossier, souvent rayé, qui servait à l’emballage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "808c2654-73ac-3ae4-b36c-c4777ee9a595",
                                        "entry_id": "7af26e5a-f1d4-354c-8b68-934b4ba2a278",
                                        "glosses": [
                                            "Coiffe jadis portée par les paysannes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34b99c9-7d7f-4ebb-a41a-d3ba5a5f9176",
                                                "sense_id": "808c2654-73ac-3ae4-b36c-c4777ee9a595",
                                                "text": "C’était la première fois que nous la voyions travailler aux champs. Sa carpette me dérobait son visage (jamais non plus je ne lui avais vu cette coiffe paysanne)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbc9045a-a1f5-44d7-ab32-161d95f4f0fa",
                        "source_entry_id": "469f05f1-7745-3df9-a331-c2495b207a15",
                        "source_sense_id": "f73d645a-407a-390c-82bd-dbe1c26b891e",
                        "target_lang_word": "paillasson",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paillasson",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efa875d6-d795-34ec-99bb-8e8c801f242c",
                                        "entry_id": "8a5fdd11-f02f-34ed-bffc-6282606f1374",
                                        "glosses": [
                                            "Natte de paille, tapis de fibre végétale ou synthétique, que l’on met à l’entrée d’une maison ou d’un appartement pour permettre de s’essuyer les pieds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d4b836-d2c7-4099-81a8-2e18c73478be",
                                                "sense_id": "efa875d6-d795-34ec-99bb-8e8c801f242c",
                                                "text": "Te souviens-tu des paillassons que tu changeais d’étage dans les maisons ou nous allions ? J’avais beau te gronder chaque fois, tu recommençais toujours."
                                            },
                                            {
                                                "example_id": "b64ac9aa-8847-4742-9210-8b130ea29ff5",
                                                "sense_id": "efa875d6-d795-34ec-99bb-8e8c801f242c",
                                                "text": "Même quand elle fut pour partir, comme déjà elle était sur le paillasson, avec au bras son parapluie, et ses petites affaires dans un panier, et son porte-monnaie dans sa poche de jupon, […]"
                                            },
                                            {
                                                "example_id": "7e78d5a2-e214-4f4b-a78d-d15a06d3ab75",
                                                "sense_id": "efa875d6-d795-34ec-99bb-8e8c801f242c",
                                                "text": "J’ai toujours été sidéré par le signifiant des halls d’immeubles, particulièrement les paillassons. Le concept du paillasson. Ça n’a l’air de rien, mais c’est très important le paillasson. Quelle grandeur ! Quelle épaisseur ! Le grand paillasson s’affirme large dans l’immeuble chic, et il nous emmène mine de rien sur le tapis qui recouvre l’escalier. C’est là que ça se joue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa10724e-9305-3243-87ba-34602cc611a4",
                                        "entry_id": "8a5fdd11-f02f-34ed-bffc-6282606f1374",
                                        "glosses": [
                                            "Paillasse peu épaisse."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f9de2b6-365f-4d31-bdef-d979e7118be1",
                                                "sense_id": "fa10724e-9305-3243-87ba-34602cc611a4",
                                                "text": "Les charpoys les plus communs et les plus durs, ou même un simple paillasson, remplacent les luxueux coussins et les matelas bien rembourrés sur lesquels les Luknois reposent ordinairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22dae0bd-a180-3134-87d8-7cdd34ae225c",
                                        "entry_id": "8a5fdd11-f02f-34ed-bffc-6282606f1374",
                                        "glosses": [
                                            "Endroit ou chose qui a l’apparence d’un tapis servant à s’essuyer les pieds."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c984eef6-05bd-4241-beee-400c0e9ecc8b",
                                                "sense_id": "22dae0bd-a180-3134-87d8-7cdd34ae225c",
                                                "text": "Elles entrèrent dans le bois, et au bout d’une demi-heure, nous arrivions dans une grande prairie dont le soleil avait fait un véritable paillasson"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087b807a-c5d9-30c2-960b-1d8e670f0a61",
                                        "entry_id": "8a5fdd11-f02f-34ed-bffc-6282606f1374",
                                        "glosses": [
                                            "Tapis de joncs servant à faire sécher le fromage. → voir paillisse"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66611096-7a1f-389f-8cb5-08c905a0c849",
                                        "entry_id": "8a5fdd11-f02f-34ed-bffc-6282606f1374",
                                        "glosses": [
                                            "Sorte de claie faite avec de la paille longue, étendue et attachée sur des perches, qui sert à garantir de la gelée les couches et les espaliers ; ou que l’on met sur les serres pour les garantir du soleil et des intempéries."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1116ca1-9d6c-407f-a563-c2744f908844",
                                                "sense_id": "66611096-7a1f-389f-8cb5-08c905a0c849",
                                                "text": "— Quand même ils seraient arrivés avant la grêle, jamais ils n’auront eu le temps de couvrir les panneaux avec les paillassons ; tout va être perdu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f116094-9d4b-3588-b3e4-efe64e73488e",
                                        "entry_id": "8a5fdd11-f02f-34ed-bffc-6282606f1374",
                                        "glosses": [
