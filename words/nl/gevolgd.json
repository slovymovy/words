                    "sense_id": "3c716661-35c9-317e-aa26-04fc9387c2d4",
                    "sense_definition": "verwijst naar een weg, route of methode die men gekozen of genomen heeft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "route_method",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gevolgde</w> weg was niet de snelste, maar wel de mooiste route door de bergen.",
                            "target_lang_translations": {
                                "en": "The path <w>taken</w> was not the fastest, but it was the most beautiful route through the mountains.",
                                "ru": "<w>Выбранный</w> путь не был самым быстрым, но зато это был самый красивый маршрут через горы.",
                                "pl": "<w>Obrana</w> droga nie była najszybsza, ale za to najpiękniejsza przez góry."
                            }
                        },
                        {
                            "text": "De directie was niet tevreden over de <w>gevolgde</w> procedure tijdens het project.",
                            "target_lang_translations": {
                                "en": "The management was not satisfied with the procedure <w>followed</w> during the project.",
                                "ru": "Руководство было недовольно <w>принятой</w> процедурой в ходе проекта.",
                                "pl": "Zarząd nie był zadowolony z <w>zastosowanej</w> procedury podczas projektu."
                            }
                        }
                    ],
                    "synonyms": [
