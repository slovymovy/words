            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dfb7a4b1-0a59-3c21-b9ca-607969bd5e1d",
                    "sense_definition": "Personne noble titulaire d'une baronnie, ou portant le titre de noblesse intermédiaire entre vicomte et chevalier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>baron</w> a invité toute la noblesse de la province dans son château restauré."
                        },
                        {
                            "text": "Il a hérité du domaine familial et de son titre de <w>baron</w> après le décès de son père."
                        }
                    ],
                    "common_phrases": [
                        "titre de baron"
                    ]
                },
                {
                    "sense_id": "2895941d-0ab1-3c0e-84f6-1dd30e9d6ab3",
                    "sense_definition": "Personnalité influente et puissante qui exerce une autorité dominante dans un secteur particulier.",
