                                "target_senses": [
                                    {
                                        "sense_id": "34abfc46-558f-3641-befc-1847ef00d4b3",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "The act of contradicting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b298af-8fa7-4ca9-8ff4-00c2b05fbdaf",
                                                "sense_id": "34abfc46-558f-3641-befc-1847ef00d4b3",
                                                "text": "His contradiction of the proposal was very interesting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b32e89b-f168-3622-a4d8-e5bb396917d2",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "A statement that contradicts itself, i.e., a statement that claims that the same thing is true and that it is false at the same time and in the same senses of the terms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70faaf4b-d597-4e44-b13a-634d0b058895",
                                                "sense_id": "3b32e89b-f168-3622-a4d8-e5bb396917d2",
                                                "text": "There is a contradiction in Clarence Page's statement that a woman should have the right to choose and decide for herself whether to have an abortion and at the same time she should not have that right."
                                            },
                                            {
                                                "example_id": "4a55e7a6-a594-48a3-81ca-d7fbe9104072",
                                                "sense_id": "3b32e89b-f168-3622-a4d8-e5bb396917d2",
                                                "text": "There is a contradiction in what you say: she can't be both married and single."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58a3754-16dd-31c2-8cd2-5cc699f46a88",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "A logical inconsistency among two or more elements or propositions."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f36b779-98bd-461d-bdd4-15518efec8b9",
                                                "sense_id": "f58a3754-16dd-31c2-8cd2-5cc699f46a88",
                                                "text": "Marx believed that the contradictions of capitalism would lead to socialism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee86b40-f424-3f6f-8f9a-e1bd02055dc3",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "A proposition that is false for all values of its propositional variables or Boolean atoms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
