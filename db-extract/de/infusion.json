                                        "sense_id": "7f1525e2-eb3d-3574-9412-2030edeefa93",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "A product consisting of a liquid which has had other ingredients steeped in it to extract useful qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9850d5f0-2bda-49f2-8982-e8e9ff85347a",
                                                "sense_id": "7f1525e2-eb3d-3574-9412-2030edeefa93",
                                                "text": "An extract of rooibos and chamomile makes a refreshing infusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ad15b6-d859-34ad-a72a-3956f0d06492",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The act of steeping or soaking a substance in liquid so as to extract medicinal or herbal qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd77a647-38e6-3a04-94bc-a7c862ae65f7",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The act of installing a quality into a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3279206-7a24-3732-b6ec-d69e2ad6341c",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "A giving of money or other resources, typically a large amount, to an organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "543393ab-65e4-44bd-a467-a5a9860e4983",
                                                "sense_id": "d3279206-7a24-3732-b6ec-d69e2ad6341c",
                                                "text": "He made a number of other changes at the Transit Police, including revamping audio equipment, moving the force to nine-millimeter semiautomatic weapons, and designing new uniforms. These changes were all part of a $40 million infusion into the Transit Police in 1990 from Governor Mario Cuomo."
                                            },
                                            {
                                                "example_id": "ec32ea49-090d-463e-a5f8-2b196a4d8363",
                                                "sense_id": "d3279206-7a24-3732-b6ec-d69e2ad6341c",
                                                "text": "[...] but in the verity of extolment / I take him to be a soul of great article and his infusion / of such dearth and rareness as, to make true diction of / him, his semblable in his mirror, and who else would / trace him, his umbrage, nothing more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6589ce0-8257-3dd5-aaf6-46ce414a4aaa",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The act of dipping into a fluid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b11066c-68df-366c-9864-735d7104cb8a",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The administration of liquid substances directly into a vein for medical purposes; perfusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1327eb01-d501-4187-a4c8-df9a65fa69dc",
                        "source_entry_id": "6ead9c68-ba3c-3a2f-80f5-af62495bfdc0",
                        "source_sense_id": "3dc22ad8-496d-32c1-a8b7-f72351a4ce27",
                        "source_sense_description": "Einführen von Flüssigkeit in den Körper",
                        "target_lang_word": "perfusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                        "entry_id": "5eaf98a2-f9c6-3865-9938-071f16e53908",
                                        "glosses": [
                                            "Introduction lente et continue d’un médicament ou de sang dans un organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7c1fd2-22c9-4765-82bf-3ffc671716cc",
                                                "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                                "text": "On retira les perfusions de ses bras squelettiques posés sagement sur les draps le long de son corps momifié, on arracha le tuyau d’alimentation de son nez, et son cœur vaillant ne se fit pas prier. En trois secondes, l’affaire – la grande – était réglée."
                                            },
                                            {
                                                "example_id": "fb1cdf8d-1bbf-4bcd-b18c-7ec4ec3b5338",
                                                "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                                "text": "Élise, infirmière canadienne plus têtue qu'une chèvre et plus généreuse qu'un champ de coquelicots, s'occupa de la perfusion."
                                            },
                                            {
                                                "example_id": "e56b9bf2-cef9-4adc-be7d-a5fe18f28e1e",
                                                "sense_id": "806b2929-0a7e-3d94-bdc6-4d8df0fd1b47",
                                                "text": "La perfusion à domicile (PAD) permet l’administration d’un grand nombre de spécialités thérapeutiques ainsi que de produits sanguins labiles : la voie d’abord peut être centrale ou périphérique en fonction des produits ; les durées de traitement et les fréquences d’administration peuvent être très différentes selon les pathologies et les traitements concernés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f463b868-78c2-394e-abfc-8183e0deb62d",
                                        "entry_id": "5eaf98a2-f9c6-3865-9938-071f16e53908",
                                        "glosses": [
                                            "Dispositif permettant la perfusion ; matériel de perfusion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49627e34-ea9f-4ab7-862d-94aeee534804",
                                                "sense_id": "f463b868-78c2-394e-abfc-8183e0deb62d",
                                                "text": "— Je vais commencer par t'administrer du Valium pour que tu te détendes, a annoncé la vétérinaire comme elle posait une perfusion sur mon bras sans puce."
                                            },
                                            {
                                                "example_id": "2417fdac-585d-4676-9e91-9442bbf36753",
                                                "sense_id": "f463b868-78c2-394e-abfc-8183e0deb62d",
                                                "text": "Comme chaque matin, l’infirmière est venue changer ma perfusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f0d1db-8434-3492-a25a-92691390f824",
                                        "entry_id": "5eaf98a2-f9c6-3865-9938-071f16e53908",
                                        "glosses": [
                                            "Processus qui alimente un organe en oxygène et nutriments nécessaires à son métabolisme, sa saine activité biochimique au sein de l'organisme. En particulier, alimentation d'un organe en sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6afad4a0-88cf-49ba-b419-e88dc9ac563f",
                                                "sense_id": "32f0d1db-8434-3492-a25a-92691390f824",
                                                "text": "Lorsque, en conditions normales de pesanteur, la pression d’éjection systolique (la « tension artérielle ») est de 12 cmHg, la pression de perfusion cérébrale du sujet assis ou debout est de 12 – 2,25 = 9,75 cmHg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
