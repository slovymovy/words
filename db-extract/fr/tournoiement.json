                        "form": "tournoiements"
                    },
                    {
                        "form_id": "065c830a-2c60-443d-8cbd-f4ec0e93a055",
                        "entry_id": "6939e08c-618d-3424-b2d1-6ff468ff8a15",
                        "tags": [],
                        "form": "tournoîment"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c88f13f-2438-39ef-9dd5-c4edb168af08",
                        "entry_id": "6939e08c-618d-3424-b2d1-6ff468ff8a15",
                        "glosses": [
                            "Action de ce qui tournoie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2287c13e-08e1-4e6e-8837-318c38df13ff",
                                "sense_id": "4c88f13f-2438-39ef-9dd5-c4edb168af08",
                                "text": "Le soleil, la lune et les autres astres, qui se formaient par eux-mêmes, étaient ensuite enveloppés par le monde, ainsi évidemment que tout ce qu’il préserve, mais dès le début ils se façonnaient et s’accroissaient (de la même façon que la terre et la mer) grâce à des accrétions et des tournoiements de fines particules."
                            },
                            {
                                "example_id": "d1a2db42-ccc3-4940-a65b-4cf591a516d1",
                                "sense_id": "4c88f13f-2438-39ef-9dd5-c4edb168af08",
                                "text": "La vallée à ses pieds était emplie d’un tournoiement de lumière blonde et la côte de sapins, noyée dans une poussière d’or, semblait reculée jusqu’au fond extrême de l’horizon."
                            },
                            {
                                "example_id": "e8260ef5-22ae-4eb1-a3d9-3b5e79d523de",
                                "sense_id": "4c88f13f-2438-39ef-9dd5-c4edb168af08",
                                "text": "Il se leva de nouveau et pivota deux ou trois fois sur ses talons, petit tournoiement qu’il fit suivre d’une esquisse de danse qui tenait du cancan et de la gigue."
                            },
                            {
                                "example_id": "f1beaf32-d98e-4069-ae8e-f2d406fe236d",
                                "sense_id": "4c88f13f-2438-39ef-9dd5-c4edb168af08",
                                "text": "Elle se dressa comme dans les scènes les plus pathétiques de Bérénice, avec ce noble tournoiement de cuisses qui repousse à la fois le siège et la draperie de la robe, en amorçant une déambulation majestueuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
