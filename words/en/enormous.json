                        "zh": [
                            {
                                "target_lang_word": "滔天",
                                "target_lang_sense_clarification": "形容罪恶极大，如滔天大罪"
                            },
                            {
                                "target_lang_word": "极度邪恶",
                                "target_lang_sense_clarification": "描述行为极其恶劣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50d264bd-a8f6-3794-8469-ba634863cb23",
                    "sense_definition": "Deviating from the norm; unusual or extraordinary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "normality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist noted an <w>enormous</w> deviation in the experimental results.",
                            "target_lang_translations": {
                                "ru": "Ученый отметил <w>аномальное</w> отклонение в результатах эксперимента.",
                                "tr": "Bilim insanı, deney sonuçlarında <w>olağandışı</w> bir sapma fark etti.",
                                "zh": "科学家注意到实验结果中存在<w>异常</w>的偏差。"
                            }
                        },
                        {
                            "text": "His behavior was considered <w>enormous</w> and strange by the local villagers.",
                            "target_lang_translations": {
                                "ru": "Местные жители считали его поведение <w>ненормальным</w> и странным.",
                                "tr": "Onun davranışı köylüler tarafından <w>anormal</w> ve garip karşılandı.",
                                "zh": "当地村民认为他的行为既<w>异常</w>又古怪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Refers to the etymological meaning 'out of the norm'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняющийся от нормы; необычный или экстраординарный.",
                        "tr": "Normdan sapan; alışılmadık veya olağanüstü.",
                        "zh": "偏离常态；不同寻常或非凡的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненормальный",
                                "target_lang_sense_clarification": "выходящий за рамки нормы"
                            },
                            {
