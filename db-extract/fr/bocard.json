                ],
                "senses": [
                    {
                        "sense_id": "173b76df-41e7-3891-91e5-f727fc6da6fe",
                        "entry_id": "75e01349-834a-3b14-838a-3abc47eab152",
                        "glosses": [
                            "Machine au moyen de laquelle on écrase le minerai ou les vieilles pièces de fonte avant de le fondre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88359b89-8453-46e0-8d75-cf55572efd4b",
                                "sense_id": "173b76df-41e7-3891-91e5-f727fc6da6fe",
                                "text": "Les bocarts sont fréquemment employés dans le voisinage des mines métalliques pour réduire en poudre les minerais qui contiennent des parties non métalliques ou gangues, ce qui permet ensuite de les débarrasser facilement de ces gangues."
                            },
                            {
                                "example_id": "fa353fbe-fa9a-4cac-a85e-6909fb219806",
                                "sense_id": "173b76df-41e7-3891-91e5-f727fc6da6fe",
                                "text": "Le bocard est pourvu d’un papillon qui permet d’étrangler l’arrivée de vapeur sous le piston sans réduire la quantité admise au-dessus."
                            },
                            {
                                "example_id": "06f8e975-343d-4df0-83ff-6b756f98a94e",
                                "sense_id": "173b76df-41e7-3891-91e5-f727fc6da6fe",
                                "text": "Le Roi était vêtu d'un habit de bocard d'or enrichi d'une broderie d'or & garni de boutons de damans son manteau était de points d'Espagne d'or."
                            }
                        ]
                    }
                ],
