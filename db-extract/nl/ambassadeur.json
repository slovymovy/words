                                        "entry_id": "b370db82-863e-306d-a95e-8bb7955a0198",
                                        "glosses": [
                                            "die oberste diplomatische Vertreterin eines Staates im Ausland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e92dc1-a088-425f-83c6-54e99e852022",
                                                "sense_id": "232ecc91-37c6-34b2-a775-4f87e608195f",
                                                "text": "Anna möchte Botschafterin von Kanada werden."
                                            },
                                            {
                                                "example_id": "9a466c27-f458-44dc-8d82-23f1dd3a96f7",
                                                "sense_id": "232ecc91-37c6-34b2-a775-4f87e608195f",
                                                "text": "„In seine letzten Schwingungen hinein sprach die Botschafterin Vietnams ein Grußwort.“"
                                            }
