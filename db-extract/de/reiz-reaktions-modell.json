                        "sense_id": "a2651975-60a8-35d7-80c9-b365dd5e0e10",
                        "entry_id": "a3733538-f626-3206-9e94-60455b44a8bc",
                        "glosses": [
                            "Modell für menschliches oder tierisches Verhalten, das Verhalten aufgrund von Reiz und Reaktion zu erklären versucht. Dieses Modell spielt auch in der Linguistik eine Rolle."
                        ],
                        "tags": [
                            "speziell Behaviorismus"
                        ],
                        "examples": [
                            {
                                "example_id": "eb497ada-5a31-4663-8558-813c6da12e5c",
                                "sense_id": "a2651975-60a8-35d7-80c9-b365dd5e0e10",
                                "text": "Besonders bekannt für Untersuchungen auf der Grundlage des Reiz-Reaktions-Modells sind die Pawlowschen Hunde."
                            },
                            {
                                "example_id": "d8a510c8-5ba9-437c-8efd-7858911743d9",
                                "sense_id": "a2651975-60a8-35d7-80c9-b365dd5e0e10",
                                "text": "In der Linguistik wurde versucht, die Bedeutung sprachlicher Ausdrücke ausschließlich mittels der beobachtbaren Größen Reiz (Stimulus) und Reaktion (Response) zu beschreiben."
                            }
                        ],
