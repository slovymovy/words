                "senses": [
                    {
                        "sense_id": "0485728b-2105-34fa-be53-29a09af1e9d6",
                        "entry_id": "98b5bffe-9760-34a0-87a6-217063828ece",
                        "glosses": [
                            "Variante de fruste."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6ac06193-f181-43d6-9d9f-a3b30bdd86c2",
                                "sense_id": "0485728b-2105-34fa-be53-29a09af1e9d6",
                                "text": "Il vivait de façon très frustre."
                            },
                            {
                                "example_id": "90ff3d5c-bb71-4ffe-8d13-509f9b464abc",
                                "sense_id": "0485728b-2105-34fa-be53-29a09af1e9d6",
                                "text": "En aucun cas, on ne peut concevoir que le brassage aléatoire des composants élémentaires du vivant puisse engendrer un organisme, même très frustre, tel que nous le connaissons."
                            },
                            {
                                "example_id": "5748e0a7-cb1f-404a-abef-f2b1cf0bf510",
                                "sense_id": "0485728b-2105-34fa-be53-29a09af1e9d6",
                                "text": "Il reproche à je ne sais quels écrivains de ne plus savoir le français et d’écrire « friche » où il faudrait « guéret » ; – mais lui écrit « opprobe » et « frustre »."
                            }
                        ]
                    }
                ],
