                ],
                "translations": [
                    {
                        "translation_id": "14be2efa-6465-438c-8690-09be130e496f",
                        "source_entry_id": "e1c5ad7f-9123-3484-bf1a-f1bca21c83d0",
                        "target_lang_word": "monster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57a551b1-3862-3b52-974e-d31e71a060e0",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A terrifying and dangerous creature, especially one of an imaginary or mythical kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ef43ba-3b9a-484a-a1e0-23497cdbb080",
                                                "sense_id": "57a551b1-3862-3b52-974e-d31e71a060e0",
                                                "text": "O, 'twas a din to fright a monster's ear,/ to make an earthquake."
                                            },
                                            {
                                                "example_id": "b9e75d4b-64ca-4ff5-ae75-a498322081d8",
                                                "sense_id": "57a551b1-3862-3b52-974e-d31e71a060e0",
                                                "text": "[T]he monſter [sc. a tiger], rouſed by the noiſe, ſtarted forward, preſented ſuch a viſage of horror, and raiſed ſuch a hideous roar, that the hearts of the bold were contracted, and the nerves of the valiant unſtrung."
                                            },
                                            {
                                                "example_id": "496fc21c-758d-4168-ae28-fed8e345eef8",
                                                "sense_id": "57a551b1-3862-3b52-974e-d31e71a060e0",
                                                "text": "He caught Grendel's right hand, and still without rising from his bed, stopped the monster's onrush."
                                            },
                                            {
                                                "example_id": "f4c17499-2553-4249-89bd-d98f757cbe22",
                                                "sense_id": "57a551b1-3862-3b52-974e-d31e71a060e0",
                                                "text": "His origin amongst monsters and man-eaters signals the play's recurrent concerns with monstrification, with eating others or being eaten by them, and with issues of specularity […]"
                                            },
                                            {
                                                "example_id": "8874c565-266b-4e30-93f4-9cf149a2ad35",
                                                "sense_id": "57a551b1-3862-3b52-974e-d31e71a060e0",
                                                "text": "“My flesh was not for feasting on,\nthere would be no monsters gnawing and gloating\nover their banquet at the bottom of the sea.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9938e31b-abfa-307f-87e1-344203f15bec",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A bizarre or whimsical creature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb599390-fb0c-4ae0-8e50-3c222e638f46",
                                                "sense_id": "9938e31b-abfa-307f-87e1-344203f15bec",
                                                "text": "The children decided Grover was a cuddly monster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "229f2f81-5d67-3e2f-9d5d-0820d6663e09",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A cruel, heartless, or antisocial person, especially a criminal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1884da8-cdff-487a-996a-372c1cacd35d",
                                                "sense_id": "229f2f81-5d67-3e2f-9d5d-0820d6663e09",
                                                "text": "Get away from those children, you monster!"
                                            },
                                            {
                                                "example_id": "f5f953cf-1828-42c5-bd5d-8e209510306b",
                                                "sense_id": "229f2f81-5d67-3e2f-9d5d-0820d6663e09",
                                                "text": "I'm not a monster, Tom, well, technically I am / I guess I am..."
                                            },
                                            {
                                                "example_id": "70b645c2-0c53-4a19-ae2c-696e52e25b2f",
                                                "sense_id": "229f2f81-5d67-3e2f-9d5d-0820d6663e09",
                                                "text": "My young children leave their art everywhere. I find most of it on the floor. […] Eventually, I started throwing it all away. Perhaps I am a monster."
                                            },
                                            {
                                                "example_id": "b74e45e6-0533-4d3e-a325-eaf53518a002",
                                                "sense_id": "229f2f81-5d67-3e2f-9d5d-0820d6663e09",
                                                "text": "\"Because of this monster, Jayme won't have her mom and dad at her dance recitals,\" Mike Closs, Jayme's uncle, said in court. Closs' aunt Jennifer Smith said the family was satisfied with the sentence and knew it would give Jayme peace."
                                            },
                                            {
                                                "example_id": "ba40d181-44cc-43f6-b6b5-304066bfa4ed",
                                                "sense_id": "229f2f81-5d67-3e2f-9d5d-0820d6663e09",
                                                "text": "So go and tell your friends that I'm a fucking monster / Sugar, spice and torture / Do it for the culture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64b476c0-6824-36c6-b7eb-770a53f0b0d1",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A deformed animal or person (especially, a severely deformed one); in previous centuries often taken as an ill omen at the time of its birth. (Offensive when applied to humans in modern usage.)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "737bbc1e-dd1c-4dda-ae68-6e0922f027db",
                                                "sense_id": "64b476c0-6824-36c6-b7eb-770a53f0b0d1",
                                                "text": "The villagers were worried because the weather had been strange and several monsters had been born among the flocks and people."
                                            },
                                            {
                                                "example_id": "d1759a1f-115e-4b4e-b139-6c050e226f57",
                                                "sense_id": "64b476c0-6824-36c6-b7eb-770a53f0b0d1",
                                                "text": "Deducting then these cases, we have a large proportion of imperfect foetuses, which belonged to twin conceptions, and in which, therefore, the circulation of the monster may have essentially depended on that of the sound child."
                                            },
                                            {
                                                "example_id": "8f68bafd-7319-4d8b-bdc1-6bbbf73e5f16",
                                                "sense_id": "64b476c0-6824-36c6-b7eb-770a53f0b0d1",
                                                "text": "Cases of twins developed from one ovum, where one twin flourishes at the expense of its less fortunate partner, are not by any means uncommonly met with in veterinary practice. This is evidenced by the fairly frequent descriptions in veterinary periodicals of so-called \"moles.\" It is not, therefore, with the idea of describing any monster of startling newness that I am tempted to record the anatomical peculiarities of one such anomaly; but rather because \"moles,\" as described most commonly in veterinary journals, are viewed from the exterior only; their inner organisation being, for the most part, either ignored entirely, or treated of in a very cavalier manner. No doubt the external form and semblance of any monster is a matter of interest, but alone it is not satisfying; nor, indeed, is it always a trustworthy indication of the most important peculiarities of the organism. The outer architecture of a monster may be entirely misleading if taken too implicitly as a reflex of the internal furnishings. Especially is this the more likely to be the case when the malformation is great."
                                            },
                                            {
                                                "example_id": "119202e6-01dc-4756-80c8-04a32c17bdfe",
                                                "sense_id": "64b476c0-6824-36c6-b7eb-770a53f0b0d1",
                                                "text": "\"Periodically, storms would bring the creeping death to the valley - drifting clouds of radio-active dust - and men would sicken and die and women give birth to monsters.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51251c09-2435-3899-a173-6ff593fc40a1",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A badly behaved person, especially a child; a brat."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10b6b1b0-9ba0-4f86-8641-655b9166fea3",
                                                "sense_id": "51251c09-2435-3899-a173-6ff593fc40a1",
                                                "text": "Sit still, you little monster!"
                                            },
                                            {
                                                "example_id": "68d08196-1bb5-46a2-9537-041c4a187a9c",
                                                "sense_id": "51251c09-2435-3899-a173-6ff593fc40a1",
                                                "text": "The rest of the day he heard the children playing kick-the-can, hide-and-seek, Over-Annie-Over, jacks, tops, mibs, and the sound of the little monsters in every shrub and shadow would not let him rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8476ad6a-7398-3e7a-8d41-bb5ab62f560e",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "Something very or unusually large."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd1d8f71-468c-417d-b18e-672e75c55208",
                                                "sense_id": "8476ad6a-7398-3e7a-8d41-bb5ab62f560e",
                                                "text": "Have you seen those powerlifters on TV? They're monsters."
                                            },
                                            {
                                                "example_id": "d4beaa3e-d9fd-4493-8d97-7e1e98ec1d88",
                                                "sense_id": "8476ad6a-7398-3e7a-8d41-bb5ab62f560e",
                                                "text": "Although she, for many years had waged continual war against rheumatism, her pleasant face shone like the full moon from under the white head-gear, while she had protected herself against any possible attack of the enemy by a multiplicity of petticoats and jackets; and as an outer fortification she had put on a monster of a frieze cloak."
                                            },
                                            {
                                                "example_id": "124ddf29-85c1-46bd-8e83-29c37312ddfc",
                                                "sense_id": "8476ad6a-7398-3e7a-8d41-bb5ab62f560e",
                                                "text": "The blacks had faded into the jungle before the weak eyes of the monster had fallen upon any of them, but now he caught the sound of their retreat, and, amid a terrific crashing of underbrush and branches, he charged in the direction of the noise."
                                            },
                                            {
                                                "example_id": "8a79e3da-1603-45b0-8376-a7f4e2d95a93",
                                                "sense_id": "8476ad6a-7398-3e7a-8d41-bb5ab62f560e",
                                                "text": "Ashley: Look at the size of that ship!\nKaidan: The Ascension. Flagship of the Citadel fleet.\nJoker: Well, size isn't everything.\nAshley: Why so touchy, Joker?\nJoker: I'm just saying you need firepower, too.\nAshley: Look at that monster! It's main gun could rip through the barriers on any ship in the Alliance fleet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b65cd6-236b-3874-8091-a7769e5040d4",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A prodigy; someone very talented in a specific domain."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e25c81-4fb7-4d15-9d0a-393be029564f",
                                                "sense_id": "27b65cd6-236b-3874-8091-a7769e5040d4",
                                                "text": "That dude playing guitar is a monster."
                                            },
                                            {
                                                "example_id": "66b6a8ce-2a35-4e64-9c2a-af83965e9c3f",
                                                "sense_id": "27b65cd6-236b-3874-8091-a7769e5040d4",
                                                "text": "He was a party monster. Able to drink and drug just about any member of the Fleetwood Mac family under the table, he did so with regularity and charm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92361af0-6451-3a0c-89fa-a4fa5aaf6ebf",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A non-player character that player(s) fight against in role-playing games; a mob"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfe24c86-6a54-322d-a03b-d3c7a10cb4be",
                                        "entry_id": "d11ba1b5-9673-322a-b70d-42cd49eac42d",
                                        "glosses": [
                                            "A disabled person."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "monster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ec02be1-1551-311f-b18c-a4dcf0c60d24",
                                        "entry_id": "1618ff4e-0387-3aa5-8289-01c9ab0a3194",
                                        "glosses": [
                                            "Very large; worthy of a monster."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6fc2129-4c7e-434b-88af-f6f5107fa85b",
                                                "sense_id": "3ec02be1-1551-311f-b18c-a4dcf0c60d24",
                                                "text": "How do you get more monster than a monster truck? You build a monster tank."
                                            },
                                            {
                                                "example_id": "4bed2b05-56eb-4849-bb0f-a2e009914658",
                                                "sense_id": "3ec02be1-1551-311f-b18c-a4dcf0c60d24",
                                                "text": "He has a monster appetite."
                                            },
                                            {
                                                "example_id": "b7834a96-62a8-4bad-b423-8fcc376d0c4f",
                                                "sense_id": "3ec02be1-1551-311f-b18c-a4dcf0c60d24",
                                                "text": "I turned to Jack and said, \"It's supposed to be monster.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff53bba4-7899-383a-8cec-1262912e9153",
                                        "entry_id": "1618ff4e-0387-3aa5-8289-01c9ab0a3194",
                                        "glosses": [
                                            "Great; very good; excellent."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b597d8d-5f3b-4fd8-8bc4-d046295796b9",
                                                "sense_id": "ff53bba4-7899-383a-8cec-1262912e9153",
                                                "text": "“You did great today,” I told Josh. “You were monster.” “yeah,” he said. “I was monster. Thank you, Charlie.”"
                                            },
                                            {
                                                "example_id": "d90fdbb7-56ff-4fe2-941d-5a542da03523",
                                                "sense_id": "ff53bba4-7899-383a-8cec-1262912e9153",
                                                "text": "Seconds later Nano’s monster throw-in from the left was recycled to the wing-back and, when he produced the most delicious of deliveries, the totally unmarked Lopes drilled home from six yards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "200dd18a-b7c4-3b0d-8ceb-c6748b877419",
                                        "entry_id": "a8a11395-43aa-3a01-bd5d-47c0adf7a058",
                                        "glosses": [
                                            "To make into a monster; to categorise as a monster; to demonise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "109d1f97-fc10-4252-8547-0ac7da6b4622",
                                                "sense_id": "200dd18a-b7c4-3b0d-8ceb-c6748b877419",
                                                "text": "Animals in our world have been monstered by human action as much as the free beasts of the pre-lapsarian state were monstered by the primal crime."
                                            },
                                            {
                                                "example_id": "d2789637-3c18-43bc-a33d-6e9b9db05faf",
                                                "sense_id": "200dd18a-b7c4-3b0d-8ceb-c6748b877419",
                                                "text": "A Tale of Two Cities and Great Expectations feature four cases of women monstered by passion. Madame Defarge is ‘a tigress’, Mrs Joe a virago, Molly (Estella′s criminal mother) ‘a wild beast tamed’ and Miss Havisham a witch-like creature, a ghastly combination of waxwork and skeleton."
                                            },
                                            {
                                                "example_id": "36ada86d-36b0-4457-ba25-043d274aeeea",
                                                "sense_id": "200dd18a-b7c4-3b0d-8ceb-c6748b877419",
                                                "text": "The community forgives: this is in deep contrast to offenders that emerge from prison and remain stigmatised and monstered, often unable to get work or housing."
                                            },
                                            {
                                                "example_id": "15dfb7be-993b-4f0d-9140-c1141b4f4346",
                                                "sense_id": "200dd18a-b7c4-3b0d-8ceb-c6748b877419",
                                                "text": "Demonizing or monstering other groups has even become part of the cycle of American politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87a2fd0d-eef6-351f-aef3-e8a653c9471a",
                                        "entry_id": "a8a11395-43aa-3a01-bd5d-47c0adf7a058",
                                        "glosses": [
                                            "To behave as a monster to; to terrorise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36782c36-73a1-4b6f-9b08-2f415356e2ed",
                                                "sense_id": "87a2fd0d-eef6-351f-aef3-e8a653c9471a",
                                                "text": "In 2002, American interrogators on the ground in Afghanistan developed a technique they called “monstering.” The commander “instituted a new rule that a prisoner could be kept awake and in the booth for as long as an interrogator could last.” One “monstering” interrogator engaged in this for thirty hours.¹⁷⁷"
                                            },
                                            {
                                                "example_id": "f522ae94-f9dc-4ddb-a89c-515f6bda745f",
                                                "sense_id": "87a2fd0d-eef6-351f-aef3-e8a653c9471a",
                                                "text": "The interrogators asked members of the 377th Military Police Company to help them with monstering, and the MPs complied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a4f398d-9261-3290-aecf-45fee6a6e910",
                                        "entry_id": "a8a11395-43aa-3a01-bd5d-47c0adf7a058",
                                        "glosses": [
                                            "To harass."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baf92249-5089-40e1-b8c7-8e78ac1ce329",
                                                "sense_id": "3a4f398d-9261-3290-aecf-45fee6a6e910",
                                                "text": "Andy Roddick has been monstered by both Federer and Nadal and suffered a 6-2 7-5 7-5 semi-final loss at the hands of the Swiss champion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8818d31-60ef-3dad-bcff-b7ee5e3d6273",
                                        "entry_id": "a8a11395-43aa-3a01-bd5d-47c0adf7a058",
                                        "glosses": [
                                            "To play (a series of) non-player characters as directed, without having the responsibility of organising the game itself; generally not limited to playing literal monsters or hostile combatants."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97a6514a-3ab8-4ac7-8062-fcff36152b9d",
                                                "sense_id": "f8818d31-60ef-3dad-bcff-b7ee5e3d6273",
                                                "text": "Are you monstering that event?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2657a775-6c76-34b8-b687-944e2a18ab7e",
                                        "entry_id": "a8a11395-43aa-3a01-bd5d-47c0adf7a058",
                                        "glosses": [
                                            "To condemn or reprimand."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
