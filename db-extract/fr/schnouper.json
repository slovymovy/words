                "senses": [
                    {
                        "sense_id": "8ee8efae-93cd-38e5-9ea9-665266719bdb",
                        "entry_id": "a028319f-dd80-3136-8638-e6ed93c8c64c",
                        "glosses": [
                            "Boire (au sens alcoolisé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb308e95-c900-4cd9-b62c-505ac804e71e",
                                "sense_id": "8ee8efae-93cd-38e5-9ea9-665266719bdb",
                                "text": "— Pas trop schnouper à votre âge, si vous tenez à un long parcours ! a dit le praticien, sans plaisanter."
                            },
                            {
                                "example_id": "e4352fa4-9ba5-408d-bb07-4924d57818e7",
                                "sense_id": "8ee8efae-93cd-38e5-9ea9-665266719bdb",
                                "text": "C'est le temps de la persuasion, difficile, vu que le clodo, même ourdé à zéro, aspire violemment à schnouper encore et toujours, et nullement à regagner les locaux et l'asile."
                            },
                            {
                                "example_id": "7e0e3e55-635e-4084-a030-682f49a73f6d",
                                "sense_id": "8ee8efae-93cd-38e5-9ea9-665266719bdb",
                                "text": "Faut quand même schnouper dur et s'dévorer tirelire au picton pour délirer comme ça."
                            }
                        ]
                    },
