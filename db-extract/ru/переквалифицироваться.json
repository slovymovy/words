                        "entry_id": "1b61f35b-3316-3a59-ba35-efe7b930b045",
                        "glosses": [
                            "приобрести (приобретать) новую квалификацию, обучиться (обучаться) новой профессии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b25ae3-a208-4e68-8d0c-fe52be092f52",
                                "sense_id": "80844a5b-b47f-3ce5-8b75-f3cbd9a5c84f",
                                "text": "Придётся переквалифицироваться в управдомы."
                            },
                            {
                                "example_id": "dbcf972e-b7d2-4973-9a94-a854d2c435da",
                                "sense_id": "80844a5b-b47f-3ce5-8b75-f3cbd9a5c84f",
                                "text": "Я раньше эстрадным сатириком был, громил поджигателей, братцы, но миром запахло — и вот я решил переквалифицироваться!"
                            }
                        ]
                    },
