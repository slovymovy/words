                                                "sense_id": "3697266a-5959-30ee-9cd1-d0d9a9a79cbc",
                                                "text": "„Diese Sinisierungen vollziehen sich meist auf zwei Ebenen: der Sprache und der Praxis.“"
                                            },
                                            {
                                                "example_id": "e87aac93-86be-477e-8ee2-540a41346242",
                                                "sense_id": "3697266a-5959-30ee-9cd1-d0d9a9a79cbc",
                                                "text": "„Experten sprechen bereits von einer Sinisierung der deutschen Wirtschaft, da China immer mehr in den Mittelpunkt der heimischen Exportwirtschaft gerät.“"
                                            }
                                        ],
