{
    "word_family": [
        "unhinge",
        "hinge"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aad3a2bf-70b0-3d64-aaf5-eb62316c0436",
                    "sense_definition": "Mentally disturbed, unstable, or highly erratic in behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His behavior became completely <w>unhinged</w> after he lost his job. ",
                            "target_lang_translations": {
                                "ru": "Его поведение стало совершенно <w>неадекватным</w> после того, как он потерял работу."
                            }
                        },
                        {
                            "text": "She started acting completely <w>unhinged</w> after staying awake for three straight days.",
                            "target_lang_translations": {
                                "ru": "Она начала вести себя абсолютно <w>помешанной</w> после того, как не спала три дня подряд."
                            }
                        }
                    ],
                    "synonyms": [
                        "deranged",
                        "unbalanced",
                        "insane",
                        "demented"
                    ],
                    "common_phrases": [
                        "completely unhinged",
                        "acting unhinged"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used informally to describe chaotic or crazy behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Психически нестабильный, неадекватный или безумный в поведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свихнувшийся",
                                "target_lang_sense_clarification": "потерявший рассудок"
                            },
                            {
                                "target_lang_word": "неравновешенный",
                                "target_lang_sense_clarification": "психически нестабильный"
                            },
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "безумный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c8ababb-8e1b-3233-b2d3-0812db6866ab",
                    "sense_definition": "Not attached or fitted with hinges.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They carried an <w>unhinged</w> door into the workshop for repairs.",
                            "target_lang_translations": {
                                "ru": "Они отнесли <w>снятую с петель</w> дверь в мастерскую для ремонта."
                            }
                        },
                        {
                            "text": "The workmen left an <w>unhinged</w> panel leaning against the wall.",
                            "target_lang_translations": {
                                "ru": "Рабочие оставили <w>снятую с петель</w> панель прислоненной к стене."
                            }
                        }
                    ],
                    "antonyms": [
                        "hinged"
                    ],
                    "common_phrases": [
                        "unhinged door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снятый с петель, не закрепленный на петлях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снятый с петель",
                                "target_lang_sense_clarification": "о двери или панели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fda9d60f-d9de-3d38-a9e0-d2cac8eb47e0",
                    "sense_definition": "(of a postage stamp) Never mounted using a stamp hinge; in original condition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This rare stamp is unmounted and completely <w>unhinged</w>.",
                            "target_lang_translations": {
                                "ru": "Эта редкая марка не была в альбоме и абсолютно <w>без наклейки</w>."
                            }
                        },
                        {
                            "text": "Collectors prefer an <w>unhinged</w> stamp because it retains its original gum.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры предпочитают марку <w>без следов наклейки</w>, потому что она сохраняет оригинальный клей."
                            }
                        }
                    ],
                    "synonyms": [
                        "unmounted",
                        "mint-never-hinged"
                    ],
                    "target_lang_definitions": {
                        "ru": "(о почтовой марке) Никогда не крепившаяся на наклейку; в первозданном виде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без наклейки",
                                "target_lang_sense_clarification": "о почтовой марке (MNH)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5b96390-96f5-3523-8277-9b07405cf36d",
                    "sense_definition": "simple past and past participle of <w>unhinge</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden traumatic news completely <w>unhinged</w> him for weeks.",
                            "target_lang_translations": {
                                "ru": "Внезапная трагическая новость совершенно <w>выбила</w> его <w>из колеи</w> на несколько недель."
                            }
                        },
                        {
                            "text": "Strong winds <w>unhinged</w> the heavy wooden gate from the post.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>сорвал</w> тяжелые деревянные ворота <w>с петель</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от unhinge (выбить из колеи, снять с петель)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбил из колеи",
                                "target_lang_sense_clarification": "лишил душевного равновесия"
                            },
                            {
                                "target_lang_word": "снял с петель",
                                "target_lang_sense_clarification": "о двери или воротах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}