                        "entry_id": "276ad648-ddfe-3216-b3cd-a70cbbf3bcab",
                        "glosses": [
                            "Zustand am Morgen, nur relativ niedrige Temperatur aufzuweisen/kühl zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef769ecf-81de-40ad-9180-a319f4a1f550",
                                "sense_id": "a0da7674-0ce2-3b56-b3e9-c130d427610a",
                                "text": "„Sie liegen noch im Bett, die Fenster in die Morgenkühle geöffnet.“"
                            },
                            {
                                "example_id": "5560be45-ae19-4041-8a0b-140f6be73038",
                                "sense_id": "a0da7674-0ce2-3b56-b3e9-c130d427610a",
                                "text": "„Unmittelbar am Abhang aber standen Libellen in der Luft, und kleine graue Heuschrecken, die sich in der Morgenkühle von Feld und Wiese her bis an den Waldrand gewagt haben mochten, sprangen jetzt, bei sich steigernder Tagesglut, in die kühlere Kleewiese zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
