                                    },
                                    {
                                        "sense_id": "ee7bff6b-4ed2-3ed8-ab5c-fc804e505106",
                                        "entry_id": "9fafc42c-3740-3bd2-833a-14639ba82695",
                                        "glosses": [
                                            "Somewhere one can find protection.",
                                            "A refuge, sanctuary, or (by metonymy) institution that provides temporary housing or a place to sleep for those in need or in danger.",
                                            "An animal shelter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e89926c0-1e69-48d9-af2c-27bbf896e906",
                                                "sense_id": "ee7bff6b-4ed2-3ed8-ab5c-fc804e505106",
                                                "text": "I wish more people would look for pets at the shelter before turning to breeders!"
                                            },
                                            {
                                                "example_id": "9dd05856-448c-456b-a013-31b42f22d774",
                                                "sense_id": "ee7bff6b-4ed2-3ed8-ab5c-fc804e505106",
