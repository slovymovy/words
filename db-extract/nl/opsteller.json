                "senses": [
                    {
                        "sense_id": "f596b948-1432-3dd3-8f03-ce3b55efe0d9",
                        "entry_id": "bf2df593-afca-3faa-868e-a5aec24ecabc",
                        "glosses": [
                            "schrijver of ontwerper van een plan of geschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb38db84-ae8b-4b71-b10a-287f0c061c42",
                                "sense_id": "f596b948-1432-3dd3-8f03-ce3b55efe0d9",
                                "text": "Volgens de opstellers van de brief moet de universiteit extremistische organisaties als Revolutionaire Eenheid van de campus weren. „Wij, Joodse studenten en oud-studenten, verzoeken het bestuur van de VU om radicale clubs met racistische en antisemitische tendensen en hun evenementen niet langer te gedogen.”"
                            },
                            {
                                "example_id": "1f6fac5c-4150-41f0-aad1-f1248361595c",
                                "sense_id": "f596b948-1432-3dd3-8f03-ce3b55efe0d9",
                                "text": "Door de opkomst van de e-bike nemen steeds meer mensen de fiets voor langere afstanden van stad naar stad, vooral voor hun werk. Maar het nieuwe netwerk maakt het ook makkelijker om van de stad naar het vrije landschap te fietsen, zeggen de opstellers van het plan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d8f7f33-53d9-4b6c-8b94-da9ed395e772",
                        "source_entry_id": "bf2df593-afca-3faa-868e-a5aec24ecabc",
                        "source_sense_id": "f596b948-1432-3dd3-8f03-ce3b55efe0d9",
                        "target_lang_word": "author",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "author",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                        "entry_id": "fda8c9ff-e7c8-39f6-80ee-414a3778814e",
                                        "glosses": [
                                            "The originator or creator of a work, especially of a literary composition; or, one of the creators of a collaborative work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf1e9023-2635-4c6e-91b0-367840d96263",
                                                "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "22170082-6efd-4467-abc6-e33e07197369",
                                                "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                                "text": "The copyright of any original writing belongs initially and properly to its author."
                                            },
                                            {
                                                "example_id": "1ef25dbb-3955-44d1-80a7-1c0a64e2e427",
                                                "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                                "text": "Have you read any Corinthian authors?"
                                            },
                                            {
                                                "example_id": "1114ee26-6889-42a3-badb-9b16f45b923a",
                                                "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                                "text": "This paper has three authors."
                                            },
                                            {
                                                "example_id": "69dff24f-7b5c-48e9-a77c-017742fa2c9f",
                                                "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                                "text": "Eternal King; thee, Author of all being."
                                            },
                                            {
                                                "example_id": "c1331c58-9fd3-464c-a67f-e7efdd68b2c7",
                                                "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "90206d3e-8138-4298-8c62-83e34696032f",
                                                "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                                                "text": "The chief glory of every people arises from its authors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53257577-9e9e-34c9-8138-00fbd72bf27d",
                                        "entry_id": "fda8c9ff-e7c8-39f6-80ee-414a3778814e",
                                        "glosses": [
                                            "The initial owner of the copyright to a work, especially a work made for hire or a work of corporate authorship."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5660ae0-d46d-4e4d-893d-5a4232b3e743",
                                                "sense_id": "53257577-9e9e-34c9-8138-00fbd72bf27d",
                                                "text": "The author named on the copyright registration for the Android robot is Google Inc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c368eaa9-cebf-32aa-9a1c-9dcb93324edc",
                                        "entry_id": "fda8c9ff-e7c8-39f6-80ee-414a3778814e",
                                        "glosses": [
                                            "Someone who writes books for a living."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57c789a6-dfc1-3790-bd3f-c6e444492389",
                                        "entry_id": "fda8c9ff-e7c8-39f6-80ee-414a3778814e",
                                        "glosses": [
                                            "Principal; the primary participant in a crime."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b7b916-67a7-4c8f-887f-6b7f09069024",
                                                "sense_id": "57c789a6-dfc1-3790-bd3f-c6e444492389",
                                                "text": "We hear […]of fratricidal murders, and stern reprisals on their authors."
                                            },
                                            {
                                                "example_id": "ae425f36-ccfb-437c-9fde-41a60e402a4f",
                                                "sense_id": "57c789a6-dfc1-3790-bd3f-c6e444492389",
                                                "text": "Accomplices of a crime or an offence shall incur the same punishment as the authors of such a crime or offence, except when the law will have disposed otherwise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71edf3bb-07e4-3f6a-bef0-f4f8f8c21d07",
                                        "entry_id": "fda8c9ff-e7c8-39f6-80ee-414a3778814e",
                                        "glosses": [
                                            "One's authority for something: an informant."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6992ec2c-4ce4-4127-a737-7ae88fe62666",
                                                "sense_id": "71edf3bb-07e4-3f6a-bef0-f4f8f8c21d07",
                                                "text": "Let me inform you en passant, Ladies, that those Villains the Heathens, as my Authors tell me, (and I thought it wou'd^([sic]) not be amiss to communicate such a nice Observation to this House) used to call our Saviour Chrestus, and not Christus, by way of Contempt and Derision […]"
                                            },
                                            {
                                                "example_id": "43ae1291-4142-4d15-aa45-90794159cb7b",
                                                "sense_id": "71edf3bb-07e4-3f6a-bef0-f4f8f8c21d07",
                                                "text": "'Wanting the hat,' continues my author, Kirstie, whom I but haltingly follow, for she told this tale like one inspired, 'wanting guns, for there wasna twa grains o' pouder in the house, wi' nae mair weepons than their sticks into their hands, the fower o' them took the road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ee7057-1f85-3e43-9fe8-968584e8c7ab",
                                        "entry_id": "fda8c9ff-e7c8-39f6-80ee-414a3778814e",
                                        "glosses": [
                                            "The creator or cause of anything."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35985f20-b98c-4eef-9201-f89c52329cc9",
                                                "sense_id": "57ee7057-1f85-3e43-9fe8-968584e8c7ab",
                                                "text": "The other, standing nearly head-on toward the hunters, had not proved so good a mark, and though every spear struck not one entered the great heart. For a moment the huge bull stood trumpeting in rage and pain, casting about with its little eyes for the author of its hurt."
                                            }
                                        ]
                                    }
                                ]
