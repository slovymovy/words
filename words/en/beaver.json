{
    "word_family": [
        "beavering",
        "beaverish",
        "beaver-like"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93d6b8eb-44ed-3cf0-b834-f8b72c1004f7",
                    "sense_definition": "A semiaquatic rodent of the genus Castor, having a wide, flat tail and webbed feet, native to the Northern Hemisphere.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>beaver</w> built a large dam across the stream using branches and mud.",
                            "target_lang_translations": {
                                "ru": "<w>Бобр</w> построил большую плотину через ручей, используя ветки и грязь."
                            }
                        },
                        {
                            "text": "We saw a <w>beaver</w> swimming near the edge of the lake at sunset.",
                            "target_lang_translations": {
                                "ru": "На закате мы видели <w>бобра</w>, плывущего у края озера."
                            }
                        }
                    ],
                    "synonyms": [
                        "castor"
                    ],
                    "common_phrases": [
                        "beaver dam",
                        "beaver lodge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полуводное млекопитающее отряда грызунов с широким плоским хвостом и перепончатыми лапами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бобр",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "бобёр",
                                "target_lang_sense_clarification": "разговорное название животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e6ef19e-fddc-3b56-8862-dd01139fde31",
                    "sense_definition": "The fur of the beaver, often used for clothing or hats.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collar of her winter coat was made of soft, warm <w>beaver</w>.",
                            "target_lang_translations": {
                                "ru": "Воротник её зимнего пальто был сделан из мягкого, тёплого <w>бобра</w>."
                            }
                        },
                        {
                            "text": "Historically, <w>beaver</w> was a highly valued commodity in the North American fur trade.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>бобровый мех</w> был высоко ценимым товаром в североамериканской торговле пушниной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beaver fur",
                        "beaver pelt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мех бобра, часто используемый для изготовления одежды или головных уборов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бобр",
                                "target_lang_sense_clarification": "мех или изделие из него"
                            },
                            {
                                "target_lang_word": "бобровый мех",
                                "target_lang_sense_clarification": "материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d13e2886-c911-36e1-b755-f1722e14688a",
                    "sense_definition": "A hat, of various shapes, made from a felted beaver fur (or later of silk), fashionable in Europe between 1550 and 1850.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentleman tipped his <w>beaver</w> as he passed the ladies on the street.",
                            "target_lang_translations": {
                                "ru": "Джентльмен приподнял свою <w>бобровую шляпу</w>, проходя мимо дам на улице."
                            }
                        },
                        {
                            "text": "He wore a broad <w>beaver</w> slouched over his eyes to hide his identity.",
                            "target_lang_translations": {
                                "ru": "Он носил широкую <w>шляпу из бобра</w>, надвинутую на глаза, чтобы скрыть свою личность."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical style of hat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шляпа различной формы, изготовленная из валяного бобрового меха (позже из шелка), модная в Европе в XVI-XIX веках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бобровая шляпа",
                                "target_lang_sense_clarification": "головной убор"
                            },
                            {
                                "target_lang_word": "кастор",
                                "target_lang_sense_clarification": "устаревшее название шляпы из бобрового пуха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67c8966c-cfc0-30e7-941f-4ebc4f2dc08e",
                    "sense_definition": "A member of the youngest wing of the Scout movement, composed of groups for children, traditionally boys, of approximately five to seven years of age.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My younger brother just joined the local scouts as a <w>Beaver</w>.",
                            "target_lang_translations": {
                                "ru": "Мой младший брат только что присоединился к местным скаутам в качестве <w>бивера</w>."
                            }
                        },
                        {
                            "text": "The <w>Beavers</w> went on their first camping trip last weekend.",
                            "target_lang_translations": {
                                "ru": "<w>Бобрята</w> отправились в свой первый поход на прошлых выходных."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in UK and Commonwealth scouting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член младшей возрастной группы скаутского движения (обычно дети 5-7 лет)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бивер",
                                "target_lang_sense_clarification": "младший скаут"
                            },
                            {
                                "target_lang_word": "бобрёнок",
                                "target_lang_sense_clarification": "перевод названия младшей группы скаутов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aedebef-20a4-3384-8856-a510f95ee1ac",
                    "sense_definition": "A beard or a bearded person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had fallen among a band of criminals who were not wilful <w>beavers</w> but wore false beards.",
                            "target_lang_translations": {
                                "ru": "Он попал в банду преступников, которые не были настоящими <w>бородачами</w>, а носили фальшивые бороды."
                            }
                        },
                        {
                            "text": "The old man was a true <w>beaver</w> with hair reaching down to his chest.",
                            "target_lang_translations": {
                                "ru": "Старик был настоящим <w>бородачом</w> с волосами до самой груди."
                            }
                        }
                    ],
                    "synonyms": [
                        "beard",
                        "beardo",
                        "beardy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Old-fashioned British slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Борода или человек с бородой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бородач",
                                "target_lang_sense_clarification": "человек с бородой"
                            },
                            {
                                "target_lang_word": "борода",
                                "target_lang_sense_clarification": "растительность на лице"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14690514-f2af-3f30-a523-42a4a079c178",
                    "sense_definition": "The pubic hair near a vulva or a vulva itself.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The adult magazine was criticized for its explicit photos of <w>beaver</w>.",
                            "target_lang_translations": {
                                "ru": "Журнал для взрослых критиковали за откровенные фотографии <w>мохнаток</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лобковые волосы или женские половые органы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мохнатка",
                                "target_lang_sense_clarification": "вульгарный сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1043726f-04a2-3781-9e0e-fa1780d755db",
                    "sense_definition": "To work hard and diligently, often on a specific task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been <w>beavering</w> away at her thesis all morning.",
                            "target_lang_translations": {
                                "ru": "Она всё утро <w>корпела</w> над своей диссертацией."
                            }
                        },
                        {
                            "text": "The students were <w>beavering</w> away in the library to finish their projects.",
                            "target_lang_translations": {
                                "ru": "Студенты <w>усердно трудились</w> в библиотеке, чтобы закончить свои проекты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beaver away"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used with 'away'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Усердно и прилежно работать, часто над конкретной задачей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпеть",
                                "target_lang_sense_clarification": "усердно работать над чем-то"
                            },
                            {
                                "target_lang_word": "трудиться как пчелка",
                                "target_lang_sense_clarification": "идиома о трудолюбии"
                            },
                            {
                                "target_lang_word": "вкалывать",
                                "target_lang_sense_clarification": "разговорное о тяжелой работе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "392f7101-d51f-305a-aa9f-911a7f6b8df8",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Beaver</w> was the principal of the local high school for many years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бивер</w> много лет был директором местной средней школы."
                            }
                        },
                        {
                            "text": "The <w>Beaver</w> family has lived in this town since the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Бивер</w> живет в этом городе с девятнадцатого века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бивер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847d6be4-87c9-3b06-aaf8-8b8b25999fe8",
                    "sense_definition": "A city, the county seat of Beaver County, Utah.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped for gas in <w>Beaver</w> while driving through Utah.",
                            "target_lang_translations": {
                                "ru": "Они остановились заправиться в <w>Бивере</w>, когда проезжали через Юту."
                            }
                        },
                        {
                            "text": "The town of <w>Beaver</w> is located in the southwestern part of the state.",
                            "target_lang_translations": {
                                "ru": "Город <w>Бивер</w> расположен в юго-западной части штата."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в штате Юта, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бивер",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}