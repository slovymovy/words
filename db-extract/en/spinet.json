                    },
                    {
                        "translation_id": "416f53a9-7afc-4f8b-93b0-b0548d749b57",
                        "source_entry_id": "11442135-1438-3e9c-88bd-f90eb4f09531",
                        "source_sense_id": "191102c7-49cf-371b-99ba-039f9785892b",
                        "source_sense_description": "short, compact harpsichord",
                        "target_lang_word": "épinette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épinette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f8d369d-3edd-3d4d-9c05-01e231cb743f",
                                        "entry_id": "b6436189-17f6-3b00-9053-df405e90d09f",
                                        "glosses": [
                                            "Instrument de musique ressemblant à un petit clavecin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd1d849-d3bc-4778-8b21-2cb015730fcc",
                                                "sense_id": "4f8d369d-3edd-3d4d-9c05-01e231cb743f",
                                                "text": "Jouer de l’épinette."
                                            },
                                            {
                                                "example_id": "843a0740-85cc-46fb-abce-039ebcf37696",
                                                "sense_id": "4f8d369d-3edd-3d4d-9c05-01e231cb743f",
                                                "text": "Comme en un concert d’instruments, on n’oit pas un luth, une épinette et la flûte, on oit une harmonie en globe, l’assemblage et le fruit de tout cet amas."
                                            },
                                            {
                                                "example_id": "6132f692-9b84-44ab-8160-6772c1cea1e2",
                                                "sense_id": "4f8d369d-3edd-3d4d-9c05-01e231cb743f",
                                                "text": "Le piano à l’époque romantique a supplanté le clavecin et l’épinette sans les faire disparaitre pour autant."
                                            },
                                            {
                                                "example_id": "1f3f0a2f-fa32-436d-b87f-d15d63cbc44c",
                                                "sense_id": "4f8d369d-3edd-3d4d-9c05-01e231cb743f",
                                                "text": "Il se leva, et, s’asseyant devant l’épinette séculaire, endormie en un coin, fit sortir une valse, une valse enrouée, larmoyante, du ventre geignant de la machine."
                                            },
                                            {
                                                "example_id": "e4062ddf-1afa-4a15-a915-7194f6e6f4da",
                                                "sense_id": "4f8d369d-3edd-3d4d-9c05-01e231cb743f",
                                                "text": "Ninon, coiffée d'un petit bonnet de nuit, allait et venait sur le parquet frais qui ﬂattait la plante et les mignons doigts de son pied, soulevés et abaissés un à un comme les touches d'ivoire d'une épinette, car elle semblait faire ﬁ des mules tenues à la main par Thérèse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40bbed9b-f06f-3206-a8f4-bf2c0f5dd0e2",
                                        "entry_id": "b6436189-17f6-3b00-9053-df405e90d09f",
                                        "glosses": [
                                            "Instrument de musique apparenté à la cithare."
                                        ],
                                        "tags": [
                                            "Vosges"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5fe2a64-2079-4312-8faa-464c1f35bf9d",
                                                "sense_id": "40bbed9b-f06f-3206-a8f4-bf2c0f5dd0e2",
                                                "text": "Contrairement à d’autres instruments, comme le dulcimer, la particularité de l’épinette est de permettre la distinction entre chanterelles et bourdons."
                                            },
                                            {
                                                "example_id": "6dba47ee-64c8-4563-84d3-0949e5db0268",
                                                "sense_id": "40bbed9b-f06f-3206-a8f4-bf2c0f5dd0e2",
                                                "text": "… et mademoiselle Sophia Schlick, la maîtresse d’école de Margrédel, deux petites anglaises au coin des yeux et quatre cheveux tendus sur le front, comme les cordes d’une épinette, je l’entends répéter sans cesse : « Quel malheur ! quel malheur d’avoir déjeuné si tard ! je n’ai plus d’appétit !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épinette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a3421f-903d-3256-9f1f-94ae30df94a9",
                                        "entry_id": "57656095-7b2a-3aba-9e26-4646c38e1b82",
                                        "glosses": [
                                            "Nom commun d’un genre d’arbres résineux nommés épicéa en France (Picea)."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76e5945-cd95-44e9-b84d-85e31805690f",
                                                "sense_id": "d2a3421f-903d-3256-9f1f-94ae30df94a9",
                                                "text": "Même l’éternel vert foncé des sapins, des épinettes et des cyprès se faisait rare ; les quelques jeunes arbres vivants se perdaient parmi les innombrables squelettes couchés à terre et recouverts de neige, ou ces autres squelettes encore debout, décharnés et noircis."
                                            },
                                            {
                                                "example_id": "751cbbc2-dd02-4823-9ce5-33ba2449a808",
                                                "sense_id": "d2a3421f-903d-3256-9f1f-94ae30df94a9",
                                                "text": "Les pêcheurs de Terre-Neuve font une sorte de bière avec les jeunes pousses de l’épinette blanche."
                                            },
                                            {
                                                "example_id": "e198b498-8083-4fdb-850a-bd17ebf9a8a4",
                                                "sense_id": "d2a3421f-903d-3256-9f1f-94ae30df94a9",
                                                "text": "L’épinette est répartie dans l’ensemble des régions les plus froides de la zone tempérée du Nord et en altitude, plus au sud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épinette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "335a12d1-3b07-3aaf-b8ed-30b755bdf864",
                                        "entry_id": "f64bac2d-f046-341f-8520-261a95f7347c",
                                        "glosses": [
                                            "Prunelier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "697c82e4-6063-3227-8400-f01ccb175090",
                                        "entry_id": "f64bac2d-f046-341f-8520-261a95f7347c",
                                        "glosses": [
                                            "Boisson apéritive fabriquée avec de jeunes rameaux de prunelier."
                                        ],
                                        "tags": [
                                            "Aunis",
                                            "Saintonge"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae61a7f7-c41e-4e0d-95d5-1313046b5968",
                                                "sense_id": "697c82e4-6063-3227-8400-f01ccb175090",
                                                "text": "Épine, épinette ou trouspinette : quel que soit son nom, cette boisson apéritive est probablement l’une des plus populaires dans nos campagnes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épinette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f944bf62-535a-31e0-9ab8-02858b90edf4",
                                        "entry_id": "c7b77bed-e135-3c54-811a-40da8ba219f4",
                                        "glosses": [
                                            "Cage en bois utilisée pour l’engraissage des chapons et des poulets."
                                        ],
                                        "tags": [
                                            "Bresse",
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b628ac8-fbaa-4051-9e35-4f3018612d2c",
                                                "sense_id": "f944bf62-535a-31e0-9ab8-02858b90edf4",
                                                "text": "Dans l’épinette, il y a un coq favori et pour ainsi dire sacré, qui survit à tous les autres ; il est fameux pour avoir chanté pendant un combat, comme dans la cour d’une ferme au milieu de ses poules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épinette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61fca955-0871-33d6-b922-865aae187ac8",
                                        "entry_id": "e4aca78d-15f3-3b01-8cf2-65bdec71c83a",
                                        "glosses": [
                                            "Sécateur de petite taille et relativement léger, adapté à la récolte de fruits ou de fleurs, et à la taille de végétaux non-lignifiés (potager, fruitiers, aromatiques, art floral, …)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3fe6208-9264-4048-8382-cfb9f4164de9",
                        "source_entry_id": "11442135-1438-3e9c-88bd-f90eb4f09531",
