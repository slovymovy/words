                "senses": [
                    {
                        "sense_id": "db5beb24-dafa-3fec-affe-3c8f536d3f74",
                        "entry_id": "ae263d86-0c63-3f0e-ba2a-914768acef58",
                        "glosses": [
                            "een ei van chocolade of suiker dat op of omstreeks Pasen gegeten wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff11f8cc-44e8-4cc1-9a8a-b6a2af77618c",
                                "sense_id": "db5beb24-dafa-3fec-affe-3c8f536d3f74",
                                "text": "De kinderen aten bij het ontbijt paaseieren."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec88cc9f-3d3e-30c1-86bd-8362e6edb2bb",
                        "entry_id": "ae263d86-0c63-3f0e-ba2a-914768acef58",
                        "glosses": [
                            "een ter gelegenheid van Pasen gekleurd en versierd kippenei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7226a8c-88a2-4ea7-9d38-1ccac204dd9a",
                                "sense_id": "ec88cc9f-3d3e-30c1-86bd-8362e6edb2bb",
                                "text": "De ouders gingen met z'n allen paaseieren verven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1948a16-a1b4-4f24-950f-b8ebab5143a2",
                        "source_entry_id": "ae263d86-0c63-3f0e-ba2a-914768acef58",
                        "source_sense_id": "db5beb24-dafa-3fec-affe-3c8f536d3f74",
                        "source_sense_description": "een ei van chocolade of suiker dat op of omstreeks Pasen gegeten wordt",
                        "target_lang_word": "Osterei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Osterei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bf7fcf9-d5f9-394e-b42e-f5134ab66b4c",
                                        "entry_id": "ebb15a15-e611-33bf-92f6-dab449a5780f",
                                        "glosses": [
                                            "ein bunt dekoriertes oder künstliches Ei, das zu Ostern gegessen, für Spiele oder als Schmuck verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca891ac-07b2-4b59-b090-d98da97c5d32",
                                                "sense_id": "0bf7fcf9-d5f9-394e-b42e-f5134ab66b4c",
                                                "text": "Das ist ein schönes Osterei."
                                            },
                                            {
                                                "example_id": "c9da3ff7-4ecf-466e-bbb6-6832d8a6debc",
                                                "sense_id": "0bf7fcf9-d5f9-394e-b42e-f5134ab66b4c",
                                                "text": "Für Kinder versteckt man gerne Ostereier in nestähnlichen Gruben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "333eb73f-2a9d-4c39-bf0e-d6da589ea561",
                        "source_entry_id": "ae263d86-0c63-3f0e-ba2a-914768acef58",
                        "source_sense_id": "db5beb24-dafa-3fec-affe-3c8f536d3f74",
                        "source_sense_description": "een ei van chocolade of suiker dat op of omstreeks Pasen gegeten wordt",
                        "target_lang_word": "Easter egg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Easter egg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3ee1a4-9937-3cd2-8988-fa61ee3f4400",
                                        "entry_id": "6ff119da-c54e-3c2b-b3cb-f2062a63fd18",
                                        "glosses": [
                                            "A dyed or decorated egg, traditionally associated with Easter and, in the Western European tradition, sometimes hidden for children to find."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "913cd274-e8ab-4340-a800-d2e15aa4388c",
                                                "sense_id": "fa3ee1a4-9937-3cd2-8988-fa61ee3f4400",
                                                "text": "Because eggs were inexpensive in most regions, the practice of decorating Easter eggs crossed all social classes and remained somewhat simple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0585f81e-5648-32e3-acbc-9724806c44ea",
                                        "entry_id": "6ff119da-c54e-3c2b-b3cb-f2062a63fd18",
                                        "glosses": [
                                            "A chocolate confection in the shape of an egg, sometimes with chocolates or sweets inside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ef548e-f6d0-44b1-9bdb-939d13a82123",
                                                "sense_id": "0585f81e-5648-32e3-acbc-9724806c44ea",
                                                "text": "I reached the first fork in the tree and there they lay—several melted Easter eggs[…] Quickly I tore open the foil and licked the melted chocolate until there wasn't a trace left on the paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebba0846-01c5-3e6b-8fdc-c96d027cbf8a",
                                        "entry_id": "6ff119da-c54e-3c2b-b3cb-f2062a63fd18",
                                        "glosses": [
                                            "An undocumented function hidden in a program or video game, typically triggered by a particular input sequence or combination of keystrokes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f714a04-4c0b-466b-9d25-e0db1a86595c",
                                                "sense_id": "ebba0846-01c5-3e6b-8fdc-c96d027cbf8a",
                                                "text": "an Easter egg that displays the names of the application's development team"
                                            },
                                            {
                                                "example_id": "a119ec2a-c9d1-45b9-960c-0c33d7c9134b",
                                                "sense_id": "ebba0846-01c5-3e6b-8fdc-c96d027cbf8a",
                                                "text": "Once found, the Easter egg will often enable the player to traverse through the game much more rapidly the second time around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bb15743-04d7-38ef-b9c2-a66d39f27893",
                                        "entry_id": "6ff119da-c54e-3c2b-b3cb-f2062a63fd18",
                                        "glosses": [
                                            "Any image, feature, or other content that is hidden on a video disc or in a movie, trailer, or poster."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f481a6-1f33-455f-86e2-0dba335c50f2",
                                                "sense_id": "5bb15743-04d7-38ef-b9c2-a66d39f27893",
                                                "text": "For the Best of Bowie DVD release, APl even concealed an Easter egg within a hidden extra."
                                            },
                                            {
                                                "example_id": "f5e62193-90ef-4b76-b145-0e9a8a3df9dc",
                                                "sense_id": "5bb15743-04d7-38ef-b9c2-a66d39f27893",
                                                "text": "The repeated appearance of a number as an Easter egg is not a new concept for J.J., Burky or those other members of Lost Labs who previously worked on Alias."
                                            },
                                            {
                                                "example_id": "5082cf42-a2ff-42ff-b41d-2dadbb2ee825",
                                                "sense_id": "5bb15743-04d7-38ef-b9c2-a66d39f27893",
                                                "text": "Unlike an allusion — a tip of the hat to a previous work — an Easter egg, when found, is an anachronistic disruption, an anti-mimetic breaking of the fourth wall to make room for a joke, clue or grievance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbece7bd-2372-4ab2-a123-7eec4e6f6e46",
                        "source_entry_id": "ae263d86-0c63-3f0e-ba2a-914768acef58",
                        "source_sense_id": "db5beb24-dafa-3fec-affe-3c8f536d3f74",
                        "source_sense_description": "een ei van chocolade of suiker dat op of omstreeks Pasen gegeten wordt",
                        "target_lang_word": "œuf de Pâques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "œuf de Pâques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75938f50-1f5d-3a2a-ac10-03fa1b01b0fc",
                                        "entry_id": "41cef1dd-2b37-3e23-9ab7-c0e87d34d0f6",
                                        "glosses": [
                                            "Sorte de friandise, en sucre ou en chocolat, qui a la forme d’un œuf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28488a37-05d9-4526-9ece-795875b49e90",
                                                "sense_id": "75938f50-1f5d-3a2a-ac10-03fa1b01b0fc",
                                                "text": "L'œuf pondu le vendredi saint préservait de la foudre, mangé il garantissait de la fièvre ou de la rage... Notre œuf de Pâques est certainement un dérivé de ces anciennes coutumes vosgiennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
