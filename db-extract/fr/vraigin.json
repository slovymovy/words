                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50adf13a-d98b-4618-ab24-7cfcba34bcde",
                                "sense_id": "a7efee60-633a-3ed6-8bf9-163004d7cbd8",
                                "text": "Dans beaucoup de localités, l’Ascophyllum est connu sous le nom de Robert ; Moquin-Tandon dit qu’on l’appelle aussi Vraigin."
                            },
                            {
                                "example_id": "d3e575d1-317c-4b88-b90f-d5654aec9633",
                                "sense_id": "a7efee60-633a-3ed6-8bf9-163004d7cbd8",
                                "text": "Quant à l’Ascophyllum, il se rencontre au même niveau que le Fucus vesiculosus, on le connaît aussi sous le nom de « robert » et de « vraigin » (Moquin-Tandon)."
                            }
                        ]
                    }
