                        "sense_id": "eb9d605e-f564-3b76-9e3b-25c1cc3b810f",
                        "entry_id": "bf84dfc9-a731-33cd-9d5c-c9faf8a4f740",
                        "glosses": [
                            "taxpayer"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "e91d8cac-5b8e-4976-8a07-282815938ae4",
                                "sense_id": "eb9d605e-f564-3b76-9e3b-25c1cc3b810f",
                                "text": "De belastingbetaler zal deze kosten uiteindelijk dragen.",
                                "translation": "The taxpayer will ultimately bear these costs.",
                                "english": "The taxpayer will ultimately bear these costs."
                            },
                            {
                                "example_id": "09547af5-a8e3-4f33-b084-160d3f400607",
                                "sense_id": "eb9d605e-f564-3b76-9e3b-25c1cc3b810f",
                                "text": "Als belastingbetaler heb ik het recht om te weten waar mijn geld naartoe gaat.",
                                "translation": "As a taxpayer, I have the right to know where my money is going.",
                                "english": "As a taxpayer, I have the right to know where my money is going."
                            },
                            {
                                "example_id": "93bc030c-0df3-413f-8098-5f6d7a609e3e",
                                "sense_id": "eb9d605e-f564-3b76-9e3b-25c1cc3b810f",
                                "text": "De overheid moet verantwoordelijkheid tonen tegenover de belastingbetalers.",
                                "translation": "The government should show accountability to the taxpayers.",
                                "english": "The government should show accountability to the taxpayers."
                            }
                        ]
                    }
                ],
