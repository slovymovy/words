                    {
                        "translation_id": "f5d11210-d9a7-4017-b10d-1b92c719cc28",
                        "source_entry_id": "bb90b69a-7f3c-3e1f-8039-854b8b1b1cfd",
                        "source_sense_description": "female deity",
                        "target_lang_word": "naïade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naïade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7e03c32-9edd-35a0-87e7-5f314daaf53f",
                                        "entry_id": "b6810161-a59c-3106-bfab-6b70d9ab475a",
                                        "glosses": [
                                            "Nymphe des eaux douces, comme les fontaines, les rivières, les fleuves."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594e3996-3f6d-4957-963a-4b6a953c1fc5",
                                                "sense_id": "e7e03c32-9edd-35a0-87e7-5f314daaf53f",
                                                "text": "Une naïade ingénue, qui s’échappe de sa source, n’est pas plus timide, plus blanche ni plus naïve."
                                            },
                                            {
                                                "example_id": "3193c5e4-9de4-4136-baea-fc8c2805f981",
                                                "sense_id": "e7e03c32-9edd-35a0-87e7-5f314daaf53f",
                                                "text": "La dryade ne rehausse pas le sous-bois, ni la naïade la fontaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b35e5f14-1acc-38a7-9dc1-7551ffe977a9",
                                        "entry_id": "b6810161-a59c-3106-bfab-6b70d9ab475a",
                                        "glosses": [
                                            "Genre de plantes aquatiques, monocotylédones (famille des najadacées), telle que les naïas, qui croît dans les eaux douces d’Europe centrale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f857a038-c9e3-30a4-b579-584917891443",
                                        "entry_id": "b6810161-a59c-3106-bfab-6b70d9ab475a",
                                        "glosses": [
                                            "ou Baigneuse, nageuse."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b7b8c73-318f-3396-95b5-45aacc973c2f",
                                        "entry_id": "b6810161-a59c-3106-bfab-6b70d9ab475a",
                                        "glosses": [
                                            "Famille de mollusques comprenant les conchifères des eaux douces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e3f854-e8f8-4183-a26e-43ad5eac1d91",
                                                "sense_id": "2b7b8c73-318f-3396-95b5-45aacc973c2f",
                                                "text": "C’est ainsi : la Naïade est une philosophe aux goûts simples, une ermite dont l’existence entière se passe à tamiser des poussières dans le noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e75e76c7-f470-3930-895e-cb3a2aec57b3",
                                        "entry_id": "b6810161-a59c-3106-bfab-6b70d9ab475a",
                                        "glosses": [
                                            "Terme désignant les larves de certains groupes d’insectes aquatiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
