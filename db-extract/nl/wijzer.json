                            },
                            {
                                "target_word": "needle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4893750-b6e1-3a3d-b53f-f0bcf72f8081",
                                        "entry_id": "13625cc7-3c60-3677-9cc7-47e0d876b9f1",
                                        "glosses": [
                                            "To pierce with a needle, especially for sewing or acupuncture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a2670e-98f0-41ce-b0c6-93f317efdb7f",
                                                "sense_id": "e4893750-b6e1-3a3d-b53f-f0bcf72f8081",
                                                "text": "[…]the eyes were once more beginning to show the old nystagmus; so I decided to needle the cataracts, and on Jan. 31 I needled the right eye."
                                            },
                                            {
                                                "example_id": "63088e11-7136-4c7d-9642-77448532d037",
                                                "sense_id": "e4893750-b6e1-3a3d-b53f-f0bcf72f8081",
                                                "text": "Possibly the greatest effect is achieved in the hand by needling the thumb, the index finger and the region of the 1st and 2nd metacarpal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45bd4b7-2821-3519-a9a2-11e9ad51c706",
                                        "entry_id": "13625cc7-3c60-3677-9cc7-47e0d876b9f1",
                                        "glosses": [
                                            "To tease in order to provoke; to poke fun at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1da0eeb-a7e5-4175-bd24-92d9c20cc7ee",
                                                "sense_id": "e45bd4b7-2821-3519-a9a2-11e9ad51c706",
                                                "text": "Billy needled his sister incessantly about her pimples."
                                            },
                                            {
                                                "example_id": "c1192f06-cf70-43d9-811a-85dbaf124622",
                                                "sense_id": "e45bd4b7-2821-3519-a9a2-11e9ad51c706",
                                                "text": "FRED: Well, I teased her to some extent, or I needled her, not teased her. I needled her about—first I said that she didn't want to work, and then I think that there were a couple of comments."
                                            },
                                            {
                                                "example_id": "e1991011-1af7-4217-97e8-9e56dce1016f",
                                                "sense_id": "e45bd4b7-2821-3519-a9a2-11e9ad51c706",
                                                "text": "To needle Lady Leviathan, Hel has convinced her husband to agree to the heartful offer."
                                            },
                                            {
                                                "example_id": "8bb67ea3-ba6f-495f-b87c-086b2ad9824b",
                                                "sense_id": "e45bd4b7-2821-3519-a9a2-11e9ad51c706",
                                                "text": "Significantly, similar language was used by Sullivan, who had been needled by a question from a Ukrainian activist who suggested the US was “afraid of Ukraine winning”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8212c14c-6c24-3fcb-8f89-c4effdf7b413",
                                        "entry_id": "13625cc7-3c60-3677-9cc7-47e0d876b9f1",
                                        "glosses": [
                                            "To form, or be formed, in the shape of a needle."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab707f5b-a7f2-4972-8657-ca13ae391972",
                                                "sense_id": "8212c14c-6c24-3fcb-8f89-c4effdf7b413",
                                                "text": "to needle crystals"
                                            }
                                        ]
                                    }
                                ]
                            }
