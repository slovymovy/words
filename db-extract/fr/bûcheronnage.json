                    {
                        "sense_id": "7782d5a1-fecc-365a-830b-8f786bf267da",
                        "entry_id": "3c2dd0b2-f7e5-32ce-a9b6-0b1c15e501b9",
                        "glosses": [
                            "Coupe et ébranchage d’arbres, effectué en forêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0040504-c0e1-4152-a839-06bf34d2ef71",
                                "sense_id": "7782d5a1-fecc-365a-830b-8f786bf267da",
                                "text": "La toilette à l'eau froide, la pratique quotidienne de l’hébertisme, le forestage et le bûcheronnage, les ateliers de travail du bois et des métaux s'inscrivent dans une pédagogie de la vie au grand air."
                            },
                            {
                                "example_id": "40bd4670-5f99-4f9d-b82c-c20594c9e2e6",
                                "sense_id": "7782d5a1-fecc-365a-830b-8f786bf267da",
                                "text": "La mécanisation du bûcheronnage est une révolution récente qui a débuté entre 1970 et 1980."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0e30dec-c3c9-309c-b2d7-8fc93bd5316c",
                        "entry_id": "3c2dd0b2-f7e5-32ce-a9b6-0b1c15e501b9",
                        "glosses": [
                            "Ce genre d’activité, pratiquée en tant que sport."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6607dbaa-29d4-4c92-8722-ee37407cc83a",
                                "sense_id": "a0e30dec-c3c9-309c-b2d7-8fc93bd5316c",
                                "text": "C’est à Rotterdam (Pays-Bas), le 11 juin, que s’est déroulé le Trophée Mondial de bûcheronnage sportif Stihl Timbersports."
                            }
                        ]
