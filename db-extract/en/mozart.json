                        "target_lang_word": "Мо́царт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Мо́царт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "30d30d8c-a4f4-3c28-ba7a-79bf814c13aa",
                                        "entry_id": "7df51686-fbad-3656-b9f4-b5bce9b3c0c2",
                                        "glosses": [
                                            "немецкая фамилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cecbe611-8102-4a92-b84c-870687cd34f8",
                                                "sense_id": "30d30d8c-a4f4-3c28-ba7a-79bf814c13aa",
                                                "text": "— Осмелюсь вас спросить, кто этот молодой человек в простом немецком кафтане и с такой выразительной физиономиею, вон тот, что сидит в первом ряду с краю? — Это Моцарт. Моцарт! — повторил я."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Мо́царт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0bec941c-ae0d-3cf7-9bdd-1ffc5b248f42",
                                        "entry_id": "32040f6c-9d5d-39f5-bf3a-a789e264b302",
                                        "glosses": [
                                            "о том, кто достиг высшего мастерства в своём деле"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "d1e75660-1136-30ce-b019-65ef1f4d86ca",
                "word": "Mozart",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5ae3aa09-596b-40f3-b392-a134d3255937",
                        "entry_id": "d1e75660-1136-30ce-b019-65ef1f4d86ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "Mozarts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79193abf-fab3-354e-bc61-bd326ed399e0",
                        "entry_id": "d1e75660-1136-30ce-b019-65ef1f4d86ca",
                        "glosses": [
                            "By analogy with Wolfgang Amadeus Mozart, a musical virtuoso."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c76b674d-3155-48ff-a819-c71e10f433fc",
                                "sense_id": "79193abf-fab3-354e-bc61-bd326ed399e0",
                                "text": "One child is a Mozart with a flying start, while another foots it, and makes little way; but the course is the same, being set by the object."
                            },
                            {
                                "example_id": "b635c75e-a089-4729-959a-d80edcf82b37",
                                "sense_id": "79193abf-fab3-354e-bc61-bd326ed399e0",
                                "text": "He is a Mozart in the insect world, sending out his strain upon the evening air."
                            },
                            {
                                "example_id": "19880967-f2c2-4683-9c38-2f35cc3fe819",
                                "sense_id": "79193abf-fab3-354e-bc61-bd326ed399e0",
                                "text": "[W]e can understand how a father who is a good musician may have a son who is a Mozart—a genius in music..."
                            }
                        ]
                    },
                    {
                        "sense_id": "74ebec0e-720c-3cfd-8738-98232006f85f",
                        "entry_id": "d1e75660-1136-30ce-b019-65ef1f4d86ca",
                        "glosses": [
                            "By extension, a virtuoso in any field."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b6a733a-4d43-49bd-a046-a854454351cd",
                                "sense_id": "74ebec0e-720c-3cfd-8738-98232006f85f",
                                "text": "There is a Mozart of competitive eating who is yet to reveal himself."
                            },
                            {
                                "example_id": "4c860cec-ac25-46ad-8452-fb7895e2db7a",
                                "sense_id": "74ebec0e-720c-3cfd-8738-98232006f85f",
                                "text": "Li Po is the most musical, most versatile, and most engaging of Chinese poets, a Mozart of words."
                            },
                            {
                                "example_id": "f50b0a9f-adcb-4892-9dd3-525c32d44fc2",
                                "sense_id": "74ebec0e-720c-3cfd-8738-98232006f85f",
                                "text": "Joyce Carol Oates has said, \"If there is a Mozart of interviewers, Larry Grobel is that individual.\""
                            },
                            {
                                "example_id": "521625af-c271-414c-b501-2fb3544b3381",
                                "sense_id": "74ebec0e-720c-3cfd-8738-98232006f85f",
                                "text": "In contrast, MacDonald's Gibbie is not only a moral prodigy, but also a Mozart of religious sensibility."
                            },
                            {
                                "example_id": "e4ce972a-3fe1-43a1-8283-6ef0b6754496",
                                "sense_id": "74ebec0e-720c-3cfd-8738-98232006f85f",
                                "text": "By the same token, Rembrandt resembled Hawthorne, and the architect who had designed Melrose Abbey was a Mozart among architects."
                            }
                        ]
                    }
                ],
