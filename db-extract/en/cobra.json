                                                "example_id": "a22bf583-6552-4e2c-aebe-586f00d71f6b",
                                                "sense_id": "b3101319-0a5a-3173-8da1-45061438e95c",
                                                "text": "Il y en a un qui doit l'avoir mordu, soit le crotale, soit le naja. Ces bestioles, ça ne pardonne pas."
                                            }
