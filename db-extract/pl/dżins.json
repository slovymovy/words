                "senses": [
                    {
                        "sense_id": "cfa6c98a-0296-35a6-a94a-c5d7cc7ad0ac",
                        "entry_id": "eda3bd57-d34d-3d9c-bc30-3d2936578cc1",
                        "glosses": [
                            "mocna, bawełniana tkanina o skośnym splocie, klasycznie barwiona błękitem indygo, stosowana głównie do produkcji odzieży oraz toreb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201d5deb-7b73-4bcb-b0da-006412aa86fb",
                                "sense_id": "cfa6c98a-0296-35a6-a94a-c5d7cc7ad0ac",
                                "text": "W tym sezonie modne są sukienki z dżinsu."
                            },
                            {
                                "example_id": "177cc127-5fd0-47ba-9a85-ab68a1690ed8",
                                "sense_id": "cfa6c98a-0296-35a6-a94a-c5d7cc7ad0ac",
                                "text": "Ubierał się ze smakiem w markowe dżinsy marki Wrangler i kurtkę tej samej firmy. Ciuchy kupował w peweksie, bo – jak mówił – polski dżins z „Odry” to zafarbowany na niebiesko materiał na worki do pyrów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19dbe711-931a-49f1-88a9-5046c0a2131e",
                        "source_entry_id": "eda3bd57-d34d-3d9c-bc30-3d2936578cc1",
                        "source_sense_id": "cfa6c98a-0296-35a6-a94a-c5d7cc7ad0ac",
                        "target_lang_word": "denim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                        "entry_id": "d00507c7-ab5d-3d96-89ab-3eacf5700883",
                                        "glosses": [
                                            "A textile often made of cotton with a distinct diagonal pattern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dff5bf2-f6fd-4576-b84b-84ff32fb4f73",
                                                "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                                "text": "The Mexican people want a cheaper grade of drillings, sheetings, denims, and other fabrics than are called for in our domestic markets, and purchase them in England because they can not be bought in the United States."
                                            },
                                            {
                                                "example_id": "0d60a42d-a3aa-4b55-923f-ba47fb16d1ff",
                                                "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                                "text": "Fabrics: Gamine fabrics are informal as possible. For sports: tweeds, flannels, suedes, cottons, and denims;"
                                            },
                                            {
                                                "example_id": "8f2749e9-fa7c-4440-a524-4865e46bd5cd",
                                                "sense_id": "35fba45c-4424-3720-a216-de874d3fb1dc",
                                                "text": "Indigo, a typical member of this group of dyes, is widely used on denims and other fabrics for work clothes because of its very low cost and excellent fastness to washing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
