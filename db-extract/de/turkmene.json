                                "example_id": "b9eacbd6-84e0-4e56-ba0f-24c6f96d6481",
                                "sense_id": "cc763c74-334e-35f4-8fc1-134efb28de74",
                                "text": "Turkmenistans Einwohner sind zu circa 77,0 % Turkmenen, 9,2 % Usbeken, 6,7 % Russen, 2 % Kasachen, 1,1 % Tataren, je 0,8 % Armenier, Aserbaidschaner, Beludschen und 0,5 % Ukrainer."
                            }
