                        "sense_id": "af0d2e9b-e896-3faf-ae34-2901ddf45522",
                        "entry_id": "4f0f1cbe-9be1-37ee-a508-296fe75af13c",
                        "glosses": [
                            "de gemoedstoestand die past bij een feestelijke gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ab2300-11c7-4e24-9802-e9423e9b6abd",
                                "sense_id": "af0d2e9b-e896-3faf-ae34-2901ddf45522",
                                "text": "Niet dat er veel reden was voor een feeststemming. Het leek alsof de oorlogsjaren zich herhaalden. Boter, kaas en eieren waren alleen op de bon te krijgen."
                            },
                            {
                                "example_id": "cb673fa9-9a66-4651-8885-1467a90196e5",
                                "sense_id": "af0d2e9b-e896-3faf-ae34-2901ddf45522",
                                "text": "Gertjan Verbeek ging een jaar geleden aan de slag als trainer van Adelaide United, waarmee hij meteen de beker won. Maar van een feeststemming is momenteel geen sprake meer in huize-Verbeek. De coach krijgt geen salaris en vertrekt komende week naar Nederland."
                            }
                        ]
                    }
