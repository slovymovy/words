                "senses": [
                    {
                        "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                        "entry_id": "4dfce87e-fee1-3f13-823a-e882fe1390a9",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0341a3ee-e84d-4ff9-843d-c06ba0a52913",
                                "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                                "text": "Frau Gerhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7c2f3c46-82a4-4bf5-9706-1976cbd1f85d",
                                "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                                "text": "Herr Gerhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c5302603-3766-4cfe-b6af-1a14e1670c83",
                                "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                                "text": "Die Gerhardts fliegen heute nach Boston."
                            },
                            {
                                "example_id": "2cc53143-5a86-45dd-b9cf-5da6ed46eee7",
                                "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                                "text": "Der Gerhardt trägt nie die Pullover, die die Gerhardt ihm strickt."
                            },
                            {
                                "example_id": "75c97d50-c97c-45a6-9876-ebf5f412847a",
                                "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gerhardt kommt, geht der Herr Gerhardt.“"
                            },
                            {
                                "example_id": "0c6e8eba-f6e9-4144-8c3b-6fc364e439d7",
                                "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                                "text": "Gerhardt kommt und geht."
                            },
                            {
                                "example_id": "a604b01d-c847-4f56-9947-610082ccbe78",
                                "sense_id": "c6fa2c2a-e9e2-3b9f-a14f-9645b57d2c2d",
                                "text": "Gerhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
