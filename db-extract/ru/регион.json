                    {
                        "translation_id": "1c96e38f-3732-4164-9e26-8cbe716ae74d",
                        "source_entry_id": "e77e3a48-a6de-3a49-9d1d-c2d9562177be",
                        "source_sense_description": "область",
                        "target_lang_word": "Region",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Region",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                        "entry_id": "f47558a7-cfed-31cb-a78e-68ec86efb095",
                                        "glosses": [
                                            "ein Bereich beziehungsweise ein Gebiet, das (geografisch, politisch oder in Bezug auf die Verwaltung) eine Einheit bildet und mehrere Städte und Gemeinden umfasst, aber auch über Landesgrenzen hinweggehen kann"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c710050e-131c-437d-9a3b-21609ee4921c",
                                                "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                                "text": "Die Region um den Bodensee lebt vom internationalen Austausch."
                                            },
                                            {
                                                "example_id": "26452419-54a1-48f9-b9ee-fe18d58dd4d1",
                                                "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                                "text": "„Es war nicht zuletzt der wissenschaftliche Positivismus des späten 19. Jahrhunderts, der die Erforscher außereuropäischer Regionen und Kulturen wieder zu Jägern und Sammlern werden ließ.“"
                                            },
                                            {
                                                "example_id": "5dddbd16-3111-413e-b1ef-3294c95d2e43",
                                                "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                                "text": "„Um diese Streitereien zu beenden, treffen die freien Männer einer Region schon bald regelmäßig zusammen.“"
                                            },
                                            {
                                                "example_id": "b7fca65c-62a3-4962-a321-cf738fb310c1",
                                                "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                                "text": "„Diese Region wurde schon früh von den Wikingern besiedelt.“"
                                            },
                                            {
                                                "example_id": "6a4f0347-e286-416c-a4d0-f8c6fcd41bc2",
                                                "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                                "text": "[…] „Der Wohnungsmangel hat auch ländliche Regionen erreicht.“"
                                            },
                                            {
                                                "example_id": "6d53d3e9-395f-4b1f-89c1-5c75caa918d7",
                                                "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                                "text": "„Die Grenzen der in der Tabelle definierten Regionen sind im Übergangsbereich zu benachbarten Regionen fließend.“"
                                            },
                                            {
                                                "example_id": "f931fbdb-fb26-4df7-8515-49f23155397f",
                                                "sense_id": "978c41c4-f739-3b1d-b5fa-40b80c93d38d",
                                                "text": "„Es muss einen Extrembergsteiger schon frustrieren, wenn die Regionen, in die er vorgedrungen ist, heutzutage sogar von kletternden Hausfrauen erreicht werden - wenn sie denn genügend Kleingeld haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f276a39-8b57-3afb-8a12-44a7f855cea6",
                                        "entry_id": "f47558a7-cfed-31cb-a78e-68ec86efb095",
                                        "glosses": [
                                            "Bereich, auf den man Einfluss hat; Wirkungskreis"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae636a2-2ccb-42da-ab99-b8f679aa9386",
                                                "sense_id": "8f276a39-8b57-3afb-8a12-44a7f855cea6",
                                                "text": "„Es muss einen Extrembergsteiger schon frustrieren, wenn die Regionen, in die er vorgedrungen ist, heutzutage sogar von kletternden Hausfrauen erreicht werden - wenn sie denn genügend Kleingeld haben.“"
                                            },
                                            {
                                                "example_id": "e0d1eac0-3b80-4fa2-9b2b-376315295400",
                                                "sense_id": "8f276a39-8b57-3afb-8a12-44a7f855cea6",
                                                "text": "„Dadurch eben, dass das Denken etwas Höheres, als die Wirklichkeit seyn, von ihr sich entfernt in höheren Regionen halten soll, dasselbe also selbst als ein Sollen bestimmt ist, geht es einer Seits nicht zum Begriffe fort, und geschieht ihm andererseits, dass es sich ebenso unwahr gegen die Wirklichkeit als gegen den Begriff verhält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4750fec2-0b0f-3067-b681-7fce4553c982",
                                        "entry_id": "f47558a7-cfed-31cb-a78e-68ec86efb095",
                                        "glosses": [
                                            "Bereich eines Teils eines Körpers oder seiner Oberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3deb3ec-aea3-432b-944f-0f258a993472",
                                                "sense_id": "4750fec2-0b0f-3067-b681-7fce4553c982",
                                                "text": "Die Schmerzen in der Region der Schulter verschwanden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
