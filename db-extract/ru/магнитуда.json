                "translations": [
                    {
                        "translation_id": "ddd90823-7519-4959-b1da-515c633e7f3d",
                        "source_entry_id": "3bb7aab4-683b-3629-b69e-c8f878a48042",
                        "source_sense_id": "13fbd56a-121d-3144-9a9a-f26e9004ad47",
                        "target_lang_word": "magnitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f850e8e-ab58-3236-bcb0-6dbe38839bd5",
                                        "entry_id": "d694d419-5836-32bf-99ae-216d02eb9c94",
                                        "glosses": [
                                            "The absolute or relative size, extent or importance of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91ef6a41-0db8-4bdb-99b3-005243040b63",
                                                "sense_id": "2f850e8e-ab58-3236-bcb0-6dbe38839bd5",
                                                "text": "And on a programme of works of this magnitude, passengers will need to be mindful of the age-old maxim of 'no gain without pain'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03d4931a-85e0-3d72-8e10-bb96542dc919",
                                        "entry_id": "d694d419-5836-32bf-99ae-216d02eb9c94",
                                        "glosses": [
                                            "An order of magnitude."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1456575-d260-3d4f-8a84-cb0bb66b1612",
                                        "entry_id": "d694d419-5836-32bf-99ae-216d02eb9c94",
                                        "glosses": [
                                            "A number, assigned to something, such that it may be compared to others numerically"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1387be0-8c1f-397e-9a46-d84588783230",
                                        "entry_id": "d694d419-5836-32bf-99ae-216d02eb9c94",
                                        "glosses": [
                                            "Of a vector, the norm, most commonly, the two-norm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9819323-8765-37b0-ba74-f82ea5267988",
                                        "entry_id": "d694d419-5836-32bf-99ae-216d02eb9c94",
                                        "glosses": [
                                            "A logarithmic scale of brightness defined so that a difference of 5 magnitudes is a factor of 100.",
                                            "The apparent brightness of a star, with lower magnitudes being brighter; apparent magnitude"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea5c9d70-ac3b-3fa6-81ba-cf0d66db75b7",
                                        "entry_id": "d694d419-5836-32bf-99ae-216d02eb9c94",
                                        "glosses": [
                                            "A logarithmic scale of brightness defined so that a difference of 5 magnitudes is a factor of 100.",
                                            "A ratio of intensity expressed as a logarithm."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb27ecc0-a384-4d04-96d7-d9612429c5af",
                                                "sense_id": "ea5c9d70-ac3b-3fa6-81ba-cf0d66db75b7",
                                                "text": "Observations in the infrared domain allow one to penetrate the ~25-30 magnitudes of extinction present at visible wavelengths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e666b6fe-1442-3227-a39a-05439376e26e",
                                        "entry_id": "d694d419-5836-32bf-99ae-216d02eb9c94",
                                        "glosses": [
                                            "A measure of the energy released by an earthquake (e.g. on the Richter scale)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52835ffd-b6df-47e8-b088-d21d1983c55f",
                        "source_entry_id": "3bb7aab4-683b-3629-b69e-c8f878a48042",
                        "source_sense_id": "13fbd56a-121d-3144-9a9a-f26e9004ad47",
                        "target_lang_word": "magnitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86e971a9-6102-3630-b070-cd34385d8720",
                                        "entry_id": "e94d2f98-5b80-330d-9b58-56fe784aa2ab",
                                        "glosses": [
                                            "Grandeur."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cafaf81-d458-4cb2-a0a9-0e09a57c2dab",
                                                "sense_id": "86e971a9-6102-3630-b070-cd34385d8720",
                                                "text": "Chez les Juifs de France, l’inquiétude des cœurs maintenue jusqu’au dernier jour par le secret rigoureux dont Israël entoura les opérations se changea, lorsque la victoire fut certaine et sa magnitude connue, en une explosion de soulagement, de joie, de fierté qu’on a peine à imaginer aujourd’hui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10267a8-73a8-3d13-91b9-6cf0e6bef0cd",
                                        "entry_id": "e94d2f98-5b80-330d-9b58-56fe784aa2ab",
                                        "glosses": [
                                            "Ampleur, en parlant d’un séisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9430a61-7f15-40f3-ab68-5c15f0513259",
                                                "sense_id": "e10267a8-73a8-3d13-91b9-6cf0e6bef0cd",
                                                "text": "« Le nombre de ces séismes augmente, ainsi que la magnitude des plus puissants d'entre eux. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68827658-42df-3298-9e65-1de618d9dabc",
                                        "entry_id": "e94d2f98-5b80-330d-9b58-56fe784aa2ab",
                                        "glosses": [
                                            "Mesure logarithmique exprimant la luminosité d’un astre tel qu’il est observé depuis la Terre (magnitude apparente) ou intrinsèquement (magnitude absolue), une valeur plus élevée correspondant à une luminosité plus faible."
                                        ],
                                        "tags": [
                                            "Astronomie observationnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be6848f9-f9e4-4356-8738-f082c8c8100b",
                                                "sense_id": "68827658-42df-3298-9e65-1de618d9dabc",
                                                "text": "Ayant établi que la magnitude de l’étoile Polaire valait exactement 2,0, Pogson constata que la magnitude des étoiles les plus brillantes s’avérait négative (c’est ainsi que la magnitude de Sirius vaut officiellement – 1,46). Depuis l’époque de Pogson, les astronomes se sont rendu compte que l’étoile Polaire était très légèrement variable ; l’étoile de référence est donc maintenant Véga (alpha de la Lyre), définie comme étant de magnitude 0,0."
                                            },
                                            {
                                                "example_id": "986cf25b-2799-4492-b5d6-7d4540b5a9f5",
                                                "sense_id": "68827658-42df-3298-9e65-1de618d9dabc",
                                                "text": "Altaïr est l’étoile la plus brillante de la constellation de l’Aigle. De magnitude apparente 0,762, elle est la douzième étoile la plus brillante de la voûte céleste."
                                            },
                                            {
                                                "example_id": "a4dc4a44-b4e1-4efa-a845-93bc584c2e21",
                                                "sense_id": "68827658-42df-3298-9e65-1de618d9dabc",
                                                "text": "L’Almageste, de l’astronome grec Claude Ptolémée (IIᵉ siècle) référence 1,026 étoiles et, pour la première fois, les classe en six degrés de luminosité appelés « magnitudes »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
