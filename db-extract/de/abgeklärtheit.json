                    {
                        "sense_id": "1f411593-1a02-39d7-8fe2-16df2707153f",
                        "entry_id": "0cf5b5d1-05c9-3222-8afe-c9bbbafeb5bb",
                        "glosses": [
                            "durch Lebenserfahrung erlangte Besonnenheit, unerschütterliche Ruhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c3805a-780c-46b7-9095-7fc3a7dd9020",
                                "sense_id": "1f411593-1a02-39d7-8fe2-16df2707153f",
                                "text": "Der Innenverteidiger erledigte seine schwierige Aufgabe mit einer für sein Alter erstaunlichen Abgeklärtheit."
                            },
                            {
                                "example_id": "09727b38-c6aa-4ab0-b678-212767da1e8c",
                                "sense_id": "1f411593-1a02-39d7-8fe2-16df2707153f",
                                "text": "„Es ist leicht, mit dem Wissen von heute und in der Abgeklärtheit des Historikers, ohne die emotionale Berührtheit der Betroffenen, auf die Ereignisse vor 50 Jahren und danach zu schauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95f1f55c-b06c-4772-a333-705e4ed6aec2",
                        "source_entry_id": "0cf5b5d1-05c9-3222-8afe-c9bbbafeb5bb",
                        "source_sense_id": "1f411593-1a02-39d7-8fe2-16df2707153f",
                        "source_sense_description": "durch Lebenserfahrung erlangte Besonnenheit, unerschütterliche Ruhe",
                        "target_lang_word": "serenity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serenity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "353076e1-7d82-3dc7-b9fd-37d575f7ca88",
                                        "entry_id": "bedd6976-14da-3d4c-8048-a7d0cebf283f",
                                        "glosses": [
                                            "The state of being serene; calmness; peacefulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4b39d0-6888-4131-8ad6-da665d19401d",
                                                "sense_id": "353076e1-7d82-3dc7-b9fd-37d575f7ca88",
                                                "text": "Forthwith a change came over the waters, and the serenity became less brilliant but more profound."
                                            },
                                            {
                                                "example_id": "d7bed98c-0da5-47c0-825f-00ac769d3926",
                                                "sense_id": "353076e1-7d82-3dc7-b9fd-37d575f7ca88",
                                                "text": "There is no passion, there is serenity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1bd3b8e-87c2-3cda-829e-a0bb5b2ff476",
                                        "entry_id": "bedd6976-14da-3d4c-8048-a7d0cebf283f",
                                        "glosses": [
                                            "A lack of agitation or disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7bb2e36-c05f-3655-ae7a-79f4d3ffbc18",
                                        "entry_id": "bedd6976-14da-3d4c-8048-a7d0cebf283f",
                                        "glosses": [
                                            "A title given to a reigning prince or similar dignitary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc95a742-0ceb-4d55-a055-8daada5ec3fa",
                        "source_entry_id": "0cf5b5d1-05c9-3222-8afe-c9bbbafeb5bb",
                        "source_sense_id": "1f411593-1a02-39d7-8fe2-16df2707153f",
                        "source_sense_description": "durch Lebenserfahrung erlangte Besonnenheit, unerschütterliche Ruhe",
                        "target_lang_word": "prudence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prudence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                        "entry_id": "a6ec378f-2594-3d91-9b4a-fe7511c1a1d4",
                                        "glosses": [
                                            "The quality or state of being prudent: circumspection and good judgment in knowing how best to act; (countable, archaic) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f917a1d-4f0a-4a33-b21b-eb2086dc336e",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "[T]here are ſo many concurrencies vvhich have their attending cheques; vvhich poſſible are to be, but actually, vvere not improved in remedy that the prevalence of the Fire againſt, and in deſpight of thoſe vvonted prudences, and uſual reſiſtances, and the Latitude of effects, ſeconding ſuch a neglect of impending means, vvhere ſo vvell underſtood, and ſo dextrouſly at other times practiſed; […]"
                                            },
                                            {
                                                "example_id": "6f949e53-0261-43e1-8e9a-83713b6fdb27",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "Concerning intellectual Habits or the genuine effects of theſe acts in the underſtanding Faculty, and they are divers and diverſly expreſſed by thoſe that have treated thereof. […] Prudence, vvhich is principally in reference to actions to be done, the due means, order, ſeaſon, method of doing or not doing."
                                            },
                                            {
                                                "example_id": "de19f6cb-47bc-4993-b3e0-f3887b341b0f",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "Prudence, like experience, must be paid for."
                                            },
                                            {
                                                "example_id": "7bc2ff5f-b9b4-4cbf-9716-fcd150671d44",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "[U]nder pretence of carrying in a pitcher of vvater, he entered the priſon, though, his prudence having prevented him from telling the ſentinel the real motive of his viſit, he vvas obliged to make his conference vvith the priſoner a very ſhort one."
                                            },
                                            {
                                                "example_id": "a6442ab3-438c-46b4-b28f-7311f8e618e1",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "Novv as I don't much chuſe to have my girls go to theſe ſort of places often, vvhich is a prudence that I dare ſay you approve as much as myſelf, I vvould vviſh to have the moſt made of them at once; […]"
                                            },
                                            {
                                                "example_id": "2d197e53-56ea-41d7-a129-77dfc02fc27a",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "Mrs. Varden approved of this meek and forgiving spirit in high terms, and incidentally declared as a closing article of agreement, that Dolly should accompany her to the Clerkenwell branch of the association, that very night. This was an extraordinary instance of her great prudence and policy; having had this end in view from the first, and entertaining a secret misgiving that the locksmith (who was bold when Dolly was in question) would object, she had backed Miss Miggs up to this point, in order that she might have him at a disadvantage."
                                            },
                                            {
                                                "example_id": "b95e6d60-daf0-43b4-bd2f-072dfd4371ed",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "A man is prudent, who acts so as to promote his own Interest, if his Interest be assumed to be the proper Object of action: but if we conceive Happiness to be a higher object than Interest, he is prudent, if he disregard mere Interest, and attend only to his Happiness. Prudence supposes the value of the end to be assumed, and refers only to the adaptation of the means. It is the selection of right means for given ends."
                                            },
                                            {
                                                "example_id": "3050d0e9-4826-4786-b64e-62a2036c7bd7",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "\"You mistake,\" cried the doctor, startled out of all his prudences; \"it ought to be my business quite as much as it is yours.\""
                                            },
                                            {
                                                "example_id": "af752aa5-4fbc-4679-8812-6cbd6f0579ad",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "She heard her ask, irritated and sombre, what tone, in God's name—since her bravery didn't suit him—she was then to adopt; and, by way of a fantastic flight of divination, she heard Amerigo reply, in a voice of which every fine note, familiar and admirable, came home to her, that one must really manage such prudences a little for one's self."
                                            },
                                            {
                                                "example_id": "3bf2a3c1-7b6e-4e3f-8ef6-245dfceaecfd",
                                                "sense_id": "792d04ef-4ae8-3b8c-b9a6-93494f9706d5",
                                                "text": "With 3,600 h.p. underfoot, acceleration was reasonably brisk, but the flickering wheel-slip indicator light showed the prudence of not putting full power through the traction motors while there were traces of early-morning dampness on the rails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ef73ed-f89d-3e11-ae93-99d2c23032b4",
                                        "entry_id": "a6ec378f-2594-3d91-9b4a-fe7511c1a1d4",
                                        "glosses": [
                                            "Synonym of frugality (“the quality of avoiding unnecessary expenditure; economy, parsimony, thrift, thriftiness”)."
                                        ],
                                        "tags": [
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7804febc-248b-3194-944d-1cc308c9650a",
                                        "entry_id": "a6ec378f-2594-3d91-9b4a-fe7511c1a1d4",
                                        "glosses": [
                                            "Synonym of providence (“preparation for the future; foresight”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4c22c01-cb8f-41e3-b6ad-fe4899b995d9",
                                                "sense_id": "7804febc-248b-3194-944d-1cc308c9650a",
                                                "text": "For 'tis my ſetled Opinion, that Divine Prudence is often, at leaſt, converſant in a peculiar manner about the Actions of Men, and the things that happen to Them, or have a neceſſary Connexion vvith the One, or the Other, or Both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b33c6e-5225-3aee-83e5-dc9446542f5e",
                                        "entry_id": "a6ec378f-2594-3d91-9b4a-fe7511c1a1d4",
                                        "glosses": [
                                            "Synonym of wisdom (“an element of personal character that enables one to distinguish the wise from the unwise; wise advice”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e803893-2fe8-4930-912a-1f95ddcf350a",
                                                "sense_id": "86b33c6e-5225-3aee-83e5-dc9446542f5e",
                                                "text": "Children here ye the fathers diſcipline, and attend that you may knovve prudence."
                                            },
                                            {
                                                "example_id": "ccf299ab-78ed-4c6c-91e4-daa44f5ddf72",
                                                "sense_id": "86b33c6e-5225-3aee-83e5-dc9446542f5e",
                                                "text": "[H]e [Pythagoras] vvent from Ægypt to the Perſians, (not to Perſia, as ſome conceive) and reſigned himſelf to the moſt exact prudence of the Magi, to be formed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e52c896-1fbb-4cbe-b2ec-4b0e600c76f8",
                        "source_entry_id": "0cf5b5d1-05c9-3222-8afe-c9bbbafeb5bb",
                        "source_sense_id": "1f411593-1a02-39d7-8fe2-16df2707153f",
                        "source_sense_description": "durch Lebenserfahrung erlangte Besonnenheit, unerschütterliche Ruhe",
                        "target_lang_word": "sérénité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sérénité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4fc6ddf-0e5e-3ee2-9abb-4a52dc26623a",
                                        "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                                        "glosses": [
                                            "État du temps, de l’air qui est serein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a81805-b6ad-40e6-a9cf-affc572e717c",
                                                "sense_id": "a4fc6ddf-0e5e-3ee2-9abb-4a52dc26623a",
                                                "text": "La sérénité de l’air, du temps, du ciel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                        "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                                        "glosses": [
                                            "Tranquillité, calme, absence de trouble ou d’agitation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02c97fbb-82f7-403f-9339-62836cb661ac",
                                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                                "text": "Brusquement, il poussa une porte, entra, et vit Giselle debout, si calme, une telle sérénité dans ses yeux, où il n'y avait ni crainte, ni défi, ni pas même du dédain, qu'il s'arrêta, pâle comme un mort."
                                            },
                                            {
                                                "example_id": "fb0e42de-e1b2-4b66-b6b7-bfbea3eec847",
                                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                                "text": "Il siégeait, au fond, sur une banquette, et fumait un cigare. Une indéniable sérénité se reflétait sur ses traits. Peut-être était-ce l’apaisante influence du cigare […]"
                                            },
                                            {
                                                "example_id": "7d945b38-bc3a-4900-86c2-468fd44734eb",
                                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                                "text": "L’archéologie et l’anthropologie locales sont coutumières, on le sait, d’une grande sérénité dans l’affirmation. Ledit Poignant ne s’en est pas tenu là : à une portée de fusil du tombeau de Merlin, l’« archidruide », il a retrouvé le tombeau de « son épouse » Viviane !"
                                            },
                                            {
                                                "example_id": "59f7d103-94f2-4b84-9cdb-daaa35047de7",
                                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                                "text": "Rien ne trouble la sérénité de ses jours, rien ne trouble le calme dont il jouit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1a4a6e-f509-3c06-8748-c5fa2b2e6552",
                                        "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                                        "glosses": [
                                            "Titre honorifique qu’on donnait à quelques souverains et à quelques princes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb8a122e-23e2-49ab-b027-f50fcd19da6d",
                                                "sense_id": "fa1a4a6e-f509-3c06-8748-c5fa2b2e6552",
                                                "text": "On traitait le doge de Venise, le doge de gênes de Sérénité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
