                        "entry_id": "deba27b9-927c-3c18-916b-c54b50a1e7bf",
                        "glosses": [
                            "lub określenie męża"
                        ],
                        "tags": [
                            "colloquial",
                            "endearing",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "e928f841-12d1-40b6-ae20-ff64afbaada8",
                                "sense_id": "e21de5f6-5e24-3860-b837-3de628eb1b28",
                                "text": "Barbórka wciąż zerka na swojego mężusia."
                            },
                            {
                                "example_id": "7851d6e5-3367-4048-9a85-7571142c8498",
                                "sense_id": "e21de5f6-5e24-3860-b837-3de628eb1b28",
                                "text": "Mężuś myśli, że ja nie wiem, ile on zarabia, a ja co miesiąc odbieram jego wyciągi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c73acd1-4437-4f62-958b-83c08f9285f0",
                        "source_entry_id": "deba27b9-927c-3c18-916b-c54b50a1e7bf",
                        "source_sense_id": "e21de5f6-5e24-3860-b837-3de628eb1b28",
                        "target_lang_word": "hubby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hubby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e495c87-f011-331a-a0ae-0f4f2802a788",
                                        "entry_id": "4ecc19ce-741a-37db-a124-946a517ff875",
                                        "glosses": [
                                            "Husband."
                                        ],
                                        "tags": [
                                            "endearing",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6721eb9d-b1d4-483e-9ccf-496b6e12f947",
                                                "sense_id": "1e495c87-f011-331a-a0ae-0f4f2802a788",
                                                "text": "Laura thought Jack was the most wonderful hubby in the world."
                                            },
                                            {
                                                "example_id": "971291df-32b1-4e21-bcb9-c4fff7d2e042",
                                                "sense_id": "1e495c87-f011-331a-a0ae-0f4f2802a788",
                                                "text": "“But they have done more than talk — they have written — written to my hubby — I'm sure of it,” said the Man's Wife, and she pulled a letter from her husband out of her saddle-pocket and gave it to the Tertium Quid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hubby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8c0f73f-8267-363c-8d29-04904d652407",
                                        "entry_id": "f7d7746e-876a-3e27-92a9-5dfaa22e2f94",
                                        "glosses": [
                                            "Full of hubs or protuberances."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bfe620-583e-422e-842f-730e748c96d0",
                                                "sense_id": "c8c0f73f-8267-363c-8d29-04904d652407",
                                                "text": "A road that has been frozen while muddy is hubby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
