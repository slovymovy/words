                "senses": [
                    {
                        "sense_id": "38fbcd15-dde2-3abd-8beb-9d5ebef3e8f2",
                        "entry_id": "944cd41f-042f-3d8f-ac0c-6c0c45f79f54",
                        "glosses": [
                            "o wielbłądach: mający jeden garb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b89c26-140b-4932-995f-6cd6292c42be",
                                "sense_id": "38fbcd15-dde2-3abd-8beb-9d5ebef3e8f2",
                                "text": "Wielbłądy jako zwierzęta hodowlane są kosmopolityczne. Występują w postaci dwóch gatunków: wielbłąd jednogarbny (dromader) i dwugarbny"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
