                "senses": [
                    {
                        "sense_id": "1360cd16-9b8b-3ad2-9add-802e8403a124",
                        "entry_id": "f73ebbc3-1c73-345a-a690-78d01312790f",
                        "glosses": [
                            "Person, die im Krieg Ruhm erworben hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "773a8988-6edf-4119-aa24-00d61e7d0fc7",
                                "sense_id": "1360cd16-9b8b-3ad2-9add-802e8403a124",
                                "text": "„Alle ihre Spiele sind Soldatenspiele mit dem einen Ziel, den großen Kriegshelden nachzueifern.“"
                            },
                            {
                                "example_id": "601f305a-4043-4b83-b903-fbd9822b7f0f",
                                "sense_id": "1360cd16-9b8b-3ad2-9add-802e8403a124",
                                "text": "„So wurde Robert Clive zum Kriegshelden und Gouverneur von Bengalen, und Warren Hastings, der erste Generalgouverneur Indiens, kam im Alter von 39 Jahren auf diesen hohen Posten und wurde zu einem bedeutenden «empire builder», der die britische Territorialherrschaft weit über Bengalen ausdehnte.“"
                            },
                            {
                                "example_id": "9493da71-d863-4b44-997e-0094a5b6303d",
                                "sense_id": "1360cd16-9b8b-3ad2-9add-802e8403a124",
                                "text": "„Angeblich war ich ein Kriegsheld, dabei hab ich einen ganzen Zug Leute verloren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd65da5f-77ac-44da-9e96-d5d90e485328",
                        "source_entry_id": "f73ebbc3-1c73-345a-a690-78d01312790f",
                        "source_sense_id": "1360cd16-9b8b-3ad2-9add-802e8403a124",
                        "source_sense_description": "Person, die im Krieg Ruhm erworben hat",
                        "target_lang_word": "war hero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "war hero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71c9f7af-a84d-3379-b944-b7875432c357",
                                        "entry_id": "2785a56d-e658-31a5-8de3-f6510249de7f",
                                        "glosses": [
                                            "Someone who commits an act of heroism in a combat setting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd28ed0-b5a4-4ad0-ad81-e0f2c2cc6761",
                                                "sense_id": "71c9f7af-a84d-3379-b944-b7875432c357",
                                                "text": "For one, at a very young age he became a war hero who had slain a giant."
                                            },
                                            {
                                                "example_id": "1b4f4789-0194-4fb8-b847-9a79b1560410",
                                                "sense_id": "71c9f7af-a84d-3379-b944-b7875432c357",
                                                "text": "George went off to fight Nazis, later was described as a war hero."
                                            },
                                            {
                                                "example_id": "ab4dfa57-67fc-41d4-b851-9a1c699b9c50",
                                                "sense_id": "71c9f7af-a84d-3379-b944-b7875432c357",
                                                "text": "He apparently found in Rommel a German war hero who shared his doubts and uncertainties."
                                            },
                                            {
                                                "example_id": "0f9f94f5-746e-4a7d-bb2a-fc0fdc6029bb",
                                                "sense_id": "71c9f7af-a84d-3379-b944-b7875432c357",
                                                "text": "Kennedy's presidency is examined for the way it reinforced ideas about him that had come to the fore before he became chief executive: his use of the White House to showcase the arts, thereby strengthening his image as a man of letters and cultural refinement; the enhancing of his war-hero status with the release of the Hollywood film PT-109; the continued eroticization of his image through his public links with Marilyn Monroe, Grace Kelly and Anita Ekberg; and the prominence of his wife, siblings, children and parents in reinforcing the image of JFK as a symbol of the family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
