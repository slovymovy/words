                "senses": [
                    {
                        "sense_id": "348aef8c-05c2-3d8e-8d1e-fc9126d829b6",
                        "entry_id": "2b75f02e-d916-375f-bf3c-a310bdb2e54f",
                        "glosses": [
                            "Sérosités obstruant et comprimant un trompe de Fallope, résultant généralement d’une inflammation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3e0ebd-df98-4704-9843-463fbfe7b26f",
                                "sense_id": "348aef8c-05c2-3d8e-8d1e-fc9126d829b6",
                                "text": "L’hydrosalpinx est la dilatation de la trompe de Fallope par un liquide séreux, clair qui comprime l'épithélium muqueux. Il représente une séquelle d'inflammation tubaire."
                            },
                            {
                                "example_id": "c214ee8f-4ac6-4b0d-af27-a801c32f74d3",
                                "sense_id": "348aef8c-05c2-3d8e-8d1e-fc9126d829b6",
                                "text": "On réalisera aussi une échographie qui pourra soit être normale soit retrouver un épanchement dans le Douglas, des ovaires dystrophiques, des images évocatrices d’hydrosalpinx."
                            }
                        ]
                    }
                ],
