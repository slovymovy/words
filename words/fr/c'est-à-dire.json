            "senses": [
                {
                    "sense_id": "8eeea2e1-2953-3ddc-bbd1-e846a849703b",
                    "sense_definition": "Sert à introduire une explication, une précision ou une reformulation de ce qui précède.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "explication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il viendra la semaine prochaine, <w>c'est-à-dire</w> après les vacances scolaires."
                        },
                        {
                            "text": "Nous serons absents vendredi, <w>c'est-à-dire</w> que le bureau restera fermé toute la journée."
                        }
                    ],
                    "synonyms": [
                        "autrement dit",
                        "à savoir",
                        "en d'autres termes"
                    ],
                    "common_phrases": [
                        "c'est-à-dire que"
                    ]
                },
                {
                    "sense_id": "72195c49-580e-3025-8659-46ee30a251e0",
                    "sense_definition": "Employé pour demander un éclaircissement ou des précisions sur ce qui vient d'être énoncé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "demande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Le projet prendra du retard. — <w>C'est-à-dire</w> ? Peux-tu nous donner une date précise ?"
                        },
                        {
                            "text": "— Il faudra faire des concessions. — <w>C'est-à-dire</w> ? Que nous demandez-vous exactement ?"
                        }
                    ]
                }
            ]
        }
    ]
