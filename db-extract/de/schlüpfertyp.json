                "senses": [
                    {
                        "sense_id": "a1b86799-eb94-3eaf-9cb5-b1df2058d8c4",
                        "entry_id": "82b84ece-0bfa-3702-9780-89d6b3165fe9",
                        "glosses": [
                            "Fluchttyp des Jagdwildes, das bei Gefahr rasch Schutz in dichtem Unterholz oder in Waldrändern sucht"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "4e6cd2c8-e1a8-424a-874b-58a55f8933a6",
                                "sense_id": "a1b86799-eb94-3eaf-9cb5-b1df2058d8c4",
                                "text": "Körperform und Fortbewegungsart ermöglichen den Schlüpfertypen wie Reh- oder Sikawild die rasante Flucht ins dichte Unterholz mit schnellen, kurzen Sprüngen."
                            },
                            {
                                "example_id": "6cbd65af-1b2f-4332-973e-28181519ca70",
                                "sense_id": "a1b86799-eb94-3eaf-9cb5-b1df2058d8c4",
                                "text": "Der sogenannte „Schlüpfertyp“ ist gut an das Dickicht des Waldrandes mit Hecken, Sträuchern, kleinen und großen Bäumen (stufig) angepasst."
                            }
                        ],
                        "sense_index_json": "\"1\""
