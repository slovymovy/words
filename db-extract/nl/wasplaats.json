                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32f34d3d-5e09-4613-a1c9-037ce0d91d63",
                                "sense_id": "e1b23dd8-6a7b-30e4-a9d8-d5981f971d99",
                                "text": "Al vijftig jaar langs wast de Ecuadoriaanse Delia Veloz (74) kleding. Ze poseert hier op een wasplaats in La Ermita, een wijk in Quito, Ecuador."
                            }
                        ]
                    },
                    {
                        "sense_id": "0387f071-d5e7-348f-bf16-d1f8de06537a",
                        "entry_id": "e53b9a53-7a0e-3410-815d-0777b1b40da8",
