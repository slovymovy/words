                "senses": [
                    {
                        "sense_id": "ddd5f972-cdc2-3688-841d-4b686e69076c",
                        "entry_id": "a7c83283-b4c2-30d0-af97-6ee6e2129b3d",
                        "glosses": [
                            "Konzert, dessen Erlös zur Verbesserung der Situation von Bedürftigen oder Organisationen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48199884-2820-43b0-a1a2-57b8ead03760",
                                "sense_id": "ddd5f972-cdc2-3688-841d-4b686e69076c",
                                "text": "„Zum zehnten Todestag 2007 fand ein großes Wohltätigkeitskonzert im Wembley-Stadion statt.“"
                            },
                            {
                                "example_id": "9a52df28-d9fd-4543-b4ff-ebd6b9c338e3",
                                "sense_id": "ddd5f972-cdc2-3688-841d-4b686e69076c",
                                "text": "„Oft ist Ärger die beste Motivation. So war es zumindest bei Damon Albarn, nachdem er 2005 ein gefeiertes Wohltätigkeitskonzert im Londoner Hyde Park besucht hatte.“"
                            }
                        ],
