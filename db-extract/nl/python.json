                    {
                        "sense_id": "120e9dc3-948b-3eac-98f2-dacbaa3219a9",
                        "entry_id": "dca991fa-5488-3423-8b01-7e15696663a6",
                        "glosses": [
                            "geslacht Python van wurgslangen uit de familie pythons (Pythonidae) waarvan de soorten niet giftig zijn en die soms erg lang kunnen worden"
                        ],
                        "tags": [
                            "reptielen"
                        ],
                        "examples": [
                            {
                                "example_id": "e8ced357-d2d5-4ff6-af0a-d92b8ee1c294",
                                "sense_id": "120e9dc3-948b-3eac-98f2-dacbaa3219a9",
                                "text": "Ik ben echt als de dood voor pythons!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0851ed6c-58f8-495b-b744-238864ca182e",
                        "source_entry_id": "dca991fa-5488-3423-8b01-7e15696663a6",
                        "source_sense_id": "120e9dc3-948b-3eac-98f2-dacbaa3219a9",
                        "source_sense_description": "een niet-giftige en grote wurgslang",
                        "target_lang_word": "Python",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Python",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68f4ac70-d52b-3615-b270-ea294c829fe7",
                                        "entry_id": "ae2610bd-2961-31e8-bbba-7b55c2c6f006",
                                        "glosses": [
                                            "Schlange aus der Familie Pythonidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c241ac-71b9-4e6c-b6b0-7432c9928685",
                                                "sense_id": "68f4ac70-d52b-3615-b270-ea294c829fe7",
                                                "text": "Die größten Pythons können Längen von über 10 Metern erreichen, manche Arten werden aber kaum einen Meter lang."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "afbecb53-9a49-35c6-938b-a2f7171de7d2",
                                        "entry_id": "ae2610bd-2961-31e8-bbba-7b55c2c6f006",
                                        "glosses": [
                                            "Vertreter der gleichnamigen Gattung aus der Familie der Pythons^([1])"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8995fc64-fb51-4ef1-ba4b-57fbcd18e748",
                                                "sense_id": "afbecb53-9a49-35c6-938b-a2f7171de7d2",
                                                "text": "Pythons sind überwiegend nachtaktiv."
                                            },
                                            {
                                                "example_id": "a71509c5-2837-4db0-a05c-ba7a5ee74511",
                                                "sense_id": "afbecb53-9a49-35c6-938b-a2f7171de7d2",
                                                "text": "„Auch wer in der Stadt einen Python tötet, muss mit der Todesstrafe rechnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Python",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                        "entry_id": "5196bde0-a18e-3811-8e42-ca2f47b9dfb3",
                                        "glosses": [
                                            "Name einer Open-Source-Scriptsprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff931914-d764-4793-9694-c6a8bc83583f",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "Python 2 ist auf dem Mac für den Einstieg immer noch die bessere Wahl."
                                            },
                                            {
                                                "example_id": "f2dfa131-90bf-47b4-b9f7-e9c6af2eaa16",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„Das macht man nicht mit Maus oder Tastatur, sondern mit Programmierbefehlen in Python oder Javascript, zwei sehr verbreiteten Programmiersprachen.“"
                                            },
                                            {
                                                "example_id": "546e9ad4-91a1-4395-9fc6-296f687c8619",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„Debian und Ubuntu planen die Entfernung von Paketen auf der Basis von Python 2. Der Support für Python 2 endet am 31. Dezember 2019.“"
                                            },
                                            {
                                                "example_id": "c1991266-804d-4d20-a4d5-9cd6e0193d8d",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„Python 3 wurde bereits 2008 eingeführt […].“"
                                            },
                                            {
                                                "example_id": "1526116a-1676-485d-a461-54cc5ca78e39",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„In der wenigen verbleibenden Zeit bis zur offiziellen Einstellung von Python 2 arbeiten beide Projekte daran, Pakete auf Python 3 umzustellen, wo dies möglich ist.“"
                                            },
                                            {
                                                "example_id": "92511b18-5241-4651-9c55-42857e1621ad",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„Python kennt einige Frameworks, die die notwendige Kommunikationsinfrastruktur automatisch erzeugen.“"
                                            },
                                            {
                                                "example_id": "835bcb05-dfe9-455f-bd3c-05c901c5d875",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„Einführung in Machine Learning mit Python – Wir zeigen an Beispieldaten, wie man ein Machine-Learning-Projekt in Python umsetzt.“"
                                            },
                                            {
                                                "example_id": "0a2672d5-8b80-4b10-b374-5aec85661670",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„Die Programmiersprache Python ist zum Schweizer Taschenmesser für Data Scientists geworden.“"
                                            },
                                            {
                                                "example_id": "f884092a-fb9d-403d-8a5c-998ee371ed3a",
                                                "sense_id": "a543b56c-5dfb-3e4e-b051-2587f3e9b880",
                                                "text": "„Python gilt aufgrund seiner Einfachheit in \"professionellen\" Entwicklerkreisen häufig nicht als Programmiersprache der Wahl […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
