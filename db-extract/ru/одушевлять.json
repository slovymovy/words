                                "target_senses": [
                                    {
                                        "sense_id": "8e447227-cba9-33d5-b090-a650d332f908",
                                        "entry_id": "89929cfd-2429-3aed-b8d1-4fb81430fef8",
                                        "glosses": [
                                            "To impart motion or the appearance of motion to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87f0b63d-809b-42a5-b607-f57683dfb196",
                                                "sense_id": "8e447227-cba9-33d5-b090-a650d332f908",
                                                "text": "If we animate the model, we can see the complexity of the action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a426d1-c0ff-3a97-be2d-f29c48761d8b",
                                        "entry_id": "89929cfd-2429-3aed-b8d1-4fb81430fef8",
                                        "glosses": [
                                            "To give spirit or vigour to; to stimulate or enliven; to inspirit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884d9fc9-0133-497b-8407-c5513ba75435",
                                                "sense_id": "f1a426d1-c0ff-3a97-be2d-f29c48761d8b",
                                                "text": "The more to animate the people, he stood on high […] and cried unto them with a loud voice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
