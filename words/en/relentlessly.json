    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c3289a91-ee60-3784-bea3-ebe7a69a5614",
                    "sense_definition": "In a way that is harsh, persistent, and does not stop or become less intense.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun beat down <w>relentlessly</w> on the desert travelers all afternoon.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>беспощадно</w> палило путников в пустыне весь день.",
                                "es": "El sol caía <w>implacablemente</w> sobre los viajeros del desierto durante toda la tarde."
                            }
                        },
                        {
                            "text": "The company <w>relentlessly</w> pursues innovation to stay ahead of its competitors.",
                            "target_lang_translations": {
                                "ru": "Компания <w>неустанно</w> стремится к инновациям, чтобы опережать своих конкурентов.",
                                "es": "La empresa busca la innovación <w>incansablemente</w> para mantenerse por delante de sus competidores."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistently",
                        "incessantly",
                        "unceasingly",
                        "unremittingly"
                    ],
                    "common_phrases": [
                        "pursue relentlessly",
                        "beat down relentlessly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, характеризующийся суровостью, настойчивостью и отсутствием остановок или снижения интенсивности.",
                        "es": "De manera implacable, constante y sin perder intensidad ni detenerse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспощадно",
                                "target_lang_sense_clarification": "подчеркивает суровость и отсутствие жалости"
                            },
                            {
                                "target_lang_word": "неустанно",
                                "target_lang_sense_clarification": "подчеркивает постоянство и отсутствие усталости"
                            },
                            {
                                "target_lang_word": "непрерывно",
                                "target_lang_sense_clarification": "подчеркивает отсутствие пауз или остановок"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "implacablemente",
                                "target_lang_sense_clarification": "enfatiza la severidad y la falta de tregua o piedad"
                            },
                            {
                                "target_lang_word": "incansablemente",
                                "target_lang_sense_clarification": "enfatiza la perseverancia y el esfuerzo continuo"
                            },
                            {
                                "target_lang_word": "incesantemente",
                                "target_lang_sense_clarification": "enfatiza la repetición continua sin pausas ni interrupciones"
                            },
                            {
                                "target_lang_word": "sin descanso",
                                "target_lang_sense_clarification": "locución común que resalta la persistencia continua"
                            }
                        ]
                    }
                }
            ]
        }
    ]
