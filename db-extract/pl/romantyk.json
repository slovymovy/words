                "senses": [
                    {
                        "sense_id": "2e833d5b-b931-3444-aece-a949f1738df8",
                        "entry_id": "e133481f-16dc-37b0-9e48-756d4d83ff73",
                        "glosses": [
                            "artysta tworzący zgodnie z założeniami romantyzmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44104431-5352-4bed-906b-02e70b73a28e",
                                "sense_id": "2e833d5b-b931-3444-aece-a949f1738df8",
                                "text": "Adam Mickiewicz należy do romantyków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "26d5fad2-99cd-3377-a7ab-399413f787bc",
                        "entry_id": "e133481f-16dc-37b0-9e48-756d4d83ff73",
                        "glosses": [
                            "mężczyzna romantyczny, uczuciowy, sentymentalny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8dbe6c5-16ce-454c-843c-e83a05002186",
                                "sense_id": "26d5fad2-99cd-3377-a7ab-399413f787bc",
                                "text": "Mój narzeczony jest romantykiem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32af247e-e6ab-4762-9b38-9ba1953ffa45",
                        "source_entry_id": "e133481f-16dc-37b0-9e48-756d4d83ff73",
                        "source_sense_id": "2e833d5b-b931-3444-aece-a949f1738df8",
                        "target_lang_word": "Romantiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romantiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e92099b-a19d-3e09-bf0d-ccac01363e8f",
                                        "entry_id": "06402fcb-a1c8-341b-b48d-92d30e84795f",
                                        "glosses": [
                                            "romantische, gefühlsbetonte Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b4b1eb7-e15f-4320-a442-e0e5d6c91549",
                                                "sense_id": "8e92099b-a19d-3e09-bf0d-ccac01363e8f",
                                                "text": "Er hat ihr abends wieder Blumen mitgebracht. Was für ein Romantiker!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc153cec-68ba-3184-a338-004704b857d0",
                                        "entry_id": "06402fcb-a1c8-341b-b48d-92d30e84795f",
                                        "glosses": [
                                            "Vertreter der kulturgeschichtlichen Epoche Romantik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd91ea9-7812-4736-b048-bbe407ada357",
                                                "sense_id": "fc153cec-68ba-3184-a338-004704b857d0",
                                                "text": "„Die aufklärerische Fetischisierung der Nützlichkeit wurde nicht erst von den Romantikern lächerlich gemacht.“"
                                            },
                                            {
                                                "example_id": "44c21b06-816d-4dbc-91fa-72d397628091",
                                                "sense_id": "fc153cec-68ba-3184-a338-004704b857d0",
                                                "text": "„Für die Romantiker war es gar nicht so schwer, die Welt zum Klingen zu bringen, wenn man über die Wünschelrute dazu verfügt.“"
                                            },
                                            {
                                                "example_id": "6e37f35c-0787-4e71-877d-c8792438440f",
                                                "sense_id": "fc153cec-68ba-3184-a338-004704b857d0",
                                                "text": "„Ende August 1839 machte er sich auf den Weg, zu Fuß, wie es sich für einen Romantiker von selbst verstand.“"
                                            },
                                            {
                                                "example_id": "b10f4360-37a4-4ba2-8680-228fa519e704",
                                                "sense_id": "fc153cec-68ba-3184-a338-004704b857d0",
                                                "text": "„Einmal waren die Romantiker, wie man an Caroline Schlegel oder Bettina von Brentano sieht, die erste Generation deutscher Dichter, die ein emanzipiertes Frauenbild mit sich trug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
