                "senses": [
                    {
                        "sense_id": "8fea2770-65b6-37f9-ac48-dd2a361f9405",
                        "entry_id": "8f7762bc-a993-311f-9e11-4ba140ca2366",
                        "glosses": [
                            "einer der verschiedenen Grade der Komparation (Steigerung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29188fa-5a71-484d-b3ff-c3b9b1be50d5",
                                "sense_id": "8fea2770-65b6-37f9-ac48-dd2a361f9405",
                                "text": "„Zum Adjektiv gehören alle flektierten und nichtflektierten Formen auf den drei Komparationsstufen.“"
                            },
                            {
                                "example_id": "7546e4db-6182-4997-9bc0-46b4de6a6051",
                                "sense_id": "8fea2770-65b6-37f9-ac48-dd2a361f9405",
                                "text": "„Eine weitere Komparationsstufe, der Elativ (Hervorhebung) wird im Deutschen schließlich allein periphrastisch gekennzeichnet;…“"
                            },
                            {
                                "example_id": "36b51360-e277-4b0d-806f-cd7452c7a00d",
                                "sense_id": "8fea2770-65b6-37f9-ac48-dd2a361f9405",
                                "text": "„Die Komparationsstufen können dabei auf zwei verschiedene Weisen gebildet werden, durch Ableitung mittels Anhängung des Suffixes ‚ter‘ (τερ) im Komparativ und Superlativ bzw. ‚tat‘ (τατ) im Elativ oder durch Umschreibung des Positivs mit dem Adverb pio (πιο ‚mehr‘) für den Komparativ oder ‚poly‘ (πολύ ‚sehr‘) für den Elativ. “"
                            },
                            {
                                "example_id": "5f959c29-f335-4641-b11c-f8d704d5d235",
                                "sense_id": "8fea2770-65b6-37f9-ac48-dd2a361f9405",
                                "text": "„Der Komparativ (auch Höherstufe, Mehrstufe, Vergleichsstufe, erste Komparationsstufe) ermöglicht den Vergleich zwischen zwei Größen in Bezug auf den Grad einer Eigenschaft, die diese zwei Größen gemeinsam aufweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
