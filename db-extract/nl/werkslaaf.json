                                        "glosses": [
                                            "Someone who works for wages and has little to no professional autonomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "835a0c04-de78-4a52-bbe5-9ae45cf247c7",
                                                "sense_id": "00cd3265-a5c0-3cc4-a24f-5b46ae92248c",
                                                "text": "The catch is that you have to be invested in order to gnaw on it. The superwealthy will do fine buying and selling things. But many wage slaves just don't have the cash."
                                            },
                                            {
                                                "example_id": "aaa0a9ea-e1ba-4912-b3e5-11c821e4163a",
                                                "sense_id": "00cd3265-a5c0-3cc4-a24f-5b46ae92248c",
                                                "text": "Yankovic stars as George Newman, a daydreaming wage slave whose overactive imagination keeps standing between him and a steady paycheck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd71ff3-4be5-35a1-a90e-3373e7cabcff",
