                                "target_lang_word": "сбросить захват",
                                "target_lang_sense_clarification": "игровой термин"
                            },
                            {
                                "target_lang_word": "уйти от захвата",
                                "target_lang_sense_clarification": "описание действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拆投",
                                "target_lang_sense_clarification": "格斗游戏术语"
                            }
                        ]
                    }
