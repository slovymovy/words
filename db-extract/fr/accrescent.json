                "senses": [
                    {
                        "sense_id": "fb9e4fce-065b-37c0-8f44-51d3f4e1fcd7",
                        "entry_id": "f426051c-7bb4-3b4b-9aee-6cb9f85b608c",
                        "glosses": [
                            "Qui continue à croître après la fécondation, en parlant de certains organes floraux, et principalement du calice, lorsqu’au lieu de tomber aussitôt après la floraison, il continue de s’accroître avec le fruit, dont il devient alors partie intégrante (poires, coings, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb3ec6e-d00a-4eca-a290-e075d129328e",
                                "sense_id": "fb9e4fce-065b-37c0-8f44-51d3f4e1fcd7",
                                "text": "Cependant, il est entouré par le calice de la fleur qui devient membraneux et renflé (calice accrescent)."
                            },
                            {
                                "example_id": "eaf6a3f6-4403-4c5b-8d5f-32519a2aef7d",
                                "sense_id": "fb9e4fce-065b-37c0-8f44-51d3f4e1fcd7",
                                "text": "Cette plante se distingue de la précédente par divers caractères, notamment les bractées libres et le périanthe fructifié non accrescent en tube."
                            }
                        ]
                    }
                ],
