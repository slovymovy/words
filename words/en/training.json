        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3169877e-7701-3b8c-a384-9a06bc5e7000",
                    "sense_definition": "The process of learning the skills needed to do a particular job or activity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skill_acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company provides extensive <w>training</w> for all new employees.",
                            "target_lang_translations": {
                                "ru": "Компания проводит обширное <w>обучение</w> для всех новых сотрудников.",
                                "tr": "Şirket, tüm yeni çalışanlar için kapsamlı <w>eğitim</w> sağlıyor.",
                                "zh": "公司为所有新员工提供全面的<w>培训</w>。"
                            }
                        },
                        {
                            "text": "He is currently in <w>training</w> for the upcoming marathon.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он проходит <w>подготовку</w> к предстоящему марафону.",
                                "tr": "Şu anda yaklaşan maraton için <w>antrenman</w> yapıyor.",
                                "zh": "他目前正在为即将到来的马拉松进行<w>训练</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instruction",
                        "education",
                        "coaching",
                        "tuition",
                        "preparation"
                    ],
                    "common_phrases": [
                        "training course",
                        "in training",
                        "job training",
                        "physical training",
                        "basic training"
                    ],
                    "target_lang_definitions": {
