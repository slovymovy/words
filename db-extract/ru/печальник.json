                "senses": [
                    {
                        "sense_id": "22a5dfdb-cce3-3b8f-be53-b963b46bda7d",
                        "entry_id": "38d9e43c-aca4-3391-b8d8-f6fd0aab35da",
                        "glosses": [
                            "sympathizer, someone who cares about others"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "27600cad-7d4d-4fe5-b88d-8861c42ac45d",
                                "sense_id": "22a5dfdb-cce3-3b8f-be53-b963b46bda7d",
                                "text": "Пе́ред вы́борами кандида́т, в свое́й програ́мме и в реча́х свои́х, ссыла́ется постоя́нно на вышеупомя́нутую фи́кцию: он тверди́т все о бла́ге обще́ственном, он не что ино́е, как слуга́ и печа́льник наро́да, он о себе́ не ду́мает […] .",
                                "translation": "In his addresses and speeches the candidate for election lays constant emphasis upon this fiction; he reiterates his phrases about the public welfare; he is nothing but a servant of the people; he will forget himself […] .",
                                "english": "In his addresses and speeches the candidate for election lays constant emphasis upon this fiction; he reiterates his phrases about the public welfare; he is nothing but a servant of the people; he will forget himself […] ."
                            }
                        ]
                    }
                ],
