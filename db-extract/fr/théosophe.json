                    },
                    {
                        "sense_id": "247351b2-b3fd-3ffa-9129-590167265bc0",
                        "entry_id": "49400426-b438-391c-bb27-34af6bcb452d",
                        "glosses": [
                            "theosophist"
                        ],
                        "tags": [
