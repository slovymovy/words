                        ],
                        "form": "die Äthiopier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74bf3f29-9125-3389-ab7b-c6056c7e4af0",
                        "entry_id": "1ef5a663-8e94-3bc9-b849-8e314da2d87c",
                        "glosses": [
                            "Staatsbürger von Äthiopien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0327405a-87e5-4f64-a557-263dbf29e7e8",
                                "sense_id": "74bf3f29-9125-3389-ab7b-c6056c7e4af0",
                                "text": "„Kebede stürmte indessen zum ersten Marathon-Triumph seiner Karriere. Bei Olympia 2008 und der WM 2009 hatte der 23 Jahre alte Äthiopier jeweils Bronze gewonnen.“"
                            },
                            {
                                "example_id": "c8d00762-71ab-4956-b6b4-4d68f3759c96",
                                "sense_id": "74bf3f29-9125-3389-ab7b-c6056c7e4af0",
                                "text": "„Am 1. März 1896 besiegen die Äthiopier Roms Truppen in der Schlacht von Adua.“"
                            },
                            {
                                "example_id": "030c6bc0-ec0f-4a49-ac52-f278f5c00a19",
                                "sense_id": "74bf3f29-9125-3389-ab7b-c6056c7e4af0",
                                "text": "„Für viele Amharen und andere Äthiopier gilt das noch heute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f06633a-07af-421c-b204-cdb7d611790d",
                        "source_entry_id": "1ef5a663-8e94-3bc9-b849-8e314da2d87c",
                        "source_sense_id": "74bf3f29-9125-3389-ab7b-c6056c7e4af0",
                        "source_sense_description": "Staatsbürger von Äthiopien",
                        "target_lang_word": "Ethiopian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ethiopian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "720bd837-f8e7-3a2e-8daa-e88c5222adec",
                                        "entry_id": "e841e7b1-0fe8-3130-b2fa-bc39cf6c2c4f",
                                        "glosses": [
                                            "A person from Ethiopia or of Ethiopian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18efd880-fce7-4cdd-a1ad-80e6c4ccd307",
                                                "sense_id": "720bd837-f8e7-3a2e-8daa-e88c5222adec",
                                                "text": "Ahmed was also appreciated for his talents as a showman, because he had no equal in letting loose the famous eskista, with the heaving quiver of the torso and shoulders, of which Ethiopians are so fond. Eskista is the dance of the Amharas, enhancing amorous repartee and expressing collective jubilation."
                                            },
                                            {
                                                "example_id": "6c5d27bb-0a0f-46ae-9340-c90abb6f1892",
                                                "sense_id": "720bd837-f8e7-3a2e-8daa-e88c5222adec",
                                                "text": "So why is Ethiopia, Africa’s second most populous country, seven years and eight months “behind” much of the rest of the world? And how does that work for Ethiopians living on an increasingly interconnected planet that mostly operates in an entirely different era?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "407ab292-2967-34dd-8c1f-51237bca20de",
                                        "entry_id": "e841e7b1-0fe8-3130-b2fa-bc39cf6c2c4f",
                                        "glosses": [
                                            "A black-skinned person, especially one from Africa."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15e5222d-976a-43df-b99d-f6483d2fc757",
                                                "sense_id": "407ab292-2967-34dd-8c1f-51237bca20de",
                                                "text": "The Ethiopian eunuch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "420d13c7-38ca-3b6e-8c42-7b282e156b35",
                                        "entry_id": "e841e7b1-0fe8-3130-b2fa-bc39cf6c2c4f",
                                        "glosses": [
                                            "A very skinny person, referencing the historic malnutrition and poverty in Ethiopia."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Ethiopian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa285ac-635f-32e5-9cb3-677f899a181b",
                                        "entry_id": "9fca95d5-7168-351c-a714-f5e07040cb6f",
                                        "glosses": [
                                            "Of, from, or pertaining to Ethiopia, the Ethiopian people or the Ethiopian culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e690832-2243-45c8-bdb1-75b7b82e270b",
                                                "sense_id": "daa285ac-635f-32e5-9cb3-677f899a181b",
                                                "text": "One of Ethiopia's most popular traditional dances, eskista, which is said to have originated from the lower highlands of Ethiopia's Amhara region, exemplifies the type of multi-functionality that Martin (1967) acknowledges as it is performed in many different settings of the Ethiopian community."
                                            },
                                            {
                                                "example_id": "1d152131-7664-404f-a785-9321ef9035ea",
                                                "sense_id": "daa285ac-635f-32e5-9cb3-677f899a181b",
                                                "text": "A local official, Habtamu Fetena, had earlier told state-run broadcaster, the Ethiopian Broadcasting Corporation (EBC) that children were among the dead and the death toll was likely to increase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c93177f1-d59f-3927-af85-442d0e6f6a54",
                                        "entry_id": "9fca95d5-7168-351c-a714-f5e07040cb6f",
                                        "glosses": [
                                            "Of, from, or pertaining to Africa and the African diaspora."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d55d2b10-49aa-4c51-863e-310481a8b6d8",
                                                "sense_id": "c93177f1-d59f-3927-af85-442d0e6f6a54",
                                                "text": "Any person of color recognized his Ethiopian heritage immediately. That nose, those lips, good hair or no."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42d161e9-4c8c-4df7-a4b0-a71cb19687e9",
