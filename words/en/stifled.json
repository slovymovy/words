{
    "word_family": [
        "stifle",
        "stifling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "00b9507e-2681-3023-85ea-4567e50d2851",
                    "sense_definition": "Suppressed, restrained, or prevented from being expressed or developed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stifled</w> attempt at reform led to further resentment.",
                            "target_lang_translations": {
                                "nl": "De <w>onderdrukte</w> poging tot hervorming leidde tot verdere wrok."
                            }
                        },
                        {
                            "text": "She gave a <w>stifled</w> laugh during the serious meeting.",
                            "target_lang_translations": {
                                "nl": "Ze liet een <w>gesmoorde</w> lach horen tijdens de serieuze vergadering."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppressed",
                        "restrained",
                        "smothered"
                    ],
                    "antonyms": [
                        "expressed",
                        "unrestrained"
                    ],
                    "common_phrases": [
                        "stifled laugh",
                        "stifled yawn",
                        "stifled cry"
                    ],
                    "target_lang_definitions": {
                        "nl": "Onderdrukt, tegengehouden of verhinderd om tot uiting te komen of zich te ontwikkelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onderdrukt",
                                "target_lang_sense_clarification": "Algemene term voor iets dat wordt tegengehouden of gesmoord."
                            },
                            {
                                "target_lang_word": "gesmoord",
                                "target_lang_sense_clarification": "Vaak gebruikt voor geluiden of emoties die niet volledig geuit worden."
                            },
                            {
                                "target_lang_word": "ingehouden",
                                "target_lang_sense_clarification": "Gebruikt voor emoties of reacties die men bewust beheerst."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de5de1c9-1357-3c16-aec3-4ada8c4b9d62",
                    "sense_definition": "Simple past and past participle of <w>stifle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>stifled</w> a yawn while listening to the long lecture.",
                            "target_lang_translations": {
                                "nl": "Hij <w>smoorde</w> een geeuw terwijl hij naar de lange lezing luisterde."
                            }
                        },
                        {
                            "text": "The government <w>stifled</w> all opposition to the new law.",
                            "target_lang_translations": {
                                "nl": "De overheid <w>onderdrukte</w> alle oppositie tegen de nieuwe wet."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb stifle."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van 'stifle' (smoren, onderdrukken)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "smoorde",
                                "target_lang_sense_clarification": "Verleden tijd van smoren (bijv. een geluid of emotie)."
                            },
                            {
                                "target_lang_word": "onderdrukte",
                                "target_lang_sense_clarification": "Verleden tijd van onderdrukken (bijv. verzet of een beweging)."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}