            {
                "entry_id": "49bdf253-8f09-3a0d-89cb-0268a5c54a64",
                "word": "modem",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b3c178e-9049-4526-9c2b-dabeda064661",
                        "entry_id": "49bdf253-8f09-3a0d-89cb-0268a5c54a64",
                        "tags": [
                            "plural"
                        ],
                        "form": "modems"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "471e5a8b-b24f-3b04-8e3b-9f48e9230419",
                        "entry_id": "49bdf253-8f09-3a0d-89cb-0268a5c54a64",
                        "glosses": [
                            "Dispositif qui transforme un signal numérique en un signal, souvent analogique, adapté aux caractéristiques d’une ligne de transmission, et inversement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce63464-1d4e-49f6-99f0-0eb473dca0d3",
                                "sense_id": "471e5a8b-b24f-3b04-8e3b-9f48e9230419",
                                "text": "Malgré l’étymologie de leur dénomination, les lignes ADSL ne sont pas numériques par nature, elles exigent l’utilisation d’un modem approprié à chacune de leurs extrémités."
                            },
                            {
                                "example_id": "80155227-5e0d-45bd-99d4-6bd1e8596e41",
                                "sense_id": "471e5a8b-b24f-3b04-8e3b-9f48e9230419",
                                "text": "S’il s’agit d’un modem analogique, il connecte sur un port série."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b46bb272-f705-4da2-9798-616b007b2bce",
                        "source_entry_id": "49bdf253-8f09-3a0d-89cb-0268a5c54a64",
                        "source_sense_id": "471e5a8b-b24f-3b04-8e3b-9f48e9230419",
                        "target_lang_word": "modem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef480f74-fbef-39de-8c1f-9ac6162a3446",
                                        "entry_id": "7a6f0c84-fa88-3ac8-b0c7-b86b63375856",
                                        "glosses": [
                                            "A device that encodes digital computer signals into analog telephone signals and vice versa, allowing computers to communicate over a phone line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba0d4d58-ac1b-4bc8-8dfd-51c8736c29fe",
                                                "sense_id": "ef480f74-fbef-39de-8c1f-9ac6162a3446",
                                                "text": "Choose and rent, over PC and modem and fiber-optic line, from tens of thousands of second-run films, documentaries, the occasional sport, old beloved non—‘Happy Days’ programs, wholly new programs, cultural stuff, and c.[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "modem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                        "entry_id": "ac2cd71e-de55-32af-a83d-85fb26f3dbe8",
                                        "glosses": [
                                            "To transmit by modem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86084be6-6f3b-4f2c-84b8-975aa6abb1bb",
                                                "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                                "text": "“Books” can even be faxed or modemed to you!"
                                            },
                                            {
                                                "example_id": "caf8eefc-9de9-40b5-9c6d-f5dd75ff19f7",
                                                "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                                "text": "Personal modeming is most prevalent in the U.S., where a modem generally doesn't have huge taxes slapped on it, and after-tax income is comparatively high."
                                            },
                                            {
                                                "example_id": "ed2e644b-da52-48bc-af80-20bcc9c3b4dd",
                                                "sense_id": "66c4e5b6-2665-31b7-a791-0f3a4c7e456b",
                                                "text": "He had to modem in to the agency and say that there was an emergency […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f00cc1a-9fae-4646-823f-9e88a8df7814",
                        "source_entry_id": "49bdf253-8f09-3a0d-89cb-0268a5c54a64",
