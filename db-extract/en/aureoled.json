                                "example_id": "8cb864e6-d957-4d6b-9302-a4e8003828dc",
                                "sense_id": "898dff5d-47d5-37e3-a3c9-6cd1292b7b88",
                                "text": "The lover's passion was yet upon them; each to the other was plainly aureoled."
