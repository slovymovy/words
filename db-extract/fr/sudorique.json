                                "target_senses": [
                                    {
                                        "sense_id": "a3118b8a-fd99-3930-b578-39091989f1da",
                                        "entry_id": "a2b44e61-7cea-3cf8-b920-ad0ce0353906",
                                        "glosses": [
                                            "Covered in sweat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc40ef45-a0d4-46bc-81c9-bff1be4115ab",
                                                "sense_id": "a3118b8a-fd99-3930-b578-39091989f1da",
                                                "text": "John felt better after changing out of his sweaty clothes."
                                            },
                                            {
                                                "example_id": "0a8b07bd-af14-47cd-a567-08455dbeec59",
                                                "sense_id": "a3118b8a-fd99-3930-b578-39091989f1da",
                                                "text": "In that a Snayl or Dodman, vvhich is not only not vvarm, but to our feeling, very cold, is fain to brood its as cold svveatty eggs, neſted upon a cold vvet earth, beſpievving them about vvith the fuzze of a cold clammy froth, in coldish [d]raughty vveather, and all making vvay to a kind and timely hatching of them: […] I dare undertake to light ſooner of that vvarmth and reek and air, that vvill hatch an hens egge, than that cold and devv and clammineſs, that goes to the hatching of a ſnails."
                                            },
                                            {
                                                "example_id": "f30a225a-da67-4f59-bf8e-2364385283d0",
                                                "sense_id": "a3118b8a-fd99-3930-b578-39091989f1da",
                                                "text": "You never worried, with Jane, whether your hand was sweaty or not. All you knew was, you were happy. You really were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7537526a-a4d2-39ce-b6ad-b2da126d4e7a",
                                        "entry_id": "a2b44e61-7cea-3cf8-b920-ad0ce0353906",
                                        "glosses": [
                                            "Having a tendency to sweat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a06b9fd-bde0-488d-b69f-0b83222b0f3a",
                                                "sense_id": "7537526a-a4d2-39ce-b6ad-b2da126d4e7a",
                                                "text": "She had never met someone so sweaty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ffd235a-0d09-38eb-ab20-c9740e87b607",
                                        "entry_id": "a2b44e61-7cea-3cf8-b920-ad0ce0353906",
                                        "glosses": [
                                            "Likely to cause one to sweat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088775ef-bcec-4c89-b060-8b083a3c5888",
                                                "sense_id": "0ffd235a-0d09-38eb-ab20-c9740e87b607",
                                                "text": "It was a hot and sweaty day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "901790bb-d5af-36a5-8ad3-8dacb86a3dd7",
                                        "entry_id": "a2b44e61-7cea-3cf8-b920-ad0ce0353906",
                                        "glosses": [
                                            "Caused by sweat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fdeed2e-275f-473f-a0b7-acecf7794f68",
                                                "sense_id": "901790bb-d5af-36a5-8ad3-8dacb86a3dd7",
                                                "text": "That sweaty odour is disgusting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e78cb9d3-b6fc-3168-b4d3-c82c92720e4a",
                                        "entry_id": "a2b44e61-7cea-3cf8-b920-ad0ce0353906",
                                        "glosses": [
                                            "Strenuous; laborious; exhausting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d491b2ef-4332-4713-b291-966833bb52f0",
                                                "sense_id": "e78cb9d3-b6fc-3168-b4d3-c82c92720e4a",
                                                "text": "He resented being asked to do such a sweaty task."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf1c6d1-6f4a-3596-9009-882b66d217bc",
                                        "entry_id": "a2b44e61-7cea-3cf8-b920-ad0ce0353906",
                                        "glosses": [
                                            "Extremely (and possibly inappropriately) obsessed with winning."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddfdf653-797e-47bd-951f-fb7fa8639097",
                                                "sense_id": "6cf1c6d1-6f4a-3596-9009-882b66d217bc",
                                                "text": "Watch out for that sweaty team."
                                            },
                                            {
                                                "example_id": "ba31f845-4c03-4424-baaa-c1e7abe195da",
                                                "sense_id": "6cf1c6d1-6f4a-3596-9009-882b66d217bc",
                                                "text": "The YouTuber delved deeper into his goals, claiming: \"I want to do sweaty, try hard FPS gaming from the toilet.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a7740ed-46fc-3115-ae7f-1adc434636a6",
                                        "entry_id": "a2b44e61-7cea-3cf8-b920-ad0ce0353906",
                                        "glosses": [
                                            "Attracting many extremely competitive players."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b866609f-2d5a-43eb-86d7-687ba989f34a",
                                                "sense_id": "6a7740ed-46fc-3115-ae7f-1adc434636a6",
                                                "text": "I stick to casual because ranked lobbies are way too sweaty."
                                            },
                                            {
                                                "example_id": "84e56650-ae80-4f47-9fc5-2db346982d2b",
                                                "sense_id": "6a7740ed-46fc-3115-ae7f-1adc434636a6",
                                                "text": "The mode caters to competitive players by offering increased health and larger lobby sizes. However, some players argue the game mode is extremely \"sweaty.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sweaty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05b4824c-b7fc-331f-922e-5102f466a65a",
                                        "entry_id": "d29c094f-74ff-3872-abe8-bd0145bb5313",
                                        "glosses": [
                                            "One who is sweaty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5132dc-0764-4dfc-9202-4f6d94af7da1",
                                                "sense_id": "05b4824c-b7fc-331f-922e-5102f466a65a",
                                                "text": "For example a conscious attemp at separating the \"hots and sweaties\" from the “bibs and tuckers” is often desirable amount according to which activity areas he/she has used."
                                            },
                                            {
                                                "example_id": "116b5f42-899e-4636-b809-810dcdeb1125",
                                                "sense_id": "05b4824c-b7fc-331f-922e-5102f466a65a",
                                                "text": "Crowd ranges from post-gym sweaties to locals."
                                            },
                                            {
                                                "example_id": "00609ae3-82fa-4ad9-9c14-d263df483feb",
                                                "sense_id": "05b4824c-b7fc-331f-922e-5102f466a65a",
                                                "text": "An ardent proponent of geek culture, Schnepp would often refer to himself and his fellow enthusiasts of genre entertainment as “Sweaties,” a reminder of his creed that it was OK to sweat over something you love (and also perhaps a reference to the perspiration such fans would often endure as a result of waiting in long lines during the hot days of Comic-Con to see their favorite actors and creators in panels and autograph sessions). This earned him the moniker “King of the Sweaties.”"
                                            },
                                            {
                                                "example_id": "84f46cb2-e6e6-4ba0-a4ce-623bb92dc2ab",
                                                "sense_id": "05b4824c-b7fc-331f-922e-5102f466a65a",
                                                "text": "As someone who immediately starts sweating profusely the second the temperature creeps over 75 degrees (sexy?), I felt enormous sympathy for these absolutely drenched men. Justice for us sweaties!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c52b7ae6-b6c6-3b22-a7af-565eac5ceb45",
                                        "entry_id": "d29c094f-74ff-3872-abe8-bd0145bb5313",
                                        "glosses": [
                                            "Informal sportswear, such as a sweatshirt, pair of sweatpants or a sweatsuit."
                                        ],
                                        "tags": [
                                            "informal",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673c219e-5a39-47ab-9f4e-01d6ddc2d8cd",
                                                "sense_id": "c52b7ae6-b6c6-3b22-a7af-565eac5ceb45",
                                                "text": "After lessons I went down town with O'Hara and William, we bought a bow and arrows and some sweaties, when we came home we practised with our bow and arrows and played marbles."
                                            },
                                            {
                                                "example_id": "7245145a-9b11-40a3-840f-7d3b4b338bc8",
                                                "sense_id": "c52b7ae6-b6c6-3b22-a7af-565eac5ceb45",
                                                "text": "Designer Hanna Andersson specializes in comfortable, round-the-clock children's clothes: snugglies and “sweaties\" (indefatigable sportswear) made of cotton trikā, a combed-cotton rib-knit in bright colors and bold stripes."
                                            },
                                            {
                                                "example_id": "fd869801-e7a2-46e1-aef8-1d9bc431d103",
                                                "sense_id": "c52b7ae6-b6c6-3b22-a7af-565eac5ceb45",
                                                "text": "As the rictal woman leaves the A & P for the oppressive heat of the streets, she is knocked sprawling by Grace Armstrong, a ridiculous figure in “sweat” clothing , or “sweaties,” who is just finishing her daily jogging stint."
                                            },
                                            {
                                                "example_id": "7492f539-2648-4ed8-b946-266824eb5aa3",
                                                "sense_id": "c52b7ae6-b6c6-3b22-a7af-565eac5ceb45",
                                                "text": "Grey sweaties are our go-to and the rhinestones add a little something extra for the days when you actually make it out of the house."
                                            }
                                        ]
                                    }
                                ]
                            },
