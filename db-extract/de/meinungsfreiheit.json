                        "source_sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                        "target_lang_word": "vrijheid van meningsuiting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vrijheid van meningsuiting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "63bd7691-1a6c-345f-acfa-ff7813f9f0d9",
                                        "entry_id": "be741fb6-bb00-32f6-93d3-c57256074744",
                                        "glosses": [
                                            "beginsel dat iedereen vrij moet zijn mening te geven, omdat juist verschillen van mening betere inzichten kunnen opleveren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81398ecb-cb41-41ff-9d83-143fa27f8f5e",
                                                "sense_id": "63bd7691-1a6c-345f-acfa-ff7813f9f0d9",
                                                "text": "De kern van de vrijheid van meningsuiting is nu eenmaal dat we andermans meningen verdragen. Je bent het hartstochtelijk oneens met de ander maar gunt hem zijn opvatting, zelfs als je denkt: hier gaat het land aan ten onder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b61771a-afb5-3802-bdec-057c16b242d5",
                                        "entry_id": "be741fb6-bb00-32f6-93d3-c57256074744",
                                        "glosses": [
                                            "democratisch recht opvattingen uit te dragen, zolang het niet om haatzaaien gaat (geldt slechts in kleine delen van de wereld)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04648807-5048-4474-ae5a-491aa7a4bca5",
                                                "sense_id": "1b61771a-afb5-3802-bdec-057c16b242d5",
                                                "text": "De vrijheid van meningsuiting is een effectief instrument om het gezag ter verantwoording te roepen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c81595-0c1d-3849-9ad8-ab5c4e687e03",
                                        "entry_id": "be741fb6-bb00-32f6-93d3-c57256074744",
                                        "glosses": [
                                            "recht dat ieder de eigen inzichten kan publiceren zonder toestemming vooraf van de overheid, aangevuld met een strikte beperking van de mogelijkheden van de overheid om daar achteraf tegen op te treden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8feee2-139c-424f-80af-c86690124275",
                                                "sense_id": "50c81595-0c1d-3849-9ad8-ab5c4e687e03",
                                                "text": "Het gerechtshof in Den Haag oordeelde donderdag dat het naroepen en -sissen van mensen op straat valt onder de vrijheid van meningsuiting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
