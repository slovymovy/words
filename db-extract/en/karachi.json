                                        "sense_id": "ac74ff11-cd31-36ff-92b2-cb39791860f5",
                                        "entry_id": "81ec5418-110a-36d8-84e6-c62ac52f43f9",
                                        "glosses": [
                                            "Grande ville du Pakistan sur la côte est de la mer d’Oman et au nord-ouest de l’Indus, capitale de la province du Sindh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa88dba1-e78e-49ae-975b-0a5a732bc510",
                                                "sense_id": "ac74ff11-cd31-36ff-92b2-cb39791860f5",
                                                "text": "C'est désormais au Pakistan, ou en Iran, que la fréquentation des sites de téléchargement de films X est le plus assidue. Qui sait quelles bombes mentales s'allument dans les nuits solitaires de Kaboul ou de Karachi ?"
                                            },
                                            {
                                                "example_id": "b304ace8-11b3-438e-b7a6-64a0a6803888",
                                                "sense_id": "ac74ff11-cd31-36ff-92b2-cb39791860f5",
                                                "text": "Les Pachtounes se répartissent entre la province de Khyber Pakhtunkhwa (ancienne Province de la Frontière du Nord-Est), les « Zones tribales », le Baloutchistan et Karachi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72c23d0d-d959-4d17-85d0-76305c33a26c",
                        "source_entry_id": "a5fc3351-d54e-3110-a17a-9efd1a11cb3a",
                        "source_sense_id": "f32f2c68-0f94-37e1-a616-29f5b2763943",
                        "source_sense_description": "the capital of the province of Sindh, Pakistan",
                        "target_lang_word": "Karatschi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karatschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a91ed42-a2e0-3e44-aea3-2e0e7bc1347f",
                                        "entry_id": "1135a896-bcff-3360-b46e-18358dfcdbc6",
                                        "glosses": [
                                            "Hauptstadt der pakistanischen Provinz Sindh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c54f195-4eef-4bbb-83e0-9a45b1958b1e",
                                                "sense_id": "1a91ed42-a2e0-3e44-aea3-2e0e7bc1347f",
                                                "text": "„Während im Inneren Sindh und entlang des Indus überwiegend Sindhis (mit eigener Sprache und Kultur) leben, dominieren in Karatschi und Hyderabad die Mohajirin, wie die Flüchtlinge, die nach 1947 von Indien nach Pakistan gekommen sind, genannt werden.“"
                                            },
                                            {
                                                "example_id": "c1917bf9-281a-4e85-a8c5-2d3ceea71835",
                                                "sense_id": "1a91ed42-a2e0-3e44-aea3-2e0e7bc1347f",
                                                "text": "„Sein Geld erhält er von einem Mann in Dubai, der es selbst wiederum aus Karatschi bezieht.“"
                                            },
                                            {
                                                "example_id": "91c7384d-4102-4f28-ac83-f611c19f7dc3",
                                                "sense_id": "1a91ed42-a2e0-3e44-aea3-2e0e7bc1347f",
                                                "text": "„Die Stadt Mazar liegt in der Steppe Zentralasiens, die nördlich des Hindukusch beginnt, und ist in kultureller und ethnischer Hinsicht von Kandahar so weit entfernt wie Karatschi“"
                                            },
                                            {
                                                "example_id": "6a446ce7-a912-4232-acc3-4fd5660d0cdc",
                                                "sense_id": "1a91ed42-a2e0-3e44-aea3-2e0e7bc1347f",
                                                "text": "„Der Brigadegeneral, der die Niederlassung des Geheimdienstes in Karatschi leitete, hatte ihn angerufen und vor einem potenziellen Problem gewarnt.“"
                                            },
                                            {
                                                "example_id": "b6727324-97a0-4587-9ce6-75f4e278e3f4",
                                                "sense_id": "1a91ed42-a2e0-3e44-aea3-2e0e7bc1347f",
                                                "text": "„Jedes weitere Flugzeug, das über dem Jinnah International Airport in Karatschi vom Himmel hinabsank, versetzte die riesige, hinter dem Stacheldraht am Rand der Landebahn versammelte Menschenmenge in noch größere Begeisterung.“"
                                            },
                                            {
                                                "example_id": "3707ff97-5e10-4bdb-9419-7734b4e1375d",
                                                "sense_id": "1a91ed42-a2e0-3e44-aea3-2e0e7bc1347f",
                                                "text": "„Kuala Lumpur, Kalkutta oder Karatschi, wo auch immer meine Eltern gerade in der Sonne badeten und ihre mit Schweiß gefüllten Näbel beschauten, sie mussten den Schrei vernommen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
