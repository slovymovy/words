                                                "sense_id": "826db8e8-1e97-3a91-88a5-724d9dcd37d3",
                                                "text": "Die Addition von 16 zu 8 ergibt 24."
                                            },
                                            {
                                                "example_id": "922617da-8787-4ed0-9339-027f910bb161",
                                                "sense_id": "826db8e8-1e97-3a91-88a5-724d9dcd37d3",
                                                "text": "„Er lernte Addition mit Blick auf Ananas und Melonen.“"
                                            },
                                            {
                                                "example_id": "3b021c4a-8fd1-491e-9472-da85b24c5626",
                                                "sense_id": "826db8e8-1e97-3a91-88a5-724d9dcd37d3",
                                                "text": "„Die Addition zweier Zahlen erfolgt so, dass zunächst die erste Zahl auf dem Abakus eingestellt wird und dann die zweite dazukommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
