                "senses": [
                    {
                        "sense_id": "5a9987b6-eded-3ce4-a6f4-e2877cc6c28b",
                        "entry_id": "15122c98-6612-3167-b673-d105e1a20b00",
                        "glosses": [
                            "mathematisches Modell, das die Abfolge von Elementen in einer Sequenz (zum Beispiel von Buchstaben oder Wörtern in natürlichsprachlichen Texten) modelliert"
                        ],
                        "tags": [
                            "Computerlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "a26648e8-f352-4439-96b3-30291f005831",
                                "sense_id": "5a9987b6-eded-3ce4-a6f4-e2877cc6c28b",
                                "text": "„Die Leistung großer Sprachmodelle hängt theoretisch davon ab, wie viele Daten und wie viel Rechenpower für das Training aufgewendet werden.“"
                            },
                            {
                                "example_id": "fcae4440-c546-4385-a2b6-b99b93099c9b",
                                "sense_id": "5a9987b6-eded-3ce4-a6f4-e2877cc6c28b",
                                "text": "„Sprachmodelle wie jenes hinter ChatGPT und Konkurrenten wie Claude basieren auf Wahrscheinlichkeitsrechnungen, so die Leiterin des Instituts für Managementwissenschaften – die Hoffnung, dass derartige KI-Modelle noch deutlich besser werden, ist laut Köszegi eine „falsche“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
