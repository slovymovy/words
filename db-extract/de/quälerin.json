                ],
                "senses": [
                    {
                        "sense_id": "3c72f5c8-72bc-315c-9419-a6d6a9ed642c",
                        "entry_id": "e9a90869-2cf8-36fd-b9c4-c8b0c6aab58f",
                        "glosses": [
                            "weibliche Person, die einem Menschen (oder anderen Lebewesen) Schmerzen zufügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8c3426-971e-4ca1-a575-6860b04b83ae",
                                "sense_id": "3c72f5c8-72bc-315c-9419-a6d6a9ed642c",
                                "text": "„Nachbarn hatten aufgrund des jämmerlichen Gewinsels und Gemaules die Polizei alarmiert – aber von der mutmaßlichen Quälerin fehlt wieder jede Spur.“"
                            },
                            {
                                "example_id": "e34d65bb-6665-42af-a7eb-a5139493d8d6",
                                "sense_id": "3c72f5c8-72bc-315c-9419-a6d6a9ed642c",
                                "text": "„Es habe sich doch bloss um ein im Voraus abgesprochenes Rollenspiel gehandelt, und er habe auf seinem Bildschirm überhaupt nie ein dreijähriges Mädchen und dessen erwachsene Quälerin gesehen.“"
                            },
                            {
                                "example_id": "6a45aec3-405d-476e-a4d2-c7dbf96d55c2",
                                "sense_id": "3c72f5c8-72bc-315c-9419-a6d6a9ed642c",
                                "text": "„Bei dieser Komödie oder Tragödie, je nach den Umständen, treten die beiden handelnden Personen fast immer in denselben Rollen auf: in der des Quälers oder der Quälerin und in der des Opfers.“"
                            },
                            {
                                "example_id": "7e8c6dd4-9e62-4122-a010-03403c3655f5",
                                "sense_id": "3c72f5c8-72bc-315c-9419-a6d6a9ed642c",
                                "text": "„Aber ihre Quälerin folgte ihr auch hierher; mit einem Lächeln zwar, in das sich aber doch die Schadenfreude der überlegenen Kraft mischte, suchte sie Felicitas das Band zu entwinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
