                    }
                ],
                "senses": [
                    {
                        "sense_id": "c431c3bf-0ff6-31ee-a401-9932d91a80f4",
                        "entry_id": "3b68dbeb-48a4-3295-91f2-6f447ecfcd4b",
                        "glosses": [
                            "Le fait de n’être pas conforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef490c11-4faf-472a-8c73-103b05b589f3",
                                "sense_id": "c431c3bf-0ff6-31ee-a401-9932d91a80f4",
                                "text": "On constata la non-conformité des deux objets, des deux récits."
                            },
                            {
                                "example_id": "2fd0d596-5910-4623-a221-b28a98a07af6",
                                "sense_id": "c431c3bf-0ff6-31ee-a401-9932d91a80f4",
                                "text": "Car face à une non-conformité, l’Echa ne peut qu’envoyer des demandes d’explications et d’informations supplémentaires — qui mettent en général des années à aboutir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5410c8c0-6ff9-47d8-95c6-f86a8eafdd97",
                        "source_entry_id": "3b68dbeb-48a4-3295-91f2-6f447ecfcd4b",
                        "source_sense_id": "c431c3bf-0ff6-31ee-a401-9932d91a80f4",
                        "target_lang_word": "Nichtkonformität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7d30f72b-da50-43dc-99de-2e88c9c9ba71",
                        "source_entry_id": "3b68dbeb-48a4-3295-91f2-6f447ecfcd4b",
                        "source_sense_id": "c431c3bf-0ff6-31ee-a401-9932d91a80f4",
                        "target_lang_word": "Abweichung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abweichung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8330e810-4b79-35b2-af0e-f994f265ecf2",
                                        "entry_id": "417f3af5-9080-356e-949e-b85a5ee3735a",
                                        "glosses": [
                                            "die Nichterfüllung einer Regelmäßigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cba916-f00d-41cc-8263-1588d7303b25",
                                                "sense_id": "8330e810-4b79-35b2-af0e-f994f265ecf2",
                                                "text": "Eine Abweichung vom Zeitplan steht außer Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                        "entry_id": "417f3af5-9080-356e-949e-b85a5ee3735a",
                                        "glosses": [
                                            "Verletzung einer grammatischen Regel oder Verstoß gegen eine geltende Sprachnorm oder -konvention"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0ead03-7860-40f2-93f4-51b0c01f2544",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "Abweichungen können auf jeder grammatischen oder stilistischen Ebene erfolgen."
                                            },
                                            {
                                                "example_id": "8ac7f817-e59b-4bb9-a64f-0b4a1163d06a",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "„Riffaterres kontextuelle Stilauffassung setzt einen Stilbegriff voraus, der nur der Abweichung von der Lesererwartung Stilcharakter zuerkennt.“"
                                            },
                                            {
                                                "example_id": "c6c5138a-c674-4478-9879-b76843d56da2",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "Über das »Österreichische«: „Sah man in der Betonung der Abweichungen nach 1945 noch die Möglichkeit, eine identitätsstiftende antideutsche Haltung zu demonstrieren, sieht Professor Koppensteiner heute eher ein Imageproblem vorherrschen.“"
                                            },
                                            {
                                                "example_id": "732a125b-8602-497e-922a-5bac6ef74872",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "„In der Schreibpraxis gibt es jedoch Abweichungen davon, die insbesondere den Bereich der Behörden betreffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6948723b-c8b0-40e8-bb5b-7bf725fdf03a",
                        "source_entry_id": "3b68dbeb-48a4-3295-91f2-6f447ecfcd4b",
                        "source_sense_id": "c431c3bf-0ff6-31ee-a401-9932d91a80f4",
                        "target_lang_word": "nonconformity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonconformity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a39dd98e-6526-3414-adf1-602b4a76ea61",
                                        "entry_id": "6677c68b-908a-37f5-b249-12a851f18f78",
                                        "glosses": [
                                            "Refusal to conform to the doctrine, discipline, or practice of a state religion, especially refusal by other Protestants to conform to the doctrine or discipline of the Church of England; the principles or practice of nonconformists; nonconformists as a class."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc4051dc-d888-4707-be03-db05c17c00b2",
                                                "sense_id": "a39dd98e-6526-3414-adf1-602b4a76ea61",
                                                "text": "Here then is S. Pauls Judaeus in abscondito, a Jew inwardly. Here is the true Recusant, and the true Non-conformitan; Au∣diunt, sed non faciunt: he comes to hear, but never comes to doe; there's Recusancy: he confesses that he hath received good instru∣ction, but he refufes to conform himself unto it; there's Non-con∣formity'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1f9b12-86ca-3db6-b312-8d6a864633d3",
                                        "entry_id": "6677c68b-908a-37f5-b249-12a851f18f78",
                                        "glosses": [
                                            "Rejection of, or failure to conform to, a practice, standard, rule, or law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abbd43e3-0789-4b8d-ad22-98bb82349ba0",
                                                "sense_id": "2a1f9b12-86ca-3db6-b312-8d6a864633d3",
                                                "text": "But as no man, that does acknowledg the Authority and Divinity of the Scriptures, can easily satisfie himself in living in the Breach of any of it's known rules and precepts, without the countenance and protection (such as it is) of some vain imagination, and deceitful reasoning or other, so is it in this case with some, who having no mind to this way of God (Bap∣tism I mean) though otherwise convinced of the nullity of In∣fant-baptism) have taken hold of certain delusive Pleas, where∣by to justifie their non-conformity to this rule of the Gospel, and Doctrine of Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bbbe518-a5d4-3d01-9233-3067af07174e",
                                        "entry_id": "6677c68b-908a-37f5-b249-12a851f18f78",
                                        "glosses": [
                                            "A type of unconformity in which a non-sedimentary rock intrudes in sedimentary layers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
