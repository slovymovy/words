{
    "word_family": [
        "достижение",
        "достижимый",
        "недостижимый",
        "достижимость",
        "достигать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95aba580-d147-3beb-b042-6c86a2a2ae35",
                    "sense_definition": "добиться желаемого результата, получить или осуществить что-либо благодаря усилиям",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "успех",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Благодаря упорному труду студент смог <w>достигнуть</w> поставленной цели и сдать экзамен на отлично.",
                            "target_lang_translations": {
                                "pl": "Dzięki ciężkiej pracy student zdołał <w>osiągnąć</w> wyznaczony cel i zdać egzamin na ocenę celującą."
                            }
                        },
                        {
                            "text": "Они упорно тренировались каждый день, чтобы <w>достигнуть</w> успеха на международных соревнованиях.",
                            "target_lang_translations": {
                                "pl": "Ciężko trenowali każdego dnia, aby <w>osiągnąć</w> sukces na zawodach międzynarodowych."
                            }
                        }
                    ],
                    "synonyms": [
                        "достичь"
                    ],
                    "common_phrases": [
                        "достигнуть цели",
                        "достигнуть успеха",
                        "достигнуть соглашения"
                    ],
                    "target_lang_definitions": {
                        "pl": "uzyskać pożądany rezultat, zrealizować cel dzięki własnym staraniom"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osiągnąć",
                                "target_lang_sense_clarification": "cel, sukces, porozumienie"
                            },
                            {
                                "target_lang_word": "uzyskać",
                                "target_lang_sense_clarification": "wynik, zgodę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dee5dcb-9db8-3fb6-b5b3-3fb73b0f7602",
                    "sense_definition": "перемещаясь, дойти или доехать до какого-либо места, границы или ориентира",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "перемещение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгого перехода туристы наконец смогли <w>достигнуть</w> вершины горы до захода солнца.",
                            "target_lang_translations": {
                                "pl": "Po długiej wędrówce turyści wreszcie zdołali <w>osiągnąć</w> szczyt góry przed zachodem słońca."
                            }
                        },
                        {
                            "text": "Корабль плыл несколько недель и сумел <w>достигнуть</w> берега только к утру.",
                            "target_lang_translations": {
                                "pl": "Statek płynął przez kilka tygodni i zdołał <w>dotrzeć do</w> brzegu dopiero nad ranem."
                            }
                        }
                    ],
                    "synonyms": [
                        "достичь"
                    ],
                    "common_phrases": [
                        "достигнуть берега",
                        "достигнуть вершины"
                    ],
                    "target_lang_definitions": {
                        "pl": "dotrzeć lub dojechać w określone miejsce, do jakiegoś punktu lub granicy"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osiągnąć",
                                "target_lang_sense_clarification": "szczyt, brzeg, cel podróży"
                            },
                            {
                                "target_lang_word": "dotrzeć do",
                                "target_lang_sense_clarification": "miejsca docelowego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c650af4f-ce12-320d-a1ee-2e6175e2e6e4",
                    "sense_definition": "дойти в количественном выражении, размерах, весе или показателях до определённого предела",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "величина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом температура воздуха в этом южном регионе может легко <w>достигнуть</w> сорока градусов.",
                            "target_lang_translations": {
                                "pl": "Latem temperatura powietrza w tym południowym regionie może z łatwością <w>osiągnąć</w> czterdzieści stopni."
                            }
                        },
                        {
                            "text": "Численность населения в крупном городе успела <w>достигнуть</w> двух миллионов человек.",
                            "target_lang_translations": {
                                "pl": "Liczba ludności w tym dużym mieście zdążyła <w>osiągnąć</w> dwa miliony osób."
                            }
                        }
                    ],
                    "synonyms": [
                        "достичь"
                    ],
                    "common_phrases": [
                        "достигнуть максимума",
                        "достигнуть предела"
                    ],
                    "target_lang_definitions": {
                        "pl": "dojść do pewnej wartości liczbowej, miary, wagi lub określonego poziomu"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osiągnąć",
                                "target_lang_sense_clarification": "poziom, wartość, limit"
                            },
                            {
                                "target_lang_word": "wynieść",
                                "target_lang_sense_clarification": "o wartości, liczbie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b874648-19f6-3b86-8fa8-b13f7e4b1b97",
                    "sense_definition": "дожить до определённого возраста или периода жизни",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "величина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой человек должен был <w>достигнуть</w> совершеннолетия, чтобы получить доступ к семейному наследству.",
                            "target_lang_translations": {
                                "pl": "Młody człowiek musiał <w>osiągnąć</w> pełnoletniość, aby uzyskać dostęp do rodzinnego spadku."
                            }
                        },
                        {
                            "text": "Мало кто в этой древней династии смог <w>достигнуть</w> преклонного возраста.",
                            "target_lang_translations": {
                                "pl": "Niewielu w tej starożytnej dynastii zdołało <w>dożyć</w> sędziwego wieku."
                            }
                        }
                    ],
                    "synonyms": [
                        "достичь"
                    ],
                    "common_phrases": [
                        "достигнуть совершеннолетия",
                        "достигнуть зрелого возраста"
                    ],
                    "target_lang_definitions": {
                        "pl": "dożyć określonego wieku lub fazy życia"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osiągnąć",
                                "target_lang_sense_clarification": "wiek, pełnoletniość"
                            },
                            {
                                "target_lang_word": "dożyć",
                                "target_lang_sense_clarification": "podeszłego wieku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c49f720b-d7b7-37b3-96b3-bae30d58873b",
                    "sense_definition": "дойти до определённой степени, фазы или состояния в своём развитии",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "состояние",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Напряжение в зале заседаний успело <w>достигнуть</w> критической точки перед самым голосованием.",
                            "target_lang_translations": {
                                "pl": "Napięcie na sali obrad zdążyło <w>osiągnąć</w> punkt krytyczny tuż przed samym głosowaniem."
                            }
                        },
                        {
                            "text": "Конфликт между сторонами спора рискует <w>достигнуть</w> опасного накала без вмешательства посредников.",
                            "target_lang_translations": {
                                "pl": "Konflikt między stronami sporu grozi <w>osiągnięciem</w> niebezpiecznego poziomu bez interwencji mediatorów."
                            }
                        }
                    ],
                    "synonyms": [
                        "достичь"
                    ],
                    "common_phrases": [
                        "достигнуть высшей точки",
                        "достигнуть совершенства"
                    ],
                    "target_lang_definitions": {
                        "pl": "dojść do określonego stadium, fazy lub stanu w rozwoju"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osiągnąć",
                                "target_lang_sense_clarification": "stan, punkt kulminacyjny, poziom rozwoju"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7dfcee4-c0e0-339b-acad-fd3a7603b14a",
                    "sense_definition": "распространяясь в пространстве (о звуках, запахах, вестях), дойти до кого-либо или чего-либо",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "перемещение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тихий шум ночного прибоя смог <w>достигнуть</w> наших ушей сквозь открытые окна дома.",
                            "target_lang_translations": {
                                "pl": "Cichy szum nocnego przypływu zdołał <w>dotrzeć do</w> naszych uszu przez otwarte okna domu."
                            }
                        },
                        {
                            "text": "Тревожная новость о восстании успела быстро <w>достигнуть</w> столицы государства.",
                            "target_lang_translations": {
                                "pl": "Niepokojąca wieść o powstaniu zdążyła szybko <w>dotrzeć do</w> stolicy państwa."
                            }
                        }
                    ],
                    "synonyms": [
                        "достичь"
                    ],
                    "common_phrases": [
                        "достигнуть слуха"
                    ],
                    "target_lang_definitions": {
                        "pl": "rozchodząc się w przestrzeni (o dźwiękach, zapachach, wieściach), dotrzeć do odbiorcy"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dotrzeć do",
                                "target_lang_sense_clarification": "o dźwiękach, zapachach, wiadomościach"
                            },
                            {
                                "target_lang_word": "dojść do",
                                "target_lang_sense_clarification": "o głosach, wiadomościach do uszu/świadomości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}