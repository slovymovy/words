                "senses": [
                    {
                        "sense_id": "80092a8c-ac92-3240-ac46-0b9ebf9e9bad",
                        "entry_id": "991883cd-a6fa-3bd9-ae39-060a2a48fa99",
                        "glosses": [
                            "Réaliser une dispersion stable de particules colloïdales dans l'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca476bb0-ae99-41e0-a24b-fc18bd947692",
                                "sense_id": "80092a8c-ac92-3240-ac46-0b9ebf9e9bad",
                                "text": "On peut ainsi obtenir un sol dans un mélange eau-alcool, que l'on peut séparer et peptiser en milieu aqueux si nécessaire...."
                            },
                            {
                                "example_id": "9044aa4e-5f8f-419e-a1b9-9e11f77cf2f5",
                                "sense_id": "80092a8c-ac92-3240-ac46-0b9ebf9e9bad",
                                "text": "L'acide doit être en mesure de peptiser l'hydrate d'alumine; c'est le cas, en particulier, pour les acides acétique, perchlorique et..."
                            },
                            {
                                "example_id": "09533678-2e38-4334-b23b-e0b5b3dcb541",
                                "sense_id": "80092a8c-ac92-3240-ac46-0b9ebf9e9bad",
                                "text": "Argiles en milieu calcaire : le pH est légèrement supérieur à 7 d'où présence d'ions OH- et l'argile devrait peptiser."
                            }
                        ]
                    }
