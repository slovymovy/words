                        "examples": [
                            {
                                "example_id": "127c08ab-07ff-4155-a48b-c2123f477f40",
                                "sense_id": "107018e9-cc9d-3759-93c9-6fd14789ec52",
                                "text": "⧖ Fraai is de dennenpijlstaart, evenals de daaruit voortkomende vlinder; voorts is er de rups van den non vlinder, die in grooter aantal en dus schadelijker optreedt; maar vooral de gestreepte dennenrups heeft wegens haar verwoestingen een treurige vermaardheid. Ook de dennenspanrups kan men in de bosschen vinden, evenals eenige motten, waaronder die, welke als rupsje inde harstbuilen leeft en daaruit zeer gemakkelijk te kweeken is (bl. 35)."
                            }
