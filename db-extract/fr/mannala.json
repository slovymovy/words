                                        "glosses": [
                                            "Gebäck in der stilisierten Form eines Mannes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "496f2f17-2b27-4257-b3c3-e0b3517e3e63",
                                                "sense_id": "8d2fb3fc-6623-357c-a27e-eb3d720f4acd",
                                                "text": "„Diesmal gab's auch Schokoladenzigaretten, bei denen man nicht wußte, ob man das Papier mitessen konnte, und einen großen Stutenkerl mit weißer Tonpfeife.“"
                                            },
                                            {
                                                "example_id": "faa24454-0dd0-4647-a16f-848fc5213b76",
                                                "sense_id": "8d2fb3fc-6623-357c-a27e-eb3d720f4acd",
                                                "text": "„Sie begann zu kneten und legte den einzelnen Stutenkerl aufs Blech.“"
                                            }
