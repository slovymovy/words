                                        "glosses": [
                                            "ισχυρό θερμό θαλάσσιο ρεύμα που εντοπίζεται στον βορειοδυτικό Ειρηνικό Ωκεανό"
                                        ],
                                        "tags": [
                                            "μετεωρολογία",
