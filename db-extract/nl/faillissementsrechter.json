                        "glosses": [
                            "rechter die zich bezighoudt met bedrijven en personen die hun financiële verplichtingen niet meer kunnen nakomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf58094-a1c0-4033-a543-125ea5851c64",
                                "sense_id": "08fc17d2-3940-365e-ba22-d5698da0e582",
                                "text": "Een faillissementsrechter in de VS is akkoord gegaan met de betaling van omgerekend zo'n 14 miljoen euro aan de slachtoffers van de veroordeelde filmproducent Harvey Weinstein. De betaling is onderdeel van het liquidatieplan voor The Weinstein Company, het bedrijf van Harvey en zijn broer Bob."
                            },
                            {
                                "example_id": "8af1829d-8144-4f07-8f67-6b843a6934df",
                                "sense_id": "08fc17d2-3940-365e-ba22-d5698da0e582",
                                "text": "Gildan gaat ook kleding van American Apparel inkopen en is van plan om het merk via zijn bestaande distributienetwerk in Noord-Amerika te verkopen. Gildan zegt geen winkels van American Apparel over te nemen. Daardoor is onduidelijk wat er met de winkels gebeurt. De deal met Gildan moet nog worden goedgekeurd door de faillissementsrechter."
                            }
                        ]
                    }
