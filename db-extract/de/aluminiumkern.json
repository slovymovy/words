                "senses": [
                    {
                        "sense_id": "1ef4501d-e0cc-37ea-beef-1edd5bc25375",
                        "entry_id": "9e0e2a2a-f4e4-376b-838e-cc96dee32873",
                        "glosses": [
                            "Kern des Aluminiumatoms"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "fafeb972-afe9-4e33-9579-a3f057a4756c",
                                "sense_id": "1ef4501d-e0cc-37ea-beef-1edd5bc25375",
                                "text": "„Die Aussendung der Neutronenstrahlung ist mit der Darstellung des Phosphorkernes aus dem Aluminiumkern gekuppelt.“"
                            },
                            {
                                "example_id": "c8447d06-0eb5-40ab-b44a-a2c97d4da492",
                                "sense_id": "1ef4501d-e0cc-37ea-beef-1edd5bc25375",
                                "text": "„Diese Beobachtung wurde zuerst bei der Bestrahlung des Aluminiums mit x-Teilchen gemacht; beim Zusammenstoß eines ox-Teilchens mit einem Aluminiumkern entsteht unter gleichzeitiger Aussendung eines Neutrons (jn) ein Kern der Masse 30 […]“"
                            },
                            {
                                "example_id": "b76d0b1c-1994-4154-9c94-b907993de866",
                                "sense_id": "1ef4501d-e0cc-37ea-beef-1edd5bc25375",
                                "text": "„Wenn man annimmt, daß nur zentrale Treffer eines Alphateilchens die Abtrennung eines H-Teilchens veranlassen, so ist die Ausbeutezahl an ausgesprengten H-Teilchen ein Maß für die Treffwahrscheinlichkeit auf einen Aluminiumkern.“"
                            },
                            {
                                "example_id": "a4d66a73-7332-4aa2-b516-2c412f7c96ad",
                                "sense_id": "1ef4501d-e0cc-37ea-beef-1edd5bc25375",
                                "text": "„Wieviel mal näher kann ein a-Teilchen von gegebener Energie an einen Aluminiumkern herankommen als an einen Goldkern? Wie weit kann sich ein a-Teilchen aus einer Poloniumquelle einem Aluminiumkern nähern?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48627b1f-1609-3b01-99bd-d886604a8bde",
                        "entry_id": "9e0e2a2a-f4e4-376b-838e-cc96dee32873",
                        "glosses": [
                            "aus Aluminium bestehender Kern eines größeren Gebildes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a79f58-dd32-4be4-aeb4-99213c9c8057",
                                "sense_id": "48627b1f-1609-3b01-99bd-d886604a8bde",
                                "text": "„In der Pouch-Technologie wird als Gehäusematerial ein mehrlagiger Folienverbund mit einem Aluminiumkern eingesetzt.“"
                            },
                            {
                                "example_id": "37d2a4a0-a002-49d1-8053-dbcde64d222c",
                                "sense_id": "48627b1f-1609-3b01-99bd-d886604a8bde",
                                "text": "„Wie groß ist das Feld B im Aluminiumkern? Welcher Strom müsste fließen, damit in der leeren Spule (ohne Aluminiumkern) das gleiche Feld B herrscht, wie im Aluminiumkern, wenn der Strom 10 A fließt?“"
                            },
                            {
                                "example_id": "d93e6206-1143-4707-92c7-45a3a100f612",
                                "sense_id": "48627b1f-1609-3b01-99bd-d886604a8bde",
                                "text": "„Wie oben bereits erwähnt, befinden sich die LEDs eines Strangs auf einer Aluminiumkern-Leiterplatte..“"
                            },
                            {
                                "example_id": "0880afad-019d-47cc-931f-572b5d1d73ae",
                                "sense_id": "48627b1f-1609-3b01-99bd-d886604a8bde",
                                "text": "„Von dem Geschoß ist die Spitze mit dem Aluminiumkern sowie der größere Teil des Mantels erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
