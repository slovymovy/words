                "senses": [
                    {
                        "sense_id": "61d30e48-279e-3c3a-92fa-7595b160128b",
                        "entry_id": "451a0e17-76b7-3b10-b87a-3606f81d03bf",
                        "glosses": [
                            "scharfes Messer zum Schneiden von Lebensmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319e95b0-470b-46c7-a5d9-92d4d8e7d1d0",
                                "sense_id": "61d30e48-279e-3c3a-92fa-7595b160128b",
                                "text": "Sei vorsichtig, wenn du das Küchenmesser benutzt."
                            },
                            {
                                "example_id": "d9dcaa59-047f-4cd6-a0bb-2ec6a5aec41e",
                                "sense_id": "61d30e48-279e-3c3a-92fa-7595b160128b",
                                "text": "„Einmal schnitt sie sich mit einem Küchenmesser in den Finger.“"
                            },
                            {
                                "example_id": "bb60844a-76e9-4d8e-a8d6-04c1d4940e2e",
                                "sense_id": "61d30e48-279e-3c3a-92fa-7595b160128b",
                                "text": "„Was wir besitzen, ist rasch aufgezählt: meine Matratze, Küchenmesser und Teekessel, einen Kochtopf samt Kochlöffel, drei Thermosflaschen und pro Kopf ein Eßbesteck, einen Teller und anderthalb Tassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3796d7a1-deaf-474e-876d-610b7e995a69",
                        "source_entry_id": "451a0e17-76b7-3b10-b87a-3606f81d03bf",
