                        {
                            "text": "De slager scheidde het bruikbare vlees zorgvuldig van het overtollige <w>karwei</w>.",
                            "target_lang_translations": {
                                "en": "The butcher carefully separated the usable meat from the excess <w>slaughter waste</w>."
                            }
                        }
                    ],
                    "synonyms": [
