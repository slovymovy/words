                    {
                        "sense_id": "72c28a73-28c4-3128-8aaf-59f4cfddb170",
                        "entry_id": "5c8e2cd7-e901-36da-a15a-dc0fbb267097",
                        "glosses": [
                            "Not funny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c4dffa-8271-44f6-ae14-ff3a44058b67",
                                "sense_id": "72c28a73-28c4-3128-8aaf-59f4cfddb170",
                                "text": "Edward told an unfunny knock-knock joke that made his brother groan."
                            },
                            {
                                "example_id": "9f60350e-6b3f-4b46-bbec-373df5d62c17",
                                "sense_id": "72c28a73-28c4-3128-8aaf-59f4cfddb170",
                                "text": "The decline of mobility, reason fading in and out like short-wave radio, the trickle of minor ailments that fed a deeper river—the subject was vast and not all of it was unfunny."
                            }
                        ]
                    }
                ],
