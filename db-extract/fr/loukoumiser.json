                ],
                "senses": [
                    {
                        "sense_id": "5a75c433-8976-38ff-874a-fe6e0b7a3cc1",
                        "entry_id": "4f647c01-4d83-38b4-96e6-e1c6fab91924",
                        "glosses": [
                            "Donner un caractère rappelant un loukoum, gros et amorphe, à."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "40e4a2db-4014-4519-847e-13e178824146",
                                "sense_id": "5a75c433-8976-38ff-874a-fe6e0b7a3cc1",
                                "text": "Ne nous sommes pas si naïfs au point de nous faire “loukoumiser” de la sorte."
                            },
                            {
                                "example_id": "41ae4494-e3b9-493e-9e63-0f1fd00a4640",
                                "sense_id": "5a75c433-8976-38ff-874a-fe6e0b7a3cc1",
                                "text": "Très belle manucure que j'essayerai de reproduire quand cette chaleur cessera de me loukoumiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "00079c59-58c0-39bc-8f41-22a7a0b3a2ab",
                        "entry_id": "4f647c01-4d83-38b4-96e6-e1c6fab91924",
                        "glosses": [
                            "Se comporter comme quelqu’un qui se gave de loukoums, se prélasser sans rien faire."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d6cbf7f6-de6a-4088-9f99-957369705ae7",
                                "sense_id": "00079c59-58c0-39bc-8f41-22a7a0b3a2ab",
                                "text": "Après cela on a le droit de loukoumiser dans les canapés du salon, de regarder le va-et-vient incessant des serveurs et de fixer le plafond en rêvant que l’on va monter dans une des chambres pour faire une sieste."
                            },
                            {
                                "example_id": "eb37c63a-64d8-4b85-84b3-25a5be3cb729",
                                "sense_id": "00079c59-58c0-39bc-8f41-22a7a0b3a2ab",
                                "text": "Plutôt que de « loukoumiser » à regarder les enfants s'agiter sur la plage, je participe à leurs jeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "3deba8b0-11d3-39a3-9d28-9498f05aaa7e",
                        "entry_id": "4f647c01-4d83-38b4-96e6-e1c6fab91924",
                        "glosses": [
                            "Prendre un caractère rappelant un loukoum, gros et amorphe."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "62013083-bfa2-4236-88d3-ab722ee2a80e",
                                "sense_id": "3deba8b0-11d3-39a3-9d28-9498f05aaa7e",
                                "text": "\"Je me loukoumise\", a-t-il expliqué en riant au Parisien."
                            },
                            {
                                "example_id": "995c3a88-c7fc-47d3-a880-2a8c6155fb0b",
                                "sense_id": "3deba8b0-11d3-39a3-9d28-9498f05aaa7e",
                                "text": "Je n'en peux plus de cet hiver sans fin. De me loukoumiser."
                            },
                            {
                                "example_id": "c57eb954-36e6-460b-b24e-36d96845022f",
                                "sense_id": "3deba8b0-11d3-39a3-9d28-9498f05aaa7e",
                                "text": "Elle a des bonnes grosses joues et commence à se loukoumiser (celui qui ose dire telle mère telle fille sera brulé vif)."
                            }
                        ]
                    }
                ],
