{
    "word_family": [
        "porcelaneous",
        "porcelainize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b108e97-0f8b-3eb0-a192-2f76db4cd267",
                    "sense_definition": "A hard, white, translucent ceramic material made by firing clay at high temperatures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ceramic_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used fine <w>porcelain</w> to create the delicate white vase.",
                            "target_lang_translations": {
                                "ru": "Художник использовал высококачественный <w>фарфор</w>, чтобы создать изящную белую вазу."
                            }
                        },
                        {
                            "text": "Most high-quality bathroom sinks and toilets are made of <w>porcelain</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство высококачественных раковин и унитазов изготавливаются из <w>фарфора</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "china"
                    ],
                    "common_phrases": [
                        "fine porcelain",
                        "white porcelain",
                        "porcelain doll"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый, белый, полупрозрачный керамический материал, получаемый путем обжига глины при высоких температурах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фарфор",
                                "target_lang_sense_clarification": "материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d1ba667-298f-330c-ad37-cd2762c8a7e1",
                    "sense_definition": "Tableware, such as plates and cups, made from porcelain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tableware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully set the table with her best <w>porcelain</w> for the dinner party.",
                            "target_lang_translations": {
                                "ru": "Она тщательно накрыла стол своим лучшим <w>фарфором</w> к званому ужину."
                            }
                        },
                        {
                            "text": "The family heirloom <w>porcelain</w> was only used on very special occasions.",
                            "target_lang_translations": {
                                "ru": "Семейный реликвийный <w>фарфор</w> использовался только в самых торжественных случаях."
                            }
                        }
                    ],
                    "synonyms": [
                        "china",
                        "chinaware"
                    ],
                    "common_phrases": [
                        "antique porcelain",
                        "collectible porcelain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Столовая посуда, такая как тарелки и чашки, изготовленная из фарфора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фарфор",
                                "target_lang_sense_clarification": "изделия"
                            },
                            {
                                "target_lang_word": "фарфоровая посуда",
                                "target_lang_sense_clarification": "столовые принадлежности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89be6de7-2f78-3fb2-8132-8c32d9a33d8d",
                    "sense_definition": "The specific type of clay, such as <w>kaolin</w>, used to manufacture ceramic goods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceramic_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners extracted the raw <w>porcelain</w> from the hills to supply the factory.",
                            "target_lang_translations": {
                                "ru": "Шахтеры добывали сырую <w>фарфоровую глину</w> в холмах для снабжения фабрики."
                            }
                        },
                        {
                            "text": "This region is famous for its deposits of pure white <w>porcelain</w> clay.",
                            "target_lang_translations": {
                                "ru": "Этот регион славится залежами чистой белой <w>фарфоровой глины</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kaolin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический тип глины, такой как каолин, используемый для производства керамических изделий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фарфоровая глина",
                                "target_lang_sense_clarification": "сырье"
                            },
                            {
                                "target_lang_word": "каолин",
                                "target_lang_sense_clarification": "белая глина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a314982-1574-3aa8-ba33-0819e640c049",
                    "sense_definition": "A type of sea shell, specifically a <w>cowrie</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shells",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some ancient cultures, the <w>porcelain</w> shell was used as a form of currency.",
                            "target_lang_translations": {
                                "ru": "В некоторых древних культурах раковина <w>каури</w> использовалась в качестве валюты."
                            }
                        },
                        {
                            "text": "The collector found a rare species of <w>porcelain</w> while diving in the tropics.",
                            "target_lang_translations": {
                                "ru": "Коллекционер нашел редкий вид <w>фарфоровой улитки</w> во время погружения в тропиках."
                            }
                        }
                    ],
                    "synonyms": [
                        "cowrie"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically to refer to shells"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип морской раковины, в частности каури."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каури",
                                "target_lang_sense_clarification": "раковина"
                            },
                            {
                                "target_lang_word": "фарфоровая улитка",
                                "target_lang_sense_clarification": "моллюск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fcf98e3-a455-3643-8350-0051cce13f98",
                    "sense_definition": "Strings of shells or beads used as ornamentation or currency, similar to <w>wampum</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers exchanged <w>porcelain</w> for food and supplies during their journey.",
                            "target_lang_translations": {
                                "ru": "Путешественники обменивали <w>вампум</w> на еду и припасы во время своего пути."
                            }
                        },
                        {
                            "text": "Intricate belts made of <w>porcelain</w> were worn by the tribal leaders.",
                            "target_lang_translations": {
                                "ru": "Сложные пояса из <w>ракушек</w> носились вождями племен."
                            }
                        }
                    ],
                    "synonyms": [
                        "wampum"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage for shell beads"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связки ракушек или бусин, используемые в качестве украшения или валюты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вампум",
                                "target_lang_sense_clarification": "ожерелье из ракушек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4995dc1c-9c64-30ea-8370-a9867725160a",
                    "sense_definition": "A variety of pigeon characterized by deep brown and off-white feathers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird enthusiast kept several <w>porcelains</w> in his backyard aviary.",
                            "target_lang_translations": {
                                "ru": "Любитель птиц держал несколько <w>фарфоровых голубей</w> в вольере на заднем дворе."
                            }
                        },
                        {
                            "text": "Among the different breeds at the show, the <w>porcelain</w> stood out for its unique pattern.",
                            "target_lang_translations": {
                                "ru": "Среди различных пород на выставке <w>фарфоровый голубь</w> выделялся своим уникальным окрасом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "specific breed name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность голубя, характеризующаяся темно-коричневым и грязно-белым оперением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фарфоровый голубь",
                                "target_lang_sense_clarification": "порода"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e73cd7a6-31a9-3c31-a574-7e198f4a3110",
                    "sense_definition": "To coat a surface with a porcelain enamel finish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer decided to <w>porcelain</w> the interior of the oven for durability.",
                            "target_lang_translations": {
                                "ru": "Производитель решил <w>покрыть фарфоровой эмалью</w> внутреннюю часть духовки для долговечности."
                            }
                        },
                        {
                            "text": "They are <w>porcelaining</w> the metal panels to protect them from rust.",
                            "target_lang_translations": {
                                "ru": "Они <w>эмалируют</w> металлические панели, чтобы защитить их от ржавчины."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность слоем фарфоровой эмали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмалировать",
                                "target_lang_sense_clarification": "покрывать эмалью"
                            },
                            {
                                "target_lang_word": "покрывать фарфором",
                                "target_lang_sense_clarification": "наносить покрытие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}