                "senses": [
                    {
                        "sense_id": "42b42827-db64-3805-9ea5-72ae3c3a4c09",
                        "entry_id": "ccc90b68-c35e-3427-ac16-a66b4809491a",
                        "glosses": [
                            "Tumeur extérieure qui suppure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c3b83e9-a2d2-4a38-8ef5-40bd121e9169",
                                "sense_id": "42b42827-db64-3805-9ea5-72ae3c3a4c09",
                                "text": "C’est pas exactement de la parole, maintenant, c’est comme si je saignais. C’est comme d’un mauvais apostume que j’ai crevé du couteau et qui saigne du sang et du pus ; voilà ma parole de ce soir, voilà. C’est du mal qui s’en va."
                            }
                        ]
                    },
                    {
                        "sense_id": "15ffe411-1585-35a6-9d9d-ffec1db35939",
                        "entry_id": "ccc90b68-c35e-3427-ac16-a66b4809491a",
                        "glosses": [
                            "Grosseur extérieure qui suppure."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8e333f49-58eb-409e-84d6-f3f59ec48d3c",
                                "sense_id": "15ffe411-1585-35a6-9d9d-ffec1db35939",
                                "text": "Des gommes s’accumulaient le long des écorces, comme des apostumes par les fentes desquelles couraient les résines ; aux branches s’ouvraient des plaies pareilles à des bouches, à des flans ébrasés et spumants."
                            }
                        ]
                    }
