                ],
                "senses": [
                    {
                        "sense_id": "54e49beb-f92f-311f-a2a8-cc7274594857",
                        "entry_id": "3dfdd972-4d0a-31ba-8d78-8698b105b10a",
                        "glosses": [
                            "angestrebte Ziele in der Entwicklung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633d0b0d-0c8f-457f-96bd-f41c7c3d0f53",
                                "sense_id": "54e49beb-f92f-311f-a2a8-cc7274594857",
                                "text": "„Im Rahmen der Untersuchung zur Selbstdefinition Jugendlicher ist es von besonderem Interesse zu wissen, welches Entwicklungsziel Jugendliche anstreben.“"
                            },
                            {
                                "example_id": "74c0a7ae-0a5c-4170-814e-c75c219b4d67",
                                "sense_id": "54e49beb-f92f-311f-a2a8-cc7274594857",
                                "text": "„Den Teilnehmern an dieser Befragung wurde diese Checkliste als Anregung zur Erarbeitung persönlicher Entwicklungsziele vorgelegt.“"
                            },
                            {
                                "example_id": "8e184b98-f8c4-437b-8020-531bd1ae878d",
                                "sense_id": "54e49beb-f92f-311f-a2a8-cc7274594857",
                                "text": "„Die technisch erreichbaren Entwicklungsziele sind ebenfalls in der Tabelle angegeben.“"
                            },
                            {
                                "example_id": "b793787b-eb70-49fb-8115-55fd118c8134",
                                "sense_id": "54e49beb-f92f-311f-a2a8-cc7274594857",
                                "text": "„Dort wurde festgehalten, dass ein inklusives Bildungssystem als Entwicklungsziel aller Schulen anzustreben ist.“"
                            },
                            {
                                "example_id": "2a4e9c18-1581-4317-945d-6c7716fed475",
                                "sense_id": "54e49beb-f92f-311f-a2a8-cc7274594857",
                                "text": "„Dies ist ein Entwicklungsziel, und das Modell soll didaktisch helfen, dieses Entwicklungsziel zu erreichen.“"
                            },
                            {
                                "example_id": "618da323-8b9f-4f7e-9db5-b43bd1e8fb31",
                                "sense_id": "54e49beb-f92f-311f-a2a8-cc7274594857",
                                "text": "„Das Entwicklungsziel eines raschen Körperwachstums steht in enger Verbindung mit mütterlichen Sorgen um die Gesundheit ihrer Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
