                "senses": [
                    {
                        "sense_id": "79c49166-17ee-32cb-b493-98f400bcb0ed",
                        "entry_id": "3a6183f3-ae5f-3ce2-b359-53845afe5e3a",
                        "glosses": [
                            "größeres gegartes Fleischstück, das von einem Lamm stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62b4180-483b-4769-9f27-86f402854749",
                                "sense_id": "79c49166-17ee-32cb-b493-98f400bcb0ed",
                                "text": "„Zum Osterfest hat es sich auch bei uns eingebürgert, Traditionen aus Spanien, Südfrankreich und Griechenland zu folgen und einen Lammbraten auf den Tisch zu bringen.“"
                            },
                            {
                                "example_id": "34001663-fda3-4795-af09-fc383a619733",
                                "sense_id": "79c49166-17ee-32cb-b493-98f400bcb0ed",
                                "text": "„Der Wein floß in Strömen zum Lammbraten, und Pfirsiche ließen die Suppen Wellen schlagen.“"
                            }
                        ],
