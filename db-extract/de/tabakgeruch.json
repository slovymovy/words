                    {
                        "sense_id": "2bcd91ac-bd8c-365f-a133-ed7837a0651f",
                        "entry_id": "94c344df-700d-3074-bfc8-8af6a52309de",
                        "glosses": [
                            "Wahrnehmung des Geruchs, der von Tabakpflanzen und später nur von deren Blättern stammt; natürlicher Eigengeruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5485ff8-7580-40e3-9ddb-fb6c0603cfcc",
                                "sense_id": "2bcd91ac-bd8c-365f-a133-ed7837a0651f",
                                "text": "„Außerdem würden die großen Tabakmengen das Raumklima spürbar beeinflussen: Hohe Luftfeuchtigkeit oder intensiver Tabakgeruch wären die Folge.“"
                            },
                            {
                                "example_id": "6b5c4d9e-0869-4c2b-8a74-e9705f34818b",
                                "sense_id": "2bcd91ac-bd8c-365f-a133-ed7837a0651f",
                                "text": "„Nach ca. 12 - 14 Tagen sollte man einen angenehmen Tabakgeruch merken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
