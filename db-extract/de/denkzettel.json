                                            {
                                                "example_id": "c6d05ca1-bffb-4b2d-a7ca-5d6d807626ce",
                                                "sense_id": "31fa6f20-26c8-3a58-a770-efb4eca3d301",
                                                "text": "Lorsqu’un mémo est expédié à l’ensemble du personnel, il est facile de présumer qu’il exprime l’essentiel et ainsi oublier que les significations qu’il génère sont aussi fonction des relations entre les parties concernées."
                                            },
                                            {
                                                "example_id": "1e23b695-898f-444d-8a4f-0e30b93fa1d3",
                                                "sense_id": "31fa6f20-26c8-3a58-a770-efb4eca3d301",
                                                "text": "Si Risa rédigeait même le plus ordinaire des mémos, Noa s’arrêtait pour le lire une seconde fois...."
                                            },
                                            {
                                                "example_id": "10c5edec-fe85-402c-9bf7-61924690638d",
                                                "sense_id": "31fa6f20-26c8-3a58-a770-efb4eca3d301",
                                                "text": "Au début du conflit, Gertrude Bell avait rédigé un long mémo, fondé sur ses dernières expéditions dans la région."
                                            }
                                        ]
