                        "entry_id": "6ce8f709-ec3b-3df8-b4a8-38b978ce00fb",
                        "glosses": [
                            "A Turkish city, and the largest European city by population, which was the last capital of the Ottoman Empire and the Byzantine Empire (Eastern Roman Empire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de9cbe83-45ee-4665-8324-dc26822b46f5",
                                "sense_id": "22097e5f-3121-3396-bb93-8c6a05ee3113",
                                "text": "Nearly a century ago, my grandfather passed through Istanbul en route to Europe along with hordes of other White Russians fleeing the Russian civil war."
                            }
                        ]
                    },
