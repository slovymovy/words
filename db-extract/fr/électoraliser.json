                "senses": [
                    {
                        "sense_id": "5756c11f-0fec-35b2-9ce4-91fcec9895b2",
                        "entry_id": "a97ae6be-a269-31cd-a40b-9d1e64850085",
                        "glosses": [
                            "Donner un caractère électoral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ac3e7b8-7dba-4115-be10-724c777bfa5b",
                                "sense_id": "5756c11f-0fec-35b2-9ce4-91fcec9895b2",
                                "text": "La logique d'électoraliser l'écologie a trop politisé les combats."
                            },
                            {
                                "example_id": "522b0172-8167-4111-ac57-f0c3735bd67e",
                                "sense_id": "5756c11f-0fec-35b2-9ce4-91fcec9895b2",
                                "text": "Parce que le nouveau maire demeurait silencieux, l'ancien, Jean-Claude Delalonde, a claironné son refus, dans l'intention, évidente, d' «électoraliser» le débat."
                            },
                            {
                                "example_id": "9b9c06a4-9577-4feb-8806-8f80f7100d92",
                                "sense_id": "5756c11f-0fec-35b2-9ce4-91fcec9895b2",
                                "text": "Et voilà 500 emplois « d'obligés socialos » qu'il ne pourra pas octroyer, fidéliser, électoraliser !"
                            }
                        ]
                    }
