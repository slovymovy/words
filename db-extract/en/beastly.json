                "senses": [
                    {
                        "sense_id": "15a86929-2c7c-380f-9bbb-2a6b946e2b1e",
                        "entry_id": "2b766c4a-dbbc-3bf5-8ff3-fe439298c3ed",
                        "glosses": [
                            "Like a beast; brutishly."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "a55513f5-1167-4803-a507-3f1a860d59c2",
                                "sense_id": "15a86929-2c7c-380f-9bbb-2a6b946e2b1e",
                                "text": "Beastly he threwe her downe, ne car'd to spill / Her garments gay with scales of fish that all did fill."
                            },
                            {
                                "example_id": "85507381-7a48-4abf-a0ee-9cc88f4f53ca",
                                "sense_id": "15a86929-2c7c-380f-9bbb-2a6b946e2b1e",
                                "text": "They have insulted me most beastly. Moreover, they are, everyone of them, black-satan filthmen."
                            },
                            {
                                "example_id": "ffdc7a84-e146-4137-bcd4-07ff880e143e",
                                "sense_id": "15a86929-2c7c-380f-9bbb-2a6b946e2b1e",
                                "text": "The baths were mostly tiled showers, with an endless variety of spouting mechanisms, but with one definitely non-Laodicean characteristic in common, a propensity, while in use, to turn instantly beastly hot or blindingly cold upon you, depending on whether your neighbor turned on his cold or his hot to deprive you of a necessary complement in the shower you had so carefully blended."
                            }
                        ]
                    }
                ],
