                "senses": [
                    {
                        "sense_id": "ed8c8689-fe4c-36b9-90bd-31e4d5c551b1",
                        "entry_id": "16be2e73-8e58-3b20-b558-e13ef16665b6",
                        "glosses": [
                            "Eigenschaft eines Programmes, in eine andere Umgebung/Anlage übertragbar (portabel) zu sein"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "3596052e-35c4-4f21-9c12-1c922fe27203",
                                "sense_id": "ed8c8689-fe4c-36b9-90bd-31e4d5c551b1",
                                "text": "„Portabilität ist eine Eigenschaft von Software (Programme und Daten), die es erlaubt, diese mit relativ geringem Aufwand von einem Grundsystem auf ein anderes zu übertragen.“"
                            },
                            {
                                "example_id": "429e07d0-55d3-4e87-8690-2f6679124433",
                                "sense_id": "ed8c8689-fe4c-36b9-90bd-31e4d5c551b1",
                                "text": "Hoher Umstellungsaufwand bedeutet geringe Portabilität."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4e1d43b-c718-3bb4-b665-86156118e444",
                        "entry_id": "16be2e73-8e58-3b20-b558-e13ef16665b6",
                        "glosses": [
                            "Eigenschaft einer Versicherung/Rückstellung, übertragbar (portabel) zu sein"
                        ],
                        "tags": [
                            "Versicherungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "d739d91d-515f-4428-9606-484e115af2fe",
                                "sense_id": "a4e1d43b-c718-3bb4-b665-86156118e444",
                                "text": "„Zur Stärkung des Wettbewerbs der PKVen untereinander wurde zusätzlich die Portabilität von Altersrückstellungen der Versicherten bei einem Wechsel innerhalb der PKV ermöglicht.“"
                            },
                            {
                                "example_id": "c0c0026e-4417-4c7d-9ba8-bbf43e78e27f",
                                "sense_id": "a4e1d43b-c718-3bb4-b665-86156118e444",
                                "text": "In der Betrieblichen Altersversorgung in Deutschland versteht man im Fall eines Arbeitgeberwechsels unter Portabilität die Übertragbarkeit von bereits erworbenen Versorgungsanwartschaften des Arbeitnehmers von einem auf den nächsten Arbeitgeber."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
