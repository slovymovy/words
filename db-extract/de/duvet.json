                "senses": [
                    {
                        "sense_id": "667b901d-1eb6-3728-bb46-150efb883bb3",
                        "entry_id": "a3e8411d-fff7-309d-ad7e-55720f91005f",
                        "glosses": [
                            "Bettdecke, die mit Federn oder anderen weichen Materialien gefüllt ist"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "cd81285c-b65b-47a3-b911-c288543fbea1",
                                "sense_id": "667b901d-1eb6-3728-bb46-150efb883bb3",
                                "text": "„Längst hat das nordische Schlafen mit Kissen, Duvet und properer Bettwäsche den Mief von damals abgelöst.“"
                            },
                            {
                                "example_id": "411fdbc1-c106-4efd-8826-3023d5f16ac6",
                                "sense_id": "667b901d-1eb6-3728-bb46-150efb883bb3",
                                "text": "„Eine dicke Matratze, darüber eine dünne Auflage, garniert mit einem riesigen Duvet und vier Kissen, das alles eingehüllt in feinste weisse Wäsche.“"
                            },
                            {
                                "example_id": "529670cc-ce91-4cfc-9d55-508faf4634d1",
                                "sense_id": "667b901d-1eb6-3728-bb46-150efb883bb3",
                                "text": "„Dreissig Bergsteiger passen hinein, doch zum Glück ist es nur zur Hälfte gefüllt, es hat genug Platz, um sich umzudrehen, und unter den Duvets liegt es sich bequem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
