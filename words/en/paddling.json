{
    "word_family": [
        "paddle",
        "paddler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c784072-9beb-3351-9976-8b9c681d36e7",
                    "sense_definition": "The act of propelling a boat or canoe using a paddle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a peaceful <w>paddling</w> session on the lake early in the morning.",
                            "target_lang_translations": {
                                "zh": "清晨，我们在湖上进行了一次宁静的<w>划船</w>活动。"
                            }
                        },
                        {
                            "text": "Good <w>paddling</w> technique helps you move faster with less effort.",
                            "target_lang_translations": {
                                "zh": "良好的<w>划桨</w>技术能让你更省力地快速前进。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go paddling"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用桨划船的动作或活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "划船",
                                "target_lang_sense_clarification": "指使用桨在水上划行的动作。"
                            },
                            {
                                "target_lang_word": "划桨",
                                "target_lang_sense_clarification": "指操作桨的动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24f6e289-22eb-37c8-bf42-46b11e69cc6a",
                    "sense_definition": "A form of corporal punishment in which a person is struck on the buttocks with a wooden paddle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The headmaster threatened the rebellious student with a severe <w>paddling</w>.",
                            "target_lang_translations": {
                                "zh": "校长威胁那个叛逆的学生要对他进行严厉的<w>打屁股</w>惩罚。"
                            }
                        },
                        {
                            "text": "In some old schools, students would get a <w>paddling</w> for misbehaving in class.",
                            "target_lang_translations": {
                                "zh": "在一些旧式学校里，学生如果上课表现不好会挨<w>打屁股</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spanking",
                        "flogging"
                    ],
                    "common_phrases": [
                        "get a paddling",
                        "give a paddling"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种体罚方式，用木板拍打人的臀部。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打屁股",
                                "target_lang_sense_clarification": "指用手或工具拍打臀部的体罚。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5364ec77-07b1-3a37-9144-e3554425139b",
                    "sense_definition": "A collective term for a group of ducks floating on water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spotted a large <w>paddling</w> of ducks floating calmly across the river.",
                            "target_lang_translations": {
                                "zh": "我们看到<w>一群</w>鸭子平静地漂浮在河面上。"
                            }
                        },
                        {
                            "text": "A <w>paddling</w> of wild ducks rested near the edge of the reeds.",
                            "target_lang_translations": {
                                "zh": "<w>一群</w>野鸭在芦苇丛边休息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "paddling of ducks"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一群在水面上漂浮的鸭子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一群",
                                "target_lang_sense_clarification": "用于描述鸭子聚集在一起的量词。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4ed04da-b583-3422-bd61-9abe7e79dbb2",
                    "sense_definition": "present participle and gerund of <w>paddle</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>paddling</w> down the river in a bright red canoe.",
                            "target_lang_translations": {
                                "zh": "他们正<w>划</w>着一艘鲜红的独木舟顺流而下。"
                            }
                        },
                        {
                            "text": "She spent the entire afternoon <w>paddling</w> gently along the coast.",
                            "target_lang_translations": {
                                "zh": "她整个下午都在沿着海岸轻轻地<w>划</w>行。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "划（船）；用桨划行。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "划",
                                "target_lang_sense_clarification": "指用桨在水中划动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}