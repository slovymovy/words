                        "examples": [
                            {
                                "example_id": "775bb6a2-0231-4983-9890-476939af7bbc",
                                "sense_id": "d94c9aef-f3d6-3f2d-8915-63a532386f7b",
                                "text": "Cependant cette parousie de l'affectivité se distingue de la présence à soi de type métaphysique, dans la mesure où il est impossible pour l'essence de s'auto-approprier."
                            },
                            {
                                "example_id": "21b320f7-b4c7-427c-a58f-43e699f7b6e9",
                                "sense_id": "d94c9aef-f3d6-3f2d-8915-63a532386f7b",
                                "text": "Permettre aux enfants de s'auto-approprier le savoir, de décider individuellement et collectivement par eux mêmes de leurs apprentissages, de se structurer selon leur rythme par tâtonnement expérimental, est aujourd'hui plus facilement réalisable en classe unique."
                            }
                        ]
