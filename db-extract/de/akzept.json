                                "target_senses": [
                                    {
                                        "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The act of accepting; the receiving of something offered, with acquiescence, approbation, or satisfaction; especially, favourable reception; approval."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d196254b-13ae-4757-a610-398136a33157",
                                                "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                                "text": "the acceptance of a gift, office, doctrine, etc."
                                            },
                                            {
                                                "example_id": "6b323343-5e92-4142-bf8b-4e3ed98b6375",
                                                "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                                "text": "All the flockes of Kedar shall be gathered together vnto thee, the rams of Nebaioth shall minister vnto thee: they shall come vp with acceptance on mine altar, and I wil glorifie the house of my glory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b8e078d-a81d-31e9-b168-c15e371c20ed",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "An instance of that act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73216d6a-e648-3793-9b1a-705de3a36558",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "Belief in something; agreement, assent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "089c969d-9895-30a3-ab08-3448943238b0",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The state of being accepted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277671ca-aba6-46d3-a0a9-0807e1176d68",
                                                "sense_id": "089c969d-9895-30a3-ab08-3448943238b0",
                                                "text": "The warrant I haue of your Honourable Diſpoſition, not the Worth of my vntutor'd Lines makes it aſſured of acceptance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5605821-3c96-3b2d-8d48-4c1c58d61198",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The usual or accepted meaning of a word or expression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48c673c0-1322-3fbf-be2a-991444445112",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "An assent and engagement by the person on whom a bill of exchange is drawn, to pay it when due according to the terms of the acceptance; the bill of exchange itself when accepted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73815f9c-66fb-32ca-8aa8-51ebe92d5e25",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "An agreeing to the action, proposals, or terms of another by some act which results in the conclusion of a legally binding contract; the reception or taking of a thing bought as that for which it was bought, or as that agreed to be delivered, or the taking of possession of a thing as owner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebe383e-2e82-4746-91e8-1f33532fef29",
                                                "sense_id": "73815f9c-66fb-32ca-8aa8-51ebe92d5e25",
                                                "text": "But what acts shall amount to such an acceptance is often a question of great nicety and difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df8b1be-8799-3486-981e-c4ee77e7feef",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The act of an authorized representative of the government by which the government assents to ownership of existing and identified supplies, or approves specific services rendered, as partial or complete performance of a contract."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b37e30dc-f015-30cf-b68c-93debe637ba9",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
