                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60ba66bc-00e3-32ee-84bd-2c86e996cc0c",
                                        "entry_id": "c4be9cdc-f059-35de-b2f1-3a721f0e049a",
                                        "glosses": [
                                            "To serve as the leading locomotive on a double-headed train."
                                        ],
                                        "tags": [
                                            "of a locomotive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69f0731-b773-4577-8798-843768856819",
                                                "sense_id": "60ba66bc-00e3-32ee-84bd-2c86e996cc0c",
                                                "text": "One of the Midland Lines' Birmingham R.C.W. Type 2 diesels, No. D5403, made the debut of its class in the Manchester area on July 28 when it appeared in the early hours on freight; after four days in the area it left for the south piloting B.R./Sulzer Type 4 diesel No. D88 on the 2.25 Manchester Central-St. Pancras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee5d237e-2e34-3979-9afc-abead637ad31",
                                        "entry_id": "c4be9cdc-f059-35de-b2f1-3a721f0e049a",
                                        "glosses": [
                                            "To guide or conduct (a person) somewhere."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f978c7e8-efef-4f7f-aa3e-f0c668cffb56",
                                                "sense_id": "ee5d237e-2e34-3979-9afc-abead637ad31",
                                                "text": "Thus it came about that, three days later, I descended from the train at Styles St. Mary, an absurd little station, with no apparent reason for existence, perched up in the midst of green fields and country lanes. John Cavendish was waiting on the platform, and piloted me out to the car."
                                            }
                                        ]
                                    }
                                ]
