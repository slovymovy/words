                        "form_id": "8fbad4da-13d4-41bf-aea2-71e61a71d45a",
                        "entry_id": "1e60bae4-ce0f-302f-b347-6f0cc74e548c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "felsiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "094bb83e-b3b3-37bb-917e-7129045b1465",
                        "entry_id": "1e60bae4-ce0f-302f-b347-6f0cc74e548c",
                        "glosses": [
                            "Qualifie un minéral, surtout un silicate, riche en silicium, en aluminium, en sodium et en potassium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ced1f06b-aa4f-49db-9950-90f9327fe8f9",
                                "sense_id": "094bb83e-b3b3-37bb-917e-7129045b1465",
                                "text": "La plus grande partie des horizons de tuf felsique affleure dans la partie SE de la bande de volcanites felsiques du lac Porphyre."
                            },
                            {
                                "example_id": "a7170951-b687-4aef-ad01-ce888097a48f",
                                "sense_id": "094bb83e-b3b3-37bb-917e-7129045b1465",
                                "text": "La première étape consiste à la formation de lentilles de matériel felsique qui résulte de la cristallisation fractionnée du magma basaltique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18db882a-05b1-4c0b-88c5-a924ff0551ae",
                        "source_entry_id": "1e60bae4-ce0f-302f-b347-6f0cc74e548c",
                        "source_sense_id": "094bb83e-b3b3-37bb-917e-7129045b1465",
                        "target_lang_word": "felsic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "felsic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c9d14a4-2521-3374-a987-dced9c59e04b",
                                        "entry_id": "7f69fa4c-b60d-39cb-919e-6fee4ddb7db7",
                                        "glosses": [
                                            "Enriched in minerals predominantly composed of the lighter elements such as silicon, oxygen, aluminium, sodium, and potassium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733fdb49-2342-431e-9d21-7c8d0d2c21e6",
                                                "sense_id": "3c9d14a4-2521-3374-a987-dced9c59e04b",
                                                "text": "Much of the southern half of the southeastern body is a mafic syenite, slightly more felsic than the shonkinite."
                                            },
                                            {
                                                "example_id": "065aa2da-2a13-404c-b60b-737839f180ee",
                                                "sense_id": "3c9d14a4-2521-3374-a987-dced9c59e04b",
                                                "text": "Within comagmatic suites, successively younger granitoids are commonly, but not invariably, more felsic, representing progressively lower temperature mineral assemblages."
                                            },
                                            {
                                                "example_id": "566b9e0d-68d7-4514-a050-2aa26f4e3607",
                                                "sense_id": "3c9d14a4-2521-3374-a987-dced9c59e04b",
                                                "text": "The Claret Creek Supersuite granites are a little more felsic (65-77% SiO₂), and are chemically distinctive, having higher Al₂O₃, CaO, Na₂O and Sr, and lower K₂O, Rb, Th and U than the granites of the Almaden Supersuite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "felsic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67091e49-046f-3921-86b4-0e027c9a68a0",
                                        "entry_id": "66998d69-403d-3e29-9a6d-65583d74d54d",
                                        "glosses": [
                                            "A rock with such properties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4640cf-d828-4e65-a1b6-28f27a92464d",
                                                "sense_id": "67091e49-046f-3921-86b4-0e027c9a68a0",
                                                "text": "The central part of this nepheline syenite is very white felsics with black mafics in it. The entire area contains many nepheline-bearing dike rocks, but almost all are gray or pink or even red due to the color in the felsics."
                                            },
                                            {
                                                "example_id": "0263d9b5-a35f-4169-8e44-f724424a268b",
                                                "sense_id": "67091e49-046f-3921-86b4-0e027c9a68a0",
                                                "text": "There are also calcalkaline felsics that have highly enriched LREE^([light rare-earth element]) patterns with lower overall abundances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
