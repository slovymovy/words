                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8c1344c8-ec3d-4195-9fdf-bb994cb2dc92",
                        "entry_id": "c3daabb6-de8c-3109-b323-cf89404de0f4",
                        "tags": [
                            "plural"
