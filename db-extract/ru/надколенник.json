                "senses": [
                    {
                        "sense_id": "65a2bcc5-090d-3988-ac98-873b9441c8ae",
                        "entry_id": "c540a4f2-4180-3c2c-90c3-b6e2d4dab3b5",
                        "glosses": [
                            "самая крупная сесамовидная кость скелета человека"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bc76b93-b060-46e2-87c2-06d9c9dfac8d",
                                "sense_id": "65a2bcc5-090d-3988-ac98-873b9441c8ae",
                                "text": "Подвидом этого остеосинтеза является так называемый серкляж надколенника — схватывание сломанного надколенника."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b0830a9-6f55-40d1-a98b-5931b62407b6",
                        "source_entry_id": "c540a4f2-4180-3c2c-90c3-b6e2d4dab3b5",
                        "source_sense_id": "65a2bcc5-090d-3988-ac98-873b9441c8ae",
                        "target_lang_word": "patella",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8b8e0c-ea27-386d-b515-dc36783d0d30",
                                        "entry_id": "5d026a5d-6962-3bb1-915d-98f266f5ac5f",
                                        "glosses": [
                                            "Alternative form of putelee (“type of boat”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                        "entry_id": "b1b54e10-5bd9-3f90-ad5c-b10d16238c1f",
                                        "glosses": [
                                            "The sesamoid bone of the knee; the kneecap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "180a8dc4-85b5-486f-b14e-fffbf364b693",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "Subluxed patellas, more commonly referred to as slipped stifles, like all inherited factors will continue to cripple a breed as long as breeders continue to mate affected animals."
                                            },
                                            {
                                                "example_id": "1f8ca6c0-cf1b-4322-be27-cbd4ef1c3285",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "2005, Roger E. Stevenson, 20: Limbs, Roger E. Stevenson, Judith G. Hall, Human Malformations and Related Anomalies, page 920,\nSince patella diameter is a feature of continuous variation, the majority of small patellas represent simply the lower extreme of normal anatomic variation."
                                            },
                                            {
                                                "example_id": "079676e3-5860-44a3-9903-97cfc6b3b106",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "Both patellae are well preserved for Dolni Věstonice 3 and 13-15, and the left patella remains for Dolni Věstonice 16 (Figures 18.22 to 18.26)."
                                            },
                                            {
                                                "example_id": "42c421d8-ddf1-44a9-9c94-ca0391e61adc",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "The patellae may be up to 30° externally rotated at birth. In young children it is considered normal for the patellae to be externally rotated, but by 5 years of age the patellae should face forwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b254b7c7-a669-3062-b9eb-bb8d0fa22532",
                                        "entry_id": "b1b54e10-5bd9-3f90-ad5c-b10d16238c1f",
                                        "glosses": [
                                            "A little dish or vase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3851ebd4-4a9f-329d-b307-930589352cd1",
                                        "entry_id": "b1b54e10-5bd9-3f90-ad5c-b10d16238c1f",
                                        "glosses": [
                                            "An orbicular sessile apothecium, with a marginal rim distinct from the thallus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc07bbd6-fd7f-4e99-b175-f2f7cff190ae",
                        "source_entry_id": "c540a4f2-4180-3c2c-90c3-b6e2d4dab3b5",
                        "source_sense_id": "65a2bcc5-090d-3988-ac98-873b9441c8ae",
                        "target_lang_word": "kneecap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kneecap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00311926-7068-3378-9761-071575bb90a0",
                                        "entry_id": "4f38ea61-d496-3d1e-8b33-49486d408fbd",
                                        "glosses": [
                                            "The flat, roundish bone in the knee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a88b36b4-c54d-3ec0-99ec-64516246cf28",
                                        "entry_id": "4f38ea61-d496-3d1e-8b33-49486d408fbd",
                                        "glosses": [
                                            "A metal cover trim that fits over a panel rib after it has been cut and bent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f870ac0-997f-3d6e-9b37-aa36d5289c19",
                                        "entry_id": "4f38ea61-d496-3d1e-8b33-49486d408fbd",
                                        "glosses": [
                                            "A cap or strong covering for the knees, used chiefly for horses, to protect their knees in case of a fall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kneecap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20413ab7-8949-3737-9c77-03a65ad6e228",
                                        "entry_id": "513c976d-27a7-343e-9278-4a98be3ad44b",
                                        "glosses": [
                                            "To destroy the knees of (a person), usually by shooting at the knees, as a punishment carried out by criminals or terrorists."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2ffd57-9ec3-4d56-8d2b-c6ae6a1f86eb",
                                                "sense_id": "20413ab7-8949-3737-9c77-03a65ad6e228",
                                                "text": "The Sinn Féin press officer Richard McAuley freely admitted, “Back four or five years ago, people were getting kneecapped who should not have been kneecapped.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71414aeb-6a6e-3c3f-aa12-a43c20f450de",
                                        "entry_id": "513c976d-27a7-343e-9278-4a98be3ad44b",
                                        "glosses": [
                                            "To attack (someone) in a way that is excessively and needlessly damaging: To cut (someone) off at the knees."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b690ee-307c-482a-8386-469b557716b5",
                                                "sense_id": "71414aeb-6a6e-3c3f-aa12-a43c20f450de",
                                                "text": "This story of how American originality lost its way is arresting and well told. On an alternate timeline without Donald Trump in office dismantling the American scientific establishment and Elon Musk kneecapping the American state, it might have been the manifesto of a new politics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f678199-a417-437f-9ce0-305c3099aff6",
                        "source_entry_id": "c540a4f2-4180-3c2c-90c3-b6e2d4dab3b5",
                        "source_sense_id": "65a2bcc5-090d-3988-ac98-873b9441c8ae",
                        "target_lang_word": "patella",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patella",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6621be-338b-3056-abf3-1e3f9dd2222b",
                                        "entry_id": "efe9c22a-59df-3d81-8e60-2d1445d13b3b",
                                        "glosses": [
                                            "Nouveau nom scientifique de la rotule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51cb575-9cb0-477c-be39-549dea25b4f7",
                                                "sense_id": "fd6621be-338b-3056-abf3-1e3f9dd2222b",
                                                "text": "La face antérieure de la patella est convexe. Sa partie supérieure est rugueuse et donne attache au muscle droit fémoral. Sa partie inférieure est lisse et donne attache au tendon rotulien, qui la relie au tibia."
                                            },
                                            {
                                                "example_id": "1c7826e6-299d-4213-8c10-acf84ecfd8a8",
                                                "sense_id": "fd6621be-338b-3056-abf3-1e3f9dd2222b",
                                                "text": "La kinésithérapeute qui m'a soigné ironisait sur l'adoption du terme patella pour désigner l'os que jadis on appelait rotule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b75ee8f5-820c-412e-bb88-123d84fc4a14",
                        "source_entry_id": "c540a4f2-4180-3c2c-90c3-b6e2d4dab3b5",
                        "source_sense_id": "65a2bcc5-090d-3988-ac98-873b9441c8ae",
                        "target_lang_word": "rotule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rotule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5dafacbc-cd4b-3cb0-9fa9-45d3ee8ad4c9",
                                        "entry_id": "95ca273d-5c51-3a4e-a4d4-e7d390c81475",
                                        "glosses": [
                                            "Petit os plat, triangulaire, à angles arrondis, placé en avant du genou, à l’endroit où le fémur s’articule avec le tibia."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1796f29-216b-4db8-8e19-297d5feaaff3",
                                                "sense_id": "5dafacbc-cd4b-3cb0-9fa9-45d3ee8ad4c9",
                                                "text": "Une balle reçue au cours d’une rixe provoquée par lui pour ne pas laisser mettre en doute qu’il était un homme, lui avait brisé le genou ; il était affublé d’une rotule de métal, d’où son surnom."
                                            }
