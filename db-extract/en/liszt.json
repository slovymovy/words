                        "cross_references": [
                            {
                                "target_word": "リスト",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "4014f13f-956e-30f6-9c4c-af4fa47f36b3",
                                        "entry_id": "debeddc8-0a0f-3583-926d-15112ce4f318",
                                        "glosses": [
                                            "目録。名簿。一覧表。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed0b1ba6-e157-4524-afda-30853cd03408",
                                                "sense_id": "4014f13f-956e-30f6-9c4c-af4fa47f36b3",
                                                "text": "そう思って自分の読み度いと思う本のリストを繰って見ると、其の大半は欧州の作家である。"
                                            },
                                            {
                                                "example_id": "81962280-5c00-4fbe-a606-7257bd9b5deb",
                                                "sense_id": "4014f13f-956e-30f6-9c4c-af4fa47f36b3",
                                                "text": "戦争がすんだ年の翌年チャーチ博士から、この戦争を生きのびた会員たちを探す手紙がきた。そして再び国際協力の日を迎えて、新しく会員のリストを作りたいという希望が述べてあった。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2a73405-bb4b-3a3a-ac2e-728c814ba3b0",
                                        "entry_id": "debeddc8-0a0f-3583-926d-15112ce4f318",
                                        "glosses": [
                                            "データ構造のひとつで、データに順序をつけたもの。多く配列や連結リストのことを指す。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "リスト",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "57abce4d-5249-353b-bb42-3ce3d6e2733a",
                                        "entry_id": "8a78d29c-d294-313b-913a-dee4ce6c6458",
                                        "glosses": [
                                            "〔何かの〕リストを作る。〔何かを〕既存のリストに追加する。"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656c10d4-1093-4b47-9ec9-7518dacc7b72",
                                                "sense_id": "57abce4d-5249-353b-bb42-3ce3d6e2733a",
                                                "text": "このリストを見ますと、平成七年三月末の、九十二特殊法人のうちいわゆる利益剰余金、資本剰余金とかそういうものじゃなくて、利益分、利益の剰余金をリストしました。"
                                            },
                                            {
                                                "example_id": "91fdc950-89ba-4f99-a8b5-5e95c016aaf6",
                                                "sense_id": "57abce4d-5249-353b-bb42-3ce3d6e2733a",
                                                "text": "リスティング協会というのは何なんだいといったら、リストするというんです。何をリストするんだいといったら、不動産の建物の売却の希望リストを並べて、誰でもが見られるようにするんだと。"
                                            }
                                        ]
                                    }
                                ]
                            },
