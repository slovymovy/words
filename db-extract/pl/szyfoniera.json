                "translations": [
                    {
                        "translation_id": "e8a7607b-760f-4cc7-b63e-2c916e97e676",
                        "source_entry_id": "873c38ec-7b79-3568-b052-74a3fe2e2e17",
                        "source_sense_id": "f9e8e24c-2f90-3ad3-a71f-211e5944736b",
                        "target_lang_word": "chiffonier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiffonier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0fd5208-da0f-30a5-8400-821d61bf52bf",
                                        "entry_id": "5da7f222-d45d-30a2-b0cb-c0117adfea11",
                                        "glosses": [
                                            "A tall, elegant chest of drawers, often with a mirror attached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd523c32-f6b7-4c47-9a21-8db913c841a9",
                                                "sense_id": "b0fd5208-da0f-30a5-8400-821d61bf52bf",
                                                "text": "\"There is nothing of the kind even within view,\" cried Helen, warmly, \"nor any one object that could offend the most fastidious eye, as Mrs. Palmer observed; a duchess might delight in it; every thing is so clean without, and so good within: such beautiful carpets and rugs to match! such handsome chiffoniers, and elegant books!..."
                                            },
                                            {
                                                "example_id": "e0ef41f8-468b-4bbb-8529-5d09c5960533",
                                                "sense_id": "b0fd5208-da0f-30a5-8400-821d61bf52bf",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            },
                                            {
                                                "example_id": "be1043d7-be2f-42b9-90e2-fec51e35621f",
                                                "sense_id": "b0fd5208-da0f-30a5-8400-821d61bf52bf",
                                                "text": "From the half-open drawers of this chiffonnier hung laces, ribands, stockings, ladies' underclothing and an abdominal brace, which gave the impression that the feminine finery had suffered venery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53e0e6f-0cce-3182-9141-56bc972b6415",
                                        "entry_id": "5da7f222-d45d-30a2-b0cb-c0117adfea11",
                                        "glosses": [
                                            "One who gathers rags and odds and ends; a ragpicker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6387f428-5639-3d3f-840a-4eee1d4d74fc",
                                        "entry_id": "5da7f222-d45d-30a2-b0cb-c0117adfea11",
                                        "glosses": [
                                            "A receptacle for rags or shreds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f9a35b9-26cf-4608-9007-6c1ed6de0458",
                        "source_entry_id": "873c38ec-7b79-3568-b052-74a3fe2e2e17",
                        "source_sense_id": "f9e8e24c-2f90-3ad3-a71f-211e5944736b",
                        "target_lang_word": "chiffonnier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiffonnier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5feecb9-53e1-3364-aa96-efdb60928ffa",
                                        "entry_id": "23adc8b8-5310-38ba-bab3-4b0f829d4292",
                                        "glosses": [
                                            "Alternative form of chiffonier."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dcc8c27-dd79-4bb8-9513-b299082da4ed",
                                                "sense_id": "f5feecb9-53e1-3364-aa96-efdb60928ffa",
                                                "text": "Emily, who came up with all the curiosity of the country, would have liked to have seen much more than she did; but young ladies are like the pieces of looking-glass let into chiffonniers and doorways—only meant to reflect the actions of others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f09d9916-d655-4d8b-a732-ff615185258d",
                        "source_entry_id": "873c38ec-7b79-3568-b052-74a3fe2e2e17",
                        "source_sense_id": "f9e8e24c-2f90-3ad3-a71f-211e5944736b",
                        "target_lang_word": "chiffonnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiffonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2af6d7fc-af47-30d0-b9b8-c3e8f6c4830a",
                                        "entry_id": "afeb1b56-1ef9-365b-a2f9-3501c644eaee",
                                        "glosses": [
                                            "Mal tenu, négligé, sale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37fc85e8-0520-4639-a868-85586eb9982c",
                                                "sense_id": "2af6d7fc-af47-30d0-b9b8-c3e8f6c4830a",
                                                "text": "Les boutiques à badigeon sombre portent une gourme négligée d’éclaboussures ; les maisons, au-dessus, tendent leurs faces chiffonnières, cendrées, avec des traînées de larmes couleur de café ; les fenêtres étroites, malsaines, n’ont que de la friperie à laisser voir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ef9ce9-c3fd-3cf9-aa70-5990deecb7e5",
                                        "entry_id": "afeb1b56-1ef9-365b-a2f9-3501c644eaee",
                                        "glosses": [
                                            "Qui concerne la mode, les toilettes, les vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb734427-f564-4adc-82bc-151db5f4638a",
                                                "sense_id": "94ef9ce9-c3fd-3cf9-aa70-5990deecb7e5",
                                                "text": "La glose d’une sophistication intarissable dont il enguirlande les toilettes d’Albertine le dédouane de cette passion chiffonnière à laquelle il craint de se livrer, et qui s’enivre de ses volutes jusqu’aux recherches du maquillage et des accessoires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chiffonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a811979c-ef7b-3b40-9050-8d9a967485e1",
                                        "entry_id": "2de84635-65c8-3167-9b98-4a009fa0679c",
                                        "glosses": [
                                            "Celui qui ramasse des chiffons afin de les revendre."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69ba12b1-d230-4fe1-9e02-05eb68973aa4",
                                                "sense_id": "a811979c-ef7b-3b40-9050-8d9a967485e1",
                                                "text": "Il ne fait ni une, ni deux, sitôt sa sœur et son jules partis bosser, il fait venir un chiffonnier juif et il vend les fringues, les draps qui lui venaient de sa mère, les rideaux qu’il décroche, les nappes brodées, tout !..."
                                            },
                                            {
                                                "example_id": "800aa8da-9153-426d-89f7-0c9bf2bce974",
                                                "sense_id": "a811979c-ef7b-3b40-9050-8d9a967485e1",
                                                "text": "Les noms mêmes des petits métiers qui sont à la base de l’édifice du recyclage révèlent le côté dérisoire de ces occupations : plus spécialisés encore que le chiffonnier, il y a le ramasseur de crottes de chien, le ramasseur de bouts de cigare, etc."
                                            },
                                            {
                                                "example_id": "1c9041fe-1776-4482-a6f5-ed273445e99c",
                                                "sense_id": "a811979c-ef7b-3b40-9050-8d9a967485e1",
                                                "text": "Se disputer comme des chiffonniers.",
                                                "translation": "Se disputer violemment pour peu de chose."
                                            },
                                            {
                                                "example_id": "3a1772de-c7fc-4939-94c3-2f81cab370f6",
                                                "sense_id": "a811979c-ef7b-3b40-9050-8d9a967485e1",
                                                "text": "Vêtu comme un chiffonnier.",
                                                "translation": "Mal vêtu, sale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00797e8-2301-3426-a6f7-437e02a95882",
                                        "entry_id": "2de84635-65c8-3167-9b98-4a009fa0679c",
                                        "glosses": [
                                            "Celui qui ramasse les matériaux, plastiques, verre, cartons, etc et les objets usagés afin de les revendre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "219cb05c-b1e2-31e3-bcef-5bfa6194df9a",
                                        "entry_id": "2de84635-65c8-3167-9b98-4a009fa0679c",
                                        "glosses": [
                                            "Petit meuble à plusieurs tiroirs, qui servait aux femmes de rangement pour leurs chiffons, travaux d’aiguille, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6ebb169-969f-4a56-9f7a-42a251c9039f",
                                                "sense_id": "219cb05c-b1e2-31e3-bcef-5bfa6194df9a",
                                                "text": "Le chiffonnier de bois de rose était surmonté d’une coupe en argent, prix décerné par quelque société de sport."
                                            },
                                            {
                                                "example_id": "2f7ca1a7-2a8b-4c87-9c71-698688791db8",
                                                "sense_id": "219cb05c-b1e2-31e3-bcef-5bfa6194df9a",
                                                "text": "La différence principale à établir entre eux, c’est que le chiffonnier, haut généralement de 1ᵐ,40 à 1ᵐ,60, offre, comme taille et comme aspect, certaines analogies avec un secrétaire. La chiffonnière, beaucoup plus mignonne, ressemble plutôt à une petite commode, parfois même à un petit bureau."
                                            },
                                            {
                                                "example_id": "f2172227-e07b-4123-a730-087ada5472bb",
                                                "sense_id": "219cb05c-b1e2-31e3-bcef-5bfa6194df9a",
                                                "text": "– Je connaissais la place où on met l’argent, sous le linge du chiffonnier, dans un vieux portefeuille de mon père…"
                                            },
                                            {
                                                "example_id": "1e2b80fa-3427-4576-a675-3b9384f2d2de",
                                                "sense_id": "219cb05c-b1e2-31e3-bcef-5bfa6194df9a",
                                                "text": "Ce secrétaire japonisant laqué de bleu ayant appartenu à Mᵐᵉ de Pompadour, ou ce chiffonnier orné d’un bouquet de roses et de lilas peint à l’huile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
