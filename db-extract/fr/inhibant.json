                "senses": [
                    {
                        "sense_id": "a7094639-4165-31c5-b2a8-15092fbd19f4",
                        "entry_id": "3bf86b79-14c1-3cd9-b09e-97027c3a108b",
                        "glosses": [
                            "Qui inhibe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbbbe120-a19c-442b-805b-b581be087f76",
                                "sense_id": "a7094639-4165-31c5-b2a8-15092fbd19f4",
                                "text": "Il n'y a pas là d’action inhibante, car l’on sait que les Pyrophores sont attirés par les lumières vives qui les éblouissent, ainsi que les autres insectes nocturnes."
                            },
                            {
                                "example_id": "57292c1d-c53b-4a36-8780-7c5494fbc436",
                                "sense_id": "a7094639-4165-31c5-b2a8-15092fbd19f4",
                                "text": "À court terme, dans l’urgence, il faut parvenir à maîtriser les réactions émotives et physiologiques embarrassantes et inhibantes."
                            },
                            {
                                "example_id": "cd6f6b17-aa00-439e-a7c4-6801e61073b7",
                                "sense_id": "a7094639-4165-31c5-b2a8-15092fbd19f4",
                                "text": "Tu as libéré en moi les effets inhibants de mon austère condition conjugale et permis à ma pulsion libidinale erratique de trouver bi-hebdomadairement un havre suffisamment chauffé."
                            }
                        ]
                    }
