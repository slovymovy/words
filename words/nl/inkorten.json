                            },
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to reduce the length of something"
                            },
                            {
                                "target_lang_word": "hem",
                                "target_lang_sense_clarification": "specifically for shortening clothing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1777649c-210e-3824-8db3-c14d1a679c72",
                    "sense_definition": "Het beperken of verminderen van middelen, rechten of budgetten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beperken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid besloot de subsidies voor cultuur drastisch te <w>inkorten</w>.",
                            "target_lang_translations": {
                                "en": "The government decided to drastically <w>cut</w> the subsidies for culture."
                            }
                        },
                        {
                            "text": "Door de crisis moesten we het budget voor marketing flink <w>inkorten</w>.",
                            "target_lang_translations": {
                                "en": "Due to the crisis, we had to significantly <w>reduce</w> the marketing budget."
                            }
                        }
                    ],
                    "synonyms": [
