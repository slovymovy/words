                        "sense_id": "04de21a8-2214-3a29-b3f0-a72682393703",
                        "entry_id": "7c91f156-ef62-3104-b282-bc413ee1821b",
                        "glosses": [
                            "Qui astreint, qui contraint grandement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bbf9857-ff04-43f0-917e-23d8f9aa399a",
                                "sense_id": "04de21a8-2214-3a29-b3f0-a72682393703",
