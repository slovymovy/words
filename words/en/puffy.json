    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ea4d43a-196b-3ed8-9bda-d9465aca7c52",
                    "sense_definition": "Swollen or inflated in shape, as if filled with air or soft material.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "swollen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After crying for hours, she woke up with <w>puffy</w> eyes and a headache.",
                            "target_lang_translations": {
                                "ru": "После многочасового плача она проснулась с <w>опухшими</w> глазами и головной болью.",
                                "cs": "Po hodinách pláče se probudila s <w>oteklýma</w> očima a bolestí hlavy.",
                                "pl": "Po wielogodzinnym płaczu obudziła się z <w>opuchniętymi</w> oczami i bólem głowy."
                            }
                        },
                        {
                            "text": "The sky was filled with <w>puffy</w> white clouds on a beautiful summer afternoon.",
                            "target_lang_translations": {
                                "ru": "Прекрасным летним днем небо было заполнено <w>пышными</w> белыми облаками.",
                                "cs": "Obloha byla za krásného letního odpoledne plná <w>nadýchaných</w> bílých mraků.",
                                "pl": "Pięknym letnim popołudniem niebo było pełne <w>puszystych</w> białych chmur."
                            }
                        }
                    ],
                    "synonyms": [
                        "swollen",
                        "bloated",
                        "inflated"
                    ],
                    "antonyms": [
                        "flat",
                        "sunken"
                    ],
                    "common_phrases": [
                        "puffy eyes",
                        "puffy clouds",
                        "puffy jacket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опухший или раздутый, словно наполненный воздухом или мягким материалом.",
                        "cs": "Oteklý nebo nadmutý, jako by byl naplněn vzduchem nebo měkkým materiálem.",
                        "pl": "Spuchnięty lub nadmuchany, jakby wypełniony powietrzem lub miękkim materiałem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опухший",
                                "target_lang_sense_clarification": "о глазах или частях тела"
                            },
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "об облаках или одежде"
                            },
                            {
                                "target_lang_word": "дутый",
                                "target_lang_sense_clarification": "о куртках или материалах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "oteklý",
                                "target_lang_sense_clarification": "o očích nebo částech těla"
                            },
                            {
                                "target_lang_word": "nadýchaný",
                                "target_lang_sense_clarification": "o oblacích nebo materiálech"
                            },
                            {
                                "target_lang_word": "prošívaný",
                                "target_lang_sense_clarification": "o bundách"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "opuchnięty",
                                "target_lang_sense_clarification": "o oczach lub częściach ciała"
                            },
                            {
                                "target_lang_word": "puszysty",
                                "target_lang_sense_clarification": "o chmurach lub materiałach"
                            },
                            {
                                "target_lang_word": "pikowany",
                                "target_lang_sense_clarification": "o kurtkach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf40b6da-a2a3-39b0-99df-cb61f48438bf",
                    "sense_definition": "Having cheeks that are rounded or bulging outward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "swollen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler had <w>puffy</w> cheeks that everyone wanted to pinch.",
                            "target_lang_translations": {
                                "ru": "У малыша были такие <w>пухлые</w> щечки, что каждому хотелось их ущипнуть.",
                                "cs": "Batole mělo <w>baculaté</w> tvářičky, které chtěl každý štípnout.",
                                "pl": "Maluch miał <w>pulchne</w> policzki, które każdy chciał uszczypnąć."
                            }
                        },
                        {
                            "text": "He looked quite different in the old photo with his <w>puffy</w> face and short hair.",
                            "target_lang_translations": {
                                "ru": "На старом фото он выглядел совсем иначе со своим <w>одутловатым</w> лицом и короткой стрижкой.",
                                "cs": "Na staré fotce vypadal úplně jinak se svým <w>opuchlým</w> obličejem a krátkými vlasy.",
                                "pl": "Na starym zdjęciu wyglądał zupełnie inaczej ze swoją <w>opuchniętą</w> twarzą i krótkimi włosami."
                            }
                        }
                    ],
                    "synonyms": [
                        "chubby",
                        "plump"
                    ],
                    "antonyms": [
                        "gaunt",
                        "hollow"
                    ],
                    "common_phrases": [
                        "puffy cheeks",
                        "puffy face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий округлые или выпирающие щеки.",
                        "cs": "Mající kulaté nebo vystouplé tváře.",
                        "pl": "Mający zaokrąglone lub wypukłe policzki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пухлый",
                                "target_lang_sense_clarification": "о щеках или лице"
                            },
                            {
                                "target_lang_word": "одутловатый",
                                "target_lang_sense_clarification": "о болезненно припухшем лице"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "baculatý",
                                "target_lang_sense_clarification": "o tvářích nebo obličeji"
                            },
                            {
                                "target_lang_word": "opuchlý",
                                "target_lang_sense_clarification": "o nezdravě vypadajícím obličeji"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pulchny",
                                "target_lang_sense_clarification": "o policzkach lub twarzy"
                            },
                            {
                                "target_lang_word": "opuchnięty",
                                "target_lang_sense_clarification": "o niezdrowo wyglądającej twarzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bd19acd-c643-3316-91ee-1e60ca374d50",
                    "sense_definition": "Coming out or exhaling in short, sudden bursts of air or smoke.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bursts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old steam engine released <w>puffy</w> clouds of smoke as it left the station.",
                            "target_lang_translations": {
                                "ru": "Старый паровоз выпускал <w>клубящиеся</w> облака дыма, покидая станцию.",
                                "cs": "Stará parní lokomotiva vypouštěla <w>obláčkové</w> mraky kouře, když opouštěla stanici.",
                                "pl": "Stara lokomotywa parowa wypuszczała <w>kłębiące się</w> obłoki dymu, opuszczając stację."
                            }
                        },
                        {
                            "text": "In the cold morning air, his <w>puffy</w> breath was visible with every step.",
                            "target_lang_translations": {
                                "ru": "В холодном утреннем воздухе его <w>прерывистое</w> дыхание было заметно при каждом шаге.",
                                "cs": "V chladném ranním vzduchu byl jeho <w>přerušovaný</w> dech viditelný při každém kroku.",
                                "pl": "W chłodnym porannym powietrzu jego <w>przerywany</w> oddech był widoczny przy każdym kroku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "puffy breath",
                        "puffy smoke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выходящий короткими, внезапными порывами воздуха или дыма.",
                        "cs": "Vycházející v krátkých, náhlých poryvech vzduchu nebo kouře.",
                        "pl": "Wydobywający się w krótkich, nagłych podmuchach powietrza lub dymu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клубящийся",
                                "target_lang_sense_clarification": "о дыме или паре"
                            },
                            {
                                "target_lang_word": "прерывистый",
                                "target_lang_sense_clarification": "о дыхании или выбросах"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "obláčkový",
                                "target_lang_sense_clarification": "o kouři nebo páře"
                            },
                            {
                                "target_lang_word": "přerušovaný",
                                "target_lang_sense_clarification": "o dechu nebo výfukových plynech"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kłębiący się",
                                "target_lang_sense_clarification": "o dymie lub parze"
                            },
                            {
                                "target_lang_word": "przerywany",
                                "target_lang_sense_clarification": "o oddechu lub wyrzutach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a0cd40e-9fb5-341d-bdcc-4b67728cdda2",
                    "sense_definition": "Describing speech or writing that is exaggeratedly eloquent, arrogant, or self-important.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic dismissed the novel as <w>puffy</w> prose that lacked any real substance.",
                            "target_lang_translations": {
                                "ru": "Критик отверг роман как <w>напыщенную</w> прозу, лишенную какого-либо реального содержания.",
                                "cs": "Kritik odsoudil román jako <w>nabubřelou</w> prózu, které chyběl jakýkoli skutečný obsah.",
                                "pl": "Krytyk odrzucił powieść jako <w>napuszoną</w> prozę, której brakowało jakiejkolwiek głębi."
                            }
                        },
                        {
                            "text": "He delivered a <w>puffy</w> speech filled with academic jargon and self-praise.",
                            "target_lang_translations": {
                                "ru": "Он произнес <w>высокопарную</w> речь, наполненную академическим жаргоном и самовосхвалением.",
                                "cs": "Přednesl <w>vznešený</w> projev plný akademického žargonu a sebechvály.",
                                "pl": "Wygłosił <w>napuszoną</w> mowę pełną akademickiego żargonu i samouwielbienia."
                            }
                        }
                    ],
                    "synonyms": [
                        "pompous",
                        "bombastic",
                        "turgid"
                    ],
                    "antonyms": [
                        "concise",
                        "modest"
                    ],
                    "common_phrases": [
                        "puffy prose",
                        "puffy style"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает речь или письмо, которые являются преувеличенно красноречивыми, высокомерными или самодовольными.",
                        "cs": "Popisuje řeč nebo text, které jsou přehnaně květnaté, arogantní nebo samolibé.",
                        "pl": "Opisuje mowę lub tekst, które są przesadnie kwieciste, aroganckie lub pełne samouwielbienia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напыщенный",
                                "target_lang_sense_clarification": "преувеличенно важный или высокопарный"
                            },
                            {
                                "target_lang_word": "высокопарный",
                                "target_lang_sense_clarification": "о стиле изложения"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "nabubřelý",
                                "target_lang_sense_clarification": "přehnaně důležitý nebo prázdný"
                            },
                            {
                                "target_lang_word": "vznešený",
                                "target_lang_sense_clarification": "o stylu vyjadřování"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "napuszony",
                                "target_lang_sense_clarification": "przesadnie ważny lub pełen patosu"
                            },
                            {
                                "target_lang_word": "bombastyczny",
                                "target_lang_sense_clarification": "o stylu wypowiedzi"
                            }
                        ]
                    }
                }
            ]
        }
