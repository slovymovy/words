                            {
                                "example_id": "7d85c3d8-62cd-44c4-ba7d-9c343caecf21",
                                "sense_id": "98703357-03cd-3f7f-b988-da7338c66c3e",
                                "text": "Zij maakte speciaal voor ons een paar xylografieën."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bc4fbee-081e-49f7-8fa9-0057ca61dd9f",
                        "source_entry_id": "c45ddef0-7500-3998-95e1-908102dd966d",
                        "source_sense_id": "c176afbd-1944-31cc-94c0-d9c4d0574693",
                        "source_sense_description": "houtsnijkunst",
                        "target_lang_word": "Xylographie",
