                "senses": [
                    {
                        "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                        "entry_id": "c66b2395-4638-3d29-abc0-447e7c75e500",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09bf9680-9843-4d3c-9a52-1bdfe07a7e78",
                                "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                                "text": "Frau Feederle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bfb7f345-7732-4254-9a59-437db7afa130",
                                "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                                "text": "Herr Feederle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9b74af66-0d43-4b2c-94c5-a4e1842a404c",
                                "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                                "text": "Die Feederles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a93d818a-b7e2-406a-80b4-e8c87b379c7b",
                                "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                                "text": "Der Feederle trägt nie die Schals, die die Feederle ihm strickt."
                            },
                            {
                                "example_id": "2f062990-2112-43fb-9885-11e113e1d56a",
                                "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feederle kommt, geht der Herr Feederle.“"
                            },
                            {
                                "example_id": "375d18ff-8647-4614-80f1-ba19430f8d3f",
                                "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                                "text": "Feederle kommt und geht."
                            },
                            {
                                "example_id": "63a7597c-6e65-4de3-8f79-0331efa39436",
                                "sense_id": "d425aa58-0475-3bcc-9485-7c12fb750284",
                                "text": "Feederles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
