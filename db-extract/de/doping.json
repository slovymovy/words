                ],
                "senses": [
                    {
                        "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                        "entry_id": "391c1f94-d735-3d6d-9434-1ffb0168d10c",
                        "glosses": [
                            "Anwendung unerlaubter Substanzen zur Leistungssteigerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5729b7-90b1-449c-99d8-b81f7dea8a6c",
                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                "text": "In der DDR war Doping anscheinend an der Tagesordnung."
                            },
                            {
                                "example_id": "fccec226-6ace-44f2-b72a-6492a17b1a4c",
                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                "text": "„Es wäre natürlich der Idealfall, dass Doping gar nicht stattfindet, so wie es im Idealfall nur gute Menschen geben sollte.“"
                            },
                            {
                                "example_id": "9462ff77-119e-4388-a717-95f70d6f8420",
                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                "text": "„Die so lange verbreitete Mär, dass Doping im Fußball ›nichts bringen‹ würde, scheint damit wieder einmal widerlegt worden zu sein.“"
                            },
                            {
                                "example_id": "2aca824d-e4fa-46a4-a7ee-5e1e95d40b40",
                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                "text": "„Das war noch vor der Einführung von Speicheltests und anderen Methoden, mit denen künstlich aufgeputschte Pferde entlarvt werden sollten, zu einer Zeit, als Doping noch eine weitverbreitete Praxis war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
