                    {
                        "translation_id": "9ef9e2d6-c0fb-4181-9435-d0f896b7a7d1",
                        "source_entry_id": "95feb6e6-250d-3efc-80f8-ae32d9beaef8",
                        "source_sense_id": "6eed05cc-773f-3417-bb08-2265a735c7c0",
                        "source_sense_description": "der Wettkämpfer, der Wettbewerber, der Kandidat",
                        "target_lang_word": "Kandidat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kandidat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                        "entry_id": "7649a930-5b3b-34f3-80a5-ce1d3c1c725d",
                                        "glosses": [
                                            "Person (oder auch Sache oder Umstand/Ort), die für etwas zur Auswahl steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0edc9a5a-1d73-40df-8ef0-bab6ce10e65f",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "Herr Müller war zuvor noch nie Kandidat in einer Spielshow."
                                            },
                                            {
                                                "example_id": "62dbc712-29ac-4245-ab70-0d785d04ba72",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "Die beiden Kandidaten für die Aushilfsstelle haben beide ausgezeichnete Referenzen vorgelegt."
                                            },
                                            {
                                                "example_id": "c03c404b-a749-42a6-98ce-f9d83f99d5e0",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "„Bevor er vom Examinator aufgerufen wurde, war er, mit dem Zylinder eines anderen Kandidaten auf dem Kopfe, durch die Korridore spaziert und hatte den Pedell erschreckt.“"
                                            },
                                            {
                                                "example_id": "84149497-d47d-4933-89eb-6ee2b4c62371",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "„Der Nubier war ein idealer Kandidat für die Liga gegen Imperialismus.“"
                                            },
                                            {
                                                "example_id": "837e8b69-ff6d-44da-94d0-a73ecd0cf000",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "„Aber ich war von Anfang an ein unsicherer Kandidat.“"
                                            },
                                            {
                                                "example_id": "bc4b95b1-7165-4e6f-a12d-143a9813efa3",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "Wir haben mehrere Kandidaten, die grundsätzlich als Impfstoff gegen diesen Virus geeignet wären. Die speziefische Eignung werden wir nun in verschiedenen Testreihen überprüfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
