                "senses": [
                    {
                        "sense_id": "063e563e-c15c-3c7f-9f4c-9b14cde4be73",
                        "entry_id": "2972e350-d24c-341f-bf1b-95e078471161",
                        "glosses": [
                            "mathematische Berechnung zur Ausbreitung von Geruch in der Luft, um eine Geruchsquelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f619e3-533f-4480-babd-782e5b60fbd5",
                                "sense_id": "063e563e-c15c-3c7f-9f4c-9b14cde4be73",
                                "text": "„Links ist das Ergebnis der Geruchsausbreitungsrechnung nach früherem Muster zu sehen (entspricht der Simulation aller Quellen gleichzeitig, IG), rechts ist die belästigungsrelevante Kenngröße IG_b dargestellt, nach der die gleiche Situation nach den Handlungsempfehlungen des UM BW beurteilt werden soll (Verwendung von f _(Schwein)=0,6).“"
                            },
                            {
                                "example_id": "bbb6dc30-e84d-4fb9-8ede-7e35b938c3ec",
                                "sense_id": "063e563e-c15c-3c7f-9f4c-9b14cde4be73",
                                "text": "„Bislang wurden zur Geruchsausbreitungsberechnung bei Tierhaltungsanlagen über einen Mastdurchgang gemittelte Geruchsemissionsmassenströme, bezogen auf 500 kg Lebendtiermasse (= 1 Großvieheinheit, GV) verwendet.“"
                            },
                            {
                                "example_id": "f997ab2f-9304-44e2-b72b-c8daaea16d71",
                                "sense_id": "063e563e-c15c-3c7f-9f4c-9b14cde4be73",
                                "text": "„Die Geruchsausbreitungsrechnung hat auf der Basis der Richtlinie VDI 3788 (Blatt 1), des Anhangs 3 der TA Luft und der speziellen Anpassungen für Geruch entsprechend dem Referenzmodell AUSTAL 2000 zu erfolgen.“"
                            },
                            {
                                "example_id": "e4f25491-95d8-49d8-9734-c025d6de51f6",
                                "sense_id": "063e563e-c15c-3c7f-9f4c-9b14cde4be73",
                                "text": "„Berücksichtigung von Emissionszyklen in der Geruchsausbreitungsrechnung am Beispiel eines Masthähnchenstalls in gedruckter Form im Abo bestellen.“"
                            },
                            {
                                "example_id": "1cf719f4-56a8-43b9-8af1-9e804f495d63",
                                "sense_id": "063e563e-c15c-3c7f-9f4c-9b14cde4be73",
                                "text": "„Die Ermittlung der vorhandenen Belastung hat im Allgemeinen durch olfaktorische Feststellungen im Rahmen von Rasterbegehungen entsprechend Richtlinie VDI 3940 Blatt 1 (2006) oder durch Geruchsausbreitungsrechnung zu erfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
