{
    "word_family": [
        "observer",
        "observation",
        "observable",
        "observatoire",
        "observance",
        "inobservable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4199bd82-8cb2-3c92-a135-620f54e7df96",
                    "sense_definition": "Personne qui regarde attentivement une scène ou une situation sans y prendre une part active.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temoin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant toute la réunion, il est resté un simple <w>observateur</w> sans jamais donner son avis."
                        },
                        {
                            "text": "Cette journaliste se comporte en <w>observatrice</w> impartiale afin de décrire fidèlement les événements."
                        }
                    ],
                    "synonyms": [
                        "témoin",
                        "spectateur"
                    ],
                    "antonyms": [
                        "acteur",
                        "participant"
                    ],
                    "common_phrases": [
                        "simple observateur",
                        "poste d'observateur"
                    ]
                },
                {
                    "sense_id": "f800ae69-9e57-3d69-8197-af92bc9a921c",
                    "sense_definition": "Personne envoyée officiellement pour surveiller le bon déroulement d'un événement sans intervenir directement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mandat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des <w>observateurs</w> internationaux ont été déployés pour garantir la transparence des élections."
                        },
                        {
                            "text": "Elle a assisté aux négociations de paix avec le statut d'<w>observatrice</w> indépendante."
                        }
                    ],
                    "synonyms": [
                        "délégué",
                        "contrôleur"
                    ],
                    "common_phrases": [
                        "observateur international",
                        "observateurs électoraux",
                        "statut d'observateur"
                    ]
                },
                {
                    "sense_id": "e86080bb-e948-3725-b2d9-5ae8b881a9e9",
                    "sense_definition": "Personne qui analyse et commente régulièrement les faits politiques, économiques ou sociaux.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux <w>observateurs</w> de la vie politique prévoient une recomposition majeure des partis."
                        },
                        {
                            "text": "Selon les <w>observateurs</w> les plus attentifs, cette crise économique était parfaitement prévisible."
                        }
                    ],
                    "synonyms": [
                        "analyste",
                        "commentateur"
                    ],
                    "common_phrases": [
                        "observateurs politiques",
                        "observateurs attentifs"
                    ]
                },
                {
                    "sense_id": "e6c25c92-5f6d-326e-827a-eb2f46f14ff8",
                    "sense_definition": "Personne qui étudie ou enregistre méthodiquement des données dans le cadre d'une recherche scientifique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>observateur</w> note soigneusement chaque variation de température constatée pendant l'expérience."
                        },
                        {
                            "text": "Cette équipe d'<w>observateurs</w> étudie le comportement des oiseaux migrateurs depuis plusieurs semaines."
                        }
                    ],
                    "synonyms": [
                        "chercheur",
                        "expérimentateur"
                    ],
                    "common_phrases": [
                        "observateur attentif"
                    ]
                },
                {
                    "sense_id": "0dbac2bb-d329-3232-8dc2-0e4d8e123415",
                    "sense_definition": "Personne qui respecte et applique scrupuleusement une règle, un précepte ou une loi.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce religieux est resté toute sa vie un fidèle <w>observateur</w> des commandements divins."
                        },
                        {
                            "text": "Le magistrat s'est toujours montré un scrupuleux <w>observateur</w> des principes républicains."
                        }
                    ],
                    "synonyms": [
                        "pratiquant",
                        "respectueux"
                    ],
                    "antonyms": [
                        "infracteur",
                        "transgresseur"
                    ],
                    "common_phrases": [
                        "fidèle observateur",
                        "scrupuleux observateur"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Soutenu"
                        }
                    ]
                },
                {
                    "sense_id": "ee73ab1c-fcaa-3d8c-8ab0-9fe1d398fad9",
                    "sense_definition": "Militaire spécialement chargé de surveiller les mouvements de l'ennemi ou de repérer des cibles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pilote et son <w>observateur</w> survolaient les lignes ennemies pour localiser l'artillerie."
                        },
                        {
                            "text": "Installé dans un poste avancé, l'<w>observateur</w> transmettait les coordonnées au quartier général."
                        }
                    ],
                    "synonyms": [
                        "guetteur",
                        "éclaireur"
                    ],
                    "common_phrases": [
                        "poste d'observateur"
                    ]
                },
                {
                    "sense_id": "b7a6aa72-7214-3984-aaf0-5ea25a622e6f",
                    "sense_definition": "En sciences physiques, point de vue ou repère matériel par rapport auquel on décrit un phénomène.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour un <w>observateur</w> terrestre, le soleil semble tourner autour de notre planète."
                        },
                        {
                            "text": "La vitesse de l'objet varie selon le référentiel choisi par l'<w>observateur</w>."
                        }
                    ],
                    "synonyms": [
                        "référentiel"
                    ],
                    "common_phrases": [
                        "observateur terrestre"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5b8d0f2-5e5a-313c-98f0-0e165374bdfc",
                    "sense_definition": "Qui a le don de regarder avec minutie, de remarquer facilement les détails et de bien analyser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son esprit <w>observateur</w>, elle a tout de suite remarqué le changement de décor."
                        },
                        {
                            "text": "Cet artiste pose un regard très <w>observateur</w> sur les travers de la société moderne."
                        }
                    ],
                    "synonyms": [
                        "perspicace",
                        "attentif",
                        "vigilant"
                    ],
                    "antonyms": [
                        "distrait",
                        "inattentif"
                    ],
                    "common_phrases": [
                        "esprit observateur",
                        "œil observateur",
                        "regard observateur"
                    ]
                }
            ]
        }
    ]
}