    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26295e0b-b825-3f4e-a2e1-e1f9abddd9f7",
                    "sense_definition": "To recover health or strength after an illness or period of exhaustion",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She needed time to <w>recuperate</w> after her long and difficult surgery."
                        },
                        {
                            "text": "The athlete went to the mountains to <w>recuperate</w> from the intense season."
                        }
                    ],
                    "synonyms": [
                        "recover",
                        "convalesce",
                        "recuperate"
                    ],
                    "common_phrases": [
                        "recuperate from illness",
                        "time to recuperate"
                    ]
                },
                {
                    "sense_id": "27a9b355-46d2-315e-a95b-88147dd982af",
                    "sense_definition": "To regain or get back something that was lost",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hopes to <w>recuperate</w> its losses by increasing sales next quarter."
                        },
                        {
                            "text": "He worked hard to <w>recuperate</w> his reputation after the public scandal."
                        }
                    ],
                    "synonyms": [
                        "regain",
                        "reclaim",
                        "retrieve"
                    ],
                    "antonyms": [
                        "lose",
                        "forfeit"
                    ],
                    "common_phrases": [
                        "recuperate losses"
                    ]
                },
                {
                    "sense_id": "cbcc42a8-e144-314f-bb55-bb2bdff7271b",
                    "sense_definition": "To restore someone or something to a former state of strength or importance",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian aimed to <w>recuperate</w> the forgotten works of the early feminist writers."
                        },
                        {
                            "text": "New policies were introduced to <w>recuperate</w> the failing economy of the region."
                        }
                    ],
                    "synonyms": [
                        "restore",
                        "revive",
                        "rehabilitate"
                    ]
                },
                {
                    "sense_id": "d70b2f71-41ad-3c98-8731-a037c5cc30da",
                    "sense_definition": "To incorporate a radical or critical idea into an established system to neutralize its impact",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mainstream media often <w>recuperates</w> protest slogans to sell commercial products."
                        },
                        {
                            "text": "Critics argue that the movement was <w>recuperated</w> by the very institutions it opposed."
                        }
                    ],
                    "synonyms": [
                        "co-opt",
                        "assimilate"
                    ]
                }
            ]
        }
    ]
