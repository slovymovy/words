                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>larve</w> de ce papillon se nourrit principalement de feuilles d'arbres."
                        },
                        {
                            "text": "Les chercheurs ont observé l'évolution d'une petite <w>larve</w> dans l'eau douce."
                        }
                    ],
                    "common_phrases": [
