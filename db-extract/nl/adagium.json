                "senses": [
                    {
                        "sense_id": "d0cf1556-bd26-3561-ad88-e419aee4b44a",
                        "entry_id": "2a6d9175-6802-3551-9958-bb294471f636",
                        "glosses": [
                            "levenswijsheid, motto, spreuk, stelregel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b8ea47-f828-41c6-86b9-6a5a93592518",
                                "sense_id": "d0cf1556-bd26-3561-ad88-e419aee4b44a",
                                "text": "We houden vast aan het adagium 'samen uit, samen thuis'."
                            },
                            {
                                "example_id": "84efdfb4-9ae0-4f15-b869-4fa3b3d04121",
                                "sense_id": "d0cf1556-bd26-3561-ad88-e419aee4b44a",
                                "text": "'Met een witte blijf je zitten', is het aloude adagium."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbac98c5-d3d2-4b36-af9d-2f3dba5ececa",
                        "source_entry_id": "2a6d9175-6802-3551-9958-bb294471f636",
                        "source_sense_id": "d0cf1556-bd26-3561-ad88-e419aee4b44a",
                        "target_lang_word": "Adagium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0beb7dc2-81e2-4ddb-b209-d4974eaafe9f",
                        "source_entry_id": "2a6d9175-6802-3551-9958-bb294471f636",
                        "source_sense_id": "d0cf1556-bd26-3561-ad88-e419aee4b44a",
                        "target_lang_word": "Sprichwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprichwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2660e284-729a-3feb-ab57-d5b7d570ed0b",
                                        "entry_id": "7d42961d-a812-3c33-a205-55f923a915dd",
                                        "glosses": [
                                            "Sinnspruch volkstümlichen Charakters, meist anonym überliefert; oft erzieherisch gedachter Erfahrungssatz, der treffend und bildmächtig formuliert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a42b31a-5ced-41af-a3c2-325e1890f3df",
                                                "sense_id": "2660e284-729a-3feb-ab57-d5b7d570ed0b",
                                                "text": "„Wer andern eine Grube gräbt, fällt selbst hinein.“ ist ein bekanntes Sprichwort aus den Apokryphen zur Bibel (Sirach 27,29)."
                                            },
                                            {
                                                "example_id": "eecb5763-96e9-4b21-b529-dbd9a377aae6",
                                                "sense_id": "2660e284-729a-3feb-ab57-d5b7d570ed0b",
                                                "text": "„Grundsätzlich ist es für Übersetzer ein großes Problem, Clichés, Slogans, idiomatische Ausdrücke, Redewendungen, Sprichwörter und geflügelte Worte von einer Sprache in eine andere adäquat zu übertragen.“"
                                            },
                                            {
                                                "example_id": "19e38faa-9397-466d-bbee-aa940c65a043",
                                                "sense_id": "2660e284-729a-3feb-ab57-d5b7d570ed0b",
                                                "text": "„W. Mieder differenziert die Inhaltlichkeit des Lehrhaften stärker und gibt dem Sprichwort eine ganze Reihe von Funktionen (1975, Seite 68): Lehre, Ratschlag, Trost, Warnung, Rechtfertigung, Argument, Erklärung, Feststellung, Charakterisierung.“"
                                            },
                                            {
                                                "example_id": "511a1aaa-5ea8-4f00-8a08-bbe936290afd",
                                                "sense_id": "2660e284-729a-3feb-ab57-d5b7d570ed0b",
                                                "text": "„Die Fehler von heute sind die Regeln von morgen, sagt ein germanistisches Sprichwort.“"
                                            },
                                            {
                                                "example_id": "b39fd508-a84d-46e3-b033-60b65ecfa961",
                                                "sense_id": "2660e284-729a-3feb-ab57-d5b7d570ed0b",
                                                "text": "„Wer aber, wie das englische Sprichwort sagt, mit dem Teufel an Bord geht, muß mit ihm segeln; ich befand mich unter ihnen und richtete mich ein, so gut ich konnte.“"
                                            },
                                            {
                                                "example_id": "9ac5ded7-243a-49ba-8604-a8d24c844473",
                                                "sense_id": "2660e284-729a-3feb-ab57-d5b7d570ed0b",
                                                "text": "„Sprichwörter sind meist kurz, treffend, volkstümlich formuliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e8441ec-4f08-41ad-b228-08184d770264",
                        "source_entry_id": "2a6d9175-6802-3551-9958-bb294471f636",
                        "source_sense_id": "d0cf1556-bd26-3561-ad88-e419aee4b44a",
