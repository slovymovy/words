                    {
                        "sense_id": "532dee31-f7f2-37e4-a0bd-270eea1eba4e",
                        "entry_id": "8def891a-20ab-313d-91cb-ae9142be4a14",
                        "glosses": [
                            "ударами, энергичным перемешиванием превратить в плотную массу"
                        ],
                        "tags": [],
