                "senses": [
                    {
                        "sense_id": "d0c67a47-2d1d-37a9-ba70-35a7e2fd5b95",
                        "entry_id": "9a5b72ab-af84-3ca8-9067-6df2e292eed4",
                        "glosses": [
                            "To handle roughly, as by chasing or scaring."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8a2e9c3b-e7e1-3979-904b-9d4ae0cd20b6",
                        "entry_id": "9a5b72ab-af84-3ca8-9067-6df2e292eed4",
                        "glosses": [
                            "To handle, to take care of."
                        ],
                        "tags": [
                            "US",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "31d484a6-7eeb-4cff-be58-d7ea320f1061",
                                "sense_id": "8a2e9c3b-e7e1-3979-904b-9d4ae0cd20b6",
                                "text": "This gave the roundup the appearance of a cavalry charge, and a stranger observing the procedure for the first time might have thought we were a bunch of green, possibly drunken cowboys making sport out of chousing cattle. But we weren't chousing them, we were just trying to keep them in sight, and for a very good reason."
                            }
                        ]
                    },
                    {
                        "sense_id": "06bfbe39-3cd5-3a2a-a120-a3c5f6eab539",
                        "entry_id": "9a5b72ab-af84-3ca8-9067-6df2e292eed4",
                        "glosses": [
                            "To cause undesirable activity in livestock, such as running."
                        ],
                        "tags": [
                            "US",
                            "regional",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "53b3feab-855d-465a-a12d-de6893355395",
                                "sense_id": "06bfbe39-3cd5-3a2a-a120-a3c5f6eab539",
                                "text": "[…] but the fact remains that my range cattle, because of the chousing which they received at the hands of the troops and the fright that they had, were caused to go into a period of considerable range deﬁciency without the ﬂesh with which they should have entered this period."
                            }
                        ]
                    }
                ],
