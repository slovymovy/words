                "senses": [
                    {
                        "sense_id": "a84690c3-d234-3efc-bf2b-dde504fc65a0",
                        "entry_id": "481e1491-dafd-3f17-a78e-ace264ae6219",
                        "glosses": [
                            "развёртывая, стелить, раскладывать, распространять на какой-либо поверхности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "728f6f47-4a02-48f6-b559-32e4439094b3",
                                "sense_id": "a84690c3-d234-3efc-bf2b-dde504fc65a0",
                                "text": "Он успевал расстилать свой ковёр при входе на каждый «объект» по пути кортежа."
                            }
                        ]
                    },
                    {
                        "sense_id": "3eff86a6-26da-382e-a7ea-672b9c2bb4fe",
                        "entry_id": "481e1491-dafd-3f17-a78e-ace264ae6219",
                        "glosses": [
                            "раскладывать тонким слоем по какой-либо поверхности"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9431a941-fce9-45e1-aa12-732b8054fb2f",
                        "source_entry_id": "481e1491-dafd-3f17-a78e-ace264ae6219",
                        "target_lang_word": "ausbreiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausbreiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adca9106-9315-30f2-bb99-d48da0bdcd20",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "etwas entfalten, übersichtlich nebeneinanderlegen (um jemandem etwas zu zeigen)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70432773-d58f-4442-8a96-226ac2d820f6",
                                                "sense_id": "adca9106-9315-30f2-bb99-d48da0bdcd20",
                                                "text": "Über dem Tisch, auf dem eine auseinandergepackte Musterkollektion von Tuchwaren ausgebreitet war, hing das Bild."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                        "entry_id": "e1d759b5-6de5-34dd-9ff6-443b0f82a0bf",
                                        "glosses": [
                                            "an Einfluss, Ausmaß, Fläche, Raum zunehmen; in einen größeren Umkreis gelangen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b621030-ceaa-4b63-9024-7fdc899a757e",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "Ein schöner, frischer Geruch breitet sich im Raum aus."
                                            },
                                            {
                                                "example_id": "39b059a7-8222-469b-a669-acefdbcd202c",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "Das Coronavirus breitete sich im Laufe der kalten Monate in Deutschland stark aus."
                                            },
                                            {
                                                "example_id": "06655924-38b8-438d-98a3-d53973fe01a3",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "Das Feuer konnte sich ungehindert ausbreiten."
                                            },
                                            {
                                                "example_id": "5a893b16-04d3-4622-821a-79f99c961e79",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "„Der Orden breitete sich rasch über Europa und auch nach Amerika aus.“"
                                            },
                                            {
                                                "example_id": "a0a2de73-8076-4841-92ad-17e14ce46bb1",
                                                "sense_id": "aafd5a68-6e8b-3666-a8c4-cb14776c04f7",
                                                "text": "„Sie sammeln unzählige Daten, die allesamt zeigen, wie sich westliche Rationalität und Organisationsformen in alle Winkel dieser Welt ausbreiten, und wie sich Entscheider zunehmend auf ethische Ziele berufen müssen, um Legitimität zu erhalten.“"
                                            },
                                            {
                                                "example_id": "98716685-fbda-40f3-a07f-512ea5332a2e",
