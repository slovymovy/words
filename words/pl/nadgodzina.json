                    "frequency": "Middle",
                    "semantic_group_id": "czas_pracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marta bardzo późno wraca z pracy, ponieważ ma dzisiaj sporo <w>nadgodzin</w>.",
