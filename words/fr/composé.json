                    "sense_definition": "En botanique, qualifie une feuille ou un organe subdivisé en plusieurs folioles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le trèfle possède une feuille <w>composée</w> de trois petites folioles distinctes."
                        },
                        {
                            "text": "Chez le mimosa, chaque feuille est deux fois <w>composée</w>, d'où son aspect très léger."
                        }
                    ],
                    "antonyms": [
                        "simple"
                    ],
                    "common_phrases": [
