                        "sense_id": "9f9601aa-dcd0-37c2-a2f4-a9dc1e1beac9",
                        "entry_id": "dcb63532-d49d-3b15-83b1-a3b4f5333b0e",
                        "glosses": [
                            "betrekking hebbend op het vereren van iets of iemand alsof het een god is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff2a347-80f4-4ece-ace4-afaf8fc3da02",
                                "sense_id": "9f9601aa-dcd0-37c2-a2f4-a9dc1e1beac9",
                                "text": "Nee. Hier dient geen sprake te zijn van afgodische verering van een aantal jochies die even flink met hun vuist op hun borst slaan."
                            },
                            {
                                "example_id": "67d12026-b387-4d96-a358-576beebe33ba",
                                "sense_id": "9f9601aa-dcd0-37c2-a2f4-a9dc1e1beac9",
                                "text": "De christelijke God is de onzichtbare God Die in Christus Jezus zichtbaar tot ons kwam (2 Kor. 4:4-6 en Kol. 1:15). Alle andere concepten van God zijn niet alleen incompleet, maar ook afgodisch (Joh. 8:39-59)."
                            }
                        ]
                    }
