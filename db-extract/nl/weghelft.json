                        "sense_id": "1df8f080-60c6-37d6-98e6-d07088311608",
                        "entry_id": "946c142c-ae32-308c-87b6-fa1174a08e19",
                        "glosses": [
                            "een van de twee helften van de weg waar de weggebruikers allemaal in dezelfde richting rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a65dff2-0597-4fa8-a029-878427e7f9ef",
                                "sense_id": "1df8f080-60c6-37d6-98e6-d07088311608",
                                "text": "Vorig jaar vielen er in Nederland 629 doden in het verkeer. De overheid wil dat dat aantal in 2020 is teruggebracht tot 500 verkeersdoden. Ze spreekt van een moeilijke klus, maar Peter Romijn wil hen alvast een eind op weg helpen: verreweg de meeste verkeersdoden vallen op provinciale wegen, meestal staat dan in de krant: ’door onbekende reden op de verkeerde weghelft gekomen’."
                            },
                            {
                                "example_id": "e0134930-8bbc-4c62-b8c9-c31a10d92557",
                                "sense_id": "1df8f080-60c6-37d6-98e6-d07088311608",
                                "text": "Op de Hunzeweg tussen De Groeve en Zuidlaren kwam een 46-jarige man uit Tynaarlo met zijn wagen op de verkeerde weghelft terecht en botste frontaal op de auto van de vrouw."
                            }
                        ]
                    }
