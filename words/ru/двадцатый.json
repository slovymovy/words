                },
                {
                    "sense_id": "431147d5-25e4-3904-af93-c19ec1a46380",
                    "sense_definition": "Обозначение года, оканчивающегося на двадцать, или века, начинающегося с двадцати.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "События происходили в <w>двадцатом</w> году прошлого века.",
                            "target_lang_translations": {
                                "en": "The events took place in the year <w>twenty</w> of the last century."
                            }
                        },
                        {
                            "text": "Культура <w>двадцатых</w> годов была очень яркой.",
                            "target_lang_translations": {
                                "en": "The culture of the <w>twenties</w> was very vibrant."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Referring to a year ending in twenty or a century starting with twenty."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twentieth",
                                "target_lang_sense_clarification": "Used in dates or centuries (e.g., twentieth century)."
