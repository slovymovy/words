                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigenlob",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40bf6b7b-2e9b-3397-adf4-ddda5a448f00",
                                        "entry_id": "9c1a0bc5-9b43-306e-a1e5-6d19b9ce8dce",
                                        "glosses": [
                                            "das Loben seiner eigenen Taten; die eigenen Handlungen als besonders gut hervorheben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8be7228-2632-4e8e-9831-79635b267c53",
                                                "sense_id": "40bf6b7b-2e9b-3397-adf4-ddda5a448f00",
                                                "text": "Sein ständiges Eigenlob geht mir auf die Nerven."
                                            },
                                            {
                                                "example_id": "e69019a9-6989-4fb4-9057-432217bcbefe",
                                                "sense_id": "40bf6b7b-2e9b-3397-adf4-ddda5a448f00",
                                                "text": "Um das Eigenlob von Hoteliers oder Schmähattacken durch die Konkurrenz herauszufiltern, werden die Beiträge durch einen Computeralgorithmus geschickt, der bei verdächtiger Katalogprosa Alarm schlagen soll."
                                            },
                                            {
                                                "example_id": "8dc6ec87-ec69-425f-84e7-b618bdac4029",
                                                "sense_id": "40bf6b7b-2e9b-3397-adf4-ddda5a448f00",
                                                "text": "„Man hält sich wohl den Spiegel vor, doch der Rückspiegel des Eigenlobs ist unversehens auch wieder da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
