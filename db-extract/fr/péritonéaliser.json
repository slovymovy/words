                "senses": [
                    {
                        "sense_id": "ed244f1e-d494-3f28-84de-27a5312f75c4",
                        "entry_id": "37657f0a-9c92-3127-9828-368ded711ae1",
                        "glosses": [
                            "Doter d’un péritoine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8acb901a-9606-40e1-93b8-39b45a656d99",
                                "sense_id": "ed244f1e-d494-3f28-84de-27a5312f75c4",
                                "text": "La main qui passe le fil sait où est l’aiguille ; celle qui tient l’aiguille sait d’où vient le fil ; ceux qui m’ont vu péritonéaliser des pédicules dans le ventre à points passés, avec une simple aiguille de Doyen, ont eu de suite l’impression de cette synergie : et c’est très facile."
                            },
                            {
                                "example_id": "debfe1c5-e271-49b4-8b45-e535aeaf4274",
                                "sense_id": "ed244f1e-d494-3f28-84de-27a5312f75c4",
                                "text": "On la place entre la paroi musculaire et le péritoine pour qu'elle se péritonéalise et se fibrose."
                            }
                        ]
                    }
