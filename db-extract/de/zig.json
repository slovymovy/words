                "senses": [
                    {
                        "sense_id": "866e51b4-137e-3647-ac44-ddb82a37b9a6",
                        "entry_id": "6041f516-57c2-3079-8c80-2df2af61b01c",
                        "glosses": [
                            "(sehr) viele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b4e42b-f2e0-4c9e-b3d9-253de5a9bd9a",
                                "sense_id": "866e51b4-137e-3647-ac44-ddb82a37b9a6",
                                "text": "„Dieses ‚Geschichtskabinett‘ ist eine von zig Geschichtsinitiativen, die es hier gibt.“"
                            },
                            {
                                "example_id": "61352344-29cf-483a-9062-1af3a96cd5df",
                                "sense_id": "866e51b4-137e-3647-ac44-ddb82a37b9a6",
                                "text": "„Es ist für einen Autor kompletter Unsinn auf die Messe zu fahren, wenn man nicht zig Interviewtermine und Lesungsanfragen hat.“"
                            },
                            {
                                "example_id": "3184a830-5438-4d76-af5f-b36370230c83",
                                "sense_id": "866e51b4-137e-3647-ac44-ddb82a37b9a6",
                                "text": "„Auch er hatte genau wie meine Tochter sehr schlechte Augen und nach zig Modellen abenteuerlicher Brillengestelle bekam er Kontaktlinsen.“"
                            },
                            {
                                "example_id": "ab9899fd-2b95-4c26-9110-e089b87b3a39",
                                "sense_id": "866e51b4-137e-3647-ac44-ddb82a37b9a6",
                                "text": "„Im Hinterzimmer zu sitzen und all die offiziellen Nachrichten und die vielen weiteren Briefe zu lesen – an zig Tassen Kaffee geklammert, um nicht die ganze Zeit zu rauchen –, während Julie vorn im Laden die Stellung hielt, war fast zu viel für sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02a8d39b-b4d3-4375-8252-ec09f55f3dfb",
