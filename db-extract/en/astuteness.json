                        "target_lang_word": "кова́рство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кова́рство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d147a28f-a140-3af5-b48b-58e32aa9ce25",
                                        "entry_id": "dedb4a90-f4c7-3fb2-8881-13a48fdc335a",
                                        "glosses": [
                                            "свойство характера человека: способность и склонность скрывать за показным дружелюбием злые намерения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9aeda6e-0fed-45e7-b80b-43957006a2fb",
                                                "sense_id": "d147a28f-a140-3af5-b48b-58e32aa9ce25",
                                                "text": "Коварство и завистливость — главные черты характера Яго."
                                            },
                                            {
                                                "example_id": "9553bb01-7415-47ee-9f0e-e639fcba6c90",
                                                "sense_id": "d147a28f-a140-3af5-b48b-58e32aa9ce25",
                                                "text": "Помню, как на лекции о коварстве иностранных разведок лектор сказал: «Западный агент, к примеру, в ресторане выпивает по глоточку и не закусывает»."
                                            }
                                        ]
