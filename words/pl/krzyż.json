    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1a14282-8b21-3bae-a5c5-0345008b41f1",
                    "sense_definition": "Dwie przecinające się linie (zwykle pod kątem prostym) lub przedmiot o takim kształcie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na mapie zaznaczono cel czerwonym <w>krzyżem</w>.",
                            "target_lang_translations": {
                                "ru": "На карте цель отмечена красным <w>крестом</w>.",
                                "en": "The target was marked on the map with a red <w>cross</w>."
                            }
                        },
                        {
                            "text": "Dziecko narysowało na kartce koło i <w>krzyż</w>.",
                            "target_lang_translations": {
                                "ru": "Ребёнок нарисовал на листе круг и <w>крест</w>.",
                                "en": "The child drew a circle and a <w>cross</w> on the sheet of paper."
                            }
                        }
                    ],
                    "common_phrases": [
                        "krzyż na drogę",
                        "na krzyż"
                    ],
                    "target_lang_definitions": {
                        "ru": "Две пересекающиеся линии (обычно под прямым углом) или предмет такой формы.",
                        "en": "Two intersecting lines (usually at a right angle) or an object of such a shape."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крест",
                                "target_lang_sense_clarification": "фигура"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "geometric shape or mark"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53a7de18-46cd-3b3f-8985-04fd416d59f6",
                    "sense_definition": "Główny symbol religii chrześcijańskiej, upamiętniający śmierć Jezusa.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni modlili się pod wielkim drewnianym <w>krzyżem</w>.",
                            "target_lang_translations": {
                                "ru": "Верующие молились под большим деревянным <w>крестом</w>.",
                                "en": "The faithful prayed under a large wooden <w>cross</w>."
                            }
                        },
                        {
                            "text": "Na wieży kościoła znajduje się złoty <w>krzyż</w>.",
                            "target_lang_translations": {
                                "ru": "На башне костёла находится золотой <w>крест</w>.",
                                "en": "There is a golden <w>cross</w> on the church tower."
                            }
                        }
                    ],
                    "common_phrases": [
                        "znak krzyża"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главный символ христианской религии, напоминающий о смерти Иисуса.",
                        "en": "The primary symbol of the Christian religion, commemorating the death of Jesus."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крест",
                                "target_lang_sense_clarification": "символ веры"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cross",
                                "target_lang_sense_clarification": "religious symbol"
                            },
                            {
                                "target_lang_word": "crucifix",
                                "target_lang_sense_clarification": "cross with the figure of Jesus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "962039da-cb0b-3344-b46f-2d0555475592",
                    "sense_definition": "Dolna część pleców, okolica kości krzyżowej.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po całym dniu pracy w ogrodzie czuję silny ból w <w>krzyżu</w>.",
                            "target_lang_translations": {
                                "ru": "После целого дня работы в саду я чувствую сильную боль в <w>пояснице</w>.",
                                "en": "After a whole day of working in the garden, I feel a sharp pain in my <w>lower back</w>."
                            }
                        },
                        {
                            "text": "Dziadek często narzeka na łamanie w <w>krzyżu</w>.",
                            "target_lang_translations": {
                                "ru": "Дедушка часто жалуется на ломоту в <w>пояснице</w>.",
                                "en": "Grandpa often complains about aching in his <w>lower back</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ból w krzyżu",
                        "łamać w krzyżu"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common way to refer to lower back pain"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть спины, область крестцовой кости.",
                        "en": "The lower part of the back, the sacral region."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поясница",
                                "target_lang_sense_clarification": "часть спины"
                            },
                            {
                                "target_lang_word": "крестец",
                                "target_lang_sense_clarification": "анатомия"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lower back",
                                "target_lang_sense_clarification": "lumbar region of the back"
                            },
                            {
                                "target_lang_word": "small of the back",
                                "target_lang_sense_clarification": "lower back"
                            },
                            {
                                "target_lang_word": "sacrum",
                                "target_lang_sense_clarification": "anatomical bone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aa1fc59-e81c-3908-9c3b-ab7899252b5f",
                    "sense_definition": "Gest religijny wykonywany ręką, oznaczający wyznanie wiary.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kobieta zrobiła znak <w>krzyża</w>, wchodząc do świątyni.",
                            "target_lang_translations": {
                                "ru": "Женщина осенила себя <w>крестным знамением</w>, входя в храм.",
                                "en": "The woman made the <w>sign of the cross</w> as she entered the temple."
                            }
                        },
                        {
                            "text": "Kapłan nakreślił <w>krzyż</w> nad głowami wiernych.",
                            "target_lang_translations": {
                                "ru": "Священник начертал <w>крест</w> над головами верующих.",
                                "en": "The priest made the <w>sign of the cross</w> over the heads of the faithful."
                            }
