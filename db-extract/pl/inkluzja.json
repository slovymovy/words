                    {
                        "translation_id": "092b1de5-8103-4380-80ed-f131ec31ff36",
                        "source_entry_id": "41dc7d89-bd65-3a27-a7c0-b48b293812a7",
                        "source_sense_id": "ebeebef2-cf3d-3bc1-94fb-a104fb216b5b",
                        "target_lang_word": "Inklusion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inklusion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "528ff041-a79b-34bc-96d1-b0b344582a64",
                                        "entry_id": "20f6a952-a527-308c-aa71-35fbed869225",
                                        "glosses": [
                                            "allgemein: ein Einschluss, eine Einschließung oder das Einschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a128181-3233-4def-9c37-2c6bbf1cd87d",
                                                "sense_id": "528ff041-a79b-34bc-96d1-b0b344582a64",
                                                "text": "Die Inklusion findet noch nicht statt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8dcf3070-63e6-310b-bbb5-31efce8a7d90",
                                        "entry_id": "20f6a952-a527-308c-aa71-35fbed869225",
                                        "glosses": [
                                            "Teilmengenbeziehung, siehe Teilmenge"
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89e01980-0225-406e-851a-e2d567ba002d",
                                                "sense_id": "8dcf3070-63e6-310b-bbb5-31efce8a7d90",
                                                "text": "Die Inklusion als Beziehung zwischen Mengen erfüllt die drei Eigenschaften einer partiellen Ordnungsrelation, sie ist nämlich reflexiv, antisymmetrisch und transitiv."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3307918d-84a8-3588-849f-e9c64cbcf17f",
                                        "entry_id": "20f6a952-a527-308c-aa71-35fbed869225",
                                        "glosses": [
                                            "Einschlüsse von andersartigen Materialien in Mineralien"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "838f8e4d-7518-334e-9d7b-ed20bf08f8af",
                                        "entry_id": "20f6a952-a527-308c-aa71-35fbed869225",
                                        "glosses": [
                                            "Zugang zu gesellschaftlichen Teilsystemen"
                                        ],
                                        "tags": [
                                            "Bildung",
                                            "Sozialwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60846d18-d425-4361-9b17-a64169a3654b",
                                                "sense_id": "838f8e4d-7518-334e-9d7b-ed20bf08f8af",
                                                "text": "„Inklusion meint bei Parsons innerhalb der evolutionären Gesellschaftsentwicklung die Einbeziehung bislang ausgeschlossener Akteure in Subsysteme.“"
                                            },
                                            {
                                                "example_id": "76cee731-ee61-4ca5-b96e-36d97b4624a0",
                                                "sense_id": "838f8e4d-7518-334e-9d7b-ed20bf08f8af",
                                                "text": "„Inklusion ist das Leitbild dieser weltweit gültigen Vereinbarung, also die nahtlose Integration aller Lebensformen in die Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "518ffbaa-0e92-4e1f-9d10-95c87fc4c451",
                                                "sense_id": "838f8e4d-7518-334e-9d7b-ed20bf08f8af",
                                                "text": "„In den letzten Jahren hat die gesellschaftliche Debatte zum Thema Inklusion deutlich an Dynamik gewonnen; ein Teilthema dieser Inklusionsdebatte stellt die »Leichte Sprache« dar.“"
                                            },
                                            {
                                                "example_id": "c3d0b88e-3be2-4df5-936a-16f8a3edbbe7",
                                                "sense_id": "838f8e4d-7518-334e-9d7b-ed20bf08f8af",
                                                "text": "„Die in Deutschland in den vergangenen Jahren so oft diskutierte Inklusion, das Nebeneinander von Schülern mit und ohne Handicap in einer Klasse, ist in Finnland kein Thema, denn es gab sie schon immer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81133f0a-8176-4815-890b-f3d1fd70d2c7",
                        "source_entry_id": "41dc7d89-bd65-3a27-a7c0-b48b293812a7",
