{
    "word_family": [
        "murmure",
        "murmureur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4787ee22-d2c8-35db-9a34-6fc51275804e",
                    "sense_definition": "Dire ou prononcer des paroles à voix basse et discrète.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'est approchée pour lui <w>murmurer</w> quelques mots d'encouragement à l'oreille."
                        },
                        {
                            "text": "L'enfant fatigué <w>murmura</w> un dernier souhait avant de s'endormir paisiblement."
                        }
                    ],
                    "synonyms": [
                        "chuchoter",
                        "susurrer"
                    ],
                    "antonyms": [
                        "crier",
                        "hurler"
                    ],
                    "common_phrases": [
                        "murmurer à l'oreille",
                        "murmurer un secret"
                    ]
                },
                {
                    "sense_id": "d9a34bcc-bc87-3e2d-8ddf-fa70194935cf",
                    "sense_definition": "Produire un son doux, continu et léger, en parlant des éléments naturels comme l'eau ou le vent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au fond du jardin, un petit ruisseau <w>murmure</w> calmement entre les pierres moussues."
                        },
                        {
                            "text": "Le vent d'automne <w>murmurait</w> doucement à travers les branches des vieux arbres."
                        }
                    ],
                    "synonyms": [
                        "bruire",
                        "frémir"
                    ],
                    "antonyms": [
                        "gronder",
                        "rugir"
                    ],
                    "common_phrases": [
                        "le ruisseau murmure",
                        "le vent murmure"
                    ]
                },
                {
                    "sense_id": "5ffe662d-af2f-32e1-a5b4-aff329dfc0ae",
                    "sense_definition": "Faire entendre un bruit de voix indistinct, sourd ou confus.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spectateurs impatients ont commencé à <w>murmurer</w> dans la salle obscure."
                        },
                        {
                            "text": "Il <w>murmurait</w> entre ses dents des phrases incompréhensibles que personne ne saisissait."
                        }
                    ],
                    "synonyms": [
                        "marmonner",
                        "bourdonner"
                    ],
                    "common_phrases": [
                        "murmurer entre ses dents"
                    ]
                },
                {
                    "sense_id": "f363bc96-7c43-3d65-9abe-8aaec3fbd87e",
                    "sense_definition": "Exprimer discrètement ou sourdement son mécontentement ; se plaindre à voix basse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés ont exécuté les ordres imposés sans oser <w>murmurer</w> ouvertement."
                        },
                        {
                            "text": "Plusieurs voisins <w>murmurent</w> contre les nouvelles règles votées par l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "grommeler",
                        "maugréer",
                        "ronchonner"
                    ],
                    "antonyms": [
                        "approuver",
                        "acquiescer"
                    ],
                    "common_phrases": [
                        "obéir sans murmurer",
                        "murmurer contre"
                    ]
                },
                {
                    "sense_id": "cc627c46-26a5-3530-a4d0-090c23fab311",
                    "sense_definition": "Faire courir une rumeur secrètement ou insinuer une nouvelle encore officieuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rumeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On <w>murmure</w> dans les couloirs que le directeur général quittera bientôt ses fonctions."
                        },
                        {
                            "text": "Les journalistes hésitaient à publier ce que tout le monde <w>murmurait</w> déjà."
                        }
                    ],
                    "synonyms": [
                        "ébruiter",
                        "chuchoter"
                    ],
                    "antonyms": [
                        "proclamer"
                    ],
                    "common_phrases": [
                        "on murmure que"
                    ]
                }
            ]
        }
    ]
}