                "senses": [
                    {
                        "sense_id": "8acf78e6-32c6-3c2d-9057-554837397ab9",
                        "entry_id": "c3e78487-d002-3053-9e01-bf9d508fea49",
                        "glosses": [
                            "Satzteil (Konstituente), dessen Kopf (Kern) ein Nomen (Substantiv oder Pronomen) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c45cc09b-34fc-4b63-b9af-c537dbc48ac5",
                                "sense_id": "8acf78e6-32c6-3c2d-9057-554837397ab9",
                                "text": "„Viele Sätze mit einem Übergewicht an Nominalgruppen können als Verkürzungen von Langsätzen (Satzgefüge, Satzreihen usw.) gelten.“"
                            },
                            {
                                "example_id": "f78cf616-6498-492d-9824-34db649a56b8",
                                "sense_id": "8acf78e6-32c6-3c2d-9057-554837397ab9",
                                "text": "„Bei Umsetzung verbaler Infinitivkonstruktionen in Nominalgruppen bleibt der abhängige Infinitiv bewahrt…“"
                            },
                            {
                                "example_id": "cf44e862-41d2-4da4-9dc8-dd07dc67dedc",
                                "sense_id": "8acf78e6-32c6-3c2d-9057-554837397ab9",
                                "text": "„Das Genitivattribut erlaubt auf sehr ökonomische Weise Präzisierungen von Nominalgruppen.“"
                            },
                            {
                                "example_id": "32f9c627-bd3d-4660-9e00-85dd37dde006",
                                "sense_id": "8acf78e6-32c6-3c2d-9057-554837397ab9",
                                "text": "„Da die Nominalgruppe zusammengehört, verwendet man nicht überall die differenzierteren Endungen der starken Flexion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
