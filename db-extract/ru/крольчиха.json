                                        "entry_id": "8bb0cd86-7c73-31b7-861e-5b65dd1ae901",
                                        "glosses": [
                                            "A female deer; also used of similar animals such as antelope (less commonly a goat, as nanny is also used)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
