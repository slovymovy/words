                "senses": [
                    {
                        "sense_id": "56a5bac7-783d-34eb-84bf-6000bd221fbb",
                        "entry_id": "a731172f-1a8f-341d-a4be-5d3adc293003",
                        "glosses": [
                            "ein Wort der russischen Sprache als Fremd- oder Lehnwort in einer anderen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bff34d4-2ef3-4e30-9e65-da17057acf8f",
                                "sense_id": "56a5bac7-783d-34eb-84bf-6000bd221fbb",
                                "text": "„Im Bereich der Vokabeln aus Fremdsprachen führt Beneke neben einigen gängigen Anglizismen … auch einige wenige Russizismen auf.“"
                            },
                            {
                                "example_id": "3aeca26f-2a41-4a2e-9832-729639fa0e4c",
                                "sense_id": "56a5bac7-783d-34eb-84bf-6000bd221fbb",
                                "text": "„Die meisten angeblichen Russizismen sind in Wirklichkeit deutsche Eigenkreationen nach russischem Modell (…) oder typische Ostblock-Internationalismen (…).“"
                            },
                            {
                                "example_id": "7925926b-b567-48d1-a07a-0e3fc9c13fd2",
                                "sense_id": "56a5bac7-783d-34eb-84bf-6000bd221fbb",
                                "text": "„Es wurde am Beispiel der Übernahme von Russizismen in die deutsche Sprache erneut erprobt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
