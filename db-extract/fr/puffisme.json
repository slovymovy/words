                        "examples": [
                            {
                                "example_id": "2b237cad-f8cc-4eca-afbf-7596210ca152",
                                "sense_id": "a483bf4d-afee-3bc3-a452-1a49d1c09b6d",
                                "text": "Il semble que si quelqu’un doit être à l’abri du puffisme financier, c’est bien celui qui, moyennant finances, écrit l’article dont l’enthousiasme est tarifé."
                            },
                            {
                                "example_id": "30db72dd-9ee8-4bfe-9ea6-fac21a73ce36",
                                "sense_id": "a483bf4d-afee-3bc3-a452-1a49d1c09b6d",
                                "text": "Le muflisme, c’est le triomphe du moi-égoïste sur le moi-humain. C’est la multiplication de cet individualisme qui dit : « Moi d’abord!… les autres s’il en reste ». C'est le puffisme appuyé sur l’argent et l’absence de scrupules."
                            },
                            {
                                "example_id": "a8bcf0fc-b089-4de8-a6d7-9f5620958a34",
                                "sense_id": "a483bf4d-afee-3bc3-a452-1a49d1c09b6d",
                                "text": "Il proteste contre l’œuvre et l’homme, n’y veut voir que puffisme, arrivisme et prétention."
                            }
                        ]
                    }
