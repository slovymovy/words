                                        "entry_id": "a956a150-3355-35be-b6b7-4294c883de7b",
                                        "glosses": [
                                            "A person who becomes a focal point of discussion on a social media platform (particularly Twitter)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d83a93b5-2d42-4301-961c-f134aaae0e94",
                                                "sense_id": "3ea8aace-2ab7-30ab-a727-c7dde9045ef4",
                                                "text": "With his Jill Biden essay, Joseph Epstein became Twitter’s main character this month."
                                            },
                                            {
                                                "example_id": "ffe5e1cf-f167-44a0-8c5f-00d182585c32",
                                                "sense_id": "3ea8aace-2ab7-30ab-a727-c7dde9045ef4",
                                                "text": "Unless you’re in the business of receiving hate clicks for profit, you never want to be the “main character” of Twitter."
                                            },
                                            {
                                                "example_id": "a441e13d-52d4-4a67-ab4d-d7a55c9e3b29",
                                                "sense_id": "3ea8aace-2ab7-30ab-a727-c7dde9045ef4",
                                                "text": "And while Trump, at least, now faces a reckoning over his most consequential tweets via the January 6 hearings, one final way to understand Elon Musk as our new main character is to consider the internet that has incentivized the rise of both men."
                                            }
                                        ]
                                    },
