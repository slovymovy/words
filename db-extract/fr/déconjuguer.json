                "senses": [
                    {
                        "sense_id": "447eacab-7e59-3beb-9bfd-d0d6d0067637",
                        "entry_id": "87cbd423-a434-3b7b-b7cb-b63e33ed2679",
                        "glosses": [
                            "Séparer ce qui était conjugué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cecb5a4-3b46-4246-b22e-44359f63ee15",
                                "sense_id": "447eacab-7e59-3beb-9bfd-d0d6d0067637",
                                "text": "Les bactéroïdes, les bifidobactéries et les clostridies produisent des hydrolases capables de déconjuguer les sels biliaires et de produire des sels biliaires libres."
                            },
                            {
                                "example_id": "c2734311-2b03-4edc-b4eb-8da567b6f6b8",
                                "sense_id": "447eacab-7e59-3beb-9bfd-d0d6d0067637",
                                "text": "Enfin, in vitro, F. Prausnitzii était capable de déconjuguer les AB."
                            },
                            {
                                "example_id": "581089e6-9b2d-49d5-bee7-32a4040ac023",
                                "sense_id": "447eacab-7e59-3beb-9bfd-d0d6d0067637",
                                "text": "On déconjugue l’arbre de couche d’avec l’arbre de commande de l’atelier ou de l’hélice qu’il est appelé à entraîner ; ou, s’il s’agit d’un bâtiment à roues, on enlève les pales."
                            }
                        ]
                    }
