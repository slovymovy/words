                                    {
                                        "sense_id": "252a175f-76e8-3e26-8a9d-ec587f63df29",
                                        "entry_id": "989a4378-2c3c-3e2c-8849-8b88de8d3436",
                                        "glosses": [
                                            "Que se mete o interviene en asuntos que no son de su incumbencia."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b6b79a4-51ba-4841-a253-9da8c126fd58",
                                                "sense_id": "252a175f-76e8-3e26-8a9d-ec587f63df29",
                                                "text": "Sucedió, pues, que un nuevo jefe de policía, tan entrometido como mal inspirado, resolvió conocer el manejo y situación de los subalternos rurales y sin decir ¡agua va! destacó inspectores que fueran a escudriñar cuanto pasaba en las comisarías."
                                            }
                                        ],
