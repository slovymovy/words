                        "glosses": [
                            "Personne habitant dans une péniche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51fa7814-aa32-4db9-b165-41b04237bf9b",
                                "sense_id": "79d2ecc4-b19c-36c7-ad4a-27528f6c6470",
                                "text": "Car Steven Deschuyter, « Steven la Flahute » bien qu’il fasse la biffe et la récupération n’était nullement un clochard, mais un pénichard, c’est-à-dire qu’il habitait sur l’eau, comme d’autres vivent dans une maison, une tente ou un igloo."
                            },
                            {
                                "example_id": "78f0a7bb-a45a-4013-976e-001f248bddc7",
                                "sense_id": "79d2ecc4-b19c-36c7-ad4a-27528f6c6470",
                                "text": "Le flic n’avait pas vécu le calvaire de la crue de juin, mais il sentait la tension grandissante des pénichards, le long du port d’Asnières-sur-Seine."
                            },
                            {
                                "example_id": "8070b943-42b1-4b7c-95b5-1632748da5d6",
                                "sense_id": "79d2ecc4-b19c-36c7-ad4a-27528f6c6470",
                                "text": "Structurés en association, les pénichards se sont mobilisés pour porter un avis commun auprès du commissaire enquêteur."
                            }
                        ]
                    }
