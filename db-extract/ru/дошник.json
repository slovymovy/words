                    }
                ],
                "translations": [
                    {
                        "translation_id": "acb7eeaf-f279-4bef-9181-6d5590dc02d5",
                        "source_entry_id": "524ea583-3981-31f2-b5a0-7be3b82dbe2b",
                        "source_sense_id": "3234cc72-49ca-3bce-b982-9a92cff8e34a",
                        "target_lang_word": "tank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e3eb107-9d2c-3494-8a12-9b0204f10674",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A closed container for liquids or gases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b156b89a-9abb-4b5d-b633-2928d8c24967",
                                                "sense_id": "4e3eb107-9d2c-3494-8a12-9b0204f10674",
                                                "text": "The propane is stored in these tanks."
                                            },
                                            {
                                                "example_id": "35d75a42-2679-42ef-b084-959e2a70f25d",
                                                "sense_id": "4e3eb107-9d2c-3494-8a12-9b0204f10674",
                                                "text": "The tank contains unfiltered water. You really shouldn't drink from that."
                                            },
                                            {
                                                "example_id": "c2a7f2da-ec40-40a7-aaa4-93d3d202de94",
                                                "sense_id": "4e3eb107-9d2c-3494-8a12-9b0204f10674",
                                                "text": "The other room was a kitchen, with an open fireplace, a safe, a dresser and a tin sink, with a tap from the tank outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c8b5b24-734d-3397-92bd-1fceaf3b32ae",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "An open container or pool for storing water or other liquids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "981e9efa-15fd-446e-87fc-e9b9d43f37f8",
                                                "sense_id": "7c8b5b24-734d-3397-92bd-1fceaf3b32ae",
                                                "text": "The contractors installed a new tank with gorgeous fish and corals."
                                            },
                                            {
                                                "example_id": "77b9ba13-041f-4cb6-9f70-01ac486c9015",
                                                "sense_id": "7c8b5b24-734d-3397-92bd-1fceaf3b32ae",
                                                "text": "The ore slurries are directed into an open tank outside the excavation site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61461fcc-f5dd-3b49-bd0e-1d9e7603794f",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A pond, pool, or small lake (either natural or artificial)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dffe0fc-ac0c-4a12-b03d-d997e076108d",
                                                "sense_id": "61461fcc-f5dd-3b49-bd0e-1d9e7603794f",
                                                "text": "The tanks are full and the grass is high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb2ae6b-4f73-3f7a-a4dd-606bd32616b5",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "The fuel reservoir of a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a56579-bdf5-4751-8a68-3fe065e506a5",
                                                "sense_id": "2eb2ae6b-4f73-3f7a-a4dd-606bd32616b5",
                                                "text": "We have brought the van to a garage after we found a leak in the tank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "473c77b4-6e01-3646-9bec-6fd9b8ef2eee",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "The amount held by a container; a tankful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e46dee9-fccf-4bad-847e-c8ff9723ec27",
                                                "sense_id": "473c77b4-6e01-3646-9bec-6fd9b8ef2eee",
                                                "text": "I burned three tanks of gas on the drive to New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d3f88d-54fb-33ba-8958-ec805ae678bc",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "An armoured fighting vehicle, armed with a gun designed for direct fire, and moving on caterpillar tracks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36067e34-7b0c-4f47-9f96-e34e59d7e76e",
                                                "sense_id": "23d3f88d-54fb-33ba-8958-ec805ae678bc",
                                                "text": "The journalist mistook the self-propelled artillery vehicle for a tank."
                                            },
                                            {
                                                "example_id": "88a8e062-d345-4233-8633-c66f90b2d11e",
                                                "sense_id": "23d3f88d-54fb-33ba-8958-ec805ae678bc",
                                                "text": "Few remember the female tanks that were produced between the World Wars."
                                            },
                                            {
                                                "example_id": "61abd487-fab6-4ba5-9522-f79faf76fbc2",
                                                "sense_id": "23d3f88d-54fb-33ba-8958-ec805ae678bc",
                                                "text": "Tank beats everything! Oh, man! I could do this all day!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793d8286-f6d0-3735-b5f9-4a8d8f83ff12",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A reservoir or dam."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "India"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3027d71a-0634-3367-8a93-32ca081d5b79",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A structure of tightly overlapping leaves used by some bromeliads to retain water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58613503-8cf6-3fd8-9a6d-e8521c5c779b",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A very muscular and physically imposing person; somebody who is built like a tank."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f5610a9-bfe0-3ed0-bf7e-7f0407d5565a",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A bouncer or doorman."
                                        ],
                                        "tags": [
                                            "UK",
                                            "broadly",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af2586ba-2ced-37f5-9eaa-a1e28dc4f06a",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A unit or character designed primarily around damage absorption and holding the attention of the enemy (as opposed to dealing damage, healing, or other tasks)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53703beb-691c-4418-a3e1-d8f491a3b11f",
                                                "sense_id": "af2586ba-2ced-37f5-9eaa-a1e28dc4f06a",
                                                "text": "The paladin can make for a decent tank, but I recommend that you get a class with better taunting skills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f77c5834-e3bf-3080-8e8f-058359785cf4",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A prison cell, or prison generally."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "701a900f-0536-4115-bd8c-afe4d1afa4fc",
                                                "sense_id": "f77c5834-e3bf-3080-8e8f-058359785cf4",
                                                "text": "drunk tank"
                                            },
                                            {
                                                "example_id": "6579e3c6-19de-47f0-844a-92118eb7ce34",
                                                "sense_id": "f77c5834-e3bf-3080-8e8f-058359785cf4",
                                                "text": "The sheriff threw us in the tank without charges!"
                                            },
                                            {
                                                "example_id": "957d6517-c0bb-4927-bbd1-2884bdf008df",
                                                "sense_id": "f77c5834-e3bf-3080-8e8f-058359785cf4",
                                                "text": "By the nature of imprisonment, one is perceived by free society as something subhuman. By the nature of being on a protective custody tank, a \"gay tank\", everyone there is seen as members of the lowest caste in the system."
                                            },
                                            {
                                                "example_id": "adeeaf50-0529-448a-93e6-afc4e699d663",
                                                "sense_id": "f77c5834-e3bf-3080-8e8f-058359785cf4",
                                                "text": "It was Christmas Eve, babe, in the drunk tank / An old man said to me, “Won't see another one”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec9ae32-6eca-3c4f-8f55-c6c6c3bb1b7f",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "A metaphorical place where a player goes to contemplate a decision; see in the tank."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "406fc69e-fe65-3ce1-b5f1-ace4bd3a1d48",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "Ellipsis of tank engine or tank locomotive."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a9f037-9625-4c40-916e-31302516d2ea",
                                                "sense_id": "406fc69e-fe65-3ce1-b5f1-ace4bd3a1d48",
                                                "text": "Before their conversion to 4-6-0 tender locomotives, the L.B. & S.C.R. Baltic tank engines Nos. 330 to 334 measured 50 ft. 5 in. over buffers; the nearest present approach to this figure is the 49 ft. 10½ in. of the remaining ex-Lancashire & Yorkshire Hughes type 4-cylinder 4-6-4 tanks of the L.M.S.R. The Furness and G. & S.W.R. 4-6-4 tanks of the same company, all now scrapped, were, respectively, 49 ft. 1½ in. and 47 ft. 8 in. long."
                                            },
                                            {
                                                "example_id": "8671a4f9-1df0-40dc-a890-2c428d4cecfb",
                                                "sense_id": "406fc69e-fe65-3ce1-b5f1-ace4bd3a1d48",
                                                "text": "Representing the older types now are some Stroudley 0-6-0 tanks, while a Drummond \"C14\" 0-4-0 tank might still be pottering about on the Town Quays as of yore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f770190d-b5bc-3b64-934f-5c7915a9d2ab",
                                        "entry_id": "206cb90a-042a-3bf0-bd6d-4b933cdea27a",
                                        "glosses": [
                                            "Ellipsis of tank top."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d5c354-fa80-44da-95e1-bbd6e1efbcd1",
                                                "sense_id": "f770190d-b5bc-3b64-934f-5c7915a9d2ab",
                                                "text": "T-BACK COTTON TANK"
                                            },
                                            {
                                                "example_id": "72c2243b-cf80-438d-9c2a-c1405317b159",
                                                "sense_id": "f770190d-b5bc-3b64-934f-5c7915a9d2ab",
                                                "text": "It pleased her more than she could say to know she walked on her own land, over dewed grass, wearing a tank and cotton pajama pants."
                                            },
                                            {
                                                "example_id": "bac743ba-2ffd-41d1-ab83-54e31b73e9f5",
                                                "sense_id": "f770190d-b5bc-3b64-934f-5c7915a9d2ab",
                                                "text": "I was wearing a tank and some cotton pants."
                                            },
                                            {
                                                "example_id": "21a6a66e-8922-431f-b95c-d6178863ff6c",
                                                "sense_id": "f770190d-b5bc-3b64-934f-5c7915a9d2ab",
                                                "text": "On TikTok, #wifepleaser boasts more than 11.4 million views, while #wifepleasertank has racked up 13.9 million. […] Thanks to TikTok, there has been a mass adoption of the term “wife pleaser” in an attempt to rebrand the tank."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "165e4ddd-8353-3cbc-9ecb-2fd023a262fb",
                                        "entry_id": "645ef24c-2b43-39b5-a661-a193f81d4b6c",
                                        "glosses": [
                                            "To fail or fall (often used in describing the economy or the stock market); to degenerate or decline rapidly; to plummet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4ee9bb-d14b-46c6-ac67-5e34923e060c",
                                                "sense_id": "165e4ddd-8353-3cbc-9ecb-2fd023a262fb",
                                                "text": "He told me about all the odd jobs he'd taken after I was born, when Michigan's economy was tanking. For one, he crisscrossed the Midwest buying old carpets from dentists' offices."
                                            },
                                            {
                                                "example_id": "6e71498e-47d6-448b-9b3c-44d5d253e645",
                                                "sense_id": "165e4ddd-8353-3cbc-9ecb-2fd023a262fb",
                                                "text": "\"[...] If the economy has tanked... then we don't want to over-promise and under-deliver.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c01b2731-b045-3dad-b04d-981919bc6ce0",
                                        "entry_id": "645ef24c-2b43-39b5-a661-a193f81d4b6c",
                                        "glosses": [
                                            "To attract the attacks of an enemy target in cooperative team-based combat, so that one's teammates can defeat the enemy in question more efficiently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf533c38-355d-3c77-a7c9-11759be8d6ad",
                                        "entry_id": "645ef24c-2b43-39b5-a661-a193f81d4b6c",
                                        "glosses": [
                                            "To put (fuel, etc.) into a tank."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e601ae95-f75b-4553-bbd0-5d26abab92f5",
                                                "sense_id": "bf533c38-355d-3c77-a7c9-11759be8d6ad",
                                                "text": "Concrete below ground must be fully tanked to prevent water uptake."
                                            },
                                            {
                                                "example_id": "cd344617-f586-4016-9439-13543d729955",
                                                "sense_id": "bf533c38-355d-3c77-a7c9-11759be8d6ad",
                                                "text": "Sometimes oils are tanked for months or years at a time (e.g., linseed oil)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb8a71a-505a-3437-949c-932834d042c5",
                                        "entry_id": "645ef24c-2b43-39b5-a661-a193f81d4b6c",
                                        "glosses": [
                                            "To deliberately lose a sports match with the intent of gaining a perceived future competitive advantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "634683a8-7f01-4d6b-a7f2-d492c3fca43a",
                                                "sense_id": "2cb8a71a-505a-3437-949c-932834d042c5",
                                                "text": "Beforehand, Swedish [national ice hockey team] coach Bengt-Ake Gustafsson had ruminated about tanking against Slovakia to avoid powerful Canada or the Czechs in the quarters [i.e., quarterfinals of the 2006 Winter Olympic tournament], telling Swedish television, \"One is cholera, the other the plague.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58bb847b-ef47-37b5-846d-da61aa694278",
                                        "entry_id": "645ef24c-2b43-39b5-a661-a193f81d4b6c",
                                        "glosses": [
                                            "To resist damage; to be attacked without being hurt."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc60761d-ef52-4b18-b98c-b91749836724",
                                                "sense_id": "58bb847b-ef47-37b5-846d-da61aa694278",
                                                "text": "Unless Bane can tank Helicarrier-busting explosions I'm not sure how he stands a chance."
                                            },
                                            {
