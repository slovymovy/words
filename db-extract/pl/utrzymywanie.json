                                                "sense_id": "8c179649-ff9f-3cc0-9486-549cb304a332",
                                                "text": "Die Zahlungen für die Unterhaltung und Wartung der Aggregate müssen reduziert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "776c353b-92ef-3321-9e0e-7d7d5296a678",
                                        "entry_id": "cb669da0-f102-3676-a1db-e94790b2027d",
