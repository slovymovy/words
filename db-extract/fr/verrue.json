                                        "glosses": [
                                            "Excrecencia patológica que se forma en la piel, causada por la infección del epitelio escamoso por el virus del papiloma humano."
                                        ],
                                        "tags": [
                                            "Enfermedades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e53338-f048-4f93-883a-bc119fd87b4b",
                                                "sense_id": "44bfeabb-f658-3df2-9af0-2dbae542202e",
                                                "text": "La verruga & la carne superflua sea quitada con el ligamiento: o espatumen spinoso tomando a ella con el vncino."
                                            }
