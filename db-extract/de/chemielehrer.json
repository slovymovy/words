                ],
                "senses": [
                    {
                        "sense_id": "c786775b-c1ea-3d4e-93ac-b80f7597a0f2",
                        "entry_id": "42167826-8038-3b1a-aa69-a32bf9221b58",
                        "glosses": [
                            "jemand, der an einer Schule Chemie unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d316dc90-eb90-4d59-ab05-f5ea455b238e",
                                "sense_id": "c786775b-c1ea-3d4e-93ac-b80f7597a0f2",
                                "text": "Der Chemielehrer musste beim Experimentieren sehr vorsichtig sein."
                            },
                            {
                                "example_id": "98374163-c0ff-4154-99d4-ba41f01710eb",
                                "sense_id": "c786775b-c1ea-3d4e-93ac-b80f7597a0f2",
                                "text": "„Auch der nette Chemielehrer, der die Schüler einschließlich der Untertertia unterrichtete, sollte bis ans Ende an das Regime geglaubt haben.“"
                            },
                            {
                                "example_id": "f1d7150c-c8e1-4ffd-b4fc-38c69f441dca",
                                "sense_id": "c786775b-c1ea-3d4e-93ac-b80f7597a0f2",
                                "text": "„Wir saßen in unseren Reihen auf den alten Holzbänken und unser Chemielehrer, ein Mann um die vierzig, der Herr Zauber hieß, sprang vor der Tafel herum wie Rumpelstilzchen.“"
                            },
                            {
                                "example_id": "1413ef53-bf50-4360-b367-ce726fb4caa6",
                                "sense_id": "c786775b-c1ea-3d4e-93ac-b80f7597a0f2",
                                "text": "„Ein engagierter Chemielehrer hatte darüber hinaus sein Interesse an Chemie geweckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
