                                "target_senses": [
                                    {
                                        "sense_id": "2a7f9e1f-f9fc-386f-a24b-4ecaa9935828",
                                        "entry_id": "31547772-47fb-3ba1-8c12-12d76b0156ec",
                                        "glosses": [
                                            "jemand, der Verhandlungen führt für eine Institution (Staat, Partei), um anderen möglichst viel für die eigenen Ziele abzuringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bb7b3a-6713-4d89-aa7e-e785d10f7e11",
                                                "sense_id": "2a7f9e1f-f9fc-386f-a24b-4ecaa9935828",
                                                "text": "Nachdem deutsche Unterhändler in Verhandlungen mit der Schweiz wenig oder nichts gegen den Schutz deutschen Schwarzgeldes erreichen konnten, drohte Finanzminister Steinbrück, die Kavallerie dorthin zu schicken."
                                            },
                                            {
                                                "example_id": "b0c42d4a-4c75-4632-9b36-2869470899c5",
                                                "sense_id": "2a7f9e1f-f9fc-386f-a24b-4ecaa9935828",
                                                "text": "„Es wurde eine Weile hin und her beraten und schließlich einer, der über besondere Redegewandtheit verfügte, zum Unterhändler gewählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd97c4c6-f1ec-4e36-bb0f-78189c0d25b1",
                        "source_entry_id": "dad571ad-9a12-3ea4-b21c-9f96c2758e22",
                        "source_sense_id": "2be1810e-ce1f-361e-8cb4-adfba79cad54",
