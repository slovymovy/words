                "senses": [
                    {
                        "sense_id": "3490f104-d04e-3824-8648-7d48941332c7",
                        "entry_id": "c8531350-04ac-3057-a992-0b0102067fa0",
                        "glosses": [
                            "Faire perdre son caractère anglais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6ef0ac-1403-4f7c-9206-40fb3804c808",
                                "sense_id": "3490f104-d04e-3824-8648-7d48941332c7",
                                "text": "Qu'il s'agisse de la Société littéraire de Yeats ou de la Ligue gaélique, les deux mouvements visent, plus ou moins directement, à désangliciser l'Irlande."
                            },
                            {
                                "example_id": "d3e49381-2e2a-4244-ac39-2fb55c652431",
                                "sense_id": "3490f104-d04e-3824-8648-7d48941332c7",
                                "text": "Les États-Unis, de ce fait, tendent à se désangliciser, tout en restant foncièrement de couleur anglo-saxonne."
                            }
                        ]
                    }
                ],
