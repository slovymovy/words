                        "entry_id": "0d1aff31-f651-3139-aa17-8b9ec9ff7638",
                        "glosses": [
                            "Biological growth, (now usually restricted to) expansion or growth of an organism apart from that due to cellular division."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "911b8185-1858-45dd-ac0e-bf3cba2e353f",
                                "sense_id": "e9062c00-7f46-33b1-ba5a-f4a74ba2e8aa",
                                "text": "Auxesis, augmentation, increase."
                            },
                            {
                                "example_id": "0cf62042-69a8-4bef-a918-5306b872eb47",
                                "sense_id": "e9062c00-7f46-33b1-ba5a-f4a74ba2e8aa",
                                "text": "Botanists do still distinguish between auxesis or growth by expansion, and merisis or growth by cell-multiplication."
