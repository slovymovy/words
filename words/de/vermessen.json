                },
                {
                    "sense_id": "ed8d6eae-c0ab-3119-a240-18a4fba12f0f",
                    "sense_definition": "Übermäßig ehrgeizig und deshalb mit großem Risiko verbunden; gewagt oder kühn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "presumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Konstruktionsweise der Brücke war allzu <w>vermessen</w>, weshalb das Bauwerk den starken Stürmen nicht standhielt."
                        },
                        {
                            "text": "Sein <w>vermessener</w> Plan, die Bergwand im Alleingang zu bezwingen, scheiterte schließlich an den Wetterbedingungen."
                        }
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "ein vermessener Plan",
                        "allzu vermessen sein"
                    ],
                    "synonyms": [
                        "gewagt",
                        "kühn"
                    ]
                }
            ]
        },
