                    {
                        "sense_id": "1d8c1597-73da-38e8-97d2-54000655fd1f",
                        "entry_id": "fe111c78-f290-354b-af50-511e50dc2c8b",
                        "glosses": [
                            "Drink, für den man nicht selber bezahlen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb00b1d0-7204-4e0e-9c6b-89b5e9970870",
                                "sense_id": "1d8c1597-73da-38e8-97d2-54000655fd1f",
                                "text": "„Es ist eine Nachricht von Salome: ›Meine Quellen sind zuverlässig, aber die Chance auf einen Gratisdrink lasse ich mir nicht entgehen. Sagen Sie Bescheid, wann es Ihnen passt.‹“"
                            },
                            {
                                "example_id": "eb8b4475-0d49-4bc6-af99-91754c8a7be4",
                                "sense_id": "1d8c1597-73da-38e8-97d2-54000655fd1f",
                                "text": "„John ruft die Rezeption an und bestellt uns Champagner. Davon wird mir zwar immer kotzübel, aber wer bin ich, einen Gratisdrink auszuschlagen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
