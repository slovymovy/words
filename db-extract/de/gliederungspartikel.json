                ],
                "senses": [
                    {
                        "sense_id": "60fb09f2-eaba-3c18-a68d-18ff74eca95c",
                        "entry_id": "27664e2a-c142-35a8-82df-c12673761624",
                        "glosses": [
                            "Partikel, die der Gesprächsgliederung (Beginn, Aufrechterhaltung, Beendigung) dienen; sie markieren zum Beispiel, ob ein Sprecherwechsel gewünscht wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d853f7-d86e-4297-b522-6f38e48b697a",
                                "sense_id": "60fb09f2-eaba-3c18-a68d-18ff74eca95c",
                                "text": "In der Äußerung „Also! Bitte mal herhören.“ ist „also“ eine Gliederungspartikel, mit der der Sprecher die Anwesenden um Aufmerksamkeit bittet und zugleich seinen Redebeitrag eröffnet."
                            },
                            {
                                "example_id": "fa5a92c8-be71-4a08-8358-bc66752ca7ba",
                                "sense_id": "60fb09f2-eaba-3c18-a68d-18ff74eca95c",
                                "text": "Gliederungspartikeln können vom Sprecher ebenso wie vom Hörer verwendet werden, um zum Beispiel - als Sprecher - Aufmerksamkeit einzufordern oder - als Hörer - zu signalisieren."
                            },
                            {
                                "example_id": "6a4169ab-6d4d-4f6d-a8f1-1fbc042df043",
                                "sense_id": "60fb09f2-eaba-3c18-a68d-18ff74eca95c",
                                "text": "„In ähnlicher Weise werden verbale Rückmeldungs- und Gliederungspartikeln wie ja, ne, aha, so prosodisch gekennzeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
