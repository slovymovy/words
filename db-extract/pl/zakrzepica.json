                    {
                        "sense_id": "dcb5ae28-db1a-3ab3-8687-ae16954651f2",
                        "entry_id": "249c00e5-f839-35af-ad26-94528555b9c9",
                        "glosses": [
                            "choroba polegająca na powstawaniu w żyłach zakrzepów blokujących przepływ krwi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "809ae695-e3a3-4d8f-831e-2a8f67554ee9",
                                "sense_id": "dcb5ae28-db1a-3ab3-8687-ae16954651f2",
                                "text": "Kobiety w ciąży, których ciało produkuje wielkie ilości estrogenów, są o wiele bardziej narażone na zakrzepicę niż kobiety stosujące antykoncepcję"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bb54184-d583-434a-b6ab-9cca6bbfeda6",
                        "source_entry_id": "249c00e5-f839-35af-ad26-94528555b9c9",
                        "source_sense_id": "dcb5ae28-db1a-3ab3-8687-ae16954651f2",
                        "target_lang_word": "thrombosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrombosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                        "entry_id": "07ded963-5a0b-3086-8a2c-b2f04cb3ceda",
                                        "glosses": [
                                            "The formation of thrombi in the blood vessels of a living organism, causing obstruction of the circulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea37e276-e542-4609-b255-eacd353a0886",
                                                "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                                "text": "The cure for thrombosis at the heart of London was to start work quickly on the new Victoria line. A high-level decision to proceed with this railway was urgently awaited"
                                            },
                                            {
                                                "example_id": "f8decf70-ecde-4153-adc7-d02a805b3b44",
                                                "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                                "text": "Blood-clotting platelets had surged like minnows to the site of injury, clumping together to form a thrombosis that blocked the artery, causing a heart attack and tissue death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9748dc1-9fcf-46ff-905c-e65b8d26c797",
                        "source_entry_id": "249c00e5-f839-35af-ad26-94528555b9c9",
                        "source_sense_id": "dcb5ae28-db1a-3ab3-8687-ae16954651f2",
