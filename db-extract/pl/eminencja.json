                                        "sense_id": "d518e4c0-5fdf-3dd0-9897-94f62280eed2",
                                        "entry_id": "de5f14f7-e46d-3117-8efe-77dc1f365e1c",
                                        "glosses": [
                                            "Someone of high rank, reputation or social status."
                                        ],
