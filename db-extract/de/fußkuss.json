                        "examples": [
                            {
                                "example_id": "3f3c4495-498d-46dc-aa1b-cad4a5169f07",
                                "sense_id": "1b4ce9c7-6d4f-3fdc-a24a-556a369ec6f6",
                                "text": "Früher wurde den höchsten Würdenträgern wie dem Papst oder dem Kaiser durch einen Fußkuss Ehrerbietung und Unterwerfung gezeigt."
                            },
                            {
                                "example_id": "9b6d5f44-8605-4ff2-abb2-09203a21a8f3",
                                "sense_id": "1b4ce9c7-6d4f-3fdc-a24a-556a369ec6f6",
                                "text": "„Wie trauerte er seinem Johannes XXIII. nach, der den Fußkuss und den dreimaligen tiefen Kniefall bei einer Audienz abgeschafft hatte.“"
                            }
                        ],
