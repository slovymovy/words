                        "entry_id": "ebb5edea-e3c5-3456-849c-c77fbc94f087",
                        "glosses": [
                            "een stevig, beschermend omhulsel voor een bril"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "539ffaf0-1a19-4c41-ba76-09dbf48fa64c",
                                "sense_id": "e3be035c-6404-3506-9a61-57a47072f8fa",
                                "text": "Een bril wordt 's nachts het best in een brillenkoker bewaard."
                            }
                        ]
