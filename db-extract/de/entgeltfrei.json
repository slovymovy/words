                "senses": [
                    {
                        "sense_id": "fb7f1ca5-d512-3ff6-8d44-2a98a7c517d5",
                        "entry_id": "ad4f95bf-3844-3a41-b0fc-d3ee396b1283",
                        "glosses": [
                            "ohne Entgelt, ohne geldliche Gegenleistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3409ea1c-5747-4bb2-8a10-69586567b3d1",
                                "sense_id": "fb7f1ca5-d512-3ff6-8d44-2a98a7c517d5",
                                "text": "„Für private Nutzer ist die Facebook-Nutzung entgeltfrei.“"
                            },
                            {
                                "example_id": "e4153fe5-584a-4a96-af31-0b3afe2c4bf8",
                                "sense_id": "fb7f1ca5-d512-3ff6-8d44-2a98a7c517d5",
                                "text": "„Die meisten Fahrzeuge, die entgeltfrei dort abgestellt sind, werden mindestens 90% der Zeit nicht bewegt.“"
                            },
                            {
                                "example_id": "07c05d9e-1bc9-4c50-8e07-f98709eb775f",
                                "sense_id": "fb7f1ca5-d512-3ff6-8d44-2a98a7c517d5",
                                "text": "„Die EU möchte die Rechte von Urhebern und Verlagen stärken und damit vor allem die entgeltfreie Verwendung von Inhalten durch Internetgiganten eindämmen.“"
                            },
                            {
                                "example_id": "23de25ff-2372-4330-86ea-6dea2170eb5b",
                                "sense_id": "fb7f1ca5-d512-3ff6-8d44-2a98a7c517d5",
                                "text": "„Diese Angebote erlauben in der Regel eine entgeltfreie Nutzung und finanzieren sich durch die Einbindung von Werbung im Umfeld der Videos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
