{
    "word_family": [
        "mislukken",
        "mislukking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4d1db74-8d00-3833-8068-3fb7b147fb75",
                    "sense_definition": "iemand die in het leven of bij een bepaalde onderneming niets bereikt heeft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij voelde zich een enorme <w>mislukkeling</w> nadat zijn eigen bedrijf failliet was gegaan.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя полным <w>неудачником</w> после того, как его собственная компания обанкротилась."
                            }
                        },
                        {
                            "text": "Je moet jezelf niet meteen als een <w>mislukkeling</w> zien als je een keer zakt voor een examen.",
                            "target_lang_translations": {
                                "ru": "Не стоит сразу считать себя <w>неудачником</w>, если ты однажды провалил экзамен."
                            }
                        }
                    ],
                    "synonyms": [
                        "loser"
                    ],
                    "common_phrases": [
                        "totale mislukkeling",
                        "voelen als een mislukkeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который ничего не добился в жизни или в определенном деле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неудачник",
                                "target_lang_sense_clarification": "человек, потерпевший неудачу в жизни или деле"
                            },
                            {
                                "target_lang_word": "лузер",
                                "target_lang_sense_clarification": "разговорное обозначение неудачника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13273b2b-01b3-3c1a-b052-6a1934cf41ff",
                    "sense_definition": "iets wat niet goed gelukt of misvormd is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voorwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die eerste appeltaart die ik probeerde te bakken was een echte <w>mislukkeling</w>.",
                            "target_lang_translations": {
                                "ru": "Тот первый яблочный пирог, который я попытался испечь, оказался сплошным <w>недоразумением</w>."
                            }
                        },
                        {
                            "text": "De kunstenaar gooide elke <w>mislukkeling</w> direct in de prullenbak om opnieuw te beginnen.",
                            "target_lang_translations": {
                                "ru": "Художник сразу выбрасывал каждый <w>неудавшийся экземпляр</w> в мусорную корзину, чтобы начать заново."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "неудавшийся, испорченный или деформированный предмет или результат работы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брак",
                                "target_lang_sense_clarification": "испорченное или дефектное изделие"
                            },
                            {
                                "target_lang_word": "неудавшийся экземпляр",
                                "target_lang_sense_clarification": "вещь, которая получилась неудачной"
                            },
                            {
                                "target_lang_word": "уродец",
                                "target_lang_sense_clarification": "разговорно о деформированном, кривом предмете"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}