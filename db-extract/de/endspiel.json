                                                "sense_id": "2b743fe0-77ea-38cc-9881-791d17ed286a",
                                                "text": "It was tough cramming for those midterms and finals, staying up 72 hours straight hepped up on caffeine and pizza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "725e4542-652a-3412-9f67-744c771fd440",
