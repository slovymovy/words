                        "glosses": [
                            "Celle qui déchiquette."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e1d0b744-d6c1-3f6a-b9c8-4e7cc731a217",
                        "entry_id": "e3d91393-5059-35c4-8279-11069595382d",
                        "glosses": [
                            "Appareil utilisé pour la destruction de documents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d0eac0b-1f14-4156-b365-c6d3fe0fd8e5",
                                "sense_id": "e1d0b744-d6c1-3f6a-b9c8-4e7cc731a217",
                                "text": "– Vous dites ça bien légèrement… Que faire du rapport d’autopsie ?\n– Passez-le dans la déchiqueteuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a7ea3b3-810e-3fed-a330-6904097786fe",
                        "entry_id": "e3d91393-5059-35c4-8279-11069595382d",
                        "glosses": [
                            "Appareil utilisé pour la mise en copeaux de petits et moyens morceaux de bois, branches, etc…"
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "ff822141-9fb1-4e84-a743-9a680e7c8af5",
                                "sense_id": "4a7ea3b3-810e-3fed-a330-6904097786fe",
                                "text": "Selon les premiers éléments d’enquête, la dépouille de la victime aurait été mutilée dans une déchiqueteuse servant à l’entreprise arboricole, qui n’aurait toutefois rien à voir avec le crime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37a879d0-b079-4c97-903d-ae1835fcd23c",
                        "source_entry_id": "e3d91393-5059-35c4-8279-11069595382d",
                        "source_sense_id": "57e6570a-bc85-3b5c-a07a-c54e18f8ddbf",
                        "source_sense_description": "Celle qui déchiquette.",
                        "target_lang_word": "chipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a60dcfe3-eeef-3b2e-8535-bc1492b44cc9",
                                        "entry_id": "3dae4562-c971-350f-b8d8-b655129055c7",
                                        "glosses": [
                                            "Exhibiting a lively optimism; in high spirits, cheerful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b7a6bc-3e10-408f-ab51-129bfc3b9315",
                                                "sense_id": "a60dcfe3-eeef-3b2e-8535-bc1492b44cc9",
                                                "text": "Van Halen orders garlic strewn about Lucy's bedroom. she feels a bit chipperer the next morning, so Mina heads off to help poor Harker in Budapest."
                                            },
                                            {
                                                "example_id": "2b6eb49e-d9f1-4c5d-b707-83d98b318d70",
                                                "sense_id": "a60dcfe3-eeef-3b2e-8535-bc1492b44cc9",
                                                "text": "The idea of a merchant selling both totems of pure evil and frozen yogurt (he calls it frogurt!) is amusing in itself, as is the idea that frogurt could be cursed, but it’s really the Shopkeeper’s quicksilver shift from ominous doomsaying to chipper salesmanship that sells the sequence."
                                            },
                                            {
                                                "example_id": "291f8b0c-b8fe-4273-85e8-bd2028aa5b92",
                                                "sense_id": "a60dcfe3-eeef-3b2e-8535-bc1492b44cc9",
                                                "text": "\"Sure, but she's not saying.\" Imrich kicked his feet up on the coffee table, dislodging a pile of research papers — hers, of course — onto the floor. She tried not to twitch. Laiken twitched a lot, and it was irritating. \"Personally I think she has the magical ability to not notice she's working for an arguably evil worldwide truth suppression conspiracy. Nobody at the SCP Foundation ought to be that goddamn chipper.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8d7a9c-265a-3ea2-a7d7-364d4f09c89f",
                                        "entry_id": "fb3de615-29a1-31e3-93fd-16f4920d71ca",
                                        "glosses": [
                                            "Someone who or something which chips (e.g. wood)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366a35e7-ce94-4f32-9a52-04a9e1623b33",
                                                "sense_id": "5c8d7a9c-265a-3ea2-a7d7-364d4f09c89f",
                                                "text": "Used for chopping large blocks of chocolate into small pieces, a chocolate chipper looks like a large fork with six thin, very sharp, pointed metal fingers. To use the chipper, hold it straight up and down and press it firmly[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbc4635-b648-3015-bfc5-0286cc611a8a",
                                        "entry_id": "fb3de615-29a1-31e3-93fd-16f4920d71ca",
                                        "glosses": [
                                            "Someone who or something which chips (e.g. wood).",
                                            "A machine that reduces organic matter to compost; depending on size, whole tree trunks are reduced to sawdust; a woodchipper."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab31d74c-cb8b-418a-ac0c-b6b3d2d184e7",
                                                "sense_id": "efbc4635-b648-3015-bfc5-0286cc611a8a",
                                                "text": "NR workers feed the cleared vegetation into a chipper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c178f4fd-ea40-3859-96c2-da3c6d92aa2e",
                                        "entry_id": "fb3de615-29a1-31e3-93fd-16f4920d71ca",
                                        "glosses": [
                                            "Someone who or something which chips (e.g. wood).",
                                            "A machine that chips potatoes into pieces that are ready to be fried and made into chips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14a80ab4-5aa9-3638-b4b9-d9eed39cfe3e",
                                        "entry_id": "fb3de615-29a1-31e3-93fd-16f4920d71ca",
                                        "glosses": [
                                            "A fish and chip shop, or more generally a cheap fast food outlet, typically selling chips and other deep-fried foods."
                                        ],
                                        "tags": [
                                            "East",
                                            "Ireland",
                                            "North",
                                            "Scotland",
                                            "slang"
