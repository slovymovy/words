{
    "word_family": [
        "staggering",
        "staggeringly",
        "staggerer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5f191ce-ed7d-3a5a-b1ee-21268a7c9234",
                    "sense_definition": "To walk or move unsteadily, as if about to fall.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unsteady-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After being hit by the ball, he began to <w>stagger</w> across the field.",
                            "target_lang_translations": {
                                "ru": "После удара мячом он начал <w>шататься</w> по полю."
                            }
                        },
                        {
                            "text": "The exhausted hiker managed to <w>stagger</w> into the camp before collapsing.",
                            "target_lang_translations": {
                                "ru": "Изможденному туристу удалось <w>доковылять</w> до лагеря, прежде чем он упал без сил."
                            }
                        }
                    ],
                    "synonyms": [
                        "totter",
                        "reel",
                        "sway",
                        "stumble"
                    ],
                    "common_phrases": [
                        "stagger to feet",
                        "stagger across room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти или двигаться неуверенно, покачиваясь, как будто собираясь упасть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шататься",
                                "target_lang_sense_clarification": "идти неверной походкой, покачиваясь"
                            },
                            {
                                "target_lang_word": "идти шатаясь",
                                "target_lang_sense_clarification": "передвигаться с трудом, теряя равновесие"
                            },
                            {
                                "target_lang_word": "ковылять",
                                "target_lang_sense_clarification": "идти неровно, спотыкаясь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcf5ec1e-dbb4-3fee-a8ec-808634c48591",
                    "sense_definition": "To shock, amaze, or deeply confuse someone, making them hesitate or doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shock-amaze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer scale of the corruption scandal will <w>stagger</w> the public.",
                            "target_lang_translations": {
                                "ru": "Один лишь масштаб коррупционного скандала <w>потрясет</w> общественность."
                            }
                        },
                        {
                            "text": "The cost of the new project is enough to <w>stagger</w> the imagination of the board members.",
                            "target_lang_translations": {
                                "ru": "Стоимость нового проекта способна <w>поразить</w> воображение членов совета директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "astound",
                        "shock",
                        "dumbfound",
                        "flabbergast"
                    ],
                    "common_phrases": [
                        "stagger the imagination",
                        "stagger the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потрясти, изумить или глубоко запутать кого-либо, заставив сомневаться или колебаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясать",
                                "target_lang_sense_clarification": "сильно удивлять, поражать воображение"
                            },
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "изумлять масштабом или неожиданностью"
                            },
                            {
                                "target_lang_word": "ошеломлять",
                                "target_lang_sense_clarification": "приводить в замешательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a61591c0-8890-39d9-8267-dc834fe8df44",
                    "sense_definition": "To arrange or schedule events, shifts, or hours so that they occur at different, overlapping, or intervals of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrange-intervals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>stagger</w> working hours to reduce traffic congestion.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>сдвинуть</w> рабочие часы, чтобы уменьшить пробки на дорогах."
                            }
                        },
                        {
                            "text": "We should <w>stagger</w> our lunch breaks so that someone is always at the desk.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>распределить по времени</w> наши обеденные перерывы, чтобы за столом всегда кто-то был."
                            }
                        }
                    ],
                    "synonyms": [
                        "alternate",
                        "space out"
                    ],
                    "common_phrases": [
                        "stagger working hours",
                        "stagger the release"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределять или планировать события, смены или часы так, чтобы они происходили в разное время или с интервалами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределять по времени",
                                "target_lang_sense_clarification": "устанавливать разные интервалы"
                            },
                            {
                                "target_lang_word": "чередовать",
                                "target_lang_sense_clarification": "делать посменно или с промежутками"
                            },
                            {
                                "target_lang_word": "сдвигать",
                                "target_lang_sense_clarification": "делать графики несовпадающими"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31f6e483-b61c-31a6-a848-c162033bc57f",
                    "sense_definition": "To cause someone to reel, totter, or become unsteady physically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unsteady-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden blow to the shoulder managed to <w>stagger</w> the defender.",
                            "target_lang_translations": {
                                "ru": "Внезапный удар в плечо заставил защитника <w>пошатнуться</w>."
                            }
                        },
                        {
                            "text": "The strong gust of wind threatened to <w>stagger</w> the pedestrians on the bridge.",
                            "target_lang_translations": {
                                "ru": "Сильный порыв ветра грозил <w>сбить с ног</w> пешеходов на мосту."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw off balance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то покачнуться, потерять равновесие или стать физически неустойчивым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пошатнуть",
                                "target_lang_sense_clarification": "лишить физического равновесия"
                            },
                            {
                                "target_lang_word": "заставить покачнуться",
                                "target_lang_sense_clarification": "выбить из устойчивого положения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dfc12b1-e117-32fb-a1c7-96b3a5144c22",
                    "sense_definition": "To arrange objects in a zigzag, alternating, or overlapping pattern rather than a straight line.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arrange-intervals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>stagger</w> the starting positions, the runners will have equal distance on the curve.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>сместите</w> стартовые позиции, бегуны преодолеют одинаковое расстояние на повороте."
                            }
                        },
                        {
                            "text": "The builder advised us to <w>stagger</w> the joints of the wooden planks for better stability.",
                            "target_lang_translations": {
                                "ru": "Строитель посоветовал нам <w>расположить в шахматном порядке</w> стыки деревянных досок для большей прочности."
                            }
                        }
                    ],
                    "synonyms": [
                        "offset"
                    ],
                    "common_phrases": [
                        "stagger starting positions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Располагать объекты в шахматном, зигзагообразном или чередующемся порядке вместо прямой линии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "располагать в шахматном порядке",
                                "target_lang_sense_clarification": "размещать со смещением"
                            },
                            {
                                "target_lang_word": "смещать",
                                "target_lang_sense_clarification": "располагать не на одной линии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c527be4b-9adf-3abe-b5df-04772a247900",
                    "sense_definition": "To begin to doubt, waver, or hesitate in purpose or belief.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shock-amaze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not <w>stagger</w> in his faith despite facing numerous hardships.",
                            "target_lang_translations": {
                                "ru": "Он не <w>поколебался</w> в своей вере, несмотря на многочисленные трудности."
                            }
                        },
                        {
                            "text": "Faced with such strong opposition, her resolve began to <w>stagger</w>.",
                            "target_lang_translations": {
                                "ru": "Столкнувшись с таким сильным противодействием, ее решимость начала <w>слабеть</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "waver",
                        "hesitate",
                        "falter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in literary or religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать сомневаться, колебаться или проявлять нерешительность в намерениях или вере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "испытывать сомнения, терять уверенность"
                            },
                            {
                                "target_lang_word": "пошатнуться",
                                "target_lang_sense_clarification": "о вере или решимости: ослабеть"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3332155e-35f5-3f50-8196-9c126258977b",
                    "sense_definition": "An unsteady, reeling movement of the body as if about to fall.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unsteady-movement-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got up with a noticeable <w>stagger</w> after the collision.",
                            "target_lang_translations": {
                                "ru": "После столкновения он поднялся с заметным <w>шатанием</w>."
                            }
                        },
                        {
                            "text": "The drunken man walked down the street with a heavy <w>stagger</w>.",
                            "target_lang_translations": {
                                "ru": "Пьяный мужчина шел по улице <w>шаткой походкой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lurch",
                        "reel",
                        "stumble"
                    ],
                    "common_phrases": [
                        "stagger of a drunken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неуверенное, шатающееся движение тела, как будто перед падением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатание",
                                "target_lang_sense_clarification": "неуверенная походка, покачивание"
                            },
                            {
                                "target_lang_word": "шаткая походка",
                                "target_lang_sense_clarification": "неустойчивое движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf991440-9954-3c16-9f0e-ebab481529e8",
                    "sense_definition": "An arrangement or spacing out of actions, events, or objects over time or space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arrange-intervals-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe suggests a <w>stagger</w> of ingredients to ensure everything cooks perfectly.",
                            "target_lang_translations": {
                                "ru": "Рецепт предполагает <w>чередование</w> ингредиентов, чтобы все приготовилось идеально."
                            }
                        },
                        {
                            "text": "By introducing a <w>stagger</w> in the release dates, they managed the high demand.",
                            "target_lang_translations": {
                                "ru": "Введя <w>интервалы</w> между датами выпуска, они справились с высоким спросом."
                            }
                        }
                    ],
                    "synonyms": [
                        "interval",
                        "spacing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположение или распределение действий, событий или объектов во времени или пространстве с интервалами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интервал",
                                "target_lang_sense_clarification": "промежуток времени или пространства"
                            },
                            {
                                "target_lang_word": "шахматный порядок",
                                "target_lang_sense_clarification": "расположение со смещением"
                            },
                            {
                                "target_lang_word": "чередование",
                                "target_lang_sense_clarification": "последовательность с интервалами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}