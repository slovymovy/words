                                "target_lang_sense_clarification": "существительное, группа из ста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "百",
                                "target_lang_sense_clarification": "数字100"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a5422b4-0c2e-3da9-a6eb-b9f55dba5f5b",
                    "sense_definition": "The word used to pronounce the double zero indicating exact hours in the twenty-four-hour clock system.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time_pronunciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The briefing is scheduled to begin at fifteen <w>hundred</w> hours.",
