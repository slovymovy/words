                        "entry_id": "def6a650-ce1d-38a2-a86d-2931432e202c",
                        "glosses": [
                            "Décharge de pistolets ; échange de coups de pistolets."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "ee58f6be-f937-4ee8-86f8-7871e4cf8ab6",
                                "sense_id": "d3568bff-de30-3a16-adc3-92bc948b1fd3",
                                "text": "Déplaire est mon plaisir. J’aime qu’on me haïsse.\nMon cher, si tu savais comme l’on marche mieux\nSous la pistolétade excitante des yeux !"
                            },
                            {
                                "example_id": "2c96f382-619b-4c98-a602-5901589ad3c9",
                                "sense_id": "d3568bff-de30-3a16-adc3-92bc948b1fd3",
                                "text": "Le meunier […] vous envoie par-dessus les ridelles une pistolétade nourrie."
                            },
                            {
                                "example_id": "71a807b3-a38e-4220-84dc-5930258f12b2",
                                "sense_id": "d3568bff-de30-3a16-adc3-92bc948b1fd3",
                                "text": "Vociférant, éructant, de plus en plus veule et hardi à mesure que l’autre s’écrase, il exécute l’archiviste sous la pistolétade excitante des yeux d’Odette."
                            }
                        ]
                    }
