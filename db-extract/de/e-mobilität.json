                    {
                        "sense_id": "78ea01c8-e072-3a37-8720-d0cd16de91b2",
                        "entry_id": "eadc42d3-91e4-3973-9cba-d8c585f1570e",
                        "glosses": [
                            "Teil des Verkehrs, bei dem Elektrofahrzeuge eingesetzt werden"
                        ],
                        "tags": [
                            "Transport"
                        ],
                        "examples": [
                            {
                                "example_id": "baef3756-d0bb-4697-8a7a-0160460affc9",
                                "sense_id": "78ea01c8-e072-3a37-8720-d0cd16de91b2",
                                "text": "„Bis 2024 will die Kernmarke des weltgrößten Autobauers wie schon bekannt 11 Milliarden Euro in den Ausbau der E-Mobilität stecken, konzernweit sind es 33 Milliarden Euro.“"
                            },
                            {
                                "example_id": "6fdf0ac1-69bd-4400-8ffb-14267fa982dd",
                                "sense_id": "78ea01c8-e072-3a37-8720-d0cd16de91b2",
                                "text": "„In Summe will der Volkswagen-Konzern mit seinen dreizehn Marken über die nächsten fünf Jahre rund 60 Milliarden Euro investieren, davon entfallen rund 33 Milliarden Euro auf die E-Mobilität.“"
                            },
                            {
                                "example_id": "e067ab71-a4ea-4e1b-a42a-ae4ffc2fdf75",
                                "sense_id": "78ea01c8-e072-3a37-8720-d0cd16de91b2",
                                "text": "„Auf der Me Convention diskutiert Robert Habeck mit dem neuen Daimler-Chef Ola Källenius über Klimaschutz und E-Mobilität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
