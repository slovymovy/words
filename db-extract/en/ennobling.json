                        "entry_id": "a9caae28-3dca-3fc2-9426-0c9ce0300a3f",
                        "glosses": [
                            "An act of making noble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9fc252e-7b6b-486f-9778-e450b96becd5",
                                "sense_id": "f021fbca-649e-37f0-af12-29e27a3eefa9",
                                "text": "They may think to improve the Scripture; but by their ennoblings they debase it, by their enrichings they impoverish it, by their enlargings they contract it."
                            }
                        ]
                    }
                ],
