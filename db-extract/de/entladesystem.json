                ],
                "senses": [
                    {
                        "sense_id": "6cf2fff1-7a9e-34a3-a2c7-b04b6dea8926",
                        "entry_id": "7045c8c8-d5b2-3058-bba7-67e0525f6ee6",
                        "glosses": [
                            "technisches System zur Beseitigung von elektrostatischer Aufladung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2747bba4-a258-46b2-ad72-f4348c7ef1fe",
                                "sense_id": "6cf2fff1-7a9e-34a3-a2c7-b04b6dea8926",
                                "text": "„Entladesysteme beseitigen elektrostatischer Ladungen und ermöglichen die berührungslose Abreinigung elektrostatisch anhaftender Partikel auf Objekten wie beispielsweise Folien, Glas, Papier, Karton, Textilien und vielen mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b541b61-5fcd-31d4-8ead-e104c9810d3b",
                        "entry_id": "7045c8c8-d5b2-3058-bba7-67e0525f6ee6",
                        "glosses": [
                            "maschinelle Logistikeinheit zum Transport und Konfektionierung von Waren"
                        ],
                        "tags": [
                            "Logistik"
                        ],
                        "examples": [
                            {
                                "example_id": "8d7c78c7-e1fa-4ef7-9919-1463443ad1bb",
                                "sense_id": "3b541b61-5fcd-31d4-8ead-e104c9810d3b",
                                "text": "„[…] Realisierung eines neuen universellen hochflexiblen roboter- und sensorgestützten Entladesystem, welches für obige Logistikaufgaben in der Produktion und im Service geeignet ist.“"
                            },
                            {
                                "example_id": "6d8c97fb-88ba-4a6b-81fe-5a0aca119e8b",
                                "sense_id": "3b541b61-5fcd-31d4-8ead-e104c9810d3b",
                                "text": "„Das CargoMatic automatische Be- und Entladesystem wird eingesetzt für das vollautomatische Beladen und Entladen von Paletten und verpackten Materialien und wird verwendet in Lastzügen, Trailern, Aufliegern und Fabriken.“"
                            },
                            {
                                "example_id": "df972efc-9f60-4771-9ad2-4aae1a073674",
                                "sense_id": "3b541b61-5fcd-31d4-8ead-e104c9810d3b",
                                "text": "„Das automatische Belade-/Entladesystem reduziert den Zeitaufwand für die manuelle Handhabung der Platten um mehr als 80 % und bietet eine effiziente Bearbeitung von Materialien bis zu 3,5 mm Stärke.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5444a4e2-ae2b-3426-be2f-242be40c39ce",
                        "entry_id": "7045c8c8-d5b2-3058-bba7-67e0525f6ee6",
                        "glosses": [
                            "großtechnische Leerung, durch Stülpen, von Silo´s und Bahnbehältern"
                        ],
                        "tags": [
                            "Anlagentechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "4edf6f70-89c5-4cb3-a0ef-28bd17d1f2fb",
                                "sense_id": "5444a4e2-ae2b-3426-be2f-242be40c39ce",
                                "text": "„Der Transport von Schüttgütern erfolgt aus Kostengründen, sowie aus Gründen der Umweltverträglichkeit, vermehrt in Silowagen per Bahn. […] Bahnwagen – Entladesystem“"
                            },
                            {
                                "example_id": "cd45ca49-7adf-4525-aba6-00ba4a5199c9",
                                "sense_id": "5444a4e2-ae2b-3426-be2f-242be40c39ce",
                                "text": "„Automatisches Entladesystem zur gleichzeitigen Entladung mehrerer Eisenbahn-Kesselwagen mit Domanschluß.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
