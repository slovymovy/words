                "senses": [
                    {
                        "sense_id": "2a7bc61a-6c52-3ead-9dbf-97aa9a18b3bc",
                        "entry_id": "c5e9131c-7184-33c8-81b2-592ecae0027d",
                        "glosses": [
                            "lekkernij bestaande uit een hoeveelheid gesponnen suiker aan een stokje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f7c1d3-69ac-4a29-9717-3c53611542df",
                                "sense_id": "2a7bc61a-6c52-3ead-9dbf-97aa9a18b3bc",
                                "text": "De kinderen kwamen in grote aantallen een suikerspin kopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdc64050-a49d-36df-9e39-63be582f6b1a",
                        "entry_id": "c5e9131c-7184-33c8-81b2-592ecae0027d",
                        "glosses": [
                            "bepaald kegelvormig dameskapsel, in vorm gelijkend op de onder [1] genoemde lekkernij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d5f75a-9fa5-446b-8f16-30bf1236adfe",
                                "sense_id": "bdc64050-a49d-36df-9e39-63be582f6b1a",
                                "text": "Grayson grinnikte. 'Je bedoelt de suikerspin die je vróéger had. Ik ben blij dat ze je zo goed opgeleid heeft.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e2cc708-b03b-41e1-827b-00a0a33224d2",
                        "source_entry_id": "c5e9131c-7184-33c8-81b2-592ecae0027d",
                        "source_sense_id": "2a7bc61a-6c52-3ead-9dbf-97aa9a18b3bc",
                        "source_sense_description": "lekkernij bestaande uit een hoeveelheid gesponnen suiker aan een stokje",
                        "target_lang_word": "Zuckerwatte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuckerwatte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38d57580-a4bc-32ef-a46a-1cedee61e261",
                                        "entry_id": "fe09af7e-bacb-323d-b5c0-a117715f8c2c",
                                        "glosses": [
                                            "Süßware, die aus zu Fäden gesponnenem Zucker besteht und vor allem auf Jahrmärkten verkauft wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3156d3b2-bbe0-4150-9792-54373861fe98",
                                                "sense_id": "38d57580-a4bc-32ef-a46a-1cedee61e261",
                                                "text": "Kinder essen gerne Zuckerwatte."
                                            },
                                            {
                                                "example_id": "3ccc0114-2517-4bbd-b3f2-ef28456bf977",
                                                "sense_id": "38d57580-a4bc-32ef-a46a-1cedee61e261",
                                                "text": "„In die Weihnachtslieder mischten sich die Düfte von Rotwein, Zimt, Nelken, Lorbeer, von heißem Fett, Currywürsten, Pommes, von kandierten Äpfeln, gerösteten Mandeln und Zuckerwatte.“"
                                            },
                                            {
                                                "example_id": "d8d0cf06-baf8-43e7-9b0e-f82130844d35",
                                                "sense_id": "38d57580-a4bc-32ef-a46a-1cedee61e261",
                                                "text": "„Auf dem Schützenfest kriegten wir Zuckerwatte.“"
                                            },
                                            {
                                                "example_id": "c90a1d8e-ea01-4adc-9bf1-9684ff5dc6d3",
                                                "sense_id": "38d57580-a4bc-32ef-a46a-1cedee61e261",
                                                "text": "«Für die Kinder gibt es nichts Schöneres als Spielzeuge und Schleckwaren. Ausgerüstet mit ihren Glaces und Zuckerwatten stürmen sie das Karussell, die Hüpfburg und den Autoscooter.»"
                                            },
                                            {
                                                "example_id": "ce5ab2b8-4e09-4a3a-b1e2-0202ba706779",
                                                "sense_id": "38d57580-a4bc-32ef-a46a-1cedee61e261",
                                                "text": "„Sylvia schob sich eine Handvoll Zuckerwatte in den Mund, um nicht noch mehr zu sagen oder allzu breit zu lächeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
