                "senses": [
                    {
                        "sense_id": "ec6cf13e-052b-3671-a041-fbc2a38f48b0",
                        "entry_id": "371d87b5-5e84-32ed-a333-b1c00a613e4d",
                        "glosses": [
                            "zu den verschiedenen Toponymen namens Niederberg, sich auf dieses Toponym Niederberg beziehend, in der Art und Weise dieses Ortes Niederberg, aus Niederberg kommend, stammend, Niederberg betreffend, zu Niederberg gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07cfbf2f-44ba-4ba5-8db3-a1592ec8372b",
                                "sense_id": "ec6cf13e-052b-3671-a041-fbc2a38f48b0",
                                "text": "„Dasselbe sollte die Niederberger Höhe, so wie das auf dieser zu erbauende Kronwerk, im Rücken beschießen können und eine neue (vierte) Enceinte bilden, die der Feind zu nehmen genöthigt war, wenn er das Kronwerk angreifen wollte.“"
                            },
                            {
                                "example_id": "d9c2f1fc-31c1-4d82-a024-a4dd6e1f80cb",
                                "sense_id": "ec6cf13e-052b-3671-a041-fbc2a38f48b0",
                                "text": "„Auf der Niederberger Höhe werden zehn große Mehrfamilienhäuser mit insgesamt 200 Wohnungen grundlegend modernisiert.“"
                            },
                            {
                                "example_id": "8959136a-45b5-46ea-ab4a-da31647aa208",
                                "sense_id": "ec6cf13e-052b-3671-a041-fbc2a38f48b0",
                                "text": "„Auf der Jahreshauptversammlung am 23. Mai haben die Niederberger Christdemokraten einen neuen Vorstand gewählt.“"
                            },
                            {
                                "example_id": "7785c653-c596-42b1-a65b-6fb01c115ca1",
                                "sense_id": "ec6cf13e-052b-3671-a041-fbc2a38f48b0",
                                "text": "„Bis in die 1990er Jahre war die Niederberger Fritsch-Kaserne ein bedeutender Bundeswehr-Stützpunkt mit Panzereinheiten, einem Fernmeldebataillon und einem Mannschaftsheim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
