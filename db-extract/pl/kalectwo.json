                        "source_sense_id": "f76ab823-5b83-3d0a-8d31-c043b896870f",
                        "target_lang_word": "infirmité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infirmité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a1d698-6dd7-3eb4-aa06-c58cc6906e12",
                                        "entry_id": "896aa4eb-7615-3494-856d-a581f16a0602",
                                        "glosses": [
                                            "Affection congénitale ou accidentelle qui gêne ou empêche le fonctionnement de telle ou telle partie de l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01e398d9-4157-4c43-ad5b-3b2e2602488e",
                                                "sense_id": "b8a1d698-6dd7-3eb4-aa06-c58cc6906e12",
                                                "text": "Et le docteur Béritens conclut que le Gréco, loin d'être un exalté ou un fou, était un astigmate atteint de strabisme. S'il avait vécu de nos jours, il serait passé chez l’oculiste et, son infirmité corrigée, aurait ensuite peint ses tableaux normalement."
                                            },
                                            {
                                                "example_id": "2d588974-2ee8-4f97-85ca-48f0c5d6bb4c",
                                                "sense_id": "b8a1d698-6dd7-3eb4-aa06-c58cc6906e12",
                                                "text": "La surdité, la claudication sont des infirmités. Par extension,"
                                            },
                                            {
                                                "example_id": "e4eef6e6-897f-4858-bd88-796674fa2473",
                                                "sense_id": "b8a1d698-6dd7-3eb4-aa06-c58cc6906e12",
                                                "text": "Les infirmités de l’âge, de la vieillesse, Affaiblissement de l’organisme qu’amènent l’âge, la vieillesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d85e992a-444c-3e9f-8f2f-95ddb1cebd25",
                                        "entry_id": "896aa4eb-7615-3494-856d-a581f16a0602",
                                        "glosses": [
                                            "D’une manière plus générale, tant au propre qu’au figuré, imperfection naturelle, défaut de force, faiblesse, fragilité pour le bien, défaut, imperfection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c91a1ec8-960e-4638-b0c5-3a0b7c4b38f4",
                                                "sense_id": "d85e992a-444c-3e9f-8f2f-95ddb1cebd25",
                                                "text": "L’infirmité humaine."
                                            },
                                            {
                                                "example_id": "dc5ed65c-0796-4a1c-8b12-2c4ea63d4a06",
                                                "sense_id": "d85e992a-444c-3e9f-8f2f-95ddb1cebd25",
                                                "text": "C’est une infirmité d’esprit que de ne pas vouloir reconnaître le mérite."
                                            },
                                            {
                                                "example_id": "11be924c-60ec-4909-a7e4-06edce07570a",
