                "senses": [
                    {
                        "sense_id": "6782786a-4814-39cc-8113-bca6b4d6f7a2",
                        "entry_id": "8b183684-419d-3060-8d8c-b06cd8a2c0f3",
                        "glosses": [
                            "A curse, a malediction."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "65664d32-78c6-4f3f-81c5-a7ffd1f0f54a",
                                "sense_id": "6782786a-4814-39cc-8113-bca6b4d6f7a2",
                                "text": "A hide of land I give to thee in my steads of Walbrugham, from me and mine to thee and thine aye and for ever; and God’s malison on his head who this gainsays!"
                            },
                            {
                                "example_id": "0b185dc0-a59b-4c68-ac19-e7ea65d7e902",
                                "sense_id": "6782786a-4814-39cc-8113-bca6b4d6f7a2",
                                "text": "Rascality male and female is prowling in view of him. His fasting stomach is, with good cause, sour; he perhaps cannot forbear a passing malison on them; least of all can he forbear answering such."
                            }
                        ]
                    }
                ],
