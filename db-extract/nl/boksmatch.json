                        ],
                        "examples": [
                            {
                                "example_id": "3b828303-dd43-4592-8b68-a3417e294e86",
                                "sense_id": "3207550e-a870-38d8-a663-0af80f2da7fa",
                                "text": "Anders dan in het verleden zoekt hij niet meer de confrontatie, maar de dialoog. “Er komen geen boksmatchen meer. De voorbije twee jaar hebben mij veranderd. De scherpe kanten zijn er afgerond”, aldus Verhofstadt zaterdag in het Gentse casino."
                            }
