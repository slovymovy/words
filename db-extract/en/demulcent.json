                        ],
                        "form": "more demulcent"
                    },
                    {
                        "form_id": "5ab95191-746c-4516-9f31-a06b21a167ef",
                        "entry_id": "31547aa2-62ce-399a-b564-55b68e6605f5",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most demulcent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81630f91-6cc9-3cbd-b985-2a5d824bc21f",
                        "entry_id": "31547aa2-62ce-399a-b564-55b68e6605f5",
                        "glosses": [
                            "Soothing or softening."
                        ],
                        "tags": [
                            "also",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "20bef787-b718-43a4-9921-aca3c53b2709",
                                "sense_id": "81630f91-6cc9-3cbd-b985-2a5d824bc21f",
                                "text": "In continual hectic Heats, and if the ſweet Juices, by a continued ſlow Fever, acquire a ſaltiſh alcaline Acrimony, Cream and new Butter, on Account of their demulcent Qualities, are found to produce excellent Effects."
                            },
                            {
                                "example_id": "e8f1e9d3-90e6-4672-98f8-a86f20ecc124",
                                "sense_id": "81630f91-6cc9-3cbd-b985-2a5d824bc21f",
                                "text": "Twenty leeches were ordered to be applied round the nose every two days; frequent emollient fomentations; the local vapour bath; general bathing; stimulating pedilavia; a strict regimen; vegetables, milk, white meats; demulcent or acidulated drinks; avoidance of exposure to the sun or to cold air; flannel waistcoat and trousers. This treatment, being strictly observed for two months, caused all the inflammatory symptoms to disappear, […]"
                            },
                            {
                                "example_id": "6ca17f56-5552-41af-bf11-0c5ec3c7b24e",
                                "sense_id": "81630f91-6cc9-3cbd-b985-2a5d824bc21f",
                                "text": "I channel vertically under the sheet to hide my blushing neck, muttering demulcent nothings."
                            },
                            {
                                "example_id": "af039dbb-fddc-4120-95cc-3da35784380e",
                                "sense_id": "81630f91-6cc9-3cbd-b985-2a5d824bc21f",
                                "text": "Expectorants may have a demulcent (soothing and irritation-allaying) effect on the cells of the respiratory tract and assist in repelling invasion through providing a medium for the upward propulsion of foreign particles by ciliary action."
                            },
                            {
                                "example_id": "447b850e-9f12-495f-b147-f25ef5d010e0",
                                "sense_id": "81630f91-6cc9-3cbd-b985-2a5d824bc21f",
                                "text": "And like many of us, Dr. Ed filled those 5–10 'extra minutes' a day with some unchallenging, often demulcent reading material."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c99fed7-639c-4a29-afb4-dc14e0a8820a",
                        "source_entry_id": "31547aa2-62ce-399a-b564-55b68e6605f5",
                        "source_sense_id": "81630f91-6cc9-3cbd-b985-2a5d824bc21f",
