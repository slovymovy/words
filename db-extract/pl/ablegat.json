                                        "sense_id": "51cbe8da-51dc-38c6-927f-945ec312eb13",
                                        "entry_id": "292fc47e-c9f8-31ef-9978-9edeaaff370f",
                                        "glosses": [
                                            "Person, die verbannt wurde"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d60acfb-fd3c-4f29-9607-ec7bbe85ef8e",
                                                "sense_id": "51cbe8da-51dc-38c6-927f-945ec312eb13",
                                                "text": "Jetzt war er ganz allein, ein Ablegat in einem fremden Land."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "857af118-e29b-35c5-918b-cc94817bde2d",
                                        "entry_id": "292fc47e-c9f8-31ef-9978-9edeaaff370f",
                                        "glosses": [
                                            "Stellvertreter eines Magnaten im ungarischen Reichstag"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd695976-3dd9-47d9-883e-129d6fd51f55",
                                                "sense_id": "857af118-e29b-35c5-918b-cc94817bde2d",
                                                "text": "„Die Ablegaten der abwesenden Barone und Magnaten, auch die der grundbesitzenden Frauen sitzen an der Ständetafel, hinter den Deputierten der Komitate und der Domkapitel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
