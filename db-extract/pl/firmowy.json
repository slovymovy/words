                "senses": [
                    {
                        "sense_id": "aa279838-6f8e-3e32-8bbb-b9f31911bb47",
                        "entry_id": "97967b96-103a-3628-8f29-6afe987ee9dd",
                        "glosses": [
                            "związany z firmą, dotyczący firmy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b182235c-f204-4540-8a3b-bcf907c61dff",
                                "sense_id": "aa279838-6f8e-3e32-8bbb-b9f31911bb47",
                                "text": "Utrudnił mu określenie brak znaku firmowego, co się przy naczyniach Amphory często zdarza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "864e8fbc-f9b0-4544-ac8b-905b1721906d",
                        "source_entry_id": "97967b96-103a-3628-8f29-6afe987ee9dd",
                        "source_sense_id": "aa279838-6f8e-3e32-8bbb-b9f31911bb47",
                        "target_lang_word": "фирменный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фирменный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79704b5e-16bd-3429-8a86-b6a4a0a96ea2",
                                        "entry_id": "869d10a2-0057-38a7-be48-b94da20ee3f5",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным фирма"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dda87186-752c-3aa1-9b87-a72b14e3da3e",
                                        "entry_id": "869d10a2-0057-38a7-be48-b94da20ee3f5",
                                        "glosses": [
                                            "свойственный или принадлежащий фирме, организации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d72de67-2402-41e7-a80b-c4a132359cbf",
                                                "sense_id": "dda87186-752c-3aa1-9b87-a72b14e3da3e",
                                                "text": "Фирменный логотип приобрел почти мистическое свойство превращать практически любую вещь в одежду, достойную носки."
                                            },
                                            {
                                                "example_id": "f901b8cf-a76e-4fdf-a6ba-8798ffda7771",
                                                "sense_id": "dda87186-752c-3aa1-9b87-a72b14e3da3e",
                                                "text": "Но главная фирменная черта журнала ― профессиональная, хладнокровная критика."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "587ad38d-399e-33d9-9ea4-7464e3cd8789",
                                        "entry_id": "869d10a2-0057-38a7-be48-b94da20ee3f5",
                                        "glosses": [
                                            "произведённый, осуществлённый, предоставляемый или организованный фирмой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72bc2e88-3288-45bc-a4b5-3926d9deaf5d",
                                                "sense_id": "587ad38d-399e-33d9-9ea4-7464e3cd8789",
                                                "text": "Фирменный замок мягко защёлкнулся."
                                            },
                                            {
                                                "example_id": "7471cd47-654e-4fae-8d56-cf8b2a59f1ab",
                                                "sense_id": "587ad38d-399e-33d9-9ea4-7464e3cd8789",
                                                "text": "Однако шведская компания подчеркивает фирменную настройку практически всех агрегатов и использование собственных систем управления двигателем и трансмиссией."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4db68dc3-34f6-34a9-9c0c-9dae51add113",
                                        "entry_id": "869d10a2-0057-38a7-be48-b94da20ee3f5",
                                        "glosses": [
                                            "перен. предполагающий высокое качество товара или изделия, гарантированное репутацией фирмы-производителя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e6620a-e6bb-4c63-804c-7d2b0942427d",
                                                "sense_id": "4db68dc3-34f6-34a9-9c0c-9dae51add113",
                                                "text": "Фирменные очки его вдруг поблёкли, подбородок заострился и пожелтел."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cd96193-3f82-3050-8335-9fdb58da4fe6",
                                        "entry_id": "869d10a2-0057-38a7-be48-b94da20ee3f5",
                                        "glosses": [
                                            "перен., разг. отличающийся высоким качеством; превосходный, отличный"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
