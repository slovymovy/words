                ],
                "senses": [
                    {
                        "sense_id": "0a1e2c1e-79ec-3e6b-b3b9-1088fb2d3143",
                        "entry_id": "73aa8b03-cf10-3ca0-9761-3c889c4d36e3",
                        "glosses": [
                            "Faire perdre son caractère baroque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fed0c12-497e-466f-8623-4dee91d85167",
                                "sense_id": "0a1e2c1e-79ec-3e6b-b3b9-1088fb2d3143",
                                "text": "Il a enfin massivement débaroquisé les églises romanes surchargées au XVII-XVIIIᵉ siècle d’angelots, de gypseries tarabiscotées, de peintures édifiantes."
                            },
                            {
                                "example_id": "1b2191c4-b95d-4340-9df4-16e8c5f84808",
                                "sense_id": "0a1e2c1e-79ec-3e6b-b3b9-1088fb2d3143",
                                "text": "Accommodée au goût du XVIIᵉ siècle puis fort lourdement « débaroquisée » au XIXᵉ (peintures décoratives, revêtements de faux-marbre), l’unique église gothique de Rome semble aujourd’hui un mauvais pastiche."
                            },
                            {
                                "example_id": "dae2ab86-c19a-4b43-b30c-fd4c92c3f53b",
                                "sense_id": "0a1e2c1e-79ec-3e6b-b3b9-1088fb2d3143",
                                "text": "Il n’est certes pas le premier pianiste à aborder la musique de Bach avec une volonté d’universaliser, de débaroquiser une partition aussi fondamentale que Le Clavier bien tempéré."
                            }
                        ]
                    }
                ],
