                                "target_senses": [
                                    {
                                        "sense_id": "641faaa2-637b-305f-be89-ba0702e441dc",
                                        "entry_id": "22a29870-50fb-3fb0-8b18-34bd91893297",
                                        "glosses": [
                                            "Person der Kirchengeschichte, die die Reformation befördert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebbdbef2-f378-482a-b444-f95e932e629b",
                                                "sense_id": "641faaa2-637b-305f-be89-ba0702e441dc",
                                                "text": "„Zwei Gefahren sah der Reformator in den Schreibschulen…“"
                                            },
                                            {
                                                "example_id": "c7335a0a-617f-4582-953f-f4df873a0a6e",
                                                "sense_id": "641faaa2-637b-305f-be89-ba0702e441dc",
                                                "text": "„Hier schuf der Reformator sein sprachliches Meisterwerk, das neben der großen theologischen Bedeutung, die ihm zukommt, auch die deutsche Sprache und ihre Entwicklung stark beeinflusst hat: die Übersetzung des Neunen Testaments.“"
                                            },
                                            {
                                                "example_id": "11a736b2-b863-4e41-b87c-dd4b2126f94f",
                                                "sense_id": "641faaa2-637b-305f-be89-ba0702e441dc",
                                                "text": "„Einer der Geldgeber der Stolbergs war Hans Luder, der Vater des Reformators.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
