                "senses": [
                    {
                        "sense_id": "001903d3-9056-3781-a6e7-36bfe6df6c59",
                        "entry_id": "a86bd72d-33de-3e46-9eb6-14e93313c9ad",
                        "glosses": [
                            "woonplaats voor asielzoekers zonder verblijfsvergunning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de21a386-39af-4b35-a2c2-30d7786996b7",
                                "sense_id": "001903d3-9056-3781-a6e7-36bfe6df6c59",
                                "text": "De familie Grigoryan is al negen jaar in Nederland en heeft altijd in asielzoekerscentra gezeten. De kinderen van acht, vijf en drie jaar oud zijn hier geboren. Hun asielverzoeken zijn steeds afgewezen."
                            },
                            {
                                "example_id": "42d11957-96cf-4bfe-8213-6ee5a3ef5844",
                                "sense_id": "001903d3-9056-3781-a6e7-36bfe6df6c59",
                                "text": "Als de asielprocedure is voltooid gaan mensen uit het asielzoekerscentrum naar een eigen woning of het land uit."
                            },
                            {
                                "example_id": "5cba02ab-6f54-42d5-8993-17e60b521c90",
                                "sense_id": "001903d3-9056-3781-a6e7-36bfe6df6c59",
                                "text": "Het kabinet trekt de vergunningverlening voor een asielzoekerscentrum in de Overijsselse plaats Albergen naar zich toe. Daarmee passeert het kabinet de gemeente Tubbergen, waar Albergen ligt."
                            }
                        ]
                    }
