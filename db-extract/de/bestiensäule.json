                "senses": [
                    {
                        "sense_id": "834f6e40-0565-3e3d-b9bb-eb340938596e",
                        "entry_id": "f8c47501-7370-3bf8-bd01-85999a74a21f",
                        "glosses": [
                            "freistehende Säule in romanischen Bauwerken, deren Schaft von plastisch herausgearbeiteten miteinander kämpfenden Figuren (Tiere, Fabelwesen, Menschen) vollständig bedeckt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8bd9573-3c25-4ea8-a2fe-d7ca6de06249",
                                "sense_id": "834f6e40-0565-3e3d-b9bb-eb340938596e",
                                "text": "„Eine Bestiensäule ist eine Säule mit einer plastischen Darstellung kämpfender Menschen und Tiere auf dem Säulenschaft.“"
                            },
                            {
                                "example_id": "02e26778-e045-4074-af01-5b4861ff0249",
                                "sense_id": "834f6e40-0565-3e3d-b9bb-eb340938596e",
                                "text": "„Die Bestiensäule in der Krypta des Freisinger Doms wurde um 1160 von einem unbekannten Steinmetz errichtet.“"
                            },
                            {
                                "example_id": "3b38178d-ce1c-4df9-9c16-b1f080345a50",
                                "sense_id": "834f6e40-0565-3e3d-b9bb-eb340938596e",
                                "text": "„In diesem Zusammenhang sei auch auf die ‚Bestiensäulen‘ verwiesen, Steinmetzarbeiten aus romanischer Zeit, die eine Fülle von phantasievoll gestalteten Untieren zeigen, die Menschen wie auch sich selbst verschlingen (das schönste Beispiel in Freising).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
