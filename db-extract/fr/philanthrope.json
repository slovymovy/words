                                            {
                                                "example_id": "f4e35439-4054-4187-9c0a-87a71fcdf46b",
                                                "sense_id": "c7723a73-0267-35c1-8aa2-82dccb92876b",
                                                "text": "No outro lado da sala, Bernard Schwartz, presidente da Loral Space and Communications, e Lewis Cullman, um filantropo de 87 anos, conversavam."
