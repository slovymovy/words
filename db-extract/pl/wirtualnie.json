                                                "sense_id": "2dd47bc8-a57b-34d4-aedb-7432672a2d27",
                                                "text": "Durch diese virtuelle 3D-Grafik können Sie bereits das fertige Gebäude betrachten."
                                            },
                                            {
                                                "example_id": "ddbe79aa-0241-4191-85ea-c9f20831af5c",
                                                "sense_id": "2dd47bc8-a57b-34d4-aedb-7432672a2d27",
                                                "text": "Schauen Sie in unseren virtuellen Semesterapparat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5790445b-d489-302b-8276-713524eed49a",
                                        "entry_id": "42f2e5b5-5743-3dfe-84a7-afc503fd84ec",
                                        "glosses": [
                                            "nur theoretisch existent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da132c7-6643-48d5-8b13-53f5e93574c0",
                                                "sense_id": "5790445b-d489-302b-8276-713524eed49a",
                                                "text": "Bei der Brechung an der Linse entstehen ein virtuelles und ein reelles Bild."
                                            },
                                            {
                                                "example_id": "a71d656e-fa4e-4dc1-a92c-ed1b68235734",
                                                "sense_id": "5790445b-d489-302b-8276-713524eed49a",
                                                "text": "… dort sind die Längen- und Breitenkreise nur gedacht, oder wie man auch sagt, virtuell."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a3aaf027-04f1-3436-848d-4d7f16010cf5",
                                        "entry_id": "42f2e5b5-5743-3dfe-84a7-afc503fd84ec",
                                        "glosses": [
                                            "durch Computer vermittelt, nicht in der physischen Welt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b192acf-7e8a-4710-9a27-1b55c6c4f9b6",
                                                "sense_id": "a3aaf027-04f1-3436-848d-4d7f16010cf5",
                                                "text": "Schauen Sie in unseren virtuellen Semesterapparat."
                                            },
                                            {
                                                "example_id": "a8dee79d-0845-4477-9c22-bb95eb3e8913",
                                                "sense_id": "a3aaf027-04f1-3436-848d-4d7f16010cf5",
                                                "text": "Der Unterricht kann wegen der Coronakrise nur virtuell stattfinden."
                                            }
                                        ],
