                        "glosses": [
                            "Que l’on peut embaucher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b68becd-3eac-4477-a56c-9e681e9520ec",
                                "sense_id": "8e34ba7f-4f35-353a-a2d1-23341238af33",
                                "text": "\"Vous avez déjà vu des personnes obèses dans les grandes écoles”, s’interroge l’auteure de On ne naît pas grosse. Avant de lâcher : “L’obèse n’est pas embauchable parce qu’il est jugé fainéant !”."
                            },
                            {
                                "example_id": "58a06512-d9ff-48be-bd34-280741a8ac4b",
                                "sense_id": "8e34ba7f-4f35-353a-a2d1-23341238af33",
                                "text": "Fin mai, il y retourne pour une dernière formalité, valider la formation continue obligatoire, qui le rendra directement embauchable."
                            },
                            {
                                "example_id": "4a596e46-5f04-42fa-afe2-396b96f743f7",
                                "sense_id": "8e34ba7f-4f35-353a-a2d1-23341238af33",
                                "text": "Tout compagnon est embauchable lorsqu’il possède quatre ou cinq robes, atteste qu’il a fini son apprentissage et prouve qu’il sait travailler."
                            }
                        ]
                    }
