                "senses": [
                    {
                        "sense_id": "1dc6ad3f-9c64-3514-b090-e2531d138a8d",
                        "entry_id": "285dd218-ea3e-337f-80d5-aede92f20d0e",
                        "glosses": [
                            "Person, die an einer Party teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c1caf0-e2b6-4240-9535-3c22e1f0117a",
                                "sense_id": "1dc6ad3f-9c64-3514-b090-e2531d138a8d",
                                "text": "Der Veranstalter rechnet mit mehreren hundert Partygästen."
                            },
                            {
                                "example_id": "347b720a-90cb-4900-8983-c8df8b10bcab",
                                "sense_id": "1dc6ad3f-9c64-3514-b090-e2531d138a8d",
                                "text": "„Die Partygäste drängten sich uns entgegen, eingehüllt in eine Wolke aus Zigaretten, Rasierwasser, Deo, Parfüm.“"
                            },
                            {
                                "example_id": "d65c4337-a82b-44ad-b838-3188fcb5ca8c",
                                "sense_id": "1dc6ad3f-9c64-3514-b090-e2531d138a8d",
                                "text": "„Insgeheim verstand ein jeder der Partygäste, worum es ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
