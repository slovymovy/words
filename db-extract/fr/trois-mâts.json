        "fr-extract.jsonl": [
            {
                "entry_id": "466c0085-ee0f-3216-886a-5fdb1a82ef84",
                "word": "trois-mâts",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7cfa9913-1d46-3545-8ca0-5524032404bb",
                        "entry_id": "466c0085-ee0f-3216-886a-5fdb1a82ef84",
                        "glosses": [
                            "Navire à trois mâts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffd9b4f3-823a-41ed-8f76-8d0d004297c0",
                                "sense_id": "7cfa9913-1d46-3545-8ca0-5524032404bb",
                                "text": "L'homme, qui était un garde-côte, comme le faisait voir sa cape d'uniforme, épiait toutes les manœuvres du trois-mâts et semblait en prendre note mentalement."
                            },
                            {
                                "example_id": "ce882032-9245-4e96-acfe-8c43f78eb003",
                                "sense_id": "7cfa9913-1d46-3545-8ca0-5524032404bb",
                                "text": "On reconnaissait en ce bâtiment un long trois-mâts, évidemment un baleinier de New-Arkhangel, […]"
                            },
                            {
                                "example_id": "0b080b65-dbfe-42ce-af32-8d35fa65f399",
                                "sense_id": "7cfa9913-1d46-3545-8ca0-5524032404bb",
                                "text": "Tout dernièrement encore, un trois-mâts français, […], avait rebroussé chemin vers le Costa Rica, où il avait dû être condamné car sa coque était entièrement mangé par les tarets."
                            },
                            {
                                "example_id": "4bff2b74-7575-490f-83dc-edad696c233f",
                                "sense_id": "7cfa9913-1d46-3545-8ca0-5524032404bb",
                                "text": "Les Islandais donnent ainsi une histoire aux fameuses formations rocheuses Reynisdrangar à Vík. Deux trolls auraient essayé de tirer un trois-mâts sur le rivage, mais la lumière du petit matin les surprit, les transformant aussitôt en pierre."
                            },
                            {
                                "example_id": "24dcb4fb-30f7-4755-91f2-194dc06183e2",
                                "sense_id": "7cfa9913-1d46-3545-8ca0-5524032404bb",
                                "text": "T'as vu tes slibars ? On dirait les voiles d'un trois-mâts après une tornade. Et ton odeur de crabe moisi, t'as senti ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5b8ae43-237f-45e0-adb2-a5183dde7e7f",
                        "source_entry_id": "466c0085-ee0f-3216-886a-5fdb1a82ef84",
                        "source_sense_id": "7cfa9913-1d46-3545-8ca0-5524032404bb",
                        "target_lang_word": "Dreimaster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreimaster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "836d441f-ddef-3d78-8488-b4063e456c3a",
                                        "entry_id": "1be4f9bf-c054-3b4e-8be7-e5fdd48e3a99",
                                        "glosses": [
                                            "Segelschiff mit drei Masten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054564af-2d83-43cf-9ace-0b3664e2d3f6",
                                                "sense_id": "836d441f-ddef-3d78-8488-b4063e456c3a",
                                                "text": "„Wer sie zum ersten Mal sieht, ist fasziniert, und ihre Form erklärt, warum die Isländer sich früher erzählten, dass es sich bei den vier Zinnen um einen Dreimaster handelt, der von einer Trollfrau gezogen wird.“"
                                            },
                                            {
                                                "example_id": "0912d2e3-5e81-410b-a17a-2a94687a8abe",
                                                "sense_id": "836d441f-ddef-3d78-8488-b4063e456c3a",
                                                "text": "„Er fuhr mit den Fingern über ein Buddelschiff, das in einem der Bücherregale stand, in der hellblauen Glasflasche war ein Dreimaster ausgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59430fe6-3426-3d6b-bca4-5f5a06bc2994",
                                        "entry_id": "1be4f9bf-c054-3b4e-8be7-e5fdd48e3a99",
                                        "glosses": [
                                            "Kopfbedeckung, bei der die Krempe an drei Stellen hochgeklappt ist, mit der Spitze nach vorne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85903c64-2928-455a-96d0-b9af9408c579",
                                                "sense_id": "59430fe6-3426-3d6b-bca4-5f5a06bc2994",
                                                "text": "„Vornehmlich galt diese Aufmerksamkeit aber doch dem schönen jungen Kaiser Alexander, der die Uniform der Garde zu Pferde und den Dreimaster mit aufgeschlagener Krempe trug, seinem freundlichen Gesicht und seiner klangvollen, nur mässig lauten Stimme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fcf1da6-fda5-4500-96a8-bff5e785af85",
                        "source_entry_id": "466c0085-ee0f-3216-886a-5fdb1a82ef84",
