    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74332eb4-8cfe-3e80-8082-fc574e03555f",
                    "sense_definition": "Plezier beleven aan iets; een aangename ervaring hebben.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij hebben tijdens de vakantie enorm van de zon <w>genoten</w>.",
                            "target_lang_translations": {
                                "en": "We <w>enjoyed</w> the sun immensely during the holiday.",
                                "ru": "Во время отпуска мы очень <w>наслаждались</w> солнцем.",
                                "fr": "Nous avons énormément <w>profité</w> du soleil pendant les vacances."
                            }
                        },
                        {
                            "text": "<w>Geniet</w> van het leven zolang het nog kan.",
                            "target_lang_translations": {
                                "en": "<w>Enjoy</w> life while you still can.",
                                "ru": "<w>Наслаждайся</w> жизнью, пока можешь.",
                                "fr": "<w>Profite</w> de la vie tant que tu le peux encore."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich vermaken",
                        "plezier hebben"
                    ],
                    "antonyms": [
                        "zich vervelen",
                        "balen"
                    ],
                    "common_phrases": [
                        "genieten van",
                        "met volle teugen genieten",
                        "volop genieten"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience pleasure from something; to have a pleasant experience.",
                        "ru": "Испытывать удовольствие от чего-либо; иметь приятный опыт.",
                        "fr": "Éprouver du plaisir à quelque chose ; passer un moment agréable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enjoy",
                                "target_lang_sense_clarification": "to take pleasure in"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "наслаждаться",
                                "target_lang_sense_clarification": "испытывать блаженство или удовольствие"
                            },
                            {
                                "target_lang_word": "получать удовольствие",
                                "target_lang_sense_clarification": "радоваться чему-либо"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "profiter",
                                "target_lang_sense_clarification": "tirer du plaisir de quelque chose (ex. profiter du soleil)"
                            },
                            {
                                "target_lang_word": "apprécier",
                                "target_lang_sense_clarification": "trouver du plaisir à"
                            },
                            {
                                "target_lang_word": "savourer",
                                "target_lang_sense_clarification": "goûter pleinement un plaisir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba6ef695-317d-30a1-8979-d95231222706",
                    "sense_definition": "Het voordeel, gebruik of bezit hebben van iets (vaak abstract, zoals onderwijs, bescherming of aanzien).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "benefit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijfsleven <w>geniet</w> in deze regio vele belastingvoordelen.",
                            "target_lang_translations": {
                                "en": "The business community <w>enjoys</w> many tax benefits in this region.",
                                "ru": "Бизнес в этом регионе <w>пользуется</w> многими налоговыми льготами.",
                                "fr": "Le secteur des affaires <w>bénéficie</w> de nombreux avantages fiscaux dans cette région."
                            }
                        },
                        {
                            "text": "Hij heeft een uitstekende opvoeding <w>genoten</w>.",
                            "target_lang_translations": {
                                "en": "He <w>received</w> an excellent education.",
                                "ru": "Он <w>получил</w> отличное воспитание.",
                                "fr": "Il a <w>reçu</w> une excellente éducation."
                            }
                        }
                    ],
                    "synonyms": [
                        "profiteren",
                        "ontvangen",
                        "bezitten"
                    ],
                    "antonyms": [
                        "ontberen",
                        "missen"
                    ],
                    "common_phrases": [
                        "een opleiding genieten",
                        "bescherming genieten",
                        "de voorkeur genieten",
                        "aanzien genieten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have the benefit, use, or possession of something (often abstract, such as education, protection, or prestige).",
                        "ru": "Иметь преимущество, пользоваться или обладать чем-либо (часто абстрактным, например, образованием, защитой или уважением).",
                        "fr": "Bénéficier de, posséder ou faire usage de quelque chose (souvent abstrait, comme une éducation, une protection ou du prestige)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enjoy",
                                "target_lang_sense_clarification": "to have the use or benefit of (formal)"
                            },
                            {
                                "target_lang_word": "benefit from",
                                "target_lang_sense_clarification": "to receive an advantage from"
                            },
                            {
                                "target_lang_word": "receive",
                                "target_lang_sense_clarification": "to get or undergo (e.g. education)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пользоваться",
                                "target_lang_sense_clarification": "иметь в своем распоряжении (напр. правами, уважением, льготами)"
                            },
                            {
                                "target_lang_word": "получить",
                                "target_lang_sense_clarification": "пройти курс обучения или воспитания"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "jouir de",
                                "target_lang_sense_clarification": "posséder un avantage, un droit ou un privilège"
                            },
                            {
                                "target_lang_word": "bénéficier de",
                                "target_lang_sense_clarification": "tirer un avantage de quelque chose"
                            },
                            {
                                "target_lang_word": "recevoir",
                                "target_lang_sense_clarification": "obtenir ou subir (ex. recevoir une éducation)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}