                            {
                                "example_id": "e0cc53f9-6a25-4098-8d91-af010f5960f5",
                                "sense_id": "f347f488-fda1-3922-8964-beaf051ebf54",
                                "text": "En algèbre, un idéal à droite et à gauche est un idéal bilatère."
                            },
                            {
                                "example_id": "2112c929-cf18-4a9f-9695-973a954a1d59",
                                "sense_id": "f347f488-fda1-3922-8964-beaf051ebf54",
                                "text": "Un intervalle de confiance bilatère comprend des valeurs de part et d'autre du paramètre."
