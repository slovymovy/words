                    {
                        "translation_id": "4fa504d8-4859-4871-8196-626957214877",
                        "source_entry_id": "88b2c243-cb80-3c97-b751-a954531764fa",
                        "source_sense_id": "b380bd4f-6cf6-3fe1-98e0-8bb677f33ee9",
