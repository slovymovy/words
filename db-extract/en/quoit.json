                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee9a3fda-7ae8-4b95-8174-ea260a5c3e74",
                                "sense_id": "8bf3ad92-9031-35b0-8510-da7c49ec4ad5",
                                "text": "Then, to preſerve the Fame of ſuch a deed, / For Python ſlain, he [Phoebus or Apollo] Pythian Games decreed. / Where Noble Youths for Maſterſhip ſhou'd ſtrive, / To Quoit, to Run, and Steeds and Chariots drive."
                            }
                        ]
                    },
                    {
                        "sense_id": "99516861-c6ef-34f9-bb5f-3ed2f7a601cf",
                        "entry_id": "7afb4a61-b1fa-3755-b07d-b2717eb1c30d",
                        "glosses": [
                            "To throw like a quoit."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c8e02b12-28c3-4d6a-b17e-391faf851fec",
                                "sense_id": "99516861-c6ef-34f9-bb5f-3ed2f7a601cf",
                                "text": "Each took / His ſtation, and Epeüs ſeized the clod. / He ſwung, he caſt it, and the Greecians laugh'd. / Leonteus, branch of Mars, quoited it next."
                            }
                        ]
                    }
