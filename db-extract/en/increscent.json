                "translations": [
                    {
                        "translation_id": "eca0e78f-53c3-4c72-9031-2af8a124cd9e",
                        "source_entry_id": "27f5454b-6db2-32b5-9eff-d4ff0db27ad7",
                        "source_sense_id": "e28ba39e-9b5d-3c0d-8a8d-ee191280f0e7",
                        "source_sense_description": "termine araldico",
                        "target_lang_word": "tourné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e3805a8-efc5-3676-b94d-763e7b14ff44",
                                        "entry_id": "ec836476-4933-3c3a-a067-46bf14f76414",
                                        "glosses": [
                                            "Aigri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ba39bf7-aa32-47d8-a7c2-2e5aac66bf9c",
                                                "sense_id": "3e3805a8-efc5-3676-b94d-763e7b14ff44",
                                                "text": "Le lait est tourné."
                                            },
                                            {
                                                "example_id": "fa93cd6c-c93f-41fc-a75d-4843f9d5d969",
                                                "sense_id": "3e3805a8-efc5-3676-b94d-763e7b14ff44",
                                                "text": "Du vin tourné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38990ba8-22fe-3a57-a430-4f3b5bcacb98",
                                        "entry_id": "ec836476-4933-3c3a-a067-46bf14f76414",
                                        "glosses": [
                                            "Bien ou mal fait."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a11adeb-f1d5-4d59-b127-be702d96db24",
                                                "sense_id": "38990ba8-22fe-3a57-a430-4f3b5bcacb98",
                                                "text": "De ceux qu’à votre avis dame Nature a faits\nMoins bien tournés que vous, ne plaisantez jamais :\nCar qui sait si, trouvant profit à leur disgrâce,\nIls ne sortiront pas mieux que vous d’une impasse ?"
                                            },
                                            {
                                                "example_id": "ed734fd4-19f0-4183-b2c6-13b6c568a7f9",
                                                "sense_id": "38990ba8-22fe-3a57-a430-4f3b5bcacb98",
                                                "text": "Marie de Boussac était moins fraîche et moins bien tournée que sa compagne ; mais sans être jolie, elle était infiniment agréable."
                                            },
                                            {
                                                "example_id": "6290008a-d26b-4b4a-a1c4-e5aa39389116",
                                                "sense_id": "38990ba8-22fe-3a57-a430-4f3b5bcacb98",
                                                "text": "– Je crois, en vérité, que je ne suis pas mal tournée. Mais vous savez mieux que moi, Gérard, qu’un corps convenable sans un buste harmonieux, c’est une tranche de beef sans pikles…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d506ba37-8010-34ee-b2db-828a8f4e07ed",
                                        "entry_id": "ec836476-4933-3c3a-a067-46bf14f76414",
                                        "glosses": [
                                            "Droit ou de travers."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e6f636e-6731-4ee2-b2e8-70491e608b7e",
                                                "sense_id": "d506ba37-8010-34ee-b2db-828a8f4e07ed",
                                                "text": "C’est un esprit mal tourné, se dit d’un homme qui prend ordinairement les choses de travers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa5ed203-4899-3d62-9575-508cb48d7cfa",
                                        "entry_id": "ec836476-4933-3c3a-a067-46bf14f76414",
                                        "glosses": [
                                            "Qualifie une protubérance d’un meuble permettant d'indiquer la direction qu’elle a (vers le chef, la pointe, dextre, senestre…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a19a9c7e-e8e4-42cc-9614-5667711a986f",
                                                "sense_id": "fa5ed203-4899-3d62-9575-508cb48d7cfa",
                                                "text": "Écartelé : au premier d’or à un saint d’argent vêtu d’azur et nimbé de gueules, les deux avant-bras tournés vers le chef, adextré de la lettre S et senestré de la lettre I le tout d’argent, au deuxième d’azur à trois monts d’argent rangés en bande et, brochant sur le tout, trois sapins également d’argent et rangés vaguement en bande, au troisième d’azur à une grappe de raisin fruitée, feuillée et tigée d’argent, au quatrième d’or à un dauphin d’azur, crêté, barbé, loré, peautré et oreillé de gueules, qui est de Saint Ismier → voir illustration « bras tournés »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3140758f-7441-39b3-9951-3d05661bd7a1",
                                        "entry_id": "ec836476-4933-3c3a-a067-46bf14f76414",
                                        "glosses": [
                                            "Se dit du croissant ou du chevron quand la pointe est tournée vers dextre ou senestre au lieu de pointer vers le chef comme à l’ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ddbb29-4fdf-47a1-9537-ea5511ccc24f",
                                                "sense_id": "3140758f-7441-39b3-9951-3d05661bd7a1",
                                                "text": "Coupé de gueules et d’azur, au croissant tourné d’argent brochant sur la partition, qui est de Ranspach → voir illustration « croissant tourné »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed6f1783-4028-3ece-b82e-f43e5df01e88",
                                        "entry_id": "ec836476-4933-3c3a-a067-46bf14f76414",
                                        "glosses": [
                                            "Pris à revers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94f64b1-49cf-4e94-b101-5f325e9c73d1",
                                                "sense_id": "ed6f1783-4028-3ece-b82e-f43e5df01e88",
                                                "text": "Il y eut donc un de ces arrêts sinistres si fréquents où chacun faisait l’éternelle question : « Sommes-nous tournés ? » qui fut la grande anxiété militaire en ce temps-là et démoralisa si souvent les plus intrépides."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tourné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a84ff946-83dc-3b60-bd8a-49803e4ee303",
                                        "entry_id": "6ad233c1-b538-3041-aa5a-b28fec430124",
                                        "glosses": [
                                            "Participe passé masculin singulier de tourner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab052147-5dcf-488d-b271-eaf310b70277",
                                                "sense_id": "a84ff946-83dc-3b60-bd8a-49803e4ee303",
                                                "text": "Il balbutia quelques mots, puis tira son couteau de sa poche, un eustache à manche de corne, coupa son pain par le milieu et en mit la moitié sur les genoux de la jeune mère, qui regarda étonnée ; mais il avait déjà tourné le coin de la rue."
                                            },
                                            {
                                                "example_id": "4f170b5a-a80b-4755-a153-4d22a92aee4d",
                                                "sense_id": "a84ff946-83dc-3b60-bd8a-49803e4ee303",
                                                "text": "Depuis une douzaine d’années, un groupe d’universitaires français attachés à l’étude des anciens écrivains grecs chrétiens s’est tourné vers la Septante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
