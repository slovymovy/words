                        "sense_id": "be8d7c50-35e9-3553-8677-199960eae361",
                        "entry_id": "3e68d3c3-c7c3-35cd-b690-b5ea63377569",
                        "glosses": [
                            "État, fonction de précepteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9e310a-37bd-47d8-99e3-66e1e56dae62",
                                "sense_id": "be8d7c50-35e9-3553-8677-199960eae361",
                                "text": "Les devoirs du préceptorat."
                            },
                            {
                                "example_id": "078f7c8f-03f2-4977-a3e0-924d3224e73a",
                                "sense_id": "be8d7c50-35e9-3553-8677-199960eae361",
                                "text": "En novembre 1885, j’acceptai d’entrer comme précepteur chez les Jussat-Bandon. Je vous écrivis alors que je renonçais à mon indépendance afin d’éviter de nouvelles dépenses à ma mère. Il se joignait à cette raison l’espoir secret que les économies réalisées dans ce préceptorat me permettraient, une fois ma licence passée, de préparer mon agrégation à Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "c99e9103-e570-330c-adbd-c18f4cc7d55e",
                        "entry_id": "3e68d3c3-c7c3-35cd-b690-b5ea63377569",
                        "glosses": [
                            "Temps pendant lequel un précepteur exerce sa fonction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811074c1-1e46-4996-995f-0bd7f6c8900d",
                                "sense_id": "c99e9103-e570-330c-adbd-c18f4cc7d55e",
                                "text": "Tout s’est passé pour le mieux pendant votre préceptorat."
                            }
                        ]
                    }
