                                "target_lang_word": "Sohn",
                                "target_lang_sense_clarification": "männliches Kind der Eltern"
                            },
                            {
                                "target_lang_word": "Junge",
                                "target_lang_sense_clarification": "umgangssprachlich für Sohn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2ca654b-a980-350e-a81e-6deed97f4d0c",
                    "sense_definition": "Młody pracownik wykonujący proste prace fizyczne lub pomocnicze.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szef zatrudnił nowego <w>chłopaka</w> do noszenia paczek w magazynie.",
                            "target_lang_translations": {
                                "ru": "Шеф нанял нового <w>парня</w> таскать коробки на складе.",
                                "de": "Der Chef hat einen neuen <w>Burschen</w> eingestellt, um Pakete im Lager zu tragen."
                            }
                        },
                        {
                            "text": "Nie chcę być całe życie <w>chłopakiem</w> na posyłki.",
                            "target_lang_translations": {
                                "ru": "Я не хочу всю жизнь быть <w>мальчиком</w> на побегушках.",
                                "de": "Ich will nicht mein ganzes Leben lang der <w>Laufbursche</w> sein."
                            }
                        }
                    ],
                    "synonyms": [
                        "pomocnik",
                        "praktykant"
                    ],
                    "common_phrases": [
                        "chłopak na posyłki",
                        "chłopak do pomocy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой работник, выполняющий простую физическую или подсобную работу.",
                        "de": "Ein junger Arbeiter, der einfache körperliche oder unterstützende Tätigkeiten ausführt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "работник"
                            },
                            {
                                "target_lang_word": "мальчик",
                                "target_lang_sense_clarification": "в выражении 'мальчик на побегушках'"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bursche",
                                "target_lang_sense_clarification": "junger Mann in einer Hilfsfunktion"
                            },
                            {
                                "target_lang_word": "Hilfsarbeiter",
                                "target_lang_sense_clarification": "Arbeiter für einfache Tätigkeiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35648091-c277-3bd7-b2b0-ae7d33be4922",
                    "sense_definition": "Część kołowrotu w kształcie walca, na którą nawija się lina.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lina zablokowała się na <w>chłopaku</w> i nie mogliśmy jej odwinąć.",
                            "target_lang_translations": {
                                "ru": "Трос застрял на <w>барабане</w>, и мы не могли его размотать.",
                                "de": "Das Seil hat sich an der <w>Trommel</w> verklemmt und wir konnten es nicht abwickeln."
                            }
                        },
                        {
                            "text": "Mechanizm wymagał naprawy, ponieważ pękł <w>chłopak</w>.",
                            "target_lang_translations": {
                                "ru": "Механизм требовал ремонта, так как треснул <w>барабан</w>.",
                                "de": "Der Mechanismus musste repariert werden, da die <w>Trommel</w> gebrochen war."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical or dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть ворота цилиндрической формы, на которую наматывается трос.",
                        "de": "Ein zylindrisches Teil einer Winde, auf das ein Seil aufgewickelt wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барабан",
                                "target_lang_sense_clarification": "техническое"
                            },
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "техническое"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Trommel",
                                "target_lang_sense_clarification": "technisches Bauteil zum Aufwickeln"
                            },
                            {
                                "target_lang_word": "Seilrolle",
                                "target_lang_sense_clarification": "technisches Bauteil"
                            }
                        ]
                    }
                }
