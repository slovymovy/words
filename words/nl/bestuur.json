    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c6d05ea-8f80-3419-b134-afec5b6579c4",
                    "sense_definition": "De groep mensen die de leiding heeft over een organisatie, vereniging of bedrijf.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "organisatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>bestuur</w> van de sportclub komt elke maandagavond bij elkaar voor overleg.",
                            "target_lang_translations": {
                                "en": "The <w>board</w> of the sports club meets every Monday evening for consultation."
                            }
                        },
                        {
                            "text": "De leden van het <w>bestuur</w> zijn verantwoordelijk voor de besluitvorming binnen de organisatie.",
                            "target_lang_translations": {
                                "en": "The members of the <w>board</w> are responsible for decision-making within the organization."
                            }
                        }
                    ],
                    "synonyms": [
                        "directie",
                        "management"
                    ],
                    "common_phrases": [
                        "het bestuur van",
                        "leden van het bestuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The group of people in charge of an organization, association, or company."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "board",
                                "target_lang_sense_clarification": "of directors or an association"
                            },
                            {
                                "target_lang_word": "management",
                                "target_lang_sense_clarification": "the people running a company"
                            },
                            {
                                "target_lang_word": "board of directors",
                                "target_lang_sense_clarification": "formal governing body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06fa32f3-c303-3dcd-8ca2-9bc47e7a13e5",
                    "sense_definition": "De manier waarop een organisatie, land of instelling wordt geleid of gecontroleerd.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organisatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een goed <w>bestuur</w> is essentieel voor de stabiliteit van een land.",
                            "target_lang_translations": {
                                "en": "Good <w>governance</w> is essential for the stability of a country."
                            }
                        },
                        {
                            "text": "Het <w>bestuur</w> van onze vereniging is van zeer goede kwaliteit.",
                            "target_lang_translations": {
                                "en": "The <w>management</w> of our association is of very high quality."
                            }
                        }
                    ],
                    "synonyms": [
                        "management"
                    ],
                    "common_phrases": [
                        "goed bestuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The manner in which an organization, country, or institution is led or controlled."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "governance",
                                "target_lang_sense_clarification": "the act or process of governing"
                            },
                            {
                                "target_lang_word": "administration",
                                "target_lang_sense_clarification": "the management of public or business affairs"
                            },
                            {
                                "target_lang_word": "management",
                                "target_lang_sense_clarification": "the process of dealing with or controlling things"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6ddc81c-c960-3f86-96c7-62d0dd500dfc",
                    "sense_definition": "De periode waarin een vorst of leider aan de macht is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>bestuur</w> van de koning was lang en welvarend voor het hele volk.",
                            "target_lang_translations": {
                                "en": "The king's <w>reign</w> was long and prosperous for the entire people."
                            }
                        },
                        {
                            "text": "Tijdens zijn <w>bestuur</w> werden er veel nieuwe wetten aangenomen.",
                            "target_lang_translations": {
                                "en": "During his <w>rule</w>, many new laws were passed."
                            }
                        }
                    ],
                    "common_phrases": [
                        "onder het bestuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The period during which a monarch or leader is in power."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reign",
                                "target_lang_sense_clarification": "period of a monarch's rule"
                            },
                            {
                                "target_lang_word": "rule",
                                "target_lang_sense_clarification": "period of control by a leader"
                            },
                            {
                                "target_lang_word": "governance",
                                "target_lang_sense_clarification": "period of administration"
                            }
                        ]
                    }
                }
            ]
        },
        {
