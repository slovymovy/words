                    "examples": [
                        {
                            "text": "Een <w>vijfde</w> is hetzelfde als twintig procent.",
                            "target_lang_translations": {
                                "en": "A <w>fifth</w> is the same as twenty percent.",
                                "ru": "<w>Одна пятая</w> — это то же самое, что двадцать процентов.",
                                "pl": "<w>Jedna piąta</w> to to samo, co dwadzieścia procent.",
                                "de": "Ein <w>Fünftel</w> ist das Gleiche wie zwanzig Prozent.",
                                "fr": "<w>Un cinquième</w> est la même chose que vingt pour cent.",
                                "it": "<w>Un quinto</w> è lo stesso che venti per cento.",
                                "cs": "<w>Jedna pětina</w> je totéž co dvacet procent.",
                                "tr": "<w>Beşte bir</w>, yüzde yirmi ile aynıdır.",
                                "es": "<w>Un quinto</w> es lo mismo que el veinte por ciento.",
                                "zh": "<w>五分之一</w>和百分之二十是一样的。"
                            }
                        },
                        {
                            "text": "Hij heeft bijna een <w>vijfde</w> van zijn salaris gespaard.",
                            "target_lang_translations": {
                                "en": "He has saved almost a <w>fifth</w> of his salary.",
                                "ru": "Он отложил почти <w>одну пятую</w> своей зарплаты.",
                                "pl": "Oszczędził prawie <w>jedną piątą</w> swojej pensji.",
                                "de": "Er hat fast ein <w>Fünftel</w> seines Gehalts gespart.",
                                "fr": "Il a épargné presque <w>un cinquième</w> de son salaire.",
                                "it": "Ha risparmiato quasi <w>un quinto</w> del suo stipendio.",
                                "cs": "Ušetřil téměř <w>jednu pětinu</w> svého platu.",
                                "tr": "Maaşının neredeyse <w>beşte birini</w> biriktirdi.",
                                "es": "Ha ahorrado casi <w>una quinta parte</w> de su salario.",
                                "zh": "他存下了几乎<w>五分之一</w>的工资。"
                            }
                        }
