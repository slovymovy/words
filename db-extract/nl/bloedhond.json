                ],
                "translations": [
                    {
                        "translation_id": "6afcd7df-e702-4eae-9e99-07999d8ff753",
                        "source_entry_id": "e608c91d-543f-3a66-8215-9e307f5cf3b2",
                        "source_sense_id": "7ed34bcf-8add-3353-b119-7b3494050f51",
                        "source_sense_description": "Brits hondenras met grote kop, lange hangende oren en een lange staart",
                        "target_lang_word": "Bluthund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluthund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f47ab63-2a7a-37f9-871b-283fd7aa673a",
                                        "entry_id": "851d2021-0405-3730-ba92-0be825f03b37",
                                        "glosses": [
                                            "auf Menschen dressierte Hunde, meist Doggen; insbesondere von den Spaniern nach der Entdeckung Amerikas gegen die Bewohner dort eingesetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e8bb076-83b3-45e9-9ac8-07e812fee569",
                                                "sense_id": "2f47ab63-2a7a-37f9-871b-283fd7aa673a",
                                                "text": "Und dann hetzte man die Bluthunde auf die Dorfbewohner."
                                            },
                                            {
                                                "example_id": "632342e1-936a-4d56-a4fa-1ba2bbc0ac4c",
                                                "sense_id": "2f47ab63-2a7a-37f9-871b-283fd7aa673a",
                                                "text": "„Er hatte sich mit einer Metallschere durch das Dickicht eines stacheldrahtdurchwucherten Waldes gekämpft, hatte über eine hohe Mauer klettern müssen, war von Bluthunden gehetzt und von SS-Männern verfolgt worden, hatte durch einen Tunnel laufen müssen und ... war aufgewacht.“"
                                            },
                                            {
                                                "example_id": "ee925802-f0a8-4d5f-9063-58564426680b",
                                                "sense_id": "2f47ab63-2a7a-37f9-871b-283fd7aa673a",
                                                "text": "„Es ist ein sonderbarer Effekt; er hat vom vielen Weinen so viele Falten im Gesicht wie ein Bluthund und auch gewöhnlich denselben trübfeierlichen Ausdruck.“"
                                            },
                                            {
                                                "example_id": "42635083-0b95-47be-99b1-b4e9da31ed57",
                                                "sense_id": "2f47ab63-2a7a-37f9-871b-283fd7aa673a",
                                                "text": "„So schnell und lautlos bewegte er sich durch das Zimmer wie ein abgerichteter Bluthund, der eine Fährte aufnimmt, daß mir unwillkürlich der Gedanke kam, er hätte sich ebenso einen großen und schrecklichen Namen als Verbrecher machen können, hätte er seine Energie und Klugheit gegen das Gesetz gewandt, anstatt sie zu seiner Verteidigung einzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d920d16-6ceb-3b8f-969f-8ad4bb08d744",
                                        "entry_id": "851d2021-0405-3730-ba92-0be825f03b37",
                                        "glosses": [
                                            "Menschen, die sich als grausame Tyrannen zeigen, besonders hartnäckige Mitarbeiter öffentlicher Medien"
                                        ],
                                        "tags": [
                                            "oder auch übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e70dab1-4ae6-458d-94a0-6e768de33e9e",
                                                "sense_id": "3d920d16-6ceb-3b8f-969f-8ad4bb08d744",
                                                "text": "„Wer dem Arbeiter seinen Lohn nicht gibt, der ist ein Bluthund.“ (Sirach 34, 27)"
                                            },
                                            {
                                                "example_id": "6d27caca-32b5-40e5-8c2e-f275e76d2158",
                                                "sense_id": "3d920d16-6ceb-3b8f-969f-8ad4bb08d744",
                                                "text": "Natürlich ist es hart, die Medienvertreter als Bluthunde zu bezeichnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "896e0722-9ef1-39dc-b1cf-9d80ee890453",
                                        "entry_id": "851d2021-0405-3730-ba92-0be825f03b37",
                                        "glosses": [
                                            "die Hunderasse Bloodhound"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8da9f3a-ea1f-43de-9339-44da2ed7a226",
                                                "sense_id": "896e0722-9ef1-39dc-b1cf-9d80ee890453",
                                                "text": "Die Vorfahren des Bluthundes auch Bloodhound, Chien de St. Hubert oder Hubertushund genannt, lebten in England."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fa2a45f-53d6-484f-a806-6c3d64417a8f",
                        "source_entry_id": "e608c91d-543f-3a66-8215-9e307f5cf3b2",
                        "source_sense_id": "7ed34bcf-8add-3353-b119-7b3494050f51",
                        "source_sense_description": "Brits hondenras met grote kop, lange hangende oren en een lange staart",
                        "target_lang_word": "bloodhound",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloodhound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01808557-4fb5-3cd2-9e84-8fda98cc966d",
                                        "entry_id": "c49b8f2c-0105-3cf3-9791-77f44e6eb557",
                                        "glosses": [
                                            "A large scenthound famed for its ability to follow a scent many days old, over vast distances. This dog is often used as a police dog to track missing people, fleeing suspects, or escaped prisoners."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "569fb4fb-bf45-4c40-9d4f-27645dec19f3",
                                                "sense_id": "01808557-4fb5-3cd2-9e84-8fda98cc966d",
                                                "text": "Someone stole our bloodhounds, but we got the backup bloodhounds to chase the first tier of bloodhounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1552598b-8f01-38c3-9c92-94dd8eb939f5",
                                        "entry_id": "c49b8f2c-0105-3cf3-9791-77f44e6eb557",
                                        "glosses": [
                                            "A detective or other person skilled at finding people or clues."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e00d933e-f1ad-3684-bb67-523daa9a5441",
                                        "entry_id": "c49b8f2c-0105-3cf3-9791-77f44e6eb557",
                                        "glosses": [
                                            "A bloodthirsty person."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef50fa11-168f-4679-8bca-a9e719685ae9",
                                                "sense_id": "e00d933e-f1ad-3684-bb67-523daa9a5441",
                                                "text": "For now the despot’s blood-hounds with their prey,\nUnarmed and unaware, were gorging deep\nTheir gluttony of death; the loose array\nOf horsemen o’er the wide fields murdering sweep,\nAnd with loud laughter for their tyrant reap\nA harvest sown with other hopes; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91a56d81-165a-4ce8-b358-b99abcaed398",
                        "source_entry_id": "e608c91d-543f-3a66-8215-9e307f5cf3b2",
                        "source_sense_id": "7ed34bcf-8add-3353-b119-7b3494050f51",
                        "source_sense_description": "Brits hondenras met grote kop, lange hangende oren en een lange staart",
                        "target_lang_word": "limier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e3817c1-6a13-3457-9264-90cba6cfec5a",
                                        "entry_id": "301b280e-5079-35cb-8340-edb334d7224f",
                                        "glosses": [
                                            "Gros chien de chasse avec lequel le veneur quête et détourne la bête, pour la lancer quand on veut la courir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c74df246-ef8c-4566-9e82-c6fbcc357e8c",
                                                "sense_id": "9e3817c1-6a13-3457-9264-90cba6cfec5a",
                                                "text": "[…] l’un d’eux vient du Hexhamshire, il est habitué à suivre la piste des voleurs du Tynedale et du Teviotdale, comme le limier suit la trace du daim blessé […]."
                                            },
                                            {
                                                "example_id": "f0d9f20b-96f1-4bbd-b53b-cd98f2f6397d",
                                                "sense_id": "9e3817c1-6a13-3457-9264-90cba6cfec5a",
                                                "text": "[…] ; or, on conçoit l'affectueuse et haute estime de tout veneur pour la sagacité de son limier, lorsqu'on songe que, selon cette sagacité, on chasse ou on fait buisson creux , en cela que le limier doit d'abord chercher et trouver l'animal destiné à être ensuite couru et forcé par la meute."
                                            },
                                            {
                                                "example_id": "816f700c-96f4-4259-b53a-181a3cbfae76",
                                                "sense_id": "9e3817c1-6a13-3457-9264-90cba6cfec5a",
                                                "text": "Nô Eusébio détacha quatre magnifiques limiers, nommés rastreros dans le pays, et qui servent à suivre les pistes ; il leur fit sentir une chemise appartenant à Rafaël ; les limiers s’élancèrent sur la voie en poussant de grands cris […]."
                                            },
                                            {
                                                "example_id": "59d6f3ae-5506-4d0e-be42-ab62f170603c",
                                                "sense_id": "9e3817c1-6a13-3457-9264-90cba6cfec5a",
                                                "text": "– Qu’on puisse te retrouver après tous les détours que tu as faits, cela me paraît peu probable, car tu as eu la finesse et la ruse du renard ; tu as si bien embrouillé ta piste, qu’il faudrait un fin limier pour la suivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7914eabd-3675-380a-921e-1f6c2444b0a4",
                                        "entry_id": "301b280e-5079-35cb-8340-edb334d7224f",
                                        "glosses": [
                                            "Agent en civil de la police."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e7ab73e-8a64-4d01-8613-8ee0d48a7203",
                                                "sense_id": "7914eabd-3675-380a-921e-1f6c2444b0a4",
                                                "text": "S’il est un lieu commun en police, c’est bien le peu d’utilité de la photographie pour arriver jusqu’au malfaiteur en fuite. — « Autant elle serait excellente, dit-on, pour confirmer une identité soupçonnée, autant elle serait insuffisante comme moyen de recherche, et il arriverait journellement aux limiers les plus consciencieux de passer à côté d’un type dont ils auraient l’image en poche sans le reconnaître. »"
                                            },
                                            {
                                                "example_id": "8558e428-16a6-4938-9150-5b7cddcf084d",
                                                "sense_id": "7914eabd-3675-380a-921e-1f6c2444b0a4",
                                                "text": "M. Dudouis, le chef de la Sûreté, envoya ses meilleurs limiers de la brigade de fer."
                                            },
                                            {
                                                "example_id": "2a1bf0ce-3fe1-4806-a01d-fab5f5c36e6d",
                                                "sense_id": "7914eabd-3675-380a-921e-1f6c2444b0a4",
                                                "text": "Rien dans ses agissements, ses relations, n'était douteux. Plusieurs heures durant, vingt limiers du Bureau Central avaient travaillé d'arrache-pied sur cette matière, cherchant la faille par où pourrait s'insinuer le soupçon. Pour aboutir à délivrer vingt certificats de bonne vie et mœurs..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
