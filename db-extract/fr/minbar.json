                    {
                        "sense_id": "64ee456f-8fb6-3514-91ec-501f0e78cd9f",
                        "entry_id": "8f3fe801-9cc7-3c2a-8ac2-4c5ecb09616d",
                        "glosses": [
                            "Planète fictive, point d’origine des Minbaris, dans l’univers de la série Babylon 5."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f16477-2bcc-41b7-af57-5c9c353a39fb",
                                "sense_id": "64ee456f-8fb6-3514-91ec-501f0e78cd9f",
                                "text": "Minbar possède deux lunes, son année dure 1,5 année terrienne, son jour 20 heures et 47 minutes. Sa population est d’environ quatre milliards de Minbaris, et sa capitale Yedor."
                            }
                        ]
                    }
                ],
