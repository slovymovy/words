        "fr-extract.jsonl": [
            {
                "entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                "word": "démarcation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a55dc95a-9c54-40c6-9fc8-33250489b824",
                        "entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                        "tags": [
                            "plural"
                        ],
                        "form": "démarcations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c0ca7e8-c680-3fa1-8e02-eaf687138cdf",
                        "entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                        "glosses": [
                            "Séparation entre deux régions, deux zones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387bbdf5-7664-4820-9ed1-05a7abe517d7",
                                "sense_id": "5c0ca7e8-c680-3fa1-8e02-eaf687138cdf",
                                "text": "Les lignes de démarcation durant la guerre comme la lame d'un couteau sur la meule."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5eb3373-392c-3b84-b2ab-ac038c3be15f",
                        "entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                        "glosses": [
                            "Délimitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c434f03f-457b-4604-ade3-13fc69e2fba7",
                                "sense_id": "a5eb3373-392c-3b84-b2ab-ac038c3be15f",
                                "text": "Enfin, j'ai trouvé des laitiers de hauts fourneaux, en partie vitreux et en partie clivables, mais offrant toujours une démarcation tranchée entre la partie cristalline et la partie translucide."
                            },
                            {
                                "example_id": "7a781037-fd59-41c0-933c-ad0d1f365bb8",
                                "sense_id": "a5eb3373-392c-3b84-b2ab-ac038c3be15f",
                                "text": "Etant donné qu’elle a été promulguée le 24 mars 2000, la démarcation des terres aurait dû être réalisée au plus tard le 23 mars 2002."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "942c2de9-c675-4c13-be6f-a6216d88b5ea",
                        "source_entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                        "target_lang_word": "Abgrenzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abgrenzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54385479-8c31-3514-bf10-8af73b7c3737",
                                        "entry_id": "6f45c0a2-ba87-3b6f-a016-a41e47bce763",
                                        "glosses": [
                                            "das Erstellen von Grenzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300a9aa2-836e-475c-9b16-6f5fc7d5166f",
                                                "sense_id": "54385479-8c31-3514-bf10-8af73b7c3737",
                                                "text": "Wir werden zunächst eine Abgrenzung des Geländes vornehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab41ea84-19ff-30d8-9c50-732296b4983b",
                                        "entry_id": "6f45c0a2-ba87-3b6f-a016-a41e47bce763",
                                        "glosses": [
                                            "verbale Distanzierung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0038de51-d5b2-43c7-8d3f-dcbbf7b52122",
                                                "sense_id": "ab41ea84-19ff-30d8-9c50-732296b4983b",
                                                "text": "Seiner Abgrenzung war ganz klar zu entnehmen, wie unangenehm ihm das Thema war."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ed9e70d-6818-39ac-b5ed-022a93cf0a3a",
                                        "entry_id": "6f45c0a2-ba87-3b6f-a016-a41e47bce763",
                                        "glosses": [
                                            "der Akt des Unterscheidens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b181d10-0206-4e23-8b7e-c8d94f442c04",
                                                "sense_id": "4ed9e70d-6818-39ac-b5ed-022a93cf0a3a",
                                                "text": "Ihnen ist die Abgrenzung der Begriffe nicht ganz gelungen."
                                            },
                                            {
                                                "example_id": "619a670b-1c27-4b26-a935-a34ce2c2c1f3",
                                                "sense_id": "4ed9e70d-6818-39ac-b5ed-022a93cf0a3a",
                                                "text": "„Ich sehe es sogar im Gegenteil als bewusste Abgrenzung von der Gesamtgesellschaft.“"
                                            },
                                            {
                                                "example_id": "d287f20a-f5df-4b43-af95-af757da5cc1f",
                                                "sense_id": "4ed9e70d-6818-39ac-b5ed-022a93cf0a3a",
                                                "text": "„Jedoch dient die konfessionelle Zuordnung nur in wenigen Fällen der ethnischen Abgrenzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6efd9052-2bfc-4f8f-8162-b99b020e7cae",
                        "source_entry_id": "677c76f1-7e3a-3a99-b7af-b831acb62a19",
                        "target_lang_word": "demarcation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demarcation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96793901-8d2f-33ed-aec4-262ccdc21895",
                                        "entry_id": "fd459e81-1690-390e-b3fa-71b963b38388",
                                        "glosses": [
                                            "The act of marking off a boundary or setting a limit, notably by belligerents signing a treaty or ceasefire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e47303d-bb67-37de-bc7b-50faf432ae17",
                                        "entry_id": "fd459e81-1690-390e-b3fa-71b963b38388",
                                        "glosses": [
                                            "A limit thus fixed, in full demarcation line."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a1e5cf0-de13-440c-bb6e-9c73caaff312",
                                                "sense_id": "6e47303d-bb67-37de-bc7b-50faf432ae17",
                                                "text": "About sunset, he was leaning on the remains of an old wall, which had once probably surrounded a Roman encampment, and now served as a line of demarcation between two villages, as jealous of each other's claims as near neighbours usually are."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                        "entry_id": "fd459e81-1690-390e-b3fa-71b963b38388",
                                        "glosses": [
                                            "Any strictly defined separation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d53b2a83-f731-490a-8260-ae96a28581d9",
                                                "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                                "text": "There is an alleged, in fact somewhat artificial demarcation in the type of work done by members of different trade unions."
                                            },
                                            {
                                                "example_id": "f5ede313-606c-431b-a9bd-001331dbb0b4",
                                                "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                                "text": "In the sea there is no demarcation between the hunter and the hunted, as there is on the African plains."
                                            },
                                            {
                                                "example_id": "1265e3e0-6d7e-4059-8875-64cb2de46202",
                                                "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                                "text": "Certainly no clear line of demarcation has as yet been drawn between species and sub-species—that is, the forms which in the opinion of some naturalists come very near to, but do not quite arrive at the rank of species; or, again, between sub-species and well-marked varieties, or between lesser varieties and individual differences. These differences blend into each other in an insensible series; and a series impresses the mind with the idea of an actual passage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
