                "senses": [
                    {
                        "sense_id": "bf2d136c-aa63-3a83-a90d-60061fc24688",
                        "entry_id": "9fbd4f77-2dd0-3ac8-b9b4-97e39920adf1",
                        "glosses": [
                            "internationales Recht, eine bestimmte Menge Schadstoffe auszustoßen"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "9ac231b8-54f8-4b51-8ea4-3b544c7a3249",
                                "sense_id": "bf2d136c-aa63-3a83-a90d-60061fc24688",
                                "text": "„Betriebe mit einem höheren Ausstoß sind verpflichtet, zusätzliche Emissionsrechte zu erwerben.“"
                            },
                            {
                                "example_id": "d8999b13-2f77-4e95-9ee2-426e46150e5f",
                                "sense_id": "bf2d136c-aa63-3a83-a90d-60061fc24688",
                                "text": "„Dass die Bundesregierung die Emissionsrechte gratis an die Energieerzeuger und die Industrie abgibt, während die Regierungen anderer Länder die Zertifikate versteigern, sorgt in Berlin für teils hitzige Diskussionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
