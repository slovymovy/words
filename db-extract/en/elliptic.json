                                "sense_id": "7b6252d9-97f6-314f-a06d-5b9884d30c25",
                                "text": "elliptic regularity"
                            }
                        ]
                    },
                    {
                        "sense_id": "6f619414-fdc5-3c96-a208-a9169d215e46",
                        "entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                        "glosses": [
                            "Oval, with a short or no point."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c020456e-9743-3e4f-a85b-879f7c8c8740",
                        "entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                        "glosses": [
                            "Of, or showing ellipsis; having a word or words omitted; elliptical."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ee81d3d0-acc0-42d7-b75b-69944470fef7",
                                "sense_id": "c020456e-9743-3e4f-a85b-879f7c8c8740",
                                "text": "The message, which is elliptic, could be spelled out as: (Hello) Olive. This is Julian. I am here until you want to ring me."
                            }
                        ]
                    }
                ],
