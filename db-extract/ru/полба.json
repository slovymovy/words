                    {
                        "translation_id": "f81cd3f1-cae2-4df9-a237-44bbc3f336f5",
                        "source_entry_id": "de1c8ce9-39c0-373b-9e69-fff20143d66e",
                        "source_sense_description": "вид пшеницы",
                        "target_lang_word": "Dinkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dinkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b94741c-b8f1-3645-a5cb-062ba08bd1cc",
                                        "entry_id": "60e44cdd-a66b-39b2-b687-22bcb060a468",
                                        "glosses": [
                                            "Getreideart, die auch in rauen Lagen und auf „armen“ Böden wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2725d803-191e-4883-bc6c-9bef8ddd4483",
                                                "sense_id": "7b94741c-b8f1-3645-a5cb-062ba08bd1cc",
                                                "text": "Der Dinkel ist eine anspruchslose Getreideart."
                                            },
                                            {
                                                "example_id": "eff5df4a-acb4-41b3-9fa9-cc2e43bacb16",
                                                "sense_id": "7b94741c-b8f1-3645-a5cb-062ba08bd1cc",
                                                "text": "In Dinkel kommt, wie auch in Weizen und Roggen, Gluten vor, ein Proteingemisch, das ca. einer von dreihundert Personen nicht verträgt."
                                            },
                                            {
                                                "example_id": "2fcb12f5-a6a8-4a03-9f96-c19d1f75eba8",
                                                "sense_id": "7b94741c-b8f1-3645-a5cb-062ba08bd1cc",
                                                "text": "Und Dinkel – der Klassiker der Hildegardmedizin – sorgt nicht nur für eine gute Verdauung, sondern auch für ein fröhliches und entspanntes Gemüt, weil es Tryptophan enthält, eine Aminosäure, die das Glückshormon Serotonin aktiviert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cae4b284-3412-42b3-83d3-065549a07f6b",
                        "source_entry_id": "de1c8ce9-39c0-373b-9e69-fff20143d66e",
