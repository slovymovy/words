        "fr-extract.jsonl": [
            {
                "entry_id": "03cea8cb-58d5-3f25-a7c3-ceec0a11b13e",
                "word": "avant-midi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cce098db-c251-4be3-9fcc-3c55e9b385f2",
                        "entry_id": "03cea8cb-58d5-3f25-a7c3-ceec0a11b13e",
                        "tags": [
                            "plural"
                        ],
                        "form": "avant-midis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "820bb232-347a-3efb-b333-9e1c2f2e358f",
                        "entry_id": "03cea8cb-58d5-3f25-a7c3-ceec0a11b13e",
                        "glosses": [
                            "Partie de la journée allant du matin à midi."
                        ],
                        "tags": [
                            "Canada",
                            "Belgique",
                            "Congo-Kinshasa",
                            "Liban",
                            "Cameroun",
                            "Ardennes"
                        ],
                        "examples": [
                            {
                                "example_id": "06305d1e-fb2b-47ec-87da-5558105affc9",
                                "sense_id": "820bb232-347a-3efb-b333-9e1c2f2e358f",
                                "text": "Mais dans l’assemblée du 17 dans l’avant-midi, les Patriotes les forcèrent à prendre une résolution vigoureuse & définitive. Il n’y eut plus de milieu, il fallut se déclarer sur le champ pour ou contre la Patrie."
                            },
                            {
                                "example_id": "ff4bdc8b-8334-4592-9d81-206ac0ebad19",
                                "sense_id": "820bb232-347a-3efb-b333-9e1c2f2e358f",
                                "text": "Il est décidé au premier synode tenu à Douala du 26 au 28 septembre 1906 que les cours doivent avoir lieu dans l’avant-midi et le travail manuel dans l’après-midi."
                            },
                            {
                                "example_id": "2e5b5793-27ed-425d-8bd7-000deca65fe9",
                                "sense_id": "820bb232-347a-3efb-b333-9e1c2f2e358f",
                                "text": "Durant l’avant-midi, l’adolescente n'avait pu s'empêcher de se plaindre de l’indiscipline de ses deux frères qui acceptaient mal son autorité."
                            },
                            {
                                "example_id": "bffa4bb7-3c44-4c2e-87a3-34452fec28e0",
                                "sense_id": "820bb232-347a-3efb-b333-9e1c2f2e358f",
                                "text": "En ce qui me concerne, je suis occupée avec des clients, mais tant que tu seras ici, je ne travaillerai que durant les avant-midis pour profiter de ta présence. Tu es heureuse à Vancouver, mais tu me manques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92b316c8-3192-4abc-b2ea-ec85c24bd536",
                        "source_entry_id": "03cea8cb-58d5-3f25-a7c3-ceec0a11b13e",
                        "source_sense_id": "820bb232-347a-3efb-b333-9e1c2f2e358f",
                        "source_sense_description": "Partie du matin au midi",
                        "target_lang_word": "Vormittag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vormittag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                        "entry_id": "71ff7621-743d-38aa-8103-c98762847964",
                                        "glosses": [
                                            "Zeitraum zwischen dem Morgen und dem Mittag"
                                        ],
                                        "tags": [
                                            "Tageszeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223019cd-84ba-4ad0-9ba5-294351ccad96",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "Ruf am besten am späten Vormittag an."
                                            },
                                            {
                                                "example_id": "9ea2b752-4796-4da7-8d7c-5952a318a5b3",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Gleich nach dem Frühstück fuhren wir mit der Weinlese fort und im Laufe des Vormittags kamen noch einige Dorfbewohner hinzu.“"
                                            },
                                            {
                                                "example_id": "45d17796-b9fc-497f-866c-905412c5eaa3",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Am späten Vormittag trat ein Wilder aus dem Busch.“"
                                            },
                                            {
                                                "example_id": "5afa85f4-2d99-45d0-acc3-f92a84abc73d",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Im Laufe des späten Vormittages führte Aëtius das Heer zur Schlacht auf die Ebene zwischen den beiden Lagern.“"
                                            },
                                            {
                                                "example_id": "649cea48-6bfa-4c5a-a3ab-ee26a2482979",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Am frühen Vormittag war ich in Trier.“"
                                            },
                                            {
                                                "example_id": "569dacf9-9407-48a5-b6d6-2c53ee6b4124",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Der Vormittag war vorüber.“"
                                            },
                                            {
                                                "example_id": "5c53c9f0-b3ea-4281-8131-5c245c4b3eff",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Die Kleinstadt, wo sie davor gelebt hatten und nach der Ada benannt wurde, war zu Fuß etwa einen halben Vormittag entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56e21cc5-8e0a-44f2-80d1-25154d5a97b6",
                        "source_entry_id": "03cea8cb-58d5-3f25-a7c3-ceec0a11b13e",
                        "source_sense_id": "820bb232-347a-3efb-b333-9e1c2f2e358f",
                        "source_sense_description": "Partie du matin au midi",
                        "target_lang_word": "forenoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forenoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                        "entry_id": "4f325957-b1df-30e3-898d-593c969073a9",
                                        "glosses": [
                                            "Synonym of morning: the part of the day between sunrise and noon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb3566f-df64-4117-9c91-bfd328f8d189",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "You are ambitious for poor knaves' caps and legs; you wear out a good wholesome forenoon in hearing a cause between an orange-wife and a fosset-seller, and then rejourn the controversy of threepence to a second day of audience."
                                            },
                                            {
                                                "example_id": "8388a81c-168f-487e-880e-f23c141d4712",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "Later in the forenoon the gale increased more and more; the seas set in, and the waves grew bigger and bigger[.]"
                                            },
                                            {
                                                "example_id": "05ff34b2-4816-4b9a-803f-8d424e92f330",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "This, too, was why no one, not even the twins, paid Papa O. any heed when the family returned from Mass one Sunday forenoon and he told them someone had been knocking while they were away."
                                            },
                                            {
                                                "example_id": "59263fdd-4708-4a53-ac3b-8bac677142e2",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "A hot sun burned down on us. Ten times during a single forenoon every stitch of clothes on one's body was soaked with perspiration, and ten times it dried again."
                                            },
                                            {
                                                "example_id": "dbd88d10-72d1-401a-a808-78cdde5cecfa",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "It was run in by Ranochan of Polmadie on the forenoon slow to Carlisle and the afternoon slow back to the North."
                                            },
                                            {
                                                "example_id": "d2eb1078-686b-41ed-991e-1700adc28562",
                                                "sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                                                "text": "Desire to be alone in forenoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
