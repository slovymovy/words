                        "glosses": [
                            "langlebiges Produktionsgut, das langfristig an der Wertschöpfung eines Unternehmens beteiligt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc42062-8f18-4c14-9633-79de762aa7a8",
                                "sense_id": "a5b5373b-ea51-3dfc-b9f5-44107d812a8d",
                                "text": "Während Immobilien für die meisten Unternehmen Investitionsgüter darstellen, die, etwa als Betriebsgrundstück über Jahre ein unentbehrlicher Wertschöpfungsfaktor bleiben, sind sie für Baufirmen und Immobilienmakler eher als Vorleistungsgut zu betrachten."
                            }
                        ],
