                        "cross_references": []
                    },
                    {
                        "translation_id": "02be4587-25bd-4491-ad3f-260de587d2c0",
                        "source_entry_id": "43519c8f-6429-3b94-b8f8-b2cde319fb75",
                        "source_sense_id": "2d208da6-c66c-3c6b-b535-d22921ba2e5d",
                        "target_lang_word": "fühlbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fühlbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                        "entry_id": "ded493d9-0ad5-361c-a60b-0fd98d17bc6b",
                                        "glosses": [
                                            "so, dass es sich leicht erkennen oder bemerken lässt; deutlich wahrnehmbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82aab2c6-52e9-4b75-a260-1c71f8c1a131",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "Die Spannung im Raum war deutlich, fast körperlich, fühlbar."
                                            },
                                            {
                                                "example_id": "11ebd02e-9bac-4885-b58c-82bbe9deb6f7",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "[Im Knast] wird die Enge fühlbar, ebenso wie die Unmöglichkeit auszuweichen. Jeder Sinn ist betroffen."
                                            },
                                            {
                                                "example_id": "926e698f-6719-4c61-a8c5-4f564b10236b",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "[…] der Südostasienwissenschaftler Carlyle Thayer [schreibt] in einer Analyse der chinesisch-vietnamesischen Beziehungen 2011: „Es gibt fühlbar anti-chinesische Ressentiments in großen Teilen der politischen Elite Vietnams.[…]“"
                                            },
                                            {
                                                "example_id": "0a7d40cf-84c1-4b7f-bfed-e71ce2b57801",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "„Das ist das Blut meines Freundes Joseph. Er lag auf mir, als er starb. Sein Körper hat mich geschützt“, sagt der alte Mann unvermittelt. Die grausame Erfahrung, die Tat [des Massakers von Oradour durch die deutsche Waffen-SS] ist plötzlich ganz nah, fühlbar geworden."
                                            },
                                            {
                                                "example_id": "d4ee18c0-9f6d-4c50-827d-34e1a12f5ce2",
                                                "sense_id": "ff98c9e9-9af0-3033-861f-db7f24b27462",
                                                "text": "Überschrift: Die Skirennfahrer Hirscher und Kristoffersen - Wo Selbstsicherheit fühlbar ist - Marcel Hirscher und Henrik Kristoffersen gewinnen die Rennen in Val-d'Isère. Ihre Überlegenheit ist offensichtlich – ebenso ihr Selbstbewusstsein. Sie haben andere Ansprüche als die meisten Gegner."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                        "entry_id": "ded493d9-0ad5-361c-a60b-0fd98d17bc6b",
                                        "glosses": [
                                            "körperlich durch die Sinne, insbesondere den Tastsinn, wahrnehmen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b8d04bb-8c9f-44de-8699-fa8d043e1513",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Sie lag im Sterben, ihr Puls war kaum noch fühlbar."
                                            },
                                            {
                                                "example_id": "51157c4b-fbf7-4e70-ba5e-9feba5e2c193",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Wind ist nicht sicht-, aber fühlbar."
                                            },
                                            {
                                                "example_id": "afed14b1-cdb9-433c-959a-d434810d7ff5",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Die Hitze lastet bleischwer auf der Ruhrgebietsstadt [Dortmund], von den Temperaturen her machen Tag und Nacht kaum einen fühlbaren Unterschied […]"
                                            },
                                            {
                                                "example_id": "dc064135-0d2b-465b-b948-47bc401bd2b1",
                                                "sense_id": "e4d9c35f-5738-39f0-9485-c02d5c5589c6",
                                                "text": "Die Patienten [einer Alkoholerkrankung] haben eine fühlbar vergrößerte Leber, sind aber meist beschwerdefrei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c393b08c-ca01-498e-88d8-deb9e22aa9c2",
                        "source_entry_id": "43519c8f-6429-3b94-b8f8-b2cde319fb75",
                        "source_sense_id": "2d208da6-c66c-3c6b-b535-d22921ba2e5d",
                        "target_lang_word": "empfindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empfindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "körperlich leicht auf äußere Einflüsse reagierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b9d949-ec74-4f1d-a99c-5986127a662a",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "Er ist gegen hohe Temperaturen sehr empfindlich."
                                            },
                                            {
                                                "example_id": "01b4bbb9-6f9c-493b-be6e-891ce8232679",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Als Blonde reagiere ich sehr empfindlich auf die Sonne. Ich muß mich immer gut mit Sonnencreme einschmieren.“"
                                            },
                                            {
                                                "example_id": "53a2378e-3cd9-4a04-8151-f9661e8fe09c",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Obergärige Hefen sind zwar empfindlicher als untergärige, aber mit ihnen verläuft die Gärung deutlich schneller und ohne moderne Kühltechnik.“"
                                            },
                                            {
                                                "example_id": "a898190d-5850-443f-bdd4-214d038c1586",
                                                "sense_id": "c52e1a29-0c42-3ebb-ab46-576717a595a9",
                                                "text": "„Dubslav, sonst empfindlich gegen Zug, hatte die Thüren aufmachen lassen, und von dem großen Portal her zog ein erquicklicher Luftstrom bis auf die mit weiß und schwarzen Fliesen gedeckte Veranda hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "leicht, schnell beleidigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1744fa-1663-43d2-b817-bfafaae9faff",
                                                "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                                "text": "Man muss bei ihm sehr aufpassen, was man sagt: Er ist sehr empfindlich."
                                            },
                                            {
                                                "example_id": "5d3a2674-88f0-4e34-9fae-285a5e93c3b8",
                                                "sense_id": "35c9ace7-4300-3d16-9a29-c4dcd3263684",
                                                "text": "„Ihr Tod war genauso wenig ein Unfall, wie mein Hintern ein Unfall ist, sagte ich zu Svanhvít und hoffte, dass sie nicht empfindlich war, eine klitzekleine Portion grober Wortwahl zu ertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e558d2f8-ea41-35ac-9223-d3e7ca88d976",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "genau, präzise reagierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed392d5-4ab8-4914-ade0-a458bde8e500",
                                                "sense_id": "e558d2f8-ea41-35ac-9223-d3e7ca88d976",
                                                "text": "Dazu benötigt man ein empfindliches Messgerät."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e30cf20b-b902-3413-93ec-92c3f61da6b1",
                                        "entry_id": "43aa08bf-6848-3e7c-a146-703007c53f82",
                                        "glosses": [
                                            "sehr fühlbar, spürbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d312eb8e-27d0-492f-a3fb-4877f75cb223",
                                                "sense_id": "e30cf20b-b902-3413-93ec-92c3f61da6b1",
                                                "text": "Das gibt eine empfindliche Strafe."
                                            },
                                            {
                                                "example_id": "75264bfe-166d-4bac-9e35-511f86bf3f04",
                                                "sense_id": "e30cf20b-b902-3413-93ec-92c3f61da6b1",
                                                "text": "Die Arktis reagiert viel empfindlicher als andere Erdteile auf die globale Erwärmung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30273f62-79ef-4029-a55e-bacd41382b2e",
                        "source_entry_id": "43519c8f-6429-3b94-b8f8-b2cde319fb75",
                        "source_sense_id": "2d208da6-c66c-3c6b-b535-d22921ba2e5d",
