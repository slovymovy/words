                                            {
                                                "example_id": "d5c444f4-7478-4f20-885c-0870ad78cffe",
                                                "sense_id": "da018a45-f9b7-375d-9e4e-27b9ab2e8086",
                                                "text": "Pałeczki nosacizny wnikają do organizmu głównie poprzez przewód pokarmowy, dodatkowo mogą wnikać przez skórę"
