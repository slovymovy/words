                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a levé son <w>index</w> pour demander la parole en classe."
                        },
                        {
                            "text": "Il tenait une feuille fragile entre le pouce et l'<w>index</w>."
                        }
                    ],
                    "synonyms": [
                        "deuxième doigt",
                        "doigt II"
                    ],
                    "common_phrases": [
                        "pouce et index",
                        "lever l'index",
                        "pointer l'index"
