                                        "sense_id": "cd609348-32c8-3e1d-87d9-5dd0a5574746",
                                        "entry_id": "1937f038-5bf0-300b-ad88-c873bf9ee082",
                                        "glosses": [
                                            "A retail sales company or salesman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0d7161-ee95-411b-bc98-3e2997307763",
                                                "sense_id": "cd609348-32c8-3e1d-87d9-5dd0a5574746",
                                                "text": "Your market gardener is not a well-breeched man, dependant as he is on the imponderables of glut, the inequities of distribution, and the greeds of wholesaler and retailer."
                                            },
                                            {
                                                "example_id": "5b74fe56-0ca5-4286-8028-40aa59d99f61",
                                                "sense_id": "cd609348-32c8-3e1d-87d9-5dd0a5574746",
                                                "text": "Among Baum’s many incarnations were these: military school student, actor, poultry expert, newspaperman, retailer, window dresser, women’s rights advocate, racist denigrator of American Indians and early Hollywood filmmaker."
                                            },
                                            {
                                                "example_id": "f38de2bf-1457-448d-a9c2-13b254c3ad97",
                                                "sense_id": "cd609348-32c8-3e1d-87d9-5dd0a5574746",
                                                "text": "Publishers typically sell hardcover books to retailers at half the list price, while retailers set consumer prices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
