                                        "examples": [
                                            {
                                                "example_id": "60ece44e-b768-4880-ae4c-f383f1c752e7",
                                                "sense_id": "fb7a28ef-17f0-340b-a89c-ecee734f2a4c",
                                                "text": "And therewith Sir Launcelot gate all his armoure as well as he myght and put hit upon hym for drede of more resseite[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4234dba6-a516-3faf-88e6-3828d8bcf883",
                                        "entry_id": "49ffe91a-4104-3d9c-8016-7e72da3994b2",
                                        "glosses": [
                                            "A quantity or amount received; takings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2478135b-617c-473c-8e53-dd8f36921b8b",
                                                "sense_id": "4234dba6-a516-3faf-88e6-3828d8bcf883",
                                                "text": "This weekend's receipts alone cover our costs to mount the production!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7330c394-04eb-3230-85d9-beabed25de8a",
                                        "entry_id": "49ffe91a-4104-3d9c-8016-7e72da3994b2",
                                        "glosses": [
                                            "A written acknowledgment that a specified article or sum of money has been received."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13f11e1c-a668-3244-b48f-4633cd0fbbcc",
                                        "entry_id": "49ffe91a-4104-3d9c-8016-7e72da3994b2",
                                        "glosses": [
                                            "(A piece of) evidence, documentation, etc. to prove one's past actions, accomplishments, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dffe52f-5967-43b5-a40a-9bc295e034a1",
                                                "sense_id": "13f11e1c-a668-3244-b48f-4633cd0fbbcc",
                                                "text": "So, Andy, if you ask me nicely, I might produce a receipt that is my marriage certificate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e522b3f-179e-3c23-9224-05d637123739",
                                        "entry_id": "49ffe91a-4104-3d9c-8016-7e72da3994b2",
                                        "glosses": [
                                            "(A piece of) evidence (e.g. documentation or screen captures) of past wrongdoing."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d79517c-4ada-4a42-b8bf-b0a8a74d6bf8",
                                                "sense_id": "4e522b3f-179e-3c23-9224-05d637123739",
                                                "text": "\"Oh yes, the Internet trolls went there, and we've got the receipts\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "003344a6-fd6c-3644-af78-4adc7d300f59",
                                        "entry_id": "49ffe91a-4104-3d9c-8016-7e72da3994b2",
                                        "glosses": [
                                            "A recipe, instructions, prescription."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
