                "senses": [
                    {
                        "sense_id": "5cc0e78e-ecdb-3275-ad9a-08be2527ee78",
                        "entry_id": "96d49482-3549-36b0-8381-4921604cadec",
                        "glosses": [
                            "Schüler, den jemand am meisten mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306bfba7-fbca-40ac-974b-4db6f34375f3",
                                "sense_id": "5cc0e78e-ecdb-3275-ad9a-08be2527ee78",
                                "text": "„Die Überzeugung, dass Wissen und Bildung von entscheidender Bedeutung für junge Afrikaner seien, pflanzte er seinem Lieblingsschüler Mugabe ein, der später selbst über viele Jahre Lehrer war und sich in seinen Anfangsjahren als Premierminister besonders für die Ausweitung des staatlichen Bildungssystems engagierte.“"
                            },
                            {
                                "example_id": "e5cd37ad-25c9-47f6-9d30-51daefc79f3c",
                                "sense_id": "5cc0e78e-ecdb-3275-ad9a-08be2527ee78",
                                "text": "„Er war der Musterpfadfinder gewesen, der eine unter vielen. Der Chorknabe, der Lieblingsschüler irgendeines Lehrers, er war in die Polizeiwache Südost spaziert, hatte sich nach rechts und links umgeschaut, hinter vorgehaltener Hand geflüstert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
