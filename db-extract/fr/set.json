                "senses": [
                    {
                        "sense_id": "e6ba6253-0598-3ec9-9f42-367d675035b5",
                        "entry_id": "0f898528-305d-3404-971b-f8ed35d58b46",
                        "glosses": [
                            "Un des dieux de l’Égypte antique."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": [
                            {
                                "example_id": "a096744a-6b40-4e3b-8e8f-75a6102978ef",
                                "sense_id": "e6ba6253-0598-3ec9-9f42-367d675035b5",
                                "text": "Le scénario du musée s’articule autour du thème principal, qui est le mythe d’Isis, d’Osiris et du conflit entre Horus et Set, en plus d’éclairer un groupe de sujets tels que : L’histoire de la ville antique de Bouto, l’une des anciennes capitales égyptiennes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                "word": "set",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f12fc047-05d1-4d20-ba04-dceb4d889652",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "tags": [
                            "plural"
                        ],
                        "form": "sets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e06e385f-7f79-3e26-a4fb-e205d2c2a5c9",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Ensemble, trousse, équipement, assortiment."
                        ],
                        "tags": [],
                        "note": "Cet usage particulier, inspiré de l’anglais, est critiqué par l'OQLF, qui recommande d’y substituer ensemble, mobilier, lot ou trousseau",
                        "examples": [
                            {
                                "example_id": "7449cffa-d14b-4706-9da9-2cbe8493de9d",
                                "sense_id": "e06e385f-7f79-3e26-a4fb-e205d2c2a5c9",
                                "text": "Robin se rapprochait, en défaisant son paquet. Que dit-on de ce set de pelleteries, demanda-t-il ?"
                            },
                            {
                                "example_id": "ec0bf451-aba2-4239-9fb1-d5905d23f189",
                                "sense_id": "e06e385f-7f79-3e26-a4fb-e205d2c2a5c9",
                                "text": "Set de table, ensemble des napperons, des serviettes éventuellement assortis ensemble et à la nappe. Note : Cet usage particulier, inspiré de l’anglais, est critiqué par l'OQLF, qui recommande d’y substituer « ensemble de napperons »."
                            },
                            {
                                "example_id": "d03ba0a2-e2c7-47b7-8018-330c2f75b26f",
                                "sense_id": "e06e385f-7f79-3e26-a4fb-e205d2c2a5c9",
                                "text": "Une soupière fumante sur une nappe blanche (...). Le steak haché, les frites surgelées et les sets de table en plastique font très bien l'affaire pour l'ordinaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "0196ebbd-e045-3cd5-8016-ab07e12635bf",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Ensemble, trousse, équipement, assortiment.",
                            "Chacun de ces napperons, napperon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b74461ed-3fe5-3a27-b340-c4c5d5aef635",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Manche, partie d’un match."
                        ],
                        "tags": [],
                        "note": "Cet usage particulier, inspiré de l’anglais, est critiqué par l'OQLF, qui recommande d’y substituer manche",
                        "examples": []
                    },
                    {
                        "sense_id": "df18bf1f-6133-3c99-977d-b9ac63c1f462",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Manche, partie d’un match.",
                            "Au tennis, unité du score comportant au moins six jeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a61988c-c131-4b44-b01b-844355c61bb9",
                                "sense_id": "df18bf1f-6133-3c99-977d-b9ac63c1f462",
                                "text": "J'ai tout donné. Je suis allé encore plus loin : j'ai pris son service, cogné, sorti des aces, des volées, des passing-shots, tout l'arsenal. J'ai remporté le troisième set 6-3. Le match m'appartenait !"
                            }
                        ]
                    },
                    {
                        "sense_id": "3db835d6-5012-3287-938f-f0de3526d3f9",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Manche, partie d’un match.",
                            "Partie d'un match comptant onze points (anciennement 21 avant 2001) avec un écart final d'au moins deux points."
                        ],
                        "tags": [
                            "Tennis de table"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1f228aea-d18d-3049-9a46-8cc40981b904",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Manche, partie d’un match.",
                            "Partie d'un match comptant un minimum de quinze points avec un écart final d'au moins deux points."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f777b122-c882-42d3-a582-d98cc15a867c",
                                "sense_id": "1f228aea-d18d-3049-9a46-8cc40981b904",
                                "text": "Il aura fallu tout le génie de Fabiana (…), de Faure (…), et de Bouvier pour que les tricolores remontent à 13 partout, puis emportent le set."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6d22fe0-bc08-3cc1-8fca-638ce60a817c",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Plateau de télévision ou de cinéma."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e294d31a-df3d-4f24-b48c-ec2d8971d53a",
                                "sense_id": "b6d22fe0-bc08-3cc1-8fca-638ce60a817c",
                                "text": "Elle pénétra sur le « set » du STUDIO TROIS. Elle gardait de l’entrevue […] avec le nouveau magnat de la pellicule, un souvenir confus."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b9d8784-3a67-34d5-8347-730dee57db6c",
                        "entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "glosses": [
                            "Ensemble de morceaux joués par un même orchestre au cours d'un concert ou d'une soirée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07f49d8-fe62-4d5a-abf1-60a96f8d1e57",
                                "sense_id": "8b9d8784-3a67-34d5-8347-730dee57db6c",
                                "text": "Au Minton’s, on trouvait la formule habituelle des boîtes de jazz avec chaque soir un concert en plusieurs sets, entrecoupés de quelques numéros d’animations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "201d1996-5d5b-4aa5-b2e3-9bf4dc10d669",
                        "source_entry_id": "16eb621a-b3cb-358a-8e8e-40758d5d4f7a",
                        "source_sense_id": "e06e385f-7f79-3e26-a4fb-e205d2c2a5c9",
                        "source_sense_description": "Ensemble, trousse, équipement, assortiment.",
                        "target_lang_word": "Set",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Set",
