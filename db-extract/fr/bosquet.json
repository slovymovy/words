            {
                "entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
                "word": "bosquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e285c9c-ca9e-49fd-8101-ed4fdf31cee8",
                        "entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
                        "tags": [
                            "plural"
                        ],
                        "form": "bosquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                        "entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
                        "glosses": [
                            "Petit bois ; touffe d’arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d0a9e6-f760-4c85-93f4-cce543d6fd79",
                                "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                                "text": "Comme il y avait d’autres bosquets de cette sorte entre les grands chênes, je demandai pourquoi l’assassin avait choisi celui-ci plutôt que les autres."
                            },
                            {
                                "example_id": "6240e240-d84c-4b80-911d-1c5e0e9015d7",
                                "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                                "text": "La terre que l’aïeul paternel de Saint-Ybars, émigré du Canada en Louisiane, avait achetée en 1749, n’était alors qu’un désert dont le centre était occupé par un bosquet de chênes séculaires."
                            },
                            {
                                "example_id": "68b8eb0b-32b4-4e2d-9f27-2438c7cae518",
                                "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                                "text": "Le jardin est si dépouillé que rien ne cache plus l’insignifiance de ce qui est, ici, concédé à l’agrément : les carcasses des charmilles, les bosquets maigres grelottent sous la pluie éternelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "571e6ba1-fb9a-35ff-abfc-f44a0d0c06bf",
                        "entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
                        "glosses": [
                            "Pièce de jardin plantée d’arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "765c4b66-7e91-4316-9458-5de5d92ef749",
                                "sense_id": "571e6ba1-fb9a-35ff-abfc-f44a0d0c06bf",
                                "text": "Madame C*** se levait ordinairement vers les cinq heures du matin pour aller se promener dans un petit bosquet au bout de son jardin."
                            },
                            {
                                "example_id": "89bbe3e0-4346-4840-bd36-b7a04477b867",
                                "sense_id": "571e6ba1-fb9a-35ff-abfc-f44a0d0c06bf",
                                "text": "Ces arbrisseaux font aussi un très bel effet dans les bosquets et les boulingrins à cause de l’aspect de leurs fruits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24a79f8f-724e-4031-a51c-bffca298bf33",
                        "source_entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
                        "source_sense_description": "petit bois",
                        "target_lang_word": "Wäldchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wäldchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                        "entry_id": "4d2fdbd3-1e28-3c64-8583-c4c500bf9cc0",
                                        "glosses": [
                                            "kleiner Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edc24dd-4070-40a4-b18c-ade49b1abf5e",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "Er lebt in seinem Landhaus neben einem Wäldchen."
                                            },
                                            {
                                                "example_id": "153baa88-e5eb-4246-9931-ff2d9a932c56",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Der Fußgängerweg vorm Wäldchen führte zu einem Spielplatz, der für Babys war.“"
                                            },
                                            {
                                                "example_id": "452dc002-ee5e-4224-9cc1-d9478f596ce9",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Sie führte mich nach einer Premierenfeier in das Wäldchen, das neben ihrem (unbetretbaren) Studentenheim lag.“"
                                            },
                                            {
                                                "example_id": "c6b4bcec-24e7-4862-8354-5bd711e91d85",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Martin kümmerte sich um die Zugpferde, die sie weiter hinten in einem Wäldchen angepflockt hatten.“"
                                            },
                                            {
                                                "example_id": "b1e14731-7acb-4e8d-85dd-4cbaaee5e7e0",
                                                "sense_id": "78d72d80-b9b4-3834-bca0-25bce3ca1dc3",
                                                "text": "„Vor dem Mietshaus führt ein Feldweg in Richtung eines kleinen Wäldchens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3f1c255-a1bc-4116-91b4-7a1a7b004093",
                        "source_entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
