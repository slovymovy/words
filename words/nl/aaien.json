{
    "word_family": [
        "aai",
        "geaaid",
        "aaiend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f389a15e-e65e-3391-8afb-81b4310d8ffe",
                    "sense_definition": "zachtjes met de hand over iets of iemand heen strijken als teken van genegenheid",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liefkozen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine meisje wilde de zachte vacht van het konijn voorzichtig <w>aaien</w>.",
                            "target_lang_translations": {
                                "en": "The little girl wanted to carefully <w>pet</w> the rabbit's soft fur."
                            }
                        },
                        {
                            "text": "Onze hond kwispelt altijd met zijn staart als hij door de kinderen <w>geaaid</w> wordt.",
                            "target_lang_translations": {
                                "en": "Our dog always wags his tail when he is <w>petted</w> by the children."
                            }
                        }
                    ],
                    "synonyms": [
                        "strelen",
                        "aanhalen",
                        "liefkozen"
                    ],
                    "common_phrases": [
                        "over de bol aaien",
                        "een dier aaien"
                    ],
                    "target_lang_definitions": {
                        "en": "to gently move one's hand over something or someone as a sign of affection"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pet",
                                "target_lang_sense_clarification": "to stroke an animal"
                            },
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "to move the hand along a surface"
                            },
                            {
                                "target_lang_word": "caress",
                                "target_lang_sense_clarification": "to touch lovingly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7046a3ee-acb2-3d5d-be03-515c47eb16f8",
                    "sense_definition": "iets of iemand heel lichtjes aanraken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanraken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zachte wind leek de bladeren van de bomen teder te <w>aaien</w>.",
                            "target_lang_translations": {
                                "en": "The gentle wind seemed to tenderly <w>stroke</w> the leaves of the trees."
                            }
                        },
                        {
                            "text": "Zij voelde hoe de zijden stof haar huid heel lichtjes kwam te <w>aaien</w>.",
                            "target_lang_translations": {
                                "en": "She felt how the silk fabric came to <w>brush</w> her skin very lightly."
                            }
                        }
                    ],
                    "synonyms": [
                        "strelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to touch something or someone very lightly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "to touch lightly"
                            },
                            {
                                "target_lang_word": "brush",
                                "target_lang_sense_clarification": "to touch very lightly in passing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5eba3215-3c3b-3f89-8458-65afa823de9f",
                    "sense_definition": "iemand opzettelijk pijn doen of slaan",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pijn doen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pestkop zei dat hij de jongen even zou <w>aaien</w>, maar hij sloeg hem hard.",
                            "target_lang_translations": {
                                "en": "The bully said he would <w>clobber</w> the boy for a moment, but he hit him hard."
                            }
                        },
                        {
                            "text": "Pas maar op, of ik kom je dadelijk ook even stevig <w>aaien</w>.",
                            "target_lang_translations": {
                                "en": "Watch out, or I'll come and <w>rough</w> you up in a bit too."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "ironisch gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to intentionally hurt or hit someone (used ironically)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clobber",
                                "target_lang_sense_clarification": "to hit hard (ironic context)"
                            },
                            {
                                "target_lang_word": "rough up",
                                "target_lang_sense_clarification": "to treat someone violently"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16c9a7b2-2b3c-3dfd-a25d-d3d03cf23f03",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>aai</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanraking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat genoot zichtbaar van de vele <w>aaien</w> die hij van de bezoekers kreeg.",
                            "target_lang_translations": {
                                "en": "The cat visibly enjoyed the many <w>pets</w> he received from the visitors."
                            }
                        },
                        {
                            "text": "Na een paar zachte <w>aaien</w> over zijn kop viel de puppy eindelijk in slaap.",
                            "target_lang_translations": {
                                "en": "After a few gentle <w>strokes</w> on his head, the puppy finally fell asleep."
                            }
                        }
                    ],
                    "traits": [
