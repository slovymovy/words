                    {
                        "sense_id": "f590e6be-cfe1-3053-abbe-65080c74d794",
                        "entry_id": "5d37b28f-cdd5-3f91-9489-5880b45c321c",
                        "glosses": [
                            "Eigenschaft/Fähigkeit Nachkommen zu zeugen, sich fortpflanzen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc1a04d5-fa5f-495f-abae-cbd93007fd8a",
                                "sense_id": "f590e6be-cfe1-3053-abbe-65080c74d794",
                                "text": "„Unter biologischer Generativität versteht er die biologische Reproduktion, die Weitergabe von Genen, die Fortführung der genetischen Linie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a480689-46e6-3907-a001-043e44506661",
                        "entry_id": "5d37b28f-cdd5-3f91-9489-5880b45c321c",
                        "glosses": [
                            "Eigenschaft/Fähigkeit sich um andere als die eigene Generation zu kümmern; Verantwortungsübernahme für die vorausgehende und die nachfolgende Generation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c3515f-975f-43a9-9ab8-0bdd0fa27c75",
                                "sense_id": "6a480689-46e6-3907-a001-043e44506661",
                                "text": "„Mit Generativität bekommen SeniorInnen [sic] das Gefühl, von den Jüngeren gebraucht zu werden, denn die eigene Sterblichkeit wird von vielen als Kränkung erfahren, und es macht dann glücklich zu wissen, dass sie etwas hinterlassen können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
