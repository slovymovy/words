                "senses": [
                    {
                        "sense_id": "e65f0504-6984-37cb-8299-583a34e873c4",
                        "entry_id": "6d5a2162-2991-33d8-8ebf-5986d766ddb4",
                        "glosses": [
                            "iemand die een goede daad doet door iemand vooral financieël te helpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4be646d6-0622-4f03-8454-34f3f0e5bdd6",
                                "sense_id": "e65f0504-6984-37cb-8299-583a34e873c4",
                                "text": "Zo was de eenvoudige monnik uit Myra, die in de vierde eeuw plotseling in de geschiedenis kwam als de weldoener van alle mensen - en er korte tijd later weer uit verdween - nu in oost en west bekend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af4f0769-2343-4383-b6ea-6f3a6b46aae0",
                        "source_entry_id": "6d5a2162-2991-33d8-8ebf-5986d766ddb4",
                        "source_sense_id": "e65f0504-6984-37cb-8299-583a34e873c4",
                        "target_lang_word": "Wohltäter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohltäter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dad71b7-b935-3337-86b7-afad3fa38547",
                                        "entry_id": "5cdd5011-1d7f-37e6-a7df-b4aa0ff69990",
                                        "glosses": [
                                            "jemand, der gutes tut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8739dfd6-2923-4132-a286-3f404659906e",
                                                "sense_id": "6dad71b7-b935-3337-86b7-afad3fa38547",
                                                "text": "„Die drei Vermächtnisse, die in den Jahren 1989, 1991 und 1996 im hessischen Rechenschaftsbericht unter \"sonstigen Einnahmen\" verbucht sind, stammen allesamt von unbekannten Spendern. Die Nachlassverwalter in Liechtenstein und in der Schweiz halten strikt an der Anonymität der verstorbenen Wohltäter fest. Selbst in der CDU/CSU-Fraktion heißt es: \"Diese Gelder stinken zum Himmel.“"
                                            },
                                            {
                                                "example_id": "805f312b-2707-4498-9eab-68819e934530",
                                                "sense_id": "6dad71b7-b935-3337-86b7-afad3fa38547",
                                                "text": "„Die Wandlung von Geizhals Scrooge zum Wohltäter im alten London - glaubwürdig von Benjamin Stawicki gespielt - ist eine anrührende Geschichte, die auch heute noch aktuell ist.“"
                                            },
                                            {
                                                "example_id": "9db5992e-8364-455e-b4fb-1e1c4e7a6cab",
                                                "sense_id": "6dad71b7-b935-3337-86b7-afad3fa38547",
                                                "text": "„Diese prominenten, medienwirksamen Wohltäter bilden einen goldumrahmten Spiegel, der diese großen Ambitionen düster reflektiert.“"
                                            },
                                            {
                                                "example_id": "473cb907-2179-4731-bdde-86e14eebb290",
                                                "sense_id": "6dad71b7-b935-3337-86b7-afad3fa38547",
                                                "text": "„Sie war bereit, ihren Wohltätern alles zu opfern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93c0060f-5392-4109-b352-04e6eec74c91",
                        "source_entry_id": "6d5a2162-2991-33d8-8ebf-5986d766ddb4",
