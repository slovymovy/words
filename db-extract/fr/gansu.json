                        "sense_id": "a4308af9-8339-3552-8d18-a18a09a884bb",
                        "entry_id": "b23b3ff5-2c31-3395-916e-f6d393caa1b3",
                        "glosses": [
                            "Province de Chine dont la capitale est Lanzhou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eef7621-023f-4cf9-98e7-433eb3af1788",
                                "sense_id": "a4308af9-8339-3552-8d18-a18a09a884bb",
                                "text": "Dans le nord du Xinjiang évoluent des nomades de langues principalement turques. À l’est se situe la province chinoise de Gansu, couloir donnant accès à la Chine elle-même."
                            },
                            {
                                "example_id": "30feec70-98a8-472d-a25e-2ce0b1233b30",
                                "sense_id": "a4308af9-8339-3552-8d18-a18a09a884bb",
                                "text": "Le Gansu, l’une des régions les plus pauvres de Chine, longe la Mongolie au nord et le Xinjiang à l’ouest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d993103-e6d4-42b3-817a-476b4f452f8a",
                        "source_entry_id": "b23b3ff5-2c31-3395-916e-f6d393caa1b3",
