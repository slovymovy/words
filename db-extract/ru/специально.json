                                                "sense_id": "54d34a8a-8b68-3cc3-981d-7dc3b28dc6a0",
                                                "text": "She's specially good at running."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1f301e7-ac3d-3484-bae1-fe66220c63c3",
                                        "entry_id": "646d5756-faa7-3933-a1c6-9d413814dd64",
                                        "glosses": [
                                            "in particular"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed"
                                        ],
                                        "examples": [
