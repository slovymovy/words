                        "sense_id": "4c11f54e-5154-3cc3-87e1-36659bcd64e6",
                        "entry_id": "e61e7006-20c0-38a3-a347-7f7b067f2e95",
                        "glosses": [
                            "A scripting programming language most commonly used to add interactive features to webpages."
