                    "sense_definition": "Sad and dispirited; feeling downcast or disheartened.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked extremely <w>dejected</w> after hearing the disappointing news about his job application.",
