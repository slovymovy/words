                            {
                                "target_word": "buffalo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cd967db-9356-3be0-873f-9ea2af91ec92",
                                        "entry_id": "a8343be2-e8e2-3fcf-8a20-86d32814fba7",
                                        "glosses": [
                                            "To hunt buffalo."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8264123-9933-37ee-9507-f8cfce6927d6",
                                        "entry_id": "a8343be2-e8e2-3fcf-8a20-86d32814fba7",
                                        "glosses": [
                                            "To outwit, confuse, deceive, or intimidate."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b948e8-c83a-458b-b27a-7a8a2e32de63",
                                                "sense_id": "e8264123-9933-37ee-9507-f8cfce6927d6",
                                                "text": "I'm just gonna let you have it. Probably in the midst of a kiss. Right when you think everything’s been healed up. Right in the moment when you're sure you've got me buffaloed. That's when you'll die."
                                            },
                                            {
                                                "example_id": "1856fda0-87ce-457c-bdf6-0593463811db",
                                                "sense_id": "e8264123-9933-37ee-9507-f8cfce6927d6",
                                                "text": "The nontechnical administrator should never be buffaloed by the esoteric vocabulary and the endless jargon of the computer expert."
                                            },
                                            {
                                                "example_id": "73b84a77-91b6-4b78-9e28-178f20b25c98",
                                                "sense_id": "e8264123-9933-37ee-9507-f8cfce6927d6",
                                                "text": "He was speaking to an indifferent audience of pale polite faces, in an overheated space on the Northern edge of Europe, a subcontinent whose natives for a few passing centuries had bullied and buffaloed the rest of the world."
                                            },
                                            {
                                                "example_id": "a49fb650-554a-495f-b40f-3cdadb485fed",
                                                "sense_id": "e8264123-9933-37ee-9507-f8cfce6927d6",
                                                "text": "If nonfiction is where you do your best writing, or your best teaching of writing, don't be buffaloed into the idea that it's an inferior species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79251583-a43d-3df1-976f-119969627aa2",
                                        "entry_id": "a8343be2-e8e2-3fcf-8a20-86d32814fba7",
                                        "glosses": [
                                            "To pistol-whip."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bb1261b-ed1e-4a0f-adf7-bcc26668b93b",
                                                "sense_id": "79251583-a43d-3df1-976f-119969627aa2",
                                                "text": "Whereupon the twelve-inch barrel of the Buntline Special was laid alongside and just underneath the Rachal hatbrim most effectively. The buffaloed cattleman dropped to the walk, unconscious."
                                            },
                                            {
                                                "example_id": "6dbd556c-848b-4f0a-b6a6-6abc25b0a47e",
                                                "sense_id": "79251583-a43d-3df1-976f-119969627aa2",
                                                "text": "He walked arrogant and scornful among the Texans and cavalrymen whom he hazed and buffaloed with the barrels of his guns when they got out of line."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a74bd6b-3c69-4464-9c9a-e13a25fdc0f2",
                        "source_entry_id": "68b09fc7-9f76-33bf-a053-e878663cc18c",
                        "source_sense_id": "386c37dc-4c01-3a82-866b-375686417afa",
