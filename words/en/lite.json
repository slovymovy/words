        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49c3a7cc-50ef-3f8b-9e87-978218e9757c",
                    "sense_definition": "Containing fewer calories, less fat, or less alcohol than the standard version of a food or drink.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dietary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>lite</w> dinner consisted of crackers, some broccoli and a salad with <w>lite</w> ranch dressing.",
                            "target_lang_translations": {
                                "ru": "Его <w>легкий</w> ужин состоял из крекеров, брокколи и салата с <w>низкокалорийной</w> заправкой ранч.",
                                "zh": "他的<w>低卡</w>晚餐包括饼干、一些西兰花和一份配有<w>低脂</w>牧场沙拉酱的沙拉。",
                                "es": "Su cena <w>ligera</w> consistió en galletas saladas, algo de brócoli y una ensalada con aderezo ranch <w>light</w>."
                            }
                        },
                        {
                            "text": "I prefer drinking <w>lite</w> beer because it feels much less heavy than the regular version.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю пить <w>светлое облегченное</w> пиво, потому что оно кажется гораздо менее тяжелым, чем обычное.",
                                "zh": "我更喜欢喝<w>清淡</w>啤酒，因为它喝起来比普通啤酒感觉轻盈得多。",
                                "es": "Prefiero beber cerveza <w>light</w> porque se siente mucho menos pesada que la versión normal."
                            }
                        }
                    ],
                    "synonyms": [
                        "light",
                        "low-fat",
                        "low-calorie"
                    ],
                    "antonyms": [
                        "full-fat",
                        "heavy"
                    ],
                    "common_phrases": [
                        "lite beer",
                        "lite dressing",
                        "lite version"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in commercial branding"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий меньше калорий, жира или алкоголя, чем стандартная версия продукта или напитка.",
                        "zh": "指食品或饮料中热量、脂肪或酒精含量低于标准版本。",
                        "es": "Que contiene menos calorías, grasa o alcohol que la versión estándar de un alimento o bebida."
                    },
