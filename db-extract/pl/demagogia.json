                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74569fe1-6f5a-44e5-909d-7656234bf8e4",
                                                "sense_id": "193d172c-28b7-3ab3-b9ca-fc378cc9505e",
                                                "text": "Long before the energy crisis the debate over deregulation of natural gas prices raged stormily, stirring high emotions, demagogueries and mutual deceptions, and with literally billions of dollars at stake."
                                            },
                                            {
                                                "example_id": "5b614d95-4008-4ad3-a8b3-ac41c3b484ad",
                                                "sense_id": "193d172c-28b7-3ab3-b9ca-fc378cc9505e",
                                                "text": "The desire for politicians who are sincere explains not only the strategic value of demagoguery (and hence the campaign choices of candidates like Trump who may not in fact believe their own demagogic bombast)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912335bc-dbf5-37b7-83f9-5759b92e6c9a",
                                        "entry_id": "9ac16eb2-62b4-3166-908c-b61b40865a14",
                                        "glosses": [
                                            "Rhetoric that appeals to the prejudices of the people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
