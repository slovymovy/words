                        "glosses": [
                            "Rangée de saules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ec6807-23c7-4fd2-8e66-b73e342c6c78",
                                "sense_id": "5199a646-df7b-3b5b-9c9b-67ff2403acf3",
                                "text": "Il rêvait le long de cette saulée."
                            },
                            {
                                "example_id": "c5132d49-3733-451a-b86d-223a11285440",
                                "sense_id": "5199a646-df7b-3b5b-9c9b-67ff2403acf3",
                                "text": "Les mésanges et les bouvreuils se levaient sur leurs nids et montaient aux hautes branches ; les merles fuyaient brusquement dans un gros bruit de feuilles. Mais tous ces oiseaux n’allaient pas loin. Elle sentait qu’ils restaient là, cachés dans les saulées et les touffes de houx et qu’ils la regardaient avec inquiétude."
                            }
                        ]
                    }
