                    "sense_id": "f25125a1-a833-3fda-8ea5-808f0a610521",
                    "sense_definition": "Öffnung im unteren Teil des Gesichts bei Mensch und Tier, die zur Nahrungsaufnahme und Lautbildung dient",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte öffnen Sie den <w>Mund</w>, damit der Arzt die Zähne untersuchen kann."
                        },
                        {
                            "text": "Beim schnellen Laufen atmete das Kind tief durch den offenen <w>Mund</w>."
                        }
                    ],
                    "synonyms": [
                        "Maul",
                        "Schnauze",
                        "Schnute"
                    ],
                    "common_phrases": [
                        "den Mund öffnen",
                        "trockener Mund",
                        "mit vollem Mund"
                    ]
                },
                {
                    "sense_id": "efd57b40-6d4d-35d1-89fa-a19ba3636596",
                    "sense_definition": "Äußerung oder mündliche Mitteilung einer Person",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sprache",
                    "name_type": "no",
                    "examples": [
