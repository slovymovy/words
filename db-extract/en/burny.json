                "senses": [
                    {
                        "sense_id": "4120730c-08f8-3f0d-9c5a-a6db894776d2",
                        "entry_id": "1e87da3b-cddb-3b76-b5f8-fe9ceb874bbc",
                        "glosses": [
                            "Tending to burn."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8439b295-186e-4819-8848-6b44c245fee1",
                                "sense_id": "4120730c-08f8-3f0d-9c5a-a6db894776d2",
                                "text": "My eyes seem very burny, especially the right eye."
                            },
                            {
                                "example_id": "5ee6d39e-bc81-4edb-aa0c-d45fb5d4e4c2",
                                "sense_id": "4120730c-08f8-3f0d-9c5a-a6db894776d2",
                                "text": "I suppose I must have read them at some point, but mostly I came into contact with them by means of burnier-than-thou dialogues with old-timers—or anxious, status-conscious noobs—who wanted to point out all the ways in which my burn was the wrong sort of burn."
                            },
                            {
                                "example_id": "fc862ca0-dd66-4112-b8ce-9083c9c66db5",
                                "sense_id": "4120730c-08f8-3f0d-9c5a-a6db894776d2",
                                "text": "Though perhaps not quite “nothing but the truth”. April hadn't been burned. That dubious honour went to her mother. Finding out her husband of fifteen years had been seeing another woman for a decade of that time was about as burny as that kind of thing got."
                            },
                            {
                                "example_id": "26a0b82b-95b6-47ff-93fc-9addb4e5c51c",
                                "sense_id": "4120730c-08f8-3f0d-9c5a-a6db894776d2",
                                "text": "... with what you do and needs to go because it is weakening the message? Danger zone: Distinction matters, but be sure to choose the right distinction. The biggest burger may work like a charm. But the burniest onion rings probably wouldn't."
                            }
                        ]
                    },
                    {
                        "sense_id": "25dfe79f-b021-327b-ab10-6965b41c5555",
                        "entry_id": "1e87da3b-cddb-3b76-b5f8-fe9ceb874bbc",
                        "glosses": [
                            "Very hot."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "01772dca-2921-4716-9422-8d41bd743928",
                                "sense_id": "25dfe79f-b021-327b-ab10-6965b41c5555",
                                "text": "The lightbrown dust is very burny on my feet. Just have to put up with it, I suppose, ..."
                            },
                            {
                                "example_id": "5657d415-6066-4881-9f34-99dcf983722a",
                                "sense_id": "25dfe79f-b021-327b-ab10-6965b41c5555",
                                "text": "She lays the backs of her fingers against the girl's cheek — burny, rough — and blows on the sleeping face, rotating her head to let the breeze play over forehead, eyes, nose, cheeks, chin."
                            }
                        ]
                    }
