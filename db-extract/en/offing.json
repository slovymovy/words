    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4d63c1bc-9707-3dc3-a439-202dc21817ab",
                "word": "offing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "be701fd5-a57d-43b4-9ad3-553d807e9626",
                        "entry_id": "4d63c1bc-9707-3dc3-a439-202dc21817ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "offings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c3a0754-4bd2-3bdc-9153-3217985bea08",
                        "entry_id": "4d63c1bc-9707-3dc3-a439-202dc21817ab",
                        "glosses": [
                            "The area of the sea in which a ship can be seen in the distance from land, excluding the parts nearest the shore, and beyond the anchoring ground."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6356e71a-20a9-4394-8220-440c7fcce7b5",
                                "sense_id": "1c3a0754-4bd2-3bdc-9153-3217985bea08",
                                "text": "to see (a ship) in the offing"
                            },
                            {
                                "example_id": "cc10cfde-db30-49ac-ad85-b19d5d0eb1a4",
                                "sense_id": "1c3a0754-4bd2-3bdc-9153-3217985bea08",
                                "text": "I came to an Anchor in seven fathomes water in the offing to Sea."
                            },
                            {
                                "example_id": "0b7133be-f077-4da2-8136-9a031d632a80",
                                "sense_id": "1c3a0754-4bd2-3bdc-9153-3217985bea08",
                                "text": "September 30, 1659. I, poor miserable Robinson Crusoe, being shipwreck'd during a dreadful Storm, in the offing, came on Shore on this dismal, unfortunate Island, which I call'd the Island of Despair, all the rest of the Ship's Company being drown'd, and my self almost dead."
                            },
                            {
                                "example_id": "d01d44e1-4cad-4a2b-a8f1-44d5930a5f3e",
                                "sense_id": "1c3a0754-4bd2-3bdc-9153-3217985bea08",
                                "text": "That's the Grampus's crew. I seed her reported in the offing this morning; a three years' voyage, and a full ship."
                            },
                            {
                                "example_id": "5c949fd3-5d2e-4aaf-8b80-d6e3a336ee63",
                                "sense_id": "1c3a0754-4bd2-3bdc-9153-3217985bea08",
                                "text": "In the offing the sea and the sky were welded together without a joint […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "099de0d5-0bd7-3341-9e28-8155e888cb52",
                        "entry_id": "4d63c1bc-9707-3dc3-a439-202dc21817ab",
                        "glosses": [
                            "The distance that a ship at sea keeps away from land, often because of navigational dangers, fog and other hazards; a position at a distance from shore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6d6bcf-919b-4b63-a310-bcc6bc17b328",
                                "sense_id": "099de0d5-0bd7-3341-9e28-8155e888cb52",
                                "text": "[…] till I ſaw the Land tun out a great Length into the Sea, at about the Diſtance of four or five Leagues before me, and the Sea being very calm I kept a large, offing to make this Point; […]"
                            },
                            {
                                "example_id": "12a842d7-650d-4959-955c-d681fc76da6e",
                                "sense_id": "099de0d5-0bd7-3341-9e28-8155e888cb52",
                                "text": "However, what with the help of this Ebb, and our Boats, we by Noon had got an Offing of 1 1/2 or 2 Miles, yet we could hardly flatter ourselves with hopes of getting Clear […]"
                            },
                            {
                                "example_id": "969bf22c-a7a4-4001-89bf-7218aa86ec6b",
                                "sense_id": "099de0d5-0bd7-3341-9e28-8155e888cb52",
                                "text": "We beat off shore during the whole of the night, when the weather moderated, and at daybreak we found out that we had not gained much offing, in consequence of the current […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "6f18030f-2375-3fa2-8d88-23df011af087",
                        "entry_id": "4d63c1bc-9707-3dc3-a439-202dc21817ab",
                        "glosses": [
                            "The foreseeable future. Chiefly in the phrase in the offing."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
