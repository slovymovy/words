                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccd7cb9a-3bfd-3c45-a493-add70a0acc05",
                                        "entry_id": "5a4ebd69-0923-3cf9-a500-dcbf1c3e7d7e",
                                        "glosses": [
                                            "An old person, usually a man."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca9e9cdd-042e-435e-91ad-358c22056704",
                                                "sense_id": "ccd7cb9a-3bfd-3c45-a493-add70a0acc05",
                                                "text": "If thou return not, Gammer o'er her pail\nWill sing in sorrow, 'neath the brinded cow,\nAnd Gaffer sigh over his nut-brown ale […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9c10af5-c990-39fc-9030-d6857cf856c5",
                                        "entry_id": "5a4ebd69-0923-3cf9-a500-dcbf1c3e7d7e",
                                        "glosses": [
                                            "The leader of a group or team, such as a boss, foreman, coach, or publican."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1f66dfd-b55d-48c5-96d2-198c8517ef42",
                                                "sense_id": "d9c10af5-c990-39fc-9030-d6857cf856c5",
                                                "text": "And you're here to tell me what's what. Just like your bloody gaffer promised."
                                            }
