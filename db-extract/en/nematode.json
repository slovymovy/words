                                        "entry_id": "4f4f938f-e2b6-37ad-835a-700233963a1f",
                                        "glosses": [
                                            "relativ kleines, lang gestrecktes, weißes bis farbloses Tier, das sich je nach Art von Mikroben ernährt oder parasitär lebt, indem es Pflanzen, Tiere oder Menschen befällt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e59619d-d4e4-4ef0-9e03-e8da69ae2acf",
                                                "sense_id": "5458362c-dcb4-317a-83c9-a627b94ef4fe",
                                                "text": "„Um die weitere Ausbreitung des Japankäfers zu verhindern, setzt die Schweizer Großstadt Basel erstmals Fadenwürmer gegen den Schädling in öffentlichen Parks und Sportanlagen ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
