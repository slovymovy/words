                    "sense_id": "406874f0-648d-3375-b6b5-a3251fbf261e",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>случайный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adjective_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это странное совпадение вовсе не <w>случайно</w>.",
                            "target_lang_translations": {
                                "en": "This strange coincidence is not <w>accidental</w> at all.",
                                "es": "Esta extraña coincidencia no es en absoluto <w>casual</w>.",
                                "fr": "Cette étrange coïncidence n'est pas du tout un <w>hasard</w>."
                            }
                        },
                        {
                            "text": "Всё в этом мире закономерно и ничто не <w>случайно</w>.",
                            "target_lang_translations": {
                                "en": "Everything in this world is lawful and nothing is <w>accidental</w>.",
                                "es": "Todo en este mundo obedece a leyes y nada es <w>accidental</w>.",
                                "fr": "Tout dans ce monde obéit à des lois et rien n'est <w>accidentel</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Existing or happening by chance; not planned or intended (adjective form).",
                        "es": "Forma corta del adjetivo que indica que algo sucede por casualidad o no es intencionado.",
                        "fr": "Forme courte au neutre de l'adjectif « случайный » (fortuit, accidentel)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accidental",
                                "target_lang_sense_clarification": "adjective describing an event"
