                                "target_senses": [
                                    {
                                        "sense_id": "8de52421-13af-34ee-9989-f02ca73a0981",
                                        "entry_id": "0511d573-bedf-31c7-807e-15cd852d8f01",
                                        "glosses": [
                                            "die Geometrie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c51905-9d25-4c68-8e6f-debf13dc1a69",
                                                "sense_id": "8de52421-13af-34ee-9989-f02ca73a0981",
                                                "text": "„Zur Berechnung des Volumens und des Oberflächeninhalts vieler geometrischer Körper gibt es mathematische Formeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0135a48-21c1-3b74-92c5-807621adada0",
