{
    "word_family": [
        "scramble",
        "scrambler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06285857-f283-3396-8eba-2159b5818547",
                    "sense_definition": "present participle and gerund of <w>scramble</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military is <w>scrambling</w> jets to intercept the unidentified aircraft.",
                            "target_lang_translations": {
                                "cs": "Armáda <w>rychle vysílá</w> stíhačky k zachycení neidentifikovaného letadla."
                            }
                        },
                        {
                            "text": "He is <w>scrambling</w> eggs for breakfast in the kitchen.",
                            "target_lang_translations": {
                                "cs": "V kuchyni <w>míchá</w> vajíčka k snídani."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scrambling eggs",
                        "scrambling jets"
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium slovesa scramble (rychle se pohybovat, šplhat, míchat vajíčka, vysílat letadla)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rychlý přesun",
                                "target_lang_sense_clarification": "ve smyslu rychlého startu nebo pohybu"
                            },
                            {
                                "target_lang_word": "míchání",
                                "target_lang_sense_clarification": "při přípravě pokrmů"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "279548d0-dbdf-3444-a6bf-ea26a2c63829",
                    "sense_definition": "The act of mixing or confusing something, or moving quickly and awkwardly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scrambling</w> of the radio signal made the message impossible to understand.",
                            "target_lang_translations": {
                                "cs": "<w>Zmatení</w> rádiového signálu způsobilo, že zpráva byla nesrozumitelná."
                            }
                        },
                        {
                            "text": "After the alarm, there was a frantic <w>scrambling</w> to get out of the building.",
                            "target_lang_translations": {
                                "cs": "Po alarmu nastalo zběsilé <w>pobíhání</w> při snaze dostat se z budovy."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumble",
                        "disorder"
                    ],
                    "antonyms": [
                        "order",
                        "organization"
                    ],
                    "target_lang_definitions": {
                        "cs": "akt míchání, zmatení něčeho nebo rychlý a neohrabaný pohyb"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmatení",
                                "target_lang_sense_clarification": "např. signálu nebo dat"
                            },
                            {
                                "target_lang_word": "chaotický pohyb",
                                "target_lang_sense_clarification": "ve smyslu zmateného pobíhání"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5750aecf-5495-36fd-b476-e67adfefaae6",
                    "sense_definition": "Confused, irregular, or awkward in appearance or arrangement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house had a <w>scrambling</w> layout that made it difficult to navigate.",
                            "target_lang_translations": {
                                "cs": "Dům měl <w>chaotické</w> uspořádání, ve kterém bylo těžké se orientovat."
                            }
                        },
                        {
                            "text": "She kept her notes in a <w>scrambling</w> pile on her desk.",
                            "target_lang_translations": {
                                "cs": "Své poznámky měla na stole v <w>zmatené</w> hromadě."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorganized",
                        "chaotic"
                    ],
                    "antonyms": [
                        "orderly",
                        "neat"
                    ],
                    "target_lang_definitions": {
                        "cs": "zmatený, nepravidelný nebo neohrabaný vzhled či uspořádání"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chaotický",
                                "target_lang_sense_clarification": "ve smyslu neuspořádanosti"
                            },
                            {
                                "target_lang_word": "zmatený",
                                "target_lang_sense_clarification": "ve smyslu nejasného uspořádání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d260f269-3139-358c-9f29-78e0bbab3d3d",
                    "sense_definition": "Describing a plant that grows by leaning on or attaching to other plants for support.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scrambling</w> vines quickly covered the fence and the nearby bushes.",
                            "target_lang_translations": {
                                "cs": "<w>Popínavé</w> liány rychle pokryly plot a blízké keře."
                            }
                        },
                        {
                            "text": "Many tropical plants have a <w>scrambling</w> habit to reach sunlight in dense forests.",
                            "target_lang_translations": {
                                "cs": "Mnoho tropických rostlin má <w>popínavý</w> způsob růstu, aby dosáhly na sluneční světlo v hustých lesích."
                            }
                        }
                    ],
                    "synonyms": [
                        "climbing"
                    ],
                    "target_lang_definitions": {
                        "cs": "popisující rostlinu, která roste opíráním se o jiné rostliny nebo přichycováním se k nim"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "popínavý",
                                "target_lang_sense_clarification": "v botanickém smyslu"
                            },
                            {
                                "target_lang_word": "plazivý",
                                "target_lang_sense_clarification": "ve smyslu rostliny šířící se po podkladu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}