                "senses": [
                    {
                        "sense_id": "33ecf83a-e21d-3fee-ac4a-5695641429e9",
                        "entry_id": "21937c56-a99d-3cda-8b4f-6e3fd1df200a",
                        "glosses": [
                            "Angehöriger des gleichnamigen Volkes, das im antiken Reich Elam lebte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5553ffef-e5f0-4032-8dd7-ced715504032",
                                "sense_id": "33ecf83a-e21d-3fee-ac4a-5695641429e9",
                                "text": "„Ein ehemaliger Provinzgouverneur […] sicherte sich die Stadt Isin, von der aus er die Elamer aus Ur vertrieb und sich eines Teils des Kerngebiets des zerfallenen Reichs bemächtigte.“"
                            },
                            {
                                "example_id": "2c783599-e66a-410f-950e-c14a2b6b577d",
                                "sense_id": "33ecf83a-e21d-3fee-ac4a-5695641429e9",
                                "text": "„Die Elamer hatten ursprünglich wohl nicht ein dezimales, sondern ein Sexagesimalsystem, welches heute neben dem Dualsystem als Computer-Code verwendet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
