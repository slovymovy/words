        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b27e4389-d3c9-3736-86b1-65722c5fc09c",
                    "sense_definition": "A dog, especially a breed with a strong sense of smell used for hunting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hound</w> followed the scent of the fox through the dense forest.",
                            "target_lang_translations": {
                                "nl": "De <w>jachthond</w> volgde het spoor van de vos door het dichte bos."
                            }
                        },
                        {
                            "text": "The hunter trained his <w>hound</w> to track animals over long distances.",
                            "target_lang_translations": {
                                "nl": "De jager trainde zijn <w>jachthond</w> om dieren over grote afstanden op te sporen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een hond, vooral een ras met een sterk reukvermogen dat wordt gebruikt voor de jacht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "jachthond",
                                "target_lang_sense_clarification": "hond gebruikt voor de jacht"
                            },
                            {
                                "target_lang_word": "speurhond",
                                "target_lang_sense_clarification": "hond die sporen volgt via geur"
                            }
                        ]
