                        "glosses": [
                            "De façon factuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c17f1f8d-de52-497d-9753-fe031d35a499",
                                "sense_id": "60bf22b8-c69b-31e6-8000-da3446804c8b",
                                "text": "L’ambassadeur de France réagit aux éléments factuellement incorrects de l’article de Dagens Industri."
