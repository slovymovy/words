                "senses": [
                    {
                        "sense_id": "95b6411d-4725-321c-9b8c-66ec2cb58984",
                        "entry_id": "54bcb185-7c2d-32ff-bdbd-c647ee6eb118",
                        "glosses": [
                            "vorwiegend in Europa verbreitete Art des Steckers"
