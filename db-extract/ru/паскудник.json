                "senses": [
                    {
                        "sense_id": "2c44d19e-aa75-3c26-89cb-8233b6e69ba0",
                        "entry_id": "35fd3323-a5c0-3980-80f0-49526d70f0c3",
                        "glosses": [
                            "разг., груб. тот, кто делает мерзости, гадости; пакостник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09320f6-25b2-4819-83d9-4f32449e042e",
                                "sense_id": "2c44d19e-aa75-3c26-89cb-8233b6e69ba0",
                                "text": "— Говорил я тебе, что ты, Тебеньков, паскудник и засушина."
                            },
                            {
                                "example_id": "51acb68a-8440-433c-bd1d-c05312bf9d98",
                                "sense_id": "2c44d19e-aa75-3c26-89cb-8233b6e69ba0",
                                "text": "Перепуганные родители явились в полицию и, услышав о проделке сына, так и ахнули: — Ах он паскудник! Ах он разбойник эдакий!"
                            },
                            {
                                "example_id": "55d74f82-0524-493b-bffe-2929fc47540d",
                                "sense_id": "2c44d19e-aa75-3c26-89cb-8233b6e69ba0",
                                "text": "Выколотить из Ритки правду, да выволочь на свет божий паскудника, и мордой, мордой в его паскудство!"
                            }
                        ]
                    }
                ],
