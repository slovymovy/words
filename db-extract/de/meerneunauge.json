                                    {
                                        "sense_id": "a5bc937e-4215-30fd-81fa-75965821fb7d",
                                        "entry_id": "8cec13a9-f34d-3065-b4ad-81958238cb27",
                                        "glosses": [
                                            "Espèce d’agnathe de la Méditerranée, la Manche, l’Atlantique et des grands lacs d’Amérique du Nord, lamproie brune ou grise et marbrée sur le dos."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d956a904-df85-4459-9dd5-a56729f3876a",
                        "source_entry_id": "18c917d2-29ec-3fbb-97a7-361db4afe28a",
                        "source_sense_id": "bbb08579-f2db-3583-9af9-7406cf983368",
                        "target_lang_word": "lamproie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamproie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13ce3982-ef97-30b2-8bab-ec3147e61d39",
                                        "entry_id": "d2c6b3c4-0e85-33ba-a1ed-6233f785bf75",
                                        "glosses": [
                                            "Agnathe marin ou d'eau douce, de forme allongée et cylindrique, sans nageoires paires, à peau visqueuse sans écailles, filtreur à l'état larvaire et ectoparasite hématophage à l'état adulte et qui, au printemps, remonte les fleuves et les rivières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898f8f2c-e3dd-4b81-88d4-f42d23491342",
                                                "sense_id": "13ce3982-ef97-30b2-8bab-ec3147e61d39",
                                                "text": "Les poissons qu'on trouve dans la Charente sont la tanche, la truite, l’anguille, la plie, le barbeau, le chabot, l’âton, le dard, la brème, le goujon, l’ablette et l’écrevisse. Ceux qui remontent de la mer sont la lamproie, le meuil, qui s'arrêtent le plus ordinairement à Jarnac; la gathe, et rarement l’alose."
                                            },
                                            {
                                                "example_id": "64f4fada-b477-451c-a70a-cc5606d25d1a",
                                                "sense_id": "13ce3982-ef97-30b2-8bab-ec3147e61d39",
                                                "text": "Dans le monde actuel se trouvent l’amphioxus, l’animal vertébré dont l’organisme est le plus imparfait, et les lamproies, qui occupent le dernier rang parmi les poissons."
                                            },
                                            {
                                                "example_id": "8355a4d4-5c35-4c59-8edf-f6455d55e2cb",
                                                "sense_id": "13ce3982-ef97-30b2-8bab-ec3147e61d39",
                                                "text": "Bien plus, il ajoutait qu’ayant noyé ses lignes de fond, amorcées de fromage de Gruyère et de sang de bœuf, en aval de l’égout, il avait pris une de ces anguilles courtes, replètes et marquées de taches de feu qu’on rencontre en Loire entre Paimbœuf et Nantes, mais qui sont rares en Seine, autant que le merle blanc dans nos vergers : une lamproie, ce poisson cannibale, que les patriciens de Rome nourrissaient avec de la chair d’esclave."
                                            },
                                            {
                                                "example_id": "5d9b5b09-39d3-42ae-a64d-7fcd017b5ff8",
                                                "sense_id": "13ce3982-ef97-30b2-8bab-ec3147e61d39",
                                                "text": "Nous étions assis au fond du restaurant qui avait dû être une auberge à matelots et où l’on venait maintenant manger des coquillages, de la lamproie, des cèpes à la saison des cèpes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
