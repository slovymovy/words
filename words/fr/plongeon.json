                    ]
                },
                {
                    "sense_id": "70210f17-3af8-3b34-8a4e-fa23fd668f30",
                    "sense_definition": "Mouvement de descente rapide et brutale vers le bas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avion a effectué un brusque <w>plongeon</w> pour échapper aux turbulences de la tempête."
                        },
                        {
                            "text": "Le cours de l'action a fait un <w>plongeon</w> inattendu dès l'ouverture des marchés financiers ce matin."
