                                "sense_id": "1be0ab50-bb89-33d3-bb37-5b8a55484629",
                                "text": "Poznali się podczas wieczornicy zorganizowanej przez strażaków z Wisły."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
