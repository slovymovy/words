                    {
                        "sense_id": "e15d7529-7d4a-3d30-ace3-b706d08b4d1f",
                        "entry_id": "bf9ca9ee-149f-3b53-87eb-35232e8cc004",
                        "glosses": [
                            "vrouwelijke kat Felis sylvestris catus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2926a19a-7d2a-4d7d-9480-a49438a21e0c",
                                "sense_id": "e15d7529-7d4a-3d30-ace3-b706d08b4d1f",
                                "text": "Katten kweken er lustig op los en hebben talrijke welgevulde nesten. Plutarchus vertelt (zonder kritisch commentaar) dat de kattin volgens de Egyptenaren evenveel jongen ter wereld bracht als er dagen in de maan-maand zijn, dus 28, echter met dien verstande dat ze er bij de eerste worp één baart, bij de tweede worp twee, bij de derde drie enzovoort tot ze stopt bij 28."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b1a8d16-1a7c-33cb-8522-dc8c9ed14bbc",
                        "entry_id": "bf9ca9ee-149f-3b53-87eb-35232e8cc004",
                        "glosses": [
                            "vrouw die zich onvriendelijk gedraagt bijvoorbeeld door nare opmerkingen te maken"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "03b8496d-f1d5-4b9e-9cad-c1663f489441",
                                "sense_id": "9b1a8d16-1a7c-33cb-8522-dc8c9ed14bbc",
                                "text": "Hoe meer ik dat meisken bij ons zie, hoe kwader ik word op de kattin van onzen Fons."
                            }
                        ]
                    }
