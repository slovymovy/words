{
    "word_family": [
        "might",
        "mightily",
        "mightiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4e0d5f0-11c6-38dd-b409-d1abfd5c1db5",
                    "sense_definition": "Possessing great physical strength or power.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "strength_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mighty</w> warrior defeated all his enemies in battle.",
                            "target_lang_translations": {
                                "ru": "<w>Могучий</w> воин победил всех своих врагов в битве.",
                                "zh": "那位<w>强大</w>的战士在战斗中击败了所有敌人。"
                            }
                        },
                        {
                            "text": "A <w>mighty</w> storm caused significant damage to the coastal town.",
                            "target_lang_translations": {
                                "ru": "<w>Мощный</w> шторм нанес значительный ущерб прибрежному городу.",
                                "zh": "一场<w>猛烈</w>的风暴给沿海城镇造成了严重破坏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strong",
                        "powerful",
                        "robust",
                        "potent"
                    ],
                    "antonyms": [
                        "weak",
                        "feeble",
                        "powerless"
                    ],
                    "common_phrases": [
                        "mighty warrior",
                        "mighty army",
                        "mighty king",
                        "mighty hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий огромной физической силой или властью.",
                        "zh": "拥有巨大的体力或权力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "могучий",
                                "target_lang_sense_clarification": "обладающий большой физической силой (о людях, природе)"
                            },
                            {
                                "target_lang_word": "могущественный",
                                "target_lang_sense_clarification": "обладающий большой властью или влиянием"
                            },
                            {
                                "target_lang_word": "мощный",
                                "target_lang_sense_clarification": "обладающий большой силой или энергией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强大",
                                "target_lang_sense_clarification": "指力量或势力雄厚"
                            },
                            {
                                "target_lang_word": "有力",
                                "target_lang_sense_clarification": "指体力充沛或具有影响力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7432a7ed-aa05-39e7-95cc-a6fd6dca4bee",
                    "sense_definition": "Of great size, extent, or importance; imposing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size_magnitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stood in silence looking at the <w>mighty</w> mountain range ahead of us.",
                            "target_lang_translations": {
                                "ru": "Мы стояли молча, глядя на <w>величественную</w> горную цепь впереди нас.",
                                "zh": "我们静静地伫立着，凝望着前方<w>宏伟</w>的山脉。"
                            }
                        },
                        {
                            "text": "The <w>mighty</w> river flows through three different countries before reaching the sea.",
                            "target_lang_translations": {
                                "ru": "<w>Могучая</w> река протекает через три разные страны, прежде чем достичь моря.",
                                "zh": "这条<w>巨大</w>的河流在汇入大海前流经了三个国家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "huge",
                        "enormous",
                        "vast",
                        "immense",
                        "colossal"
                    ],
                    "antonyms": [
                        "tiny",
                        "small",
                        "insignificant"
                    ],
                    "common_phrases": [
                        "mighty river",
                        "mighty oak",
                        "mighty ocean"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огромного размера, протяженности или важности; внушительный.",
                        "zh": "规模、范围或重要性巨大；宏伟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "величественный",
                                "target_lang_sense_clarification": "производящий сильное впечатление своим видом"
                            },
                            {
                                "target_lang_word": "могучий",
                                "target_lang_sense_clarification": "огромный и внушительный (о реках, горах, деревьях)"
                            },
                            {
                                "target_lang_word": "громадный",
                                "target_lang_sense_clarification": "очень большой по размеру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏伟",
                                "target_lang_sense_clarification": "形容规模宏大"
                            },
                            {
                                "target_lang_word": "巨大",
                                "target_lang_sense_clarification": "形容体积或程度非常大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "214f9b0e-409e-31d4-82a7-d51b710cfdd7",
                    "sense_definition": "Characterized by great force, weight, or heavy impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strength_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lumberjack swung his axe with a <w>mighty</w> blow to split the log.",
                            "target_lang_translations": {
                                "ru": "Лесоруб размахнулся топором и нанес <w>мощный</w> удар, чтобы расколоть бревно.",
                                "zh": "伐木工挥动斧头，用<w>强劲</w>的一击劈开了圆木。"
                            }
                        },
                        {
                            "text": "With a <w>mighty</w> leap, the tiger jumped across the wide stream.",
                            "target_lang_translations": {
                                "ru": "<w>Мощным</w> прыжком тигр перепрыгнул через широкий ручей.",
                                "zh": "老虎纵身一跃，<w>猛烈</w>地跳过了宽阔的小溪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forceful",
                        "heavy",
                        "violent",
                        "powerful"
                    ],
                    "antonyms": [
                        "gentle",
                        "light",
                        "soft"
                    ],
                    "common_phrases": [
                        "mighty blow",
                        "mighty crash",
                        "mighty roar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся большой силой, тяжестью или мощным воздействием.",
                        "zh": "以巨大的力量、重量或强烈的冲击力为特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощный",
                                "target_lang_sense_clarification": "обладающий большой ударной силой"
                            },
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "значительный по степени проявления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛烈",
                                "target_lang_sense_clarification": "形容力量大且剧烈"
                            },
                            {
                                "target_lang_word": "强劲",
                                "target_lang_sense_clarification": "形容力量雄厚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ab92ea1-2eef-3877-a8f7-2543e2ca3bc0",
                    "sense_definition": "Extremely good or excellent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality_excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <w>mighty</w> meal you cooked for us last night.",
                            "target_lang_translations": {
                                "ru": "Ты приготовил нам вчера <w>отличный</w> ужин.",
                                "zh": "你昨晚为我们做的饭菜真是<w>极好</w>。"
                            }
                        },
                        {
                            "text": "It is a <w>mighty</w> pleasure to finally meet you in person.",
                            "target_lang_translations": {
                                "ru": "Для меня <w>огромное</w> удовольствие наконец встретиться с вами лично.",
                                "zh": "能亲自见到你真是<w>极其</w>荣幸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "great",
                        "wonderful",
                        "superb"
                    ],
                    "antonyms": [
                        "terrible",
                        "awful"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize approval"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хороший или превосходный.",
                        "zh": "极好或卓越。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличный",
                                "target_lang_sense_clarification": "очень хорошего качества"
                            },
                            {
                                "target_lang_word": "знатный",
                                "target_lang_sense_clarification": "разг. превосходный, замечательный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好",
                                "target_lang_sense_clarification": "质量非常高"
                            },
                            {
                                "target_lang_word": "出色",
                                "target_lang_sense_clarification": "表现优异"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3d40bbff-6a47-34c3-ae0a-7da319b2a0cc",
                    "sense_definition": "To a high degree; very.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>mighty</w> glad that you decided to join our team.",
                            "target_lang_translations": {
                                "ru": "Я <w>чертовски</w> рад, что вы решили присоединиться к нашей команде.",
                                "zh": "我<w>非常</w>高兴你决定加入我们的团队。"
                            }
                        },
                        {
                            "text": "It is getting <w>mighty</w> cold outside, so you should wear a coat.",
                            "target_lang_translations": {
                                "ru": "На улице становится <w>очень</w> холодно, так что тебе стоит надеть пальто.",
                                "zh": "外面变得<w>极其</w>寒冷，你应该穿上外套。"
                            }
                        }
                    ],
                    "synonyms": [
                        "very",
                        "extremely",
                        "really",
                        "awfully"
                    ],
                    "antonyms": [
                        "slightly",
                        "somewhat"
                    ],
                    "common_phrases": [
                        "mighty fine",
                        "mighty glad",
                        "mighty close"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in US regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В высокой степени; очень.",
                        "zh": "在很大程度上；非常。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "в значительной степени"
                            },
                            {
                                "target_lang_word": "чертовски",
                                "target_lang_sense_clarification": "разг. чрезвычайно, крайне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "程度副词"
                            },
                            {
                                "target_lang_word": "极其",
                                "target_lang_sense_clarification": "程度副词，强调程度之深"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dda1ee37-2a95-3b0f-becb-25057d832bbc",
                    "sense_definition": "A warrior or person of great strength and courage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_warrior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king called upon his <w>mighties</w> to defend the castle walls.",
                            "target_lang_translations": {
                                "ru": "Король призвал своих <w>витязей</w> защищать стены замка.",
                                "zh": "国王召集了他的<w>勇士</w>们来保卫城堡城墙。"
                            }
                        },
                        {
                            "text": "He was counted among the <w>mighties</w> of the ancient kingdom.",
                            "target_lang_translations": {
                                "ru": "Его причисляли к <w>сильнейшим</w> людям древнего королевства.",
                                "zh": "他被列为那个古老王国中的<w>强者</w>之一。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warrior",
                        "hero",
                        "champion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often found in biblical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воин или человек огромной силы и мужества.",
                        "zh": "拥有巨大力量和勇气的战士或人物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "витязь",
                                "target_lang_sense_clarification": "устар. храбрый воин, герой"
                            },
                            {
                                "target_lang_word": "храбрец",
                                "target_lang_sense_clarification": "смелый, мужественный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勇士",
                                "target_lang_sense_clarification": "勇敢的战士"
                            },
                            {
                                "target_lang_word": "强者",
                                "target_lang_sense_clarification": "指能力或力量出众的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}