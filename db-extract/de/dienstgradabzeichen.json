                        "glosses": [
                            "„äußerliche Kenntlichmachung des Dienstgrads eines Soldaten (meist gekennzeichnet durch Schulterklappen und Markierungen auf dem Ärmel)“"
                        ],
                        "tags": [],
                        "examples": [
