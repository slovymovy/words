                "senses": [
                    {
                        "sense_id": "885889a1-351b-35f2-8e3a-e8da0f0ec753",
                        "entry_id": "56bbcb70-5d9a-30b8-a76e-5fa0dff2f0eb",
                        "glosses": [
                            "Saft aus den Beeren des Holunders"
                        ],
                        "tags": [
                            "Austrian German",
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "16b0923c-c001-4c32-b3f1-8d10fe299df2",
                                "sense_id": "885889a1-351b-35f2-8e3a-e8da0f0ec753",
                                "text": "„Überhaupt Wien! Der Tafelspitz mundet ihm, den Mohr im Hemd nascht er und Hollersaft trinkt er literweise.“"
                            },
                            {
                                "example_id": "6ba933d8-2aa6-4cd1-a83f-93e19f607947",
                                "sense_id": "885889a1-351b-35f2-8e3a-e8da0f0ec753",
                                "text": "„Wo kann der Fremde (ob Piefke oder nicht) noch Wirga mit Grantn essen, Innsbrucker Knoblauchsuppe, Specknockn, Schlipfkrapfen als Hauptgericht und Nigilan zum Dessert? Wo kriegt er Vogelbeerschnaps und selbstgemachten Hollersaft?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
