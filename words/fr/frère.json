                },
                {
                    "sense_id": "d2316aaa-ae7e-37f1-8e60-d307fd1c60f1",
                    "sense_definition": "Religieux catholique membre d'un ordre monastique ou d'une congrégation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>frère</w> Martin s'occupe du jardin de l'abbaye chaque matin."
                        },
                        {
                            "text": "Ce monastère accueille une communauté de plusieurs <w>frères</w> franciscains."
                        }
                    ],
                    "antonyms": [
