                "senses": [
                    {
                        "sense_id": "3405bacd-49f2-3c24-9a58-58642e6d4763",
                        "entry_id": "98bf5e2e-c235-3bb1-859e-109a40212c57",
                        "glosses": [
                            "Réaliser les formalités de douane dans le pays d’origine plutôt que dans le pays de destination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cf62a1d-d5c1-48bc-9679-e3b12424f581",
                                "sense_id": "3405bacd-49f2-3c24-9a58-58642e6d4763",
                                "text": "Et de la même façon que nous prédédouanons les passagers à destination des Etats-Unis dans les aéroports canadiens, ne pouvons-nous pas prédédouaner les marchandises dans la salle d’expédition de l’usine?"
                            },
                            {
                                "example_id": "67e82113-1024-49d8-8f7f-1a0789b2e04e",
                                "sense_id": "3405bacd-49f2-3c24-9a58-58642e6d4763",
                                "text": "Le système informatique Champ a évolué dans sa fonctionnalité, permettant aux transitaires de prédédouaner leurs envois à bord de certains vols pour les États-Unis."
                            }
                        ]
                    }
