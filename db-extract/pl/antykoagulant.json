                ],
                "senses": [
                    {
                        "sense_id": "36bf778c-2c91-3f44-8fdd-09813bc35ee4",
                        "entry_id": "5d1c976c-ece7-3bf3-8bf2-fc13d193d6ec",
                        "glosses": [
                            "środek zmniejszający krzepliwość krwi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648eaa65-c8f5-46dd-894b-64ab6cff3021",
                                "sense_id": "36bf778c-2c91-3f44-8fdd-09813bc35ee4",
                                "text": "Lekarz i chory mają jedną z 3 możliwości: kontynuować leczenie doustnym antykoagulantem, zatrzymać terapię na okres okołozabiegowy lub zatrzymać leczenie doustnym antykoagulantem, stosując jednocześnie leczenie pomostowe heparyną niefrakcjonowaną lub drobnocząsteczkową."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da44df96-a7a3-419c-8630-86d8a6ee0a06",
                        "source_entry_id": "5d1c976c-ece7-3bf3-8bf2-fc13d193d6ec",
                        "source_sense_id": "36bf778c-2c91-3f44-8fdd-09813bc35ee4",
                        "target_lang_word": "anticoagulant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticoagulant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f2fea6-5194-3b68-a189-ee3fd80a4588",
                                        "entry_id": "899cd5e1-5c97-35e3-89c2-823824c07bbe",
                                        "glosses": [
                                            "A substance that prevents coagulation (stops blood from clotting); especially, any of a group of pharmaceutical drugs that reduce the clotting speed or affinity of the blood by any of several mechanisms (e.g., inhibiting platelet function, inhibiting clotting factor (protein) production or function, increasing antithrombin function)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c52b0cb3-91f1-42ed-8ffe-daeed24c33e6",
                                                "sense_id": "d8f2fea6-5194-3b68-a189-ee3fd80a4588",
                                                "text": "In the case of pathological hypercoagulative conditions such as thrombosis and embolism, 4-hydroxycoumarin based oral anticoagulants, including warfarin as a well-known example, are administered to block the enzymatic function of VKORC1, effectively diminishing turnover of the vitamin K cycle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticoagulant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8177089-a73e-3320-a658-0dfdf7a20943",
                                        "entry_id": "8edb8613-632c-3549-a377-e1e9409fb37a",
                                        "glosses": [
                                            "That prevents coagulation, that stops blood from clotting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68415ba6-a2d8-4902-b848-10a6debd3b24",
                                                "sense_id": "d8177089-a73e-3320-a658-0dfdf7a20943",
                                                "text": "The posologies employed require careful clinical and electrical supervision, and the same anticoagulant measures as for electrical cardioversion are necessary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d3fc4b4-269d-4178-8595-000ad83e3e2c",
                        "source_entry_id": "5d1c976c-ece7-3bf3-8bf2-fc13d193d6ec",
                        "source_sense_id": "36bf778c-2c91-3f44-8fdd-09813bc35ee4",
                        "target_lang_word": "anticoagulant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticoagulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98bb9f57-2d69-34a1-a024-d9cea940f62c",
                                        "entry_id": "edf21dcb-b17b-370e-8314-5bdb452c5290",
                                        "glosses": [
                                            "Qui empêche la coagulation."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77832207-0732-43e4-bb2f-cbfe23cb4d0b",
                                                "sense_id": "98bb9f57-2d69-34a1-a024-d9cea940f62c",
                                                "text": "L’action anticoagulante résultante de l’injection de la poudre totale doit donc être regardée ici comme la somme algébrique d’actions coagulantes et anticoagulantes multiples."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticoagulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5954a815-aaf5-37db-b9fe-8aa0eff5ceee",
                                        "entry_id": "ba6e9288-4317-312f-a323-b95fd3a1e25a",
                                        "glosses": [
                                            "Substance qui empêche la coagulation du sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a94c4498-92de-4d7f-a4f5-77912c99a45c",
                                                "sense_id": "5954a815-aaf5-37db-b9fe-8aa0eff5ceee",
                                                "text": "La tentation d’utiliser des doses minimes et inefficaces d’un anticoagulant oral doit être repoussée car un traitement de ce type est peut-être susceptible de créer un état d’hypercoagulabilité réactionnelle indésirable."
                                            },
                                            {
                                                "example_id": "ff30e54b-5dc0-4f98-886d-747df7bb3fdf",
                                                "sense_id": "5954a815-aaf5-37db-b9fe-8aa0eff5ceee",
                                                "text": "Des analyses a posteriori permettent cependant de définir des groupes à risque pour lesquels la prescription d’un anticoagulant peut être logique."
                                            },
                                            {
                                                "example_id": "2f8a9de0-8eae-41ec-936f-de424f557aab",
                                                "sense_id": "5954a815-aaf5-37db-b9fe-8aa0eff5ceee",
                                                "text": "On a fait de gros progrès depuis un an en montrant l’efficacité des anticoagulants et de certains stéroïdes, et on va continuer d’en grapiller un peu plus avec l’amélioration de l’arsenal thérapeutique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticoagulant",
                                "target_lang_code": "fr",
                                "target_senses": [
