                        ],
                        "form": "blocs-notes"
                    },
                    {
                        "form_id": "5c32bf15-7b58-4bf9-8a41-8bbfc25a180f",
                        "entry_id": "009e98eb-bc93-31d5-bfa2-1b0a706b5ced",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "bloc-note"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f4d2148-43fd-3309-88e1-89e2078b253c",
                        "entry_id": "009e98eb-bc93-31d5-bfa2-1b0a706b5ced",
                        "glosses": [
                            "Ensemble de feuilles accrochées d'un coté, faciles à détacher et qui sert à écrire des notes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bf6b8b-0e14-48bd-a731-4dcbe9ee5ae2",
                                "sense_id": "9f4d2148-43fd-3309-88e1-89e2078b253c",
                                "text": "Si nous pouvions relever ici nos communications transmises sur de petites feuilles blanches de bloc-notes, on serait étonné de la fréquence de nos relations."
                            }
                        ]
                    },
                    {
                        "sense_id": "c42188a9-c6e9-335c-8c6d-a41427e16907",
                        "entry_id": "009e98eb-bc93-31d5-bfa2-1b0a706b5ced",
                        "glosses": [
                            "Rubrique d'un journal ou d'un magazine dans lesquels il est écrit une suite d'échos et de réflexions personnelles."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b39e341-8ca9-3056-aeaf-fe40a6f2fdb0",
                        "entry_id": "009e98eb-bc93-31d5-bfa2-1b0a706b5ced",
                        "glosses": [
                            "Site sur la toile, souvent personnel, qui présente en ordre chronologique de courts articles ou notes, généralement accompagnés de liens vers d'autres sites."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73afd3e6-4009-4f3a-9899-92b1a721200f",
                        "source_entry_id": "009e98eb-bc93-31d5-bfa2-1b0a706b5ced",
                        "source_sense_description": "ensemble de feuilles",
                        "target_lang_word": "Notizbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notizbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                        "entry_id": "d7307eec-d441-3e03-9ac4-6af3c2afef50",
                                        "glosses": [
                                            "ein (manchmal kleines) Heft oder Buch mit leeren Seiten, in das Notizen eingetragen werden und Ideen, Ausschnitte und Skizzen gesammelt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea99ed6b-234c-4e0b-84a3-51f3ad3cac72",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "Der Kommissar holte sein Notizbuch hervor und schrieb sich Stichworte zu dem, was er eben gehört hatte, auf."
                                            },
                                            {
                                                "example_id": "82b21372-5867-4406-8e80-5510866514c5",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Im Eingangsamte wird die Waare zur Revision gestellt, nach der Quittung revidirt, diese, vor der Rückstellung an den Waarenführer, dann mit der Bescheinigung des Eingangs der Waare versehen, wenn sie ausdrücklich auf die Passage noch ein Mal durch das Inland gerichtet ist, und die Waare in das Notizbuch eingetragen.“"
                                            },
                                            {
                                                "example_id": "8e5e9200-57e5-4362-a737-276a383077d3",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Die Banditen durchsuchen seinen Tornister und finden nichts als Bücher, trockenes Brot, harten Käse, zwei Hemden und ein Notizbuch.“"
                                            },
                                            {
                                                "example_id": "3db8f30f-3809-40e9-9f16-4e1db652558f",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Ich steckte das kleine Notizbuch wieder in sein Versteck.“"
                                            },
                                            {
                                                "example_id": "fa62a7d0-783a-48db-aecb-865531130e05",
                                                "sense_id": "2e8b12b3-69ca-387d-9941-843d8d67c05a",
                                                "text": "„Ab und zu zog er ein Notizbuch aus der Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b45d372-fdd9-4721-9567-403a565150a6",
                        "source_entry_id": "009e98eb-bc93-31d5-bfa2-1b0a706b5ced",
                        "source_sense_description": "ensemble de feuilles",
                        "target_lang_word": "notebook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notebook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "A book in which notes or memoranda are written."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f661450-213c-41fc-a3b8-9206f8e320a5",
                                                "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                                "text": "With an unquenchable enthusiasm for locomotives and their work, at an early age I had commenced to keep engine and traffic-recording notebooks, compiled in a schoolboy's round hand."
                                            },
                                            {
                                                "example_id": "0157a3e9-dd49-4ada-8d39-fe4dc6d334b8",
                                                "sense_id": "3b774c05-3dfe-3434-9c89-9f56c1972e83",
                                                "text": "For Caſſius is a-weary of the World: / Hated by one he loues, brau'd by his Brother, / Check'd like a bondman, all his faults obſeru'd, / Set in a Note-booke, learn'd, and con'd by roate / To caſt into my Teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7f7f95-836f-3b9d-8f39-47f35b6926ec",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "A kind of user interface in literate programming, allowing calculations to be interspersed with human-readable comments, diagrams, etc."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd2549f-63de-4550-a6fc-2f2b9a683248",
                                                "sense_id": "cf7f7f95-836f-3b9d-8f39-47f35b6926ec",
                                                "text": "We have found the use of Jupyter notebooks to be a convenient way of sharing work and code in a compact and reproducible manner. Jupyter notebooks are easy to update and adapt over time compared to a static CD-ROM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898cce50-6c35-3728-82a1-b1dc45f9598d",
                                        "entry_id": "6956d866-b77a-34cd-b41a-96184181c4fe",
                                        "glosses": [
                                            "Ellipsis of notebook computer (“laptop computer”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "599f9bba-fd5d-4e01-9848-9aeb3a34ff61",
                                                "sense_id": "898cce50-6c35-3728-82a1-b1dc45f9598d",
                                                "text": "Over time, the difference in size between laptops and notebooks became a matter of no more than an inch or two in length and width, and a fraction of an inch in thickness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d71ddf24-0a3c-4c09-9908-68a17e59a828",
                        "source_entry_id": "009e98eb-bc93-31d5-bfa2-1b0a706b5ced",
