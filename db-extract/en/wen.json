            {
                "entry_id": "4f0d7fc7-3d72-3471-b787-9f6811e1407e",
                "word": "Wen",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "caef91ad-6698-3a40-9a4b-82e2487698bd",
                        "entry_id": "4f0d7fc7-3d72-3471-b787-9f6811e1407e",
                        "glosses": [
                            "A common surname from Chinese of east Asian derivation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34fe293-44a5-4cc2-85d0-dd5aee2d63cb",
                                "sense_id": "caef91ad-6698-3a40-9a4b-82e2487698bd",
                                "text": "To find out more, I spoke with CNN wellness expert Dr. Leana Wen. Wen, a mother of two young kids, is an emergency physician and adjunct associate professor at the George Washington University."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20c9a4d1-17ba-4a38-9215-b686366d5f31",
                        "source_entry_id": "4f0d7fc7-3d72-3471-b787-9f6811e1407e",
                        "source_sense_id": "caef91ad-6698-3a40-9a4b-82e2487698bd",
