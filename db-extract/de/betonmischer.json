                        "source_sense_id": "ebef99be-51f1-3e91-aefb-241caada784a",
                        "source_sense_description": "ein rotierender Kessel, der aus Zement und Wasser sowie Sand, Kies oder Splitt Beton herstellt",
                        "target_lang_word": "bétonnière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bétonnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "030041c4-5082-34fe-ad21-dfa7c2e21bc0",
                                        "entry_id": "2193367b-6d5c-3db2-95c9-50579e925e16",
                                        "glosses": [
                                            "Machine utilisée pour fabriquer le béton qui comprend une cuve tournante pour le malaxer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "591e7a84-f3b5-4198-933b-487899f8f4a0",
                                                "sense_id": "030041c4-5082-34fe-ad21-dfa7c2e21bc0",
                                                "text": "Cette pratique n’est pas acceptable car elle sous entend que les gâchées seront réhomogénéisées dans la bétonnière portée (une gâchée sèche pouvant compenser une gâchée humide), ce qui est tout à fait aléatoire."
                                            },
                                            {
                                                "example_id": "bdcf2d5c-7c74-44a5-ba29-f424153a04f9",
                                                "sense_id": "030041c4-5082-34fe-ad21-dfa7c2e21bc0",
                                                "text": "Les appels d’offres ont été passés, des fouilles ont d’ores et déjà débuté. Faites chauffer les bétonnières !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af7f5871-2482-4c99-8074-cd3d4116116f",
                        "source_entry_id": "8a52693c-076c-31c8-b1bf-7c8e186dd9ae",
                        "source_sense_id": "ebef99be-51f1-3e91-aefb-241caada784a",
                        "source_sense_description": "ein rotierender Kessel, der aus Zement und Wasser sowie Sand, Kies oder Splitt Beton herstellt",
                        "target_lang_word": "bétonneuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bétonneuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "328b3018-b670-3b39-9914-d1c148aa345c",
                                        "entry_id": "0c674eda-d1fc-31ec-8c82-e59e7dcac0ed",
                                        "glosses": [
                                            "Ouvrière qui fabrique du béton, qui coule du béton."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9c8d52e-a413-35e4-8319-512d29d1ea81",
                                        "entry_id": "0c674eda-d1fc-31ec-8c82-e59e7dcac0ed",
                                        "glosses": [
                                            "Variante de bétonnière."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c87a6d-6623-49fe-9c5f-51197ee4fd6e",
                                                "sense_id": "f9c8d52e-a413-35e4-8319-512d29d1ea81",
                                                "text": "Les dernières parcelles d’air immobile sont absorbées par la charge des machines du chantier, compresseuses, bétonneuses, défonceuses, scies mécaniques, mâchent et mastiquent l’air qui n’en peut plus."
                                            },
                                            {
                                                "example_id": "6a2db928-a8d6-4495-b7c3-c6aa7a82f1b1",
                                                "sense_id": "f9c8d52e-a413-35e4-8319-512d29d1ea81",
                                                "text": "Mais il y a pire… Si tu l’imaginais ! Les bétonneuses ! Ces cons-là se sont mis à voler des bétonneuses sur nos chantiers !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bétonneuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d876551e-fb36-35bd-b6fd-5c94ace4ac27",
                                        "entry_id": "c981d2fb-c27b-313d-9aa4-8fd673004021",
                                        "glosses": [
                                            "ou Féminin singulier de bétonneux"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80f1cb97-6887-4d1c-bd4d-db0d0a389db2",
                                                "sense_id": "d876551e-fb36-35bd-b6fd-5c94ace4ac27",
                                                "text": "[…] les uns situent d’emblée l’action de l’agence dans le champ de l’environnement et donc la présentent comme une alliée objective de la protection des milieux naturels ; les autres, parfois amers, ne cachent pas leur crainte de mener une action trop « bétonneuse » et insuffisamment soucieuse des espaces naturels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
