                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9d2e48-88b0-4093-8d66-c94c78a40e0f",
                                                "sense_id": "0d912741-f1ff-3377-8f97-faa4de00f264",
                                                "text": "Gott gilt als allwissend."
                                            },
                                            {
                                                "example_id": "7a2985cb-5e2f-4d73-ae38-6ec9389bf90c",
                                                "sense_id": "0d912741-f1ff-3377-8f97-faa4de00f264",
                                                "text": "Ich bin doch nicht allwissend!"
                                            },
                                            {
                                                "example_id": "7f273ede-0afe-43e7-8294-ca043d5cb434",
                                                "sense_id": "0d912741-f1ff-3377-8f97-faa4de00f264",
                                                "text": "„An dieser Stelle muß ich als beinahe allwissender Erzähler wieder in den Hintergrund treten und erneut den Blickwinkel Lucas Corsos einnehmen, denn Sie, lieber Leser, sollen die dramatischen Ereignisse […] genau so nachvollziehen können, wie er selbst sie erlebt und mir später geschildert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
