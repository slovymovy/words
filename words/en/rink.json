        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1e0d3ce-9779-375b-a293-4801d7672a06",
                    "sense_definition": "A prepared smooth area or sheet of ice used for ice skating, ice hockey, or curling.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "skating_surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children spent the cold winter afternoon gliding across the outdoor ice <w>rink</w>.",
                            "target_lang_translations": {
                                "ru": "Дети провели холодный зимний день, катаясь по открытому ледовому <w>катку</w>."
                            }
                        },
                        {
                            "text": "The local hockey team had to clear snow before they could use the frozen <w>rink</w>.",
                            "target_lang_translations": {
                                "ru": "Местной хоккейной команде пришлось расчистить снег, прежде чем выйти на замерзшую <w>площадку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ice rink"
                    ],
                    "common_phrases": [
                        "ice rink",
                        "skating rink",
                        "hockey rink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально подготовленная ровная ледяная площадка для катания на коньках, игры в хоккей или керлинг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каток",
                                "target_lang_sense_clarification": "ледовая площадка для катания"
                            },
                            {
                                "target_lang_word": "хоккейная площадка",
                                "target_lang_sense_clarification": "для игры в хоккей"
                            },
                            {
                                "target_lang_word": "ледовая арена",
                                "target_lang_sense_clarification": "спортивная площадка со льдом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dbf6d4f-e79f-34b6-81e8-41c24d92be23",
                    "sense_definition": "A smooth floor or designated surface specifically prepared for roller skating.",
