                                "target_word": "lave-vaisselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0b09d95-a381-3186-8fe1-c4e7c7beb7cb",
                                        "entry_id": "140db792-07aa-3e12-ae60-f3b23f99360b",
                                        "glosses": [
                                            "Machine à laver spécialisée pour le nettoyage de la vaisselle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887a9617-701c-4c4f-9e7d-b93a6655c15a",
                                                "sense_id": "b0b09d95-a381-3186-8fe1-c4e7c7beb7cb",
                                                "text": "Il vide le lave-vaisselle pendant qu'elle flâne à table en lisant le journal."
                                            },
                                            {
                                                "example_id": "17f35a1e-371a-455f-ac6f-de5119705cd7",
                                                "sense_id": "b0b09d95-a381-3186-8fe1-c4e7c7beb7cb",
                                                "text": "Cependant, vers 1973, l'usine fabrique quelque temps des lave-vaisselle et un peu plus tard des sèche-linge [Saglio et Bonamy, 1978]."
                                            },
                                            {
                                                "example_id": "83f4c946-d502-45a1-b07e-05e31841b1f2",
                                                "sense_id": "b0b09d95-a381-3186-8fe1-c4e7c7beb7cb",
                                                "text": "Vous lui dites de mettre son assiette sale dans le lave-vaisselle et il vous traite de nazi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
