                "senses": [
                    {
                        "sense_id": "af2ce65c-b2f5-3075-be91-2a5aad90ec3b",
                        "entry_id": "4b97a5ae-c960-3686-99e4-adfa16cb7ece",
                        "glosses": [
                            "стать слабее, незначительнее"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43de1960-b56f-4ea6-929c-7f8465ec3b89",
                                "sense_id": "af2ce65c-b2f5-3075-be91-2a5aad90ec3b",
                                "text": "А как только искусство стало профессией, то значительно ослабилось и отчасти уничтожилось главное и драгоценнейшее свойство искусства — его искренность."
                            }
                        ]
                    }
                ],
                "translations": [
