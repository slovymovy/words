                            }
                        },
                        {
                            "text": "Als toetje eten we vanavond <w>blanke</w> vla met slagroom.",
                            "target_lang_translations": {
                                "en": "For dessert tonight we are eating <w>plain</w> custard with whipped cream.",
                                "ru": "На десерт мы сегодня едим <w>светлый</w> заварной крем со взбитыми сливками.",
                                "pl": "Na deser zjemy dziś <w>jasny</w> budyń z bitą śmietaną.",
                                "de": "Als Nachtisch essen wir heute Abend <w>helle</w> Vanillepudding mit Schlagsahne.",
                                "fr": "Pour le dessert ce soir, nous mangeons de la crème dessert <w>claire</w> avec de la chantilly.",
                                "it": "Come dessert stasera mangiamo crema <w>chiara</w> con panna montata.",
                                "cs": "Jako dezert budeme dnes večer jíst <w>světlý</w> pudink se šlehačkou.",
                                "tr": "Bu akşam tatlı olarak krem şantili <w>açık renkli</w> muhallebi yiyoruz.",
                                "es": "De postre esta noche comemos natillas <w>claras</w> con nata montada.",
                                "zh": "今晚我们吃<w>原味</w>卡仕达酱配鲜奶油作为甜点。"
                            }
