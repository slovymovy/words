                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3600480-0d28-4ea1-86d0-9742ab413347",
                                                "sense_id": "6dd2b935-1c7a-3a3b-b6d0-e58b873b5590",
                                                "text": "De beschrijving van de dader kwam aardig overeen met de werkelijkheid."
                                            },
                                            {
                                                "example_id": "a458f9e7-e68a-4d77-8039-d1b4978fc247",
                                                "sense_id": "6dd2b935-1c7a-3a3b-b6d0-e58b873b5590",
                                                "text": "Je leest de beschrijvingen op de site in eerste instantie uit compassie."
                                            },
                                            {
                                                "example_id": "17ffb3e9-d3c5-4dac-b058-c5a755a92fbd",
                                                "sense_id": "6dd2b935-1c7a-3a3b-b6d0-e58b873b5590",
                                                "text": "Een paar dagen na dat bezoek vond ik via Google een beschrijving van de verkoop van houten lambriseringpanelen, afkomstig uit de consistorie van een kerk die was gesloopt in Voorburg."
