                {
                    "sense_id": "9759e0c4-7f07-396e-84ed-26119b5fbcd3",
                    "sense_definition": "a long, narrow, flat-bottomed boat with square ends, moved by a pole",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hired a <w>punt</w> for an hour to explore the quiet backwaters.",
                            "target_lang_translations": {
                                "ru": "Мы арендовали <w>плоскодонку</w> на час, чтобы исследовать тихие заводи.",
                                "zh": "我们租了一艘<w>平底船</w>，花了一个小时探索宁静的河道。"
                            }
                        },
                        {
                            "text": "The <w>punt</w> was filled with cushions and a picnic basket for the trip.",
                            "target_lang_translations": {
                                "ru": "<w>Лодка</w> была наполнена подушками и корзинами для пикника для прогулки.",
                                "zh": "这艘<w>平底船</w>里放满了靠垫和野餐篮，准备出发。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "river punt"
                    ],
                    "target_lang_definitions": {
                        "ru": "длинная узкая плоскодонная лодка с квадратными концами, приводимая в движение шестом",
                        "zh": "一种长而窄、平底且两端呈方形的船，靠撑杆推动"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плоскодонка",
                                "target_lang_sense_clarification": "тип лодки"
                            },
                            {
                                "target_lang_word": "пант",
                                "target_lang_sense_clarification": "английская лодка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平底船",
                                "target_lang_sense_clarification": "指用于撑船的特定船只"
                            }
                        ]
                    }
                },
                {
