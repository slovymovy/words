                                                "sense_id": "9ead7db3-6782-3f8c-9dd9-0194b4be74bb",
                                                "text": "„Schnell verbreitete sich unter den Sepoys die Nachricht, dass es sich um den Talg von Rindern oder Schweinen handele.“"
                                            },
                                            {
                                                "example_id": "e0d486db-0d08-46f1-9fa2-6fb2eccf8279",
                                                "sense_id": "9ead7db3-6782-3f8c-9dd9-0194b4be74bb",
                                                "text": "„Von 139000 Sepoys, den indigenen Soldaten in der britischen Armee Indiens, revoltierten alle bis auf eine kleine Minderheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
