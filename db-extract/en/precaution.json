                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32ab3baa-e49d-434d-89ac-9ea6e0541d99",
                        "source_entry_id": "64bba641-25c0-3399-bf5a-12ab127cc20f",
                        "source_sense_description": "A measure taken beforehand to ward off evil or secure good or success",
                        "target_lang_word": "voorzorgsmaatregel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorzorgsmaatregel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c218f96f-a8b8-3422-9dba-935c37c31d8c",
                                        "entry_id": "c6501e00-91c0-30e7-8ed3-19e4ce2ebcf4",
                                        "glosses": [
                                            "een handeling die je vooraf doet om te zorgen dat iets vervelends later niet kan gebeuren, vaak gedaan onder het motto 'voorkomen is beter dan genezen'"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60759111-9edd-414f-baad-21a3e0db52a8",
                                                "sense_id": "c218f96f-a8b8-3422-9dba-935c37c31d8c",
                                                "text": "Voor de deur is een stalen schot van 30 centimeter dik aangebracht dat voor de deur gerold wordt en dat vergrendeld wordt met een 10 centimeter dikke stalen pin. Het is een voorzorgsmaatregel die moet voorkomen dat in geval van een aardbeving - toch tamelijk zeldzaam in Zeeland - de gewone deur open zou gaan terwijl daar binnen zwaar stralend afval behandeld wordt.'."
                                            },
                                            {
                                                "example_id": "05d55747-d473-40d3-a062-aba06520860d",
                                                "sense_id": "c218f96f-a8b8-3422-9dba-935c37c31d8c",
                                                "text": "Het had natuurlijk een uur eerder moeten zijn, maar het was een voorzorgsmaatregel met in zijn achterhoofd dat het deze avond laat kon worden met een heleboel wijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cb56e96-ace9-4372-9474-374fb171ed5e",
                        "source_entry_id": "64bba641-25c0-3399-bf5a-12ab127cc20f",
                        "source_sense_description": "A measure taken beforehand to ward off evil or secure good or success",
                        "target_lang_word": "Vorsichtsmaßnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorsichtsmaßnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a03e55-236d-37d2-a687-ef4775d1fd03",
                                        "entry_id": "36d503cd-dbcb-3750-b705-707c8908be06",
                                        "glosses": [
                                            "Handlung, mit der denkbaren negativen Ereignissen vorgebeugt werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa2cf0c-07ff-418e-8080-6032174a199c",
                                                "sense_id": "e7a03e55-236d-37d2-a687-ef4775d1fd03",
                                                "text": "„Um keine Vorsichtsmaßnahme außer Acht zu lassen, schob ich den Riegel an der rückseitigen Tür des Wagens vor und zog die Vorhänge zu.“"
                                            },
                                            {
                                                "example_id": "a26e7ef0-9eb4-4a40-aa1e-b984447b628b",
                                                "sense_id": "e7a03e55-236d-37d2-a687-ef4775d1fd03",
                                                "text": "„Über eine weitere Vorsichtsmaßnahme war Justus gar nicht begeistert.“"
                                            },
                                            {
                                                "example_id": "f5d30287-00ea-48a5-8ac4-321a936c854d",
                                                "sense_id": "e7a03e55-236d-37d2-a687-ef4775d1fd03",
                                                "text": "„Das war eine Vorsichtsmaßnahme.“"
                                            },
                                            {
                                                "example_id": "7fc72852-faa6-4917-bbaf-b6ee9ddd9037",
                                                "sense_id": "e7a03e55-236d-37d2-a687-ef4775d1fd03",
                                                "text": "„Wenn nun trotz all dieser Vorsichtsmaßnahmen jemand zufällig an der Insel gelandet wäre, so hätte er sich mehrere hundert Schritt durch den fürchterlichsten Schilfbruch hindurcharbeiten müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
