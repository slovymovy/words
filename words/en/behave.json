{
    "word_family": [
        "behavior",
        "behaviour",
        "misbehave",
        "behavioral",
        "behavioural"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9acd977-b2a5-3db6-98bc-6f1ec7c6cdc1",
                    "sense_definition": "To act or conduct oneself in a specific manner.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>behaves</w> like a child whenever she is around.",
                            "target_lang_translations": {
                                "ru": "Он <w>ведёт себя</w> как ребёнок, когда она рядом.",
                                "zh": "每当她在场时，他就像个孩子一样<w>表现</w>得幼稚。"
                            }
                        },
                        {
                            "text": "My computer has been <w>behaving</w> strangely all morning.",
                            "target_lang_translations": {
                                "ru": "Мой компьютер всё утро странно <w>себя ведёт</w>.",
                                "zh": "我的电脑整个上午都<w>表现</w>得很反常。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "behave like",
                        "behave strangely",
                        "behave well"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя или поступать определённым образом.",
                        "zh": "以特定的方式行动或表现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести себя",
                                "target_lang_sense_clarification": "держать себя, действовать"
                            },
                            {
                                "target_lang_word": "поступать",
                                "target_lang_sense_clarification": "совершать действия или принимать решения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表现",
                                "target_lang_sense_clarification": "指人的行为或事物的运作状态"
                            },
                            {
                                "target_lang_word": "举止",
                                "target_lang_sense_clarification": "指人的言谈举止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09711e42-27ae-3fe5-b658-b3cdff8d349b",
                    "sense_definition": "To act in a polite or proper way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>behave</w> yourself when we visit your grandmother.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>вести себя прилично</w>, когда мы навестим твою бабушку.",
                                "zh": "我们去拜访你祖母时，你需要<w>守规矩</w>。"
                            }
                        },
                        {
                            "text": "The children promised to <w>behave</w> while we were gone.",
                            "target_lang_translations": {
                                "ru": "Дети обещали <w>вести себя хорошо</w>, пока нас не будет.",
                                "zh": "孩子们答应在我们离开期间会<w>表现良好</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "misbehave"
                    ],
                    "common_phrases": [
                        "behave yourself",
                        "learn to behave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соблюдать правила приличия, быть вежливым и послушным.",
                        "zh": "表现得体，遵守礼节或规矩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести себя хорошо",
                                "target_lang_sense_clarification": "быть послушным, не шалить"
                            },
                            {
                                "target_lang_word": "вести себя прилично",
                                "target_lang_sense_clarification": "соблюдать нормы этикета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "守规矩",
                                "target_lang_sense_clarification": "指遵守纪律或礼貌"
                            },
                            {
                                "target_lang_word": "表现良好",
                                "target_lang_sense_clarification": "指行为符合预期或礼仪"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}