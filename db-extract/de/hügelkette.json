                "senses": [
                    {
                        "sense_id": "8333a2ec-0dfd-3260-90dd-6e84ba6a7440",
                        "entry_id": "d4caae38-641d-3225-a610-c8f0049577ec",
                        "glosses": [
                            "eine Aneinanderreihung von Hügeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4947d9-5fbf-4114-ac6f-f43abe40f748",
                                "sense_id": "8333a2ec-0dfd-3260-90dd-6e84ba6a7440",
                                "text": "Der Kommandant befehligte die Truppen auf die gegenüberliegende Hügelkette zu verschieben."
                            },
                            {
                                "example_id": "c93f4008-3b70-4ebe-940f-13953c1bc07e",
                                "sense_id": "8333a2ec-0dfd-3260-90dd-6e84ba6a7440",
                                "text": "„Eingerahmt von einer Hügelkette ragen die spitzen Türme des jesidischen Tempels Lalisch zwischen den Baumkronen empor.“"
                            },
                            {
                                "example_id": "0a841950-7272-475c-9217-322ab69388d6",
                                "sense_id": "8333a2ec-0dfd-3260-90dd-6e84ba6a7440",
                                "text": "„Zwischen Hügelketten, Wiesen und Feldern unweit der bayrischen Stadt Windischeschenbach ragt ein stählerner, 83 Meter hoher Bohrturm in den Himmel. Geowissenschaftler haben hier mehr als neun Kilometer in die Tiefe gebohrt.“"
                            },
                            {
                                "example_id": "9ed9c93f-43ab-4091-8817-58eb7a8d222e",
                                "sense_id": "8333a2ec-0dfd-3260-90dd-6e84ba6a7440",
                                "text": "„Er zeigte auf eine Hügelkette, die sich auf der anderen Seite des Tals über die Baumkronen erhob.“"
                            },
                            {
                                "example_id": "29e041d5-3103-4b19-8cf8-a904ee54d635",
                                "sense_id": "8333a2ec-0dfd-3260-90dd-6e84ba6a7440",
                                "text": "„Zwei Reiter, die sie als Vorposten aufgestellt hatten, kamen nach Einbruch der Dunkelheit zum Biwakfeuer, um zu sagen, die Russen hätten die Hügelkette links der Straße geräumt und seien gänzlich verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dabfadb-d440-4af7-ab5d-50ded325d12a",
                        "source_entry_id": "d4caae38-641d-3225-a610-c8f0049577ec",
                        "source_sense_id": "8333a2ec-0dfd-3260-90dd-6e84ba6a7440",
