                "senses": [
                    {
                        "sense_id": "c5b4dd4e-daae-3e65-af60-563a44b9107b",
                        "entry_id": "7080af36-67ac-3785-98e5-b73670db5432",
                        "glosses": [
                            "Fahrrad ohne Oberrohr (Längsstange) für weibliche Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "783210bc-798c-450c-8356-0d7f36b67412",
                                "sense_id": "c5b4dd4e-daae-3e65-af60-563a44b9107b",
                                "text": "„Fakt ist, dass es nahezu ausschließlich Damenfahrräder sind, die vorne oder hinten einen praktischen Korb angebaut haben und die tatsächlich mit Einkäufen gefüllt werden.“"
                            },
                            {
                                "example_id": "b39c6316-2b83-4d16-bc3f-0500d6098ea2",
                                "sense_id": "c5b4dd4e-daae-3e65-af60-563a44b9107b",
                                "text": "In der letzten Zeit werden verstärkt Damenfahrräder gestohlen."
                            },
                            {
                                "example_id": "7c9f86b1-2e84-4456-8520-48bd6bff51e1",
                                "sense_id": "c5b4dd4e-daae-3e65-af60-563a44b9107b",
                                "text": "„Sicherlich war ich der erste Deutsche mit einem mintfarbenen Damenfahrrad auf einer abwärtsführenden Rolltreppe in Helsinki.“"
                            },
                            {
                                "example_id": "4930fca7-bcde-4357-bb59-59d50252b84f",
                                "sense_id": "c5b4dd4e-daae-3e65-af60-563a44b9107b",
                                "text": "„Sie sahen ihre Zukunft in Cottbus und nahmen die Damenfahrräder mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
