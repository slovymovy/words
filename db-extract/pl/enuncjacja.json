                                "target_senses": [
                                    {
                                        "sense_id": "518841f5-362e-308a-9fe4-884dc790b635",
                                        "entry_id": "021365a9-b94c-31ad-9cb2-502e3566ed5f",
                                        "glosses": [
                                            "торжественное заявление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bb7b5df-8dc9-43a7-8116-4d8a8733a033",
                                                "sense_id": "518841f5-362e-308a-9fe4-884dc790b635",
                                                "text": "Главной составляющей закона стали различные декларации в поддержку русского языка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f86e8bb7-1b1e-34fc-b4f4-5ae131c316d6",
                                        "entry_id": "021365a9-b94c-31ad-9cb2-502e3566ed5f",
                                        "glosses": [
                                            "официальный программный документ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cec9d7e-dc08-4a4c-9fe9-87fe7fefd6e6",
                                                "sense_id": "f86e8bb7-1b1e-34fc-b4f4-5ae131c316d6",
                                                "text": "Декларация прав человека."
                                            },
                                            {
                                                "example_id": "1f2eab4e-6aac-441b-8844-b8a055827915",
                                                "sense_id": "f86e8bb7-1b1e-34fc-b4f4-5ae131c316d6",
