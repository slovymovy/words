                    {
                        "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                        "entry_id": "f7b02fa2-5b59-319e-b81f-eec02bfe0623",
                        "glosses": [
                            "Weg entlang von Flüssen, der dazu dient, Schiffe von Hand oder mit Tieren flussaufwärts zu ziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "228058be-c71f-48de-b0f9-56ee7d65d4f5",
                                "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                                "text": "Der Treidelweg wechselt manchmal die Flussseite."
                            },
                            {
                                "example_id": "d214c086-7ca9-4acb-9ece-de43a9bd27af",
                                "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                                "text": "„Dort unten auf dem Treidelweg jenseits des Stromes schleppen Bomätschen einen Elbkahn stromaufwärts.“"
                            },
                            {
                                "example_id": "ce676e1f-b6cb-412d-afc2-1b29eca3797f",
                                "sense_id": "083f02ba-ac21-3aa6-8610-76cde0085091",
                                "text": "„Gern gingen wir auf den Uferdämmen und Treidelwegen der Flüsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe14106-79ec-4207-9549-6381f25fdaec",
