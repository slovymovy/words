{
    "word_family": [
        "canvasser",
        "canvassing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3888b5ac-36ec-3842-8ac0-ff2dfdc4e7cf",
                    "sense_definition": "A piece of heavy cloth stretched across a frame, used by artists as a surface for oil or acrylic painting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "art_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist spent hours preparing the <w>canvas</w> before applying the first layer of paint.",
                            "target_lang_translations": {
                                "ru": "Художник часами готовил <w>холст</w>, прежде чем нанести первый слой краски."
                            }
                        },
                        {
                            "text": "She bought a large <w>canvas</w> to start her new landscape project.",
                            "target_lang_translations": {
                                "ru": "Она купила большое <w>полотно</w>, чтобы начать свой новый проект пейзажа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blank canvas",
                        "oil on canvas",
                        "stretched canvas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок плотной ткани, натянутый на раму, используемый художниками в качестве основы для живописи маслом или акрилом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холст",
                                "target_lang_sense_clarification": "ткань для живописи"
                            },
                            {
                                "target_lang_word": "полотно",
                                "target_lang_sense_clarification": "основа для картины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2651b002-4dee-3bca-9f87-f21f49825852",
                    "sense_definition": "A strong, coarse, unbleached cloth made from hemp, flax, or cotton, used for making items like sails, tents, and bags.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors repaired the torn sails with heavy <w>canvas</w> and thick thread.",
                            "target_lang_translations": {
                                "ru": "Моряки починили порванные паруса плотной <w>парусиной</w> и толстыми нитками."
                            }
                        },
                        {
                            "text": "This durable <w>canvas</w> bag is perfect for carrying heavy groceries.",
                            "target_lang_translations": {
                                "ru": "Эта прочная <w>брезентовая</w> сумка идеально подходит для переноски тяжелых продуктов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "canvas bag",
                        "heavy canvas",
                        "canvas shoes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочная, грубая, неотбеленная ткань из конопли, льна или хлопка, используемая для изготовления парусов, палаток и сумок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парусина",
                                "target_lang_sense_clarification": "грубая ткань для парусов"
                            },
                            {
                                "target_lang_word": "брезент",
                                "target_lang_sense_clarification": "плотная водостойкая ткань"
                            },
                            {
                                "target_lang_word": "холст",
                                "target_lang_sense_clarification": "грубая ткань"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31443ae0-f076-3b11-883e-f318be8ceae2",
                    "sense_definition": "A tent or a collection of tents, often used to refer to the experience of camping or living outdoors.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers spent the cold winter night under <w>canvas</w> in the middle of the forest.",
                            "target_lang_translations": {
                                "ru": "Солдаты провели холодную зимнюю ночь в <w>палатках</w> посреди леса."
                            }
                        },
                        {
                            "text": "Living under <w>canvas</w> for a week made them appreciate the comforts of home.",
                            "target_lang_translations": {
                                "ru": "Жизнь в <w>палаточном лагере</w> в течение недели заставила их оценить домашний уют."
                            }
                        }
                    ],
                    "synonyms": [
                        "tent"
                    ],
                    "common_phrases": [
                        "under canvas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Палатка или группа палаток; часто используется для обозначения жизни в походных условиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палатка",
                                "target_lang_sense_clarification": "походное жилище"
                            },
                            {
                                "target_lang_word": "палаточный лагерь",
                                "target_lang_sense_clarification": "группа палаток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83a9d7c0-c364-3e94-b434-82ea795153e6",
                    "sense_definition": "A metaphorical background or basis upon which a creative work, story, or complex situation is built.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city's diverse culture provided a rich <w>canvas</w> for the filmmaker's latest documentary.",
                            "target_lang_translations": {
                                "ru": "Многообразная культура города послужила богатым <w>фоном</w> для последнего документального фильма режиссера."
                            }
                        },
                        {
                            "text": "The author uses the historical setting as a <w>canvas</w> for a series of character studies.",
                            "target_lang_translations": {
                                "ru": "Автор использует историческую обстановку как <w>канву</w> для серии психологических портретов героев."
                            }
                        }
                    ],
                    "synonyms": [
                        "background",
                        "backdrop",
                        "framework"
                    ],
                    "common_phrases": [
                        "broad canvas",
                        "rich canvas"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Метафорический фон или основа, на которой строится творческое произведение, история или сложная ситуация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полотно",
                                "target_lang_sense_clarification": "масштабное произведение"
                            },
                            {
                                "target_lang_word": "фон",
                                "target_lang_sense_clarification": "основа для сюжета"
                            },
                            {
                                "target_lang_word": "канва",
                                "target_lang_sense_clarification": "основа повествования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a7ff05b-377f-3cc9-8e83-2c5ec722e792",
                    "sense_definition": "In computing, a specific area on a screen or within a program where graphics and images can be drawn or displayed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer used the HTML5 <w>canvas</w> element to create the interactive animation.",
                            "target_lang_translations": {
                                "ru": "Разработчик использовал элемент <w>canvas</w> в HTML5 для создания интерактивной анимации."
                            }
                        },
                        {
                            "text": "You can drag and drop elements anywhere on the digital <w>canvas</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете перетаскивать элементы в любое место на цифровом <w>холсте</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital canvas",
                        "canvas element"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В программировании — область на экране или внутри программы, предназначенная для рисования или отображения графики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холст",
                                "target_lang_sense_clarification": "графическая область"
                            },
                            {
                                "target_lang_word": "канвас",
                                "target_lang_sense_clarification": "элемент HTML5"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9559b512-9bd8-3a64-9bb1-da1f7fdf0c0e",
                    "sense_definition": "A mesh of woven strands used as a base for needlework, such as cross-stitch or embroidery.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully counted the threads on the <w>canvas</w> before starting her embroidery.",
                            "target_lang_translations": {
                                "ru": "Она тщательно пересчитала нити на <w>канве</w>, прежде чем начать вышивку."
                            }
                        },
                        {
                            "text": "The needlepoint <w>canvas</w> was pre-printed with a beautiful floral pattern.",
                            "target_lang_translations": {
                                "ru": "На <w>канву</w> для вышивания был заранее нанесен красивый цветочный узор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "needlepoint canvas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сетчатая ткань из переплетенных нитей, используемая в качестве основы для рукоделия, например, вышивки крестиком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канва",
                                "target_lang_sense_clarification": "сетка для вышивания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4da3637f-a5f9-3b1a-9c69-fe6cab7d87c8",
                    "sense_definition": "To cover a surface or an object with canvas material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>canvas</w> the roof to protect the interior from the rain.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>закрыть брезентом</w> крышу, чтобы защитить внутренние помещения от дождя."
                            }
                        },
                        {
                            "text": "They decided to <w>canvas</w> the deck of the boat for the winter season.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>обтянуть парусиной</w> палубу лодки на зимний сезон."
                            }
                        }
                    ],
                    "synonyms": [
                        "cover"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность или объект брезентом или парусиной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обтягивать",
                                "target_lang_sense_clarification": "покрывать тканью"
                            },
                            {
                                "target_lang_word": "накрывать брезентом",
                                "target_lang_sense_clarification": "защищать материалом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}