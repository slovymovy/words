            "pos": "noun",
            "senses": [
                {
                    "sense_id": "290d3fd5-3802-362a-b33e-7118280cb799",
                    "sense_definition": "etenswaar of drinken met een zoete smaak, zoals snoep of gebak",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wil je wat <w>zoetigheid</w> op de boterham of liever iets hartigs?",
                            "target_lang_translations": {
                                "en": "Would you like something <w>sweet</w> on your sandwich or would you prefer something savory?"
                            }
                        },
                        {
                            "text": "Kinderen houden meestal erg van <w>zoetigheid</w> zoals snoepjes en chocolade.",
                            "target_lang_translations": {
                                "en": "Children usually love <w>sweets</w> such as candy and chocolate."
                            }
                        }
                    ],
                    "synonyms": [
                        "lekkers",
                        "snoepgoed",
                        "suikerwaren"
                    ],
                    "antonyms": [
                        "hartigheid"
                    ],
                    "common_phrases": [
                        "dol op zoetigheid",
                        "allerlei zoetigheid"
                    ],
                    "target_lang_definitions": {
                        "en": "food or drink with a sweet taste, such as candy or pastries"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweets",
                                "target_lang_sense_clarification": "confectionery and sugary snacks"
                            },
                            {
                                "target_lang_word": "sweet treats",
                                "target_lang_sense_clarification": "general term for sugary food items"
                            },
                            {
                                "target_lang_word": "candy",
                                "target_lang_sense_clarification": "specifically sugary confectionery"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0875bdf3-4a8a-31db-9281-5b653f26b95b",
                    "sense_definition": "de eigenschap van het zoet zijn of een overdreven vriendelijke houding",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overdreven <w>zoetigheid</w> in haar stem klonk niet erg oprecht.",
                            "target_lang_translations": {
                                "en": "The excessive <w>sweetness</w> in her voice did not sound very sincere."
                            }
                        },
                        {
                            "text": "De natuurlijke <w>zoetigheid</w> van deze rijpe vruchten is heerlijk.",
                            "target_lang_translations": {
                                "en": "The natural <w>sweetness</w> of these ripe fruits is delicious."
                            }
                        }
                    ],
                    "synonyms": [
                        "zoetheid",
                        "vriendelijkheid"
                    ],
                    "antonyms": [
                        "bitterheid",
                        "zuurheid"
                    ],
                    "target_lang_definitions": {
                        "en": "the quality of being sweet or an excessively friendly attitude"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweetness",
                                "target_lang_sense_clarification": "the quality of tasting sweet or being kind"
                            },
                            {
                                "target_lang_word": "sugary tone",
                                "target_lang_sense_clarification": "excessively sweet or insincere manner of speaking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d05f99a1-f27b-315d-beb2-ed17142033cf",
                    "sense_definition": "het aangenaam of prettig zijn van een situatie of karakter",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beleving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij genoten van de <w>zoetigheid</w> van het zorgeloze leven op het platteland.",
                            "target_lang_translations": {
                                "en": "They enjoyed the <w>sweetness</w> of the carefree life in the countryside."
                            }
                        },
                        {
                            "text": "Na alle ellende was de <w>zoetigheid</w> van de overwinning extra welkom.",
                            "target_lang_translations": {
                                "en": "After all the misery, the <w>sweetness</w> of victory was extra welcome."
                            }
                        }
                    ],
                    "synonyms": [
                        "aangenaamheid",
                        "genoegen"
                    ],
                    "antonyms": [
                        "onaangenaamheid"
                    ],
                    "target_lang_definitions": {
                        "en": "the pleasantness or sweetness of a situation or character"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweetness",
                                "target_lang_sense_clarification": "the pleasant quality of an experience"
                            },
                            {
                                "target_lang_word": "delight",
                                "target_lang_sense_clarification": "the pleasure derived from a situation"
                            }
                        ]
                    }
                }
            ]
