                                    {
                                        "sense_id": "1b0a0a6b-7c0b-3428-96c8-0cf03e9fd65e",
                                        "entry_id": "2eb8068a-b809-38dd-9db6-83ed7aed1303",
                                        "glosses": [
                                            "A small separate part or one of the compartments of a room, especially in a work environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7468253f-10ff-4d78-ab81-ed4d3cdea432",
                                                "sense_id": "1b0a0a6b-7c0b-3428-96c8-0cf03e9fd65e",
                                                "text": "Most libraries provide cubicles for quiet study."
                                            },
                                            {
                                                "example_id": "8520af7d-dc81-4829-bf0e-8c25b8b5b7e6",
                                                "sense_id": "1b0a0a6b-7c0b-3428-96c8-0cf03e9fd65e",
                                                "text": "Two men who were in the baths at the time of the fire, who preferred to remain anonymous, told GCN that they were asleep in a cubicle on the fourth floor when they awoke to the smell of smoke."
                                            },
                                            {
                                                "example_id": "049559e2-94f2-4fcf-b6f6-58a2a0cb48c4",
                                                "sense_id": "1b0a0a6b-7c0b-3428-96c8-0cf03e9fd65e",
                                                "text": "I sit in a cubicle and I update bank software for the 2000 switch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03713198-4776-364e-ad2c-3dcb9fa97339",
                                        "entry_id": "2eb8068a-b809-38dd-9db6-83ed7aed1303",
                                        "glosses": [
                                            "A small enclosure at a swimming pool etc. used to provide personal privacy when changing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "729dc643-ea99-39e6-b319-a6df51536e12",
                                        "entry_id": "2eb8068a-b809-38dd-9db6-83ed7aed1303",
                                        "glosses": [
                                            "A small enclosure in a public toilet for individual use."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb838765-9676-440c-8f5f-596bd04038d7",
                                                "sense_id": "729dc643-ea99-39e6-b319-a6df51536e12",
                                                "text": "With more urinals than cubicles, men - unlike women - rarely queue, a Royal Society for Public Health report says."
                                            },
                                            {
                                                "example_id": "84852ef2-07ec-490c-b3f3-a717c3088e31",
                                                "sense_id": "729dc643-ea99-39e6-b319-a6df51536e12",
                                                "text": "The toilets will have weight-sensitive floors to make sure only one person is using each cubicle at a time."
                                            }
