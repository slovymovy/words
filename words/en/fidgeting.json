{
    "word_family": [
        "fidget",
        "fidgety"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8bb7bc9e-a4f9-3e99-91cb-b109aa9dff9f",
                    "sense_definition": "Present participle and gerund of <w>fidget</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was <w>fidgeting</w> in his seat because he was bored.",
                            "target_lang_translations": {
                                "nl": "Het kind zat te <w>wiebelen</w> op zijn stoel omdat hij zich verveelde."
                            }
                        },
                        {
                            "text": "Stop <w>fidgeting</w> with your pen while I am trying to speak.",
                            "target_lang_translations": {
                                "nl": "Stop met <w>friemelen</w> aan je pen terwijl ik probeer te praten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fidgeting with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle and gerund form of the verb fidget."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het maken van kleine, rusteloze bewegingen met het lichaam of met voorwerpen, vaak door verveling of nervositeit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "friemelen",
                                "target_lang_sense_clarification": "vaak gebruikt voor het onrustig spelen met voorwerpen of kleding"
                            },
                            {
                                "target_lang_word": "wiebelen",
                                "target_lang_sense_clarification": "vaak gebruikt voor het onrustig bewegen van het lichaam of op een stoel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d6d66ec-a81f-35d8-8c5a-d893e1c29700",
                    "sense_definition": "A restless or nervous movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her constant <w>fidgeting</w> made it difficult for others to concentrate.",
                            "target_lang_translations": {
                                "nl": "Haar constante <w>gewiebel</w> maakte het voor anderen moeilijk om zich te concentreren."
                            }
                        },
                        {
                            "text": "The nervous <w>fidgeting</w> of the witness revealed his anxiety.",
                            "target_lang_translations": {
                                "nl": "Het nerveuze <w>gefriemel</w> van de getuige verraadde zijn angst."
                            }
                        }
                    ],
                    "synonyms": [
                        "restlessness",
                        "twitching"
                    ],
                    "antonyms": [
                        "stillness"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een rusteloze of nerveuze beweging."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gewiebel",
                                "target_lang_sense_clarification": "het herhaaldelijk onrustig bewegen"
                            },
                            {
                                "target_lang_word": "gefriemel",
                                "target_lang_sense_clarification": "het herhaaldelijk onrustig spelen met de handen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}