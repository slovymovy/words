                "senses": [
                    {
                        "sense_id": "2c91d596-c5f3-31b5-ac71-fe2d85d976fb",
                        "entry_id": "a5581f49-5ebe-33ec-815a-4f20a63d8b92",
                        "glosses": [
                            "Amtsbezeichnung in Strafverfolgungsbehörden"
                        ],
                        "tags": [
                            "Großbritannien",
                            "Commonwealth"
                        ],
                        "examples": [
                            {
                                "example_id": "3f8c416b-8b8b-4903-9f73-dc1c78f9b14b",
                                "sense_id": "2c91d596-c5f3-31b5-ac71-fe2d85d976fb",
                                "text": "„Es gibt Dutzende von Constables, die die Zeugenaussagen aufgenommen haben, doch nur die Detectives arbeiten am Tatort.“"
                            },
                            {
                                "example_id": "1f043096-514e-4359-b622-7ba463c36dce",
                                "sense_id": "2c91d596-c5f3-31b5-ac71-fe2d85d976fb",
                                "text": "„Auf dem Rasen versuchte ein farbiger Constable in Uniform, ihn aufzuhalten.“"
                            },
                            {
                                "example_id": "f8c8a498-bf60-42f7-84ff-bf4e4db2e7d5",
                                "sense_id": "2c91d596-c5f3-31b5-ac71-fe2d85d976fb",
                                "text": "„Zwar verfügte er nur über eine kleine Polizeistation, die so heruntergekommen war wie ein streunender Hund, zwei Constables und ein altes Polizeiauto, das nicht immer ansprang, aber dennoch wandten sich die Leute an Fiti, sobald es Schwierigkeiten gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "576ac359-73d9-4d2d-af37-40d5f0fd1274",
                        "source_entry_id": "a5581f49-5ebe-33ec-815a-4f20a63d8b92",
                        "source_sense_id": "2c91d596-c5f3-31b5-ac71-fe2d85d976fb",
