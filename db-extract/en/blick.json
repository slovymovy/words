                "senses": [
                    {
                        "sense_id": "9ae8d059-be3f-34c4-a730-c264568de9e6",
                        "entry_id": "31f72a48-1ed7-3096-8917-9f8a327e83de",
                        "glosses": [
                            "To shine, gleam."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4bef9c20-0fe4-4bb3-8826-fb0354b8df6a",
                                "sense_id": "9ae8d059-be3f-34c4-a730-c264568de9e6",
                                "text": "Shirley Steynes Bluey took a deep breath as he entered the main street; nothing new under the sun-lamp as white pinks blicked across the street in a line of heat-glazed asterisks"
                            },
                            {
                                "example_id": "731b7399-6f14-42e6-9e9d-b46156695668",
                                "sense_id": "9ae8d059-be3f-34c4-a730-c264568de9e6",
                                "text": "The lancing sunlight blicked sharps of light from the scattering of sand on the marble of the plinth."
                            }
                        ]
                    },
                    {
                        "sense_id": "9328495d-3bf6-3ccb-8b48-9549b46233d1",
                        "entry_id": "31f72a48-1ed7-3096-8917-9f8a327e83de",
                        "glosses": [
                            "To make, or cause to make, a soft, crisp sound."
                        ],
                        "tags": [
                            "ambitransitive",
                            "nonce-word"
                        ],
                        "examples": [
                            {
                                "example_id": "b53526fe-6203-4937-9288-9434d0096a44",
                                "sense_id": "9328495d-3bf6-3ccb-8b48-9549b46233d1",
                                "text": "The recorder blicked off, and the tape hissed to the end of the reel in silence."
                            },
                            {
                                "example_id": "8ca84546-9d4c-4344-bc4e-92cef47da14f",
                                "sense_id": "9328495d-3bf6-3ccb-8b48-9549b46233d1",
                                "text": "He pulled out a cigarette lighter and blicked it."
                            },
                            {
                                "example_id": "88ea61f8-6084-407a-9e7d-4f6f154b5d6f",
                                "sense_id": "9328495d-3bf6-3ccb-8b48-9549b46233d1",
                                "text": "On her first day, as she walked into work[…][s]he blicked-in at the time clock[…]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
