{
    "word_family": [
        "jargoneer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5f5ddc6-8790-3b47-9ef9-b13e9ec1b160",
                    "sense_definition": "A technical terminology unique to a particular subject.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "language_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manual is full of technical <w>jargon</w> that is difficult for beginners to understand.",
                            "target_lang_translations": {
                                "zh": "这本手册里充满了初学者难以理解的专业<w>术语</w>。"
                            }
                        },
                        {
                            "text": "Avoid using complex <w>jargon</w> when explaining your project to the general public.",
                            "target_lang_translations": {
                                "zh": "向公众解释你的项目时，要避免使用复杂的<w>行话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminology"
                    ],
                    "common_phrases": [
                        "technical jargon"
                    ],
                    "target_lang_definitions": {
                        "zh": "特定领域或学科中使用的专业术语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "术语",
                                "target_lang_sense_clarification": "指特定学科或行业中使用的专门词汇。"
                            },
                            {
                                "target_lang_word": "行话",
                                "target_lang_sense_clarification": "指特定行业或群体内部使用的专业用语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b86e97f-a6a4-3233-8168-6263209811d0",
                    "sense_definition": "A language characteristic of a particular group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "language_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secret society developed its own <w>jargon</w> to communicate without being overheard by outsiders.",
                            "target_lang_translations": {
                                "zh": "那个秘密社团开发了一套自己的<w>黑话</w>，以便在不被外人偷听的情况下进行交流。"
                            }
                        },
                        {
                            "text": "Each professional field has its own <w>jargon</w> that defines the group identity.",
                            "target_lang_translations": {
                                "zh": "每个专业领域都有其独特的<w>行话</w>，用以界定该群体的身份。"
                            }
                        }
                    ],
                    "synonyms": [
                        "argot",
                        "cant",
                        "intalk",
                        "lingo"
                    ],
                    "antonyms": [
                        "vernacular"
                    ],
                    "target_lang_definitions": {
                        "zh": "特定群体所使用的独特语言或暗语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "黑话",
                                "target_lang_sense_clarification": "指特定群体或秘密组织内部使用的隐语。"
                            },
                            {
                                "target_lang_word": "隐语",
                                "target_lang_sense_clarification": "指为了保密而使用的特殊语言。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "688494c4-b840-3235-bf73-2f2339eff501",
                    "sense_definition": "Speech or language that is incomprehensible or unintelligible; gibberish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "language_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's speech was nothing but empty <w>jargon</w> that meant absolutely nothing to the audience.",
                            "target_lang_translations": {
                                "zh": "这位政客的演讲不过是空洞的<w>废话</w>，对听众来说毫无意义。"
                            }
                        },
                        {
                            "text": "I could not understand the legal document because it was written in confusing <w>jargon</w>.",
                            "target_lang_translations": {
                                "zh": "我看不懂这份法律文件，因为它写满了令人困惑的专业<w>术语</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "难以理解或毫无意义的言语；胡言乱语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胡言乱语",
                                "target_lang_sense_clarification": "指说话没有逻辑或意义。"
                            },
                            {
                                "target_lang_word": "废话",
                                "target_lang_sense_clarification": "指没有实际意义或价值的言论。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86c71d0b-c1b1-3845-9b28-3340a8661e54",
                    "sense_definition": "An alternative form of <w>jargoon</w>, which is a variety of zircon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler identified the stone as a rare <w>jargon</w>.",
                            "target_lang_translations": {
                                "zh": "珠宝商鉴定这块石头为一种稀有的<w>锆石</w>。"
                            }
                        },
                        {
                            "text": "This specific <w>jargon</w> is highly valued for its clarity.",
                            "target_lang_translations": {
                                "zh": "这种特殊的<w>锆石</w>因其净度高而备受推崇。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is archaic or rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种锆石的变体（现已罕用）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "锆石",
                                "target_lang_sense_clarification": "指矿物名称。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a97da8b-d1d2-320a-b735-b942956c1ab8",
                    "sense_definition": "To utter jargon; to emit confused or unintelligible sounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds were <w>jargoning</w> loudly in the trees at dawn.",
                            "target_lang_translations": {
                                "zh": "黎明时分，鸟儿在树上大声地<w>叽叽喳喳</w>。"
                            }
                        },
                        {
                            "text": "He continued <w>jargoning</w> in his sleep, making it impossible to understand his dreams.",
                            "target_lang_translations": {
                                "zh": "他在睡梦中继续<w>胡言乱语</w>，让人无法理解他梦到了什么。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is literary and rarely encountered in contemporary speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发出难以理解的嘈杂声或胡言乱语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "叽叽喳喳",
                                "target_lang_sense_clarification": "形容鸟类或人发出嘈杂且难以辨认的声音。"
                            },
                            {
                                "target_lang_word": "胡言乱语",
                                "target_lang_sense_clarification": "指发出无意义的言语。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}