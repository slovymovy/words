                        ]
                    },
                    {
                        "translation_id": "d8526478-f5d2-4b73-b86a-4f6eae6aed9d",
                        "source_entry_id": "b850a24c-1d80-3d71-9e04-3014eacd1cb1",
                        "source_sense_id": "44e406fa-21a1-35bf-8d03-cc0d79db7126",
                        "target_lang_word": "quête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69804448-b9ee-3d18-a10d-98ec70658b83",
                                        "entry_id": "50c5c451-6265-33c0-870f-9df604d71d04",
                                        "glosses": [
                                            "Action par laquelle on cherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47dc6930-23c7-4f2e-9253-4d6e905695ff",
                                                "sense_id": "69804448-b9ee-3d18-a10d-98ec70658b83",
                                                "text": "« Nous sommes d’ailleurs en quête de nouveaux partenaires », souligne l’Angérien."
                                            },
                                            {
                                                "example_id": "c7077bb1-77db-4de6-953a-76740a29a2d1",
                                                "sense_id": "69804448-b9ee-3d18-a10d-98ec70658b83",
                                                "text": "Là-dessus, Capestang se mit en quête d'une auberge pour s'y loger avec Cogolin."
                                            },
                                            {
                                                "example_id": "1573ccb6-6712-4fce-97b3-346d25bd6815",
                                                "sense_id": "69804448-b9ee-3d18-a10d-98ec70658b83",
                                                "text": "Agressif ou flatteur, impromptu ou acharné, le dragueur égrène tout au long de son infructueuse quête sa concupiscente litanie. On presse alors le pas, tête baissée, découragée et battue, tristement ramenée à son humiliante condition de femme […]."
                                            },
                                            {
                                                "example_id": "c778de98-dec3-47a0-bc75-ca7153e81e5a",
                                                "sense_id": "69804448-b9ee-3d18-a10d-98ec70658b83",
                                                "text": "D'une façon intéressante, les néoconservateurs, poursuivant une quête digne de Moby Dick pour trouver un monstre à occire — […] — sont, de par leur tempérament et leur point de vue philosophique, bien plus « fondamentalistes » que ceux qu'ils perçoivent comme leurs ennemis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71870042-2c65-354d-875f-9ff6e1efd89e",
                                        "entry_id": "50c5c451-6265-33c0-870f-9df604d71d04",
                                        "glosses": [
                                            "Action de demander et de recueillir des aumônes pour les pauvres ou pour une œuvre de charité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059d4daa-e030-40b5-82aa-87af17413ba9",
                                                "sense_id": "71870042-2c65-354d-875f-9ff6e1efd89e",
                                                "text": "Les capucines étaient non-seulement confessées et dirigées par les capucins, mais nourries par eux et du produit de leurs quêtes."
                                            },
                                            {
                                                "example_id": "00ae1bcb-2574-43e2-93c1-02c7a778e88f",
                                                "sense_id": "71870042-2c65-354d-875f-9ff6e1efd89e",
                                                "text": "Faire la quête dans l’église, à domicile, pour les œuvres de la paroisse, pour les pauvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0c5563c-d040-38ce-860b-4ae84660f520",
                                        "entry_id": "50c5c451-6265-33c0-870f-9df604d71d04",
                                        "glosses": [
                                            "Action d’un valet de limier qui va détourner une bête pour la lancer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae974ef-e7d3-490f-a986-89d06b0edd6d",
                                                "sense_id": "f0c5563c-d040-38ce-860b-4ae84660f520",
                                                "text": "Aller en quête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5c790cd-b0ba-3014-b6ef-88761546821c",
                                        "entry_id": "50c5c451-6265-33c0-870f-9df604d71d04",
                                        "glosses": [
                                            "Action du chien qui démêle la voie d’un gibier qu’on veut détourner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c1104f-9003-4ffa-8088-819a13097825",
                                                "sense_id": "d5c790cd-b0ba-3014-b6ef-88761546821c",
                                                "text": "Un épagneul bon pour la quête."
                                            },
                                            {
                                                "example_id": "7ea05fcf-d461-483c-be52-2862a4920ecb",
                                                "sense_id": "d5c790cd-b0ba-3014-b6ef-88761546821c",
                                                "text": "Ce chien est trop vif, trop ardent, il n’est pas bon pour la quête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd5e397-b73e-371a-9919-37bbf5a7ceec",
                                        "entry_id": "50c5c451-6265-33c0-870f-9df604d71d04",
                                        "glosses": [
                                            "Ton de chasse que l’on sonne pour exciter les chiens à trouver l’animal qu'on veut leur faire chasser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10181c3-4c5f-4dec-87fa-5c54520ae1f9",
                                                "sense_id": "1dd5e397-b73e-371a-9919-37bbf5a7ceec",
                                                "text": "Lorsqu’on entre en chasse, il faut sonner la quête à de courts intervalles. Les chiens savent alors qu’il faut travailler. La quête les excite, les encourage, leur rappelle d’heureux souvenirs ; vous les voyez s’animer à l'envi les uns des autres, et déjà quelques uns lancent par-ci par-là des notes graves comme des points d'orgue."
                                            },
                                            {
                                                "example_id": "012a90c2-365b-45b8-a3f6-96ea7024c99b",
                                                "sense_id": "1dd5e397-b73e-371a-9919-37bbf5a7ceec",
                                                "text": "Ce livre contient les tons de chasse suivants : la quête, deux tons pour chiens, le laissé courre royal, le forhu, pour remettre les chiens dans la bonne voye et pour le hourvary, le débucher, l’eau, la sortie de l’eau, l’hallali, l’appel, la retraite prise."
                                            },
                                            {
                                                "example_id": "ee1f3069-bc7c-4db0-97ac-6ccd2f2472f6",
                                                "sense_id": "1dd5e397-b73e-371a-9919-37bbf5a7ceec",
                                                "text": "Lorsqu’on entre en chasse, on sonne la quête pour encourager les chiens."
                                            },
                                            {
                                                "example_id": "bc703d00-35b8-4b40-aec5-b98d72ea99ef",
                                                "sense_id": "1dd5e397-b73e-371a-9919-37bbf5a7ceec",
                                                "text": "« Tu dis vrai, Nicamor (nom du chien)! » s’écriait-il… et il sonnait la quête et la requête…, l'hourvari, quand le vieux chien tombait à bout de voix…, la vue, alors que, changeant le lieu de sa reposée, le piqueur tentait de se dérober à la meute…, l’hallali, lorsqu'après une heure de chasse, Nicamor, démêlant toutes les ruses de la bête, aboyait au fort devant la nappe du cerf, dont l’honnête serviteur s’était fait un manteau; puis, la fête terminée, le gentilhomme regagnait sa demeure en sonnant de toutes les forces de ses poumons la joyeuse fanfare de la retraite prise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd3628d-f0bd-3603-bab8-eebf46970808",
                                        "entry_id": "50c5c451-6265-33c0-870f-9df604d71d04",
                                        "glosses": [
                                            "Inclinaison d’un mât vers l’arrière ou l’avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3e5a87-c04c-4af8-aa9a-1dff83c123ee",
                                                "sense_id": "6fd3628d-f0bd-3603-bab8-eebf46970808",
                                                "text": "Il se retira à l’arrière de la dunette et braqua sa longue-vue au-dessus des bastingages. Il voyait deux mâts présentant une forte quête avec deux grandes voiles sombres, pareilles à des ailes."
                                            }
                                        ]
                                    }
                                ]
