                                    {
                                        "sense_id": "59954a51-fedd-30cd-ac25-9574e07a8bbb",
                                        "entry_id": "cb6ee4f6-a371-364c-9af9-0a5f0c4d094f",
                                        "glosses": [
                                            "A slight or temporary structure built to shade or shelter something; a structure usually open in front; an outbuilding, especially a smallish one; a hut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531bf9f1-3f4f-4fd2-b0d6-f0e45ae797f4",
                                                "sense_id": "59954a51-fedd-30cd-ac25-9574e07a8bbb",
                                                "text": "wood shed"
                                            },
                                            {
                                                "example_id": "50c44c21-0214-4fd0-9649-f6f76325af27",
                                                "sense_id": "59954a51-fedd-30cd-ac25-9574e07a8bbb",
                                                "text": "garden shed"
                                            },
                                            {
                                                "example_id": "94a33fc8-3f36-453f-980e-2c642bcb9469",
                                                "sense_id": "59954a51-fedd-30cd-ac25-9574e07a8bbb",
                                                "text": "wagon shed"
                                            },
                                            {
                                                "example_id": "9c1f64e5-cf83-46b5-be83-3b0aa0f25d8b",
                                                "sense_id": "59954a51-fedd-30cd-ac25-9574e07a8bbb",
                                                "text": "There are numerous sheds in the now grass-grown yard, most of which now house threshing machines and farm carts instead of locomotives and rolling stock, although [in] the roofs of some are gaping holes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11eba271-8115-348e-a678-9c15ade83cf2",
                                        "entry_id": "cb6ee4f6-a371-364c-9af9-0a5f0c4d094f",
                                        "glosses": [
                                            "A large temporary open structure for reception of goods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b6ecc7e-a875-3c61-9bdf-9d522bd19082",
                                        "entry_id": "cb6ee4f6-a371-364c-9af9-0a5f0c4d094f",
                                        "glosses": [
                                            "An automobile which is old, worn-out, slow, or otherwise of poor quality."
                                        ],
                                        "tags": [
                                            "British",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10b0435f-706c-38d6-8968-8b21a52b4434",
                                        "entry_id": "cb6ee4f6-a371-364c-9af9-0a5f0c4d094f",
                                        "glosses": [
                                            "A British Rail Class 66 locomotive."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52173095-f57c-4882-a589-2aa36709c190",
                                                "sense_id": "10b0435f-706c-38d6-8968-8b21a52b4434",
                                                "text": "Never saw that but we did stand and watch a pair of Sheds (156 and 165) speed north on a loaded steel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ef031a2-141a-3885-90e3-18892de61c95",
                                        "entry_id": "cb6ee4f6-a371-364c-9af9-0a5f0c4d094f",
                                        "glosses": [
                                            "A unit of area equivalent to 10⁻⁵² square meters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9be2ab09-ad01-3cb6-b6df-858d878a3394",
                                        "entry_id": "cb6ee4f6-a371-364c-9af9-0a5f0c4d094f",
                                        "glosses": [
                                            "Alternative form of woodshed."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90cccde0-8408-3179-9b72-0b7b7fe6c8b7",
                                        "entry_id": "b672685a-860d-3249-a857-4bde9b239f97",
                                        "glosses": [
                                            "To place or allocate a vehicle, such as a locomotive, in or to a depot or shed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "579271c9-53eb-4a76-af76-4f53cda03beb",
                                                "sense_id": "90cccde0-8408-3179-9b72-0b7b7fe6c8b7",
                                                "text": "On the Dava line, apart from the banking assistance given by the 4-4-0s, the traffic is handled by the standard class \"5\" 4-6-0s, known among the drivers as \"Hikers\"; these engines are shedded at Inverness and Perth."
                                            },
                                            {
                                                "example_id": "6e18f898-e3a6-4754-859e-adf08f183e9d",
                                                "sense_id": "90cccde0-8408-3179-9b72-0b7b7fe6c8b7",
                                                "text": "As these [diesel] trains have to be shedded under cover at night, four additional outdoor standage roads are being provided for stabling of electric rolling stock after inspection in the shed."
                                            },
                                            {
                                                "example_id": "1a46a62b-facb-4ba0-a668-fea5bf4de8aa",
                                                "sense_id": "90cccde0-8408-3179-9b72-0b7b7fe6c8b7",
                                                "text": "Three 14XX class 0-4-2Ts were allocated to Bath Road for the Clevedon branch and one was sub-shedded at Yatton for a week at a time, during which period it amassed an aggregate mileage of nearly 1,400 miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d411e731-0de8-3853-881c-c34f490a41b8",
                                        "entry_id": "b672685a-860d-3249-a857-4bde9b239f97",
                                        "glosses": [
                                            "To woodshed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
