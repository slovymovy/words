                "senses": [
                    {
                        "sense_id": "6d3228cd-62ab-3f95-9850-4dd53a578f5c",
                        "entry_id": "a8d37828-d3fd-3477-8206-66a2dc1ca3e9",
                        "glosses": [
                            "drużyna sportowa lub zawodnik, który na skutek złych wyników w sezonie został przeniesiony do niższej klasy rozgrywek lub któremu grozi takie przeniesienie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34395871-61ef-4c80-b332-879a498e376f",
                                "sense_id": "6d3228cd-62ab-3f95-9850-4dd53a578f5c",
                                "text": "Z drugim spadkowiczem, z Radzionkowa, myszkowianie grać będą, również na własnym boisku, w połowie września."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bd82ccd3-0260-3ba0-b7cb-fc4643b8d7b3",
                        "entry_id": "a8d37828-d3fd-3477-8206-66a2dc1ca3e9",
                        "glosses": [
                            "firma, która w danym momencie notuje spadek wartości swoich akcji"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "168bda48-5f44-484d-b20b-3c3f9fa359e3",
                                "sense_id": "bd82ccd3-0260-3ba0-b7cb-fc4643b8d7b3",
                                "text": "Wśród spadkowiczów znalazł się także Elektrim, który obniżył swój kurs o 1,9 proc."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
