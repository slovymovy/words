                    },
                    {
                        "translation_id": "e2848803-b657-44ec-ad6e-b1261604ccfe",
                        "source_entry_id": "84409351-df3e-3419-a503-fe0f551be23d",
                        "source_sense_id": "a1f5bf8e-d1d7-3dff-afaa-cc0ca98927a1",
