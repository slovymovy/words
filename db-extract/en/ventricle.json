                                                "sense_id": "1ce0c0dc-171b-38b7-b13f-9f4c1e44fc57",
                                                "text": "Lidské srdce se skládá ze dvou srdečních síní a dvou srdečních komor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5937b6a4-ef3e-3d25-b4e7-434edd839deb",
                                        "entry_id": "9ec918e6-0d5d-37da-bc96-5983ef559ddc",
                                        "glosses": [
                                            "samosprávný orgán sdružující osoby stejné profese"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b522e98-0975-47e7-82f2-ec59fc7da3ca",
                                                "sense_id": "5937b6a4-ef3e-3d25-b4e7-434edd839deb",
                                                "text": "Českomoravská komora pro pozemkové úpravy, Česká lékařská komora"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89f0bab-ba0c-375b-928f-2ae72eeafd86",
                                        "entry_id": "9ec918e6-0d5d-37da-bc96-5983ef559ddc",
                                        "glosses": [
                                            "oddíl zákonodárného sboru"
