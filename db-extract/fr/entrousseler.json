                ],
                "senses": [
                    {
                        "sense_id": "78dbbabd-224b-3c7b-96f5-8f6821d70db1",
                        "entry_id": "37031cd1-1445-33cf-96dd-e2685a187f6c",
                        "glosses": [
                            "Donner en tant que trousseau à (une jeune fille qui se marie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c375f6cb-89ff-4558-9cbd-8b8db61cadd2",
                                "sense_id": "78dbbabd-224b-3c7b-96f5-8f6821d70db1",
                                "text": "Voilà des maris qui ont entrousselé une jeunesse avec leurs deniers, qui l’ont habillée en dame et nourrie jusqu’au jour de maintenant, ce n’est pas pour te la mettre sous la jambe…"
                            },
                            {
                                "example_id": "56e6142e-5f7d-4a43-9df9-6aef8c2dd91c",
                                "sense_id": "78dbbabd-224b-3c7b-96f5-8f6821d70db1",
                                "text": "Une jeune femme bien « entrousselée » par son père pour ses noces pouvait vivre de nombreuses années sans acheter une robe neuve, du moins dans le milieu très sérieux du Parlement et de la Chancellerie."
                            },
                            {
                                "example_id": "9be39fa7-f06c-44fc-9554-782b51d0d5c4",
                                "sense_id": "78dbbabd-224b-3c7b-96f5-8f6821d70db1",
                                "text": "Il demande ce délai au moment où il entrousselle sa fille Etiennette, vingt-quatre ans, en lui donnant 1 000 livres en avance d’hoiries et la possession et jouissance de 10 arpents de labours à prendre dans les héritages de sa défunte mère."
                            }
                        ]
                    }
                ],
