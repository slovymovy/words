                "translations": [
                    {
                        "translation_id": "0d9e19af-efae-4b01-a4ae-f620459dd27b",
                        "source_entry_id": "83f2279a-41af-34ad-8b77-bd82ea133dac",
                        "source_sense_id": "b43335a4-012f-3b86-9bf3-e16be6cf7e83",
                        "target_lang_word": "Saljuqid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saljuqid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3066267c-6284-3c03-ac39-38f7b1214d72",
                                        "entry_id": "9055365c-0f73-3bc9-8ac6-5248fc535806",
                                        "glosses": [
                                            "Alternative form of Seljukid, of or related to Seljuk, his dynasty, their empire, or their period of rule."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5dc8eb4-ae55-428c-91ac-43a0299cd09e",
                                                "sense_id": "3066267c-6284-3c03-ac39-38f7b1214d72",
                                                "text": "The pirinj būrū پرنج بورو [brass trumpet]. Invented by the Saljuqid Arslān Shāh at Konia."
                                            },
                                            {
                                                "example_id": "65febfa7-3722-4964-aa21-5e7420c1611a",
                                                "sense_id": "3066267c-6284-3c03-ac39-38f7b1214d72",
                                                "text": "During the Saljuqid Period the society was composed of essentially two classes: [...]"
                                            },
                                            {
                                                "example_id": "a67af485-5966-4f02-8c47-043641ba98ed",
                                                "sense_id": "3066267c-6284-3c03-ac39-38f7b1214d72",
                                                "text": "This victory ended the influence of Byzantine emperors in Armenia and the rest of Caucasus and Azerbaijan, and spread the fame of the Saljuqid king in the Muslim world."
                                            },
                                            {
                                                "example_id": "98b724b1-2099-4268-b6ef-2b82817b62de",
                                                "sense_id": "3066267c-6284-3c03-ac39-38f7b1214d72",
                                                "text": "The Saljuqid Empire expanded during the period that the Abbasid dynasty was declining."
                                            },
                                            {
                                                "example_id": "4f38e21c-5f80-4e5b-8906-2cbf0aced4d3",
                                                "sense_id": "3066267c-6284-3c03-ac39-38f7b1214d72",
                                                "text": "Although the suppression of the revolt of Sharaf al-Dīn Masʽūd helped to consolidate the position of the Saljuqid governor Muʽīn al-Dīn Sulaymān, known as parvāna, in Anatolia, it had also demonstrated that the parvāna was dependent on Ilkhanid military support to maintain that position."
                                            },
                                            {
                                                "example_id": "5924d393-2a92-4e2c-b8f4-85eb7ac080c6",
                                                "sense_id": "3066267c-6284-3c03-ac39-38f7b1214d72",
                                                "text": "During the decades following the Saljuqid victory over Byzantine forces at Manzikert (1071), contingents of Muslim Turkmen gradually moved westward across the anciently Christian religious landscape of Anatolia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Saljuqid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1597ae7-c002-3e3f-a019-808d6d1fdd36",
                                        "entry_id": "c6a2e6eb-d43c-3abd-8117-6bd35a4f60bc",
                                        "glosses": [
                                            "Alternative form of Seljukid, a member of the Seljuk dynasty or a person of their empire."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9058e4c3-4bc8-4673-9079-7df4aa3a779b",
                                                "sense_id": "b1597ae7-c002-3e3f-a019-808d6d1fdd36",
                                                "text": "In this way, glorification of the Fatimids was the poet's method of promulgating Ismailism among those who were discontended with the Saljuqids."
                                            },
                                            {
                                                "example_id": "c2548bd5-2152-4939-b119-e43e43dcc5e9",
                                                "sense_id": "b1597ae7-c002-3e3f-a019-808d6d1fdd36",
                                                "text": "The vast empire of the Saljuqids had disintegrated and a larger portion of it had passed to Muʼayyid who had established himself in Nīshāpūr."
                                            },
                                            {
                                                "example_id": "61265623-883f-4f9d-b03b-6d22985297fc",
                                                "sense_id": "b1597ae7-c002-3e3f-a019-808d6d1fdd36",
                                                "text": "Badr was governor over several provinces for thirty-two years; and Nizam, for thirty years, a prime minister under two of the great Saljuqids."
                                            },
                                            {
                                                "example_id": "2129fe5b-8656-432d-8ec0-93398f795177",
                                                "sense_id": "b1597ae7-c002-3e3f-a019-808d6d1fdd36",
                                                "text": "He served possibly as a tax collector first under the Ghaznavids and then the Saljuqids."
                                            },
                                            {
                                                "example_id": "757bc16a-e15c-4740-97ff-ce685983af5e",
                                                "sense_id": "b1597ae7-c002-3e3f-a019-808d6d1fdd36",
                                                "text": "Dubays ibn Ṣadaqa finally lost his head to a Saljuqid."
                                            },
                                            {
                                                "example_id": "5435d7cb-8a87-4adc-8d7c-ebe87f38d3d1",
                                                "sense_id": "b1597ae7-c002-3e3f-a019-808d6d1fdd36",
                                                "text": "The new ruler Bahram Shah (r. 1117–57), having received the assistance of the Saljuqids, accepted their overlordship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
