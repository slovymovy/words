                            }
                        ]
                    },
                    {
                        "translation_id": "825d7cf3-e0ee-4bc2-ac47-00ef3989d1bf",
                        "source_entry_id": "a4b33d23-de5f-3705-ae2b-0653f759a0ec",
                        "source_sense_id": "6e009240-cb47-3ab1-8eb1-fea421589d2c",
