{
    "word_family": [
        "sleuren",
        "meesleuren",
        "voortsleuren"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c422fa00-59c1-39fb-8a7e-b1b27d073dcb",
                    "sense_definition": "Een dagelijkse gang van zaken die door herhaling saai of geestdodend is geworden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "routine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na tien jaar bij hetzelfde bedrijf te werken, begon hij de dagelijkse <w>sleur</w> eindelijk beu te worden.",
                            "target_lang_translations": {
                                "en": "After working at the same company for ten years, he finally started to get tired of the daily <w>rut</w>."
                            }
                        },
                        {
                            "text": "Ze besloten op vakantie te gaan om even te ontsnappen aan de dagelijkse <w>sleur</w> van het huishouden.",
                            "target_lang_translations": {
                                "en": "They decided to go on holiday to escape the daily <w>grind</w> of the household for a while."
                            }
                        }
                    ],
                    "synonyms": [
                        "routine",
                        "sleurwerk",
                        "monotonie"
                    ],
                    "antonyms": [
                        "afwisseling",
                        "variatie",
                        "avontuur"
                    ],
                    "common_phrases": [
                        "dagelijkse sleur",
                        "in een sleur raken"
                    ],
                    "target_lang_definitions": {
                        "en": "A daily course of affairs that has become boring or soul-destroying through repetition."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rut",
                                "target_lang_sense_clarification": "a boring, fixed routine"
                            },
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "monotonous daily work or routine"
                            },
                            {
                                "target_lang_word": "drudgery",
                                "target_lang_sense_clarification": "hard, menial, or dull work"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b36bdb4-b4d0-3ce6-abc6-9f469d79f2be",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>sleuren</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>sleur</w> de zware koffer de trap op omdat de lift in het gebouw kapot is.",
                            "target_lang_translations": {
                                "en": "I <w>drag</w> the heavy suitcase up the stairs because the elevator in the building is broken."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>sleur</w> ik mezelf met veel moeite uit mijn warme bed.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>drag</w> myself out of my warm bed with great effort."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'sleuren' (to drag or lug)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "to pull something heavy"
                            },
                            {
                                "target_lang_word": "lug",
                                "target_lang_sense_clarification": "to carry or pull with effort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79c94d4-4ac0-34c8-b664-4cfd7e42497a",
                    "sense_definition": "De gebiedende wijs van <w>sleuren</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sleur</w> die zak niet over de grond, want dan gaat de stof waarschijnlijk kapot.",
                            "target_lang_translations": {
                                "en": "Don't <w>drag</w> that bag across the floor, because the fabric will probably break."
                            }
                        },
                        {
                            "text": "Kom op, <w>sleur</w> die oude kast naar buiten zodat we meer ruimte hebben.",
                            "target_lang_translations": {
                                "en": "Come on, <w>haul</w> that old cupboard outside so we have more space."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'sleuren' (to drag or lug)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "command to pull something"
                            },
                            {
                                "target_lang_word": "haul",
                                "target_lang_sense_clarification": "command to pull with force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5883a28a-87db-3fd7-b28b-878518efb1fc",
                    "sense_definition": "De tweede persoon enkelvoud tegenwoordige tijd van <w>sleuren</w> bij inversie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>sleur</w> je die zware tas helemaal alleen mee naar het station?",
                            "target_lang_translations": {
                                "en": "Why are you <w>lugging</w> that heavy bag to the station all by yourself?"
                            }
                        },
                        {
                            "text": "<w>Sleur</w> je die takken naar de composthoop of moet ik je even helpen?",
                            "target_lang_translations": {
                                "en": "Are you <w>dragging</w> those branches to the compost heap or should I help you for a moment?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present indicative (inverted)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The second-person singular present tense of 'sleuren' used in inverted word order."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "to pull along the ground"
                            },
                            {
                                "target_lang_word": "schlep",
                                "target_lang_sense_clarification": "to carry or haul something tedious"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}