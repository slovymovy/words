                        "glosses": [
                            "Rabot à deux poignées, au fer arrondi, permettant au menuisier de dégrossir des bois gauches ou noueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0f32a0-6681-4b35-b13f-37aefb4cb0f9",
                                "sense_id": "2973ddc3-0e06-3497-b3ea-b32f1e49eab7",
                                "text": "« Les outils à fust de Menuisiers, s’appellent en général des rabots. Leurs noms propres sont le rabot, le riflart, la galere, les varlopes, les guillaumes, les mouchettes, les bouvemens, les bouvets, & les feuillerets. »."
                            }
                        ]
                    },
                    {
                        "sense_id": "79b5d19f-3876-3478-9aed-5dc79bbe7c67",
                        "entry_id": "9a6bcd20-2c82-3655-8466-d446c4aebd72",
                        "glosses": [
                            "Espèce de ciseau de fer très large en bas et légèrement rabattu en chanfrein, à manche de bois, utilisé par le tailleur de pierre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8bb09974-df1c-3132-ad11-0e229776661c",
                        "entry_id": "9a6bcd20-2c82-3655-8466-d446c4aebd72",
                        "glosses": [
                            "Sorte de laine longue se trouvant sur les peaux de mouton non apprêtés, autrefois utilisée pour remplir les bales qui servaient aux imprimeurs à encrer les plaques."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ad90718c-a20e-374d-a2d3-12738e6339fa",
                        "entry_id": "9a6bcd20-2c82-3655-8466-d446c4aebd72",
                        "glosses": [
                            "Parapluie."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "92cade22-0f01-40b2-bb2a-30229e10b389",
                                "sense_id": "ad90718c-a20e-374d-a2d3-12738e6339fa",
                                "text": "« L’ondée reprenait, la noce venait d’ouvrir les parapluies ; et, sous les riflarts lamentables, balancés à la main des hommes, les femmes se retroussaient. »"
