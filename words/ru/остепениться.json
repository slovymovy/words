                    "sense_id": "f6c8b9f3-9edb-3685-8ebf-04e0630c5c9f",
                    "sense_definition": "стать более спокойным, рассудительным и серьезным в поведении, образе жизни",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После женитьбы и рождения ребёнка он наконец <w>остепенился</w> и начал думать о будущем семьи.",
                            "target_lang_translations": {
                                "pl": "Po ślubie i narodzinach dziecka w końcu <w>się ustatkował</w> i zaczął myśleć o przyszłości rodziny."
                            }
                        },
                        {
                            "text": "Родители очень надеялись, что их легкомысленный сын скоро повзрослеет и <w>остепенится</w>.",
                            "target_lang_translations": {
                                "pl": "Rodzice mieli wielką nadzieję, że ich lekkomyślny syn wkrótce dorośnie i <w>spoważnieje</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "угомониться",
                        "успокоиться",
                        "поумнеть"
                    ],
                    "antonyms": [
                        "разгуляться"
                    ],
                    "common_phrases": [
                        "пора остепениться",
                        "наконец остепениться"
                    ],
                    "target_lang_definitions": {
                        "pl": "stać się bardziej spokojnym, rozsądnym, statecznym i ustatkować się"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ustatkowac się",
                                "target_lang_sense_clarification": "o stylu życia, uspokojeniu się"
                            },
                            {
                                "target_lang_word": "spoważnieć",
                                "target_lang_sense_clarification": "stać się poważniejszym"
                            },
                            {
                                "target_lang_word": "uspokoić się",
                                "target_lang_sense_clarification": "przestać prowadzić hulaszczy tryb życia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47c18315-5df2-3c05-b43a-4ec6bcf7a946",
                    "sense_definition": "получить учёную степень кандидата или доктора наук",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он успешно защитил диссертацию по физике и наконец-то <w>остепенился</w>.",
                            "target_lang_translations": {
                                "pl": "Pomyślnie obronił rozprawę doktorską z fizyki i w końcu <w>uzyskał stopień naukowy</w>."
                            }
                        },
                        {
                            "text": "Многие молодые преподаватели стремятся как можно скорее <w>остепениться</w>, чтобы получить прибавку к зарплате.",
                            "target_lang_translations": {
                                "pl": "Wielu młodych wykładowców stara się jak najszybciej <w>zrobić doktorat</w>, aby dostać podwyżkę."
                            }
                        }
                    ],
                    "traits": [
