            "senses": [
                {
                    "sense_id": "a8083728-1e03-3aaa-8a27-5c5e949aad8e",
                    "sense_definition": "Rendre quelque chose plus lourd en lui apportant davantage de poids physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poids_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie fine a fini par <w>alourdir</w> les vêtements des randonneurs."
                        },
                        {
                            "text": "Il ne faut pas trop <w>alourdir</w> la valise pour éviter des frais à l'aéroport."
                        }
                    ],
                    "synonyms": [
                        "désalléger"
                    ],
                    "antonyms": [
                        "alléger",
                        "désalourdir"
                    ],
                    "common_phrases": [
                        "alourdir la charge",
                        "alourdir les bagages"
                    ]
                },
                {
                    "sense_id": "3c05658a-5795-32c1-aced-d1469e93920a",
                    "sense_definition": "Devenir pesant, engourdi ou fatigué, en parlant du corps ou des membres.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corps_sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue journée de travail, mes yeux commencent à s'<w>alourdir</w> de fatigue."
                        },
                        {
                            "text": "Il sentait ses paupières s'<w>alourdir</w> doucement au son de la musique apaisante."
                        }
                    ],
                    "common_phrases": [
                        "paupières qui s'alourdissent",
                        "jambes qui s'alourdissent"
                    ]
                },
                {
                    "sense_id": "db4d1d5c-5c24-3d73-8e61-056e97992d19",
                    "sense_definition": "Rendre une situation plus pénible, plus coûteuse ou plus importante en nombre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aggravation_cout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces dépenses imprévues risquent d'<w>alourdir</w> la facture totale des réparations."
                        },
                        {
                            "text": "Le ministre craint que cette décision vienne <w>alourdir</w> les démarches administratives."
                        }
                    ],
                    "antonyms": [
                        "alléger"
                    ],
                    "common_phrases": [
                        "alourdir la facture",
                        "alourdir le bilan"
                    ]
                },
                {
                    "sense_id": "ced74401-ca21-325d-b1fa-eb26c6240e6b",
                    "sense_definition": "Rendre l'esprit, les réflexes ou la démarche moins vifs et plus lents.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lenteur_esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fatigue accumulée peut facilement <w>alourdir</w> les réflexes des conducteurs."
                        },
                        {
                            "text": "Une digestion difficile a tendance à <w>alourdir</w> l'esprit pendant les réunions de l'après-midi."
                        }
                    ],
                    "antonyms": [
                        "alléger"
                    ],
                    "common_phrases": [
                        "alourdir l'esprit",
                        "alourdir le pas"
                    ]
                }
            ]
        }
