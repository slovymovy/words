                ],
                "senses": [
                    {
                        "sense_id": "afe7633c-15c1-350c-84f0-715222c84a55",
                        "entry_id": "77ba958f-6f8c-3b91-bdc4-d096a9417b4f",
                        "glosses": [
                            "odbywający się każdego roku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73285f1c-f6c2-4991-a971-358ba88cd73a",
                                "sense_id": "afe7633c-15c1-350c-84f0-715222c84a55",
                                "text": "Spotykali się na dorocznym święcie nadleśnictwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43b5ab63-09b2-477b-bdbd-2f246e57e2c1",
                        "source_entry_id": "77ba958f-6f8c-3b91-bdc4-d096a9417b4f",
                        "source_sense_id": "afe7633c-15c1-350c-84f0-715222c84a55",
                        "target_lang_word": "annual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "559c3463-a583-3fde-8f35-447f6c340e6c",
                                        "entry_id": "98ec38ee-a7a8-3105-846a-88f294e8f962",
                                        "glosses": [
                                            "Happening once every year."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208271e7-5ffc-401a-b72e-fc7a43142224",
                                                "sense_id": "559c3463-a583-3fde-8f35-447f6c340e6c",
                                                "text": "an annual general meeting; an annual publication"
                                            },
                                            {
                                                "example_id": "814463f2-020a-47dd-b92a-3f1a3ccafb9e",
                                                "sense_id": "559c3463-a583-3fde-8f35-447f6c340e6c",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia. The cheapest way to clear logged woodland is to burn it, producing an acrid cloud of foul white smoke that, carried by the wind, can cover hundreds, or even thousands, of square miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f64ac41e-cced-3da2-8a9b-791b5429b96c",
                                        "entry_id": "98ec38ee-a7a8-3105-846a-88f294e8f962",
                                        "glosses": [
                                            "Of, for, or relating to a whole year, often as a recurring cycle; determined or reckoned by the year; accumulating in the course of a year; performed, executed, or completed over the course of a year. See also circannual."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d79e3223-7401-496e-812f-80760410b86d",
                                                "sense_id": "f64ac41e-cced-3da2-8a9b-791b5429b96c",
                                                "text": "an annual salary; average annual profits; the annual course of the sun"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7728e3-cab0-3d96-844c-4623e0d9cf1a",
                                        "entry_id": "98ec38ee-a7a8-3105-846a-88f294e8f962",
                                        "glosses": [
                                            "Having a life cycle that is completed in only one growing season; e.g. beans, corn, marigold. See Annual plant in Wikipedia. Compare biennial, perennial."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d845166-0d7e-386e-8cba-9b6ef1a60369",
                                        "entry_id": "98ec38ee-a7a8-3105-846a-88f294e8f962",
                                        "glosses": [
                                            "Living or lasting just one season or year, as certain insects or insect colonies."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "annual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24a07bcf-1d00-3d7a-a20a-4d30249b13be",
                                        "entry_id": "18b7a1ea-56a8-3838-8f2d-53be54ba05f8",
                                        "glosses": [
                                            "An annual publication; a book, periodical, journal, report, comic book, yearbook, etc., which is published serially once a year, which may or may not be in addition to regular weekly or monthly publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de53ad3f-cbb3-4854-a9d6-1cac9a265945",
                                                "sense_id": "24a07bcf-1d00-3d7a-a20a-4d30249b13be",
                                                "text": "I read the magazine, but I usually don't purchase the annuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6152b21-8f0a-36e7-ac36-0e29ce51fac6",
                                        "entry_id": "18b7a1ea-56a8-3838-8f2d-53be54ba05f8",
                                        "glosses": [
                                            "An annual plant; a plant with a life span of just one growing season; a plant which naturally germinates, flowers and dies in one year. Compare biennial, perennial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b899a619-cd5b-4a70-a677-f5f40e2b78f3",
                                                "sense_id": "c6152b21-8f0a-36e7-ac36-0e29ce51fac6",
                                                "text": "I can't wait to plant my annuals in the spring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "029ef553-15ba-3cee-9a98-a30e880a71cd",
                                        "entry_id": "18b7a1ea-56a8-3838-8f2d-53be54ba05f8",
                                        "glosses": [
                                            "A medical checkup taking place once a year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b37598-e3c7-441e-ae0c-21000d99118c",
                                                "sense_id": "029ef553-15ba-3cee-9a98-a30e880a71cd",
                                                "text": "Some routine annuals take a half hour and cost about $30."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0792707b-9cb7-382b-bfe4-28b7bcffe992",
                                        "entry_id": "18b7a1ea-56a8-3838-8f2d-53be54ba05f8",
                                        "glosses": [
                                            "A pantomime taking place once a year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4fe855-0c03-481f-a4f3-19dd0ee1fadb",
                                                "sense_id": "0792707b-9cb7-382b-bfe4-28b7bcffe992",
                                                "text": "Excellent work has been done by the Playgoers' Club in connection with its Christmas Pantomime Fund. Thousands of children who possibly otherwise would have little chance of witnessing one of the hardy annuals have been annually taken […]"
                                            },
                                            {
                                                "example_id": "a678a252-99b3-4fb0-af58-77135acbfbe8",
                                                "sense_id": "0792707b-9cb7-382b-bfe4-28b7bcffe992",
                                                "text": "From 1852 until 1888 he was the author of every Drury Lane pantomime, or \"Annuals\" as in his old fashioned way he preferred to […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
