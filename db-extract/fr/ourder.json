                        "glosses": [
                            "Variante ancienne de hourder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c9c6a7-e4f1-4d06-a5c8-dce894646a0e",
                                "sense_id": "8c1de347-91bb-3108-8413-5b116c81953e",
                                "text": "Ils étaient occupés à crépir une façade, à fignoler une plinthe, à ourder une cloison, à ravaler un pan de mur."
                            },
                            {
                                "example_id": "90c16a4f-cf17-46d8-9ebf-0538cb307573",
                                "sense_id": "8c1de347-91bb-3108-8413-5b116c81953e",
                                "text": "Le soir, on mange la soupe en parlant des trumeaux montés dans l’après-midi, des aires de planchers à ourder le lendemain."
                            }
                        ]
                    }
