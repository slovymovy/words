{
    "word_family": [
        "sturen",
        "besturen",
        "aansturing",
        "stuurman"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5430e2fa-3c93-3f07-8eb4-e0ee679d95d2",
                    "sense_definition": "Leiding geven aan mensen of een organisatie; managen of instrueren.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "leiding_geven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als manager moet hij een groot team van professionals <w>aansturen</w>.",
                            "target_lang_translations": {
                                "en": "As a manager, he has to <w>manage</w> a large team of professionals."
                            }
                        },
                        {
                            "text": "Ik ga jullie vandaag in jullie werk <w>aansturen</w>.",
                            "target_lang_translations": {
                                "en": "I am going to <w>direct</w> you in your work today."
                            }
                        }
                    ],
                    "synonyms": [
                        "leiden",
                        "managen",
                        "besturen",
                        "begeleiden"
                    ],
                    "common_phrases": [
                        "een team aansturen",
                        "medewerkers aansturen"
                    ],
                    "target_lang_definitions": {
                        "en": "To lead, manage, or instruct people or an organization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "manage",
                                "target_lang_sense_clarification": "to direct or control a team or organization"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to guide or direct a group of people"
                            },
                            {
                                "target_lang_word": "direct",
                                "target_lang_sense_clarification": "to give instructions or supervise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bf51241-ea84-3cfc-ac2b-78809e44dbb4",
                    "sense_definition": "Bewust toewerken naar een bepaald doel of resultaat, of anderen daartoe aanzetten (vaak met 'op').",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toewerken_naar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tegenpartij <w>stuurt</w> steeds <w>aan</w> op conflict.",
                            "target_lang_translations": {
                                "en": "The opposing party is constantly <w>steering towards</w> conflict."
                            }
                        },
                        {
                            "text": "Het is duidelijk dat de directie <w>aanstuurt</w> op een snelle reorganisatie.",
                            "target_lang_translations": {
                                "en": "It is clear that the board is <w>pushing for</w> a rapid reorganization."
                            }
                        }
                    ],
                    "synonyms": [
                        "toewerken",
                        "aansturen op",
                        "aanstoken"
                    ],
                    "common_phrases": [
                        "aansturen op een compromis",
                        "aansturen op verandering"
                    ],
                    "target_lang_definitions": {
                        "en": "To consciously work towards a specific goal or result, or to urge others towards it (often used with 'op')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aim for",
                                "target_lang_sense_clarification": "to direct one's efforts towards a goal"
                            },
                            {
                                "target_lang_word": "steer towards",
                                "target_lang_sense_clarification": "to guide a situation towards a certain outcome"
                            },
                            {
                                "target_lang_word": "push for",
                                "target_lang_sense_clarification": "to strongly advocate or work for a result"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93dada70-ab83-3f3a-9ff6-14dd35aff1e4",
                    "sense_definition": "Machines, apparaten of biologische systemen elektronisch of mechanisch controleren en in werking stellen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technische_controle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De spieren worden <w>aangestuurd</w> door de hersenen.",
                            "target_lang_translations": {
                                "en": "The muscles are <w>controlled</w> by the brain."
                            }
                        },
                        {
                            "text": "Met deze software kun je de verlichting in het hele gebouw automatisch <w>aansturen</w>.",
                            "target_lang_translations": {
                                "en": "With this software, you can automatically <w>control</w> the lighting in the entire building."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedienen",
                        "regelen",
                        "controleren",
                        "beheersen"
                    ],
                    "common_phrases": [
                        "een apparaat aansturen",
                        "elektronisch aansturen"
                    ],
                    "target_lang_definitions": {
                        "en": "To electronically or mechanically control and activate machines, devices, or biological systems."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "to command or regulate a machine or system"
                            },
                            {
                                "target_lang_word": "drive",
                                "target_lang_sense_clarification": "to provide the power or signals to operate a mechanism"
                            },
                            {
                                "target_lang_word": "operate",
                                "target_lang_sense_clarification": "to control the functioning of a device"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}