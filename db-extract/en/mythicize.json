                "translations": [
                    {
                        "translation_id": "36766c79-a6e8-40d2-b31e-da130a401b00",
                        "source_entry_id": "717654a7-7517-37ce-b10a-c726062106a9",
                        "source_sense_description": "Translations",
                        "target_lang_word": "mythifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64ae802e-6b5f-3357-befd-33a2dba5123d",
                                        "entry_id": "6c7242ce-d8e6-3c9f-8082-719e236f2065",
                                        "glosses": [
                                            "Rendre mythique quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc3a691-d67f-42f6-91bc-3d5ce7eb9acd",
                                                "sense_id": "64ae802e-6b5f-3357-befd-33a2dba5123d",
                                                "text": "Bien sûr que nous mythifions le passé, mais à la recherche d’une vérité, à la recherche de plus de vérité sur le passé."
                                            },
                                            {
                                                "example_id": "2b4f784f-ab16-4c3b-8e43-18821eb5b45d",
                                                "sense_id": "64ae802e-6b5f-3357-befd-33a2dba5123d",
                                                "text": "La chasse leur permet tout à coup d’échapper à cette vie et de retrouver quelque chose de leur enfance, de se vantardiser et de se mythifier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb1dab3d-2722-3737-b302-9a05435c4441",
                                        "entry_id": "6c7242ce-d8e6-3c9f-8082-719e236f2065",
                                        "glosses": [
                                            "Instaurer un mythe."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "750c291c-e974-43bb-a2e6-04d2e16bb13c",
                                                "sense_id": "cb1dab3d-2722-3737-b302-9a05435c4441",
                                                "text": "En outre, la communauté fait preuve d’une forte propension à mythifier les fondateurs de ces monnaies et à les placer sur un piédestal. Pour Bitcoin, le culte se concentre autour de la figure énigmatique de Satoshi Nakamoto, devenu prophète malgré lui. Dans la mythologie Bitcoin, ce dernier restitue au peuple un instrument constitutif de son émancipation, la monnaie, en la volant au monopole des États et des Banques centrales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5aa3da2f-a5da-4284-9c8c-b2df181461f5",
                        "source_entry_id": "717654a7-7517-37ce-b10a-c726062106a9",
                        "source_sense_description": "Translations",
                        "target_lang_word": "mythiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79f3b175-7702-3a8c-9985-659564052251",
                                        "entry_id": "76b0775b-5c5f-3476-9a29-3e81e1f855e6",
                                        "glosses": [
                                            "Donner un caractère de mythe à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92fe7ceb-6888-4c8b-b6a4-00840bee28e8",
                                                "sense_id": "79f3b175-7702-3a8c-9985-659564052251",
                                                "text": "Ma tendance à « mythiser » la réalité est telle que je crois beaucoup plus aux essences immuables d’une vision substantielle qu’au processus historique de l’évolution des choses."
                                            },
                                            {
                                                "example_id": "5b86ffa5-4517-4bf6-bfd1-3c47c539a294",
                                                "sense_id": "79f3b175-7702-3a8c-9985-659564052251",
                                                "text": "Lui accorder un pouvoir de la volonté sur ses réflexes physiologiques, n’est-ce pas mythiser son humanité?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49cfbbaa-6a2d-4ae1-b8f7-a00a623fe67a",
                        "source_entry_id": "717654a7-7517-37ce-b10a-c726062106a9",
                        "source_sense_description": "Translations",
                        "target_lang_word": "mythiciser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
