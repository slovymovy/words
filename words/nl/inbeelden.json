{
    "word_family": [
        "beeld",
        "verbeelding",
        "beeldend",
        "afbeelden",
        "uitbeelden",
        "verbeelden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ecb4add-6acf-304f-92e4-dbf13164159d",
                    "sense_definition": "zich een voorstelling maken van iets in de gedachten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verbeelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je je <w>inbeelden</w> hoe het is om op de maan te wandelen?",
                            "target_lang_translations": {
                                "en": "Can you <w>imagine</w> what it is like to walk on the moon?"
                            }
                        },
                        {
                            "text": "Ik kan me levendig <w>inbeelden</w> dat de vakantie fantastisch zal zijn.",
                            "target_lang_translations": {
                                "en": "I can vividly <w>imagine</w> that the holiday will be fantastic."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorstellen",
                        "verbeelden",
                        "fantaseren"
                    ],
                    "common_phrases": [
                        "zich levendig inbeelden",
                        "moeilijk inbeelden"
                    ],
                    "target_lang_definitions": {
                        "en": "to form a mental image or concept of something in one's mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imagine",
                                "target_lang_sense_clarification": "to form a mental picture"
                            },
                            {
                                "target_lang_word": "visualize",
                                "target_lang_sense_clarification": "to form a clear visual image in the mind"
                            },
                            {
                                "target_lang_word": "picture",
                                "target_lang_sense_clarification": "to imagine what something looks like"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24eae5d4-2989-3c51-904d-c5255a3c48d0",
                    "sense_definition": "ten onrechte geloven dat iets waar is of dat men bepaalde eigenschappen bezit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbeelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>beeldde</w> zich <w>in</w> dat hij een machtig man was, maar niemand luisterde naar hem.",
                            "target_lang_translations": {
                                "en": "He <w>imagined</w> himself to be a powerful man, but nobody listened to him."
                            }
                        },
                        {
                            "text": "Je moet je niets <w>inbeelden</w>, want je bent niet belangrijker dan de rest.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>get ideas into your head</w>, because you are no more important than the rest."
                            }
                        }
                    ],
                    "synonyms": [
                        "wanen",
                        "zich verbeelden"
                    ],
                    "common_phrases": [
                        "zich van alles inbeelden",
                        "niets inbeelden"
                    ],
                    "target_lang_definitions": {
                        "en": "to wrongly believe that something is true or that one possesses certain qualities"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delude oneself",
                                "target_lang_sense_clarification": "to believe something that is not true"
                            },
                            {
                                "target_lang_word": "imagine things",
                                "target_lang_sense_clarification": "to believe something is happening when it is not"
                            },
                            {
                                "target_lang_word": "get ideas into one's head",
                                "target_lang_sense_clarification": "to start believing something false or arrogant"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}