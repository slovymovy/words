                    },
                    {
                        "translation_id": "c14df135-9229-4b2a-ac4a-799b676a7b46",
                        "source_entry_id": "aff57919-5fd0-380e-b627-bffed5b191ef",
                        "source_sense_description": "Without wit or understanding",
                        "target_lang_word": "hirnlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hirnlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "360249e8-acc9-3792-b598-ef48b0d0b0fc",
                                        "entry_id": "40061e64-445c-34b6-ae0e-1eb169f5a19a",
                                        "glosses": [
                                            "kein Gehirn aufweisend"
                                        ],
                                        "tags": [
                                            "keine Steigerung; Anatomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eea4ead-395f-42f0-b0c8-05e0dc5dc415",
                                                "sense_id": "360249e8-acc9-3792-b598-ef48b0d0b0fc",
                                                "text": "„In Amerika hat man Mütter, deren Kinder voraussichtlich hirnlos geboren werden würden, dazu veranlaßt, die Schwangerschaft auszutragen – mit allen Risiken, die eine Schwangerschaft mit sich bringt –, um auf diese Weise zu Organen zu kommen, also Neugeborene quasi als lebende Organbank zur Verfügung zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34193c3d-ba7f-3449-8e46-2fadf0384eef",
                                        "entry_id": "40061e64-445c-34b6-ae0e-1eb169f5a19a",
                                        "glosses": [
                                            "in einer ärgerlichen, unerfreulichen Weise dumm, unverständig, unüberlegt"
                                        ],
                                        "tags": [
                                            "übertragen umgangssprachlich abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74575140-c45a-47e4-b299-360876ed8d98",
                                                "sense_id": "34193c3d-ba7f-3449-8e46-2fadf0384eef",
                                                "text": "„Ihr einstiges Engagement blieb weithin unvergessen: Die einen preisen sie als eine der raren wahren Idealistinnen, andere sagen ihr noch heute nach, sie sei im mexikanischen Exil unter hirnlos treuen Stalinisten eine hirnlosere treuere Stalinistin gewesen.“"
                                            },
                                            {
                                                "example_id": "63daefd9-8215-47d8-b442-ec9c5dd7c180",
                                                "sense_id": "34193c3d-ba7f-3449-8e46-2fadf0384eef",
                                                "text": "„Herz von dieser neuen ‚Kultur‘, erläutert ihr Finanzminister Wolfgang Schäuble, sei die deutsche ‚Schuldenbremse‘: ausgerechnet das hirnloseste Produkt des deutschen Stabilitätsfetischismus.“"
                                            },
                                            {
                                                "example_id": "2d540ebf-7ad0-4dff-bf03-d4b715c301c8",
                                                "sense_id": "34193c3d-ba7f-3449-8e46-2fadf0384eef",
                                                "text": "„Europa hat den Syrern, Irakern und Ägyptern die Antike unter dem Hintern weggegraben; unsere glorreichen Nationen haben sich kraft ihres Monopols in Wissenschaft und Archäologie des Universellen bemächtigt und mit diesem Raub den kolonisierten Völkern eine Vergangenheit entwendet, die deshalb von ihnen leicht als ortsfremd erlebt wird: Die hirnlosen islamistischen Zerstörer steuern die Abrissbagger in den antiken Stätten umso leichter, als sich ihre abgrundtiefe, ahnungslose Dummheit mit dem mehr oder weniger diffusen Gefühl verbindet, es handele sich bei diesem Kulturerbe um eine seltsame rückwirkende Emanation der fremden Macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d918556c-0c5d-4b55-a691-79c60daa6a9a",
                        "source_entry_id": "aff57919-5fd0-380e-b627-bffed5b191ef",
                        "source_sense_description": "Without wit or understanding",
                        "target_lang_word": "dumm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dumm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81248644-5e4a-328d-b423-be2570a486e0",
                                        "entry_id": "70eb5c34-f7c1-3fdf-9fd9-0c75c6bcca92",
                                        "glosses": [
                                            "schwach an Verstand, ohne Intelligenz, ohne Können, unwissend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2309cd9d-1d8d-416c-a9cc-069cb441840a",
                                                "sense_id": "81248644-5e4a-328d-b423-be2570a486e0",
                                                "text": "Das Nachbarskind ist wirklich dumm, trotz Nachhilfe schreibt es nur Sechsen in der Schule."
                                            },
                                            {
                                                "example_id": "fb41f00b-70ff-46ec-8157-b4875cbe5061",
                                                "sense_id": "81248644-5e4a-328d-b423-be2570a486e0",
                                                "text": "3 mal 3 ist bei dir 5? Bist du dumm?"
                                            },
                                            {
                                                "example_id": "e0b63efc-221d-465a-b9b9-c70c6554b7b8",
                                                "sense_id": "81248644-5e4a-328d-b423-be2570a486e0",
                                                "text": "„Ich behaupte, ein dummer Diener ist gefährlicher als ein boshafter, vor allem fällt er mehr zur Last; gegen einen boshaften kann man auf der Hut sein, nie aber gegen einen dummen. Eine Nichtswürdigkeit kann man bestrafen, eine Dummheit aber niemals anders, als indem man den Dummen oder die Dumme wegjagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e5ced2b-46b9-30ce-b8ab-2d8a07721bc3",
                                        "entry_id": "70eb5c34-f7c1-3fdf-9fd9-0c75c6bcca92",
                                        "glosses": [
                                            "auf unpassende und kindische Art lustig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0b070c0-26ad-4f4d-8805-7dad94723580",
                                                "sense_id": "9e5ced2b-46b9-30ce-b8ab-2d8a07721bc3",
                                                "text": "Benimm dich und stell dich nicht so dumm an, dann bist du auch erfolgreicher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9a07409a-3958-31b3-b5ef-460fe5b153c2",
                                        "entry_id": "70eb5c34-f7c1-3fdf-9fd9-0c75c6bcca92",
                                        "glosses": [
                                            "mit nachteiligen Folgen, unangenehm, übel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48459d2f-0e38-49f8-850e-ea661c96506e",
                                                "sense_id": "9a07409a-3958-31b3-b5ef-460fe5b153c2",
                                                "text": "Er hat das erste Mal im Auto gesessen und schon einen Unfall gebaut. Das war echt dumm!"
                                            },
                                            {
                                                "example_id": "08142f01-a03a-457f-a7aa-1c2882840d4e",
                                                "sense_id": "9a07409a-3958-31b3-b5ef-460fe5b153c2",
                                                "text": "Die Sache ist dumm gelaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d66efe99-78af-3bd1-9f3b-4ed5d8e19565",
                                        "entry_id": "70eb5c34-f7c1-3fdf-9fd9-0c75c6bcca92",
                                        "glosses": [
                                            "sich taumelig, schwindelig fühlend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80402038-5899-4b25-8d2e-64f2fb83510f",
                                                "sense_id": "d66efe99-78af-3bd1-9f3b-4ed5d8e19565",
                                                "text": "Mein Nachbar hatte gestern seine Musik so laut, dass mir dumm im Kopf wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
