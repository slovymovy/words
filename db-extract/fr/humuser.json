                "senses": [
                    {
                        "sense_id": "476f0348-e6fb-3321-9ce7-120d0b5d8199",
                        "entry_id": "90c921bd-7d6b-3031-80bd-940ad9b6f31e",
                        "glosses": [
                            "Transformer progressivement en humus (en tant que pratique funéraire)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a028e2d-5ada-475d-92d6-f93d5f1c433d",
                                "sense_id": "476f0348-e6fb-3321-9ce7-120d0b5d8199",
                                "text": "Et si, au lieu d'être enterrés ou incinérés, les citoyens décidaient de se faire \"humuser\" ?"
                            },
                            {
                                "example_id": "51546568-db20-48b9-89f2-074e68d7e72f",
                                "sense_id": "476f0348-e6fb-3321-9ce7-120d0b5d8199",
                                "text": "Alors, à 80 ans passés, il a émis un vœu aussi surprenant que pertinent : à sa mort, il ne veut ni être enterré, ni être incinéré, mais humusé."
                            },
                            {
                                "example_id": "284a4fe7-2f16-485e-830d-af4464ba4447",
                                "sense_id": "476f0348-e6fb-3321-9ce7-120d0b5d8199",
                                "text": "Ceux qui rêvent d'une dernière demeure plus naturelle peuvent s'inscrire sur une liste pour se faire \" humuser \"."
                            }
                        ]
                    }
                ],
