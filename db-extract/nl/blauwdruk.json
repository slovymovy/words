                "senses": [
                    {
                        "sense_id": "ce99003c-8953-389f-bcc8-f9351de1778b",
                        "entry_id": "02f305f2-0307-34dc-94c4-1b3c6e62bdb7",
                        "glosses": [
                            "een directe fotografische kopie in witte lijnen op een achtergrond van Pruisisch blauw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c91d0e2-9dcb-46ab-8455-281561669eed",
                                "sense_id": "ce99003c-8953-389f-bcc8-f9351de1778b",
                                "text": "Lange tijd was het maken van een blauwdruk de enige manier om van een tekening meerdere kopieën te maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfa7dc46-826f-3456-a232-561f48039f0d",
                        "entry_id": "02f305f2-0307-34dc-94c4-1b3c6e62bdb7",
                        "glosses": [
                            "een gedetailleerd ontwerp van iets dat in uitvoering genomen gaat worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dfab74-897d-4638-a6a5-b7094c9d4985",
                                "sense_id": "bfa7dc46-826f-3456-a232-561f48039f0d",
                                "text": "De blauwdrukken zijn al gereed en de uitvoering begint volgende maand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff7f1b6f-98b5-48a2-a872-ae73332cdf69",
                        "source_entry_id": "02f305f2-0307-34dc-94c4-1b3c6e62bdb7",
                        "source_sense_id": "ce99003c-8953-389f-bcc8-f9351de1778b",
                        "source_sense_description": "een directe fotografische kopie in witte lijnen op een achtergrond van Pruisisch blauw",
                        "target_lang_word": "Blaupause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blaupause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f687a62-42ed-3b87-83c9-9f1cd767113f",
                                        "entry_id": "7c7efac7-a255-36c9-be34-b5ef87ab8fc6",
                                        "glosses": [
                                            "eine durch Hektographie oder durch das Verwenden von (blauem) Durchschreibepapier, der sogenannten Pause, hergestellte Kopie eines Dokumentes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe29eeb5-ab96-4280-9638-156a6f592a91",
                                                "sense_id": "4f687a62-42ed-3b87-83c9-9f1cd767113f",
                                                "text": "Reich mal bitte die Blaupause rüber."
                                            },
                                            {
                                                "example_id": "02256b56-5593-4fad-8dc8-e5b4e13a90d8",
                                                "sense_id": "4f687a62-42ed-3b87-83c9-9f1cd767113f",
                                                "text": "„Einen Findlingsblock unter den niedrigen Ästen einer mächtigen Eiche, die später den Patio überschirmen würde, als Tisch benutzend, vertieften er und Leon sich dann eine Stunde lang in die Blaupausen, die er sich aus Chicago von einer Firma für Hochbaubedarf hatte kommen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c5b63eb-885b-3442-b6d8-96596e635a9e",
                                        "entry_id": "7c7efac7-a255-36c9-be34-b5ef87ab8fc6",
                                        "glosses": [
                                            "eine Grundidee, die als Vorlage zur Umsetzung von etwas herangezogen wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "797e6931-a287-4a68-af51-e1c7c72cfff5",
                                                "sense_id": "1c5b63eb-885b-3442-b6d8-96596e635a9e",
                                                "text": "„Dieses Programm wäre eine gute Blaupause für ein neues Konjunkturprogramm. Stattdessen lässt die Kanzlerin \"branchenspezifische Lösungen\" prüfen.“"
                                            },
                                            {
                                                "example_id": "842051c5-56fd-423c-95cd-0d826bdeb053",
                                                "sense_id": "1c5b63eb-885b-3442-b6d8-96596e635a9e",
                                                "text": "„Lord of Ultima könnte eine Blaupause für die Zukunft sein: Das Online-Rollenspiel soll sich über den Verkauf von allerlei virtuellen Hilfsmitteln finanzieren.“"
                                            },
                                            {
                                                "example_id": "9295ce5e-bdcb-41ce-a0f4-ceb72e3162ec",
                                                "sense_id": "1c5b63eb-885b-3442-b6d8-96596e635a9e",
                                                "text": "„Die Blaupause für die neue polnische Fabrik lieferte jedoch oft nicht das Stammwerk. Meist fungierte die jeweils neuste Fabrik im Konzernverbund als Blaupause, also der jeweils aktuellste Vorläufer.“"
                                            },
                                            {
                                                "example_id": "7216e2e9-e33d-4633-807e-41186c4360cb",
                                                "sense_id": "1c5b63eb-885b-3442-b6d8-96596e635a9e",
                                                "text": "„Die Reichsverfassung, die von der Nationalversammlung 1919 in der Stadt Weimar verabschiedet worden war, wirkte zu großen Teilen wie eine negative Blaupause, auf der das Grundgesetz bewusst anders konstruiert worden ist.“"
                                            },
                                            {
                                                "example_id": "debd3997-0c4d-4505-9529-3a559d9accc3",
                                                "sense_id": "1c5b63eb-885b-3442-b6d8-96596e635a9e",
                                                "text": "„Zudem geriet er - nicht zuletzt, da sein Reich nahezu den gesamten südasiatischen Subkontinent umfasste - zur antiken Blaupause für das moderne Indien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "306ab826-0a71-49c5-8ce7-38d148a4da82",
                        "source_entry_id": "02f305f2-0307-34dc-94c4-1b3c6e62bdb7",
                        "source_sense_id": "ce99003c-8953-389f-bcc8-f9351de1778b",
                        "source_sense_description": "een directe fotografische kopie in witte lijnen op een achtergrond van Pruisisch blauw",
                        "target_lang_word": "blueprint",
