                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d02cae-3f08-4dcf-bfa8-d2491ebaad15",
                                "sense_id": "50013685-f19b-32d2-b309-c80e70659a79",
                                "text": "„Die beiden nahmen sich vor, das Gegenteil eines Massenquartiers zu schaffen, daher das Prinzip des Dorfes und der locker gruppierten, zweistöckigen Häuser mit Innenhöfen, die Luftigkeit und zugleich Geborgenheit vermitteln.“"
                            },
                            {
                                "example_id": "5e5e8dd1-8345-43fe-b16c-3b17c7e0dc79",
                                "sense_id": "50013685-f19b-32d2-b309-c80e70659a79",
                                "text": "„Alle verfügbaren Räume haben sich in Massenquartiere mit Strohlagern verwandelt, doch Mutter und ich bekommen sogar ein kleines Zimmer mit zwei Betten zugewiesen.“"
                            }
                        ],
