                "senses": [
                    {
                        "sense_id": "1c02b89d-6b11-3802-974f-91a1e15c69f7",
                        "entry_id": "c2f08fda-d502-3450-8a64-caac8f00b402",
                        "glosses": [
                            "side road, rat run; secret path"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "4551456a-1890-4308-b8bc-4f5a59b0a993",
                                "sense_id": "1c02b89d-6b11-3802-974f-91a1e15c69f7",
                                "text": "»[…] Ist es sittlich, junge, lebensvolle Mädchen, die auf Freude dasselbe Recht haben wie die höheren Töchter, denen die Natur dasselbe Verlangen nach der Erfüllung ihrer Geschlechtsbestimmung verlieh wie diesen, auf Hintertreppen, auf Schleichwege und zweifelhafte Balllokale anzuweisen, statt ihnen den Schutz des Hauses zu verleihen ..?«",
                                "translation": "Memoirs of a Woman Socialist",
                                "english": "Memoirs of a Woman Socialist"
                            }
                        ]
                    }
