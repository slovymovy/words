                    "frequency": "Middle",
                    "semantic_group_id": "excessief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het lawaai van de buren irriteert me <w>mateloos</w> tijdens het studeren.",
                            "target_lang_translations": {
                                "en": "The noise from the neighbors irritates me <w>immensely</w> while studying."
                            }
                        },
                        {
                            "text": "Zij kan zich <w>mateloos</w> ergeren aan mensen die hun afspraken niet nakomen.",
                            "target_lang_translations": {
                                "en": "She can get <w>endlessly</w> annoyed by people who do not keep their appointments."
                            }
                        }
                    ],
                    "synonyms": [
