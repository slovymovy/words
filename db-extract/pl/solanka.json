                        ],
                        "examples": [],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "8f63802e-2c3d-3f76-8a3b-28054b02670a",
                        "entry_id": "499ac653-a738-324b-92b3-57b817e8f0ff",
                        "glosses": [
                            "tradycyjna zupa chłopska z terenów Ukrainy i Rosji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de22f28-4507-4f15-ad18-54689f1af2e8",
                                "sense_id": "8f63802e-2c3d-3f76-8a3b-28054b02670a",
                                "text": "W jednej z katowickich restauracji podali nam prawdziwą ukraińską solankę."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ac5890-5bf2-4a1a-b331-2f7c80d0592d",
                        "source_entry_id": "499ac653-a738-324b-92b3-57b817e8f0ff",
                        "source_sense_id": "07231820-2531-3da3-8024-85617e69bad6",
                        "target_lang_word": "brine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99c1ce7d-de6f-3279-8bc8-63575cb3ddff",
                                        "entry_id": "926d8828-132e-3876-875a-9827998055ca",
                                        "glosses": [
                                            "Salt water; water saturated or strongly impregnated with salt; a salt-and-water solution for pickling."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed95aed-8a8f-47d5-ba77-da6e5e0858b8",
                                                "sense_id": "99c1ce7d-de6f-3279-8bc8-63575cb3ddff",
                                                "text": "Do you want a can of tuna in oil or in brine?"
                                            },
                                            {
                                                "example_id": "2e57e4a9-77d9-43b0-ae5f-4c23bb0d403c",
                                                "sense_id": "99c1ce7d-de6f-3279-8bc8-63575cb3ddff",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9081f617-87ad-31f8-8702-4bca86727cf5",
                                        "entry_id": "926d8828-132e-3876-875a-9827998055ca",
                                        "glosses": [
                                            "The sea or ocean; the water of the sea."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "518683ca-a1e8-4273-a57d-afc5464e8064",
                                                "sense_id": "9081f617-87ad-31f8-8702-4bca86727cf5",
                                                "text": "Ariell: Not a ſoule\n But felt a Feauer of the madde, and plaid\n Some tricks of deſperation ; all but Mariners\n Plung'd in the foaming bryne, and quit the veſſell ;\n Then all a fire with me the Kings ſonne Ferdinand\n With haire vp-ſtaring (then like reeds, not haire)\n Was the firſt man that leapt ; cride hell is empty,\n And all the Diuels are heere."
                                            },
                                            {
                                                "example_id": "7e2f0b2a-393b-462b-8c89-c3bf159f5b7e",
                                                "sense_id": "9081f617-87ad-31f8-8702-4bca86727cf5",
                                                "text": "\"Ho, aboard the Salt Junk Sarah,\nRollin\" home across the line,\nThe Bo'sun collared the Captain's hat\nAnd threw it in the brine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brine",
