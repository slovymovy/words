                "senses": [
                    {
                        "sense_id": "e52285a3-0c3d-341d-a4d0-13188f0d458c",
                        "entry_id": "1e22b1ba-072b-3f39-b0b6-e7b5141be07e",
                        "glosses": [
                            "Doctrine bouddhique qui enseigne que l’on ne peut atteindre le nirvana qu’après de multiples vies conformes à la doctrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7102fe05-0428-4610-ad28-b046c01c576a",
                                "sense_id": "e52285a3-0c3d-341d-a4d0-13188f0d458c",
                                "text": "L’antinomie du subitisme et du gradualisme était bien connue des bouddhistes de l’Inde."
                            },
                            {
                                "example_id": "ffa4ea98-6c4e-42b5-905a-d7d590f8e724",
                                "sense_id": "e52285a3-0c3d-341d-a4d0-13188f0d458c",
                                "text": "Les plus remarquables commentateurs ont vu dans le gradualisme d’une part et le subitisme de l’autre des aspects d’un ancien dilemme chinois, celui de dong et de jing : l’activité et la passivité."
                            }
                        ]
                    },
                    {
                        "sense_id": "46def617-388e-3c7b-80a6-531349407ffc",
                        "entry_id": "1e22b1ba-072b-3f39-b0b6-e7b5141be07e",
                        "glosses": [
                            "Attitude réformatrice modérée, procédant par paliers."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c47211cd-3be8-3319-a267-6459a573fd6d",
                        "entry_id": "1e22b1ba-072b-3f39-b0b6-e7b5141be07e",
                        "glosses": [
                            "Hypothèse néodarwinienne selon laquelle les espèces évoluent lentement par micro-mutations successives."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22bf99f5-25bf-445b-adf6-4b61e33c3bc8",
                        "source_entry_id": "1e22b1ba-072b-3f39-b0b6-e7b5141be07e",
                        "target_lang_word": "gradualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gradualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a226c3f8-6c3d-3a1a-b0e9-fb42b7ed8c5e",
                                        "entry_id": "46321fcc-1fe1-39ef-a72b-0ac29f1f24b0",
                                        "glosses": [
                                            "The belief that evolution proceeds at a steady pace, without the sudden development of new species or biological features from one generation to the next."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "904871d2-3af5-3889-8b64-93a15cb279b9",
                                        "entry_id": "46321fcc-1fe1-39ef-a72b-0ac29f1f24b0",
                                        "glosses": [
                                            "The belief that some phenomenon occurs gradually over a long period of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f9f801-f9e8-48cd-9c53-0161f8ee91ec",
                                                "sense_id": "904871d2-3af5-3889-8b64-93a15cb279b9",
                                                "text": "Given enough time, the logic goes, water can cleave solid rock and mountains can be reduced to plains. This \"gradualism\" now underpins modern geologic thought. ... Maybe we'll find evidence that the rock layers are exposed on the flanks of Mount Sharp [on Mars] not because a river carved through them over millions of years, but because the wind blew against them for billions of years – the ultimate in gradualism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f10f96e-6221-3d19-99f3-44c8e2f27f81",
                                        "entry_id": "46321fcc-1fe1-39ef-a72b-0ac29f1f24b0",
                                        "glosses": [
                                            "The belief that change ought to be brought about in small, discrete increments rather than in abrupt strokes such as revolutions or uprisings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
