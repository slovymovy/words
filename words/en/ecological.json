                            }
                        },
                        {
                            "text": "Scientists are conducting an <w>ecological</w> study to understand how climate change affects local wildlife.",
                            "target_lang_translations": {
                                "ru": "Ученые проводят <w>экологическое</w> исследование, чтобы понять, как изменение климата влияет на местную фауну."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ecological balance",
                        "ecological system",
                        "ecological study",
                        "ecological niche"
                    ],
                    "target_lang_definitions": {
