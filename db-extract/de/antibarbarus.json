                "senses": [
                    {
                        "sense_id": "9a842c42-4c23-3dcf-9ebf-b484ceb5cc59",
                        "entry_id": "5c93a0df-12fb-37ce-a459-3fd611e12ead",
                        "glosses": [
                            "Buch, in dem sprachliche Unkorrektheiten (Barbarismen) aufgelistet und korrigiert werden und das häufig auch gegen Fremdwörter gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d292d4e-c65e-48fd-92c7-f51730b8cbe2",
                                "sense_id": "9a842c42-4c23-3dcf-9ebf-b484ceb5cc59",
                                "text": "Im 18. Jahrhundert wurden die ersten Antibarbari veröffentlicht."
                            },
                            {
                                "example_id": "8ac9c583-cf63-493b-a10c-2d2b64fe73b8",
                                "sense_id": "9a842c42-4c23-3dcf-9ebf-b484ceb5cc59",
                                "text": "„Es bildet im Deutschen den Höhepunkt jener jahrhundertealten Tradition sogenannter Antibarbari, die der Bekämpfung von »Barbarismen« in Sprache und Stil dienten: Negativzusammenstellungen speziell stilistischer Fehler und Unschönheiten, die vor allen Dingen abschrecken sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
