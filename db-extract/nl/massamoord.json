                "senses": [
                    {
                        "sense_id": "0bafd3eb-c37a-37b6-bf45-12f0a77199c8",
                        "entry_id": "a0449804-7417-3359-a5a7-869ffe01bf7d",
                        "glosses": [
                            "moord op een groot aantal personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d79a409-3bcf-427a-9240-8e223ca652d4",
                                "sense_id": "0bafd3eb-c37a-37b6-bf45-12f0a77199c8",
                                "text": "De generaal wordt gezocht vanwege zijn aandeel in de massamoord op duizenden mannen na de val van de enclave."
                            },
                            {
                                "example_id": "22724253-c4a4-4230-a3be-1976fed3f8a3",
                                "sense_id": "0bafd3eb-c37a-37b6-bf45-12f0a77199c8",
                                "text": "Twee zwaar bewapende leerlingen voerden een tevoren beraamde massamoord uit en schoten twaalf leerlingen en een docent dood."
                            },
                            {
                                "example_id": "88f03949-fa1d-4840-907c-6da3da53ae8b",
                                "sense_id": "0bafd3eb-c37a-37b6-bf45-12f0a77199c8",
                                "text": "Tegen het eind van het verhaal haalde de vader een groot album tevoorschijn met krantenknipsels en foto's die over een massamoord gingen die zo groot was dat het niet te bevatten was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38e03442-47c5-44d5-a151-b425b271fae2",
                        "source_entry_id": "a0449804-7417-3359-a5a7-869ffe01bf7d",
                        "source_sense_id": "0bafd3eb-c37a-37b6-bf45-12f0a77199c8",
                        "source_sense_description": "moord op een groot aantal personen",
                        "target_lang_word": "Massenmord",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massenmord",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                        "entry_id": "e92d5db6-662e-32e0-b14f-1825d9f6efdb",
                                        "glosses": [
                                            "Mord an vielen Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af3fba07-a3c1-4e61-8f37-700518e31985",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„In den 16 Jahren seit dem Massenmord entwickelte sich der ostafrikanische Kleinstaat zu einem der Länder Afrikas mit den höchsten wirtschaftlichen Wachstumsraten.“"
                                            },
                                            {
                                                "example_id": "416334a1-f69f-4bb6-a3ca-d544712046ef",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„Und heute drohen Unterseeboote mit Massenmord, unsere dumme, unsere einzige Art, vom Massenmord abzuschrecken.“"
                                            },
                                            {
                                                "example_id": "0467192d-080d-4c67-9ede-3a8fada21740",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„Zeit seines Lebens hatte Elia geglaubt, den Massenmord als einziger dieser hundertsechzig überlebt zu haben, erst spät fand er die zweite Überlebende aus seiner Familie, seine Schwester, als alte Frau in Aleppo.“"
                                            },
                                            {
                                                "example_id": "e53cbef9-6290-4301-887e-09155ecadbbb",
                                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                                "text": "„Aus Gewohnheit lese ich zuerst Berichte über den Massenmord, schneide sie aus, bewahre sie auf, unterstreiche aber vorher, ehe ich sie ablege, die Namen der geschnappten Verbrecher, ebenso die noch gesuchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
