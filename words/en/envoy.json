{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59621a29-429b-379c-aa50-d0c063e82458",
                    "sense_definition": "A person sent as a representative or messenger, especially on a official or diplomatic mission.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president appointed a special <w>envoy</w> to negotiate the peace agreement.      ",
                            "target_lang_translations": {
                                "tr": "Başkan, barış anlaşmasını müzakere etmek üzere özel bir <w>elçi</w> atadı."
                            }
                        },
                        {
                            "text": "He served as a special <w>envoy</w> to the international summit to represent his country's interests.      ",
                            "target_lang_translations": {
                                "tr": "Ülkesinin çıkarlarını temsil etmek amacıyla uluslararası zirvede özel <w>temsilci</w> olarak görev yaptı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "special envoy",
                        "presidential envoy"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle resmi veya diplomatik bir görev için temsilci veya temsilci olarak gönderilen kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "elçi",
                                "target_lang_sense_clarification": "temsilci veya ulak"
                            },
                            {
                                "target_lang_word": "temsilci",
                                "target_lang_sense_clarification": "resmi görevli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9fa02d0-2e2a-3afd-af84-fe36344f5526",
                    "sense_definition": "A diplomatic agent ranking immediately below an ambassador.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly appointed foreign <w>envoy</w> delivered his credentials to the government.      ",
                            "target_lang_translations": {
                                "tr": "Yeni atanan yabancı <w>elçi</w>, güven mektubunu hükümete sundu."
                            }
                        },
                        {
                            "text": "As an extra diplomatic official, he acted as an <w>envoy extraordinary</w> during the crisis.      ",
                            "target_lang_translations": {
                                "tr": "Ek bir diplomatik görevli olarak, kriz sırasında <w>fevkalade murahhas elçi</w> olarak hareket etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "envoy extraordinary",
                        "minister plenipotentiary"
                    ],
                    "common_phrases": [
                        "foreign envoy"
                    ],
                    "target_lang_definitions": {
                        "tr": "Büyükelçinin hemen altında yer alan diplomatik görevli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "orta elçi",
                                "target_lang_sense_clarification": "diplomatik unvan"
                            },
                            {
                                "target_lang_word": "elçi",
                                "target_lang_sense_clarification": "diplomat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c9ffb9-bb8b-3366-a23d-80110eb1e0fa",
                    "sense_definition": "A short concluding stanza at the end of a poem, such as a ballade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet concluded the ballade with a brief and elegant <w>envoy</w>.      ",
                            "target_lang_translations": {
                                "tr": "Şair, baladı kısa ve zarif bir <w>sunuş kıtası</w> ile tamamladı."
                            }
                        },
                        {
                            "text": "Students analyzed the main stanzas as well as the final <w>envoy</w> of the classic poem.      ",
                            "target_lang_translations": {
                                "tr": "Öğrenciler, klasik şiirin ana kıtalarının yanı sıra son <w>kıtayı</w> da incelediler."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şiirin (örneğin bir baladın) sonundaki kısa sonuç kıtası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sunuş kıtası",
                                "target_lang_sense_clarification": "edebiyat terimi"
                            },
                            {
                                "target_lang_word": "envoi",
                                "target_lang_sense_clarification": "şiir terimi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}