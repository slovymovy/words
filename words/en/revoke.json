{
    "word_family": [
        "revocation",
        "revocable",
        "irrevocable",
        "irrevocably",
        "revocatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d10d8afd-30d8-35f8-a780-4cb1cbb7c5c9",
                    "sense_definition": "To officially cancel, annul, or withdraw an order, license, law, or privilege.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cancel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authorities decided to <w>revoke</w> his driver's license after repeated traffic violations.",
                            "target_lang_translations": {
                                "nl": "De autoriteiten besloten zijn rijbewijs <w>in te trekken</w> na herhaalde verkeersovertredingen."
                            }
                        },
                        {
                            "text": "The government may <w>revoke</w> the company's operating permit if standards are not met.",
                            "target_lang_translations": {
                                "nl": "De overheid kan de exploitatievergunning van het bedrijf <w>intrekken</w> als er niet aan de normen wordt voldaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "withdraw"
                    ],
                    "common_phrases": [
                        "revoke a license",
                        "revoke a permit",
                        "revoke an offer"
                    ],
                    "target_lang_definitions": {
                        "nl": "Officieel intrekken, ongeldig verklaren of tenietdoen van een bevel, vergunning, wet of privilege."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "intrekken",
                                "target_lang_sense_clarification": "van een vergunning, besluit of rijbewijs"
                            },
                            {
                                "target_lang_word": "herroepen",
                                "target_lang_sense_clarification": "formeel ongeldig verklaren of terugdraaien van een besluit of verklaring"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c3604d3-3083-3fcd-8f7b-c0f9ef013b8c",
                    "sense_definition": "To fail to follow suit in a card game when able and required by the rules to do so.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accidentally <w>revoked</w> during the second trick and conceded the penalty points.",
                            "target_lang_translations": {
                                "nl": "Hij <w>verzaakte</w> per ongeluk tijdens de tweede slag en kreeg strafpunten tegen."
                            }
                        },
                        {
                            "text": "If a player does not notice their error and continues, they might <w>revoke</w> again.",
                            "target_lang_translations": {
                                "nl": "Als een speler zijn fout niet opmerkt en doorspeelt, kan hij opnieuw <w>verzaken</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Bij een kaartspel geen kleur bekennen terwijl men daartoe wel verplicht en in staat is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verzaken",
                                "target_lang_sense_clarification": "bij kaartspelen, niet bekennen"
                            },
                            {
                                "target_lang_word": "renonceren",
                                "target_lang_sense_clarification": "kaartterm: niet bekennen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4d4ac2a-4bc8-3eed-970f-c0599b51d0b3",
                    "sense_definition": "To summon or call back.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient incantation seemed to <w>revoke</w> wandering spirits from the gloom.",
                            "target_lang_translations": {
                                "nl": "De oude bezwering leek dolende geesten uit de duisternis <w>terug te roepen</w>."
                            }
                        },
                        {
                            "text": "No mortal command could ever <w>revoke</w> the departed soul to its clay.",
                            "target_lang_translations": {
                                "nl": "Geen enkel sterfelijk bevel zou ooit de heengegane ziel kunnen <w>terugroepen</w> naar haar stoffelijk omhulsel."
                            }
                        }
                    ],
                    "synonyms": [
                        "recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Terugroepen of ontbieden (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "terugroepen",
                                "target_lang_sense_clarification": "iemand of iets doen terugkeren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "146c193a-4aec-304b-ad8d-46114a87cbde",
                    "sense_definition": "To hold back or check.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restrain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She could barely <w>revoke</w> her anger when hearing the cruel accusation.",
                            "target_lang_translations": {
                                "nl": "Ze kon haar woede nauwelijks <w>bedwingen</w> toen ze de wrede beschuldiging hoorde."
                            }
                        },
                        {
                            "text": "Wise elders counseled the young warrior to <w>revoke</w> his bitter impulse.",
                            "target_lang_translations": {
                                "nl": "Wijze oudsten adviseerden de jonge krijger om zijn bittere impuls <w>in te houden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "repress",
                        "restrain"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Inhouden, bedwingen of beteugelen (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "inhouden",
                                "target_lang_sense_clarification": "emoties of impulsen bedwingen"
                            },
                            {
                                "target_lang_word": "bedwingen",
                                "target_lang_sense_clarification": "onder controle houden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2f3dedb-64d9-3a4f-bd3a-62b58db59db9",
                    "sense_definition": "To bring back to memory; to recollect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>revoke</w> the memories of childhood that had long since faded.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde de herinneringen aan zijn kindertijd, die allang vervaagd waren, weer <w>voor de geest te halen</w>."
                            }
                        },
                        {
                            "text": "In silence, she could <w>revoke</w> every detail of their fateful conversation.",
                            "target_lang_translations": {
                                "nl": "In stilte kon ze zich elk detail van hun noodlottige gesprek weer <w>herinneren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "recollect",
                        "remember"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Weer voor de geest halen; zich herinneren (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zich herinneren",
                                "target_lang_sense_clarification": "in herinnering roepen"
                            },
                            {
                                "target_lang_word": "voor de geest halen",
                                "target_lang_sense_clarification": "weer in herinnering brengen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10f18879-074e-3892-9a15-7b24bf62d62d",
                    "sense_definition": "An instance of failing to follow suit in a card game when required by the rules.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee penalised the partnership after an accidental <w>revoke</w> occurred.",
                            "target_lang_translations": {
                                "nl": "De scheidsrechter bestrafte het paar nadat er een onopzettelijke <w>verzaking</w> plaatsvond."
                            }
                        },
                        {
                            "text": "Committing a <w>revoke</w> during the tournament cost their team crucial match points.",
                            "target_lang_translations": {
                                "nl": "Het begaan van een <w>renonce</w> tijdens het toernooi kostte hun team cruciale wedstrijdpunten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een overtreding bij een kaartspel waarbij een speler nalaat kleur te bekennen terwijl dat wel moet."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verzaking",
                                "target_lang_sense_clarification": "fout bij het kaartspel door niet te bekennen"
                            },
                            {
                                "target_lang_word": "renonce",
                                "target_lang_sense_clarification": "het niet bekennen bij kaartspelen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}