                    {
                        "translation_id": "149a6fec-c85b-437b-a9aa-cb8fec280e26",
                        "source_entry_id": "ff94ddc5-be29-363f-aaea-b282fea6363b",
                        "source_sense_description": "study of the dosages of drugs",
                        "target_lang_word": "posologie",
