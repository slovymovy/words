                "senses": [
                    {
                        "sense_id": "398109b6-7191-3554-b7f4-1000429d10e6",
                        "entry_id": "f9dc995b-0189-3fb5-9b5d-4135953d87e2",
                        "glosses": [
                            "Variante de vouvoyer"
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ca7d7e72-af80-4ece-b937-db332afd63fb",
                                "sense_id": "398109b6-7191-3554-b7f4-1000429d10e6",
                                "text": "Tel est l’usage français : il n’est personne, quelque bas, quelque vil qu’il soit, qu’on ne puisse vousoyer."
                            },
                            {
                                "example_id": "89874c9f-3458-40b0-93fa-9a8c83a74fb7",
                                "sense_id": "398109b6-7191-3554-b7f4-1000429d10e6",
                                "text": "Je garde confiance, répondait le biologiste. Vous verrez ! Car ils avaient continué de se vousoyer, ainsi qu’il est d’usage dans l’aristocratie allemande, mais aussi dans la grande bourgeoisie française attachée à ses traditions."
                            }
                        ]
                    }
