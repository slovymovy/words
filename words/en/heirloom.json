            "senses": [
                {
                    "sense_id": "5a158133-43b2-3800-9ed0-de227f61bb93",
                    "sense_definition": "A valuable object that has belonged to a family for several generations and is passed down from one member to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inherited_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This diamond ring is a family <w>heirloom</w> that belonged to my great-grandmother."
                        },
                        {
                            "text": "He treated the antique grandfather clock as a precious <w>heirloom</w>."
                        }
                    ],
                    "synonyms": [
                        "patrimony"
                    ],
                    "common_phrases": [
                        "family heirloom",
                        "priceless heirloom"
                    ]
                },
                {
                    "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                    "sense_definition": "A traditional variety of a plant, vegetable, or fruit that has been grown and preserved over many generations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanical_variety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many gardeners prefer to grow <w>heirloom</w> tomatoes because of their exceptional flavor."
                        },
                        {
                            "text": "The local farm specializes in preserving rare <w>heirlooms</w> from the nineteenth century."
                        }
                    ],
                    "common_phrases": [
