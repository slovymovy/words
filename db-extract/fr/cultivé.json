                "senses": [
                    {
                        "sense_id": "5bcd0072-3dd9-30df-b3b8-1b4f90863c3b",
                        "entry_id": "facb4fc6-5f7d-3284-ac8a-e3248c4bbb34",
                        "glosses": [
                            "Travaillé pour rendre plus fertile et productif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0f52d8-bb5b-48c9-8bbd-e2fcb86e51f1",
                                "sense_id": "5bcd0072-3dd9-30df-b3b8-1b4f90863c3b",
                                "text": "Des trois bandes ou régions qui divisaient devant nous la plaine d’Athènes, nous traversâmes les deux premières, la région inculte et la région cultivée."
                            },
                            {
                                "example_id": "e4f69469-5282-437a-aa8c-6dbdf17068c9",
                                "sense_id": "5bcd0072-3dd9-30df-b3b8-1b4f90863c3b",
                                "text": "La limite de l’Olivier, bien qu’artificielle, puisque c'est une plante cultivée, est la meilleure limite de la flore méditerranéenne en France."
                            }
                        ]
                    },
                    {
                        "sense_id": "81e6e835-7589-39a6-9e20-e2a5f3f2f6c6",
                        "entry_id": "facb4fc6-5f7d-3284-ac8a-e3248c4bbb34",
                        "glosses": [
                            "Qui a de la culture, de la connaissance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "40576195-0301-4960-a0b7-21e236d531c2",
                                "sense_id": "81e6e835-7589-39a6-9e20-e2a5f3f2f6c6",
                                "text": "Lorsque ces maîtres franco-parisiens commenceront d’enseigner en déclamant pédantesquement leurs démonstrations scolastiques, les Toulousains cultivés, venus les écouter, éclateront de rire."
                            }
                        ]
                    }
                ],
