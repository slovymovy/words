                    {
                        "sense_id": "d83c6af6-633e-366c-8573-b9a40b8cf043",
                        "entry_id": "ebb89cde-5c2b-3239-9dd4-61ffbe1d050d",
                        "glosses": [
                            "ein Gerät zur Übermittlung von Nachrichten, wobei ein Abbild der Nachricht versendet und empfangen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde4ad96-d62c-46d2-b283-c15fceab93b7",
                                "sense_id": "d83c6af6-633e-366c-8573-b9a40b8cf043",
                                "text": "Wir benutzen das Telefax immer noch gerne, weil wir viele Bauzeichnungen verschicken müssen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "44d2551f-09fe-30d6-83d5-40ae68779a33",
                        "entry_id": "ebb89cde-5c2b-3239-9dd4-61ffbe1d050d",
                        "glosses": [
                            "die Nachricht, die per Faxgerät versendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4783afd-e919-405c-b48b-e64873359e7b",
                                "sense_id": "44d2551f-09fe-30d6-83d5-40ae68779a33",
                                "text": "Möchten Sie den Entwurf als Telefax oder als Kopie in der Post?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
