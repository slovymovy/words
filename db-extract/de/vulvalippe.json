                "senses": [
                    {
                        "sense_id": "443eaf3a-bc52-3a78-bd5f-5253c5cc88c8",
                        "entry_id": "b8092ea4-67da-3646-ad4a-20a5a4b51e3b",
                        "glosses": [
                            "doppelt paarig auftretender Teil der äußeren weiblichen Geschlechtsorgane, die in ihrer Gesamtheit als Vulva bezeichnet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57b7d335-95a2-460e-9730-0e3dab86b02c",
                                "sense_id": "443eaf3a-bc52-3a78-bd5f-5253c5cc88c8",
                                "text": "„Dass diese weitverbreitet als große und kleine Vulvalippen bezeichnet werden, ist ein weiteres Problem im Umgang mit dem weiblichen Geschlechtsorgan, denn dieser Ausdruck suggeriert, dass die äußeren Vulvalippen immer die großen und die inneren Vulvalippen immer die kleineren Lippen sind.“"
                            },
                            {
                                "example_id": "3516825c-5f51-4e19-82b8-074e03dc7d38",
                                "sense_id": "443eaf3a-bc52-3a78-bd5f-5253c5cc88c8",
                                "text": "„Vor vier Jahren hat zum Beispiel die US-amerikanische Firma Dame, gegründet von zwei New Yorkerinnen, den ersten tragbaren Klitorisstimulator auf den Markt gebracht. Er wird an den Vulvalippen befestigt und ermöglicht Frauen, die ihn tragen, die Hände beim Sex frei zu haben.“"
                            },
                            {
                                "example_id": "3aa32c64-10eb-4554-bfc9-c84351073b68",
                                "sense_id": "443eaf3a-bc52-3a78-bd5f-5253c5cc88c8",
                                "text": "„In den meisten Köpfen gibt es ein kulturelles Bild einer Norm-Vulva: glattrasiert, die Hautfarbe ist genau wie der Rest des Körpers, die inneren Vulvalippen kleiner als die äußeren, die Klitoris ist nicht besonders groß.“"
                            },
                            {
                                "example_id": "c4290f1b-685b-499d-a435-c79ae7f0d388",
                                "sense_id": "443eaf3a-bc52-3a78-bd5f-5253c5cc88c8",
                                "text": "„Wenn Christiane Kolb über Penis und Vulva spricht, Eichel und äußere wie innere Vulvalippen benennt, dann transportiert sie das fragile Thema mit Natürlichkeit und Offenheit – vielleicht auch, weil sie selbst Mutter zweier Mädchen ist.“"
                            },
                            {
                                "example_id": "ac762bc7-c142-4ea5-b323-b6d64e648052",
                                "sense_id": "443eaf3a-bc52-3a78-bd5f-5253c5cc88c8",
                                "text": "„Die Vulva umfasst die großen und kleinen Vulvalippen, die Klitoris, die Harnröhre sowie den Vaginaleingang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
