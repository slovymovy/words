                    {
                        "sense_id": "a2664e72-909f-37e7-af17-1cf3c282475a",
                        "entry_id": "2f4340dd-2cd8-367c-8fbc-f1749c296b63",
                        "glosses": [
                            "Taux de sodium dans le plasma sanguin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117c5d24-8ca5-45e9-8fd4-c6dd14423f89",
                                "sense_id": "a2664e72-909f-37e7-af17-1cf3c282475a",
                                "text": "La natrémie est jugée normale si elle se situe entre 135 et 145 milliéquivalents par litre de sang (mEq/L). Une simple prise de sang, réalisée au niveau du bras, permet de la mesurer."
                            },
                            {
                                "example_id": "2a596e83-1fd6-483d-821d-0f273aebe6cc",
                                "sense_id": "a2664e72-909f-37e7-af17-1cf3c282475a",
                                "text": "Ainsi, la survenue des symptomes cliniques d’hyponatrémie se produit à des natrémies (Na+) moyennes plus hautes chez l’enfant (120 mmol.l⁻¹) par rapport à l’adulte (111 mmol.l⁻¹)."
                            }
                        ]
                    }
                ],
