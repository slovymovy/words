                        "examples": [
                            {
                                "example_id": "9b5dba20-d902-4673-95d5-38d6cbd6756e",
                                "sense_id": "8a6cb296-fa68-36e4-ac38-a9ef74afb0ee",
                                "text": "„Der Westen muss Putin zu verstehen geben, wo die rote Linie liegt. Das erfordert die Bereitschaft, entschlossen zu handeln. Denn niemand weiß, wo der russische Landhunger endet“"
                            },
                            {
                                "example_id": "dc14c760-aa3a-40ec-b6e9-1ccf64fda48c",
                                "sense_id": "8a6cb296-fa68-36e4-ac38-a9ef74afb0ee",
                                "text": "„Der Landhunger der Biogas-Anlagen frisst uns auf“"
                            },
                            {
                                "example_id": "43115b57-503a-40eb-9c00-56df894d4d61",
                                "sense_id": "8a6cb296-fa68-36e4-ac38-a9ef74afb0ee",
                                "text": "„Um die Wende vom 2. zum 1. Jahrhundert v. Chr. hatte Rom an den Kimbern und Teutonen erstmals den Landhunger germanischer Stämme kennen gelernt.“"
                            }
                        ],
