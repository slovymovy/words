                ],
                "senses": [
                    {
                        "sense_id": "f30cca43-3494-32fd-97f9-eb068dc431bc",
                        "entry_id": "5d58257e-7bfd-34c2-bc3a-d4b8f6d86e3e",
                        "glosses": [
                            "die Aufnahme von Alkohol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8902b8cd-1814-498f-b7ff-ed96f22bb7ca",
                                "sense_id": "f30cca43-3494-32fd-97f9-eb068dc431bc",
                                "text": "Sein hoher Alkoholkonsum ist schlecht für seine Gesundheit."
                            },
                            {
                                "example_id": "8019af28-46ae-49c6-9a86-d88e3c82abf1",
                                "sense_id": "f30cca43-3494-32fd-97f9-eb068dc431bc",
                                "text": "„1933 setzt der Senat fünfzehn Jahren heimlicher Trinkerei ein Ende und legalisiert den Alkoholkonsum wieder.“"
                            },
                            {
                                "example_id": "bdc4a91e-db96-40f2-b58a-0c9069ee87e2",
                                "sense_id": "f30cca43-3494-32fd-97f9-eb068dc431bc",
                                "text": "„Die Staatsanwaltschaft ordnete eine Blutentnahme zur Überprüfung auf Alkohol- und Drogenkonsum an.“"
                            },
                            {
                                "example_id": "29ab7bf3-90b9-4547-8c92-21931fc3cfc2",
                                "sense_id": "f30cca43-3494-32fd-97f9-eb068dc431bc",
                                "text": "„Die Beamten trieben Korruption und Alkoholkonsum in ungekannte Höhen, und obwohl die Sklaven jetzt frei waren, ging es ihnen kaum besser.“"
                            },
                            {
                                "example_id": "2c8d2620-ffe2-4827-8ca3-b45279e088f1",
                                "sense_id": "f30cca43-3494-32fd-97f9-eb068dc431bc",
                                "text": "„Auch die Prohibition in den zwanziger Jahren des letzten Jahrhunderts bewirkte nicht, dass die amerikanische Bevölkerung ihren Alkoholkonsum verringerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
