    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                    "sense_definition": "État ou qualité de ce qui manque de flexibilité ou de souplesse au toucher ou dans le mouvement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa longue séance de gymnastique, elle a ressenti une certaine <w>raideur</w> dans les jambes."
                        },
                        {
                            "text": "La <w>raideur</w> de ce câble métallique empêche de le plier facilement sans outil adapté."
                        }
                    ],
                    "synonyms": [
                        "rigidité",
                        "tension"
                    ],
                    "antonyms": [
                        "élasticité",
                        "souplesse"
                    ],
                    "common_phrases": [
                        "raideur musculaire"
                    ]
                },
                {
                    "sense_id": "7a9d04fd-fcfd-3495-8656-9b7bffa1962f",
                    "sense_definition": "Caractère d'une pente, d'une côte ou d'un escalier particulièrement abrupt ou difficile à gravir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>raideur</w> de la pente a obligé les randonneurs à ralentir considérablement leur allure."
                        },
                        {
                            "text": "Les cyclistes ont été surpris par la <w>raideur</w> de la montée finale vers le col."
                        }
                    ],
                    "synonyms": [
                        "abruptesse",
                        "escarpement"
                    ],
                    "common_phrases": [
                        "raideur de la pente",
                        "raideur de la montée"
                    ]
                },
                {
                    "sense_id": "4c669a52-2b15-38d1-88fb-c63480da2850",
                    "sense_definition": "Inflexibilité ou sévérité excessive dans le caractère, l'attitude ou les principes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa <w>raideur</w> excessive lors des négociations a fini par décourager tous ses partenaires commerciaux."
                        },
                        {
                            "text": "Le directeur fait preuve d'une grande <w>raideur</w> dès qu'on évoque le règlement intérieur."
                        }
                    ],
                    "synonyms": [
                        "austérité",
                        "fermeté",
                        "inflexibilité",
                        "intransigeance"
                    ],
                    "antonyms": [
                        "indulgence",
                        "souplesse"
                    ],
                    "common_phrases": [
                        "raideur de caractère"
                    ]
                },
                {
                    "sense_id": "c48136b8-177d-3e74-9454-412eca496d32",
                    "sense_definition": "Diminution pathologique ou temporaire de l'amplitude du mouvement d'une articulation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "propriete_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette affection des articulations provoque une forte <w>raideur</w> au réveil chez de nombreux patients."
                        },
                        {
                            "text": "Le médecin a constaté une <w>raideur</w> anormale du cou après l'accident de voiture."
                        }
                    ],
                    "synonyms": [
                        "ankylose"
                    ],
                    "common_phrases": [
                        "raideur articulaire"
                    ]
                },
                {
                    "sense_id": "1bc65156-a887-3c90-835e-5e4f394698b0",
                    "sense_definition": "Personne qui participe à des compétitions sportives d'endurance en pleine nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune <w>raideur</w> s'entraîne toute l'année pour affronter les épreuves de pleine nature les plus difficiles."
                        },
                        {
                            "text": "Chaque <w>raideur</w> engagé dans cette course en montagne doit porter un équipement de survie obligatoire."
                        }
                    ]
                },
                {
                    "sense_id": "9bb943a9-461c-34d1-b16d-80a3a96ef9c2",
                    "sense_definition": "Investisseur ou financier lançant seul des offres publiques d'achat hostiles sur des entreprises.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce redoutable <w>raideur</w> a acquis discrètement des actions pour déstabiliser la direction du groupe."
                        },
                        {
                            "text": "L'entreprise ciblée tente de négocier un accord financier pour repousser les attaques de ce <w>raideur</w>."
                        }
                    ],
                    "synonyms": [
                        "raider"
                    ]
                }
            ]
        }
    ]
