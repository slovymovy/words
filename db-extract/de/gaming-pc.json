                "senses": [
                    {
                        "sense_id": "40d1cee2-7ea2-3a58-8420-fba93b169a17",
                        "entry_id": "d1d2b0f0-2d05-31e5-a411-3b650bc9d851",
                        "glosses": [
                            "für das Spielen von Videospielen entworfener Computer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb9385c0-2152-49a0-92ae-f7d4d3996a9e",
                                "sense_id": "40d1cee2-7ea2-3a58-8420-fba93b169a17",
                                "text": "„Ich mache mich auf den Weg zu Michaels Man Cave, dem kleinen Zimmer neben der Küche, in dem Flo ihn hält: Darin stehen ein Sessel, ein riesiger Schreibtisch und dieser monströse, laute Gaming-PC mit drei Bildschirmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
