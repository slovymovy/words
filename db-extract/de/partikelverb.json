                "senses": [
                    {
                        "sense_id": "a20943e7-a2d7-3f56-bfb7-b232afcfbbc9",
                        "entry_id": "98605e14-666e-366a-aa43-c4ddd3fd6fe8",
                        "glosses": [
                            "Verb, bei dem der nichtverbale Bestandteil (die Partikel, Bedeutung 1) unter bestimmten syntaktischen Bedingungen abgetrennt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2550417b-170d-476c-a458-5b3598352f7a",
                                "sense_id": "a20943e7-a2d7-3f56-bfb7-b232afcfbbc9",
                                "text": "Das Verb \"schönreden\" ist ein Partikelverb: in dem Satz \"Er redete sich das Ergebnis schön\" erscheint \"schön\" getrennt vom Verbstamm. Weitere Partikelverben: \"anschreiben\", \"krankschreiben\", \"vorlaufen\", \"zumachen\", \"anerkennen\" und viele andere."
                            },
                            {
                                "example_id": "cd6a7bb4-a423-49e3-b5ca-2f673c8d2428",
                                "sense_id": "a20943e7-a2d7-3f56-bfb7-b232afcfbbc9",
                                "text": "„Eine formale Unterscheidung der Partikel- von den Präfixverben ist problemlos möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0a1e3529-9b5a-3006-acb3-6e71392a8337",
                        "entry_id": "98605e14-666e-366a-aa43-c4ddd3fd6fe8",
                        "glosses": [
                            "Verb, das aus einem Hauptverb plus einer Partikel, das heißt hier einem Adverb oder einer Präposition, besteht, wobei die Partikel betont und das Partizip zusammengeschrieben wird"
                        ],
                        "tags": [
                            "Schwedisch"
                        ],
                        "examples": [
                            {
                                "example_id": "142956d2-2130-45ec-a341-91e3c08cba0d",
                                "sense_id": "0a1e3529-9b5a-3006-acb3-6e71392a8337",
                                "text": "Ein Beispiel für ein schwedisches Partikelverb ist „ta i“, das aus ta = nehmen und i = in besteht und in seiner festen Komposition „anfassen“ oder „zupacken“ bedeutet."
                            },
                            {
                                "example_id": "ad283992-a376-4127-8d2d-5d49d3fcc32a",
                                "sense_id": "0a1e3529-9b5a-3006-acb3-6e71392a8337",
                                "text": "Formen Sie folgende Aussagesätze mit Partikelverben in Fragesätze um:"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40212f78-9806-490b-9a2e-6b41fe2c84c0",
                        "source_entry_id": "98605e14-666e-366a-aa43-c4ddd3fd6fe8",
                        "source_sense_id": "a20943e7-a2d7-3f56-bfb7-b232afcfbbc9",
                        "source_sense_description": "Verb, bei dem der nichtverbale Bestandteil unter bestimmten syntaktischen Bedingungen abgetrennt wird",
                        "target_lang_word": "phrasal verb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phrasal verb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e020c9c7-6d9b-3aa2-b84b-d2ad3eb72837",
                                        "entry_id": "f541c63b-41b2-394b-aacd-67bd7c1c8087",
                                        "glosses": [
                                            "A two-word verb, consisting of a verb and a \\\"small\\\" adverb or particle, that has an idiomatic meaning not easily predictable from the individual parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b56332-cd62-4b7c-ab37-aa5ec2d028d9",
                                                "sense_id": "e020c9c7-6d9b-3aa2-b84b-d2ad3eb72837",
                                                "text": "In 'The police told the driver to pull over', 'pull over' is a phrasal verb."
                                            },
                                            {
                                                "example_id": "96c710b6-1bcd-44b4-a656-09c0e3b9f596",
                                                "sense_id": "e020c9c7-6d9b-3aa2-b84b-d2ad3eb72837",
                                                "text": "In every section of this invaluable work new light is thrown on ancient problems - phrasal verbs (bring up, put off), phrasal-prepositional verbs (catch up on, come up with) [...] duratives, sentence adverbs, and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4dd1ddf-8478-3dbe-8c5a-a87282e5ead3",
                                        "entry_id": "f541c63b-41b2-394b-aacd-67bd7c1c8087",
                                        "glosses": [
                                            "A phrase, consisting of a verb with a preposition and/or adverb, that has idiomatic meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59141abc-9d4e-4b97-91b3-a2a7df72d0f0",
                                                "sense_id": "b4dd1ddf-8478-3dbe-8c5a-a87282e5ead3",
                                                "text": "Thus, it would seem that as far as GAPPING is concerned, the whole expression put off is somehow treated as a single 'compound Verb'. But this is the very intuition which we encapsulated in analysis (125) (b), by giving the sequence [put off] the status of a single V constituent (i.e. by analysing it as a Phrasal Verb). Thus, facts about GAPPING lend yet further support to analysis (125)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a236fcd2-e614-4f37-bac6-13d877b6a069",
                        "source_entry_id": "98605e14-666e-366a-aa43-c4ddd3fd6fe8",
                        "source_sense_id": "a20943e7-a2d7-3f56-bfb7-b232afcfbbc9",
                        "source_sense_description": "Verb, bei dem der nichtverbale Bestandteil unter bestimmten syntaktischen Bedingungen abgetrennt wird",
                        "target_lang_word": "verbe à particule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbe à particule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1067f33-e3a5-3ce4-98ac-3a0a234ed9af",
                                        "entry_id": "6e1a8e36-d7a0-3804-90b0-8ee7d76b42eb",
                                        "glosses": [
                                            "Mot composé constitué d’un verbe conjuguant et d’une particule (partie invariable autre qu’un nom ou un pronom), comme get up en anglais et ankommen en allemand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cb47a8-75f3-4fba-8b49-8dd9dc00886a",
                                                "sense_id": "a1067f33-e3a5-3ce4-98ac-3a0a234ed9af",
                                                "text": "On retrouve cette structure de détermination dans le verbe à particule séparable, qui est une sorte de verbe composé. Dans abfahren, ab détermine à droite fahren et en précise le sens, […]."
                                            },
                                            {
                                                "example_id": "b2a4bd6e-aa33-4805-9f32-97e82a280efa",
                                                "sense_id": "a1067f33-e3a5-3ce4-98ac-3a0a234ed9af",
                                                "text": "Remarque : lorsque le verbe à particule admet un gérondif comme complément, la particule ne peut être déplacée : He gave up smoking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
