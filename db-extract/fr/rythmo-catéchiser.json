                "senses": [
                    {
                        "sense_id": "56f80ff2-3f54-3435-becd-c69d20063bc6",
                        "entry_id": "3a80102c-b651-3152-8b07-fd9a7f0c3ceb",
                        "glosses": [
                            "Catéchiser en utilisant le rythme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1be0499-c481-40b1-a221-2355d09323f2",
                                "sense_id": "56f80ff2-3f54-3435-becd-c69d20063bc6",
                                "text": "Tout cela n'était pas fait pour demeurer dans l'écrit, mais pour être mishnaïsé, c'est-à-dire rythmo-catéchisé, donc enfoncé dans les muscles de ceux qui devaient partir à la conquête du monde."
                            },
                            {
                                "example_id": "78836a68-80b0-4b25-aac9-bd294a293d06",
                                "sense_id": "56f80ff2-3f54-3435-becd-c69d20063bc6",
                                "text": "De là, la nécessité de rythmo-catéchiser, de rythmo-psalmodier les formules."
                            },
                            {
                                "example_id": "a62692a6-153c-48d3-9e5d-a13c0a2ce061",
                                "sense_id": "56f80ff2-3f54-3435-becd-c69d20063bc6",
                                "text": "Faut-il dire « rythmer » ? ou « rythmo-catéchiser » ?"
                            }
                        ]
                    }
