                "senses": [
                    {
                        "sense_id": "abfd9a87-8f3d-3a2c-bda8-475ccfcfe608",
                        "entry_id": "fc653ced-ba13-37df-9e1e-775bccbca801",
                        "glosses": [
                            "żołnierz piechoty uzbrojony w strzelbę skałkową (fuzję) w armiach XVII-XIX wieku; w okresie napoleońskim żołnierz lekkiej piechoty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c24bbf-bcb6-4c46-9503-325acec8c60c",
                                "sense_id": "abfd9a87-8f3d-3a2c-bda8-475ccfcfe608",
                                "text": "Będzie z ciebie fizylier, jak się patrzy. Do którego chcesz batalionu?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "509f08c4-9b91-3138-bae7-fc1629f38c3f",
                        "entry_id": "fc653ced-ba13-37df-9e1e-775bccbca801",
                        "glosses": [
                            "podczas II wojny światowej żołnierz wspierającej piechoty uzbrojony w ręczną broń maszynową"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "86e6e85a-b473-45a8-aa4b-43e3714dc3cd",
                                "sense_id": "509f08c4-9b91-3138-bae7-fc1629f38c3f",
                                "text": "Widzieliśmy, że przejeżdżające sznurem czołgi radzieckie obsadzał desant co najmniej paru fizylierów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
