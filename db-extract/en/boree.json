                        "entry_id": "bf907125-1d2a-3a1b-a092-95bb2883649d",
                        "glosses": [
                            "A person who is bored by another; the victim of a bore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e5d3965-6950-46e4-ac21-a0858432ad8c",
                                "sense_id": "afa4da1a-4120-3595-8518-12f703352f32",
                                "text": "The boree has been heard from frequently since the Renaissance, and his sentiments have undergone little change. The borer hasn't had much to say for himself."
                            },
                            {
                                "example_id": "346f220f-7b8e-4371-a332-4c0acecd38b4",
                                "sense_id": "afa4da1a-4120-3595-8518-12f703352f32",
                                "text": "Rennie was an expert on boredom, having done a piece on it for Pandora's “Relationships” column in which she claimed that there were two people involved in boredom, not just one: the borer and the boree."
                            }
                        ]
                    }
