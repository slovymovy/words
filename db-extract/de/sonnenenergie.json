                "senses": [
                    {
                        "sense_id": "467720ce-c46e-3ca1-b194-ee583d21e325",
                        "entry_id": "ac762896-c8af-3272-8dd4-add5e671e337",
                        "glosses": [
                            "von der Sonne erzeugte und abgestrahlte Energie"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f41d8fee-28ca-444f-80b9-3e21ed4eb349",
                                "sense_id": "467720ce-c46e-3ca1-b194-ee583d21e325",
                                "text": "Sonnenenergie wird von der Sonne hergestellt und abgestrahlt."
                            },
                            {
                                "example_id": "2a130bd8-3b13-48f6-8efe-68616ebc68ef",
                                "sense_id": "467720ce-c46e-3ca1-b194-ee583d21e325",
                                "text": "„Für die Wissenschaft steht fest, daß sich die Konzentration der Treibhausgase (wie z.B. CO₂) in der Atmosphäre erhöht und daß mit steigender Konzentration der Anteil der in der Atmosphäre eingefangenen Sonnenenergie zunimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9408fb5b-7afa-39f0-9375-f12db0ab062a",
                        "entry_id": "ac762896-c8af-3272-8dd4-add5e671e337",
                        "glosses": [
                            "durch Kollektoren aus Sonnenstrahlen gewonnene Wärme oder Strom; Form der umweltfreundlichen Energiegewinnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496aa9df-12aa-4168-8cb4-0eed80bf8b78",
                                "sense_id": "9408fb5b-7afa-39f0-9375-f12db0ab062a",
                                "text": "„Um den Wärmebedarf vollständig mit Sonnenenergie zu decken, benötigt man eine grosse Solaranlage, denn diese muss selbst in Wintern mit sehr tiefen Temperaturen die Gebäudeheizung gewährleisten können.“"
                            },
                            {
                                "example_id": "485bdd52-ad26-4231-8557-f65b9c690e88",
                                "sense_id": "9408fb5b-7afa-39f0-9375-f12db0ab062a",
                                "text": "„968 Personen erklären sich mit ihrer Unterschrift bereit, zur Förderung der Sonnenenergie fünf Franken pro Jahr mehr für ihren Strom zu bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
