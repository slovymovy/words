                        "entry_id": "64beee44-86a4-3540-bb51-a358c00a0599",
                        "glosses": [
                            "een uit staaldraad vervaardigd object, aan één zijde gepunt en aan de andere zijde meestal voorzien van een kop, om twee of meer voorwerpen met elkaar te verbinden"
                        ],
