                "senses": [
                    {
                        "sense_id": "c541f67e-ced7-329d-9b3f-0dab366fda17",
                        "entry_id": "8c2ad8a3-3f21-3769-acbc-1955c972dff7",
                        "glosses": [
                            "Qui est couvert d’une enveloppe dure et souvent articulée."
                        ],
                        "tags": [
                            "Histoire naturelle"
                        ],
                        "examples": [
                            {
                                "example_id": "f5a7cf5f-8f8b-49b1-9b24-eb978b92abfd",
                                "sense_id": "c541f67e-ced7-329d-9b3f-0dab366fda17",
                                "text": "Le Crabe , la Favouyo est un animal crustacé , dont nous avons plusieurs espèces ; la plus remarquable est celle qu'on nomme l'Esquinado . Les Crabes ont la queue composée d'écailles , […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "622c14e9-fa1d-3597-b6b8-ab1796ed752c",
                        "entry_id": "8c2ad8a3-3f21-3769-acbc-1955c972dff7",
                        "glosses": [
                            "En forme de croûte difficilement séparable du substrat."
                        ],
                        "tags": [
                            "Histoire naturelle"
                        ],
                        "examples": [
                            {
                                "example_id": "5897353b-8cfc-4aa1-b332-944816125276",
                                "sense_id": "622c14e9-fa1d-3597-b6b8-ab1796ed752c",
                                "text": "Le thallus des lécanores est toujours crustacé ou tartareux ; il est surtout très-épais et très-développé dans l’espèce dont nous allons parler."
                            },
                            {
                                "example_id": "be84f9fe-6c72-4f8b-b36a-bbfe7d378b83",
                                "sense_id": "622c14e9-fa1d-3597-b6b8-ab1796ed752c",
                                "text": "Thalle plat, crustacé, fixé par sa surface intérieure, encrouté de calcaire, lobé et mamelonné, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1aad566-5e93-43be-823c-23273784ade1",
