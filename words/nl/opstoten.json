    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ea56a20-3aad-3c55-9521-02a80f8d2b25",
                    "sense_definition": "het vanuit de maag omhoogkomen van maagzuur of onverteerd voedsel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spijsvertering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het eten van die vette maaltijd begon het maagzuur weer <w>op</w> te <w>stoten</w>.",
                            "target_lang_translations": {
                                "en": "After eating that fatty meal, the stomach acid started to <w>regurgitate</w> again."
                            }
                        },
                        {
                            "text": "Hevige en regelmatige <w>opstoten</w> van maagzuur kunnen wijzen op een medisch probleem.",
                            "target_lang_translations": {
                                "en": "Severe and regular <w>reflux</w> of stomach acid can indicate a medical problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "oprispen"
                    ],
                    "common_phrases": [
                        "opstoten van maagzuur"
                    ],
                    "target_lang_definitions": {
                        "en": "the rising of stomach acid or undigested food from the stomach into the esophagus"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regurgitate",
                                "target_lang_sense_clarification": "to bring swallowed food up again to the mouth"
                            },
                            {
                                "target_lang_word": "reflux",
                                "target_lang_sense_clarification": "the backflow of stomach acid"
                            },
                            {
                                "target_lang_word": "burp up",
                                "target_lang_sense_clarification": "to bring up gas or food from the stomach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32047c68-477a-3f9e-a58d-6bd63deb958e",
                    "sense_definition": "het wild opjagen van dieren of mensen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jagers probeerden het wild <w>op</w> te <w>stoten</w> uit het dichte struikgewas.",
                            "target_lang_translations": {
                                "en": "The hunters tried to <w>flush out</w> the game from the thick undergrowth."
                            }
                        },
                        {
                            "text": "Door het lawaai <w>stootten</w> ze de vogels per ongeluk <w>op</w>.",
                            "target_lang_translations": {
                                "en": "Because of the noise, they accidentally <w>startled</w> the birds."
                            }
                        }
                    ],
                    "synonyms": [
                        "opjagen",
                        "opschrikken"
                    ],
                    "common_phrases": [
                        "wild opstoten"
                    ],
                    "target_lang_definitions": {
                        "en": "to flush out or startle animals or people from a hiding place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flush out",
                                "target_lang_sense_clarification": "to force an animal or person out of a hiding place"
                            },
                            {
                                "target_lang_word": "startle",
                                "target_lang_sense_clarification": "to cause to move suddenly from surprise or fear"
                            },
                            {
                                "target_lang_word": "scare up",
                                "target_lang_sense_clarification": "to find or drive out animals"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "091eee9c-9327-3fdc-b8f3-994ef2fd7bdc",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>opstoot</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt had de afgelopen week meerdere <w>opstoten</w> van de ziekte.",
                            "target_lang_translations": {
                                "en": "The patient had several <w>flare-ups</w> of the disease over the past week."
                            }
                        },
                        {
                            "text": "Er waren kleine <w>opstoten</w> van geweld tijdens de demonstratie.",
                            "target_lang_translations": {
                                "en": "There were small <w>outbursts</w> of violence during the demonstration."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of opstoot"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of 'opstoot', referring to sudden occurrences, flare-ups, or minor scuffles"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flare-ups",
                                "target_lang_sense_clarification": "sudden recurrences of a disease or condition"
                            },
                            {
                                "target_lang_word": "outbursts",
                                "target_lang_sense_clarification": "sudden releases of strong emotion or violence"
                            },
                            {
                                "target_lang_word": "bouts",
                                "target_lang_sense_clarification": "short periods of intense activity or illness"
                            }
                        ]
                    }
                }
            ]
        }
    ]
