                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc4b51af-8d97-42ec-bfa2-2f24c42027ee",
                                "sense_id": "08887f8a-9102-3482-89cb-254dd03f1c10",
                                "text": "Sie lieben ihren Adoptivsohn genau so sehr wie ihre leiblichen Kinder."
                            },
                            {
                                "example_id": "2fea0c3c-8e88-4de2-8540-e3b09cc364f0",
                                "sense_id": "08887f8a-9102-3482-89cb-254dd03f1c10",
                                "text": "„Schon während der kurzen Reise überzeugte ich mich, daß die Seele meines neuen Adoptivsohnes nicht so wohlgestalt war wie sein Äußeres.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
