                        "glosses": [
                            "хим. содержащий серу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e4f0c4-1cbf-49a9-8680-187b389af98d",
                                "sense_id": "26113354-1c45-3066-88e6-256f40102f57",
                                "text": "Результаты этой так называемой реакции Майара воспроизведены в таблице 7, из которой видно, что в образовании, например, мясных запахов участвуют серосодержащие аминокислоты."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b4743ea-b3d8-4b28-9d2e-3c2a040e0faa",
                        "source_entry_id": "f5302493-1f4f-31b3-b843-a89ea9209589",
                        "source_sense_id": "26113354-1c45-3066-88e6-256f40102f57",
                        "target_lang_word": "schwefelhaltig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwefelhaltig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "755e60fb-77da-3eec-a4a5-dea55a2d6906",
                                        "entry_id": "d3761827-e1d1-338b-8594-66cb4d789ce5",
                                        "glosses": [
                                            "Schwefel enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af45d57-6aa4-45bb-8b6e-a2eea6603514",
                                                "sense_id": "755e60fb-77da-3eec-a4a5-dea55a2d6906",
                                                "text": "„Cystein […] ist eine schwefelhaltige proteinogene α-Aminosäure mit der Seitenkette –CH2–SH, die beim Erwachsenen in der Leber gebildet werden kann.“"
                                            },
                                            {
                                                "example_id": "af110a6c-ec3f-4d22-b96a-df9e11635a47",
                                                "sense_id": "755e60fb-77da-3eec-a4a5-dea55a2d6906",
                                                "text": "„Die schwefelhaltigen Aerosole schirmten das Sonnenlicht teilweise ab.“"
                                            },
                                            {
                                                "example_id": "6bf63938-39b5-4702-bdb0-2909186263d9",
                                                "sense_id": "755e60fb-77da-3eec-a4a5-dea55a2d6906",
                                                "text": "„Schwefelhaltigere Brennstoffe (Kohle) werden durch Schwefelärmere (Gas, Erdöl ) Brennstoffe sowie durch den in seiner Verwendung emissionsfreien Input Elektrizität ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
