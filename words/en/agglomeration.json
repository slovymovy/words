{
    "word_family": [
        "agglomerate",
        "agglomerative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "032cdda1-56da-30c0-be14-0d116c64873d",
                    "sense_definition": "A jumbled collection or mass of different things gathered together.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suburb had grown into an unruly <w>agglomeration</w> of small shops and houses.",
                            "target_lang_translations": {
                                "ru": "Пригород разросся в беспорядочное <w>нагромождение</w> маленьких магазинчиков и жилых домов."
                            }
                        },
                        {
                            "text": "His desk was covered in an odd <w>agglomeration</w> of papers, old books, and coffee mugs.",
                            "target_lang_translations": {
                                "ru": "Его стол был завален странным <w>скоплением</w> бумаг, старых книг и кофейных кружек."
                            }
                        }
                    ],
                    "synonyms": [
                        "accumulation",
                        "cluster",
                        "collection",
                        "heap",
                        "mass"
                    ],
                    "common_phrases": [
                        "vast agglomeration",
                        "chaotic agglomeration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочное скопление или нагромождение различных предметов, собранных вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "большое количество предметов или объектов в одном месте"
                            },
                            {
                                "target_lang_word": "нагромождение",
                                "target_lang_sense_clarification": "беспорядочно собранная куча разнородных вещей"
                            },
                            {
                                "target_lang_word": "агломерат",
                                "target_lang_sense_clarification": "соединение разнородных элементов, частей"
                            },
                            {
                                "target_lang_word": "конгломерат",
                                "target_lang_sense_clarification": "смесь разнообразных вещей или явлений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09ddba23-0a8a-3df3-ac90-0c75c24ddecc",
                    "sense_definition": "An extended urban area consisting of a central city and its adjoining suburbs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "urban",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The greater urban <w>agglomeration</w> now supports a population of over ten million residents.",
                            "target_lang_translations": {
                                "ru": "Вся городская <w>агломерация</w> в настоящее время насчитывает более десяти миллионов жителей."
                            }
                        },
                        {
                            "text": "Commuters travel across the whole <w>agglomeration</w> every day using the integrated rail network.",
                            "target_lang_translations": {
                                "ru": "Пассажиры ежедневно перемещаются по всей <w>агломерации</w>, пользуясь единой сетью железных дорог."
                            }
                        }
                    ],
                    "synonyms": [
                        "conurbation",
                        "metropolis"
                    ],
                    "common_phrases": [
                        "urban agglomeration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный урбанизированный район, состоящий из центрального города и прилегающих к нему пригородов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агломерация",
                                "target_lang_sense_clarification": "городская конурбация, система объединённых поселений"
                            },
                            {
                                "target_lang_word": "городская агломерация",
                                "target_lang_sense_clarification": "урбанизированная территория города и пригородов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4e5968a-5f2f-3fa7-9b27-e77c290aae61",
                    "sense_definition": "The act or process of collecting or heaping items together into a single mass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid <w>agglomeration</w> of independent companies into a single conglomerate worried regulators.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>слияние</w> независимых компаний в единый конгломерат встревожило регулирующие органы."
                            }
                        },
                        {
                            "text": "Industrial policies favored the <w>agglomeration</w> of related manufacturing businesses in one region.",
                            "target_lang_translations": {
                                "ru": "Промышленная политика способствовала <w>концентрации</w> смежных производственных предприятий в одном регионе."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggregation",
                        "amassing",
                        "clustering",
                        "gathering"
                    ],
                    "antonyms": [
                        "dispersal",
                        "dispersion"
                    ],
                    "common_phrases": [
                        "process of agglomeration",
                        "economic agglomeration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс соединения, слияния или накопления элементов в единую массу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агломерация",
                                "target_lang_sense_clarification": "процесс укрупнения, соединения или концентрации"
                            },
                            {
                                "target_lang_word": "скапливание",
                                "target_lang_sense_clarification": "процесс накапливания в одном месте"
                            },
                            {
                                "target_lang_word": "слияние",
                                "target_lang_sense_clarification": "объединение в единое целое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a7eda18-8ce2-326a-889b-1261d98c986a",
                    "sense_definition": "A rock or mass composed of volcanic fragments fused together under intense heat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists discovered a thick deposit of volcanic <w>agglomeration</w> near the extinct crater.",
                            "target_lang_translations": {
                                "ru": "Геологи обнаружили мощное отложение вулканического <w>агломерата</w> рядом с потухшим кратером."
                            }
                        },
                        {
                            "text": "The cliff face consists primarily of basaltic <w>agglomeration</w> formed during ancient eruptions.",
                            "target_lang_translations": {
                                "ru": "Склон утеса сложен преимущественно базальтовым <w>агломератом</w>, образовавшимся во время древних извержений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volcanic agglomeration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горная порода или масса, состоящая из спёкшихся под воздействием жара обломков вулканического происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агломерат",
                                "target_lang_sense_clarification": "вулканическая обломочная порода"
                            },
                            {
                                "target_lang_word": "спекание",
                                "target_lang_sense_clarification": "процесс или результат термического соединения частиц"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}