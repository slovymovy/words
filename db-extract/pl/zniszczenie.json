                                                "sense_id": "612757b0-7482-37bc-9be8-416870a4c203",
                                                "text": "Разрушение стены запланировано на утро."
                                            },
                                            {
                                                "example_id": "e31856e3-4d0a-49d7-aab2-c4cc08427243",
                                                "sense_id": "612757b0-7482-37bc-9be8-416870a4c203",
                                                "text": "Разрушение горной породы под действием ветров и дождей."
                                            }
                                        ]
                                    },
