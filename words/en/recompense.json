{
    "word_family": [
        "recompensable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b419571-68ca-336e-9323-d5aac966f682",
                    "sense_definition": "A reward or payment given in return for something done or suffered.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volunteers received no <w>recompense</w> for their hard work during the summer."
                        },
                        {
                            "text": "He felt that the promotion was a fair <w>recompense</w> for his years of loyal service."
                        }
                    ],
                    "synonyms": [
                        "meed",
                        "recompence"
                    ],
                    "common_phrases": [
                        "fair recompense",
                        "seek recompense"
                    ]
                },
                {
                    "sense_id": "6d22222d-cd5d-3d2f-8aec-9074594033c6",
                    "sense_definition": "Payment or action taken to make up for an injury, harm, or damage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offered financial <w>recompense</w> to the victims of the accident."
                        },
                        {
                            "text": "They demanded full <w>recompense</w> for the damage caused to their property."
                        }
                    ],
                    "synonyms": [
                        "restitution",
                        "payback"
                    ],
                    "common_phrases": [
                        "full recompense"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "915e2187-1b7e-3c43-85f7-243b491c9584",
                    "sense_definition": "To reward or pay someone for a service or effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>recompense</w> the employees for their extra hours."
                        },
                        {
                            "text": "It is difficult to <w>recompense</w> someone for the time they have sacrificed."
                        }
                    ],
                    "synonyms": [
                        "recompensate"
                    ]
                },
                {
                    "sense_id": "a0242c09-4c50-394a-aea4-bf247a057051",
                    "sense_definition": "To provide payment or amends for harm or damage caused.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ordered the driver to <w>recompense</w> the owner for the broken fence."
                        },
                        {
                            "text": "He tried to <w>recompense</w> the family for the loss they suffered."
                        }
                    ],
                    "synonyms": [
                        "restitution"
                    ]
                },
                {
                    "sense_id": "a36d2541-3441-336f-986f-468f1dcba6d7",
                    "sense_definition": "To give something back in return for what was received.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should <w>recompense</w> kindness with kindness."
                        },
                        {
                            "text": "They were unable to <w>recompense</w> the favor immediately."
                        }
                    ]
                }
            ]
        }
    ]
}