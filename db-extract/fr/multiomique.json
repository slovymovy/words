                    {
                        "sense_id": "2745b375-ac3b-317d-9811-7e17d3897ef1",
                        "entry_id": "d59ab38c-3ba5-38da-94d5-e5403552c2e0",
                        "glosses": [
                            "Qui concerne la multiomique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad8d7f78-0a0c-41d3-941d-1cdf82b87fb2",
                                "sense_id": "2745b375-ac3b-317d-9811-7e17d3897ef1",
                                "text": "L’approche diagnostique avec une nouvelle taxonomie multiomique est un bouleversement. Elle va changer la façon de voir les maladies inflammatoires et auto-immunes pour découvrir de nouveaux marqueurs diagnostiques, pronostiques et de nouvelles cibles thérapeutiques."
                            },
                            {
                                "example_id": "1f2fc056-be90-49d5-8991-6953dd0f4770",
                                "sense_id": "2745b375-ac3b-317d-9811-7e17d3897ef1",
                                "text": "Les chapitres 4 et 5 abordent l’intégration des données mono-omiques pour prédire un phénotype. Les chapitres 6 et 7 présentent des techniques exploratoires pour l’analyse multiomique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e2ee01e-f5fb-47d7-8f2f-93e76d281efd",
