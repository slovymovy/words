                "senses": [
                    {
                        "sense_id": "5f265eb6-d557-3052-b9e4-2021e60259b8",
                        "entry_id": "15c4282d-cbc8-3627-9a99-abb8702a0e98",
                        "glosses": [
                            "To bear or endure (something); to put up with, to suffer, to undergo."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dad7b68c-1352-4271-9696-2bca8ef48deb",
                                "sense_id": "5f265eb6-d557-3052-b9e4-2021e60259b8",
                                "text": "Peace to the souls of the graveless dead! / 'Twas an awful doom to dree; / But fearful and wondrous are thy works, / O God! in the boundless sea!"
                            },
                            {
                                "example_id": "b5506dee-f1c7-41fb-b73b-f59b43d7f796",
                                "sense_id": "5f265eb6-d557-3052-b9e4-2021e60259b8",
                                "text": "And redoubled pine for its dwellers I dree."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a19f20b-6f85-391d-b97f-ad41c7a8e0ef",
                        "entry_id": "15c4282d-cbc8-3627-9a99-abb8702a0e98",
                        "glosses": [
                            "To endure; to brook; also, to be able to do or continue."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "intransitive"
                        ],
                        "examples": []
                    }
