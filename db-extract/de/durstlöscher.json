                ],
                "senses": [
                    {
                        "sense_id": "e76eba8f-b861-3eb1-b0b3-1638ea7b0da5",
                        "entry_id": "82e184ce-02da-36d9-aefa-684b87d9fe00",
                        "glosses": [
                            "etwas (Getränk), das das Verlangen nach Flüssigkeit (schnell) mindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98dea7f1-ed98-4083-a154-59ecc02ad980",
                                "sense_id": "e76eba8f-b861-3eb1-b0b3-1638ea7b0da5",
                                "text": "Ein guter Durstlöscher ist klassisches Mineralwasser."
                            },
                            {
                                "example_id": "4b2ff645-5a1e-4962-9d52-42509c04a444",
                                "sense_id": "e76eba8f-b861-3eb1-b0b3-1638ea7b0da5",
                                "text": "„Als Durstlöscher empfehlen sich Mineralwässer, ungesüßte Kräuter- und Früchtetees sowie im Verhältnis 1:1 mit Wasser verdünnte Obst- oder Gemüsesäfte.“"
                            },
                            {
                                "example_id": "501fad8a-92b4-4e00-931f-1933d4de2b3d",
                                "sense_id": "e76eba8f-b861-3eb1-b0b3-1638ea7b0da5",
                                "text": "„Als Durstlöscher nicht zu empfehlen sind Alkohol und gesüßte Getränke wie koffeinhaltige Limonaden, schwarzer Tee und Kaffee, da sie dem Körper Flüssigkeit entziehen.“"
                            },
                            {
                                "example_id": "9569090a-3bff-4fff-88d3-a5b8e4b303c4",
                                "sense_id": "e76eba8f-b861-3eb1-b0b3-1638ea7b0da5",
                                "text": "„Ein promillefreier Durstlöscher ist „Kwas“, ein leicht säuerliches Getränk aus gegorenem Brot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
