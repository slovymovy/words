                ],
                "senses": [
                    {
                        "sense_id": "82502693-77f1-35a3-823e-43fcf2f88a47",
                        "entry_id": "6dd6bdaa-4339-31a5-bf80-6933d2c5fae8",
                        "glosses": [
                            "Faire perdre son caractère vieux à, rajeunir."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "76f48b8c-7b8f-40d5-8050-4a804f36c14d",
                                "sense_id": "82502693-77f1-35a3-823e-43fcf2f88a47",
                                "text": "J’fais ça pour dévieillir les enfants."
                            },
                            {
                                "example_id": "943c0d6f-0f23-46a5-8e36-096a9696d376",
                                "sense_id": "82502693-77f1-35a3-823e-43fcf2f88a47",
                                "text": "Quels que soient nos malheurs, nos tourments, et surtout\nCes orages cachés, qui nous suivent partout,\nCroyons qu’il est des lieux, un pays, un asile,\nOù, loin des yeux jaloux, on peut se voir tranquille,\nSe dévieillir du cœur sous un ciel embaumé,\nVivre d’aimer toujours, exister d'être aimé."
                            },
                            {
                                "example_id": "504c5dfb-8bad-4d60-a3b1-cbe60aec74a1",
                                "sense_id": "82502693-77f1-35a3-823e-43fcf2f88a47",
                                "text": "Nous avons besoin de nous dévieillir."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a8b8b2c-b53e-3b05-9ddf-23e4ef5d2c79",
                        "entry_id": "6dd6bdaa-4339-31a5-bf80-6933d2c5fae8",
                        "glosses": [
                            "Devenir moins vieux."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b123cd-d48d-425d-8efa-a83a67fea803",
                                "sense_id": "9a8b8b2c-b53e-3b05-9ddf-23e4ef5d2c79",
                                "text": "Je suis en train de dévieillir."
                            }
                        ]
                    }
