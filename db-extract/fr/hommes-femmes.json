                                                "example_id": "679c3666-ace5-48a0-adc6-9317fa4304b0",
                                                "sense_id": "6d68c950-fd8d-368f-975f-e19787074367",
                                                "text": "男女同工同酬。"
                                            },
                                            {
                                                "example_id": "7da89efa-750c-4fdb-b319-8e6f862359e9",
                                                "sense_id": "6d68c950-fd8d-368f-975f-e19787074367",
                                                "text": "男女搭配，幹活不累。"
