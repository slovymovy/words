                                    },
                                    {
                                        "sense_id": "80d599e4-3806-3efb-a553-c14da5f9c4ff",
                                        "entry_id": "ddb9a09b-161f-3d8b-9038-48719fde62c5",
                                        "glosses": [
                                            "The art or power of gaining good will by a prepossessing manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce43fc28-1cf2-386f-82b6-f51797a24c29",
                                        "entry_id": "ddb9a09b-161f-3d8b-9038-48719fde62c5",
                                        "glosses": [
                                            "That which is insinuated; a hint; a suggestion, innuendo or intimation by distant allusion"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2774553c-421d-489e-bdf9-96dc41063e66",
                                                "sense_id": "ce43fc28-1cf2-386f-82b6-f51797a24c29",
                                                "text": "Slander may be conveyed by insinuations."
                                            }
                                        ]
                                    }
