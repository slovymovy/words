                        "entry_id": "23e567f4-5119-31fa-84c4-68aa4173e7f1",
                        "glosses": [
                            "autumn, (before) winter (of crops)"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd3ba3d-a1ea-442c-bd66-e03363ab4d5a",
                                "sense_id": "4937d731-6891-3c16-8cc7-6fe7fe9c259a",
                                "text": "Бы́ло тепло́, и ози́мая рожь пла́вно волнова́лась от ти́хого полу́денного ветерка́.",
                                "translation": "It was warm, and the winter rye swayed slowly in the gentle midday breeze.",
                                "english": "It was warm, and the winter rye swayed slowly in the gentle midday breeze."
                            }
                        ]
                    }
