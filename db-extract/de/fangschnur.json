                        "glosses": [
                            "Schnur aus Metallgespinst, die besonders von Soldaten zu repräsentativen Zwecken getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d42d04-98f2-4069-94f3-044ed90791ed",
                                "sense_id": "021e0ed1-74f4-3770-87ae-c15e3072967b",
                                "text": "„Der Oberkutscher war in voller Livree, mit Fangschnüren um die Schulter und in hohen Stulpenstiefeln. “"
                            },
                            {
                                "example_id": "2667849c-6bd3-4631-9159-981edd0182af",
                                "sense_id": "021e0ed1-74f4-3770-87ae-c15e3072967b",
                                "text": "„Meine Uniform war weiß, die Weste blau, mit gold- und silbernen Fangschnüren und gleicher Degenquaste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
