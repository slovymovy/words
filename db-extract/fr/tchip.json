                    {
                        "translation_id": "51ab7841-189d-4fe1-b71b-fd225c20e004",
                        "source_entry_id": "9fc784b7-2889-3d3a-b02a-dcbeac8618f3",
                        "source_sense_id": "3ce2d520-3980-37d2-af9d-35b75a88b4c5",
                        "target_lang_word": "pshaw",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pshaw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b03a94be-cd40-3273-9e60-c8eaee846891",
                                        "entry_id": "4c219af1-70b7-3959-96e1-d071a2157a87",
                                        "glosses": [
                                            "Indicating disapproval, scoffery, irritation, impatience or disbelief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0190e867-a7cd-410c-8cee-c6b66721179d",
                                                "sense_id": "b03a94be-cd40-3273-9e60-c8eaee846891",
                                                "text": "Pshaw! I can't believe it!"
                                            },
                                            {
                                                "example_id": "f741ee3e-1eab-45fc-8d47-c7b3e964b8d2",
                                                "sense_id": "b03a94be-cd40-3273-9e60-c8eaee846891",
                                                "text": "\"Pshaw! Why do ye bother yourself wid texts, man, about so small a matter?\" interrupted the landlady"
                                            },
                                            {
                                                "example_id": "515e3f84-34e1-4869-8d6f-af42da19f53c",
                                                "sense_id": "b03a94be-cd40-3273-9e60-c8eaee846891",
                                                "text": "'Pshaw!' Ralph muttered, forcing a laugh."
                                            },
                                            {
                                                "example_id": "e4039644-96e4-4182-bf9c-240229470858",
                                                "sense_id": "b03a94be-cd40-3273-9e60-c8eaee846891",
                                                "text": "\"Have a care, cousin,\" he whispered; \"for the sake of the Virgin have a care, for you have angered him.\"\n\"Pshaw! fear not,\" the other answered in the same low tone."
                                            },
                                            {
                                                "example_id": "d2a7e993-617c-4455-86df-9e9b93248e18",
                                                "sense_id": "b03a94be-cd40-3273-9e60-c8eaee846891",
                                                "text": "Pshaw! And monkeys might fly out of my butt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pshaw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38df75f8-38fa-3667-a487-30c90e029976",
                                        "entry_id": "80da1dc8-eb5d-334c-8fec-6395a9bbef35",
                                        "glosses": [
                                            "To express disgust or contempt by saying \\\"pshaw\\\"."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8459ecaa-5ff8-457d-afdc-8f17da0ee7f0",
                        "source_entry_id": "9fc784b7-2889-3d3a-b02a-dcbeac8618f3",
                        "source_sense_id": "3ce2d520-3980-37d2-af9d-35b75a88b4c5",
                        "target_lang_word": "tchick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tchick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bf6860f-fdc9-3adb-82dd-9094cebea99c",
                                        "entry_id": "e909fa95-75e9-3d84-9d38-b5f7e4e3e5f8",
                                        "glosses": [
                                            "A click sound such as a palatal, lateral, or dental click.",
                                            "used to urge on a horse or other animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "135e9352-bb71-4e90-af7f-2623007c5a6e",
                                                "sense_id": "3bf6860f-fdc9-3adb-82dd-9094cebea99c",
                                                "text": "The driver mounted his box, put his long whip into a hole in the box, and, buttoning his coat, called, \" Tchick, tchick, tchick.\" Away the horses set off, and went so willingly and briskly, till he saw a passenger waiting to get into the coach."
                                            },
                                            {
                                                "example_id": "4e54f141-5327-4f90-a75e-15b2aa74cb3f",
                                                "sense_id": "3bf6860f-fdc9-3adb-82dd-9094cebea99c",
                                                "text": "\"Weel! weel!\" ejaculated the carter, \"that comes o' your education ; G — d be thank'd, I never could write ; get on Bess, tchick, tchick,\" and giving the horse a lusty thwack, he made off as fast as possible."
                                            },
                                            {
                                                "example_id": "b9705ab8-0968-4a4a-8ac1-6c8755c321fb",
                                                "sense_id": "3bf6860f-fdc9-3adb-82dd-9094cebea99c",
                                                "text": "Do come back! Come along, old fellow! — tchick, tchick, tchick, tchicky.\""
                                            },
                                            {
                                                "example_id": "7a45338a-2937-4981-8788-95446888ff8a",
                                                "sense_id": "3bf6860f-fdc9-3adb-82dd-9094cebea99c",
                                                "text": "I called him — \"tchick-tchick-tchick\" — and started making noises toward him, holding up the acorn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ada46435-ad83-309b-b802-2b71f0ea9bed",
                                        "entry_id": "e909fa95-75e9-3d84-9d38-b5f7e4e3e5f8",
                                        "glosses": [
                                            "A click sound such as a palatal, lateral, or dental click.",
                                            "used to express disapproval or disappointment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e47a78-e0c5-47dd-b87a-791c28fe9208",
                                                "sense_id": "ada46435-ad83-309b-b802-2b71f0ea9bed",
                                                "text": "Tchick! Tchick! Now I call that an awful pity Katie."
                                            },
                                            {
                                                "example_id": "b9c53467-0ee4-47f5-99ce-874a0e1d38e3",
                                                "sense_id": "ada46435-ad83-309b-b802-2b71f0ea9bed",
                                                "text": "Mr. Blantox. And she asked permission of the court for your boy to make a will and disinherit you? Mrs. Berg. Tchick-tchick-tchick."
                                            },
                                            {
                                                "example_id": "0c3b3733-7a2a-4ae6-a0d0-827bedc3a616",
                                                "sense_id": "ada46435-ad83-309b-b802-2b71f0ea9bed",
                                                "text": "A LOOK IN THE MIRROR, CHESTER SEES CHARLES CROMWELL PEERING OVER HIS SHOULDER, LEERING AT HIM WITH A SMUG SMILE FROM EAR-TO-EAR: “TCHICK, TCHICK, TCHICK, TCHICK, TCHICK, TCHICK, TCHICK,”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cedf1d8f-2fa3-36ab-9f82-0e64a23a7cd7",
                                        "entry_id": "e909fa95-75e9-3d84-9d38-b5f7e4e3e5f8",
                                        "glosses": [
                                            "Used to represent similar animal or other natural sounds"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e069816f-729e-4522-876b-306bf16e5c4b",
                                                "sense_id": "cedf1d8f-2fa3-36ab-9f82-0e64a23a7cd7",
                                                "text": "Their shrill tchick, tchick, tchick, had done the damage, warning of our approach."
                                            },
                                            {
                                                "example_id": "f31662d0-37a5-4fcf-b966-a7c70559b560",
                                                "sense_id": "cedf1d8f-2fa3-36ab-9f82-0e64a23a7cd7",
                                                "text": "They also fly with head sunk in 'shoulders', tail slightly raised and wings quivering, calling 'tchick tchick'."
                                            },
                                            {
                                                "example_id": "ebfd70c5-487a-459e-a338-baef9665357c",
                                                "sense_id": "cedf1d8f-2fa3-36ab-9f82-0e64a23a7cd7",
                                                "text": "The clumsy Herr was trying in vain to strike a light with a flint. Tchick! Tchick! but no spark appeared."
                                            },
                                            {
                                                "example_id": "5edb36e7-c1dc-40fa-ac95-d0fb8ef126ba",
                                                "sense_id": "cedf1d8f-2fa3-36ab-9f82-0e64a23a7cd7",
                                                "text": "The doctor cut here, then he cut here, and pulled the skin back like this—piitchhuu—then folded it— tchick—like this, and tucked it under—tchick—like that, and pulled this piece over—tchick—like this, and sewed it across here—tchick, tchick, tchick."
                                            },
                                            {
                                                "example_id": "41826ada-905b-462d-ae0c-63c4328aa77b",
                                                "sense_id": "cedf1d8f-2fa3-36ab-9f82-0e64a23a7cd7",
                                                "text": "From the day that I've been lying here and can no longer move around in a wheelchair, I've been hearing the door of the sideboard open. Tchick, open, tchick, closed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tchick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "975b6761-1766-3232-940d-a216d3ec56bb",
                                        "entry_id": "01f381c5-c55d-30ed-acf8-37c0409945ed",
                                        "glosses": [
                                            "A clicking sound, such as a palatal or dental click."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "705e676b-dbc2-4dc0-ac23-42c16ae2a26e",
                                                "sense_id": "975b6761-1766-3232-940d-a216d3ec56bb",
                                                "text": "So saying, and summing up the whole with a provoking wink, and such an interjectional tchick as may quicken a dull horse with , Petit-André drew oil\" to the other side of the path, and left the youth to digest the taunts he had treated him with, as his proud Scotch stomach best might."
                                            },
                                            {
                                                "example_id": "314f5824-8654-4378-b63f-dbb9ce1863c8",
                                                "sense_id": "975b6761-1766-3232-940d-a216d3ec56bb",
                                                "text": "The sound is created by sucking on the molars in the back of the mouth to create a sound (tchick) somewhat like that used in English to […]"
                                            },
                                            {
                                                "example_id": "2f620807-3f9b-41bc-a7fa-6d4f0f61ae5e",
                                                "sense_id": "975b6761-1766-3232-940d-a216d3ec56bb",
                                                "text": "The almost inaudible tchick of the panic button, the beep of the toxin test kit accompanied by green light indicating that he was not poisoned and click, screech and the clicktic of the front entrance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tchick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96f1c6cf-7181-365c-bc56-ee92dd1483ee",
                                        "entry_id": "bc931609-cbb6-3a13-9e0c-d21f599a6c77",
                                        "glosses": [
                                            "to make a tchick sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c39ab58-17fd-4406-bb69-6908d7e30e7a",
                                                "sense_id": "96f1c6cf-7181-365c-bc56-ee92dd1483ee",
                                                "text": "And the glass of water they've left for me Shall 'tchick!' to tell them I'm drinking!"
                                            },
                                            {
                                                "example_id": "e094a44d-a55f-4c17-9645-b42c61e78c8a",
                                                "sense_id": "96f1c6cf-7181-365c-bc56-ee92dd1483ee",
                                                "text": "But Aunt Janey was tchicking rebukefully, with her hand out. \"Nay, for shame,\" she said."
                                            },
                                            {
                                                "example_id": "8a95b62b-9c55-4594-86d2-e65e44f23847",
                                                "sense_id": "96f1c6cf-7181-365c-bc56-ee92dd1483ee",
                                                "text": "The sandpipers took off, 'tchick-tchicking' away in flight, and the chameleon changed colour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
