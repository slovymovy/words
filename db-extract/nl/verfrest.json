                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcb15177-be3c-46a2-af7a-b666da9586af",
                                "sense_id": "40fb542b-3cef-365b-8c6e-9d8e3322636a",
                                "text": "Op de belt is in de vorige eeuw allerlei afval gestort, waaronder verfresten en verpakkingen van schoonmaakmiddelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "32fd76ce-6aff-3168-9cc0-831069fb772f",
                        "entry_id": "c765693e-abc6-37e4-a486-2bbe876d836a",
                        "glosses": [
                            "overblijfsel van schilderwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e6417d-86c9-4000-a8d7-47a2f3c1761b",
                                "sense_id": "32fd76ce-6aff-3168-9cc0-831069fb772f",
                                "text": "Eurogrit is een fabrikant van straalgrit, wat gebruikt wordt om onder meer verfresten van muren te spuiten. Het bedrijf kwam in opspraak omdat het aan honderden bedrijven straalgrit heeft geleverd dat vervuild was met asbest."
                            },
                            {
                                "example_id": "0494ec3b-4f6c-4c79-8256-b6d6926dfda1",
                                "sense_id": "32fd76ce-6aff-3168-9cc0-831069fb772f",
                                "text": "Op basis van verfresten kon worden vastgesteld dat de auto bij de aanrijding betrokken was geweest. De oude eigenaar is vervolgens eerder deze week opgepakt."
                            }
                        ]
                    }
