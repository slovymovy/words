                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082b5c16-7b50-486b-a85b-084bdcf3965a",
                                "sense_id": "27e89e42-d324-3d2f-8d36-95fd6295b840",
                                "text": "Deutschland steht aufgrund von teuren Waffenexporten in Krisengebiete in der Kritik."
                            },
                            {
                                "example_id": "cdc95734-d554-4417-a1b9-e2bf946b8a98",
                                "sense_id": "27e89e42-d324-3d2f-8d36-95fd6295b840",
                                "text": "Der internationale Waffenexport ist in den letzten Jahren deutlich angestiegen."
                            },
                            {
                                "example_id": "abba5178-f0bf-40b9-a244-0c4f6bbf0f88",
                                "sense_id": "27e89e42-d324-3d2f-8d36-95fd6295b840",
                                "text": "„Die meisten seiner Einwohner sind nicht gerade stolz auf die Waffenexporte ihres Landes, und Kriegstreiber sind sie schon gar nicht.“"
                            }
                        ],
