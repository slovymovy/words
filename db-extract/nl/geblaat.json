                                    {
                                        "sense_id": "df20fb56-b13b-3c21-b67c-d87eee64dc89",
                                        "entry_id": "65fdabe3-90b2-387b-97b0-a24d2d40bf1e",
                                        "glosses": [
                                            "Sonido natural de la oveja, la cabra, el cordero, el carnero, el gamo y el ciervo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b661ea5-8257-461b-b68f-31351570fdd9",
                                                "sense_id": "df20fb56-b13b-3c21-b67c-d87eee64dc89",
                                                "text": "¿Por qué te quedaste entre las majadas, Para oir los balidos de los rebaños?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e40857f6-de99-45c9-9539-0a8a983eb16f",
                        "source_entry_id": "8f6e081a-baa6-39b3-8843-e7412a422a30",
                        "source_sense_id": "4102f56b-4ea3-31ab-b191-b785a86ca090",
                        "source_sense_description": "inhoudsloos gepraat, op een luide toon",
                        "target_lang_word": "Geschrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdf1747a-5c84-3f06-ac6a-3fd8449040b2",
                                        "entry_id": "f49c3634-98a4-3b93-b033-5a2bc85446a6",
                                        "glosses": [
                                            "Lärm, verursacht durch laute, anhaltende Lautäußerungen (Schreien) von Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c454718-ae04-4def-a61c-a48c62f294d5",
                                                "sense_id": "cdf1747a-5c84-3f06-ac6a-3fd8449040b2",
                                                "text": "Die Nachbarn beschwerten sich über das Geschrei der Kinder am Pausenhof der Grundschule."
                                            },
                                            {
                                                "example_id": "06ba4c9a-8e41-4dae-a49c-fa40bbbc9d33",
                                                "sense_id": "cdf1747a-5c84-3f06-ac6a-3fd8449040b2",
                                                "text": "„Nach richterlicher Überzeugung gibt es nämlich qualitative Unterschiede zwischen dem im ländlichen Bereich ortsüblichen Geschnatter von Gänsen, Wiehern von Pferden, Blöken von Schafen und dem Geschrei der Kakadus.“"
                                            },
                                            {
                                                "example_id": "83482900-5615-417b-a0e3-b02114831b29",
                                                "sense_id": "cdf1747a-5c84-3f06-ac6a-3fd8449040b2",
                                                "text": "„Es ist ein Erlebnis, diese mit dem Fernglas zu beobachten und ihrem Geschrei zu lauschen.“"
                                            },
                                            {
                                                "example_id": "cf948ffd-6c83-4a43-9ba8-9961227b968d",
                                                "sense_id": "cdf1747a-5c84-3f06-ac6a-3fd8449040b2",
                                                "text": "„Wegen seines Geschreis hatte er das allerdings auch verdient, denn es ist die Pflicht eines jeden Mannes, unter solchen Umständen die Klappe zu halten und zu sterben.“"
                                            },
                                            {
                                                "example_id": "07fd59b2-989d-4b80-8989-04834b9f7d01",
                                                "sense_id": "cdf1747a-5c84-3f06-ac6a-3fd8449040b2",
                                                "text": "„Alle Haustore und Läden waren geschlossen; allenfalls hörte man, wo Kneipen in der Nähe waren, vereinzelt Geschrei oder betrunkenes Gröhlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87e48e52-b27e-3a64-8a5d-af1f67efff03",
                                        "entry_id": "f49c3634-98a4-3b93-b033-5a2bc85446a6",
                                        "glosses": [
                                            "viel Aufsehen um unbedeutende Kleinigkeiten"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a3e4f06-274d-4243-a421-db392540f709",
                                                "sense_id": "87e48e52-b27e-3a64-8a5d-af1f67efff03",
                                                "text": "Meine Güte, hab dich doch nicht so, wegen der paar Rechtschreibfehler machst du so ein Geschrei!"
                                            },
                                            {
                                                "example_id": "3d4d8a17-c5b2-46ec-8f92-a995a52d3f18",
                                                "sense_id": "87e48e52-b27e-3a64-8a5d-af1f67efff03",
                                                "text": "„In Deutschland verstehe ich das Geschrei um die Verlängerung der Lebensarbeitszeit nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "535eb677-70f3-3004-80ee-5ac7b52e8a45",
                                        "entry_id": "f49c3634-98a4-3b93-b033-5a2bc85446a6",
                                        "glosses": [
                                            "abfälliges Reden über andere, Gerede"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ebeb8a-ae24-45f7-9c8c-f8c76b23491c",
                                                "sense_id": "535eb677-70f3-3004-80ee-5ac7b52e8a45",
                                                "text": "„Er hat allerlei entdeckt, mehr als er zeigen darf, wenn er nicht noch ärger als Hexenmeister ins Geschrei kommen will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfa7a19c-6c6d-42d7-a6be-5318a429cfec",
                        "source_entry_id": "8f6e081a-baa6-39b3-8843-e7412a422a30",
                        "source_sense_id": "4102f56b-4ea3-31ab-b191-b785a86ca090",
                        "source_sense_description": "inhoudsloos gepraat, op een luide toon",
                        "target_lang_word": "hurlement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurlement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                        "entry_id": "f4999f57-fd8f-331c-9864-e8378d48776d",
                                        "glosses": [
                                            "Action de hurler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a26a9b-ef1c-40c9-9fd2-b62db98fc46c",
                                                "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                                "text": "La nuit était complètement venue, le désert s’éveillait peu à peu ; les hurlements des bêtes fauves résonnaient déjà dans la prairie."
                                            },
                                            {
                                                "example_id": "1e27edcc-5ee8-4836-998a-c8e0d2737d3f",
                                                "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                                "text": "– Si je pouvais l'instrumenter à ma guise, peut-être la guérirais-je.\n– Comment cela ?\n– En la rouant de coups. J'ai guéri de la sorte vingt paysannes dans un village où s'était déclarée cette furieuse folie russe, le hurlement ; une femme se met à hurler, sa commère hurle. Au bout de trois jours, tout un village hurle. À force de les rosser, j'en suis venu à bout."
                                            },
                                            {
                                                "example_id": "999df36e-5308-4831-a193-6b65792bafbd",
                                                "sense_id": "b1339faa-6594-3c7b-839e-7fa1642f73a7",
                                                "text": "Chacun peut s'adonner aux joies des paris. Il faut alors entendre les hurlements des parieurs, et les cris des spectateurs. Seul un habitué des gallodromes est capable de comprendre ce qui est en train de se passer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                        "entry_id": "f4999f57-fd8f-331c-9864-e8378d48776d",
                                        "glosses": [
                                            "Bruit sinistre semblable au cri qui résulte de cette action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30e91149-9e10-4172-8aca-83cec467631e",
                                                "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                                "text": "Là-haut sa voix tonnante domine souvent les hurlements de la tempête ou le tumulte des combats ; mais ici elle est douce et mélodieuse […]."
                                            },
                                            {
                                                "example_id": "42f084d6-88ff-4a49-8495-a977af85f1f8",
                                                "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                                "text": "À chaque coup de roulis ou de tangage le hurlement continu du vent s'amplifiait d'un sifflement sinistre ; […]."
                                            },
                                            {
                                                "example_id": "8d9c80e5-7195-4c07-bfb5-84bce6becf72",
                                                "sense_id": "81bc4e0c-6cf1-3411-9491-e963e2b9adc1",
                                                "text": "Une dernière voiture, en slalomant en peu, eut le temps de passer, avec un hurlement de klaxons, avant qu'ils ne barrent l'accès vers Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad305d7-2583-3bb7-a756-e0d316e8cc3a",
                                        "entry_id": "f4999f57-fd8f-331c-9864-e8378d48776d",
                                        "glosses": [
                                            "Cri du loup."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
