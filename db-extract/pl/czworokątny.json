                            },
                            {
                                "target_word": "tétragone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd6bcff6-ee2d-394c-8546-7354a5830e39",
                                        "entry_id": "3043434f-e2c4-33fe-9288-ebcd7ffff0b9",
                                        "glosses": [
                                            "Polygone à quatre angles."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "869f3f03-36c0-4ec4-b776-bb5bb5211f65",
                                                "sense_id": "cd6bcff6-ee2d-394c-8546-7354a5830e39",
                                                "text": "Je me sens dur comme un tétragone envers les coups du sort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tétragone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21487bee-9a97-364c-85cd-ce94642b815e",
                                        "entry_id": "df7bfd23-0b9c-35cf-baeb-d87dfd75ee16",
                                        "glosses": [
                                            "Sorte d’épinard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6671201-848c-4d8f-8f38-94196f66c85d",
                                                "sense_id": "21487bee-9a97-364c-85cd-ce94642b815e",
                                                "text": "La tétragone cornue."
                                            },
                                            {
                                                "example_id": "b343f8d7-2854-4914-97ca-07ca27bb9317",
                                                "sense_id": "21487bee-9a97-364c-85cd-ce94642b815e",
                                                "text": "C’est avec une certaine émotion qu’ils avaient goûté à la première récolte de leurs légumes, notamment la tétragone que Loda avait semée."
                                            },
                                            {
                                                "example_id": "b51b048a-1978-417f-98f4-51e9e55d4c90",
                                                "sense_id": "21487bee-9a97-364c-85cd-ce94642b815e",
                                                "text": "Ça, c’est du plantain et voilà de l’oseille sauvage, de la drouille, de l’ortie ou barbe à bouc, du pissenlit, de la doucette, un petit chardon des champs ou chonzio, une plante laiteuse, le laichuron, du mille-feuilles, du chalabréi aux feuilles largement dentelées, de la tétragone ou épinard sauvage, de la langue bogne, une feuille de sauge et un brin de ciboulette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da38108f-1ead-421e-97fc-697a5111f134",
                        "source_entry_id": "8c11cee2-afe1-3ab2-8748-51c10d42e6e2",
                        "source_sense_id": "b7d65319-b2f7-34e3-b14d-cb3443503200",
                        "target_lang_word": "viereckig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viereckig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db95f78b-9aaf-3bd1-bc04-8b12143b2a9d",
                                        "entry_id": "b4cc3c0a-181a-3fc8-b071-b109e45d3be3",
                                        "glosses": [
                                            "vier Ecken besitzend, in der Form eines Vierecks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930709bb-6a96-4aa7-adff-f903c9a9fc4b",
                                                "sense_id": "db95f78b-9aaf-3bd1-bc04-8b12143b2a9d",
                                                "text": "Er steckte den viereckigen Brief in den Postkasten."
                                            },
                                            {
                                                "example_id": "7c75e590-c50d-4deb-b95d-9c3ba822c7ea",
                                                "sense_id": "db95f78b-9aaf-3bd1-bc04-8b12143b2a9d",
                                                "text": "„Brechts Lehrtheater ist ein Welttheater, in welchem die unendliche Welt sonderbar klein und viereckig geworden ist: etwas größer vielleicht als eine Zigarrenkiste, kaum größer als eine deutsche Schulstube.“"
                                            },
                                            {
                                                "example_id": "17017e38-77b8-4865-bae0-068efeb58973",
                                                "sense_id": "db95f78b-9aaf-3bd1-bc04-8b12143b2a9d",
                                                "text": "„Leonardo beobachtete die Vögel bei ihrer Technik, mit weit ausgebreiteten Flügeln langsam abzusinken und entwarf einen Fallschirm in Form einer viereckigen Pyramide, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
