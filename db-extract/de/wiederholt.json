                ],
                "senses": [
                    {
                        "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                        "entry_id": "9243e8e0-4898-38bd-9415-bf4aba0b0ad2",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9220091-3b51-4d08-a772-8bd24fa52ef0",
                                "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                                "text": "Frau Wiederholt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3bbe7103-b0b1-4852-9303-cd26611f403c",
                                "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                                "text": "Herr Wiederholt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8bf42a7b-3fcf-42c9-872a-e6dff07a3772",
                                "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                                "text": "Die Wiederholts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5ee40f72-7c5f-49a6-b549-d14cbe26f821",
                                "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                                "text": "Der Wiederholt trägt nie die Schals, die die Wiederholt ihm strickt."
                            },
                            {
                                "example_id": "e59cb5ae-ebc7-4fc8-bc94-838bb8e366c6",
                                "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wiederholt kommt, geht der Herr Wiederholt.“"
                            },
                            {
                                "example_id": "8a51b83d-5735-4803-bdd8-b43f571d1cbc",
                                "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                                "text": "Wiederholt kommt und geht."
                            },
                            {
                                "example_id": "23163f42-a87f-4746-b8c5-ebdc2be4e7ed",
                                "sense_id": "3ae33e24-e0f4-3d5a-b822-7e5b4501be78",
                                "text": "Wiederholts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
