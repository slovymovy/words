                "senses": [
                    {
                        "sense_id": "c9c39fdc-1972-3fa1-b30d-95c9b70c75b5",
                        "entry_id": "e3ee9a5c-b3ff-310d-8dd3-8e4b8a2b6ec7",
                        "glosses": [
                            "Apporter du fer à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63f01675-a423-47b6-b9ad-724140e36121",
                                "sense_id": "c9c39fdc-1972-3fa1-b30d-95c9b70c75b5",
                                "text": "Je passe sur les clous rouillés qu’on faisait macérer dans mes boissons pour les ferruginer : de l’eau rosie par du vin."
                            },
                            {
                                "example_id": "f6babb6b-27ab-4e02-9130-cc11ca78a170",
                                "sense_id": "c9c39fdc-1972-3fa1-b30d-95c9b70c75b5",
                                "text": "J’en conviens tout à fait; aussi est-il vrai que ce n'est pas moi qui le premier ai pensé à ferruginer ma tête."
                            },
                            {
                                "example_id": "3818f812-fde3-492e-896c-7416c1cf4a46",
                                "sense_id": "c9c39fdc-1972-3fa1-b30d-95c9b70c75b5",
                                "text": "D'autres pistes sont étudiées : ferruginer la mer, décolorer les villes ou soustraire du CO2 de l'atmosphère."
                            }
                        ]
                    }
                ],
