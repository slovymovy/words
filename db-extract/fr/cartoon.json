                        "entry_id": "6c5981e2-4cf1-308f-9270-3e940b9a178f",
                        "glosses": [
                            "Dessin animé américain de style comique généralement au format de court métrage, dont l’âge d’or se situe dans les années 1930-1950."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2507a104-182a-45f3-94d3-b957c8c60351",
                                "sense_id": "70691145-6881-3d6a-9886-a116232f3aec",
                                "text": "Les années 30 et sa récession économique trouvent dans le cartoon, comme dans les exaltantes comédies musicales ou dans l’humanisme naïf de Franck Capra, l’opportunité idéale de se soustraire à une réalité oppressante."
                            }
                        ]
                    },
                    {
                        "sense_id": "91a8d6ac-343a-33a2-ae17-162c03575e07",
                        "entry_id": "6c5981e2-4cf1-308f-9270-3e940b9a178f",
                        "glosses": [
                            "Bande dessinée humoristique américaine (livre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3cd3725-3934-400e-ae89-cd739c828435",
                                "sense_id": "91a8d6ac-343a-33a2-ae17-162c03575e07",
                                "text": "Dans le halo d’une lampe de bureau, le réceptionniste lisait un cartoon jauni."
                            }
                        ]
