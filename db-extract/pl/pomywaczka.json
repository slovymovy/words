                "senses": [
                    {
                        "sense_id": "5ba9e3bb-b261-3b73-92db-686235531096",
                        "entry_id": "0db62e40-d8e4-3eba-ac96-c5bddb7cebee",
                        "glosses": [
                            "pracownica restauracji myjąca naczynia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4fb6c88-8fea-4c08-a62b-b225ed2aff87",
                                "sense_id": "5ba9e3bb-b261-3b73-92db-686235531096",
                                "text": "Zwolniliśmy tę niemiecką pomywaczkę, bo kradła sztućce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1fb86d7-3b43-45da-b6a8-44b795a97815",
                        "source_entry_id": "0db62e40-d8e4-3eba-ac96-c5bddb7cebee",
                        "source_sense_id": "5ba9e3bb-b261-3b73-92db-686235531096",
                        "target_lang_word": "dishwasher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dishwasher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59cc2d42-d235-3ff7-8225-2e8ccadd0c3a",
                                        "entry_id": "611cf647-4af4-36d9-a16a-e45c8d00df6f",
                                        "glosses": [
                                            "A machine for washing dishes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b29d3b6-04e4-4ff8-b926-9da555171540",
                                                "sense_id": "59cc2d42-d235-3ff7-8225-2e8ccadd0c3a",
                                                "text": "load the dishwasher"
                                            },
                                            {
                                                "example_id": "df61f910-6cca-4a32-9c88-e3ac88fd2015",
                                                "sense_id": "59cc2d42-d235-3ff7-8225-2e8ccadd0c3a",
                                                "text": "Plus, there are about a thousand things that also could, or should get done in that time: a load of laundry, loading the dishwasher, tidying the kitchen, picking up a gagillion toys and blankies off the ground, restocking the change tables."
                                            },
                                            {
                                                "example_id": "9215ad65-51e6-4e4c-babd-f3ea31099fc8",
                                                "sense_id": "59cc2d42-d235-3ff7-8225-2e8ccadd0c3a",
                                                "text": "Conditions inside dishwashers not only enable selected fungal species to survive, but also promote the selective enrichment of particular polyextremotolerant fungi that can tolerate low and high pH, temperatures up to 60°C or 80°C, occasional dehydration and high organic loads, high concentrations of NaCl, and mechanical stress due to water ejectors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c133222-8c5c-3ac6-9a25-fbb6a5941859",
                                        "entry_id": "611cf647-4af4-36d9-a16a-e45c8d00df6f",
                                        "glosses": [
                                            "Someone who washes dishes, especially one hired to wash dishes in a restaurant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c78909f-9669-445b-9e35-6e3eb31ad1ea",
                                                "sense_id": "5c133222-8c5c-3ac6-9a25-fbb6a5941859",
                                                "text": "The chefs never cooked before, the cashiers never cashiered before, the dishwashers never dishwashed before, the waitresses never waitressed before, and the managers never managed before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d64bfb45-cb02-31da-9c0e-2968c40b0567",
                                        "entry_id": "611cf647-4af4-36d9-a16a-e45c8d00df6f",
                                        "glosses": [
                                            "A European bird, the wagtail."
                                        ],
                                        "tags": [
                                            "Cornwall",
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b761a0a2-397e-4b00-a111-bfad41bc1df5",
                                                "sense_id": "d64bfb45-cb02-31da-9c0e-2968c40b0567",
                                                "text": "The country-people say that the \"tinner,\" that is the \"dishwasher\" or water-wagtail, is scarcer than it was before the blizzard, which must have caused the death of tens of thousands of birds. They call it the tinner, because it builds its nest in the mouth of the old mine-shafts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437067d3-febe-32cc-8e60-09790c15c246",
                                        "entry_id": "611cf647-4af4-36d9-a16a-e45c8d00df6f",
                                        "glosses": [
                                            "A bird, the restless flycatcher (Myiagra inquieta)."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b7255cc-fdea-4137-a971-5396d35ff42a",
                        "source_entry_id": "0db62e40-d8e4-3eba-ac96-c5bddb7cebee",
                        "source_sense_id": "5ba9e3bb-b261-3b73-92db-686235531096",
                        "target_lang_word": "plongeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plongeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb6b3ad-ac77-3d8b-9aa9-5eab0fe76dbf",
                                        "entry_id": "8084bd22-0e4a-36d1-aa86-08bb3cc9cfff",
                                        "glosses": [
                                            "Celle qui pratique la plongée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f9036a8-5ef8-3fa9-8cbf-e41b65357b43",
                                        "entry_id": "8084bd22-0e4a-36d1-aa86-08bb3cc9cfff",
                                        "glosses": [
                                            "Employée de restaurant chargée de faire la vaisselle."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f05502-eba9-4ca5-856d-a8b0c56fb2e0",
                                                "sense_id": "6f9036a8-5ef8-3fa9-8cbf-e41b65357b43",
                                                "text": "Oui, tous touchés, depuis la plongeuse du palace, frottant de son doigt graisseux, pour mieux voir, les carreaux d’une arrière-cuisine, jusqu’à l’artiste, à la fois ému, impuissant, irrité devant cette carte postale en couleurs : tous touchés."
                                            },
                                            {
                                                "example_id": "db8a6507-aadf-4168-8979-423f43d1a656",
                                                "sense_id": "6f9036a8-5ef8-3fa9-8cbf-e41b65357b43",
                                                "text": "À Berlin, une femme engagée comme assistante médicale est employée comme plongeuse dans un restaurant et fait 80 heures par semaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0738673a-8177-3a27-8825-952241a0ea9a",
                                        "entry_id": "8084bd22-0e4a-36d1-aa86-08bb3cc9cfff",
                                        "glosses": [
                                            "Montre de plongée."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4551e396-6fff-40ad-bb96-4bf6551538e3",
                                                "sense_id": "0738673a-8177-3a27-8825-952241a0ea9a",
                                                "text": "La marque horlogère suisse Tissot, présente une nouvelle collection de plongeuses – dix pièces en tout – qui ont tout pour plaire aux amateurs de montres mécaniques à budgets serrés."
                                            }
                                        ]
                                    }
                                ]
                            },
