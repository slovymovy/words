                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autorisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f41a9ec-3d38-35ce-998b-4762870cf8c5",
                                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                                        "glosses": [
                                            "Erteilung einer Vollmacht oder Befugnis, auch die Vollmacht selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc674eb-7e05-419a-aa0b-cbd81e05f4f0",
                                                "sense_id": "3f41a9ec-3d38-35ce-998b-4762870cf8c5",
                                                "text": "„Die Autoren der Kunstwerke, wie sie im vorherigen Artikel erwähnt wurden, könnten das exklusive Recht zur Reproduktion oder zur Autorisierung der Reproduktion abtreten und würden dabei trotzdem das Besitzrecht über das Originalwerk behalten.“"
                                            },
                                            {
                                                "example_id": "ec6d71bc-c240-48bc-930f-4c89edca0f82",
                                                "sense_id": "3f41a9ec-3d38-35ce-998b-4762870cf8c5",
                                                "text": "„Hat ein Zahlungsdienstleister einen Zahlungsvorgang ohne Autorisierung vorgenommen, hat er keinen Anspruch auf Ersatz seiner Auslagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2d8929e-b6f0-3944-af62-4a32ab702668",
                                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                                        "glosses": [
                                            "Erteilung einer Genehmigung, auch die Genehmigung selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e754da-fcb7-4724-bf6a-a76cafedb8fb",
                                                "sense_id": "d2d8929e-b6f0-3944-af62-4a32ab702668",
                                                "text": "Können Sie mir eine Autorisierung für den Interviewtext vorlegen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                                        "glosses": [
                                            "Nachweis der Identität (die mit gewissen Rechten verknüpft ist)"
                                        ],
                                        "tags": [
                                            "EDV",
                                            "Online-Geschäfte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4da47f3-0dd1-4d13-83c8-8e16a1c0bb9c",
                                                "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                                                "text": "„Die Autorisierung zur Tätigung einer Zahlung wird aus einer anderen Autorisierung abgeleitet: Wer Zugang zu einem Telefon, einem Handy oder einer Internetverbindung hat, belegt damit, so wird unterstellt, dass er der Gläubiger des dazugehörigen Vertrags ist.“"
                                            },
                                            {
                                                "example_id": "4ef0da18-c012-4a54-8173-db374d4c8ff2",
                                                "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                                                "text": "„Bei der Autorisierung wird der Zugang zu Datenbanken oder Anwendungen mittels Access-Control-Listen oder Zertifikaten oder anderer Zugangskontrollmethoden überprüft und bei Berechtigung Zugang gewährt.“"
                                            },
                                            {
                                                "example_id": "8db3d7a9-343e-4474-a9c4-25ad44245e4d",
                                                "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                                                "text": "„Der Verkauf oder Einkauf von Gütern und Dienstleistungen in einer geschützten Umgebung fordert die Autorisierung über eine eigenständige Stelle in Form einer Site-Zertifizierung oder „digital ID“ (siehe unten).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e7ce1f2-bbe1-42f1-8d34-94c1d3629189",
                        "source_entry_id": "b065a2ce-fec8-3108-8f82-74bcd97920e3",
                        "source_sense_id": "340f974d-9853-36cd-8f37-e1798095af51",
