                        "examples": [
                            {
                                "example_id": "4e48c176-7fe4-43b8-a3fc-070bf5eddb90",
                                "sense_id": "73cbfa87-c452-3832-98ee-61139a36421a",
                                "text": "Ruim 500 reddingswerkers gingen maandag (lokale tijd) weer op zoek naar slachtoffers. Voordat ze door zwaveldampen werden gedwongen de berg te verlaten, hadden ze berghutten doorzocht waar gaten in het dak waren geslagen door vallende stenen. Ze stonden kniediep in as van de vulkaan."
                            },
                            {
                                "example_id": "059063a6-7ef8-443b-8f4e-c0fa0a516bb0",
                                "sense_id": "73cbfa87-c452-3832-98ee-61139a36421a",
                                "text": "In het water van Yunomine Onsen kun je samen met de locals ook eieren of bamboescheuten koken in een bron waaruit stinkende zwaveldampen opstijgen."
                            }
                        ]
                    }
                ],
