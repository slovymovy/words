                                        "entry_id": "75d409f0-6718-37f3-af66-6acd5910d8f7",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de chicaner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
