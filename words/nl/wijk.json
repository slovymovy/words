                    "examples": [
                        {
                            "text": "Het water in de <w>wijk</w> werd vroeger gebruikt om turf te vervoeren.",
                            "target_lang_translations": {
                                "en": "The water in the <w>canal</w> was formerly used to transport peat.",
                                "ru": "Вода в <w>канале</w> раньше использовалась для транспортировки торфа.",
                                "pl": "Woda w tym <w>kanale</w> była dawniej używana do transportu torfu.",
                                "de": "Das Wasser in dem <w>Kanal</w> wurde früher zum Transport von Torf genutzt.",
                                "fr": "L'eau du <w>canal</w> était autrefois utilisée pour transporter la tourbe.",
                                "it": "L'acqua nel <w>canale</w> veniva usata in passato per trasportare la torba.",
                                "cs": "Voda v <w>kanálu</w> se dříve používala k přepravě rašeliny.",
                                "tr": "<w>Kanaldaki</w> su eskiden turba taşımak için kullanılırdı.",
                                "es": "El agua en el <w>canal</w> se utilizaba antiguamente para transportar turba.",
                                "zh": "这条<w>运河</w>里的水过去常被用来运输泥炭。"
                            }
                        },
                        {
                            "text": "Langs de oude <w>wijk</w> groeien nu prachtige rietkragen.",
                            "target_lang_translations": {
                                "en": "Beautiful reed beds now grow along the old <w>side channel</w>.",
                                "ru": "Вдоль старого <w>канала</w> теперь растут красивые заросли тростника.",
                                "pl": "Wzdłuż starego <w>kanału</w> rosną teraz piękne szuwary.",
                                "de": "Entlang des alten <w>Kanals</w> wachsen heute wunderschöne Schilfgürtel.",
                                "fr": "De magnifiques roselières poussent désormais le long de l'ancien <w>canal</w>.",
                                "it": "Lungo il vecchio <w>canale</w> crescono ora splendidi canneti.",
                                "cs": "Podél starého <w>kanálu</w> nyní rostou nádherné rákosiny.",
                                "tr": "Eski <w>kanalın</w> boyunca şimdi harika sazlıklar büyüyor.",
                                "es": "A lo largo del antiguo <w>canal</w> crecen ahora hermosos cañaverales.",
                                "zh": "古老的<w>侧渠</w>边现在长满了美丽的芦苇。"
                            }
