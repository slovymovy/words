                "senses": [
                    {
                        "sense_id": "6e4683b0-4b30-36dc-a181-1f49ff6e771f",
                        "entry_id": "7d0373d3-e2fb-3fe6-9af3-cfe852f3f39a",
                        "glosses": [
                            "Zusammenstellung von Gegenständen, die dem Servieren von Tee dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87bd2d0-e748-48a8-b7a4-84f0cd0626ba",
                                "sense_id": "6e4683b0-4b30-36dc-a181-1f49ff6e771f",
                                "text": "„In der Küche findet sie das noch in altes Zeitungspapier eingewickelte Teeservice, reißt eine Familienpackung Lipton-Teebeutel auf, schrubbt den Kessel mit dem angeschimmelten Deckel und hält ihn unter den ebenfalls mit Schimmel überzogenen Wasserhahn.“"
                            },
                            {
                                "example_id": "4a0ed351-9380-4a3b-b295-857c407a3316",
                                "sense_id": "6e4683b0-4b30-36dc-a181-1f49ff6e771f",
                                "text": "„Der Tisch war mit schwarzem Geschirr, Gläsern und einem schwarzen Teeservice gedeckt.“"
                            },
                            {
                                "example_id": "c90ea4e3-67b9-47e9-8781-4237c4ef0cab",
                                "sense_id": "6e4683b0-4b30-36dc-a181-1f49ff6e771f",
                                "text": "„Ahmed deutete auf das Teeservice auf einer Ecke der Schreibtischplatte und nahm sich eine der leeren Tassen.“"
                            },
                            {
                                "example_id": "f7d31d67-df77-4fbe-865e-7bc8e9e6da08",
                                "sense_id": "6e4683b0-4b30-36dc-a181-1f49ff6e771f",
                                "text": "„Eine ältere Dame trägt ein Tablett mit einem Teeservice herum und bietet den diensthabenden Beamten heißen Tee an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
