                "senses": [
                    {
                        "sense_id": "069cc194-5c96-3e0b-8635-e636d81267b8",
                        "entry_id": "755ead1e-cfa7-35e8-813d-3b21a4bd4d05",
                        "glosses": [
                            "Broyer après avoir cryogénisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf525b31-a4b1-4deb-b30d-4034373de9aa",
                                "sense_id": "069cc194-5c96-3e0b-8635-e636d81267b8",
                                "text": "L’invention concerne un procédé de densification d'une poudre métallique qui consiste à cryobroyer la poudre métallique pour produire une poudre métallique nanocristalline ; à dégazer la poudre métallique nanocristalline; à la préformer en vue d'un processus ultérieur de pression angulaire à canaux égaux (ECAP) en fonction de la poudre métallique en cours de traitement ; et à soumettre la poudre métallique nanocristalline dégazée et préformée à la pression angulaire à canaux égaux (ECAP) à une température et une pression prédéterminées."
                            },
                            {
                                "example_id": "6e03591a-181e-48fc-b2e8-9f6f879d23ab",
                                "sense_id": "069cc194-5c96-3e0b-8635-e636d81267b8",
                                "text": "On obtient quelque 85 grammes de fibres séchées, que l’on cryobroie sous azote liquide directement introduite dans le broyeur."
                            }
                        ]
                    }
