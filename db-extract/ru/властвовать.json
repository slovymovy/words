                "senses": [
                    {
                        "sense_id": "67b5fa3c-6ed2-34e8-b034-b24af2c9273d",
                        "entry_id": "4a2a6657-9258-3cdc-80aa-3a17a09434f4",
                        "glosses": [
                            "to rule (over), to hold sway (over), to wield power (over)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4caca89e-9258-4630-aef8-fae4c4b17054",
                                "sense_id": "67b5fa3c-6ed2-34e8-b034-b24af2c9273d",
                                "text": "вла́ствовать собо́й",
                                "translation": "control oneself",
                                "english": "control oneself"
                            },
                            {
                                "example_id": "5f9a959a-cd3f-4355-a516-cbb136cd54e3",
                                "sense_id": "67b5fa3c-6ed2-34e8-b034-b24af2c9273d",
                                "text": "— Мы, о́рки, друг дру́га му́чаем. Всё де́лаем че́рез обма́н, по́длость и страх. И над мате́рией хоти́м вла́ствовать то́чно та́к же…",
                                "translation": "‘We Orks are always torturing each other. Our way of doing things is through underhand deception and fear. And we try to dominate matter in exactly the same way …’",
                                "english": "‘We Orks are always torturing each other. Our way of doing things is through underhand deception and fear. And we try to dominate matter in exactly the same way …’"
                            }
                        ]
                    }
