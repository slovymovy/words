                        "cross_references": [
                            {
                                "target_word": "bras mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46519b50-4380-359f-a1db-724b1d0270b8",
                                        "entry_id": "7bec65bc-bda5-3e60-a7e1-1c021202cfa1",
                                        "glosses": [
                                            "Partie relictuelle de l’ancien cours d’un cours d’eau, dans lequel l’eau ne passe plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b93935b3-f53e-45e3-8d73-757ff274c6d3",
                                                "sense_id": "46519b50-4380-359f-a1db-724b1d0270b8",
                                                "text": "A un stade plus avancé, les bras morts en voie d'assèchement présentent un complexe où il est facile pourtant de déceler, parmi les groupements qui s’interfèrent, l’association initiale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e1a9a3-3730-3948-bbd7-5c0a0b9b01b5",
                                        "entry_id": "7bec65bc-bda5-3e60-a7e1-1c021202cfa1",
                                        "glosses": [
                                            "Canalisation où l’eau stagne pendant une longue période (tuyau pincé à son extrémité suite à la suppression d’un robinet, canalisation d’un robinet qui ne sert jamais, canalisation en attente de raccord)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75dd5b52-baa5-4a35-a070-b139a36e242c",
                        "source_entry_id": "74f1701d-5002-3d99-bc9b-f131d4d49e04",
                        "source_sense_id": "0922dd55-f84f-3ba7-ae0c-98b39462e4cd",
                        "target_lang_word": "Altwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3a96bd-6e76-3fa6-a539-c45b08c7c734",
                                        "entry_id": "0117b0e5-eb2a-391b-92ad-40c46bd5aa1a",
                                        "glosses": [
                                            "durch Verlegung eines Flusses stillgelegte Arme und Schlingen, die sich mit Grundwasser gefüllt haben"
                                        ],
                                        "tags": [
                                            "Physische Geografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1efed222-f834-42c9-ac2f-2353cf989b84",
                                                "sense_id": "4a3a96bd-6e76-3fa6-a539-c45b08c7c734",
                                                "text": "„Altwässer, Auwälder und Kiesbänke breiten sich am Fluss aus, wo die Deiche weiter im Binnenland stehen – die warmen Herbsttage verleiten noch zum Sonnenbaden.“"
                                            },
                                            {
                                                "example_id": "e673963f-bc4e-4616-a81f-9a34590d380a",
                                                "sense_id": "4a3a96bd-6e76-3fa6-a539-c45b08c7c734",
                                                "text": "„Die kürzere Strecke führte Richtung Umspannstation, am Altwasser der Brenz entlang Richtung Flugplatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45fdb546-3887-4ee7-866a-2079b9589e38",
                        "source_entry_id": "74f1701d-5002-3d99-bc9b-f131d4d49e04",
                        "source_sense_id": "0922dd55-f84f-3ba7-ae0c-98b39462e4cd",
                        "target_lang_word": "старица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "старица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b710297a-c49d-3a89-aff3-176eaddf7061",
                                        "entry_id": "5332631b-cd3a-3355-aadc-8cfa234de71e",
                                        "glosses": [
                                            "церк. женск. к старец; пожилая монахиня, отшельница (в православии)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e867fa41-1f3c-431f-abd2-da1a81a070ae",
                                                "sense_id": "b710297a-c49d-3a89-aff3-176eaddf7061",
                                                "text": "Ты же говори то, что сообразно с здравым учением: чтобы старцы были бдительны, степенны, целомудренны, здравы в вере, в любви, в терпении; чтобы старицы также одевались прилично святым, не были клеветницы, не порабощались пьянству, учили добру; чтобы вразумляли молодых любить мужей, любить детей, быть целомудренными, чистыми, попечительными о доме, добрыми, покорными своим мужьям, да не порицается слово Божие."
                                            },
                                            {
                                                "example_id": "3046fe22-8a14-4243-9e2e-32d7cd451567",
                                                "sense_id": "b710297a-c49d-3a89-aff3-176eaddf7061",
                                                "text": "Здесь была одна бедная женщина, старица Феодула: одни считали её полоумной, другие святой; уже целые годы не отходила она от гробницы Мамы; больная дочь, для которой старица сначала просила исцеления, давно умерла, а Феодула по-прежнему молилась о кусочке полинявшей, истрепанной ткани."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "старица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "558d28c9-7cc0-332a-af7e-4b0927bd50fc",
                                        "entry_id": "4975e091-6866-3583-97dd-b34dabf07e0c",
                                        "glosses": [
                                            "гидрол. полностью или частично отделившийся от реки участок её прежнего русла; староречье"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25eb065-bbc9-4890-8095-8364fb6c083d",
                                                "sense_id": "558d28c9-7cc0-332a-af7e-4b0927bd50fc",
                                                "text": "Напротив, через реку, высились обсыпавшиеся красные отвесы крутого берега, под которым проходила старица, то есть главное русло реки."
                                            },
                                            {
                                                "example_id": "2ea740f9-60a5-44f7-b4b1-472101fb33c2",
                                                "sense_id": "558d28c9-7cc0-332a-af7e-4b0927bd50fc",
                                                "text": "Фарков утёр рукавом серого азяма вспотевший лоб. ― Это не ручеёк, а старица, протока. Вот ужо она версты через три широко выйдет."
                                            },
                                            {
                                                "example_id": "b3f1d59c-54ab-440c-a77b-667e3d34be4b",
                                                "sense_id": "558d28c9-7cc0-332a-af7e-4b0927bd50fc",
                                                "text": "На западе и севере видна громадная низина левого берега Колымы, вся испещрённая множеством озёр ― стариц."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
