                "entry_id": "d3300b03-3d40-3c5b-83c9-76356f621c85",
                "word": "illiberal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "395fbc38-4fd6-44ed-a2fb-19003ef6da51",
                        "entry_id": "d3300b03-3d40-3c5b-83c9-76356f621c85",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more illiberal"
                    },
                    {
                        "form_id": "5724fb85-28fd-485d-b219-88a4d2a642cc",
                        "entry_id": "d3300b03-3d40-3c5b-83c9-76356f621c85",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most illiberal"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90f424f0-6826-38e8-b32c-26c754f9f4c0",
                        "entry_id": "d3300b03-3d40-3c5b-83c9-76356f621c85",
                        "glosses": [
                            "Illibéral, antilibéral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b89ffd4f-4aae-4453-a954-1e34dcbf04cb",
                                "sense_id": "90f424f0-6826-38e8-b32c-26c754f9f4c0",
                                "text": "It is not illiberal for an editor to decline the services of a member of the opposite party as a leader writer, or even as a political reviewer or in any capacity in which his opinions would affect his work. It is illiberal to reject him as a compositor or as a clerk, or in any capacity in which his opinions would not affect his work for the paper."
                            },
                            {
                                "example_id": "27d9a9f0-46bf-4778-b3a2-700616b8ece7",
                                "sense_id": "90f424f0-6826-38e8-b32c-26c754f9f4c0",
                                "text": "Many are also illiberal – capturing the judiciary and media, usurping constitutional bodies, attacking civil society – and “anti-woke”. But just look, said Rooduijn, at that core ideology. Is it nativist, exclusionary of outgroups, authoritarian? Then you have a far-right party."
                            }
                        ]
                    }
