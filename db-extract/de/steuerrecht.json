                ],
                "senses": [
                    {
                        "sense_id": "f96a0726-b7af-3fe6-bacb-c795ff000ea6",
                        "entry_id": "2bac7430-882e-3ff2-8f36-3bba26e7c360",
                        "glosses": [
                            "Gesamtheit der gesetzlichen Vorschriften, die die Steuern betreffen"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "f63cde4d-4bfa-4c53-ab6b-bdcc9bc45cb4",
                                "sense_id": "f96a0726-b7af-3fe6-bacb-c795ff000ea6",
                                "text": "Das Steuerrecht ist viel zu kompliziert! Da blickt ein normaler Mensch nicht mehr durch."
                            },
                            {
                                "example_id": "0c50d9aa-d305-4ae2-af0d-6699ffd3f1ce",
                                "sense_id": "f96a0726-b7af-3fe6-bacb-c795ff000ea6",
                                "text": "Viele Steuerzahler wünschen sich ein einfacheres Steuerrecht."
                            },
                            {
                                "example_id": "d4eeaa1e-de70-43af-95a4-7d1840eeeae8",
                                "sense_id": "f96a0726-b7af-3fe6-bacb-c795ff000ea6",
                                "text": "Max Müller ist Fachanwalt für Steuerrecht."
                            },
                            {
                                "example_id": "e55572e0-8032-4b5e-a463-4f6849620895",
                                "sense_id": "f96a0726-b7af-3fe6-bacb-c795ff000ea6",
                                "text": "„Zu verzeichnen ist eine wachsenden Europäisierung der nationalen Steuerrechte, was das Spannungsverhältnis zwischen Harmonisierung und Steuerhoheit der Mitgliedstaaten weiter verstärkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba27ec41-a0e4-3576-b9a0-05744fb65522",
                        "entry_id": "2bac7430-882e-3ff2-8f36-3bba26e7c360",
                        "glosses": [
                            "Anspruch auf Grundlage der steuerlichen Gesetzgebung"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "a116c1dc-1ea1-4116-801b-1978b5546c9b",
                                "sense_id": "ba27ec41-a0e4-3576-b9a0-05744fb65522",
                                "text": "„Die Unionsführung will den Koalitionsstreit um gleiche Steuerrechte für homosexuelle Paare trotz internen Drucks aussitzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
