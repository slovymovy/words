                "senses": [
                    {
                        "sense_id": "436c638a-9334-3d25-8fd7-c995167208fb",
                        "entry_id": "82aa786a-9fbd-30f9-90ae-f51741c3182a",
                        "glosses": [
                            "Turm, in dem Fallversuche durchgeführt werden. Der freie Fall der sogenannten Fallkapsel findet dabei in einer evakuierten Röhre im Inneren des Fallturms statt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f562b4f6-4b0c-409b-9bef-8d3d800707be",
                                "sense_id": "436c638a-9334-3d25-8fd7-c995167208fb",
                                "text": "Der Fallturm in Bremen ist der bekannteste Fallturm in Deutschland."
                            },
                            {
                                "example_id": "e4597ca7-0fa3-423f-ad4c-b37a4f5fb185",
                                "sense_id": "436c638a-9334-3d25-8fd7-c995167208fb",
                                "text": "„Der Versuchsaufbau ist zuvor im Bremer Fallturm und bei ballistischen Raketenflügen in bis zu 270 Kilometer Höhe getestet worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
