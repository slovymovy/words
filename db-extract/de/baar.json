                "senses": [
                    {
                        "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                        "entry_id": "2c8a1345-d61f-36cd-9d5a-f3edc5e75990",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "655ba3c1-6ce9-48af-9377-8da0df942fb2",
                                "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                                "text": "Frau Baar ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6a57aa3d-554a-4c03-97b4-311b1f87f446",
                                "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                                "text": "Herr Baar wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8d3a5389-affd-427a-9199-ad8040738625",
                                "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                                "text": "Die Baars kommen heute aus dem Schwarzwald."
                            },
                            {
                                "example_id": "b27ae91c-7c8d-4b9c-ae1d-01d54d72eecd",
                                "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                                "text": "Der Baar trägt nie die Schals, die die Baar ihm strickt."
                            },
                            {
                                "example_id": "1da3783c-148c-4a00-8c32-02ac135c06a5",
                                "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baar kommt, geht der Herr Baar.“"
                            },
                            {
                                "example_id": "69f5ac2e-fdc8-4d0d-ac14-c6d2c244d4e5",
                                "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                                "text": "Baar kommt und geht."
                            },
                            {
                                "example_id": "9d653daf-614c-4ad5-a259-d023166eadba",
                                "sense_id": "afe5f432-9fba-35c5-bd78-c80dea5e7278",
                                "text": "Baars kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
