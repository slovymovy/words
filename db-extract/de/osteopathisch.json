                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f9e2ff8-54ba-3f46-8185-f9c4f39e448f",
                        "entry_id": "718a84d6-01e1-36bd-8067-1963a697292f",
                        "glosses": [
                            "Osteopathien, also Krankheiten der Knochen betreffend"
                        ],
                        "tags": [
                            "general",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9de61d98-383b-4aae-8474-34f2d418139d",
                                "sense_id": "0f9e2ff8-54ba-3f46-8185-f9c4f39e448f",
                                "text": "„Dabei geht es in unserem engagierten Teamwork unter anderem darum, osteopathische Krankheiten wie Rheuma, Gicht oder Osteoporose völlig natürlich durch eine ausgewählte Ernährungsumstellung zu heilen.“"
                            },
                            {
                                "example_id": "439f3272-08a0-464a-ac00-e6a4a003a417",
                                "sense_id": "0f9e2ff8-54ba-3f46-8185-f9c4f39e448f",
                                "text": "Wir behandeln „osteopathische Krankheiten: Schwerpunkt Osteoporose, Erkrankungen des rheumatischen Formenkreises (entzündliches Rheuma, Morbus Bechterew […]) […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d0da64d-90e6-3f55-8619-f8763ab00486",
                        "entry_id": "718a84d6-01e1-36bd-8067-1963a697292f",
                        "glosses": [
                            "die Osteopathie als ganzheitliches, manuelles Diagnose- und Behandlungskonzept der alternativen Medizin bei Störungen und Bewegungseinschränkungen der Faszien und Gelenke betreffen"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "0ffbc041-8caa-4526-b1ef-0e11736be68e",
                                "sense_id": "9d0da64d-90e6-3f55-8619-f8763ab00486",
                                "text": "„Wer im Kreis Segeberg osteopathisch arbeiten will, braucht bald eine teure, zeitaufwendige Ausbildung bei der Heilpraktikerschule.“"
                            },
                            {
                                "example_id": "e1900e27-de78-4e02-8a4b-c4cc8b2e45c0",
                                "sense_id": "9d0da64d-90e6-3f55-8619-f8763ab00486",
                                "text": "„Der Bundesverband Osteopathie e. V. – BVO ist eine berufliche Interessensvertretung für osteopathisch arbeitende Personen in Deutschland.“"
                            },
                            {
                                "example_id": "f9e7e02b-c17f-4f24-a588-535f14a648f7",
                                "sense_id": "9d0da64d-90e6-3f55-8619-f8763ab00486",
                                "text": "„Nicht nur physiotherapeutisch, sondern mittlerweile auch osteopathisch kann Regina Fester mittlerweile die Hunde behandeln, was die Faszien - Bindegewebsstrukturen - lösen soll.“"
                            },
                            {
                                "example_id": "613babb1-72bf-4470-9ae3-9f7a5044ae7d",
                                "sense_id": "9d0da64d-90e6-3f55-8619-f8763ab00486",
                                "text": "„Schon ihren ersten Vorfall im Jahr 2005 kurierte sie mit konservativen Mitteln, machte Physiotherapie, ließ sich osteopathisch behandeln und trieb rückenstärkenden Sport.“"
                            },
                            {
                                "example_id": "6448e422-5e12-45da-b117-ee508884729d",
                                "sense_id": "9d0da64d-90e6-3f55-8619-f8763ab00486",
                                "text": "„Der Abend gibt einen Einblick, wie Menschen vom Baby bis ins hohe Alter osteopathisch behandelt werden können.“"
