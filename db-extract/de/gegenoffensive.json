                    {
                        "translation_id": "16335cb8-8949-4663-b94e-55269e35938d",
                        "source_entry_id": "5faea5e4-7fdf-31d3-8c00-716f4346a2eb",
                        "source_sense_id": "e5352fd9-e6dd-3a06-b340-63a5c11dd95c",
