                "senses": [
                    {
                        "sense_id": "5a195394-a0e0-30fb-8a2b-4ca4c3b6314b",
                        "entry_id": "e7a51471-a1ac-3cc8-bfce-8e6e1c313530",
                        "glosses": [
                            "grobowiec w formie kamiennej skrzyni lub trumny przykrytej płytą, zazwyczaj z rzeźbionym wizerunkiem zmarłego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f04a5a-bad4-40b5-a7e4-adb22b01ba8a",
                                "sense_id": "5a195394-a0e0-30fb-8a2b-4ca4c3b6314b",
                                "text": "Podobnie jak w przypadku pozostałych monarchów (z wyjątkiem grobu Kazimierza Wielkiego), nagrobek stanowi swojego rodzaju kenotafium – ciało Kazimierza Jagiellończyka, nie spoczywa we wnętrzu tumby, ale pochowane jest pod posadzką kaplicy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "52154fee-32f5-33af-9105-de71c7be9931",
                        "entry_id": "e7a51471-a1ac-3cc8-bfce-8e6e1c313530",
                        "glosses": [
                            "trumna, sarkofag, grobowiec, mauzoleum przeznaczone na zwłoki świętego"
                        ],
                        "tags": [
                            "dated"
                        ],
