                                        "sense_id": "97a3bfaa-f1c3-39b7-a3a6-8f2cf1d0c1b7",
                                        "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                                        "glosses": [
                                            "A refuse heap usually near a dwelling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee66d14e-fee5-4538-8ecc-05425c7a704b",
                                                "sense_id": "97a3bfaa-f1c3-39b7-a3a6-8f2cf1d0c1b7",
                                                "text": "Untouched by the decaying middens in which they live, they emerge into the sunshine immaculate and serene. The Burmese must be the best-dressed people in the world."
                                            },
                                            {
                                                "example_id": "900deb9c-90a0-4fa0-9c18-1450e06a2baa",
                                                "sense_id": "97a3bfaa-f1c3-39b7-a3a6-8f2cf1d0c1b7",
                                                "text": "Strange rubbish, not the tins and paper and boxes and other containers you would expect in a town, but a finer kind of waste […] that made the middens look like grey-black mounds of sifted earth."
                                            }
                                        ]
                                    },
