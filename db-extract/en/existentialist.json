                    {
                        "translation_id": "bd1779d8-00b6-48ea-9af9-07b35ef048aa",
                        "source_entry_id": "27832c15-8a09-3405-b2f8-67aedbee1be1",
                        "source_sense_id": "0e3ff20e-77a1-3b44-adb4-f9ce9a6021a9",
