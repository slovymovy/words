                "senses": [
                    {
                        "sense_id": "7cccebdf-1718-3807-b869-f610d6eafa02",
                        "entry_id": "35bc1883-a283-3199-9d53-4a4545cdc5c2",
                        "glosses": [
                            "Qui constitue une aggravation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5bb0171-caf9-495d-ac9c-d4c42c9f85c6",
                                "sense_id": "7cccebdf-1718-3807-b869-f610d6eafa02",
                                "text": "Pour lors, l’impôt est aggravatif à l’égard de l’état antérieur et permanent de misère."
                            },
                            {
                                "example_id": "e0765fd0-50e9-4788-bfff-630b61da7003",
                                "sense_id": "7cccebdf-1718-3807-b869-f610d6eafa02",
                                "text": "Dans la blennorrhagie aiguë de l’homme, les injections de levure n’exercent aucune espèce d’influence bien nette ni dans un sens aggravatif ni dans un sens curatif ; elles semblent se comporter comme un médicament absolument inerte."
                            },
                            {
                                "example_id": "a06f70e3-8477-4d60-afa9-7977a5e680f4",
                                "sense_id": "7cccebdf-1718-3807-b869-f610d6eafa02",
                                "text": "Dans un tout autre domaine où la contrefaçon du modèle, il est vrai, était le grief principal, la concurrence déloyale résidait, à titre aggravatif, dans une reproduction servile au point d’être interchangeable."
                            }
                        ]
                    }
