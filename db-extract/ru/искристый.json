                ],
                "translations": [
                    {
                        "translation_id": "62709b1f-fee6-4587-b44f-c09119f5e911",
                        "source_entry_id": "a78846d0-6bcb-34dc-a398-88041546569f",
                        "target_lang_word": "étincelant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étincelant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Qui étincelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23941d3d-dd7f-49a2-8a61-5e8d9784e286",
                                                "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                                "text": "Il a fait très frais pendant la nuit, et, ce matin, quand je suis sorti de ma tente, la campagne était étincelante de givre."
                                            },
                                            {
                                                "example_id": "4530c0aa-2d4b-435b-afec-071f301f984a",
                                                "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                                "text": "À l’inverse, la Metro Goldwyn Mayer revendique le luxe étincelant dans des décors de rêve, mettant en valeur son écurie de stars ultra-glamour."
                                            },
                                            {
                                                "example_id": "6787ab76-f8fe-44af-b0a6-b0a194145723",
                                                "sense_id": "7ac74956-9797-3a81-bf02-26026887991a",
                                                "text": "Et, dans sa grâce, il créa une gigantesque coupole d'or étincelant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976c6096-6b4f-3770-8c90-6f5daadf289e",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Qui semble étinceler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dff1c50b-d4aa-4ab7-97f3-90a6fbe4154f",
                                                "sense_id": "976c6096-6b4f-3770-8c90-6f5daadf289e",
                                                "text": "D’une maigreur extrême, les joues d’un rouge sombre, les yeux caves et étrangement étincelants, les lèvres amincies et douloureusement serrées, elle semblait vieillie de dix années, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c773976d-fd73-333f-804f-6a67eb27f2da",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Qui lance des traits d’esprit brillants."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a268ff08-ba05-4660-bec0-96a7ed494c1a",
                                                "sense_id": "c773976d-fd73-333f-804f-6a67eb27f2da",
                                                "text": "Un esprit étincelant. Un style étincelant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4edf5da-6c74-3b89-b1a7-a340ce910cb1",
                                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                                        "glosses": [
                                            "Se dit de charbon, astre, lumière ou feux qui sont représentés avec des étincelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d6252d5-228e-4794-b528-ce9bda2ba5ee",
                                                "sense_id": "f4edf5da-6c74-3b89-b1a7-a340ce910cb1",
                                                "text": "D’azur à la fasce ondée d’argent chargée de trois losanges de sable, accompagné en chef d’une étoile étincelante d’or et en pointe d’une croix patriarcale, qui est du Cardinal Joseph Charbonneau → voir illustration « étoile étincelante »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "étincelant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9dd10d1-303e-3242-9b1a-9740d48b1767",
                                        "entry_id": "748894e4-10ee-39c4-bac0-609d973161e3",
                                        "glosses": [
                                            "Participe présent de étinceler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25ff8292-cd37-4efb-96b9-38e491f02244",
                        "source_entry_id": "a78846d0-6bcb-34dc-a398-88041546569f",
                        "target_lang_word": "pétillant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                        "entry_id": "d9b2e5a7-f119-39f8-919c-f37916aaf248",
                                        "glosses": [
                                            "Qui pétille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9a4695-e1b1-4bf1-924e-a0e6ab59ff43",
                                                "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                                "text": "En bon Champenois, il célébra le vin de Champagne dans une ode en vers iambiques, dont le style vif et pétillant, présente la belle image de cette charmante liqueur."
                                            },
                                            {
                                                "example_id": "cf5e1117-e999-436a-b228-8a34d64cbbd1",
                                                "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                                "text": "Du foyer avivé s’élevaient de belles flammes qui montaient en tourbillons jusqu’au toit, en jetant des étincelles pétillantes qui, seules, troublaient le silence."
                                            },
                                            {
                                                "example_id": "6fbb2b63-ef27-4623-8750-d31668ac0771",
                                                "sense_id": "e533aa1b-231c-32a8-8861-8bdbceb75863",
                                                "text": "Vin pétillant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ca4d20-d256-38dc-ad03-1dd467b1c7ec",
                                        "entry_id": "d9b2e5a7-f119-39f8-919c-f37916aaf248",
                                        "glosses": [
                                            "Qui brille avec éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7aef038-9c2a-4d43-a008-f55c431c242e",
                                                "sense_id": "f5ca4d20-d256-38dc-ad03-1dd467b1c7ec",
                                                "text": "À l’affiche cette année, entre autres, le chanteur, guitariste et auteur-compositeur Gilberto Gil, le pétillant groupe de jazz-funk Earth Wind and Fire, la chanteuse Jane Birkin, l’organiste Rhoda Scott ou encore l’ensemble vocal de gospel Golden Gate Quartet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d839e4b9-75bc-3760-b5ee-b20c0b38bd97",
                                        "entry_id": "4ad44c09-3fbb-3a96-baa0-02f2047fe915",
                                        "glosses": [
                                            "Vin qui pétille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "238eccaf-1220-4dec-b6e3-597f105f24af",
                                                "sense_id": "d839e4b9-75bc-3760-b5ee-b20c0b38bd97",
                                                "text": "Main sur l’épaule, tapes dans le dos, sourires et lunch d’adieu avec petit pétillant frais, ses ex-coachs de Think Global firent part de leur regret de devoir se séparer de lui."
                                            },
                                            {
                                                "example_id": "41f4bb4b-0dc6-4cb4-8e56-eb0aa67f7902",
                                                "sense_id": "d839e4b9-75bc-3760-b5ee-b20c0b38bd97",
                                                "text": "Quoi de plus frais et de désaltérant l’été qu’un pétillant peu sucré ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pétillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3135d9da-117b-3eec-b1bb-7f6cf7a0fe71",
                                        "entry_id": "46a850f3-1a08-35ab-b24f-2d8ba5f02ee4",
                                        "glosses": [
                                            "Participe présent de pétiller."
                                        ],
