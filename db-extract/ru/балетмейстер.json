                                        "glosses": [
                                            "Celui, celle qui pratique la chorégraphie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50c4ef4-6d1c-4508-ab7f-3714eb196737",
                                                "sense_id": "1d63f8f5-1a55-36c4-bfa0-52446e182ce7",
                                                "text": "Un désespéré, précise le chorégraphe, un héros romantique, dont « Nina » est la planche de salut, ne l’oublie jamais !"
                                            },
                                            {
                                                "example_id": "f7de0420-ff4f-45a5-8140-13f6fdfa0d6d",
                                                "sense_id": "1d63f8f5-1a55-36c4-bfa0-52446e182ce7",
                                                "text": "Surtout, elle rencontre la crème des chorégraphes du XXᵉ siècle en la personne de Maurice Béjart, Rudolf Noureev ou Carolyn Carlson qui devient une amie, « ma grande sœur »."
                                            }
                                        ]
