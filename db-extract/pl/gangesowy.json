                                                "text": "La partie gangétique de l’Inde."
                                            },
                                            {
                                                "example_id": "5b5ba357-7a05-4d53-9e53-5e07e3d933ac",
                                                "sense_id": "03d788e0-3f52-34e8-b8b9-83481c2313bf",
