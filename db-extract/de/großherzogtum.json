                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34d7d8e-1bf1-4563-aa3b-726c3eb349c9",
                                "sense_id": "84134579-4a80-3a43-95c0-dd69947b04af",
                                "text": "Ich lebe in einem Großherzogtum."
                            },
                            {
                                "example_id": "edceb271-49f1-4a29-a219-f957f34938b9",
                                "sense_id": "84134579-4a80-3a43-95c0-dd69947b04af",
                                "text": "Luxemburg ist das letzte noch existierende Großherzogtum."
                            },
                            {
                                "example_id": "0e6d0857-dab8-4c6f-b882-8c881259aeb1",
                                "sense_id": "84134579-4a80-3a43-95c0-dd69947b04af",
                                "text": "Das Großherzogtum Luxemburg will sich mit dem Abbau wertvoller Bodenschätze auf Asteroiden einen Platz unter den führenden Weltraumnationen der Erde sichern."
                            }
                        ],
