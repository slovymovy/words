                "senses": [
                    {
                        "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                        "entry_id": "a1f92426-1463-30b8-8c93-976d416e2d1c",
                        "glosses": [
                            "nach der Hälfte der Spielzeit eingelegte Pause"
                        ],
                        "tags": [
                            "Ballspiel"
                        ],
                        "examples": [
                            {
                                "example_id": "7e5c29ef-5619-4cc1-a476-b8f2bb2e1863",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "Beim Basketball dauert jede Viertelpause zwei Minuten, die Halbzeitpause zehn Minuten."
                            },
                            {
                                "example_id": "2e0187af-b873-42d4-9358-ffd86e0b5462",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "„Eriksen war während des ersten EM-Auftritts der Dänen gegen Finnland kurz vor der Halbzeitpause mit einem Herzstillstand zusammengebrochen […].“"
                            },
                            {
                                "example_id": "004c43c1-f7f0-4cde-a147-83cfa2a1410b",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "„Noch vor der Halbzeitpause (43.) erhöhte Leipzig durch Nkunku.“"
                            },
                            {
                                "example_id": "8fb5533d-d74a-486c-b2dd-ef3f469d27e8",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "„Dietmar \"Didi\" Hamann gehört zu den erfolgreichsten deutschen Fußballern. Sein größter Erfolg war 2005 der UEFA Champions League-Sieg mit dem FC Liverpool, bei dem er nach einem 0:3 Rückstand zur Halbzeitpause eingewechselt wurde, die Mannschaft dann den 3:3 Ausgleich schaffte und nach Elfmeterschießen schließlich noch gewann.“"
                            },
                            {
                                "example_id": "10e3d04c-1f98-48b5-aca2-5913efeda0da",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "„[…] Torhüter Timo Horn ergänzte: »Wir geraten durch zwei Fehler in der ersten Halbzeit in Rückstand. Dann nehmen wir uns viel vor in der Halbzeitpause und kriegen direkt das 3:0 und das 4:0. […]«“"
                            },
                            {
                                "example_id": "3573399b-1b5b-4822-a20b-90594455b2e5",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "„Kurz nach der Halbzeitpause wechselte Ancelotti den angeschlagenen Hummels sicherheitshalber aus, für ihn kam Joan Bernat (50.) auf den Platz.“"
                            },
                            {
                                "example_id": "804a3374-d652-43f0-ac38-0c2671a858e3",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "„Nachdem der TSG kurz nach der Halbzeitpause der 1:1-Ausgleich gelungen war, entschied ein Doppelschlag innerhalb von 90 Sekunden die Partie.“"
                            },
                            {
                                "example_id": "6a600d13-8332-4a8d-acf6-80bac1af6ef9",
                                "sense_id": "20349de1-862b-337f-a47b-0e4d39282053",
                                "text": "„Augsburg nutzte die Halbzeitpause aber bestens und kam mit neuer Aggressivität auf den Platz zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
