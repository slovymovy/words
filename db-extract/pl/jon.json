                            }
                        ]
                    },
                    {
                        "translation_id": "2f902ec7-3c8c-43e3-b8d9-f2e0dcdba54c",
                        "source_entry_id": "2824ae97-e6dd-3591-bfe3-515a979e1eb6",
                        "source_sense_id": "9270dab6-aadb-3ada-9b99-4dd5246f0248",
                        "target_lang_word": "Ion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                        "entry_id": "4eb94384-605b-3ebe-8fcb-9891041467ea",
                                        "glosses": [
                                            "elektrisch geladenes Teilchen, das aus einem neutralen Atom oder Molekül durch Anlagerung oder Abgabe von Elektronen (Ionisation) entsteht"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea77a38d-af70-4d0e-a20d-11e7d4de3823",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "Dieses Ion ist zweifach positiv geladen."
                                            },
                                            {
                                                "example_id": "be0fc274-2490-439b-b394-321972054308",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "„Weder gibt es einen Plus- noch einen Minuspol, sondern nur ein Gefälle von geladenen Teilchen wie Elektronen oder Ionen.“"
                                            },
                                            {
                                                "example_id": "a9c01a7c-7d95-40e8-8de6-3bb600f0f051",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "[…] „Beim Lösen eines Salzes muss zunächst die Gitterenergie aufgewendet werden, um die Anziehungskräfte zwischen den Ionen im Kristallgitter zu überwinden und die Ionen voneinenader zu trennen.“"
                                            },
                                            {
                                                "example_id": "7b220e33-21c8-4039-bbf2-577a7b1f0c53",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "„Manche Ionen binden ihre Hydrathülle so fest, dass beim Auskristallisieren des Salzes ein Teil der Wasser-Moleküle in das Kristallgitter eingebaut wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9da6750-2558-43b8-a138-0625e7b24f5d",
                        "source_entry_id": "2824ae97-e6dd-3591-bfe3-515a979e1eb6",
                        "source_sense_id": "9270dab6-aadb-3ada-9b99-4dd5246f0248",
                        "target_lang_word": "ион",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ион",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                        "entry_id": "d13b4ead-8c55-3dd7-99fd-ea5d6f31f16e",
                                        "glosses": [
                                            "хим., эл.-техн. электрически заряженная частица (атом, молекула), образующаяся в результате потери или присоединения одного или нескольких электронов атомами или молекулами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ad5922d-7b76-41d0-8c4d-a60dd075bf7c",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                                "text": "«Нейтральные» планетки ― газовые молекулы, ― утратив электрон, становились «позитивным ионом»."
                                            },
                                            {
                                                "example_id": "3ff3bf9d-82b1-461a-b727-59981c2c546d",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                                "text": "Испускаемые радием альфа-частицы оказались положительно заряженными ионами гелия."
                                            },
                                            {
                                                "example_id": "2b1fb302-0b73-42ae-b888-891a4f6ee880",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
                                                "text": "Ионы газа, ударяясь о катод, также выбивают дополнительные электроны."
                                            },
                                            {
                                                "example_id": "d80ff281-7b2c-48b6-acff-3c3d4cdcb00e",
                                                "sense_id": "d4ec5767-3706-313d-b85c-468074f06bb7",
