{
    "word_family": [
        "собачий",
        "собачка",
        "собачник",
        "собачиться",
        "по-собачьи"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63c153b5-3482-31ed-b545-71f003a144bc",
                    "sense_definition": "Домашнее животное семейства псовых, которое лает и часто используется для охраны или как компаньон.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У моих соседей есть большая добрая <w>собака</w>, которая любит играть с детьми.",
                            "target_lang_translations": {
                                "de": "Meine Nachbarn haben einen großen, lieben <w>Hund</w>, der gerne mit Kindern spielt."
                            }
                        },
                        {
                            "text": "Каждое утро я выхожу на улицу, чтобы выгулять свою <w>собаку</w>.",
                            "target_lang_translations": {
                                "de": "Jeden Morgen gehe ich nach draußen, um meinen <w>Hund</w> auszuführen."
                            }
                        }
                    ],
                    "synonyms": [
                        "пёс",
                        "псина",
                        "друг человека",
                        "четвероногий друг"
                    ],
                    "common_phrases": [
                        "злая собака",
                        "сторожевая собака",
                        "гулять с собакой",
                        "бездомная собака"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Haustier aus der Familie der Hundeartigen, das bellt und oft zum Schutz oder als Begleiter gehalten wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hund",
                                "target_lang_sense_clarification": "Haustier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dba53e8-ddc9-365e-996b-2ff008c58db9",
                    "sense_definition": "Разговорное название символа «@», используемого в адресах электронной почты.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Диктуя адрес почты, он сказал: «имя, потом <w>собака</w>, потом джимэйл точка ком».",
                            "target_lang_translations": {
                                "de": "Als er die E-Mail-Adresse diktierte, sagte er: „Name, dann <w>At-Zeichen</w>, dann gmail Punkt com“."
                            }
                        },
                        {
                            "text": "На клавиатуре символ <w>собака</w> находится на клавише с цифрой два.",
                            "target_lang_translations": {
                                "de": "Auf der Tastatur befindet sich das <w>At-Zeichen</w> auf der Taste mit der Nummer zwei."
                            }
                        }
                    ],
                    "synonyms": [
                        "собачка"
                    ],
                    "common_phrases": [
                        "значок собаки",
                        "символ собаки"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Umgangssprachliche Bezeichnung für das Symbol »@«, das in E-Mail-Adressen verwendet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "At-Zeichen",
                                "target_lang_sense_clarification": "das Symbol @"
                            },
                            {
                                "target_lang_word": "Klammeraffe",
                                "target_lang_sense_clarification": "umgangssprachlich für das Symbol @"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "356db5fa-4a21-388e-9119-70e52f0fe368",
                    "sense_definition": "Грубое слово, обозначающее злого, подлого или недостойного человека.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот <w>собака</w> украл у меня кошелёк и скрылся в толпе!",
                            "target_lang_translations": {
                                "de": "Dieser <w>Hund</w> hat mein Portemonnaie gestohlen und ist in der Menge verschwunden!"
                            }
                        },
                        {
                            "text": "Не верь ни одному его слову, он хитрая и опасная <w>собака</w>.",
                            "target_lang_translations": {
                                "de": "Glaube keinem seiner Worte, er ist ein hinterlistiger und gefährlicher <w>Hund</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "негодяй",
                        "мерзавец",
                        "поганец",
                        "скотина",
                        "сукин сын",
                        "чёрт"
                    ],
                    "antonyms": [
                        "молодец"
                    ],
                    "common_phrases": [
                        "злой как собака",
                        "собака на сене",
                        "устать как собака",
                        "замёрзнуть как собака"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": "used as abuse/swear word"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Schimpfwort für einen bösen, gemeinen oder niederträchtigen Menschen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hund",
                                "target_lang_sense_clarification": "Schimpfwort für einen gemeinen Menschen"
                            },
                            {
                                "target_lang_word": "Schweinehund",
                                "target_lang_sense_clarification": "Schimpfwort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8caf2e7-2ddf-3bae-93ed-bf02e6ac0d96",
                    "sense_definition": "Человек, который очень хорошо знает своё дело, мастер (часто с оттенком восхищения ловкостью).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш новый инженер просто <w>собака</w> в программировании, решает любые задачи за пять минут.",
                            "target_lang_translations": {
                                "de": "Unser neuer Ingenieur ist ein absoluter <w>Könner</w> im Programmieren, er löst jede Aufgabe in fünf Minuten."
                            }
                        },
                        {
                            "text": "Он на этих юридических вопросах <w>собаку</w> съел, лучше спроси у него.",
                            "target_lang_translations": {
                                "de": "Er ist ein <w>alter Hase</w> in diesen Rechtsfragen, frag ihn am besten."
                            }
                        }
                    ],
                    "synonyms": [
                        "мастер",
                        "мастак"
                    ],
                    "common_phrases": [
                        "собаку съесть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die ihre Sache sehr gut versteht; ein Meister oder Experte auf einem Gebiet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Könner",
                                "target_lang_sense_clarification": "Experte, Meister"
                            },
                            {
                                "target_lang_word": "Alter Hase",
                                "target_lang_sense_clarification": "erfahrene Person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daeba351-42f4-320f-a49c-d60395245f43",
                    "sense_definition": "Электричка или пригородный поезд.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты часто ездят в университет на утренней <w>собаке</w>, потому что это дёшево.",
                            "target_lang_translations": {
                                "de": "Studenten fahren oft mit dem morgendlichen <w>Vorortzug</w> zur Universität, weil es günstig ist."
                            }
                        },
                        {
                            "text": "Мы опоздали на последнюю <w>собаку</w> до Москвы и остались ночевать на вокзале.",
                            "target_lang_translations": {
                                "de": "Wir haben die letzte <w>S-Bahn</w> nach Moskau verpasst und übernachteten am Bahnhof."
                            }
                        }
                    ],
                    "synonyms": [
                        "электричка"
                    ],
                    "common_phrases": [
                        "ехать на собаках"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Umgangssprachlich für einen Vorortzug oder eine Elektritschka."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Vorortzug",
                                "target_lang_sense_clarification": "Elektritschka"
                            },
                            {
                                "target_lang_word": "S-Bahn",
                                "target_lang_sense_clarification": "Nahverkehrszug"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "416f8825-f6c2-3b80-a734-a4ba18afd628",
                    "sense_definition": "Сторожевой таймер — устройство, которое перезагружает компьютер или систему, если она зависла.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если микроконтроллер перестанет отвечать, аппаратная <w>собака</w> выполнит перезагрузку системы.",
                            "target_lang_translations": {
                                "de": "Wenn der Mikrocontroller nicht mehr antwortet, führt der Hardware-<w>Watchdog</w> einen Systemneustart durch."
                            }
                        },
                        {
                            "text": "Программист забыл сбросить <w>собаку</w>, и устройство постоянно перезагружалось.",
                            "target_lang_translations": {
                                "de": "Der Programmierer hat vergessen, den <w>Watchdog</w> zurückzusetzen, und das Gerät startete ständig neu."
                            }
                        }
                    ],
                    "synonyms": [
                        "сторожевой таймер"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Watchdog-Timer: eine elektronische Schaltung oder Komponente, die ein System neu startet, wenn es sich aufhängt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Watchdog",
                                "target_lang_sense_clarification": "Fachbegriff aus der Informatik"
                            },
                            {
                                "target_lang_word": "Watchdog-Timer",
                                "target_lang_sense_clarification": "Сторожевой таймер"
                            }
                        ]
                    }
                }
            ]
        },
