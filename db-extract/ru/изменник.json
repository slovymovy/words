                        "form": "изме́нниками"
                    },
                    {
                        "form_id": "83c31f98-1811-48ba-8e9e-2caee0b6680c",
                        "entry_id": "83e7dba4-36ea-3eef-b7be-699b53ad4904",
                        "tags": [
                            "singular",
