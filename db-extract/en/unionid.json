                    {
                        "sense_id": "cf6f1756-aaa8-3994-89b7-71ed65bbdf7e",
                        "entry_id": "708789c9-1fdc-3f48-97b4-cfe31a85fccb",
                        "glosses": [
                            "Relating to, resembling, or characteristic of a member of the family Unionidae of bivalves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25576f45-cb9e-4db1-9014-0dffad4d8252",
                                "sense_id": "cf6f1756-aaa8-3994-89b7-71ed65bbdf7e",
                                "text": "Mr. C[harles] T[orrey] Simpson states that no Mutelid, known to be such, has the Unionid type of hinge."
                            },
                            {
                                "example_id": "c6329fd4-088d-495a-a2e6-3644e7248849",
                                "sense_id": "cf6f1756-aaa8-3994-89b7-71ed65bbdf7e",
                                "text": "The present study began with the discovery of metacercariae in the edge of the mantle of unionid bivalves collected from the Tippecanoe River, Indiana."
                            },
                            {
                                "example_id": "fe14f5fc-cf6e-4d60-b1b7-a2a9cfd2fbf3",
                                "sense_id": "cf6f1756-aaa8-3994-89b7-71ed65bbdf7e",
                                "text": "Articulated unionid shells, many in life position in channel lag (cl) below a thin clay bed (c), in turn overlain by a shelving sandstone (SS) with Lockeia in its sole face and with escape structures."
                            }
                        ]
                    }
