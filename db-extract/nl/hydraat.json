                    {
                        "translation_id": "5b4ab657-9bf4-4df7-a5eb-5084f0ae141e",
                        "source_entry_id": "17f8059d-47bf-3736-bf3f-7a0e1413262a",
                        "source_sense_id": "a906c850-c5eb-354a-ad87-a9a23abf6d18",
                        "source_sense_description": "(scheikunde) een moleculaire verbinding van een stof met water",
                        "target_lang_word": "hydrate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6df24435-702e-3ef6-80c3-3f03ff851484",
                                        "entry_id": "676f0de0-ba21-3665-84fd-606f811eee68",
                                        "glosses": [
                                            "Nom générique des corps composés d’eau et d’un oxyde métallique, ou d’eau et d’un acide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fcd533d-0a6b-4412-8ffa-5fd63d199175",
                                                "sense_id": "6df24435-702e-3ef6-80c3-3f03ff851484",
                                                "text": "Les oxydes sont précipités des sels par les bases alcalines à l’état d’hydrate."
                                            },
                                            {
                                                "example_id": "d4bbbfec-1f5b-459c-8bca-9c858613af04",
                                                "sense_id": "6df24435-702e-3ef6-80c3-3f03ff851484",
                                                "text": "Des analyses ultérieures pourront seules décider si l'on doit admettre l’idée émise par l’auteur, que si l’hydrate d’alumine se trouve en proportions variables dans les plombs-gomme, on devrait être porté à les faire rentrer dans les variétés de pyromorphite."
                                            },
                                            {
                                                "example_id": "bd77bed5-2a0f-4776-a13d-aaef10020c17",
                                                "sense_id": "6df24435-702e-3ef6-80c3-3f03ff851484",
                                                "text": "L’hydrate de chaux en pâte, tel qu'il convient aux mortiers, est obtenu de la même manière, mais eu ajoutant plus d'eau, pour préparer une pâte fluide qui prend plus de consistance par l’extinction (hydratation) des dernières particules de chaux."
                                            },
                                            {
                                                "example_id": "5a34a3c5-6a7f-4fd6-9907-3e413a413f9c",
                                                "sense_id": "6df24435-702e-3ef6-80c3-3f03ff851484",
                                                "text": "À l'aldéhyde éthylique CH₃.CHO correspond un dérivé trichloré, CCl₃.CHO, le chloral, très employé sous forme d’hydrate."
                                            },
                                            {
                                                "example_id": "9ff29f8e-11c3-4a33-9f71-85a9d8662c1f",
                                                "sense_id": "6df24435-702e-3ef6-80c3-3f03ff851484",
                                                "text": "On emploie également des batteries de plusieurs cuves renfermant de la sciure de bois recouverte d'hydrate de magnésie."
                                            }
                                        ]
                                    }
                                ]
                            },
