                ],
                "senses": [
                    {
                        "sense_id": "3c716c51-d147-3b06-a00b-f292577d50a5",
                        "entry_id": "7b71464a-b7af-3e18-b464-bbda9446c973",
                        "glosses": [
                            "Détériorer (à cause des charançons)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba2cfbdb-2216-42f3-af00-bdc2b39e74a9",
                                "sense_id": "3c716c51-d147-3b06-a00b-f292577d50a5",
                                "text": "Qui ira charançonner le précieux dépôt millénaire (ou ce qu'on en communiquera encore sous forme de papier) dans l'espoir de gagner un concours de poudre à laver et le voyage de rêve qui couronne le lauréat?"
                            },
                            {
                                "example_id": "d3ea076b-a4a2-4717-b78c-7292873db4f8",
                                "sense_id": "3c716c51-d147-3b06-a00b-f292577d50a5",
                                "text": "Au lieu de vendre du riz en sacs pourquoi ne pas l'empaqueter par exemple ? Il courrait moins le risque de se charançonner et surtout nous transporterions un produit fini plus rémunérateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "53dc1b35-78ea-3908-bc57-dc3cb81a1df4",
                        "entry_id": "7b71464a-b7af-3e18-b464-bbda9446c973",
                        "glosses": [
                            "Détériorer, mettre hors service, contaminer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bbfd185-436e-45a1-bb34-affb082c98aa",
                                "sense_id": "53dc1b35-78ea-3908-bc57-dc3cb81a1df4",
                                "text": "Selon lui, ce serait été une manucure qu’aurait pu charançonner les mignonnes du copain."
                            }
                        ]
                    }
                ],
