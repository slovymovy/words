                        "entry_id": "decd3e7e-df99-3f88-beed-5b497a70418b",
                        "glosses": [
                            "Machines implantées à bord des navires et dédiées aux opérations de manutention ou aux manœuvres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "354e76f2-cc3b-4fb3-bbe9-87b8b046f145",
                                "sense_id": "f88fd1f1-e079-3085-aca1-6c63668f2cc8",
                                "text": "Le bourgeois devait fournir son navire en bon état et muni des agrès, apparaux, canons et autres armes nécessaires."
                            },
                            {
                                "example_id": "3bfce5aa-4f74-4716-9515-e52d54da40e9",
                                "sense_id": "f88fd1f1-e079-3085-aca1-6c63668f2cc8",
                                "text": "Morisseau, lui, n’avait plus qu’une préoccupation, qui le tenait du matin au soir : déménager tous les apparaux du cuivre du yacht pour les plaquer sur sa maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "c77b67a7-995e-3021-a5f2-23b128e8cb99",
                        "entry_id": "decd3e7e-df99-3f88-beed-5b497a70418b",
                        "glosses": [
                            "Appareils de construction des ponts, etc."
                        ],
