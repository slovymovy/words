                                    {
                                        "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                        "entry_id": "913ff466-a166-34a4-a209-215dd7709451",
                                        "glosses": [
                                            "Person, die etwas Verwerfliches (eine Missetat) begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b91aa0d-65fa-4832-9c16-42538da1f219",
                                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                                "text": "„Diese Missetäter knieten nieder.“"
                                            },
                                            {
                                                "example_id": "45a27da7-1bd8-47a6-a8ac-6d4b01112569",
                                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                                "text": "„Mögen Jahre darüber hingehen, mag dem Missetäter inzwischen ein langer Bart gewachsen sein, eines Tages kommt die Geschichte ans Licht, der Vorhang lüftet sich über seiner Tat, über der er längst Gras gewachsen glaubte.“"
                                            },
                                            {
                                                "example_id": "a452c246-e936-4cd2-a9b6-bd036da61b91",
                                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                                "text": "„An den Galeeren hingegen wird die Republik Venedig niemals etwas ändern, nicht nur weil diese ihr auf einem begrenzten Meer gute Dienste leisten, das sie auch bei Windstille befahren muß, sondern auch, weil sie nicht wüßte, wohin sie die Missetäter, die sie zum Rudern verurteilt, stecken noch was sie mit ihnen tun sollte.“"
                                            },
                                            {
                                                "example_id": "0a06ee30-ea49-4b56-8619-3506ad77c2ee",
                                                "sense_id": "66215e55-ec11-3ecb-9254-ba077a2c1fad",
                                                "text": "„Sie versucht, mit einer elektrischen Taschenlampe den Missetäter vom Fenster aus zu erkennen; aber das Licht ist zu schwach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1705fb8e-6aa4-48d5-a5d0-6145e4ec6644",
                        "source_entry_id": "ac1b3730-f5f9-3d7a-a861-00d7105482ae",
