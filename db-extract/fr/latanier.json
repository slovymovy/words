                "entry_id": "b38b94e8-ee2f-3ed6-b9ec-a0d3d43bb418",
                "word": "latanier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bd3636ce-f775-44ad-addb-73a4de81f130",
                        "entry_id": "b38b94e8-ee2f-3ed6-b9ec-a0d3d43bb418",
                        "tags": [
                            "plural"
                        ],
                        "form": "lataniers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0abc1d9d-5d67-3c9c-93f6-a5d4497e6d16",
                        "entry_id": "b38b94e8-ee2f-3ed6-b9ec-a0d3d43bb418",
                        "glosses": [
                            "Genre de palmier originaire de La Réunion de l’île Maurice et des Mascareignes et dont les feuilles sont en éventail. → voir Latania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b849e8a-c1b7-49f4-8e4d-a71133d882f3",
                                "sense_id": "0abc1d9d-5d67-3c9c-93f6-a5d4497e6d16",
                                "text": "Plus loin, des palmiers, des dattiers du Levant, des lataniers rouges, des figuiers de l’Inde, tous robustes, vivaces, feuillus, complètent ces immenses massifs de verdure."
                            },
                            {
                                "example_id": "ad6130ac-0dd6-4ceb-a394-685d57e309b6",
                                "sense_id": "0abc1d9d-5d67-3c9c-93f6-a5d4497e6d16",
                                "text": "Allons chercher le bonheur à l’ombre des lataniers, sur le tombeau de Virginie."
                            },
                            {
                                "example_id": "2ae3e642-57a4-4db7-8251-bc8cd379f75d",
                                "sense_id": "0abc1d9d-5d67-3c9c-93f6-a5d4497e6d16",
                                "text": "Je fus introduit par un laquais en petite tenue – habit noir sur pantalon gris fer – dans un hall jonché de peaux de bêtes, entre des floraisons excessives de phénix et de lataniers."
                            },
                            {
                                "example_id": "333c368e-e445-4048-8816-2ae3b83038c8",
                                "sense_id": "0abc1d9d-5d67-3c9c-93f6-a5d4497e6d16",
                                "text": "Les après-midi, Manuel tressait sur la galerie des chapeaux de paille de latanier."
                            }
                        ]
                    }
                ],
