                "senses": [
                    {
                        "sense_id": "97cbc63a-4572-37b4-ac9e-f59e8592b6bf",
                        "entry_id": "4a9b4d06-1b9b-3f02-9880-7aaaafbd5ce2",
                        "glosses": [
                            "разг. отец; обращение к отцу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "294c0a4c-fd46-4d08-bf1f-8db64b6fe098",
                                "sense_id": "97cbc63a-4572-37b4-ac9e-f59e8592b6bf",
                                "text": "Я, батя, книжку одну читал, так там именно сказано: услугами ума, ежели оный верою направляется, отнюдь не следует пренебрегать, ибо человек без ума в скором времени делается игралищем страстей."
                            }
                        ]
                    },
                    {
                        "sense_id": "257438b2-7ca2-3d2f-a321-76eb3c17a555",
                        "entry_id": "4a9b4d06-1b9b-3f02-9880-7aaaafbd5ce2",
                        "glosses": [
                            "фам. священник, поп"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1f8e48d3-4a71-35a6-bb11-dba47c684850",
                        "entry_id": "4a9b4d06-1b9b-3f02-9880-7aaaafbd5ce2",
                        "glosses": [
                            "фам. обращение к старшему мужчине"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "959dfdd8-3113-4169-baa0-d1129499498d",
                        "source_entry_id": "4a9b4d06-1b9b-3f02-9880-7aaaafbd5ce2",
                        "target_lang_word": "dad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3cb1e86-b585-38c1-aa4d-a0e6e463ed36",
                                        "entry_id": "56889e93-8b6b-3e62-b8bc-5b347af56f25",
                                        "glosses": [
                                            "A father, a male parent."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc65714d-4669-4e7c-9b01-f767f20d46cc",
                                                "sense_id": "a3cb1e86-b585-38c1-aa4d-a0e6e463ed36",
                                                "text": "His dad was always there for him."
                                            },
                                            {
                                                "example_id": "135f8028-dfca-4568-91b2-f41c64b5739c",
                                                "sense_id": "a3cb1e86-b585-38c1-aa4d-a0e6e463ed36",
                                                "text": "A lot of the power for dads comes in the form of modeling. As much as dads can teach their sons directly and guide them in the world, they also provide an example of who their children can aim to be as they grow up, Singley said.\n“There are going to be the times when as the dad I’m going to screw up,” he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db4189e8-9051-3b2b-b0e9-afc323f2a723",
                                        "entry_id": "56889e93-8b6b-3e62-b8bc-5b347af56f25",
                                        "glosses": [
                                            "Used to address one's father; often capitalized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3235f29e-ec4e-4d37-89d9-7dd67f736a37",
                                                "sense_id": "db4189e8-9051-3b2b-b0e9-afc323f2a723",
                                                "text": "Happy Father's Day, dad!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5949b5fe-495f-375e-beb8-4a5835f10ceb",
                                        "entry_id": "56889e93-8b6b-3e62-b8bc-5b347af56f25",
                                        "glosses": [
                                            "Used to address an older adult male."
                                        ],
