                                    {
                                        "sense_id": "604dae9f-8225-3fc4-af32-dab1b23db717",
                                        "entry_id": "5b029b24-e2f2-3187-b218-e7eaa116b5f9",
                                        "glosses": [
                                            "A long bladed weapon with a grip and typically a pommel and crossguard (together forming a hilt), which is designed to cut, stab, slash and/or hack."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e505a66b-58f1-414c-b058-1eff5a084bec",
                                                "sense_id": "604dae9f-8225-3fc4-af32-dab1b23db717",
                                                "text": "He took out his sword and stabbed the man in the stomach."
                                            },
                                            {
                                                "example_id": "777d7d82-58c9-46a0-8bbb-40e42eba2f65",
                                                "sense_id": "604dae9f-8225-3fc4-af32-dab1b23db717",
                                                "text": "Malicious tunges, though they have no bones,\nAre ſharper then ſwordes, ſturdier then ſtones."
                                            },
                                            {
                                                "example_id": "0ae3ab67-55d0-4e6a-84c1-e968d2ac665f",
                                                "sense_id": "604dae9f-8225-3fc4-af32-dab1b23db717",
                                                "text": "Unsheathe your sword and dub him presently."
                                            },
                                            {
                                                "example_id": "f40cd23e-5857-4da1-b3df-c93b002a3d21",
                                                "sense_id": "604dae9f-8225-3fc4-af32-dab1b23db717",
                                                "text": "Some swords were also made solely to thrust, and some only to cut; others were equally adapted for both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "961dd444-b36b-3869-933d-f5fad31b251d",
                                        "entry_id": "5b029b24-e2f2-3187-b218-e7eaa116b5f9",
                                        "glosses": [
