                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "964e6b14-ff00-4361-9ebb-af2176e248ec",
                                "sense_id": "14fe2178-4450-3037-b2a3-933022e8f7e3",
                                "text": "Ob wohl alle Aristoteliker wie ihr Schulhaupt geglaubt haben, dass Ungeziefer aus bloßem Schmutz entstehe?"
                            }
