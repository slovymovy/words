    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2de4a279-99f6-3f61-91e4-14e14e57c3a4",
                    "sense_definition": "Retirer ou déduire une somme d'argent d'un compte bancaire ou d'un revenu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque va <w>prélever</w> le montant de votre facture directement chaque mois."
                        },
                        {
                            "text": "L'administration a décidé de <w>prélever</w> les taxes à la source dès cette année."
                        }
                    ],
                    "synonyms": [
                        "déduire",
                        "soustraire"
                    ],
                    "antonyms": [
                        "verser",
                        "créditer"
                    ],
                    "common_phrases": [
                        "prélever une somme",
                        "prélever sur le compte"
                    ]
                },
                {
                    "sense_id": "23b08900-be75-390b-9c77-b23db9e3e3d7",
                    "sense_definition": "Recueillir un liquide biologique, un tissu ou un organe à des fins d'analyse ou de greffe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière doit <w>prélever</w> du sang pour effectuer plusieurs analyses médicales importantes."
                        },
                        {
                            "text": "Les médecins ont réussi à <w>prélever</w> un échantillon de peau sans aucune douleur."
                        }
                    ],
                    "synonyms": [
                        "extraire",
                        "recueillir"
                    ],
                    "antonyms": [
                        "injecter",
                        "implanter"
                    ],
                    "common_phrases": [
                        "prélever du sang",
                        "prélever un échantillon",
                        "prélever un organe"
                    ]
                },
                {
                    "sense_id": "5911ffed-da95-3c7f-bbc2-55ecc5e21935",
                    "sense_definition": "Prendre ou détacher une partie d'un ensemble avant d'utiliser le reste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier va <w>prélever</w> un morceau de pâte avant d'enfourner le reste."
                        },
                        {
                            "text": "Il faut <w>prélever</w> un peu de terre du jardin pour vérifier sa qualité."
                        }
                    ],
                    "synonyms": [
                        "retirer",
                        "prendre"
                    ],
                    "antonyms": [
                        "ajouter"
                    ],
                    "common_phrases": [
                        "prélever une partie",
                        "prélever un morceau"
                    ]
                },
                {
                    "sense_id": "b5dd1483-3050-3f99-b0ed-7302181428bb",
                    "sense_definition": "Abattre ou capturer un animal sauvage dans le cadre de la chasse ou de la régulation des espèces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les gardes forestiers peuvent <w>prélever</w> du gibier pour réguler la population locale."
