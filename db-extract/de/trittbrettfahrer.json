                ],
                "senses": [
                    {
                        "sense_id": "89f8e7a3-4118-3409-8126-5a93561ff336",
                        "entry_id": "80f82984-8632-3ae1-afc3-897f94ebd3d2",
                        "glosses": [
                            "Person, die sich außen an einem Zug oder einem ähnlichen Fahrzeug festhält und auf dem Trittbrett stehend mitfährt, weil sie nicht bezahlen will oder innen keinen Platz gefunden hat"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "762cc264-0336-430b-8f98-d7849076bc39",
                                "sense_id": "89f8e7a3-4118-3409-8126-5a93561ff336",
                                "text": "„Wilma war 18. Sie verkaufte Fahrkarten in der Straßenbahn, als eines Tages ihr Bruno als Trittbrettfahrer aufsprang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a8633d8e-43b3-33af-84ea-769fc4ca45d8",
                        "entry_id": "80f82984-8632-3ae1-afc3-897f94ebd3d2",
                        "glosses": [
                            "Person, die ohne Anstrengung an Vorteilen teilhaben will"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "416c96c4-2c70-4181-b354-d7f56151466d",
                                "sense_id": "a8633d8e-43b3-33af-84ea-769fc4ca45d8",
                                "text": "„Bleibt schließlich noch das Problem der Trittbrettfahrer, die sich ohne Versicherung aus Nachlässigkeit in das soziale Netz abgleiten lassen.“"
                            },
                            {
                                "example_id": "12a3f1cc-eca1-4827-a514-a2d35f053fb7",
                                "sense_id": "a8633d8e-43b3-33af-84ea-769fc4ca45d8",
                                "text": "„Als Trittbrettfahrer der Revolution gelingt es der SPD, die sich mit den reaktionären Militärs verbündet, diese Revolution im Keim zu ersticken.“"
                            },
                            {
                                "example_id": "92c1d797-241f-4a47-951d-a3f29d61de93",
                                "sense_id": "a8633d8e-43b3-33af-84ea-769fc4ca45d8",
                                "text": "„In Wirklichkeit betraten die Nationalisten gerade in Rhodesien erst spät die Bühne und waren oft Trittbrettfahrer, die sich bereits existierenden Bewegungen anschlossen, um sie dann für sich zu vereinnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ce024856-3f0b-367e-a35a-a737416c9bf9",
                        "entry_id": "80f82984-8632-3ae1-afc3-897f94ebd3d2",
                        "glosses": [
                            "Person, die Aufmerksamkeit sucht, indem sie beim Begehen von Verbrechen das Muster bekannter Straftaten nachahmt, oder sich zu von ihr nicht begangenen Straftaten bekennt, bei denen nach dem Täter gefahndet wird"
                        ],
                        "tags": [
                            "Kriminologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b83f4e05-2278-46ad-b3f5-2dc0c9f0ad7c",
                                "sense_id": "ce024856-3f0b-367e-a35a-a737416c9bf9",
                                "text": "„Als sie den Trittbrettfahrer in Conyers gefasst haben, dachte ich, das war es.“"
                            },
                            {
                                "example_id": "fc7a8e33-a812-4fe3-a7a6-1fa9139c4e14",
                                "sense_id": "ce024856-3f0b-367e-a35a-a737416c9bf9",
                                "text": "„›Genau das ist unsere Befürchtung. Außerdem könnten wir damit Trittbrettfahrer auf den Plan rufen.‹“"
                            },
                            {
                                "example_id": "48c05d96-64ec-4d12-9237-f1053d3b8b2f",
                                "sense_id": "ce024856-3f0b-367e-a35a-a737416c9bf9",
                                "text": "„›Wenn wir die Orte beseitigen, die Joe aufgesucht hat, dann sind wir auch den Tourismus los, der damit einhergeht. Dann sind wir die Trittbrettfahrer los.‹“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
