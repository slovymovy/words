                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19669e98-f4bb-4bf6-bee2-7b2cb5e4667e",
                        "entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "perfides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                        "entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                        "glosses": [
                            "Qui est déloyal, qui manque à sa foi, à sa parole, ou à la confiance qu’on a mise en lui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bf5176-391d-4f3a-a72d-2c8ba6f3d592",
                                "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                                "text": "Un homme perfide."
                            },
                            {
                                "example_id": "3ea7f281-ed14-4c6d-97b2-da507a1029dd",
                                "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                                "text": "Une nation perfide."
                            },
                            {
                                "example_id": "a19bbeb2-07cb-410e-a63f-af6ea6e5292d",
                                "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                                "text": "Amant perfide."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f1f3289-492f-32d0-821b-5a7e2d3d0214",
                        "entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                        "glosses": [
                            "Sans foi, incrédule, dissident, hérétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec0b7d83-a9e5-4052-9b6b-fb30d989924a",
                                "sense_id": "2f1f3289-492f-32d0-821b-5a7e2d3d0214",
                                "text": "L’Angleterre, ah, la perfide Angleterre, que le rempart de ses mers rendait inaccessible aux Romains, la foi du Sauveur y est abordée."
                            },
                            {
                                "example_id": "646fce76-efff-49d3-8423-0c1c5b5103d8",
                                "sense_id": "2f1f3289-492f-32d0-821b-5a7e2d3d0214",
                                "text": "Le roi et la reine d’Angleterre sont bien mieux à Saint-Germain que dans leur perfide royaume."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                        "entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                        "glosses": [
                            "Choses où il y a de la perfidie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e13dddd2-6dcb-4614-a6a3-461f05f05116",
                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                "text": "Une araignée tisse sa toile auprès de moi, sa toile au fil de brume, couleur de rêve et couleur d’eau.\nCette dentelle souple en roue blanche qui luit, c’est un piège perfide où la mort se balance."
                            },
                            {
                                "example_id": "8e4d9874-ca04-4517-abf8-38e747263c30",
                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                "text": "Connaissant de l’intérieur ce milieu souvent perfide, je comprends leurs craintes."
                            },
                            {
                                "example_id": "43fd3f19-4e32-4a6c-8f97-9ec46ef012df",
                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                "text": "Il lui a fait un tour bien perfide."
                            },
                            {
                                "example_id": "cc6f297d-9454-4b18-9d2a-cd3223c8f35d",
                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                "text": "Voilà une action bien perfide."
                            },
                            {
                                "example_id": "cf34c8ed-d4e7-4785-b641-acc19b90e9dc",
                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                "text": "Après tant de perfides serments."
                            },
                            {
                                "example_id": "899371a1-b416-489a-bc06-76da9c863b19",
                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                "text": "Des caresses, des louanges perfides."
                            },
                            {
                                "example_id": "15865392-1a14-4a5c-a583-85405df7ae0c",
                                "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                                "text": "Un sourire perfide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc3cb7a1-b973-4951-9ee4-e2e4692a37d2",
                        "source_entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                        "target_lang_word": "perfidious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfidious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d0cb8ab-fc8c-3737-b7fe-9a7b17285082",
                                        "entry_id": "e49e6b2d-33d0-32bd-bb29-6207ea209e73",
                                        "glosses": [
                                            "Of, pertaining to, or representing perfidy; disloyal to what should command one's fidelity or allegiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db0d64b-d6ad-4b70-8bb4-7a86bab208bb",
                                                "sense_id": "6d0cb8ab-fc8c-3737-b7fe-9a7b17285082",
                                                "text": "TRINCULO (speaking about Caliban): By this light, a most perfidious and drunken / monster: when his god's asleep, he'll rob his bottle."
                                            },
                                            {
                                                "example_id": "165f423d-5c3e-4caa-9e56-4f82d783c09b",
                                                "sense_id": "6d0cb8ab-fc8c-3737-b7fe-9a7b17285082",
                                                "text": "The perfidious Ricimer soon became dissatisfied with Anthe'mius, and raised the standard of revolt."
                                            },
                                            {
                                                "example_id": "2be0e269-9f36-4b82-b0d8-46da2ed4f4a8",
                                                "sense_id": "6d0cb8ab-fc8c-3737-b7fe-9a7b17285082",
                                                "text": "[S]he knew Huntly for the ambitious traitor he was, a man peculiarly perfidious and self-seeking."
                                            },
                                            {
                                                "example_id": "df3f6acc-1409-4643-97de-67f210284c84",
                                                "sense_id": "6d0cb8ab-fc8c-3737-b7fe-9a7b17285082",
                                                "text": "When the Nazis branded Feininger a \"degenerate artist\" in 1937, he left 54 paintings for safekeeping with a Bauhaus friend named Hermann Klumpp. After the war, and for the rest of Feininger's life, the perfidious Klumpp refused to give them back."
                                            },
                                            {
                                                "example_id": "acb70151-805a-41ce-91ae-ebfb57d96d11",
                                                "sense_id": "6d0cb8ab-fc8c-3737-b7fe-9a7b17285082",
                                                "text": "Enraged, the 2010 Nobel literature laureate thundered that he was “flabbergasted to learn that this kind of gossip can find its way into a respectable publication such as the Book Review” - a “slanderous and perfidious” instance of the convergence of posh and pop that his book inveighs against."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b6fa980-f414-4bd6-888f-02a735467ae5",
                        "source_entry_id": "a078bbe5-5019-3a76-9a58-27846f73f1d4",
                        "target_lang_word": "treacherous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treacherous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf3ed98-3e79-3fe3-b818-012e3aeedb84",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Exhibiting treachery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14bff02a-5054-4091-b7b5-4a1bc8e0cb78",
                                                "sense_id": "9cf3ed98-3e79-3fe3-b818-012e3aeedb84",
                                                "text": "I see the wife misused by her husband, I see the treacherous seducer of young women, / I mark the ranklings of jealousy and unrequited love attempted to be hid […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d7078-2940-3be0-a69a-5f9a1ff7cce5",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Deceitful; inclined to betray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Unreliable; dangerous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46e4ff0-53cc-4afa-9c3b-67d98f4acbfb",
                                                "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                                "text": "a treacherous mountain trail"
                                            },
                                            {
                                                "example_id": "9753a164-d60b-49ad-aa95-00b326142e3c",
                                                "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                                "text": "[…] they stood in the region of perpetual snow, amidst the glittering, treacherous glaciers and crevasses, with vast slippery-pathed precipices yawning round."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
