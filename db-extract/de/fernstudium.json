                ],
                "senses": [
                    {
                        "sense_id": "1c933f47-b70f-31a0-a490-c812b6ba35b1",
                        "entry_id": "2ef94c60-67b9-36be-83c7-9d80e0a885c5",
                        "glosses": [
                            "ein Studium, bei dem ein Großteil des Lehrstoffes über Studienbriefe oder heute auch über Online-Kurse von den Studenten erarbeitet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096472e5-a257-45dc-b97b-66303a65fda1",
                                "sense_id": "1c933f47-b70f-31a0-a490-c812b6ba35b1",
                                "text": "„Ein anderes System, in dem Nähe und Distanz kombiniert sind, stellt das Fernstudium dar, das in Deutschland an der Gesamthochschule Hagen angeboten und in England von der sog. „Open University“ praktiziert wird, die nach der sechsstelligen Zahl der eingeschriebenen Studenten die größte Universität der Welt ist.“"
                            },
                            {
                                "example_id": "0804b761-acee-4de3-9cf7-0a9386146c84",
                                "sense_id": "1c933f47-b70f-31a0-a490-c812b6ba35b1",
                                "text": "„Noch als Präsident Simbabwes gab er dem Personal seiner Residenz Stunden und versuchte sogar, seinen Gärtner zum Fernstudium zu überreden.“"
                            },
                            {
                                "example_id": "a146a7e3-7862-4d3b-8016-c7dfe398388f",
                                "sense_id": "1c933f47-b70f-31a0-a490-c812b6ba35b1",
                                "text": "„Sie hatte sich im Herbst an der Privatuni Bifröst für BWL im Fernstudium eingeschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
