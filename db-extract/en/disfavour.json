                                                "sense_id": "76a7f61f-bd5e-3573-ba5a-d3445d90d278",
                                                "text": "Diesmal verlor er aufgrund der Ungunst des Wetters."
                                            },
                                            {
                                                "example_id": "bbb245d5-f757-4123-9f95-20242fcf9cef",
                                                "sense_id": "76a7f61f-bd5e-3573-ba5a-d3445d90d278",
                                                "text": "Die Entscheidung fiel zu seinen Ungunsten."
