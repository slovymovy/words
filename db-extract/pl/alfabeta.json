                "senses": [
                    {
                        "sense_id": "0b27c1a9-e410-3c22-aab3-76b21a047afa",
                        "entry_id": "045edde0-3569-313e-ba30-6bc0677d80d1",
                        "glosses": [
                            "człowiek prawie niepiśmienny, znający tylko alfabet"
                        ],
                        "tags": [
                            "dated",
                            "humorous",
