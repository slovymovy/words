                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44219b55-6cbb-4452-b771-efe6b6eec828",
                                "sense_id": "6cd575c2-293c-3998-a7de-60557d2f7cb0",
                                "text": "Die Chinesen sind ein Nachbarvolk der Russen."
                            },
                            {
                                "example_id": "6e17d81b-822c-4c27-ad74-934442055442",
                                "sense_id": "6cd575c2-293c-3998-a7de-60557d2f7cb0",
                                "text": "„Da kommt wohl Uraltes und immer Neues zwischen zwei Nachbarvölkern zum Vorschein, die derzeit doch als Waffengefährten, als brüderlich Verbündete gelten.“"
                            }
