                ],
                "senses": [
                    {
                        "sense_id": "c45ed32b-37bb-3a3b-b64c-2dace1708348",
                        "entry_id": "d022dc47-add2-3e71-b495-e1dddfc0cc06",
                        "glosses": [
                            "vorbeugende Sicherheitsmaßnahme, die den Blitzeinschlag oder dessen Auswirkungen begrenzt und geschützt in die Erde ableitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d3ec4f-5425-4523-8f32-f6a49e30d3c9",
                                "sense_id": "c45ed32b-37bb-3a3b-b64c-2dace1708348",
                                "text": "„Alle Maßnahmen zum gefahrlosen Ableiten von Blitzströmen und deren Ableitung zur Erde werden als Blitzschutz bezeichnet.“"
                            },
                            {
                                "example_id": "93dc8d70-7996-45d3-a95c-70f0884e7540",
                                "sense_id": "c45ed32b-37bb-3a3b-b64c-2dace1708348",
                                "text": "„Der äußere Blitzschutz sorgt dafür, dass der Blitzstrom, im Falle eines Einschlages, gefahrlos zur Erde abgeleitet wird. Ein Brandschaden wird damit verhindert.“"
                            },
                            {
                                "example_id": "853535c6-a596-4e02-be27-e1adb9d8a94e",
                                "sense_id": "c45ed32b-37bb-3a3b-b64c-2dace1708348",
                                "text": "„Der innere Blitzschutz hingegen schützt elektrische Anlagen gegen mögliche Überspannungen als Auswirkung eines Blitzeinschlages in das Gebäude oder im Wirkbereich des Spannungstrichters in der unmittelbaren Umgebung des Einschlages.“"
                            },
                            {
                                "example_id": "573434d6-0b7f-4fe0-a1e4-9f9e5890afd9",
                                "sense_id": "c45ed32b-37bb-3a3b-b64c-2dace1708348",
                                "text": "„Die rechtlichen und normativen Anforderungen an den Blitzschutz sind mittlerweile komplex und für den Anlagenbetreiber kaum zu überblicken.“"
                            },
                            {
                                "example_id": "6f13ff3d-ebe8-40f4-9de0-3b686f54f225",
                                "sense_id": "c45ed32b-37bb-3a3b-b64c-2dace1708348",
                                "text": "„Die Anforderung und Ausführung für den Blitzschutz ergeben sich aus DIN EN 62305-3(VDE 0185-305-3) (Blitzschutz – Teil 3: Schutz von baulichen Anlagen und Personen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
