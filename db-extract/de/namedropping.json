                "senses": [
                    {
                        "sense_id": "dec0ef33-cc54-367f-823a-252354d47465",
                        "entry_id": "5ab17e1d-0298-3ba3-adf6-c800126d95fb",
                        "glosses": [
                            "scheinbar beiläufige namentliche Nennung bekannter oder einflussreicher Persönlichkeiten, die man kennt oder zu kennen vorgibt, um Eindruck zu erwecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1590862b-a9d6-467a-8883-6a9324660a7c",
                                "sense_id": "dec0ef33-cc54-367f-823a-252354d47465",
                                "text": "Wenn die Autorin es auch nicht offen ausspricht, so ist trotzdem ein gewisser Stolz auf die Zugehörigkeit der Familie von Einem zur »großen Welt«, d. h. auch auf die Teilnahme an der Welt des Adels, spürbar, wie das Namedropping zeigt."
                            },
                            {
                                "example_id": "25b4b8e3-5d6f-4c37-aa8c-853dee7d1840",
                                "sense_id": "dec0ef33-cc54-367f-823a-252354d47465",
                                "text": "„Er ist sichtbar stolz auf sie, zeigt sie in ausführlichen Kommentaren und beiläufigem Namedropping, aber man sollte sich hüten, es bloße Angeberei zu nennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
