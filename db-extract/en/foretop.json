                        "entry_id": "ea19bd0a-9165-3a74-b8f3-6dc79cd1fba3",
                        "glosses": [
                            "The front seat at the top of a horse-drawn vehicle."
                        ],
                        "tags": [],
                        "examples": []
                    }
