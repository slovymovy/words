                                        ],
                                        "tags": [
                                            "Chenopodium"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5d4cfc6-1641-43b9-aa2a-c4844be0845a",
                                                "sense_id": "3c5f3ed5-8a25-3187-8526-c04c72de4f4d",
                                                "text": "Der Gänsefuß war eine der ersten Kulturpflanzen der Steinzeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "999c375d-9d69-3f82-9618-0ba39079c422",
                                        "entry_id": "dc4b2a0c-cfac-3d81-9741-923d24b82bff",
                                        "glosses": [
                                            "Fuß der Gans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e7b7db9-cc7d-4176-90fe-f8e310dba414",
                                                "sense_id": "999c375d-9d69-3f82-9618-0ba39079c422",
                                                "text": "Auf dem Wege lag ein abgeschossener Gänsefuß."
                                            },
                                            {
                                                "example_id": "07607db9-0dee-4a0e-ac37-156c6293e9d6",
                                                "sense_id": "999c375d-9d69-3f82-9618-0ba39079c422",
                                                "text": "„Guillemets sehen im Gegensatz zu Gänsefüßchen wie Gänsefüße aus und sind nach einem gewissen Guillaume benannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34f01493-4aba-3f33-9ad6-b13f1cf92484",
                                        "entry_id": "dc4b2a0c-cfac-3d81-9741-923d24b82bff",
                                        "glosses": [
                                            "Anführungszeichen, Ausführungszeichen"
                                        ],
                                        "tags": [
                                            "Typografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024cffbf-96eb-4c9c-9a23-9fbeb31b3671",
                                                "sense_id": "34f01493-4aba-3f33-9ad6-b13f1cf92484",
                                                "text": "Dieses Wort sollte man in Gänsefüße setzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "35819f51-c96e-3770-84a9-07f711d9ff1d",
                                        "entry_id": "dc4b2a0c-cfac-3d81-9741-923d24b82bff",
                                        "glosses": [
                                            "Sehnenstruktur am Unterschenkel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09596c07-a0b9-48b9-b43c-2a7f01873516",
                                                "sense_id": "35819f51-c96e-3770-84a9-07f711d9ff1d",
                                                "text": "„Die Sehnen der Mm. semitendinosus, gracilis und sartorius bilden den sog. Gänsefuß (Pes anserinus).“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0b28137-2a9b-4f7d-960d-36f870a7f31d",
                        "source_entry_id": "b8e2410e-73d7-3999-aae4-67aff6da8d22",
