                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46a1e7ab-770d-3ee0-b00f-764450688f5b",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "Someone who guides, especially someone hired to show people around a place or an institution and offer information and explanation, or to lead them through dangerous terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418fae44-bba3-44c7-8875-7144578ba8ae",
                                                "sense_id": "46a1e7ab-770d-3ee0-b00f-764450688f5b",
                                                "text": "The guide led us around the museum and explained the exhibits."
                                            },
                                            {
                                                "example_id": "4a4fa1a5-680b-44f4-b36a-136c6ebe718c",
                                                "sense_id": "46a1e7ab-770d-3ee0-b00f-764450688f5b",
                                                "text": "He will be our guide, even unto death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dec958bf-2777-37fa-b735-15cd5539a01d",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A document or book that offers information or instruction; guidebook."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f46bc88-8bad-3c98-8a25-e7950839518f",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A sign that guides people; guidepost."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbc77501-d6b1-31fd-a493-90c9bdd4e307",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "Any marking or object that catches the eye to provide quick reference."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e213c58d-424d-3573-9602-f15732295e8a",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "Synonym of legend, a key to symbols, abbreviations, and terms on a map, chart, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85011234-a5cf-33d0-985e-ffb2a1ff6e4c",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A device that guides part of a machine, or guides motion or action.",
                                            "A blade or channel for directing the flow of water to the buckets in a water wheel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e1945f2-20cf-354d-8b0c-ef77f25f7869",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A device that guides part of a machine, or guides motion or action.",
                                            "A grooved director for a probe or knife in surgery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c8cac9c-2cc9-3b78-995a-d0cb5a72d2ff",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A device that guides part of a machine, or guides motion or action.",
                                            "A strip or device to direct the compositor's eye to the line of copy being set."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ac3e6d5-63e6-3fa8-bc34-9fbd0cf2ae48",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A spirit believed to speak through a medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b888f9b0-43e0-4096-8585-479b2ee94fc0",
                                                "sense_id": "5ac3e6d5-63e6-3fa8-bc34-9fbd0cf2ae48",
                                                "text": "The familiars of the magicians, on the other hand, were not in all cases evil, and often may have approximated the \"guides\" with whom present-day spiritualists are well acquainted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "393556f8-652a-37fc-981a-b50625bf6476",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A member of a group marching in formation who sets the pattern of movement or alignment for the rest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "guide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc86df04-0fe0-3344-b7a5-973dd77136a1",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To serve as a guide for someone or something; to lead or direct in a way; to conduct in a course or path."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbbfbb40-b7a5-4eb7-aec3-1ae06e12f15b",
                                                "sense_id": "fc86df04-0fe0-3344-b7a5-973dd77136a1",
                                                "text": "And that you'd guide me to your Soueraignes Court,"
                                            },
                                            {
                                                "example_id": "a1b34137-fc1a-44c0-8cf4-2c29ddc9ce9f",
                                                "sense_id": "fc86df04-0fe0-3344-b7a5-973dd77136a1",
                                                "text": "Kolyat: I brought a prayer book, Commander. Would you care to join me?\nKolyat: Kalahira, this one's heart is pure, but beset by wickedness and contention.\nShepard: Guide this one to where the traveler never tires, the lover never leaves, the hungry never starve.\nShepard: Guide this one, Kalahira, and she will be a companion to you as she was to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d4dadf-78a3-3351-8427-512963a1fd3a",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To steer or navigate, especially a ship or as a pilot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4ba5a65-c52a-36c3-abdb-2eb05ac9ae60",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To exert control or influence over someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5dd9a44-353e-4460-975a-00eb6878b2b5",
                                                "sense_id": "d4ba5a65-c52a-36c3-abdb-2eb05ac9ae60",
                                                "text": "A good man sheweth fauour and lendeth: he will guide his affaires with discretion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2dee0c-49ee-3214-83df-35d19a440641",
                                        "entry_id": "2f4ef5e2-f3e2-3a22-8981-1ac726c6313f",
                                        "glosses": [
                                            "To supervise the education or training of someone."
                                        ],
                                        "tags": [],
