                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bad165a-e5cd-4579-88ee-7dc46119d717",
                                "sense_id": "b635f832-3cea-375a-9297-5dcd862bb11e",
                                "text": "L’archevêque de Tours a pour suffragants les évêques d’Angers, du Mans, de Nantes, etc."
                            },
                            {
                                "example_id": "9ebe96c5-e043-4f85-8f3c-0f845dcee5ad",
                                "sense_id": "b635f832-3cea-375a-9297-5dcd862bb11e",
                                "text": "Appeler du suffragant au métropolitain."
                            }
                        ]
                    }
