                "senses": [
                    {
                        "sense_id": "b24aedda-2234-3bf4-8fdf-6093c12b8478",
                        "entry_id": "965976a3-7edf-3d82-a47f-8700a267d89d",
                        "glosses": [
                            "zeitlich beschränkter Urlaub in der Heimat, der Frontsoldaten gewährt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299a693b-7cc5-4fe6-99fd-ca1c3b3401c9",
                                "sense_id": "b24aedda-2234-3bf4-8fdf-6093c12b8478",
                                "text": "Wegen der kritischen Situation an der Front wurde kein Heimaturlaub gewährt."
                            },
                            {
                                "example_id": "52c48e6b-fddb-4895-9dd1-227cbd5a6033",
                                "sense_id": "b24aedda-2234-3bf4-8fdf-6093c12b8478",
                                "text": "„Der 14 Tage währende Heimaturlaub war genau wie mein erster viel zu rasch zu Ende gegangen.“"
                            },
                            {
                                "example_id": "1cd022a1-2b38-433a-a3e3-1cf1ca65d134",
                                "sense_id": "b24aedda-2234-3bf4-8fdf-6093c12b8478",
                                "text": "„Die meisten Kinder sahen ihre Soldatenväter nur auf Heimaturlaub.“"
                            },
                            {
                                "example_id": "b939a7d4-8fb4-4414-b00b-5ce932d534b2",
                                "sense_id": "b24aedda-2234-3bf4-8fdf-6093c12b8478",
                                "text": "„Zu der Zeit war ich praktisch ein Kind, aber ich weiß noch, als er auf Heimaturlaub nach Hause kam und so, lag er praktisch die ganze Zeit auf dem Bett.“"
                            },
                            {
                                "example_id": "f9e56f3f-7504-4b26-b6c8-bef0a56cc8f5",
                                "sense_id": "b24aedda-2234-3bf4-8fdf-6093c12b8478",
                                "text": "„Während seiner kurzen Heimaturlaube hatte Onkel August nur wenig Zeit für den kleinen Alfred.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
