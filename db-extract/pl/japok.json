                                            {
                                                "example_id": "4fdca906-9b79-415f-bf6e-602df89b74ed",
                                                "sense_id": "b1353f0e-ec43-3e04-acf9-60bb067a5856",
                                                "text": "Le yapok, ou loutre marsupiale, (Chironectes minimus Zimmermann, 1780), est un très bon nageur qui se nourrit de crabes, de poissons et de grenouilles."
                                            }
