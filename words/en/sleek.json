                                "target_lang_word": "精致",
                                "target_lang_sense_clarification": "指外观或设计"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7e78214-6ded-3472-992c-6c5fcf2ed9aa",
                    "sense_definition": "having an even, smooth, and often shiny surface",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat's fur was <w>sleek</w> and soft after she finished cleaning herself.",
                            "target_lang_translations": {
                                "ru": "Шерсть кошки стала <w>гладкой</w> и мягкой после того, как она умылась.",
                                "zh": "猫咪清理完自己后，毛发变得<w>油亮</w>而柔软。"
                            }
                        },
                        {
                            "text": "He used a special serum to keep his <w>sleek</w> hair looking perfect all day.",
                            "target_lang_translations": {
                                "ru": "Он использовал специальную сыворотку, чтобы его <w>гладкие</w> волосы выглядели идеально весь день.",
                                "zh": "他用了一种特殊的精华液，让他的<w>光滑</w>秀发整天看起来都很完美。"
                            }
                        }
