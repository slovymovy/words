                "senses": [
                    {
                        "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                        "entry_id": "87ba1924-36c8-3ec0-9016-de1f52ab8be2",
                        "glosses": [
                            "Großunternehmen, das Erdöl fördert, verarbeitet und mit Erdöl und Erdölprodukten handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46bfa25c-281d-49f7-9bb1-32f5803f6b15",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "„Internationale Erdölkonzerne suchen seit Jahren im Mittelmeer nach Erdöl.“"
                            },
                            {
                                "example_id": "681d41c3-887a-4b4b-9606-a349cf8688a2",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "„Der Krieg in der Ukraine beschert Rohstoff- und Erdölkonzernen Rekordgewinne.“"
                            },
                            {
                                "example_id": "504490a7-c067-4ea1-9210-c8d997c827e4",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "[Klimawandelleugnung:] „Die Erdölkonzerne hatten ein furchtbar leichtes Spiel mit der Öffentlichkeit. Die Wissenschaft leistet wenig Widerstand, denn weder lobbyieren Wissenschaftler, noch gehen sie auf „Argumente“ ein, für die es keine wissenschaftliche Grundlage gibt.“"
                            },
                            {
                                "example_id": "eaae4a8c-7679-4187-9d14-59b974e84c12",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "[Klimakrise:] „Wo sind die Stimmen, die fordern, dass die Erdölkonzerne so etwas wie Reparationen zahlen?“"
                            },
                            {
                                "example_id": "700d9029-6f5b-4a1b-82d8-9980997bca58",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "„Vier Jahre nach dem tödlichen Giftmülltransport in die Elfenbeinküste ist in den Niederlanden der Erdölkonzern Trafigura zu einer Geldstrafe in Höhe von einer Million Euro verurteilt worden.“"
                            },
                            {
                                "example_id": "6d2f81fc-32d1-4b83-ae88-c41e678412dd",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "„Im vergangenen Januar zahlte der Erdölkonzern Shell umgerechnet 84 Millionen Franken an die Bewohner eines Dorfes im Nigerdelta – als Entschädigung für Umweltschäden aus der Erdölgewinnung.“"
                            },
                            {
                                "example_id": "75521808-0538-4b99-8e32-0ce18b8f82d6",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "„Ölpest schädigt Natur im Golf von Thailand – Zehntausende Liter Rohöl strömen aus einer Unterwasser-Pipeline im Golf von Thailand. […] Der spanische Erdölkonzern Repsol, der die betroffene Raffinerie La Pampilla betreibt, sprach von rund 10.000 Barrel.“"
                            },
                            {
                                "example_id": "caf0bd35-58f4-4740-b776-6a631ddbda3b",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "[Amin H. Nasser] „ist seit 2015 Präsident und Geschäftsführer (CEO) des staatlichen Erdölkonzern Saudi Aramco.“"
                            },
                            {
                                "example_id": "153e603d-1f11-4a26-ba52-44c1420be865",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "[1999:] Aus der Fusion der beiden amerikanischen Gesellschaften Exxon Corporation und Mobil Corporation zur Exxon Mobil Corporation entstand der damals größte Erdölkonzern der Welt."
                            },
                            {
                                "example_id": "0c01ddcf-7631-4122-a590-d71b3c83eb88",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "„Gulf Oil war ein 1901 gegründeter, global operierender Erdölkonzern, der 1984 mit Chevron fusionierte.“"
                            },
                            {
                                "example_id": "2ddfe0ff-b744-4267-9dbc-fb8a1cc3252b",
                                "sense_id": "b556432b-a2a6-359e-aa55-61ce6b614a6e",
                                "text": "„Der staatliche brasilianische Erdölkonzern Petrobras ist ohne Führung – das gesamte Direktorium ist zurückgetreten. Grund ist ein gigantischer Korruptionsskandal,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
