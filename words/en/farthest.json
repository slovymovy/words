{
    "word_family": [
        "far",
        "further",
        "furthest"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4cac91a8-509a-3691-aa44-82f0b8b9e7b5",
                    "sense_definition": "Superlative form of far; being at the greatest distance, which is an alternative form of <w>furthest</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They traveled to the <w>farthest</w> corner of the globe to find peace.",
                            "target_lang_translations": {
                                "ru": "Они отправились в <w>самый дальний</w> уголок земного шара, чтобы обрести покой."
                            }
                        },
                        {
                            "text": "The <w>farthest</w> point on the map is where the lighthouse stands.",
                            "target_lang_translations": {
                                "ru": "<w>Самая дальняя</w> точка на карте — это место, где стоит маяк."
                            }
                        }
                    ],
                    "synonyms": [
                        "furthest",
                        "most distant",
                        "remotest"
                    ],
                    "antonyms": [
                        "nearest"
                    ],
                    "common_phrases": [
                        "farthest point",
                        "farthest corner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходная степень от «далекий»; находящийся на самом большом расстоянии, альтернативная форма слова «furthest»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самый дальний",
                                "target_lang_sense_clarification": "наиболее удаленный в пространстве"
                            },
                            {
                                "target_lang_word": "самый отдаленный",
                                "target_lang_sense_clarification": "находящийся на значительном удалении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bed390c0-480d-37c1-931c-d90453e37a35",
                    "sense_definition": "To the greatest distance or degree, which is an alternative form of <w>furthest</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Of all the runners, he ran <w>farthest</w> during the marathon.",
                            "target_lang_translations": {
                                "ru": "Из всех бегунов он пробежал <w>дальше всех</w> во время марафона."
                            }
                        },
                        {
                            "text": "The arrow that flew <w>farthest</w> won the competition.",
                            "target_lang_translations": {
                                "ru": "Стрела, которая улетела <w>дальше всех</w>, выиграла соревнование."
                            }
                        }
                    ],
                    "synonyms": [
                        "furthest"
                    ],
                    "antonyms": [
                        "nearest"
                    ],
                    "common_phrases": [
                        "flew farthest",
                        "ran farthest"
                    ],
                    "target_lang_definitions": {
                        "ru": "На самое большое расстояние или в наибольшей степени, альтернативная форма слова «furthest»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дальше всех",
                                "target_lang_sense_clarification": "на наибольшее расстояние"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}