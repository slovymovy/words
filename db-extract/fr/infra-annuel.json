                "senses": [
                    {
                        "sense_id": "b93ed337-21b0-384c-bb74-a21909b0ee09",
                        "entry_id": "1c4457ec-cc18-3e3d-81e2-aebde429363f",
                        "glosses": [
                            "Qui concerne les dates incluses dans une année de référence, et non les dates de début ou de fin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72fc8150-05c1-4add-960a-629aca1dcf0d",
                                "sense_id": "b93ed337-21b0-384c-bb74-a21909b0ee09",
                                "text": "Cette résiliation infra-annuelle (parce qu’elle intervient en cours d’année et non à chaque échéance annuelle), intéresse toutes sortes d’assurances, individuelles et collectives : les assurances automobiles, les multirisques habitation et les assurances affinitaires (constituant le complément d’un bien ou d'un service. – C. assur., art. R. 113-11, nᵒ 1, nᵒ 2 et nᵒ 3)."
                            },
                            {
                                "example_id": "ec4496a0-f11c-4d21-844b-5d84ee4010d9",
                                "sense_id": "b93ed337-21b0-384c-bb74-a21909b0ee09",
                                "text": "Ces besoins infra-annuels sont assurés par des outils financiers spécifiques, les lignes de trésorerie."
                            },
                            {
                                "example_id": "c5071815-1b16-43b8-a25f-3261e075e8fa",
                                "sense_id": "b93ed337-21b0-384c-bb74-a21909b0ee09",
                                "text": "On peut cependant construire des balances infra-annuelles, par exemple des balances mensuelles désaisonnalisées, ou pluriannuelles pour tenir compte de la possibilité de compensation cyclique de déséquilibres annuels."
                            }
                        ]
                    }
