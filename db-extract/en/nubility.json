                "senses": [
                    {
                        "sense_id": "d8eeab66-f81f-34ba-a492-76ddb7aa7656",
                        "entry_id": "6d377465-0737-3cba-906c-c93c26ae62bb",
                        "glosses": [
                            "The property or state of being nubile"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "88caeade-77a6-4261-bb86-a251b7723266",
                                "sense_id": "d8eeab66-f81f-34ba-a492-76ddb7aa7656",
                                "text": "It's certainly no disgrace to have been ripped off by a pretty-faced hustler--who among us has not mistaken nubility for genius?"
                            },
                            {
                                "example_id": "e8fe7edc-14b2-42f4-9c0c-f1371a691f9b",
                                "sense_id": "d8eeab66-f81f-34ba-a492-76ddb7aa7656",
                                "text": "In France, more than half the women who have reached the age of nubility are married; in Ireland, generally speaking, less than a third."
                            },
                            {
                                "example_id": "8ed97782-5f63-409b-95cc-159295be9721",
                                "sense_id": "d8eeab66-f81f-34ba-a492-76ddb7aa7656",
                                "text": "Among the northern clans of the Thonga tribe, in South-Eastern Africa, about Delagoa Bay, when a girl thinks that the time of her nubility is near, she chooses an adoptive mother, perhaps in a neighbouring village."
                            },
                            {
                                "example_id": "429cdcff-542b-49d6-8a89-7402ebbfb71f",
                                "sense_id": "d8eeab66-f81f-34ba-a492-76ddb7aa7656",
                                "text": "Among most modern nations, the civil laws fixing the earliest date of marriage seem to have been made without any reference to physiology, or with the mistaken notion that puberty and nubility are identical."
                            }
                        ]
                    }
                ],
