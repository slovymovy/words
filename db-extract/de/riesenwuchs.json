                "translations": [
                    {
                        "translation_id": "74773f56-62cd-4240-adbf-1119ff22ae9d",
                        "source_entry_id": "caa7020f-e7e7-3c5a-bc82-88d022d56774",
                        "source_sense_id": "23aba3ed-b179-3a47-9925-6a63ede20b6c",
                        "source_sense_description": "abnormal ausgeprägter Wuchs",
                        "target_lang_word": "gigantism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gigantism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ee3ed0-7537-32b5-b0b7-c3ee6cce5f70",
                                        "entry_id": "289f53ae-010a-3070-ba1e-99aeca03c415",
                                        "glosses": [
                                            "The quality or state of being gigantic; being of abnormally large size."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a26548dc-4dff-370e-b4bb-a8cfee772eea",
                                        "entry_id": "289f53ae-010a-3070-ba1e-99aeca03c415",
                                        "glosses": [
                                            "A condition where there is over-production of growth hormone by the pituitary gland in a child before the bone growth plates close, resulting in excessive long bone growth, accompanied by muscular weakness and sexual impotence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9113bd9c-7341-4be7-8b08-2f73929819c5",
                                                "sense_id": "a26548dc-4dff-370e-b4bb-a8cfee772eea",
                                                "text": "He [...] may have had a condition called gigantism that explained his notable height."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8c0d294-61c5-4210-8ba1-d57fbbd8fe6d",
                        "source_entry_id": "caa7020f-e7e7-3c5a-bc82-88d022d56774",
                        "source_sense_id": "23aba3ed-b179-3a47-9925-6a63ede20b6c",
                        "source_sense_description": "abnormal ausgeprägter Wuchs",
                        "target_lang_word": "gigantisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gigantisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fdc1308-2cc6-3a61-a8c9-09577630d385",
                                        "entry_id": "061ee122-a447-3b8f-afbc-00fe012c3761",
                                        "glosses": [
                                            "Exagération du développement de certaines parties du corps humain ou du corps en général, dans le sens de la hauteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7786b0c3-1915-4501-8789-559851b05728",
                                                "sense_id": "1fdc1308-2cc6-3a61-a8c9-09577630d385",
                                                "text": "Né en 1761, Charles Byrne était atteint de gigantisme, en raison d’une tumeur bénigne de l’hypophyse non diagnostiquée."
                                            },
                                            {
                                                "example_id": "9cf1f79d-ff88-4a5e-8303-de5a3d34114a",
                                                "sense_id": "1fdc1308-2cc6-3a61-a8c9-09577630d385",
                                                "text": "Dans l’acromégalie, comme d’ailleurs dans le gigantisme, maladie qui a tant de points communs avec elle, le trouble de la nutrition qui fait les déformations squelettiques serait le phénomène primitif; la tumeur de l’hypophyse est secondaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8807b20-f34e-32f5-9e8b-e7b4092c276f",
                                        "entry_id": "061ee122-a447-3b8f-afbc-00fe012c3761",
                                        "glosses": [
                                            "Énormité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b854803-2f34-4ce5-ba5d-89a7e7094a82",
                                                "sense_id": "b8807b20-f34e-32f5-9e8b-e7b4092c276f",
                                                "text": "Le « Virtuosa » est un vaisseau clinquant, joyeux, coloré, kitch, digne représentant assumé du gigantisme et de tous les superlatifs, devant lequel il est difficile de rester impassible."
                                            },
                                            {
                                                "example_id": "ae2a8ced-6072-4e5c-8227-733bf283cbc8",
                                                "sense_id": "b8807b20-f34e-32f5-9e8b-e7b4092c276f",
                                                "text": "Affectés par leur gigantisme et par des contestations croissantes au sein des démocraties en raison de leurs coûts prohibitifs, les grands événements sportifs sont plus souvent tombés dans le giron des Etats autoritaires ou illibéraux.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
