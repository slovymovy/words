                                "example_id": "8a497528-6dda-42b6-9194-8bf6a870f386",
                                "sense_id": "34e5885d-c8a3-3db5-b867-c570492b077c",
                                "text": "„Mehrfach kam es zu für die Babylonier erfolgreichen Auseinandersetzungen mit ägyptischen Truppen.“"
                            },
                            {
                                "example_id": "8d2eb8c2-7a22-475f-ba3b-349ec950c0c9",
                                "sense_id": "34e5885d-c8a3-3db5-b867-c570492b077c",
                                "text": "„Auch die Gradeinteilung bei Winkeln geht auf die Babylonier zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
