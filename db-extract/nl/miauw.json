                    },
                    {
                        "translation_id": "9bcaf1ae-a8f9-422a-adb3-581990f1cc5a",
                        "source_entry_id": "1df7a4d9-4ef6-32e1-855f-37bebee4be99",
                        "source_sense_id": "5abef28c-26bb-3497-968c-4698d3c863f7",
                        "source_sense_description": "het geluid van een kat",
                        "target_lang_word": "meow",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e0e08cf4-e082-428f-a0cd-5b46e6f35a1d",
                        "source_entry_id": "1df7a4d9-4ef6-32e1-855f-37bebee4be99",
                        "source_sense_id": "5abef28c-26bb-3497-968c-4698d3c863f7",
                        "source_sense_description": "het geluid van een kat",
                        "target_lang_word": "miaou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miaou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecf0df5e-1e3a-3fb0-b100-9cf9c7cc4030",
                                        "entry_id": "58c256cf-e991-3572-adc6-e35db4913f2b",
                                        "glosses": [
                                            "Onomatopée qui exprime le cri du chat ; bruit du miaulement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d233b510-fcc7-471b-a610-610a7c8cb0e9",
                                                "sense_id": "ecf0df5e-1e3a-3fb0-b100-9cf9c7cc4030",
                                                "text": "Il y avait une sorte de supplication touchante et furieuse dans l’accent plaintif et rageur des sempiternels miaou qu’il poussait de seconde en seconde, tantôt s’étirant sur ses pattes comme pour assouplir son corps et pour aiguiser ses griffes, tantôt courbant l’échine à la manière de ces bons apôtres, qui pour obtenir quelque faveur, vous saluent obséquieusement en faisant le gros dos."
                                            },
                                            {
                                                "example_id": "b04c343f-37e2-43d0-9b80-2f488ba572b6",
                                                "sense_id": "ecf0df5e-1e3a-3fb0-b100-9cf9c7cc4030",
                                                "text": "Sans boire ni manger, elle faisait des retraites prolongées sur le haut des murs, immobile pendant des journées entières à la même place, ne répondant à tous nos appels que par des regards attendris et de plaintifs petits « miaou »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "miaou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97f14581-e927-3c47-836b-a09544569e89",
                                        "entry_id": "f6017a25-f871-3568-b43a-071e229ed3b7",
                                        "glosses": [
                                            "Miaulement."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "629e792f-03a4-4328-beea-1c99dbd3396a",
                                                "sense_id": "97f14581-e927-3c47-836b-a09544569e89",
                                                "text": "Le miaou du chat est peut-être le cri dont les nuances assez nombreuses s’accusent avec le plus de netteté, celui dont nous déduisons le plus aisément la sensation qui l’inspire."
                                            },
                                            {
                                                "example_id": "2a5fa449-0d6f-4cc1-b106-d4a3d12174e5",
                                                "sense_id": "97f14581-e927-3c47-836b-a09544569e89",
                                                "text": "Le langage de ce pays semble toujours une suite de consonances incertaines, nasillardes, entrecoupées en monosyllabes un peu haletants, et où revient à courts intervalles quelque chose comme le miaou des chats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cba03175-fa78-3834-b3fe-1a477646bf8b",
                                        "entry_id": "f6017a25-f871-3568-b43a-071e229ed3b7",
                                        "glosses": [
                                            "Chat ou chaton."
                                        ],
                                        "tags": [
                                            "childish",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61c9ec46-e13f-4eb8-949b-ac7226778e2d",
                                                "sense_id": "cba03175-fa78-3834-b3fe-1a477646bf8b",
                                                "text": "Tu as vu le petit miaou ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "551f5dac-d378-3fd1-b4a3-58cc8cce63c1",
                                        "entry_id": "f6017a25-f871-3568-b43a-071e229ed3b7",
                                        "glosses": [
                                            "Repas d’un chat."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f3cab31-4a39-4311-879c-002f58f73065",
                                                "sense_id": "551f5dac-d378-3fd1-b4a3-58cc8cce63c1",
                                                "text": "Pendant qu’elle était à la cave, j’insultai le chat :\n— Imbécile. Elle allait enfin m’apprendre son emploi du temps et il a fallu que monsieur vienne réclamer son miaou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38009ed0-04d4-44b2-a441-a859c991cd30",
                        "source_entry_id": "1df7a4d9-4ef6-32e1-855f-37bebee4be99",
                        "source_sense_id": "5abef28c-26bb-3497-968c-4698d3c863f7",
                        "source_sense_description": "het geluid van een kat",
                        "target_lang_word": "miaulement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miaulement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b916af0a-fdb3-370b-aabd-0ecdf59c603d",
                                        "entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                                        "glosses": [
                                            "Cri du chat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca1bdfe-ffc4-410a-b19b-b8527007005c",
                                                "sense_id": "b916af0a-fdb3-370b-aabd-0ecdf59c603d",
                                                "text": "À quoi pouvait-il s’attendre, si ce n’est […] à voir sa sérénade, comme on l’appelle, aussi mal reçue que le miaulement d’un chat dans la gouttière ?"
                                            },
                                            {
                                                "example_id": "b205f768-947c-4243-b928-dab7ced2964d",
                                                "sense_id": "b916af0a-fdb3-370b-aabd-0ecdf59c603d",
                                                "text": "Soudain, d’un seul élan, cela se précipita sur lui, avec un miaulement plaintif et la queue droite. C’était un jeune chat, menu et décharné, qui frottait sa tête contre les jambes de Bert, en ronronnant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a244ec7-e0af-32a1-88b6-127b9e95a8a5",
                                        "entry_id": "fc8f8687-5e4b-3a87-940c-fe94eace7135",
                                        "glosses": [
                                            "Bruit rappelant ce cri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c0f313-5176-462e-8570-46af2435fee8",
                                                "sense_id": "3a244ec7-e0af-32a1-88b6-127b9e95a8a5",
                                                "text": "[…] la brise apporte les parfums du Généralife, énorme touffe de lauriers-roses épanouie au front de la colline prochaine, et le miaulement plaintif des paons qui se promènent sur les murs démantelés."
                                            },
                                            {
                                                "example_id": "461057b9-84cd-4564-8d28-2e0a27ddb223",
                                                "sense_id": "3a244ec7-e0af-32a1-88b6-127b9e95a8a5",
                                                "text": "Celui-là, il en a de la chance, dit-elle d'un air entendu, et par une suite d'onomatopées qui secouèrent son visage de tics et le rendirent simiesque, elle prétendit reproduire le miaulement de pneus qui venait à peine de s’estomper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
