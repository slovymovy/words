                        "examples": [
                            {
                                "example_id": "0eba28ba-ffb6-48a9-9c15-eba538223f9f",
                                "sense_id": "fcd99d2b-aa2f-3ad5-b55d-09e6bfc2c4d5",
                                "text": "circumspective concern"
                            },
                            {
                                "example_id": "60076dcf-cc7f-4cc6-a901-a34a6e30b73e",
                                "sense_id": "fcd99d2b-aa2f-3ad5-b55d-09e6bfc2c4d5",
                                "text": "The existential meaning of circumspective deliberation, Heidegger argues in Being and Time is making-present (Gegenwärtigung)."
                            },
                            {
                                "example_id": "13394644-8f60-4850-bbb6-df8a0ff36371",
                                "sense_id": "fcd99d2b-aa2f-3ad5-b55d-09e6bfc2c4d5",
                                "text": "Rather it is the unity of the three ecstasies of the temporality that constitutes the circumspective concern in its temporality. In other words, Dasein makes the equipmental system present in his circumspective concern with reference to his future ends, i.e., awaiting future ends, on the basis of the retention from the past."
                            },
                            {
                                "example_id": "9b9827fe-b18e-4bcc-b54e-4336aaaaac48",
                                "sense_id": "fcd99d2b-aa2f-3ad5-b55d-09e6bfc2c4d5",
                                "text": "In the main, this circumspective aspect of morality is a relational affair, principally between the agent and at least two persons or parties other than the agent."
                            }
                        ]
                    }
                ],
