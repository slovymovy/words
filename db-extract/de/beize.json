                                "sense_id": "63aae935-2f08-30db-9161-d7ff365db1ef",
                                "text": "Im vorindustriellen Zeitalter wurden Pflanzenextrakte oder Jauche als Beize verwendet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e96099f0-cba8-36e3-be33-c608b518564f",
                        "entry_id": "96bac7a3-e33e-3144-a3cc-3ea07d916cad",
                        "glosses": [
