                "senses": [
                    {
                        "sense_id": "f7fc754b-4951-3c30-9c1e-dff11f3a5f44",
                        "entry_id": "09b37efa-d8b2-3dd6-884b-59e15d71d8f9",
                        "glosses": [
                            "Insel, auf der es viele Gewürze gibt, die ein Zentrum des Gewürzhandels ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "499832c6-289d-4da5-a9a5-8a6d37ce6dd2",
                                "sense_id": "f7fc754b-4951-3c30-9c1e-dff11f3a5f44",
                                "text": "„Danach war er unter dem Holländer Kees Veerman zu dessen zweiter Reise auf der Suche nach der legendären Nordostpassage nach Kathay und den Gewürzinseln Asiens aufgebrochen, die im Eismeer nördlich des zaristischen Russland gelegen sein sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7cc6933d-77d3-3a36-be49-3f4217a71a8c",
                        "entry_id": "09b37efa-d8b2-3dd6-884b-59e15d71d8f9",
                        "glosses": [
                            "Insel, auf der es viele Gewürze gibt, die ein Zentrum des Gewürzhandels ist",
                            "Beiname der Molukken"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3c13be71-bb17-4207-8b07-e8b2f51f6516",
                                "sense_id": "7cc6933d-77d3-3a36-be49-3f4217a71a8c",
                                "text": "„Noch im Feldlager bei Granada erteilten sie Christoph Kolumbus die Erlaubnis, eine westliche Seeroute nach Ostasien und zu den begehrten Gewürzinseln (Molukken) zu suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
