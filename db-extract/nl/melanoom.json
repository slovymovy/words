                    {
                        "translation_id": "dd87c7c1-04a9-40dd-8ed0-9273e5db3bf9",
                        "source_entry_id": "d09b9d00-f839-306e-a10c-63c9aa303f1d",
                        "source_sense_id": "3c3f74eb-ccb4-3026-b7bc-ac7969973aaa",
                        "target_lang_word": "mélanome",
                        "target_lang_code": "fr",
