                        "source_sense_id": "93200c57-c8bd-3624-b0d5-80ce30fc0a7b",
                        "target_lang_word": "νεονορβηγικά",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "νεονορβηγικά",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "24958007-6ba6-3185-9a43-1c54969882f5",
                                        "entry_id": "74c020bf-c04b-3c7b-b8e5-c0bb77349ad7",
                                        "glosses": [
                                            "(landsmål / nynorsk) αποτελούν τυποποιημένη (και από το 1885 επίσημη) γραπτή διαλεκτική μορφή της Νορβηγικής γλώσσας που δημιουργήθηκε από τον Ivar Aasen στα μέσα του 19ου αιώνα για να αντικαταστήσει την επίσημη νορβηγο-δανέζικη γλώσσα (riksmål / bokmål) που ήταν αποτέλεσμα της κυριαρχίας των Δανών στη Νορβηγία για 400 περίπου χρόνια. Σήμερα, και οι δύο διάλεκτοι απολαμβάνουν καθεστώς επίσημης γλώσσας, ενώ έχουν γίνει και προσπάθειες για την ενοποίησή τους. Η νεονορβηγική μιλιέται περίπου από το 1/4 του πληθυσμού (κυρίως στις δυτικές και κεντρικές περιοχές της Νορβηγίας)."
                                        ],
                                        "tags": [
                                            "γλώσσα"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
