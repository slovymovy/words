                ],
                "translations": [
                    {
                        "translation_id": "804e0cf9-d569-472f-b5ae-b4038a94f6fe",
                        "source_entry_id": "412caa81-5669-32ba-a39c-7e455cbc3fb0",
                        "source_sense_id": "84c9446c-c998-3a5b-902a-d3b79e078aa0",
                        "source_sense_description": "Literatur: Vertreterin des Akmeismus",
                        "target_lang_word": "Acmeist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Acmeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3edda281-4727-3c9f-b49d-22168d7e4c6b",
                                        "entry_id": "4ea4e446-866d-3851-92c6-caaae39818f4",
                                        "glosses": [
                                            "Of or pertaining to Acmeism, a transient poetic school in Russia in the early 1900s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f169ef-2728-405d-8ded-c7aea1b7ab20",
                                                "sense_id": "3edda281-4727-3c9f-b49d-22168d7e4c6b",
                                                "text": "He was Acmeist in spades."
                                            },
                                            {
                                                "example_id": "9f8ea382-8706-4407-a4cf-6ecfcc32dac5",
                                                "sense_id": "3edda281-4727-3c9f-b49d-22168d7e4c6b",
                                                "text": "As such, they reveal a central concern in Acmeist practice, but do not necessarily specify qualities which are uniquely Acmeist."
                                            },
                                            {
                                                "example_id": "34a98912-30e8-4f40-be7d-da6b53d3a338",
                                                "sense_id": "3edda281-4727-3c9f-b49d-22168d7e4c6b",
                                                "text": "The poem is also Acmeist in the speaker’s countering of his previous emotional abandon (“a thousand sorrows”) with his present moderation—a simple declaration of love instead of exhaustion and yearning."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Acmeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49c1be03-b030-32d9-a80e-43b9027fbdc6",
                                        "entry_id": "d05df741-4105-3923-8aa0-a2ae4a213291",
                                        "glosses": [
                                            "An Acmeist poet, a member of the Acmeist school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1be9aa-e9ce-4a44-8827-1f9335109732",
                                                "sense_id": "49c1be03-b030-32d9-a80e-43b9027fbdc6",
                                                "text": "The Russian poet Anna Akhmatova, who died in 1966 at the age of 77, belongs to the latter category. One of the leading poets of her era, she was a member of the Acmeists, a group of poets who sought—unlike the mystical Symbolists who preceded them—to write about the tangible world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
