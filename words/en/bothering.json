                            },
                            {
                                "target_lang_word": "irytujący",
                                "target_lang_sense_clarification": "powodujący zdenerwowanie"
                            },
                            {
                                "target_lang_word": "uciążliwy",
                                "target_lang_sense_clarification": "sprawiający kłopot lub dyskomfort"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "agaçant",
