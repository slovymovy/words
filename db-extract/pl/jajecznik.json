                        "sense_id": "07ed6e92-aab3-355f-ac56-31b550d512ea",
                        "entry_id": "bb40b5cd-14da-3874-bed5-8964a9bca5bc",
                        "glosses": [
                            "tradycyjne ciasto wypiekane na Wielkanoc z żółtek oraz mąki pszennej; omlet"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "10dd3761-8c98-42a1-b5bd-e34f5bb89949",
                                "sense_id": "07ed6e92-aab3-355f-ac56-31b550d512ea",
                                "text": "A w domach zacnych, arystokratycznych o bogatych mieszczańskich tradycjach, w Wielką Sobotę, krzątali się księża, machając kropidłami: święcili po domach jaja pisane, szynki, kiełbasy, jajeczniki, mazurki i placki różnego rodzaju"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "5768631a-a532-3dce-a592-439721871cfa",
                        "entry_id": "bb40b5cd-14da-3874-bed5-8964a9bca5bc",
                        "glosses": [
                            "element zastawy stołowej służący do podawania ugotowanych jaj, w którym to umieszcza się je w okrągłym zagłębieniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b0950f-9d10-4237-b702-86322382a673",
                                "sense_id": "5768631a-a532-3dce-a592-439721871cfa",
                                "text": "Sklepy z ceramiką oferują nam także jajeczniki w różnych kształtach."
                            }
                        ],
