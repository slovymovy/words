        "fr-extract.jsonl": [
            {
                "entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                "word": "attirail",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e83ca13e-17a6-43ee-8449-cb3711192889",
                        "entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                        "tags": [
                            "plural"
                        ],
                        "form": "attirails"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78df0438-ae46-3604-bb0d-28a15b63426d",
                        "entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                        "glosses": [
                            "Ensemble de choses nécessaires pour tel ou tel usage."
                        ],
                        "tags": [
                            "collective"
                        ],
                        "examples": [
                            {
                                "example_id": "e101bc23-4163-445d-91cd-583e2f48e751",
                                "sense_id": "78df0438-ae46-3604-bb0d-28a15b63426d",
                                "text": "On apercevait à chaque pas des pêcheurs à la ligne penchés sur leur bouchon et entourés d’un attirail qui les faisait reconnaître tout de suite pour des amateurs endimanchés échappés de la ville."
                            },
                            {
                                "example_id": "31d8a150-bb7c-495b-9fe7-d532ef39fed0",
                                "sense_id": "78df0438-ae46-3604-bb0d-28a15b63426d",
                                "text": "Tantôt avec les lassets, tantôt à l’aide de la bourraque, il faisait une petite récolte de ces belles crevettes roses (quand elles sont cuites) et qu’on appelle le bouquet; muni de l’attirail que j’ai décrit plus haut, il se livrait à une guerre acharnée contre toute la légion des crabes, pouparts, claquarts et craparagdis, sans compter les célèbres pieuvres, dont il avait un talent particulier pour découvrir les trous sous les rochers, et qui, si horribles qu’elles soient, n’en constituent pas moins une boîte très prisée des tendeurs de cordes, et qu’ils achètent fort bien."
                            },
                            {
                                "example_id": "48d1c18c-131e-45a3-89ac-076f01caaade",
                                "sense_id": "78df0438-ae46-3604-bb0d-28a15b63426d",
                                "text": "Celui qui, deux heures auparavant, eût pénétré dans la chambre de la marquise d'Ancre, l’eût vue assise devant l’attirail compliqué d’une grande coquette."
                            },
                            {
                                "example_id": "2f5fe9f8-3d63-4fd3-b6bb-8c2b04b80cb7",
                                "sense_id": "78df0438-ae46-3604-bb0d-28a15b63426d",
                                "text": "Il enfourcha une bicyclette à laquelle était accroché tout un attirail de peintre et fila vers la gare d’Austerlitz."
                            },
                            {
                                "example_id": "d8175ac8-82eb-4656-b0c7-f5908c5a3119",
                                "sense_id": "78df0438-ae46-3604-bb0d-28a15b63426d",
                                "text": "Originaire de Condé-lès-Herpy dans le Rethélois, le jeune homme de 21 ans cultivait ces plants dans une pièce spécialisée de sa maison et avec tout l’attirail du petit cultivateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "5db64874-60b3-39e7-8acf-96216b91d130",
                        "entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                        "glosses": [
                            "Étalage de choses dont on se fait accompagner."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "19c0e3c5-899a-40e9-a113-ac61a92ab1c9",
                                "sense_id": "5db64874-60b3-39e7-8acf-96216b91d130",
                                "text": "Il traînait un grand attirail après lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2ffaf65-9be7-3125-bc0e-d02edd555e9f",
                        "entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                        "glosses": [
                            "Ensemble d’éléments abstraits inutiles."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e199ce98-ab85-4a5d-a326-6085c4fae9ce",
                                "sense_id": "f2ffaf65-9be7-3125-bc0e-d02edd555e9f",
                                "text": "L’attirail de la majesté royale, de la mort."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e4e21a5-fb04-3494-b717-4f569fbbe6d3",
                        "entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                        "glosses": [
                            "Organes génitaux masculins, c’est-à-dire le pénis et les deux testicules."
                        ],
                        "tags": [
                            "euphemism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e1230694-a5fd-4f9c-874f-058a5fd31bfd",
                                "sense_id": "6e4e21a5-fb04-3494-b717-4f569fbbe6d3",
                                "text": "\"Bon maintenant, j’ai plus qu’à me démerder pour m’en débarrasser\" lui a alors lancé son grand frère dans une colère noire, à deux doigts de sortir son attirail pour lui pisser dessus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82b6e60e-1d76-4bf2-9175-634815598383",
                        "source_entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                        "target_lang_word": "paraphernalia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paraphernalia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14fccfb8-611e-36ea-bbc7-20af05b737fc",
                                        "entry_id": "87f5bdfd-18a4-3800-aa55-43dfc0440646",
                                        "glosses": [
                                            "Miscellaneous items, especially the set of equipment required for a particular activity."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "541daf91-94b9-4700-8e1a-881fb16928a0",
                                                "sense_id": "14fccfb8-611e-36ea-bbc7-20af05b737fc",
                                                "text": "He has an impressive collection of bicycling paraphernalia, but he doesn't ride very often anymore."
                                            },
                                            {
                                                "example_id": "5d03e971-e63c-499f-b95c-b1ec5fae96d6",
                                                "sense_id": "14fccfb8-611e-36ea-bbc7-20af05b737fc",
                                                "text": "Then the boys arrived, with their camping paraphernalia, and in such bubbling good spirits that the girls were infected with them, for they had become rather lonesome of late."
                                            },
                                            {
                                                "example_id": "04f10dd1-bcfc-496c-bcfd-d760ad3dff76",
                                                "sense_id": "14fccfb8-611e-36ea-bbc7-20af05b737fc",
                                                "text": "People such as William James and the Stephensons (with whom he collaborated) may have been the movers and shakers of the early railways, but there was other, less exalted bods who constructed all the paraphernalia - including stations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c71e894c-c5f2-34e5-8b4a-42c797490001",
                                        "entry_id": "87f5bdfd-18a4-3800-aa55-43dfc0440646",
                                        "glosses": [
                                            "Objects that a married woman owns, such as clothing and jewellery, apart from her dowry."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac55967-6214-4267-bb3b-0f3e79213f7b",
                                                "sense_id": "c71e894c-c5f2-34e5-8b4a-42c797490001",
                                                "text": "So she told her what her husband had said and sat with her awhile; but, presently, up came porters, who brought all her clothes and paraphernalia and what not else belonged to her of goods and vessels from her husband’s house and deposited them in that of her mother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2df57010-5e1a-462b-bb34-70fd4e919967",
                        "source_entry_id": "92f3c7ec-61ee-387e-8fc2-3da990774aa4",
                        "target_lang_word": "parafernália",
