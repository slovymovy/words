        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "b0a08c35-7887-3381-9572-38a2ea9a5dd9",
                "word": "kurzum",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31faf962-6e7e-3b1f-8827-18cfa2c679ec",
                        "entry_id": "b0a08c35-7887-3381-9572-38a2ea9a5dd9",
                        "glosses": [
                            "um vorher Gesagtes zusammenzufassen; kurz gesagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbc3cb3-41a7-43b3-a7fb-210508303882",
                                "sense_id": "31faf962-6e7e-3b1f-8827-18cfa2c679ec",
                                "text": "Kurzum: ich fahre jetzt wieder nach Hause."
                            },
                            {
                                "example_id": "47b5161a-0160-43f6-b9f9-d65d656f0118",
                                "sense_id": "31faf962-6e7e-3b1f-8827-18cfa2c679ec",
                                "text": "Alle liefen aufgeschreckt durcheinander und man konnte sein eigenes Wort kaum verstehen, kurzum, Krise!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "011dc54d-3c12-42fb-acff-558c81f20fc3",
                        "source_entry_id": "b0a08c35-7887-3381-9572-38a2ea9a5dd9",
                        "source_sense_id": "31faf962-6e7e-3b1f-8827-18cfa2c679ec",
                        "source_sense_description": "um vorher Gesagtes zusammenzufassen; kurz gesagt",
                        "target_lang_word": "in short",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in short",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3303c85f-3843-34f2-8208-9a45b753d7f4",
                                        "entry_id": "b77ddaf8-790d-39db-a9f3-42ab205ad9a0",
                                        "glosses": [
                                            "As a summary; as a shortened version of what has been told or what would have been told."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faca228d-bf4a-4148-8704-b1a3d15f8372",
                                                "sense_id": "3303c85f-3843-34f2-8208-9a45b753d7f4",
                                                "text": "[H]e told me I did not treat him as if he was my husband, or talk of my children as if I was a mother; and, in short, that I did not deserve to be used as a wife."
                                            },
                                            {
                                                "example_id": "0ba7b1c7-382a-49fc-b035-c629ce79a2a8",
                                                "sense_id": "3303c85f-3843-34f2-8208-9a45b753d7f4",
                                                "text": "Mr Snagsby has dealt in all sorts of blank forms of legal process; in skins and rolls of parchment; in paper—foolscap, brief, draft, brown, white, whitey-brown, and blotting; in stamps; in office-quills, pens, ink, India-rubber, pounce, pins, pencils, sealing-wax, and wafers; in red tape, and green ferret; in pocket-books, almanacs, diaries, and law lists; in string boxes, rulers, inkstands—glass and leaden, penknives, scissors, bodkins, and other small office-cutlery; in short, in articles too numerous to mention."
                                            },
                                            {
                                                "example_id": "6a22dc9c-6098-4cf3-999c-af50a515df05",
                                                "sense_id": "3303c85f-3843-34f2-8208-9a45b753d7f4",
                                                "text": "I have seen the eternal Footman hold my coat, and snicker, / And in short, I was afraid."
                                            },
                                            {
                                                "example_id": "c6d6d182-e0fb-4d4a-a0fa-40e3260bec98",
                                                "sense_id": "3303c85f-3843-34f2-8208-9a45b753d7f4",
                                                "text": "Most political experts expect the Minnesota election to be decided in the courts or even in the state senate. In short, it's a mess."
                                            },
                                            {
                                                "example_id": "109fbaed-945b-4ec7-8941-700ac5caf35d",
                                                "sense_id": "3303c85f-3843-34f2-8208-9a45b753d7f4",
                                                "text": "It was, in short, saved before - and looks to be once more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b41d12e-f36d-4059-ac62-bf73ca906856",
                        "source_entry_id": "b0a08c35-7887-3381-9572-38a2ea9a5dd9",
                        "source_sense_id": "31faf962-6e7e-3b1f-8827-18cfa2c679ec",
                        "source_sense_description": "um vorher Gesagtes zusammenzufassen; kurz gesagt",
                        "target_lang_word": "in a word",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in a word",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff4eb470-d6c1-3d95-ae0a-90518d3b4a17",
                                        "entry_id": "aece8ec8-b261-361d-a868-075eb84cdd26",
                                        "glosses": [
                                            "In summarization: briefly, concisely, summarily, in short; to sum up"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a828c1-74af-43e9-a69f-c979a5fc876e",
                                                "sense_id": "ff4eb470-d6c1-3d95-ae0a-90518d3b4a17",
                                                "text": "In order to deliver the news of Greek victory to Athens, Pheidippides covered the distance there from the plain of Marathon as quickly as his two legs could carry him, and did so without making any stops; in a word, he ran the entire distance."
                                            },
                                            {
                                                "example_id": "aa25589d-1e00-45d3-b18f-030794b8168a",
                                                "sense_id": "ff4eb470-d6c1-3d95-ae0a-90518d3b4a17",
                                                "text": "Man, I got here by putting one foot in front of the other; in a word, I walked."
                                            },
                                            {
                                                "example_id": "9051957e-97d6-4c07-9f5d-0c35040316d6",
                                                "sense_id": "ff4eb470-d6c1-3d95-ae0a-90518d3b4a17",
                                                "text": "In a Word, to hint at no more Reaſons for his Conduct, Mr. Northerton was deſirous of departing that Evening, and nothing remained for him but to contrive the Quomodo, which appeared to be a Matter of ſome Difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c3b1287-9bf9-3e0a-8393-f87767f1b37b",
                                        "entry_id": "aece8ec8-b261-361d-a868-075eb84cdd26",
                                        "glosses": [
                                            "In summation: all in all, altogether, in total, overall, to sum up"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a08b76-9d62-40b1-b0bf-444412343d30",
                                                "sense_id": "1c3b1287-9bf9-3e0a-8393-f87767f1b37b",
                                                "text": "He was suspicious, standoffish, taciturn; in a word, hostile."
                                            },
                                            {
                                                "example_id": "97911e06-5c92-4c28-bf65-15f81c380167",
                                                "sense_id": "1c3b1287-9bf9-3e0a-8393-f87767f1b37b",
                                                "text": "Susan soon discovered her blind date to be mean, vulgar, obstreperous, presuming, and insulting; in a word, a cad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "754f4990-4029-42ee-8637-c76b72347882",
                        "source_entry_id": "b0a08c35-7887-3381-9572-38a2ea9a5dd9",
                        "source_sense_id": "31faf962-6e7e-3b1f-8827-18cfa2c679ec",
                        "source_sense_description": "um vorher Gesagtes zusammenzufassen; kurz gesagt",
                        "target_lang_word": "bref",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bref",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3aacf96-758d-35bd-b35b-834dac51509f",
                                        "entry_id": "ca1ec1a1-97eb-3fca-8257-426e0fad8f37",
                                        "glosses": [
                                            "Court, de peu de durée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b44a80-4a60-488a-ac86-538802be13cd",
                                                "sense_id": "c3aacf96-758d-35bd-b35b-834dac51509f",
                                                "text": "Dans les plus brefs délais."
                                            },
                                            {
                                                "example_id": "4bf9eff7-29ec-4d22-a9fb-60728a451529",
                                                "sense_id": "c3aacf96-758d-35bd-b35b-834dac51509f",
                                                "text": "Cette relation fut brève."
                                            },
                                            {
                                                "example_id": "e5647a0a-49f2-4363-aedd-9e6112960f7c",
                                                "sense_id": "c3aacf96-758d-35bd-b35b-834dac51509f",
                                                "text": "… si tant de démagogies concourantes consentaient à nous laisser quelque respiration, c'est à de telles études que je me mettrais en devoir de me précipiter immédiatement, parce que la vie est brève."
                                            },
                                            {
                                                "example_id": "25543429-df0f-4aa6-a660-b54d53851e74",
                                                "sense_id": "c3aacf96-758d-35bd-b35b-834dac51509f",
                                                "text": "Il hésite, bref, il ne sait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "026dd036-0827-3c9a-bd97-7efdc34e57e1",
                                        "entry_id": "ca1ec1a1-97eb-3fca-8257-426e0fad8f37",
                                        "glosses": [
                                            "Petit de taille."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22bd239c-2979-4d02-8ccc-d48d97866976",
                                                "sense_id": "026dd036-0827-3c9a-bd97-7efdc34e57e1",
                                                "text": "Pépin le bref."
                                            },
                                            {
                                                "example_id": "8ef0f10d-4d96-40b3-ba98-ba921e45c414",
                                                "sense_id": "026dd036-0827-3c9a-bd97-7efdc34e57e1",
                                                "text": "Mon petit copain Julot habite au numéro 9. Je dis petit, car il est bref de taille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "763c4938-1c86-3c73-a4c4-74f6ae404964",
                                        "entry_id": "ca1ec1a1-97eb-3fca-8257-426e0fad8f37",
                                        "glosses": [
                                            "Court, peu élevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e4b534-9e17-42c1-8f9e-b6200eceaedc",
                                                "sense_id": "763c4938-1c86-3c73-a4c4-74f6ae404964",
                                                "text": "Assis dans un petit fauteuil à dossier bref, papa travaillait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0304370e-d376-3eda-b684-6e436d48de1a",
                                        "entry_id": "ca1ec1a1-97eb-3fca-8257-426e0fad8f37",
                                        "glosses": [
                                            "Qualifie une syllabe ou une voyelle qui ne se prononce pas longuement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f87573-66e0-4bbd-9357-9d060052463b",
                                                "sense_id": "0304370e-d376-3eda-b684-6e436d48de1a",
                                                "text": "En français, a était long dans grâce et bref dans race."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bref",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d44fadfa-1401-33c8-881c-a11fad7d45ec",
                                        "entry_id": "a3d32e89-7262-306c-a2c3-5fab6d86ca18",
                                        "glosses": [
                                            "Enfin ; pour le dire en peu de mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40e2571-b1a1-46cb-accd-4694c47b3a4c",
                                                "sense_id": "d44fadfa-1401-33c8-881c-a11fad7d45ec",
                                                "text": "Choisir un roi jeune, beau et bien portant n’empêchait pas qu’il vieillît, enlaidît, tombât malade, ni qu’il perdît ses vertus, ses qualités morales — bref, qu’il changeât et cessât d’être adéquat."
                                            },
                                            {
                                                "example_id": "b5295d9a-7267-4cee-8d8e-58b101d71ef0",
                                                "sense_id": "d44fadfa-1401-33c8-881c-a11fad7d45ec",
                                                "text": "J'ai repris mes anciennes habitudes. Je sors le soir dans les bars pour rencontrer des gens, y aller à la cool pour m’attirer leur sympathie et essayer d'obtenir des informations, prendre la température du territoire, bref chercher si possible de nouveaux tontons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c9977e-1b3c-3b9e-bae7-df9a9db05778",
                                        "entry_id": "a3d32e89-7262-306c-a2c3-5fab6d86ca18",
                                        "glosses": [
                                            "Promptement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c34152-d9c7-4460-90a8-ae9ed68d78e7",
                                                "sense_id": "53c9977e-1b3c-3b9e-bae7-df9a9db05778",
                                                "text": "Parler bref, avoir une prononciation prompte, tranchante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bref",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05b266f3-a6c3-37f5-bd2f-32aaa582c0a6",
                                        "entry_id": "4b09bd2d-9b13-31f6-8d82-346f941df29d",
                                        "glosses": [
                                            "Rescrit émané du pape ou du grand pénitencier sur des affaires brèves et succinctes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122869a1-b6d5-49af-9eac-0a2a3f3dd63b",
                                                "sense_id": "05b266f3-a6c3-37f5-bd2f-32aaa582c0a6",
                                                "text": "Il reçut un bref du Pape."
                                            },
                                            {
                                                "example_id": "9e5208db-ed67-4b6b-9c7c-17acc3982950",
                                                "sense_id": "05b266f3-a6c3-37f5-bd2f-32aaa582c0a6",
                                                "text": "Solliciter, obtenir un bref."
                                            },
                                            {
                                                "example_id": "920f6e8d-5194-4fa8-8a88-52d6237f2d3f",
                                                "sense_id": "05b266f3-a6c3-37f5-bd2f-32aaa582c0a6",
                                                "text": "Le secrétaire des brefs."
                                            },
                                            {
                                                "example_id": "24ae91aa-b0cc-47c3-a453-32721e10e287",
                                                "sense_id": "05b266f3-a6c3-37f5-bd2f-32aaa582c0a6",
                                                "text": "Bref apostolique."
                                            },
                                            {
                                                "example_id": "7932a9c7-1791-43d6-891a-ddf2cfc0affc",
                                                "sense_id": "05b266f3-a6c3-37f5-bd2f-32aaa582c0a6",
                                                "text": "On fait état de brefs qu'auraient donnés les papes Nicolas III en 1277, et Benoît XII en 1334 à des corporations de maçons, leur confirmant un monopole embrassant la chrétienté entière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f2c2f66-bdc6-3376-9e49-584213034261",
                                        "entry_id": "4b09bd2d-9b13-31f6-8d82-346f941df29d",
                                        "glosses": [
                                            "Livret écrit en abréviations qui indique les rubriques du bréviaire pour chaque jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bc338f2-851c-43a6-887f-befbf3fae2bc",
                                                "sense_id": "9f2c2f66-bdc6-3376-9e49-584213034261",
                                                "text": "Un bref à l’usage de Paris, à l’usage de Rome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
