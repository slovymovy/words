                "senses": [
                    {
                        "sense_id": "571da482-bd1b-3769-ab5f-fcaa8c5c5e37",
                        "entry_id": "ab8ca730-1a9a-3e88-ae91-d0907abbedd1",
                        "glosses": [
                            "разг. кубарем, переворачиваясь через голову"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef47b87-1a50-45ee-a534-c597789a027e",
                                "sense_id": "571da482-bd1b-3769-ab5f-fcaa8c5c5e37",
                                "text": "― А то, что если вы еще раз… осмелитесь упомянуть хоть одно слово… о моей матери… то я вас с лестницы кувырком спущу!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c01fb484-7827-4640-9029-e9dfe215abba",
                        "source_entry_id": "ab8ca730-1a9a-3e88-ae91-d0907abbedd1",
                        "source_sense_id": "571da482-bd1b-3769-ab5f-fcaa8c5c5e37",
                        "target_lang_word": "upside down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upside down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99d52abd-06ae-3ff8-b05e-e521a674dada",
                                        "entry_id": "5a6deb22-3cf9-3a18-8dda-2e09a086d430",
                                        "glosses": [
                                            "Inverted, so that the top is now at the bottom."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38bf7b98-fa0b-49d4-9e89-780d1aed87df",
                                                "sense_id": "99d52abd-06ae-3ff8-b05e-e521a674dada",
                                                "text": "The Union flag was flying upside down, a sign of danger."
                                            },
                                            {
                                                "example_id": "5226374b-098c-48f7-bd07-664b0f481b51",
                                                "sense_id": "99d52abd-06ae-3ff8-b05e-e521a674dada",
                                                "text": "For, suddenly, I saw you there / And through foggy London town / The sun was shining upside down!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8be6b4ce-3f8e-3ec6-9aee-74b118f504e9",
                                        "entry_id": "5a6deb22-3cf9-3a18-8dda-2e09a086d430",
                                        "glosses": [
                                            "In great disorder."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27e70b12-4356-498f-b40b-1db73575b639",
                                                "sense_id": "8be6b4ce-3f8e-3ec6-9aee-74b118f504e9",
                                                "text": "The thief had turned the room upside down."
                                            },
                                            {
                                                "example_id": "dc14e85e-5c71-4dd0-9fe1-98e7f00c98c9",
                                                "sense_id": "8be6b4ce-3f8e-3ec6-9aee-74b118f504e9",
                                                "text": "This house is turned upside down since Robin Ostler died."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upside down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec4148c-e193-30b6-969a-d6048fd78e4d",
                                        "entry_id": "4195465c-f273-33b3-afee-f76b3cb14df4",
                                        "glosses": [
                                            "Inverted; turned so that the top is at the bottom."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59db7426-b274-43d0-8233-411bdc313d91",
                                                "sense_id": "9ec4148c-e193-30b6-969a-d6048fd78e4d",
                                                "text": "The pattern resembled an upside down letter W."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834b98bf-fa98-32e1-931e-0a4ff64495bf",
                                        "entry_id": "4195465c-f273-33b3-afee-f76b3cb14df4",
                                        "glosses": [
                                            "In great disorder."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ee7ff6-5485-46e9-8cc9-f06b8c8fc3d5",
                                                "sense_id": "834b98bf-fa98-32e1-931e-0a4ff64495bf",
                                                "text": "The wenches and the men have been on the streets all day, and the kitchen is upside down. You never saw the like."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454d9b8b-5386-3cd9-b5fe-c4d0776262da",
                                        "entry_id": "4195465c-f273-33b3-afee-f76b3cb14df4",
                                        "glosses": [
                                            "Owing more money for something than it is worth; having negative equity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e2ac35-fabf-4eba-8bdb-46bad616400d",
                                                "sense_id": "454d9b8b-5386-3cd9-b5fe-c4d0776262da",
                                                "text": "He's upside down on his mortgage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upside down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b74f435-131f-3b81-a357-57f3455b1144",
                                        "entry_id": "e475a436-7e6c-3c30-8fa2-7b3bf571aa64",
                                        "glosses": [
                                            "Alternative form of Upside Down."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac04e44-2ffe-4521-9599-cdd1fa4aaef0",
                                                "sense_id": "3b74f435-131f-3b81-a357-57f3455b1144",
                                                "text": "It is in the upside down where we can find many opportunities to grow and learn."
                                            },
                                            {
                                                "example_id": "aeb19ca4-2f7e-48cb-b11a-002d6ce16e13",
                                                "sense_id": "3b74f435-131f-3b81-a357-57f3455b1144",
                                                "text": "it asks courts to step into the reality educators face: the reality of teaching in the upside down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
