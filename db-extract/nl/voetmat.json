                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ccd60d-06bc-48b7-8751-4922c618ae67",
                                                "sense_id": "a78acb25-95e1-3da1-b799-9c64dcd8f10d",
                                                "text": "Frons mat black, orbits slightly paler, more greyish; mesonotum distinctly mat, greyish-black, but with some subshine; […]"
                                            }
                                        ]
