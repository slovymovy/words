{
    "word_family": [
        "rasp"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "268963d7-69e2-3b58-a582-a1d23bec6300",
                    "sense_definition": "To rub surfaces together to produce a harsh, grating sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grating_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry branches began to <w>risp</w> against the windowpane as the wind picked up.",
                            "target_lang_translations": {
                                "ru": "Сухие ветки начали <w>скрести</w> по оконному стеклу, когда ветер усилился."
                            }
                        },
                        {
                            "text": "He heard the insects <w>risp</w> their wings together in the heat of the afternoon.",
                            "target_lang_translations": {
                                "ru": "Он слышал, как насекомые <w>стрекочут</w> крыльями в послеобеденный зной."
                            }
                        }
                    ],
                    "synonyms": [
                        "rasp",
                        "grate",
                        "scrape"
                    ],
                    "common_phrases": [
                        "risp-together"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily found in specific regional or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тереть поверхности друг о друга, издавая резкий, скрежещущий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрежетать",
                                "target_lang_sense_clarification": "издавать резкий звук при трении"
                            },
                            {
                                "target_lang_word": "скрести",
                                "target_lang_sense_clarification": "производить шум трением"
                            },
                            {
                                "target_lang_word": "издавать стрекотание",
                                "target_lang_sense_clarification": "о звуках насекомых"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9336a1b-97a1-3d03-b777-28fd8d992e4c",
                    "sense_definition": "A sound or sensation produced by rubbing or grating things together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grating_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The only sound in the field was the constant <w>risp</w> of the insects in the grass.",
                            "target_lang_translations": {
                                "ru": "Единственным звуком в поле было постоянное <w>стрекотание</w> насекомых в траве."
                            }
                        },
                        {
                            "text": "A slight <w>risp</w> of metal against stone echoed through the quiet hallway.",
                            "target_lang_translations": {
                                "ru": "Легкий <w>скрежет</w> металла о камень эхом разнесся по тихому коридору."
                            }
                        }
                    ],
                    "synonyms": [
                        "rasping",
                        "grating"
                    ],
                    "common_phrases": [
                        "faint risp"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily found in specific regional or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук или ощущение, возникающее при трении предметов друг о друга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрежет",
                                "target_lang_sense_clarification": "резкий звук трения"
                            },
                            {
                                "target_lang_word": "скрип",
                                "target_lang_sense_clarification": "сухой звук трения"
                            },
                            {
                                "target_lang_word": "стрекотание",
                                "target_lang_sense_clarification": "звук крыльев насекомых"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}