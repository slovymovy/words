    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a23a9d86-6cd5-3df8-8714-e77b107d359b",
                "word": "mashup",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3309e8d1-4514-4c56-b4bd-d0d743eaa9ad",
                        "entry_id": "a23a9d86-6cd5-3df8-8714-e77b107d359b",
                        "tags": [
                            "plural"
                        ],
                        "form": "mashups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0be08204-a49b-3013-bdd0-5fa008cc07b7",
                        "entry_id": "a23a9d86-6cd5-3df8-8714-e77b107d359b",
                        "glosses": [
                            "Something consisting of two or more elements combined together.",
                            "An artistic work that consists primarily of parts borrowed from other works, or features a mixture of genres."
                        ],
                        "tags": [
                            "informal",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a9f686b0-9eeb-49a4-888e-56089c1180bc",
                                "sense_id": "0be08204-a49b-3013-bdd0-5fa008cc07b7",
                                "text": "What’s tiresome about Anna, though, is that it's such an obvious mashup of other movies, moving from homage right into ripoff."
                            }
                        ]
                    },
                    {
                        "sense_id": "df186411-272c-3a0f-80f1-61822263d158",
                        "entry_id": "a23a9d86-6cd5-3df8-8714-e77b107d359b",
                        "glosses": [
                            "Something consisting of two or more elements combined together.",
                            "A remix created by combining two or more songs from different artists into one piece of music."
                        ],
                        "tags": [
                            "informal",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6b26b407-faaf-347c-ae6f-dedc3c04fad7",
                        "entry_id": "a23a9d86-6cd5-3df8-8714-e77b107d359b",
                        "glosses": [
                            "Something consisting of two or more elements combined together.",
                            "A derivative work consisting of two or more pieces of (generally digital) media joined together, such as a video clip with a different soundtrack applied for humorous effect, or a map overlaid with user-supplied data."
                        ],
                        "tags": [
                            "informal",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "96d8dccd-577d-3e45-ab6b-84bf0cff8d41",
                        "entry_id": "a23a9d86-6cd5-3df8-8714-e77b107d359b",
                        "glosses": [
                            "Something consisting of two or more elements combined together.",
                            "A Web application that combines data or functionality from more than one source."
                        ],
                        "tags": [
                            "Internet",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "209347f5-7a72-4a37-bf16-d5750e06bebc",
                                "sense_id": "96d8dccd-577d-3e45-ab6b-84bf0cff8d41",
                                "text": "This app is a mashup mixing news from the BBC and maps from Google."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40413e9e-7291-48e9-a818-cdd230459921",
                        "source_entry_id": "a23a9d86-6cd5-3df8-8714-e77b107d359b",
                        "source_sense_description": "derivative work consisting of two or more pieces of media joined together",
                        "target_lang_word": "Mashup",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mashup",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "100c3ecb-70e7-30be-b5c1-555bf2e85d5d",
                                        "entry_id": "5d72af73-2da8-3b87-8331-30bf368acd27",
                                        "glosses": [
                                            "Schaffen neuer Medieninhalte aus der Kombination bestehender Formen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "355bcb68-adf6-4e43-accf-f87c4f1fe474",
                                                "sense_id": "100c3ecb-70e7-30be-b5c1-555bf2e85d5d",
                                                "text": "„Der Begriff Mashup bezeichnet Webseiten oder Webapplikationen, die Dienste oder Inhalte von verschiedenen Quellen zu einem neuen Service verschmelzen. Die Integration der Daten erfolgt typischerweise über offene Programmierschnittstellen, die von den Anbietern der ursprünglichen Informationen zur Verfügung gestellt werden.“"
                                            },
                                            {
                                                "example_id": "c2623d62-6972-438e-863b-8dcd31f17762",
                                                "sense_id": "100c3ecb-70e7-30be-b5c1-555bf2e85d5d",
                                                "text": "„Bisher umfasst das Gebiet der größten Innovation das Mashup von Kartierungs- und Satellitenbildsoftware mit lokalem Inhalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe2cc52c-cdac-3b02-b66b-e8573f2c54d8",
                                        "entry_id": "5d72af73-2da8-3b87-8331-30bf368acd27",
                                        "glosses": [
                                            "Remix von Tonaufnahmen meist verschiedener Interpreten"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4e1cc2-7c1c-4d34-86e1-7ce0d8147577",
                                                "sense_id": "fe2cc52c-cdac-3b02-b66b-e8573f2c54d8",
                                                "text": "„Der Begriff ‚Mashup‘ stammt ursprünglich aus der Musikszene und beschreibt das Vermischen von Liedern verschiedener Musikrichtungen miteinander. Das daraus entstehende neue Lied stellt trotz seiner hörbaren Ursprungsklänge ein völlig neues Klangerlebnis dar.“"
                                            },
                                            {
                                                "example_id": "aa56e78b-fb7f-49d8-95af-8344e3179bc7",
                                                "sense_id": "fe2cc52c-cdac-3b02-b66b-e8573f2c54d8",
                                                "text": "„Am Beispiel des musikalischen Genres des Mashups geht Frédéric Döhl der Frage nach, wann in auditiven digitalen Adaptionskulturen ästhetische Selbstständigkeit entsteht.“"
                                            },
                                            {
                                                "example_id": "c642dff3-8f97-46f7-9123-5a70bc3f96a9",
                                                "sense_id": "fe2cc52c-cdac-3b02-b66b-e8573f2c54d8",
                                                "text": "„Filme und TV-Serien, Rock, Rap und Dancepop, die kreative Zitierkultur des Internets (Mashups, Meme und Co.) werden nicht für eine edle Elite, sondern für eine demokratische Massengesellschaft geschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
