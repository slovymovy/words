                "senses": [
                    {
                        "sense_id": "b61c0fcf-5b62-31b4-94b9-c2eaab4a3e5f",
                        "entry_id": "96801251-9294-3687-8982-5700327358f3",
                        "glosses": [
                            "Norm, die die Abgasausscheidung bestimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f032c89d-9d4b-4ea2-98fe-dd433834b756",
                                "sense_id": "b61c0fcf-5b62-31b4-94b9-c2eaab4a3e5f",
                                "text": "„Die Abgasnorm im Saale ist übererfüllt.“"
                            },
                            {
                                "example_id": "94ca7c5c-9c47-4089-aa49-63742817016b",
                                "sense_id": "b61c0fcf-5b62-31b4-94b9-c2eaab4a3e5f",
                                "text": "„In vielen Innenstädten dürfen nur noch Autos fahren, die eine bestimmte Abgasnorm erfüllen.“"
                            },
                            {
                                "example_id": "47b6aa5c-5abf-4a6b-8387-db3f3d49d7d8",
                                "sense_id": "b61c0fcf-5b62-31b4-94b9-c2eaab4a3e5f",
                                "text": "„Viele Neuwagen mit Dieselmotor sind tatsächlich zumindest so wenig gesundheitsschädlich, wie es die gesetzliche Abgasnorm erfordert. Diese Feststellung sollte eigentlich selbstverständlich sein.“"
                            }
                        ],
