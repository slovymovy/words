                "senses": [
                    {
                        "sense_id": "0a5a36ae-7dd7-39d4-9f1a-8d09a54fc8c2",
                        "entry_id": "7ef36611-ff29-390b-b55c-5bd1103243b9",
                        "glosses": [
                            "Atteint de trisomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c589ca0b-d81c-46bc-b02c-9cb0d53c8d87",
                                "sense_id": "0a5a36ae-7dd7-39d4-9f1a-8d09a54fc8c2",
                                "text": "« 96% des enfants trisomiques dépistés sont encore avortés en France », souligne-t-il."
                            },
                            {
                                "example_id": "de5b289d-1e90-4976-91a4-5275aecb48fc",
                                "sense_id": "0a5a36ae-7dd7-39d4-9f1a-8d09a54fc8c2",
                                "text": "C'est une fille, et elle pensa que cela ne tenait pas à grand-chose, car si ça avait été un garçon, trisomique ou pas, sa mère ne l'aurait peut-être pas abandonné."
                            },
                            {
                                "example_id": "a1ee0a29-b15d-458d-942b-c342d935a73e",
                                "sense_id": "0a5a36ae-7dd7-39d4-9f1a-8d09a54fc8c2",
                                "text": "Un restaurant extraordinaire « pour permettre aux personnes trisomiques de s’épanouir professionnellement et socialement, dans un lieu conçu et pensé pour tous, y compris pour eux. Un lieu de partage et de découverte humaine », explique Flore Lelièvre, alors jeune diplômée en architecture d’intérieur."
                            }
                        ]
                    }
