                    {
                        "translation_id": "a9776b2c-38b0-442c-b886-2cbf53a3c18c",
                        "source_entry_id": "5e63d48a-1599-31de-95df-c30153f05245",
                        "source_sense_description": "to behave in a servile manner",
                        "target_lang_word": "пресмыка́ться",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пресмыка́ться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "13f587f3-3c6a-3e30-90de-b5c114b138f4",
                                        "entry_id": "e0ddfede-b91b-3223-ad1c-f2057d96dd45",
                                        "glosses": [
                                            "передвигаться ползком по земле; ползать"
                                        ],
                                        "tags": [
                                            "о некоторых животных"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25c5e8c-ffff-43fb-88d4-06ca0bf6d0a1",
                                                "sense_id": "13f587f3-3c6a-3e30-90de-b5c114b138f4",
                                                "text": "Здесь кричат попугаи всех цветов и видов; здесь пресмыкаются в великолепных клетках зме́и ужасной величины."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "239d4326-5c06-3922-8552-763236d2af4a",
                                        "entry_id": "e0ddfede-b91b-3223-ad1c-f2057d96dd45",
                                        "glosses": [
                                            "перен. раболепно преклоняться, угодничать, унижаться перед кем-, чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3e1efa-6603-4519-95b9-1f8f543e42c2",
                                                "sense_id": "239d4326-5c06-3922-8552-763236d2af4a",
                                                "text": "Не больно ли сердцу твоему, что сынок твой, знатный боярин, презирает заслуги и достоинства, для того что их участь пресмыкаться в стезе чинов, пронырства гнушаяся?"
                                            },
                                            {
                                                "example_id": "fd2bd939-d623-4043-829f-0352723eee03",
                                                "sense_id": "239d4326-5c06-3922-8552-763236d2af4a",
                                                "text": "Князь был одним из тех расслабленных и чванных представителей старинных родов, которые, по-видимому, отстаивают корпоративную связь, но, в сущности, пресмыкаются и ползают, исключительно посвящая свою жизнь поддерживанию дворских и высокобюрократических отношений."
                                            },
                                            {
                                                "example_id": "a4fad896-c1fd-4160-91fd-55025ecd441f",
                                                "sense_id": "239d4326-5c06-3922-8552-763236d2af4a",
                                                "text": "«Они пресмыкаются перед силою; они безжалостны к слабым, беспощадны к ошибкам и снисходительны к преступлениям ..»."
                                            },
                                            {
                                                "example_id": "736bf2a9-f1cd-46ef-8cd4-574f4197870c",
                                                "sense_id": "239d4326-5c06-3922-8552-763236d2af4a",
                                                "text": "Блатарь может быть груб и дерзок с любым начальником (этот шик, этот дух он даже обязан в некоторых обстоятельствах показать во всей яркости) ― перед врачом блатарь лебезит, подчас пресмыкается и не позволит грубого слова в отношении врача, пока блатарь не увидит, что ему не верят, что его наглые требования никто выполнять не собирается."
                                            }
