                                    {
                                        "sense_id": "84db5d9c-256e-375d-847d-6d4f7d336183",
                                        "entry_id": "2097dcb8-0f8a-3865-a6e3-0f2d66b02d7f",
                                        "glosses": [
                                            "długi i wąski półwysep powstały wskutek naniesienia piasku przez prądy przybrzeżne"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "1f37352a-d5a6-356d-ac0c-ad8b5827d96d",
                                        "entry_id": "2097dcb8-0f8a-3865-a6e3-0f2d66b02d7f",
                                        "glosses": [
