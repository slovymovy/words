                "senses": [
                    {
                        "sense_id": "df74c0c0-d654-327c-b20f-310373ae79ca",
                        "entry_id": "fc511dd5-8950-3168-a5ac-fdd7ece1ea85",
                        "glosses": [
                            "gedrängte, wenig geordnete Menge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017ea5bd-cdbb-4855-ba75-73b121df3095",
                                "sense_id": "df74c0c0-d654-327c-b20f-310373ae79ca",
                                "text": "„Die spanisch aussehende Enkelin kehrte zurück in einem Pulk junger Menschen, in ihrer Mitte die Blonde, die Ingeborg bei sich die Prinzessin getauft hatte.“"
                            },
                            {
                                "example_id": "198b713c-8925-4518-8609-f0b77189ecde",
                                "sense_id": "df74c0c0-d654-327c-b20f-310373ae79ca",
                                "text": "„Ein ganzer Pulk von Menschen strömt von der Straße in die Eingangshalle.“"
                            },
                            {
                                "example_id": "e1772c9d-a5e3-4682-8346-7cd2bd030990",
                                "sense_id": "df74c0c0-d654-327c-b20f-310373ae79ca",
                                "text": "„Ich finde mich im Pulk unserer Leute wieder und gehe ein paar Schritte mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "66d8b4a7-33e8-3d37-aca3-67f28c86be40",
                        "entry_id": "fc511dd5-8950-3168-a5ac-fdd7ece1ea85",
                        "glosses": [
                            "Gruppe von Läufern/Fahrzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec828281-a492-42c7-b595-3b47572de8f0",
                                "sense_id": "66d8b4a7-33e8-3d37-aca3-67f28c86be40",
                                "text": "Er war als Fünftplatzierter in den Pulk hinter die beiden Führenden geraten und konnte sich daraus nicht mehr befreien."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3bd77557-1d5b-3e5d-8241-9ab856581a24",
                        "entry_id": "fc511dd5-8950-3168-a5ac-fdd7ece1ea85",
                        "glosses": [
                            "Menge von Militärfahrzeugen/-flugzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a20949-0802-4b48-9a02-603fa62daadb",
                                "sense_id": "3bd77557-1d5b-3e5d-8241-9ab856581a24",
                                "text": "Die Bomber flogen nach dem Angriff im Pulk nach Westen ab."
                            }
                        ],
