        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "960f49be-136d-3b62-b596-4bdc93d02aaa",
                "word": "antiphrasis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dbc57d4e-3983-41ee-a41c-fd3c50d145f0",
                        "entry_id": "960f49be-136d-3b62-b596-4bdc93d02aaa",
                        "tags": [
                            "plural"
                        ],
                        "form": "antiphrases"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98e12081-1e7a-3227-9067-b4f0495d32a1",
                        "entry_id": "960f49be-136d-3b62-b596-4bdc93d02aaa",
                        "glosses": [
                            "Use of a word or phrase in a sense opposite of its literal meaning, especially for ironic or humorous effect."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "59903723-f5c8-4e18-ac8f-1f01f38a8ab3",
                                "sense_id": "98e12081-1e7a-3227-9067-b4f0495d32a1",
                                "text": "When they called him “bad as hell”, they weren’t calling him evil. It was antiphrasis."
                            },
                            {
                                "example_id": "795d6a8b-7552-4d6d-a65c-9e9b87d51f1c",
                                "sense_id": "98e12081-1e7a-3227-9067-b4f0495d32a1",
                                "text": "By the turn of this century the situation concerning logic was quite simple: there was basically one logic (classical logic) which could be used (by changing the set of proper axioms) in various situations. Logic was about pure reasoning. Brouwer’s criticism destroyed this dream of unity: classical logic was not suited for constructive features and therefore it lost its universality. Now by the end of the century we are faced with an incredible number of logics-some of them only named ‘logic’ by antiphrasis, some of them introduced on serious grounds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39782a96-9762-4bc3-a373-31cdb97dff15",
                        "source_entry_id": "960f49be-136d-3b62-b596-4bdc93d02aaa",
                        "source_sense_id": "98e12081-1e7a-3227-9067-b4f0495d32a1",
                        "source_sense_description": "use of a word or phrase in a sense not in accord with its literal meaning",
                        "target_lang_word": "antiphrase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiphrase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43fb7c0a-5cf6-3b38-b095-f128c6916d0f",
                                        "entry_id": "b2224c68-3b16-37b2-803d-5db3074f61e5",
                                        "glosses": [
                                            "Figure de style, par laquelle on emploie un mot, une locution, une phrase, pour signifier le contraire."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "143d8c16-98ac-4a45-83ef-0a367e32d74c",
                                                "sense_id": "43fb7c0a-5cf6-3b38-b095-f128c6916d0f",
                                                "text": "Dans un propos ironique, l’antiphrase porte sur tout l’énoncé."
                                            },
                                            {
                                                "example_id": "b93075a4-4f4a-4bcc-aae9-b1d234a19321",
                                                "sense_id": "43fb7c0a-5cf6-3b38-b095-f128c6916d0f",
                                                "text": "Les Anciens appelaient les Furies les Euménides (« bienveillantes ») par antiphrase propitiatoire, pour éviter que le nom exact ne déclenche malencontreusement sur eux leur courroux."
                                            },
                                            {
                                                "example_id": "3f8a19c3-95a5-4996-9f84-0e2d71316147",
                                                "sense_id": "43fb7c0a-5cf6-3b38-b095-f128c6916d0f",
                                                "text": "Il […] était froid, impassible, d’une nature essentiellement silencieuse et répondait au nom de « Babillard », que sans doute les Indiens, ou ses compagnons eux-mêmes lui avaient donné par antiphrase."
                                            },
                                            {
                                                "example_id": "87e30299-dc38-41fb-8eb6-ce2fbff97f7b",
                                                "sense_id": "43fb7c0a-5cf6-3b38-b095-f128c6916d0f",
                                                "text": "C’est M. Lefèvre, l’ancien acteur des Variétés, qui a fait éclore un jour cette phrase dans la bouche de mademoiselle Juliette, une figurante laide et rousse qu’Odry, par antiphrase, appelait Joliette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
