                "senses": [
                    {
                        "sense_id": "8e481e41-aa04-3af7-b8cc-ab34746fcdc5",
                        "entry_id": "013bf0d2-4459-316d-9877-9c606170744f",
                        "glosses": [
                            "Argumenter pour répondre à d’autres arguments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a8ccee-54de-4d58-87cb-2cf28c7d560d",
                                "sense_id": "8e481e41-aa04-3af7-b8cc-ab34746fcdc5",
                                "text": "« Son pire ennemi, c’est sa situation. Il n’a pas correctement été pris en charge », contre-argumente Mᵉ Noël, son avocate."
                            },
                            {
                                "example_id": "b7249652-483d-4104-a487-f4b6132bed98",
                                "sense_id": "8e481e41-aa04-3af7-b8cc-ab34746fcdc5",
                                "text": "Contre-argumenter cette citation : \"Les plus désespérés sont les chants les plus beaux...\""
                            },
                            {
                                "example_id": "fe4263b9-9f72-43ba-9749-4aefe439efff",
                                "sense_id": "8e481e41-aa04-3af7-b8cc-ab34746fcdc5",
                                "text": "Il est important pour nous de comprendre comment il construit ses tarifs pour pouvoir contre-argumenter efficacement."
                            }
                        ]
                    }
