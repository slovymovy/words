                ],
                "senses": [
                    {
                        "sense_id": "3ab6ed2e-572b-3d94-9f7f-1f7a819fa2f5",
                        "entry_id": "8684ea81-c6ff-3593-9b3e-72934c86f840",
                        "glosses": [
                            "Absence d’un organe provoquée par l’absence ou l’insuffisance de développement de son ébauche embryonnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93b7ac2-f6ee-45b7-9c81-d2621897e89e",
                                "sense_id": "3ab6ed2e-572b-3d94-9f7f-1f7a819fa2f5",
                                "text": "L’aplasie mammaire est un arrêt du développement de la glande mammaire entrainant une absence de seins, l’aplasie surrénalienne, l’aplasie cutanée."
                            },
                            {
                                "example_id": "f19ae58a-74df-4c1e-b1d9-0be788d371b0",
                                "sense_id": "3ab6ed2e-572b-3d94-9f7f-1f7a819fa2f5",
                                "text": "L’aplasie cutanée congénitale est définie par l’existence, à la naissance, d’une ulcération ou d’une cicatrice cutanée d’aspect et de forme variables."
                            }
                        ]
                    },
                    {
                        "sense_id": "9efa2486-4437-3a79-bcae-57006e71a04a",
                        "entry_id": "8684ea81-c6ff-3593-9b3e-72934c86f840",
                        "glosses": [
                            "Arrêt de la multiplication cellulaire dans un tissu qui se renouvelle habituellement en permanence"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7cef24ee-2c4b-4681-8f2d-86be1543e1be",
                                "sense_id": "9efa2486-4437-3a79-bcae-57006e71a04a",
                                "text": "Durant la période d’aplasie provoquée par les traitements intensifs contre les cancers, il devient nécessaire de transfuser des quantités de plaquettes et de globules rouges pour contrer les effets des traitements."
                            }
                        ]
                    }
                ],
