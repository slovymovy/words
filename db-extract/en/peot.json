                "forms": [],
                "senses": [
                    {
                        "sense_id": "bea06ef3-843a-3248-8333-2154e2913fae",
                        "entry_id": "c6cbb96b-ae37-3483-a79a-9679d5b8355d",
                        "glosses": [
                            "Sidelocks worn by Hasidic and Orthodox male Jews."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "f1e2801d-1e9a-4078-a328-4e58acc33ec9",
                                "sense_id": "bea06ef3-843a-3248-8333-2154e2913fae",
                                "text": "With box or beads or peyiss, / Let each do his own thing."
                            },
                            {
                                "example_id": "7c1918a3-15b6-4a19-8549-378ac8194697",
                                "sense_id": "bea06ef3-843a-3248-8333-2154e2913fae",
                                "text": "'Manny? Sweet? Manny doesn't do sweet.'\n'Every man does sweet, Max. Even weird ones with payess.'"
                            },
                            {
                                "example_id": "5cb4c95f-6efe-436f-9817-144918f48b3a",
                                "sense_id": "bea06ef3-843a-3248-8333-2154e2913fae",
                                "text": "He showed me the items in his den, or “trophy room” — the cardboard cutout of Sinatra wearing Jewish payos, the portrait of King made entirely of jelly beans, his Emmy for Lifetime Achievement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
