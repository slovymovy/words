                                        "entry_id": "bcac5504-a9cd-3d84-993c-c6d7e7b562fc",
                                        "glosses": [
                                            "große, oft grenzüberschreitende Rohrleitung für Erdgas, Erdöl, manchmal auch Bier, sonstige Flüssigkeiten oder Gase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6077cf88-adba-41be-beea-c0cf0f81e04b",
                                                "sense_id": "d204985f-5bb7-3b90-b267-0aa4a1ab1749",
                                                "text": "In der Ukraine wurden russische Pipelines angezapft."
                                            },
                                            {
                                                "example_id": "7d67298b-eeb8-4310-91fc-ef33cb3e40b5",
                                                "sense_id": "d204985f-5bb7-3b90-b267-0aa4a1ab1749",
                                                "text": "„Nansen und Quisling nahmen auch die Pipeline in Augenschein, durch die seit der Jahrhundertwende Öl von Baku, wo die größten Ölfelder der Welt lagen, an die Schwarzmeerküste transportiert wurde.“"
                                            },
                                            {
                                                "example_id": "4ea5446d-2c41-447f-b78f-d0d9185a3053",
                                                "sense_id": "d204985f-5bb7-3b90-b267-0aa4a1ab1749",
                                                "text": "„Nach Reykjavík führt […] eine mehrere zehn Kilometer lange Pipeline mit Heißwasser, das in den Bergen mit ca. 88 °C startet und mit 86 °C in der Stadt ankommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f016df8-87eb-3f34-9eda-5330ea50aa92",
                                        "entry_id": "bcac5504-a9cd-3d84-993c-c6d7e7b562fc",
                                        "glosses": [
                                            "Zwischenpuffer, in den ein Prozess schreibt und aus dem ein anderer liest"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80d19ef-c721-4ada-9174-00cf1c6b3236",
                                                "sense_id": "9f016df8-87eb-3f34-9eda-5330ea50aa92",
                                                "text": "Der Kindprozess öffnet die Pipeline zum Lesen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7aebf7d2-df81-31f6-b139-c2a947df8dd4",
                                        "entry_id": "bcac5504-a9cd-3d84-993c-c6d7e7b562fc",
                                        "glosses": [
                                            "Reihe hintereinandergeschalteter und gemeinsam getakteter Verarbeitungseinheiten in einem Mikroprozessor"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "555d4b92-46eb-441b-8491-89f09c36363d",
                                                "sense_id": "7aebf7d2-df81-31f6-b139-c2a947df8dd4",
                                                "text": "Da in jedem Takt ein neuer Befehl geladen wird, verlässt im Idealfall auch ein Befehl pro Takt die Pipeline."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
