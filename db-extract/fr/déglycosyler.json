                "senses": [
                    {
                        "sense_id": "dddf4586-f3ae-35e9-a55d-eca149f301f7",
                        "entry_id": "83c2f52d-aec1-31c2-9bd4-ff76fe7db5b8",
                        "glosses": [
                            "Altérer l’ADN en rompant le lien entre une purine (adénine ou guanine) ou une pyrimidine (thymine ou cytosine) et le désoxyribose auquel elle est attachée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46ae198-dcab-4e60-8b8a-a9723efdc96c",
                                "sense_id": "dddf4586-f3ae-35e9-a55d-eca149f301f7",
                                "text": "Les dosages par récepteur mesurent leur liaison à celui-ci, mais comme nous l’avons vu la LH déglycosylée se lie mais reste inactive."
                            },
                            {
                                "example_id": "eec234f2-c99b-4f58-b6cb-88d7bbe63bc8",
                                "sense_id": "dddf4586-f3ae-35e9-a55d-eca149f301f7",
                                "text": "Ce qui est intéressant dans cette méthode est le fait de pouvoir déglycosyler les protéines à l’aide de la PNGase F directement dans le gel 2D-PAGE après coloration à l’argent sans traitement particulier du gel."
                            }
                        ]
                    }
