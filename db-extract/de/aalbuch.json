                "senses": [
                    {
                        "sense_id": "a3245874-872f-3dce-8c57-04733fd0da27",
                        "entry_id": "476cf420-3758-3c6b-bffc-df75fb5af144",
                        "glosses": [
                            "im Osten gelegener Teil der Schwäbischen Alb in Baden-Württemberg, Deutschland"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "6504627f-2ea6-401b-a237-409828083941",
                                "sense_id": "a3245874-872f-3dce-8c57-04733fd0da27",
                                "text": "„Den Anstoß dazu gab, dass bereits seit 1870 auf der Alb, dem Heuberg, dem Härtsfeld und im Aalbuch Wasserversorgungsgruppen gebildet worden waren und seit einigen Jahren erfolgreich arbeiteten.“"
                            },
                            {
                                "example_id": "ad01d494-b8c8-4b3d-b840-fefb4f9881a6",
                                "sense_id": "a3245874-872f-3dce-8c57-04733fd0da27",
                                "text": "„Erst nach dem die Wasserversorgung Härtsfeld/Aalbuch die Hochdruckzone öffnete, konnte Druck auf alle zur Löschung bereitgestellten Rohre gegeben werden.“"
                            },
                            {
                                "example_id": "8a46172e-c98f-4e3a-b751-eabb854d3eb9",
                                "sense_id": "a3245874-872f-3dce-8c57-04733fd0da27",
                                "text": "„Das Gebiet des Aalbuchs, des Härtsfeldes sowie des Albtraufs sind Hauptachsen des Wildkatzenwegeplans.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
