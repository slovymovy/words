                            {
                                "example_id": "b11ff1dd-99ba-4a9d-9c36-0cf70bc6ca49",
                                "sense_id": "cc53ce0e-986d-3323-a4f8-2f7db94379ee",
                                "text": "Gib mir mal bitte die Coladose, sagte der Kollege in der Nachtschicht."
                            },
                            {
                                "example_id": "bfa9d480-80d9-4990-a9c2-7ad8f275488e",
                                "sense_id": "cc53ce0e-986d-3323-a4f8-2f7db94379ee",
                                "text": "„Wenn zusätzlich auf den kleinen Tischen leere Coladosen rumstehen und vor dem essenden Kunden fettige Speisereste in den Mülleimer gewischt werden, wendet sich der Gast, der sich einbilden soll, ihm werde hier etwas Besonderes geboten, mit Grausen.“"
                            }
                        ],
