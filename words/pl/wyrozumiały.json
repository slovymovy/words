                    "sense_definition": "forma czasu przeszłego czasownika <w>wyrozumieć</w> dla trzeciej osoby liczby mnogiej w rodzaju niemęskoosobowym",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kobiety wreszcie <w>wyrozumiały</w> sens tej trudnej i skomplikowanej decyzji.",
                            "target_lang_translations": {
                                "ru": "Женщины наконец <w>поняли</w> смысл этого непростого и сложного решения."
                            }
                        },
                        {
                            "text": "Dzieci szybko <w>wyrozumiały</w> ukryte znaczenie tej starej bajki.",
                            "target_lang_translations": {
                                "ru": "Дети быстро <w>уразумели</w> скрытый смысл этой старой сказки."
                            }
                        }
