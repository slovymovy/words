                {
                    "sense_id": "a8bf1795-983a-3ba5-a384-54dbcd0b2ca4",
                    "sense_definition": "Qui fulmine sous le coup d'une vive irritation ou de la colère.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "émotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est sorti du bureau de son supérieur tout <w>fumant</w> de colère.",
                            "target_lang_translations": {
                                "en": "He stormed out of his boss's office <w>fuming</w> with anger.",
                                "ru": "Он вышел из кабинета начальника, весь <w>кипя</w> от злости.",
                                "de": "Er stürmte <w>wutschnaubend</w> aus dem Büro seines Vorgesetzten.",
                                "es": "Salió del despacho de su jefe <w>echando humo</w> de rabia.",
                                "zh": "他<w>怒气冲冲</w>地走出了上司的办公室。"
                            }
                        },
                        {
                            "text": "En apprenant cette injustice, elle est restée muette mais intérieurement <w>fumante</w> de rage.",
                            "target_lang_translations": {
                                "en": "On learning of this injustice, she stayed silent but was inwardly <w>seething</w> with rage.",
                                "ru": "Узнав об этой несправедливости, она промолчала, но внутри <w>кипела</w> от ярости.",
                                "de": "Als sie von dieser Ungerechtigkeit erfuhr, blieb sie stumm, <w>kochte</w> aber innerlich vor Wut.",
                                "es": "Al enterarse de esta injusticia, se quedó callada, pero por dentro estaba <w>echando humo</w> de rabia.",
                                "zh": "得知这种不公之事后，她一言不发，内心却<w>愤怒</w>不已。"
                            }
                        }
                    ],
                    "synonyms": [
                        "furieux",
                        "enragé"
                    ],
                    "antonyms": [
                        "calme",
                        "apaisé"
