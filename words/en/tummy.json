                    "sense_id": "d4dec040-747e-3380-b50b-ec8a8c0faf8b",
                    "sense_definition": "The stomach or belly, especially when referred to in a child-friendly or informal way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stomach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy complained of a <w>tummy</w> ache after eating too many sweets.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик пожаловался на то, что у него болит <w>животик</w>, после того как съел слишком много сладостей."
                            }
                        },
                        {
                            "text": "She rubbed her dog's soft <w>tummy</w> while he lay on his back.",
                            "target_lang_translations": {
                                "ru": "Она гладила мягкое <w>пузико</w> своего пса, пока тот лежал на спине."
                            }
                        }
                    ],
                    "synonyms": [
                        "belly"
                    ],
                    "common_phrases": [
                        "tummy ache",
                        "tummy rumble"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used by or when speaking to children."
                        }
                    ],
                    "target_lang_definitions": {
