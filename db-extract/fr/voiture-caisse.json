                    {
                        "sense_id": "87ec76f7-4675-354e-a129-e2a243f16575",
                        "entry_id": "7a8e9771-446e-30b5-91d4-9b70a86588ab",
                        "glosses": [
                            "Véhicule servant à la vente au public des billets d'entrée à un cirque ou une ménagerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ff4cd8-5e30-47a1-890e-7c43bb2717bf",
                                "sense_id": "87ec76f7-4675-354e-a129-e2a243f16575",
                                "text": "C'est sans doute cette bosse des affaires qui lui fit choisir la voiture-caisse du cirque, le jour où il s'échappa."
                            },
                            {
                                "example_id": "7392b02f-13a3-46b3-9e5d-97fb8f1e6727",
                                "sense_id": "87ec76f7-4675-354e-a129-e2a243f16575",
                                "text": "Il place la voiture-caisse et la voiture-bar-et-confiserie qui encadreront l'entrée au public et fait dresser à l'opposé les tentes annexes — écuries et ménagerie."
                            },
                            {
                                "example_id": "4dac7414-420d-4f68-84d8-d7348d23a210",
                                "sense_id": "87ec76f7-4675-354e-a129-e2a243f16575",
                                "text": "La voiture façade est partie, et la voiture-bar, et la voiture-caisse où l'administrateur compte ses billets après avoir payé la place et les droits d'auteurs « au forfait »."
                            }
                        ]
                    }
