                                                "example_id": "258a6c41-14fa-4c83-b798-06395122c1f0",
                                                "sense_id": "8515af56-f471-3f35-8831-584728000211",
                                                "text": "„Ohne die isolierenden Eigenschaften von Gummi und Guttapercha wären die meisten neuen Anwendungen der Elektrotechnik im vorigen Jahrhundert nicht möglich gewesen.“"
                                            }
                                        ],
