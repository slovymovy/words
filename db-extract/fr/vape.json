        "fr-extract.jsonl": [
            {
                "entry_id": "df7f6562-4ad2-3c8a-8f07-4e3c56017972",
                "word": "vape",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b4c7a034-eb1b-48a7-813d-a30c849ed32d",
                        "entry_id": "df7f6562-4ad2-3c8a-8f07-4e3c56017972",
                        "tags": [
                            "plural"
                        ],
                        "form": "vapes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc8fd9f1-d6a8-3987-98cb-27de0644c293",
                        "entry_id": "df7f6562-4ad2-3c8a-8f07-4e3c56017972",
                        "glosses": [
                            "Situation louche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d92e3bb-2681-448e-9807-9a14c6674b1b",
                                "sense_id": "bc8fd9f1-d6a8-3987-98cb-27de0644c293",
                                "text": "Ils renâclaient presque toujours au moment de douiller […] il leur passait une inquiétude […] ils sentaient malgré tout la vape… Que c’était un petit flouze qu’ils reverraient jamais."
                            }
                        ]
                    },
                    {
                        "sense_id": "9aacda0f-840c-3a7b-b3a5-8faec01d9187",
                        "entry_id": "df7f6562-4ad2-3c8a-8f07-4e3c56017972",
                        "glosses": [
                            "Hébétude, somnolence ou perte de connaissance due à la fatigue, à un malaise, aux drogues, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbda0f9-cc7d-4ffb-907c-4fc6f80ed1b9",
                                "sense_id": "9aacda0f-840c-3a7b-b3a5-8faec01d9187",
                                "text": "Tomber dans les vapes."
                            },
                            {
                                "example_id": "3c0da78a-7920-4793-a77c-38f17857cd4c",
                                "sense_id": "9aacda0f-840c-3a7b-b3a5-8faec01d9187",
                                "text": "Il devait [à 11 h du matin] être en pleine vape, quelque part, camé à bloc."
                            },
                            {
                                "example_id": "c1618ff1-2302-4a0c-8387-7098b23a2af0",
                                "sense_id": "9aacda0f-840c-3a7b-b3a5-8faec01d9187",
                                "text": "L’herbe et les trips ne nous stimulent pas vraiment. On s’y est habitués. La vape, c’est à peu près notre état normal. Ça ne nous apporte plus grand chose."
                            }
                        ]
                    },
                    {
                        "sense_id": "2eccd7dc-5ce6-35a2-a922-01ba796039e0",
                        "entry_id": "df7f6562-4ad2-3c8a-8f07-4e3c56017972",
                        "glosses": [
                            "Action de vapoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6cd7c4-d35e-48f7-afae-0d6f9ff70601",
                                "sense_id": "2eccd7dc-5ce6-35a2-a922-01ba796039e0",
                                "text": "Les entreprises ne devraient pas mettre sur la même affiche l’interdiction du vapotage et de la cigarette. Si on alimente le doute sur la vape, les gens vont recommencer à fumer et ce sera bien pire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dccb255-1846-4a2e-8e72-2ff2eeb8c6fd",
                        "source_entry_id": "df7f6562-4ad2-3c8a-8f07-4e3c56017972",
                        "target_lang_word": "haze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e17aeb6b-dfbe-37a7-9c58-0e27eb209bb9",
                                        "entry_id": "3073e30b-cd22-3505-9bf9-f20e80c6357c",
                                        "glosses": [
                                            "Very fine solid particles (smoke, dust) or liquid droplets (moisture) suspended in the air, slightly limiting visibility. (Compare fog, mist.)"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845b9177-f729-4284-bc2b-de71f33e2129",
                                                "sense_id": "e17aeb6b-dfbe-37a7-9c58-0e27eb209bb9",
                                                "text": "Our hopes, however, soon vanished; for before eight o'clock, the serenity of the sky was changed into a thick haze, accompanied with rain."
                                            },
                                            {
                                                "example_id": "e12ca7e4-d736-4f5c-8461-d0b6a8b672c3",
                                                "sense_id": "e17aeb6b-dfbe-37a7-9c58-0e27eb209bb9",
                                                "text": "A blue haze, half dust, half mist, touched the long valley with mystery."
                                            },
                                            {
                                                "example_id": "540d44b9-6564-499d-a701-1a33478e424e",
                                                "sense_id": "e17aeb6b-dfbe-37a7-9c58-0e27eb209bb9",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab6cfd94-f1a0-39ac-89af-6d7e050057a2",
                                        "entry_id": "3073e30b-cd22-3505-9bf9-f20e80c6357c",
                                        "glosses": [
                                            "A reduction of transparency of a clear gas or liquid."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1416960-ffb4-3669-a122-dc2e0ec4de8d",
                                        "entry_id": "3073e30b-cd22-3505-9bf9-f20e80c6357c",
                                        "glosses": [
                                            "An analogous dullness on a surface that is ideally highly reflective or transparent."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13d974de-f056-4c93-906b-cc07ab055ba4",
                                                "sense_id": "a1416960-ffb4-3669-a122-dc2e0ec4de8d",
                                                "text": "The soap left a persistent haze on the drinking glasses."
                                            },
                                            {
                                                "example_id": "3a3c0d46-1b1e-43d8-a996-ae287055382e",
                                                "sense_id": "a1416960-ffb4-3669-a122-dc2e0ec4de8d",
                                                "text": "The furniture has a haze, possibly from some kind of wax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba91ba49-6a9a-353a-8dde-c3c573633bea",
                                        "entry_id": "3073e30b-cd22-3505-9bf9-f20e80c6357c",
                                        "glosses": [
                                            "Any state suggestive of haze in the atmosphere, such as mental confusion or vagueness of memory."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec16e2ea-2319-46bc-a5e7-26c1ab54a3ef",
                                                "sense_id": "ba91ba49-6a9a-353a-8dde-c3c573633bea",
                                                "text": "And is it that the haze of grief\n⁠Hath stretch’d my former joy so great?\n⁠The lowness of the present state,\nThat sets the past in this relief?"
                                            },
                                            {
                                                "example_id": "d2df512a-7b36-433e-80c5-3fb1664acad5",
                                                "sense_id": "ba91ba49-6a9a-353a-8dde-c3c573633bea",
                                                "text": "In my haze of alcohol, I thought for one crazy instant that he had plumbed my secret."
                                            },
                                            {
                                                "example_id": "f0566d99-8e92-4319-9518-1300d50fa39c",
                                                "sense_id": "ba91ba49-6a9a-353a-8dde-c3c573633bea",
                                                "text": "But these tasks are difficult for the recent history of the form, since our perceptions are clouded by the haze of historical proximity."
                                            },
                                            {
                                                "example_id": "a4d1da92-31d2-41e9-99a0-029919cd74d3",
                                                "sense_id": "ba91ba49-6a9a-353a-8dde-c3c573633bea",
                                                "text": "Because he chose to be \"a citizen of somewhere else,\" we glimpse him now only \"through the haze of memory.\""
                                            },
                                            {
                                                "example_id": "616a8187-aa02-45a5-8062-8977cb44995c",
                                                "sense_id": "ba91ba49-6a9a-353a-8dde-c3c573633bea",
                                                "text": "I've spent years in a haze, trying to forget my past. Sakaar seemed like the best place to drink, and to forget... and to die, one day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f26d69b-d99e-3b9f-9511-7f845b2f2a8e",
                                        "entry_id": "3073e30b-cd22-3505-9bf9-f20e80c6357c",
                                        "glosses": [
                                            "The degree of cloudiness or turbidity in a clear glass or plastic, measured in percent."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6f0cbc1-21f2-46c7-b48b-203dee4985c8",
                                                "sense_id": "1f26d69b-d99e-3b9f-9511-7f845b2f2a8e",
                                                "text": "Haze is listed as a percent value and, typically, is about 1% for meat film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ea85df-1abd-3038-aa7b-e7eabfbe1095",
                                        "entry_id": "3073e30b-cd22-3505-9bf9-f20e80c6357c",
                                        "glosses": [
                                            "Any substance causing turbidity in beer or wine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af11e015-7f82-4635-9e90-267ee83c4ee0",
                                                "sense_id": "c6ea85df-1abd-3038-aa7b-e7eabfbe1095",
                                                "text": "Various clarifying and fining agents are used in winemaking to remove hazes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47268a52-08cf-3dc3-9b82-f31f54d453c8",
                                        "entry_id": "f8fe1719-75a9-3ba0-9738-d11313751fa1",
                                        "glosses": [
                                            "To be or become hazy, or thick with haze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68375a30-0c1d-4e00-879f-937054b86f21",
                                                "sense_id": "47268a52-08cf-3dc3-9b82-f31f54d453c8",
                                                "text": "Pyramids of clouds now fringed its edge, and the centre had hazed into a sandy mist."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b0953bc-9ea1-3cd5-a911-8f4f093d65ee",
                                        "entry_id": "cbf10b1d-b500-3bc9-a382-a06fc5918027",
                                        "glosses": [
                                            "To perform an unpleasant initiation ritual upon a usually non-consenting individual, especially freshmen to a closed community such as a college fraternity or military unit."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a12eb333-6dc5-3e52-9445-7e86ad06278c",
                                        "entry_id": "cbf10b1d-b500-3bc9-a382-a06fc5918027",
                                        "glosses": [
                                            "To oppress or harass by forcing to do hard and unnecessary work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbe854e-bc62-45ec-9a03-050ee7ab1fbe",
                                                "sense_id": "a12eb333-6dc5-3e52-9445-7e86ad06278c",
                                                "text": "[…] when the young man whirled his horse, “hazed” Jupiter in circles and belaboured him with a rawhide quirt, […] He ceased his cavortings […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e00c6b-f4b4-3966-ac11-e69e2407444d",
                                        "entry_id": "cbf10b1d-b500-3bc9-a382-a06fc5918027",
                                        "glosses": [
                                            "In a rodeo, to assist the bulldogger by keeping (the steer) running in a straight line."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23b8aa9b-fa3a-3aac-95e6-2b5c6ca7d9d5",
                                        "entry_id": "cbf10b1d-b500-3bc9-a382-a06fc5918027",
                                        "glosses": [
                                            "To use aversive stimuli on (a wild animal, such as a bear) to encourage it to keep its distance from humans."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b02e73-6148-415c-8647-ed17310b555d",
                                                "sense_id": "23b8aa9b-fa3a-3aac-95e6-2b5c6ca7d9d5",
                                                "text": "Hazing a bear involves creating a \"negative experience for a bear that seeks out human food or loses its natural avoidance of humans and developed areas,\" the release said. That involves using non-lethal rubber shotgun slugs, or rubber rounds and noise-deterrent rounds in sequence to scare bears away, according to the release."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
