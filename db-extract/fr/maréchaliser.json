                "senses": [
                    {
                        "sense_id": "a6203fcc-4e93-34de-a3f5-6880745ab8aa",
                        "entry_id": "34414742-2825-3430-ac8a-44ae63f5f4c0",
                        "glosses": [
                            "Donner un caractère lié à un maréchal (en particulier le maréchal Philippe Pétain) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22b3cdb1-151c-4c71-a738-e219d1e34b21",
                                "sense_id": "a6203fcc-4e93-34de-a3f5-6880745ab8aa",
                                "text": "La période du gouvernement de Vichy se caractérise, du point de vue de son intérêt pour les jeunes, par l’instauration d’une politique activiste visant à former une jeunesse « maréchalisée »."
                            },
                            {
                                "example_id": "693c0537-f557-4cf9-b88a-ba55eac6d8a7",
                                "sense_id": "a6203fcc-4e93-34de-a3f5-6880745ab8aa",
                                "text": "La Saint-Philippe se célébrait le 1ᵉʳ mai, ce qui contribua à « maréchaliser » cette journée."
                            },
                            {
                                "example_id": "b6dc8de1-b2a4-4f76-a04b-6218d64f3a1a",
                                "sense_id": "a6203fcc-4e93-34de-a3f5-6880745ab8aa",
                                "text": "Vous ne voulez pas caporaliser les ouvriers, mais les maréchaliser !"
                            }
                        ]
                    }
