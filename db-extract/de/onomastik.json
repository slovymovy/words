                    {
                        "form_id": "0e9e66ed-e29c-402d-a255-682352ffab3e",
                        "entry_id": "a0145ffe-a813-3600-b437-1ea387a2b1b4",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Onomastik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                        "entry_id": "a0145ffe-a813-3600-b437-1ea387a2b1b4",
                        "glosses": [
                            "linguistische Disziplin, die sich der Erforschung von Eigennamen widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e92c8d0-84ad-4eb1-ad6f-47cae4e4a90e",
                                "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                                "text": "Die Onomastik erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                            },
                            {
                                "example_id": "797fccd7-fec4-47df-81b9-7555329b2e55",
                                "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                                "text": "„Aber auch und vor allem Leipzig gilt als traditionelles Zentrum der Onomastik, wie Fachwissenschaftler die Namenkunde nennen.“"
                            },
                            {
                                "example_id": "9d639b39-47bb-4dc7-b3ac-4e1f315399bf",
                                "sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                                "text": "„Dieser Frage sind verschiedene Forschungsrichtungen wie Onomastik und Logik, Grammatik und Zeichentheorie, Pragma- und Textlinguistik nachgegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fffaa9cd-af0e-4647-ad2d-1a42158d4cfe",
                        "source_entry_id": "a0145ffe-a813-3600-b437-1ea387a2b1b4",
                        "source_sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                        "source_sense_description": "Linguistik: linguistische Disziplin, die sich der Erforschung von Eigennamen widmet",
                        "target_lang_word": "onomastics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onomastics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                                        "entry_id": "36e92e57-070f-3ce4-a314-bea618fac363",
                                        "glosses": [
                                            "The branch of lexicology devoted to the study of names and naming, especially the origins of names."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce0e7a5-f281-4e87-9d0f-9da1face1247",
                                                "sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                                                "text": "Her father had long been a student of onomastics, and loved to unpack the names of people they encountered as children."
                                            },
                                            {
                                                "example_id": "2579a443-f9aa-4c61-b630-042d0b558cf2",
                                                "sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                                                "text": "From the point of view of onomastics, proper names fulfill many functions (individualizing, localizing, differentiating etc.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fd09f0a-f7cf-4588-957e-dcc58975bbbd",
                        "source_entry_id": "a0145ffe-a813-3600-b437-1ea387a2b1b4",
                        "source_sense_id": "dc3cfbf4-7e4e-3641-a92a-91bd768dcd62",
                        "source_sense_description": "Linguistik: linguistische Disziplin, die sich der Erforschung von Eigennamen widmet",
                        "target_lang_word": "onomatology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onomatology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8d6127-a8f9-3447-ad49-4e7623f77a81",
                                        "entry_id": "73f66736-f7e1-3054-91c5-51b439714dd0",
                                        "glosses": [
                                            "The study of the origins of names; onomastics."
