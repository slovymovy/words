                    "frequency": "High",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut jamais <w>couper</w> la parole quand une personne s'exprime."
                        },
                        {
                            "text": "L'électricien doit <w>couper</w> le courant avant de réparer cette prise murale."
