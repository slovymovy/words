                                    {
                                        "sense_id": "e4497cc0-df77-34f7-b353-ee2f2b757563",
                                        "entry_id": "c58ce341-39bc-381c-bf72-c71e2bc4919f",
                                        "glosses": [
                                            "A disemboweling; the removal of viscera."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83320adb-9728-4dff-9cf5-b78e41981081",
                                                "sense_id": "e4497cc0-df77-34f7-b353-ee2f2b757563",
                                                "text": "The evisceration of the animal was accomplished with a single blow of the knife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f6815c-2178-375e-a57f-00e953cba663",
                                        "entry_id": "c58ce341-39bc-381c-bf72-c71e2bc4919f",
                                        "glosses": [
                                            "A vigorous verbal or physical assault."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4a1c8fa-17b5-4ed6-a322-71443d7c90ab",
                                                "sense_id": "d6f6815c-2178-375e-a57f-00e953cba663",
                                                "text": "The critic delivered another evisceration of the latest movie."
                                            },
                                            {
                                                "example_id": "5f799ecd-280d-4050-bdf4-4b1414f66107",
                                                "sense_id": "d6f6815c-2178-375e-a57f-00e953cba663",
                                                "text": "If you were a Belgian, it was pretty and what you would have expected from your boys. If you were a Scot it was painful, an evisceration of McLeish's notion that his team were good enough to go \"toe-to-toe\" with the third best team in the world. Delusional."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
