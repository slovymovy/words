                    {
                        "sense_id": "6b3c0cd1-661c-35a6-86b3-01795f119dea",
                        "entry_id": "98721fcc-0704-3f46-840a-3f9cab2684b9",
                        "glosses": [
                            "Bauteileträger aus Isolierstoff, dessen Leiterbahnen entweder aus einer Kupferkaschierung geätzt oder gefräst, oder additiv aufgebracht wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f084af-e3a5-499e-ab58-773fcdfae98e",
                                "sense_id": "6b3c0cd1-661c-35a6-86b3-01795f119dea",
                                "text": "Klassische Leiterplatten wurden bestückt, indem die Anschlüsse von bedrahteten Bauteilen durch Bohrungen von der Bestückungsseite her gesteckt und auf der Lötseite per Hand oder Tauchlötverfahren mit den Leiterbahnen verlötet wurden."
                            },
                            {
                                "example_id": "3155a091-8aeb-470b-9642-42ad8c629364",
                                "sense_id": "6b3c0cd1-661c-35a6-86b3-01795f119dea",
                                "text": "„Der größte Teil einseitiger und doppelseitiger durchkontaktierter Leiterplatten wird fotochemisch hergestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
