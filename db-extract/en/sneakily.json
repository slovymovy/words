                        "source_entry_id": "4d1c3777-b415-38fa-bc53-d5217eefc874",
                        "source_sense_id": "8cc77c35-a7d6-35a8-b42b-47f392c67c15",
                        "source_sense_description": "in a sneaky manner",
                        "target_lang_word": "in het geniep",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in het geniep",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "110c423f-3be6-3d0c-aae0-a54cad8afbc3",
                                        "entry_id": "7ce150a1-9675-3051-9df6-a460a859cd8b",
                                        "glosses": [
                                            "opzettelijk verborgen om een ongunstige reactie van anderen te voorkomen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e37840c-1915-4acc-b941-b1eba45df55d",
                                                "sense_id": "110c423f-3be6-3d0c-aae0-a54cad8afbc3",
                                                "text": "⧖Of 't geen ons Frans Pedant zo deftiglijk vermelt,\nDat op de klapbank der Poëten wordt verteld,\nDaar hij in het geniep door listig dankbetuigen\nAan magre prammen, van Geveinstheid, weet te zuigen."
                                            },
                                            {
                                                "example_id": "daf5bba2-1516-4f26-814c-2bc585954b37",
                                                "sense_id": "110c423f-3be6-3d0c-aae0-a54cad8afbc3",
                                                "text": "Het enige taboe was alles dat met Japan te maken had, omdat mijn grootmoeder in een jappenkamp had gezeten. Dus geen Japanse elektronica, geen Japanse auto, geen Japanse keuken. En zo was ik van kindsbeen af geobsedeerd door dat land, verzamelde in het geniep kimono’s, las als tiener Mishima en Tanizaki en kon al sushi maken in een tijd waarin de rest van Nederland nog dacht dat wasabi een schoonmaakmiddel was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1cbf2b0-df4c-4347-838d-3c1f4e156c5a",
                        "source_entry_id": "4d1c3777-b415-38fa-bc53-d5217eefc874",
                        "source_sense_id": "8cc77c35-a7d6-35a8-b42b-47f392c67c15",
                        "source_sense_description": "in a sneaky manner",
                        "target_lang_word": "sournoisement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sournoisement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                        "entry_id": "c62cf84c-3e41-3647-bfdc-8a464f363dda",
                                        "glosses": [
                                            "D’une manière sournoise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd276f96-3e73-4f60-9110-a394c2c4f647",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "Le cabinet de Vienne se déterminait sournoisement à la guerre,"
                                            },
                                            {
                                                "example_id": "a50a25ef-bedd-411c-8756-493b01efabf9",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "Il pressentait que l’eau triompherait des semelles sans résistance, et, sournoisement, s’infiltrerait jusqu'aux chevilles."
                                            },
                                            {
                                                "example_id": "66fe3a70-7820-4436-89b5-e4c32c2adb76",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "On n'échappe pas aux morsures de l’ypérite qui, sournoisement, s’accroche à la peau."
                                            },
                                            {
                                                "example_id": "71fb032d-085a-428a-b76b-08954977115b",
                                                "sense_id": "1af19c7d-cff0-3f63-afdf-0ba0a823c846",
                                                "text": "Parti de Marrakech pour se rendre à Fez, il ne parvint que jusqu’à l’Oued El-Abid, au Tedla, où il succomba subitement à une maladie qui le minait sournoisement depuis longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce542808-a07d-4278-ba3c-f9993e144e3f",
                        "source_entry_id": "4d1c3777-b415-38fa-bc53-d5217eefc874",
