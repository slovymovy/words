                    {
                        "form_id": "32924740-9173-4605-8a89-5bdd4052f2f7",
                        "entry_id": "cca3811c-e4f3-303b-ae44-7a06666752f5",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
