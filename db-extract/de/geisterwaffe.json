                                "target_senses": [
                                    {
                                        "sense_id": "7d6dc0d8-ece8-3543-86ab-43b76d96a5c3",
                                        "entry_id": "335e4900-fc7f-3df7-a69d-c79eda63273e",
                                        "glosses": [
                                            "A gun without serial numbers that cannot be easily tracked, especially a homemade gun built with nonregistered, partially finished, or 3D printed components."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cafc612-00fa-4369-8dc3-ba248f88a625",
                                                "sense_id": "7d6dc0d8-ece8-3543-86ab-43b76d96a5c3",
                                                "text": "The two companies warrant attention because their marketing focuses “on the anonymous, untraceable nature of the guns they allow to be made — and the many examples of ghost guns used in crimes,” Adam Skaggs, chief counsel at the center, said in an email."
                                            },
                                            {
                                                "example_id": "a3cea4e9-ef9b-47da-bb1c-ba5e96620d7f",
                                                "sense_id": "7d6dc0d8-ece8-3543-86ab-43b76d96a5c3",
                                                "text": "In New York, state lawmakers announced legislation on Monday that would require makers of ghost guns to have a gunsmith license and register the firearms."
                                            },
                                            {
                                                "example_id": "8abac952-9d06-47fc-89fe-3ed22fd9679b",
                                                "sense_id": "7d6dc0d8-ece8-3543-86ab-43b76d96a5c3",
                                                "text": "The suspects in New Jersey are accused of trying to sell several homemade AR-15 assault-style rifles that are known as ghost guns because they cannot be tracked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6650dbb0-67bb-369d-b098-33e403815fbe",
                                        "entry_id": "335e4900-fc7f-3df7-a69d-c79eda63273e",
                                        "glosses": [
                                            "A gun that is not detectable by standard gun detection measures, such as a gun without much metal and thus unable to set off metal detectors."
                                        ],
