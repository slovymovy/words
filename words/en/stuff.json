{
    "word_family": [
        "stuffing",
        "stuffy",
        "stuffed",
        "unstuff"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f526e141-5d34-3c25-8ed7-258103c5c686",
                    "sense_definition": "Miscellaneous items, objects, or personal belongings, often referred to in a general or unspecified way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pick up all your <w>stuff</w> from the living room floor.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, собери все свои <w>вещи</w> с пола в гостиной.",
                                "zh": "请把客厅地板上你所有的<w>东西</w>都捡起来。"
                            }
                        },
                        {
                            "text": "I have too much <w>stuff</w> in my bag to carry it comfortably.",
                            "target_lang_translations": {
                                "ru": "У меня в сумке слишком много <w>вещей</w>, чтобы нести её с удобством.",
                                "zh": "我包里的<w>东西</w>太多了，背着很不舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gear",
                        "junk",
                        "things",
                        "belongings",
                        "items"
                    ],
                    "common_phrases": [
                        "all my stuff",
                        "stuff like that",
                        "and stuff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Различные предметы, вещи или личное имущество, о которых часто говорят в общем или неопределенном смысле.",
                        "zh": "指各种杂物、物品或个人所属的物件，通常以笼统或不明确的方式提及。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вещи",
                                "target_lang_sense_clarification": "предметы, имущество"
                            },
                            {
                                "target_lang_word": "барахло",
                                "target_lang_sense_clarification": "разг. вещи, пожитки"
                            },
                            {
                                "target_lang_word": "штуки",
                                "target_lang_sense_clarification": "разг. предметы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "东西",
                                "target_lang_sense_clarification": "泛指物品"
                            },
                            {
                                "target_lang_word": "物品",
                                "target_lang_sense_clarification": "指具体的物件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72e44794-69fe-3062-bb7c-0008e8055224",
                    "sense_definition": "The material or substance out of which something is made or formed, whether physical or abstract.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero of the story was made of sterner <w>stuff</w> than his enemies expected.",
                            "target_lang_translations": {
                                "ru": "Герой рассказа был сделан из более крепкого <w>материала</w>, чем ожидали его враги.",
                                "zh": "故事里的英雄比敌人预想的更有<w>骨气</w>。"
                            }
                        },
                        {
                            "text": "She bought some thick woollen <w>stuff</w> to make warm curtains for the winter.",
                            "target_lang_translations": {
                                "ru": "Она купила плотную шерстяную <w>ткань</w>, чтобы сшить теплые шторы на зиму.",
                                "zh": "她买了一些厚羊毛<w>料子</w>来做冬天的保暖窗帘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "material",
                        "substance",
                        "matter"
                    ],
                    "common_phrases": [
                        "sterner stuff",
                        "stuff of dreams"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал или вещество, из которого что-либо сделано или сформировано, будь то физическое или абстрактное.",
                        "zh": "构成某物或某事的材料或物质，无论是实体的还是抽象的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материал",
                                "target_lang_sense_clarification": "сырьё, ткань"
                            },
                            {
                                "target_lang_word": "вещество",
                                "target_lang_sense_clarification": "субстанция"
                            },
                            {
                                "target_lang_word": "материя",
                                "target_lang_sense_clarification": "ткань, субстанция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "材料",
                                "target_lang_sense_clarification": "制作某物的原料"
                            },
                            {
                                "target_lang_word": "物质",
                                "target_lang_sense_clarification": "构成实体的成分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "613841b7-2845-3be4-9eec-2e827ca1e4bb",
                    "sense_definition": "Foolish ideas, worthless actions, or nonsense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to him because he is talking absolute <w>stuff</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его, потому что он несет полную <w>чепуху</w>.",
                                "zh": "别听他瞎说，他完全是在讲<w>废话</w>。"
                            }
                        },
                        {
                            "text": "I have never heard such <w>stuff</w> and nonsense in all my life.",
                            "target_lang_translations": {
                                "ru": "Я никогда в жизни не слышал подобного <w>вздора</w> и бессмыслицы.",
                                "zh": "我这辈子从没听过这么<w>荒唐</w>的胡言乱语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "nonsense",
                        "rot",
                        "trash",
                        "garbage",
                        "tripe",
                        "drivel"
                    ],
                    "common_phrases": [
                        "stuff and nonsense"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупые идеи, бесполезные действия или бессмыслица.",
                        "zh": "愚蠢的想法、无意义的行为或胡言乱语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чепуха",
                                "target_lang_sense_clarification": "бессмыслица"
                            },
                            {
                                "target_lang_word": "ерунда",
                                "target_lang_sense_clarification": "вздор"
                            },
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "глупости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废话",
                                "target_lang_sense_clarification": "无意义的话"
                            },
                            {
                                "target_lang_word": "胡说",
                                "target_lang_sense_clarification": "没有根据的言论"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ab9ab91-3377-3a80-911f-becdf29e26cb",
                    "sense_definition": "Illegal narcotic drugs, especially heroin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the dealer for selling <w>stuff</w> on the street corner.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала дилера за продажу <w>дури</w> на углу улицы.",
                                "zh": "警察逮捕了那个在街角卖<w>毒品</w>的贩子。"
                            }
                        },
                        {
                            "text": "He spent all his money on the <w>stuff</w> and ruined his health.",
                            "target_lang_translations": {
                                "ru": "Он потратил все свои деньги на <w>наркоту</w> и подорвал здоровье.",
                                "zh": "他把所有的钱都花在<w>毒品</w>上，毁了自己的健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dope",
                        "gear"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконные наркотические средства, особенно героин.",
                        "zh": "非法麻醉药品，尤指海洛因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наркота",
                                "target_lang_sense_clarification": "сленг. наркотики"
                            },
                            {
                                "target_lang_word": "дурь",
                                "target_lang_sense_clarification": "сленг. наркотики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒品",
                                "target_lang_sense_clarification": "非法药物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65bc78c7-166e-3352-ac97-f5f53376b0cb",
                    "sense_definition": "To fill a space tightly by pushing a lot of things into it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fill_cram",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to <w>stuff</w> all her dirty clothes into the washing machine at once.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>запихнуть</w> всю свою грязную одежду в стиральную машину за один раз.",
                                "zh": "她试图一次性把所有脏衣服都<w>塞</w>进洗衣机里。"
                            }
                        },
                        {
                            "text": "You cannot just <w>stuff</w> the papers into the drawer without organizing them.",
                            "target_lang_translations": {
                                "ru": "Нельзя просто <w>засовывать</w> бумаги в ящик, не разложив их.",
                                "zh": "你不能不整理就直接把文件<w>塞</w>进抽屉里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cram",
                        "pack",
                        "jam",
                        "squeeze"
                    ],
                    "common_phrases": [
                        "stuff into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно заполнять пространство, заталкивая в него много вещей.",
                        "zh": "通过强行塞入大量物品来紧密地填满空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набивать",
                                "target_lang_sense_clarification": "плотно наполнять"
                            },
                            {
                                "target_lang_word": "запихивать",
                                "target_lang_sense_clarification": "с силой вталкивать"
                            },
                            {
                                "target_lang_word": "засовывать",
                                "target_lang_sense_clarification": "небрежно класть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞",
                                "target_lang_sense_clarification": "填入或挤入"
                            },
                            {
                                "target_lang_word": "填满",
                                "target_lang_sense_clarification": "使空间充满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd36f1d-3e08-3d8e-9a67-56f99e71bcd2",
                    "sense_definition": "To fill food, such as poultry or vegetables, with a mixture of ingredients before cooking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We usually <w>stuff</w> the turkey with herbs and breadcrumbs for Thanksgiving.",
                            "target_lang_translations": {
                                "ru": "Мы обычно <w>фаршируем</w> индейку травами и панировочными сухарями на День благодарения.",
                                "zh": "感恩节我们通常会在火鸡里<w>填入</w>香草和面包屑。"
                            }
                        },
                        {
                            "text": "It takes a long time to <w>stuff</w> the peppers with the spicy rice mixture.",
                            "target_lang_translations": {
                                "ru": "Требуется много времени, чтобы <w>начинить</w> перцы острой рисовой смесью.",
                                "zh": "把辣味米饭馅<w>填入</w>辣椒里需要很长时间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stuff the turkey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять еду (птицу, овощи) смесью ингредиентов перед приготовлением.",
                        "zh": "在烹饪前将配料混合物填入食物（如禽类或蔬菜）内部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фаршировать",
                                "target_lang_sense_clarification": "начинять еду"
                            },
                            {
                                "target_lang_word": "начинять",
                                "target_lang_sense_clarification": "заполнять начинкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞入",
                                "target_lang_sense_clarification": "填入馅料"
                            },
                            {
                                "target_lang_word": "填馅",
                                "target_lang_sense_clarification": "放入馅料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3342b6d-dc50-3f7f-b40e-41e3ba036582",
                    "sense_definition": "To eat a large amount of food greedily until one is full.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children sat on the sofa and <w>stuffed</w> themselves with chocolate cake.",
                            "target_lang_translations": {
                                "ru": "Дети сидели на диване и <w>объедались</w> шоколадным тортом.",
                                "zh": "孩子们坐在沙发上，<w>大吃</w>巧克力蛋糕。"
                            }
                        },
                        {
                            "text": "I really <w>stuffed</w> myself at dinner and now I cannot move.",
                            "target_lang_translations": {
                                "ru": "Я действительно <w>набил живот</w> за ужином и теперь не могу пошевелиться.",
                                "zh": "晚饭我吃得太<w>撑</w>了，现在动弹不得。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stuff one's face",
                        "gorge",
                        "pig out"
                    ],
                    "common_phrases": [
                        "stuff oneself"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жадно есть большое количество еды до полного насыщения.",
                        "zh": "贪婪地吃大量食物直到饱腹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объедаться",
                                "target_lang_sense_clarification": "есть слишком много"
                            },
                            {
                                "target_lang_word": "набивать живот",
                                "target_lang_sense_clarification": "разг. плотно есть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大吃大喝",
                                "target_lang_sense_clarification": "过量进食"
                            },
                            {
                                "target_lang_word": "塞满",
                                "target_lang_sense_clarification": "指把肚子吃撑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ebacf7c-c028-3a20-a7b9-3067550c21ad",
                    "sense_definition": "To block a passage, especially the nose, making it difficult to breathe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My nose is completely <w>stuffed</w> up because of this terrible cold.",
                            "target_lang_translations": {
                                "ru": "У меня полностью <w>заложен</w> нос из-за этой ужасной простуды.",
                                "zh": "因为这场重感冒，我的鼻子完全<w>堵</w>住了。"
                            }
                        },
                        {
                            "text": "The dust began to <w>stuff</w> up the ventilation system.",
                            "target_lang_translations": {
                                "ru": "Пыль начала <w>забивать</w> систему вентиляции.",
                                "zh": "灰尘开始<w>堵塞</w>通风系统。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stuffed up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блокировать проход, особенно нос, затрудняя дыхание.",
                        "zh": "阻塞通道，尤指鼻腔，导致呼吸困难。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закладывать",
                                "target_lang_sense_clarification": "о носе"
                            },
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "закупоривать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堵塞",
                                "target_lang_sense_clarification": "不通畅"
                            },
                            {
                                "target_lang_word": "塞住",
                                "target_lang_sense_clarification": "被填满而无法通过"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23cc087c-29f2-3c6c-82e1-d9fc537456c9",
                    "sense_definition": "Used to express anger, contempt, or rejection towards something or someone.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you don't like the way I work, you can <w>stuff</w> it.",
                            "target_lang_translations": {
                                "ru": "Если тебе не нравится, как я работаю, можешь <w>засунуть</w> это.",
                                "zh": "如果你不喜欢我的工作方式，那就<w>滚蛋</w>吧。"
                            }
                        },
                        {
                            "text": "He told his boss to <w>stuff</w> the job because he was tired of the low pay.",
                            "target_lang_translations": {
                                "ru": "Он сказал начальнику <w>засунуть</w> эту работу, потому что устал от низкой зарплаты.",
                                "zh": "他告诉老板这份工作他<w>不干了</w>，因为他厌倦了低薪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stuff it"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "impolite"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения гнева, презрения или отказа по отношению к чему-либо или кому-либо.",
                        "zh": "用于表达对某人或某事的愤怒、蔑视或拒绝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засунуть",
                                "target_lang_sense_clarification": "груб. в выражении 'засунь это...'"
                            },
                            {
                                "target_lang_word": "послать",
                                "target_lang_sense_clarification": "груб. отвергнуть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滚一边去",
                                "target_lang_sense_clarification": "粗鲁的拒绝"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9b8333d-efb0-3525-971a-4a5563e6791d",
                    "sense_definition": "To fill the skin of a dead animal to make it look alive for display.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "taxidermy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter decided to <w>stuff</w> the bear he caught and display it in his cabin.",
                            "target_lang_translations": {
                                "ru": "Охотник решил <w>сделать чучело</w> из пойманного медведя и выставить его в своей хижине.",
                                "zh": "猎人决定把他捕到的熊<w>做成标本</w>，摆在小屋里。"
                            }
                        },
                        {
                            "text": "It requires great skill to <w>stuff</w> a bird so that it looks natural.",
                            "target_lang_translations": {
                                "ru": "Требуется большое мастерство, чтобы <w>набить</w> птицу так, чтобы она выглядела естественно.",
                                "zh": "把鸟<w>做成标本</w>并使其看起来自然需要高超的技巧。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набивать шкуру мертвого животного для придания ей живого вида для демонстрации.",
                        "zh": "填充死去的动物皮毛，使其看起来像活着一样以供展示。"
                    },
                    "translations": {
                        "ru": [
