                "translations": [
                    {
                        "translation_id": "92385a86-5566-429a-af55-9443dd336fe2",
                        "source_entry_id": "681d137e-4214-3644-9672-c8e54a558589",
                        "source_sense_description": "to raise again or anew",
                        "target_lang_word": "rehausser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rehausser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3be0e4a4-502a-37a1-be08-72daf903ee62",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Hausser davantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60926892-ab8d-48d5-83af-d3d94d82e605",
                                                "sense_id": "3be0e4a4-502a-37a1-be08-72daf903ee62",
                                                "text": "Ce plancher s’est affaissé, il faut le rehausser."
                                            },
                                            {
                                                "example_id": "bd1587c7-68e5-4064-b114-45afe99d595d",
                                                "sense_id": "3be0e4a4-502a-37a1-be08-72daf903ee62",
                                                "text": "Les planchers de cette maison sont trop bas, ils ont besoin d’être rehaussés."
                                            },
                                            {
                                                "example_id": "bded0d58-abd2-4322-a4b9-b64670c5d722",
                                                "sense_id": "3be0e4a4-502a-37a1-be08-72daf903ee62",
                                                "text": "Ce tableau est placé trop bas, il faut le rehausser au niveau de cet autre."
                                            },
                                            {
                                                "example_id": "c7ce2f0a-d655-4293-8b4e-cd5af6083da0",
                                                "sense_id": "3be0e4a4-502a-37a1-be08-72daf903ee62",
                                                "text": "Il faudra rehausser cette muraille de deux mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b125979c-f6d9-3165-8c9e-c98e08f4fe3a",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Relever, en parlant de vertus humaines comme le courage, la ténacité, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b261918f-a9cb-443f-b377-baab45794ecc",
                                                "sense_id": "b125979c-f6d9-3165-8c9e-c98e08f4fe3a",
                                                "text": "Quelque citation latine banale de ci, de là, un aphorisme philosophique ou pédagogique, une ironie forcée mais acerbe, rehaussent son prestige."
                                            },
                                            {
                                                "example_id": "43d271bb-ee56-4f4b-81c4-95769f68d206",
                                                "sense_id": "b125979c-f6d9-3165-8c9e-c98e08f4fe3a",
                                                "text": "Cette victoire rehaussa son courage, lui rehaussa le courage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90c4c72-1ba0-3c3f-a629-e453fe7f2860",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Élever, augmenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c41232-3837-42ee-81ec-4ee202e1c834",
                                                "sense_id": "d90c4c72-1ba0-3c3f-a629-e453fe7f2860",
                                                "text": "Le prix du blé est rehaussé."
                                            },
                                            {
                                                "example_id": "394a3fc8-8225-4a1b-8b9e-2357ca406950",
                                                "sense_id": "d90c4c72-1ba0-3c3f-a629-e453fe7f2860",
                                                "text": "Cette circonstance a rehaussé le prix, la valeur des actions de cette société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c83175-2111-39c7-b836-8f2a62377e23",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Augmenter la valeur numéraire ou nominale, en parlant de monnaie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "681a78e0-fdc9-3852-abb6-5f220d0346b9",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Faire paraître davantage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e92d03-b5d0-48dc-9f0f-393bf2447bd0",
                                                "sense_id": "681a78e0-fdc9-3852-abb6-5f220d0346b9",
                                                "text": "Nous laisserons de côté l’Asphodeline lutea, le vulgaire Bâton de Jacob, qui rehausse les vieux jardins, qu’il orne de ses longues inflorescences dorées, pour nous arrêter à d’autres espèces pour le moins aussi ornementales […]."
                                            },
                                            {
                                                "example_id": "3c483d0a-7b90-40bd-b480-77691909e3dc",
                                                "sense_id": "681a78e0-fdc9-3852-abb6-5f220d0346b9",
                                                "text": "La dryade ne rehausse pas le sous-bois, ni la naïade la fontaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "435f18e6-8c48-3bd0-9bbd-8b91a449545a",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Faire valoir, relever le mérite, en parlant d’une action ; lui donner un nouvel éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f21d49-cdf3-475e-a281-799008cb0e89",
                                                "sense_id": "435f18e6-8c48-3bd0-9bbd-8b91a449545a",
                                                "text": "Cette circonstance rehausse beaucoup le mérite, l’éclat de son action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Retoucher ; ajouter de l’éclat à la peinture d’un bâtiment, à un dessin, à un ornement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84241e86-79e0-4277-9ecc-f3d6dc4f3ab4",
                                                "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                                "text": "La façade était peinte en blanc et les arêtes de la corniche se rehaussaient d’un filet rouge qui en accentuait le profil."
                                            },
                                            {
                                                "example_id": "7d5b17a1-1c50-4ca3-92a9-089ffab32901",
                                                "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                                "text": "Ses yeux bruns étaient bordés de noir ou plutôt meurtris ; sa lèvre supérieure était ornée d’un duvet brun qui dessinait une espèce de fumée ; elle avait les lèvres menues, et son front impérieux était rehaussé par une chevelure jadis noire, mais qui tournait au chinchilla."
                                            },
                                            {
                                                "example_id": "cb43772d-df63-4acd-983a-ab3eafcf8814",
                                                "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                                "text": "Rehausser de blanc des moulures."
                                            },
                                            {
                                                "example_id": "ab029bcf-6357-45ea-9cc0-cd5670b39729",
                                                "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                                "text": "Un dessin rehaussé de blanc, Un dessin dont les lumières sont rendues plus vives par des touches de crayon blanc."
                                            },
                                            {
                                                "example_id": "58ecdbf3-4e70-4a4d-ae73-742bb3bb3d59",
                                                "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                                "text": "Rehausser d’or et de soie des ouvrages de tapisserie, Leur donner plus d’éclat en y mêlant de l’or et de la soie."
                                            },
                                            {
                                                "example_id": "073d51a0-9019-43d6-bfaf-6366a29e8519",
                                                "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                                "text": "Une tapisserie rehaussée d’or et de soie. On dit de même :"
                                            },
                                            {
                                                "example_id": "744ebae7-0bb4-4efa-9987-06cfe7340b24",
                                                "sense_id": "b866927e-6c05-384d-bb9f-424b1a63c058",
                                                "text": "Rehausser de broderie le fond d’une étoffe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ddbddd-84a3-35ef-905c-3136c7e93522",
                                        "entry_id": "6bdea482-24da-3fe2-a59f-566a3cf9ec50",
                                        "glosses": [
                                            "Vanter avec excès, faire beaucoup valoir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735f5917-d32a-4d05-b222-75aecfabb4af",
                                                "sense_id": "94ddbddd-84a3-35ef-905c-3136c7e93522",
                                                "text": "Les historiens espagnols rehaussent les moindres actions de Charles-Quint et déprécient celles de François Ier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
