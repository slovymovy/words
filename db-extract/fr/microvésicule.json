                        "entry_id": "f9d1ede7-2ce5-31ef-a917-080fa3a32b93",
                        "glosses": [
                            "Vésicule microscopique libérée par une cellule, jouant le rôle de messager à destination d’autres cellules."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
