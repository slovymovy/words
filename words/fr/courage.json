                        {
                            "text": "Les sauveteurs ont fait preuve d'un grand <w>courage</w> lors de cette tempête.",
                            "target_lang_translations": {
                                "en": "The rescuers showed great <w>courage</w> during the storm.",
                                "ru": "Спасатели проявили большое <w>мужество</w> во время этого шторма.",
                                "nl": "De reddingswerkers toonden grote <w>moed</w> tijdens deze storm.",
                                "de": "Die Rettungskräfte bewiesen bei diesem Sturm großen <w>Mut</w>.",
                                "pl": "Ratownicy wykazali się wielką <w>odwagą</w> podczas tej burzy.",
                                "it": "I soccorritori hanno dimostrato un grande <w>coraggio</w> durante questa tempesta.",
                                "cs": "Záchranáři během této bouře projevili velkou <w>odvahu</w>.",
                                "tr": "Kurtarma görevlileri bu fırtına sırasında büyük bir <w>cesaret</w> gösterdi.",
                                "es": "Los socorristas demostraron una gran <w>valentía</w> durante esta tormenta.",
                                "zh": "救援人员在这场暴风雨中表现出了极大的<w>勇气</w>。"
                            }
                        },
                        {
                            "text": "Il faut du <w>courage</w> pour exprimer son désaccord devant toute l'assemblée.",
                            "target_lang_translations": {
                                "en": "It takes <w>courage</w> to voice your disagreement in front of the whole assembly.",
                                "ru": "Чтобы высказать несогласие перед всем собранием, нужна <w>смелость</w>.",
                                "nl": "Het vergt <w>moed</w> om in het bijzijn van de hele vergadering je onenigheid te uiten.",
                                "de": "Es erfordert <w>Mut</w>, vor der gesamten Versammlung seinen Widerspruch zu äußern.",
                                "pl": "Trzeba mieć <w>odwagę</w>, żeby wyrazić swój sprzeciw wobec całego zgromadzenia.",
                                "it": "Ci vuole <w>coraggio</w> per esprimere il proprio disaccordo davanti a tutta l'assemblea.",
                                "cs": "Vyjádřit nesouhlas před celým shromážděním vyžaduje <w>odvahu</w>.",
                                "tr": "Tüm meclisin önünde karşı görüşünü dile getirmek için <w>cesaret</w> gerekir.",
                                "es": "Hace falta <w>valor</w> para expresar su desacuerdo delante de toda la asamblea.",
                                "zh": "在全体与会者面前表达不同意见，需要很大的<w>勇气</w>。"
                            }
                        }
