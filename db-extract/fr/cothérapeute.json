                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b5ea08b-f6f8-4fbf-bc91-3046de837fbb",
                                "sense_id": "967b2e46-0fab-3311-a105-b4a9bd82cabd",
                                "text": "Le choix d’un cothérapeute et la façon de travailler conjointement prédiront fortement l’efficacité de la thérapie."
                            },
                            {
                                "example_id": "5667e3e6-0687-459d-9f9b-931137ce7715",
                                "sense_id": "967b2e46-0fab-3311-a105-b4a9bd82cabd",
                                "text": "Dans les années 1960, le pédopsychiatre américain Boris M. Levinson obtient des résultats bénéfiques en utilisant le chien comme « cothérapeute » de l’enfant présentant des troubles psychiatriques."
                            },
                            {
                                "example_id": "2a5cf861-34ef-4bba-9c8f-d73d13892909",
                                "sense_id": "967b2e46-0fab-3311-a105-b4a9bd82cabd",
                                "text": "Le nombre des cothérapeutes est variable selon les équipes."
