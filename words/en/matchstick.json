{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e932c663-63e7-3ff1-afa1-c61214e04874",
                    "sense_definition": "A small, slender piece of wood or cardboard that forms the body of a match.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "match_components",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He built a miniature model of a castle using glue and thousands of <w>matchsticks</w>.",
                            "target_lang_translations": {
                                "zh": "他用胶水和数千根<w>火柴棒</w>搭建了一座城堡微缩模型。"
                            }
                        },
                        {
                            "text": "She took a wooden <w>matchstick</w> and struck it against the side of the box.",
                            "target_lang_translations": {
                                "zh": "她拿出一根木质<w>火柴梗</w>，在火柴盒侧面擦拭了一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden matchstick"
                    ],
                    "target_lang_definitions": {
                        "zh": "火柴梗，即构成火柴主体的细小木棒或硬纸棒"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "火柴梗",
                                "target_lang_sense_clarification": "指火柴杆"
                            },
                            {
                                "target_lang_word": "火柴棒",
                                "target_lang_sense_clarification": "指细木棒"
                            },
                            {
                                "target_lang_word": "火柴杆",
                                "target_lang_sense_clarification": "火柴的细木棍部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "085701ec-f78b-3544-a725-99ccfaf186d2",
                    "sense_definition": "Any object or piece broken, cut, or reduced to a very small and thin sliver.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fragments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fierce storm tore the small wooden boat into <w>matchsticks</w> against the rocks.",
                            "target_lang_translations": {
                                "zh": "猛烈的风暴将小木船砸在岩石上，撞成了<w>碎片</w>。"
                            }
                        },
                        {
                            "text": "Cut the carrots into fine <w>matchsticks</w> before tossing them into the salad.",
                            "target_lang_translations": {
                                "zh": "把胡萝卜切成细<w>丝</w>，然后再拌入沙拉中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shred",
                        "sliver",
                        "splinter"
                    ],
                    "common_phrases": [
                        "crushed to matchsticks"
                    ],
                    "target_lang_definitions": {
                        "zh": "像火柴棍般极细小、细碎的碎片或细丝"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "碎片",
                                "target_lang_sense_clarification": "撞碎成的细小残片"
                            },
                            {
                                "target_lang_word": "细丝",
                                "target_lang_sense_clarification": "切成的极细小条状"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}