                            }
                        },
                        {
                            "text": "She met her husband at an ice cream <w>sociable</w> held in their town square.",
                            "target_lang_translations": {
                                "ru": "Она встретила своего мужа на <w>празднике мороженого</w>, проходившем на городской площади."
