                "senses": [
                    {
                        "sense_id": "22278496-4c2a-34fb-b4b4-4abaec153e50",
                        "entry_id": "03657ab2-ba70-3624-a4b3-6e3d2dcb096a",
                        "glosses": [
                            "Qui se trouve à l’ombre, placé sous un ombrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "504566ce-42a9-4212-bc66-30195ed1d6d6",
                                "sense_id": "22278496-4c2a-34fb-b4b4-4abaec153e50",
                                "text": "On voit encore les beaux chemins ombragés d'arbres, les caravansérails et les bains qu'il fit construire pour les voyageurs."
                            },
                            {
                                "example_id": "5c26f279-7971-451c-a503-a70a6548de50",
                                "sense_id": "22278496-4c2a-34fb-b4b4-4abaec153e50",
                                "text": "Ami exclusif des lieux ombragés et solitaires, il [le lierre] croît loin des rayons du soleil, au sein des bois les plus sombres."
                            },
                            {
                                "example_id": "24893fa8-0343-48c9-b99e-14c37597aff4",
                                "sense_id": "22278496-4c2a-34fb-b4b4-4abaec153e50",
                                "text": "Des photographies commentées un peu plus tard par Michel ou par l’une de mes anciennes bonnes m’ont montré, parmi des adultes en costume clair, une toute petite fille ombragée par une immense capeline de paille, engoncée dans sa longue robe de broderie anglaise dont la jupe se gonfle et risque de l’emporter au large."
                            }
                        ]
                    },
                    {
                        "sense_id": "49cfc7e1-752c-337d-92f3-592a3d69937a",
                        "entry_id": "03657ab2-ba70-3624-a4b3-6e3d2dcb096a",
                        "glosses": [
                            "Couvert, caché comme d'un ombrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c3cc23-9e89-4ce5-9e25-aacc7f5bf301",
                                "sense_id": "49cfc7e1-752c-337d-92f3-592a3d69937a",
                                "text": "Et son feutre à grands poils ombragé d'un panache."
                            },
                            {
                                "example_id": "55a28f1b-95f3-48ca-9510-3cfebaa4eb00",
                                "sense_id": "49cfc7e1-752c-337d-92f3-592a3d69937a",
                                "text": "Il couvre sa belle tête d'un casque d'or ombragé de plumes de héron et d'autruche."
                            }
                        ]
                    },
                    {
                        "sense_id": "f98507d8-9035-38bb-89a1-8ea57d954de4",
                        "entry_id": "03657ab2-ba70-3624-a4b3-6e3d2dcb096a",
                        "glosses": [
                            "Dans l’ombre d’une personne."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b69c31a4-d64f-4e24-a87e-77e1ebe5c00a",
                                "sense_id": "f98507d8-9035-38bb-89a1-8ea57d954de4",
                                "text": "Ombragés en naissant des lauriers paternels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a8fe01c-bfa9-4694-b99d-f09806ff996f",
                        "source_entry_id": "03657ab2-ba70-3624-a4b3-6e3d2dcb096a",
