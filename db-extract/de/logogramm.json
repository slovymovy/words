                        ],
                        "form": "die Logogramme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                        "entry_id": "ebf7b398-daf4-32d9-8319-396fed4f0324",
                        "glosses": [
                            "Zeichen, das symbolisch für ein Wort/Lexem steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9fe95ab-6da9-421a-9e56-b36609ef2883",
                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                "text": "„Wenn diese nicht nur für Begriffe und Ideen standen, sondern für Wörter, spricht man von Logogrammen.“"
                            },
                            {
                                "example_id": "ef00715a-3d2a-4b2b-964f-72acfb6fdf29",
                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                "text": "„Nicht nur die Inhalts-, auch die Ausdrucksseite der Logogramme liegt fest, lässt sich aber nicht aus den einzelnen Segmenten des Zeichens erschließen.“"
                            },
                            {
                                "example_id": "f20333a0-268f-46fe-b895-80e232d193ca",
                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                "text": "Beispiele für Logogramme findet man auf jeder Schreibmaschinentastatur/Computertastatur: §, $, @, %, &."
                            },
                            {
                                "example_id": "1355b854-aa22-4b65-a8f5-8ebe4c1fee15",
                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                "text": "„Das Interessante an der japanischen Schrift in dieser Hinsicht ist, daß sie in systematischer Funktionsdifferenzierung Elemente strukturell verschieden konstituierter Zeichenklassen verwendet: nicht selbst bedeutungstragende Silbenzeichen (Kana) und bedeutungstragende Logogramme (Kanji).“"
                            },
                            {
                                "example_id": "097d1136-f693-41c4-ae6b-c441a7d8ff72",
                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                "text": "„Die ältesten Schriftformen haben mit dem Wortklang überhaupt nichts zu tun. Sie setzen für jede Sache ein Symbol, ein Zeichen, ein Ideo- oder Logogramm.“"
                            },
                            {
                                "example_id": "17b28f30-a9c7-48b0-97d0-828ac2e932fb",
                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                "text": "„Logogramme sind auch unsere Zahlzeichen wie 1, 2, 3.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
