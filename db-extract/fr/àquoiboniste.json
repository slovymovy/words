                            {
                                "example_id": "834485f3-c20f-4b9b-ac07-0584321f8ab2",
                                "sense_id": "684abb4b-a6b5-33da-98c9-48b8d5fb1278",
                                "text": "Parmi les avis récoltés par 20 Minutes lors de son appel à témoignages se dégage une troisième catégorie, probablement la plus nombreuse, les « àquoibonistes »."
                            },
                            {
                                "example_id": "d58ca650-779b-4339-93d4-705b517b3e63",
                                "sense_id": "684abb4b-a6b5-33da-98c9-48b8d5fb1278",
                                "text": "Alexandre Jardin: «Reléguons les àquoibonistes aux oubliettes»."
                            },
                            {
                                "example_id": "8a049be5-86d6-4508-b596-83c8bb6bd7d9",
                                "sense_id": "684abb4b-a6b5-33da-98c9-48b8d5fb1278",
                                "text": "Ce sont des individualistes jouisseurs, des àquoibonistes qui démissionnent avant d’avoir essayé quoi que ce soit."
                            }
                        ]
                    }
