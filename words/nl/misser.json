    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e4034ea-e85f-3c02-bcd0-b6d153257ab5",
                    "sense_definition": "een domme of onhandige fout",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een enorme <w>misser</w> om de datum van de vergadering te vergeten.",
                            "target_lang_translations": {
                                "en": "It was a huge <w>blunder</w> to forget the date of the meeting."
                            }
                        },
                        {
                            "text": "Na die grote <w>misser</w> moest de directeur zijn excuses aanbieden aan het hele team.",
                            "target_lang_translations": {
                                "en": "After that major <w>slip-up</w>, the director had to apologize to the entire team."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunder",
                        "fout",
                        "flater",
                        "bok"
                    ],
                    "antonyms": [
                        "succes",
                        "voltreffer"
                    ],
                    "common_phrases": [
                        "grote misser",
                        "enorme misser"
                    ],
                    "target_lang_definitions": {
                        "en": "a stupid or clumsy mistake"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blunder",
                                "target_lang_sense_clarification": "a stupid or careless mistake"
                            },
                            {
                                "target_lang_word": "slip-up",
                                "target_lang_sense_clarification": "a minor or careless mistake"
                            },
                            {
                                "target_lang_word": "gaffe",
                                "target_lang_sense_clarification": "a socially awkward or embarrassing mistake"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b481d8fd-860c-3ed0-a398-b7e070c5aaf0",
                    "sense_definition": "een poging die niet slaagt, vooral in de sport of bij een kans",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De spits schoot de bal over het doel, wat een pijnlijke <w>misser</w> was voor de club.",
                            "target_lang_translations": {
                                "en": "The striker shot the ball over the goal, which was a painful <w>miss</w> for the club."
                            }
                        },
                        {
                            "text": "Zelfs met een open doel voor zich, maakte de speler een onbegrijpelijke <w>misser</w>.",
                            "target_lang_translations": {
                                "en": "Even with an open goal in front of him, the player made an incomprehensible <w>miss</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mislukking",
                        "foutschot"
                    ],
                    "antonyms": [
                        "doelpunt",
                        "treffer"
                    ],
                    "common_phrases": [
                        "pijnlijke misser",
                        "onbegrijpelijke misser"
                    ],
                    "target_lang_definitions": {
                        "en": "an unsuccessful attempt, especially in sports or when presented with an opportunity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miss",
                                "target_lang_sense_clarification": "failure to hit or reach a target"
                            },
                            {
                                "target_lang_word": "failure",
                                "target_lang_sense_clarification": "lack of success in an attempt"
                            },
                            {
                                "target_lang_word": "botch",
                                "target_lang_sense_clarification": "a failed or poorly executed attempt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2bb52898-cfcc-3b44-aae5-e60211ed240b",
                    "sense_definition": "onverbogen vorm van de vergrotende trap van <w>mis</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vergelijking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kan bijna niet <w>misser</w> gaan dan het gisteren al ging tijdens de presentatie.",
                            "target_lang_translations": {
                                "en": "It can hardly go <w>more wrong</w> than it already did yesterday during the presentation."
                            }
                        },
                        {
                            "text": "Hoewel de eerste schatting fout was, bleek de tweede poging nog veel <w>misser</w>.",
                            "target_lang_translations": {
                                "en": "Although the first estimate was wrong, the second attempt turned out to be even <w>more incorrect</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "comparative form of 'wrong' or 'incorrect'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "more wrong",
                                "target_lang_sense_clarification": "further from the truth or correct path"
                            },
                            {
                                "target_lang_word": "more incorrect",
                                "target_lang_sense_clarification": "having more errors"
                            }
                        ]
                    }
                }
            ]
        }
    ]
