                {
                    "sense_id": "4f973fb4-f65f-31fa-b024-4cc7c524e485",
                    "sense_definition": "Used after an adjective or adverb to strengthen its meaning, similar to 'very'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis_intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain was beautiful <w>indeed</w>.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был <w>поистине</w> прекрасным.",
                                "nl": "Het uitzicht vanaf de top van de berg was <w>inderdaad</w> prachtig.",
                                "pl": "Widok ze szczytu góry był <w>naprawdę</w> piękny.",
                                "de": "Die Aussicht vom Gipfel des Berges war <w>in der Tat</w> wunderschön.",
                                "fr": "La vue depuis le sommet de la montagne était <w>vraiment</w> magnifique.",
                                "it": "La vista dalla cima della montagna era <w>davvero</w> bellissima.",
                                "cs": "Výhled z vrcholu hory byl <w>skutečně</w> nádherný.",
                                "tr": "Dağın zirvesinden manzara <w>gerçekten de</w> çok güzeldi.",
                                "es": "La vista desde la cima de la montaña era <w>verdaderamente</w> hermosa.",
                                "zh": "从山顶看到的景色<w>确实</w>很美。"
                            }
                        },
                        {
                            "text": "It was a very strange day <w>indeed</w>, with weather changing every hour.",
                            "target_lang_translations": {
                                "ru": "Это был <w>действительно</w> очень странный день, погода менялась каждый час.",
                                "nl": "Het was <w>inderdaad</w> een heel vreemde dag, met weer dat elk uur veranderde.",
                                "pl": "To był <w>doprawdy</w> bardzo dziwny dzień, z pogodą zmieniającą się co godzinę.",
                                "de": "Es war <w>wirklich</w> ein sehr seltsamer Tag, an dem sich das Wetter stündlich änderte.",
                                "fr": "C'était <w>en vérité</w> une journée très étrange, avec un temps qui changeait toutes les heures.",
                                "it": "È stata una giornata <w>proprio</w> strana, con il tempo che cambiava ogni ora.",
                                "cs": "Byl to <w>opravdu</w> velmi zvláštní den, kdy se počasí měnilo každou hodinu.",
                                "tr": "Havanın her saat değiştiği, <w>doğrusu</w> çok tuhaf bir gündü.",
                                "es": "Fue un día <w>realmente</w> muy extraño, con el clima cambiando cada hora.",
                                "zh": "那<w>确实</w>是非常奇怪的一天，天气每小时都在变。"
                            }
                        }
