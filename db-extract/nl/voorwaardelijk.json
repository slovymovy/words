                ],
                "senses": [
                    {
                        "sense_id": "5f20bfd3-5830-3a10-9ab8-0247cb967245",
                        "entry_id": "6b31c2c4-81aa-3121-9880-6cd5b212ce19",
                        "glosses": [
                            "conditional (pertaining to a condition)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a92f08f5-123f-4b57-975c-fc8f57f0c023",
                                "sense_id": "5f20bfd3-5830-3a10-9ab8-0247cb967245",
                                "text": "In het contract staan enkele voorwaardelijke clausules.",
                                "translation": "The contract contains some conditional clauses.",
                                "english": "The contract contains some conditional clauses."
                            }
                        ]
                    },
                    {
                        "sense_id": "07f215c5-e7d7-3fe8-b996-8692d70c22a1",
                        "entry_id": "6b31c2c4-81aa-3121-9880-6cd5b212ce19",
                        "glosses": [
                            "probationary; suspended"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254cb636-833a-4f21-b05c-ed7c47e4bd88",
                                "sense_id": "07f215c5-e7d7-3fe8-b996-8692d70c22a1",
                                "text": "De straf werd opgelegd met een voorwaardelijke veroordeling.",
                                "translation": "The punishment was imposed with a probationary sentence.",
                                "english": "The punishment was imposed with a probationary sentence."
                            },
                            {
                                "example_id": "a94efc95-b8fa-4f80-8f6f-4649a0cf6631",
                                "sense_id": "07f215c5-e7d7-3fe8-b996-8692d70c22a1",
                                "text": "De rechter besloot een voorwaardelijke straf op te leggen.",
                                "translation": "The judge decided to impose a conditional sentence.",
                                "english": "The judge decided to impose a conditional sentence."
                            },
                            {
                                "example_id": "42e8d513-e774-4581-9283-9f5c75a6b779",
                                "sense_id": "07f215c5-e7d7-3fe8-b996-8692d70c22a1",
                                "text": "De rechter veroordeelde de man tot een celstraf van 3 jaar voorwaardelijk, met uitzondering van de voorhechtenis, en een boete van 4.000 euro.",
                                "translation": "The judged sentenced the man to 3 years of prison time, probationally, the pre-trial detention excepted, and a fine of 4,000 euros.",
                                "english": "The judged sentenced the man to 3 years of prison time, probationally, the pre-trial detention excepted, and a fine of 4,000 euros."
                            },
                            {
                                "example_id": "c7b68aa2-e6d0-4ddc-b89e-ec9d5abbbf38",
                                "sense_id": "07f215c5-e7d7-3fe8-b996-8692d70c22a1",
                                "text": "Bij een voorwaardelijke straf word je (nog) niet opgesloten. Als je binnen de proeftijd (meestal 1 tot 2 jaar) iets strafbaars doet of je niet houdt aan de voorwaarden die de rechter aan je heeft gesteld, dan gaat je voorwaardelijk opgelegde straf in en kan je worden opgesloten.",
                                "translation": "With a suspended sentence you are not incarcerated (yet). If, within your probation period (usually 1 to 2 years), you commit a punishable act or do not respect the conditions the judge made, your suspended sentence is triggered and you can be incarcerated.",
                                "english": "With a suspended sentence you are not incarcerated (yet). If, within your probation period (usually 1 to 2 years), you commit a punishable act or do not respect the conditions the judge made, your suspended sentence is triggered and you can be incarcerated."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e99c7bb-060b-3947-9716-3ecf0b0b2983",
                        "entry_id": "6b31c2c4-81aa-3121-9880-6cd5b212ce19",
                        "glosses": [
                            "conditional (pertaining to a conditional mood or tense or another grammatical way to express contingency)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25cad1a4-ccc6-47e5-9c31-134f96b600a2",
                                "sense_id": "4e99c7bb-060b-3947-9716-3ecf0b0b2983",
                                "text": "In het Nederlands hebben we een voorwaardelijke wijs om condities uit te drukken.",
                                "translation": "In Dutch, we have a conditional mood to express conditions.",
                                "english": "In Dutch, we have a conditional mood to express conditions."
                            }
                        ]
                    }
