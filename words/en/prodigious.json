                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "buitengewoon",
                                "target_lang_sense_clarification": "Uitzonderlijk in talent of kwaliteit."
                            },
                            {
                                "target_lang_word": "verbazingwekkend",
