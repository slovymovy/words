{
    "word_family": [
        "wholesomeness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13a70d6b-0a30-3749-85c4-9347e711f317",
                    "sense_definition": "Promoting good physical health and well-being.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating <w>wholesome</w> food is essential for maintaining a strong immune system.",
                            "target_lang_translations": {
                                "ru": "Употребление <w>здоровой</w> пищи необходимо для поддержания сильного иммунитета."
                            }
                        },
                        {
                            "text": "The doctor recommended a <w>wholesome</w> diet rich in fruits and vegetables.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал <w>полезную</w> диету, богатую фруктами и овощами."
                            }
                        }
                    ],
                    "synonyms": [
                        "healthy",
                        "healthful"
                    ],
                    "antonyms": [
                        "unwholesome"
                    ],
                    "common_phrases": [
                        "wholesome food",
                        "wholesome diet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствующий укреплению физического здоровья и хорошего самочувствия; полезный для организма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здоровый",
                                "target_lang_sense_clarification": "о пище, образе жизни, полезный для организма"
                            },
                            {
                                "target_lang_word": "полезный",
                                "target_lang_sense_clarification": "для здоровья, питательный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b4df3d1-2a2f-3181-bc7b-1e86cb0ef74a",
                    "sense_definition": "Promoting moral and mental well-being.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie provides <w>wholesome</w> entertainment that the entire family can enjoy together.",
                            "target_lang_translations": {
                                "ru": "Этот фильм предлагает <w>доброе</w> развлечение, которым может наслаждаться вся семья вместе."
                            }
                        },
                        {
                            "text": "She finds <w>wholesome</w> activities like reading and gardening very relaxing after a long day.",
                            "target_lang_translations": {
                                "ru": "Она находит такие <w>здоровые</w> занятия, как чтение и садоводство, очень успокаивающими после долгого дня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wholesome entertainment",
                        "wholesome fun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствующий душевному или нравственному благополучию; благотворный, целомудренный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотворный",
                                "target_lang_sense_clarification": "положительно влияющий на душевное состояние или мораль"
                            },
                            {
                                "target_lang_word": "здоровый",
                                "target_lang_sense_clarification": "о развлечениях, атмосфере; нормальный и правильный"
                            },
                            {
                                "target_lang_word": "нравственный",
                                "target_lang_sense_clarification": "приличный, высокоморальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fc112d5-49ec-3401-93a6-573cc3068cac",
                    "sense_definition": "Decent, innocuous, or pleasant in a simple way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The internet is full of <w>wholesome</w> memes that make people smile.",
                            "target_lang_translations": {
                                "ru": "Интернет полон <w>добрых</w> мемов, которые заставляют людей улыбаться."
                            }
                        },
                        {
                            "text": "He has a <w>wholesome</w> appearance that makes everyone trust him immediately.",
                            "target_lang_translations": {
                                "ru": "У него приятная и <w>располагающая</w> внешность, которая сразу внушает доверие."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wholesome content",
                        "wholesome meme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Милый, добрый, невинный или вызывающий приятные и светлые чувства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душевный",
                                "target_lang_sense_clarification": "искренний, теплый, трогательный"
                            },
                            {
                                "target_lang_word": "добрый",
                                "target_lang_sense_clarification": "безобидный, светлый"
                            },
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "о контенте, внешности; простой и приятный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a92c0a4-0b12-3d81-9b2a-b193de050723",
                    "sense_definition": "Favorable to morals, religion, or prosperity; conducive to good.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community leaders offered <w>wholesome</w> advice to the youth during the town meeting.",
                            "target_lang_translations": {
                                "ru": "Лидеры сообщества дали молодежи <w>здравый</w> совет во время городского собрания."
                            }
                        },
                        {
                            "text": "His <w>wholesome</w> influence helped the organization regain its reputation.",
                            "target_lang_translations": {
                                "ru": "Его <w>благотворное</w> влияние помогло организации восстановить свою репутацию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wholesome advice",
                        "wholesome influence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствующий нравственности, добродетели, общему благу или процветанию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотворный",
                                "target_lang_sense_clarification": "оказывающий положительное влияние"
                            },
                            {
                                "target_lang_word": "добродетельный",
                                "target_lang_sense_clarification": "высоконравственный, направленный на благо"
                            },
                            {
                                "target_lang_word": "здравый",
                                "target_lang_sense_clarification": "о совете, суждении; разумный и полезный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69bb5319-6c6d-376c-9301-3d794cf43c00",
                    "sense_definition": "Marked by wholeness; sound and healthy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structure of the building remains <w>wholesome</w> despite the recent earthquake.",
                            "target_lang_translations": {
                                "ru": "Конструкция здания остаётся <w>крепкой</w>, несмотря на недавнее землетрясение."
                            }
                        },
                        {
                            "text": "A <w>wholesome</w> foundation is necessary for any long-term project to succeed.",
                            "target_lang_translations": {
                                "ru": "<w>Прочный</w> фундамент необходим для успеха любого долгосрочного проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "salubrious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный, крепкий, неповрежденный или надежный по своей структуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "надежный, нерушимый"
                            },
                            {
                                "target_lang_word": "прочный",
                                "target_lang_sense_clarification": "о структуре или фундаменте"
                            },
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "устойчивый, добротный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}