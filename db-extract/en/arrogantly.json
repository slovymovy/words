                        "cross_references": [
                            {
                                "target_word": "зано́счиво",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "da3a77e9-ed60-3c92-a498-ede5fa87ff0c",
                                        "entry_id": "17c8eaff-f0bd-3e60-867e-c3513f9b4e28",
                                        "glosses": [
                                            "наречие к заносчивый; высокомерно, самоуверенно, дерзко"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b09ffc7-a20a-41d3-84e5-82b17504de8f",
                                                "sense_id": "da3a77e9-ed60-3c92-a498-ede5fa87ff0c",
                                                "text": "Во время парада заговорщики держали себя чрезвычайно заносчиво и как бы гордились совершённым преступлением."
                                            },
                                            {
                                                "example_id": "6ce72a88-6cc3-4dc1-b6b3-931468a803c5",
                                                "sense_id": "da3a77e9-ed60-3c92-a498-ede5fa87ff0c",
                                                "text": "Нельзя отрицать, что последний, обороняясь, действовал заносчиво и давал поводы к новым обвинениям."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4abd0f5-5a4c-36c9-b263-c600740e49a7",
                                        "entry_id": "17c8eaff-f0bd-3e60-867e-c3513f9b4e28",
                                        "glosses": [
                                            "оценочная характеристика чьего-либо поведения, чьих-либо действий, поступков как преисполненных высокомерия, самоуверенности, дерзости"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1473ca5b-2839-4bef-8a8c-ee04f2534899",
                                                "sense_id": "d4abd0f5-5a4c-36c9-b263-c600740e49a7",
                                                "text": "Видите, как всё это заносчиво и самоуверенно, несмотря на то, что в существе дела оно вздорно и жалко!"
                                            },
                                            {
                                                "example_id": "ccfde99b-356e-4003-b1c6-d74f0026f7c5",
                                                "sense_id": "d4abd0f5-5a4c-36c9-b263-c600740e49a7",
                                                "text": "Не слишком ли это заносчиво — сравнивать себя с христианами первых веков?"
                                            }
                                        ]
                                    }
                                ]
                            },
