            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8b3c342-1f7b-370b-8656-85380f19d2fc",
                    "sense_definition": "оценка ситуации или объекта как вызывающих интерес, любопытство (в значении сказуемого)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "predicative_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне очень <интересно> изучать русский язык.",
                            "target_lang_translations": {
                                "en": "It is very <w>interesting</w> for me to study the Russian language.",
                                "zh": "我觉得学习俄语非常<w>有意思</w>。"
                            }
                        },
                        {
                            "text": "Детям было <интересно> смотреть этот мультфильм.",
                            "target_lang_translations": {
                                "en": "It was <w>interesting</w> for the children to watch this cartoon.",
                                "zh": "孩子们看这部动画片觉得很<w>有趣</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "любопытно"
                    ],
                    "antonyms": [
                        "неинтересно",
                        "скучно"
                    ],
                    "common_phrases": [
                        "мне интересно",
                        "очень интересно",
                        "стало интересно",
                        "было интересно"
                    ],
                    "target_lang_definitions": {
                        "en": "evaluation of a situation or object as causing interest or curiosity (used as a predicate)",
                        "zh": "用于评价某事或某物引起兴趣或好奇心（作谓语）"
