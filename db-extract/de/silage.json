                                "target_senses": [
                                    {
                                        "sense_id": "74d73b93-1a5d-342f-b4bd-8e4397b5ecb7",
                                        "entry_id": "a91295fd-52ca-305d-83bc-0839c4420f28",
                                        "glosses": [
                                            "Action d’ensiler, de mettre en silo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33dfa71-9eca-488a-aed2-974f244e0aa7",
                                                "sense_id": "74d73b93-1a5d-342f-b4bd-8e4397b5ecb7",
                                                "text": "L’avantage est donc au maïs haché avant l’ensilage, malgré l'embarras que donne cette opération ; d’un autre côté on sera dispensé de hacher lors du désilage. — (Publication industrielle des machines, outils et appareils les plus perfectionnés et les plus récents employés dans les différentes branches de l’industrie française et étrangère, t. 24, page 90, M. Armengaud & A. Morel, 1878)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a46e3a-96f7-37f8-bd42-553cba46769b",
                                        "entry_id": "a91295fd-52ca-305d-83bc-0839c4420f28",
                                        "glosses": [
                                            "La matière mise dans le silo."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f307e79a-d48a-4b36-b447-110df0c90177",
                                                "sense_id": "f1a46e3a-96f7-37f8-bd42-553cba46769b",
                                                "text": "La solution aux problèmes de distribution des ensilages aux animaux est trouvée ; les animaux, qui sont libres, consomment l’ensilage directement au silo."
                                            }
                                        ]
                                    }
