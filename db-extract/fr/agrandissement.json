                "senses": [
                    {
                        "sense_id": "64c7c275-d85a-366a-ab63-3d08d6235d11",
                        "entry_id": "61393c4d-386d-32d6-a4ab-2a7c72a47328",
                        "glosses": [
                            "Action d’agrandir ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780d8ea0-ef8f-408b-ba87-e02474af53d6",
                                "sense_id": "64c7c275-d85a-366a-ab63-3d08d6235d11",
                                "text": "L’agrandissement d’une photographie, d’un portrait."
                            },
                            {
                                "example_id": "17904d3b-b2c5-4079-9806-63230918d4e2",
                                "sense_id": "64c7c275-d85a-366a-ab63-3d08d6235d11",
                                "text": "Prévoir un agrandissement de la zone résidentielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "b365f6f4-12ae-3017-88d3-1a0ae4c3e883",
                        "entry_id": "61393c4d-386d-32d6-a4ab-2a7c72a47328",
                        "glosses": [
                            "Accroissement en fortune, en sagesse, en dignité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "303cdd39-c496-4856-a6f0-e71d96b506f5",
                                "sense_id": "b365f6f4-12ae-3017-88d3-1a0ae4c3e883",
                                "text": "Les enfants pauvres, libérés de la prison scolaire, apprennent un métier, ce qui est un agrandissement de soi, et commencent de vivre à l'âge où leurs frères riches s'exercent au maniement de mots qui ne correspondent à rien de réel, outils qui sculptent l'éternel vide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ca1bb19-4eac-4f86-b10c-27b13557ea35",
                        "source_entry_id": "61393c4d-386d-32d6-a4ab-2a7c72a47328",
                        "target_lang_word": "extension",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extension",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf4503d-3e9e-3b65-83a2-0e31efd0eeeb",
                                        "entry_id": "ae4de6b5-efb8-3847-bc0a-c394f80fbe4e",
                                        "glosses": [
                                            "The act of extending; a stretching out; enlargement in length, breadth, or time; an increase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7351c6a-7889-4403-8e63-8cfbcca6daf9",
                                                "sense_id": "bcf4503d-3e9e-3b65-83a2-0e31efd0eeeb",
                                                "text": "Next month the house is undergoing an extension."
                                            },
                                            {
                                                "example_id": "3b397fe8-16f4-43e3-96d1-2139c5169e68",
                                                "sense_id": "bcf4503d-3e9e-3b65-83a2-0e31efd0eeeb",
                                                "text": "Due to the unforeseen circumstances, you are allowed an extension of two weeks to complete the task."
                                            },
                                            {
                                                "example_id": "12fce4c9-7838-495a-b7bd-53e850f4c142",
                                                "sense_id": "bcf4503d-3e9e-3b65-83a2-0e31efd0eeeb",
                                                "text": "\"Keep off Conductor Rails\" said red-painted notices at the platform ends, for third-rails were laid in many places even where electric trains never normally ran, and there had been many rumours of impending electrification of the Wirral, as a natural extension of the Mersey system, a quarter of a century before the change was actually made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a3adb7-fd0d-3c22-a012-a51857b34875",
                                        "entry_id": "ae4de6b5-efb8-3847-bc0a-c394f80fbe4e",
                                        "glosses": [
                                            "The state of being extended."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8a0e9ed-a2c6-45ba-93d1-7d0219826c30",
                                                "sense_id": "83a3adb7-fd0d-3c22-a012-a51857b34875",
                                                "text": "For station is properly no rest, but one kind of motion, relating unto that which physicians (from Galen) do name extensive or tonical; that is, an extension of the muscles and organs of motion, maintaining the body at length, or in its proper figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9b2411d-32a7-341d-800c-ca0cd645fa07",
                                        "entry_id": "ae4de6b5-efb8-3847-bc0a-c394f80fbe4e",
                                        "glosses": [
                                            "That property of a body by which it occupies a portion of space (or time, e.g. \\\"spatiotemporal extension\\\")."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "895f0b28-de49-3134-bdcd-35e9eed9da0c",
                                        "entry_id": "ae4de6b5-efb8-3847-bc0a-c394f80fbe4e",
                                        "glosses": [
                                            "A short exact sequence 1→H→E→G→1, or the group E therein."
                                        ],
                                        "tags": [
