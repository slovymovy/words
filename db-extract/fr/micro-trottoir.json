                    },
                    {
                        "translation_id": "3f91be75-546f-450c-88b8-43d066b9d0d4",
                        "source_entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
                        "source_sense_id": "c8761909-26db-3672-ae43-3f0262e824e3",
                        "target_lang_word": "Straßenbefragung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3340fdc0-bc5d-427e-816d-e5cdcf7a7432",
                        "source_entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
                        "source_sense_id": "c8761909-26db-3672-ae43-3f0262e824e3",
                        "target_lang_word": "Passantenbefragung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9d491ba3-bbe2-4834-8342-2b49c5065677",
                        "source_entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
                        "source_sense_id": "c8761909-26db-3672-ae43-3f0262e824e3",
                        "target_lang_word": "vox pop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vox pop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e990ba8d-7c91-3222-9a24-37fe758782bd",
                                        "entry_id": "850ec6f6-e544-3e4a-b228-ce9d5dc10130",
                                        "glosses": [
                                            "A short, informal, non-prearranged interview with a member of the public, especially to canvas opinion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f7fe709-47ac-4cf3-9f86-3cf9f1113c99",
                                                "sense_id": "e990ba8d-7c91-3222-9a24-37fe758782bd",
                                                "text": "The reporter got some vox pops in the city square to see what people thought of the country's new flag."
                                            },
                                            {
                                                "example_id": "6ca80898-f448-4c7f-bc14-c058d04e1963",
                                                "sense_id": "e990ba8d-7c91-3222-9a24-37fe758782bd",
                                                "text": "While the BBC guidelines relating to balance are[…] so diligently applied that the opinion of 100 so-called experts must always be weighed[…], vox pops remain a chance for journalists to run more or less free."
                                            },
                                            {
                                                "example_id": "d327fceb-6f43-47f6-bb99-45249a67e324",
                                                "sense_id": "e990ba8d-7c91-3222-9a24-37fe758782bd",
                                                "text": "Vox pops – a series of comments from a variety of people – are a great way to include a sample of public opinion in your programmes and to add colour to reports that would otherwise suffer from a lack of lively soundbites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d0cb824-97fc-4eb6-99ce-40c8126c5b11",
                        "source_entry_id": "0a5b3bd9-bc0f-3fc6-a499-6f105aafdc6f",
