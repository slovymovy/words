                    {
                        "sense_id": "5fb16062-867f-35c2-961a-df4093150649",
                        "entry_id": "1ad6ca29-a36b-3531-8afc-a71ddf561ebf",
                        "glosses": [
                            "een kleine plaats met grote, vrijstaande, dure woningen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a6f7b6-9320-4a22-b3f1-0e82eb2d922c",
                                "sense_id": "5fb16062-867f-35c2-961a-df4093150649",
                                "text": "De rijke gemeenten beklemtonen dat het geen onwil is. Volgens een woordvoerster van villadorp Rozendaal is er simpelweg geen geschikte plek voor vluchtelingenopvang."
                            },
                            {
                                "example_id": "de819f4f-a1ce-4827-b6da-47323a256af3",
                                "sense_id": "5fb16062-867f-35c2-961a-df4093150649",
                                "text": "De gemeente Haren moet de kosten van de commissie-Cohen, die de Facebookrellen in het villadorp onderzocht, openbaar maken. Dat adviseert een onafhankelijke bezwaarcommissie na een verzoek van RTV Noord en het Dagblad van het Noorden. Dat maakte de gemeente vandaag bekend."
                            },
                            {
                                "example_id": "3647c74b-3830-4778-bf26-a2efde0440c7",
                                "sense_id": "5fb16062-867f-35c2-961a-df4093150649",
                                "text": "Ongeveer 50 inwoners van het villadorp Blaricum hebben in de afgelopen week een dwangbevel van de gemeente in de brievenbus gevonden met de mededeling dat ze direct achterstallige gemeentelijke belastingen moesten voldoen. Het versturen van de dwangbevelen was een foutje van een ambtenaar, zo heeft de gemeente laten weten."
                            }
                        ]
                    }
