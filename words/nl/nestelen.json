                },
                {
                    "sense_id": "626308e2-81c9-3ad3-ad78-f6b06ed29ba8",
                    "sense_definition": "zich ergens op een prettige of comfortabele manier installeren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wilde zich lekker op de bank <w>nestelen</w> met een goed boek.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>nestle</w> comfortably on the couch with a good book."
                            }
                        },
                        {
                            "text": "De kat kwam bij hem op schoot en begon zich behaaglijk te <w>nestelen</w>.",
                            "target_lang_translations": {
                                "en": "The cat came onto his lap and began to <w>snuggle</w> comfortably."
                            }
