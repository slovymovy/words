                                        "glosses": [
                                            "Exactly correct, correct in every letter; word-perfect."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c72d85-65fc-4401-8edc-757e1978d026",
                                                "sense_id": "2fa0f8cd-cfeb-3128-8b7a-b0130e55a91d",
                                                "text": "He was able to write out the speeches of Hamlet, letter perfect. It was impressive to see how exactly he knew the wording."
                                            },
                                            {
                                                "example_id": "d8fc9b14-49eb-4926-a56a-336ce80a38ac",
                                                "sense_id": "2fa0f8cd-cfeb-3128-8b7a-b0130e55a91d",
                                                "text": "\"Can you quote it?\" \"I know my New Testament pretty well, but I am not letter-perfect.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
