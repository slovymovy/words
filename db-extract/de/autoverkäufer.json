                "senses": [
                    {
                        "sense_id": "29a37e1e-9feb-3e74-94b5-ce4a15a5c388",
                        "entry_id": "41243b3a-0aa9-3593-b2b7-2b4d6cfaf122",
                        "glosses": [
                            "jemand, der ein Auto verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71398d3b-9109-4bb6-90db-1ca95111658a",
                                "sense_id": "29a37e1e-9feb-3e74-94b5-ce4a15a5c388",
                                "text": "Autoverkäufer sind bestrebt einen möglichst hohen Verkaufspreis zu erzielen."
                            },
                            {
                                "example_id": "86b8dcdb-78a8-49cd-b978-67f12521fc1c",
                                "sense_id": "29a37e1e-9feb-3e74-94b5-ce4a15a5c388",
                                "text": "„Am 17. Februar 2003 kam es schließlich in der Wohnung von Tanja S. in Traiskirchen zum Aufeinandertreffen mit einem Autoverkäufer.“"
                            },
                            {
                                "example_id": "d32e0e9b-76b1-4ea9-b62a-dcd600729141",
                                "sense_id": "29a37e1e-9feb-3e74-94b5-ce4a15a5c388",
                                "text": "„Siebzehn Briefe hatten Immobilienbüros, Antiquitätengeschäfte, Juweliere und Autoverkäufer zum Absender, die zwar kein Geld, dafür ihre Objekte anpriesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
