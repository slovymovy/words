                ],
                "senses": [
                    {
                        "sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
                        "entry_id": "c67cc185-69d2-35a4-8ed2-f90f8fd2fa3e",
                        "glosses": [
                            "übliche, aber ungenaue Regel oder Vorgehensweise, die sich im Laufe der Zeit bewährt hat, aber nicht von Gremien oder Institutionen als allgemeingültige Formel festgesetzt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e51be9b-1962-4d01-8f04-2f2c64efdff7",
                                "sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
                                "text": "Für einen Wiktionary-Artikel kannst Du folgende Faustregel ansetzen: 1.500 kb entsprechen ungefähr 10 Minuten Arbeit."
                            },
                            {
                                "example_id": "f4313b0e-61a5-4b6d-9a87-8254deb46c9a",
                                "sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
                                "text": "Generell gilt die Faustregel: Je weniger Kontakt zum Täter, desto größer die Anzeigebereitschaft."
                            },
                            {
                                "example_id": "5ee99b68-34a1-46e5-9b9d-21ff2081c554",
                                "sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
                                "text": "Es gilt die Faustregel: Jeder vorgezogene Monat [, den man früher in Rente geht,] bedeutet 0,3 Prozent weniger Rente."
                            },
                            {
                                "example_id": "c8b78018-2178-462c-adc1-a80cf9d39fba",
                                "sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
                                "text": "„Zumindest auf der Ebene der festlandsskandinavischen Hochsprachen kann man mit folgender Faustregel operieren, daß die dem vokalischen Silbenkern folgende Konsonanz die Länge des vorangehenden Vokals bestimmt.“"
                            },
                            {
                                "example_id": "850645a2-4ca3-428b-934e-7e3cbfe87bdf",
                                "sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
                                "text": "Nach einer Faustregel muss bei einer betrieblichen Investition das Geld nach 18 Monaten wieder drin sein. Sonst lässt man besser die Ausgabe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c36a7e9d-1140-4739-b3e2-626613bf9362",
                        "source_entry_id": "c67cc185-69d2-35a4-8ed2-f90f8fd2fa3e",
                        "source_sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
                        "target_lang_word": "rule of thumb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rule of thumb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                        "entry_id": "7cead9ab-431b-3d32-bb41-875edb284109",
                                        "glosses": [
                                            "A general guideline, rather than a strict rule; an approximate measure or means of reckoning based on experience or common knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1d7e57-af82-4336-aa30-f85f883a1042",
                                                "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                                "text": "The usual rule of thumb says that to calculate when an investment will double, divide 70 by the interest rate."
                                            },
                                            {
                                                "example_id": "8cb59dd9-63b7-49e8-9c0d-e8bbe487d5ed",
                                                "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                                "text": "Here's a good rule of thumb:\nToo clever is dumb."
                                            },
                                            {
                                                "example_id": "eab13270-0752-4bef-9c30-3e6ab7c77669",
                                                "sense_id": "38ca18bb-5214-353e-a370-43df37b43469",
                                                "text": "Since it is impossible to second-guess what a user will want to look up, there is a general lexicographical rule of thumb to err on the side of inclusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db276a3-fd4e-33c2-8a75-d2f4033c8e55",
                                        "entry_id": "7cead9ab-431b-3d32-bb41-875edb284109",
                                        "glosses": [
                                            "Approximated, guesstimated."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e42f4be2-ec6d-4067-8a85-7bef4a4757f7",
                                                "sense_id": "1db276a3-fd4e-33c2-8a75-d2f4033c8e55",
                                                "text": "I made a quick, rule-of-thumb estimate of the manhours required for the job."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87ae725b-1996-47c6-ba27-7980d189fcd7",
                        "source_entry_id": "c67cc185-69d2-35a4-8ed2-f90f8fd2fa3e",
                        "source_sense_id": "1c66a9c0-91ef-38b3-8c1a-04a4f7b6019b",
