{
    "word_family": [
        "condamnation",
        "condamnable",
        "incondamnable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e507ffd9-0ca1-32d9-b619-c9bb30c8c03f",
                    "sense_definition": "Déclarer quelqu'un coupable en justice et lui infliger une peine légale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a décidé de <w>condamner</w> l'accusé à trois ans de prison ferme."
                        },
                        {
                            "text": "Le juge a choisi de le <w>condamner</w> à une amende pour excès de vitesse."
                        }
                    ],
                    "synonyms": [
                        "sanctionner",
                        "punir"
                    ],
                    "antonyms": [
                        "acquitter",
                        "gracier",
                        "innocenter"
                    ],
                    "common_phrases": [
                        "condamner à mort",
                        "condamner à une amende",
                        "condamner à perpétuité"
                    ]
                },
                {
                    "sense_id": "4af87d2a-9138-37fa-a255-8d1fcd324574",
                    "sense_definition": "Exprimer un jugement très sévère ou une désapprobation totale à l'égard de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les représentants politiques ont tenu à <w>condamner</w> fermement ces actes de violence injustifiés."
                        },
                        {
                            "text": "Toute l'opinion publique <w>condamne</w> ce genre de comportement irresponsable."
                        }
                    ],
                    "synonyms": [
                        "blâmer",
                        "désapprouver",
                        "réprouver"
                    ],
                    "antonyms": [
                        "approuver",
                        "louer",
                        "cautionner"
                    ],
                    "common_phrases": [
                        "condamner fermement",
                        "condamner avec force",
                        "condamner unanimement"
                    ]
                },
                {
                    "sense_id": "52f0bff9-7324-3e13-bf7f-7d9986042e70",
                    "sense_definition": "Fermer définitivement une porte, une fenêtre ou une issue pour en interdire l'usage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fermeture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les travaux de rénovation, ils ont dû <w>condamner</w> une porte d'entrée latérale."
                        },
                        {
                            "text": "Les pompiers ont exigé de ne pas <w>condamner</w> cette issue de secours."
                        }
                    ],
                    "synonyms": [
                        "murer",
                        "obstruer",
                        "bloquer"
                    ],
                    "antonyms": [
                        "débloquer",
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "condamner une porte",
                        "condamner une issue",
                        "condamner un passage"
                    ]
                },
                {
                    "sense_id": "e96afa79-2c01-3a7c-a589-42241aa99c58",
                    "sense_definition": "Contraindre quelqu'un à subir une condition ou un état pénible et inévitable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contrainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa grave blessure au genou va le <w>condamner</w> au repos forcé durant des mois."
                        },
                        {
                            "text": "La crise économique semble <w>condamner</w> à l'échec toutes ses nouvelles initiatives."
                        }
                    ],
                    "synonyms": [
                        "contraindre",
                        "vouer",
                        "réduire"
                    ],
                    "antonyms": [
                        "libérer",
                        "affranchir"
                    ],
                    "common_phrases": [
                        "condamner à l'échec",
                        "condamner au silence",
                        "condamner à l'oubli"
                    ]
                },
                {
                    "sense_id": "da3cc62c-9dfa-362c-9829-d991751af63f",
                    "sense_definition": "Déclarer un malade incurable et estimer que son décès est certain et proche.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le diagnostic était sans appel et les spécialistes ont fini par <w>condamner</w> le patient."
                        },
                        {
                            "text": "Bien que la médecine l'eût presque <w>condamné</w>, il a miraculeusement survécu."
                        }
                    ],
                    "antonyms": [
                        "sauver",
                        "guérir"
                    ],
                    "common_phrases": [
                        "condamné par les médecins"
                    ]
                }
            ]
        }
    ]
}