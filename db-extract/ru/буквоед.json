                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2063e99-2958-4e7a-a42d-d938fb0b1275",
                                                "sense_id": "2e7581cb-a3b8-35e2-bc9d-0ed2ac3082b7",
