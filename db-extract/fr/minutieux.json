                                    {
                                        "sense_id": "14294032-49bf-38c6-80a9-2f5721e564e8",
                                        "entry_id": "ed3ded14-755a-3a5a-a132-8eb981acc3d3",
                                        "glosses": [
                                            "Carefully attentive to details; studious; diligent in performing a process or procedure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691c122c-6926-4355-ae06-05e58510f27f",
                                                "sense_id": "14294032-49bf-38c6-80a9-2f5721e564e8",
                                                "text": "All these painstaking men, considered together, may be said to have completed another species of criticism."
                                            },
                                            {
                                                "example_id": "029a53a9-f36a-4ff1-85f3-e79fda93e948",
                                                "sense_id": "14294032-49bf-38c6-80a9-2f5721e564e8",
                                                "text": "It is hoped to feature the historic vehicles to be found on the line in a future article, so that full justice may be done to the painstaking work of renovation on many of them, such as the North Eastern Railway Coach Group's NER autocoach No 3453."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "painstaking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a852e8-d64c-37c6-957b-a595ac90872d",
                                        "entry_id": "783826b8-1608-381e-a94d-4f0dd2f727ff",
                                        "glosses": [
                                            "The application of careful and attentive effort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3b7402-ab19-4643-9f8a-76404c4e29c3",
                                                "sense_id": "a2a852e8-d64c-37c6-957b-a595ac90872d",
                                                "text": "I esteeme Bocace his Decameron, Rabelais, and the kisses of John the second (if they may be placed under this title) worth the paines-taking to reade them."
                                            },
                                            {
                                                "example_id": "0d6e7bc6-2765-442b-bfbd-926b1e65e375",
                                                "sense_id": "a2a852e8-d64c-37c6-957b-a595ac90872d",
                                                "text": "It is not by a flight of imagination that you gain the ascents of spiritual experience. It is by the toils and the watchings and the painstakings of a solid obedience."
                                            },
                                            {
                                                "example_id": "57153cf3-fe49-427a-8987-8323bb5d63b7",
                                                "sense_id": "a2a852e8-d64c-37c6-957b-a595ac90872d",
                                                "text": "Behold what an abundant recompense attends the small processes of the earth, with the help of a little warm air; and what wealthy returns the industry of the husbandman and the florist is preparing from a few seeds and painstakings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
