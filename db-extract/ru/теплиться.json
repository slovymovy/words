                    {
                        "form_id": "0e3804ba-ade1-4aa5-b517-74237707cf65",
                        "entry_id": "ac425fa9-f387-30b2-8c42-d7fade7ee423",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "те́плившись"
                    },
                    {
                        "form_id": "32d2b3aa-28b1-49ed-a982-548a34ee2fd3",
                        "entry_id": "ac425fa9-f387-30b2-8c42-d7fade7ee423",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… те́плиться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e04f9a20-4636-33b6-94bb-d8aee763e9ad",
                        "entry_id": "ac425fa9-f387-30b2-8c42-d7fade7ee423",
                        "glosses": [
                            "гореть слабым, неярким пламенем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970f14fe-51de-44bb-ba15-8fcb50d61f7d",
                                "sense_id": "e04f9a20-4636-33b6-94bb-d8aee763e9ad",
                                "text": "Перед образами теплятся лампады."
                            }
                        ]
                    },
                    {
                        "sense_id": "f88ef099-b56b-3c03-967b-31a7124f130a",
                        "entry_id": "ac425fa9-f387-30b2-8c42-d7fade7ee423",
                        "glosses": [
                            "быть охваченным слабым, неярким пламенем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a601e36-d0f0-4551-b206-8bb303ecb2f1",
                                "sense_id": "f88ef099-b56b-3c03-967b-31a7124f130a",
                                "text": "Бросаюсь с постели к окну ― весь город теплится, огненные языки шевелятся уж над кровлями."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd7a9510-3227-37e5-a131-f05b99041aa9",
                        "entry_id": "ac425fa9-f387-30b2-8c42-d7fade7ee423",
                        "glosses": [
                            "излучать слабый свет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "899f743e-cf99-43a3-9a76-ae7e98baf2d2",
                                "sense_id": "cd7a9510-3227-37e5-a131-f05b99041aa9",
                                "text": "Звезды тихо гасли; только две или три продолжали ещё теплиться мигающими блёстками."
                            },
                            {
                                "example_id": "52c03258-0786-48c8-9816-f57483ec5c32",
                                "sense_id": "cd7a9510-3227-37e5-a131-f05b99041aa9",
                                "text": "Заря чуть теплится…"
                            },
                            {
                                "example_id": "1d5e9f13-c7d6-46f3-81de-c913ba84964e",
                                "sense_id": "cd7a9510-3227-37e5-a131-f05b99041aa9",
                                "text": "В репьевском дому все уже легли спать, только у Петра Леонтьевича ещё теплился свет в окошке."
                            }
                        ]
                    },
                    {
                        "sense_id": "22588833-b869-3bf1-b9e7-b3e7c21e3ebc",
                        "entry_id": "ac425fa9-f387-30b2-8c42-d7fade7ee423",
                        "glosses": [
                            "перен. проявляться слабо, в незначительной степени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab72e5e5-20b5-48aa-948d-fbc744d83bc6",
                                "sense_id": "22588833-b869-3bf1-b9e7-b3e7c21e3ebc",
                                "text": "Жизнь ещё теплилась в этих обвядших травинках, а в золотых кувшинчиках зябры ещё не высохла и капелька меда, а смолка ещё липла к пальцам, а пушица не утратила своего шелковистого тепла."
                            }
                        ]
                    },
                    {
                        "sense_id": "da8654ec-62ba-3be3-9156-f6552915d5b9",
                        "entry_id": "ac425fa9-f387-30b2-8c42-d7fade7ee423",
                        "glosses": [
                            "перен. существовать в скрытом виде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd963a59-48fc-43cb-ab6c-8001ec53f189",
                                "sense_id": "da8654ec-62ba-3be3-9156-f6552915d5b9",
                                "text": "В сердце её теплится и бьётся последний огонёк надежды."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
