                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceadfa4f-67a1-4c87-be16-e89894085ecd",
                                                "sense_id": "0433fe50-c27c-32ed-bdad-d95ab0505ab2",
                                                "text": "Another is on the right, to turn his murder into a justification for an all-out war, a Reichstag fire for our time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "397136e5-0646-3579-af9c-56112340e8c4",
                                        "entry_id": "d776d11b-04a0-3446-ae70-9a9a3e6bd154",
                                        "glosses": [
                                            "The building in Berlin that houses the Bundestag of modern Germany."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6977d9a5-db30-406c-a757-68345a7bffd9",
                                                "sense_id": "397136e5-0646-3579-af9c-56112340e8c4",
                                                "text": "It was one of the most beautiful things I have ever seen: 100 rock climbers abseiling down the facade of the Reichstag, slowly unfurling this huge silvery curtain."
                                            }
                                        ]
