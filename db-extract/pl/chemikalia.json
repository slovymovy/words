                                        "glosses": [
                                            "Of or relating to chemistry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db2733bb-e8c8-4761-8ccf-96485b872dca",
                                                "sense_id": "949a424a-f52f-39a0-ad7d-21116b9dea90",
                                                "text": "chemical experiments"
                                            },
                                            {
                                                "example_id": "b9235c61-5d62-4581-a6e6-da630825ec07",
                                                "sense_id": "949a424a-f52f-39a0-ad7d-21116b9dea90",
                                                "text": "the chemical properties of iron"
                                            },
                                            {
                                                "example_id": "aa447f39-6200-4dee-ab65-c7be4abbcf16",
                                                "sense_id": "949a424a-f52f-39a0-ad7d-21116b9dea90",
                                                "text": "Pentalene has chemical formula C₈H₆"
                                            },
                                            {
                                                "example_id": "7e3a079f-c066-4b92-8540-df7f2b3ec559",
                                                "sense_id": "949a424a-f52f-39a0-ad7d-21116b9dea90",
                                                "text": "The physiology of matter in the abstract is dynamical, that of mineral species is both dynamical and chemical, while that of organized forms is at once dynamical, chemical, and biotical."
                                            },
                                            {
                                                "example_id": "7b32db66-755b-4e22-9035-90a79eb00a48",
                                                "sense_id": "949a424a-f52f-39a0-ad7d-21116b9dea90",
                                                "text": "We pinpoint all essential ingredients of intelligence found in spatio-temporal dynamics of nonlinear chemical systems, and show outlines of future designs and protypes of chemical intelligent \"gooware\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b7cea12-a2c5-3f12-9b6b-feafc99a9aab",
                                        "entry_id": "e3b0389b-fb00-3962-9921-a3a0cdef3f60",
                                        "glosses": [
                                            "Of or relating to a material or processes not commonly found in nature or in a particular product."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "019d7009-20a0-3f4b-9779-9beedb4cc207",
                                        "entry_id": "e3b0389b-fb00-3962-9921-a3a0cdef3f60",
                                        "glosses": [
                                            "Of or relating to alchemy."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chemical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0fe3b4-c0f2-3ae7-82ff-7851688910f9",
                                        "entry_id": "5a899dfd-ad95-3022-bc10-3c8ef104fcaa",
                                        "glosses": [
                                            "Any specific chemical element or chemical compound or alloy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15c489d-15f5-4ac4-9a45-a976151cde09",
                                                "sense_id": "5e0fe3b4-c0f2-3ae7-82ff-7851688910f9",
                                                "text": "Hydrogen and sulphur are both chemicals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                                        "entry_id": "5a899dfd-ad95-3022-bc10-3c8ef104fcaa",
                                        "glosses": [
                                            "An artificial chemical compound."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781c48d0-93b7-4d7d-96a8-5c99f4fefeb6",
                                                "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                                                "text": "I color my hair with henna, not chemicals."
                                            },
                                            {
                                                "example_id": "5e744748-3fcc-4c41-9c2a-89a5ee439480",
                                                "sense_id": "641a55cc-d141-3867-9fa3-9d7968f53998",
                                                "text": "CSPI says the Trump Administration could take steps to protect consumers from each of these chemicals and support FDA’s broader post-market assessment efforts. It could ensure that FDA sets health-protective limits on heavy metals, like lead, arsenic, and cadmium, in foods consumed by children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deca466b-7293-3fff-8f1a-cf4b83202176",
                                        "entry_id": "5a899dfd-ad95-3022-bc10-3c8ef104fcaa",
                                        "glosses": [
                                            "An addictive drug."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
