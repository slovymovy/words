                                            "pronominal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a58719f1-abb0-4d18-873d-585c448ed56b",
                                                "sense_id": "05ad5c0c-5560-345e-a31b-90e3a3f2664b",
                                                "text": "Je me patine de finir ma pièce, autrement samedi pas de galette."
                                            },
                                            {
                                                "example_id": "0e56cf40-f0f8-49af-a3af-48d230929675",
