                        "examples": [
                            {
                                "example_id": "7f25b5d9-f03a-43bb-b8fe-5868cc84dfc5",
                                "sense_id": "949382f4-29b1-3639-b1f4-0904931acbda",
                                "text": "« OJ », comme le surnomment les « loréaliens », reste la figure de proue du groupe."
                            },
                            {
                                "example_id": "c15b3945-2fb1-4b15-b2a7-cf164e90218f",
                                "sense_id": "949382f4-29b1-3639-b1f4-0904931acbda",
                                "text": "\"Elle montre le visage souriant du capital\", nous a confié un jour un \"loréalien\"."
                            },
                            {
                                "example_id": "1ac036aa-c8e9-4cdb-a81b-fb8ef74b679b",
                                "sense_id": "949382f4-29b1-3639-b1f4-0904931acbda",
                                "text": "En juin 2008, il a placé des «Loréaliens» pur sucre à la tête de The Body Shop en veillant à ne pas créer de traumatismes."
                            },
                            {
                                "example_id": "0c407c6c-4a54-4eaa-8cec-2f62dfef748d",
                                "sense_id": "949382f4-29b1-3639-b1f4-0904931acbda",
                                "text": "Cet ancien « Loréalien » invite depuis cinq ans hommes et femmes d'affaires à venir lâcher prise dans ses espaces de détente à l'orientale."
                            }
                        ]
                    }
