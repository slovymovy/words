                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e79f0e57-dda0-4a83-a146-35271479ef84",
                        "entry_id": "c24360de-da45-385d-a906-3d24bc8cb405",
                        "tags": [
                            "plural"
                        ],
