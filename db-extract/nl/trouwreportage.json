                        "examples": [
                            {
                                "example_id": "f3ff044c-064e-484d-88d3-d240f6b194ec",
                                "sense_id": "7fa63e62-33b8-3af5-9a49-7ad21d920d70",
                                "text": "Als jullie gekozen hebben voor een bepaalde fotograaf, maak dan een afspraak voor een pre-weddingshoot of een loveshoot. Tijdens deze shoot maak je kennis met de fotograaf en zijn werkwijze en kunnen jullie alvast samen wat leuke plekjes gaan spotten voor de echte trouwreportage. Zo'n shoot kan ontzettend fijn zijn voor jullie als bruidspaar en ook de fotograaf kan dit alleen maar helpen om straks op de grote dag de mooiste foto’s te maken."
                            },
                            {
                                "example_id": "09f59a1d-7e1e-4fa1-bf32-1e92764b93fd",
                                "sense_id": "7fa63e62-33b8-3af5-9a49-7ad21d920d70",
                                "text": "Een cameraploeg van de website Hart voor auto’s is maandag 28 september aanwezig om een heel bijzondere Porsche vast te leggen. In de oude fabriekshallen van Ten Cate zijn meerdere trouwreportages en producties gemaakt."
                            }
                        ]
                    }
