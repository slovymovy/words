                ],
                "senses": [
                    {
                        "sense_id": "f6cc5791-2545-3510-a60b-3b8ae4ba4fd2",
                        "entry_id": "ce327e1e-7379-38eb-853d-0b4ecb07e261",
                        "glosses": [
                            "Action de défricher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c426fc8-1e77-4e31-858e-71affa6e7a6b",
                                "sense_id": "f6cc5791-2545-3510-a60b-3b8ae4ba4fd2",
                                "text": "Toutefois, si une baisse des revenus du pétrole et une véritable crise économique survenaient simultanément et réduisaient les coûts du travail au Gabon, l’amélioration de l’accès aux marchés par des routes asphaltées à l’épreuve des intempéries entraînerait probablement le défrichage des forêts au profit de l’agriculture commerciale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f8b3466-60ce-4735-92da-39958dcfe354",
                        "source_entry_id": "ce327e1e-7379-38eb-853d-0b4ecb07e261",
                        "source_sense_id": "f6cc5791-2545-3510-a60b-3b8ae4ba4fd2",
                        "target_lang_word": "Rodung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rodung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8034f34f-53dd-3c72-b212-9f0972294181",
                                        "entry_id": "f5b394b1-112c-37ce-95b8-2946b30cd5cc",
                                        "glosses": [
                                            "Beseitigung von Bäumen und Sträuchern in einem Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dace76e5-1cf3-4b7d-99b9-62db074c95bd",
                                                "sense_id": "8034f34f-53dd-3c72-b212-9f0972294181",
                                                "text": "„Schon vor einigen Jahren wurden dem Wilmar-Lieferanten illegale Rodungen auf Kalimantan zur Last gelegt.“"
                                            },
                                            {
                                                "example_id": "b651f34c-a9e7-4ab8-9e3e-3d9b89edb7c4",
                                                "sense_id": "8034f34f-53dd-3c72-b212-9f0972294181",
                                                "text": "„Die gewaltigen Waldbrände und Rodungen im Amazonas schaden nicht nur der Natur, sondern zerstören auch die Wohnstätten vieler pueblos originarios.“"
                                            },
                                            {
                                                "example_id": "75662a2a-19fb-49f7-aa95-6e9b70092b1f",
                                                "sense_id": "8034f34f-53dd-3c72-b212-9f0972294181",
                                                "text": "„[…] [D]ie Rodung des Waldes begann also dort, wo die Siedlung gebaut werden sollte […].“"
                                            },
                                            {
                                                "example_id": "2dca64f5-3ff5-4fe7-a1da-05c437f4891a",
                                                "sense_id": "8034f34f-53dd-3c72-b212-9f0972294181",
                                                "text": "„Zu ihrem Erstaunen zeichneten sich in den Ablagerungen zwar sehr deutlich die Rodungen und der Landbau der europäischen Siedler ab, ein ökologischer Fußabdruck der Indigenen fand sich jedoch nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "397e5f2a-eb42-3ca5-8880-fb885e3846be",
                                        "entry_id": "f5b394b1-112c-37ce-95b8-2946b30cd5cc",
                                        "glosses": [
                                            "gerodete Fläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc02ee61-f880-4eb7-9012-acc3717576c4",
                                                "sense_id": "397e5f2a-eb42-3ca5-8880-fb885e3846be",
                                                "text": "„Die Sprechenden schienen an einem Ort zu bleiben; O'Toole vermutete hier natürlich nichts weiter als eine Farmerwohnung, zu der er nur nicht den rechten Pfad gefunden habe, und er glaubte in irgendeine neue Rodung geraten zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
