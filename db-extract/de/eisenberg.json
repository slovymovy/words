                            "plural"
                        ],
                        "form": "die Eisenbergs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                        "entry_id": "1aebba44-a026-3e61-aa96-34448b997499",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87459283-49c0-4697-8b18-9a6c6705f634",
                                "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                                "text": "Frau Eisenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d5b07fc9-fc4e-45e8-9f2d-34a66ea6989e",
                                "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                                "text": "Herr Eisenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "165ca994-e1af-4eff-be24-675be518c516",
                                "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                                "text": "Die Eisenbergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6997d257-62f1-4cbe-a48e-233a455bc787",
                                "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                                "text": "Der Eisenberg trägt nie die Schals, die die Eisenberg ihm strickt."
                            },
                            {
                                "example_id": "3bc17660-0d0d-4a79-be99-56bc43578081",
                                "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eisenberg kommt, geht der Herr Eisenberg.“"
                            },
                            {
                                "example_id": "0d849f96-b514-4985-91bf-3159a8fc3d4d",
                                "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                                "text": "Eisenberg kommt und geht."
                            },
                            {
                                "example_id": "dd589cf9-5dca-4698-901b-58adb4628253",
                                "sense_id": "95a86a9f-6b4e-3b59-abe5-71d4811a5c6f",
                                "text": "Eisenbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
