                        ],
                        "form": "zarbs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66a7ab6e-fbd4-3782-82a9-a020105449a4",
                        "entry_id": "264f1219-6425-3674-b953-41b0ecde3b16",
                        "glosses": [
                            "Instrument de percussion digitale originaire d’Iran, composé d’une seule pièce de bois creuse de forme cylindrique dont l’ouverture est fermée par une peau tendue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76310e49-09f9-4075-9ec9-ea55b1939617",
                                "sense_id": "66a7ab6e-fbd4-3782-82a9-a020105449a4",
                                "text": "Beaucoup préféraient l’arak, la vodka ou le vin, mais je n’observai aucune attitude disgracieuse, les plus éméchés se contentant d’accompagner en sourdine les musiciens engagés par le maître de céans, un joueur de târ, un virtuose du zarb, un flûtiste."
                            },
                            {
                                "example_id": "90dc0ba4-73e0-49a1-ab6e-1adfa91e5200",
                                "sense_id": "66a7ab6e-fbd4-3782-82a9-a020105449a4",
                                "text": "Depuis dix ans, on assiste au retour en force du tambourin daf qui double le zarb dans beaucoup d’ensembles."
                            },
                            {
                                "example_id": "70f4b550-bf87-4fe6-94fe-029c24b2ce80",
                                "sense_id": "66a7ab6e-fbd4-3782-82a9-a020105449a4",
                                "text": "Un musicien berbère extirpe un zarb de sa besace couleur lilas."
                            }
                        ]
                    }
                ],
