                ],
                "senses": [
                    {
                        "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                        "entry_id": "f8d54f53-08ad-3e5f-943c-565b69e100a4",
                        "glosses": [
                            "fertige Mixtur von Zutaten (bestehend beispielsweise aus Mehl, Trockenhefe, Salz, Gewürze), die unter Zufügen von Wasser den Teig eines Brotes ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee91d85b-638c-4797-99b0-c1f3b73d4eb8",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "„Sie [Anmerkung: die belgische Puratos-Gruppe] entwickelt Brotbackmischungen für den globalen Markt auf Basis hochtechnischer Untersuchungen in Labors.“"
                            },
                            {
                                "example_id": "3cd79b1f-a0a6-4c1b-8cba-9b26d16f930e",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "Während der Coronakrise waren die Brotbackmischungen in unserem Supermarkt ausverkauft."
                            },
                            {
                                "example_id": "63166ea4-8762-4e00-b5bd-aa513e338df2",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "„Ich habe einen kleinen Panik-Hamsterkauf von Wasserflaschen, Zucker, Brotbackmischung und Ölsardinen getätigt […]“"
                            },
                            {
                                "example_id": "b15b32c8-3d01-42a2-90da-ff0603ec8f26",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "In Deutschland bieten viele kleinere Mühlen Brotbackmischungen online an. Man muss sie nicht im Supermarkt kaufen."
                            },
                            {
                                "example_id": "1051169e-a84f-4550-bd78-33da04fc5e32",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "„Brotbackmischungen sind beliebt, denn ohne viel Aufhebens bekommt man eine Mehlmischung mit dem entsprechenden Triebmittel und der passenden Salzmenge geliefert.“"
                            },
                            {
                                "example_id": "d282ac3c-7dce-4993-80a4-f98139744bd7",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "„Wie gut sind eigentlich Brotbackmischungen?“"
                            },
                            {
                                "example_id": "b38229f3-3aac-45e3-97cd-d5ad03cacfa1",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "„Im Reformhaus fand Mattern endlich eine Brotbackmischung, die ihr schmeckte.“"
                            },
                            {
                                "example_id": "9261033b-55f5-47bd-a9f6-cd54fae851a1",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "„Kaffee, Mehl und Brotbackmischungen bestanden den Test ausnahmslos mit der Note „sehr gut“.“"
                            },
                            {
                                "example_id": "5a71a0d6-8640-4ebe-ae5d-3fc2d2ec9075",
                                "sense_id": "bcb63428-691e-3c07-a402-e4bf00a2c3a4",
                                "text": "„Sie [Anmerkung: Zwei Handwerksbäcker aus dem Landkreis Dachau] arbeiten ausschließlich nach eigenen Rezepten und mit in Handarbeit selbst hergestelltem Natursauerteig. Fertige Brotbackmischungen finden keinen Platz in ihren Öfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
