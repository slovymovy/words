                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "179c9459-fb91-4221-8619-d694565783c7",
                        "source_entry_id": "6eab7669-5b23-315a-a177-921a80894719",
                        "source_sense_description": "an expression of excitement",
                        "target_lang_word": "hoera",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoera",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0b554eb5-b7a3-3874-bb6c-a77651ef09b8",
