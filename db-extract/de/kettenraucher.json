                ],
                "senses": [
                    {
                        "sense_id": "4001d1a5-8439-32e4-aceb-bcdfaa47bd68",
                        "entry_id": "a7cb942c-f6f9-3772-aa75-8afb0e878f4b",
                        "glosses": [
                            "ein Raucher, der überdurchschnittlich viele Zigaretten beinahe ohne Unterlass konsumiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3781d549-76f4-4345-abfa-86f8e30eac17",
                                "sense_id": "4001d1a5-8439-32e4-aceb-bcdfaa47bd68",
                                "text": "„Mein Vater kommt einfach nicht von den Zigaretten los. Er ist nach wie vor Kettenraucher.“"
                            },
                            {
                                "example_id": "c6b1dd5e-4938-47b5-ade7-73aca4e84d52",
                                "sense_id": "4001d1a5-8439-32e4-aceb-bcdfaa47bd68",
                                "text": "Bei einem Kettenraucher kann die Lunge nicht in einer Organspende transplantiert werden."
                            },
                            {
                                "example_id": "20444d73-b4c3-4d0b-ac46-445123fc5a0c",
                                "sense_id": "4001d1a5-8439-32e4-aceb-bcdfaa47bd68",
                                "text": "Zuletzt litt [der niederländische Fußballspieler und -trainer Johan] Cruyff, der jahrelang Kettenraucher gewesen war, an Lungenkrebs."
                            },
                            {
                                "example_id": "22104ee8-e18f-471e-94ea-9e4aba2bc75a",
                                "sense_id": "4001d1a5-8439-32e4-aceb-bcdfaa47bd68",
                                "text": "Anfang 2005 war bei dem Kettenraucher [Rudi Carrell] Lungenkrebs diagnostiziert worden."
                            },
                            {
                                "example_id": "9fe59e93-0299-46ac-90f9-d21d3b58a634",
                                "sense_id": "4001d1a5-8439-32e4-aceb-bcdfaa47bd68",
                                "text": "Wer auch immer nun für Facebook überprüft, was denn nun die allerwahrste Wahrheit ist, gelöscht wird der Unsinn dann noch lange nicht, sondern nur mit einem Warnhinweis versehen. Der dürfte auf Verschwörungstheoretiker vermutlich so wirken, wie „Rauchen gefährdet ihre Gesundheit“ auf Kettenraucher."
                            },
                            {
                                "example_id": "9fdf4772-c325-4adc-82e5-f6fd051d8647",
                                "sense_id": "4001d1a5-8439-32e4-aceb-bcdfaa47bd68",
                                "text": "„Er war Kettenraucher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
