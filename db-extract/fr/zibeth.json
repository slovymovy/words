                "senses": [
                    {
                        "sense_id": "1fe69143-ac37-3517-8221-6b9b256eb4c8",
                        "entry_id": "c536048a-c271-3eda-9431-1fa0749daff6",
                        "glosses": [
                            "Espèce de civette répandue en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61ad841c-9c5d-47eb-a961-f44fe7149082",
                                "sense_id": "1fe69143-ac37-3517-8221-6b9b256eb4c8",
                                "text": "Ne sourions pas trop de cet anthropomorphisme (au demeurant, la comparaison de la nature et de lʼart a ses lettres de noblesse), et notons plutôt que cette merveille quʼest le zibeth est une des manifestations de la variété naturelle."
                            },
                            {
                                "example_id": "355df4f8-c2a8-4767-98db-878acba2e0f8",
                                "sense_id": "1fe69143-ac37-3517-8221-6b9b256eb4c8",
                                "text": "Le Zibeth a le corps presque généralement couvert de taches noires, petites et rondes sur un fond gris, teint de brun dans quelques parties."
                            }
                        ]
                    }
                ],
