                        "glosses": [
                            "afrikanisches Johannesbrotgewächs, tropischer Baum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4185a3ff-d639-4c8c-8dd0-844530ff1eb9",
                                "sense_id": "8712a0af-cd10-3be4-8c61-8d86d6279f59",
                                "text": "Der mit einer braunen borstigen Rinde umgebene Stamm der Tamarinde erreicht eine ansehnliche Höhe und geht oben in sparrige, ausgebreitete Äste auseinander."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bd5e5c10-dda3-3bc2-88ce-4d30fc98d362",
                        "entry_id": "a834e017-8fac-3f7c-ab2c-d1cfc3d02c77",
                        "glosses": [
                            "Frucht der Tamarinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4156db8c-20c8-4cf1-94f5-ad8cb7e4940b",
                                "sense_id": "bd5e5c10-dda3-3bc2-88ce-4d30fc98d362",
                                "text": "Mit Tamarinde (Garcinia Cambogia) können Sie Ihre Fettverbrennung ankurbeln und den Fettaufbau reduzieren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
