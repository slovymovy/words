                                        "glosses": [
                                            "Celui qui informe d’une nouvelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b35f582-c20a-4328-9e3b-504085955f7c",
                                                "sense_id": "f1c63e5a-066b-3ab5-80a1-2653a6e725ff",
                                                "text": "Nous avons reçu des renseignements d’un informateur très sûr."
                                            },
                                            {
                                                "example_id": "3ae10856-82b6-4d5f-a7ec-b23d3fee988c",
                                                "sense_id": "f1c63e5a-066b-3ab5-80a1-2653a6e725ff",
