                        "source_sense_id": "3e301bb2-aeba-3e1b-8068-b87a483de855",
                        "target_lang_word": "houndstooth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "houndstooth",
