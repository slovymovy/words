                        {
                            "text": "В Москве они <w>остановились</w> у родственников.",
                            "target_lang_translations": {
                                "en": "In Moscow, they <w>stayed</w> with relatives.",
                                "es": "En Moscú se <w>quedaron</w> con unos familiares.",
                                "fr": "À Moscou, ils <w>ont logé</w> chez des parents.",
                                "nl": "In Moskou <w>verbleven</w> ze bij familieleden.",
                                "pl": "W Moskwie <w>zatrzymali się</w> u krewnych.",
                                "de": "In Moskau sind sie bei Verwandten <w>untergekommen</w>.",
                                "it": "A Mosca si sono <w>fermati</w> da alcuni parenti.",
                                "cs": "V Moskvě <w>se zastavili</w> u příbuzných.",
                                "tr": "Moskova'da akrabalarının yanında <w>kaldılar</w>.",
                                "zh": "在莫斯科，他们<w>落脚</w>在亲戚家。"
                            }
