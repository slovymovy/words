                "senses": [
                    {
                        "sense_id": "c77c1d7e-74b4-38a8-9e71-5fe69b73e4cd",
                        "entry_id": "1794a039-ed40-393d-b7d6-bcd39caaeee7",
                        "glosses": [
                            "Sportler (oder Mannschaft), der bei den Olympischen Spielen mindestens einen sportlichen Wettbewerb gewonnen hat; Gewinner eines sportlichen Wettbewerb bei den Olympischen Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f440afcf-ff7f-4a83-951b-8bd3ded5dc5e",
                                "sense_id": "c77c1d7e-74b4-38a8-9e71-5fe69b73e4cd",
                                "text": "Michael Greis aus Nesselwang wurde am Samstag, den 11. Februar Olympiasieger im Biathlon über 20 Kilometer."
                            },
                            {
                                "example_id": "dc543f5d-7a9b-4d7c-9e36-e5f847cddbd7",
                                "sense_id": "c77c1d7e-74b4-38a8-9e71-5fe69b73e4cd",
                                "text": "Ebenfalls dreifache Olympiasieger wurden der britische Bahnradsportler Chris Hoy, die australische Schwimmerin Stephanie Rice und der chinesische Turner Zou Kai."
                            },
                            {
                                "example_id": "f6eefb2e-b5ad-4a78-a411-6d1026fe635e",
                                "sense_id": "c77c1d7e-74b4-38a8-9e71-5fe69b73e4cd",
                                "text": "„Westdeutschland, die Bundesrepublik, war Fußballweltmeister, die DDR der Olympiasieger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
