                "senses": [
                    {
                        "sense_id": "27750ded-9839-38be-9101-dd1553b6074b",
                        "entry_id": "64b8fd92-dcba-371a-992d-c87a236f1603",
                        "glosses": [
                            "The area inside a racetrack or running track."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14c4ee11-da99-4860-a942-d8f6db614b09",
                                "sense_id": "27750ded-9839-38be-9101-dd1553b6074b",
                                "text": "We left the carriage, bought programmes, and walked across the infield and then across the smooth thick turf of the course to the paddock."
                            }
                        ]
                    },
                    {
                        "sense_id": "79f7b56b-370a-31cd-be72-e21fe9d89bee",
                        "entry_id": "64b8fd92-dcba-371a-992d-c87a236f1603",
                        "glosses": [
                            "A constrained scope or area."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6410dbad-19b8-4ac8-b1fb-61c9e5f43d0e",
                                "sense_id": "79f7b56b-370a-31cd-be72-e21fe9d89bee",
                                "text": "Let’s keep this problem in the infield."
                            }
                        ]
                    },
                    {
                        "sense_id": "6582f0c4-e87b-33e3-a7d8-4b7904bd4174",
                        "entry_id": "64b8fd92-dcba-371a-992d-c87a236f1603",
