                "senses": [
                    {
                        "sense_id": "2b277fa7-957f-3584-b9b0-6d5c73b611d4",
                        "entry_id": "bab616da-6199-3707-b790-c461ee24a30d",
                        "glosses": [
                            "lijkend op gedroogd veen dat men gebruikt als brandstof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30992652-5e5f-4448-829c-1a8f37dda7bb",
                                "sense_id": "2b277fa7-957f-3584-b9b0-6d5c73b611d4",
                                "text": "Haar dunne schoentjes waren nu aan flarden en met haar volgende stap stond ze tot haar enkels in turfachtig water."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8f05874-f229-3ebb-bbaf-0ccd12a8d9da",
                        "entry_id": "bab616da-6199-3707-b790-c461ee24a30d",
                        "glosses": [
                            "met de smaak van turf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5590e360-976a-40a9-9e14-a80538493e35",
                                "sense_id": "e8f05874-f229-3ebb-bbaf-0ccd12a8d9da",
                                "text": "Bij de ontvangst kregen we een Johnnie Walker Double Black, een rijke, intense spirit met sterke rookachtige smaak. Een beetje ‘peaty’ (turfachtig) zoals ze dat zeggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d78a2ad-51ec-436a-9b06-7edbe7b2614d",
                        "source_entry_id": "bab616da-6199-3707-b790-c461ee24a30d",
                        "source_sense_id": "2b277fa7-957f-3584-b9b0-6d5c73b611d4",
                        "source_sense_description": "met de smaak van turf",
                        "target_lang_word": "peaty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peaty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5eaf313-c1f5-3b21-901b-b400229c4d67",
                                        "entry_id": "070e2529-ea37-3e41-b799-14ad1696edba",
                                        "glosses": [
                                            "Of or resembling peat; peatlike."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5d51627-2156-32d4-97e2-4ead5f282744",
                                        "entry_id": "070e2529-ea37-3e41-b799-14ad1696edba",
                                        "glosses": [
                                            "Of whisky, having a complex smoky flavour imparted by compounds released by peat fires used to dry the malted barley."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e56e13cd-2078-4e66-bda2-7a18891dc15f",
                                                "sense_id": "c5d51627-2156-32d4-97e2-4ead5f282744",
                                                "text": "The ten-year-old Ardbeg is traditionally considered the saltiest, peatiest malt on Islay (and that's saying something)."
                                            },
                                            {
                                                "example_id": "5a756135-15f1-40b3-98fb-ad468814ee88",
                                                "sense_id": "c5d51627-2156-32d4-97e2-4ead5f282744",
                                                "text": "Many are eagerly anticipating Bruichladdich's Octomore line—intended to be the peatiest whisky from Islay (with a peating level of 129 phenol ppm in the malt in 2003)."
                                            },
                                            {
                                                "example_id": "76e92b6b-dc7c-4c6a-9726-19705c4f3a58",
                                                "sense_id": "c5d51627-2156-32d4-97e2-4ead5f282744",
                                                "text": "After dinner, Ned revealed that he had snuck aboard a bottle of Ardbeg Uigeadail, one of the smokiest, peatiest, single malt Scotches this side of Edinburgh; a spirit “as deep and mysterious as the loch that gives it its name\" and one that smacks of distilled pine tar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfeb30a3-5c9f-36f9-8cdb-6668bb9cdef8",
                                        "entry_id": "070e2529-ea37-3e41-b799-14ad1696edba",
                                        "glosses": [
                                            "Containing peat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf66fe99-a009-4f29-85b0-0dc623f486c7",
                                                "sense_id": "cfeb30a3-5c9f-36f9-8cdb-6668bb9cdef8",
                                                "text": "Ben Feskineth lay undiscovered in deepest, peatiest Perthshire."
                                            },
                                            {
                                                "example_id": "40fa747d-f193-4b29-880e-0327e2f3460b",
                                                "sense_id": "cfeb30a3-5c9f-36f9-8cdb-6668bb9cdef8",
                                                "text": "The hillside at this point is composed of shaly rock overlaid with a peaty loam which carries a growth of heather, and its unstable condition has resulted in two landslides in the course of the railway's history."
                                            },
                                            {
                                                "example_id": "841e0440-3823-4518-9c5c-0b3039a66eaf",
                                                "sense_id": "cfeb30a3-5c9f-36f9-8cdb-6668bb9cdef8",
                                                "text": "The Drumochter Hills are a breeding haunt of dotterel, ptarmigan occur at high density, and where the ground is peatier, especially east of the Pass, golden plover and dunlin breed in company with these other birds at around 900 m."
                                            },
                                            {
                                                "example_id": "5c02261c-de9e-4d57-8134-ad1899b87c19",
                                                "sense_id": "cfeb30a3-5c9f-36f9-8cdb-6668bb9cdef8",
                                                "text": "The Palmer Drought Severity Index for Minnesota, our peatiest state, shows a tendency for wetter, not drier conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "504dc0e5-36b0-3746-85a1-2fcc39fa66e0",
                                        "entry_id": "070e2529-ea37-3e41-b799-14ad1696edba",
                                        "glosses": [
                                            "Related to the dietary advice, research and data of Dr. Ray Peat (especially foods with high natural sugar content and lack of refined seed oils, or activities and habits claimed to boost metabolism, lifespan, inter alia)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous",
                                            "neologism",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
