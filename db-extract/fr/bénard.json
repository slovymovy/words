            {
                "entry_id": "eea7bb91-aae0-3622-a4b1-7501362e3ff9",
                "word": "bénard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "939e1b44-adea-4f83-ac43-bd597d38c21d",
                        "entry_id": "eea7bb91-aae0-3622-a4b1-7501362e3ff9",
                        "tags": [
                            "plural"
                        ],
                        "form": "bénards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "345d8291-736d-3edd-85de-293fb07adb42",
                        "entry_id": "eea7bb91-aae0-3622-a4b1-7501362e3ff9",
                        "glosses": [
                            "Pantalon."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f96f5adf-50cb-49a3-b520-afb0b9a11011",
                                "sense_id": "345d8291-736d-3edd-85de-293fb07adb42",
                                "text": "Quand elle a repris ses esprits et moi mon bénard, nous échangeons quelques baisers et reprenons la conversation."
                            },
                            {
                                "example_id": "188c7dc9-c1a6-42b5-8129-9e8d75b335a4",
                                "sense_id": "345d8291-736d-3edd-85de-293fb07adb42",
                                "text": "Il se demandait aussi pourquoi il avait des difficultés pour sortir de l’avion. Il a pas pensé, sur le moment, que c’était son bénard qui traînait par terre, il croyait que c’était une crampe."
                            },
                            {
                                "example_id": "41409417-758e-4bd5-b975-ca2262857ef9",
                                "sense_id": "345d8291-736d-3edd-85de-293fb07adb42",
                                "text": "Il pionce avec son cheval dans son lit à baldaquin, découpe ses pages en rondelles et fout carrément le feu à son bénard au « bal des Ardents » en voulant, disait-il, « allumer son tison pour les gentes demoiselles » !"
                            },
                            {
                                "example_id": "dca816c2-961e-43c8-b0db-98ff11f9cfb1",
                                "sense_id": "345d8291-736d-3edd-85de-293fb07adb42",
                                "text": "Blanche, la patronne comme il l'appelait, c'était elle qui portait le bénard dans le couple. Elle qui savait écrire, qui donnait les ordres… qui comptait les sous."
                            },
                            {
                                "example_id": "fd924e9f-3c93-41b7-9060-4e6ffb0673e3",
                                "sense_id": "345d8291-736d-3edd-85de-293fb07adb42",
                                "text": "Tous les camelots de la banlieue Est s’abattent sur Nogent le samedi, jour où la paie arrondit les morlingues et tire les bénards vers le bas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c59ae82-a2cc-4acb-bf2c-9b338ff32daa",
                        "source_entry_id": "eea7bb91-aae0-3622-a4b1-7501362e3ff9",
                        "source_sense_id": "345d8291-736d-3edd-85de-293fb07adb42",
                        "target_lang_word": "Hose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac81c89-47b0-3748-8732-c14db3e4af6a",
                                        "entry_id": "ca09299b-f288-3f32-8949-1f624aa7f3af",
                                        "glosses": [
                                            "Kleidungsstück, das den Körper unterhalb der Taille (bis zu den Füßen) bedeckt und dabei jedes Bein einzeln umschließt. Der Plural ist auch für den Singular gebräuchlich, da eine Hose aus zwei Schläuchen (Hosen) besteht (vergleiche die Herkunft)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45159ff2-d42f-465f-814e-5c5c5d987c7c",
                                                "sense_id": "4ac81c89-47b0-3748-8732-c14db3e4af6a",
                                                "text": "Die Hosen stehen dir sehr gut. / Die Hose steht dir sehr gut."
                                            },
                                            {
                                                "example_id": "273dcddc-e2da-4e77-84a0-fc62faea9131",
                                                "sense_id": "4ac81c89-47b0-3748-8732-c14db3e4af6a",
                                                "text": "„Er riß sich das Hemd vom Leib und zog die Hosen aus.“"
                                            },
                                            {
                                                "example_id": "b853c203-b3fe-487b-ba76-6e63eef6be88",
                                                "sense_id": "4ac81c89-47b0-3748-8732-c14db3e4af6a",
                                                "text": "„Ich trage die Hose jetzt ein Jahr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9d3ab25-856f-3b00-8930-eb0e8689cc17",
                                        "entry_id": "ca09299b-f288-3f32-8949-1f624aa7f3af",
                                        "glosses": [
                                            "kleinräumiger Luftwirbel in der Erdatmosphäre"
                                        ],
                                        "tags": [
                                            "nur als Wortbestandteil -hose"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad024b87-7171-4687-be99-a99b2c249218",
                                                "sense_id": "c9d3ab25-856f-3b00-8930-eb0e8689cc17",
                                                "text": "Der Tornado wird je nach Untergrund auch Wasser-Hose, Wind-Hose oder Staub-Hose genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
