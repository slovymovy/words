                                "sense_id": "7fd27d36-6826-3d1c-85b2-87cb96c4bcf2",
                                "text": "Acetofenon ma intensywny zapach kojarzący się z suszonymi różami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
