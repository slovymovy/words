                        "faire un total"
                    ]
                },
                {
                    "sense_id": "b65a41a6-2fe4-3619-812f-3e5161e63ce2",
                    "sense_definition": "Dire ou prononcer, souvent en incise dans le discours.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "« Je serai là demain matin », <w>fit</w> le voisin avec un grand sourire rassurant."
                        },
                        {
                            "text": "« Ce n'est pas possible », <w>faisait</w> l'enfant en secouant tristement la tête."
                        }
                    ],
                    "common_phrases": [
                        "faire entendre"
                    ]
                },
                {
                    "sense_id": "607ac400-a97f-3481-a177-e81761fdd42d",
                    "sense_definition": "S'habituer ou s'accoutumer à une situation ou un environnement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est difficile au début de vivre en ville, mais on s'y <w>fait</w> rapidement."
                        },
                        {
                            "text": "Après plusieurs semaines de vacances, j'ai du mal à me <w>faire</w> à ce nouveau rythme."
                        }
