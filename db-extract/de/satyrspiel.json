                        "entry_id": "ce77d5a3-6609-3207-86f9-4574c5f209df",
                        "glosses": [
                            "humoristisches Schlussspiel der altgriechischen Tetralogie und Theaterevent von drei Tragödien und dem abschließenden Satyrspiel, das die schwer lastende Stimmung der dreitägigen Tragödienaufführungen durch einen Chor aus Satyrn aufhellen sollte"
                        ],
                        "tags": [
                            "altgriechisches Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "97e6671a-7051-4187-826a-67dbe61a7885",
                                "sense_id": "7b047390-09b1-3ba6-8503-66843afd5f77",
                                "text": "Als Satyrspiele erhalten und auf unsere Zeit überkommen sind „Die Spürhunde“ von Sophokles und „Der Kyklop“ von Euripides."
                            }
                        ],
                        "sense_index_json": "\"1\""
