                ],
                "senses": [
                    {
                        "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                        "entry_id": "b789630c-1f8f-3425-bfa2-8fa2e9da2da2",
                        "glosses": [
                            "deutscher Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac6fc18-6876-4c93-81b2-2b06ee4a432f",
                                "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                                "text": "Frau Homann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "585a074c-0bf5-45af-a8da-7af62f57dea0",
                                "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                                "text": "Herr Homann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "25cada06-529d-4dbf-aec3-cd284edd7ef7",
                                "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                                "text": "Die Homanns kommen heute aus Hannover."
                            },
                            {
                                "example_id": "5b79c2cd-8703-4d85-8575-4d9c2e85ec4e",
                                "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                                "text": "Der Homann trägt nie die Schals, die die Homann ihm strickt."
                            },
                            {
                                "example_id": "a3d49a2a-fd9e-4c8c-b2fc-d7baf3442184",
                                "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Homann kommt, geht der Herr Homann.“"
                            },
                            {
                                "example_id": "d22750d4-0770-427a-a87f-95cce35f4192",
                                "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                                "text": "Homann kommt und geht."
                            },
                            {
                                "example_id": "b2f0a0a8-2b65-4de3-a4cd-c7764ba4a906",
                                "sense_id": "ed131c12-eba9-32c4-bcbf-c7030eb63cf7",
                                "text": "Homanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
