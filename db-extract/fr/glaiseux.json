                    {
                        "sense_id": "dd679a88-2fe2-3690-a3d0-a5e5f612561c",
                        "entry_id": "18b880ff-2146-3138-bae6-eb4a6abe0a5c",
                        "glosses": [
                            "Paysan."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8cd64f5b-0f4e-425a-8620-0b822f35cf6c",
                                "sense_id": "dd679a88-2fe2-3690-a3d0-a5e5f612561c",
                                "text": "Le glaiseux et ses lardons"
                            },
                            {
                                "example_id": "19983e74-39da-4193-8543-e51d43e79f5c",
                                "sense_id": "dd679a88-2fe2-3690-a3d0-a5e5f612561c",
                                "text": "Si peu qu'il reste de terre héréditaire, si révoltés qu'en soient les hoirs, les seuls glaiseux peuvent dire ce que ça peut recoller aux pieds."
                            },
                            {
                                "example_id": "d7d0e4eb-94f7-482e-bf95-12f2cf2b8bd3",
                                "sense_id": "dd679a88-2fe2-3690-a3d0-a5e5f612561c",
                                "text": "Pitié! Je ne suis qu'un glaiseux!"
                            }
                        ]
                    }
                ],
