                ],
                "senses": [
                    {
                        "sense_id": "a908b606-0027-3b21-b10b-71c5f9e4060c",
                        "entry_id": "cafd8d25-55ed-34bf-9011-13830a2c94f4",
                        "glosses": [
                            "mąż matki, który nie jest ojcem biologicznym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35bf079f-f848-4da2-87d0-bbadf371580f",
                                "sense_id": "a908b606-0027-3b21-b10b-71c5f9e4060c",
                                "text": "Po śmierci ojca, moja matka ponownie wyszła za mąż. Mój ojczym jest dla mnie bardzo miły."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8c96a22-c602-44b9-87e7-86902aaf38d3",
                        "source_entry_id": "cafd8d25-55ed-34bf-9011-13830a2c94f4",
                        "source_sense_id": "a908b606-0027-3b21-b10b-71c5f9e4060c",
                        "target_lang_word": "stepfather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stepfather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "feda8f23-ba3c-3d41-bfca-5ed2dd672a28",
                                        "entry_id": "2f6bbf37-609a-3329-930a-717771739709",
                                        "glosses": [
                                            "The husband of one's biological mother after her initial marriage to or relationship with one's biological father."
                                        ],
                                        "tags": [
                                            "in the narrow sense"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23bc5c3c-5ba8-4112-9538-46f72f1f6e61",
                                                "sense_id": "feda8f23-ba3c-3d41-bfca-5ed2dd672a28",
                                                "text": "My stepfather loved me as much as he loved his own three sons. I knew how much he wanted to help me and how lacking in financial resources he was. Nothing could erase the image I gained of my real father that day: a carefree, well-to-do man who didn't really give a damn about the hopes and dreams of his firstborn son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a471b32-11e2-35c7-8e77-b47596d492ae",
                                        "entry_id": "2f6bbf37-609a-3329-930a-717771739709",
                                        "glosses": [
                                            "The husband of one's parent distinct from one's biological father or person with a similar relationship."
                                        ],
                                        "tags": [
                                            "in the broad sense"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed003b8-a3a2-4127-97fc-1d8d93cd7f5e",
                                                "sense_id": "8a471b32-11e2-35c7-8e77-b47596d492ae",
                                                "text": "In suboptimal cases the gynaecologist takes sperm from anonymous donors. In this case the husband can only be stepfather of the child."
                                            },
                                            {
                                                "example_id": "dc58998e-5279-4f2e-80cd-cb18a8e7897c",
                                                "sense_id": "8a471b32-11e2-35c7-8e77-b47596d492ae",
                                                "text": "Telegony or Inheritance from the Stepfather\nThe earliest reference to telegony ( which has no connection with the son of Odysseus ) is supposed to be in 1665 but the classical case is that described in the Philosophical Transactions of[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14caea0b-fefa-436f-b635-112171a89627",
                        "source_entry_id": "cafd8d25-55ed-34bf-9011-13830a2c94f4",
                        "source_sense_id": "a908b606-0027-3b21-b10b-71c5f9e4060c",
                        "target_lang_word": "otčím",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "otčím",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3e07cbe0-f66c-301c-ad14-0b92210fa16c",
                                        "entry_id": "c1a7a598-7a10-38f3-a93d-972cbca325f5",
                                        "glosses": [
                                            "nevlastní otec, matčin manžel nebo partner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ac86e3-777f-4056-ac52-270795d4c9e6",
                                                "sense_id": "3e07cbe0-f66c-301c-ad14-0b92210fa16c",
                                                "text": "Má rodiče, vlastní matku, ale otec jí umřel, když jí bylo devět let, bylo tomu osm let o Jiří. Matka se zase provdala — má otčíma."
                                            },
                                            {
                                                "example_id": "50e4903f-66a5-4556-91ac-046d8eae3821",
                                                "sense_id": "3e07cbe0-f66c-301c-ad14-0b92210fa16c",
                                                "text": "Za chlapcem zlostí rozzuřen zlý otčím dále chvátá, a když mu zmizel za dvorem, uzavřel za ním vrata."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c2395e4-d480-4411-bf9a-b25f7e6c7685",
                        "source_entry_id": "cafd8d25-55ed-34bf-9011-13830a2c94f4",
                        "source_sense_id": "a908b606-0027-3b21-b10b-71c5f9e4060c",
                        "target_lang_word": "nevlastní otec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6fff191b-3d9d-4b1b-939c-0f60c1551f74",
                        "source_entry_id": "cafd8d25-55ed-34bf-9011-13830a2c94f4",
                        "source_sense_id": "a908b606-0027-3b21-b10b-71c5f9e4060c",
                        "target_lang_word": "beau-père",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beau-père",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9265085-f09c-311c-a5aa-3fa50381b312",
                                        "entry_id": "b37574fc-e346-3a69-9597-5a264c617b18",
                                        "glosses": [
                                            "Père d’un conjoint par rapport à l’autre conjoint."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0049b46e-3da4-4971-84fc-f2dd63aaf4df",
                                                "sense_id": "f9265085-f09c-311c-a5aa-3fa50381b312",
                                                "text": "Manicamp. – Ne m’appelez pas Manicamp… ça me désoblige… appelez-moi beau-père…"
                                            },
                                            {
                                                "example_id": "da6beae6-da29-4a57-8c6e-c60153dfe475",
                                                "sense_id": "f9265085-f09c-311c-a5aa-3fa50381b312",
                                                "text": "— Oh ! j’ai été si peu marié, d’ailleurs ce n’est pas une femme que j’ai épousée, c’est un beau-père."
                                            },
                                            {
                                                "example_id": "01b398b0-48cb-4745-80f1-25df56c363a6",
                                                "sense_id": "f9265085-f09c-311c-a5aa-3fa50381b312",
                                                "text": "Les filles de nobliaux seront absorbées par les roturiers enrichis… et les fils des hobereaux démocratiseront leur nom et s'associeront à leurs beaux-pères industriels, s'excusant dans les réunions d'être « nés nobles. »"
                                            },
                                            {
                                                "example_id": "11aa9df7-0616-4508-b2c1-c21767f2f200",
                                                "sense_id": "f9265085-f09c-311c-a5aa-3fa50381b312",
                                                "text": "Jean-Marc continue à draguer, à faire des blagues salaces et à embarrasser son comparse pendant qu’ils tentent d’échapper à une militaire teigneuse campée par Claude Perron, sans froisser le futur beau-père du héros joué par Nicolas Marié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac2cdc49-1952-3a39-9842-0e0f1702062a",
                                        "entry_id": "b37574fc-e346-3a69-9597-5a264c617b18",
                                        "glosses": [
                                            "Nouvel époux (ou compagnon) de la mère ou du père, par rapport aux enfants que la mère ou le père a eus lors d’une union précédente."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "160282ad-f736-4294-8cbc-f573aa3e620f",
                                                "sense_id": "ac2cdc49-1952-3a39-9842-0e0f1702062a",
                                                "text": "En effet, tant que le beau-père de son fils s’était montré rogue et agressif, elle avait trouvé de la force dans la résistance qu’elle opposait à la brutalité du boutiquier."
                                            },
                                            {
                                                "example_id": "a0a16b48-f73a-4925-b127-ceb4dc482800",
                                                "sense_id": "ac2cdc49-1952-3a39-9842-0e0f1702062a",
                                                "text": "Mes quatre beaux-fils ne m’appellent pas beau-père, mais “joli-papa”, et me présentent comme tel à leurs amis, raconte, par exemple, Dominique."
                                            },
                                            {
                                                "example_id": "1582798f-124b-4e13-8c0b-cec6e9825e61",
                                                "sense_id": "ac2cdc49-1952-3a39-9842-0e0f1702062a",
                                                "text": "Quelques jours plus tôt, le 26 novembre 2016, après six semaines de violences, le blondinet à la bouille d’ange succombait sous les coups de Loïc Vantal, son beau-père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46bd822a-1eae-495a-b3bd-a3a1ee5c10f2",
                        "source_entry_id": "cafd8d25-55ed-34bf-9011-13830a2c94f4",
                        "source_sense_id": "a908b606-0027-3b21-b10b-71c5f9e4060c",
                        "target_lang_word": "parâtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "226629dc-fcb7-33e3-93eb-d389adb1dfc2",
                                        "entry_id": "6aa6d9b6-14ff-3472-9f69-08f1051d43e2",
                                        "glosses": [
                                            "Beau-père, nouvel époux (ou compagnon) de la mère ou du père par rapport aux enfants de la première union."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce123c7-54e7-4745-9590-8a938c92ccbe",
                                                "sense_id": "226629dc-fcb7-33e3-93eb-d389adb1dfc2",
                                                "text": "S’il arrive de temps à autre que des enfants aient à se plaindre des traitements d’un parâtre ou d’une marâtre, ou seulement de certaines préférences, il n’en est pas moins vrai, […], les secondes noces, au lieu d’être un mal pour eux, leurs sont incontestablement avantageuses."
                                            },
                                            {
                                                "example_id": "83e3ee4c-9079-41af-9b56-f7d8e7dd96cd",
                                                "sense_id": "226629dc-fcb7-33e3-93eb-d389adb1dfc2",
                                                "text": "Pour reparler du conseil, je vais vous dire : ceux qui en seront vont vite se demander pourquoi vous voilà, vous, le parâtre, si fort incrusté auprès de jeunes filles qui ne vous sont rien."
                                            }
                                        ]
                                    },
