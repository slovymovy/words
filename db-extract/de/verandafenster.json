                "senses": [
                    {
                        "sense_id": "1c5c8c14-6f35-3f14-b81f-452a29fc237a",
                        "entry_id": "58a22afe-1c05-3669-b4a5-f0514fdd81d7",
                        "glosses": [
                            "Fenster zur Veranda hin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b2cef0d-cd7f-4d8f-b606-3ef22897de25",
                                "sense_id": "1c5c8c14-6f35-3f14-b81f-452a29fc237a",
                                "text": "„Wir standen am Verandafenster.“"
                            },
                            {
                                "example_id": "1d72a7db-3f82-4450-a4ac-4c7e83f9103a",
                                "sense_id": "1c5c8c14-6f35-3f14-b81f-452a29fc237a",
                                "text": "„Mit dem Blick durch die Verandafenster auf den See könnte man glauben, Teil einer privaten Verabredung zu sein.“"
                            },
                            {
                                "example_id": "1b7b57f5-589b-46f1-aa1e-bf4bce1b2bdd",
                                "sense_id": "1c5c8c14-6f35-3f14-b81f-452a29fc237a",
                                "text": "„Der obere Balkon war ursprünglich offen und die darunterliegende Eingangstür zur Straße wurde in den 70-er Jahren geschlossen und durch ein großes Verandafenster ersetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
