                                "target_senses": [
                                    {
                                        "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                        "entry_id": "ec9bfe1c-334f-326e-b7d5-d47a244e8f99",
                                        "glosses": [
                                            "Personne qui a écrit une ou plusieurs biographies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d43c2ab-2b75-47ee-a9de-6152d4c479f2",
                                                "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                                "text": "Quelle fut, au juste, la sentence rendue par l'Official ? Les biographes nous racontent qu'il n'y en eut pas, […]."
                                            },
                                            {
                                                "example_id": "4dfa6071-69bb-499d-9924-ca419ed007ac",
                                                "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                                "text": "Il n'est pas prudent, je le sais, de désavouer des biographes bien disposés en votre faveur, et qui peuvent vous menacer d'une édition revue et corrigée ; mais je n'ai jamais été prudente en quoi que ce soit."
                                            },
                                            {
                                                "example_id": "f1586e36-30cc-47c5-adb2-a3f7ecfdc356",
                                                "sense_id": "59c90e3d-a70e-3ba1-9567-905c3b93b31d",
                                                "text": "Déjà les biographes veillaient au grain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
