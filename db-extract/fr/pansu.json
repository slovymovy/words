                "senses": [
                    {
                        "sense_id": "729b2698-afaa-31bb-9ddc-bf856476f0e4",
                        "entry_id": "a6c81645-01ad-333e-b5dd-da59b22b59e3",
                        "glosses": [
                            "Qui a une grosse panse, un gros ventre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4171bb5e-f96f-4aee-89b3-228625465c0e",
                                "sense_id": "729b2698-afaa-31bb-9ddc-bf856476f0e4",
                                "text": "Rien en lui ne rappelle son père, c’est un être banal et pansu surgi d’on ne sait où."
                            },
                            {
                                "example_id": "cd4d8603-1df7-403f-9d20-969a35d9dbb3",
                                "sense_id": "729b2698-afaa-31bb-9ddc-bf856476f0e4",
                                "text": "Il déchirait à belles dents un gros chapon gras et pansu."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a8d4c5a-86db-3c90-a926-07bf494b4927",
                        "entry_id": "a6c81645-01ad-333e-b5dd-da59b22b59e3",
                        "glosses": [
                            "Renflé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2ffc2832-81d7-4971-b60f-7f8025a8820e",
                                "sense_id": "7a8d4c5a-86db-3c90-a926-07bf494b4927",
                                "text": "Le démarrage de la puissante voiture nous donna une forte secousse, qui nous jeta, riants, les uns contre les autres, puis le vaillant guide traversa très habillement la grille, qui, de notre calèche pansue, nous apparaissait tout à coup terriblement étroite, et nous atteignîmes la chaussée sans encombre."
                            }
                        ]
                    }
                ],
