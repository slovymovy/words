                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c93daa-498a-4e52-bcfe-ac5719bccc43",
                                "sense_id": "a83cc90a-90d8-3d06-97ee-a06722a9d261",
                                "text": "„Dies ist eine besondere Rechtschreibregel des Deutschen.“"
                            },
                            {
                                "example_id": "f213c57f-ddf9-49d1-86f9-cc390cb3704e",
                                "sense_id": "a83cc90a-90d8-3d06-97ee-a06722a9d261",
                                "text": "„Wenn die Rechtschreibregeln mehrere Schreibungen zulassen, stehen beide Formen durch Komma getrennt nebeneinander.“"
                            },
                            {
                                "example_id": "61cba7a6-dc29-480e-972c-cc1fb1a58f03",
                                "sense_id": "a83cc90a-90d8-3d06-97ee-a06722a9d261",
                                "text": "„Das »Große Fremdwörterbuch« liegt jetzt in einer vierten, auf der Basis der seit August 2006 verbindlichen Rechtschreibregeln aktualisierten Auflage vor.“"
                            }
                        ],
