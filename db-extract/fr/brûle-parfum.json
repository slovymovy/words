                    {
                        "form_id": "06499d79-a5fd-4a00-a729-b1420b88b817",
                        "entry_id": "283a6e7a-f55f-3ff1-86cf-eb020a64cbac",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "brule-parfum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82b3b8af-0d81-3d66-b70c-d842f8b0bc1f",
                        "entry_id": "283a6e7a-f55f-3ff1-86cf-eb020a64cbac",
                        "glosses": [
                            "Sorte de vase ou de réchaud reposant généralement sur un trépied et où l’on brûle des substances aromatiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0705dc5-8db6-4b18-a702-fc74fb217de7",
                                "sense_id": "82b3b8af-0d81-3d66-b70c-d842f8b0bc1f",
                                "text": "Sur une colonne en marbre de Carrare, la statue d’Éros, debout, l’arc au dos, soutenait de ses bras arrondis d’amples rideaux de brocart d’Orient, retombant en plis voluptueux tout autour de la conque, et, du côté du chevet, un trépied en bronze portait un brûle-parfums étoilé de pierres précieuses où se mourait une flamme rose dégageant une vague odeur d’encens."
                            },
                            {
                                "example_id": "26dc772c-d056-4ce4-b8ad-a9ce0289f8d5",
                                "sense_id": "82b3b8af-0d81-3d66-b70c-d842f8b0bc1f",
                                "text": "Il s’agit d’un brûle-parfum ancien… un Chine de la famille verte de la plus belle et authentique espèce."
                            },
                            {
                                "example_id": "db68b8a9-fcd6-4fe9-973a-f3c06e326c99",
                                "sense_id": "82b3b8af-0d81-3d66-b70c-d842f8b0bc1f",
                                "text": "Plus de 3.000 objets au total y sont présentés, liés étroitement à leur vie quotidienne, dont plusieurs sont d’une grande valeur culturelle comme gongs, brûle-parfums en cuir ou métiers à tisser."
                            }
                        ]
                    },
                    {
                        "sense_id": "798ec2e3-6632-3d58-9d8d-1b28d5cf0b69",
                        "entry_id": "283a6e7a-f55f-3ff1-86cf-eb020a64cbac",
                        "glosses": [
                            "Arme à feu."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "695ea904-c67c-42ea-b453-e2414f090508",
                                "sense_id": "798ec2e3-6632-3d58-9d8d-1b28d5cf0b69",
                                "text": "— Je m’absente pour quarante-huit plombes, ajouta Milo. Je te verrai à mon retour. Allez, dégage.\nIl me tapota sur l’épaule, un œil sur Charlot le Boucher qui avait remisé son brûle-parfum."
                            }
                        ]
                    }
