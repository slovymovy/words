                "senses": [
                    {
                        "sense_id": "14d845db-a87d-3592-9fde-778fd3e1ac20",
                        "entry_id": "22a77166-7ad9-35d8-b5a5-334f3616c0d9",
                        "glosses": [
                            "kleding die hoort bij één bepaalde sportclub, het kan hier gaan om kleding die gedragen wordt tijdens het sporten maar het kan ook gaan om kleding die buiten het sportveld wordt gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77881830-08f6-462c-afe4-8011377a6d1f",
                                "sense_id": "14d845db-a87d-3592-9fde-778fd3e1ac20",
                                "text": "Jarenlang stond het in het Huishoudelijk Reglement van USHC: \"Het clubtenue bij wedstrijden bestaat voor mannen uit een broekje, en vrouwen dragen een rok\"."
                            },
                            {
                                "example_id": "8923d73c-cfde-4826-8677-15b6bf565aee",
                                "sense_id": "14d845db-a87d-3592-9fde-778fd3e1ac20",
                                "text": "Leden van voetbalclub KSK 's-Gravenwezel, waarvan Van Espen een tijd lid was, droegen een clubtenue. Buiten de kerk konden aanwezigen iets in het rouwregister schrijven."
                            },
                            {
                                "example_id": "7ecc3b9d-fbf6-4ff7-ba72-a6d8f3bfb1ed",
                                "sense_id": "14d845db-a87d-3592-9fde-778fd3e1ac20",
                                "text": "Het gaat om zeven leden van het communicatieteam van PSV. Zij liepen in het oude centrum van de Kroatische stad toen zij werden belaagd. Ze waren niet gekleed in het clubtenue. Twee van de medewerkers kregen klappen en raakten (licht) gewond."
                            }
                        ]
                    }
