{
    "word_family": [
        "hooter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "480b7818-90c5-32a0-98f3-adbc0d52ccd0",
                    "sense_definition": "To sound the horn of a vehicle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When you arrive to pick me up, <w>hoot</w>, and I'll come outside.",
                            "target_lang_translations": {
                                "zh": "你到这儿接我时<w>按喇叭</w>，我就出来。",
                                "fr": "Quand tu arriveras pour me chercher, <w>klaxonne</w>, et je sortirai."
                            }
                        },
                        {
                            "text": "The driver had to <w>hoot</w> to warn the pedestrian crossing the street.",
                            "target_lang_translations": {
                                "zh": "司机不得不<w>按喇叭</w>来提醒过马路的行人。",
                                "fr": "Le conducteur a dû <w>klaxonner</w> pour avertir le piéton qui traversait la rue."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoot the horn"
                    ],
                    "target_lang_definitions": {
                        "zh": "按汽车喇叭",
                        "fr": "Action de faire retentir le klaxon d'un véhicule."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "按喇叭",
                                "target_lang_sense_clarification": "指发出汽车喇叭声"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "klaxonner",
                                "target_lang_sense_clarification": "Utiliser l'avertisseur sonore d'une voiture."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af5a113b-1fcb-3fb9-bc8f-ba31d0c53bf8",
                    "sense_definition": "The cry of an owl.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard the <w>hoot</w> of an owl in the woods at night.",
                            "target_lang_translations": {
                                "zh": "夜里我在树林里听到了猫头鹰的<w>鸣叫</w>。",
                                "fr": "J'ai entendu le <w>hululement</w> d'un hibou dans les bois pendant la nuit."
                            }
                        },
                        {
                            "text": "The distant <w>hoot</w> echoed through the quiet forest.",
                            "target_lang_translations": {
                                "zh": "远处传来的<w>鸣叫</w>声在寂静的森林中回荡。",
                                "fr": "Le <w>hululement</w> lointain résonnait dans la forêt silencieuse."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "猫头鹰的叫声",
                        "fr": "Le cri caractéristique d'un hibou ou d'une chouette."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咕咕声",
                                "target_lang_sense_clarification": "特指猫头鹰的鸣叫"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "hululement",
                                "target_lang_sense_clarification": "Cri spécifique des oiseaux de nuit."
                            },
                            {
                                "target_lang_word": "ululement",
                                "target_lang_sense_clarification": "Terme courant pour le cri des rapaces nocturnes."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "784f38b8-2925-3439-94a3-570424b46277",
                    "sense_definition": "A derisive cry or shout.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My performance drew <w>hoots</w> of derision from the crowd.",
                            "target_lang_translations": {
                                "zh": "我的表演引来了人群中嘲弄的<w>嘘声</w>。",
                                "fr": "Ma performance a suscité des <w>huées</w> de la part de la foule."
                            }
                        },
                        {
                            "text": "The speaker was interrupted by loud <w>hoots</w> from the back of the room.",
                            "target_lang_translations": {
                                "zh": "演讲者被房间后方传来的巨大<w>嘘声</w>打断了。",
                                "fr": "L'orateur a été interrompu par de bruyantes <w>huées</w> venant du fond de la salle."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "嘲笑的叫喊声",
                        "fr": "Cri ou exclamation exprimant la dérision ou le mépris."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘘声",
                                "target_lang_sense_clarification": "表示不满或嘲弄的叫喊"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "huées",
                                "target_lang_sense_clarification": "Cris collectifs exprimant le désapprobation ou la moquerie."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46445963-5688-3a0b-a4fa-f729a806d480",
                    "sense_definition": "A fun event or person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party at the weekend was such a <w>hoot</w>!",
                            "target_lang_translations": {
                                "zh": "周末的派对真是太有<w>乐子</w>了！",
                                "fr": "La fête de ce week-end était une vraie <w>partie de plaisir</w> !"
                            }
                        },
                        {
                            "text": "You should meet my cousin, he is a real <w>hoot</w> at parties.",
                            "target_lang_translations": {
                                "zh": "你应该见见我表弟，他在派对上真是个<w>活宝</w>。",
                                "fr": "Tu devrais rencontrer mon cousin, c'est un vrai <w>rigolo</w> dans les soirées."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "非常有趣的人或事",
                        "fr": "Personne ou événement très amusant."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乐子",
                                "target_lang_sense_clarification": "指令人感到非常有趣的事物"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "partie de plaisir",
                                "target_lang_sense_clarification": "Événement très divertissant."
                            },
                            {
                                "target_lang_word": "rigolo",
                                "target_lang_sense_clarification": "Personne amusante ou comique."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e66ef91-2231-3ef1-a748-b15a11bbf45e",
                    "sense_definition": "A small particle; a whit or jot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We don't care a <w>hoot</w> about what you think.",
                            "target_lang_translations": {
                                "zh": "我们对你的想法<w>毫不在乎</w>。",
                                "fr": "On ne se <w>soucie pas comme d'une guigne</w> de ce que tu penses."
                            }
                        },
                        {
                            "text": "He didn't give a <w>hoot</w> about the consequences of his actions.",
                            "target_lang_translations": {
                                "zh": "他对自己行为的后果<w>毫不在乎</w>。",
                                "fr": "Il ne se <w>souciait pas comme d'une guigne</w> des conséquences de ses actes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not care a hoot"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in negative constructions."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一点点，通常用于否定句",
                        "fr": "Une toute petite quantité, souvent utilisé dans des expressions négatives pour marquer l'indifférence."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "毫不在乎",
                                "target_lang_sense_clarification": "用于表示完全不关心"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se soucier comme d'une guigne",
                                "target_lang_sense_clarification": "Expression idiomatique pour dire qu'on ne s'intéresse absolument pas à quelque chose."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2098afaf-6408-30b0-b9f5-6a1b76efcdfc",
                    "sense_definition": "Money, especially in the form of cash given as payment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On the construction site you could make a pot of <w>hoot</w> in no time.",
                            "target_lang_translations": {
                                "zh": "在建筑工地上，你很快就能赚到一大笔<w>钱</w>。",
                                "fr": "Sur le chantier, tu pouvais te faire un paquet de <w>fric</w> en un rien de temps."
                            }
                        },
                        {
                            "text": "He was always looking for ways to earn more <w>hoot</w>.",
                            "target_lang_translations": {
                                "zh": "他总是在寻找赚更多<w>钱</w>的方法。",
                                "fr": "Il cherchait toujours des moyens de gagner plus de <w>thune</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "money",
                        "cash"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Archaic or regional slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "钱，尤指现金",
                        "fr": "Argent, en particulier sous forme d'espèces."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钱",
                                "target_lang_sense_clarification": "俚语用法"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "fric",
                                "target_lang_sense_clarification": "Terme familier pour désigner l'argent."
                            },
                            {
                                "target_lang_word": "thune",
                                "target_lang_sense_clarification": "Terme argotique pour l'argent."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "481f4280-1bdf-3acb-b740-83d27ac12c5d",
                    "sense_definition": "To make a hoo, the cry of an owl.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Outside an owl was <w>hooting</w> most dismally in the darkness.",
                            "target_lang_translations": {
                                "zh": "外面，一只猫头鹰在黑暗中凄凉地<w>鸣叫</w>着。",
                                "fr": "Dehors, un hibou <w>hululait</w> tristement dans l'obscurité."
                            }
                        },
                        {
                            "text": "The clamorous owl that nightly <w>hoots</w> and wonders at our spirits.",
                            "target_lang_translations": {
                                "zh": "那只吵闹的猫头鹰每晚都在<w>鸣叫</w>，惊叹着我们的灵魂。",
                                "fr": "Le hibou bruyant qui <w>hulule</w> chaque nuit et s'émerveille de nos esprits."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "猫头鹰发出叫声",
                        "fr": "Émettre le cri propre au hibou."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸣叫",
                                "target_lang_sense_clarification": "指猫头鹰发出咕咕声"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "hululer",
                                "target_lang_sense_clarification": "Verbe spécifique pour le cri des oiseaux de nuit."
                            },
                            {
                                "target_lang_word": "ululer",
                                "target_lang_sense_clarification": "Verbe synonyme pour le cri des rapaces nocturnes."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45fe110e-2b67-3cfd-b863-02ac2bff47c1",
                    "sense_definition": "To cry out or shout in contempt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Matrons and girls shall <w>hoot</w> at thee no more.",
                            "target_lang_translations": {
                                "zh": "主妇和姑娘们再也不会对你<w>起哄</w>了。",
                                "fr": "Les matrones et les jeunes filles ne te <w>hueront</w> plus."
                            }
                        },
                        {
                            "text": "The crowd began to <w>hoot</w> when the politician started speaking.",
                            "target_lang_translations": {
                                "zh": "当政客开始讲话时，人群开始<w>起哄</w>。",
                                "fr": "La foule a commencé à <w>huer</w> quand le politicien a commencé à parler."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "大声嘲笑或表示蔑视",
                        "fr": "Crier ou interpeller quelqu'un avec mépris."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "起哄",
                                "target_lang_sense_clarification": "指通过叫喊表示不满或嘲弄"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "huer",
                                "target_lang_sense_clarification": "Manifester son mécontentement par des cris."
                            },
                            {
                                "target_lang_word": "railler",
                                "target_lang_sense_clarification": "Se moquer ouvertement de quelqu'un."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6659eb12-73f9-39d0-ab38-a9603bd8b554",
                    "sense_definition": "To assail with contemptuous cries or shouts; to follow with derisive shouts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mary felt extremely offended when the workers <w>hooted</w> at her.",
                            "target_lang_translations": {
                                "zh": "当工人们对她<w>喝倒彩</w>时，玛丽感到非常受辱。",
                                "fr": "Mary s'est sentie extrêmement offensée quand les ouvriers l'ont <w>huée</w>."
                            }
                        },
                        {
                            "text": "They <w>hooted</w> the performer off the stage after a terrible show.",
                            "target_lang_translations": {
                                "zh": "演出糟糕透顶，他们把表演者<w>喝倒彩</w>赶下了台。",
                                "fr": "Ils ont <w>sifflé</w> l'artiste pour le faire descendre de scène après un spectacle terrible."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用嘲笑声驱赶某人",
                        "fr": "Pousser des cris de dérision pour forcer quelqu'un à partir."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喝倒彩",
                                "target_lang_sense_clarification": "指通过嘘声让某人离开"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "siffler",
                                "target_lang_sense_clarification": "Exprimer sa désapprobation bruyante, souvent au théâtre ou en public."
                            },
                            {
                                "target_lang_word": "chahuter",
                                "target_lang_sense_clarification": "Perturber quelqu'un par des cris et du bruit."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d301e15c-1867-37e5-bd69-151304bb5c50",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hoot</w> is the new teacher at the school.",
                            "target_lang_translations": {
                                "zh": "<w>胡特</w>先生是学校的新老师。",
                                "fr": "M. <w>Hoot</w> est le nouveau professeur à l'école."
                            }
                        },
                        {
                            "text": "The <w>Hoots</w> family moved into the neighborhood last week.",
                            "target_lang_translations": {
                                "zh": "<w>胡特</w>一家上周搬到了这个社区。",
                                "fr": "La famille <w>Hoot</w> a emménagé dans le quartier la semaine dernière."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏",
                        "fr": "Un nom de famille."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胡特",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "Hoot",
                                "target_lang_sense_clarification": "Nom propre (patronyme)."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}