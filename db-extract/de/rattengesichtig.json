                    },
                    {
                        "form_id": "1fe6dedd-3d69-414e-8c0b-6ec02048edb2",
                        "entry_id": "4cd099c8-1040-31dc-874f-fef50ffd0043",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind rattengesichtig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8af8722-46b5-30ab-b123-eafa93b4fe66",
                        "entry_id": "4cd099c8-1040-31dc-874f-fef50ffd0043",
                        "glosses": [
                            "ein hässliches, an das einer Ratte erinnerndes Gesicht habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d65ad6-e1db-49c7-a631-c9f42da81e20",
                                "sense_id": "f8af8722-46b5-30ab-b123-eafa93b4fe66",
                                "text": "„Fischmann verkörpert großartig einen rattengesichtigen, wienerisch-näselnden, pedantischen Beamten und Krabbe brilliert als bitterböser, aber nur bedingt heterosexueller Diener Boraccio.“"
                            },
                            {
                                "example_id": "d0a4ef55-3ff9-4ab4-bfa5-cd3d18ea73de",
                                "sense_id": "f8af8722-46b5-30ab-b123-eafa93b4fe66",
                                "text": "„Wer weiß, ob er nicht ein ganzes Imperium auf dem schwarzen Land erschaffen hätte, wäre Carlos nicht gewesen, sein rattengesichtiger Neffe – aber ich greife schon zu weit vor.“"
                            },
                            {
                                "example_id": "756d4a78-7637-41c4-92f3-8d448e3ccd51",
                                "sense_id": "f8af8722-46b5-30ab-b123-eafa93b4fe66",
                                "text": "„Ich hätte geschmunzelt, denn ich hatte Lestrade in der Chronik zu unserem ersten gemeinsamen Fall in ähnlicher Weise als rattengesichtig beschrieben, wenn mich die nun vorliegende Tatsache nicht dermassen schockiert hätte.“"
                            },
                            {
                                "example_id": "d80c84f6-89d6-451a-b1c1-5eb935fccf2c",
                                "sense_id": "f8af8722-46b5-30ab-b123-eafa93b4fe66",
                                "text": "„Die Figur des Grafen Dracula erscheint hier als leichenhaft, rattengesichtig, mit fledermausartigen Ohren und Spinnenfingern, ist also in höchstem Maße abstoßend.“"
                            },
                            {
                                "example_id": "f610ffd8-db44-4c79-b26c-6170419c3d9a",
