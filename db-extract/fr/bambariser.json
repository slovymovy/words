                ],
                "senses": [
                    {
                        "sense_id": "9830d113-8c53-3959-994f-74b60c27bfc4",
                        "entry_id": "d2186369-02e6-3f8b-89c8-be6ad8286311",
                        "glosses": [
                            "Donner un caractère bambara à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0630f5-c7fc-47b6-9d5f-f8105e6f649b",
                                "sense_id": "9830d113-8c53-3959-994f-74b60c27bfc4",
                                "text": "En revanche, il existe beaucoup de villages de Foroba-Foula, descendants de Peul capturés à la guerre et bambarisés (campagne de Bakary-Dian, fin du xvme siècle- début du xixe siècle)."
                            },
                            {
                                "example_id": "9a6d2090-cefd-4707-a569-89b44cc78abd",
                                "sense_id": "9830d113-8c53-3959-994f-74b60c27bfc4",
                                "text": "Il est donc tout à fait probable que la quatrième génération soit tout à fait bambarisée malgré l’acharnement de certains pères de famille qui ne peuvent empêcher leurs enfants de sortir et d’apprendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ac77db3-3bde-39d7-9be5-6b8da3daf111",
                        "entry_id": "d2186369-02e6-3f8b-89c8-be6ad8286311",
                        "glosses": [
                            "Pratiquer le bambara."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4f877d-aae4-4b09-84ff-f9a8dfe604e2",
                                "sense_id": "3ac77db3-3bde-39d7-9be5-6b8da3daf111",
                                "text": "Dans l'après-midi, Kassambara vient bambariser avec Jean-Pierre qui appelle Youssouf pour traduction."
                            }
                        ]
                    }
