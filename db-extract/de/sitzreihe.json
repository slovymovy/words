                                "target_senses": [
                                    {
                                        "sense_id": "45041346-adf8-3705-bf9c-d48a1c83c493",
                                        "entry_id": "afc468d1-66fe-3a5f-b43a-5bd2c2cf5d78",
                                        "glosses": [
                                            "A line of objects, often regularly spaced, such as seats in a theatre, vegetable plants in a garden, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fb3b728-0927-4560-9b59-2cb57f45dd3c",
                                                "sense_id": "45041346-adf8-3705-bf9c-d48a1c83c493",
                                                "text": "And there were windows in three rows."
                                            },
                                            {
                                                "example_id": "49390098-d4db-43b4-9f7a-0228be04cb7a",
                                                "sense_id": "45041346-adf8-3705-bf9c-d48a1c83c493",
                                                "text": "The bright seraphim in burning row."
                                            },
                                            {
                                                "example_id": "20de4490-77cf-41c0-afb6-e7bc68dfb5cc",
                                                "sense_id": "45041346-adf8-3705-bf9c-d48a1c83c493",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d5a0bb-f949-37a5-8c43-757ebc6a2a20",
                                        "entry_id": "afc468d1-66fe-3a5f-b43a-5bd2c2cf5d78",
                                        "glosses": [
                                            "A horizontal line of entries in a table, etc., going from left to right, as opposed to a column going from top to bottom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8de440d-cbb0-3fa8-bf53-8b8449a7e3ed",
                                        "entry_id": "afc468d1-66fe-3a5f-b43a-5bd2c2cf5d78",
                                        "glosses": [
                                            "Clipping of cornrow."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93c5da37-6cd8-43e9-9e96-a46e03d238a4",
                                                "sense_id": "d8de440d-cbb0-3fa8-bf53-8b8449a7e3ed",
                                                "text": "Vyreen had just finished braiding my hair, and his call had caught me coming out of her crib with my 'rows looking tight."
                                            },
                                            {
                                                "example_id": "b8bf0c54-4539-4ecc-9436-a86c2637654a",
                                                "sense_id": "d8de440d-cbb0-3fa8-bf53-8b8449a7e3ed",
                                                "text": "If you thought it'd be hard to get a good cornrow braiding in Latvia, think again. Porzingis said he was re-braided almost every week to keep his rows fresh."
                                            }
                                        ]
                                    }
                                ]
                            },
