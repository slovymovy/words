                        ],
                        "examples": [
                            {
                                "example_id": "f988b535-0fca-4c5b-814f-187549827fbb",
                                "sense_id": "0d1b63c6-121e-33bf-8f02-c34acd224039",
                                "text": "Boję się przechodzić wieczorem koło tego nocnego sklepu, bo tam zawsze kręci się pełno żuli."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d02a9b82-5473-36e2-aab0-b32c4ab7e796",
                        "entry_id": "021f6942-ee3b-396e-815e-9d3f752423a2",
                        "glosses": [
                            "chuligan lub drobny przestępca"
                        ],
                        "tags": [
                            "commonly",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "43346fac-3b55-468f-bae3-7549272930e9",
                                "sense_id": "d02a9b82-5473-36e2-aab0-b32c4ab7e796",
                                "text": "Ostatnio na naszym osiedlu widziałam jakichś żuli, nie zostawiaj więc otwartych drzwi."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
