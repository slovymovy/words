                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dd3fc6e-c13d-4992-b0f2-50cb73c8e788",
                                "sense_id": "598ac158-5c59-3281-b22a-16ef45c0efc5",
                                "text": "Słonie mają pięciopalczaste nogi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "612fd414-e61d-3e3b-bc68-07d15b51fccc",
                        "entry_id": "34e1f2d3-9536-3a0c-8172-870495951d2e",
                        "glosses": [
                            "taki, który ma miejsce na pięć palców"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38cdefd-6be2-4cdf-8075-59b23f75775d",
                                "sense_id": "612fd414-e61d-3e3b-bc68-07d15b51fccc",
                                "text": "Moje dzieci zdecydowanie wolą pięciopalczaste rękawice od tych z jednym palcem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "66d99497-cbc2-33b5-9e0b-171bab043071",
                        "entry_id": "34e1f2d3-9536-3a0c-8172-870495951d2e",
                        "glosses": [
                            "taki, który przypomina kształtem dłoń z pięcioma palcami lub ma pięć wyrostków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c7aa1dc-02df-4496-a74d-ea9b7b7982e6",
                                "sense_id": "66d99497-cbc2-33b5-9e0b-171bab043071",
                                "text": "Ten kwiatek doniczkowy u babci, z pięciopalczastymi liśćmi, to pewnie marihuana wnuczka."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
