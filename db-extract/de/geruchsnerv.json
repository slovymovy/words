                "senses": [
                    {
                        "sense_id": "26958696-d35d-3088-b930-2a8ec73b3602",
                        "entry_id": "599f6bdf-ce0e-363b-8c00-2abed3abc46d",
                        "glosses": [
                            "erster Abschnitt der Riechbahn in der Nase; paarig angelegte Nervenstrang der direkt mit dem Zentralnervensystem verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d4d4f20-dc61-46c4-ba92-9dd9dbc186f5",
                                "sense_id": "26958696-d35d-3088-b930-2a8ec73b3602",
                                "text": "„Die Geruchsnerven sitzen in der Nasenschleimhaut, genauer in der oberen der drei Nasenmuscheln.“"
                            },
                            {
                                "example_id": "b9867d5c-5a9a-4dda-8dae-7c9f8fd0cefd",
                                "sense_id": "26958696-d35d-3088-b930-2a8ec73b3602",
                                "text": "„Der Mensch besitzt zirka 30 Millionen Geruchsnerven und eine fünf Quadratzentimeter große Riechschleimhaut.“"
                            },
                            {
                                "example_id": "8aadf396-60d7-4236-9eef-b9e20345fe52",
                                "sense_id": "26958696-d35d-3088-b930-2a8ec73b3602",
                                "text": "„Die Geruchsnerven wirken auch bei der Wahrnehmung verschiedener Geschmacksrichtungen im Mund mit, d. h., die meisten Empfindungen, die man selbst für Geschmack hält, sind in Wirklichkeit Gerüche.“"
                            },
                            {
                                "example_id": "dffdfc3a-dd5b-4486-8187-7cf6caf793d4",
                                "sense_id": "26958696-d35d-3088-b930-2a8ec73b3602",
                                "text": "„Grund dafür können zerstörte Geruchsnerven sein, chronische Entzündungen, Allergien, aber auch Hirntumore oder Alzheimer-Erkrankungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
