                "translations": [
                    {
                        "translation_id": "0f9e0ed4-c347-4046-838a-874c7c0b5057",
                        "source_entry_id": "fe17be7c-3961-39c9-aa2c-a6131f1349b9",
                        "source_sense_id": "e161dce9-67e5-3dd9-96b4-9180e387ae3c",
                        "target_lang_word": "portable radio transmitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5e4b6f5b-d961-44a9-9089-a9992b1b3f0e",
                        "source_entry_id": "fe17be7c-3961-39c9-aa2c-a6131f1349b9",
                        "source_sense_id": "e161dce9-67e5-3dd9-96b4-9180e387ae3c",
                        "target_lang_word": "walkie-talkie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walkie-talkie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef153eb-2415-33d9-b6a6-6548be90761a",
                                        "entry_id": "75e890a9-71c0-3665-abcf-958a8dc5490a",
                                        "glosses": [
                                            "A portable, bidirectional radio transceiver, usually one of a pair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcaacf9-4ba1-4b87-adff-26b38730fbdc",
                                                "sense_id": "7ef153eb-2415-33d9-b6a6-6548be90761a",
                                                "text": "It is intended to equip the yard foremen and shunters with \"walkie-talkie\" apparatus to keep them in close touch with the control office."
                                            },
                                            {
                                                "example_id": "dc643fd1-2cee-4b46-b92d-db8bc796362a",
                                                "sense_id": "7ef153eb-2415-33d9-b6a6-6548be90761a",
                                                "text": "A walkie-talkie is a handheld, portable, two-way radio transceiver. It includes a half-duplex channel (only one radio transmits at a time, though any number can listen) and a push-to-talk switch that starts transmission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b76599-bfe7-31c7-aebb-5b2ec6724269",
                                        "entry_id": "75e890a9-71c0-3665-abcf-958a8dc5490a",
                                        "glosses": [
                                            "A walk and talk."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269474f6-365b-48bf-b341-38127490738b",
                                                "sense_id": "88b76599-bfe7-31c7-aebb-5b2ec6724269",
                                                "text": "It could be that her walkie-talkie with Naylor had concerned a private matter not connected with what was about to happen to him, ..."
                                            },
                                            {
                                                "example_id": "2c9119a6-e3ac-4ebe-9390-6687bab5a31c",
                                                "sense_id": "88b76599-bfe7-31c7-aebb-5b2ec6724269",
                                                "text": "Go on a walkie-talkie. Everyone goes on a 15-minute brisk walk and talks about their day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9c23e09-abb5-4345-b939-0588a2de666f",
                        "source_entry_id": "fe17be7c-3961-39c9-aa2c-a6131f1349b9",
                        "source_sense_id": "e161dce9-67e5-3dd9-96b4-9180e387ae3c",
                        "target_lang_word": "estación de TSH",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "73ab1d0c-1426-4d21-9f52-f09c2c0904d8",
                        "source_entry_id": "fe17be7c-3961-39c9-aa2c-a6131f1349b9",
                        "source_sense_id": "e161dce9-67e5-3dd9-96b4-9180e387ae3c",
                        "target_lang_word": "ricetrasmettitore portatile",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "00f99db2-74ea-4db7-a40d-9e964b79983c",
                        "source_entry_id": "fe17be7c-3961-39c9-aa2c-a6131f1349b9",
                        "source_sense_id": "e161dce9-67e5-3dd9-96b4-9180e387ae3c",
                        "target_lang_word": "Handfunkgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handfunkgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac58f51b-5685-3b63-b6a0-524e43a4ee9f",
                                        "entry_id": "90c0ffff-20f1-3352-908c-ffc88f7cac29",
                                        "glosses": [
                                            "kleines Funkgerät, das mit einer Hand gehalten werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065c0b44-904a-4dea-8686-3f7c0e2ee4be",
                                                "sense_id": "ac58f51b-5685-3b63-b6a0-524e43a4ee9f",
                                                "text": "„Nachdem das BKA das neue BGS-Handfunkgerät \"Motorola\" in einem \"technischen Prüfbericht\" auf seine Tauglichkeit untersucht hatte, zog Roski, wie er zugab, eine Kopie für die Gegenseite.“"
                                            },
                                            {
                                                "example_id": "4e25438a-ea6b-4d12-8907-c234afb31395",
                                                "sense_id": "ac58f51b-5685-3b63-b6a0-524e43a4ee9f",
                                                "text": "„\"One-five-zero\" meldet Giambattista noch einmal laut und deutlich auf Englisch, damit auch der Lotse im Kontrollraum, der die kritischen Szenen per Rechner einspielt, die Bestätigung über sein Handfunkgerät versteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c16b12a0-9b61-4dc6-9c13-491afe1e0533",
                        "source_entry_id": "fe17be7c-3961-39c9-aa2c-a6131f1349b9",
                        "source_sense_id": "e161dce9-67e5-3dd9-96b4-9180e387ae3c",
                        "target_lang_word": "Walkie-Talkie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walkie-Talkie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                                        "entry_id": "6c07b621-692f-3518-b60e-4e32f646ae4b",
                                        "glosses": [
                                            "kleines, tragbares Gerät für Sprechfunk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60fb68e3-5a6e-4931-83a8-2ebb3af4c6d3",
                                                "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                                                "text": "„Er fuchtelt hektisch mit einem Walkie-Talkie herum.“"
                                            },
                                            {
                                                "example_id": "440fe706-000b-4276-ad64-db0da831d0bc",
                                                "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                                                "text": "„In den Händen halten sie altmodische Walkie-talkies, ihre Jacken sind an den richtigen Stellen ausgebeult.“"
                                            },
                                            {
                                                "example_id": "4249eb9a-51f1-4606-8192-371040854444",
                                                "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                                                "text": "„Finnisches Militär campiert in den Wäldern, einzelne Uniformierte mit Walkie-Talkies – laufen und liegen an allen Ufern herum – bewachen die Anlegestellen, schlafend, rauchend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4464c3f-9263-4aa7-9375-b36a2f5c6c96",
                        "source_entry_id": "fe17be7c-3961-39c9-aa2c-a6131f1349b9",
                        "source_sense_id": "e161dce9-67e5-3dd9-96b4-9180e387ae3c",
                        "target_lang_word": "talkie-walkie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talkie-walkie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f34e937c-6232-3d4e-882f-9d2265d89c8c",
                                        "entry_id": "f2640ab4-b1a7-357f-b75d-cb4892b4d3fc",
                                        "glosses": [
                                            "Émetteur-récepteur radio portatif servant aux liaisons radiophoniques sur de courtes distances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d7fbb9-86e3-4092-8f51-1806c7339382",
                                                "sense_id": "f34e937c-6232-3d4e-882f-9d2265d89c8c",
                                                "text": "Le talkie-walkie a été inventé par l’ingénieur canadien Donald Hings (1907–2004), employé par Motorola."
                                            },
                                            {
                                                "example_id": "990db895-bb93-4edb-8019-d770aefb87f1",
                                                "sense_id": "f34e937c-6232-3d4e-882f-9d2265d89c8c",
                                                "text": "On entendait les coups de gueule, les ordres et les contrordres qui grésillaient dans les talkies-walkies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
