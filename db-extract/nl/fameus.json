                "senses": [
                    {
                        "sense_id": "0c77c62d-b813-35f3-8a6b-10fc0c5dce4a",
                        "entry_id": "93478394-c0eb-3440-bbda-1277b6d31795",
                        "glosses": [
                            "beroemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b1c2a5-25b5-4676-8b65-5252c536ddcb",
                                "sense_id": "0c77c62d-b813-35f3-8a6b-10fc0c5dce4a",
                                "text": "De fameuze schrijver was ook heel tevreden met zichzelf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30ef1285-b854-4a03-97eb-a53be2e2fe40",
                        "source_entry_id": "93478394-c0eb-3440-bbda-1277b6d31795",
                        "source_sense_id": "0c77c62d-b813-35f3-8a6b-10fc0c5dce4a",
                        "source_sense_description": "beroemd",
                        "target_lang_word": "fameux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fameux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be372686-87a1-3cf5-a71d-63e30f45f9fe",
                                        "entry_id": "28c0995a-6b26-3f90-8bdc-648676f54330",
                                        "glosses": [
                                            "Dont la réputation est très grande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a2ab9bd-53f1-4447-aed7-8a25d1665e12",
                                                "sense_id": "be372686-87a1-3cf5-a71d-63e30f45f9fe",
                                                "text": "C'est sur la limite des communes de Poule et de Propières qu'est située la fameuse roche d’Ajoux, dont on fait dériver le nom d’Ara Jovis, autel de Jupiter."
                                            },
                                            {
                                                "example_id": "2e520af1-34ca-48cb-b0f8-a56a0d0e4c96",
                                                "sense_id": "be372686-87a1-3cf5-a71d-63e30f45f9fe",
                                                "text": "Voici une étape aussi sauvage qu'inédite entre l'intemporel village de Condé-Sainte-Libiaire et la fameuse ancienne chocolaterie de Noisiel."
                                            },
                                            {
                                                "example_id": "18c4a6d8-8bf9-4fbb-a242-eccaf1454a62",
                                                "sense_id": "be372686-87a1-3cf5-a71d-63e30f45f9fe",
                                                "text": "Pour le seconder, il peut compter sur les compétences aiguisées de Youness Chtioui, lui aussi passé par le fameux Palace Jamaï."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c85af17-8cd8-371e-9671-4f4e47370d10",
                                        "entry_id": "28c0995a-6b26-3f90-8bdc-648676f54330",
                                        "glosses": [
                                            "Qui est remarquable en son genre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d41434f2-10d7-4b37-a8ec-b6e459a5f242",
                                                "sense_id": "3c85af17-8cd8-371e-9671-4f4e47370d10",
                                                "text": "Un fameux vin."
                                            },
                                            {
                                                "example_id": "291bf1f0-8f80-49d4-8700-7192bfd3c816",
                                                "sense_id": "3c85af17-8cd8-371e-9671-4f4e47370d10",
                                                "text": "De fameuses réjouissances."
                                            },
                                            {
                                                "example_id": "f1f6c1d6-ddc9-4823-a3c5-867a3a7a9932",
                                                "sense_id": "3c85af17-8cd8-371e-9671-4f4e47370d10",
                                                "text": "Cet homme est un fameux gredin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
