                ],
                "senses": [
                    {
                        "sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                        "entry_id": "e7ada7ed-0738-31f9-812e-9a44455d52a9",
                        "glosses": [
                            "das Raumgebiet um einen Planeten oder Stern, in dem das Magnetfeld des Objektes dominiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1914388-1baa-4748-bcb7-b1f0039e8738",
                                "sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                                "text": "„Die Magnetosphäre der Erde ist typisch für die Magnetosphären von Planeten mit eigenem Magnetfeld.“"
                            },
                            {
                                "example_id": "0ae325e4-6dda-4669-ba2d-4848bc0ef165",
                                "sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                                "text": "„Polarlichter entstehen, wenn elektrisch geladene Teilchen aus der Magnetosphäre (hauptsächlich Elektronen, aber auch Protonen) auf Sauerstoff- und Stickstoffatome in den oberen Schichten der Erdatmosphäre treffen und diese ionisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ba64ac7-a0ca-4d4c-a054-463c22170708",
                        "source_entry_id": "e7ada7ed-0738-31f9-812e-9a44455d52a9",
                        "source_sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                        "source_sense_description": "Astronomie: das Raumgebiet um einen Planeten oder Stern, in dem das Magnetfeld des Objektes dominiert",
                        "target_lang_word": "磁层",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "57df884b-4cf7-48b2-b88c-f31014e9f42d",
                        "source_entry_id": "e7ada7ed-0738-31f9-812e-9a44455d52a9",
                        "source_sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                        "source_sense_description": "Astronomie: das Raumgebiet um einen Planeten oder Stern, in dem das Magnetfeld des Objektes dominiert",
                        "target_lang_word": "magnetosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "679cb3de-3378-37bd-82ea-8aa9c55b3a7d",
                                        "entry_id": "a1e624a1-735f-3a36-a035-00f9df86a30e",
                                        "glosses": [
                                            "The comet-shaped region around Earth or another planet in which charged particles are trapped or deflected. Shaped by the solar wind and the planet's magnetic field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f448ed9b-094c-4ab6-b158-a6b7475942fc",
                                                "sense_id": "679cb3de-3378-37bd-82ea-8aa9c55b3a7d",
                                                "text": "We derive rotation periods, photometric activity indices, flaring energies, mass loss rates, gyrochronological ages, X-ray luminosities and consider implications for the planetary magnetospheres and habitability."
                                            },
                                            {
                                                "example_id": "8e705c22-61c6-45e9-ba38-43e0564db878",
                                                "sense_id": "679cb3de-3378-37bd-82ea-8aa9c55b3a7d",
                                                "text": "One of the earliest (and biggest) space weather events on record occurred in September 1859, when a massive solar eruption crashed into the Earth's magnetosphere, triggering a geomagnetic storm that lasted for days."
                                            },
                                            {
                                                "example_id": "7c26e94c-a534-460e-8c53-9e07f4fa1ce8",
                                                "sense_id": "679cb3de-3378-37bd-82ea-8aa9c55b3a7d",
                                                "text": "Earth is surrounded by a magnetosphere — an invisible bubble of magnetism generated by the powerful churning of molten metals at Earth’s core. It prevents our atmosphere from being stripped away by solar winds blasting it from the sun. While the magnetosphere has been a constant presence for billions of years, its strength waxes and wanes over time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb1d7415-61f5-4df9-9c20-bef27bbee86c",
                        "source_entry_id": "e7ada7ed-0738-31f9-812e-9a44455d52a9",
                        "source_sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                        "source_sense_description": "Astronomie: das Raumgebiet um einen Planeten oder Stern, in dem das Magnetfeld des Objektes dominiert",
                        "target_lang_word": "magnétosphère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnétosphère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efacdea7-c3ec-30ed-bf61-cba604f41a5d",
                                        "entry_id": "42f9839a-062d-3996-94da-243990e33003",
                                        "glosses": [
                                            "Région entourant un objet céleste dans laquelle les phénomènes physiques sont dominés ou organisés par son champ magnétique."
                                        ],
                                        "tags": [
                                            "Géophysique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1018a312-29ad-446a-a690-54e9f2576863",
                                                "sense_id": "efacdea7-c3ec-30ed-bf61-cba604f41a5d",
                                                "text": "Jupiter est entourée par une énorme magnétosphère qui dévie les particules chargées du vent solaire. Le flux de particules solaires déforme la bulle magnétique, créant une magnétoqueue qui s'étend jusqu'à l'orbite de Saturne. Le plasma piégé est concentré dans une nappe de plasma en forme de disque aligné sur l'équateur de la planète."
                                            },
                                            {
                                                "example_id": "ae50c450-9a36-4bc7-88d5-dcac10bb0855",
                                                "sense_id": "efacdea7-c3ec-30ed-bf61-cba604f41a5d",
                                                "text": "Elle collabore avec l’agence américaine en tant qu’experte de la magnétosphère de la « géante de glace »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
