                ],
                "senses": [
                    {
                        "sense_id": "f71bc249-d37a-3fdb-bebe-49ffbd8ded4d",
                        "entry_id": "34c9ec6b-4f5a-33ce-b240-8ae35bed7417",
                        "glosses": [
                            "Relatif aux Hokkiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96fc8fc6-abc9-4b0c-b5ff-4d5635575946",
                                "sense_id": "f71bc249-d37a-3fdb-bebe-49ffbd8ded4d",
                                "text": "Sur ces mille cinquante-quatre associations, 49 % sont d’origine hokkienne (du Fujian) – alors que la population actuelle de Hokkiens à Penang est estimée à 65 % de la population totale –, et 50 % ont leurs origines dans le Guangdong (Cantonais, Teochew, Hakka)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f79f500f-3f01-3665-a2a4-628daf923ae8",
                        "entry_id": "34c9ec6b-4f5a-33ce-b240-8ae35bed7417",
                        "glosses": [
                            "Relatif au hokkien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44bdab94-c1ac-4f99-acba-8e0edcdb46e7",
                                "sense_id": "f79f500f-3f01-3665-a2a4-628daf923ae8",
                                "text": "À partir du XVIIᵉ siècle, des Chinois de dialecte hokkien ont colonisé Taiwan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f83125a7-a021-4990-86c6-6ffabe11f6d0",
                        "source_entry_id": "34c9ec6b-4f5a-33ce-b240-8ae35bed7417",
                        "target_lang_word": "Hokkien",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hokkien",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd049a3d-b800-3156-b9e3-2ce383380d50",
                                        "entry_id": "e3acdf7f-39f7-342d-b361-e9c61a543fe5",
                                        "glosses": [
                                            "A linguistic subgroup of the Southern Min (Min Nan) branch, of the Min branch, of the Sinitic (Chinese) branch, of the Sino-Tibetan language family which is mainly spoken in the south-eastern part of mainland China (Fujian province), Taiwan, and people of Hoklo descent elsewhere in the world, like in Malaysia, Singapore, Philippines, Indonesia, Southern Thailand, Myanmar, Cambodia, Southern Vietnam, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd28d0b-2114-4631-b3ba-48148f467d51",
                                                "sense_id": "cd049a3d-b800-3156-b9e3-2ce383380d50",
                                                "text": "Almost 90 percent of Taiwan's 6 million occupants at the end of World War II spoke Hokkien."
                                            },
                                            {
                                                "example_id": "fb921bb8-4e25-4569-a604-a30ae4225643",
                                                "sense_id": "cd049a3d-b800-3156-b9e3-2ce383380d50",
                                                "text": "Because Hokkien is the most widely spoken local language (after Mandarin) in both Taiwan and Kinmen, this national language policy – when implemented in Kinmen – resulted in a different perceived language policy."
                                            },
                                            {
                                                "example_id": "ef4c4e4f-74e3-441c-b876-8ee4933bf9a5",
                                                "sense_id": "cd049a3d-b800-3156-b9e3-2ce383380d50",
                                                "text": "Under colonial rule, learning or speaking my grandma’s native Hokkien, along with dozens of indigenous languages, was illegal by law."
                                            },
                                            {
                                                "example_id": "c537f053-e633-49b4-9c20-0cbf4121f4b5",
                                                "sense_id": "cd049a3d-b800-3156-b9e3-2ce383380d50",
                                                "text": "The awards celebrate not only Mandopop but also artists singing in Taiwanese - also known as Hokkien - Hakka and indigenous languages, a visible sign of the government's efforts to promote tongues other than Mandarin."
                                            },
                                            {
                                                "example_id": "dc63b97a-fd15-41b3-8b4b-5600b6bdc2ae",
                                                "sense_id": "cd049a3d-b800-3156-b9e3-2ce383380d50",
                                                "text": "For quotations using this term, see Citations:Hokkien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49594ebc-d474-33be-9cdb-d2093e387694",
                                        "entry_id": "e3acdf7f-39f7-342d-b361-e9c61a543fe5",
                                        "glosses": [
                                            "A linguistic subgroup of the Southern Min (Min Nan) branch, of the Min branch, of the Sinitic (Chinese) branch, of the Sino-Tibetan language family which is mainly spoken in the south-eastern part of mainland China (Fujian province), Taiwan, and people of Hoklo descent elsewhere in the world, like in Malaysia, Singapore, Philippines, Indonesia, Southern Thailand, Myanmar, Cambodia, Southern Vietnam, etc.",
                                            "the varieties of Hokkien spoken in mainland China, usually as opposed to Taiwanese Taigi spoken in Taiwan"
                                        ],
                                        "tags": [
                                            "Taiwan"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eca1a0cf-3eaf-3ef0-860f-56708e9451bb",
                                        "entry_id": "e3acdf7f-39f7-342d-b361-e9c61a543fe5",
                                        "glosses": [
                                            "A group of Han Chinese people whose traditional ancestral homes are in southern Fujian, South China, especially those that ancestrally spoke the Hokkien language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e4e8bf3-26d0-3001-9341-4b0b4b2c1775",
                                        "entry_id": "e3acdf7f-39f7-342d-b361-e9c61a543fe5",
                                        "glosses": [
                                            "Any person from Fujian."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
