                                    },
                                    {
                                        "sense_id": "8a81d5cd-e9c9-3a65-8f1b-67762464792b",
                                        "entry_id": "4b200412-e3cb-30eb-85e1-4d323e469f0c",
                                        "glosses": [
                                            "To explicitly establish the existence of (a variable, function, etc.) without necessarily describing its content."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92042df-3f18-4864-9972-a559fd531321",
                                                "sense_id": "8a81d5cd-e9c9-3a65-8f1b-67762464792b",
                                                "text": "The counter \"i\" was declared as an integer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96153775-26cf-371c-9c8d-c1ddb7f31479",
                                        "entry_id": "4b200412-e3cb-30eb-85e1-4d323e469f0c",
                                        "glosses": [
                                            "to declare war"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8234b731-a4f1-44f1-8ef2-59ef33c8cdc0",
                                                "sense_id": "96153775-26cf-371c-9c8d-c1ddb7f31479",
                                                "text": "France declared on me, I'm finished!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad6a6658-8a9b-3b05-89df-90c9a2c6ec49",
                                        "entry_id": "4b200412-e3cb-30eb-85e1-4d323e469f0c",
                                        "glosses": [
                                            "To state that a thing shall happen or affirm a condition in the hopes of seeing it happen spiritually, in contrast to prayer which takes the form of a request."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3992db-a859-4575-8928-85d816cff794",
                                                "sense_id": "ad6a6658-8a9b-3b05-89df-90c9a2c6ec49",
                                                "text": "He prayed to God \"please heal my sister\", while she declared \"I am healed in Jesus' name\"."
                                            }
