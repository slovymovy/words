                "senses": [
                    {
                        "sense_id": "5fe86447-a032-3073-a959-0a7af08c2e59",
                        "entry_id": "796ecf44-deb2-3ac9-adb4-8c05c2675696",
                        "glosses": [
                            "in hoge mate vervelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd30e636-f6aa-4582-bd1e-86cad9e78f9b",
                                "sense_id": "5fe86447-a032-3073-a959-0a7af08c2e59",
                                "text": "Dit is de irritantste persoon die ik ooit gezien heb."
                            },
                            {
                                "example_id": "e4335d34-b2a4-4366-808c-3c1184076cd8",
                                "sense_id": "5fe86447-a032-3073-a959-0a7af08c2e59",
                                "text": "Emiel is bijzonder irritant."
                            },
                            {
                                "example_id": "0676bc19-925f-4d4b-8b0a-bc13dc13fcd4",
                                "sense_id": "5fe86447-a032-3073-a959-0a7af08c2e59",
                                "text": "De meeste vakantiegangers nemen de Autoroute du Soleil, een ongezellige snelweg met irritante tolpoorten en karakterloze wegrestaurants."
                            },
                            {
                                "example_id": "3bf7b63c-847d-4107-ab0b-91978434159f",
                                "sense_id": "5fe86447-a032-3073-a959-0a7af08c2e59",
                                "text": "Hij was in bepaalde opzichten een jongere versie van mezelf. Zijn grote mond, iets te harde stem, irritante enthousiasme en overdreven positiviteit waren herkenbaar maar ook zijn ongepolijste bravoure, idealisme en romantische dromen om de wereld te verbeteren."
                            }
                        ]
                    }
                ],
