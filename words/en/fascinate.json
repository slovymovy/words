{
    "word_family": [
        "fascination",
        "fascinator",
        "fascinating",
        "fascinated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6777223-d8c0-3568-a1ce-345124f40af3",
                    "sense_definition": "To evoke an intense interest or attraction in someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flickering TV screen <w>fascinated</w> the cat for hours.",
                            "target_lang_translations": {
                                "ru": "Мерцающий экран телевизора часами <w>завораживал</w> кошку."
                            }
                        },
                        {
                            "text": "Ancient history has always managed to <w>fascinate</w> young students.",
                            "target_lang_translations": {
                                "ru": "Древняя история всегда умела <w>увлекать</w> молодых студентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivate",
                        "intrigue",
                        "interest"
                    ],
                    "antonyms": [
                        "bore",
                        "repel"
                    ],
                    "common_phrases": [
                        "fascinate the audience",
                        "never cease to fascinate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать сильный интерес, привлекать или увлекать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увлекать",
                                "target_lang_sense_clarification": "вызывать сильный интерес"
                            },
                            {
                                "target_lang_word": "завораживать",
                                "target_lang_sense_clarification": "всецело завладевать вниманием"
                            },
                            {
                                "target_lang_word": "интересовать",
                                "target_lang_sense_clarification": "вызывать любопытство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b10a8434-ff78-36e8-9e03-f02957c07dd7",
                    "sense_definition": "To be irresistibly charming or attractive to.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her elegant gait <w>fascinates</w> all men who see her walk.",
                            "target_lang_translations": {
                                "ru": "Ее элегантная походка <w>очаровывает</w> всех мужчин, которые видят, как она идет."
                            }
                        },
                        {
                            "text": "The mysterious beauty of the painting continues to <w>fascinate</w> art collectors.",
                            "target_lang_translations": {
                                "ru": "Таинственная красота картины продолжает <w>пленять</w> коллекционеров искусства."
                            }
                        }
                    ],
                    "synonyms": [
                        "charm",
                        "enchant",
                        "allure"
                    ],
                    "common_phrases": [
                        "fascinate with beauty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть непреодолимо очаровательным или привлекательным для кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровывать",
                                "target_lang_sense_clarification": "подчинять своему обаянию"
                            },
                            {
                                "target_lang_word": "пленять",
                                "target_lang_sense_clarification": "покорять, восхищать"
                            },
                            {
                                "target_lang_word": "притягивать",
                                "target_lang_sense_clarification": "сильно привлекать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d4dcf9f-7d1c-3cee-bc04-61d505b0f6fa",
                    "sense_definition": "To make someone hold motionless; to spellbind.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spellbind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were <w>fascinated</w> by the potter's skill, unable to look away from the spinning clay.",
                            "target_lang_translations": {
                                "ru": "Мы были <w>заворожены</w> мастерством гончара, не в силах отвести взгляд от вращающейся глины."
                            }
                        },
                        {
                            "text": "The snake seemed to <w>fascinate</w> its prey before striking.",
                            "target_lang_translations": {
                                "ru": "Казалось, змея <w>гипнотизирует</w> свою жертву перед броском."
                            }
                        }
                    ],
                    "synonyms": [
                        "spellbind",
                        "mesmerize",
                        "hypnotize"
                    ],
                    "common_phrases": [
                        "fascinated by the skill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо замереть на месте; завораживать, гипнотизировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завораживать",
                                "target_lang_sense_clarification": "лишать возможности отвести взгляд"
                            },
                            {
                                "target_lang_word": "приковывать",
                                "target_lang_sense_clarification": "удерживать внимание неподвижно"
                            },
                            {
                                "target_lang_word": "гипнотизировать",
                                "target_lang_sense_clarification": "вводить в оцепенение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}