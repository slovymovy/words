                        "entry_id": "922e2a5c-4c15-353c-b542-8d5a310291dc",
                        "glosses": [
                            "iemand die tot een hogere klasse in de maatschappij, doch niet tot de daarbij behorende beschaving gekomen is"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "55ca74b9-12f6-4425-bf55-09cb7d9a12f1",
                                "sense_id": "d2e2d941-a2ac-35f2-985f-1b7a1bbc69c7",
                                "text": "Wat een platvloerse parvenu is hij toch!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5235c7a2-707e-44ae-b454-843040af9153",
                        "source_entry_id": "922e2a5c-4c15-353c-b542-8d5a310291dc",
                        "source_sense_id": "d2e2d941-a2ac-35f2-985f-1b7a1bbc69c7",
                        "target_lang_word": "Parvenü",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parvenü",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6efe53e3-7414-358a-b739-c20f08f9f755",
                                        "entry_id": "b8976a50-4af0-3197-b9aa-2c98decda3ab",
                                        "glosses": [
                                            "für einen Emporkömmling, Neureichen, der schnell aufgestiegen ist und mit seinem Reichtum protzt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dc1775c-47dd-4d6b-8319-6703d0856b89",
                                                "sense_id": "6efe53e3-7414-358a-b739-c20f08f9f755",
                                                "text": "Der Schulze, der Parvenü, hat Millionen geerbt und glaubt, er gehöre deshalb plötzlich zur besseren Gesellschaft."
                                            },
                                            {
                                                "example_id": "a172ade8-3305-418e-824c-8c1a544f1ea8",
                                                "sense_id": "6efe53e3-7414-358a-b739-c20f08f9f755",
                                                "text": "„Es ist die Maxime des Parvenü, der sich einbildet, sein Geld verleihe ihm gegenüber seinem Mitmenschen eine höhere Stellung.“"
                                            },
                                            {
                                                "example_id": "317b04b9-ecbe-4715-9633-ee9637d817d5",
                                                "sense_id": "6efe53e3-7414-358a-b739-c20f08f9f755",
                                                "text": "„Selbst das Borchardt, die Schickimicki-Kantine im neuen Berlin, sieht neben dieser Institution wie ein Schuppen für Parvenüs aus.“"
                                            },
                                            {
                                                "example_id": "1afb465d-a34e-4546-8c76-c13d3006e24d",
                                                "sense_id": "6efe53e3-7414-358a-b739-c20f08f9f755",
                                                "text": "„Das Fundament war die wirklich vornehme, wirklich aufgeschlossene, wirklich kultivierte Berliner Gesellschaft, die gediegenen Kreise aus dem Westen, der Tiergartenstraße oder dem Grunewald, die den lauten Parvenüs und Neureichen an Zahl, Rang und Gewicht immer noch überlegen waren – ebenso das Volk, die jungen Menschen aller Stände, und die – für ein paar Jahre – durch die erstarkende Großindustrie gesicherte Arbeiterschaft.“"
                                            },
                                            {
                                                "example_id": "dee4e622-9d7c-47e3-aef5-56542a259be9",
                                                "sense_id": "6efe53e3-7414-358a-b739-c20f08f9f755",
                                                "text": "„Die feinen Damen aus der Plutokratie und die schicken Parvenüs waren überaus gespannt, ob Frau L. heute Frau K. grüßen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67bd0544-7168-4a2f-b9d8-5df42ee2d0d4",
