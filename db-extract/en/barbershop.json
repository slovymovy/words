                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db2cfa3-08f2-4b94-bdb1-c3a86cfd824d",
                                                "sense_id": "9881ee59-0076-32ee-8d80-d1d91f1f9978",
                                                "text": "Петь в стиле барбершоп довольно трудно: требуется острый слух и послушный голос."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d33c28-93ed-3ac9-b415-8ac3d17218fa",
