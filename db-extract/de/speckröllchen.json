                            {
                                "example_id": "a865e91c-214a-42f0-8b1a-e28670f4902e",
                                "sense_id": "309ec3bd-0b87-3c5f-b1d7-840ac504c5f2",
                                "text": "„Ihre Taille wurde jedoch nicht im Geringsten schmaler. Sunguk behauptete zwar, dass er ihr Bäuchlein und die Speckröllchen mochte, aber das nahm sie ihm nicht ab.“"
                            },
                            {
                                "example_id": "fce6f991-bfd2-4aaf-a5ed-d53749615467",
                                "sense_id": "309ec3bd-0b87-3c5f-b1d7-840ac504c5f2",
                                "text": "„Doch die Speckröllchen fuchsten ihn, und zwar sehr.“"
                            }
