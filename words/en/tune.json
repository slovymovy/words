{
    "word_family": [
        "tuner",
        "tuneful",
        "tuneless",
        "tuning",
        "attune"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d0b828b-91b0-3678-b064-c37e5ca020f4",
                    "sense_definition": "A series of musical notes that produce a pleasing sound; a melody or a song.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "noun_music_melody",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She hummed a happy <w>tune</w> while she worked in the garden.",
                            "target_lang_translations": {
                                "ru": "Она напевала веселый <w>мотив</w>, работая в саду.",
                                "zh": "她在花园里干活时，嘴里哼着欢快的<w>曲调</w>。"
                            }
                        },
                        {
                            "text": "The band played a catchy <w>tune</w> that everyone started dancing to.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла запоминающуюся <w>мелодию</w>, под которую все начали танцевать.",
                                "zh": "乐队演奏了一首朗朗上口的<w>旋律</w>，大家都跳起舞来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность музыкальных нот, образующая приятное звучание; мелодия или песня.",
                        "zh": "一系列悦耳的音符；曲调或歌曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелодия",
                                "target_lang_sense_clarification": "музыкальная последовательность"
                            },
                            {
                                "target_lang_word": "мотив",
                                "target_lang_sense_clarification": "напев, мелодия"
                            },
                            {
                                "target_lang_word": "напев",
                                "target_lang_sense_clarification": "вокальная мелодия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曲调",
                                "target_lang_sense_clarification": "音乐的旋律"
                            },
                            {
                                "target_lang_word": "旋律",
                                "target_lang_sense_clarification": "乐曲的基调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86383aea-511e-3b4c-9929-bf0d9fb16064",
                    "sense_definition": "The state of having the correct musical pitch or frequency.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_music_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old piano is terribly out of <w>tune</w> and needs fixing.",
                            "target_lang_translations": {
                                "ru": "Старое пианино совершенно <w>расстроено</w> и требует ремонта.",
                                "zh": "这架旧钢琴<w>音准</w>差得离谱，需要修理。"
                            }
                        },
                        {
                            "text": "It is difficult for beginners to stay in <w>tune</w> while singing.",
                            "target_lang_translations": {
                                "ru": "Новичкам трудно попадать в <w>ноты</w> во время пения.",
                                "zh": "初学者唱歌时很难保持<w>音准</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in tune",
                        "out of tune"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние правильной музыкальной высоты тона или частоты.",
                        "zh": "乐器音高或频率准确的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строй",
                                "target_lang_sense_clarification": "музыкальный строй"
                            },
                            {
                                "target_lang_word": "настройка",
                                "target_lang_sense_clarification": "состояние инструмента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音准",
                                "target_lang_sense_clarification": "乐器或歌唱的音高准确度"
                            },
                            {
                                "target_lang_word": "调子",
                                "target_lang_sense_clarification": "乐器的定调状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8c007fa-ed18-32bb-b139-b4a43fafb4be",
                    "sense_definition": "The act of adjusting an engine or machine to make it work better.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your car engine needs a good <w>tune</w> before the long trip.",
                            "target_lang_translations": {
                                "ru": "Двигателю твоей машины нужна хорошая <w>настройка</w> перед долгой поездкой.",
                                "zh": "长途旅行前，你的汽车发动机需要好好<w>调校</w>一下。"
                            }
                        },
                        {
                            "text": "The mechanic gave the motor a quick <w>tune</w> to improve its performance.",
                            "target_lang_translations": {
                                "ru": "Механик быстро произвел <w>регулировку</w> мотора, чтобы улучшить его работу.",
                                "zh": "技工对马达进行了快速<w>调试</w>以提升其性能。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по регулировке двигателя или механизма для улучшения его работы.",
                        "zh": "为改善发动机或机器性能而进行的调节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настройка",
                                "target_lang_sense_clarification": "техническая"
                            },
                            {
                                "target_lang_word": "регулировка",
                                "target_lang_sense_clarification": "механизма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调试",
                                "target_lang_sense_clarification": "对机械设备的性能优化"
                            },
                            {
                                "target_lang_word": "调校",
                                "target_lang_sense_clarification": "对发动机等机械的精细调节"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c04aef3-5125-3cbf-955d-a226cf8ea67d",
                    "sense_definition": "To adjust a musical instrument so that it produces the correct notes or pitch.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needs to <w>tune</w> his guitar before the concert begins.",
                            "target_lang_translations": {
                                "ru": "Ему нужно <w>настроить</w> гитару перед началом концерта.",
                                "zh": "音乐会开始前，他需要给吉他<w>调音</w>。"
                            }
                        },
                        {
                            "text": "The orchestra began to <w>tune</w> their instruments as the audience arrived.",
                            "target_lang_translations": {
                                "ru": "Оркестр начал <w>настраивать</w> свои инструменты, когда зрители стали прибывать.",
                                "zh": "观众入场时，管弦乐队开始<w>调音</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tune up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настраивать музыкальный инструмент для получения верных нот или высоты звука.",
                        "zh": "调节乐器以产生正确的音符或音高。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调音",
                                "target_lang_sense_clarification": "调整乐器音高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67e971dc-a696-3041-a3ea-0ec6f1241022",
                    "sense_definition": "To adjust a radio or television to receive a specific broadcast signal or channel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>tune</w> the radio to the local news station.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>настрой</w> радио на местную новостную станцию.",
                                "zh": "请把收音机<w>调台</w>到本地新闻频道。"
                            }
                        },
                        {
                            "text": "We <w>tuned</w> in to watch the live broadcast of the game.",
                            "target_lang_translations": {
                                "ru": "Мы <w>настроились</w> на просмотр прямой трансляции игры.",
                                "zh": "我们<w>调好</w>频道观看了比赛直播。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tune in"
                    ],
                    "common_phrases": [
                        "tune out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настраивать радио или телевизор на определенный сигнал или канал.",
                        "zh": "调节收音机或电视机以接收特定的广播信号或频道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "прибор, радио"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调台",
                                "target_lang_sense_clarification": "切换广播或电视频道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c86b97-4ffd-3135-a3f9-4ea040ae8802",
                    "sense_definition": "To adjust an engine or machine so that it functions smoothly and efficiently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic will <w>tune</w> the engine to get more power out of it.",
                            "target_lang_translations": {
                                "ru": "Механик <w>отрегулирует</w> двигатель, чтобы выжать из него больше мощности.",
                                "zh": "技工将<w>调节</w>发动机以获得更大的动力。"
                            }
                        },
                        {
                            "text": "If you <w>tune</w> the system correctly, it will run much faster.",
                            "target_lang_translations": {
                                "ru": "Если вы правильно <w>настроите</w> систему, она будет работать намного быстрее.",
                                "zh": "如果你正确地<w>优化</w>系统，它的运行速度会快得多。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулировать двигатель или механизм для обеспечения плавной и эффективной работы.",
                        "zh": "调节发动机或机器以使其运行平稳高效。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулировать",
                                "target_lang_sense_clarification": "механизм"
                            },
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "оптимизировать работу"
                            },
                            {
                                "target_lang_word": "отлаживать",
                                "target_lang_sense_clarification": "систему"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调节",
                                "target_lang_sense_clarification": "使机器运行正常"
                            },
                            {
                                "target_lang_word": "优化",
                                "target_lang_sense_clarification": "提升系统性能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fcb35d8-77c5-3eab-ad3b-a19061222601",
                    "sense_definition": "To adapt or adjust one's attitude or senses to a particular environment or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My ears were <w>tuned</w> to the sounds of the forest at night.",
                            "target_lang_translations": {
                                "ru": "Мой слух был <w>настроен</w> на звуки ночного леса.",
                                "zh": "我的耳朵已经<w>调整</w>到能捕捉夜晚森林里的声音了。"
                            }
                        },
                        {
                            "text": "The company is <w>tuned</w> to the changing needs of its customers.",
                            "target_lang_translations": {
                                "ru": "Компания <w>ориентирована</w> на меняющиеся потребности своих клиентов.",
                                "zh": "公司时刻<w>调整</w>自身以适应客户不断变化的需求。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приспосабливать или настраивать свое отношение или чувства к определенной среде.",
                        "zh": "使个人的态度或感官适应特定的环境或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "внимание, слух"
                            },
                            {
                                "target_lang_word": "приспосабливать",
                                "target_lang_sense_clarification": "адаптировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调整",
                                "target_lang_sense_clarification": "改变状态以适应环境"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "2472a159-b87a-3cb3-a702-2e6be3659a52",
                    "sense_definition": "Used to express approval or appreciation of a song, often enthusiastically.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "interjection_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the DJ played that track, everyone shouted \"<w>Tune</w>!\"",
                            "target_lang_translations": {
                                "ru": "Когда диджей поставил этот трек, все закричали: \"<w>Хит</w>!\"",
                                "zh": "当DJ播放那首歌时，大家都大喊：“<w>神曲</w>！”"
                            }
                        },
                        {
                            "text": "I love this new song on the radio, absolute <w>tune</w>!",
                            "target_lang_translations": {
                                "ru": "Обожаю эту новую песню по радио, полный <w>улет</w>!",
                                "zh": "我超爱电台里这首新歌，简直是<w>神曲</w>！"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения одобрения песни, часто с энтузиазмом.",
                        "zh": "用于表达对某首歌曲的赞赏，通常带有热情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хит",
                                "target_lang_sense_clarification": "отличная песня"
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "сленг: крутая вещь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神曲",
                                "target_lang_sense_clarification": "极受欢迎的歌曲"
                            },
                            {
                                "target_lang_word": "好歌",
                                "target_lang_sense_clarification": "赞美歌曲好听"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6d2320f3-2133-3330-9ec0-f3834916448a",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Tune</w> signed the documents yesterday.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Тюн</w> подписал документы вчера.",
                                "zh": "<w>图恩</w>先生昨天签署了文件。"
                            }
                        },
                        {
                            "text": "We met a family named <w>Tune</w> during our vacation.",
                            "target_lang_translations": {
                                "ru": "Мы встретили семью по фамилии <w>Тюн</w> во время нашего отпуска.",
                                "zh": "度假期间，我们遇到了一户姓<w>图恩</w>的人家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тюн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图恩",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}