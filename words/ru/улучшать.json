{
    "word_family": [
        "лучший",
        "лучше",
        "улучшение",
        "улучшенный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ec858db-28be-3a8f-996a-d50ed38c6309",
                    "sense_definition": "Делать что-либо лучше по качеству или состоянию.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Правильное питание помогает <w>улучшать</w> здоровье человека.",
                            "target_lang_translations": {
                                "pl": "Prawidłowe odżywianie pomaga <w>polepszać</w> zdrowie człowieka."
                            }
                        },
                        {
                            "text": "Мы стараемся <w>улучшать</w> условия работы в нашем офисе.",
                            "target_lang_translations": {
                                "pl": "Staramy się <w>ulepszać</w> warunki pracy w naszym biurze."
                            }
                        }
                    ],
                    "synonyms": [
                        "совершенствовать",
                        "оптимизировать"
                    ],
                    "antonyms": [
                        "ухудшать"
                    ],
                    "common_phrases": [
                        "улучшать качество",
                        "улучшать жизнь"
                    ],
                    "target_lang_definitions": {
                        "pl": "Sprawianie, że coś staje się lepsze pod względem jakości lub stanu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ulepszać",
                                "target_lang_sense_clarification": "czynić coś lepszym, udoskonalać"
                            },
                            {
                                "target_lang_word": "polepszać",
                                "target_lang_sense_clarification": "zmieniać stan czegoś na lepszy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ef0996f-27b9-3951-b72a-393b74719ec4",
                    "sense_definition": "Повышать результаты или показатели в работе, спорте или деятельности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спортсмен продолжает <w>улучшать</w> свои результаты на каждой тренировке.",
                            "target_lang_translations": {
                                "pl": "Sportowiec kontynuuje <w>poprawianie</w> swoich wyników na każdym treningu."
                            }
                        },
                        {
                            "text": "Компания планирует <w>улучшать</w> показатели продаж в следующем квартале.",
                            "target_lang_translations": {
                                "pl": "Firma planuje <w>polepszać</w> wskaźniki sprzedaży w następnym kwartale."
                            }
                        }
                    ],
                    "synonyms": [
                        "повышать",
                        "увеличивать"
                    ],
                    "antonyms": [
                        "понижать",
                        "ухудшать"
                    ],
                    "common_phrases": [
                        "улучшать показатели",
                        "улучшать результат"
                    ],
                    "target_lang_definitions": {
                        "pl": "Podnoszenie wyników lub wskaźników w pracy, sporcie lub innej działalności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poprawiać",
                                "target_lang_sense_clarification": "zwiększać efektywność lub wyniki"
                            },
                            {
                                "target_lang_word": "polepszać",
                                "target_lang_sense_clarification": "podnosić poziom wskaźników"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1578aff4-a7d2-31a7-ae75-b950f51eabe9",
                    "sense_definition": "Находить подходящий момент для осуществления чего-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный охотник умеет <w>улучшать</w> момент для точного выстрела.",
                            "target_lang_translations": {
                                "pl": "Doświadczony myśliwy potrafi <w>wybierać</w> moment na celny strzał."
                            }
                        },
                        {
                            "text": "Важно <w>улучшать</w> время для начала серьезного разговора.",
                            "target_lang_translations": {
                                "pl": "Ważne jest, aby <w>podgadywać</w> czas na rozpoczęcie poważnej rozmowy."
                            }
                        }
                    ],
                    "synonyms": [
                        "выбирать",
                        "подгадывать"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее значение, близкое к слову улучать."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wybieranie odpowiedniego momentu na zrobienie czegoś (znaczenie przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wybierać",
                                "target_lang_sense_clarification": "wskazywać odpowiedni czas"
                            },
                            {
                                "target_lang_word": "podgadywać",
                                "target_lang_sense_clarification": "trafiać w odpowiedni moment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}