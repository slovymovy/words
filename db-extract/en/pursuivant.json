                    {
                        "sense_id": "57db7a25-f400-35d1-8b19-2e80e317a5c4",
                        "entry_id": "4325fad7-a909-3290-a681-a4644cf17cf0",
                        "glosses": [
                            "A functionary of lower rank than a herald, but discharging similar duties; an attendant of the heralds, e.g. in the College of Arms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3818152d-5165-4a70-92a2-032fc93dbe18",
                                "sense_id": "57db7a25-f400-35d1-8b19-2e80e317a5c4",
                                "text": "How oft do they [the blessed Angels] with golden pineons, cleaue / The flitting skyes, like flying Purſuiuant, / Againſt fowle feendes to ayd vs millitant: […]"
                            },
                            {
                                "example_id": "12a66c11-ec44-4ad9-8280-0094f94cf8b9",
                                "sense_id": "57db7a25-f400-35d1-8b19-2e80e317a5c4",
                                "text": "The herald Hope, forerunning Fear, / And Fear, the pursuivant of Hope."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1dd4a99-38bc-357d-abc5-7fbfaa8d3053",
                        "entry_id": "4325fad7-a909-3290-a681-a4644cf17cf0",
                        "glosses": [
                            "A Grand Lodge Officer who guards the inner door during a meeting of the Grand Lodge."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8b1d2288-2dbd-3642-be07-c20024ad6b35",
                        "entry_id": "4325fad7-a909-3290-a681-a4644cf17cf0",
                        "glosses": [
                            "A royal messenger, (particularly) one with the authority to execute warrants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b8bcb7-cf68-4672-ab33-ca7526dc40c2",
                                "sense_id": "8b1d2288-2dbd-3642-be07-c20024ad6b35",
                                "text": "The law was altogether without force in the highlands which lie on the south of the vale of Tralee. No officer of justice willingly ventured into those parts. One pursuivant who in 1680 attempted to execute a warrant there was murdered."
                            }
                        ]
                    },
                    {
                        "sense_id": "255e6b1a-2258-3755-9f33-abbc7beebdae",
                        "entry_id": "4325fad7-a909-3290-a681-a4644cf17cf0",
                        "glosses": [
