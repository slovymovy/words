                "senses": [
                    {
                        "sense_id": "2805bbe1-5edf-3672-8ded-4bc9c546540d",
                        "entry_id": "68ffb1e4-786e-3c3e-af47-6d59e81465ea",
                        "glosses": [
                            "Science de l’étude du comportement criminel et son impact sur les lois et le comportement humain ; également considérée comme la science des causes du crime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19e3afba-330f-49e0-8fc3-610f9b7e5511",
                                "sense_id": "2805bbe1-5edf-3672-8ded-4bc9c546540d",
                                "text": "Une lecture cohérente, documentée, réflexive de près de deux siècles d’apports scientifiques en matière de criminologie offerte par des historiens, psychologues, sociologues et psychiatres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b111b7c-00d7-41be-a8a2-5da9355e20e9",
                        "source_entry_id": "68ffb1e4-786e-3c3e-af47-6d59e81465ea",
                        "source_sense_id": "2805bbe1-5edf-3672-8ded-4bc9c546540d",
                        "target_lang_word": "Kriminologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriminologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a56d0be0-c13b-3dd4-85d7-4d5bf65e80e1",
                                        "entry_id": "123f0bb8-5a00-3a18-8386-3484762bec09",
                                        "glosses": [
                                            "Wissenschaft, die sich mit Ursachen und Erscheinungsformen von Verbrechen und die Verhütung solcher auseinandersetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d1070da-c45c-4e3b-81b4-142c24e4e005",
                                                "sense_id": "a56d0be0-c13b-3dd4-85d7-4d5bf65e80e1",
                                                "text": "„Die Kriminologie schaut vor allem auf die Verbrechen armer Menschen. Dabei schaden Reiche mit ihren Taten der Gesellschaft viel mehr.“"
                                            },
                                            {
                                                "example_id": "5798bc7d-be36-4e46-b5a4-eccb5122b5be",
                                                "sense_id": "a56d0be0-c13b-3dd4-85d7-4d5bf65e80e1",
                                                "text": "„Das interdisziplinär arbeitende Institut hat in seiner vierzigjährigen Geschichte grundlegende Forschungsergebnisse im Bereich der Kriminologie hervorgebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fce06df-ee44-42b5-9c5b-7cadd2bb9a3b",
                        "source_entry_id": "68ffb1e4-786e-3c3e-af47-6d59e81465ea",
