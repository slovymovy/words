    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f79dc4c-f96d-3ef5-81ee-3392ddbb409d",
                    "sense_definition": "uczucie głębokiego smutku, cierpienia psychicznego lub żalu wywołane nieszczęściem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cierpienie_psychiczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po stracie wieloletniego przyjaciela pogrążył się w niewypowiedzianej <w>boleści</w>.",
                            "target_lang_translations": {
                                "ru": "После потери давнего друга он погрузился в невыразимую <w>скорбь</w>."
                            }
                        },
                        {
                            "text": "Nie będę ci opowiadał o mojej <w>boleści</w>, bo i tak niczego to nie zmieni.",
                            "target_lang_translations": {
                                "ru": "Я не буду рассказывать тебе о своей <w>печали</w>, потому что это всё равно ничего не изменит."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozpacz",
                        "żal",
                        "żałość"
                    ],
                    "common_phrases": [
                        "wielka boleść",
                        "pogrążyć się w boleści"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "często w języku książkowym lub podniosłym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "глубокая душевная боль, скорбь, страдание или горечь, вызванные несчастьем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорбь",
                                "target_lang_sense_clarification": "глубокое горе, печаль"
                            },
                            {
                                "target_lang_word": "горесть",
                                "target_lang_sense_clarification": "душевная боль, печаль (книжн.)"
                            },
                            {
                                "target_lang_word": "печаль",
                                "target_lang_sense_clarification": "грусть, тоска"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f302ced-db3b-3601-9e9b-2e038ef3e960",
                    "sense_definition": "silny, nieprzyjemny ból fizyczny, zwłaszcza dolegliwości ze strony brzucha lub ból porodowy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cierpienie_fizyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciężarna kobieta zaczęła już odczuwać pierwsze <w>boleści</w> i natychmiast pojechała do szpitala.",
                            "target_lang_translations": {
                                "ru": "Беременная женщина уже начала ощущать первые <w>схватки</w> и немедленно поехала в больницу."
                            }
                        },
                        {
                            "text": "Z powodu nagłej <w>boleści</w> w podbrzuszu musiał położyć się do łóżka.",
                            "target_lang_translations": {
                                "ru": "Из-за внезапной <w>боли</w> внизу живота ему пришлось лечь в постель."
                            }
                        }
                    ],
                    "synonyms": [
                        "ból"
                    ],
                    "common_phrases": [
                        "boleści brzuszne",
                        "odczuwać boleści"
                    ],
                    "target_lang_definitions": {
                        "ru": "сильная физическая боль, особенно схватки при родах или рези в животе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боль",
                                "target_lang_sense_clarification": "физическое страдание"
                            },
                            {
                                "target_lang_word": "схватки",
                                "target_lang_sense_clarification": "родовые боли"
                            },
                            {
                                "target_lang_word": "рези",
                                "target_lang_sense_clarification": "острая боль в животе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbc95eaa-51e9-38f7-b376-fac0a6940ef9",
                    "sense_definition": "dawne określenie choroby lub dolegliwości zdrowotnej",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cierpienie_fizyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary zielarz próbował uleczyć tę tajemniczą <w>boleść</w> naparem ze świeżych ziół.",
                            "target_lang_translations": {
                                "ru": "Старый травник пытался вылечить этот таинственный <w>недуг</w> настоем из свежих трав."
                            }
                        },
                        {
                            "text": "W dawnych kronikach opisano zarazę jako nieuleczalną <w>boleść</w> dotykającą całe wsie.",
                            "target_lang_translations": {
                                "ru": "В старинных хрониках чума описывалась как неизлечимая <w>болезнь</w>, поражавшая целые деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "choroba"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревшее обозначение болезни или недуга"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болезнь",
                                "target_lang_sense_clarification": "заболевание (устар.)"
                            },
                            {
                                "target_lang_word": "недуг",
                                "target_lang_sense_clarification": "хворь, нездоровье"
                            },
                            {
                                "target_lang_word": "хворь",
                                "target_lang_sense_clarification": "недомогание (разг., устар.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}