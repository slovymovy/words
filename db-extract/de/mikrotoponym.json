                "senses": [
                    {
                        "sense_id": "0538e988-83f4-3ee0-a840-ecc54337a6c5",
                        "entry_id": "3410b0a4-3131-3918-bb5c-9eddee79af42",
                        "glosses": [
                            "Name eines kleinen geografischen Objekts (zum Beispiel Flurstück, Hof, Verkehrsweg)"
                        ],
                        "tags": [
                            "Onomastik"
                        ],
                        "examples": [
                            {
                                "example_id": "b13dc996-a661-4311-9666-60cd04e1af7e",
                                "sense_id": "0538e988-83f4-3ee0-a840-ecc54337a6c5",
                                "text": "„Im Laufe der Zeit konnte ein Ortsname, sogar ein zweiteiliger, auch ein zweiteiliges Mikrotoponym zur Bezeichnung für ein neues Objekt werden.“"
                            },
                            {
                                "example_id": "87b45500-12d9-4de1-8de9-c42af1e51d71",
                                "sense_id": "0538e988-83f4-3ee0-a840-ecc54337a6c5",
                                "text": "„Eine große Unterklasse der Mikrotoponyme, die terminologisch allerdings oft mit den Mikrotoponymen gleichgesetzt wird, sind die Flurnamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
