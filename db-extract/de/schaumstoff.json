                    }
                ],
                "senses": [
                    {
                        "sense_id": "16722e41-c1eb-3a4c-b397-0634597694b3",
                        "entry_id": "24f0b5c5-efd8-3481-ab65-095e3399ebc1",
                        "glosses": [
                            "Kunststoff, dessen Struktur durch viele Zellen (von Grundmaterial eingeschlossene Hohlräume, Poren) gebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e76e3ba-2d73-41ea-9389-9381c58a0baa",
                                "sense_id": "16722e41-c1eb-3a4c-b397-0634597694b3",
                                "text": "Ich lege etwas Schaumstoff in das Paket, damit das Gerät beim Transport nicht kaputt geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d259ba3-770c-4956-8f5f-ded5b52177f7",
                        "source_entry_id": "24f0b5c5-efd8-3481-ab65-095e3399ebc1",
                        "source_sense_id": "16722e41-c1eb-3a4c-b397-0634597694b3",
                        "target_lang_word": "foam plastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "11db8707-767f-4ef1-8464-ec925c4c63a1",
                        "source_entry_id": "24f0b5c5-efd8-3481-ab65-095e3399ebc1",
                        "source_sense_id": "16722e41-c1eb-3a4c-b397-0634597694b3",
                        "target_lang_word": "foam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb2347f-a3fe-38d6-8c9f-de5eb1984a91",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "A substance composed of a large collection of bubbles or their solidified remains, especially"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "763abbf5-c3fc-4456-88ca-cb3a5cdaa83f",
                                                "sense_id": "9bb2347f-a3fe-38d6-8c9f-de5eb1984a91",
                                                "text": "Similarly, the biotech giant Cargill has begun manufacturing a polymer from vegetable oils that is used in polyurethane foams, which is found in beddings, furniture and car-seat headrests."
                                            },
                                            {
                                                "example_id": "e5861072-51e2-4b7c-a8fe-a0d6e404ca95",
                                                "sense_id": "9bb2347f-a3fe-38d6-8c9f-de5eb1984a91",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ece6c850-9a61-39ca-ab29-a1795ddf3e90",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "A substance composed of a large collection of bubbles or their solidified remains, especially:",
                                            "A collection of small bubbles created when the surface of a body of water is moved by tides, wind, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c32c513-9d31-427b-9cbd-7913ce4b466a",
                                                "sense_id": "ece6c850-9a61-39ca-ab29-a1795ddf3e90",
                                                "text": "’Tis thou that rigg’st the bark and plough’st the foam,"
                                            },
                                            {
                                                "example_id": "5554b61e-1b3d-4bd3-85d0-0f1f25db01d3",
                                                "sense_id": "ece6c850-9a61-39ca-ab29-a1795ddf3e90",
                                                "text": "1798, Samuel Taylor Coleridge, The Rime of the Ancient Mariner in Lyrical Ballads, London: J. & A. Arch, p. 12,\nThe breezes blew, the white foam flew, / The furrow follow’d free: / We were the first that ever burst / Into that silent Sea."
                                            },
                                            {
                                                "example_id": "3db916b6-464c-4d21-96e7-fdfdaf4c15f7",
                                                "sense_id": "ece6c850-9a61-39ca-ab29-a1795ddf3e90",
                                                "text": "And the heaven became livid with the violence of the tempest […] and the river was tormented into foam […]"
                                            },
                                            {
                                                "example_id": "87cf754d-de10-48c5-baba-33405f87dbf2",
                                                "sense_id": "ece6c850-9a61-39ca-ab29-a1795ddf3e90",
                                                "text": "Many [of the fish-traps] were full of fish that raised foam as they splashed about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f04541a6-85d3-34fc-85c5-84f1388293a1",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "A substance composed of a large collection of bubbles or their solidified remains, especially:",
                                            "A collection of small bubbles formed from bodily fluids such as saliva or sweat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "143c6c40-4b5c-43ec-b85c-33bbdb85b068",
                                                "sense_id": "f04541a6-85d3-34fc-85c5-84f1388293a1",
                                                "text": "“Again. Tell it again!” cried Fagin, tightening his grasp on Sikes, and brandishing his other hand aloft as the foam flew from his lips."
                                            },
                                            {
                                                "example_id": "321eae9a-bf54-4d4f-93df-7fae09aaaee3",
                                                "sense_id": "f04541a6-85d3-34fc-85c5-84f1388293a1",
                                                "text": "The horses were flecked with foam and their breathing was noisy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5977d5e-2c79-37d9-b855-7a87517a5562",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "A substance composed of a large collection of bubbles or their solidified remains, especially:",
                                            "A collection of small bubbles on the surface of a liquid that is heated, fermented or carbonated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d50717-d794-4feb-a5a2-77abc18235f4",
                                                "sense_id": "b5977d5e-2c79-37d9-b855-7a87517a5562",
                                                "text": "a quart jug with a crown of foam upon it"
                                            },
                                            {
                                                "example_id": "9f983f7d-2ca5-4030-819e-e4e9d1db8f9b",
                                                "sense_id": "b5977d5e-2c79-37d9-b855-7a87517a5562",
                                                "text": "The last of the milk vanished in a swirl of foam and gurgling."
                                            },
                                            {
                                                "example_id": "846c54cd-c7e0-4724-b102-09275d932eff",
                                                "sense_id": "b5977d5e-2c79-37d9-b855-7a87517a5562",
                                                "text": "It was a very good palm-wine and powerful, for in spite of the palm fruit hung across the mouth of the pot to restrain the lively liquor, white foam rose and spilled over."
                                            },
                                            {
                                                "example_id": "b7e87681-76bb-465d-be42-55f4b7aa4242",
                                                "sense_id": "b5977d5e-2c79-37d9-b855-7a87517a5562",
                                                "text": "A slender thread of soft-drink foam traced her upper lip;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "417693ef-cb69-3cc0-8dd2-7597ef700b22",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "A substance composed of a large collection of bubbles or their solidified remains, especially:",
                                            "A collection of small bubbles created by mixing soap with water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a957786-df1d-4506-a79c-c88dd4762856",
                                                "sense_id": "417693ef-cb69-3cc0-8dd2-7597ef700b22",
                                                "text": "[…] she concentrated on the foam in the sink, tempering the water."
                                            },
                                            {
                                                "example_id": "df651700-f22e-45a6-8c21-b747fad55fc9",
                                                "sense_id": "417693ef-cb69-3cc0-8dd2-7597ef700b22",
                                                "text": "Later we shared a bath with foam up to our ears, like they always discreetly have in films."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3bcf607-701c-3233-92cb-82515d8db2b2",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "A substance composed of a large collection of bubbles or their solidified remains, especially:",
                                            "A collection of small bubbles formed by mixing an extinguishing agent with water, used to cover and extinguish fires."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd6c8856-a3d1-30b1-b7bc-bde81d27bc57",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "A material formed by trapping pockets of gas in a liquid or solid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75bcc28-edec-4790-9b9b-74f8af18ebbb",
                                                "sense_id": "bd6c8856-a3d1-30b1-b7bc-bde81d27bc57",
                                                "text": "A foam mat can soften a hard seat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d464a0f-26a6-3d69-9bdf-fe39836e45c7",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "The sea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1714d091-ce04-4566-a431-193133db4fd2",
                                                "sense_id": "6d464a0f-26a6-3d69-9bdf-fe39836e45c7",
                                                "text": "He is in Europe, across the foam."
                                            },
                                            {
                                                "example_id": "3ccd6b94-0cb0-4333-8cea-97feda20774d",
                                                "sense_id": "6d464a0f-26a6-3d69-9bdf-fe39836e45c7",
                                                "text": "How slowly does sad Time his feathers moue? / Hast thee O fayrest Planet to thy home / Within the Westerne fome:"
                                            },
                                            {
                                                "example_id": "4f754187-e16a-4a8e-9ba2-2df724c098af",
                                                "sense_id": "6d464a0f-26a6-3d69-9bdf-fe39836e45c7",
                                                "text": "You must dwell beyond the foam, / But I am safe and live at home."
                                            },
                                            {
                                                "example_id": "ef7c7408-3dd4-4451-8203-226473d9a9c7",
                                                "sense_id": "6d464a0f-26a6-3d69-9bdf-fe39836e45c7",
                                                "text": "But as for me, I'd sooner be\nA-roaring here at home\nAbout the rolling, roaring life\nOf them that sails the foam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b44a576d-316f-3ee2-b75d-c31f1cc65d70",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "Fury, rage, ire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b1616ec-3685-3f6c-9a8f-97cdaddca5a9",
                                        "entry_id": "6fdbcf6e-0d6d-31b3-be9f-95969c0c5abe",
                                        "glosses": [
                                            "Sneakers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
