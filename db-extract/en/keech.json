                    {
                        "sense_id": "0dabd12d-9a0a-357b-a7e9-da7e0628fc11",
                        "entry_id": "317fbd39-4205-3c77-b0cd-0183236422ac",
                        "glosses": [
                            "A mass or lump of fat rolled up by the butcher."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5cd6dd86-f888-41bb-baac-a62b2a59e7c4",
                                "sense_id": "0dabd12d-9a0a-357b-a7e9-da7e0628fc11",
                                "text": "I wonder\n That such a keech can with his very bulk\n Take up the rays o' th' beneficial sun,\n And keep it from the earth."
                            },
                            {
                                "example_id": "e9249fba-2696-49ad-a24f-b066900d8250",
                                "sense_id": "0dabd12d-9a0a-357b-a7e9-da7e0628fc11",
                                "text": "I observed them [natives of British Columbia] on another occasion content with merely warming keeches of raw and solid flesh under their naked armpits."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
