                "senses": [
                    {
                        "sense_id": "e37829f3-a20f-3251-aa4e-b86225ebb0b2",
                        "entry_id": "eda60b16-9a0d-34c3-ad28-79a930d9a0f0",
                        "glosses": [
                            "gedenkteken dat op het graf van iemand staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2184358-4c7e-4134-aecd-0f2e65dc26c4",
                                "sense_id": "e37829f3-a20f-3251-aa4e-b86225ebb0b2",
                                "text": "Misschien zou hij op het idee komen om een van de foto's die hij in de loop van de jaren van zijn vader gemaakt had op steen te laten drukken, en die in het grafmonument te laten verwerken."
                            },
                            {
                                "example_id": "2f078fef-f62d-4636-bbcd-0119773c8d3c",
                                "sense_id": "e37829f3-a20f-3251-aa4e-b86225ebb0b2",
                                "text": "Opgraven zit er echter niet in. „De weg is staatsgrond, maar erachter is het allemaal privéterrein.” Begraven aan de Via Appia was in het begin alleen voor de elite en streng gereguleerd, vertelt Mols. Hij wijst op enkele kleine blokken langs de kant. „In Romeinse voeten staat aangegeven hoe breed en hoe diep een bepaald grafmonument mocht zijn. Bij enkele monumenten hebben we het kunnen verifiëren en het klopte precies.”"
                            }
                        ]
                    }
