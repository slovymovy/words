                ],
                "senses": [
                    {
                        "sense_id": "e8738840-0386-3cc7-85f0-1cfb1c52734b",
                        "entry_id": "d29c9097-851c-39ab-bcbd-0020ecdbe826",
                        "glosses": [
                            "Frau, die bei einer offiziellen Marathonmeisterschaft den ersten Platz belegt hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "b69f7ab1-dcf7-4661-8295-f48971725787",
                                "sense_id": "e8738840-0386-3cc7-85f0-1cfb1c52734b",
                                "text": "„Ihren größten Erfolg feierte sie 1997 beim Regensburg-Marathon, wo sie als Gesamtsiegerin Deutsche Marathonmeisterin wurde.“"
                            },
                            {
                                "example_id": "d40452ce-5b0e-4ef4-b2b6-221b5f3e7031",
                                "sense_id": "e8738840-0386-3cc7-85f0-1cfb1c52734b",
                                "text": "„Bei ihrem Sieg an gleicher Stelle ein Jahr später wurde sie Deutsche Marathonmeisterin und stellte mit 2:24:35 h sowohl einen Streckenrekord wie auch einen deutschen Rekord auf.“"
                            },
                            {
                                "example_id": "5707db44-2462-4866-a3d1-e6c9bb24d911",
                                "sense_id": "e8738840-0386-3cc7-85f0-1cfb1c52734b",
                                "text": "„Im Jahr darauf wurde sie Dritte bei den Deutschen Meisterschaften im 10.000-Meter-Lauf, als Siegerin des Duisburg-Marathons Deutsche Marathonmeisterin und Fünfte beim Venedig-Marathon.“"
                            },
                            {
                                "example_id": "45f0fbff-a573-4697-b7db-8da838252cd8",
                                "sense_id": "e8738840-0386-3cc7-85f0-1cfb1c52734b",
                                "text": "„Die frühere deutsche Marathonmeisterin unterstrich ihre augenblicklich gute Form zuletzt beim Berliner Halbmarathon, als sie ihre persönliche Bestzeit auf der 21,1-km-Distanz um 27 Sekunden auf 69:38 Minuten steigerte.“"
                            },
                            {
                                "example_id": "54d0a4cc-2cdf-4c7e-a852-88c4d33b2ca9",
                                "sense_id": "e8738840-0386-3cc7-85f0-1cfb1c52734b",
                                "text": "„Unter ihrem Mädchennamen Amrhein hatte die frühere deutsche Marathonmeisterin (2018) den Lauf schon zweimal gewonnen: 2017 in 53:07 Minuten und 2018 in 51:43 Minuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
