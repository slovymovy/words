                "senses": [
                    {
                        "sense_id": "a076a740-decc-33ff-9655-9eea71b339ee",
                        "entry_id": "5e31ad7f-c3fb-3e0d-904e-84edac862b7f",
                        "glosses": [
                            "Boden, der in absehbarer Zeit zur Bebauung freigegeben werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa5b158-4053-4271-8762-3a2bdf619772",
                                "sense_id": "a076a740-decc-33ff-9655-9eea71b339ee",
                                "text": "Mit unseren Feldern fallen wir leider nicht ins Bauerwartungsland."
                            },
                            {
                                "example_id": "5e942e51-d27f-499b-bbb0-2165b1c9501a",
                                "sense_id": "a076a740-decc-33ff-9655-9eea71b339ee",
                                "text": "„Unter dem Begriff »Bauerwartungsland« sind solche Flächen zu verstehen, die zwar im Bewertungszeitpunkt noch nicht in Bauland umgewidmet sind, deren Umwidmung und Verbauung aber nach ihrer Lage und Aufschließungsmöglichkeit nach den Grundsätzen der Raumordnung und Bauordnung in nächster Zeit möglich ist …“"
                            },
                            {
                                "example_id": "8d2f2fc7-5fa2-44b1-b8b4-050774fa0716",
                                "sense_id": "a076a740-decc-33ff-9655-9eea71b339ee",
                                "text": "„Mollenhauer besitzt ein zweitausend Quadratmeter großes Grundstück am Ortsrand, das mit Obstbäumen bestanden und Bauerwartungsland ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
