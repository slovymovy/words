                        ],
                        "form": "die Handgranaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22d699ff-50bf-3708-9af3-bb041997896d",
                        "entry_id": "400b9124-eaa8-3163-bd04-1b785e318e4f",
                        "glosses": [
                            "mit einer Sprengladung gefüllter und einem Zeit- oder Aufschlagzünder versehener Metallhohlkörper, welcher mit der Hand geworfen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5daf0444-5534-4f41-afa4-e6b9ac5e0ce8",
                                "sense_id": "22d699ff-50bf-3708-9af3-bb041997896d",
                                "text": "Bis zu zehn bewaffnete Extremisten hätten das Büro gestürmt, das Feuer eröffnet und eine Handgranate gezündet."
                            },
                            {
                                "example_id": "b512d92c-7590-461a-b5b7-4ad6383af08b",
                                "sense_id": "22d699ff-50bf-3708-9af3-bb041997896d",
                                "text": "„Was eine Handgranate ist, wissen sie zwar, aber von Deckung haben sie wenig Ahnung, vor allen Dingen haben sie keinen Blick dafür.“"
                            },
                            {
                                "example_id": "a3ce4fc4-fab3-4939-88ce-354c58b6e9e0",
                                "sense_id": "22d699ff-50bf-3708-9af3-bb041997896d",
                                "text": "„Er wollte hinrennen und eine Handgranate in den Bunker schmeißen.“"
                            },
                            {
                                "example_id": "409fe998-527c-486b-9ba3-b7b1e1e5a7b2",
                                "sense_id": "22d699ff-50bf-3708-9af3-bb041997896d",
                                "text": "„Sie hängten sich die Karabiner um, schulterten die Panzerfäuste, nahmen die Kisten mit Munition und Handgranaten auf und bewegten sich in der einzigen Gangart, die das Gewicht der Waffen erlaubte…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a3af1a3-998b-4a59-ad62-ab1a2ab678f9",
                        "source_entry_id": "400b9124-eaa8-3163-bd04-1b785e318e4f",
