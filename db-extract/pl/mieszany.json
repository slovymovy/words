                                "target_senses": [
                                    {
                                        "sense_id": "a77cd7d9-5b56-3acd-9aa9-ce9db92e606c",
                                        "entry_id": "51c9a574-eaa1-3986-ac8f-8b96ea0a3e1a",
                                        "glosses": [
                                            "Having two or more separate aspects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d1b91f-9d00-4e02-804f-363ac077d0ec",
                                                "sense_id": "a77cd7d9-5b56-3acd-9aa9-ce9db92e606c",
                                                "text": "I get a very mixed feeling from this puzzling painting."
                                            },
                                            {
                                                "example_id": "5f0c79cc-945b-4307-a5db-ed5a53ca58ad",
                                                "sense_id": "a77cd7d9-5b56-3acd-9aa9-ce9db92e606c",
                                                "text": "The various studies produced mixed results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c11724c-bc61-304d-be65-ad0a43e51eac",
                                        "entry_id": "51c9a574-eaa1-3986-ac8f-8b96ea0a3e1a",
                                        "glosses": [
                                            "Not completely pure, tainted or adulterated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c499f9-050c-4932-91e1-6f5bff99eeae",
                                                "sense_id": "1c11724c-bc61-304d-be65-ad0a43e51eac",
                                                "text": "My joy was somewhat mixed when my partner said she was pregnant: it's a lot of responsibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a7ac3d-0f5d-3dd5-be70-1a21589daf24",
                                        "entry_id": "51c9a574-eaa1-3986-ac8f-8b96ea0a3e1a",
                                        "glosses": [
                                            "Including both male(s) and female(s)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8babc0be-d8dc-45bf-9692-7ee498fb0ea0",
                                                "sense_id": "e5a7ac3d-0f5d-3dd5-be70-1a21589daf24",
                                                "text": "The tennis match was mixed, with a boy and a girl on each side."
                                            },
                                            {
                                                "example_id": "8299ba8c-6e22-44eb-a446-83127726f46a",
                                                "sense_id": "e5a7ac3d-0f5d-3dd5-be70-1a21589daf24",
                                                "text": "My son attends a mixed school, my daughter an all-girl grammar school."
                                            },
                                            {
                                                "example_id": "aef9309f-8f6e-4184-8a14-5ba8b501ac6f",
                                                "sense_id": "e5a7ac3d-0f5d-3dd5-be70-1a21589daf24",
                                                "text": "We were the first paper to involve large numbers of gay men and lesbians: today, we remain the only truly mixed periodical in our community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d0c7237-6104-3f96-9f44-56429992e91d",
                                        "entry_id": "51c9a574-eaa1-3986-ac8f-8b96ea0a3e1a",
                                        "glosses": [
                                            "Stemming from two or more races or breeds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f52a52-e7c5-4c4c-8cdb-92c3ec295915",
                                                "sense_id": "5d0c7237-6104-3f96-9f44-56429992e91d",
                                                "text": "The benefit dog show has both mixed and single-breed competitions."
                                            },
                                            {
                                                "example_id": "04ba3426-9a8f-4536-a326-3cf299b37194",
                                                "sense_id": "5d0c7237-6104-3f96-9f44-56429992e91d",
                                                "text": "Mixed blood can surprisingly produce inherited properties which neither parent showed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1866e73f-fd24-347e-9cec-974b9c8e1806",
                                        "entry_id": "51c9a574-eaa1-3986-ac8f-8b96ea0a3e1a",
                                        "glosses": [
                                            "Polarizing; including both positive and negative feedback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7734b5a2-f29a-48fa-aae1-90f6bb942149",
                                                "sense_id": "1866e73f-fd24-347e-9cec-974b9c8e1806",
                                                "text": "The movie has received mixed reviews from movie critics."
                                            }
                                        ]
                                    }
                                ]
                            }
