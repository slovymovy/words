                                    },
                                    {
                                        "sense_id": "79963d0d-9917-31a2-bff3-6734f9e6ba78",
                                        "entry_id": "f4092156-6bd6-30b0-a2ef-c23c7eb4fb96",
                                        "glosses": [
                                            "To send messages repeatedly, often with disruptive effect; to flood."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cba35d3c-2dff-3176-a46d-af0c02fdbe52",
                                        "entry_id": "f4092156-6bd6-30b0-a2ef-c23c7eb4fb96",
                                        "glosses": [
                                            "To do something rapidly and repeatedly."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc4e68ea-678b-492e-8d45-02ab6c1b4a33",
                                                "sense_id": "cba35d3c-2dff-3176-a46d-af0c02fdbe52",
                                                "text": "Stop spamming that special attack!"
                                            },
                                            {
                                                "example_id": "6f25333e-8d59-4b90-b89d-9e0d6467242d",
