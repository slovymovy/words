                                        "examples": [
                                            {
                                                "example_id": "23cbdf97-379b-470d-add0-079885a18993",
                                                "sense_id": "fb66a41f-e4f8-3220-9231-9265e5413081",
                                                "text": "The garage was filled with a random assortment of odds and ends."
                                            },
                                            {
                                                "example_id": "2d736efc-9890-4d1c-8dc5-bdaee7a358be",
                                                "sense_id": "fb66a41f-e4f8-3220-9231-9265e5413081",
                                                "text": "I scraped my palette, stuck my brushes in a bowl of black soap, and I strolled into the smoking-room. I really believe that, excepting Geneviève's apartments, no room in the house was so free from the perfume of tobacco as this one. It was a queer chaos of odds and ends hung with threadbare tapestry."
                                            }
                                        ]
