                        "examples": [
                            {
                                "example_id": "05d8c1d9-c8fc-4114-86af-6af515f1e54d",
                                "sense_id": "05e05a19-135b-3006-89c2-47e5bddf9b62",
                                "text": "La côte amalfitaine est principalement constituée de falaises rocheuses."
                            },
                            {
                                "example_id": "39586345-3df8-42fe-9d5d-db9f0d1e5bf4",
                                "sense_id": "05e05a19-135b-3006-89c2-47e5bddf9b62",
                                "text": "Nous explorâmes tous les trois la côte amalfitaine jusqu’à Ravello, poussant même vers Paestum au-delà de Salerne, coulant de très heureuses journées."
                            }
                        ]
                    }
