                "senses": [
                    {
                        "sense_id": "975b6f56-d1b0-38c7-ba94-6d8e13671fe2",
                        "entry_id": "c89feaa4-ced4-3f7b-96f0-c7ac9f806e92",
                        "glosses": [
                            "Name des Zeichens ‚–‘ (typographisch ein Halbgeviertstrich) in der Bedeutung ‚(von) bis‘, also wenn es zwischen zwei Elementen einer Reihe steht und diese so als Endpunkte einer Spanne kennzeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba48a79-896f-49dc-9054-ad804b614045",
                                "sense_id": "975b6f56-d1b0-38c7-ba94-6d8e13671fe2",
                                "text": "„Dieses Zeichen dient […] als Gedanken- und Bisstrich.“"
                            },
                            {
                                "example_id": "ca0436e4-0a21-48bd-b7c2-33528563477e",
                                "sense_id": "975b6f56-d1b0-38c7-ba94-6d8e13671fe2",
                                "text": "„[…] oft zwei Zahlen mit einem Bisstrich verbunden, wie 3-4, oder im Falle, dass der angrenzende Bereich nur in geringem Maße eine Rolle spielt, mit Klammer, z.B. 2 (-3).“"
                            },
                            {
                                "example_id": "571fd9e1-3f01-47fc-a396-f617897f05da",
                                "sense_id": "975b6f56-d1b0-38c7-ba94-6d8e13671fe2",
                                "text": "„Der Strich (—) wird verwendet […] als Bisstrich […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
