                                        "entry_id": "69a9acf3-f624-3b72-a69c-e7e85cee1d39",
                                        "glosses": [
                                            "auf der rechten Seite; die rechte Seite betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afdbebc8-08a2-4ddb-a82c-0dddd544044b",
                                                "sense_id": "7f40f302-8f69-3a51-abce-5804e8be657a",
                                                "text": "„Holger Biege fällt ins Koma, er ist rechtsseitig gelähmt, er muss beatmet werden.“"
                                            },
                                            {
                                                "example_id": "04b69c56-a89a-4fb6-ad47-e8c352b699d7",
                                                "sense_id": "7f40f302-8f69-3a51-abce-5804e8be657a",
                                                "text": "„Wer die Isar rechtsseitig stadtauswärts geht, wird schwerlich umhin kommen, eine gewisse Monotonie zu bemerken - die aber auf hohem Niveau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
