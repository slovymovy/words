                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14a46f17-875b-39e7-9019-7b0306d19e4b",
                        "entry_id": "9790a685-351c-3601-986f-0a880541df22",
                        "glosses": [
                            "Sammler"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ef610b3-ce97-4164-9659-d927946e7579",
                        "source_entry_id": "9790a685-351c-3601-986f-0a880541df22",
                        "source_sense_id": "14a46f17-875b-39e7-9019-7b0306d19e4b",
                        "source_sense_description": "Sammler",
                        "target_lang_word": "Sammler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sammler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                        "entry_id": "0581115c-c573-3ead-b8a2-c9a3fb5b855e",
                                        "glosses": [
                                            "Person, die Gegenstände einer bestimmten Art (z. B. Münzen, Briefmarken, Karten) sammelt, meist als Hobby"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c1dd32-3044-448a-9848-a62b347f4652",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "Ansichtskarten aus der Zeit vor 1945 sind bei Sammlern sehr beliebt."
                                            },
                                            {
                                                "example_id": "c91d59b3-d47e-4b9c-9e18-c72dc0bbcfc3",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Meine Grundschullehrerin hieß auch Friede, denkt der Wolfram in mir, und meine finnische Liebe wurde auf den Namen Pia-Maria getauft, was nicht eben nach Jägern und Sammlern klingt.“"
                                            },
                                            {
                                                "example_id": "ce2145c8-0bd4-4920-891d-c082a93f5acc",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Aber dann kam hinzu, daß dies auch seine Wissenschaft hatte - der alte Elias entdeckte auf seine alten Tage die Wonnen des Sammlers (ohne es zu wissen).“"
                                            },
                                            {
                                                "example_id": "f0edb2a4-bb23-4702-841e-a3faadc044ee",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Doktor Mungole war ein Sammler.“"
                                            },
                                            {
                                                "example_id": "67d16baf-5e7b-4d33-8a94-c9b3f973b23e",
                                                "sense_id": "b2d73f59-6aba-3141-b596-3c2b6e5e1c48",
                                                "text": "„Auch Sung war eher ein Sammler als ein Geschäftsmann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d82d5066-1b6c-3487-8b7e-73c8d4f719b6",
                                        "entry_id": "0581115c-c573-3ead-b8a2-c9a3fb5b855e",
                                        "glosses": [
                                            "großes Rohr der Kanalisation"
                                        ],
                                        "tags": [
                                            "Straßenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7aa43f-af8b-4b90-a30d-d84192fd0a12",
                                                "sense_id": "d82d5066-1b6c-3487-8b7e-73c8d4f719b6",
                                                "text": "„Für das Schmutz- und Abwasser im Sammler gibt es landschaftlich unterschiedliche Ausdrücke wie Kanalwasser, Kanaljauche, Stadtlauge, städtisches Abwasser, Schleusenwasser, Sielwasser u.a.m.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
