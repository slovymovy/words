                        "glosses": [
                            "Aventure digne d’Arsène Lupin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0d8c30-207e-43ef-a2d2-b86e071fd9b9",
                                "sense_id": "bf025376-8a04-3cf7-ae32-ce475053344a",
                                "text": "C'est finalement Don Luis Perenna, alias Arsène Lupin qui viendra rétablir cette rationalité dans une agréable et légère lupinade qui rend ce roman à sa destination."
                            },
                            {
                                "example_id": "7d54cf00-9ed0-4562-8d3d-f2d99771abd2",
                                "sense_id": "bf025376-8a04-3cf7-ae32-ce475053344a",
                                "text": "Après la « lupinade » d'Omar Sy sur Netflix, faut-il s'attendre à une Flaubertmania ?"
                            },
                            {
                                "example_id": "0390180d-1936-4d5b-a47d-31040638f362",
                                "sense_id": "bf025376-8a04-3cf7-ae32-ce475053344a",
                                "text": "Une lupinade de plus, avec Rouletabille en bonus, mais qui se révèle confuse et guère palpitante."
                            },
                            {
                                "example_id": "1b1ffe80-dab1-4ebb-bc28-c47168375e87",
                                "sense_id": "bf025376-8a04-3cf7-ae32-ce475053344a",
                                "text": "Mais surtout, coup de chapeau à cette lupinade à l'ancienne, digne d'un Maurice Leblanc ou d'un Ponson du Terrail (le père de Rocambole)."
                            }
                        ]
                    }
