                "translations": [
                    {
                        "translation_id": "114b3678-3d1c-4f24-9801-3a2fcb3fd7a6",
                        "source_entry_id": "9ec500ba-154c-34fa-9942-6b05a28497fc",
                        "source_sense_id": "e6231a4d-9461-31e1-8ece-693f4fe3ef14",
                        "target_lang_word": "minaret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minaret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23d2f7d8-8c29-3ef8-89f9-d22d6f5131b1",
                                        "entry_id": "addabce0-2f41-3cb3-87fe-fac5a999199b",
                                        "glosses": [
                                            "The tall slender tower of an Islamic mosque, from which the muezzin recites the adhan (call to prayer)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cef131b-b240-4253-ac15-b0aede17bf8a",
                                                "sense_id": "23d2f7d8-8c29-3ef8-89f9-d22d6f5131b1",
                                                "text": "And in the background of the picture, just out of focus behind the man, was a soaring minaret outlined against a shockingly blue sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53f1850a-e9db-4add-a105-30fa6e5ef53e",
                        "source_entry_id": "9ec500ba-154c-34fa-9942-6b05a28497fc",
                        "source_sense_id": "e6231a4d-9461-31e1-8ece-693f4fe3ef14",
                        "target_lang_word": "minaret",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e884c804-9ed5-43c6-b902-a067e63350e5",
                        "source_entry_id": "9ec500ba-154c-34fa-9942-6b05a28497fc",
                        "source_sense_id": "e6231a4d-9461-31e1-8ece-693f4fe3ef14",
                        "target_lang_word": "minaret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minaret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                        "entry_id": "9c44e287-c9e1-3b53-b897-b5d8fcd8e715",
                                        "glosses": [
                                            "Tour d’une mosquée, d'une medersa du haut de laquelle les musulmans sont appelés à la prière par le muezzin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e1278d6-92f0-45fb-bb8c-6c00a508a89c",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Je demeurai une heure dans la grande rue, ayant pour récréation la vue d’un nid de cigogne planté sur une cheminée comme sur un minaret d’Athènes […]"
                                            },
                                            {
                                                "example_id": "41658e27-c91d-4ab5-90c2-abbb3c328b97",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Dominant tout, au sommet de la colline, une grande tour carrée, d’une blancheur tranchant sur les transparences ambiantes et qui scintillait au milieu du jour, aveuglante, gardant le soir les derniers rayons rouges du couchant : le minaret de la zaouïya de Sidi Salem."
                                            },
                                            {
                                                "example_id": "43c309c9-1d8a-4770-b859-07ae06fe5f6c",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Les petites bannières blanches viennent de grimper au sommet des minarets, annonçant l’heure méridienne de l’oûli, quand nous passons sous la voûte sombre de la grande porto de Casablanca."
                                            },
                                            {
                                                "example_id": "41c2c095-b6fd-4b5d-ba76-cf2fe2350514",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Un minaret carré et trapu, qui se termine par une coupole reposant sur une base octogonale, domine la ville du Caire du haut de la montagne de Mokattam."
                                            },
                                            {
                                                "example_id": "5cdcb8d1-0b73-4e30-a0eb-d9567a0efadf",
                                                "sense_id": "cc5fb8ff-502c-3219-9188-2045b5abb5c0",
                                                "text": "Ils restèrent près de dix jours dans ce camp et, pour la plupart des hommes, l’oisiveté était devenue une drogue dure, rythmée par la litanie des appels à la prière qui s’élevaient du grand minaret de la médina."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minaret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7c38561-d699-3736-8836-490b411b7eeb",
                                        "entry_id": "6b18256c-fd80-3c6d-9257-9623099097f6",
                                        "glosses": [
                                            "Ancien terme qui désignait un puits de mine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada9786a-7234-462f-bbe1-58772ab8ea61",
                                                "sense_id": "e7c38561-d699-3736-8836-490b411b7eeb",
                                                "text": "Minaret : Puits ou trou qu’on a creusé pour tirer de la mine de fer."
                                            },
                                            {
                                                "example_id": "b11ff5a8-806e-4a00-ad9e-c91d9eb42083",
                                                "sense_id": "e7c38561-d699-3736-8836-490b411b7eeb",
                                                "text": "Ouvrier qui transporte la mine (minerai) au moyen d’une brouette sous le puits du minaret, par lequel on en doit faire l’extraction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
