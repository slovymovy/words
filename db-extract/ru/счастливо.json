                            "adverb"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4c5aea42-2394-330a-98a4-f9c7b8961bcc",
                        "entry_id": "f34749b4-1abb-3b83-b286-0f3318d91bf7",
                        "glosses": [
                            "удачно, успешно"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25b202df-52b1-4ea9-b81f-916f6b461c62",
                        "source_entry_id": "f34749b4-1abb-3b83-b286-0f3318d91bf7",
                        "source_sense_description": "испытывая счастье",
                        "target_lang_word": "happily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "happily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "In a happy or cheerful manner; with happiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f0cd391-bf2c-4c06-a226-f5f6ee3ea0b1",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "This time next month I’ll be happily fishing at the beach."
                                            },
                                            {
                                                "example_id": "aa828e31-617b-450e-8739-5baf0be85ba0",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "And thus I have given the first part of a life of fortune and adventure, a life of Providence's chequer-work, and of a variety which the world will seldom be able to shew the like of: beginning foolishly, but closing much more happily than any part of it ever gave me leave so much as to hope for."
                                            },
                                            {
                                                "example_id": "ea2ce3e6-936d-43e7-a3de-784a79335de4",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "Train operating companies get plenty of column inches in the tabloids, usually for negative reasons. Happily, Southeastern is worthy of praise for having made The Sun for something positive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81054a6c-9a4e-3d16-8f60-660610a36c31",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "By good chance; fortunately, successfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774e1733-253b-494b-a480-193607f08318",
                                                "sense_id": "81054a6c-9a4e-3d16-8f60-660610a36c31",
                                                "text": "Watt wore, on his feet, a boot, brown in colour, and a shoe, happily of a brownish colour also."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ad5cb87-5a0a-3781-a61e-31639014727b",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "With good will; in all happiness; willingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a17171-6d89-4412-9f16-b5f172348077",
                                                "sense_id": "9ad5cb87-5a0a-3781-a61e-31639014727b",
                                                "text": "I will happily help you look for your lost wallet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5306604-7dff-3488-9c86-f35980b59732",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "By chance; perhaps."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72740378-37da-4b13-be3e-540bafc6c561",
                                                "sense_id": "f5306604-7dff-3488-9c86-f35980b59732",
                                                "text": "And who knoweth whether a thousand yeares hence a third opinion will rise, which happily shall overthrow these two precedents?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd9968c1-37ed-4017-a9ba-555cb31b2285",
                        "source_entry_id": "f34749b4-1abb-3b83-b286-0f3318d91bf7",
                        "source_sense_description": "удачно",
                        "target_lang_word": "luckily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luckily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4340cc60-1250-36ef-9cdd-c5b521f1985d",
                                        "entry_id": "684e9b28-c5f4-31b6-9afc-bc0d2405e891",
                                        "glosses": [
                                            "In a lucky manner; by good fortune; fortunately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3703a44-eba6-4f1f-8de0-f37f00190916",
                                                "sense_id": "4340cc60-1250-36ef-9cdd-c5b521f1985d",
                                                "text": "They luckily escaped injury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc6f0160-cf07-42fb-88ab-61e6f4b08230",
                        "source_entry_id": "f34749b4-1abb-3b83-b286-0f3318d91bf7",
                        "source_sense_description": "удачно",
                        "target_lang_word": "glücklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glücklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "(Zufalls-)Glück oder Erfolg habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f512a748-549e-4ca8-bb63-6391ad3b9092",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "In Erzählungen enden die meisten Abenteuer glücklich."
                                            },
                                            {
                                                "example_id": "5049dd91-8bab-4315-a5e4-6871d3ae5be6",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "6ef6656a-eaed-4f59-95a6-e8066b876bcc",
                                                "sense_id": "35154ff5-754a-3cd3-b9f8-1ea4b9de6fac",
                                                "text": "Odysseus kehrte nach Jahren glücklich zu seiner Penelope zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "von großer Freude, Zufriedenheit, vom (Wohlfühl-)Glück erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3805a823-b63a-452f-9092-5e264baddece",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "bb00e28a-8bfd-42d5-922a-5245c306504b",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Odysseus kehrte nach Jahren glücklich zu seiner Penelope zurück."
                                            },
                                            {
                                                "example_id": "6df53a76-569c-41cf-9457-7eabfc6f0963",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Sie war so glücklich, als ich sie in meinen Armen hielt."
                                            },
                                            {
                                                "example_id": "03711893-355c-45bf-b49c-cc901712af24",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "Willst du glücklich sein im Leben, trage bei zu andrer Glück, denn die Freude, die wir geben, kehrt ins eig'ne Herz zurück."
                                            },
                                            {
                                                "example_id": "9c1a176c-7ce0-4c32-b02c-edb404d78c68",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„Das Adoptivkaisertum ist vielfach als die glücklichste Zeit der antiken Geschichte bezeichnet worden.“"
                                            },
                                            {
                                                "example_id": "734174fe-97cb-4942-9b55-886dce5594e7",
                                                "sense_id": "c24172ae-1f3f-30d1-bbc3-8df5c3b1cfa5",
                                                "text": "„… ich lief weiter und war glücklich, daß ich endlich rechts und links in der Ferne Mauern sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1eb22e15-fe65-325d-9642-c13a0aa3887d",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "vorteilhaft, günstig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f47ad5-588a-4bfa-84b2-c0575e37fb41",
                                                "sense_id": "1eb22e15-fe65-325d-9642-c13a0aa3887d",
                                                "text": "Nur aufgrund glücklicher Umstände kamen wir mit geringen Verletzungen davon."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d63c760b-8ec6-323b-8657-b7d6fab8b053",
                                        "entry_id": "835c4543-961f-3b63-98b4-f67842beb053",
                                        "glosses": [
                                            "schließlich, zu guter Letzt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c0bdf6-6232-43e0-9aba-1093d1409286",
                                                "sense_id": "d63c760b-8ec6-323b-8657-b7d6fab8b053",
                                                "text": "Nach langen Versuchen hat er das Radio doch noch glücklich zum Laufen gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
