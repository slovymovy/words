                    {
                        "sense_id": "c33c65f5-0efb-333f-85f6-0e98e6c84ba1",
                        "entry_id": "181ac975-2692-3330-ba20-3d5c6b8fef4e",
                        "glosses": [
                            "Espèce vivante entraînée ou sélectionnée par l'homme pour répondre à ses besoins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ef0a84-ee9a-4748-b880-62f56a90eae7",
                                "sense_id": "c33c65f5-0efb-333f-85f6-0e98e6c84ba1",
                                "text": "Originaire du Croissant fertile proche-oriental, il fut cultivé il y a plus de 10 000 ans, ce qui fait de lui l’une des plus anciennes céréales domestiquées."
                            },
                            {
                                "example_id": "fb068b11-fbe2-457f-aacf-3b7494bf25f8",
                                "sense_id": "c33c65f5-0efb-333f-85f6-0e98e6c84ba1",
                                "text": "Le cheval, domestiqué par l’humain, nous a permis de nous déplacer, de faire la guerre et de cultiver les terres."
                            }
                        ]
                    }
                ],
