                                        "glosses": [
                                            "Movimiento del tórax al respirar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70852d86-d375-4e70-a4db-aafdcacededa",
                                                "sense_id": "021d089b-68be-329a-9da7-67bc2dc8b32f",
                                                "text": "Contener la respiración."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4045b4e-d3ef-363f-a906-136cca7c9cf9",
                                        "entry_id": "18445991-d4b8-311f-a73b-f3f2c65e100a",
                                        "glosses": [
                                            "Intercambio gaseoso entre un organismo y la atmósfera, o el agua, con aspiración de oxígeno y espiración de anhídrido carbónico."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eef69fd-68cb-4964-ae33-06d02b03fc72",
                                                "sense_id": "e4045b4e-d3ef-363f-a906-136cca7c9cf9",
                                                "text": "La respiración de las plantas sucede a través de los estomas de las hojas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15e7b180-9267-355c-b886-457f9c444df9",
                                        "entry_id": "18445991-d4b8-311f-a73b-f3f2c65e100a",
                                        "glosses": [
                                            "Circulación del aire de un lugar cerrado hacia y desde el exterior."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42d47866-c2c4-4f29-9cda-59a803eeec7f",
                        "source_entry_id": "552f2cf8-216f-35f6-8a41-a597a5bc1148",
                        "source_sense_id": "13db4253-f00a-30ab-9edb-bc17f3b397d9",
                        "target_lang_word": "Atmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84184393-20fc-3873-9689-f5edd8739430",
                                        "entry_id": "6adedced-290c-3cdf-b1f1-feb24d36c388",
                                        "glosses": [
                                            "Vorgang, bei dem ein Lebewesen Luft in die Atmungsorgane einsaugt und verbrauchte Luft ausstößt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef1960c-92df-436f-ac23-3c045a6e68dc",
                                                "sense_id": "84184393-20fc-3873-9689-f5edd8739430",
                                                "text": "„Auch wenn das Atmen die grundlegendste und konstanteste Aktivität des Lebens ist, ist den meisten Menschen nie vermittelt worden, wie man es richtig macht.“"
                                            },
                                            {
                                                "example_id": "b29f19b3-ac64-40ef-bcd3-11b12806c4ec",
                                                "sense_id": "84184393-20fc-3873-9689-f5edd8739430",
                                                "text": "„Weil das Atmen ohne unser Zutun geschieht, nehmen wir es oft als selbstverständlich hin.“"
                                            },
                                            {
                                                "example_id": "037c719d-5b15-4e63-818d-bd3db3792a8e",
                                                "sense_id": "84184393-20fc-3873-9689-f5edd8739430",
                                                "text": "„Hilfreich ist auch, wenn Sie beim Atmen während des Sports zählen.“"
                                            },
                                            {
                                                "example_id": "b4793b48-f52a-4aeb-bffd-2ed81756ba87",
                                                "sense_id": "84184393-20fc-3873-9689-f5edd8739430",
                                                "text": "„Erst tief in der Nacht bin ich eingeschlafen, aber nicht richtig, denn ich bin während der Nacht immer wieder wach geworden und habe Papa beim Atmen zugehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d4d6f16-ed81-4def-9aed-dc276d6d7bda",
                        "source_entry_id": "552f2cf8-216f-35f6-8a41-a597a5bc1148",
                        "source_sense_id": "13db4253-f00a-30ab-9edb-bc17f3b397d9",
                        "target_lang_word": "Atmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                        "entry_id": "1b27c62d-1d63-3a67-881e-9453b9dae2d0",
                                        "glosses": [
                                            "Vorgang, bei dem ein Lebewesen Luft in die Atmungsorgane einsaugt und verbrauchte Luft ausstößt"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01dd4ad-ee3f-4e84-b858-9a47c69436ed",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "Atmung ist lebensnotwendig."
                                            },
                                            {
                                                "example_id": "56f3b8d5-19bd-4566-bc95-aeb577ae5694",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "Da keine Atmung des Patienten feststellbar war, wurde er beatmet."
                                            },
                                            {
                                                "example_id": "8e9fd821-40f8-4225-a439-145d7cc385bc",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "Die Atmung des Patienten war flach und zu schnell."
                                            },
                                            {
                                                "example_id": "842d0162-c35c-409c-a9db-307e9920917d",
                                                "sense_id": "fb82e79e-9ff6-35e3-8d78-a840a62544d4",
                                                "text": "„Gerät zum Aufzeichnen der Atemtätigkeit der Lunge, der Ausdehnung des Brustkorbs und der Häufigkeit und Tiefe der Atmungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                        "entry_id": "1b27c62d-1d63-3a67-881e-9453b9dae2d0",
                                        "glosses": [
                                            "chemischer Vorgang, bei dem ein energiehaltiger Stoff mit Hilfe eines zweiten Stoffes (zum Beispiel von Sauerstoff) umgesetzt wird, um Energie im Körper chemisch zu speichern"
                                        ],
                                        "tags": [
                                            "Physiologie",
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab91dfca-9755-43e1-bf75-2d464244bf94",
                                                "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                                "text": "„Es laufen schrittweise verschiedene Gärungen (Gärung) und anaerobe Atmungen (anaerobe Atmung) ab, wobei das Endprodukt der Gärung einer Bakteriengruppe der anderen als Substrat dienen kann ( vgl. Abb. ).“"
                                            },
                                            {
                                                "example_id": "7194c6e9-5f7e-441f-b995-b4c4fa133b9a",
                                                "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                                "text": "… die zelluläre Energieerzeugung durch chemische Atmung in Mitochondrien ist membranständig."
                                            },
                                            {
                                                "example_id": "0e4a55ad-6505-4828-808c-3e10d11550e1",
                                                "sense_id": "760852db-18f4-3215-89d5-60839e9d2b5b",
                                                "text": "„Die verschiedenen anaeroben Atmungen werden anhand des veratmeten Substrates oder der Stoffwechselendprodukte klassifiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
