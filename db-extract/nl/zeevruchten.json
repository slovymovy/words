                        ],
                        "examples": [
                            {
                                "example_id": "da8ee11e-4fde-459d-8e9c-74df2f391021",
                                "sense_id": "3affc7ac-ff93-3334-9317-c3a480278cd5",
                                "text": "Dat was een goed idee, de pasta met zeevruchten is erg lekker. Het grote bord is gevuld met schelpen, mosselen, scampi’s en een lichtpittige tomatensaus."
                            },
                            {
                                "example_id": "335cdf55-8f5f-46d8-b766-81fed690b3c3",
                                "sense_id": "3affc7ac-ff93-3334-9317-c3a480278cd5",
                                "text": "Aan de kust zijn het vooral vis en zeevruchten die het menu bepalen."
                            }
                        ]
                    }
