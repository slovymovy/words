                "senses": [
                    {
                        "sense_id": "f034ee95-c4ff-3a48-a8a4-a47b4b9649f4",
                        "entry_id": "c7a09991-3b24-3028-9de1-07175f2d9424",
                        "glosses": [
                            "Avis diffusé à tous les personnels navigants et chargés de la sécurité aérienne concernant les modifications de procédure, la modification des services aéronautiques ou de dangers pour la navigation aérienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "317e37e6-0f9c-4cd9-af67-b4e58a40e438",
                                "sense_id": "f034ee95-c4ff-3a48-a8a4-a47b4b9649f4",
                                "text": "Le Service de l'Aviation civile échangera ses publications d'information aéronautique avec celles des services similaires des États intéressés et diffusera les NOTAM conformément aux recommandations des conférences aéronautiques."
                            },
                            {
                                "example_id": "ebcb637d-2e46-4724-b16a-e2cc585b1df8",
                                "sense_id": "f034ee95-c4ff-3a48-a8a4-a47b4b9649f4",
                                "text": "Ceux spécialisés dans les transmissions vont dans les divers BCT (bureau central des télécommunications) assurant l'acheminement des plans de vol et messages d'exploitation y compris les NOTAM."
                            }
                        ]
                    }
