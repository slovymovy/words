{
    "word_family": [
        "haunt",
        "haunter",
        "haunting",
        "hauntingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0722a299-25bd-3aef-9829-1b429b5fd294",
                    "sense_definition": "Of a location, inhabited or visited by ghosts or spirits.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They dared each other to enter the old <w>haunted</w> house at night.",
                            "target_lang_translations": {
                                "ru": "Они подначивали друг друга войти ночью в старый дом <w>с привидениями</w>.",
                                "cs": "Vyzývali se navzájem, aby v noci vstoupili do toho starého <w>strašidelného</w> domu."
                            }
                        },
                        {
                            "text": "Many tourists visit the castle because it is rumored to be <w>haunted</w>.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают этот замок, потому что, по слухам, он <w>с привидениями</w>.",
                                "cs": "Mnoho turistů navštěvuje tento hrad, protože se říká, že v něm <w>straší</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "haunted house",
                        "haunted mansion",
                        "haunted castle",
                        "haunted place"
                    ],
                    "target_lang_definitions": {
                        "ru": "О месте: посещаемое или населенное привидениями или духами.",
                        "cs": "O místě: obývané nebo navštěvované duchy či přízraky."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с привидениями",
                                "target_lang_sense_clarification": "о доме или месте"
                            },
                            {
                                "target_lang_word": "населенный призраками",
                                "target_lang_sense_clarification": "обитаемый духами"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "strašidelný",
                                "target_lang_sense_clarification": "o domě nebo místě, kde straší"
                            },
                            {
                                "target_lang_word": "posedlý duchy",
                                "target_lang_sense_clarification": "místo obývané nadpřirozenými bytostmi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17d171e4-36f0-3a14-813e-35d8f9a5982e",
                    "sense_definition": "Constantly worried, troubled, or obsessed by a memory, idea, or feeling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>haunted</w> by the regret of not saying goodbye.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что её <w>преследует</w> сожаление о том, что она не попрощалась.",
                                "cs": "Cítila se <w>pronásledovaná</w> lítostí, že se nerozloučila."
                            }
                        },
                        {
                            "text": "The soldier was <w>haunted</w> by memories of the war for many years.",
                            "target_lang_translations": {
                                "ru": "Солдата много лет <w>преследовали</w> воспоминания о войне.",
                                "cs": "Vojáka mnoho let <w>pronásledovaly</w> vzpomínky na válku."
                            }
                        }
                    ],
                    "synonyms": [
                        "tormented",
                        "plagued",
                        "troubled",
                        "obsessed"
                    ],
                    "antonyms": [
                        "carefree",
                        "untroubled"
                    ],
                    "common_phrases": [
                        "haunted by memories",
                        "haunted by the past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно тревожимый или мучимый навязчивыми воспоминаниями, идеями или чувствами.",
                        "cs": "Neustále znepokojený, trýzněný nebo posedlý vzpomínkou, myšlenkou či pocitem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследуемый",
                                "target_lang_sense_clarification": "воспоминаниями или мыслями"
                            },
                            {
                                "target_lang_word": "мучимый",
                                "target_lang_sense_clarification": "страдающий от чего-либо"
                            },
                            {
                                "target_lang_word": "одержимый",
                                "target_lang_sense_clarification": "охваченный навязчивой идеей"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pronásledovaný",
                                "target_lang_sense_clarification": "myšlenkami nebo vzpomínkami"
                            },
                            {
                                "target_lang_word": "trýzněný",
                                "target_lang_sense_clarification": "trpící vnitřním neklidem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "072d33be-c41e-3887-8696-dd025307bb86",
                    "sense_definition": "Showing signs of mental anguish, fear, or deep worry in one's appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>haunted</w> look in his eyes after hearing the terrible news.",
                            "target_lang_translations": {
                                "ru": "После ужасных новостей у него был <w>затравленный</w> взгляд.",
                                "cs": "Poté, co uslyšel tu hroznou zprávu, měl v očích <w>vyděšený</w> výraz."
                            }
                        },
                        {
                            "text": "Her face was pale and <w>haunted</w> from weeks of sleepless nights.",
                            "target_lang_translations": {
                                "ru": "Её лицо было бледным и <w>измученным</w> от недель бессонных ночей.",
                                "cs": "Její tvář byla bledá a <w>zmučená</w> po týdnech bezesných nocí."
                            }
                        }
                    ],
                    "synonyms": [
                        "haggard",
                        "strained",
                        "anguished",
                        "gaunt"
                    ],
                    "antonyms": [
                        "cheerful",
                        "bright"
                    ],
                    "common_phrases": [
                        "haunted look",
                        "haunted eyes",
                        "haunted expression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий душевную муку, страх или глубокое беспокойство (о внешности или взгляде).",
                        "cs": "Vyjádření duševní úzkosti, strachu nebo hlubokého znepokojení (o vzhledu nebo pohledu)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затравленный",
                                "target_lang_sense_clarification": "о взгляде, выражающем страх"
                            },
                            {
                                "target_lang_word": "измученный",
                                "target_lang_sense_clarification": "об усталом, страдальческом виде"
                            },
                            {
                                "target_lang_word": "обеспокоенный",
                                "target_lang_sense_clarification": "выражающий тревогу"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyděšený",
                                "target_lang_sense_clarification": "o pohledu vyjadřujícím strach"
                            },
                            {
                                "target_lang_word": "zmučený",
                                "target_lang_sense_clarification": "o unaveném, trpícím výrazu tváře"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d45d7c5-adfe-315d-943d-be20152ab327",
                    "sense_definition": "Simple past and past participle of <w>haunt</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The melody <w>haunted</w> him for days after the concert.",
                            "target_lang_translations": {
                                "ru": "Мелодия <w>преследовала</w> его несколько дней после концерта.",
                                "cs": "Ta melodie ho <w>pronásledovala</w> ještě několik dní po koncertě."
                            }
                        },
                        {
                            "text": "Local legends say a spirit has <w>haunted</w> this forest for centuries.",
                            "target_lang_translations": {
                                "ru": "Местные легенды гласят, что дух <w>обитал</w> в этом лесу столетиями.",
                                "cs": "Místní legendy praví, že v tomto lese po staletí <w>strašil</w> duch."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола haunt (преследовать, являться).",
                        "cs": "Minulý čas a příčestí minulé od slovesa haunt (pronásledovat, strašit)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследовал",
                                "target_lang_sense_clarification": "не давал покоя (о мыслях, мелодии)"
                            },
                            {
                                "target_lang_word": "обитал",
                                "target_lang_sense_clarification": "водился (о призраке)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pronásledoval",
                                "target_lang_sense_clarification": "nedával pokoj (o myšlenkách, melodii)"
                            },
                            {
                                "target_lang_word": "strašil",
                                "target_lang_sense_clarification": "objevoval se jako duch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}