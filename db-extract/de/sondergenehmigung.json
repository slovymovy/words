                "senses": [
                    {
                        "sense_id": "066bb2d8-14a6-3e84-9d22-a32e6f9b1227",
                        "entry_id": "d6bc59dd-f49c-30da-967e-b4619d05a789",
                        "glosses": [
                            "einem besonderen Zweck dienende Genehmigung, die im Ausnahmefall erteilt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68dbee8b-6b01-4a5d-bb79-9098052e9215",
                                "sense_id": "066bb2d8-14a6-3e84-9d22-a32e6f9b1227",
                                "text": "„Die höchste Station liegt auf gut 3500 Metern. Wer ganz nach oben will, braucht eine Sondergenehmigung, die er vorher bei der Nationalparkverwaltung beantragen muss.“"
                            },
                            {
                                "example_id": "61e3082e-a199-4fbf-bd82-06217ab22f1a",
                                "sense_id": "066bb2d8-14a6-3e84-9d22-a32e6f9b1227",
                                "text": "„Er hielt dabei ein Papier hoch, eine Art Sondergenehmigung, ein ärztliches Attest, das bescheinigte, dass deine Mutter heiratsfähig war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
