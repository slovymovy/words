                                        "examples": [
                                            {
                                                "example_id": "e39d50d3-c9bf-4cbe-9560-d5c579b54839",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "In letzter Zeit litt er sehr stark an seinen Gebrechen."
                                            },
                                            {
                                                "example_id": "8b70d098-1bae-42d1-b2f2-c1fd06e6a0aa",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„Zunehmende Gebrechen und der Kummer um ihren Sohn hatten Charlene ihres Witzes und ihrer lebhaften Art beraubt, und dieselben zwei Dämonen hatten ihren Vater zu einem verbitterten Mann gemacht.“"
                                            },
                                            {
                                                "example_id": "890f1063-530d-4da2-bc5f-8b5020c5eccd",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„In den Jahren, in denen sich die Gebrechen des Alters zu zeigen begannen, versuchte Hjartward, noch vor seinem Hinscheiden Vergebung zu erlangen.“"
                                            },
                                            {
                                                "example_id": "9e6c6dc3-11c4-496c-8692-97a957c0ce52",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„Mein Vater war zeit seines Lebens ein Hypochonder, der täglich ein anderes Gebrechen hatte, einen neuen Schmerz verspürte.“"
                                            },
                                            {
                                                "example_id": "5c027fda-9f4a-4277-bb8a-acf22fa0fc86",
                                                "sense_id": "1e429f94-c55f-32d7-8081-926bd7a12c37",
                                                "text": "„Insbesondere dort, wo es um Situationskomik geht, machen Schwank und Lustspiel von Gebrechen reichen Gebrauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                        "entry_id": "55074267-9949-3cf1-b5c0-364b3fc0f664",
                                        "glosses": [
                                            "Beschädigung, technische Störung"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1723b85c-48bf-4aaf-9f83-766f81e4a5f3",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "Das Gebrechen an der Wasserleitung wurde binnen einer Stunde repariert."
                                            },
                                            {
                                                "example_id": "6ec49349-fa96-4bb3-8dba-a04185d5bee4",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Technische Gebrechen am Flugzeug sind nicht bekannt.“"
                                            },
                                            {
                                                "example_id": "390b14f4-5a3d-40a3-9fa5-bee534c712ff",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Wahrscheinliche Unfallursachen seien ein technisches Gebrechen durch Blockierung der Steuerung durch eine Schraube, durch Blockierung zufolge eines nicht ordnungsgemäß verwahrten Fotoapparats sowie ein Flugfehler des Piloten der abgestürzten Maschine.“"
                                            },
                                            {
                                                "example_id": "072e9658-c21d-406b-9472-9d5233913b4e",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Verspäteter Abflug: Fluglinie haftet bei technischem Gebrechen“"
                                            },
                                            {
                                                "example_id": "9103c4b2-1ec7-4511-9d91-73fc9a4a6c60",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Dies könne nur darin seinen Grund haben, dass die Zustellung aufgrund technischer Gebrechen nicht möglich gewesen sei.“"
                                            },
                                            {
                                                "example_id": "5302b479-fb62-4258-96e9-06f2f64a0241",
                                                "sense_id": "006f2b72-24d8-3cb9-9fa6-2df98fd028a1",
                                                "text": "„Die Liste umfasst eine Einschränkung der technischen Probleme, Vogelschlag, die unvorhergesehene Schließung des Luftraums und unvorhergesehene Streiks. »Technisches Gebrechen« als (kostenlose) Erklärung für Verspätungen werden nicht mehr reichen: Sie sollen nur noch in Einzelfällen als »Ausrede« für die Fluglinien gelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e63208f-750f-4fc9-8a8e-e0cbee847a46",
