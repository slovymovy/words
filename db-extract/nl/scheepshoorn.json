                                "example_id": "7ecdae43-cf2c-433d-850c-3d56b1e37192",
                                "sense_id": "9e85eccf-17ec-33b9-b482-800cd7bd28fb",
                                "text": "Je kon voelen dat de zomer voor de deur stond en toen de scheepshoorn klonk en het schip zich losmaakte van de kade, kwam er net een ober langs en kon ik een biertje bestellen."
                            },
