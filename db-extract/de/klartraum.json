                                        "entry_id": "cef6cf9c-4193-34dd-9889-3d1804052a5d",
                                        "glosses": [
                                            "To experience a lucid dream."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
