                "entry_id": "46717ab3-b821-33e3-84e0-a3d213e71c3b",
                "word": "gagneuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "409503eb-8487-41bf-8137-8578073e13a9",
                        "entry_id": "46717ab3-b821-33e3-84e0-a3d213e71c3b",
                        "tags": [
