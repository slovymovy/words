                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45d3f1c1-033e-40c3-8142-a72c0108aa11",
                                                "sense_id": "9937a779-131c-399c-bdb3-425e48508bbe",
                                                "text": "Tak sakra, vzmuž se trochu - buď chlap a ne baba!"
                                            },
                                            {
                                                "example_id": "e5e3a9a2-5c7f-49c8-9f4b-b20991b190b6",
                                                "sense_id": "9937a779-131c-399c-bdb3-425e48508bbe",
                                                "text": "Mezitím dostavil se také ženich, který ukázal se být babou. Prohlásil, že se bojí morčat, a nedal se pohnout, aby je vecpal prokousaným otvorem do pohovky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6af9b25c-990e-3c0f-8078-ec8e89a1ed7c",
                                        "entry_id": "47be5158-a53d-3e8e-8edb-f431517f61ef",
                                        "glosses": [
