                {
                    "sense_id": "1a77f546-e46a-3a47-ab4d-785f8cffa3b3",
                    "sense_definition": "État d'une personne qui hésite ou qui doute sur ce qu'elle doit penser ou faire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "doute_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est restée plusieurs jours dans l'<w>incertitude</w> avant de recevoir une réponse définitive."
                        },
                        {
                            "text": "L'<w>incertitude</w> concernant son avenir professionnel lui causait beaucoup de stress au quotidien."
                        }
                    ],
                    "antonyms": [
