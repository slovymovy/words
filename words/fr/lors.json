                    "sense_definition": "À ce moment-là, à cette époque-là ; s'emploie principalement dans des locutions temporelles comme « lors de », « dès lors » ou « depuis lors ».",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a pris la parole <w>lors</w> de la conférence de presse."
                        },
                        {
                            "text": "Il n'avait plus donné de nouvelles depuis <w>lors</w>."
                        }
                    ],
                    "common_phrases": [
