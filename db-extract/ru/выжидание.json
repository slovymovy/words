                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expectative",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50436dd4-86dd-3eb6-9d0c-35bc51159b92",
                                        "entry_id": "26cc6ae5-c6df-398f-9ae4-fcea3c56228f",
                                        "glosses": [
                                            "Attente fondée sur quelque promesse ou espérance, sur des probabilités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f87eeb-5ce6-4885-8aad-99bf4049a557",
                                                "sense_id": "50436dd4-86dd-3eb6-9d0c-35bc51159b92",
                                                "text": "Mademoiselle Donis a sa fortune, moi j’ai mon nom et ma position : c’est un échange.\n— Quelle position ?\n— Celle que j’aurai et qui est d’autant plus belle qu’elle n’existe qu’en expectative."
                                            },
                                            {
                                                "example_id": "e172d04e-5c5f-4435-8df3-abfab1580858",
                                                "sense_id": "50436dd4-86dd-3eb6-9d0c-35bc51159b92",
                                                "text": "La clientèle étant réfractère à ces prix, supérieurs de 50 % à ceux qui se pratiquaient au début du mois de septembre, les acheteurs restent dans l’expectative et ne passent leurs ordres que par petits paquets et au jour le jour."
                                            },
                                            {
                                                "example_id": "16246f18-6327-4611-a3de-73ec8b3b5520",
                                                "sense_id": "50436dd4-86dd-3eb6-9d0c-35bc51159b92",
                                                "text": "Il n’a encore rien obtenu, mais il est toujours dans l’expectative."
                                            },
                                            {
                                                "example_id": "170b3b5f-a724-4767-b7ed-b3e80c7ab3d1",
                                                "sense_id": "50436dd4-86dd-3eb6-9d0c-35bc51159b92",
                                                "text": "Belle expectative !"
                                            }
                                        ]
                                    }
                                ]
                            },
