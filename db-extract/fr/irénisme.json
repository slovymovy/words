                ],
                "senses": [
                    {
                        "sense_id": "17570d29-9d2e-3147-9889-7de92cd8a6a7",
                        "entry_id": "9e5432da-1dca-39bf-8078-89d9b3d7e6c2",
                        "glosses": [
                            "Recherche de la paix et de la concorde."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d076c480-816f-31bd-bb89-746fc40e4775",
                        "entry_id": "9e5432da-1dca-39bf-8078-89d9b3d7e6c2",
                        "glosses": [
                            "Recherche de la paix et de la concorde.",
                            "Attitude visant à favoriser la bonne entente entre les religions. Le mot s'est d'abord employé dans un contexte chrétien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "233adb24-919b-4ab7-af6e-40b60fd60c6a",
                                "sense_id": "d076c480-816f-31bd-bb89-746fc40e4775",
                                "text": "La catéchèse aura une dimension œcuménique si […] elle inspire des efforts sérieux […] non pas en vue d’un irénisme facile fait d’omissions et de concessions au plan doctrinal, mais en vue de l’unité parfaite […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b7b99f2c-9e73-3082-853b-7ec90d7cd026",
                        "entry_id": "9e5432da-1dca-39bf-8078-89d9b3d7e6c2",
                        "glosses": [
                            "Recherche de la paix et de la concorde.",
                            "Attitude de celui qui fait de la concorde l’objectif politique premier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcc26a7f-0a9e-40ef-84be-31fbc1146643",
                                "sense_id": "b7b99f2c-9e73-3082-853b-7ec90d7cd026",
                                "text": "L’irénisme est une représentation de la politique comme une activité qui serait appelée à se déployer dans un espace lisse, sans aspérité, sans clivage ni conflit, orientée vers une intersubjectivité pacifique et sans problème."
                            },
                            {
                                "example_id": "ea1de81d-3161-49a8-a769-df22d94b723e",
                                "sense_id": "b7b99f2c-9e73-3082-853b-7ec90d7cd026",
                                "text": "En matière d’immigration, l’irénisme humanitaire me semble aussi dangereux que l’égoïsme nationaliste, le culte du sang et du sol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd55299f-d024-4e28-b191-3397fdd8662c",
                        "source_entry_id": "9e5432da-1dca-39bf-8078-89d9b3d7e6c2",
                        "target_lang_word": "irenicism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irenicism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeacd7e1-f645-3b08-935c-e25f0713b06d",
                                        "entry_id": "59e40722-e300-3bd4-988c-f705ec3b7b25",
                                        "glosses": [
                                            "Behaviour or belief that tends to resolve disputes between denominations or religions; irenical theology; conciliation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecfad90a-89e3-4a8e-9e48-19a307ac41ad",
                                                "sense_id": "eeacd7e1-f645-3b08-935c-e25f0713b06d",
                                                "text": "A striking feature of this volume is the pronounced irenicism of the Americans, Lindbeck of Yale and Quanbeck of the Luther Theological Seminary at St. Paul, in contrast to the unsparingly critical approach of the Europeans."
                                            },
                                            {
                                                "example_id": "4c17ed3d-95aa-4d5a-b4b3-38b150ab0ec9",
                                                "sense_id": "eeacd7e1-f645-3b08-935c-e25f0713b06d",
                                                "text": "The elector Palatine, as self-appointed Calvinist leader, promoted his own, narrow form of irenicism to remain within the Peace by finding common ground with Lutherans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
