                ],
                "senses": [
                    {
                        "sense_id": "14a8fa12-d883-344a-beb0-37a82f49811d",
                        "entry_id": "dc052778-ba3f-3108-a8a4-59a5fbfcb7bc",
                        "glosses": [
                            "Haltestation eines Verkehrsmittels zwischen Abfahrt- und Endstation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f1e916-0ce5-4be0-9934-da68aa63488c",
                                "sense_id": "14a8fa12-d883-344a-beb0-37a82f49811d",
                                "text": "Wir steigen an der Zwischenstation aus und gehen den Rest zu Fuß."
                            },
                            {
                                "example_id": "bffc86cd-5122-4b6c-be08-1fc3f58bb14f",
                                "sense_id": "14a8fa12-d883-344a-beb0-37a82f49811d",
                                "text": "„Als Zwischenstation auf dem Weg nach Indien hatte es einen neuen Namen erhalten: Das Kap der guten Hoffnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0cd68c89-aa4f-37d4-a31e-82565fd3f927",
                        "entry_id": "dc052778-ba3f-3108-a8a4-59a5fbfcb7bc",
                        "glosses": [
                            "Stelle zwischen Anfang und Ende von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81519f58-308b-40f3-bbc5-fc9a07c30214",
                                "sense_id": "0cd68c89-aa4f-37d4-a31e-82565fd3f927",
                                "text": "Diese Prüfung ist nur eine Zwischenstation in der langen Ausbildung."
                            },
                            {
                                "example_id": "249e0d4f-300d-4e67-82e8-916e844abdf8",
                                "sense_id": "0cd68c89-aa4f-37d4-a31e-82565fd3f927",
                                "text": "„Wichtige Zwischenstation und Versorgungspunkt war das Lager Hedemünden an einer Furt der Werra.“"
                            },
                            {
                                "example_id": "df05a7cb-b32c-42c2-bcf8-8d66b999dc78",
                                "sense_id": "0cd68c89-aa4f-37d4-a31e-82565fd3f927",
                                "text": "„Meine Freunde im Hamburg, bei denen ich eine Zwischenstation einlege, geben mir etwas Wertvolles mit: eine Adresse.“"
                            },
                            {
                                "example_id": "e52265de-9e19-4fa8-a232-5b45bd19d78f",
                                "sense_id": "0cd68c89-aa4f-37d4-a31e-82565fd3f927",
                                "text": "„In den letzten Kriegstagen diente es als letzte Zwischenstation für alle Frauen vor der Ermordung in den Gaskammern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
