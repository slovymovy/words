                        "glosses": [
                            "A hot desert wind in an Arabic country, especially in North Africa."
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5494ac10-e122-4019-a076-91e3a20a1110",
                                "sense_id": "0e577cf9-0c0e-33f4-aa25-564d5691c9da",
                                "text": "Then suddenly, with the least warning, the sky yellows and the Chergui blows in from the Sahara, stinging the eyes and choking with its sandy, sticky breath."
                            },
                            {
                                "example_id": "83a0089b-5d9d-4a16-87f9-c84a444fc5c8",
                                "sense_id": "0e577cf9-0c0e-33f4-aa25-564d5691c9da",
                                "text": "The Ghibli is a hot wind in Libya, usually blowing from the Sahara; this wind in Morocco is called the Chergui."
                            },
                            {
                                "example_id": "b3ce7c34-a780-4221-82c4-71a9a6863f8c",
                                "sense_id": "0e577cf9-0c0e-33f4-aa25-564d5691c9da",
                                "text": "The sharqi is a wind from the south and southeast that blows in early summer and early winter."
                            },
                            {
                                "example_id": "c4f56238-fd40-405e-b8e4-b23d5563147d",
                                "sense_id": "0e577cf9-0c0e-33f4-aa25-564d5691c9da",
                                "text": "The harmattan, which is also called sharqi in Morocco, is a hot wind that blows out of the interior of the Sahara."
                            }
                        ]
                    }
