                        "sense_id": "9173d0f9-ae17-30aa-8428-8033bb376a7a",
                        "entry_id": "c6df546f-a965-3ab8-ac73-216b5ff81a8a",
                        "glosses": [
                            "hevig, scherp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d181cf2f-93dc-492d-8759-ac08b842cfaf",
                                "sense_id": "9173d0f9-ae17-30aa-8428-8033bb376a7a",
                                "text": "Dat zonlicht is fel."
                            },
                            {
                                "example_id": "a0bf2625-7a5a-43ca-8b03-d2bb943f8c12",
                                "sense_id": "9173d0f9-ae17-30aa-8428-8033bb376a7a",
                                "text": "Hij deed een felle uitval."
                            },
                            {
                                "example_id": "60e947ac-4562-489e-9ad1-02984b369846",
                                "sense_id": "9173d0f9-ae17-30aa-8428-8033bb376a7a",
                                "text": "Door een klein raam werden we steeds fel verlicht door de bliksem."
                            },
                            {
                                "example_id": "d5050eae-64b7-4d60-804d-ffd580d51adc",
                                "sense_id": "9173d0f9-ae17-30aa-8428-8033bb376a7a",
                                "text": "Buikhuisen kwam eind jaren 70 in opspraak nadat hij had aangekondigd onderzoek te willen doen naar de rol die erfelijkheid speelt bij crimineel gedrag. Buikhuisen was op dat moment werkzaam als hoogleraar criminologie aan de Universiteit van Leiden. Zowel in het maatschappelijk debat als onder zijn collega's kregen zijn onderzoeksvoorstellen felle kritiek."
                            }
                        ]
                    }
                ],
                "translations": [
