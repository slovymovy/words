            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "04d7c71e-bbe5-340e-af56-18a90cee3f66",
                    "sense_definition": "In a way that happens by itself, without human control or attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sliding doors at the entrance open <w>automatically</w> when you approach them.",
                            "target_lang_translations": {
                                "ru": "Раздвижные двери на входе открываются <w>автоматически</w>, когда вы к ним подходите.",
                                "zh": "入口处的感应门在你靠近时会<w>自动</w>打开。"
                            }
                        },
                        {
                            "text": "My computer saves the document <w>automatically</w> every few minutes, so I never lose my work.",
                            "target_lang_translations": {
                                "ru": "Мой компьютер сохраняет документ <w>автоматически</w> каждые несколько минут, поэтому я никогда не теряю результаты своей работы.",
                                "zh": "我的电脑每隔几分钟就会<w>自动</w>保存文档，所以我从不会丢失工作成果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mechanically",
                        "on its own"
                    ],
                    "antonyms": [
                        "manually"
                    ],
                    "common_phrases": [
                        "automatically generated",
                        "automatically switch",
                        "save automatically"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, происходящее само по себе, без контроля или внимания со стороны человека.",
                        "zh": "指某事自行发生，无需人工控制或干预。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автоматически",
                                "target_lang_sense_clarification": "без участия человека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自动",
