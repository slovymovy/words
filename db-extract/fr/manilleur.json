                        "glosses": [
                            "Joueur de manille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab29320a-46b9-46a1-8e2b-eae89f7e0a29",
                                "sense_id": "41984d36-f514-3672-b715-52397549b5b1",
                                "text": "Je doute fort que les vélocipédistes ou les manilleurs actuels se déterminassent aussi volontiers que leurs pères aux aventures dangereuses, aux fredaines parfois héroïques dont la guerre franco-prussienne offrit l’occasion."
                            },
                            {
                                "example_id": "3d72ec57-1a8f-4ccc-aa5b-0c5a39a623c7",
                                "sense_id": "41984d36-f514-3672-b715-52397549b5b1",
                                "text": "Parfois, il se dérangeait pour s’approcher du billard admirer des carambolages savants ou pour aller regarder le jeu d’un manilleur par-dessus son épaule."
                            },
                            {
                                "example_id": "d12f834f-164e-4b68-86c2-6179fd1b051b",
                                "sense_id": "41984d36-f514-3672-b715-52397549b5b1",
                                "text": "Au nom de Jean, les quatre manilleurs avaient relevé la tête."
                            },
                            {
                                "example_id": "a89e7b0a-af47-444b-8036-a31f1bd6f7e0",
                                "sense_id": "41984d36-f514-3672-b715-52397549b5b1",
                                "text": "Ah vous eussiez mieux fait de rester ailleurs\nQue d’entrer dans ce café plein de manilleurs."
                            }
                        ]
                    }
