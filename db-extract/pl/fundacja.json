                "senses": [
                    {
                        "sense_id": "199a4eab-3153-3b8b-a287-e90101167f32",
                        "entry_id": "a3bebba9-6be3-32bd-b08a-8f165d4fd3f1",
                        "glosses": [
                            "organizacja zbierająca pieniądze na cel dobroczynny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c355af47-11c5-4f03-8fc1-8ad803748aaf",
                                "sense_id": "199a4eab-3153-3b8b-a287-e90101167f32",
                                "text": "Jestem wolontariuszem miejscowej fundacji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "85dc755a-8901-37be-92ab-62897455ab95",
                        "entry_id": "a3bebba9-6be3-32bd-b08a-8f165d4fd3f1",
                        "glosses": [
                            "ufundowanie, sfinansowanie, zbudowanie czegoś z własnych funduszy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "977910de-e370-49f3-894f-f9b51078625d",
                                "sense_id": "85dc755a-8901-37be-92ab-62897455ab95",
                                "text": "Król Kazimierz Wielki dokonał fundacji Akademii Krakowskiej, pierwszego polskiego uniwersytetu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed091d83-be69-4d4f-b767-1ad8c0030bf4",
                        "source_entry_id": "a3bebba9-6be3-32bd-b08a-8f165d4fd3f1",
                        "source_sense_id": "199a4eab-3153-3b8b-a287-e90101167f32",
                        "target_lang_word": "foundation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foundation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1619aa1d-dbfe-36ac-b146-df30c110e495",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "The act of founding, fixing, establishing, or beginning to erect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccef7acf-58c7-4c83-8868-8bda12958556",
                                                "sense_id": "1619aa1d-dbfe-36ac-b146-df30c110e495",
                                                "text": "The foundation of his institute has been wrought with difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ac5330-2f75-31f3-b6f5-e98cc304914f",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "That upon which anything is founded; that on which anything stands, and by which it is supported; the lowest and supporting layer of a superstructure; underbuilding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "131534d6-e06a-4eaa-9d2e-11c808c2bfe1",
                                                "sense_id": "62ac5330-2f75-31f3-b6f5-e98cc304914f",
                                                "text": "Aye Madam to be sure that is the Provoking circumstance—without Foundation—yes yes—there's the mortification indeed—for when a slanderous story is believed against one—there certainly is no comfort like the consciousness of having deserved it——"
                                            },
                                            {
                                                "example_id": "5a4f4960-388e-4681-8d46-efc182e63452",
                                                "sense_id": "62ac5330-2f75-31f3-b6f5-e98cc304914f",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2efd1c67-bb6e-3210-b6e9-e0b93bd2bc47",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "The result of the work to begin something; that which stabilizes and allows an enterprise or system to develop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de60f664-8c73-4364-aecb-f795ec5c7ba3",
                                                "sense_id": "2efd1c67-bb6e-3210-b6e9-e0b93bd2bc47",
                                                "text": "The implication is that the Gandhian model of growth is possible, now that Nehru's investment strategy had already laid a strong foundation for economic growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d26246-4782-35c1-8936-c83d196d2b8d",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "In solitaire or patience games, one of the piles of cards that the player attempts to build, usually holding all cards of a suit in ascending order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c425e987-0e17-3756-a79f-573c5375fd96",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "The lowest and supporting part or member of a wall, including the base course and footing courses; in a frame house, the whole substructure of masonry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cf5cc1d-c052-4b2c-9849-72675b743e53",
                                                "sense_id": "c425e987-0e17-3756-a79f-573c5375fd96",
                                                "text": "The foundations of this construction have been laid out."
                                            },
                                            {
                                                "example_id": "51f8baa7-80e2-46fd-9f19-56a3e3bd63b1",
                                                "sense_id": "c425e987-0e17-3756-a79f-573c5375fd96",
                                                "text": "“Marge Gets A Job” opens with the foundation of the Simpson house tilting perilously to one side, making the family homestead look like the suburban equivalent of the Leaning Tower Of Pisa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b8ef2f-d651-3997-863b-7e6c06ebaca9",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "A donation or legacy appropriated to support a charitable institution, and constituting a permanent fund; endowment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "786f6016-6161-3d13-ae93-426d73818e12",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "That which is founded, or established by endowment; an endowed institution or charity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd5cb14-9f90-4a67-9b39-0dcb093faeb8",
                                                "sense_id": "786f6016-6161-3d13-ae93-426d73818e12",
                                                "text": "The Wikimedia Foundation, Inc. is the parent organization of the Wiktionary collaborative project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0acfb244-6163-32f5-80c7-baeaee615ecf",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "Cosmetic cream roughly skin-colored, designed to make the face appear uniform in color and texture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21e0d107-44f2-336a-8d69-98eecb1caa0b",
                                        "entry_id": "5ec2541d-e6dc-3497-ba16-b1a515a0af56",
                                        "glosses": [
                                            "A basis for social bodies or intellectual disciplines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "111a1016-f27c-41f0-84b6-923064481e60",
                                                "sense_id": "21e0d107-44f2-336a-8d69-98eecb1caa0b",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too.[…]But as a foundation for analysis it is highly subjective: it rests on difficult decisions about what counts as a territory, what counts as output and how to value it. Indeed, economists are still tweaking it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "998f7530-32a7-4af6-a7c1-25442ff5eebc",
                        "source_entry_id": "a3bebba9-6be3-32bd-b08a-8f165d4fd3f1",
                        "source_sense_id": "199a4eab-3153-3b8b-a287-e90101167f32",
                        "target_lang_word": "fondation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1501a083-77fe-3973-b2c9-212eccdc829a",
                                        "entry_id": "beedd900-3dbe-3d94-8c64-09aac0d723ed",
                                        "glosses": [
                                            "Action de fonder, de bâtir la base de quelque chose ; commencement de quelque chose de durable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8533c47-df80-4429-b6c9-dbe7114bc423",
                                                "sense_id": "1501a083-77fe-3973-b2c9-212eccdc829a",
                                                "text": "Jamais, je le crois bien, on ne vit, dans la fondation d’un nouvel ordre, tant de tribulations et d’entraves, tant de malchance."
                                            },
                                            {
                                                "example_id": "51c261be-0468-4ff5-9f51-d2cc2742d748",
                                                "sense_id": "1501a083-77fe-3973-b2c9-212eccdc829a",
                                                "text": "Militant du mouvement socialiste naissant, Camélinat adhère, dès sa fondation, à l’Association internationale des travailleurs (AIT) ; il sera d’ailleurs délégué aux premiers congrès de cette Internationale portée sur les fonts baptismaux par Karl Marx."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9418d872-d217-3351-8f51-68a0f5ca14cd",
                                        "entry_id": "beedd900-3dbe-3d94-8c64-09aac0d723ed",
                                        "glosses": [
                                            "Travail que l’on fait pour asseoir les fondements d’un édifice, d’une construction."
                                        ],
                                        "tags": [
                                            "Génie civil",
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "629debe5-b99a-4c77-876e-1a55c23262eb",
                                                "sense_id": "9418d872-d217-3351-8f51-68a0f5ca14cd",
                                                "text": "Commencer les fondations d’un bâtiment."
                                            },
                                            {
                                                "example_id": "6e2e1c84-3888-4b37-a2b2-17875922b143",
                                                "sense_id": "9418d872-d217-3351-8f51-68a0f5ca14cd",
                                                "text": "Les fondations ne sont pas encore achevées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe9516fc-8b45-3735-b4b3-5de80c2dc1b1",
                                        "entry_id": "beedd900-3dbe-3d94-8c64-09aac0d723ed",
                                        "glosses": [
                                            "Fondement, base d'une construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9789de3e-9186-4670-97ae-29df04c9df81",
                                                "sense_id": "fe9516fc-8b45-3735-b4b3-5de80c2dc1b1",
                                                "text": "Pour faire une bonne fondation dans un terrain marécageux, il faut asseoir les fondements sur des pilotis."
                                            },
                                            {
                                                "example_id": "eedcb746-ab8d-48a3-a812-3b812f313830",
                                                "sense_id": "fe9516fc-8b45-3735-b4b3-5de80c2dc1b1",
                                                "text": "On travaille encore aux fondations."
                                            },
                                            {
                                                "example_id": "d3045fb5-855f-4f0a-b00d-9201f8736301",
                                                "sense_id": "fe9516fc-8b45-3735-b4b3-5de80c2dc1b1",
                                                "text": "Ce bâtiment a quatre mètres de fondation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3658bd8-9d70-3f9b-89bf-30059823db96",
                                        "entry_id": "beedd900-3dbe-3d94-8c64-09aac0d723ed",
                                        "glosses": [
                                            "Fossé, tranchée que l’on fait pour y placer les fondements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72503075-3f87-48a3-9c78-8e0fbff0f55f",
                                                "sense_id": "c3658bd8-9d70-3f9b-89bf-30059823db96",
                                                "text": "Creuser les fondations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5953cc-0250-36f7-889a-f8a28c42ad8b",
                                        "entry_id": "beedd900-3dbe-3d94-8c64-09aac0d723ed",
                                        "glosses": [
                                            "Masse de biens affectée pour réaliser une œuvre d’intérêt général à but non lucratif (de piété, caritatif, artistique, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2be219-749e-446a-81a8-d7d6fabe1a86",
                                                "sense_id": "3d5953cc-0250-36f7-889a-f8a28c42ad8b",
                                                "text": "Nous en trouvons un exemple dans la fondation qu'il fit, le 6 août 1644, à l’église Saint-Martin, d'un service à l’intention de son patron, saint Richard, service suivi, à l'issue des vêpres, de la bénédiction du Saint-Sacrement."
                                            },
                                            {
                                                "example_id": "37329018-84dd-4970-9a3b-2ec6f00f6116",
                                                "sense_id": "3d5953cc-0250-36f7-889a-f8a28c42ad8b",
                                                "text": "Située sur la commune de Saint-Martin-sur-Oreuse, la commanderie de Launay, la plus ancienne fondation de l’Ordre de l’Hôpital dans l’Yonne, administre, à partir du XVᵉ siècle et jusqu’en 1789, la plupart des maisons hospitalières du Sénonais et du Jovignien."
                                            },
                                            {
                                                "example_id": "a484066c-d3c2-41dd-8058-4f1629b8886b",
                                                "sense_id": "3d5953cc-0250-36f7-889a-f8a28c42ad8b",
                                                "text": "En 1996, la productrice française Sophie Goupil choisit de coproduire La Cinquième Saison, première coproduction franco-iranienne de long métrage, avec une institution publique, la fondation Fârâbi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc901022-59b2-3b87-9dff-c73b17aa6620",
                                        "entry_id": "beedd900-3dbe-3d94-8c64-09aac0d723ed",
                                        "glosses": [
                                            "Base, fondement, usage traditionnel, une règle qui perdure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed818dc2-5165-431d-a530-c2180d9e2212",
                                                "sense_id": "bc901022-59b2-3b87-9dff-c73b17aa6620",
                                                "text": "Dans toute assemblée dont les membres ont plus de 18 ans et moins de 25, la politique est une invitée de fondation : elle ne manque jamais au rendez-vous, inspire des harangues et fait éclore des Démosthènes. Elle est aussi nécessaire que les vins de France pour réchauffer l’enthousiasme d'un banquet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
