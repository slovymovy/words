                ],
                "senses": [
                    {
                        "sense_id": "282bfb21-5f48-3a5a-81af-99ada026142c",
                        "entry_id": "a4fd398a-2f4a-3d15-b117-dd5b99c58631",
                        "glosses": [
                            "erneute, andersartige Analyse (einer Sprachstruktur, von Daten…)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79dd8cba-bb6d-472d-96d7-cb48a63b33f1",
                                "sense_id": "282bfb21-5f48-3a5a-81af-99ada026142c",
                                "text": "„Reanalyse wird in der generativen Grammatik für verschiedene diachrone und synchrone syntaktische Umstrukturierungsprozesse angenommen, beispielsweise für den Übergang syntaktischer Konstrukte in Wortbildungsprodukte oder bei der Beschreibung bestimmter Wortstellungsphänomene…“"
                            },
                            {
                                "example_id": "8a19ed8e-909b-4a37-8252-f048ac2300e7",
                                "sense_id": "282bfb21-5f48-3a5a-81af-99ada026142c",
                                "text": "Im Fachwörterbuch von Bußmann wird Reanalyse als „Umorganisation eines Strukturbaumes, bei der die terminalen Knoten gleich bleiben, die hierarchische Analyse der Konstruktion jedoch verändert wird“ definiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05f4eb04-b96b-3b22-889d-21b87941474c",
                        "entry_id": "a4fd398a-2f4a-3d15-b117-dd5b99c58631",
                        "glosses": [
                            "erneute Auswertung einer Studie, auf deren ursprünglicher Datenbasis"
                        ],
                        "tags": [
                            "empirische Forschung"
                        ],
                        "examples": [
                            {
                                "example_id": "a55da69c-19ad-4b7d-974f-480b2a866b8b",
                                "sense_id": "05f4eb04-b96b-3b22-889d-21b87941474c",
                                "text": "In der Wissenschaft werden Daten, die schon einmal behandelt wurden, oft einer Reanalyse unterzogen."
                            },
                            {
                                "example_id": "b4ba768c-4543-4e86-b4d9-cf2644a25029",
                                "sense_id": "05f4eb04-b96b-3b22-889d-21b87941474c",
                                "text": "„Während in einer Primärstudie versucht werde, in einem großen Fundus an empirischen Informationen ein allgemeines Erklärungsmuster zu finden, werde in der Reanalyse das durch die Primärstudie vorliegende Erklärungsmuster kritisch geprüft, indem das Datenmaterial nach empirischen Belegen für oder gegen das Muster gesucht wird.“"
                            },
                            {
                                "example_id": "1860587a-2432-4e31-95fc-690806427a97",
                                "sense_id": "05f4eb04-b96b-3b22-889d-21b87941474c",
                                "text": "„Zum Abschluss der Reanalyse wurde entsprechend versucht, innerhalb dieser empirischen Vielfalt der Fälle mit einem Verfahren der Gruppenbildung auf die wesentlichen Differenzierungsmerkmale zu fokussieren.“"
                            },
                            {
                                "example_id": "34d1d58f-4ef3-4bbf-9c9b-1c90749f3428",
                                "sense_id": "05f4eb04-b96b-3b22-889d-21b87941474c",
                                "text": "„Ebenso kann die Chance, neue, erfolgreich anwendbare Theorieelemente zu generieren, auch durch die umfassende, sorgfältige und kritische Analyse und Reanalyse der Ergebnisse vorliegender empirischer Untersuchungen erhöht werden.“"
                            },
                            {
                                "example_id": "a783f259-6507-4038-9301-a93333903564",
                                "sense_id": "05f4eb04-b96b-3b22-889d-21b87941474c",
                                "text": "„Daly (1996) berichtet über eine Reanalyse von in den 1980er Jahren erhoben Daten zu zwei Kohorten von Zehntklässler(inne)n, die in monoedukativen und koedukativen Schulen unterrichtet wurden.“"
                            },
                            {
                                "example_id": "8849b3c0-be16-4fcb-96a2-b26ed46eae51",
                                "sense_id": "05f4eb04-b96b-3b22-889d-21b87941474c",
                                "text": "„Diese empirischen Ergebnisse werden basierend auf den Erkenntnissen der Literaturrecherche sowie der Reanalyse zu Energievorstellungen von Schülerinnen und Schülern interpretiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
