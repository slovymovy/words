                            {
                                "example_id": "506754b2-b1cb-4a51-91e5-acc46275f19e",
                                "sense_id": "20ca7d1e-264d-316e-939e-761d26b5e8b0",
                                "text": "Les gicleurs d’arrosage automatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "35a5d9ed-525c-3fb0-9089-508202ae06ae",
                        "entry_id": "94f0f941-6828-337c-ad69-389c071c1cf7",
                        "glosses": [
                            "Pièce du carburateur apportant le carburant dans une chambre de dépression permettant le mélange air et carburant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959d316b-beea-40f8-b75c-bea693fed745",
                                "sense_id": "35a5d9ed-525c-3fb0-9089-508202ae06ae",
                                "text": "L’essence nécessaire est alors fournie par le gicleur de ralenti, tandis qu’une vis de réglage assure le débit d’air nécessaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a883291-57aa-3bd9-93a0-a7781fd5f8b4",
                        "entry_id": "94f0f941-6828-337c-ad69-389c071c1cf7",
                        "glosses": [
                            "Dispositif anti-incendie, servant à diffuser de l’eau sur la partie à protéger."
