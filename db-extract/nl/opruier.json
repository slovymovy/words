                "senses": [
                    {
                        "sense_id": "9731fa33-3d83-3735-96d6-8690a0fff05f",
                        "entry_id": "cc4468cf-0354-380b-ad4d-67d53b5592db",
                        "glosses": [
                            "iemand die andere mensen aanzet tot het plegen van geweld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41b0963-2679-4e17-bce6-129425c9b05b",
                                "sense_id": "9731fa33-3d83-3735-96d6-8690a0fff05f",
                                "text": "Twee weken cel voor opruier Project X Arnhem: De 23-jarige man uit Arnhem die op Facebook opriep om auto's in brand te steken bij het geplande Project X feest in Arnhem op 28 september, is woensdag veroordeeld tot 2 weken cel, waarvan 1 week voorwaardelijk."
                            },
                            {
                                "example_id": "873df963-4374-4ca5-9108-2b2f15369337",
                                "sense_id": "9731fa33-3d83-3735-96d6-8690a0fff05f",
                                "text": "B. zat die avond te kaarten en te drinken in een woning aan de Sluitersveldsingel. Tussen jongeren werd over en weer gedreigd en geappt. Vader en zoon Woudstra werden door een vermeende opruier opgepikt bij De Blauwe Doffer, het honk van een duivenclub. Een opgewonden gezelschap toog naar de singel. Aan de deur liep het uit de hand."
                            },
                            {
                                "example_id": "38588c60-6048-4589-8b88-b8ccc5854295",
                                "sense_id": "9731fa33-3d83-3735-96d6-8690a0fff05f",
                                "text": "Je zou kunnen zeggen dat hij tenminste eerlijk zegt wat hij vindt en dat ze in Enschede niet zo moeten piepen. Maar dan nog: als je dit als onafhankelijke bestuurder roept op de dag van de derby, ben je als voorzitter van de RvC geen knip voor de neus waard. Dan ben je de opruier die zijn middelvinger voor het uitvak opsteekt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f74ae86c-f4ec-41be-ad6a-753b57106adc",
                        "source_entry_id": "cc4468cf-0354-380b-ad4d-67d53b5592db",
                        "source_sense_id": "9731fa33-3d83-3735-96d6-8690a0fff05f",
                        "target_lang_word": "agitator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agitator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                        "entry_id": "b055ae70-6d0c-31f3-8838-689a62157864",
                                        "glosses": [
                                            "One who agitates; one who stirs up or excites others, for example political reformers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ba9f0f-6ccc-4a2d-ae5f-4b3cdf322086",
                                                "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                                "text": "Near-synonyms: instigator; see also Thesaurus:troublemaker"
                                            },
                                            {
                                                "example_id": "6b0d17cd-9939-4b4b-b83b-2ef509bdc40a",
                                                "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                                "text": "In addition, they kept a watch on political agitators and foreigners arriving and departing at the port."
                                            },
                                            {
                                                "example_id": "26c37420-db73-49a6-a5a9-2466d58c8190",
                                                "sense_id": "6884140d-d4ed-3f01-ad2b-86bd35747aa0",
                                                "text": "I’m only aware of one anti-ICE raid incident in California over the summer in which a single agitator pointed a pistol at federal agents, and that person is apparently still at large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c99ca4-42a4-358a-90ec-9eb60321ea20",
                                        "entry_id": "b055ae70-6d0c-31f3-8838-689a62157864",
                                        "glosses": [
                                            "An implement for shaking or mixing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38d53122-57ac-3173-a1b8-4bc5663d848f",
                                        "entry_id": "b055ae70-6d0c-31f3-8838-689a62157864",
                                        "glosses": [
                                            "One of a body of men appointed by the army, in Oliver Cromwell's time, to look after their interests."
                                        ],
