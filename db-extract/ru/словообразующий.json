                "senses": [
                    {
                        "sense_id": "13a70afd-f17d-3525-afe9-12de06731805",
                        "entry_id": "231b589f-e6ca-3137-bc34-de27131fcf1b",
                        "glosses": [
                            "лингв. служащий для образования слов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3889bd1d-63fa-4136-95b0-aab0e7703479",
                                "sense_id": "13a70afd-f17d-3525-afe9-12de06731805",
                                "text": "С самых ранних лет дети понимают значимость суффиксов, приставок, утверждая своим словотворчеством их важную словообразующую роль."
                            },
                            {
                                "example_id": "de6732c3-0952-40e5-b66c-0e97506554b2",
                                "sense_id": "13a70afd-f17d-3525-afe9-12de06731805",
                                "text": "Иногда местные различия в названии одного и того же предмета обусловлены использованием разных словообразующих приставок и суффиксов."
                            }
                        ]
                    }
