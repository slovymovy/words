                    }
                ],
                "senses": [
                    {
                        "sense_id": "d120d44a-59a9-3e07-81d2-ba3a5ef2a3c1",
                        "entry_id": "16bedb1c-3e6d-3e13-8bf7-84cc46b960b6",
                        "glosses": [
                            "повиснуть, удерживаясь на чём-либо одним концом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8ddab5-8dc4-447c-8561-03ac3c2d1943",
                                "sense_id": "d120d44a-59a9-3e07-81d2-ba3a5ef2a3c1",
                                "text": "Кое-где по потолку свисла паутина, будто крылья летучих мышей."
                            }
                        ]
                    },
                    {
                        "sense_id": "329c93d4-7520-3920-9080-3e89b584c41c",
                        "entry_id": "16bedb1c-3e6d-3e13-8bf7-84cc46b960b6",
                        "glosses": [
                            "опуститься своей частью вниз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "241a26fc-b325-47ae-ae72-a88bbfd01374",
                                "sense_id": "329c93d4-7520-3920-9080-3e89b584c41c",
                                "text": "Кемский едва узнал его: он растолстел до неимоверности; широкий подбородок покоился на узеньком галстухе; красный нос свис на губы, безвласое чело лоснилось; ноги едва передвигались."
                            },
                            {
                                "example_id": "350c8826-255b-4396-a0a6-4c467d7da1bc",
                                "sense_id": "329c93d4-7520-3920-9080-3e89b584c41c",
                                "text": "Он стоял на коленях; голова его лежала на кресле; протянутые вперед руки бессильно свисли; бледное лицо дышало упоением безмерного счастия."
                            }
                        ]
                    }
                ],
