                "senses": [
                    {
                        "sense_id": "a85d860d-a357-3e88-a10f-8479a339393e",
                        "entry_id": "35b4c152-0d96-3f7d-9e7c-f72a1c84d0ba",
                        "glosses": [
                            "upstart, rogue, rascal"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a6b3e233-81ee-4304-80ee-1f80d630e6a5",
                                "sense_id": "a85d860d-a357-3e88-a10f-8479a339393e",
                                "text": "Один старик Прокофьич не любил его, с угрюмым видом подавал ему за столом кушанья, называл его «живодёром» и «прощелыгой» и уверял, что он с своими бакенбардами — настоящая свинья в кусте.",
                                "translation": "Only old Prokovich disliked him; at table he handed him dishes with a grim expression; he called him \"butcher\" and \"upstart\" and declared that with his huge whiskers he looked like a pig in a sty.",
                                "english": "Only old Prokovich disliked him; at table he handed him dishes with a grim expression; he called him \"butcher\" and \"upstart\" and declared that with his huge whiskers he looked like a pig in a sty."
                            }
                        ]
                    }
