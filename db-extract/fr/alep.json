                "forms": [],
                "senses": [
                    {
                        "sense_id": "80da3b17-0d85-3d5e-afaa-c1a08b137fef",
                        "entry_id": "46611290-3876-36af-99b2-8472f0f0eb94",
                        "glosses": [
                            "Ville du nord-ouest de la Syrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0814fb2-d907-4fe4-b144-7e651fe5b8f8",
                                "sense_id": "80da3b17-0d85-3d5e-afaa-c1a08b137fef",
                                "text": "Le QG de l’Armée syrienne libre dans le quartier de Hanano à Alep, a été pris pour cible vendredi par l’armée de Bachar Al Assad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "406e340f-ce67-4fa4-8ae3-2d9ce65e0852",
                        "source_entry_id": "46611290-3876-36af-99b2-8472f0f0eb94",
                        "source_sense_id": "80da3b17-0d85-3d5e-afaa-c1a08b137fef",
                        "target_lang_word": "Aleppo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aleppo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "969b4b60-a74b-33dd-95e5-b94de32a1c67",
                                        "entry_id": "7b38753b-c328-3774-802b-2741196fa0df",
                                        "glosses": [
                                            "zweitgrößte Stadt in Syrien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d90e743-7478-4dc6-8933-75285f8f0640",
                                                "sense_id": "969b4b60-a74b-33dd-95e5-b94de32a1c67",
                                                "text": "„Syriens Regierungstruppen konzentrieren sich den Angaben zufolge inzwischen darauf, die Kontrolle über Großstädte wie Damaskus und Aleppo zu behalten.“"
                                            },
                                            {
                                                "example_id": "c21db312-f105-4d98-9012-dc7dcdaecdbd",
                                                "sense_id": "969b4b60-a74b-33dd-95e5-b94de32a1c67",
                                                "text": "„Wahrscheinlich fuhren sie nach Norden, in Richtung Aleppo, oder nach Osten, auf die irakische Grenze zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
