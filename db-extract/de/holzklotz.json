                "senses": [
                    {
                        "sense_id": "91014f40-66a4-378f-a54d-80069d96ac44",
                        "entry_id": "87942bd0-7141-3480-a930-875a23c3aa37",
                        "glosses": [
                            "großes und dickes Stück Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b56fe7d6-775e-45fb-9be2-9755e6e9d897",
                                "sense_id": "91014f40-66a4-378f-a54d-80069d96ac44",
                                "text": "„[…] Gut zwei Monate nach dem tödlichen Wurf eines Holzklotzes von einer Autobahnbrücke bei Oldenburg verhaftet die Polizei den mutmaßlichen Täter.“"
                            },
                            {
                                "example_id": "dbd699fe-cbaf-4c15-a89f-ac856dbec21f",
                                "sense_id": "91014f40-66a4-378f-a54d-80069d96ac44",
                                "text": "„Er warf noch einen befriedigten Blick zur Koppel und bewegte sich dann ruhigen Schrittes auf den Holzklotz zu, auf dem im Herbst das Brennholz für den Winter gehackt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
