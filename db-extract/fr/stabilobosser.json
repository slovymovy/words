                "senses": [
                    {
                        "sense_id": "8f95a9c8-8466-3afe-b3fd-ee011859ac41",
                        "entry_id": "1c7d3428-4bf9-30fc-8850-81330f911a54",
                        "glosses": [
                            "Surligner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb5cba5-1c58-430b-b1ba-ff1207ba5d1e",
                                "sense_id": "8f95a9c8-8466-3afe-b3fd-ee011859ac41",
                                "text": "Tu peux stabilobosser le tout, ça c'est ma petite touche perso."
                            },
                            {
                                "example_id": "27ebdcff-798a-4a8c-a42e-26c0803e20e0",
                                "sense_id": "8f95a9c8-8466-3afe-b3fd-ee011859ac41",
                                "text": "L'envie me prend, là tout de suite de sortir le livre de mon sac et de stabilobosser les parties incriminés."
                            },
                            {
                                "example_id": "29e7370b-0f88-49aa-82e8-0b302967145d",
                                "sense_id": "8f95a9c8-8466-3afe-b3fd-ee011859ac41",
                                "text": "Depuis 1971, il s'est vendu plus de 2 milliards de feutres pour stabilobosser."
                            }
                        ]
                    }
