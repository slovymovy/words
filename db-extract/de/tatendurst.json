                    {
                        "translation_id": "fc688520-dcb4-49b5-8bb1-d0d39b35e76a",
                        "source_entry_id": "2910eef7-d443-3179-8e94-92f7facb44b5",
                        "source_sense_id": "1164c475-2a4c-3256-806c-29f68adbdeb2",
                        "source_sense_description": "das starke Verlangen, etwas zu tun",
                        "target_lang_word": "allant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34fc1508-d758-30e1-8e52-858d60540481",
                                        "entry_id": "df25ee7b-e0b7-3644-8656-9fbeda964106",
                                        "glosses": [
                                            "Qui aime à aller et venir ; qui montre de l’activité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a11121-e85b-45b8-94d5-4cd7e2982279",
                                                "sense_id": "34fc1508-d758-30e1-8e52-858d60540481",
                                                "text": "Je ne t'ai pas trouvée bien allante, ma chérie. Ce qui te soucie n'est pas trop grave, j'espère !"
                                            },
                                            {
                                                "example_id": "cc2a1af6-9e58-485d-8b5d-cb21226b5393",
                                                "sense_id": "34fc1508-d758-30e1-8e52-858d60540481",
                                                "text": "Je crois bien que, sous ses airs allants et vigoureux, il était faible et influençable."
                                            },
                                            {
                                                "example_id": "61415804-8ae3-4bb6-92be-16ceb1311922",
                                                "sense_id": "34fc1508-d758-30e1-8e52-858d60540481",
                                                "text": "Au temps de ma jeunesse allante et vagabonde,\nJ’ai goûté l’hydromel avecque Kunégonde,\nEt le vin de groseille et des ersatz aussi…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8004d5d6-b928-3151-a8a7-edcaf97f56bf",
                                        "entry_id": "df25ee7b-e0b7-3644-8656-9fbeda964106",
                                        "glosses": [
                                            "Motivé."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0223b7-bfb4-4be6-a939-ff25a32b7704",
                                                "sense_id": "8004d5d6-b928-3151-a8a7-edcaf97f56bf",
                                                "text": "[Titre] Peu allante sur l’élargissement, l’UE soutient les Balkans face à la pandémie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28bc0ba4-a8a9-3163-b965-e0fcc7da6674",
                                        "entry_id": "df25ee7b-e0b7-3644-8656-9fbeda964106",
                                        "glosses": [
                                            "En parlant d'un cheval dans une course, impétueux, brillant, qui tire, qui va plus vite que ne le voudrait son cavalier."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "735ece9e-1751-3404-b5ea-d08825f247f7",
                                        "entry_id": "df25ee7b-e0b7-3644-8656-9fbeda964106",
                                        "glosses": [
                                            "Andante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b254d63-8cb2-3119-9b78-2d3a706b2786",
                                        "entry_id": "df25ee7b-e0b7-3644-8656-9fbeda964106",
                                        "glosses": [
                                            "(Dans l’expression « plus allant ») Rapide, vif."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "allant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c1f296-761c-3e98-b5ed-9a4c3de50d0d",
                                        "entry_id": "a0a99620-3e27-355e-b246-11d8caff80ae",
                                        "glosses": [
                                            "Celui, celle qui va. Note d’usage : S’emploie au masculin pluriel en coordination avec venants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb2f430-bdfb-4aa5-9c07-d4c9af2a0cbd",
                                                "sense_id": "f7c1f296-761c-3e98-b5ed-9a4c3de50d0d",
                                                "text": "Pour moi, je l’avoue, je n’aime pas tous ces allants et ces venants étrangers."
                                            },
                                            {
                                                "example_id": "2086b281-a4d9-40c7-9a24-e7fba12daa0d",
                                                "sense_id": "f7c1f296-761c-3e98-b5ed-9a4c3de50d0d",
                                                "text": "Sale et productif comme le commerce, ce passage, toujours plein d’allants et de venants, de charrettes, de haquets, est d’un aspect repoussant, et la population qui y grouille est en harmonie avec les choses et les lieux."
                                            },
                                            {
                                                "example_id": "20d6aa56-852f-4dfc-8dbe-734b5abc60df",
                                                "sense_id": "f7c1f296-761c-3e98-b5ed-9a4c3de50d0d",
                                                "text": "Cette cour est d'ordinaire la salle à manger des commères de Paris, qui, peu soucieuses de n'être pas vues, aiment à voir passer, sur la grande route, les allants et les venants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "034a632e-1766-3e54-b91d-53d5d7e14124",
                                        "entry_id": "a0a99620-3e27-355e-b246-11d8caff80ae",
                                        "glosses": [
                                            "Initiative, entrain."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b58aa19c-b034-4694-ad1a-cc4483b65bd4",
                                                "sense_id": "034a632e-1766-3e54-b91d-53d5d7e14124",
                                                "text": "Et les mecs de l’État-Major, quels beaux soldats ! Pas chiffonnés, et de l’allant !"
                                            },
                                            {
                                                "example_id": "6beb2d53-f098-4d9c-8e30-c372e210f95f",
                                                "sense_id": "034a632e-1766-3e54-b91d-53d5d7e14124",
                                                "text": "La veille, il n’avait pas son allure coutumière, ni son allant habituel."
                                            },
                                            {
                                                "example_id": "ad6449ac-b454-495b-a334-d8677a91967a",
                                                "sense_id": "034a632e-1766-3e54-b91d-53d5d7e14124",
                                                "text": "Décidément, par notre courage, et notre allant, nous démontrions que nous étions des gens à part."
                                            },
                                            {
                                                "example_id": "56c42227-7632-4c3e-bb8a-a63ac9ac1b1f",
                                                "sense_id": "034a632e-1766-3e54-b91d-53d5d7e14124",
                                                "text": "Les Français qui étaient sortis de l’Argonne, avaient occupé la colline de Valmy d’où ils canonnèrent les Prussiens. Brunswick dut livrer contre eux une bataille à front renversé ; il fut surpris par l’allant des Français et la vigueur de leur canonnade."
                                            },
                                            {
                                                "example_id": "6c769a08-4909-4ed2-95e0-cf7e2f09d836",
                                                "sense_id": "034a632e-1766-3e54-b91d-53d5d7e14124",
                                                "text": "Tiger Shroff joue parfois de cette connivence avec son éternel allant de gros forceur, mais au global, il irradie d’un premier degré d’une telle intensité qu’il finit par tout contaminer. Et Baaghi 3 de s’imposer en sommet d’une filmographie certes lamentable, mais de façon spectaculaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ebc23a3-f826-337e-813c-ab92b1631c3f",
