                            {
                                "example_id": "a0780800-eb2e-44a4-af0e-8ef7cc0eaec6",
                                "sense_id": "9810eae1-5a85-3354-8cad-134e4f7a6750",
                                "text": "Certains qualifieurs (static, register, voir les sections 1.5.5 et 1.5.6) permettent de modifier l'allocation et la durée de vie des variables locales."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cee225a-707a-3ec2-bb17-9d268194e641",
                        "entry_id": "dcf5f84e-3928-3439-8cff-fc42b213aa1b",
