                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cee0b8d5-f97b-4559-8451-7593a007220f",
                                "sense_id": "9f29ff8f-c480-3e89-840f-e11317d9e68d",
                                "text": "Of course, I take a bang or some mud in coffee now and then, and I pick up on gage right smart."
                            },
                            {
                                "example_id": "d30636c9-66f0-4962-b6e7-aa96290e78e6",
                                "sense_id": "9f29ff8f-c480-3e89-840f-e11317d9e68d",
                                "text": "Black faces, white tablecloth, gleaming very sharp knives lined up by the saucers... tobacco and \"gage\" smoke richly blended, eye-reddening and tart as wine, yowzah gwine smoke a little ob dis hyah sheeit gib de wrinkles in mah brain a proccess!"
                            }
                        ]
                    },
                    {
                        "sense_id": "0631a08e-2031-3417-bb2e-000260351a99",
                        "entry_id": "5023138b-79a4-35ad-95da-24dcf9f0f4c6",
                        "glosses": [
                            "A pint pot."
                        ],
