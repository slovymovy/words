                        "examples": [
                            {
                                "example_id": "2e5faba3-e181-4599-9eb1-e6fa33cef803",
                                "sense_id": "1fd231be-d9c6-3467-bbb0-76811f7b9dfa",
                                "text": "Bol heeft ook het Nederlandse indoorrecord op de 400 meter op haar naam staan: 50,63. Die tijd liep ze in het Poolse Torun in de finale van de 400 meter, die haar de Europese indoortitel opleverde."
                            },
                            {
                                "example_id": "93691b12-ddee-49b7-85f8-820a44b4cc15",
                                "sense_id": "1fd231be-d9c6-3467-bbb0-76811f7b9dfa",
                                "text": "En gezien de individuele tijden op de 400 meter zijn de Nederlandse mannen- en vrouwenestafetteploeg op de 4x400 meter ook kansrijk voor een medaille in Polen. De afgelopen weken sneuvelde het ene na het andere nationale indoorrecord."
                            }
                        ]
