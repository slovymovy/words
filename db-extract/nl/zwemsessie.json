                            {
                                "example_id": "0fb1341f-614e-426d-9b22-ff7dcc731d6f",
                                "sense_id": "228e0a6f-2a8c-36f3-822e-4859ec15e12e",
                                "text": "Een opmerkelijke zwemsessie in de Tallebudgera Creek aan de Australische Gold Coast afgelopen zondag. Daar besloot een eigenaar van een slang, samen met een biertje én zijn huisdier, een frisse duik te nemen in de rivier."
                            },
                            {
                                "example_id": "42fd4a01-1897-4afa-9f6e-0f5cf933a052",
                                "sense_id": "228e0a6f-2a8c-36f3-822e-4859ec15e12e",
                                "text": "Verder zorgt een actieve zwemsessie voor goedwerkende longen en een gezond hart. Na een aantal baantjes trekken, zul je zien dat je ademcapaciteit veel groter wordt."
                            }
                        ]
