    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42cf2d3f-47ba-3530-8f0e-d98ea8736f12",
                    "sense_definition": "De behaarde boogvormige rand boven de oogkas van een mens.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij tekent elke ochtend haar <w>wenkbrauw</w> bij met een speciaal potlood.",
                            "target_lang_translations": {
                                "en": "Every morning she touches up her <w>eyebrow</w> with a special pencil."
                            }
                        },
                        {
                            "text": "Toen hij het vreemde nieuws hoorde, trok hij verbaasd een <w>wenkbrauw</w> op.",
                            "target_lang_translations": {
                                "en": "When he heard the strange news, he raised an <w>eyebrow</w> in surprise."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wenkbrauwen fronsen",
                        "wenkbrauwen optrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "The hairy arched ridge above the eye socket of a human."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eyebrow",
                                "target_lang_sense_clarification": "the ridge above the eye"
                            },
                            {
                                "target_lang_word": "brow",
                                "target_lang_sense_clarification": "literary or formal term for the eyebrow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b80816a6-b634-3f49-b8bb-e29f4c962334",
                    "sense_definition": "De haartjes die op de rand boven het oog groeien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapper vroeg of hij ook de lange haren van mijn <w>wenkbrauw</w> moest bijknippen.",
                            "target_lang_translations": {
                                "en": "The barber asked if he should also trim the long hairs of my <w>eyebrow</w>."
                            }
                        },
                        {
                            "text": "Zweet liep langs zijn gezicht maar werd tegengehouden door zijn dikke <w>wenkbrauw</w>.",
                            "target_lang_translations": {
                                "en": "Sweat ran down his face but was stopped by his thick <w>eyebrow</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "epileren van de wenkbrauw"
                    ],
                    "target_lang_definitions": {
                        "en": "The hairs that grow on the ridge above the eye."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eyebrow",
                                "target_lang_sense_clarification": "the hair itself"
                            },
                            {
                                "target_lang_word": "brow hair",
                                "target_lang_sense_clarification": "individual hairs of the eyebrow"
                            }
                        ]
                    }
                }
            ]
        }
    ]
