                        "entry_id": "66b49274-2362-30ed-9782-3c32d4b4df29",
                        "glosses": [
                            "A cavity open at one end (such as the blind end of a duct), especially a blind pouch connected to the large intestine between the ileum and the colon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82b7440-5e64-4c49-ba26-8ceaa7789202",
                                "sense_id": "cafe6aaa-7f24-3d7b-b264-96c4f5703394",
                                "text": "After a preliminary course in anatomy it was found that caecum and transverse colon also provided excellent sites for excitation."
                            }
                        ]
