                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ce7d40c5-655e-335b-a0e1-9c9b27288fef",
                        "entry_id": "059ac0d0-52d4-3a98-a394-064303e5b7c2",
                        "glosses": [
                            "zwykle w lm: rząd ptaków odznaczających się krępą budową, silnymi nogami do rozgrzebywania gleby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fb9b4d1-a7de-4ed1-82c0-4bd2fe96241b",
                                "sense_id": "ce7d40c5-655e-335b-a0e1-9c9b27288fef",
                                "text": "Zarówno indyk, kuropatwa, jak i przepiórka należą do rzędu kuraków."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79aad68d-d9ba-41ca-8a5b-18f42bae0a52",
                        "source_entry_id": "059ac0d0-52d4-3a98-a394-064303e5b7c2",
                        "source_sense_id": "ce5bc3e8-65e2-3d47-affc-9d207c4d9f8d",
                        "target_lang_word": "chicken",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chicken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2fc9141-45f2-37e7-92e7-fcb106aab2b0",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "A domesticated subspecies of red junglefowl (Gallus gallus domesticus), especially so-called when young."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "532b6b42-cffc-47a6-b369-cef39fe1983e",
                                                "sense_id": "b2fc9141-45f2-37e7-92e7-fcb106aab2b0",
                                                "text": "Some chickens lay eggs almost every day. […] Chickens are kept for their meat, too."
                                            },
                                            {
                                                "example_id": "e1c28f6f-4d3f-4f3c-bdc4-e8cfa1ef0cf7",
                                                "sense_id": "b2fc9141-45f2-37e7-92e7-fcb106aab2b0",
                                                "text": "With egg prices rising, more people may be shopping for their own backyard chicken flock.\nBut before you build a coop and subscribe to Chicken Whisperer, health experts have a warning: Caring for backyard chickens is not as easy as bringing home a cute new kitten, and keeping chickens can come with a handful of serious health risks, according to the US Centers for Disease Control and Prevention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d6f3f06-5158-30b5-9876-d944f99b9984",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "The meat from this bird eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a3a5e4d-0679-4b55-80de-50f295ee7ab1",
                                                "sense_id": "4d6f3f06-5158-30b5-9876-d944f99b9984",
                                                "text": "Amongst thee more harmless reptiles to be found were several lizards and iguanas. The natives killed these and used them for food. The flesh was not despised by explorers, and I was told it tasted exactly like chicken; but, however good it might have been, my courage was not suffcient to enable me to overcome my prejudice against tasting it."
                                            },
                                            {
                                                "example_id": "aae0461f-fde2-4515-9765-2a53f415d1d1",
                                                "sense_id": "4d6f3f06-5158-30b5-9876-d944f99b9984",
                                                "text": "Before cooking chicken, or other poultry, rinse with cold water and pat dry with a paper towel."
                                            },
                                            {
                                                "example_id": "e7ef8a9f-b0e5-4d7c-9e09-45377d97302d",
                                                "sense_id": "4d6f3f06-5158-30b5-9876-d944f99b9984",
                                                "text": "Here’s a grocery list of foods Chestnut has eaten competitively, drawn from his Major League Eating bio: apple pie, asparagus, boysenberry pie, brats, burritos, chicken spiedies (a kind of sandwich), chicken wings, chili, corned beef sandwiches, eggs, fish tacos, funnel cake, grilled cheese sandwiches, gyoza, Krystal hamburgers, horseshoe sandwiches, hot dogs, ice cream, jalapeno poppers, kolaches, pastrami sandwiches, Philly cheesesteaks, pierogi, pizza, pork ribs, pulled pork, poutine, salt potatoes, shrimp, tacos, tamales, turkey and Twinkies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe390dc1-94cd-3d7b-8a86-69b0a8a3aedf",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "The young of any bird; a chick."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3577a735-8721-440e-978f-ed96bff2056a",
                                                "sense_id": "fe390dc1-94cd-3d7b-8a86-69b0a8a3aedf",
                                                "text": "There they are – four ugly little chickens, a bit more than half-feathered, and all gaping mouths and bare bellies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "752b811b-aaa5-38ef-bfc0-f11d2ae3eba3",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "A coward."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a973774c-bd23-4aa0-ac4b-e8854150bfee",
                                                "sense_id": "752b811b-aaa5-38ef-bfc0-f11d2ae3eba3",
                                                "text": "'Why, what a chicken you are! You are not afraid of being robbed; are you?' said Jonas."
                                            },
                                            {
                                                "example_id": "ddc4b770-9946-4053-9814-522d99f88452",
                                                "sense_id": "752b811b-aaa5-38ef-bfc0-f11d2ae3eba3",
                                                "text": "Then he had an inspiration. \"There is Roxton,\" said he. \"He's not a chicken, but he is a useful man in a row. I think I could get him.\""
                                            },
                                            {
                                                "example_id": "bffa8b6c-8017-4d3d-a2b2-cd26ebd8f53e",
                                                "sense_id": "752b811b-aaa5-38ef-bfc0-f11d2ae3eba3",
                                                "text": "Usually, I had no problem approaching girls, but this one was different. I went home and berated myself for being such a chicken."
                                            },
                                            {
                                                "example_id": "c9be9b40-580b-42f0-bcd0-72573f8140d1",
                                                "sense_id": "752b811b-aaa5-38ef-bfc0-f11d2ae3eba3",
                                                "text": "(More commonly used as an adjective with this sense; see below.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e9f011-eb27-31af-9d07-94acf1067a5f",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "A young or inexperienced person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78de64f8-ed36-433d-8e3a-d589d1d659eb",
                                                "sense_id": "c3e9f011-eb27-31af-9d07-94acf1067a5f",
                                                "text": "Purſue your trade of ſcandal-picking,\n Your hints, that Stella is no chicken:\n Your innuendos, when you tell us,\n That Stella loves to talk with fellows; […]"
                                            },
                                            {
                                                "example_id": "6a47ffeb-1c22-4267-97d9-a826c1639f9c",
                                                "sense_id": "c3e9f011-eb27-31af-9d07-94acf1067a5f",
                                                "text": "\"This case will make a stir, sir,\" he remarked. \"It beats anything I have seen, and I am no chicken.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0113c8ed-d803-3ba5-8b0c-1cdbdb691b18",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "A young, attractive, slim man, usually having little body hair; compare chickenhawk."
                                        ],
                                        "tags": [
                                            "Polari",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5152601-0b85-4a53-824e-1fd4c4a798cc",
                                                "sense_id": "0113c8ed-d803-3ba5-8b0c-1cdbdb691b18",
                                                "text": "Europe's Favorite Gay Newspaper has something for you! Handsome studs, Tender Chicken, and lots of Male Nudes!"
                                            },
                                            {
                                                "example_id": "e3e01268-85d4-43d4-bd03-33eba807b451",
                                                "sense_id": "0113c8ed-d803-3ba5-8b0c-1cdbdb691b18",
                                                "text": "I am a little white chicken, beautiful as sweet and young as beautiful and soft as young and gay as soft and innocent as gay. I dare you to write."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "483f4433-de7d-33a9-8a74-22d529fac7e0",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "The game of dare."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "055cd176-0861-3f59-8d58-aceda751f4fc",
                                        "entry_id": "1eba197d-1a97-33f7-b558-e8cbd99ec7c5",
                                        "glosses": [
                                            "The game of dare.",
                                            "A confrontational game in which the participants move toward each other at high speed (usually in automobiles); the player who turns first to avoid colliding into the other is the \\\"chicken\\\" (that is, the loser)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59cec313-d289-450c-9400-231a73e9a119",
                                                "sense_id": "055cd176-0861-3f59-8d58-aceda751f4fc",
                                                "text": "Don't play chicken with a freight train; you're guaranteed to lose."
                                            },
                                            {
                                                "example_id": "f0d295f2-6a53-4185-98a0-241a8f10869a",
                                                "sense_id": "055cd176-0861-3f59-8d58-aceda751f4fc",
                                                "text": "The Mini surged forward too. The cars were hurtling towards each other across the pitch. This was a dangerous game of chicken. Who would crumble first?"
                                            }
                                        ]
