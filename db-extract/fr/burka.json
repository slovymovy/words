                        "examples": [
                            {
                                "example_id": "bbdfb72f-6903-453d-92a7-aaaa4d5960a4",
                                "sense_id": "367083e4-245d-32fa-bcfb-d66128442c1e",
                                "text": "Les femmes ne portent pas la burka, ce vêtement sans formes qui les couvre totalement dans les plaines, mais une belle coiffe décorée sur leurs cheveux noirs en nattes, souvent entrelacés de rubans et de colliers."
                            },
                            {
                                "example_id": "3f56c03d-13ac-4a1a-9609-bfaebe503f32",
                                "sense_id": "367083e4-245d-32fa-bcfb-d66128442c1e",
                                "text": "Il faisait valoir que «le respect ne doit pas altérer le fait que le hijab, le niqab et la burka sont aussi des instruments d’oppression pour des millions de filles et de femmes dans le monde qui n’ont pas la possibilité de faire un choix»."
                            }
                        ]
                    }
