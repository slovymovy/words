            {
                "entry_id": "99db36eb-4442-31f4-b370-353a98d75581",
                "word": "éventualité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "44fd63fe-36c5-44f1-929e-143b45ef2c26",
                        "entry_id": "99db36eb-4442-31f4-b370-353a98d75581",
                        "tags": [
                            "plural"
                        ],
                        "form": "éventualités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                        "entry_id": "99db36eb-4442-31f4-b370-353a98d75581",
                        "glosses": [
                            "Caractère de ce qui est éventuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e4b128-0d85-4265-a32f-cfaa6dc1397c",
                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                "text": "Toutes les éventualités se présentèrent : le désert sans ressources, des Américains exaspérés, des Japonais, des Chinois, peut-être des Peaux-Rouges !"
                            },
                            {
                                "example_id": "325bbd48-361e-4bc3-b472-9833dc11eb6f",
                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                "text": "Après tout, les conjurés n'étaient pas passés aux actes. Ils pouvaient, à la rigueur, soutenir qu'ils n'avaient fait qu'envisager des éventualités."
                            },
                            {
                                "example_id": "0705661c-5016-47bd-96c2-50e79a85bca2",
                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                "text": "L’éventualité de la gifle dissuade l'enfant de déchirer les livres de la bibliothèque paternelle, comme l’éventualité de la contravention dissuade l'automobiliste de stationner, dans la zone bleue, au delà de l'heure marquée au cadran."
                            },
                            {
                                "example_id": "c803e001-9e1c-403d-9329-b977242be5f9",
                                "sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                                "text": "Elle laisse entendre au dragueur qu'elle est ouverte a toute éventualité. Elle va alors lui donner une série de rendez-vous auxquels elle ne se rendra pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5f74557-95d3-4e93-a440-495010c06040",
                        "source_entry_id": "99db36eb-4442-31f4-b370-353a98d75581",
                        "source_sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                        "target_lang_word": "eventuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eventuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4d1e74-e046-39b7-ae9e-b2eb264a208d",
                                        "entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                                        "glosses": [
                                            "A possible event; something that may happen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac6620d-9465-4097-a72b-f53852b87ecb",
                                                "sense_id": "1e4d1e74-e046-39b7-ae9e-b2eb264a208d",
                                                "text": "Vigil: You are not Prothean. But you are not machine, either. This eventuality was one of many that was anticipated. This is why we sent our warning through the beacons."
                                            },
                                            {
                                                "example_id": "14dcbe0f-9896-4818-b269-da0ee33af9c1",
                                                "sense_id": "1e4d1e74-e046-39b7-ae9e-b2eb264a208d",
                                                "text": "England could have met world and European champions Spain but that eventuality was avoided by Sweden's 2-0 win against France, and Rooney's first goal in a major tournament since scoring twice in the 4-2 victory over Croatia in Lisbon at Euro 2004."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0fa532d-65a4-3d86-b33b-36a14054566d",
                                        "entry_id": "8fc452d2-e020-361a-9b42-10f2f351be7f",
                                        "glosses": [
                                            "An individual's propensity to take notice of events, changes, or facts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0eba009-aebe-4ff1-bc08-981b294e9cea",
                        "source_entry_id": "99db36eb-4442-31f4-b370-353a98d75581",
                        "source_sense_id": "c1d24acf-8e33-39ba-aef4-07bb3e494d52",
                        "target_lang_word": "contingency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contingency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f403e1bb-25ef-3706-a17c-c1f3e5ba1c52",
                                        "entry_id": "34d7c9ea-3b5e-3e56-a207-4c120fabd3a0",
                                        "glosses": [
                                            "The quality of being contingent, of happening by chance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6cdd015-edc8-388a-95a2-40f7c690f546",
                                        "entry_id": "34d7c9ea-3b5e-3e56-a207-4c120fabd3a0",
                                        "glosses": [
                                            "A possibility; something which may or may not happen. A chance occurrence, especially in finance, unexpected expenses."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d33210-098b-4e16-a2d9-674aec8fc563",
                                                "sense_id": "a6cdd015-edc8-388a-95a2-40f7c690f546",
                                                "text": "There was also the imperative necessity of creating a reserve fund for unforeseen contingencies, and the question ever present was how was money to be found."
                                            },
                                            {
                                                "example_id": "dd0445e9-6023-49b3-bf4f-f39b971b56cf",
                                                "sense_id": "a6cdd015-edc8-388a-95a2-40f7c690f546",
                                                "text": "In light of the inherent survival threat posed by zombies and absent specified guidance for detailed planning to address such a contingency, USSTRATCOM has taken the initiative to develop a JOPES Level 3 plan (CONPLAN) consistent with guidance derived from other specified planning efforts to ensure U.S. and Allied freedom of action from zombie domination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4f215f8-9bd6-3f33-b1a8-196561abb5e3",
                                        "entry_id": "34d7c9ea-3b5e-3e56-a207-4c120fabd3a0",
                                        "glosses": [
                                            "An amount of money which a party to a contract has to pay to the other party (usually the supplier of a major project to the client) if he or she does not fulfill the contract according to the specification."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ec0e23a-afae-34ef-a242-5b42cd60fcce",
                                        "entry_id": "34d7c9ea-3b5e-3e56-a207-4c120fabd3a0",
                                        "glosses": [
                                            "A statement which is neither a tautology nor a contradiction."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
