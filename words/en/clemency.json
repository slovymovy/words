                    "frequency": "Low",
                    "semantic_group_id": "mildness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unusual <w>clemency</w> of the winter allowed the construction work to finish ahead of schedule."
                        },
                        {
                            "text": "Travelers enjoyed the surprising <w>clemency</w> of the climate during their northern voyage."
