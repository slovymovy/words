                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd83baa7-317d-462c-9c70-e504f9d24b1d",
                                "sense_id": "f7fbd234-b0cb-3766-a808-cf9511611f77",
                                "text": "„Hinweise auf Opferrituale aus der Zeit der Druiden fanden die Archäologen auch in den großen stadtähnlichen Siedlungen, den Oppida, von denen in Caesars Feldzugsberichten so oft die Rede ist.“"
                            },
                            {
                                "example_id": "0a38feac-6783-4769-bb12-d28b2a098316",
                                "sense_id": "f7fbd234-b0cb-3766-a808-cf9511611f77",
                                "text": "„Die Brahmanen errichteten für ihre hochkomplizierten Opferrituale temporäre Altäre auf freiem Feld.“"
                            }
                        ],
