                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman is <w>caning</w> the old chair to restore its original appearance.",
                            "target_lang_translations": {
                                "ru": "Мастер <w>оплетает тростником</w> старый стул, чтобы вернуть ему первоначальный вид."
                            }
                        },
                        {
                            "text": "He was caught <w>caning</w> the student, which led to his immediate suspension from the school.",
