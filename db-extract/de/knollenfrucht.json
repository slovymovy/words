                "senses": [
                    {
                        "sense_id": "d65f1669-ba0a-37b5-8ce1-0a4b30b47cfe",
                        "entry_id": "c11ff583-9b25-3e8e-b1a9-1967d043b29d",
                        "glosses": [
                            "Kulturpflanze, die essbare Knollen ausbildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4972ab74-e3fc-4b86-a7b4-7f3e81326930",
                                "sense_id": "d65f1669-ba0a-37b5-8ce1-0a4b30b47cfe",
                                "text": "„Dank der Unterstützung von Slow Food werden in den nächsten Monaten 100 Männer und 60 Frauen geschult, um die für den Anbau bestimmten Gebiete von Plastikmüll zu reinigen, die Strukturen zum Schutz der frisch gepflanzten Knollenfrüchte anzufertigen und die verschiedenen Verwendungsmöglichkeiten kennenzulernen, die die organoleptischen Eigenschaften der Pflanze am besten zur Geltung bringen.”"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d64e44e0-c4a5-3ed5-9542-806a103208e3",
                        "entry_id": "c11ff583-9b25-3e8e-b1a9-1967d043b29d",
                        "glosses": [
                            "Frucht, die als Knolle einer Pflanze wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa5cbfb-b8bc-49b6-9760-0c2909c6c1da",
                                "sense_id": "d64e44e0-c4a5-3ed5-9542-806a103208e3",
                                "text": "„Yams, eine Knollenfrucht und das Grundnahrungsmittel, das auch zu einer Art Brot gebacken wurde, und Hirse wuchsen reichlich; ebenso Bohnen, Bataten, eine Art Süßkartoffel, und andere Gemüsesorten sowie mehrere Bananenarten, Äpfel, Feigen, Orangen, Zitronen, Ananas und viele andere Obstsorten, und natürlich Pfeffer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
