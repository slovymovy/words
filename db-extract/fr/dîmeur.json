                        "entry_id": "381bb715-24f2-3eb0-aa96-4fce79d44f2b",
                        "glosses": [
                            "Celui qui était commis au prélèvement de la dîme."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "46f951a6-15fb-42fc-ac3c-fea15a47e411",
                                "sense_id": "453c7d2b-05ca-3fbc-bfcc-5a914d52abef",
                                "text": "On appelle « décimateur » le bénéficiaire de la dîme, « dîmeur » celui qui la collecte « décimable » ou « décimé » celui qui l'acquitte."
                            },
                            {
                                "example_id": "4a7a505f-5842-4139-8737-f33452840d70",
                                "sense_id": "453c7d2b-05ca-3fbc-bfcc-5a914d52abef",
                                "text": "Le dimeur, qui était chargé de ce soin par son maître ou son bailleur, était la bête noire de l'endroit."
                            }
                        ]
                    }
