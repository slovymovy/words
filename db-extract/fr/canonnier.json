                                "target_senses": [
                                    {
                                        "sense_id": "3c5d87b9-3496-378c-991d-583924d33656",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "militair die voor geschut verantwoordelijk is"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f2e2471-55cd-38ec-9181-636c9dabfde9",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "militair die voor geschut verantwoordelijk is",
                                            "onderofficier die voor de artillerie op een schip zorgde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8506456-321e-4eb1-a9f3-e8ef5f2f71ad",
                                                "sense_id": "9f2e2471-55cd-38ec-9181-636c9dabfde9",
                                                "text": "Vice-admiraal Borsboom stond in zijn toespraak stil bij het verlies van oude geuzennamen als vonkenboer (elektricien), konstabel (artillerist) en torpedomaker. \"Die vakken vallen nu onder één noemer, maar de inventiviteit en het vernieuwende vermogen van de Technische Dienst blijven bestaan.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccc5f47e-50b1-3fe8-85f1-0aa619916e3a",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "militair die voor geschut verantwoordelijk is",
                                            "scheepsofficier belast met de zorg voor geschut en munitie, zowel bij marine als koopvaardij"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "830265f1-7f68-4cf7-966e-905bfcd17102",
                                                "sense_id": "ccc5f47e-50b1-3fe8-85f1-0aa619916e3a",
                                                "text": "Een laag eronder stuitten de archeologen op de cabine van de konstabel, die voor het geschut en de munitie zorgde, en vonden daar onder meer vijftig musketten."
                                            },
                                            {
                                                "example_id": "9b6fd4f3-650a-4ff8-91bb-d6b3d44a6f3a",
                                                "sense_id": "ccc5f47e-50b1-3fe8-85f1-0aa619916e3a",
                                                "text": "Schrijver bekwam intusschen aanmerkelijke schade en liep (niettegenstaande de heldhaftigste tegenweer) eenige oogenblikken gevaar het onderspit te delven. Het denkbeeld van een slaaf der bloeddorstige Algerijnen te worden, was hem ondragelijk. In dezen uitersten nood laat hij zijnen konstabel, in wien hij een groot vertrouwen stelde bij zich komen, hem bevelende; zich met eene brandende lont bij de kruidkamer te plaatsen, en den rooden haan in het buskruid te werpen, zoodra hij hem driemaal met den voet op het dek hoorde stampen. De konstabel hoorde bedaard dit bevel aan en vertrok, onder de betuiging, dat hij den last van zijnen bevelhebber getrouw zoude nakomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92702f08-5b2a-3313-850a-f59e33195b16",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "militair die voor geschut verantwoordelijk is",
                                            "kanonnier"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fe31e78-f66e-319f-bfae-2f3780dba177",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "functionaris die verantwoordelijk is voor de beveiliging"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6022038b-a195-35fc-a31a-ef963aa8ca96",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "adellijke functie in Vlaanderen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00a9230-0b47-4863-994d-11bef9a87564",
                                                "sense_id": "6022038b-a195-35fc-a31a-ef963aa8ca96",
                                                "text": "(…) de burggraven, die in het binnenland als vertegenwoordigers van de graaf zijn burchten verdedigden, en aan de hoven van de adellijke families die de vier erfelijke hofambten van Vlaanderen (konstabel, seneschalk, schenker en kamerling) bekleedden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "733a6c47-39c6-3632-a2c9-02502256ea5c",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "Nederlandse benaming voor functionarissen met een titel in een vreemde taal die dezelfde herkomst heeft"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f014d351-0a17-361b-b30f-789823cdf669",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "Nederlandse benaming voor functionarissen met een titel in een vreemde taal die dezelfde herkomst heeft",
                                            "politieagent"
                                        ],
                                        "tags": [
                                            "Britse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e35b40fd-9909-4efc-845a-45955acb580c",
                                                "sense_id": "f014d351-0a17-361b-b30f-789823cdf669",
                                                "text": "\"Ik ga dat tuig aangeven! Ik zal ze hun lesje wel instampen!\"\n- \"Heb je het kenteken?\"\n\"Natuurlijk.\"\nZij begon te bellen. Inderdaad - natuurlijk, dacht ik. Iemand anders niet maar Thyrza wel. Ik luisterde hoe een onfortuinlijke konstabel abrupt tot de orde werd geroepen; zij was niet tevreden voor de politieauto's uitrukten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37492637-945a-3d96-be80-ad9db3cffbc0",
                                        "entry_id": "de5d6663-c0de-308c-b0c0-62389ed2cab9",
                                        "glosses": [
                                            "Nederlandse benaming voor functionarissen met een titel in een vreemde taal die dezelfde herkomst heeft",
                                            "functionaris die bij de plaatselijke rechtbanken de orde handhaaft of uitspraken van de rechter kenbaar maakt"
                                        ],
                                        "tags": [
