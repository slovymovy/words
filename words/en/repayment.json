{
    "word_family": [
        "pay",
        "repay",
        "payable",
        "payer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aab65222-0a64-3613-8419-bcc4b5c8bd6e",
                    "sense_definition": "The act of paying back money that was borrowed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_transaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank requires the <w>repayment</w> of the loan within five years.",
                            "target_lang_translations": {
                                "ru": "Банк требует <w>погашения</w> кредита в течение пяти лет."
                            }
                        },
                        {
                            "text": "He struggled to keep up with his monthly <w>repayment</w> schedule.",
                            "target_lang_translations": {
                                "ru": "Ему было трудно придерживаться графика ежемесячных <w>выплат</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loan repayment",
                        "repayment schedule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс возврата заемных денежных средств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выплата",
                                "target_lang_sense_clarification": "процесс или действие по возврату долга"
                            },
                            {
                                "target_lang_word": "погашение",
                                "target_lang_sense_clarification": "официальный термин для возврата кредита или долга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ef6b45e-a2b5-335f-84d5-678ba98a9cb7",
                    "sense_definition": "The specific amount of money paid back to settle a debt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_transaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monthly <w>repayment</w> is due on the first of every month.",
                            "target_lang_translations": {
                                "ru": "Ежемесячный <w>платеж</w> должен быть внесен первого числа каждого месяца."
                            }
                        },
                        {
                            "text": "She made a large <w>repayment</w> to reduce the total interest owed.",
                            "target_lang_translations": {
                                "ru": "Она внесла крупный <w>платеж</w>, чтобы уменьшить общую сумму начисленных процентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monthly repayment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная сумма денег, выплачиваемая для погашения долга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платеж",
                                "target_lang_sense_clarification": "конкретная сумма, вносимая в счет долга"
                            },
                            {
                                "target_lang_word": "выплата",
                                "target_lang_sense_clarification": "сумма, выплаченная в рамках обязательств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4279603-67fc-3e80-91c5-1365907a640d",
                    "sense_definition": "An act of retaliation or revenge for a perceived wrong.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attack was a brutal <w>repayment</w> for the betrayal he suffered.",
                            "target_lang_translations": {
                                "ru": "Это нападение было жестокой <w>расплатой</w> за предательство, которое он пережил."
                            }
                        },
                        {
                            "text": "He viewed the insult as a <w>repayment</w> for his earlier criticism.",
                            "target_lang_translations": {
                                "ru": "Он воспринял это оскорбление как <w>расплату</w> за свою недавнюю критику."
                            }
                        }
                    ],
                    "synonyms": [
                        "payback"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт возмездия или мести за причиненное зло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расплата",
                                "target_lang_sense_clarification": "возмездие за совершенные действия"
                            },
                            {
                                "target_lang_word": "отмщение",
                                "target_lang_sense_clarification": "акт мести за обиду"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}