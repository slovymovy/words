                            {
                                "example_id": "f3417413-22c0-432f-927b-8f334b93270b",
                                "sense_id": "37a216f1-3aac-35b5-8b38-6f2c09517f5e",
                                "text": "Horna speelde goed, Federer speelde slecht. Werkertje Horna was uiterst geconcentreerd, virtuoos Federer liet de strijkstok waarmee hij zulk fraai spel kan componeren, regelmatig uit de handen kledderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "31327c7d-6fda-3a28-aca2-a6d8511d03f7",
                        "entry_id": "b205f7d7-96e7-3fd8-9a13-708fa5432570",
                        "glosses": [
                            "iets vies maken door zaken te laten vallen of rond te laten spetteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af3069f-7a08-4077-8f1d-97d8d5330bfe",
                                "sense_id": "31327c7d-6fda-3a28-aca2-a6d8511d03f7",
                                "text": "Van mij mogen Bashô's kikkers dus ploppen, plonzen, en zelfs kledderen zoveel ze maar willen. Elk kikkertje springt immers zoals het gebekt is?"
                            }
                        ]
                    }
