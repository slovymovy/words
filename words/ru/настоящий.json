{
    "word_family": [
        "настоящее",
        "по-настоящему",
        "настоящесть"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6abb095b-2355-3585-934d-a5b97c8ecfd7",
                    "sense_definition": "Подлинный, действительный; не поддельный и не воображаемый.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <w>настоящая</w> кожа, а не искусственный материал.",
                            "target_lang_translations": {
                                "en": "This is <w>real</w> leather, not an artificial material.",
                                "zh": "这是<w>真正的</w>皮革，而不是人造材料。"
                            }
                        },
                        {
                            "text": "У неё была <w>настоящая</w> причина для беспокойства.",
                            "target_lang_translations": {
                                "en": "She had a <w>real</w> reason for concern.",
                                "zh": "她有<w>真实的</w>理由感到担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "подлинный",
                        "неподдельный",
                        "реальный",
                        "истинный",
                        "всамделишный",
                        "действительный"
                    ],
                    "antonyms": [
                        "фальшивый",
                        "поддельный",
                        "фиктивный",
                        "выдуманный",
                        "ложный"
                    ],
                    "common_phrases": [
                        "настоящая любовь",
                        "настоящее золото",
                        "настоящая жизнь"
                    ],
                    "target_lang_definitions": {
                        "en": "Genuine, actual; not fake and not imaginary.",
                        "zh": "真实的，非伪造的；非想象的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "real",
                                "target_lang_sense_clarification": "existing in fact; not artificial"
                            },
                            {
                                "target_lang_word": "genuine",
                                "target_lang_sense_clarification": "truly what it is said to be; not counterfeit"
                            },
                            {
                                "target_lang_word": "authentic",
                                "target_lang_sense_clarification": "of undisputed origin; genuine"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真正的",
                                "target_lang_sense_clarification": "指客观存在，非人工合成或伪造的"
                            },
                            {
                                "target_lang_word": "真实的",
                                "target_lang_sense_clarification": "指符合事实，非虚构或想象的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "378da6d7-aa04-3ea4-8ed0-f09621f7f691",
                    "sense_definition": "Истинный, совершенный; представляющий собой лучший образец кого-либо или чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты <w>настоящий</w> друг, который всегда поможет.",
                            "target_lang_translations": {
                                "en": "You are a <w>true</w> friend who will always help.",
                                "zh": "你是一个<w>真正的</w>朋友，总会伸出援手。"
                            }
                        },
                        {
                            "text": "Это был <w>настоящий</w> праздник для всех гостей.",
                            "target_lang_translations": {
                                "en": "It was a <w>real</w> celebration for all the guests.",
                                "zh": "这对所有客人来说都是一场<w>名副其实的</w>盛宴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "истинный",
                        "совершенный",
                        "образцовый",
                        "подлинный"
                    ],
                    "common_phrases": [
                        "настоящий друг",
                        "настоящий мужчина",
                        "настоящий герой",
                        "настоящий профессионал"
                    ],
                    "target_lang_definitions": {
                        "en": "True, perfect; representing the best example of someone or something.",
                        "zh": "纯粹的，典型的；指某人或某事物的最佳典范。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "true",
                                "target_lang_sense_clarification": "embodying the ideal type; loyal"
                            },
                            {
                                "target_lang_word": "real",
                                "target_lang_sense_clarification": "used to emphasize the extent or degree of something"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真正的",
                                "target_lang_sense_clarification": "强调符合某种理想标准或本质"
                            },
                            {
                                "target_lang_word": "名副其实的",
                                "target_lang_sense_clarification": "指完全符合其名称或身份的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a653b7df-52f8-3f3d-ba2f-c6a8c25513d2",
                    "sense_definition": "Теперешний, происходящий сейчас, в данное время.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>настоящее</w> время мы живём в другом городе.",
                            "target_lang_translations": {
                                "en": "At the <w>present</w> time we live in another city.",
                                "zh": "我们<w>目前</w>住在另一个城市。"
                            }
                        },
                        {
                            "text": "Глагол в этом предложении стоит в <w>настоящем</w> времени.",
                            "target_lang_translations": {
                                "en": "The verb in this sentence is in the <w>present</w> tense.",
                                "zh": "这个句子里的动词是<w>现在</w>时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "теперешний",
                        "нынешний",
                        "актуальный"
                    ],
                    "antonyms": [
                        "прошлый",
                        "будущий",
                        "прошедший"
                    ],
                    "common_phrases": [
                        "в настоящее время",
                        "настоящее время"
                    ],
                    "target_lang_definitions": {
                        "en": "Current, occurring now, at the present time.",
                        "zh": "当前的，正在发生的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "present",
                                "target_lang_sense_clarification": "existing or occurring now; relating to this time"
                            },
                            {
                                "target_lang_word": "current",
                                "target_lang_sense_clarification": "happening or being used or done now"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目前的",
                                "target_lang_sense_clarification": "指此时此刻的情况"
                            },
                            {
                                "target_lang_word": "现在的",
                                "target_lang_sense_clarification": "指当前的时间段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e83f2700-2d37-3d51-b107-cda35c51ce1d",
                    "sense_definition": "Этот, данный (употребляется преимущественно в официальных документах).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Настоящий</w> договор вступает в силу с момента подписания.",
                            "target_lang_translations": {
                                "en": "<w>This</w> agreement enters into force from the moment of signing.",
                                "zh": "<w>本</w>合同自签署之日起生效。"
                            }
                        },
                        {
                            "text": "Все пункты, включённые в <w>настоящее</w> соглашение, обязательны для исполнения.",
                            "target_lang_translations": {
                                "en": "All clauses included in <w>this</w> agreement are binding.",
                                "zh": "<w>本</w>协议中包含的所有条款均具有强制执行力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "этот",
                        "данный"
                    ],
                    "common_phrases": [
                        "настоящий договор",
                        "настоящее соглашение",
                        "настоящий закон"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "официально-деловой стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "This, given (used mainly in official documents).",
                        "zh": "此，本（多用于法律或正式公文）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "this",
                                "target_lang_sense_clarification": "referring to the document or text itself"
                            },
                            {
                                "target_lang_word": "present",
                                "target_lang_sense_clarification": "formal legal reference to the document in hand"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "本",
                                "target_lang_sense_clarification": "指代当前正在讨论或签署的文件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}