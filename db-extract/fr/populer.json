                "senses": [
                    {
                        "sense_id": "6969265b-b725-3449-9f73-e4576878acbb",
                        "entry_id": "b212b7a2-a8d1-315f-8e24-1335b2c50cf3",
                        "glosses": [
                            "Alimenter (une table, une base de données) en informations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e91e2dc-664a-46ea-bc56-421ad121fb07",
                                "sense_id": "6969265b-b725-3449-9f73-e4576878acbb",
                                "text": "Populer une table depuis une autre ?"
                            },
                            {
                                "example_id": "53f323b2-f81d-4761-b10a-c64b084fda32",
                                "sense_id": "6969265b-b725-3449-9f73-e4576878acbb",
                                "text": "Permet de populer les attributs provenant d’une table de la base de données."
                            },
                            {
                                "example_id": "bc070346-5dcc-4104-85b7-58e4bb26a553",
                                "sense_id": "6969265b-b725-3449-9f73-e4576878acbb",
                                "text": "J’ai honte d’être « cadenassien », bientôt ceux qui populeront nos prisons seront les justes de la Nation."
                            }
                        ]
                    },
                    {
                        "sense_id": "fefc087f-74c5-3312-bfdf-d3851b73d32c",
                        "entry_id": "b212b7a2-a8d1-315f-8e24-1335b2c50cf3",
                        "glosses": [
                            "Peupler."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "note": "absent des dictionnaires de l’Académie Française 8e (1932-1935) et 9ᵉ édition",
                        "examples": [
                            {
                                "example_id": "92c7801f-df28-4ffb-92c1-16142b745e48",
                                "sense_id": "fefc087f-74c5-3312-bfdf-d3851b73d32c",
                                "text": "Par une seconde ordonnance, rendue au Havre pendant qu’il y était, le roi, « afin de donner espoir et ferme courage à ses sujets de populer la dite ville, » déclara que ses habitants seraient, à l’avenir et pour toujours, dispensés de tailles et de gabelles, leur accordant « le franc saler tant pour leur user que pour saler victuailles, maquereaux et harengs. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "9746a673-d53f-3a1f-ac0b-67363cd607f7",
                        "entry_id": "b212b7a2-a8d1-315f-8e24-1335b2c50cf3",
                        "glosses": [
                            "Vaquer, pulluler (en parlant d’une foule)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6b23ed-1d85-44e2-bbe4-139cb8f38ba2",
                                "sense_id": "9746a673-d53f-3a1f-ac0b-67363cd607f7",
                                "text": "Les travailleurs libérés populent sur les trottoirs."
                            }
                        ]
                    }
                ],
