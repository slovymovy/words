                        "examples": []
                    },
                    {
                        "sense_id": "a7d2111c-f227-3062-b17f-84629b6bc788",
                        "entry_id": "bc881d91-6d2a-378e-a3d5-3491e356a41c",
                        "glosses": [
                            "A device which can be used to move, arrange or operate something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2886c7-571e-4369-bcc5-1b5cf745bdbc",
                                "sense_id": "a7d2111c-f227-3062-b17f-84629b6bc788",
                                "text": "The power lights blinked red and the amplifier failed, but not before Kassad had seen the tapering ovoid shapes, spotted with thrusters and cockpit blisters, each trailing a tangle of six jointless manipulator arms."
                            }
                        ]
                    },
                    {
                        "sense_id": "71e7156b-7189-3b45-8dac-1e8fa21cb900",
                        "entry_id": "bc881d91-6d2a-378e-a3d5-3491e356a41c",
                        "glosses": [
                            "A puppeteer, especially one controlling marionettes."
                        ],
                        "tags": [],
                        "examples": []
                    }
