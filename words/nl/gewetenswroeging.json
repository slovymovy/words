                    "sense_definition": "Een pijnlijk gevoel van spijt of berouw over iets dat men verkeerd heeft gedaan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "berouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de diefstal werd hij geplaagd door een diepe <w>gewetenswroeging</w> die hem nachtenlang wakker hield.",
                            "target_lang_translations": {
                                "en": "After the theft, he was plagued by a deep <w>remorse</w> that kept him awake for nights."
                            }
                        },
                        {
                            "text": "Zonder enige <w>gewetenswroeging</w> vertelde de getuige een leugen tegen de rechter.",
                            "target_lang_translations": {
                                "en": "Without any <w>pangs of conscience</w>, the witness told a lie to the judge."
                            }
                        }
                    ],
                    "synonyms": [
                        "berouw",
                        "gewetensnood",
                        "zelfverwijt",
                        "spijt",
                        "schuldbesef"
                    ],
                    "common_phrases": [
                        "diepe gewetenswroeging",
                        "zonder enige gewetenswroeging",
                        "last van gewetenswroeging"
                    ],
                    "target_lang_definitions": {
                        "en": "A painful feeling of regret or remorse about something one has done wrong."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remorse",
