                        ]
                    },
                    {
                        "sense_id": "1305978b-497a-3682-9e62-8c3ba15e2d20",
                        "entry_id": "e40312f9-7eac-3720-a5ac-d0050d0828ac",
                        "glosses": [
                            "Qui éprouve de la frustration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34fe03d0-6990-4d89-938a-1c7587a916d3",
                                "sense_id": "1305978b-497a-3682-9e62-8c3ba15e2d20",
                                "text": "Le premier ministre canadien Justin Trudeau admet être « frustré » par la lenteur des campagnes de vaccination contre la COVID-19 en cours dans les provinces."
                            },
                            {
                                "example_id": "9c3395d6-10c1-492a-bad1-26bea30a29b2",
                                "sense_id": "1305978b-497a-3682-9e62-8c3ba15e2d20",
                                "text": "D’après la NHK, il aurait confié aux enquêteurs qu’il était « frustré » vis-à-vis de Shinzo Abe et qu’il lui a tiré dessus avec l’intention de le tuer."
                            }
                        ]
                    }
                ],
