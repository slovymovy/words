                        "sense_id": "427f660c-cd54-3190-9d6c-f326340648cf",
                        "entry_id": "30223f68-9abe-35bd-b849-57c0168a192c",
                        "glosses": [
                            "rum lub inny mocny trunek rozcieńczony gorącą wodą, czasami dodaje się również do niego sok z cytrusów, cynamon lub cukier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52565f0-64a0-4166-b177-fba416d86f3a",
                                "sense_id": "427f660c-cd54-3190-9d6c-f326340648cf",
                                "text": "Dała nam gotowanego szkapiego mięsa i kazała je zapijać grogiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04d6a15b-036e-4217-a24b-5cc46a8402ab",
                        "source_entry_id": "30223f68-9abe-35bd-b849-57c0168a192c",
                        "source_sense_id": "427f660c-cd54-3190-9d6c-f326340648cf",
                        "target_lang_word": "grog",
