                                                "example_id": "ce474cf2-872d-4789-b798-02a1a879a10c",
                                                "sense_id": "9225e82f-4d6f-366a-9e10-dcfa75401063",
                                                "text": "Мороз пробежал по всему моему телу при мысли, в чьих руках я находился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a8925e8-a46e-313e-8518-6815d53bd615",
                                        "entry_id": "249bb7f6-c786-3925-93c5-e00283bc8114",
                                        "glosses": [
                                            "книжн., поэт., устар. принадлежащий кому-либо; то же, что которого"
                                        ],
                                        "tags": [
                                            "относит."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc7f8aae-5f8d-469e-9c91-26207da4e238",
                                                "sense_id": "9a8925e8-a46e-313e-8518-6815d53bd615",
                                                "text": "О ты, чьей памятью кровавой // Мир долго, долго будет полн…"
                                            },
                                            {
                                                "example_id": "f13838b0-b5bc-4469-9ff3-15f8d56ba99f",
                                                "sense_id": "9a8925e8-a46e-313e-8518-6815d53bd615",
                                                "text": "Но жалок тот, кто всё предвидит, // Чья не кружится голова…"
                                            },
                                            {
                                                "example_id": "f506a647-0e71-447e-a3ea-43b5bf348ff4",
                                                "sense_id": "9a8925e8-a46e-313e-8518-6815d53bd615",
                                                "text": "Я — тот, чей взор надежду губит; // Я тот, кого никто не любит…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e53ebc8-26a4-3551-939e-f98d36d1e6a7",
                                        "entry_id": "249bb7f6-c786-3925-93c5-e00283bc8114",
                                        "glosses": [
                                            "разг. то же, что чей-либо, чей-нибудь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d84407-7cd4-4751-9d6f-0acf56585bf1",
                                                "sense_id": "2e53ebc8-26a4-3551-939e-f98d36d1e6a7",
                                                "text": "Коль нет в чьём голосе ослиного приятства, // Не принимать тех на Парнас."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
