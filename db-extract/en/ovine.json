                    },
                    {
                        "translation_id": "5e1b3a7f-cc45-4354-bc73-4cc37f6ecc8c",
                        "source_entry_id": "161ca4c0-85ef-39c5-a304-5ca0449e0e0d",
                        "source_sense_description": "of, being, pertaining to, or resembling a sheep",
