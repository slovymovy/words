                                            {
                                                "example_id": "0021c9d1-c049-40f2-b257-df2afdc94df9",
                                                "sense_id": "ad350fff-73ac-34de-b903-10cf2cf494e7",
                                                "text": "Największymi wyspami w archipelagu Wysp Kanaryjskich są Teneryfa i Gran Canaria."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "10ee9259-0099-3d89-bf4b-b0aa304c2f14",
                                        "entry_id": "e79431c9-abc4-3013-92a6-c297dd89f78d",
                                        "glosses": [
                                            "terytorium autonomiczne Hiszpanii obejmujące Wyspy Kanaryjskie (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3145e5c-753d-428b-bc6d-96770a060218",
                                                "sense_id": "10ee9259-0099-3d89-bf4b-b0aa304c2f14",
                                                "text": "Cały obszar Wysp Kanaryjskich to strefa wolnocłowa, nie ma więc sensu odkładać zakupów perfum czy alkoholi na ostatnią chwilę przed odlotem."
                                            },
                                            {
                                                "example_id": "7ecbd999-2ceb-4e83-8ae8-0fc7878c7bc9",
                                                "sense_id": "10ee9259-0099-3d89-bf4b-b0aa304c2f14",
                                                "text": "Na Wyspach Kanaryjskich znajdują się dwie hiszpańskie prowincje: Las Palmas i Santa Cruz de Tenerife."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
