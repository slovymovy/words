                ],
                "senses": [
                    {
                        "sense_id": "44710cd2-0383-3728-b256-7eb1d121a155",
                        "entry_id": "8f5c9cf9-0479-3734-890b-1a764961cdf1",
                        "glosses": [
                            "Maßnahme oder Vorgang mit dem Effekt, dass etwas konkret/konkreter wird"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "876a9486-a333-4677-88eb-031fc4128645",
                                "sense_id": "44710cd2-0383-3728-b256-7eb1d121a155",
                                "text": "„Diese Konkretion ist radikal gemeint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "59346b71-d1c2-391e-95eb-a7d76e3a2323",
                        "entry_id": "8f5c9cf9-0479-3734-890b-1a764961cdf1",
                        "glosses": [
                            "durch Mineralienabscheidung entstandener, meist sphärischer Gesteinskörper (zum Beispiel Kugelsandstein oder Lösskindel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d2b8b74-b9d2-499b-b3d4-705e9e115282",
                                "sense_id": "59346b71-d1c2-391e-95eb-a7d76e3a2323",
                                "text": "„Die Paläontologen knackten immer mehr Konkretionen und fanden auch Schädel von Säugern der frühesten Generation, direkt nach der geologischen Zeitenwende.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1b5960be-78d0-3f31-8536-82f04f7cb7b4",
                        "entry_id": "8f5c9cf9-0479-3734-890b-1a764961cdf1",
                        "glosses": [
                            "Entstehung fester Gebilde/Ablagerungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c5ccb8-650f-426b-87cc-48560cd5fc88",
                                "sense_id": "1b5960be-78d0-3f31-8536-82f04f7cb7b4",
                                "text": "„Der Gallenstein ist kein Stein, sondern eine harzigerdige, brennbare Masse, eine Konkretion der Galle.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
