                ],
                "senses": [
                    {
                        "sense_id": "e2adc832-bf36-3cab-98be-49809e9aa2ef",
                        "entry_id": "19d7ad96-806e-3640-af04-dc16c166d1e2",
                        "glosses": [
                            "aus religiöser oder weltanschaulicher Überzeugung erwachsene Anbetung und Verehrung von Symbolen, Personen oder Institutionen; in der katholischen Kirche insbesondere des Altarsakramentes"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "d43f0ce6-4298-4105-96d6-76695614bf85",
                                "sense_id": "e2adc832-bf36-3cab-98be-49809e9aa2ef",
                                "text": "„Die Adoration des modernen Staates kann geradezu die Vernichtung jeder Cultur herbeiführen.“"
                            },
                            {
                                "example_id": "2330bf2d-a5fe-4f8f-9f88-e0f3d80977dc",
                                "sense_id": "e2adc832-bf36-3cab-98be-49809e9aa2ef",
                                "text": "„Viel länger als die Königin-Luise-Vergötterung wird sich die Adoration Friedrichs II. halten, bis in die Sterbestunde des Diktators Hitler hinein.“"
                            },
                            {
                                "example_id": "bca659fe-1bc4-4413-9a42-5a90ecfaca52",
                                "sense_id": "e2adc832-bf36-3cab-98be-49809e9aa2ef",
                                "text": "„Der Freidemokrat hatte noch einen Freiheitsbegriff hochgehalten, der sich nicht mit der Schwarmintelligenz verträgt, wie die Adoration des kollektivistischen Denkens in Piratenkreisen heißt – das brachte ihm den Hohn und Spott der sogenannten Netzgemeinde ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32451ab4-24dc-383f-b646-3dc63b8e73b1",
                        "entry_id": "19d7ad96-806e-3640-af04-dc16c166d1e2",
                        "glosses": [
                            "dem neu gewählten Papst, der katholischen Kirche, erwiesene Huldigung der Kardinäle, beispielsweise durch Kniefall und Fußkuss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f7b0eb-96fd-494b-8392-ddc402f9b493",
                                "sense_id": "32451ab4-24dc-383f-b646-3dc63b8e73b1",
                                "text": "„Zugleich mit der Annahme der Wahl gibt der neue Papst den Namen an, den er als solcher zu führen gesonnen ist, vertauscht sodann in der Sakristei die Kardinalstracht mit der päpstlichen und erhält vor dem Altar der Wahlkapelle von seiten der Kardinäle die erste Adoration: den Fuß- und Handkuß, wofür der Papst den Friedenskuß auf beide Wangen reicht.“"
                            },
                            {
                                "example_id": "4491b07f-f3c7-43af-ba2b-cb5ba3054ecd",
                                "sense_id": "32451ab4-24dc-383f-b646-3dc63b8e73b1",
                                "text": "„Daran schließt sich die zweite Adoration in der Sixtinischen Kapelle und der Zug in die Peterskirche [an], wo vor dem Hochaltar die dritte Adoration, zu der auch die Bischöfe und Prälaten, die fremden Gesandten und sonstige Personen von Adel zugelassen sind, stattfindet.“"
                            },
                            {
                                "example_id": "ccf83a4c-e56c-431e-a16b-ea0fc20a26b7",
                                "sense_id": "32451ab4-24dc-383f-b646-3dc63b8e73b1",
                                "text": "„An Christi Himmelfahrt, dem 23.05.1555 zur Mittagszeit wurde Kardinal Carafa durch einstimmige Adoration zum neuen Kirchenoberhaupt gewählt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6001d03c-c2f1-45ea-9a83-9caecf8a106b",
                        "source_entry_id": "19d7ad96-806e-3640-af04-dc16c166d1e2",
                        "source_sense_id": "e2adc832-bf36-3cab-98be-49809e9aa2ef",
                        "source_sense_description": "religiös oder weltanschaulich motivierte Anbetung von Symbolen, Personen oder Institutionen",
                        "target_lang_word": "adoration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adoration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3314b14e-1d63-3253-8a52-61ebb2d3300d",
                                        "entry_id": "0febb597-3d4b-3061-a189-f1997a68170a",
                                        "glosses": [
                                            "An act of religious worship."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a21a5b3-2035-4db1-a557-69ed02891145",
                                                "sense_id": "3314b14e-1d63-3253-8a52-61ebb2d3300d",
                                                "text": "We incessantly look forward, and endeavour, by prayers, adoration, and sacrifice, to appease those unknown powers, whom we find, by experience, so able to afflict and oppress us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c6185a-0db8-353e-bb12-1b99888c5aee",
                                        "entry_id": "0febb597-3d4b-3061-a189-f1997a68170a",
                                        "glosses": [
                                            "Admiration or esteem."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3675129-704b-46d1-829a-cc19001bef9d",
                                                "sense_id": "30c6185a-0db8-353e-bb12-1b99888c5aee",
                                                "text": "[…] if she can create the sense of beauty in people whose lives have been sordid and ugly...she is worthy of all your adoration, worthy of the adoration of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b01313c1-0870-3784-91a5-bd1fdd524e41",
                                        "entry_id": "0febb597-3d4b-3061-a189-f1997a68170a",
                                        "glosses": [
                                            "The act of adoring; loving devotion or fascination."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a79cbf2-c159-4d69-9298-671e688c0e24",
                                                "sense_id": "b01313c1-0870-3784-91a5-bd1fdd524e41",
                                                "text": "He adored Sorais quite as earnestly as Sir Henry adored Nyleptha, and his adoration had not altogether prospered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea57294f-255f-3d7d-91af-202d6d04bf96",
                                        "entry_id": "0febb597-3d4b-3061-a189-f1997a68170a",
                                        "glosses": [
                                            "The selection of a pope by acclamation and before any formal ballot (excluded as a voting method in 1621 by Pope Gregory XV)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd9d06aa-e6d1-3e5e-8dd0-963f94ab4d9a",
                                        "entry_id": "0febb597-3d4b-3061-a189-f1997a68170a",
                                        "glosses": [
                                            "Worship of Christ in the Eucharistic host in the Catholic Church, often while exposed in a monstrance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa0fff1b-dd3d-47b1-9e11-dd5a97dc87fd",
                        "source_entry_id": "19d7ad96-806e-3640-af04-dc16c166d1e2",
                        "source_sense_id": "e2adc832-bf36-3cab-98be-49809e9aa2ef",
                        "source_sense_description": "religiös oder weltanschaulich motivierte Anbetung von Symbolen, Personen oder Institutionen",
                        "target_lang_word": "adoration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adoration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33248b1c-f376-3c03-a348-ea16b599d380",
                                        "entry_id": "cd3acb21-1e2d-39c3-85e1-d7fb0860a00e",
                                        "glosses": [
                                            "Action d’adorer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca8b8ff-8abd-4ba2-a027-a3971ca08df9",
                                                "sense_id": "33248b1c-f376-3c03-a348-ea16b599d380",
                                                "text": "L’adoration proprement dite n’est due qu’à Dieu seul. L’adoration perpétuelle du Saint Sacrement. L’adoration de la Croix est une des cérémonies de l’église dans la semaine sainte."
                                            },
                                            {
                                                "example_id": "f645e268-aaa2-4309-bf8d-6dff83c9e6eb",
                                                "sense_id": "33248b1c-f376-3c03-a348-ea16b599d380",
                                                "text": "« Il est très exact, disait Mme de la Trave ; il fait son adoration tous les soirs ; mais il manque d’onction, je ne le trouve pas ce qui s’appelle pieux. Et pour les œuvres, il laisse tout tomber. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a8c1cf-2747-3a3c-957a-2cd4249fa091",
                                        "entry_id": "cd3acb21-1e2d-39c3-85e1-d7fb0860a00e",
                                        "glosses": [
                                            "Attitude de respect et d’amour envers Dieu."
                                        ],
                                        "tags": [
                                            "Liturgie chrétienne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c850b5f-a3a8-420f-9aaf-9fbeac2c263b",
                                                "sense_id": "a6a8c1cf-2747-3a3c-957a-2cd4249fa091",
                                                "text": "Attitude de respect et d’amour du chrétien priant Dieu comme le Dieu Unique, Celui de qui tout dépend. L’adoration s’adresse exclusivement à Dieu. Elle est avant tout d’ordre spirituel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac77908-9219-3c16-b79d-7dd849aa149a",
                                        "entry_id": "cd3acb21-1e2d-39c3-85e1-d7fb0860a00e",
                                        "glosses": [
                                            "Acte de vénération du Christ réellement présent dans l’hostie consacrée au cours de la messe."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a7be2c-ce4c-4894-89a8-c992f9272bc8",
                                                "sense_id": "aac77908-9219-3c16-b79d-7dd849aa149a",
                                                "text": "L’adoration du Saint Sacrement."
                                            },
                                            {
                                                "example_id": "8409753b-90c5-4b72-ac0a-692ef48dc398",
                                                "sense_id": "aac77908-9219-3c16-b79d-7dd849aa149a",
                                                "text": "La contemplation, l’adoration devant le Saint Sacrement ne remplacent pas l’Eucharistie, elle en est le prolongement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138e41a6-7b77-3102-96e7-fee642565dcc",
                                        "entry_id": "cd3acb21-1e2d-39c3-85e1-d7fb0860a00e",
                                        "glosses": [
                                            "Cérémonie qui se pratique à l’égard d’un pape nouvellement élu, lorsqu’il est mis sur l’autel après son élection et que les cardinaux vont lui rendre honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271c9950-db00-4839-a619-c4e445042bba",
                                                "sense_id": "138e41a6-7b77-3102-96e7-fee642565dcc",
                                                "text": "Aller à l’adoration du pape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec44ec59-9e75-3a86-a85b-c7b3cc795c2f",
                                        "entry_id": "cd3acb21-1e2d-39c3-85e1-d7fb0860a00e",
                                        "glosses": [
                                            "Amour, attachement extrême."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5433150-e682-4485-94cb-6b501de05c62",
                                                "sense_id": "ec44ec59-9e75-3a86-a85b-c7b3cc795c2f",
                                                "text": "L’adoration d’une jeune fille est plus forte que toutes les réprobations sociales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
