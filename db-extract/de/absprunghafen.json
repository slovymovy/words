                ],
                "senses": [
                    {
                        "sense_id": "f7789b51-caec-3298-82b9-fed44d05c32d",
                        "entry_id": "02b49618-65be-388f-856c-b711c6ffa0f5",
                        "glosses": [
                            "Flughafen, der Ausgangspunkt für einen Militäreinsatz ist"
                        ],
                        "tags": [
                            "Militärwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "4a4348c0-cb39-4882-80f9-24931230c4d4",
                                "sense_id": "f7789b51-caec-3298-82b9-fed44d05c32d",
                                "text": "„Als Absprunghafen für die Langstreckenbomber des Typs Heinkel He 177 war der Flugplatz Prowehren bei Königsberg vorgesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "edfbfb4b-1af8-3694-8609-7eb8997d9ae5",
                        "entry_id": "02b49618-65be-388f-856c-b711c6ffa0f5",
                        "glosses": [
                            "Hafen, von dem aus man zu einer längeren Fahrt/Reise mit einem Schiff/Boot aufbricht"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "a201b0e4-8e80-472a-ac6d-e9d5abeb695c",
                                "sense_id": "edfbfb4b-1af8-3694-8609-7eb8997d9ae5",
                                "text": "„Als Absprunghäfen zu den Liparischen Inseln bieten sich Tropea am italienischen Festland (ca. 30 Seemeilen bis Stromboli) oder Portorosa auf Sizilien an (ca. 15 Seemeilen bis Vulcano).“"
                            },
                            {
                                "example_id": "05dc8c5c-35ae-45af-9b6f-f43fe0c65b58",
                                "sense_id": "edfbfb4b-1af8-3694-8609-7eb8997d9ae5",
                                "text": "„Phylos ist der ideale Absprunghafen um in die Straße von Messina zu gelangen.“"
                            },
                            {
                                "example_id": "9cda7030-82fd-4b12-abdc-172db79d9fe3",
                                "sense_id": "edfbfb4b-1af8-3694-8609-7eb8997d9ae5",
                                "text": "„Ponta Delgada ist ein idealer Zwischenstopp- und Absprunghafen für Yachten auf dem Weg zur Iberischen Halbinsel.“"
                            },
                            {
                                "example_id": "2a2fe1f9-2ec8-4a24-a1cd-54d8e46aab4e",
                                "sense_id": "edfbfb4b-1af8-3694-8609-7eb8997d9ae5",
                                "text": "„Rund achtzig Meilen quer über den Golf von Taranto liegen noch vor uns, dann sind wir in Santa Maria Leuca, unserem Absprunghafen nach Korfu.“"
                            },
                            {
                                "example_id": "4bd6b1fb-1285-4ec4-8234-a498c34dfce6",
                                "sense_id": "edfbfb4b-1af8-3694-8609-7eb8997d9ae5",
                                "text": "„In Plymouth, das zur Zeit von Queen Elizabeth I. die Höhle des britischen Seelöwen war und mittlerweile der wichtigste Absprunghafen für europäische Atlantiksegler ist, wurde die Regatta am Sonnabend, dem 17. Juni, gestartet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
