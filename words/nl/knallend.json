                            },
                            {
                                "target_lang_word": "smashing",
                                "target_lang_sense_clarification": "referring to a success or finale"
                            },
                            {
                                "target_lang_word": "splitting",
                                "target_lang_sense_clarification": "referring to a headache"
                            },
                            {
                                "target_lang_word": "striking",
                                "target_lang_sense_clarification": "visually prominent"
                            }
                        ]
                    }
                }
