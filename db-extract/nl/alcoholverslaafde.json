                        "entry_id": "1c099d13-6b60-3aa1-b2d9-1050f0d108cf",
                        "glosses": [
                            "iemand die schadelijke hoeveelheden alcohol gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f592a34-c138-4773-9f1a-3bcc4c7e6466",
                                "sense_id": "b68ac6bf-4160-30e2-8be3-dcaf89af46b2",
                                "text": "Jonge alcoholverslaafden in tijdloze lompen."
                            },
                            {
                                "example_id": "5d460e3e-d9fd-4d8d-ad98-b271b1e8f425",
                                "sense_id": "b68ac6bf-4160-30e2-8be3-dcaf89af46b2",
                                "text": "De verslavingszorg experimenteert met een nieuw wapen tegen overlast door alcoholverslaafden. Sinds vorige week lopen twaalf mensen rond met een enkelband die hun alcoholgebruik registreert."
                            }
                        ]
                    }
                ],
