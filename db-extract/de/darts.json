                ],
                "senses": [
                    {
                        "sense_id": "b1168c30-564c-32f1-ae62-71913cfe610e",
                        "entry_id": "7ad5d023-e49a-3bf3-8d6d-3dcff53cf81a",
                        "glosses": [
                            "eine Sportart, bei der mit kleinen Pfeilen (Darts) auf eine Zielscheibe geworfen wird, wobei sich die Punktzahl der Spieler danach richtet, in welchem Bereich der Zielscheibe der Pfeil stecken bleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e708912-8206-4bdb-8919-4dd948f37a8c",
                                "sense_id": "b1168c30-564c-32f1-ae62-71913cfe610e",
                                "text": "„Hinten im Raum wird Darts gespielt, vorn an der Bar treffen sich wechselnde Gruppen junger Schwarzer zu einem kurzen Schwatz.“"
                            },
                            {
                                "example_id": "c4cff5c7-e4a0-4fa9-9732-ff31d86f0403",
                                "sense_id": "b1168c30-564c-32f1-ae62-71913cfe610e",
                                "text": "„Die Geschworenen glaubten dem Staatsanwalt John Jackson, dass der arbeitslose, vorbestrafte Automechaniker zum Mörder wurde, weil ihn die Kinder beim Biertrinken und beim Darts gestört hätten, nachdem seine Frau einkaufen gegangen war.“"
                            },
                            {
                                "example_id": "9853f555-0199-4e1f-b5f3-7434e32f07c1",
                                "sense_id": "b1168c30-564c-32f1-ae62-71913cfe610e",
                                "text": "„Bis sie sich vor 15 Jahren bei einem Sturz in der Wohnung den Arm brach, habe sie noch ausgezeichnet Darts gespielt, erklärt sie.“"
                            },
                            {
                                "example_id": "74c20e39-7c69-468c-a30a-1b8c781620e8",
                                "sense_id": "b1168c30-564c-32f1-ae62-71913cfe610e",
                                "text": "„Vor einigen Jahren hatte der Sport eine Art medialen Frühling, wie ihn aktuell gerade Darts erlebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
