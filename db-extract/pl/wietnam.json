                                                "sense_id": "4ae9acce-3c75-3b05-af57-a1eaced6d207",
                                                "text": "David Rabe's anti-Viet Nam play Streamers"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Vietnam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2777a884-1c96-34d0-8b6e-d138f2e1a96b",
                                        "entry_id": "49f1a31b-01ad-3e49-bf29-5f377af8ee91",
                                        "glosses": [
                                            "A long and protracted war or conflict in which the dominating foreign occupier is unable to secure a victory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a6c7578-1d74-456d-bc22-3c7406b350a6",
                                                "sense_id": "2777a884-1c96-34d0-8b6e-d138f2e1a96b",
                                                "text": "another Vietnam"
                                            },
                                            {
                                                "example_id": "c87fc361-24ec-4622-b98a-3a5a66a22504",
                                                "sense_id": "2777a884-1c96-34d0-8b6e-d138f2e1a96b",
                                                "text": "the Soviet Union's Vietnam (the 1979–89 occupation of Afghanistan)"
                                            },
                                            {
                                                "example_id": "6fe6d674-86fa-4458-a1a6-8b4ff37f873a",
                                                "sense_id": "2777a884-1c96-34d0-8b6e-d138f2e1a96b",
                                                "text": "France's Vietnam (the Algerian War or First Indochina War)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "949d736e-2f20-3ec6-bcec-0ecd920912dd",
                                        "entry_id": "49f1a31b-01ad-3e49-bf29-5f377af8ee91",
                                        "glosses": [
                                            "A place that is very dangerous, especially if afflicted by violence."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48e8094-84d3-4030-ad84-b77523aeb36e",
                                                "sense_id": "949d736e-2f20-3ec6-bcec-0ecd920912dd",
                                                "text": "Welcome back to Vietnam, California."
                                            },
                                            {
                                                "example_id": "785a80af-bc7c-4318-b5aa-686ae795c328",
                                                "sense_id": "949d736e-2f20-3ec6-bcec-0ecd920912dd",
                                                "text": "Vietnam, California, back in and on a mission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "543ac90f-a55b-393d-8f47-1daca3398e05",
                                        "entry_id": "49f1a31b-01ad-3e49-bf29-5f377af8ee91",
                                        "glosses": [
                                            "A situation in which one cannot win."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b448f6aa-b2e0-4fc6-83a0-4d5a9666f496",
                                                "sense_id": "543ac90f-a55b-393d-8f47-1daca3398e05",
                                                "text": "Everyone was miserable, including Coppola. \"It was my Vietnam,\" he moaned a few months later."
                                            },
                                            {
                                                "example_id": "023d2cc2-c381-4434-a291-38775f37d3a7",
                                                "sense_id": "543ac90f-a55b-393d-8f47-1daca3398e05",
                                                "text": "Judy is the great deceiver / Judy is your Viet Nam"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
