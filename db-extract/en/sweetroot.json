                        "examples": [
                            {
                                "example_id": "cf469df3-35eb-4f7d-aa86-248bd4906dcf",
                                "sense_id": "41eef776-7435-3ab8-9402-cdf3049e67dc",
                                "text": "Like other members of this large family, sweetroot presents its tiny flowers in terminal, umbrella-shaped inflorescences that do little to assure us that the plant is not the deadly water hemlock (Cicula douglasii)"
                            },
                            {
                                "example_id": "e5282e40-69e4-42b7-b80b-01019023e98f",
                                "sense_id": "41eef776-7435-3ab8-9402-cdf3049e67dc",
                                "text": "The plant is sometimes confused with Osmorhiza chilensis (western sweetroot), which often shares the same habitat. However, unlike red baneberry, sweetroot has a strong licorice-like odor."
                            }
                        ]
                    }
