                        "examples": [
                            {
                                "example_id": "88d14d9f-1e7c-4dca-b5ec-255355816547",
                                "sense_id": "7803f9e8-462f-3d92-bc91-b81ef8209ea4",
                                "text": "Een deel van de resterende oogst is daarom nog ongewis. Maar hoe dan ook zal de vrieskou zijn effect op de wijnkwaliteit kunnen krijgen, aldus wijnkenner Ilja Gort op BNR."
                            },
                            {
                                "example_id": "12618c66-943e-4419-bce1-be69406e535d",
                                "sense_id": "7803f9e8-462f-3d92-bc91-b81ef8209ea4",
                                "text": "Wijnkenner en presentator Ilja Gort ontving een wel heel bijzondere uitnodiging in de bus. Of hij op het privéfeestje van zanger Sting wilde komen op zijn wijngaard in Toscane. En daar zei de flamboyante Gort als groot Sting-fan geen nee tegen."
                            }
                        ]
                    }
