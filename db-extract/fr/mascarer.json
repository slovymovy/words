                "senses": [
                    {
                        "sense_id": "c5c9868e-83d5-3190-b247-f95ecb00f1d2",
                        "entry_id": "b5254db0-540d-3a71-8e48-4f2697b446db",
                        "glosses": [
                            "Farder (ou salir, noircir)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1772020-e411-4e54-9b9e-be9348ec6061",
                                "sense_id": "c5c9868e-83d5-3190-b247-f95ecb00f1d2",
                                "text": "La mascarer. La farder si tu préfères. Ils lui barbouillent le visage avec les raisins."
                            },
                            {
                                "example_id": "2ad8eb7e-de26-4e78-a7ea-e57961d109d7",
                                "sense_id": "c5c9868e-83d5-3190-b247-f95ecb00f1d2",
                                "text": "Je ne pouvais plus me permettre de mascarer mon visage ainsi."
                            },
                            {
                                "example_id": "db09096c-cb2d-4cae-bf31-3a41ca0b78ef",
                                "sense_id": "c5c9868e-83d5-3190-b247-f95ecb00f1d2",
                                "text": "Faire du bruit, danser, se mascarer pour repousser les mauvais esprits, le loup pour nous protéger et revendiquer notre esprit réboussier."
                            }
                        ]
                    }
                ],
