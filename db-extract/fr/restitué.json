                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5711dd67-7c97-485f-a068-e8a69729e2d2",
                                "sense_id": "6aa8753c-3b84-3d40-b5e2-0f1578f13542",
                                "text": "Le texte restitué est précédé d’une vie du poète, portrait de l’homme et de son époque, qui est à lui seul tout un livre."
                            },
                            {
                                "example_id": "fbdf3ace-5489-407e-b071-8ceaf9fe66a5",
                                "sense_id": "6aa8753c-3b84-3d40-b5e2-0f1578f13542",
                                "text": "Toutes ces constructions sont figurées sur le plan, avec les parties restituées, indiquées par des teintes et des hachures."
                            }
                        ]
                    }
                ],
