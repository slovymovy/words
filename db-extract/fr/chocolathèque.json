                "senses": [
                    {
                        "sense_id": "b4655773-1cd2-3eb0-ab3b-2290b61f5764",
                        "entry_id": "20555932-622d-3616-9b7c-38882ba6091e",
                        "glosses": [
                            "Lieu présentant une collection de chocolats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca81a62-87ca-4af8-85d5-2152e9e3e55d",
                                "sense_id": "b4655773-1cd2-3eb0-ab3b-2290b61f5764",
                                "text": "Suite au déménagement du laboratoire et de la chocolaterie en mars 2009, la famille propose un espace muséographique et une chocolathèque à découvrir tout l'été."
                            },
                            {
                                "example_id": "db64ae34-5789-406c-9aaa-82289b5003bb",
                                "sense_id": "b4655773-1cd2-3eb0-ab3b-2290b61f5764",
                                "text": "Amateur de chocolat, et ils sont ultra-majoritaires, le chocolatier Yves vous propose une visite aussi originale qu’intéressante, celle de sa chocolathèque, ou chocolaterie."
                            },
                            {
                                "example_id": "a18f00ef-ad66-45a9-a459-194c6470b29f",
                                "sense_id": "b4655773-1cd2-3eb0-ab3b-2290b61f5764",
                                "text": "L’ouverture d’une nouvelle boutique, dans la même rue, est au programme. Là, une chocolathèque, un endroit réservé à la dégustation devrait y voir le jour."
                            },
                            {
                                "example_id": "ce3265d2-5421-4c58-be09-77487376de98",
                                "sense_id": "b4655773-1cd2-3eb0-ab3b-2290b61f5764",
                                "text": "\"Notre souhait est de valoriser le savoir-faire des chocolatiers du Tarn, puis de l’Occitanie. La chocolathèque est pensée comme un véritable lieu de ressources pour les amoureux de chocolat\", témoigne Hervé Frézal qui a repris le musée il y a trois ans."
                            }
                        ]
                    }
