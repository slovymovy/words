                "senses": [
                    {
                        "sense_id": "03af43c3-68c1-3d10-9695-3d4df46dac55",
                        "entry_id": "36cb41f7-c98a-39d8-a2b7-70c9eb2a0990",
                        "glosses": [
                            "andere Bezeichnung für den Vatikanstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48e35b42-1895-46bf-9f50-d15b52e13b95",
                                "sense_id": "03af43c3-68c1-3d10-9695-3d4df46dac55",
                                "text": "„Während sich die Abenddämmerung über den Kirchenstaat senkt, heben der Sekretär und der Fahrer drei Blautannen aus dem Bayerischen Wald vom Wagendach und schleppen sie zu einem kleinen Aufzug…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7f055b7-326f-331f-8e54-367fa904e23a",
                        "entry_id": "36cb41f7-c98a-39d8-a2b7-70c9eb2a0990",
                        "glosses": [
                            "bis 1870 vom Papst regierter Staat in Mittelitalien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020f5b2f-05a1-452b-bcb8-0377a8b687a5",
                                "sense_id": "e7f055b7-326f-331f-8e54-367fa904e23a",
                                "text": "„Im Norden erstreckte sich das Land bis an den Kirchenstaat, womit es für damalige europäische Verhältnisse ziemlich groß war.“"
                            },
                            {
                                "example_id": "db78c053-52f6-4da8-8a3d-1362abd21c2e",
                                "sense_id": "e7f055b7-326f-331f-8e54-367fa904e23a",
                                "text": "„Daraufhin sagte er, ich sei bei dem ehrenwertesten Sbirren des ganzen Kirchenstaates.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
