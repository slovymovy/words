                ],
                "senses": [
                    {
                        "sense_id": "eeb7c70a-0db5-3af8-999d-f737b479646c",
                        "entry_id": "db5f7b8d-6a39-3a07-b2f5-2d8f50d316e9",
                        "glosses": [
                            "To deprive of a tongue, or of voice."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2a2a2018-85a6-43ba-88d7-00220c089515",
                                "sense_id": "eeb7c70a-0db5-3af8-999d-f737b479646c",
                                "text": "Especially he ought to untongue it from talking to his prejudice"
                            },
                            {
                                "example_id": "61b7b656-3f90-4b4a-a13c-c91d8a2f0ca7",
                                "sense_id": "eeb7c70a-0db5-3af8-999d-f737b479646c",
                                "text": "Mark me, they will untongue you ; decudgel you to a very submissive state of conjugal obedience; and , what is still worse, they will actually bamboozle you —that is to say, unless you deviate your transcendent and subterranean courses."
                            },
                            {
                                "example_id": "56bbd38e-f49c-4302-ae9e-3f676fee1771",
                                "sense_id": "eeb7c70a-0db5-3af8-999d-f737b479646c",
                                "text": "Yet till thine axe untongue me, I'll maintain Ours was a mighty scheme, and that it failed, Its chiefest fault."
                            },
                            {
                                "example_id": "e2e03761-9135-48df-bbcb-b814eee5c092",
                                "sense_id": "eeb7c70a-0db5-3af8-999d-f737b479646c",
                                "text": "They are the ones who can untongue you, the poet Adler says."
                            }
                        ]
                    },
                    {
                        "sense_id": "6577c3ce-24e9-3cd5-9d59-dcee246ca907",
                        "entry_id": "db5f7b8d-6a39-3a07-b2f5-2d8f50d316e9",
                        "glosses": [
                            "To take one's tongue off of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd3b6f5-96f1-4997-9b5e-c5cae7d73487",
                                "sense_id": "6577c3ce-24e9-3cd5-9d59-dcee246ca907",
                                "text": "Unhand me-- er, untongue me, vile monster!"
                            },
                            {
                                "example_id": "48ed3aca-0010-433f-8acc-ba2b3939266c",
                                "sense_id": "6577c3ce-24e9-3cd5-9d59-dcee246ca907",
                                "text": "What?! Hey! Untongue me!"
                            },
                            {
                                "example_id": "e6d523eb-7758-4f96-b2e3-c65b834b3895",
                                "sense_id": "6577c3ce-24e9-3cd5-9d59-dcee246ca907",
                                "text": "\"Well, tell it to untongue me! \" Han demanded."
                            }
                        ]
                    }
                ],
