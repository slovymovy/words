                                            {
                                                "example_id": "4a38a3ec-e440-413b-b507-1d309a664856",
                                                "sense_id": "0d1c523c-d8e0-37c4-9164-5c3df2b20897",
                                                "text": "Im Viertel hinter dem Bahnhof treiben sich viele Schießer herum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a604090-e1cf-3beb-8657-281373e14c4e",
                                        "entry_id": "7a809239-fe27-3631-b808-f2ae2e4df06d",
                                        "glosses": [
                                            "Bäckerei-Werkzeug: ein vorne abgeflachtes Brett mit Stiel zum Einschießen der Teiglinge und zum Ausziehen des Gebäcks aus dem Ofen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a47e002-7862-4841-bfc4-718276f090c0",
                                                "sense_id": "6a604090-e1cf-3beb-8657-281373e14c4e",
                                                "text": "Je nach Ofen und Backware werden verschiedene Schießer benutzt."
                                            },
                                            {
                                                "example_id": "bda5b46f-46e8-4b54-9cfd-1c2c73f997bf",
                                                "sense_id": "6a604090-e1cf-3beb-8657-281373e14c4e",
                                                "text": "Bei mehrstöckigen Öfen wird für die oberen Etagen der Schießer in Kopfhöhe geführt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
