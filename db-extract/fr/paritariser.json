                "senses": [
                    {
                        "sense_id": "ef192a99-3db6-3e0a-b67a-66bea808bb8f",
                        "entry_id": "afb7a9da-ba54-3aed-98bf-83f7e4d77ae2",
                        "glosses": [
                            "Donner un caractère paritaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b003f08-7206-443b-bb37-a6b956aa61f0",
                                "sense_id": "ef192a99-3db6-3e0a-b67a-66bea808bb8f",
                                "text": "L'émancipation n'est-ce pas de se construire parmi les autres, de tendre à l'acceptation des différences interpersonnelles pour les paritariser socialement ?"
                            },
                            {
                                "example_id": "e090c03f-7b0c-44ff-a818-668a497a5a94",
                                "sense_id": "ef192a99-3db6-3e0a-b67a-66bea808bb8f",
                                "text": "Maintenant c'est la politique qu'il faut \"paritariser\" alors qu'on ne tient pas le même discours sur le parcours que je viens de lister pour mon gamin en difficulté."
                            },
                            {
                                "example_id": "b1c9ad6b-41f3-45ff-8c49-805659274c8e",
                                "sense_id": "ef192a99-3db6-3e0a-b67a-66bea808bb8f",
                                "text": "En termes de gouvernance, les SSTI restent sous la responsabilité des employeurs mais leur gestion se « paritarise » au travers de la composition des instances internes de décision et de contrôle."
                            }
                        ]
                    }
