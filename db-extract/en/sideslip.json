                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85bedd80-d169-48e6-bc63-ad6168ddeb44",
                        "source_entry_id": "91bc1893-3b4b-317a-bc11-4c149b4912e3",
                        "source_sense_description": "flight manoeuvre",
                        "target_lang_word": "glissade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glissade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa7d3517-c4f6-3b07-bd68-1fa980ddb51d",
                                        "entry_id": "5d1ac5e9-2015-3e6d-85c3-2b2b066d9324",
                                        "glosses": [
                                            "Action de glisser involontairement ; effet qui en résulte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc1ff201-5407-4dc3-87cd-9acd315f71da",
                                                "sense_id": "aa7d3517-c4f6-3b07-bd68-1fa980ddb51d",
                                                "text": "N’ayez pas de distraction et comptez, en cas de glissade, sur vos mains plus que sur vos pieds."
                                            },
                                            {
                                                "example_id": "017e803b-4c64-4a31-8dc1-559df4048bdd",
                                                "sense_id": "aa7d3517-c4f6-3b07-bd68-1fa980ddb51d",
                                                "text": "Dans son trouble, il prit un tel élan qu’une glissade l’amena jusqu’au trou du souffleur et que, sans un heureux rétablissement, il serait tombé au plein milieu de l’orchestre."
                                            },
                                            {
                                                "example_id": "a21c0725-6587-4dd6-a710-7a73fde4555a",
                                                "sense_id": "aa7d3517-c4f6-3b07-bd68-1fa980ddb51d",
                                                "text": "La glissade de Bertara était visible sur la terre jaune humide, et, en bas, on voyait distinctement les traînées de ses mains et la trace de ses ongles incrustés dans le sol, dans les efforts qu’il avait dû faire pour arrêter sa chute."
                                            },
                                            {
                                                "example_id": "b386d0d9-0c88-4b43-b8fb-151ddb199636",
                                                "sense_id": "aa7d3517-c4f6-3b07-bd68-1fa980ddb51d",
                                                "text": "Et brusquement, je tourne à gauche... Le 4x4 part en glissade et s'arrête au milieu d'une petite place toute choupinou..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb82ae32-997a-3d8e-9c1f-abb0e92ae0e7",
                                        "entry_id": "5d1ac5e9-2015-3e6d-85c3-2b2b066d9324",
                                        "glosses": [
                                            "Action de s’élancer sur une surface lisse ; jeu auquel on s’amuse ainsi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10e55ca-74d6-4935-ace7-16d37bf69474",
                                                "sense_id": "fb82ae32-997a-3d8e-9c1f-abb0e92ae0e7",
                                                "text": "Une glissade en « toboggan » ne s’oublie plus : c’est l’enivrement des espaces que l’on sent se dérober sous soi ; la sensation, pendant une minute, de la fuite irrévocable par delà les limites du connu..."
                                            },
                                            {
                                                "example_id": "884d9102-dcb4-407d-8a66-e21c501dbbd6",
                                                "sense_id": "fb82ae32-997a-3d8e-9c1f-abb0e92ae0e7",
                                                "text": "Elle se surprit esquissant une glissade, sur un petit coin de glace bleue."
                                            },
                                            {
                                                "example_id": "766135e5-3ab1-47d6-9c79-71b18ca409eb",
                                                "sense_id": "fb82ae32-997a-3d8e-9c1f-abb0e92ae0e7",
                                                "text": "Le reste de la place était couvert de petits pavés luisants, sur lesquels les enfants, sautant du tram, s’élançaient en de longues glissades vers la rue Bab-Azoun qui les menait en cinq minutes au lycée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b082a2-9eb0-34fe-9250-07ea3785e140",
                                        "entry_id": "5d1ac5e9-2015-3e6d-85c3-2b2b066d9324",
                                        "glosses": [
                                            "Pente glissante  ; glissoire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f74076-2f17-422b-87ca-5e157b40c472",
                                                "sense_id": "d2b082a2-9eb0-34fe-9250-07ea3785e140",
                                                "text": "Deux grosses roches émergeaient du milieu de cette glissade, et des pins arrachés formaient de périlleux barrages contre lesquels l’écume se déchirait en réseau de dentelle."
                                            },
                                            {
                                                "example_id": "fa5502ea-2808-420a-a69a-3fb82be8e6e3",
                                                "sense_id": "d2b082a2-9eb0-34fe-9250-07ea3785e140",
                                                "text": "[…] on avait établi, dans toutes les rues en pente avoisinant l’école, de superbes glissades. […] Mais la plus belle était celle de devant la cour où, selon une coutume immémoriale, on allait « luger » à toutes les sorties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0960f29b-47c6-3855-a468-b0df277ad0da",
                                        "entry_id": "5d1ac5e9-2015-3e6d-85c3-2b2b066d9324",
                                        "glosses": [
                                            "Laisser-aller, relâchement, succession de fautes qui conduit à la chute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a044fcf5-8c38-4c83-be3b-e038951f0f07",
                                                "sense_id": "0960f29b-47c6-3855-a468-b0df277ad0da",
                                                "text": "On voit aussi l’indigne imprévoyance des gens d’en haut, leur affreuse glissade en plein abîme, et leur air effaré, leur fausse audace de peureux qui tremblotent en fredonnant."
                                            },
                                            {
                                                "example_id": "7a4a422c-cdba-4258-ac0d-d07ec4e58f95",
                                                "sense_id": "0960f29b-47c6-3855-a468-b0df277ad0da",
                                                "text": "Nos systèmes de retraites actuels pavent de bonnes intentions un enfer, la glissade vers la société grisonnante, vers le ralentissement économique, vers l’impasse."
                                            },
                                            {
                                                "example_id": "5e43e943-2b9b-4423-ac16-1abba583a10f",
                                                "sense_id": "0960f29b-47c6-3855-a468-b0df277ad0da",
                                                "text": "Seul l’euro nous protège, pour un moment encore, d’une glissade vers l’abîme"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a197755-4ed8-3cf8-8893-626b1d08623f",
                                        "entry_id": "5d1ac5e9-2015-3e6d-85c3-2b2b066d9324",
                                        "glosses": [
                                            "Pas de danse que l’on fait en glissant ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224de1ad-c524-44df-bd8f-1b73d622b229",
                                                "sense_id": "4a197755-4ed8-3cf8-8893-626b1d08623f",
                                                "text": "Oh ! vous appelez cela danser : faire trois pas en avant, avec les pieds en dedans, le corps penché et les épaules arrondies ; puis hasarder une glissade à droite sans quitter terre, et comme si vous étiez fixée au parquet ; puis, peu satisfaite de ce que vous trouvez à droite, essayer à gauche une glissade parallèle ; puis, n’ayant pu encore trouver ce que vous semblez chercher, vous décider tout à coup à traverser pour aller voir ce qui se passe en face de vous ; là, recommencer le même manège, un pas à droite, un pas à gauche, le même, toujours le même ; car, si vous faisiez un pas différent, on vous prendrait pour une femme de quarante ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c934bb2-61e9-36a1-b2eb-5c51e7d3be32",
                                        "entry_id": "5d1ac5e9-2015-3e6d-85c3-2b2b066d9324",
                                        "glosses": [
                                            "Manœuvre d’accélération en descente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18ffd0d8-5881-4505-8dd2-2f62e3b451bb",
                                                "sense_id": "5c934bb2-61e9-36a1-b2eb-5c51e7d3be32",
                                                "text": "D’une brusque glissade sur l’aile, l’aéroplane échappait au tir des mitrailleuses boches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27f4fd06-b38b-3818-8e8e-5feb641ada27",
                                        "entry_id": "5d1ac5e9-2015-3e6d-85c3-2b2b066d9324",
                                        "glosses": [
                                            "Appellation enfantine pour désigner un toboggan d’un parc de jeux, d’une piscine, d’un plan d’eau…"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bb081aa-4aca-4802-a91f-5d4acf1c1f0d",
                                                "sense_id": "27f4fd06-b38b-3818-8e8e-5feb641ada27",
                                                "text": "L’échelle de la glissade, c’est pas une place pour jouer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
