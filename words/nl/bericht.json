{
    "word_family": [
        "berichten",
        "berichtgeving",
        "berichtgever",
        "berichtje",
        "nieuwsbericht",
        "weerbericht"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48ed2f1d-3497-3bce-9e44-ee4336ad7adb",
                    "sense_definition": "Een mondelinge of schriftelijke mededeling die informatie overbrengt naar iemand anders.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb gisteren een kort <w>bericht</w> van mijn broer ontvangen.",
                            "target_lang_translations": {
                                "en": "I received a short <w>message</w> from my brother yesterday.",
                                "ru": "Вчера я получил короткое <w>сообщение</w> от брата."
                            }
                        },
                        {
                            "text": "Zodra ik aankom op het station, stuur ik je een <w>bericht</w> via de telefoon.",
                            "target_lang_translations": {
                                "en": "As soon as I arrive at the station, I will send you a <w>message</w> by phone.",
                                "ru": "Как только я приеду на вокзал, я пришлю тебе <w>сообщение</w> по телефону."
                            }
                        }
                    ],
                    "synonyms": [
                        "boodschap",
                        "mededeling"
                    ],
                    "common_phrases": [
                        "een bericht sturen",
                        "een bericht ontvangen",
                        "persoonlijk bericht"
                    ],
                    "target_lang_definitions": {
                        "en": "An oral or written communication that conveys information to someone else.",
                        "ru": "Устное или письменное сообщение, передающее информацию другому лицу."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "message",
                                "target_lang_sense_clarification": "a piece of information sent to someone"
                            },
                            {
                                "target_lang_word": "note",
                                "target_lang_sense_clarification": "a short written message"
                            },
                            {
                                "target_lang_word": "notice",
                                "target_lang_sense_clarification": "a formal announcement or notification"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сообщение",
                                "target_lang_sense_clarification": "общая передача информации"
                            },
                            {
                                "target_lang_word": "известие",
                                "target_lang_sense_clarification": "новость или уведомление"
                            },
                            {
                                "target_lang_word": "послание",
                                "target_lang_sense_clarification": "письменное или официальное сообщение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a522da54-0866-3d9c-ade6-4c7f255a1eed",
                    "sense_definition": "Informatie over een recente gebeurtenis, vaak verspreid via de media.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nieuws",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>bericht</w> over de overwinning van de ploeg stond in alle kranten.",
                            "target_lang_translations": {
                                "en": "The <w>report</w> about the team's victory was in all the newspapers.",
                                "ru": "<w>Сообщение</w> о победе команды было во всех газетах."
                            }
                        },
                        {
                            "text": "Niemand had verwacht dat dit droevige <w>bericht</w> zo plotseling zou komen.",
                            "target_lang_translations": {
                                "en": "No one expected this sad <w>news</w> to come so suddenly.",
                                "ru": "Никто не ожидал, что это печальное <w>известие</w> придет так внезапно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "officieel bericht",
                        "laatste bericht"
                    ],
                    "target_lang_definitions": {
                        "en": "Information about a recent event, often distributed via the media.",
                        "ru": "Информация о недавнем событии, часто распространяемая через средства массовой информации."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "report",
                                "target_lang_sense_clarification": "an account of an event in the news"
                            },
                            {
                                "target_lang_word": "news item",
                                "target_lang_sense_clarification": "a specific piece of news"
                            },
                            {
                                "target_lang_word": "message",
                                "target_lang_sense_clarification": "a communication about a recent event"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сообщение",
                                "target_lang_sense_clarification": "информационная заметка в СМИ"
                            },
                            {
                                "target_lang_word": "новость",
                                "target_lang_sense_clarification": "информация о недавних событиях"
                            },
                            {
                                "target_lang_word": "репортаж",
                                "target_lang_sense_clarification": "отчет о событии"
                            },
                            {
                                "target_lang_word": "известие",
                                "target_lang_sense_clarification": "публичное уведомление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79dd8883-3ca3-341b-b597-1c2d932cbec7",
                    "sense_definition": "De eerste, tweede of derde persoon enkelvoud tegenwoordige tijd van <w>berichten</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bericht</w> u zodra er meer nieuws is over de situatie.",
                            "target_lang_translations": {
                                "en": "I will <w>notify</w> you as soon as there is more news about the situation.",
                                "ru": "Я <w>сообщу</w> вам, как только появится больше новостей о ситуации."
                            }
                        },
                        {
                            "text": "De journalist <w>bericht</w> dagelijks over de ontwikkelingen in het buitenland.",
                            "target_lang_translations": {
                                "en": "The journalist <w>reports</w> daily on developments abroad.",
                                "ru": "Журналист ежедневно <w>сообщает</w> о событиях за рубежом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first, second, or third person singular present tense of 'berichten' (to report/notify).",
                        "ru": "Форма первого, второго или третьего лица единственного числа настоящего времени глагола 'berichten' (сообщать, докладывать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "report",
                                "target_lang_sense_clarification": "to give an account of something"
                            },
                            {
                                "target_lang_word": "notify",
                                "target_lang_sense_clarification": "to inform someone officially"
                            },
                            {
                                "target_lang_word": "message",
                                "target_lang_sense_clarification": "to send a message to someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сообщаю",
                                "target_lang_sense_clarification": "передаю информацию (1-е лицо)"
                            },
                            {
                                "target_lang_word": "сообщает",
                                "target_lang_sense_clarification": "передает информацию (3-е лицо)"
                            },
                            {
                                "target_lang_word": "докладывает",
                                "target_lang_sense_clarification": "официально информирует"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb814848-7ca4-39dc-b12e-685e1650a2dd",
                    "sense_definition": "Het voltooid deelwoord van <w>berichten</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuigen hebben uitgebreid over het ongeval <w>bericht</w> aan de politie.",
                            "target_lang_translations": {
                                "en": "The witnesses <w>reported</w> extensively on the accident to the police.",
                                "ru": "Свидетели подробно <w>сообщили</w> полиции о происшествии."
                            }
                        },
                        {
                            "text": "Er is gisteren al over deze nieuwe wet <w>bericht</w> in de media.",
                            "target_lang_translations": {
                                "en": "This new law was already <w>reported</w> on in the media yesterday.",
                                "ru": "Вчера в СМИ уже <w>сообщалось</w> об этом новом законе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The past participle of 'berichten' (to report/notify).",
                        "ru": "Причастие прошедшего времени глагола 'berichten' (сообщать, докладывать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reported",
                                "target_lang_sense_clarification": "having given an account of something"
                            },
                            {
                                "target_lang_word": "notified",
                                "target_lang_sense_clarification": "having informed someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сообщил",
                                "target_lang_sense_clarification": "уже передал информацию"
                            },
                            {
                                "target_lang_word": "доложил",
                                "target_lang_sense_clarification": "уже представил отчет"
                            },
                            {
                                "target_lang_word": "сообщено",
                                "target_lang_sense_clarification": "было передано (пассивная форма)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b911d4c8-a4cc-395b-9f72-9e4c542b60ed",
                    "sense_definition": "De gebiedende wijs van <w>berichten</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bericht</w> ons onmiddellijk als er iets verandert in de planning.",
                            "target_lang_translations": {
                                "en": "<w>Notify</w> us immediately if anything changes in the planning.",
                                "ru": "<w>Сообщите</w> нам немедленно, если в планах что-то изменится."
                            }
                        },
                        {
                            "text": "<w>Bericht</w> de directie over de voortgang van het project.",
                            "target_lang_translations": {
                                "en": "<w>Report</w> to the management on the progress of the project.",
                                "ru": "<w>Доложите</w> руководству о ходе реализации проекта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'berichten' (to report/notify).",
                        "ru": "Повелительное наклонение глагола 'berichten' (сообщать, докладывать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "report",
                                "target_lang_sense_clarification": "command to give an account"
                            },
                            {
                                "target_lang_word": "notify",
                                "target_lang_sense_clarification": "command to inform someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сообщите",
                                "target_lang_sense_clarification": "приказ или просьба передать информацию"
                            },
                            {
                                "target_lang_word": "доложите",
                                "target_lang_sense_clarification": "приказ представить отчет"
                            },
                            {
                                "target_lang_word": "известите",
                                "target_lang_sense_clarification": "просьба поставить в известность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
