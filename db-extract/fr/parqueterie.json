                        "glosses": [
                            "Fabrication des parquets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5075645-ac7d-40ea-acbc-ca60c4ec2a92",
                                "sense_id": "fa20a1c4-d3ec-3452-9746-78dba77a105d",
                                "text": "Couvert et Lucas, menuisiers parqueteurs à Bruxelles, ont poussé l’art de la parqueterie à un point qu’aucun pays voisin n’a pu encore atteindre ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "671a086a-07e8-38d5-913d-3f90c865502a",
                        "entry_id": "20fcc453-e4e4-3ab6-af5e-40f0d862ac9e",
                        "glosses": [
                            "Usine de fabrication des parquets."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cb3a2490-5c42-4246-9fc2-8d79d0923247",
                                "sense_id": "671a086a-07e8-38d5-913d-3f90c865502a",
                                "text": "Je suis donc devenu cariste dans une parqueterie toujours dans le même village. Conduire un chariot élévateur était moins pénible que remuer du bois […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b54d26e-4c75-372b-8e69-e11830ac9d6e",
                        "entry_id": "20fcc453-e4e4-3ab6-af5e-40f0d862ac9e",
                        "glosses": [
                            "Ensemble des parquets d’une pièce, d’une bâtisse, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1224a23d-a003-46e3-9b51-df4abc1afae5",
                                "sense_id": "0b54d26e-4c75-372b-8e69-e11830ac9d6e",
                                "text": "Il visita la Grande Galerie dont il détailla la splendeur, la parqueterie, les pilastres de marbre, les bronzes et les antiques qui paraissaient s’aboucher à travers les trois cent cinquante-sept miroirs."
                            }
                        ]
                    }
