                                    {
                                        "sense_id": "56670433-e5b1-3e21-bc68-71454bb128c2",
                                        "entry_id": "261f7255-4149-31c3-9a47-2ae872985ce0",
                                        "glosses": [
                                            "US and Canada standard form of Ms."
                                        ],
                                        "tags": [
                                            "Canada",
