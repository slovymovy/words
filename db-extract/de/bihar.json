                "senses": [
                    {
                        "sense_id": "6f504688-cebc-3f9c-bc2c-6fc4eb76a964",
                        "entry_id": "07b74c05-1e8a-34ba-9b97-3fa954822a3e",
                        "glosses": [
                            "indischer Bundesstaat im Nordosten Indiens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d60db6-68e8-47ea-8bcf-4c5e0ef3989d",
                                "sense_id": "6f504688-cebc-3f9c-bc2c-6fc4eb76a964",
                                "text": "„Auch die Mohajirin, die 1947 aus dem indischen Bihar nach Ostpakistan umgesiedelt waren, stellten sich gegen die Bengalen, weshalb die Biharis in der Spätphase des Krieges Opfer von Pogromen wurden; eine Flüchtlingswelle der Biharis und anderer Verbündeter des Militärs von Ost- nach Westpakistan war die Folge.“"
                            },
                            {
                                "example_id": "a005a039-e6fc-48c2-8ea9-41a77a976360",
                                "sense_id": "6f504688-cebc-3f9c-bc2c-6fc4eb76a964",
                                "text": "„Das sind die Leute, die Mumbai ruinieren, sagte er oft zu Sartaj, diese Ganwars, die aus Bihar oder Andhra oder maderchod Bangladesh kommen und hier wie die Tiere leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
