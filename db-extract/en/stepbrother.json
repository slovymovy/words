                                            {
                                                "example_id": "003af0f9-31d1-4e95-9f86-4229febcbfbc",
                                                "sense_id": "eed3b9ca-406e-30e3-87d4-d9c87fd6fb4c",
                                                "text": "Honorable homme Jean de Briandas étoit un de ces témoins ; il est dit qu'il étoit frèrâtre, c'est-à-dire beau-frère de Germanet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f6a811-12ff-38bd-8341-f0168d968de8",
                                        "entry_id": "7204df7c-4433-3d5d-a571-d8fe7a3b761e",
