                    },
                    {
                        "sense_id": "8c2e0931-a120-30c9-a2c2-c5e43662ca59",
                        "entry_id": "25059902-ea3b-3351-90a7-1b29fa8da3d9",
                        "glosses": [
                            "protracted, tedious affair, waste of time"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5e5d0194-3fb1-464d-9274-66dfbccc4024",
                                "sense_id": "8c2e0931-a120-30c9-a2c2-c5e43662ca59",
                                "text": "Деви́ца на и́споведи у абба́та:\nПрости́ меня́ о́тче, грешна́, винова́та.\nАбба́т отвеча́ет: Что ж, без каните́ли,\nГрехи́ отпущу́ тебе́ то́лько - в по-... в по-... В посте́ли.",
                                "translation": "A lass on a confession to an abbot:\nForgive me father, I'm sinful, guilty.\nThe abbot replies: Well, no time to waste,\nI will only absolve you in the... the... the bed.",
                                "english": "A lass on a confession to an abbot:\nForgive me father, I'm sinful, guilty.\nThe abbot replies: Well, no time to waste,\nI will only absolve you in the... the... the bed."
                            }
                        ]
                    }
