                "translations": [
                    {
                        "translation_id": "06d1d508-cc03-4d6c-88ff-ea59dedb88e3",
                        "source_entry_id": "809542dd-b590-38d1-8c25-09628845907a",
                        "source_sense_id": "8e52da3d-d211-3d64-baf8-746cd117129b",
                        "source_sense_description": "zuil, pilaar",
                        "target_lang_word": "Pfeiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfeiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d58bdcb2-4fe5-3ee0-b96c-483453d02de1",
                                        "entry_id": "f4f9370e-679d-36ad-b8fc-3917bd734295",
                                        "glosses": [
                                            "ein frei oder an der Wand stehender, mehr oder minder schlanker nur prismatischer, auch runder Körper aus Stein, Holz, Mauerwerk, Kunststoff oder Metall zur Aufnahme von Lasten darüberliegender Bauteile"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76ac33c-fb85-4c88-8655-b49ccee1db82",
                                                "sense_id": "d58bdcb2-4fe5-3ee0-b96c-483453d02de1",
                                                "text": "„Pfeiler müssen einbetoniert werden.“ (my-hammer.de Internet-Beleg)"
                                            },
                                            {
                                                "example_id": "e0848f83-7664-4b2a-b9a1-6e4e49e3352e",
                                                "sense_id": "d58bdcb2-4fe5-3ee0-b96c-483453d02de1",
                                                "text": "„Ursprünglich spannte sich die Brücke mit 16 Rundbögen auf 15 Pfeilern über die Donau.“"
                                            },
                                            {
                                                "example_id": "39dd7f79-8749-4df9-a047-fcd667719349",
                                                "sense_id": "d58bdcb2-4fe5-3ee0-b96c-483453d02de1",
                                                "text": "„Erschöpft vom Lärm und vom Alkohol, von dem er reichlich getrunken hatte, lehnte sich Requiem gegen einen Pfeiler und wartete darauf, dass sie das Feld räumten.“"
                                            },
                                            {
                                                "example_id": "363a2aa8-4a2a-43c3-a25a-2fa377e032a1",
                                                "sense_id": "d58bdcb2-4fe5-3ee0-b96c-483453d02de1",
                                                "text": "„Vom Fenster aus blickte man auf die schwarzen Eisenzäune, die von hohen Pfeilern aus Sandstein gehalten wurden.“"
                                            },
                                            {
                                                "example_id": "64c7ae91-5837-4b62-a2d6-a7ad72ca6cfa",
                                                "sense_id": "d58bdcb2-4fe5-3ee0-b96c-483453d02de1",
                                                "text": "„Während der Hofprediger mit Cécile dies Gespräch führte, schlenderte Gordon am anderen Kanalufer auf seine Wohnung zu, bog aber, als er auf diesem Rückwege die Pfeiler der die Straße kreuzenden Eisenbahnbrücke passiert hatte, zunächst nach links hin in einen wenig belebten Weg ein, um hier, am Potsdamer Bahndamm entlang, ungehinderter seinen Gedanken nachhängen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d4c2ef7-cab9-3c3f-bbf3-f3e2299f1c03",
                                        "entry_id": "f4f9370e-679d-36ad-b8fc-3917bd734295",
                                        "glosses": [
                                            "Stütze einer Gesellschaft oder Einrichtung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0dc9d36-dd22-46d3-814d-eb0c862d69e3",
                                                "sense_id": "7d4c2ef7-cab9-3c3f-bbf3-f3e2299f1c03",
                                                "text": "Dieser Vertrag ist der Pfeiler unseres Zusammenlebens."
                                            },
                                            {
                                                "example_id": "93729aa5-005a-4f8f-b768-557484aec1ab",
                                                "sense_id": "7d4c2ef7-cab9-3c3f-bbf3-f3e2299f1c03",
                                                "text": "„‚Das Ehrenamt ist in Bayern, in Oberfranken, in den Kommunen des Landkreises Kulmbach und speziell auch hier in Marktschorgast ein wichtiger Pfeiler unserer Gesellschaft, ohne das Ehrenamt könnten wir viele Dinge nicht leisten‘, sagte Benker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a1bbc3e9-e48a-30c5-b24a-90bfc68db4d2",
                                        "entry_id": "f4f9370e-679d-36ad-b8fc-3917bd734295",
                                        "glosses": [
                                            "Zahn, der als Trageelement für eine Brücke dient"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b06dc4d-1c60-414a-9da0-1e315b32a7f3",
                                                "sense_id": "a1bbc3e9-e48a-30c5-b24a-90bfc68db4d2",
                                                "text": "Der Pfeiler ist wegen seines parodontalen Abbaus für eine Brücke ungeeignet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
