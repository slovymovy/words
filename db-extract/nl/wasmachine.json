                "senses": [
                    {
                        "sense_id": "f5ab2e7a-4414-309b-b766-1ff76857746b",
                        "entry_id": "5e1872a5-cc40-3397-88ec-15d31917d898",
                        "glosses": [
                            "een apparaat dat op automatische wijze wasgoed reinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaa95f34-8ea1-40f5-995f-e2e758030089",
                                "sense_id": "f5ab2e7a-4414-309b-b766-1ff76857746b",
                                "text": "Ik ben vergeten de wasmachine aan te zetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "60a93f39-5781-310a-9134-6d9881033d47",
                        "entry_id": "5e1872a5-cc40-3397-88ec-15d31917d898",
                        "glosses": [
                            "een apparaat dat op automatische wijze goederen in het algemeen reinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e03b1e-70f9-4153-99e2-048932663130",
                                "sense_id": "60a93f39-5781-310a-9134-6d9881033d47",
                                "text": "Na gebruik worden ze eerst handmatig schoongemaakt en dan gaan ze in een speciale wasmachine. \"Omdat je met zo’n apparaat door darminhoud gaat, kunnen er veel bacteriën op zitten en het blijkt moeilijk om die allemaal te verwijderen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6347816-2741-4cc7-8f29-701edde6acd8",
                        "source_entry_id": "5e1872a5-cc40-3397-88ec-15d31917d898",
                        "source_sense_id": "f5ab2e7a-4414-309b-b766-1ff76857746b",
                        "source_sense_description": "een apparaat dat op automatische wijze wasgoed reinigt",
                        "target_lang_word": "Waschmaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waschmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59f6f262-3c7f-367d-85d7-53a70d1e773b",
                                        "entry_id": "e2a2aa60-27ce-3e63-974a-b712f85f5028",
                                        "glosses": [
                                            "elektrisches Haushaltsgerät zum Waschen von Kleidung"
                                        ],
                                        "tags": [
                                            "Haushaltsgerät"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d3c022-ac53-476c-a083-fe7638843c80",
                                                "sense_id": "59f6f262-3c7f-367d-85d7-53a70d1e773b",
                                                "text": "Der Hausmann wäscht die Wäsche in der Waschmaschine."
                                            },
                                            {
                                                "example_id": "224eb715-4147-437a-b894-0697e84da0fc",
                                                "sense_id": "59f6f262-3c7f-367d-85d7-53a70d1e773b",
                                                "text": "„In die Schlucht hatte jemand eine alte Waschmaschine geworfen.“"
                                            },
                                            {
                                                "example_id": "0cda2792-a196-4879-9ba4-1a35720cd78d",
                                                "sense_id": "59f6f262-3c7f-367d-85d7-53a70d1e773b",
                                                "text": "„Ob eine Waschmaschine langlebig und reparabel ist, habe aber genau genommen mit dem Röhrchen zu tun, sagt Eisenriegler. Denn bei Billigwaschmaschinen würden zuerst diese kaputtgehen, um dann in der Folge das Lager der Waschmaschinen zu zerstören.“"
                                            },
                                            {
                                                "example_id": "58954a4b-e5fc-4f2c-9363-e2da7a05f984",
                                                "sense_id": "59f6f262-3c7f-367d-85d7-53a70d1e773b",
                                                "text": "„Der Herrenmensch von heute besitzt Waschmaschine und Elektronengehirn.“"
                                            },
                                            {
                                                "example_id": "11d030ee-7f49-4b2f-af1b-d4dc88e94541",
                                                "sense_id": "59f6f262-3c7f-367d-85d7-53a70d1e773b",
                                                "text": "„Ich sah mich Waschmaschinen zertrümmern, sie mit einem zehnpfündigen Hammer zusammenschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c4a553d-1579-47d0-a352-d5f83b190599",
                        "source_entry_id": "5e1872a5-cc40-3397-88ec-15d31917d898",
