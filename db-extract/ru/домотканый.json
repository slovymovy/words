                                        "glosses": [
                                            "von jemandem eigenhändig durch Weben angefertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eafee3f7-61cf-4bd7-8f7a-11b78dc2df87",
                                                "sense_id": "34a2bc74-3bcd-3c09-beb7-0bb3a8291220",
                                                "text": "„Ein großer, handgewebter Teppich mit einem seltsamen, oktopoiden Muster bedeckte die Mitte des Fußbodens, und alle Möbel befanden sich in dem Raum zwischen den Wänden und dem Teppich, auf welchem überhaupt nichts stand.“"
                                            }
                                        ],
