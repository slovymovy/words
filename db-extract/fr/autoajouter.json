                "senses": [
                    {
                        "sense_id": "a4d8fde0-6b7e-34e6-89e1-c5e274f22157",
                        "entry_id": "b726098c-361b-37b4-a0e3-b1a88ecb2d79",
                        "glosses": [
                            "Ajouter automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653c3043-cd66-44ca-afb4-ca1f1759056f",
                                "sense_id": "a4d8fde0-6b7e-34e6-89e1-c5e274f22157",
                                "text": "Permet d'autoajouter ce domaine à la fin des noms d'utilisateur si le domaine n'est pas spécifié."
                            }
                        ]
                    },
                    {
                        "sense_id": "e698d403-5c36-321b-a0cd-fdba5570e54f",
                        "entry_id": "b726098c-361b-37b4-a0e3-b1a88ecb2d79",
                        "glosses": [
                            "S’ajouter automatiquement."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "541885ca-023e-46f3-8a8f-784fb1a05cfe",
                                "sense_id": "e698d403-5c36-321b-a0cd-fdba5570e54f",
                                "text": "Donc, si j'ai bien compris, tu souhaiterais que deux objets d'une même classe puissent s'autoajouter à la volée des méthodes distinctes ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7048064b-2a65-3a78-9af8-3a9609f5b1b5",
                        "entry_id": "b726098c-361b-37b4-a0e3-b1a88ecb2d79",
                        "glosses": [
                            "S’ajouter soi-même."
                        ],
                        "tags": [
