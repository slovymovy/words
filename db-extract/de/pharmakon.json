                        ]
                    },
                    {
                        "translation_id": "6156354f-4507-453f-8a66-ba00cd026752",
                        "source_entry_id": "72a1e4ae-35b7-37b0-8166-c7a1bfa7c0af",
                        "source_sense_id": "2f6be835-1c61-3a01-b214-5f2724fad474",
                        "source_sense_description": "Medikament",
                        "target_lang_word": "drug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfa52867-92b7-3958-afe8-4ec0cd85c7ea",
                                        "entry_id": "8b151687-7442-39f5-b8d7-8c620d63ecbf",
                                        "glosses": [
                                            "A substance used to treat an illness, relieve a symptom, or modify a chemical process in the body for a specific purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da324904-b473-487c-9120-6f7a29bd3381",
                                                "sense_id": "cfa52867-92b7-3958-afe8-4ec0cd85c7ea",
                                                "text": "Aspirin is a drug that reduces pain, acts against inflammation and lowers body temperature."
                                            },
                                            {
                                                "example_id": "841d1914-7e37-4fa0-b41a-5ddc305c7f6b",
                                                "sense_id": "cfa52867-92b7-3958-afe8-4ec0cd85c7ea",
                                                "text": "The revenues from both brand-name drugs and generic drugs have increased."
                                            },
                                            {
                                                "example_id": "7a63a04e-42a5-4d3a-b537-d25fb4d2a5ec",
                                                "sense_id": "cfa52867-92b7-3958-afe8-4ec0cd85c7ea",
                                                "text": "whence merchants bring their spicy drugs"
                                            },
                                            {
                                                "example_id": "c864f33f-4c99-4920-b9af-79b8e1a13ac5",
                                                "sense_id": "cfa52867-92b7-3958-afe8-4ec0cd85c7ea",
                                                "text": "In the future, he says, a focus on the hate circuit may open new avenues for treatment – including new drugs and psychotherapies – that target this and other specific circuits in the brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                        "entry_id": "8b151687-7442-39f5-b8d7-8c620d63ecbf",
                                        "glosses": [
                                            "A psychoactive substance, especially one which is illegal and addictive, ingested for recreational use, such as cocaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b592002d-ec39-4d7a-bb1b-a76ac99c038b",
                                                "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                                "text": "We took drugs and partied all night."
                                            },
                                            {
                                                "example_id": "6add9d36-5fbb-4b05-9eb3-1444ce5754d2",
                                                "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                                "text": "They're on drugs."
                                            },
                                            {
                                                "example_id": "4ba077b9-9338-4fee-a46c-6acc0fde33b6",
                                                "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                                "text": "She used to be a drug addict."
                                            },
                                            {
                                                "example_id": "1c38a128-eccb-4a58-a313-dbb5e47603b0",
                                                "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                                "text": "We were somewhere around Barstow on the edge of the desert when the drugs began to take hold."
                                            },
                                            {
                                                "example_id": "96b3af9b-d3f5-436b-a1e5-81f45c757eee",
                                                "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                                "text": "You have a twelve-year-old kid being told from the time he's like five years old that all drugs are bad, they're going to screw you up, don't try them. Just say no. Then they try pot."
                                            },
                                            {
                                                "example_id": "f107ad89-5321-4251-af70-f57d73aa90ea",
                                                "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                                "text": "The only thing working against the poor Drug Abuse Resistance Officer is high-school students. ... He'd offer his simple lesson: Drugs are bad, people who use drugs are bad, and abstinence is the only answer."
                                            },
                                            {
                                                "example_id": "09ae3e4e-a5f9-4924-91b0-fb37d88d0b7f",
                                                "sense_id": "96fff67d-bf84-3f51-ae56-720fd0231c11",
                                                "text": "Cannabis use disorder is usually defined as a problematic use of the drug: developing tolerance to weed; using cannabis in larger amounts or over a longer period than intended; being unable to reduce use; spending a lot of time obtaining, using or recovering from the effects of cannabis; giving up important activities and obligations in favor of cannabis; and continued use of the drug despite negative consequences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99051595-dfc5-3ebd-bf5c-61393eef8527",
                                        "entry_id": "8b151687-7442-39f5-b8d7-8c620d63ecbf",
                                        "glosses": [
                                            "Anything, such as a substance, emotion, or action, to which one is addicted."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b046d4f7-fded-4d05-ae65-d0a0a7478aac",
                                                "sense_id": "99051595-dfc5-3ebd-bf5c-61393eef8527",
                                                "text": "Oh, get that buzz / Love is the drug / I'm thinking of"
                                            },
                                            {
                                                "example_id": "ffa1e8c5-079e-4247-8921-b6a61e174e54",
                                                "sense_id": "99051595-dfc5-3ebd-bf5c-61393eef8527",
                                                "text": "Inspiration is my drug. Such things as spirituality, booze, travel, psychedelics, contemplation, music, dance, laughter, wilderness, and ribaldry — these have simply been the different forms of the drug of inspiration for which I have had great need […]"
                                            },
                                            {
                                                "example_id": "9dcbcdd9-6648-4f69-84b4-f5c17ec157e3",
                                                "sense_id": "99051595-dfc5-3ebd-bf5c-61393eef8527",
                                                "text": "Fear was my drug of choice. I thrived on scary movies, ghost stories and rollercoasters. I dreamed of playing the last girl left alive in a slasher film — the one who screams herself hoarse as she discovers her friends' bodies one by one."
                                            },
                                            {
                                                "example_id": "3959aba9-ddbe-4d46-b99c-6647762cf330",
                                                "sense_id": "99051595-dfc5-3ebd-bf5c-61393eef8527",
                                                "text": "Because your love, your love, your love is my drug"
                                            },
                                            {
                                                "example_id": "8512d09c-b664-4ef3-8a0d-a290645a2b9a",
                                                "sense_id": "99051595-dfc5-3ebd-bf5c-61393eef8527",
                                                "text": "The truth is...eating is my drug. When I am upset, I eat...when I am sad, I eat...when I am happy, I eat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec492ae9-90cf-31eb-8275-82f78603b3cf",
                                        "entry_id": "8b151687-7442-39f5-b8d7-8c620d63ecbf",
                                        "glosses": [
                                            "Any commodity that lies on hand, or is not salable; an article of slow sale, or in no demand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a2e6d7-f543-4a78-a6d7-493060a95867",
                                                "sense_id": "ec492ae9-90cf-31eb-8275-82f78603b3cf",
                                                "text": "And virtue shall a drug become."
                                            },
                                            {
                                                "example_id": "5e3b2575-9415-4ffb-83bd-fb17b92d95b4",
                                                "sense_id": "ec492ae9-90cf-31eb-8275-82f78603b3cf",
                                                "text": "[…] Sermons are mere Drugs. The Trade is ſo vaſtly ſtocked vvith them, that really unleſs they come out vvith the Name of VVhitfield [i.e, George Whitefield] or VVeſtley [John Wesley], or ſome other ſuch great Man, as a Biſhop, or thoſe ſort of People, I don't care to touch, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f44ffe1-ee3d-3c8d-a425-5c6b8a45c977",
                                        "entry_id": "8b151687-7442-39f5-b8d7-8c620d63ecbf",
                                        "glosses": [
                                            "Ellipsis of drugstore."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6207a08-46c4-4388-819e-e393572fa9d1",
                                                "sense_id": "1f44ffe1-ee3d-3c8d-a425-5c6b8a45c977",
                                                "text": "“I’ll go this far,” I answered him. “We’ll try going over to the drug. You, me, Ollie if he wants to go, one or two others. Then we’ll talk it over again.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84165857-9a43-3e3f-aa0b-14a4f5170ffe",
                                        "entry_id": "77f06347-3639-36b9-a1a9-5035680781a7",
                                        "glosses": [
                                            "To administer intoxicating drugs to, generally without the recipient's knowledge or consent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb09ebfd-7309-426c-b076-0c2d905dc36a",
                                                "sense_id": "84165857-9a43-3e3f-aa0b-14a4f5170ffe",
                                                "text": "She suddenly felt strange, and only then realized she'd been drugged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49a58d48-5bce-3beb-8193-3d72128cc2bb",
                                        "entry_id": "77f06347-3639-36b9-a1a9-5035680781a7",
                                        "glosses": [
                                            "To add intoxicating drugs to with the intention of drugging someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "404cdf27-2a32-4ba6-8cac-c3443fa7fe9f",
                                                "sense_id": "49a58d48-5bce-3beb-8193-3d72128cc2bb",
                                                "text": "She suddenly felt strange. She realized her drink must have been drugged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1ba081-0cfd-34fd-8ace-4d3c6e7fb2a3",
                                        "entry_id": "77f06347-3639-36b9-a1a9-5035680781a7",
                                        "glosses": [
                                            "To prescribe or administer drugs or medicines."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ac2ff5-14f6-4c1a-a2f5-34bad10c596d",
                                                "sense_id": "ca1ba081-0cfd-34fd-8ace-4d3c6e7fb2a3",
                                                "text": "Past all the doses of your drugging doctors"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5329a8c5-7204-363b-93e0-e28b66229b88",
                                        "entry_id": "77f06347-3639-36b9-a1a9-5035680781a7",
                                        "glosses": [
                                            "To use intoxicating drugs."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd28357a-1bf0-45b3-83cb-7292330e0199",
                                                "sense_id": "5329a8c5-7204-363b-93e0-e28b66229b88",
                                                "text": "To soften the blow from working in such unfamiliar territory, I drank and drugged at the end of the day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85c758d2-b76f-3b58-95ac-534176352aa6",
                                        "entry_id": "c7c38d93-6fbf-3d70-afac-006dd895fdc7",
                                        "glosses": [
                                            "simple past and past participle of drag"
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "dialectal",
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "882abd6e-b6db-458e-ae5f-978890cb1d76",
                                                "sense_id": "85c758d2-b76f-3b58-95ac-534176352aa6",
                                                "text": "You look like someone drug you behind a horse for half a mile."
                                            },
                                            {
                                                "example_id": "86c67b2b-2995-48c4-bf4c-5a3127e32d13",
                                                "sense_id": "85c758d2-b76f-3b58-95ac-534176352aa6",
                                                "text": "look what the cat drug in"
                                            },
                                            {
                                                "example_id": "9a5f05e2-4648-449b-baf0-f4a597698358",
                                                "sense_id": "85c758d2-b76f-3b58-95ac-534176352aa6",
                                                "text": "[…] their faces were masked, so that no one, seeing a free and graceful gesture or a pretty face, would feel like something the cat drug in."
                                            },
                                            {
                                                "example_id": "be49fc58-f334-47d4-93d3-6f06dd4db720",
                                                "sense_id": "85c758d2-b76f-3b58-95ac-534176352aa6",
                                                "text": "When Blackburn called, I drug the telephone cord twenty feet out of the office and sat on the cord while I talked with him."
                                            },
                                            {
                                                "example_id": "986a6da6-7c07-43b2-9d9b-5ee5d55c46f0",
                                                "sense_id": "85c758d2-b76f-3b58-95ac-534176352aa6",
                                                "text": "It's about time you drug it home, Jeff!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92f841af-3a64-38ef-a94a-025b5ac9d069",
                                        "entry_id": "3817f404-6858-3ae7-9304-f0ee712d8ebd",
                                        "glosses": [
                                            "A drudge."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a3a78cc-4a9a-4b02-8d38-4b8642a47617",
                                                "sense_id": "92f841af-3a64-38ef-a94a-025b5ac9d069",
                                                "text": "Hadst thou, like us from our first swath, proceeded / The sweet degrees that this brief world affords / To such as may the passive drugs of it / Freely command, thou wouldst have plunged thyself / In general riot"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
