                            "past"
                        ],
                        "form": "extemporized"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a762d32e-e3a6-35b0-9a3a-9065ee13e9e5",
                        "entry_id": "0336db00-d0d3-3087-8e64-528ec126ecd9",
                        "glosses": [
                            "To perform or speak without prior planning or thought; to act in an impromptu manner; to improvise."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cbf5f62c-30c9-4cb4-922c-24c5f13f6d7d",
                                "sense_id": "a762d32e-e3a6-35b0-9a3a-9065ee13e9e5",
                                "text": "\"Will you please tell me whose music you have been playing?\" . . .\n\"It's nobody's, miss.\"\n\"Do you mean you have been extemporizing all this time?\""
                            },
                            {
                                "example_id": "94df91ea-ce5d-419c-8b91-177ca9793b44",
                                "sense_id": "a762d32e-e3a6-35b0-9a3a-9065ee13e9e5",
                                "text": "But while some of his predecessors liked to extemporize, Obama prefers the message to be just so."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d3c514c-e33b-36bf-9d1f-4876db7dceff",
                        "entry_id": "0336db00-d0d3-3087-8e64-528ec126ecd9",
                        "glosses": [
                            "To adapt, improvise, or devise action or speech in an impromptu or spontaneous manner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c6a9a5d5-8a65-416e-aaee-23bc04f7f382",
                                "sense_id": "4d3c514c-e33b-36bf-9d1f-4876db7dceff",
                                "text": "As the music came fresher on their ears, they danced to its cadence, extemporizing new steps and attitudes."
                            },
                            {
                                "example_id": "aad3621c-8223-4371-9f72-1c37945a1bab",
                                "sense_id": "4d3c514c-e33b-36bf-9d1f-4876db7dceff",
                                "text": "The small jelly-speck, which we call the amoeba, has no organs save what it can extemporize as occasion arises."
                            },
                            {
                                "example_id": "798db93a-ac22-4aa9-bf25-7c29aeafff37",
                                "sense_id": "4d3c514c-e33b-36bf-9d1f-4876db7dceff",
                                "text": "The wine runs into pitchers, washing-basins, shards, chamber- vessels, and other extemporized receptacles."
                            },
                            {
                                "example_id": "78e9ae53-3a11-40a4-aac4-9921767cc35a",
                                "sense_id": "4d3c514c-e33b-36bf-9d1f-4876db7dceff",
                                "text": "His most famous words — \"I have a dream\" — were extemporized."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a07c882-5cc7-4e0e-a0bd-fa2e1973890a",
                        "source_entry_id": "0336db00-d0d3-3087-8e64-528ec126ecd9",
                        "source_sense_description": "to act, particularly to perform or speak, without prior planning or thought",
                        "target_lang_word": "extemporieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extemporieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05d5d2b0-3e67-308f-99b9-8c85c14e55d7",
                                        "entry_id": "922aeea3-9c6e-3fc0-a985-62afe9d79ff4",
                                        "glosses": [
                                            "spontan, aus der Situation heraus sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2948bf94-f91c-480a-8fab-b7aec55cb90d",
                                                "sense_id": "05d5d2b0-3e67-308f-99b9-8c85c14e55d7",
                                                "text": "Er hatte sein Manuskript vergessen und so musste er extemporieren."
                                            },
                                            {
                                                "example_id": "2670ae6f-d35e-4ea8-839f-dbbe551713c8",
                                                "sense_id": "05d5d2b0-3e67-308f-99b9-8c85c14e55d7",
                                                "text": "„Schmidt extemporiert nicht mehr so lange wie früher, es gibt eine größere Chance für Fragen zwischendurch, aber die nimmt er vertraut ungnädig auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "582bbbe2-de61-3068-8e1b-e5561901f123",
                                        "entry_id": "922aeea3-9c6e-3fc0-a985-62afe9d79ff4",
                                        "glosses": [
                                            "improvisiert sprechen"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3e08a2-872e-499e-b1c1-d3dca4ae4d32",
                                                "sense_id": "582bbbe2-de61-3068-8e1b-e5561901f123",
                                                "text": "Er hatte seinen Text vergessen und musste daher extemporieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
