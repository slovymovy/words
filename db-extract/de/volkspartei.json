                "senses": [
                    {
                        "sense_id": "6617b9fa-dbf7-3636-987a-760eaaef32cd",
                        "entry_id": "32587c22-4fae-38ce-8270-3b393fc9377d",
                        "glosses": [
                            "in Mehrparteiensystemen eine Partei, die ein breites Spektrum der Gesellschaft repräsentiert und Wähler in allen Bevölkerungsschichten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e3bb30-ccd8-4888-989e-2816e2fdca3c",
                                "sense_id": "6617b9fa-dbf7-3636-987a-760eaaef32cd",
                                "text": "Die Volksparteien in Deutschland verlieren derzeit stark an Bedeutung."
                            },
                            {
                                "example_id": "fd9a5ab7-9b3a-4c8e-b54d-3c6783e9e33a",
                                "sense_id": "6617b9fa-dbf7-3636-987a-760eaaef32cd",
                                "text": "„Die beiden Volksparteien der jungen Bundesrepublik wurden zum Herz der Demokratie.“"
                            },
                            {
                                "example_id": "f414b295-a188-4ca8-883b-96f39efbf382",
                                "sense_id": "6617b9fa-dbf7-3636-987a-760eaaef32cd",
                                "text": "„Es gab zwei Weltmächte, zwei Fernsehprogramme und zwei große Volksparteien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
