                    },
                    {
                        "translation_id": "e6241c01-d3af-4d6a-9edd-b4b0014ad1e8",
                        "source_entry_id": "8b42e2f8-2698-3656-999e-b58973a64569",
                        "source_sense_description": "resembling a snake",
                        "target_lang_word": "slangachtig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slangachtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                                        "glosses": [
                                            "met de vorm of het gedrag van een langgerekt reptiel zonder poten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0087d79e-3c9f-41ef-a55d-888a35bfc19e",
                                                "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                                                "text": "Het slangachtige dier ging weer snel het water in."
                                            },
                                            {
                                                "example_id": "0627fdb2-bbbf-4117-b457-1bdc1ce825e0",
                                                "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                                                "text": "Maar nu blijkt deze aparte amfibiesoort met zijn slangachtige levensstijl er ook een ‘slangachtige’ gifbeet op na te houden. En mogelijk was de wormsalamander zelfs eerder met deze innovatie, oppert Jared, aangezien wormsalamanders evolutionair gezien honderd miljoen jaar ouder zijn dan slangen."
                                            },
                                            {
                                                "example_id": "2fc1dc2b-b34c-4bf8-a1af-7845b4c7ec01",
                                                "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                                                "text": "Via een Geheime Kamer komt Harry bij een slangachtig Voldemortmonster met dodelijke blik, een basilisk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "994986f1-6bb7-32b0-9543-8dc02fe222a9",
                                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                                        "glosses": [
                                            "onopvallend vloeiend en verrassend snel, als de beweging van een slang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59187727-bae0-4721-b013-209846cc00b3",
                                                "sense_id": "994986f1-6bb7-32b0-9543-8dc02fe222a9",
                                                "text": "Op het rechte stuk haalt een shorttracker zijn schaatsen bijna niet van het ijs. Ze glijden, maken met de ijzers haast slangachtige bewegingen en kijken zo nu en dan over hun schouder om eventuele inhaalacties te pareren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf8671c9-81a1-37c6-b24c-de7270fa8a9c",
                                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                                        "glosses": [
                                            "zonder medegevoel met kwaadaardige bedoelingen misleidend"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4046fde7-1971-40f3-a89d-f1c2f3ca955e",
                                                "sense_id": "cf8671c9-81a1-37c6-b24c-de7270fa8a9c",
                                                "text": "Michaël Pas als Jago is ijzersterk in zijn listige, slangachtige woordenspel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234047d2-9d2a-35f2-9f01-2fa254c19b0a",
                                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                                        "glosses": [
                                            "met een zeer langgerekte gladde, ronde vorm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37e4784-b0c2-4767-86c2-89187923958f",
                                                "sense_id": "234047d2-9d2a-35f2-9f01-2fa254c19b0a",
                                                "text": "Zo liet Almere René van Zuuk een slangachtig gebouw ontwerpen en stelde Den Haag zich kandidaat met twee gigantische boomstronken van Liesbeth van der Pol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7056e15-6dd2-4e34-929c-c9817e8cf332",
                        "source_entry_id": "8b42e2f8-2698-3656-999e-b58973a64569",
                        "source_sense_description": "resembling a snake",
                        "target_lang_word": "schlangenartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlangenartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c61f92-6fd1-383b-9c2c-28037dd1a0e4",
                                        "entry_id": "024cd8ae-a710-34a3-a780-fbd209115f47",
                                        "glosses": [
                                            "einer Schlange ähnelnd, an eine Schlange erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c213e83c-447d-4178-b210-762583be4e73",
                                                "sense_id": "f9c61f92-6fd1-383b-9c2c-28037dd1a0e4",
                                                "text": "„Nein, hier gab es keine Blumen, nur das schlangenartige Muster eines sich windenden, röhrenförmigen Organismus, der sich von der Wand zu lösen drohte, wenn ich nur einen Augenblick lang wegschaute.“"
                                            },
                                            {
                                                "example_id": "e5579b83-1245-42ce-812b-3c95aa46e689",
                                                "sense_id": "f9c61f92-6fd1-383b-9c2c-28037dd1a0e4",
                                                "text": "„»Nein!«, brüllte Pal und ließ seine Hand nach vorn schnellen, und zu seinem eigenen Erstaunen fing er das schlangenartige Glied in der Luft ab und hielt es mit festem Griff.“"
                                            },
                                            {
                                                "example_id": "acb02172-67d2-4149-b813-99a4a7930335",
                                                "sense_id": "f9c61f92-6fd1-383b-9c2c-28037dd1a0e4",
                                                "text": "„Eine schlangenartige Kreatur segelte über einen kupferroten Himmel, Kopf und Schwanz hingen schlaff von der Körpermitte herab, an der ein einzelner Fledermausflügel rotierte.“"
                                            },
                                            {
                                                "example_id": "b752cdd4-aa1d-4cd8-8ad8-2500a9ffeee4",
                                                "sense_id": "f9c61f92-6fd1-383b-9c2c-28037dd1a0e4",
                                                "text": "„Das Haar fiel in schlangenartigen Strähnen über sein kantiges, unmenschliches Gesicht, das schlaffe, schiefe Lippen über gelben Reißzähnen, flache, breite Nasenlöcher und große gelbe Schlitzaugen offenbarte.“"
                                            },
                                            {
                                                "example_id": "b0dd2b6f-219e-4175-999b-d9ab46596735",
                                                "sense_id": "f9c61f92-6fd1-383b-9c2c-28037dd1a0e4",
                                                "text": "„Anschließend schwebte der Vogel, während er den langen, schlangenartigen Hals nach hinten verdrehte und das Auge wachsam auf Ralibar Vooz gerichtet hielt, zwischen den Lavagraten langsam auf die pyramidenförmigen Kegel des Voormithadreth zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
