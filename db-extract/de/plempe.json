                                "sense_id": "60e78c39-330a-32d2-818e-0bcd1bff2ba2",
                                "text": "Diese Plempe wurde 1865 bei einer Mensur in Prag benutzt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "607486e7-e47c-3b6c-9643-15dd0480bdd2",
