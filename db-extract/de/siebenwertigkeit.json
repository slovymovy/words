                "senses": [
                    {
                        "sense_id": "b49dd1b9-0f6a-35ef-b493-dd5e581458e0",
                        "entry_id": "dc63cd2f-2b96-3faf-9a4d-19103118a0c4",
                        "glosses": [
                            "Eigenschaft, mit sieben anderen Atom eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccdc32f9-65d7-4457-a925-e18f7a3681cd",
                                "sense_id": "b49dd1b9-0f6a-35ef-b493-dd5e581458e0",
                                "text": "„Wenden wir nun dies Gesetz auf den Wasserstoff an, den wir als einwertig kennen, dem zunächst aber einmal eine mögliche Siebenwertigkeit unterstellt werden mag, so können wir ihm nur einen Platz in der Vertikalspalte I oder VII geben.“"
                            },
                            {
                                "example_id": "5ac56030-8f8a-416d-98f1-e80793b37241",
                                "sense_id": "b49dd1b9-0f6a-35ef-b493-dd5e581458e0",
                                "text": "„Das Mangan hatten wir als ein Element kennengelernt, das in den verschiedensten Wertigkeitsstufen bis herauf zur Siebenwertigkeit vorliegen kann, während das Kupfer nur ein- und zweiwertig auftritt.“"
                            },
                            {
                                "example_id": "d3c5b18a-bafd-43bc-9469-aa2c131c4562",
                                "sense_id": "b49dd1b9-0f6a-35ef-b493-dd5e581458e0",
                                "text": "„Schon um die Sauerstoffverbindungen der Haloide erklären zu können, hat man ihnen Siebenwertigkeit gegeben.“"
                            },
                            {
                                "example_id": "be6538d7-c94c-4c94-a6cf-d3f614794594",
                                "sense_id": "b49dd1b9-0f6a-35ef-b493-dd5e581458e0",
                                "text": "„Wasserstoff und Metallen gegenüber sind sie einwertig, Sauerstoff gegenüber können sie bis zur Siebenwertigkeit auftreten.“"
                            },
                            {
                                "example_id": "d8e0b4fd-7668-4bb7-b60a-4918d99472d9",
                                "sense_id": "b49dd1b9-0f6a-35ef-b493-dd5e581458e0",
                                "text": "„So ist etwa eine Oxidation von Sauerstoff und Fluor zur Sechs- und Siebenwertigkeit unmöglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
