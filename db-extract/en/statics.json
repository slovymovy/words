                    {
                        "translation_id": "bc691675-df82-4469-ab88-a36094af0ebf",
                        "source_entry_id": "5ec88f0c-0940-3c5d-a680-f02698568471",
                        "source_sense_id": "254d006b-7e8b-3311-94b9-927c13daaa7d",
