                "senses": [
                    {
                        "sense_id": "0a8258da-18b1-33d0-8e56-89d6a30caa43",
                        "entry_id": "33be5b0e-bb34-320c-a8ac-c2131950bf3f",
                        "glosses": [
                            "Verzeichnis, das Eintragungen über die angemeldeten Vereine im Bereich des zuständigen Amtsgerichts enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1beb9251-2992-4692-ab55-0dac4e85ff14",
                                "sense_id": "0a8258da-18b1-33d0-8e56-89d6a30caa43",
                                "text": "Auf Antrag kann sich ein Verein in das Vereinsregister eintragen lassen; er wird dann zu einem eingetragenen Verein (e.V.)."
                            },
                            {
                                "example_id": "458d9986-741e-4b94-ab89-601df95db36d",
                                "sense_id": "0a8258da-18b1-33d0-8e56-89d6a30caa43",
                                "text": "Unser Kegelverein wurde aufgelöst und danach im Vereinsregister gelöscht."
                            },
                            {
                                "example_id": "4b4e3604-2100-415f-b319-90ea1b6faf07",
                                "sense_id": "0a8258da-18b1-33d0-8e56-89d6a30caa43",
                                "text": "Über das elektronische Registerportal kann man in den Vereinsregistern sämtlicher Bundesländer recherchieren."
                            }
                        ],
