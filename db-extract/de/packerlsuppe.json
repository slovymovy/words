                        "glosses": [
                            "getrocknete, in einer Tüte oder Ähnlichem verpackte Zutaten, die mit heißem Wasser übergossen eine sogleich essbare Suppe ergeben"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "ea6fb933-0a13-4ad7-b2d2-a9ef84e4ada5",
                                "sense_id": "d166f923-8cde-3eab-9531-841bbe93ddf4",
                                "text": "Leider hatte ich heute keine Zeit, ordentlich zu kochen, deshalb muss mein Mann mit einer chinesischen Packerlsuppe zufrieden sein."
                            },
                            {
                                "example_id": "ff2a1b4d-bc10-43c6-b112-dfdae5700876",
                                "sense_id": "d166f923-8cde-3eab-9531-841bbe93ddf4",
                                "text": "Im ganzen Büro stinkt es mittags nach Packerlsuppe."
                            }
                        ],
