{
    "word_family": [
        "early",
        "earliness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "832d4e09-1d5e-33c0-976b-1419ee36b4f4",
                    "sense_definition": "At a time before the present or before a specific point in time; previously.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spoke to my doctor <w>earlier</w> today about my test results.",
                            "target_lang_translations": {
                                "es": "Hablé con mi médico <w>antes</w> hoy sobre los resultados de mis análisis.",
                                "fr": "J'ai parlé à mon médecin <w>plus tôt</w> aujourd'hui à propos des résultats de mes analyses."
                            }
                        },
                        {
                            "text": "As we mentioned <w>earlier</w>, the museum will be closed next Monday.",
                            "target_lang_translations": {
                                "es": "Como mencionamos <w>anteriormente</w>, el museo estará cerrado el próximo lunes.",
                                "fr": "Comme nous l'avons mentionné <w>précédemment</w>, le musée sera fermé lundi prochain."
                            }
                        }
                    ],
                    "synonyms": [
                        "before",
                        "previously",
                        "sooner"
                    ],
                    "antonyms": [
                        "later"
                    ],
                    "common_phrases": [
                        "earlier today",
                        "earlier this week",
                        "earlier this morning",
                        "as mentioned earlier"
                    ],
                    "target_lang_definitions": {
                        "es": "En un momento previo al presente o a un punto específico en el tiempo; anteriormente.",
                        "fr": "À un moment précédant le présent ou un moment donné ; précédemment, plus tôt."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "antes",
                                "target_lang_sense_clarification": "con anterioridad en el tiempo"
                            },
                            {
                                "target_lang_word": "anteriormente",
                                "target_lang_sense_clarification": "en un momento previo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plus tôt",
                                "target_lang_sense_clarification": "précédemment dans le temps"
                            },
                            {
                                "target_lang_word": "auparavant",
                                "target_lang_sense_clarification": "avant un moment donné"
                            },
                            {
                                "target_lang_word": "précédemment",
                                "target_lang_sense_clarification": "dans un moment antérieur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efcf5e67-863f-3bab-89f6-55f873118f8b",
                    "sense_definition": "Comparative form of <w>early</w>: more early; sooner than usual or expected.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to wake up <w>earlier</w> tomorrow to avoid the morning traffic.",
                            "target_lang_translations": {
                                "es": "Tenemos que despertarnos <w>más temprano</w> mañana para evitar el tráfico de la mañana.",
                                "fr": "Nous devons nous réveiller <w>plus tôt</w> demain pour éviter la circulation matinale."
                            }
                        },
                        {
                            "text": "The train arrived ten minutes <w>earlier</w> than expected.",
                            "target_lang_translations": {
                                "es": "El tren llegó diez minutos <w>antes</w> de lo previsto.",
                                "fr": "Le train est arrivé dix minutes <w>plus tôt</w> que prévu."
                            }
                        }
                    ],
                    "synonyms": [
                        "sooner"
                    ],
                    "antonyms": [
                        "later"
                    ],
                    "common_phrases": [
                        "wake up earlier",
                        "arrive earlier"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma comparativa de «early»: más temprano; antes de lo habitual o de lo previsto.",
                        "fr": "Comparatif de 'early' : de façon plus précoce ou plus matinale qu'habituellement."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "más temprano",
                                "target_lang_sense_clarification": "a una hora más temprana"
                            },
                            {
                                "target_lang_word": "antes",
                                "target_lang_sense_clarification": "con más antelación"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plus tôt",
                                "target_lang_sense_clarification": "de manière plus précoce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a33e4126-f81a-3b97-95ee-43b9c2656fbe",
                    "sense_definition": "Happening, existing, or done before another event, time, or period.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was late because I missed the <w>earlier</w> bus.",
                            "target_lang_translations": {
                                "es": "Llegué tarde porque perdí el autobús <w>anterior</w>.",
                                "fr": "J'étais en retard parce que j'ai manqué le bus <w>précédent</w>."
                            }
                        },
                        {
                            "text": "The author revisits themes explored in his <w>earlier</w> books.",
                            "target_lang_translations": {
                                "es": "El autor retoma temas explorados en sus libros <w>anteriores</w>.",
                                "fr": "L'auteur revisite des thèmes explorés dans ses <w>premiers</w> livres."
                            }
                        }
                    ],
                    "synonyms": [
                        "previous",
                        "prior"
                    ],
                    "antonyms": [
                        "later",
                        "subsequent"
                    ],
                    "common_phrases": [
                        "earlier version",
                        "earlier train",
                        "earlier stage"
                    ],
                    "target_lang_definitions": {
                        "es": "Que ocurrió, existió o se hizo con anterioridad a otro acontecimiento, momento o época.",
                        "fr": "Qui a lieu, existe ou s'est produit avant un autre événement, moment ou période ; antérieur ou précédent."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "anterior",
                                "target_lang_sense_clarification": "que precede a otro"
                            },
                            {
                                "target_lang_word": "previo",
                                "target_lang_sense_clarification": "ocurrido antes"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "précédent",
                                "target_lang_sense_clarification": "qui a eu lieu juste avant"
                            },
                            {
                                "target_lang_word": "antérieur",
                                "target_lang_sense_clarification": "d'une époque ou période passée"
                            },
                            {
                                "target_lang_word": "premier",
                                "target_lang_sense_clarification": "des débuts"
                            }
                        ]
