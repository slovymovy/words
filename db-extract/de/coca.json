                                            {
                                                "example_id": "aa1d3443-b763-42ad-8cd7-466b2a0e1092",
                                                "sense_id": "9bdd1daf-1487-3cc5-918f-278a076dab9e",
                                                "text": "The waiter came up, and I ordered a Coke for her—she didn't drink—and a Scotch and soda for myself, but the sonuvabitch wouldn't bring me one, so I had a Coke, too."
                                            },
                                            {
                                                "example_id": "42aa9fd5-7682-4229-8f4c-382714904899",
                                                "sense_id": "9bdd1daf-1487-3cc5-918f-278a076dab9e",
                                                "text": "'You have a coke and I'll have a beer and we can talk business.'"
                                            }
                                        ]
                                    },
