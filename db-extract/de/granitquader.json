                        "glosses": [
                            "der äußerlichen Gestalt (Form) nach einem Quader gleichendes Stück Granit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6002c86-882d-4219-8b88-99ef5faa1463",
                                "sense_id": "c64d2d8e-6181-3f98-a185-cde80016c841",
                                "text": "„Für einen Granitquader, mit dem die Herren Bürgermeister Ehre einlegen können bei der Dorferneuerung, braucht es Leute, die Steine klopfen können.“"
                            },
                            {
                                "example_id": "c7ec335f-a738-459a-826c-09078b24cc1b",
                                "sense_id": "c64d2d8e-6181-3f98-a185-cde80016c841",
                                "text": "„Das Konzept: massive Granitquader und ein gemauerter Kern, übereinander angeordnete Galerien, verziert mit gusseisernen Säulen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
