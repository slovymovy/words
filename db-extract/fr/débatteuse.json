                        "glosses": [
                            "Celle qui débat, qui participe à un ou plusieurs débats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc7b4afa-c8e7-4427-8ae7-fd2ad650269e",
                                "sense_id": "b48fb418-e503-379c-ae30-45508b06a736",
                                "text": "Personne ne semblait imaginer que je puisse être une bonne débatteuse. Je réalisais combien il est difficile d’échapper à l’image de la femme victime."
                            }
                        ]
