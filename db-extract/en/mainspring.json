                "senses": [
                    {
                        "sense_id": "31192d67-494f-3075-bb3f-1958801d3751",
                        "entry_id": "543c7f94-7447-379f-bbb6-4f413fc5ccf5",
                        "glosses": [
                            "The principal spring of a clockwork mechanism, which drives it by uncoiling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c42002-6a98-4851-9a8b-ecee8c811380",
                                "sense_id": "31192d67-494f-3075-bb3f-1958801d3751",
                                "text": "He was wise, for he had seen a long succession of mechanical toys arrive to boast and swagger, and by-and-by break their mainsprings and pass away."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ac4a48d-4772-33de-95b7-ca51203cadc4",
                        "entry_id": "543c7f94-7447-379f-bbb6-4f413fc5ccf5",
                        "glosses": [
                            "The most important reason for, or element of, something."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "323b0496-a057-450f-82ea-f7e876f71cb3",
                                "sense_id": "0ac4a48d-4772-33de-95b7-ca51203cadc4",
                                "text": "My daughter is the mainspring of my life."
                            },
                            {
                                "example_id": "a8c30deb-6b15-4b7e-af81-4555116ae509",
                                "sense_id": "0ac4a48d-4772-33de-95b7-ca51203cadc4",
                                "text": "But in the England of Shakespeare’s history plays, the mainspring of the system has broken down."
                            }
                        ]
                    }
                ],
