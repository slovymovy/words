                ],
                "senses": [
                    {
                        "sense_id": "769a7b09-63fe-3149-a24e-69b30eb8940e",
                        "entry_id": "5be3c1e1-d5f7-318d-8aab-26975c9f5b6c",
                        "glosses": [
                            "Teil des Gehirns, der Gerüche verarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "438114b2-488b-4482-9f58-f8918e50dfd4",
                                "sense_id": "769a7b09-63fe-3149-a24e-69b30eb8940e",
                                "text": "„Der paarig angelegte Geruchsnerv verläuft von den Riechzellen des Riechepithels, wo die Geruchsreize aufgenommen werden, durch das Siebbein der Nase zum Riechkolben, wo die ankommenden Reize auf das nächste Neuron geleitet werden.“"
                            },
                            {
                                "example_id": "d212e394-4896-48ce-ac37-b0b796013361",
                                "sense_id": "769a7b09-63fe-3149-a24e-69b30eb8940e",
                                "text": "„Im Unterschied zu anderen Sinnesorganen können im Riechkolben ein Leben lang neue Nervenzellen entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "713eed58-3606-3b8c-859d-a4c12415f75c",
                        "entry_id": "5be3c1e1-d5f7-318d-8aab-26975c9f5b6c",
                        "glosses": [
                            "(eindrucksvolle) Nase"
                        ],
                        "tags": [
                            "casual",
                            "colloquial",
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "d6bd03fc-f6de-4697-a23d-f29a2b330d52",
                                "sense_id": "713eed58-3606-3b8c-859d-a4c12415f75c",
                                "text": "„Stattdessen trug [Tycho Brahe] einen Riechkolben aus Kupferfolie.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
