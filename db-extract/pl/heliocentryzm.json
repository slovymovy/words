                                        "entry_id": "48dcf396-c26c-3fb4-a547-4b61579b946a",
                                        "glosses": [
                                            "Théorie scientifique qui place le Soleil au centre du système de planètes entourant la Terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99420723-8e01-4ebc-a4f7-af05dccb2e6e",
                                                "sense_id": "a5208b3c-5869-35b0-83c3-ebb0734703d6",
                                                "text": "Dans ce livre, il combat les tenants de l’héliocentrisme par leurs propres armes, c’est-à-dire par des arguments astronomiques et mathématiques."
                                            }
                                        ]
                                    }
                                ]
