                                "target_senses": [
                                    {
                                        "sense_id": "e94f2556-2efe-374e-b2f5-2c601abea547",
                                        "entry_id": "87de8323-e6bc-34ac-8068-cfde50214dad",
                                        "glosses": [
                                            "Celui ou celle qui sait, qui enseigne l’hydrologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1099ff98-cf09-4f1f-ae49-67b7996eb676",
                                                "sense_id": "e94f2556-2efe-374e-b2f5-2c601abea547",
                                                "text": "Concrètement, notre rôle consiste à définir les contours du cahier des charges, à sélectionner les experts ad hoc, un hydrologue et un architecte paysagiste, et enfin bien sûr à rédiger un rapport."
                                            },
                                            {
                                                "example_id": "3a67a484-8918-4106-9982-fbdbec52564c",
                                                "sense_id": "e94f2556-2efe-374e-b2f5-2c601abea547",
                                                "text": "'Au programme, l’aventurier Bertrand Piccard, l’hydrologue Emma Haziza ou encore le publicitaire Maurice Lévy… — (journal 20 minutes, édition Paris-IDF, 7 février 2024, page 12 (accent ajouuté à Levy))"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e0aa956-421c-484e-9523-596b81043df1",
                        "source_entry_id": "d8256627-6db3-3cfb-ae5f-6125506d5359",
                        "source_sense_id": "0943fdf6-aba4-3d5d-81cd-96e000c88cd8",
                        "source_sense_description": "one who is skilled in or practises hydrology",
                        "target_lang_word": "Hydrologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hydrologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "586340b7-9af7-305f-ac0e-a6d5a853aae3",
                                        "entry_id": "c6ca1b31-c657-3c28-84b1-414dff9bb5b5",
                                        "glosses": [
                                            "in der Hydrologie tätiger Wissenschaftler"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff75e3f-0fe8-4615-ab58-8c9c35399051",
                                                "sense_id": "586340b7-9af7-305f-ac0e-a6d5a853aae3",
                                                "text": "„Auch in Österreich stagniere die Messnetzdichte seit Jahren. ‚Vor allem oberhalb von 2.000 Metern Seehöhe findet man nicht viele Messstellen‘, berichtet der Hydrologe.“"
                                            },
                                            {
                                                "example_id": "4121b1d6-17f2-41e6-b0ed-f75e1a06a075",
                                                "sense_id": "586340b7-9af7-305f-ac0e-a6d5a853aae3",
                                                "text": "„Der Hydrologe fordert daher, öffentliche Gebäude mit Warnsystemen auszustatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a79138f-2758-47c4-b24c-66bc2e35ab4a",
                        "source_entry_id": "d8256627-6db3-3cfb-ae5f-6125506d5359",
                        "source_sense_id": "0943fdf6-aba4-3d5d-81cd-96e000c88cd8",
                        "source_sense_description": "one who is skilled in or practises hydrology",
                        "target_lang_word": "Hydrologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hydrologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eeb5a9a9-69c9-35ba-89d9-ceecfc71a7c9",
                                        "entry_id": "37dd2593-0120-33cf-90bf-1b90cca8f111",
                                        "glosses": [
                                            "in der Hydrologie tätige Wissenschaftlerin"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72373cc6-781f-4707-9feb-d0ee21fe9c73",
                                                "sense_id": "eeb5a9a9-69c9-35ba-89d9-ceecfc71a7c9",
                                                "text": "„Ein Forscherteam um die Hydrologin Anke Hildebrandt konstatierte bei der Untersuchung klare Unterschiede darin, wie sehr der Boden seiner Funktion als Auffangbecken für Niederschläge nachgehen kann.“"
                                            },
                                            {
                                                "example_id": "df1eee8e-8f05-4a00-b4cb-70be10766841",
                                                "sense_id": "eeb5a9a9-69c9-35ba-89d9-ceecfc71a7c9",
                                                "text": "„Die Hydrologin Kumke aus dem Hochwassermeldezentrum beschrieb den Oder-Scheitel so: \"Es ist eine sehr inhaltsreiche, langgezogene Welle.\"“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
