                                            {
                                                "example_id": "2c7907a7-9f9c-4fab-9441-91ebe392ec1c",
                                                "sense_id": "6ecaab28-0b37-356a-b6b1-c30643e4751a",
                                                "text": "Jack and Jill went up the hill / to fetch a pail of water; / Jack fell down and broke his crown / and Jill came tumbling after. / Up Jack got and home did trot, / as fast as he could caper, / to old Dame Dob / to mend his nob / with vinegar and brown paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019a663b-68b7-35d9-bd95-18fa52e9d02f",
                                        "entry_id": "32546c11-2c42-31b2-ae03-419b415e64c1",
                                        "glosses": [
                                            "A jack of the same suit as the card turned up by the dealer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115b6b91-7ec7-4ca4-9a9e-da713e754064",
                                                "sense_id": "019a663b-68b7-35d9-bd95-18fa52e9d02f",
                                                "text": "One for his nob."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3dfb649-1d39-324e-8b20-8585e8d3f8fb",
                                        "entry_id": "32546c11-2c42-31b2-ae03-419b415e64c1",
                                        "glosses": [
                                            "The glans penis, the sensitive bulbous structure at the end of the penis also known as the head of the penis. (Also spelled knob.)"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fab59b83-f648-323d-985f-7eb318a757b4",
                                        "entry_id": "32546c11-2c42-31b2-ae03-419b415e64c1",
                                        "glosses": [
                                            "(vulgar, slang, chiefly UK, Ireland) The penis; dick. (Also spelled knob.)"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca01a547-3a84-3a92-ae5f-aec162ba1430",
                                        "entry_id": "32546c11-2c42-31b2-ae03-419b415e64c1",
                                        "glosses": [
                                            "A contemptible person; dick. (Also spelled knob.)"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d59b9707-4dca-4150-96d2-e6e61e3c08ec",
                                                "sense_id": "ca01a547-3a84-3a92-ae5f-aec162ba1430",
                                                "text": "Col wasn’t impressed with Dick’s patronising comments and turned his back and rolled his eyes whilst at the same time mumbling “Fucking nob, Dick by name Dick by nature” under his breath."
                                            },
                                            {
                                                "example_id": "2e7c94d4-3622-4be7-8fc9-ed57cd74a28e",
                                                "sense_id": "ca01a547-3a84-3a92-ae5f-aec162ba1430",
                                                "text": "Christine would help Kelly with her submission so she didn’t look like a complete nob! And in exchange Kelly would introduce and talk Christine through some of her artistic works: giving her a personal guided tour from her earliest through to her latest pieces."
                                            },
                                            {
                                                "example_id": "68ebd8f5-933e-4819-82b5-4e1f63ef9b59",
                                                "sense_id": "ca01a547-3a84-3a92-ae5f-aec162ba1430",
                                                "text": "I was in a garden […]A place no bloody nob could take away"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0375f36-e4dc-32ee-a0b5-7fda885757d6",
                                        "entry_id": "32546c11-2c42-31b2-ae03-419b415e64c1",
                                        "glosses": [
                                            "A wealthy or influential person; a toff."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "471b3627-f71d-4827-a575-ec6b2e04558f",
                                                "sense_id": "e0375f36-e4dc-32ee-a0b5-7fda885757d6",
                                                "text": "The masses have risen up and shot all their nobs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecfb3257-b358-3764-97bc-45a061edf83a",
                                        "entry_id": "32546c11-2c42-31b2-ae03-419b415e64c1",
                                        "glosses": [
                                            "Obsolete form of knob (“rounded protuberance”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c6abe4-a890-40ef-a0da-f94a07392073",
                                                "sense_id": "ecfb3257-b358-3764-97bc-45a061edf83a",
                                                "text": "He spoke with a lisp, occasioned by the loss of two of his large front teeth, which allowed the tongue as he talked to appear through the opening in a round nob like a raspberry."
                                            }
                                        ]
                                    }
                                ]
