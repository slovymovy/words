                "senses": [
                    {
                        "sense_id": "fe4db1a5-42d5-30bc-9402-203a92d85e8d",
                        "entry_id": "ae73fa7a-6107-311d-a99c-e92e39c61a6f",
                        "glosses": [
                            "Person, die nach einem Punt oder Kickoff des gegnerischen Teams versucht, den Ball zu fangen und möglichst weit zurückzutragen"
                        ],
                        "tags": [
                            "Football"
                        ],
                        "examples": [
                            {
                                "example_id": "5bd323d2-33f8-4bcb-b5c2-66994761faf2",
                                "sense_id": "fe4db1a5-42d5-30bc-9402-203a92d85e8d",
                                "text": "„Zwischen 1923 und 1925 agierte Grange als Ballträger, Passgeber, Punter und Returner und erzielte die für damalige Verhältnisse astronomische Anzahl von 31 Touchdowns selbst.“"
                            },
                            {
                                "example_id": "60f5644a-f6ad-4dc2-84f5-d33732559fc7",
                                "sense_id": "fe4db1a5-42d5-30bc-9402-203a92d85e8d",
                                "text": "„Die Oakland Raiders haben einen neuen Returner: Ex-Vikings-Receiver Cordarrelle Patterson einigte sich am Montag mit den Raiders dem Vernehmen nach auf einen Zweijahresvertrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
