                        "entry_id": "eb046ef7-d2ed-3a9a-acae-f320132a5b53",
                        "glosses": [
                            "Not accepting negative numbers; having only a positive value (or zero)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c74b8ce5-320f-45b1-9752-76644aefb386",
                                "sense_id": "8d41bdff-e788-3641-8542-e9188838bbb5",
                                "text": "We use an unsigned variable to store the employee's salary, since it will never be less than zero."
                            }
                        ]
                    },
                    {
                        "sense_id": "910f945a-4650-3b4f-b551-ef54eb450277",
                        "entry_id": "eb046ef7-d2ed-3a9a-acae-f320132a5b53",
                        "glosses": [
