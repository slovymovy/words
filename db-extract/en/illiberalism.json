                "senses": [
                    {
                        "sense_id": "2f727466-3c5f-355e-886b-d1129728ca45",
                        "entry_id": "d0834528-45db-3479-807d-1171a2581221",
                        "glosses": [
                            "The principle, state or quality of being illiberal."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "084863e2-c9c2-4885-a74a-ead72c905b81",
                                "sense_id": "2f727466-3c5f-355e-886b-d1129728ca45",
                                "text": "As the Oxford political theorist Michael Freeden observed, if just one of the necessary components — for example, the free market — dominates, then the result can be illiberalism."
                            },
                            {
                                "example_id": "b3d8bf39-8364-44eb-8688-ad31afcfa08a",
                                "sense_id": "2f727466-3c5f-355e-886b-d1129728ca45",
                                "text": "In the Netherlands, the anti-immigrant right became the second-most-popular vote-getter — a new high-water mark for illiberalism in that once famously liberal country."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6313d11-f0f5-4fd3-afbf-815fe57fd527",
                        "source_entry_id": "d0834528-45db-3479-807d-1171a2581221",
                        "source_sense_id": "2f727466-3c5f-355e-886b-d1129728ca45",
                        "source_sense_description": "principle, state or quality of being illiberal",
                        "target_lang_word": "illibéralisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illibéralisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                        "entry_id": "8d7ca526-4268-31b8-9312-5d0bcbebf3c8",
                                        "glosses": [
                                            "Refus du libéralisme politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c139c7-1941-419c-bff3-16835258730e",
                                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                                "text": "C’est à tort qu’on accuserait d’illibéralisme ceux qui sont partisans du maintien de la contrainte par corps."
                                            },
                                            {
                                                "example_id": "7c41036a-dd01-4eb1-adf7-7e83fc1317c3",
                                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                                "text": "Plusieurs régimes politiques sont tentés par l’illibéralisme politique."
                                            },
                                            {
                                                "example_id": "beef95c2-0ba6-4ea1-b3b7-7985be876812",
                                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                                "text": "Cette montée de l’illibéralisme a au moins un mérite : elle nous oblige à devoir nous rappeler en quoi nous croyons et pour quelles valeurs nous sommes prêts à nous battre."
                                            },
                                            {
                                                "example_id": "ed28665d-70f7-4e20-a359-d473d038ca42",
                                                "sense_id": "935d3d3f-f708-35ba-a602-b1e14f7a2470",
                                                "text": "Un peu plus à l’est, en Pologne et en Hongrie, c’est l’autoritarisme de la vieille école qui revient en force : illibéralisme, recul des droits des femmes, de la liberté de la presse et de l’indépendance de la justice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
