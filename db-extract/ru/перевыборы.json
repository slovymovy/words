                                        "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "A process of choosing a leader, members of parliament, councillors, or other representatives by popular vote."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d74a606-a414-4cca-a89c-955340734e3c",
                                                "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                                "text": "The parliamentary election(s) will be held in March."
                                            },
                                            {
                                                "example_id": "12cd990e-2869-472d-84ad-dbd5ee12ba06",
                                                "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                                "text": "How did you vote in (UK also: at) the last election?"
                                            },
                                            {
                                                "example_id": "b3fc637f-d7b7-4282-872f-e6633e7f6f09",
                                                "sense_id": "75e8a4a6-caff-3671-a27c-1eb71e272546",
                                                "text": "That brief moment after the election four years ago, when many Americans thought Mr. Obama’s election would presage a new, less fractious political era, now seems very much a thing of the past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d158aa3-4794-3285-a9bd-2adabc1e0544",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "The choice of a leader or representative by popular vote."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42707749-2e58-4045-9301-262e3e16ad7a",
                                                "sense_id": "7d158aa3-4794-3285-a9bd-2adabc1e0544",
                                                "text": "The election of John Smith was due to his broad appeal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "532d3537-3f18-3f62-ba46-a15c77297298",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "An option that is selected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddbdef5b-27ca-4e1c-a661-4ab60ae26f12",
                                                "sense_id": "532d3537-3f18-3f62-ba46-a15c77297298",
                                                "text": "W-4 election"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "Any conscious choice."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50de653d-f5c6-424b-88dc-60b8be5f495e",
                                                "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                                "text": "Whosoever searcheth all the circumstances and embraceth all the consequences thereof hindereth his election."
                                            },
                                            {
                                                "example_id": "199b5f30-188e-46df-9651-5c371e720176",
                                                "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                                "text": "To use men with much difference and election is good."
                                            },
                                            {
                                                "example_id": "39612e8e-b19a-4951-b5ce-6e14e658be1a",
                                                "sense_id": "1287d9ee-b4c2-3ed9-9c9f-d0839f8ad562",
                                                "text": "The predestinative force of a free agent's own will in certain absolute acts, determinations, or elections, and in respect of which acts it is one either with the divine or the devilish will; and if the former, the conclusions to be drawn from God's goodness, faithfulness, and spiritual presence; these supply grounds of argument of a very different character […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af903de8-5e13-348f-8724-1a0ed6c2d09d",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "In Calvinism, God's predestination of saints including all of the elect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4505c11-a094-4a7d-a9d9-589162c5bb72",
                                                "sense_id": "af903de8-5e13-348f-8724-1a0ed6c2d09d",
                                                "text": "[H]e [Paul] laboureth to comfort Timothy vvith the remembrance of the ſtedfaſtneſs of Gods eternal decree of Election, becauſe grounded on his foreknowledge; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0749586-20e3-31fe-b751-904ad0b71cfd",
                                        "entry_id": "8bb79dfb-71d1-3a06-85a7-8a301971e870",
                                        "glosses": [
                                            "Those who are elected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b78fc8a0-48e7-4e94-84c4-09675879eda2",
                                                "sense_id": "e0749586-20e3-31fe-b751-904ad0b71cfd",
                                                "text": "The election hath obtained it."
                                            }
                                        ]
