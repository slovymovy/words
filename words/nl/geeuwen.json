{
    "word_family": [
        "geeuw"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d09a4661-72e0-3974-a2e0-68a78f3482c2",
                    "sense_definition": "onwillekeurig de mond wijd openen en diep in- en uitademen, vaak door vermoeidheid of verveling",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichamelijke functies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De student begon luid te <w>geeuwen</w> tijdens de lange en saaie geschiedenisles.",
                            "target_lang_translations": {
                                "en": "The student started to <w>yawn</w> loudly during the long and boring history lesson."
                            }
                        },
                        {
                            "text": "Als je iemand ziet <w>geeuwen</w>, is de kans groot dat je zelf ook moet gapen.",
                            "target_lang_translations": {
                                "en": "If you see someone <w>yawn</w>, there is a big chance that you will have to gape yourself."
                            }
                        }
                    ],
                    "synonyms": [
                        "gapen"
                    ],
                    "common_phrases": [
                        "luid geeuwen",
                        "onbedwingbaar geeuwen"
                    ],
                    "target_lang_definitions": {
                        "en": "to involuntarily open the mouth wide and inhale and exhale deeply, often due to fatigue or boredom"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yawn",
                                "target_lang_sense_clarification": "to open the mouth wide due to tiredness"
                            },
                            {
                                "target_lang_word": "gape",
                                "target_lang_sense_clarification": "to open the mouth wide"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb1031c3-c28a-35fb-b25b-461c74d060c7",
                    "sense_definition": "meervoud van <w>geeuw</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "lichamelijke functies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een paar diepe <w>geeuwen</w> besloot hij dat het tijd was om naar bed te gaan.",
                            "target_lang_translations": {
                                "en": "After a few deep <w>yawns</w>, he decided it was time to go to bed."
                            }
                        },
                        {
                            "text": "Zijn voortdurende <w>geeuwen</w> lieten duidelijk zien hoe moe hij eigenlijk was.",
                            "target_lang_translations": {
                                "en": "His constant <w>yawns</w> clearly showed how tired he actually was."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of geeuw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the act of opening the mouth wide and breathing deeply"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yawns",
                                "target_lang_sense_clarification": "plural of the act of yawning"
                            }
                        ]
                    }
                }
            ]
        }
    ]
