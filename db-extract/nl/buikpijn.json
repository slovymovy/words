                                    },
                                    {
                                        "sense_id": "c6b9b410-e47d-3533-93d9-3171c9f78cfa",
                                        "entry_id": "71defa4f-ceef-3cd1-95d5-3a6f1d641acd",
                                        "glosses": [
                                            "Schmerzgefühl im Bauch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fda31dd-7f76-402f-ba36-0f4f2edfea40",
                                                "sense_id": "c6b9b410-e47d-3533-93d9-3171c9f78cfa",
                                                "text": "Mich quält seit gestern ein heftiger Bauchschmerz."
                                            },
                                            {
                                                "example_id": "c96dcab2-b56c-4ac4-959a-3bb6c429f20f",
                                                "sense_id": "c6b9b410-e47d-3533-93d9-3171c9f78cfa",
                                                "text": "„Bobby bekam bis tief in die Nacht Bauchschmerzen davon.“"
                                            },
                                            {
                                                "example_id": "90e850a5-260b-49ca-a34c-458d02b10e4d",
                                                "sense_id": "c6b9b410-e47d-3533-93d9-3171c9f78cfa",
                                                "text": "„Die Bauchschmerzen waren nicht mehr zu ignorieren.“"
                                            },
                                            {
                                                "example_id": "a9186121-3001-40ac-905d-03443a275dae",
                                                "sense_id": "c6b9b410-e47d-3533-93d9-3171c9f78cfa",
                                                "text": "„Ich hatte tatsächlich Bauchschmerzen, und zwar aus Angst.“"
                                            },
                                            {
                                                "example_id": "1253e94d-8ea0-447f-96f3-e8e77a38e257",
                                                "sense_id": "c6b9b410-e47d-3533-93d9-3171c9f78cfa",
                                                "text": "„Von rätselhaften Bauchschmerzen fast zerrissen, saß ich mit meiner Mutter vor ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d3c7a94-2c9d-36ff-87e5-6dcafc1d8667",
                                        "entry_id": "71defa4f-ceef-3cd1-95d5-3a6f1d641acd",
                                        "glosses": [
                                            "unangenehmes Gefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7672f8d-baef-4fd7-bb2b-7ea91bf09431",
                                                "sense_id": "4d3c7a94-2c9d-36ff-87e5-6dcafc1d8667",
                                                "text": "Das Übernahmeangebot bereitet einigen Aktionären jedoch Bauchschmerzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
