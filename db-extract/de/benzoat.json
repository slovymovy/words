                        "sense_id": "4251be56-f32e-371f-8cc5-a6de10651d31",
                        "entry_id": "90753a01-32bd-3016-a69d-d3cd67019e7d",
                        "glosses": [
                            "aus der Benzoesäure abgeleitetes Salz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65935c07-46be-42ff-8b8f-9aee385fd328",
                                "sense_id": "4251be56-f32e-371f-8cc5-a6de10651d31",
                                "text": "„So genannte Konservierungsmittel wie etwa Benzoate schützen nicht nur Nahrungsmittel vor Verderb, sondern offenbar auch unsere Zähne.“"
                            },
                            {
                                "example_id": "d60477c3-b7e2-4a56-8a6d-b0f3fb9d3aad",
                                "sense_id": "4251be56-f32e-371f-8cc5-a6de10651d31",
                                "text": "„Benzoate werden Nahrungsmitteln nicht nur künstlich beigefügt, sie kommen auch natürlich etwa in Preiselbeeren, Zwetschgen oder Zimtrinden vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
