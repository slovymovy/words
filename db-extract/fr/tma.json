                            {
                                "target_word": "TMA",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96bef6b3-d708-32cd-955b-0b315d28c4c6",
                                        "entry_id": "9e476f5a-4696-31e6-8b48-56ac50d7bbb2",
                                        "glosses": [
                                            "Initialism of transmisogyny-affected, i.e. transfeminine."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "398904db-6300-4f1f-b5a3-4f939bf0fa5b",
                                                "sense_id": "96bef6b3-d708-32cd-955b-0b315d28c4c6",
                                                "text": "Coordinate term: TME"
                                            },
                                            {
                                                "example_id": "687611b9-d6b5-4e57-9888-21b3e7909e21",
                                                "sense_id": "96bef6b3-d708-32cd-955b-0b315d28c4c6",
                                                "text": "[…] transmisogyny-affected (TMA) people, are in the greatest danger of TERF violence, and thus their critiques take priority in the fight against TERFs. With TMA people routinely excluded from the bounds of academia, […] impacted by transmisogyny; […]"
                                            },
                                            {
                                                "example_id": "df7c6797-04e1-41a7-802c-840f5adaa361",
                                                "sense_id": "96bef6b3-d708-32cd-955b-0b315d28c4c6",
                                                "text": "It is urgently critical to operationalize gender expression when considering the experiences of TNB women and feminine individuals, and even more so with those who are transmisogyny-affected, because policing and weaponizing of feminine gender expression is done with higher intensity for TMA than TME people."
                                            },
                                            {
                                                "example_id": "29bc8aa5-e989-4cc9-a778-90963c2ce6ab",
                                                "sense_id": "96bef6b3-d708-32cd-955b-0b315d28c4c6",
                                                "text": "TMA people are maddened from multiple angles, complex motivations, intentions, and needs flattened into impenetrable problems for disposal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
