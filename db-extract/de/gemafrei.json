                "senses": [
                    {
                        "sense_id": "6a1d6c70-c3ae-318e-8316-67931a8ed1c0",
                        "entry_id": "9866ced3-fe5f-3077-b80f-12850164315b",
                        "glosses": [
                            "so, dass keine Gebühren an die Verwertungsgesellschaft GEMA gezahlt werden müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c07a70-da38-41bc-baf8-765eb4eda9ff",
                                "sense_id": "6a1d6c70-c3ae-318e-8316-67931a8ed1c0",
                                "text": "„Ich äußere kurz meinen Unmut darüber, jetzt zwar jede Menge gemafreie Musik zu kennen, aber immer noch keinen Ansprechpartner am Telefon zu haben, […].“"
                            },
                            {
                                "example_id": "890ead9d-4ec4-4b7b-9cf8-8c60d7d3546d",
                                "sense_id": "6a1d6c70-c3ae-318e-8316-67931a8ed1c0",
                                "text": "„Bei der übrigen Backgroundmusik handelte es sich um eine gemafreie Komposition von Alexander Ester.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
