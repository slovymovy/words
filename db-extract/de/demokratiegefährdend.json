                "senses": [
                    {
                        "sense_id": "4dcf6ccd-0f13-3a84-9925-65608de515c9",
                        "entry_id": "13309415-b266-38a9-b258-f6d970a316c4",
                        "glosses": [
                            "eine Bedrohung/Gefahr für die Demokratie darstellend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f2d09e-6159-4eb6-a215-f5ea88b6bae9",
                                "sense_id": "4dcf6ccd-0f13-3a84-9925-65608de515c9",
                                "text": "„Die Nachkriegszeit ist vorbei, Deutschland ist kein Sonderfall mehr. Es ist insofern kein demokratiegefährdendes Alarmsignal, dass sich eine rechtspopulistische Partei wie die AfD etabliert - es ist vielmehr ein weiterer Schritt zur Normalisierung des Landes im europäischen Kontext.“"
                            },
                            {
                                "example_id": "14ce8c1d-2229-4da4-8d76-25ad5c8adba1",
                                "sense_id": "4dcf6ccd-0f13-3a84-9925-65608de515c9",
                                "text": "„Dagegen hält eine klare Mehrheit von 61 Prozent gezielte Falschnachrichten sogar für demokratiegefährdend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
