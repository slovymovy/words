                                "example_id": "34008190-de39-43ab-9626-e1607119cc84",
                                "sense_id": "e231c8c3-1784-33c7-97b7-c02eb466ded5",
                                "text": "He approached the main subject delicately."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5c9a357-dc12-424a-9d4f-737736f976b2",
