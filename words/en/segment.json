{
    "word_family": [
        "segmentation",
        "segmental"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fc5d57d-9f9a-3a1e-8a54-fcef6d0a9f8c",
                    "sense_definition": "One of the separate parts into which something is naturally divided or can be separated.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She peeled the orange and ate a <w>segment</w>.",
                            "target_lang_translations": {
                                "ru": "Она почистила апельсин и съела <w>дольку</w>."
                            }
                        },
                        {
                            "text": "A large <w>segment</w> of the population voted in favor of the new policy.",
                            "target_lang_translations": {
                                "ru": "Значительный <w>сегмент</w> населения проголосовал за новую политику."
                            }
                        }
                    ],
                    "synonyms": [
                        "cleft",
                        "clove",
                        "lith",
                        "circular segment",
                        "line segment"
                    ],
                    "common_phrases": [
                        "market segment",
                        "customer segment",
                        "segment of society",
                        "large segment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из отдельных частей, на которые что-либо естественно делится или может быть разделено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегмент",
                                "target_lang_sense_clarification": "часть целого, например, рынка или общества"
                            },
                            {
                                "target_lang_word": "долька",
                                "target_lang_sense_clarification": "часть фрукта, например, апельсина"
                            },
                            {
                                "target_lang_word": "часть",
                                "target_lang_sense_clarification": "общий термин для доли или куска"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae36a20f-dd58-33a1-af87-8e7f3463b56c",
                    "sense_definition": "A specific part of a radio or television program that is devoted to a particular topic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "media_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news program included a short <w>segment</w> on the local weather.",
                            "target_lang_translations": {
                                "ru": "Программа новостей включала короткий <w>сюжет</w> о местной погоде."
                            }
                        },
                        {
                            "text": "We missed the sports <w>segment</w> because we turned on the TV too late.",
                            "target_lang_translations": {
                                "ru": "Мы пропустили спортивный <w>блок</w>, потому что слишком поздно включили телевизор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "news segment",
                        "brief segment",
                        "interview segment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная часть радио- или телепрограммы, посвященная конкретной теме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегмент",
                                "target_lang_sense_clarification": "часть эфирного времени или программы"
                            },
                            {
                                "target_lang_word": "сюжет",
                                "target_lang_sense_clarification": "отдельный репортаж или история в новостях"
                            },
                            {
                                "target_lang_word": "рубрика",
                                "target_lang_sense_clarification": "постоянный раздел в программе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69fe7dac-0b92-302e-8b92-4cba75e6f596",
                    "sense_definition": "A straight path between two points that represents the shortest distance between them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the students to draw a line <w>segment</w> connecting points A and B.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников нарисовать <w>отрезок</w> прямой, соединяющий точки А и Б."
                            }
                        },
                        {
                            "text": "Calculate the length of the <w>segment</w> on the graph.",
                            "target_lang_translations": {
                                "ru": "Вычислите длину <w>отрезка</w> на графике."
                            }
                        }
                    ],
                    "synonyms": [
                        "line segment"
                    ],
                    "common_phrases": [
                        "line segment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямой путь между двумя точками, представляющий собой кратчайшее расстояние между ними."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрезок",
                                "target_lang_sense_clarification": "часть линии между двумя точками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6acaf369-05c0-3991-bef2-b6657064fd82",
                    "sense_definition": "One of the similar sections that the body of an insect or other animal is divided into.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The body of the worm is composed of many identical <w>segments</w>.",
                            "target_lang_translations": {
                                "ru": "Тело червя состоит из множества одинаковых <w>сегментов</w>."
                            }
                        },
                        {
                            "text": "Each <w>segment</w> of the insect's thorax has a specific function.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>членик</w> груди насекомого выполняет определенную функцию."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из похожих отделов, на которые разделено тело насекомого или другого животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегмент",
                                "target_lang_sense_clarification": "биологическое членение тела"
                            },
                            {
                                "target_lang_word": "членик",
                                "target_lang_sense_clarification": "отдельная часть тела беспозвоночных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4a62e50-5076-3301-b84c-13d17378d676",
                    "sense_definition": "To divide something into separate parts or sections.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_divide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team decided to <w>segment</w> the audience based on age and interests.",
                            "target_lang_translations": {
                                "ru": "Команда по маркетингу решила <w>сегментировать</w> аудиторию по возрасту и интересам."
                            }
                        },
                        {
                            "text": "You should <w>segment</w> the project into smaller tasks to make it manageable.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>разделить</w> проект на более мелкие задачи, чтобы сделать его управляемым."
                            }
                        }
                    ],
                    "common_phrases": [
                        "segment the market",
                        "segment data",
                        "segment the audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять что-либо на отдельные части или секции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сегментировать",
                                "target_lang_sense_clarification": "делить на сегменты, часто в маркетинге или данных"
                            },
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "разбивать на части"
                            },
                            {
                                "target_lang_word": "делить",
                                "target_lang_sense_clarification": "разъединять целое на доли"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}