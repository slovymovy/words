                                        "sense_id": "547f735d-68f7-3600-b24c-c522f424eb48",
                                        "entry_id": "a4eb833d-03c9-3dba-a5ee-a58b60158a57",
                                        "glosses": [
                                            "iemand die daken construeert en waterdicht maakt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1936f0fa-56da-42e5-a914-012e2a55f4e9",
                                                "sense_id": "547f735d-68f7-3600-b24c-c522f424eb48",
                                                "text": "Ze beginnen in het splinternieuwe gebouw aan de Lariksstraat waar dezer dagen met man en macht wordt gewerkt om alles op tijd op de juiste plek te krijgen. Op de parkeerplaats staat het vol met bedrijfsbusjes. Van installateur tot dakwerker, allerlei disciplines zijn nodig om het schoolgebouw aan een zijstraat van de Berkstraat af te krijgen."
                                            },
                                            {
                                                "example_id": "c349d71b-75dc-4843-aecf-ea7f192f2770",
                                                "sense_id": "547f735d-68f7-3600-b24c-c522f424eb48",
                                                "text": "De Vlaamse burgemeester Stefaan Devleeschouwer van de gemeente Brakel is opgestapt nadat hij betrokken was geraakt bij een verkeersongeval waardoor een 35-jarige dakwerker zwaargewond raakte. De burgervader bleek te diep in het glaasje te hebben gekeken, aldus Belgische media."
                                            }
                                        ]
