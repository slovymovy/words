                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0c2269a-1cc7-47ea-9a9b-501b854e021e",
                        "source_entry_id": "76e0a2ce-38e4-39fe-8ec9-c21f6f31d4c9",
                        "source_sense_id": "f2369ba4-9dad-388d-8d8b-9af75c11d0eb",
                        "target_lang_word": "zélote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zélote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b7eb50-00a9-37c3-8fbb-48f1dae6905e",
                                        "entry_id": "388ce747-423b-3dde-8cbc-10b449f9edeb",
                                        "glosses": [
                                            "Membre d’une secte juive du Iᵉʳ siècle de notre ère qui combattait le pouvoir romain les armes à la main et pratiquait le terrorisme."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b28eed9-6e65-469a-8488-86231c40f3a9",
                                                "sense_id": "b1b7eb50-00a9-37c3-8fbb-48f1dae6905e",
                                                "text": "Du côté juif, la désunion régna rapidement entre les partisans d'un apaisement et ceux prêts à aller jusqu'au bout : les zélotes."
                                            },
                                            {
                                                "example_id": "973320fe-b380-4249-bd64-fbf0da256848",
                                                "sense_id": "b1b7eb50-00a9-37c3-8fbb-48f1dae6905e",
                                                "text": "– Il faut rendre à César ce qui est à César, et à Dieu ce qui est à Dieu. Je ne suis pas un chef de guerre. Mon Royaume n’a rien à voir avec le sien.\nCela avait soulagé Pilate, mais m’avait aliéné définitivement les zélotes, les partisans de Barabbas, qui n’auraient pas dédaigné de m’utiliser pour soulever la Palestine contre l’occupant romain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12859c67-3cd1-39a5-a5f4-2d143bf5cba9",
                                        "entry_id": "388ce747-423b-3dde-8cbc-10b449f9edeb",
                                        "glosses": [
                                            "Fanatique, personne qui fait preuve d'un zèle excessif dans ses activités ou ses idées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37453be-f58f-49fe-a0e7-515847da044e",
                                                "sense_id": "12859c67-3cd1-39a5-a5f4-2d143bf5cba9",
                                                "text": "Un Claudel qui ne serait plus un zélote et un fanatique ne serait plus Claudel."
                                            },
                                            {
                                                "example_id": "74e98907-7706-4c82-b501-13604964cf68",
                                                "sense_id": "12859c67-3cd1-39a5-a5f4-2d143bf5cba9",
                                                "text": "A la vision de la fin de l’Histoire, démentie par les attentats du 11 septembre, l’Etat islamique et autres calamités, s’en ajoute une seconde : la « politique de l’éternité ». Ses zélotes évoquent sans cesse un passé mythique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zélote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9404499-dc46-38a1-9c26-47d78567d84e",
                                        "entry_id": "eb2f275c-c462-31e9-bf05-94e601508900",
                                        "glosses": [
                                            "Araignée aranéomorphe de la famille des Gnaphosidae."
                                        ],
                                        "tags": [
                                            "Aranéologie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "zélote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2efa128a-78a1-38d9-af8e-088407915f31",
                                        "entry_id": "ed69d776-5983-38e1-b522-ceb13551f59d",
                                        "glosses": [
                                            "Des zélotes, relatif aux zélotes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a236635-3336-4bf3-be2b-fd8d94f33a80",
                                                "sense_id": "2efa128a-78a1-38d9-af8e-088407915f31",
                                                "text": "Les Romains étaient comme hantés par l’agitation zélote qui s’organisait de plus en plus. Ils flairaient le zélotisme partout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25997399-58ae-3ae4-ba07-39032201d8a5",
                                        "entry_id": "ed69d776-5983-38e1-b522-ceb13551f59d",
                                        "glosses": [
                                            "Qui fait partie du mouvement des zélotes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea099549-30c9-406e-b3cb-f9ee128f2d1f",
                                                "sense_id": "25997399-58ae-3ae4-ba07-39032201d8a5",
                                                "text": "De nos jours, où l’on parle de la « théologie de la révolution », il est compréhensible que la tentation soit grande d’aller plus loin dans la voie du rabbin juif et faire de Jésus purement et simplement un résistant zélote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d42a60be-ab74-47e9-a945-4d141e0cb527",
                        "source_entry_id": "76e0a2ce-38e4-39fe-8ec9-c21f6f31d4c9",
                        "source_sense_id": "f2369ba4-9dad-388d-8d8b-9af75c11d0eb",
                        "target_lang_word": "Zelot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zelot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f922d7ec-9be1-39fb-9e36-4e0c8abdce0b",
                                        "entry_id": "b2361086-1c17-3f52-840d-acc105c05feb",
                                        "glosses": [
                                            "Mitglied der jüdischen Widerstandsbewegung gegen die römische Besatzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e4f645-c4af-4c1b-914a-869cd73d49a3",
                                                "sense_id": "f922d7ec-9be1-39fb-9e36-4e0c8abdce0b",
                                                "text": "Die Zeloten spielten die führende Rolle beim jüdischen Aufstand des Jahres 66."
                                            },
                                            {
                                                "example_id": "88ee84e2-0198-4f31-8bd7-b1b5ab36c303",
                                                "sense_id": "f922d7ec-9be1-39fb-9e36-4e0c8abdce0b",
                                                "text": "„Die Zeloten waren tatsächlich tragische Juden, die die Römer mit der gleichen Inbrunst hassten wie die Internationale die heutigen Autoritäten.“"
                                            },
                                            {
                                                "example_id": "2ade9812-c2ad-4675-aafb-c12097141d33",
                                                "sense_id": "f922d7ec-9be1-39fb-9e36-4e0c8abdce0b",
                                                "text": "„Eine andere besagt, dass Barabass ein Mitglied der Zeloten war, einer Gruppe, die den offenen Widerstand gegen die Römer praktizierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71762634-8a35-3404-aa41-22f727ec241d",
                                        "entry_id": "b2361086-1c17-3f52-840d-acc105c05feb",
                                        "glosses": [
                                            "religiöser Eiferer, Fanatiker"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53bf2cc9-4524-483c-9480-1f12753db046",
                                                "sense_id": "71762634-8a35-3404-aa41-22f727ec241d",
                                                "text": "Mit so einem Zeloten kann man nicht vernünftig reden."
                                            },
                                            {
                                                "example_id": "3bd60072-bea4-486f-98f0-cdc552d0c787",
                                                "sense_id": "71762634-8a35-3404-aa41-22f727ec241d",
                                                "text": "„Wir waren mehr Zeloten als Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceebb6b9-52f2-4e3e-8f33-810748490968",
                        "source_entry_id": "76e0a2ce-38e4-39fe-8ec9-c21f6f31d4c9",
