                        "entry_id": "267795c0-04df-3e5f-9dd2-c3cda00ba4f6",
                        "glosses": [
                            "Compensation for services that do not have a predetermined value."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5753be1d-30ff-4571-9d6e-8681b0d192e4",
                                "sense_id": "82273e73-7fe7-360c-9dda-65d1194e617f",
                                "text": "Dizi offer honorariums to their master, Hong, in appreciation for the mental, spiritual, and physical growth that they experience after becoming members of Tai Ji Men. There is no tuition or other fees for joining Tai Ji Men or practicing Qigong at one of the many Tai Ji Men locations established in Taiwan."
                            }
                        ]
                    }
                ],
