                    "sense_definition": "wywoływać w kimś zniecierpliwienie, złość lub gniew",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Najbardziej <w>irytują</w> mnie rozpieszczone, wrzeszczące dzieciaki w autobusie miejskim.",
                            "target_lang_translations": {
                                "ru": "Больше всего меня <w>раздражают</w> избалованные, орущие дети в городском автобусе."
                            }
                        },
                        {
                            "text": "Jego ciągłe spóźnienia zaczynają powoli <w>irytować</w> wszystkich pracowników w biurze.",
                            "target_lang_translations": {
                                "ru": "Его постоянные опоздания начинают потихоньку <w>раздражать</w> всех сотрудников в офисе."
                            }
                        }
                    ],
                    "synonyms": [
                        "denerwować",
                        "drażnić",
                        "złościć",
                        "wkurzać"
                    ],
                    "antonyms": [
                        "uspokajać"
                    ],
                    "common_phrases": [
                        "irytować ludzi",
                        "irytować zachowaniem"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать в ком-либо нетерпение, злость или раздражение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать досаду, недовольство или злость"
                            },
                            {
                                "target_lang_word": "нервировать",
                                "target_lang_sense_clarification": "выводить из душевного равновесия"
                            },
                            {
                                "target_lang_word": "злить",
                                "target_lang_sense_clarification": "вызывать чувство злости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37981ed5-3590-36d9-a221-1c804a164f39",
                    "sense_definition": "wpadać w stan zdenerwowania, złości lub zniecierpliwienia; odczuwać irytację",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adam łatwo <w>irytuje</w> się, gdy jego syn puszcza głośno techno w swoim pokoju.",
                            "target_lang_translations": {
                                "ru": "Адам легко <w>раздражается</w>, когда сын громко включает техно в своей комнате."
                            }
                        },
                        {
                            "text": "Nie warto <w>irytować</w> się rzeczami, na które zupełnie nie mamy wpływu.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>раздражаться</w> из-за вещей, на которые мы никак не можем повлиять."
                            }
                        }
                    ],
                    "synonyms": [
                        "denerwować się",
                        "złościć się",
                        "wściekać się"
                    ],
                    "antonyms": [
                        "uspokajać się"
                    ],
                    "common_phrases": [
                        "irytować się drobiazgami",
                        "łatwo się irytować"
                    ],
                    "target_lang_definitions": {
                        "ru": "впадать в состояние нервозности, злости или нетерпения; испытывать раздражение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражаться",
