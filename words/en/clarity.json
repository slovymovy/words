                {
                    "sense_id": "1e798a39-143d-3858-96d1-7fdd2a8a0dbc",
                    "sense_definition": "The quality of sound being clear and easy to hear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer was praised for the amazing <w>clarity</w> of her voice.",
                            "target_lang_translations": {
                                "ru": "Певицу хвалили за удивительную <w>чистоту</w> её голоса.",
                                "pl": "Piosenkarka była chwalona za niesamowitą <w>czystość</w> głosu."
                            }
                        },
                        {
                            "text": "These high-quality speakers provide excellent sound <w>clarity</w> for home cinema.",
                            "target_lang_translations": {
                                "ru": "Эти высококачественные колонки обеспечивают отличную <w>чёткость</w> звука для домашнего кинотеатра.",
                                "pl": "Te wysokiej jakości głośniki zapewniają doskonałą <w>wyrazistość</w> dźwięku w kinie domowym."
                            }
