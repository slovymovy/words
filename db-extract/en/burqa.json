                                "target_senses": [
                                    {
                                        "sense_id": "8d05b712-878a-3ffa-afa0-873154f1b89b",
                                        "entry_id": "da168c86-68e4-3032-ad8e-750a714a8a83",
                                        "glosses": [
                                            "het gehele lichaam, inclusief gezicht en ogen, verhullend gewaad dat vrouwen volgens streng islamitische opvattingen in het openbaar behoren te dragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4341a342-beab-44c0-a96b-2d28aca37a3c",
                                                "sense_id": "8d05b712-878a-3ffa-afa0-873154f1b89b",
                                                "text": "Tijdens het taliban-regime moesten alle vrouwen in Afghanistan buitenshuis weer een boerka dragen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e557cdd-2171-3792-a692-20e7ba3f9ddc",
                                        "entry_id": "da168c86-68e4-3032-ad8e-750a714a8a83",
                                        "glosses": [
                                            "wollen mantel voor mannen, traditioneel gedragen door Kozakken en bewoners van Kaukasus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "276118fb-a6f2-4a61-b67e-e09b6215078a",
                                                "sense_id": "0e557cdd-2171-3792-a692-20e7ba3f9ddc",
                                                "text": "Voorop reed een lange, magere man in kostbaar Tataars gewaad, gevolgd door drie knechten, die de gewone kemelsharen mantel, de boerka, droegen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d497c7d-009a-47af-a2f0-a08edf016f3d",
                        "source_entry_id": "2158c474-9cf6-32ed-9319-33a06af5c6f7",
                        "source_sense_description": "female garment that covers the whole body",
                        "target_lang_word": "burqa",
