                "senses": [
                    {
                        "sense_id": "1434366c-94f9-3e40-bc5a-ebf3d99b8d75",
                        "entry_id": "f0a79ad1-8e90-3663-a134-48c6df496ce3",
                        "glosses": [
                            "anlagebedingte Erkrankung, bei der die Beugesehnen eines Fingers über dem beugeseitigen Fingergrundgelenk am Übergang von Hohlhand zu den Fingern verdickt sind und dadurch nicht mehr frei (sondern nur ruck- und schnappartig) durch das dortige Ringband gleiten können"
                        ],
                        "tags": [
                            "Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "16fda52c-45d1-4b85-9e57-cd9247643f36",
                                "sense_id": "1434366c-94f9-3e40-bc5a-ebf3d99b8d75",
                                "text": "„Ein schnellender Finger oder Schnappfinger (Tendovaginitis stenosans) ist die Folge einer Verdickung einer Sehne in der Hand.“"
                            },
                            {
                                "example_id": "78043f53-65dd-43b9-9747-6611025d6cf3",
                                "sense_id": "1434366c-94f9-3e40-bc5a-ebf3d99b8d75",
                                "text": "„Das Karpaltunnel-Syndrom und der Schnappfinger, die Tendovaginitis stenosans, an der Beugeseite des Handgelenks und in der Hohlhand, entstehen durch Überlastung, wie sie zum Beispiel eine falsch positionierte ComputerTastatur hervorrufen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
