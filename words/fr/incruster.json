                    "frequency": "Middle",
                    "semantic_group_id": "presence_indesirable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Julien n'était pas invité au dîner, mais il a réussi à s'<w>incruster</w> discrètement parmi les convives."
                        },
