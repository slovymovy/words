                            },
                            {
                                "target_word": "handcuff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f687adc5-a8c8-3b52-86bf-8c71ef0f358c",
                                        "entry_id": "bfb724fa-341f-3747-b619-4978a82560fb",
                                        "glosses": [
                                            "To apply handcuffs to someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60984137-e6b5-49cf-b474-58df0fd6af80",
                                                "sense_id": "f687adc5-a8c8-3b52-86bf-8c71ef0f358c",
                                                "text": "The sheriff had brought along all the handcuffs necessary, and in a few seconds he had handcuffed Koswell. He threw a pair of the steel bracelets to Dick and another pair to Tom, and the Rovers had the satisfaction of handcuffing Josiah Crabtree and Tad Sobber. Then the sheriff made prisoners of the rest of the crowd[…]"
                                            },
                                            {
                                                "example_id": "8c0442f9-0f36-4c9b-87d1-844f3313018e",
                                                "sense_id": "f687adc5-a8c8-3b52-86bf-8c71ef0f358c",
                                                "text": "The sheriff’s office released a compilation of bodycam footage Friday from deputies at the scene that shows them handcuffing Earl and pinning him down for more than 20 minutes as he struggles and repeatedly shouts for help."
                                            },
                                            {
                                                "example_id": "8705097e-48cb-45e4-8cea-bfc63786916c",
                                                "sense_id": "f687adc5-a8c8-3b52-86bf-8c71ef0f358c",
                                                "text": "Conservative influencer Nick Sortor is handcuffed Thursday night by a police officer outside an ICE facility in Portland, Oregon, a bystander video shows; the video does not show events leading up to the arrest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82a220e2-d27c-3f40-884c-034d29aea656",
                                        "entry_id": "bfb724fa-341f-3747-b619-4978a82560fb",
                                        "glosses": [
                                            "to restrain or restrict."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b1a7e19-7df6-4e9d-8913-cbdf48542ea4",
                                                "sense_id": "82a220e2-d27c-3f40-884c-034d29aea656",
                                                "text": "Dang, I’m handcuffed by these regulations. I’d like to help but it’d be illegal."
                                            },
                                            {
                                                "example_id": "eb3c3c93-6263-4e5b-a390-105537a3df5c",
                                                "sense_id": "82a220e2-d27c-3f40-884c-034d29aea656",
                                                "text": "After all, since our marriage has proved a childless one, the only reason for our submitting to be handcuffed to one another, now that our hearts are no longer in the arrangement, is gone."
                                            },
                                            {
                                                "example_id": "c0a3dd97-d020-4471-83dc-ada8986d7b17",
                                                "sense_id": "82a220e2-d27c-3f40-884c-034d29aea656",
                                                "text": "If he were a king, as his swagger and opera-singing occasionally suggested, he would stretch the constitution any way he wanted. In fact, as he admitted with a grin, it handcuffed him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
