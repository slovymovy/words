                                    {
                                        "sense_id": "527bfe83-113a-3780-b1e1-e7b4df583e49",
                                        "entry_id": "531e0d21-97e1-3072-be25-4872fc505500",
                                        "glosses": [
                                            "Désigne les soixante-dix (ou soixante-douze) traducteurs qui, suivant l’opinion commune, traduisirent de l’hébreu en grec, par ordre de Ptolémée Philadelphe, roi d’Égypte, les livres de l’Ancien Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4022d3a9-bf61-4981-b438-85ddb848dbfc",
                                                "sense_id": "527bfe83-113a-3780-b1e1-e7b4df583e49",
                                                "text": "La version des Septante. La traduction des Septante."
                                            },
                                            {
                                                "example_id": "3a376bdd-a531-4e79-8329-8f3fc3e42422",
                                                "sense_id": "527bfe83-113a-3780-b1e1-e7b4df583e49",
                                                "text": "La Samaritaine rapporte avant ce verset un passage qui ne se trouve point dans le texte, et que les Septante n’ont pas mis non plus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Septante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5fd238-2826-351e-91b6-c6642ec0a7cf",
                                        "entry_id": "b811db6c-b294-3cc2-a773-a9e91bc27a6a",
                                        "glosses": [
                                            "Désigne la version de la Bible des Septante (traduction grecque de l’Ancien Testament)."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "note": "On dit les Septante ou, plus rarement, la Septante",
                                        "examples": [
                                            {
                                                "example_id": "23b5ec3f-b786-4c4f-95c2-6c27765edf5f",
                                                "sense_id": "6d5fd238-2826-351e-91b6-c6642ec0a7cf",
                                                "text": "Depuis une douzaine d’années, un groupe d’universitaires français attachés à l’étude des anciens écrivains grecs chrétiens s’est tourné vers la Septante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27a408f4-d4ec-460f-90b0-47b06b3ef42b",
                        "source_entry_id": "9ff3a920-acee-3192-a3bb-7187fc774bce",
                        "source_sense_description": "an ancient translation of the Hebrew Bible into Ancient Greek",
                        "target_lang_word": "Septuaginta",
