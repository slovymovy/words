                "senses": [
                    {
                        "sense_id": "3a108efa-2ad5-327f-87a3-831e7878ca49",
                        "entry_id": "9686abd7-c648-3702-9fcb-0613e9b720e4",
                        "glosses": [
                            "deutscher Ausdruck für nomen substantivum (Substantiv)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ed6d33-6df0-4779-bfe6-505f9a03a959",
                                "sense_id": "3a108efa-2ad5-327f-87a3-831e7878ca49",
                                "text": "„Tisch“ ist ein Sachwort."
                            },
                            {
                                "example_id": "8bf1236c-b9ef-468a-86eb-cab27d7503ac",
                                "sense_id": "3a108efa-2ad5-327f-87a3-831e7878ca49",
                                "text": "Sachwort scheint als Stichwort in neuen Wörterbüchern nicht vorzukommen; das Kompositum „Sachwörterbuch“ hat dagegen ein eigenes Stichwort."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2ddb61a7-2ac3-3431-a2e4-697bbf7637ed",
                        "entry_id": "9686abd7-c648-3702-9fcb-0613e9b720e4",
                        "glosses": [
                            "Wort, das für eine Sache, einen Sachverhalt steht und kein Name ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75885e18-7478-4fa4-b795-36615a6b1f9a",
                                "sense_id": "2ddb61a7-2ac3-3431-a2e4-697bbf7637ed",
                                "text": "„Tisch“ ist ein Sachwort."
                            },
                            {
                                "example_id": "6dcbd96d-d626-4dbe-9aa3-2d0688adf9be",
                                "sense_id": "2ddb61a7-2ac3-3431-a2e4-697bbf7637ed",
                                "text": "Sachwort scheint als Stichwort in neuen Wörterbüchern nicht vorzukommen; das Kompositum „Sachwörterbuch“ hat dagegen ein eigenes Stichwort."
                            },
                            {
                                "example_id": "14429ae1-37ca-433d-8f2a-dfe0c096330f",
                                "sense_id": "2ddb61a7-2ac3-3431-a2e4-697bbf7637ed",
                                "text": "„Der Genitiv mag sich aus der bereits abgehandelten Gruppe erklären, wo er, ein possessivischer, mit dem Nominativ eines auf die Beisetzung zielenden Sachwortes verknüpft ist.“"
                            },
                            {
                                "example_id": "c34f0df6-3e56-478c-ae9d-2a04cfac0dee",
                                "sense_id": "2ddb61a7-2ac3-3431-a2e4-697bbf7637ed",
                                "text": "„Mit diesen lustig bunten Bandolinos lernen die Kinder die Sachwörter des Grundwortschatzes der Klasse 1 kennen.“"
                            },
                            {
                                "example_id": "4b8cae87-4d54-4cd9-957c-9b07c7f744ae",
                                "sense_id": "2ddb61a7-2ac3-3431-a2e4-697bbf7637ed",
                                "text": "„Dieses Register ermöglicht es, die Urkundentexte nach ausgewählten deutschen und lateinischen Sachwörtern zu durchsuchen.“"
                            },
                            {
                                "example_id": "4fe4846a-d4ba-4b35-804d-7b1e532d3b7d",
                                "sense_id": "2ddb61a7-2ac3-3431-a2e4-697bbf7637ed",
                                "text": "„Auf der Liste sind nur jene Sachwörter, die mindestens 5x verwendet wurden. Über 1500 weitere, selten verwendete Sachwörter fehlen in diesem Verzeichnis.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
