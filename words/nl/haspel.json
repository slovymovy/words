                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Haspel</w> die kabel nu snel op voordat het gaat regenen!",
                            "target_lang_translations": {
