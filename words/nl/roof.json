                    "sense_id": "aaff1d81-d3ff-339f-939b-47881b3a02a2",
                    "sense_definition": "het openlijk en gewelddadig wegnemen van hetgeen een ander toebehoort",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "misdaad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie onderzoekt een gewelddadige <w>roof</w> die gisteravond in het centrum plaatsvond.",
                            "target_lang_translations": {
                                "en": "The police are investigating a violent <w>robbery</w> that took place in the city center last night.",
                                "ru": "Полиция расследует насильственный <w>грабёж</w>, который произошел вчера вечером в центре города."
                            }
                        },
                        {
                            "text": "Na de grote <w>roof</w> uit de kluis bleven de daders spoorloos verdwenen.",
                            "target_lang_translations": {
                                "en": "After the major <w>heist</w> from the vault, the perpetrators remained missing without a trace.",
                                "ru": "После крупного <w>ограбления</w> сейфа преступники бесследно исчезли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gewelddadige roof"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of openly and violently taking what belongs to another",
                        "ru": "открытое и насильственное завладение чужим имуществом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "robbery",
                                "target_lang_sense_clarification": "theft involving force"
                            },
                            {
                                "target_lang_word": "heist",
                                "target_lang_sense_clarification": "a large-scale robbery"
                            },
                            {
                                "target_lang_word": "loot",
                                "target_lang_sense_clarification": "goods stolen during a robbery"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "грабёж",
                                "target_lang_sense_clarification": "открытое хищение имущества"
                            },
                            {
                                "target_lang_word": "разбой",
                                "target_lang_sense_clarification": "нападение с целью хищения"
                            },
                            {
                                "target_lang_word": "ограбление",
                                "target_lang_sense_clarification": "акт кражи с применением силы"
                            }
                        ]
