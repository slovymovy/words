                                            {
                                                "example_id": "0afd637d-6422-4275-a9b7-e161e424aef7",
                                                "sense_id": "325b0204-4433-3791-91bc-8b5120e4ac70",
                                                "text": "Die Neuheit der Erfindung war offensichtlich."
                                            },
                                            {
                                                "example_id": "6fa000a6-fa48-42a4-8632-f1a32368bdd0",
                                                "sense_id": "325b0204-4433-3791-91bc-8b5120e4ac70",
                                                "text": "„Steuer- und Pachtverweigerungskampagnen setzten ein, nachdem die Salzkampagne den Reiz der Neuheit verloren hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9b77096-5a08-36b2-8f12-b06daa1f9455",
                                        "entry_id": "72954dc8-51ff-3d4d-8380-5173273473c8",
                                        "glosses": [
                                            "Produkt, das es vorher noch nicht gab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f299a71-51da-4cf8-8ba4-718f61438067",
                                                "sense_id": "f9b77096-5a08-36b2-8f12-b06daa1f9455",
                                                "text": "Die Messe war voller Neuheiten."
                                            }
                                        ],
