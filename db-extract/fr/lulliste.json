                        "glosses": [
                            "Relatif à Jean-Baptiste Lully, sa musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c06f559-44fb-4359-9f61-342c88d3e59b",
                                "sense_id": "e11c2551-cef5-35e7-9a9c-3ac8ef0fe5a7",
                                "text": "L’opéra lulliste se caractérise par un style unique : de grandes lignes mélodiques simples et dramatiquement efficaces autour desquelles s’épanouissent des ouvertures et des interludes brillants et de nombreuses pièces chorégraphiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "58056099-531a-390b-aae1-c0d9d294d615",
                        "entry_id": "e8e3d732-49a2-3dcf-8adb-678deb0c33ec",
                        "glosses": [
                            "Relatif à Raymond Lulle, à sa doctrine ou son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f16fa9-f34a-4808-86de-c6d6e842166e",
                                "sense_id": "58056099-531a-390b-aae1-c0d9d294d615",
                                "text": "Les figures des ouvrages alchimiques pseudo-lullistes ressemblent quelque peu aux figures lullistes originales. — (Frances A. Yates, L'art de la mémoire, traduit de l'anglais par Daniel Arasse, Éditions Gallimard, 1975, page 205)"
                            }
                        ]
                    }
                ],
