{
    "word_family": [
        "worsen",
        "worst"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "84c4c89a-9b17-3bff-8a00-af1730f753ec",
                    "sense_definition": "Comparative form of <w>bad</w>: of lower quality, less pleasant, or less desirable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather is <w>worse</w> today than it was yesterday.",
                            "target_lang_translations": {
                                "ru": "Погода сегодня <w>хуже</w>, чем была вчера.",
                                "pl": "Pogoda jest dzisiaj <w>gorsza</w> niż wczoraj.",
                                "zh": "今天天气比昨天<w>更糟</w>。"
                            }
                        },
                        {
                            "text": "Your exam results are <w>worse</w> than before.",
                            "target_lang_translations": {
                                "ru": "Твои результаты экзамена <w>хуже</w>, чем раньше.",
                                "pl": "Twoje wyniki z egzaminu są <w>gorsze</w> niż wcześniej.",
                                "zh": "你的考试成绩比以前<w>更差</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poorer",
                        "inferior"
                    ],
                    "antonyms": [
                        "better",
                        "superior"
                    ],
                    "common_phrases": [
                        "worse than",
                        "get worse",
                        "make matters worse",
                        "from bad to worse",
                        "worse off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного \"bad\" (плохой): более низкого качества, менее приятный или менее желательный.",
                        "pl": "Stopień wyższy przymiotnika \"bad\" (zły): o niższej jakości, mniej przyjemny lub mniej pożądany.",
                        "zh": "“bad”的比较级：更差的、更不好的、更不理想的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хуже",
                                "target_lang_sense_clarification": "сравнительная степень"
                            },
                            {
                                "target_lang_word": "более плохой",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gorszy",
                                "target_lang_sense_clarification": "stopień wyższy przymiotnika"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更糟",
                                "target_lang_sense_clarification": "表示质量、状态等比原来更不好"
                            },
                            {
                                "target_lang_word": "更差",
                                "target_lang_sense_clarification": "表示水平、结果等比较差"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "24873fa9-91f3-357e-9345-70bd89e9df60",
                    "sense_definition": "Comparative form of <w>badly</w>: in a less skillful, effective, or successful way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harder you try, the <w>worse</w> you do.",
                            "target_lang_translations": {
                                "ru": "Чем больше ты стараешься, тем <w>хуже</w> у тебя получается.",
                                "pl": "Im bardziej się starasz, tym <w>gorzej</w> ci idzie.",
                                "zh": "你越努力，结果反而越糟。"
                            }
                        },
                        {
                            "text": "He drives <w>worse</w> than anyone else I know.",
                            "target_lang_translations": {
                                "ru": "Он водит машину <w>хуже</w> всех, кого я знаю.",
                                "pl": "On jeździ <w>gorzej</w> niż ktokolwiek inny, kogo znam.",
                                "zh": "他开车比我认识的任何人都<w>更差</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "more poorly"
                    ],
                    "antonyms": [
                        "better"
                    ],
                    "common_phrases": [
                        "do worse",
                        "fare worse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень наречия \"badly\" (плохо): менее умело, эффективно или успешно.",
                        "pl": "Stopień wyższy przysłówka \"badly\" (źle): w sposób mniej umiejętny, skuteczny lub udany.",
                        "zh": "“badly”的比较级：以更差、更不成功或更不熟练的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хуже",
                                "target_lang_sense_clarification": "сравнительная степень"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gorzej",
                                "target_lang_sense_clarification": "stopień wyższy przysłówka"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更差",
                                "target_lang_sense_clarification": "表示做事效果、表现等更不好"
                            },
                            {
                                "target_lang_word": "更糟",
                                "target_lang_sense_clarification": "表示结果或表现更不好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94aa518f-d6a7-3a58-b878-d4192e1dcf77",
                    "sense_definition": "More severely or seriously.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news affected me <w>worse</w> than it did my brother.",
                            "target_lang_translations": {
                                "ru": "Плохие новости повлияли на меня <w>сильнее</w>, чем на моего брата.",
                                "pl": "Złe wieści dotknęły mnie <w>bardziej</w> niż mojego brata.",
                                "zh": "这个坏消息对我的影响比对我哥哥<w>更大</w>。"
                            }
                        },
                        {
                            "text": "My leg hurts <w>worse</w> when I try to walk on it.",
                            "target_lang_translations": {
                                "ru": "Моя нога болит <w>сильнее</w>, когда я пытаюсь наступать на нее.",
                                "pl": "Noga boli mnie <w>mocniej</w>, kiedy próbuję na niej stanąć.",
                                "zh": "我试着用这条腿走路时，腿疼得<w>更厉害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "more severely",
                        "more gravely"
                    ],
                    "antonyms": [
                        "less severely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более сурово, сильно или серьезно.",
                        "pl": "Mocniej, poważniej lub bardziej dotkliwie.",
                        "zh": "更严重地、更厉害地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильнее",
                                "target_lang_sense_clarification": "о боли или воздействии"
                            },
                            {
                                "target_lang_word": "хуже",
                                "target_lang_sense_clarification": "об общем состоянии"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gorzej",
                                "target_lang_sense_clarification": "o samopoczuciu lub sytuacji"
                            },
                            {
                                "target_lang_word": "mocniej",
                                "target_lang_sense_clarification": "o bólu lub wpływie"
                            },
                            {
                                "target_lang_word": "bardziej",
                                "target_lang_sense_clarification": "o stopniu nasilenia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更厉害",
                                "target_lang_sense_clarification": "用于疼痛、症状等更强烈"
                            },
                            {
                                "target_lang_word": "更大",
                                "target_lang_sense_clarification": "用于影响、程度等更强"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d54bb753-6dec-328e-ba1c-cb069fe183e9",
                    "sense_definition": "Used to introduce a statement describing something even more unpleasant or serious.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her leg is infected, and still <w>worse</w>, she is developing a fever.",
                            "target_lang_translations": {
                                "ru": "У нее инфекция ноги, и, что еще <w>хуже</w>, у нее начинается жар.",
                                "pl": "Jej noga jest zainfekowana, a <w>co gorsza</w>, zaczyna mieć gorączkę.",
                                "zh": "她的腿感染了，<w>更糟的是</w>，她还开始发烧了。"
                            }
                        },
                        {
                            "text": "We missed the bus, and even <w>worse</w>, it started to rain heavily.",
                            "target_lang_translations": {
                                "ru": "Мы опоздали на автобус, и, что еще <w>хуже</w>, начался сильный дождь.",
                                "pl": "Uciekł nam autobus, a co <w>gorsza</w>, zaczął padać ulewny deszcz.",
                                "zh": "我们没赶上公交车，<w>更糟的是</w>，还下起了大雨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "still worse",
                        "even worse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения утверждения, описывающего что-то еще более неприятное или серьезное.",
                        "pl": "Używane do wprowadzenia stwierdzenia opisującego coś jeszcze bardziej nieprzyjemnego lub poważnego.",
                        "zh": "用于引出更加令人不快或更严重的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хуже",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "хуже того",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "co gorsza",
                                "target_lang_sense_clarification": "wtrącenie"
                            },
                            {
                                "target_lang_word": "gorzej",
                                "target_lang_sense_clarification": "w wyrażeniach typu 'jeszcze gorzej'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更糟的是",
                                "target_lang_sense_clarification": "用于引出更糟糕的一点"
                            },
                            {
                                "target_lang_word": "更坏的是",
                                "target_lang_sense_clarification": "较书面，也可单独引出更坏情况"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f201565-d333-32fa-8d2a-5a4d5debecc8",
                    "sense_definition": "A thing, event, or state that is less good or more unpleasant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient took a sudden turn for the <w>worse</w> overnight.",
                            "target_lang_translations": {
                                "ru": "Состояние пациента внезапно изменилось к <w>худшему</w> за ночь.",
                                "pl": "Stan pacjenta nagle pogorszył się w nocy na <w>gorsze</w>.",
                                "zh": "病人的病情在一夜之间突然出现了<w>恶化</w>。"
                            }
                        },
                        {
                            "text": "Do not think the <w>worse</w> of him for his ambitious enterprise.",
                            "target_lang_translations": {
                                "ru": "Не думайте о нем <w>хуже</w> из-за его амбициозного предприятия.",
                                "pl": "Nie myśl o nim <w>gorzej</w> z powodu jego ambitnego przedsięwzięcia.",
                                "zh": "不要因为他雄心勃勃的事业就把他往<w>坏处</w>想。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "for the worse",
                        "turn for the worse",
                        "think the worse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещь, событие или состояние, которое является менее хорошим или более неприятным.",
                        "pl": "Rzecz, wydarzenie lub stan, który jest gorszy lub mniej przyjemny.",
                        "zh": "更糟的事物、情况或结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "худшее",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gorsze",
                                "target_lang_sense_clarification": "rzeczownikowo, np. zmiana na gorsze"
                            },
                            {
                                "target_lang_word": "gorzej",
                                "target_lang_sense_clarification": "w zwrotach typu 'myśleć o kimś gorzej'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶化",
                                "target_lang_sense_clarification": "指情况变得更糟这一状态或结果"
                            },
                            {
                                "target_lang_word": "坏处",
                                "target_lang_sense_clarification": "用于“往坏处想”等说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8d48b7e-5ebf-3d3f-978e-eec25e18523b",
                    "sense_definition": "A state of defeat or disadvantage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defending army was put to the <w>worse</w> during the fierce battle.",
                            "target_lang_translations": {
                                "ru": "Обороняющаяся армия потерпела <w>поражение</w> в ходе ожесточенной битвы.",
                                "pl": "Broniąca się armia poniosła <w>porażkę</w> podczas zaciekłej bitwy.",
                                "zh": "守军在激战中陷入了<w>劣势</w>。"
                            }
                        },
                        {
                            "text": "Judah was put to the <w>worse</w> before Israel.",
                            "target_lang_translations": {
                                "ru": "Иуда потерпел <w>поражение</w> перед Израилем.",
                                "pl": "Juda poniósł <w>porażkę</w> w starciu z Izraelem.",
                                "zh": "犹大在以色列面前处于<w>劣势</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defeat",
                        "disadvantage"
                    ],
                    "common_phrases": [
                        "put to the worse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние поражения или невыгодного положения.",
                        "pl": "Stan porażki lub niekorzystnej sytuacji (archaicznym językiem).",
                        "zh": "失败或处于不利地位的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражение",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "худшее положение",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "porażka",
                                "target_lang_sense_clarification": "archaiczne znaczenie"
                            },
                            {
                                "target_lang_word": "gorsza pozycja",
                                "target_lang_sense_clarification": "niekorzystne położenie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "劣势",
                                "target_lang_sense_clarification": "指处于不利地位或下风"
                            },
                            {
                                "target_lang_word": "下风",
                                "target_lang_sense_clarification": "文言或较书面，指不利局面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8097348c-1a50-3554-89ec-ebc73428ebae",
                    "sense_definition": "To make something worse or put at a disadvantage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weapons more violent may serve to better us and <w>worse</w> our foes.",
                            "target_lang_translations": {
                                "ru": "Более жестокое оружие может послужить тому, чтобы улучшить наше положение и <w>ухудшить</w> положение наших врагов.",
                                "pl": "Potężniejsza broń może posłużyć do polepszenia naszej sytuacji i <w>pogorszenia</w> sytuacji naszych wrogów.",
                                "zh": "更猛烈的武器也许能改善我们的处境，并<w>使</w>敌人处于更不利的地位。"
                            }
                        },
                        {
                            "text": "The sudden storm served to <w>worse</w> our situation significantly.",
                            "target_lang_translations": {
                                "ru": "Внезапный шторм послужил тому, чтобы значительно <w>ухудшить</w> нашу ситуацию.",
                                "pl": "Nagle rozpętana burza posłużyła do znacznego <w>pogorszenia</w> naszej sytuacji.",
                                "zh": "突如其来的暴风雨使我们的处境明显<w>恶化</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "worsen",
                        "aggravate"
                    ],
                    "antonyms": [
                        "better",
                        "improve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern usage typically uses 'worsen'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-то хуже или ставить в невыгодное положение.",
                        "pl": "Pogorszyć coś lub postawić w niekorzystnej sytuacji (archaicznym językiem).",
                        "zh": "使某事变得更糟，或使某人处于不利地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшать",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pogorszyć",
                                "target_lang_sense_clarification": "archaiczne użycie czasownika"
                            },
                            {
                                "target_lang_word": "zaszkodzić",
                                "target_lang_sense_clarification": "postawić w gorszej sytuacji"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶化",
                                "target_lang_sense_clarification": "使情况变得更糟"
                            },
                            {
                                "target_lang_word": "使处于劣势",
                                "target_lang_sense_clarification": "使别人处于不利地位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}