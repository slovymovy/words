                "senses": [
                    {
                        "sense_id": "be184b46-fffd-31f8-bfa8-0b8d1215dac2",
                        "entry_id": "64565419-036a-3dd5-8d54-da163ea29b49",
                        "glosses": [
                            "to chop off, to cut off"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ee42f0-fd67-42ab-b07f-6413a5bb62ff",
                                "sense_id": "be184b46-fffd-31f8-bfa8-0b8d1215dac2",
                                "text": "отруби́ть ве́тку у де́рева",
                                "translation": "to chop a branch off a tree",
                                "english": "to chop a branch off a tree"
                            },
                            {
                                "example_id": "7937ba1a-b145-4348-8bfb-6981052c3e2f",
                                "sense_id": "be184b46-fffd-31f8-bfa8-0b8d1215dac2",
                                "text": "отруби́ть го́лову кому́-либо",
                                "translation": "to chop/cut off someone's head",
                                "english": "to chop/cut off someone's head"
                            },
                            {
                                "example_id": "5424ea3b-fa6c-4409-a978-1683a255fb6b",
                                "sense_id": "be184b46-fffd-31f8-bfa8-0b8d1215dac2",
                                "text": "отруби́ть ему́ го́лову!",
                                "translation": "off with his head!",
                                "english": "off with his head!"
                            }
                        ]
                    }
                ],
