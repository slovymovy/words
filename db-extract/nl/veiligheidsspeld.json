                                "target_senses": [
                                    {
                                        "sense_id": "fb8dafc2-b3f1-30cb-b8fd-7048ee1dd82a",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Petite tige de métal (laiton, cuivre, fer, acier, etc.) terminée par une pointe à un bout et, de l’autre, par une tête → voir tête d’épingle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01389da3-8d49-4dec-9465-47488e7b27bd",
                                                "sense_id": "fb8dafc2-b3f1-30cb-b8fd-7048ee1dd82a",
                                                "text": "Épingle blanche."
                                            },
                                            {
                                                "example_id": "ec2c0abe-17a3-4d82-93b9-fb7233222587",
                                                "sense_id": "fb8dafc2-b3f1-30cb-b8fd-7048ee1dd82a",
                                                "text": "Attacher avec une épingle."
                                            },
                                            {
                                                "example_id": "8c416d1b-cf49-4a69-a310-8bff9861005d",
                                                "sense_id": "fb8dafc2-b3f1-30cb-b8fd-7048ee1dd82a",
                                                "text": "Il s’est enfoncé une épingle dans le doigt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a34dfdbe-3c9a-3c0a-8ff5-d6a20a03a697",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Chose de très petite valeur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1925e1b-5ae9-40a4-a173-803a3779bf4a",
                                                "sense_id": "a34dfdbe-3c9a-3c0a-8ff5-d6a20a03a697",
                                                "text": "Cela ne vaut pas une épingle, je n’en donnerais pas une épingle."
                                            },
                                            {
                                                "example_id": "3e75dceb-6806-44f8-82f6-6400c78e314e",
                                                "sense_id": "a34dfdbe-3c9a-3c0a-8ff5-d6a20a03a697",
                                                "text": "Je m’en soucie comme d’une épingle."
                                            },
                                            {
                                                "example_id": "93a63451-5294-4799-9aab-8e82d33f3d66",
                                                "sense_id": "a34dfdbe-3c9a-3c0a-8ff5-d6a20a03a697",
                                                "text": "Ces deux choses se ressemblent tellement que j’en donnerais le choix pour une épingle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf1eef0-e6c6-3167-b81a-3f282dc837a0",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Bijou en forme d’épingle, dont la tête, porte quelques pierreries ou quelque autre ornement, et qui sert aux hommes à fixer la cravate ou aux femmes à maintenir leur chapeau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475b45a2-117d-4f64-9982-0073834511d2",
                                                "sense_id": "fcf1eef0-e6c6-3167-b81a-3f282dc837a0",
                                                "text": "Épingle de diamant."
                                            },
                                            {
                                                "example_id": "1ce27e6d-a599-4482-90d9-17be1b691c7a",
                                                "sense_id": "fcf1eef0-e6c6-3167-b81a-3f282dc837a0",
                                                "text": "Épingle d’or."
                                            },
                                            {
                                                "example_id": "04edaaff-e263-4e27-98b6-b2b555c6a087",
                                                "sense_id": "fcf1eef0-e6c6-3167-b81a-3f282dc837a0",
                                                "text": "Faire monter un camée, une médaille en épingle."
                                            },
                                            {
                                                "example_id": "c5f44477-d357-41c0-8737-9d4bf83ebfb4",
                                                "sense_id": "fcf1eef0-e6c6-3167-b81a-3f282dc837a0",
                                                "text": "Jusqu’aux cravates, au petit nœud suavement bloqué par une épingle dans l’échancrure du col, jusqu’au feu d’un vrai diam’ et au cuir mat du bracelet-montre, on sentait ces messieurs soucieux de leur mise."
                                            },
                                            {
                                                "example_id": "f252a6fd-601a-407e-b489-e1a90818fd53",
                                                "sense_id": "fcf1eef0-e6c6-3167-b81a-3f282dc837a0",
                                                "text": "Les cheveux bruns, assez jeune, bronzé comme Frank Alamo, auquel il ressemblait un peu, et vêtu d'un complet bleu marine à rayures, il portait même une épingle de cravate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2fb982f-3052-3ce6-82f7-5fe93880b545",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Offense légère, mais souvent répétée, faite à une personne. On dit « pique » aujourd'hui."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "183018c9-4a33-4d80-b5c8-3a7675e900f8",
                                                "sense_id": "b2fb982f-3052-3ce6-82f7-5fe93880b545",
                                                "text": "Coups d’épingle, Piqûres d’épingle."
                                            },
                                            {
                                                "example_id": "95c84e07-20ab-4924-9b0b-8593c3db2c2a",
                                                "sense_id": "b2fb982f-3052-3ce6-82f7-5fe93880b545",
                                                "text": "La tête toujours appuyée sur sa main gauche et le bras accoudé sur son pupitre, il passait les heures d’étude à regarder dans la cour le feuillage des arbres ou les nuages du ciel ; il semblait étudier ses leçons ; mais voyant sa plume immobile ou sa page restée blanche, le Régent lui criait : Vous ne faites rien, Lambert ! Ce : Vous ne faites rien, était un coup d’épingle qui blessait Louis au cœur."
                                            },
                                            {
                                                "example_id": "da0cf9c0-ef0a-42e3-85b5-d26ac6ac836a",
                                                "sense_id": "b2fb982f-3052-3ce6-82f7-5fe93880b545",
                                                "text": "Or, quand ici l’on s’est mis à dos la bonne compagnie, il faut accoutumer son amour-propre à recevoir dix coups d’épingle par jour, auquel cas la ressource la plus douce qui reste, c’est de se brûler la cervelle ou, si l’on n’en a pas le courage, d’aller se jeter à la Trappe."
                                            },
                                            {
                                                "example_id": "f3a110dc-9fad-45f7-ae10-ec7c537e7f99",
                                                "sense_id": "b2fb982f-3052-3ce6-82f7-5fe93880b545",
                                                "text": "Elle se sauvait souvent pour pleurer toute seule, car ces questions lui entraient dans la peau comme des épingles."
                                            },
                                            {
                                                "example_id": "23d962b4-a9c1-40cb-88eb-5596f5ac5722",
                                                "sense_id": "b2fb982f-3052-3ce6-82f7-5fe93880b545",
                                                "text": "Ô ma victoire fragile de l’apparence, un rien, un regard, une réflexion, suffit à la démolir. Et elles s’y connaissent en coups d’épingles, Brigitte, les copines de la classe. Mais ce n’est pas à elles qu’il faut plaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de70bddd-fdcc-3177-8b2c-2edd5d3e67fd",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Dons et gratifications que l’on ajoutait au prix d’un marché, d’un service rendu."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5665530e-a5a0-4f90-aa1e-4bcc667ec1ef",
                                                "sense_id": "de70bddd-fdcc-3177-8b2c-2edd5d3e67fd",
                                                "text": "Il a fallu payer telle somme et tant pour les épingles."
                                            },
                                            {
                                                "example_id": "9e9f5ec7-cbf1-4052-b7e4-13c8a3abfe7a",
                                                "sense_id": "de70bddd-fdcc-3177-8b2c-2edd5d3e67fd",
                                                "text": "— Va pour deux cent dix francs, dis-je, croyant tout fini.\nEt j’étendis la main pour prendre la longe, mais le paysan ne me la céda pas.\n— Et les épingles de la bourgeoise ? dit-il.\nUne nouvelle discussion s’engagea et finalement nous tombâmes d’accord sur vingt sous d’épingles. Il nous restait donc trois francs.\nDe nouveau j’avançai la main, le paysan me la prit et me la serra fortement en ami.\nJustement parce que j’étais un ami, je n’oublierais pas le vin de la fille.\nLe vin de la fille nous coûta dix sous."
                                            },
                                            {
                                                "example_id": "87ffefb4-cdab-4dc4-a295-ebe37f827157",
                                                "sense_id": "de70bddd-fdcc-3177-8b2c-2edd5d3e67fd",
                                                "text": "Et c’était à la suite d’une rencontre terrible entre eux, après l’âpre partage du butin, que l’idée profonde lui était venue de donner en mariage, comme épingles, Ève, sa fille cadette, au fils du baron, Henri."
                                            },
                                            {
                                                "example_id": "1fca1f76-84e9-476c-a1a8-f04700ddcb4a",
                                                "sense_id": "de70bddd-fdcc-3177-8b2c-2edd5d3e67fd",
                                                "text": "Une fois même il eut mandat de discuter avec le boucher certain compte qui n’était pas clair, et qu’il finit du reste par payer intégralement, après avoir joui pour ses épingles, en un bigorne de loucherbem assez diaphane, de quelques insinuations malveillantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80c79139-f288-39f7-bbe1-04075e364f2f",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Petit brin de fil d’acier qui déborde d’un câble et résulte de la rupture d’un des fils qui constitue le câble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19436b6b-c95a-4cfd-80f2-80ff24b7ef4e",
                                                "sense_id": "80c79139-f288-39f7-bbe1-04075e364f2f",
                                                "text": "Pendant la manœuvre, il s'est déchiré la main sur une épingle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d8929e-6ca0-368f-a4e6-4c8fd5000dae",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Filet de glace qui se forme dans une crème glacée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e88dd75-e415-30d7-880b-6b344baea095",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Goutte de plomb fondu qui fait saillie à l’intérieur d’un tuyau du même métal à la suite d’une soudure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5978ebd-8aee-31c9-9a8d-2b4f6d6ab0f3",
                                        "entry_id": "34861b49-5e4b-3523-988b-62cce5f4169c",
                                        "glosses": [
                                            "Synonyme de trésillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3dd6c1-b74b-4d20-a30f-1226d7526efd",
                                                "sense_id": "f5978ebd-8aee-31c9-9a8d-2b4f6d6ab0f3",
                                                "text": "Pour les autres planches tu peux soit les empiler en plot avec des épingles \"petits tasseaux\" à l’abri des intempéries - gel, pluie, neige - mais dans un endroit ventilé et tempéré,…."
                                            }
                                        ]
                                    }
                                ]
