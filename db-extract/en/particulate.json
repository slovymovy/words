                        "sense_id": "a61c389f-15ee-31cc-9ceb-7e0cce8a0592",
                        "entry_id": "7ddd0d6f-30ab-3122-b9e6-4c9af12b1026",
                        "glosses": [
                            "Pertaining to heritable characteristics which are attributable discretely to either one or another of an offspring's parents, rather than a blend of the two."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2708a6a-553b-4be4-bd41-39c53b789809",
                                "sense_id": "a61c389f-15ee-31cc-9ceb-7e0cce8a0592",
                                "text": "The rudiments of particulate inheritance were dimly understood already by the breeders of cattle and apples, but nobody was being systematic."
                            }
                        ]
                    }
