                "entry_id": "6523c549-890b-3e01-923e-fa634cfc0f0a",
                "word": "mercenariat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3428bd4-5cae-45a3-a330-9c9ae5440372",
                        "entry_id": "6523c549-890b-3e01-923e-fa634cfc0f0a",
