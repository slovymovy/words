                "senses": [
                    {
                        "sense_id": "61906cc6-e764-3fb0-bfbf-4c4ddd2b4c33",
                        "entry_id": "bb9e443c-0e12-33a4-b387-62f85992cbba",
                        "glosses": [
                            "Unterschiede in der Gleichstellung von Frauen und Männern"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "38211dcd-6d25-46d2-bc67-a78343105509",
                                "sense_id": "61906cc6-e764-3fb0-bfbf-4c4ddd2b4c33",
                                "text": "„Es sei ein ‚sozialpolitischer Skandal‘, dass Frauen in Deutschland im Jahr 2015 noch immer 21 Prozent weniger verdienten als Männer, empörte sich Wirtschaftsminister Sigmar Gabriel Anfang der Woche. Ein ‚Gender-Gap‘ von 21 Prozent, das klingt allerdings nach einer Menge Holz und impliziert, dass Frauen ungerecht behandelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fa25644c-2d0a-3e91-a875-1e7d06bc81a3",
                        "entry_id": "bb9e443c-0e12-33a4-b387-62f85992cbba",
                        "glosses": [
                            "Unterstrich im Wortinneren als Mittel der gendersensiblen Schreibung im Deutschen"
                        ],
                        "tags": [
                            "Soziolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "0aecadea-4095-46ab-a013-2304f999d2f5",
                                "sense_id": "fa25644c-2d0a-3e91-a875-1e7d06bc81a3",
                                "text": "„Der Unterstrich, der sogenannte Gender-Gap, soll signalisieren, dass das Wort alle Menschen meint, also auch Personen, die sich nicht eindeutig dem männlichen oder dem weiblichen Geschlecht zuordnen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
