                                            {
                                                "example_id": "12b9de4f-fc17-4c2c-91a8-bd4fd54d237a",
                                                "sense_id": "6b144fb6-770d-311c-b8ad-47b587ea3a4d",
                                                "text": "This is an easy skillet with potatoes and bacon."
                                            },
                                            {
                                                "example_id": "20339542-671d-470b-9183-874d79d0ebdc",
                                                "sense_id": "6b144fb6-770d-311c-b8ad-47b587ea3a4d",
                                                "text": "Can you make up a quick skillet hash?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
