                "senses": [
                    {
                        "sense_id": "f9dae482-8fda-35db-b879-dd247c0d793e",
                        "entry_id": "216aef82-49ad-33c8-ba97-94125694e097",
                        "glosses": [
                            "Faire perdre son caractère bête à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e2a47e-a69b-44a5-a238-d2fec6663fad",
                                "sense_id": "f9dae482-8fda-35db-b879-dd247c0d793e",
                                "text": "Mais il faut « débêtifier » l’amour pour lui rendre sa place et son rôle dans l’organisation de la vie de l’individu et dans l’édification de la société."
                            },
                            {
                                "example_id": "320c7a26-4715-4501-8847-14c7583126c1",
                                "sense_id": "f9dae482-8fda-35db-b879-dd247c0d793e",
                                "text": "Mais rappelle-toi donc un peu ce qu’il faut faire pour nous débêtifier; je n’en ai plus, moi, la moindre idée."
                            }
                        ]
                    }
