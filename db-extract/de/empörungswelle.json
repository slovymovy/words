                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "eaf4db46-e45a-46a5-bd5a-4ecc0b4ff407",
                                "sense_id": "2881d617-e7c2-38fb-bf59-feb66efefe6f",
                                "text": "Die Freiheit zu denken spielt in unserer Zeit allzu oft keine Rolle mehr. Auch die breite Öffentlichkeit leidet inzwischen unter zahllosen unverbindlichen Debatten, die im Wesentlichen orientierungslos einander ständig ablösen und die, nachdem eine Empörungswelle wieder abgeebbt sein mag, zumeist im Sande verlaufen."
                            }
                        ]
                    }
