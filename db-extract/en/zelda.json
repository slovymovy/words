                ],
                "senses": [
                    {
                        "sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                        "entry_id": "bf059011-3663-34e3-bc0a-2e21c80a6ddb",
                        "glosses": [
                            "Ellipsis of Legend of Zelda."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "dfabd95f-c52f-44a2-9f14-5445b5844513",
                                "sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                                "text": "The Wind Waker is the best Zelda I’ve played since Link to the Past on the Super Nintendo."
                            },
                            {
                                "example_id": "dadea9c5-1e3f-4ae8-a11c-4327cff80c0f",
                                "sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                                "text": "The blurring of distinctions between theory and evidence, between agent and tool, and between individual and group knowledge are seen in fan discussions about Zelda like they are in the practices of science."
                            },
                            {
                                "example_id": "ef6abf71-b598-4a35-a08e-208e3efff5ed",
                                "sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                                "text": "Unlike previous Zeldas, Breath of the Wild doesn't hold your hand."
                            },
                            {
                                "example_id": "16bebfe4-c722-4353-9963-aa55cf477261",
                                "sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                                "text": "When developing Zelda games, director Hidemaro Fujibayashi thinks about the main hook of the game play before digging deeper into how it will out in combat or puzzles."
                            },
                            {
                                "example_id": "b1211bfa-381e-4403-ad32-654ff191e70c",
                                "sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                                "text": "For better or worse, Ocarina was the perfect fan service for kids and adults who'd spent years closing their eyes and imagining how cool a 3D Zelda was going to be."
                            },
                            {
                                "example_id": "0492610b-15bd-413d-a4d5-6643de8d90e5",
                                "sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                                "text": "The small motifs that [Jason] Brame identifies are used in the Hyrule Field to provide a sonic connection to earlier Zelda games but primarily avoid direct quotation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5d4430a-22b4-4028-9681-0c6f6d14dfa6",
                        "source_entry_id": "bf059011-3663-34e3-bc0a-2e21c80a6ddb",
                        "source_sense_id": "dd47cae3-7859-3384-af81-66437bcff91c",
                        "source_sense_description": "female given name",
