                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18b315b1-4c1f-4c00-9a15-147f7313c907",
                        "source_entry_id": "94aa6f78-8318-303a-b840-c3c0b7760def",
                        "source_sense_description": "house used as vacation home in summer",
                        "target_lang_word": "Sommerhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommerhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                        "entry_id": "acb711e9-08c9-3a86-b751-18d91d20cb7e",
                                        "glosses": [
                                            "(meist kleines) Haus, das vorwiegend im Sommer genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f1c070-6ece-4e2d-b12e-20e760ec840c",
                                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                                "text": "„Wieso kommen noch immer jährlich dutzende Menschen zum Sommerhaus von Heidegger?“"
                                            },
                                            {
                                                "example_id": "e2817acc-e60c-4d1e-b091-7cf4500d62c7",
                                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                                "text": "„Das gemietete Sommerhaus teilten sie sich stets mit zwei anderen Familien: Bill und Lena Weber, deren Sohn Herbie in Sandys Alter war, und Joe und Selma Green, deren hübsche Tochter Ruth drei Jahre älter war als Philip.“"
                                            },
                                            {
                                                "example_id": "4c9c69fe-3c43-41a8-82ca-824670b1fb20",
                                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                                "text": "„Im Sommerhaus in der Etage rechts haben wir unsere Betten gefunden.“"
                                            },
                                            {
                                                "example_id": "941da7ce-bc7b-4238-aa0c-b1534757dd0f",
                                                "sense_id": "6c4754f4-634b-3ea6-9242-0be1c3223fe9",
                                                "text": "„Sie waren zusammen mit ihren Eltern ins Sommerhaus gefahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eda6616-2093-4765-bc35-aea9cabbf35a",
                        "source_entry_id": "94aa6f78-8318-303a-b840-c3c0b7760def",
                        "source_sense_description": "house used as vacation home in summer",
                        "target_lang_word": "dom letniskowy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d374d3cc-1455-4198-a536-a147d1380899",
                        "source_entry_id": "94aa6f78-8318-303a-b840-c3c0b7760def",
                        "source_sense_description": "house used as vacation home in summer",
                        "target_lang_word": "дача",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дача",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "92990b01-6acd-3651-bf75-d6d4dfd898fc",
                                        "entry_id": "a8f6376c-c529-3751-8e93-4331c07c0760",
                                        "glosses": [
                                            "загородный дом, как правило для летнего проживания и отдыха городских жителей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ed9df7-c293-4f08-a505-1553b4087a59",
                                                "sense_id": "92990b01-6acd-3651-bf75-d6d4dfd898fc",
                                                "text": "Договорились, что я приеду к нему на дачу к двенадцати часам."
                                            },
                                            {
                                                "example_id": "da593f35-492f-41f7-a3be-bb4acd2c14b2",
                                                "sense_id": "92990b01-6acd-3651-bf75-d6d4dfd898fc",
                                                "text": "Дач всего двадцать две, и строится ещё только семь, а нас в МАССОЛИТе три тысячи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1939d546-9023-3cdd-af15-92916554f680",
                                        "entry_id": "a8f6376c-c529-3751-8e93-4331c07c0760",
                                        "glosses": [
                                            "истор. угодья и земли, принадлежащие помещику или государственным крестьянам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37025690-0593-48e1-9817-d200aa33bdf9",
                                                "sense_id": "1939d546-9023-3cdd-af15-92916554f680",
                                                "text": "Сперва сей остров был в даче Гавриила Ивановича Головкина, Великаго Канцлера."
                                            },
                                            {
                                                "example_id": "16829300-12ee-42f9-b8e6-36a7f4da5de9",
                                                "sense_id": "1939d546-9023-3cdd-af15-92916554f680",
                                                "text": "Воображение рисовало мне разные картины, и я бродил мысленно вместе с моим отцом по полям и лесам Сергеевской дачи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62208efa-1428-3cd8-a09b-285e2b897b31",
                                        "entry_id": "a8f6376c-c529-3751-8e93-4331c07c0760",
                                        "glosses": [
                                            "устар. участок земли специального назначения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f87384-69b6-41c7-89e6-b84f6d8d1aa8",
                                                "sense_id": "62208efa-1428-3cd8-a09b-285e2b897b31",
                                                "text": "В ектеринбург-каменской казённой даче приступают средствами казны к систематическим разведкам боевского месторождения уральского вольфрамита."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "дача",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f692c572-b76e-3824-9bd1-7b974c930754",
                                        "entry_id": "78958742-77eb-3f07-bb2d-8f61aca880cf",
                                        "glosses": [
                                            "действие по значению гл. давать; процесс перехода объекта от одного субъекта к другому по инициативе первого субъекта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8a35a6-ebae-480d-906b-85213de94e5d",
                                                "sense_id": "f692c572-b76e-3824-9bd1-7b974c930754",
                                                "text": "Дача показаний."
                                            },
                                            {
                                                "example_id": "4979c8eb-7d6c-493b-b2c3-9d9b6403a67d",
                                                "sense_id": "f692c572-b76e-3824-9bd1-7b974c930754",
                                                "text": "Дача взятки."
                                            },
                                            {
                                                "example_id": "48f7ba0f-6cb5-4075-bd46-8c13ff26751f",
                                                "sense_id": "f692c572-b76e-3824-9bd1-7b974c930754",
                                                "text": "Офицеры, переходившие фронт, большею частью отправлялись в высшие штабы для дачи показаний."
                                            },
                                            {
                                                "example_id": "0dea29ae-3210-4507-a2d9-ebe1335da55a",
                                                "sense_id": "f692c572-b76e-3824-9bd1-7b974c930754",
                                                "text": "После сольного выступления Цоя в Алма-Ате организатора концерта вызывали в местный партком для дачи объяснений."
                                            },
                                            {
                                                "example_id": "1c2b7279-b902-46e8-801d-fb314eae8481",
                                                "sense_id": "f692c572-b76e-3824-9bd1-7b974c930754",
                                                "text": "Рассмотрение коллегией представления прокурора о даче заключения или согласия на возбуждение уголовного дела против судьи проводится в срок не позднее 10 суток с участием прокурора, судьи и его защитника."
                                            },
                                            {
                                                "example_id": "a5ad4481-f3f4-45a2-b739-86ee67225229",
                                                "sense_id": "f692c572-b76e-3824-9bd1-7b974c930754",
                                                "text": "Однажды лица, обещавшие снабжать его мукой, после первой дачи спросили, не нуждается ли он в ней."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c10555-c7b9-3c09-beeb-70558686f3c2",
                                        "entry_id": "78958742-77eb-3f07-bb2d-8f61aca880cf",
                                        "glosses": [
                                            "результат такого действия; то, что дано, передано, отдано кому-либо; порция, выдаваемая за один раз"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88cae77-24da-461e-a8bb-ffe8100e9f39",
                                                "sense_id": "50c10555-c7b9-3c09-beeb-70558686f3c2",
                                                "text": "Корова бурая белобокая телилась… — Что, хорошо съели вечернюю дачу? — Хорошо съели, только быльё осталось."
                                            },
                                            {
                                                "example_id": "002230be-10d4-4d3c-9f9b-322cc2d72a62",
                                                "sense_id": "50c10555-c7b9-3c09-beeb-70558686f3c2",
                                                "text": "Откупщик, с своей стороны, тоже руководился «положением», внося свою дачу по третям года или помесячно, и притом всегда вперед, так что даже в случае смерти получателя деньги эти не возвращались."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676e151a-d818-360f-b79d-21678f442526",
                                        "entry_id": "78958742-77eb-3f07-bb2d-8f61aca880cf",
                                        "glosses": [
                                            "устар. то же, что взятка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e161b2d8-a212-418c-b9a0-c5e3c4efd948",
                                                "sense_id": "676e151a-d818-360f-b79d-21678f442526",
                                                "text": "И в то ж время стольники, которые написаны были в пехоту, дачи давали ему великие за то, чтобы их имена из пехоты взять и послать к хлебным запасам для приема, и по их даче и по хотьбе то все делано."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
