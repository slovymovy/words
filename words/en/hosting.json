                {
                    "sense_id": "c5f3c7c5-fa01-3bc0-a151-bcebbd261ba8",
                    "sense_definition": "The service of running and maintaining a computer system or website on a server for a client.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "computing_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We pay a monthly fee for secure web <w>hosting</w>.",
                            "target_lang_translations": {
                                "ru": "Мы платим ежемесячный взнос за безопасный веб-<w>хостинг</w>.",
                                "zh": "我们每月支付安全网站<w>托管</w>的费用。"
                            }
                        },
                        {
                            "text": "The company offers free <w>hosting</w> for personal blogs and small sites.",
                            "target_lang_translations": {
                                "ru": "Компания предлагает бесплатный <w>хостинг</w> для личных блогов и небольших сайтов.",
                                "zh": "该公司为个人博客和小型网站提供免费的<w>托管</w>服务。"
                            }
