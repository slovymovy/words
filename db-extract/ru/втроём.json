                                            {
                                                "example_id": "3d35875c-1335-46a2-ae96-ec8e8354c0d3",
                                                "sense_id": "0521b870-5e50-33f3-bc9d-acad887eddd9",
                                                "text": "In our example, 1210 has 1 zero, 2 ones, 1 two and 0 threes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "189fe251-01b5-3bae-aef6-3c70b60b4126",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "Anything measuring three units, as length."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3a0ccc-6e8c-41a9-95c1-a6778094ed9c",
                                                "sense_id": "189fe251-01b5-3bae-aef6-3c70b60b4126",
                                                "text": "Put all the threes in a separate container."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8345755c-708c-3c5f-b02b-87bacba5169f",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "A person who is three years old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a70441-689e-4ab3-ac38-688178a8701a",
                                                "sense_id": "8345755c-708c-3c5f-b02b-87bacba5169f",
                                                "text": "All the threes will go in Mrs. Smith's class, while I'll take the fours and fives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9420302e-8693-30fc-a307-8459e02f8627",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "The playing card featuring three pips."
