                        "glosses": [
                            "To steal or creep upward."
                        ],
                        "tags": [
                            "intransitive",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "63097fc2-b61d-4c81-8c24-b9784caf5dfe",
                                "sense_id": "d4d88733-2d8f-3ba1-8ec7-5da34dead7df",
                                "text": "[…] Or the potter, from whose wheel / Fair and finished shapes upsteal, / As by magic of command, / Guided by the loving hand."
                            },
                            {
                                "example_id": "d2bb1962-89c3-4407-9417-3be5bb179563",
                                "sense_id": "d4d88733-2d8f-3ba1-8ec7-5da34dead7df",
                                "text": "Yet, maybe, in some soul, / In some spot undiscerned on sea or land, some impulse rose, / Or some intent upstole / Of that enkindling ardency from whose maturer glows / The world's amendment flows."
                            }
                        ]
                    }
