    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba97669e-3a24-3cac-87f6-06157d63ac24",
                    "sense_definition": "Munir, équiper ou doter quelqu'un ou quelque chose de ce qui lui est nécessaire ou utile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'université a <w>pourvu</w> le laboratoire d'équipements scientifiques modernes pour la rentrée."
                        },
                        {
                            "text": "Chaque nouvel employé est <w>pourvu</w> d'un ordinateur portable dès son premier jour."
                        }
                    ],
                    "synonyms": [
                        "doter",
                        "équiper",
                        "garnir",
                        "munir"
                    ],
                    "antonyms": [
                        "démunir",
                        "priver"
                    ],
                    "common_phrases": [
                        "être pourvu de",
                        "pourvoir de ressources"
                    ]
                },
                {
                    "sense_id": "3116a9f1-e258-38a0-9017-f3a18ea7a2ea",
                    "sense_definition": "Prendre les mesures indispensables pour régler une situation ou satisfaire des nécessités.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "subvenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le salaire de Pierre suffit à peine à <w>pourvoir</w> aux besoins essentiels de sa famille."
                        },
                        {
                            "text": "La direction doit rapidement <w>pourvoir</w> au remplacement des agents partis à la retraite."
                        }
                    ],
                    "synonyms": [
                        "aviser",
                        "remédier",
                        "subvenir"
                    ],
                    "antonyms": [
                        "délaisser",
                        "négliger"
                    ],
                    "common_phrases": [
                        "pourvoir à la subsistance",
                        "pourvoir aux besoins"
                    ]
                },
                {
                    "sense_id": "8f22de1a-4113-3987-80aa-aa501e69345a",
                    "sense_definition": "Désigner une personne pour occuper un emploi, une charge ou une fonction vacante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nommer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche un candidat qualifié afin de <w>pourvoir</w> ce poste de direction financière."
                        },
                        {
                            "text": "Le ministre a promis de <w>pourvoir</w> sans délai ces fonctions administratives restées vacantes."
                        }
                    ],
                    "synonyms": [
                        "assigner",
                        "attribuer",
                        "combler"
                    ],
                    "common_phrases": [
                        "pourvoir un emploi",
                        "pourvoir un poste"
                    ]
                },
                {
                    "sense_id": "3b09a948-7531-3c00-9149-a475bd712da2",
                    "sense_definition": "Exercer un recours devant une juridiction compétente.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le condamné a décidé de se <w>pourvoir</w> en cassation pour contester le jugement initial."
                        },
                        {
                            "text": "En cas de litige commercial non résolu, l'entreprise pourra se <w>pourvoir</w> devant le tribunal compétent."
                        }
                    ],
                    "synonyms": [
                        "attaquer",
                        "contester",
                        "recourir"
                    ],
                    "antonyms": [
                        "acquiescer"
                    ],
                    "common_phrases": [
                        "se pourvoir en cassation",
                        "se pourvoir en justice"
                    ]
                }
            ]
        }
    ]
