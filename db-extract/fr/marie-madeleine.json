                "senses": [
                    {
                        "sense_id": "9edb0999-2b39-3c29-8697-5ed3496e291c",
                        "entry_id": "449919c3-65de-3a7b-9458-0021f3c2119a",
                        "glosses": [
                            "Prénom composé féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e579aef-1d1d-419f-abf7-0cea5f27c00b",
                                "sense_id": "9edb0999-2b39-3c29-8697-5ed3496e291c",
                                "text": "Je bénéficie de tous mes droits civiques, même si la Cour constitutionnelle de Marie-Madeleine Mborantsuo a voulu les restreindre parce que je suis un empêcheur de tourner en rond."
                            },
                            {
                                "example_id": "16aa597f-fab4-46e6-a0de-314ad47e0979",
                                "sense_id": "9edb0999-2b39-3c29-8697-5ed3496e291c",
                                "text": "Les contributions réunies par Marie-Madeleine Fragonard et Jacques Berchtold suivent le récit qui est fait des guerres de religion jusqu’à la fin du XVIIIe siècle par l’histoire officielle et les échos pamphlétaires qu’elle produit, par la recherche érudite et la compilation des mémoires, par la fiction romanesque et le travestissement du grand genre épique jusqu’à la Henriade."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "43991050-b5fe-32ec-b58d-287b50942d4e",
                "word": "Marie-Madeleine",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dac888af-1ab3-3d3b-808c-45cc8b82e7f7",
                        "entry_id": "43991050-b5fe-32ec-b58d-287b50942d4e",
                        "glosses": [
                            "Personnage biblique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55dad34-e3c3-4f48-9d6b-91a7c907da52",
                                "sense_id": "dac888af-1ab3-3d3b-808c-45cc8b82e7f7",
                                "text": "J’imaginais souvent que j’étais Marie-Madeleine et que j’essuyais avec mes longs cheveux les pieds du Christ."
                            },
                            {
                                "example_id": "ca507113-19e6-4806-9d81-120a0313934c",
                                "sense_id": "dac888af-1ab3-3d3b-808c-45cc8b82e7f7",
                                "text": "Que dit Jean sur la réapparition de Jésus ce matin halluciné où achoppe le salut de la multitude ? Que Marie-Madeleine, le jour à peine levé, accourt au tombeau et le trouve vide – Marie-Madeleine, l’amoureuse effrénée qui couvrait d’un coûteux parfum de Galilée les pieds du marcheur sublime en les oignant de ses cheveux."
                            }
                        ]
                    }
                ],
