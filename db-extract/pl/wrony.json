                                        "examples": [
                                            {
                                                "example_id": "a7c53689-d2d7-4baa-8ebd-725288583de3",
                                                "sense_id": "9ba0d0a7-3495-3c38-bf52-f25d0691b2d4",
                                                "text": "Волосы у неё ― такие чёрные-чёрные, вороные даже: так от солнца блещут ― льются будто…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
