                                        "sense_id": "7d9f0572-4a0b-3fe0-93d0-29628fcbc2a7",
                                        "entry_id": "3d63eee4-02d2-34be-a30e-43bf933314be",
                                        "glosses": [
                                            "Unité de fractionnement d'un découpage."
