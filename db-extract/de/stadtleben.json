                ],
                "senses": [
                    {
                        "sense_id": "207ea041-6426-3d31-8b23-9c2f1fc7a606",
                        "entry_id": "724bafac-e9c0-3a5a-b52d-8c89745b9a62",
                        "glosses": [
                            "Art zu leben, die sich in der Stadt einstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58be0c28-31de-475f-9316-e8b3b238a363",
                                "sense_id": "207ea041-6426-3d31-8b23-9c2f1fc7a606",
                                "text": "„Wer Walbeobachtung und Stadtleben verbinden möchte, der muss nach Akureyri.“"
                            },
                            {
                                "example_id": "70068235-44ba-43b8-bf6a-5736c4f6e8fc",
                                "sense_id": "207ea041-6426-3d31-8b23-9c2f1fc7a606",
                                "text": "„Die Ju/'hoansi wurden verstreut und umgesiedelt, sie kämpften mit Alkoholismus, und viele von ihnen hatte das Stadtleben verdorben.“"
                            },
                            {
                                "example_id": "c2fa5a48-4afd-453a-ba79-94f145c5eaff",
                                "sense_id": "207ea041-6426-3d31-8b23-9c2f1fc7a606",
                                "text": "„Stadtleben ist lustig, und es macht krank.“"
                            },
                            {
                                "example_id": "18f1a9e0-b3a8-46d0-8601-46913e23860f",
                                "sense_id": "207ea041-6426-3d31-8b23-9c2f1fc7a606",
                                "text": "„Sie hatte im Internat gelebt und die Vorzüge des Stadtlebens entdeckt, die ländliche Gegenden ihr nicht bieten konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
