                "senses": [
                    {
                        "sense_id": "fafec3d5-b5cc-32e3-9635-1ec1ec443645",
                        "entry_id": "e0e8e878-3823-3e3c-959d-cf1d8f2cf1d1",
                        "glosses": [
                            "ein aus Stoff gefertigter, warmer und bequemer Hausschuh"
                        ],
                        "tags": [
                            "zumeist im Plural; landschaftlich",
                            "besonders ostmitteldeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "283ab54a-8573-4a6b-b41e-6ea33ce4e07c",
                                "sense_id": "fafec3d5-b5cc-32e3-9635-1ec1ec443645",
                                "text": "„Manche Händler halten einen Armreif oder Schal hin, zeigen auf ein Paar besonders reich bestickter Babuschen, andere dösen vor sich hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fc7f19e-625e-4fe2-bcb6-c6d59179ca14",
                        "source_entry_id": "e0e8e878-3823-3e3c-959d-cf1d8f2cf1d1",
                        "source_sense_id": "fafec3d5-b5cc-32e3-9635-1ec1ec443645",
                        "source_sense_description": "aus Stoff gefertigter, warmer und bequemer Hausschuh",
                        "target_lang_word": "babouche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babouche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b5e76e0-9231-3685-92e6-bff717cc7775",
                                        "entry_id": "6814301f-976c-36a9-8b89-b1ff27252e21",
                                        "glosses": [
                                            "A Turkish or Moroccan slipper having no heel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00e9b6c-ef9e-4515-b95e-ebe57dca17a0",
                                                "sense_id": "0b5e76e0-9231-3685-92e6-bff717cc7775",
                                                "text": "BABOUCHE, S. F. (soulier des Turcs, & autres peuples orientaux,) a Shoe worn by the Turks, and other Oriental Nations."
                                            },
                                            {
                                                "example_id": "62f3ee4d-8eca-48a9-8a64-0c22c4baec73",
                                                "sense_id": "0b5e76e0-9231-3685-92e6-bff717cc7775",
                                                "text": "Everything that the reader of the Arabian Nights expects to find is here: […] the tunnelled passages where indolent merchants with bare feet crouch in their little kennels hung with richly ornamented saddlery and arms, or with slippers of pale citron leather and bright embroidered babouches; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c0558d9-912b-4ea4-9afe-c6969a3d263e",
                        "source_entry_id": "e0e8e878-3823-3e3c-959d-cf1d8f2cf1d1",
                        "source_sense_id": "fafec3d5-b5cc-32e3-9635-1ec1ec443645",
                        "source_sense_description": "aus Stoff gefertigter, warmer und bequemer Hausschuh",
                        "target_lang_word": "babouche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07c5ea50-d9e1-3a0a-8456-6a84c4782c9e",
                                        "entry_id": "967763b2-c353-3087-8713-7218c98dae6b",
                                        "glosses": [
                                            "Pantoufle orientale à semelle plate et sans contrefort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73278896-8029-42c2-a284-c7fe74ecc481",
                                                "sense_id": "07c5ea50-d9e1-3a0a-8456-6a84c4782c9e",
                                                "text": "C’est là que les anciens Mores déposaient leurs babouches avant d’entrer, en signe de déférence, à peu près comme nous ôtons nos chapeaux dans les endroits respectables."
                                            },
                                            {
                                                "example_id": "660d4167-c409-4327-8682-dc8d920f8d71",
                                                "sense_id": "07c5ea50-d9e1-3a0a-8456-6a84c4782c9e",
                                                "text": "Et ça encore, continua-t-il en reconnaissant ses pantoufles dans les pieds de Marcel, ce ne sont donc pas mes babouches, présent d’une main chère ?"
                                            },
                                            {
                                                "example_id": "ad280ef4-3e64-4fa6-b34e-84a297d3f03e",
                                                "sense_id": "07c5ea50-d9e1-3a0a-8456-6a84c4782c9e",
                                                "text": "L’uniforme se compose d'un pantalon-jupe […], d’un gilet […] et d’une veste […]. Un tarbouch rouge, des babouches (belgha) de cuir jaune, chaussure absurde pour des soldats, une jellâba, espèce de capote à capuchon, complètent le costume."
                                            },
                                            {
                                                "example_id": "2e841332-1e6e-4be0-a162-dc4978a3e240",
                                                "sense_id": "07c5ea50-d9e1-3a0a-8456-6a84c4782c9e",
                                                "text": "Ses pieds gantés de babouches en cuir blanc posaient sur un coussin d’eau chaude."
                                            },
                                            {
                                                "example_id": "ca647ff9-9a22-49dd-b8da-715b14fefead",
                                                "sense_id": "07c5ea50-d9e1-3a0a-8456-6a84c4782c9e",
                                                "text": "Oui, ma chère, il parait que cette adolescente a le pied si mignon qu’un enfant de huit ans pourrait sans se moquer lui prêter ses babouches."
                                            },
                                            {
                                                "example_id": "587566e2-ca37-42c5-9d29-a8b9be7716c9",
                                                "sense_id": "07c5ea50-d9e1-3a0a-8456-6a84c4782c9e",
                                                "text": "Elle rougit de confusion. Elle était en chemise de nuit et en babouches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71a2a97f-f60f-4e5c-86ee-cf26ebe8e145",
                        "source_entry_id": "e0e8e878-3823-3e3c-959d-cf1d8f2cf1d1",
