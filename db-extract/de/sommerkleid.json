                        "form": "die Sommerkleider"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70c87e2f-3c3a-38ed-8124-d95315bb9f60",
                        "entry_id": "9337f8ec-c3d3-35d1-ad3a-4eb9b14a39ba",
                        "glosses": [
                            "leichtes Kleid, geeignet für sommerliche Temperaturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5ceb8d-8e01-4cb4-a32b-8dfdc2cba474",
                                "sense_id": "70c87e2f-3c3a-38ed-8124-d95315bb9f60",
                                "text": "„Elisabeth gefiel Stefan in ihrem Sommerkleid, und er dachte, dass sie immerhin ein Mädchen war, mit dem man ausgehen und sich sehen lassen konnte.“"
                            },
                            {
                                "example_id": "1ac782de-dc13-4892-a179-8a66d1685138",
                                "sense_id": "70c87e2f-3c3a-38ed-8124-d95315bb9f60",
                                "text": "„Im Hinterzimmer von Sungs Laden hatte sie nun nicht nur ein Stück solchen Stoffs geschenkt bekommen, das für ein Sommerkleid in gerade richtiger Länge reichen würde, sondern auch noch ein Schnittmuster.“"
                            },
                            {
                                "example_id": "0a237d1e-7620-4bda-9a5d-250d6e38c8a5",
                                "sense_id": "70c87e2f-3c3a-38ed-8124-d95315bb9f60",
                                "text": "„Ida überlegte, ihr erstes Sommerkleid auszuführen, entschied sich dann doch dagegen.“"
                            },
                            {
                                "example_id": "56843e9b-6711-40e2-892b-935a6212fa1a",
                                "sense_id": "70c87e2f-3c3a-38ed-8124-d95315bb9f60",
                                "text": "„Sie trug ein elegantes blaues Sommerkleid mit breitem Kragen und hatte Lippenstift aufgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2565672c-5b92-3629-b379-efb53b92e64f",
                        "entry_id": "9337f8ec-c3d3-35d1-ad3a-4eb9b14a39ba",
                        "glosses": [
                            "andersartige Behaarung/andersartiges Gefieder bei Tieren im Sommer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904750fc-9d62-476d-a309-794a49a4b070",
                                "sense_id": "2565672c-5b92-3629-b379-efb53b92e64f",
                                "text": "„Die Winterkälte läßt‚ beim Hermelin das braune Sommerkleid sich in das weiße des Winters verwandeln; nur die Sehwanzspitze bleibt schwarz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
