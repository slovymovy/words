                    "frequency": "High",
                    "semantic_group_id": "environnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses entreprises continuent de <w>polluer</w> les rivières de cette région sans être sanctionnées."
                        },
