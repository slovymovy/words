                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                        "entry_id": "0a4c2070-35fc-302e-a4df-a49451b9fe68",
                        "glosses": [
                            "Mensch, der sich anderen gegenüber ungewohnt grob, rücksichtslos, ruppig verhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69084752-26f8-4dba-8e3a-b9ca736ba5ea",
                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                "text": "„Es waren noch weitere Grobiane, Kumpane des ersteren, anwesend.“"
                            },
                            {
                                "example_id": "883ce77c-f701-4120-ab53-0ebfaee8202c",
                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                "text": "„Schon in der Hafenkneipe hatte er erkannt, daß ihm John auf der weiten Fahrt in die Arktis das einsame Dasein unter den Grobianen und den ausgemachten Strolchen seiner Besatzung als guter Kamerad erträglich machen konnte.“"
                            },
                            {
                                "example_id": "d48da117-b4af-49e2-99c3-b005f43a09ab",
                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                "text": "„Er stürzte sich auf den Grobian und versetzte ihm einen gezielten Faustschlag ins Gesicht, worauf die anderen Männer Laura Leonore losließen, die weinend davonlief.“"
                            },
                            {
                                "example_id": "df1e6a68-0788-47e9-86f8-2f066cbf85f4",
                                "sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                                "text": "„Pech gehabt, der Grobian war nicht einzuschüchtern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceeccaa1-bea7-460b-bdc2-706df0582023",
                        "source_entry_id": "0a4c2070-35fc-302e-a4df-a49451b9fe68",
                        "source_sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                        "source_sense_description": "Mensch, der sich anderen gegenüber ungewohnt grob, rücksichtslos, ruppig verhält",
                        "target_lang_word": "boor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A peasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727ef383-6011-412f-bf44-52e4bd91464f",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "Not swear it, now I am a gentleman? Let boors and franklins say it, I’ll swear it."
                                            },
                                            {
                                                "example_id": "b67d62d7-5486-48f7-ab27-8d45fcce7b0c",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "For all the rich array and goodly port and countenance of Corinius, he seemed but a very boor beside the Lord Brandoch Daha, and dearly did each hate the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d40eac4-4fbe-3175-a746-2bc8b1ce1695",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A Boer, white South African of Dutch or Huguenot descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00a94902-5c40-3d3f-bde6-4367bc52b1a6",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A yokel, country bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "An uncultured person; a vulgarian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367635d2-d061-48ea-8df1-fe3e60ebf3de",
                                                "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                                "text": "I question if any man ever saw his absent friend more clearly than did Shakespeare his Falstaff, for instance, or Scott his Balfour of Burleigh. But does it, therefore, follow that either of these great writers would, when hungry, have summoned up before him a clearer picture of his approaching dinner, than does the equally hungry or very much hungrier boor? This I doubt; and on the same principle I doubt if the said boor would see his dinner more clearly than a wolf, bear, or tiger would theirs when in quest of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "153e2462-9094-40c3-ae30-3d7dac95293b",
                        "source_entry_id": "0a4c2070-35fc-302e-a4df-a49451b9fe68",
                        "source_sense_id": "7b5abb9a-51c9-372d-a883-aead9ccb4cd7",
                        "source_sense_description": "Mensch, der sich anderen gegenüber ungewohnt grob, rücksichtslos, ruppig verhält",
                        "target_lang_word": "lout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e9b850-6bea-3b54-a349-0c0803423d0b",
                                        "entry_id": "2e3dcf4a-8dff-3dc1-8249-c28029e9e7e9",
                                        "glosses": [
                                            "A troublemaker, often violent; a rude violent person; a yob."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf4f1d0-cb38-49f2-85cd-149ad24ec719",
                                                "sense_id": "d0e9b850-6bea-3b54-a349-0c0803423d0b",
                                                "text": "But the lout looked only to his market, and was not easily repulsed. “He’s there, I tell you,” he persisted. “And for threepence I’ll get you to see him. Come on, your honour! It’s many a Westminster election I’ve seen, and beer running, from Mr. Fox,[…]when maybe it’s your honour’s going to stand! Anyway, it’s, Down with the mongers!”"
                                            },
                                            {
                                                "example_id": "5f2f3574-79b4-4251-afc6-84850536ee48",
                                                "sense_id": "d0e9b850-6bea-3b54-a349-0c0803423d0b",
                                                "text": "You see louts fresh from school kicking grey-haired servants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b7b171-47b5-328e-a7a1-7c377a668fd5",
                                        "entry_id": "2e3dcf4a-8dff-3dc1-8249-c28029e9e7e9",
                                        "glosses": [
                                            "A clownish, awkward fellow; a bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d0df43c-9117-41d8-aede-37df46f8a596",
                                                "sense_id": "47b7b171-47b5-328e-a7a1-7c377a668fd5",
                                                "text": "The faire Pamela, whose noble hart I finde doth greatly disdaine, that the trust of her vertue is reposed in such a louts hands, as Dametas, had yet to shew an obedience, taken on a shepeardish apparell[…]",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "3e956f03-c546-4eb2-809d-90aecb22988d",
                                                "sense_id": "47b7b171-47b5-328e-a7a1-7c377a668fd5",
                                                "text": "Sebaſtian, I haue entertained thee, / Partly that I haue neede of ſuch a youth, / That can with ſome diſcretion doe my buſineſſe: / For ’tis no truſting to yond fooliſh Lowt;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed09bde1-2e2d-3dae-896a-9b451b994060",
                                        "entry_id": "f1a91935-fefa-3aac-a1e4-21384754ac14",
                                        "glosses": [
                                            "To treat as a lout or fool; to neglect; to disappoint."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3614e5-3630-4f88-9a2d-3956ff1eecf4",
                                                "sense_id": "ed09bde1-2e2d-3dae-896a-9b451b994060",
                                                "text": "Renowned Talbot doth expect my ayde, / And I am lowted by a Traitor Villaine, / And cannot helpe the noble Cheualier:[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                        "entry_id": "25742e0e-0957-35b4-a22e-af3dbd3d32ca",
                                        "glosses": [
                                            "To bend, bow, stoop."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d973891-4b02-4f1d-ad41-35e332d0f2d9",
                                                "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                                "text": "He faire the knight ſaluted, louting low, / Who faire him quited, as that courteous was[…]."
                                            },
                                            {
                                                "example_id": "286aaefa-bbd5-4e73-b62e-f371fb78ace6",
                                                "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                                "text": "And the priest devoutly crossed himself, and turned and louted to the alter."
                                            },
                                            {
                                                "example_id": "5396d553-30f2-458f-98af-566634cafd37",
                                                "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                                "text": "He took the cup in his hand and, louting low, returned his best thanks[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1131e08b-3816-4ea7-a580-96d3d0ca722f",
