                                "target_senses": [
                                    {
                                        "sense_id": "61041ca4-f0c3-3da0-bb8f-1046a1c64649",
                                        "entry_id": "7d2ecb42-67af-3dba-ae73-d0b9efa6cfd1",
                                        "glosses": [
                                            "Commune située dans le département du Finistère, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52187536-c531-44a3-bf71-2db361b03e24",
                                                "sense_id": "61041ca4-f0c3-3da0-bb8f-1046a1c64649",
                                                "text": "Toutes ces scènes se passent dans la contrée même où elle est honorée : les personnages miraculés ont l'ancien costume breton ; les églises rappellent celles de Henvic, de Carantec et la chapelle de Callot."
                                            },
                                            {
                                                "example_id": "bbd897e1-cbad-44bd-82d9-7770757789fd",
                                                "sense_id": "61041ca4-f0c3-3da0-bb8f-1046a1c64649",
                                                "text": "En baie de Morlaix, le foyer trouvé sur le château du Taureau incite à la mise en place d’une ZCT recouvrant Taulé, Saint-Pol-de-Léon, Henvic, Carantec, Plouezoc’h et Plougasnou."
                                            },
                                            {
                                                "example_id": "ab50ea97-43b0-4a2e-8807-24b85ad67397",
                                                "sense_id": "61041ca4-f0c3-3da0-bb8f-1046a1c64649",
                                                "text": "Ce week-end, les membres des associations Création peinture et le Salon des arts de Carantec proposent un vide-ateliers, une manière qui leur est propre de revisiter le concept du vide-greniers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
