                        "entry_id": "5338cb2f-da86-3e7f-aa5c-6588a0e98601",
                        "glosses": [
                            "essbare Frucht der Acerola, die der Kirsche ähnelt und sehr reich an Vitamin C ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ae9246-4355-4d78-a413-3bf0e150fb70",
                                "sense_id": "d89d69f6-5de7-3d58-9c8d-75b1005837cc",
                                "text": "„Stoßweise empfiehlt sich auch die Einnahme von Vitamin C, wenn Sie bereits erkältet sind – am besten keine reine Ascorbinsäure, sondern aus der Acerolakirsche gewonnenes Vitamin C.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "865dc72b-7faa-3f4d-a8c1-1e63ed2a4748",
                        "entry_id": "5338cb2f-da86-3e7f-aa5c-6588a0e98601",
                        "glosses": [
                            "Baum oder Strauch, der in Mittel- und Südamerika sowie in Westindien heimisch ist und diese essbaren Früchte trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b227a0-07d9-4e44-862b-9aba68ced263",
                                "sense_id": "865dc72b-7faa-3f4d-a8c1-1e63ed2a4748",
                                "text": "In botanischer Hinsicht ist die Acerolakirsche trotz ihres Namens nicht mit dem Kirschbaum verwandt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
