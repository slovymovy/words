                {
                    "sense_id": "2a037da5-f7f7-3031-a119-8935dc656023",
                    "sense_definition": "bardzo kogoś lub czegoś nie lubić",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "niechęć",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie <w>cierpię</w> go, ponieważ zawsze kłamie.",
                            "target_lang_translations": {
                                "en": "I <w>can't stand</w> him because he always lies.",
                                "ru": "Я его <w>терпеть не могу</w>, потому что он всегда врёт.",
                                "nl": "Ik <w>kan</w> hem <w>niet uitstaan</w>, omdat hij altijd liegt.",
                                "de": "Ich <w>kann</w> ihn <w>nicht leiden</w>, weil er immer lügt.",
                                "fr": "Je <w>ne peux pas le supporter</w>, car il ment tout le temps.",
                                "it": "Non lo <w>sopporto</w>, perché mente sempre.",
                                "cs": "<w>Nesnáším</w> ho, protože pořád lže.",
                                "tr": "Ona hiç <w>tahammül edemiyorum</w> çünkü her zaman yalan söylüyor.",
                                "es": "No lo <w>soporto</w> porque siempre miente.",
                                "zh": "我很<w>讨厌</w>他，因为他总是撒谎。"
                            }
                        },
                        {
                            "text": "Moja siostra nie <w>cierpi</w> jeść ryb.",
                            "target_lang_translations": {
                                "en": "My sister <w>hates</w> eating fish.",
                                "ru": "Моя сестра <w>терпеть не может</w> есть рыбу.",
                                "nl": "Mijn zus <w>heeft een hekel aan</w> het eten van vis.",
                                "de": "Meine Schwester <w>kann</w> es <w>nicht ausstehen</w>, Fisch zu essen.",
                                "fr": "Ma sœur <w>déteste</w> manger du poisson.",
                                "it": "Mia sorella <w>detesta</w> mangiare il pesce.",
                                "cs": "Moje sestra <w>nesnáší</w> jíst ryby.",
                                "tr": "Kız kardeşim balık yemekten <w>nefret eder</w>.",
                                "es": "Mi hermana <w>detesta</w> comer pescado.",
                                "zh": "我妹妹极度<w>讨厌</w>吃鱼。"
                            }
                        }
