                                        "sense_id": "1cb73fa8-7aa7-3ee9-b112-1ca92d365871",
                                        "entry_id": "82d6fb02-d2e1-3265-aace-ab7eb5ac5130",
                                        "glosses": [
                                            "Petite chambre dans un commerce où un client peut se déshabiller pour essayer des vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcbf123a-8865-4285-8c08-02b6751ebcf6",
                                                "sense_id": "1cb73fa8-7aa7-3ee9-b112-1ca92d365871",
                                                "text": "Où nous allions passer trois heures de cabine d’essayage en cabine d’essayage. Très fine dans ses choix, Laura aimait certaines textures, certaines marques."
                                            },
                                            {
                                                "example_id": "45c14665-382a-45f5-b1ce-99672a0fc5fd",
                                                "sense_id": "1cb73fa8-7aa7-3ee9-b112-1ca92d365871",
                                                "text": "Plus ma mère s’impatientait, plus elle me houspillait de l’autre côté du rideau de la cabine d’essayage, plus je m’emberlificotais dans ma lourde chrysalide blanche."
                                            },
                                            {
                                                "example_id": "cfe9d149-5737-4129-85be-5fbe4a9f3c5b",
                                                "sense_id": "1cb73fa8-7aa7-3ee9-b112-1ca92d365871",
                                                "text": "- Ah oui, la traite des Blanches... Moi c'est papa qui m'interdit d'entrer dans une cabine d'essayage, il paraît qu'en-dessous il y a une trappe qui t’emmène directement en Afrique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
