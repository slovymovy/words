    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47be796f-d081-3c11-96c0-2c9c032c3f6c",
                    "sense_definition": "mały, soczysty owoc rośliny",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "owoce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W lesie można znaleźć wiele różnych rodzajów <w>jagód</w>.",
                            "target_lang_translations": {
                                "ru": "В лесу можно найти много разных видов <w>ягод</w>."
                            }
                        },
                        {
                            "text": "Ten mały owoc to botanicznie <w>jagoda</w>.",
                            "target_lang_translations": {
                                "ru": "Этот маленький плод ботанически является <w>ягодой</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой сочный плод растения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ягода",
                                "target_lang_sense_clarification": "ботанический термин или общее название мелких сочных плодов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd3a9100-2334-37bb-abac-c087f07b7903",
                    "sense_definition": "owoc borówki czarnej",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "owoce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Latem często zbieramy w lesie świeże <w>jagody</w>.",
                            "target_lang_translations": {
                                "ru": "Летом мы часто собираем в лесу свежую <w>чернику</w>."
                            }
                        },
                        {
                            "text": "Moja babcia piecze pyszne ciasto z <w>jagodami</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка печет вкусный пирог с <w>черникой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "czarna jagoda",
                        "borówka",
                        "czernica",
                        "borówka czarna",
                        "borówka czernica"
                    ],
                    "common_phrases": [
                        "zbierać jagody",
                        "ciasto z jagodami"
                    ],
                    "target_lang_definitions": {
                        "ru": "плод черники обыкновенной"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черника",
                                "target_lang_sense_clarification": "плод лесного кустарника с темно-синими ягодами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4de0786f-9ad3-3a5e-b546-6699ef89af06",
                    "sense_definition": "policzek, zwłaszcza u dziecka lub młodej osoby",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "części ciała",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jej <w>jagodach</w> pojawiły się rumieńce ze wstydu.",
                            "target_lang_translations": {
                                "ru": "На её <w>ланитах</w> появился румянец от стыда."
                            }
                        },
                        {
                            "text": "Dziecko miało pulchne i czerwone <w>jagody</w>.",
                            "target_lang_translations": {
                                "ru": "У ребенка были пухлые и красные <w>щечки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "policzek",
                        "polik"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane w literaturze lub gwarowo"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "щека (устаревшее, поэтическое)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ланита",
                                "target_lang_sense_clarification": "устаревшее или поэтическое обозначение щеки"
                            },
                            {
                                "target_lang_word": "щека",
                                "target_lang_sense_clarification": "общеупотребительное название части лица"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
