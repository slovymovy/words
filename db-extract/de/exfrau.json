                            {
                                "example_id": "55fcc690-defd-4e9c-9cb9-1096a769bbc1",
                                "sense_id": "3eca936f-b0a0-3513-b622-58da1c65cc30",
                                "text": "„Die Exfrau des festgenommenen Tatverdächtigen soll mit dem niedergeschossenen Opfer liiert sein, wie die Polizei am Dienstag in Cloppenburg mitteilte.“"
                            },
                            {
                                "example_id": "b3ab22cf-5179-4de7-be72-0a5afcabc968",
                                "sense_id": "3eca936f-b0a0-3513-b622-58da1c65cc30",
                                "text": "Alex kommt mit all seinen Exfrauen blendend aus."
                            }
                        ],
