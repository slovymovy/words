                        "glosses": [
                            "Numenius, rodzaj dużego i cętkowanego, eurazjatyckiego ptaka z długim dziobem, z rodziny bekasowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4040e49b-25b6-4540-959b-98738239579e",
                                "sense_id": "4324a92a-592c-3ea2-99e0-cf66eb4224ef",
                                "text": "Były tam […] i żurawie z koronami na głowach, mnóstwo kulików, pstrych i szarych jak myszy, biegających szybko tam i na powrót, niby drobne duchy leśne, na długich, cienkich jak słomki nóżkach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f36f879f-6561-3412-8fbb-d8ae88bf44f5",
                        "entry_id": "75abacd1-11fc-3a18-9d24-5c1b5c45119b",
                        "glosses": [
                            "dziś zob. kulig"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
