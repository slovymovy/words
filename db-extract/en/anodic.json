                                    },
                                    {
                                        "sense_id": "f39c1be2-951f-31c1-bb6c-67167fd44d2a",
                                        "entry_id": "06e22f08-150b-3010-b58a-9d1435d6b849",
                                        "glosses": [
                                            "Qualifie un phénomène qui se produit à l’anode d’une cuve à électrolyse."
                                        ],
                                        "tags": [
                                            "Électrotechnique"
                                        ],
                                        "examples": [
                                            {
