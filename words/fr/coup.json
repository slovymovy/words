    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3280e609-0f1e-31dc-b041-658942ac5b0f",
                    "sense_definition": "Choc physique produit par un corps qui en heurte violemment un autre, ou frappe infligée volontairement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frappe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boxeur a esquivé le premier <w>coup</w> avant de riposter rapidement."
                        },
                        {
                            "text": "Quelqu'un a frappé deux <w>coups</w> timides à la porte du salon."
                        }
                    ],
                    "synonyms": [
                        "choc"
                    ],
                    "antonyms": [
                        "caresse"
                    ],
                    "common_phrases": [
