                "senses": [
                    {
                        "sense_id": "a08f81b2-e1c2-3450-b922-79a3e510ef71",
                        "entry_id": "fe187014-59d6-38e6-aaeb-dde472736f9b",
                        "glosses": [
                            "vornehmer Liebhaber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffd84a5c-0a8d-4198-9c32-03db4e681c70",
                                "sense_id": "a08f81b2-e1c2-3450-b922-79a3e510ef71",
                                "text": "„Ist's nicht ein Mann, sei’s derweil ein Galan.“"
                            },
                            {
                                "example_id": "01cad1b9-b69c-42a7-a427-c2cfe67bcc4e",
                                "sense_id": "a08f81b2-e1c2-3450-b922-79a3e510ef71",
                                "text": "„Es mag einer unmittelbar vor ihr stehen und noch so sehr auf sie einreden und ihr den Hof mchen, so eine Kurzsichtige bleibt dem fremden Galan gegenüber gleichgültig und reserviert, gleichsam wie in eine Wolke gehüllt.“"
                            },
                            {
                                "example_id": "6008a897-0ca2-459f-bb8d-816282fca19f",
                                "sense_id": "a08f81b2-e1c2-3450-b922-79a3e510ef71",
                                "text": "Rosa hat einen heimlichen Galan, der ihr eine Rose ans Auto gesteckt hat."
                            },
                            {
                                "example_id": "bcdec788-4efa-499f-b647-51631844c82a",
                                "sense_id": "a08f81b2-e1c2-3450-b922-79a3e510ef71",
                                "text": "Martha hatte nichts gegen einen zahlungskräftigen Galan einzuwenden, im Gegenteil."
                            },
                            {
                                "example_id": "e37a5c49-5eb0-4a47-9c8a-9db48082dafc",
                                "sense_id": "a08f81b2-e1c2-3450-b922-79a3e510ef71",
                                "text": "„Über eine unangenehme Posse ist zu berichten, wir erinnern uns: Der alternde Wieland hat behauptet, Sophies Schwester, die Frau des Bürgermeisters Hillern, habe dem in den Kopf gesetzt, Wieland nach Biberach zu holen, weil sie ihn als Galan bei sich gewollt habe, schließlich habe sie ihm gar die Hand ihrer Schwiegertochter angedient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e4105f-3706-4ef6-8aca-23dca408e6b2",
                        "source_entry_id": "fe187014-59d6-38e6-aaeb-dde472736f9b",
                        "source_sense_id": "a08f81b2-e1c2-3450-b922-79a3e510ef71",
                        "source_sense_description": "vornehmer Liebhaber",
                        "target_lang_word": "gallant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a8f04d6-3995-38f4-bb4d-4e8f91bbaa90",
                                        "entry_id": "bbb5ff98-9058-3f0e-b931-3d6a34515443",
                                        "glosses": [
                                            "Brave, valiant, courteous, especially with regard to male attitudes towards women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df898cd6-98f9-4691-8dbb-24f3889e6500",
                                                "sense_id": "2a8f04d6-3995-38f4-bb4d-4e8f91bbaa90",
                                                "text": "That gallant spirit hath aspired the clouds."
                                            },
                                            {
                                                "example_id": "b4e5f6fa-7875-4d00-8ba2-00fa75dc152a",
                                                "sense_id": "2a8f04d6-3995-38f4-bb4d-4e8f91bbaa90",
                                                "text": "It is plain that the great majority of school children must be regarded, from the physical standpoint, as decidedly gallant little persons, who have wrestled through their infancy and have managed to come out of tribulations that have killed a large proportion of all the children of their birth-years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3d1c04c-f5f5-390f-8713-783cfc0aeafe",
                                        "entry_id": "bbb5ff98-9058-3f0e-b931-3d6a34515443",
                                        "glosses": [
                                            "Honorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9dc08e4-046f-4204-ad65-5c396ae07696",
                                                "sense_id": "b3d1c04c-f5f5-390f-8713-783cfc0aeafe",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "523d1f34-f722-33f9-b0ce-d4f03f187b37",
                                        "entry_id": "bbb5ff98-9058-3f0e-b931-3d6a34515443",
                                        "glosses": [
                                            "Grand, noble."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "218df44b-dee8-36ad-b169-64d7a0dcc1ff",
                                        "entry_id": "bbb5ff98-9058-3f0e-b931-3d6a34515443",
                                        "glosses": [
                                            "Showy; splendid; magnificent; gay; well-dressed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4174e7b7-4b5a-41ca-bff6-e1882449622c",
                                                "sense_id": "218df44b-dee8-36ad-b169-64d7a0dcc1ff",
                                                "text": "This town is built in a very gallant place."
                                            },
                                            {
                                                "example_id": "521735e6-751c-4b27-8284-f600ae2b240c",
                                                "sense_id": "218df44b-dee8-36ad-b169-64d7a0dcc1ff",
                                                "text": "our royal, good and gallant ship"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gallant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2a524a-f228-37b2-8892-51f99a21c506",
                                        "entry_id": "bfc90121-945e-34fa-a72c-22f1d2b71abc",
                                        "glosses": [
                                            "Polite and attentive to ladies; courteous to women; chivalrous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7612522-4d2a-4300-b844-eddf5edfb6c0",
                                                "sense_id": "ba2a524a-f228-37b2-8892-51f99a21c506",
                                                "text": "I admire all that quaint, old-fashioned politeness; it is much more to my taste than modern ease; modern ease often disgusts me. But this good old Mr. Woodhouse, I wish you had heard his gallant speeches to me at dinner. Oh! I assure you I began to think my caro sposo would be absolutely jealous."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gallant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b773e0c5-1106-333e-9d0e-2634ca8e7881",
                                        "entry_id": "87fb5423-38a2-3a89-a1f7-698e6baf0ddf",
                                        "glosses": [
                                            "A fashionable young man who is polite and attentive to women."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccc01169-427a-4e26-87e2-b132f5c820d8",
                                                "sense_id": "b773e0c5-1106-333e-9d0e-2634ca8e7881",
                                                "text": "PROSPERO: […] this gallant which thou see'st / Was in the wrack; and but he's something stain'd / with grief,—that beauty's canker,—thou mightst call him / A goodly person […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847316c6-e76d-3d54-a6d5-f0c9459559de",
                                        "entry_id": "87fb5423-38a2-3a89-a1f7-698e6baf0ddf",
                                        "glosses": [
                                            "One who woos, a lover, a suitor, a seducer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4198c3ac-9aa1-47af-af43-aff0106e58f2",
                                                "sense_id": "847316c6-e76d-3d54-a6d5-f0c9459559de",
                                                "text": "[…] they were discovered in a very improper manner by the husband of the gypsy, who, from jealousy it seems, had kept a watchful eye over his wife, and had dogged her to the place, where he found her in the arms of her gallant."
                                            },
                                            {
                                                "example_id": "09705dcc-6625-48ed-b4b6-23ad5a0a211c",
                                                "sense_id": "847316c6-e76d-3d54-a6d5-f0c9459559de",
                                                "text": "The ignominy of that whisper'd tale / About a midnight gallant, seen to climb / A window to her chamber neighbour'd near, / I will from her turn off, and put the load / On the right shoulders; on that wretch's head, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "765bce13-27dc-3691-ade5-07de5723fdf7",
                                        "entry_id": "87fb5423-38a2-3a89-a1f7-698e6baf0ddf",
                                        "glosses": [
                                            "A topgallant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gallant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6704ddb8-e134-3165-82c8-cc5becde1853",
                                        "entry_id": "7b0a7379-a43b-3d91-abf1-9d851aeac677",
                                        "glosses": [
                                            "To attend or wait on (a lady)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f29fda2e-1040-4d13-a19f-bc488400ed8b",
                                                "sense_id": "6704ddb8-e134-3165-82c8-cc5becde1853",
                                                "text": "to gallant ladies to the play"
                                            },
                                            {
                                                "example_id": "90fbe8c5-e3fe-4718-bf40-10bfd18721aa",
                                                "sense_id": "6704ddb8-e134-3165-82c8-cc5becde1853",
                                                "text": "During this period, we were the lions of the neighbourhood; and, no doubt, strangers from the distant villages were taken to see the \"Karhowrees\" (white men), in the same way that countrymen, in a city, are gallanted to the Zoological Gardens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e283013d-09ff-3ba2-a092-d754c3abd332",
                                        "entry_id": "7b0a7379-a43b-3d91-abf1-9d851aeac677",
                                        "glosses": [
                                            "To handle with grace or in a modish manner."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f219d135-6b66-4098-a573-780209f1ed3d",
                                                "sense_id": "e283013d-09ff-3ba2-a092-d754c3abd332",
                                                "text": "to gallant a fan"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41b93a48-815c-31a8-96a1-deac23eb0982",
                                        "entry_id": "7b0a7379-a43b-3d91-abf1-9d851aeac677",
                                        "glosses": [
                                            "To conduct, escort, convey."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28984358-7ea9-4dd7-bfd2-520d8fce6246",
                                                "sense_id": "41b93a48-815c-31a8-96a1-deac23eb0982",
                                                "text": "... and the canoes of Vivenza, locking their yard-arms into those of the vanquished, very courteously gallanted them into their coral harbors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd79e1b7-ca93-337d-86d9-a8d82693a90a",
                                        "entry_id": "7b0a7379-a43b-3d91-abf1-9d851aeac677",
                                        "glosses": [
                                            "To behave in a gallant fashion; to act the gallant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c86a346-f67f-4db9-af9b-3763d04ec07f",
                                                "sense_id": "fd79e1b7-ca93-337d-86d9-a8d82693a90a",
                                                "text": "How different is the young, fun-loving, comical, quizzing, gallanting Captain Arthur Wellesley, when residing in his shooting lodge between Summerhill and Dangan, from the stern, cautious, careworn Fabius of the Peninsular war[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
