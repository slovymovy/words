                ],
                "senses": [
                    {
                        "sense_id": "330d0d37-a408-3a0e-a8ec-7de0b97f407e",
                        "entry_id": "d64e7a7c-17a9-3641-a3c4-668997dbc49f",
                        "glosses": [
                            "geschmorter Braten, der zuvor in einer sauren Marinade eingelegt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94444d43-d94c-474f-830b-57a88c80eacb",
                                "sense_id": "330d0d37-a408-3a0e-a8ec-7de0b97f407e",
                                "text": "Sauerbraten ist durch das tagelange Marinieren besonders mürbe."
                            },
                            {
                                "example_id": "3b41e64c-698d-406f-8e0c-2af12ad9f009",
                                "sense_id": "330d0d37-a408-3a0e-a8ec-7de0b97f407e",
                                "text": "„Frau Schmulevitch hatte sich sichtlich Mühe gegeben: der Sauerbraten war erstklassig, ebenso die Klöße.“"
                            },
                            {
                                "example_id": "39e1cf03-3835-47f1-aaed-1533b4926b0a",
                                "sense_id": "330d0d37-a408-3a0e-a8ec-7de0b97f407e",
                                "text": "„Bodendiek verteilt den Sauerbraten zwischen uns.“"
                            },
                            {
                                "example_id": "d26609bf-8ed1-4673-867e-b081ad71d5cd",
                                "sense_id": "330d0d37-a408-3a0e-a8ec-7de0b97f407e",
                                "text": "„Papa hat Sauerbraten mit Rosinen und Klößen, und ich habe eine Bratwurst mit Pommes frites und Salat gegessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
