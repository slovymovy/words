                "senses": [
                    {
                        "sense_id": "583e7128-b7ff-3d79-bfef-850ed8a0ed14",
                        "entry_id": "373d2125-ca79-3d8d-a49c-59353065591d",
                        "glosses": [
                            "начать сверлить"
                        ],
                        "tags": [
                            "что и без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "358a76d2-80d4-41f1-9a13-1f895d9e1aaa",
                                "sense_id": "583e7128-b7ff-3d79-bfef-850ed8a0ed14",
                                "text": "Звонок засверлил опять, на этот раз настойчиво и раздраженно."
                            },
                            {
                                "example_id": "fd37f284-4f5b-4006-9baf-23ef16685505",
                                "sense_id": "583e7128-b7ff-3d79-bfef-850ed8a0ed14",
                                "text": "Лейтенант, что-то вспомнив, вытащил из кармана какую-то фотографию и засверлил взглядом Пилию…"
                            }
                        ]
                    },
                    {
                        "sense_id": "25adb213-834b-3302-a822-248283a0f263",
                        "entry_id": "373d2125-ca79-3d8d-a49c-59353065591d",
                        "glosses": [
                            "просверлить дыру, дыры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5874a4-eebc-4b17-91ce-0448a59ff30b",
                                "sense_id": "25adb213-834b-3302-a822-248283a0f263",
                                "text": "Я писал: «Засверлить мой пистолет и передать сыну»."
                            }
                        ]
