                "senses": [
                    {
                        "sense_id": "b9bdb3b0-8041-38dd-a576-609514745849",
                        "entry_id": "1d580509-851d-3aa5-ae14-f49c77ee9f79",
                        "glosses": [
                            "Dessert à base de lait, d’amandes, de sucre et d’un aliment épaississant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c4216d-b5cc-42e0-b83f-1d63a8a1d9d7",
                                "sense_id": "b9bdb3b0-8041-38dd-a576-609514745849",
                                "text": "Car, pour le bal, c’est une chose décidée, et je ferai les invitations dès que Nicholle aura fait les provisions nécessaires pour le blanc-manger et les fromages glacés."
                            },
                            {
                                "example_id": "520f9ef0-a423-4b5c-840f-88df6cd8145a",
                                "sense_id": "b9bdb3b0-8041-38dd-a576-609514745849",
                                "text": "Deux perdrix cuirassées d’une barde de lard doré se prélassaient au milieu d’un cercle de rouelles d’oranges ; des blanc-manger et une tourte aux quenelles de poisson, chef-d’œuvre de maître Bilot, les accompagnaient."
                            },
                            {
                                "example_id": "924f9f9a-fa38-45ec-9158-a63b97f1f371",
                                "sense_id": "b9bdb3b0-8041-38dd-a576-609514745849",
                                "text": "Les circonvolutions compactes étaient enveloppées de dure-mère, ornées d’un réseau de nerfs et alimentées par d’épaisses artères qui ressemblaient à des galeries dans du blanc-manger."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a18a7c8-210d-3707-903b-c7d87f187f86",
                        "entry_id": "1d580509-851d-3aa5-ae14-f49c77ee9f79",
                        "glosses": [
                            "Dessert à base de lait, de sucre et de fécule de maïs."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e93294cd-5177-40c3-b581-f964051796a2",
                        "source_entry_id": "1d580509-851d-3aa5-ae14-f49c77ee9f79",
