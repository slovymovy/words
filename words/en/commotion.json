{
    "word_family": [
        "commote"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                    "sense_definition": "A noisy, confused, or agitated disturbance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>commotion</w> in the hallway made everyone stop what they were doing.",
                            "target_lang_translations": {
                                "cs": "Náhlý <w>rozruch</w> na chodbě přiměl všechny přestat s tím, co právě dělali.",
                                "de": "Der plötzliche <w>Aufruhr</w> auf dem Flur brachte alle dazu, innezuhalten.",
                                "ru": "Внезапный <w>переполох</w> в коридоре заставил всех оторваться от своих дел."
                            }
                        },
                        {
                            "text": "She looked out the window to see what all the <w>commotion</w> was about.",
                            "target_lang_translations": {
                                "cs": "Podívala se z okna, aby zjistila, co je to za <w>pozdvižení</w>.",
                                "de": "Sie schaute aus dem Fenster, um zu sehen, worum es bei der ganzen <w>Aufregung</w> ging.",
                                "ru": "Она выглянула в окно, чтобы узнать, из-за чего вся эта <w>суматоха</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disturbance",
                        "uproar",
                        "hubbub",
                        "tumult",
                        "chaos"
                    ],
                    "common_phrases": [
                        "cause a commotion"
                    ],
                    "target_lang_definitions": {
                        "cs": "Hlučný, zmatený nebo rozrušený stav, vyvolávající pozornost.",
                        "de": "Eine laute, verworrene oder aufgeregte Unruhe bzw. Störung.",
                        "ru": "Шумное, беспокойное или суматошное происшествие, привлекающее внимание."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozruch",
                                "target_lang_sense_clarification": "obecný výraz pro hlučnou situaci nebo vzrušení"
                            },
                            {
                                "target_lang_word": "pozdvižení",
                                "target_lang_sense_clarification": "náhlý neklid nebo rozruch vyvolaný událostí"
                            },
                            {
                                "target_lang_word": "mela",
                                "target_lang_sense_clarification": "neformální výraz pro zmatek, vřavu nebo nepřehlednou situaci"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Aufruhr",
                                "target_lang_sense_clarification": "Zustand großer Unruhe, Empörung oder Erregung"
                            },
                            {
                                "target_lang_word": "Aufregung",
                                "target_lang_sense_clarification": "hektisches, aufgeregtes Durcheinander oder Getue"
                            },
                            {
                                "target_lang_word": "Tumult",
                                "target_lang_sense_clarification": "lautstarkes, unkontrolliertes Chaos und Durcheinander"
                            },
                            {
                                "target_lang_word": "Trubel",
                                "target_lang_sense_clarification": "lebhaftes und lautes Durcheinander"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "суматоха",
                                "target_lang_sense_clarification": "беспорядочная суета, торопливость и шум"
                            },
                            {
                                "target_lang_word": "переполох",
                                "target_lang_sense_clarification": "внезапная тревога, всеобщее волнение"
                            },
                            {
                                "target_lang_word": "шумиха",
                                "target_lang_sense_clarification": "громкий шум, оживление или переполох"
                            },
                            {
                                "target_lang_word": "сумятица",
                                "target_lang_sense_clarification": "неразбериха и сумбур"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69155af0-99ea-3189-941e-b1de5c4cb90f",
                    "sense_definition": "A state of turbulent or violent physical motion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disturbance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ocean was in a state of <w>commotion</w> during the powerful storm.",
                            "target_lang_translations": {
                                "cs": "Oceán byl během silné bouře v naprostém <w>neklidu</w>.",
                                "de": "Der Ozean befand sich während des gewaltigen Sturms in wildem <w>Aufruhr</w>.",
                                "ru": "Во время мощного шторма океан находился в состоянии сильного <w>волнения</w>."
                            }
                        },
                        {
                            "text": "Deep underground, the <w>commotion</w> of shifting tectonic plates caused the earthquake.",
                            "target_lang_translations": {
                                "cs": "Hluboko pod zemí způsobilo <w>vření</w> posouvajících se tektonických desek zemětřesení.",
                                "de": "Tief unter der Erde verursachte die <w>heftige Bewegung</w> der sich verschiebenden tektonischen Platten das Erdbeben.",
                                "ru": "Глубоко под землей <w>бурное движение</w> смещающихся тектонических плит вызвало землетрясение."
                            }
                        }
                    ],
                    "synonyms": [
                        "turmoil",
                        "turbulence"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav bouřlivého nebo prudkého fyzického pohybu.",
                        "de": "Ein Zustand heftiger, turbulenter physischer Bewegung.",
                        "ru": "Состояние бурного, яростного или хаотичного физического движения."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neklid",
                                "target_lang_sense_clarification": "stav neustálého pohybu nebo nestability"
                            },
                            {
                                "target_lang_word": "vření",
                                "target_lang_sense_clarification": "intenzivní, bouřlivý pohyb připomínající vření"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Aufruhr",
                                "target_lang_sense_clarification": "heftige Bewegung oder Toben von Naturgewalten"
                            },
                            {
                                "target_lang_word": "Turbulenz",
                                "target_lang_sense_clarification": "starke, unruhige Verwirbelung oder Erschütterung"
                            },
                            {
                                "target_lang_word": "Aufruhr der Elemente",
                                "target_lang_sense_clarification": "wildes Wüten oder Toben der Natur"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "волнение",
                                "target_lang_sense_clarification": "бурное движение стихии, например волн на воде"
                            },
                            {
                                "target_lang_word": "буйство",
                                "target_lang_sense_clarification": "яростное, неистовое проявление стихийных сил"
                            },
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "хаотическое, беспорядочное движение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}