                "senses": [
                    {
                        "sense_id": "66667321-e456-3891-8392-265980954991",
                        "entry_id": "af78fe10-0d10-3fb5-9635-f0a78cd1df16",
                        "glosses": [
                            "wreed, moordzuchtig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c304d33-464c-4f25-8d87-d646871a2f5b",
                                "sense_id": "66667321-e456-3891-8392-265980954991",
                                "text": "De bloeddorstige soldaten vochten zeer wreed in de oorlog."
                            },
                            {
                                "example_id": "c915bad5-f2df-4545-8945-a95e4cc1a7f2",
                                "sense_id": "66667321-e456-3891-8392-265980954991",
                                "text": "In Macbeth, die zich een weg naar de Schotse troon moordt, schuilt een bloeddorstig dier'."
                            },
                            {
                                "example_id": "c78ab5d1-213e-4337-8edb-a7aae9f049d7",
                                "sense_id": "66667321-e456-3891-8392-265980954991",
                                "text": "Volgens de overlevering vluchtten meisjes uit Plancher-Les-Mines gedurende de Dertigjarige Oorlog (1618-1648) de bossen in om te ontkomen aan bloeddorstige huurlingen in dienst van de Zweedse bezetter."
                            }
                        ]
                    }
                ],
