        "de-extract.jsonl": [
            {
                "entry_id": "8466ec69-8f49-3077-bdcd-9a9e769d6a13",
                "word": "erstmal",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                        "entry_id": "8466ec69-8f49-3077-bdcd-9a9e769d6a13",
                        "glosses": [
                            "bevor etwas anderes geschieht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "58e10e5e-113c-461a-a051-b3e7a18c16c5",
                                "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                                "text": "»Ich mache jetzt erstmal Frühstück, dann schreibe ich den Bericht zu Ende.«"
                            },
                            {
                                "example_id": "1f93ccb1-3a75-493d-ab63-687122e85f4a",
                                "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                                "text": "[Mutter zum Sohn:] »Erstmal gehst du dich waschen, dann kommst Du zum Abendessen.«"
                            },
                            {
                                "example_id": "791f1149-d876-49df-a772-42b3b5a23fa2",
                                "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                                "text": "Erstmal werden keine Mitarbeiter entlassen."
                            },
                            {
                                "example_id": "a09b701d-8120-44a9-abbd-4cc26029a0ea",
                                "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                                "text": "„Um das Schlangengehege reinigen zu können, muss die Reptilienfachfrau erstmal alle Giftschlangen einfangen.“"
                            },
                            {
                                "example_id": "bf40ad21-37b6-4c5c-b72b-bc4a8f259377",
                                "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                                "text": "„Hat man erstmal verstanden, wie der Mechanismus funktioniert, kann man ganz eigene Pop-up-Bücher basteln […].“"
                            },
                            {
                                "example_id": "c4fad18b-950a-48f6-a1ff-ff6f8b45ee49",
                                "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                                "text": "„Die 21-jährige Londonerin war erstmal baff, als sie sich auf DER Hypeliste schlechthin wiederfand - dem \"Sound Of 2016\" der BBC […].“"
                            },
                            {
                                "example_id": "7ed141b6-0c5e-4593-a7c1-43c0572cc3e2",
                                "sense_id": "e495e7ac-cf5c-38f8-b411-792d1aca3632",
                                "text": "[Schlagzeile:] „IWF-Chefin Lagarde kann aufatmen – erstmal“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
