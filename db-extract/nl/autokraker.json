                            {
                                "example_id": "2da497c0-dee4-4721-b2e9-967e1ee51785",
                                "sense_id": "f51efa2e-1678-31dd-b623-dc8eabbc49a0",
                                "text": "Als een autokraker op heterdaad wordt betrapt, staat hij eerder weer buiten in de Warmoesstraat dan de eigenaar die binnen aangifte heeft gedaan."
                            },
                            {
                                "example_id": "9e3ec483-737c-4000-8bb2-176868978233",
                                "sense_id": "f51efa2e-1678-31dd-b623-dc8eabbc49a0",
                                "text": "Nederland krijgt de komende jaren te maken met een nieuw type veelpleger, zegt de Rotterdamse korpschef Paauw. De aan drugs verslaafde autokraker verdwijnt. Zijn opvolger is uit op geld, status en kicks. Hij intimideert zijn buurt en voelt zich onaantastbaar."
                            }
