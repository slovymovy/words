                                "example_id": "d496d872-c85b-4d45-81d4-ddfa8fc661b2",
                                "sense_id": "469b5a00-f52e-3fe8-aca6-3ba9257e7886",
                                "text": "The Punic Wars […] he presented as a gigantic necessary struggle between noble north-side soldiers and revengeful, obdurate, but extremely competent south-side loanmongers."
                            }
