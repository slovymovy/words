        "fr-extract.jsonl": [
            {
                "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                "word": "divertissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "615bab0a-e065-45e3-89a6-36d63b48c2cd",
                        "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "tags": [
                            "plural"
                        ],
                        "form": "divertissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26b64377-b039-3f1b-a6c3-557eb67cdfcb",
                        "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "glosses": [
                            "Récréation, amusement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cec204c-ac4c-4f71-b117-f03300233c38",
                                "sense_id": "26b64377-b039-3f1b-a6c3-557eb67cdfcb",
                                "text": "Il y a là des cafés maures où les femmes dansent et chantent jusqu'à dix heures du soir, et où l'on fume le Kif toute la nuit, portes closes. Tel est le lieu de divertissement des militaires de la garnison."
                            },
                            {
                                "example_id": "b15d6843-c721-4768-bbdb-a9c408a45211",
                                "sense_id": "26b64377-b039-3f1b-a6c3-557eb67cdfcb",
                                "text": "Malgré la complaisance avec laquelle ses moindres désirs sont accueillis, elle se sait gardée, et la vie qu’elle mène offrirait peu de plaisir à une jeune fille qui n’aurait pas trouvé comme elle des divertissements dans les livres."
                            },
                            {
                                "example_id": "f629f72a-ed9a-4c74-90d5-4cd5905c84cb",
                                "sense_id": "26b64377-b039-3f1b-a6c3-557eb67cdfcb",
                                "text": "Le tatouage, en effet, est une institution dans la marine américaine et des heures de service sont spécialement réservées à ce divertissement artistique."
                            },
                            {
                                "example_id": "9d546833-4a99-446d-905e-354c507027ed",
                                "sense_id": "26b64377-b039-3f1b-a6c3-557eb67cdfcb",
                                "text": "Ainsi, la Bouillotte fut-elle, pendant un certain temps, un divertissement des familles autant que de salon. Les romans de Balzac, vous vous en souvenez, évoquent d'heureux joueurs de bouillotte."
                            }
                        ]
                    },
                    {
                        "sense_id": "9674f2c8-3f89-3333-a8cd-950e4d63a527",
                        "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "glosses": [
                            "Émission de télévision dont le but principal est de divertir le téléspectateur."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b80cd74-296e-3bd9-8414-781a438de70b",
                        "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "glosses": [
                            "Partie dansée, quelquefois mêlée de chant, d’un opéra ou de toute autre pièce de théâtre."
                        ],
                        "tags": [
                            "especially",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ccb1fd6d-883d-463e-bd6a-0a55e9e734a3",
                                "sense_id": "7b80cd74-296e-3bd9-8414-781a438de70b",
                                "text": "Il y a un divertissement au quatrième acte de cette comédie."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bf50cb4-182b-3777-824c-69fdf82c8962",
                        "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "glosses": [
                            "Occupation plus ou moins agréable qui détourne l’homme de lui-même et le fait sortir de lui."
                        ],
                        "tags": [
                            "Autrefois"
                        ],
                        "examples": [
                            {
                                "example_id": "7b4fa7f6-69eb-4fb3-897b-43569369724d",
                                "sense_id": "7bf50cb4-182b-3777-824c-69fdf82c8962",
                                "text": "Pascal expose dans ses Pensées la théorie du divertissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "01359eed-0b45-3921-a736-02e9257886fa",
                        "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "glosses": [
                            "Détournement à son profit."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b6baaf63-7eec-40fb-8edd-d5f93af2c47d",
                                "sense_id": "01359eed-0b45-3921-a736-02e9257886fa",
                                "text": "[…], certainement il sera puni comme banqueroutier frauduleux, parce qu’il y a dans son fait un divertissement véritable, et que par cette raison il se trouve littéralement compris dans l’art. 10 du tit. II de l’ordonnance de 1673."
                            }
                        ]
                    },
                    {
                        "sense_id": "db89c457-366b-3c24-891c-7624d0ea5e58",
                        "entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "glosses": [
                            "Ce qui détourne des choses sérieuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997ead94-a3d4-412a-9480-2cc346ef43e2",
                                "sense_id": "db89c457-366b-3c24-891c-7624d0ea5e58",
                                "text": "[…]: c’est qu’on mesure mal l’état de divertissement où sont ravis tant de jeunes gens qui découvrent à la fois les livres et les femmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9623563-15cc-4cd0-abae-58e0ce7456bd",
                        "source_entry_id": "ea95d3a8-8593-36f2-9f16-6d9439f438ac",
                        "source_sense_description": "récréation, amusement",
                        "target_lang_word": "entertainment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entertainment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abb57c31-ed1a-3039-a3f2-b5486c9a5ec8",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "An activity designed to give pleasure, enjoyment, diversion, amusement, or relaxation to an audience, no matter whether the audience participates passively as in watching opera or a movie, or actively as in games."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325a70f4-d30f-4477-875b-193ff02e0a1a",
                                                "sense_id": "abb57c31-ed1a-3039-a3f2-b5486c9a5ec8",
                                                "text": "The delinquents are generally the adventurous type, who have little use for reading and other non-active entertainment."
                                            },
                                            {
                                                "example_id": "93ce923a-1f09-428e-ba91-7a5cb22b01ba",
                                                "sense_id": "abb57c31-ed1a-3039-a3f2-b5486c9a5ec8",
                                                "text": "Such abundance must be laid out on superfluous recreations, buildings, ornaments, furniture, equipage, attendants, entertainments, visitations, braveries, and a world of need-nots […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45dd979a-3ad7-3b0a-a2f1-ea1aa6abe29c",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "A show put on for the enjoyment or amusement of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "108f38ec-008e-3073-8b62-0e00cd978927",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Maintenance or support."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d52b3d36-f6c3-412f-9153-d8ea8a2f3c30",
                                                "sense_id": "108f38ec-008e-3073-8b62-0e00cd978927",
                                                "text": "\"This,\" said the matronly presence, ushering me into a low room on the right, \"is where the Travellers sit by the fire, and cook what bits of suppers they buy with their fourpences.\"\n\"O! Then they have no Entertainment?\" said I. For the inscription over the outer door was still running in my head, and I was mentally repeating, in a kind of tune, \"Lodging, entertainment, and fourpence each.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3d541d-04e9-32ec-8a53-2690a4454551",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Admission into service; service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7397a25-e708-4111-ac23-ca6cf73453d2",
                                                "sense_id": "9d3d541d-04e9-32ec-8a53-2690a4454551",
                                                "text": "He must think us some band of strangers i' the adversary's entertainment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30693a60-9ea7-300b-9b48-819d4208654b",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Payment of soldiers or servants; wages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a8e9ef-4444-43f0-a270-aebc16f0f1fb",
                                                "sense_id": "30693a60-9ea7-300b-9b48-819d4208654b",
                                                "text": "The entertainment of the general upon his first arrival was but six shillings and eight pence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6e94862-783e-3242-aa40-ae37ac59a68c",
                                        "entry_id": "ecb8b524-c38f-3f9b-b832-7edb5fba7200",
                                        "glosses": [
                                            "Reception; (provision of) food to guests or travellers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6340b628-b257-463c-bc12-66c3622f2eb1",
                                                "sense_id": "f6e94862-783e-3242-aa40-ae37ac59a68c",
                                                "text": "I prithee, shepherd, if that love or gold\nCan in this desert place buy entertainment,\nBring us where we may rest ourselves and feed."
                                            },
                                            {
                                                "example_id": "269ecc95-0e1e-4bac-8788-7ef2841bf719",
                                                "sense_id": "f6e94862-783e-3242-aa40-ae37ac59a68c",
                                                "text": "Tho’ they cut [the beef] into long Pieces, (like Ropes) with the Hide; and dress’d, and eat it half-roasted according to their Custom, and gave it me in the same Manner; yet I thought this contemptible Food, and what a Beggar in England would not have touch’d, the most delicious Entertainment I ever met with."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
