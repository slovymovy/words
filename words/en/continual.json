{
    "word_family": [
        "continue",
        "continuity",
        "continuance",
        "continuation",
        "continuum"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1aab2f6e-e76c-36d3-bf5c-e42051e04659",
                    "sense_definition": "Happening repeatedly with very little time between each occurrence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city suffered from <w>continual</w> <w>power</w> <w>outages</w> throughout the winter.",
                            "target_lang_translations": {
                                "zh": "整个冬天，这座城市一直遭受<w>频繁的</w>停电。"
                            }
                        },
                        {
                            "text": "She was exhausted by the <w>continual</w> noise coming from the construction site next door.",
                            "target_lang_translations": {
                                "zh": "隔壁建筑工地传来的<w>不断</w>噪音让她精疲力竭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frequent",
                        "constant",
                        "recurrent"
                    ],
                    "common_phrases": [
                        "continual power outages",
                        "continual noise"
                    ],
                    "target_lang_definitions": {
                        "zh": "指频繁发生，中间几乎没有间隔。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "频繁的",
                                "target_lang_sense_clarification": "强调动作或事件发生的频率很高。"
                            },
                            {
                                "target_lang_word": "不断的",
                                "target_lang_sense_clarification": "强调重复发生，几乎没有停顿。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7eb6688-db4e-36cf-9be8-7065ca8afbac",
                    "sense_definition": "Appearing to happen without any pause or end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>continual</w> <w>rain</w> made it impossible to finish the outdoor project on time.",
                            "target_lang_translations": {
                                "zh": "<w>持续的</w>降雨使得户外项目无法按时完成。"
                            }
                        },
                        {
                            "text": "His <w>continual</w> complaining about the weather eventually annoyed everyone in the office.",
                            "target_lang_translations": {
                                "zh": "他关于天气的<w>不停</w>抱怨最终让办公室里的每个人都感到厌烦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ceaseless",
                        "endless",
                        "incessant"
                    ],
                    "common_phrases": [
                        "continual rain",
                        "continual complaining"
                    ],
                    "target_lang_definitions": {
                        "zh": "指看起来没有停顿或终结，持续不断。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "持续的",
                                "target_lang_sense_clarification": "强调状态或动作的延续性。"
                            },
                            {
                                "target_lang_word": "不停的",
                                "target_lang_sense_clarification": "强调没有间断。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "722c0736-e053-3489-a6c1-25b3e792945e",
                    "sense_definition": "Arranged in a sequence that is connected and unbroken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The map shows a <w>continual</w> <w>mountain</w> <w>range</w> stretching across the entire continent.",
                            "target_lang_translations": {
                                "zh": "地图显示了一条横跨整个大陆的<w>连绵</w>山脉。"
                            }
                        },
                        {
                            "text": "The artist created a <w>continual</w> pattern that wrapped around the entire room.",
                            "target_lang_translations": {
                                "zh": "艺术家创作了一种环绕整个房间的<w>连续</w>图案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unbroken",
                        "connected"
                    ],
                    "common_phrases": [
                        "continual mountain range"
                    ],
                    "target_lang_definitions": {
                        "zh": "指排列成连接且不间断的序列。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "连续的",
                                "target_lang_sense_clarification": "强调事物在空间或逻辑上的连接性。"
                            },
                            {
                                "target_lang_word": "连绵的",
                                "target_lang_sense_clarification": "常用于形容山脉等地理特征的延伸。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}