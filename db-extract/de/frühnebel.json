                "senses": [
                    {
                        "sense_id": "01921680-ef7b-36f8-858b-48228b41600a",
                        "entry_id": "f313af84-a6ce-353f-b138-3315023e0343",
                        "glosses": [
                            "Nebel am frühen Morgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8591544-ae74-426f-bd55-c8d516b47a74",
                                "sense_id": "01921680-ef7b-36f8-858b-48228b41600a",
                                "text": "Sie fuhr wegen des Frühnebels sehr langsam."
                            },
                            {
                                "example_id": "853d02d6-528f-464d-a493-799036a8d1cd",
                                "sense_id": "01921680-ef7b-36f8-858b-48228b41600a",
                                "text": "„Über den Weinbergen liegt ein dunstiger Film, der Frühnebel ist nicht gänzlich verflogen.“"
                            },
                            {
                                "example_id": "7a7b9635-48bc-42d3-9714-b06821f8d06b",
                                "sense_id": "01921680-ef7b-36f8-858b-48228b41600a",
                                "text": "„Frühnebel wabern noch auf den Feldern, sammeln sich in den Senken und unter den Hecken, die die Felder parzelleiren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
