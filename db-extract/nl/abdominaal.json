                                        "examples": [
                                            {
                                                "example_id": "74496a6d-ea0a-4a52-9c05-c1c4a27bdc83",
                                                "sense_id": "696a679c-0981-31b2-bb2d-319fb3e26711",
                                                "text": "Der Patient muss abdominal untersucht werden."
                                            },
                                            {
                                                "example_id": "d9e63c0e-ffb3-45aa-91c0-4b8cb3ef1471",
                                                "sense_id": "696a679c-0981-31b2-bb2d-319fb3e26711",
                                                "text": "Diese unklare abdominale Erkrankung klang im Verlauf von zwei bis drei Wochen ab, aber seither bekam das Kind in unregelmäßigen Abständen Stören von Bauchweh und Durchfällen, meist nur kurz dauernd, ein bis zwei Tage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ca23e7f-e0b6-3d17-871b-5e5ca810671c",
                                        "entry_id": "d2d45e15-209c-3a8f-868e-507508c798e3",
                                        "glosses": [
                                            "den Hinterleib des Insekts betreffend"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001e0f55-0ffe-4501-9465-00286abd7931",
                                                "sense_id": "5ca23e7f-e0b6-3d17-871b-5e5ca810671c",
                                                "text": "Bei Insekten wird der Vorderabschnitt des abdominalen Tergums als Notum bezeichnet, der hintere Abschnitt als Postnotum."
                                            },
                                            {
                                                "example_id": "3ccb8e1d-8e4e-4036-80d1-52ef0bc6c640",
                                                "sense_id": "5ca23e7f-e0b6-3d17-871b-5e5ca810671c",
                                                "text": "Vom abdominal liegenden Röhrenherz der Insekten wird eine mit Nährstoffen angereicherte Hämolymphe im Körper verteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
