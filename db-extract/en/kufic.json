                    {
                        "translation_id": "b23c4916-53bb-4a2c-ba22-179ac29d3039",
                        "source_entry_id": "34af434b-a117-3ace-83a7-6e4967d4ea2c",
                        "source_sense_description": "Relating to original Arabic script",
                        "target_lang_word": "coufique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coufique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                        "entry_id": "1740e126-8977-3fac-b9cb-bd55dab4183d",
                                        "glosses": [
                                            "Qualifie les caractères alphabétiques dont se servaient les Arabes avant le quatrième siècle de l’hégire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13bc1be4-bc58-430e-849f-51453ef26e2b",
                                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                                "text": "Entrons plus avant dans la texture de la page coufique."
                                            },
                                            {
                                                "example_id": "89aec80b-54f1-43fd-9a42-3e130e83e054",
                                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                                "text": "Une signature typiquement coufique, puisque cette variante de la calligraphie arabe se caractérise par une exagération des horizontales et des verticales."
                                            },
                                            {
                                                "example_id": "a5955799-3f57-4e0d-91f4-cacbcdc85a66",
                                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                                "text": "Non moins curieux sont les bordures et les encadrements faits de caractères arabes, allant jusqu'à des transcriptions en coufique de passages du Coran (à Moissac, au Puy, à Saint-Guilhem-le-Désert dans l'Hérault)."
                                            },
                                            {
                                                "example_id": "3ffea1a6-7f5d-45d2-8f91-c770770c3e65",
                                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                                "text": "L’écriture coufique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coufique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90a93322-e9b9-3455-b689-634122fca2aa",
                                        "entry_id": "75874d6b-cff8-3b68-9d8f-92b211255a57",
                                        "glosses": [
                                            "Écriture arabe à caractères anguleux et rigides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25efe719-8315-4f9e-8ab5-ac2d6be6746c",
                                                "sense_id": "90a93322-e9b9-3455-b689-634122fca2aa",
                                                "text": "Le kufi ou coufique tire en fait son nom de la ville de Koufa sur l’Euphrate, en Irak, et correspond à la plus ancienne forme de calligraphie arabe, celle-là même en suage dans les premiers exemplaires du Coran."
                                            },
                                            {
                                                "example_id": "d6dd0cb9-f8c1-43e0-ab86-945c1b88d05a",
                                                "sense_id": "90a93322-e9b9-3455-b689-634122fca2aa",
                                                "text": "Le coufique fleuri, écriture dans laquelle les caractères sont prolongés et les espaces vides meublés d'éléments décoratifs végétaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e94e1d8f-58b0-49b1-94e6-6e2a36df8b1f",
                        "source_entry_id": "34af434b-a117-3ace-83a7-6e4967d4ea2c",
                        "source_sense_description": "Relating to original Arabic script",
                        "target_lang_word": "kufi",
