                "senses": [
                    {
                        "sense_id": "99ed37b1-18b0-31d8-9504-0f8baf43e9e8",
                        "entry_id": "ae063a15-6a29-3662-ac4d-16e4a08f947d",
                        "glosses": [
                            "diagnostisches Instrument zur Bestimmung der Brechkraft der Augen und ihrer Sehweite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "729d5e0f-1e5b-434d-a96c-14a2e8e41085",
                                "sense_id": "99ed37b1-18b0-31d8-9504-0f8baf43e9e8",
                                "text": "„Es wird mit dem Optometer die Fernpunktbestimmung getrennt für den horizontalen und den senkrechten Schnitt der Hornhaut ausgeführt und in Dioptrien (vgl. 2) umgerechnet.“"
                            },
                            {
                                "example_id": "2d085770-cae2-4ff6-a571-ea6c0ffacd00",
                                "sense_id": "99ed37b1-18b0-31d8-9504-0f8baf43e9e8",
                                "text": "„Das Tachistoskop wird benutzt, um die Auffassungsfähigkeit für kurzdauernde Gesichtswahrnehmungen zu prüfen, mit dem Optometer bestimmt man die genaueste Augenschärfe […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
