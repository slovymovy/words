                    "frequency": "Middle",
                    "semantic_group_id": "ursache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Verspätung des Zuges war den schlechten Wetterbedingungen <w>geschuldet</w>."
                        },
                        {
                            "text": "Sein früher Erfolg war vor allem harter Arbeit und Disziplin <w>geschuldet</w>."
