                ],
                "senses": [
                    {
                        "sense_id": "5bf23d80-d268-3ab9-9814-8b282936c481",
                        "entry_id": "6a28f69d-3e13-30c5-a4b6-f59f55df0b1c",
                        "glosses": [
                            "Rundfunksendung bei der eine ausgewählte Personengruppe ihre Erfahrungen oder Meinungen zu einem Thema oder mehreren Themen austauscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f35de367-f2e9-4ff3-9092-e17e1ccbda55",
                                "sense_id": "5bf23d80-d268-3ab9-9814-8b282936c481",
                                "text": "Das Niveau mancher Talkshow lässt zu wünschen übrig."
                            },
                            {
                                "example_id": "2e0d3211-6c23-4fa4-b8f4-3a35c2735ab7",
                                "sense_id": "5bf23d80-d268-3ab9-9814-8b282936c481",
                                "text": "„Ansonsten hat sich aber die sexuelle Aufklärung dank der zahllosen Illustriertenartikel, Talkshows, Ratgeber, Interessenvertretungen und Selbsthilfegruppen flächendeckend weit verbreitet.“"
                            },
                            {
                                "example_id": "8ffad0d7-9e8c-4efc-8925-622247a69aac",
                                "sense_id": "5bf23d80-d268-3ab9-9814-8b282936c481",
                                "text": "„Haber selber saß plötzlich in vielen Talkshows und war Laudator bei Medien- und Musikpreisen.“"
                            },
                            {
                                "example_id": "becde92a-6610-49b1-82bf-57855133a8c0",
                                "sense_id": "5bf23d80-d268-3ab9-9814-8b282936c481",
                                "text": "„In Talkshows erklärten Fachleute, dass sich in der Tat in den letzten Wochen mehr Unfälle als sonst ereignet hätten, dies aber rein statistische Ausreißer seien.“"
                            },
                            {
                                "example_id": "0556c086-a54a-4b46-81e4-80d5d46aa515",
                                "sense_id": "5bf23d80-d268-3ab9-9814-8b282936c481",
                                "text": "„Als ich zu einer Talkshow eingeladen wurde, unter deren Gästen sich auch Jürgen Drews befinden würde, war ich hocherfreut und gespannt, ob es eventuell gemeinsame Erinnerungen geben würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a031dbc-b872-487c-b6fb-b60302217658",
                        "source_entry_id": "6a28f69d-3e13-30c5-a4b6-f59f55df0b1c",
                        "source_sense_id": "5bf23d80-d268-3ab9-9814-8b282936c481",
