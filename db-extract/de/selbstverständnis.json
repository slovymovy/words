                "senses": [
                    {
                        "sense_id": "1f8f59e8-eb10-388a-af6e-1d3e8c367ca1",
                        "entry_id": "9bd87c99-397f-32c5-98dc-88d8127b6a78",
                        "glosses": [
                            "Vorstellungen, Wahrnehmungen und Bewertungen eines Subjektes von sich und seinen Handlungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aaee3a6-d714-4a7f-9ed4-2d3f15e70d4d",
                                "sense_id": "1f8f59e8-eb10-388a-af6e-1d3e8c367ca1",
                                "text": "Und was die Menschen meinen, // Das ist mir einerlei; // Möchte mich mir selbst vereinen, // Allein wir sind zu zwei; // Und im lebend’gen Treiben // Sind wir ein Hier und Dort, // Das eine liebt zu bleiben, // Das andere möchte fort; // Doch zu dem Selbstverständnis // Ist auch wohl noch ein Rat: // Nach fröhlichem Erkenntnis // Erfolge rasche Tat."
                            },
                            {
                                "example_id": "e4dacc5b-6997-45a2-b58c-63eef9520e18",
                                "sense_id": "1f8f59e8-eb10-388a-af6e-1d3e8c367ca1",
                                "text": "„Die daraus resultierende Einschätzung des eigenen Werdegangs als historische Determinante sprengte das überlieferte Selbstverständnis der Adelsrepublik an einer neuralgischen Stelle.“"
                            },
                            {
                                "example_id": "3d190cfa-a341-4440-a586-89472e491a48",
                                "sense_id": "1f8f59e8-eb10-388a-af6e-1d3e8c367ca1",
                                "text": "„Aber auch andere Gruppen sind einem ähnlich dominanten Erwartungsdruck ausgeliefert, etwa Muslim*innen [sic], die sich permanent zu Geschlechterrollen, Terror und Integration äußern müssen und damit als Gegenbild zum Selbstverständnis der toleranten und aufgeklärten Deutschen dienen.“"
                            },
                            {
                                "example_id": "0e294fc6-e4a7-4f45-aa63-8d8cbb545d04",
                                "sense_id": "1f8f59e8-eb10-388a-af6e-1d3e8c367ca1",
                                "text": "„Den dritten Schlag bereitete Freud unserem Selbstverständnis.“"
                            },
                            {
                                "example_id": "3e51f69e-a499-4ff1-bfa6-a8e79abcac1f",
                                "sense_id": "1f8f59e8-eb10-388a-af6e-1d3e8c367ca1",
                                "text": "„In dieser Zeit etablierte sich das Selbstverständnis des Militärs, die einzige funktionierende Institution in Pakistan zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
