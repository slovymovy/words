                        "examples": [
                            {
                                "example_id": "ff6faf7e-aedc-4e48-9b17-567a44b4d357",
                                "sense_id": "dd146199-0caa-3f69-a12f-f92d921016e5",
                                "text": "Ils vont toujours par trois, soit pour serrer, soit pour casser...\n— Casser ?\n— J'veux dire cambrioler. Comprenez-vous, C'est l'terme. Un casseur, ça signifie un cambrio et son boulot s'appelle un cassement."
                            },
                            {
                                "example_id": "ebc34d4c-9b0a-47c8-9da9-0f64fb320543",
                                "sense_id": "dd146199-0caa-3f69-a12f-f92d921016e5",
                                "text": "Notamment que c’était plutôt accidentellement que les deux veilleurs de nuit de la bijouterie Lascève avaient succombé, lors du cassement de cette boîte par le gangster."
                            }
                        ]
                    }
