                "senses": [
                    {
                        "sense_id": "4f7a6fe8-445b-3845-a41a-d81367340b0e",
                        "entry_id": "5aa737cf-b1d1-3f9a-b8d0-061db4d89a5d",
                        "glosses": [
                            "Awkward, ungainly; lacking grace or dexterity in movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f27f7a-1299-4c36-9a1c-7dea1fc07865",
                                "sense_id": "4f7a6fe8-445b-3845-a41a-d81367340b0e",
                                "text": "The “gawky” illustrations look as though they may have been done by Belva Jean herself (Bulletin, Mar. 1989)."
                            },
                            {
                                "example_id": "6b99f429-3a0c-42ac-ab5b-ee7f021a1ab2",
                                "sense_id": "4f7a6fe8-445b-3845-a41a-d81367340b0e",
                                "text": "The woman had barely come up to Seth's shoulder. Petite with curly blonde hair and a dimpled smile. Nothing at all like Francine with her plain brown hair and hazel eyes. Just looking at the woman's picture had made her feel tall and gawky."
                            }
                        ]
                    },
