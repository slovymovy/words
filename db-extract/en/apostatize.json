                    {
                        "translation_id": "4816d427-4afb-401d-88c2-1c0a11fd8032",
                        "source_entry_id": "b924049a-5dff-3223-8c5c-487ae74c2145",
                        "source_sense_id": "ca33966c-bd02-3c31-ab68-ef8f3abd6740",
