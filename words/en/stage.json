                            },
                            {
                                "target_lang_word": "时期",
                                "target_lang_sense_clarification": "一段时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c2e331-e0c1-3b7f-81ed-e36e4ed28c1f",
                    "sense_definition": "A specific level or distinct area within a video game that a player must complete.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "game_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot beat the final <w>stage</w> of this game because the boss is too strong.",
                            "target_lang_translations": {
                                "ru": "Я не могу пройти последний <w>уровень</w> этой игры, потому что босс слишком силен.",
                                "tr": "Patron çok güçlü olduğu için bu oyunun son <w>seviyesini</w> geçemiyorum.",
                                "zh": "我打不过这个游戏的最后一<w>关</w>，因为BOSS太强了。"
                            }
                        },
                        {
                            "text": "Players must collect all the coins to unlock the bonus <w>stage</w>.",
                            "target_lang_translations": {
                                "ru": "Игроки должны собрать все монеты, чтобы разблокировать бонусный <w>уровень</w>.",
                                "tr": "Oyuncuların bonus <w>bölümünün</w> kilidini açmak için tüm altınları toplaması gerekir.",
                                "zh": "玩家必须收集所有金币才能解锁奖励<w>关卡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
