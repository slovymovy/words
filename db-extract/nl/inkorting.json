            {
                "entry_id": "2328a330-6a97-335b-a0c5-f0c07a393b2b",
                "word": "inkorting",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "5eabe769-0853-4692-8552-9602981a4891",
                        "entry_id": "2328a330-6a97-335b-a0c5-f0c07a393b2b",
                        "tags": [
                            "plural"
                        ],
                        "form": "inkortingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52f8dedf-9384-3341-b361-68c244b23060",
                        "entry_id": "2328a330-6a97-335b-a0c5-f0c07a393b2b",
                        "glosses": [
                            "het minder lang maken van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e09f6f3-64f1-420d-b150-f9088c0a8be0",
                                "sense_id": "52f8dedf-9384-3341-b361-68c244b23060",
                                "text": "Die dankte hij echter aan de inkorting van het eerste onderdeel. Door de sterke stroming hoefden de deelnemers slechts 1,9 kilometer te zwemmen in plaats van de dubbele afstand. Het fietstraject was wel de normale 180 kilometer evenals de afsluitende marathonloop."
                            },
                            {
                                "example_id": "6255d1d1-5e18-426f-b49a-6a6186d3981e",
                                "sense_id": "52f8dedf-9384-3341-b361-68c244b23060",
                                "text": "Dan is er ook nog de inkorting van de ww-periode. Vanaf 1 januari 2016 wordt die geleidelijk afgebouwd naar 24 maanden. Dat was tot vandaag maximaal 38 maanden."
                            },
                            {
                                "example_id": "d1e6627e-15a2-4bf7-bac4-412c0e2c2f81",
                                "sense_id": "52f8dedf-9384-3341-b361-68c244b23060",
                                "text": "De minister van Volksgezondheid Jane Philpott erkende dat de inkorting van de uitsluitingsperiode geen radicale verandering is, en nog steeds veel mannen belet om bloed te geven, maar had het over 'een stap in de goede richting'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77803631-a2c1-49de-963c-e059e8a2eeea",
                        "source_entry_id": "2328a330-6a97-335b-a0c5-f0c07a393b2b",
                        "source_sense_id": "52f8dedf-9384-3341-b361-68c244b23060",
                        "target_lang_word": "abbreviation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abbreviation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7571685c-c065-3d30-abd0-0dd06611967f",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
                                            "The result of shortening or reducing; abridgment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b9a1613-5d50-3bbd-8952-4663616d3b98",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
                                            "A shortened or contracted form of a word or phrase used to represent the whole, using omission of letters, and sometimes substitution of letters, or duplication of initial letters to signify plurality, including signs such as +, =, @."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fd4533-0e41-4379-819a-19cd4747dca2",
                                                "sense_id": "3b9a1613-5d50-3bbd-8952-4663616d3b98",
                                                "text": "Hants is an abbreviation of Hampshire."
                                            },
                                            {
                                                "example_id": "2579339a-6440-4c2f-aba7-cb0db3509e36",
                                                "sense_id": "3b9a1613-5d50-3bbd-8952-4663616d3b98",
                                                "text": "Americans, for example, call newcomers to Antarctica “fingies”, which comes from FNGs – a borrowed military abbreviation that means “Fucking New Guy”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdddfafd-3e0a-379f-91c5-1a257d8f90a3",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
                                            "The process of abbreviating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e97f219c-cfdd-3355-918e-02a41f2ae254",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
                                            "A notation used in music score to denote a direction, as pp or mf."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9861753-ccee-33e7-8996-efba47a889c6",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
                                            "One or more dashes through the stem of a note, dividing it respectively into quavers, semiquavers, demisemiquavers, or hemidemisemiquavers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b9763eb-c36e-371a-9c42-9064d526da6e",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
                                            "Any convenient short form used as a substitution for an understood or inferred whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2667119-cbcd-459c-a24e-6eab63ded7f6",
                                                "sense_id": "3b9763eb-c36e-371a-9c42-9064d526da6e",
                                                "text": "The phrase \"civil rights\" is an abbreviation for a whole complex of relationships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043d3da2-9269-39a5-80d8-8e9b5534096c",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
                                            "Loss during evolution of the final stages of the ancestral ontogenetic pattern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af365a6e-03e1-39bd-8e52-59892536ed94",
                                        "entry_id": "9874dbf1-2612-3435-ab59-582b3c7739b2",
                                        "glosses": [
