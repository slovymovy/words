                "senses": [
                    {
                        "sense_id": "a38a942d-8d08-3722-9a65-5ce4d6164a8d",
                        "entry_id": "917c6275-3600-31d9-8699-62c08e022b86",
                        "glosses": [
                            "Fernsehgerät, das mit dem Internet verbunden werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00089ece-24d3-47e0-ab06-693da03959f1",
                                "sense_id": "a38a942d-8d08-3722-9a65-5ce4d6164a8d",
                                "text": "„Auch mit Hilfe von Smart-TVs und HDMI-Sticks stehen heute weitere internetbasierende Empfangsmöglichkeiten zur Verfügung.“"
                            },
                            {
                                "example_id": "6af12f94-298a-4ca0-acc0-4adfabe8406a",
                                "sense_id": "a38a942d-8d08-3722-9a65-5ce4d6164a8d",
                                "text": "„Fast jeder neue Fernseher ist mittlerweile ein Smart-TV. Die Geräte haben viele nützliche Funktionen.“"
                            },
                            {
                                "example_id": "bcbbeaed-7322-4cd5-9859-776354bb8598",
                                "sense_id": "a38a942d-8d08-3722-9a65-5ce4d6164a8d",
                                "text": "„In Deutschland nutzen 38 Prozent der Haushalte ein Smart-TV mit entsprechenden Diensten als Hauptgerät, in der Schweiz sind es sogar gut die Hälfte (51 Prozent).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
