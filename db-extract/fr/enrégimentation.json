                        "sense_id": "f8604125-d6c1-3a2f-9f30-d32158a12916",
                        "entry_id": "a57951be-4ace-37b7-ba99-0d0b8cb6d929",
                        "glosses": [
                            "Action d’enrégimenter, résultat de cette action."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "abf6dbaf-7f0f-4bce-9335-a20f6231edf4",
                                "sense_id": "f8604125-d6c1-3a2f-9f30-d32158a12916",
                                "text": "Nous sommes un peu dépaysés dans cette atmosphère de démocratie autorisée, où les têtes sont déjà mûres ; où il y a des gens qu’on dit avoir été chefs de barricades à Saint-Merry, prisonniers à Doullens, insurgés de Juin ; qui ont le prestige de l’enrégimentation révolutionnaire, du combat et de la prison."
                            },
                            {
                                "example_id": "3ac9f063-4cbc-4333-91a0-2a4cea9c5732",
                                "sense_id": "f8604125-d6c1-3a2f-9f30-d32158a12916",
                                "text": "Nous sommes des Gaulois faits pour l’enrégimentation, ayant pour idéal des dévouements brillants, des audaces chevaleresques."
                            },
                            {
                                "example_id": "af776488-86a9-4fcf-bad2-25f9e7723374",
                                "sense_id": "f8604125-d6c1-3a2f-9f30-d32158a12916",
                                "text": "Ils avaient vu avec plaisir les citoyens conscients du pays adhérer à des comités divers : libéraux, démocratiques, républicains, radicaux, socialistes et senti, […], tout le parti que leur génie assoiffé pourrait tirer de ces enrégimentations volontaires."
                            }
                        ]
                    }
