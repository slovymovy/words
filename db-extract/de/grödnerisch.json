                "senses": [
                    {
                        "sense_id": "b3957466-b209-3229-9e61-48f001bc5996",
                        "entry_id": "38d41388-48ec-3964-a0f8-2ac3a543b456",
                        "glosses": [
                            "aus dem im Raum Gröden gebräuchlichen Dialekt des Ladinischen stammend, diese Dialekt betreffend, in ihm ausgedrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aebe2e62-ccf3-45b4-a0a1-492e388ba4a8",
                                "sense_id": "b3957466-b209-3229-9e61-48f001bc5996",
                                "text": "„Die europäischen Schriftsprachen bieten keine passenden Ausgangsformen [für das Wort Nudel], aber grödnerisch menùedli ‚Teigplättchen in der Suppe‘ passt formal und semantisch.“ (menùedli kursiv im Original)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "99336b41-08cd-38ad-a4f7-b122844d2318",
                        "entry_id": "38d41388-48ec-3964-a0f8-2ac3a543b456",
                        "glosses": [
                            "auf den Ort/Raum Gröden bezogen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "22a64db8-afe9-4b53-9694-a49f3ce2e2c3",
                                "sense_id": "99336b41-08cd-38ad-a4f7-b122844d2318",
                                "text": "„Zuerst gab es nur einen provisorischen Altar mit einer grödnerisch anmutenden Herz-Jesu-Statue; die zugehörige Mensa hatte ein Tischler aus Alt-Ofen gefertigt.“"
                            },
                            {
                                "example_id": "f8fd811a-4c3a-4067-997c-65b72b23d5b9",
                                "sense_id": "99336b41-08cd-38ad-a4f7-b122844d2318",
                                "text": "„Man stellt seine eigene Branche als wichtigen Bestandteil der grödnerischen Tradition dar und betont die Wichtigkeit des Erhalts der alten Traditionen.“"
                            },
                            {
                                "example_id": "b698caa9-c2f4-45f4-a089-58a9e9c88661",
                                "sense_id": "99336b41-08cd-38ad-a4f7-b122844d2318",
                                "text": "„Beim Doseswirth credenzt uns die Wirthin in schmucker grödnerischer Tracht einen kühlenden Trank, […]“"
                            },
                            {
                                "example_id": "5e3be5d2-7c91-4500-8d2e-ed3a0a2bba54",
                                "sense_id": "99336b41-08cd-38ad-a4f7-b122844d2318",
                                "text": "„[…] Steiner [äußert] die Vermuthung, daß zu seiner Zeit die Anzahl der im Heimathlande lebenden Grödner nur ein Drittel des gesammten […] Volkes betrage, wobei denn nicht zu übersehen, daß auch in Tirol selbst, in Städten, Märkten und Dörfern, eine beträchtliche Anzahl ursprünglich grödnerischer Firmen sich niegelassen[sic!] hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
