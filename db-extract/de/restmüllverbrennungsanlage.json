                        "examples": [
                            {
                                "example_id": "1c824cf4-3f44-47e8-81ec-504fb5840112",
                                "sense_id": "f3c9b564-9372-3a5e-95b1-1fd0493397bd",
                                "text": "„Die Restmüllverbrennungsanlage (RMVA) zählt zu den effizientesten und umweltfreundlichsten Müllverbrennungsanlagen weltweit.“"
                            },
                            {
                                "example_id": "43328cef-c17c-421d-84aa-a620b05c46f2",
                                "sense_id": "f3c9b564-9372-3a5e-95b1-1fd0493397bd",
                                "text": "„Auf dem Gelände der Böblinger Restmüllverbrennungsanlage verwandelt seit September 2008 ein Biomasse-Heizkraftwerk von Siemens bislang nicht verwertbare Holz-Siebreste in Wärme und Strom.“"
                            },
                            {
                                "example_id": "650b2e24-61a4-4d5b-8628-ccb33cc5edb1",
                                "sense_id": "f3c9b564-9372-3a5e-95b1-1fd0493397bd",
                                "text": "„Eine thermische Restmüllverbrennungsanlage befindet sich in Bozen, für die gerade eine neue in Bau ist.“"
                            }
                        ],
