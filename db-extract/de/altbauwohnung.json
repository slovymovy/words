                ],
                "senses": [
                    {
                        "sense_id": "3cae0bcd-123e-3975-9751-420d33d28bd5",
                        "entry_id": "698a1fa9-329b-3b27-b026-11525da363f0",
                        "glosses": [
                            "Wohnung in einem Altbau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa2daae-85f9-4a38-9142-4ee499af68a4",
                                "sense_id": "3cae0bcd-123e-3975-9751-420d33d28bd5",
                                "text": "Was vor einem Jahrhundert noch Standard war, ist heute eine begehrte Rarität: Nur in Altbauwohnung findet man noch Decken ab einer Höhe von mindestens drei Metern!"
                            },
                            {
                                "example_id": "bf9ed143-a43b-4c3d-893c-3bf053100f03",
                                "sense_id": "3cae0bcd-123e-3975-9751-420d33d28bd5",
                                "text": "„‚Vor einigen Wochen mietete ich eine frisch sanierte Altbauwohnung an.‘“"
                            },
                            {
                                "example_id": "97926c92-964f-4c9b-a362-51ac17cebeb8",
                                "sense_id": "3cae0bcd-123e-3975-9751-420d33d28bd5",
                                "text": "„Das Theaterstück spielt unter anderem in einer Altbauwohnung. Dort wirbelt eine junge Putzfrau mit Zeichentalent als neue Mitbewohnerin die friedliche Männer-WG eines stotternden Historikers und eines schürzenjagenden Kochs durcheinander.“"
                            },
                            {
                                "example_id": "cafd8ecc-53a3-407b-a40f-3ceea5243cd8",
                                "sense_id": "3cae0bcd-123e-3975-9751-420d33d28bd5",
                                "text": "„Ich sitze im Wohnzimmer seiner großzügigen Altbauwohnung direkt neben dem Kaufhaus des Westens in Berlin, er holt noch schnell Tee aus der Küche, das Radio läuft: Nachrichten.“"
                            },
                            {
                                "example_id": "e8cea744-6969-49d7-a68a-528304126dae",
                                "sense_id": "3cae0bcd-123e-3975-9751-420d33d28bd5",
                                "text": "„In einem kleinen funktionalen Raum unter dem Dach einer Altbauwohnung bittet sie zum Gespräch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
