                                        "examples": [
                                            {
                                                "example_id": "faf705ba-fc09-479c-af22-95da82553aa9",
                                                "sense_id": "56fac875-cbbc-3295-ab35-2917f8a4c050",
                                                "text": "Η εμπάθεια απέναντι στον Χ τον κάνει να χάνει τη συνηθισμένη ψυχραιμία και ευθυκρισία του."
                                            }
                                        ]
                                    },
