                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd39f76-b21e-4075-9036-572747cbe8a2",
                                                "sense_id": "f2dc3a7a-5d99-3976-93c3-c4fe76beec5e",
                                                "text": "Er kwam een voortdurende informatiestroom binnen."
                                            },
                                            {
                                                "example_id": "2000c0ed-4225-4e7c-a49b-80859948dea7",
                                                "sense_id": "f2dc3a7a-5d99-3976-93c3-c4fe76beec5e",
                                                "text": "Kunnen we niet gewoon zijn, gewoon even wandelen, zonder gedoe? Dat voortdurende praten, dat zwelgen in het eigen leed, het geroddel en geruzie, ik krijg er kloppende oogleden van."
                                            },
                                            {
                                                "example_id": "ef99f329-7c5f-4989-acb2-e54048c3c6cf",
                                                "sense_id": "f2dc3a7a-5d99-3976-93c3-c4fe76beec5e",
                                                "text": "In de huisjes aan de rivieroever werd zoals je had kunnen verwachten geklaagd over het voortdurende lawaai."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voortdurend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9133c091-b80d-3425-8e8c-3e6254f5713c",
                                        "entry_id": "02097f45-67a5-3035-bc78-12ba775c0e1e",
                                        "glosses": [
                                            "langdurig en ononderbroken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4348baee-dd9b-4691-9f21-7df8549c6bad",
                                                "sense_id": "9133c091-b80d-3425-8e8c-3e6254f5713c",
                                                "text": "Ik lette goed op veranderingen in mijn omgeving en ik keek voortdurend naar de wolkenpatronen en -trekrichting."
                                            },
                                            {
                                                "example_id": "57b17652-9ecb-43b7-862e-937e39101785",
                                                "sense_id": "9133c091-b80d-3425-8e8c-3e6254f5713c",
                                                "text": "'Mama snoepje?' Op mijn vierde schijn ik haar dat al voortdurend gevraagd te hebben."
                                            },
                                            {
                                                "example_id": "98870f12-a183-4911-8be0-ebdb63add894",
                                                "sense_id": "9133c091-b80d-3425-8e8c-3e6254f5713c",
                                                "text": "Niet als ze voortdurend teksten loopt te declameren met een air alsof het de Gijsbrecht is die ze moet instuderen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voortdurend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0f11b9-433c-31cd-96e4-e36501088d91",
