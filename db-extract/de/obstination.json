                    },
                    {
                        "translation_id": "e57f60bf-1818-4e7f-98a9-2bf1cf39952c",
                        "source_entry_id": "ada992d8-d799-3de8-9e46-f81c75ce7a47",
                        "source_sense_id": "f942f519-ee9f-32e5-8abf-5d805d59e611",
                        "source_sense_description": "veraltet: Eigensinn",
                        "target_lang_word": "obstinacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                        "entry_id": "d2ea0fe7-e2ea-3927-a3b1-7f35fd6ee269",
                                        "glosses": [
                                            "The state, or an act, of stubbornness or doggedness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67bf7caf-e589-46ea-bc2d-75c26c3b33bc",
                                                "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                                "text": "He finished only through a mixture of determined obstinacy and ingenuity."
                                            },
                                            {
                                                "example_id": "dfc6d731-a558-40c0-bc9b-07448a4f8211",
                                                "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                                "text": "\"I don't know where,\" replied the girl.\n\"Then I do,\" said Sikes, more in the spirit of obstinacy than because he had any real objection."
                                            },
                                            {
                                                "example_id": "4d76158a-f755-4db9-aa0c-13dffecb96b2",
                                                "sense_id": "0a812942-e87f-3ba9-a5dc-e0e0c2a494d3",
                                                "text": "1877, Leo Tolstoy (author), David Magarshack (translator), Anna Karenina, part 6, ch 12,\nHis hand closed, he drew back, and his face assumed a still more stubborn expression.\n\"For you it's a matter of obstinacy,\" she said, looking intently at him and suddenly finding the right word for the expression of his face which exasperated her so much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f100f97-ad51-3850-ae39-effa6cd571db",
                                        "entry_id": "d2ea0fe7-e2ea-3927-a3b1-7f35fd6ee269",
                                        "glosses": [
                                            "A group of bison; the collective noun for bison."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e5a3b86-ba88-40a6-8442-d974a02b9300",
                        "source_entry_id": "ada992d8-d799-3de8-9e46-f81c75ce7a47",
                        "source_sense_id": "f942f519-ee9f-32e5-8abf-5d805d59e611",
                        "source_sense_description": "veraltet: Eigensinn",
                        "target_lang_word": "obstination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                        "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                                        "glosses": [
                                            "Action de s’obstiner, de s’attacher opiniâtrement à une idée, à un sentiment, à une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972d2eb0-447b-422f-b6d2-0b1f16a0be5c",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Me voilà donc partagé entre travail et amusement, une vie de patachon qui inquiète maman, tandis qu'Alphonse est surtout embarrassé par mon obstination à vouloir embrasser une carrière d'artiste."
                                            },
                                            {
                                                "example_id": "aff67e05-7b30-4dd6-962b-537919578aea",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Bert, avec l’obstination convulsive de l’instinct, s’étaya contre les parois, jusqu’à ce que le ballon piquât du nez."
                                            },
                                            {
                                                "example_id": "5be05d1d-d382-460d-928b-389a81431b76",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Tout vous révèle qu’entre Le Havre et Rouen se poursuit avec obstination la création d’une zone où, inévitablement, le colossal et l’extraordinaire sont en genèse."
                                            },
                                            {
                                                "example_id": "dde59327-a008-4bf0-a59d-4be24a1c2d72",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Il était célèbre par une obstination admirable à apprendre à écrire et à lire ; le résultat ne fut pas étonnant ; il faut croire qu’il est bien difficile d'apprendre à lire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                        "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                                        "glosses": [
                                            "Qualité de celui qui est obstiné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ce6648-3fbc-43f5-a51e-a5aa281e99bd",
                                                "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                                "text": "Il lui a fallu beaucoup d’obstination pour réussir dans son examen."
                                            },
                                            {
                                                "example_id": "e78b43aa-b59a-4477-afdd-a974f29de28b",
                                                "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                                "text": "Obstination au travail, à l’étude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
