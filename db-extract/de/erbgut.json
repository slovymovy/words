                "senses": [
                    {
                        "sense_id": "dcd16630-052d-3581-b909-3fb0dc891785",
                        "entry_id": "edd2776f-5ebf-3581-b80f-fff6da4c7139",
                        "glosses": [
                            "die Gesamtheit der in der DNS verschlüsselten Erbanlagen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "87d79170-5a37-4147-9f06-88f12047bd4d",
                                "sense_id": "dcd16630-052d-3581-b909-3fb0dc891785",
                                "text": "Radioaktivität, bestimmte Chemikalien und UV-Strahlung können das Erbgut verändern."
                            },
                            {
                                "example_id": "d63410db-579b-4a12-a699-8b18b927f63d",
                                "sense_id": "dcd16630-052d-3581-b909-3fb0dc891785",
                                "text": "„Während alle anderen Körperzellen vergänglich sind, ist das Erbgut der Keimzelle unsterblich.“"
                            },
                            {
                                "example_id": "4379085b-3fb4-4be5-af8e-17fece2d8943",
                                "sense_id": "dcd16630-052d-3581-b909-3fb0dc891785",
                                "text": "„Was sie dann schließlich im Gewimmel der Probe aus dem Teichwasser fand, verriet ihr, wie das Erbgut in den Zellen unseres Körpers jung bleiben kann.“"
                            },
                            {
                                "example_id": "e8a908ba-37ac-4c37-85c2-ee4e7e9a92fa",
                                "sense_id": "dcd16630-052d-3581-b909-3fb0dc891785",
                                "text": "„Es ist vor allem das Erbgut indigener Amerikaner selbst, aus dem sich heute die Besiedlungsgeschichte der beiden amerikanischen Kontinente weitgehend rekonstruieren lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dda4b676-387c-3aa0-bf6d-42f219e750a2",
                        "entry_id": "edd2776f-5ebf-3581-b80f-fff6da4c7139",
                        "glosses": [
                            "ein Hofgut, das von Generation zu Generation innerhalb der Familie weitergegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e20ca3ed-d2e9-4425-a10d-5f04af122978",
                                "sense_id": "dda4b676-387c-3aa0-bf6d-42f219e750a2",
                                "text": "Das Erbgut ist seit 250 Jahren in Familienbesitz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0dffde14-cdb3-3440-8207-60c6be1a850d",
                        "entry_id": "edd2776f-5ebf-3581-b80f-fff6da4c7139",
                        "glosses": [
                            "komplette Hinterlassenschaft eines Verstorbenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a249ddb8-21d7-49de-9149-c815e6a47a11",
                                "sense_id": "0dffde14-cdb3-3440-8207-60c6be1a850d",
                                "text": "Das komplette Erbgut wurde unter den Kindern aufgeteilt."
                            }
