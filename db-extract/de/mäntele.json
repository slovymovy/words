                ],
                "senses": [
                    {
                        "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                        "entry_id": "0695ebd0-91bc-3e92-883c-18271aa7a980",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b635ae-3c17-4908-a32e-6f322883f69c",
                                "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                                "text": "Frau Mäntele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6de6d2b2-3401-4498-8373-5482a72e7d31",
                                "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                                "text": "Herr Mäntele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "904740cc-13d1-4816-8172-c40442c3dca4",
                                "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                                "text": "Die Mänteles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5c166929-9df7-4928-9807-39a93b27a8d2",
                                "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                                "text": "Der Mäntele trägt nie die Schals, die die Mäntele ihm strickt."
                            },
                            {
                                "example_id": "6fe4db04-c5a0-49ad-b8ce-d95ca747b921",
                                "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mäntele kommt, geht der Herr Mäntele.“"
                            },
                            {
                                "example_id": "a2a59f9d-fe9f-4f9e-a622-e1eb243f2599",
                                "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                                "text": "Mäntele kommt und geht."
                            },
                            {
                                "example_id": "5f7153ed-54d9-4579-a2c7-7ed0817334ce",
                                "sense_id": "0a6dcf6c-32ca-3707-976a-0419d92034da",
                                "text": "Mänteles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
