                "senses": [
                    {
                        "sense_id": "9e2c9f18-c3e9-3b03-9366-2738f714b899",
                        "entry_id": "cad9c69e-baaa-352f-909a-76b1c4d8a23e",
                        "glosses": [
                            "Valeur numérique : nombre constituant la partie numérique de la valeur d’une grandeur physique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f0040d4-dcb1-4788-a6ed-e1fb97f49d0d",
                                "sense_id": "9e2c9f18-c3e9-3b03-9366-2738f714b899",
                                "text": "Der Größenwert kann dann als Produkt aus Zahlenwert und Einheit dargestellt werden…",
                                "translation": "La valeur d’une grandeur peut alors être représentée comme un produit de la valeur numérique et de l’unité…"
                            },
                            {
                                "example_id": "81a3ac12-810a-4cb1-811b-f6372d140f23",
                                "sense_id": "9e2c9f18-c3e9-3b03-9366-2738f714b899",
                                "text": "Wenn ein bestimmter Wert einer Größe einer gegebenen Art als Referenzwert, Einheit genannt, ausgewählt ist, dann kann ein beliebiger anderer Wert einer Größe der gleichen Art mittels dieser Einheit als Produkt dieser Einheit und einem Zahlenwert angegeben werden. Diese Zahl wird als der Zahlenwert des Größenwertes mit dieser Einheit benannt.",
                                "translation": "Si une certaine valeur d’une grandeur d’une nature donnée est sélectionnée comme valeur de référence, appelée unité, alors toute autre valeur d’une grandeur du même type peut être indiquée au moyen de cette unité comme produit de cette unité et d’une valeur numérique. Ce nombre est appelé la valeur numérique de la valeur de grandeur avec cette unité."
                            }
                        ]
                    },
                    {
                        "sense_id": "95d692a3-8027-3a64-8eb8-470225287cd1",
                        "entry_id": "cad9c69e-baaa-352f-909a-76b1c4d8a23e",
                        "glosses": [
                            "Valeur numérique correspondant à une séquence de chiffres et autres signes, selon les règles d’une numération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dd8e8df-95ab-4a65-8b25-48b10e93488e",
                                "sense_id": "95d692a3-8027-3a64-8eb8-470225287cd1",
                                "text": "Die hebräische Zahlschrift stellt Zahlenwerte in einem dezimalen Additionssystem dar.",
                                "translation": "La numération hébraïque représente les valeurs numériques selon système additif décimal."
                            }
                        ]
                    }
                ],
