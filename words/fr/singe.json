    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c32a8e35-01eb-3666-b2fe-6cb469b9153f",
                    "sense_definition": "Mammifère primate arboricole et agile, généralement pourvu d'une queue.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit <w>singe</w> saute agilement d'une branche à l'autre dans la forêt."
                        },
                        {
                            "text": "Les enfants adorent regarder chaque <w>singe</w> manger des bananes au zoo."
                        }
                    ],
                    "synonyms": [
                        "macaque"
                    ],
                    "common_phrases": [
                        "petit singe"
                    ]
                },
                {
                    "sense_id": "3931ccf9-34f0-3f42-b630-8ca60b794f37",
                    "sense_definition": "Personne qui imite servilement les manières, les gestes ou le style d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artiste n'a aucun style propre, ce n'est qu'un <w>singe</w> de ses maîtres."
                        },
                        {
                            "text": "Arrête d'agir comme un <w>singe</w> et trouve tes propres idées pour ce projet."
                        }
                    ]
                },
                {
                    "sense_id": "9d6ed6b1-0c28-3fcf-85b9-753fa75c6a5a",
