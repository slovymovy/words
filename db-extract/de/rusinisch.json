                "senses": [
                    {
                        "sense_id": "4839bed0-7ced-3b6b-b90a-41962bf62624",
                        "entry_id": "c54a44bf-e8ae-3fcb-b868-f92af6c1924b",
                        "glosses": [
                            "von der ostslawischen Volksgruppe der Rusinen in der Karpatoukraine, der Slowakei, Polen, Ungarn und Teilen des ehemaligen Jugoslawiens gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c055e305-80e7-4335-8e45-1ee73de75dcb",
                                "sense_id": "4839bed0-7ced-3b6b-b90a-41962bf62624",
                                "text": "Ich spreche Rusinisch."
                            },
                            {
                                "example_id": "b07bf5d2-2bd6-40d5-ba07-44a368a1f386",
                                "sense_id": "4839bed0-7ced-3b6b-b90a-41962bf62624",
                                "text": "Wie heißt das auf Rusinisch?"
                            },
                            {
                                "example_id": "7497e00a-5e34-4506-bc2e-20e89267451d",
                                "sense_id": "4839bed0-7ced-3b6b-b90a-41962bf62624",
                                "text": "„Rusinisch wurde in Jugoslawien von ca. 19 500 Personen als Muttersprache gesprochen.“"
                            },
                            {
                                "example_id": "3800ebbb-c92e-4e09-92f7-5a8e5c1b6ccc",
                                "sense_id": "4839bed0-7ced-3b6b-b90a-41962bf62624",
                                "text": "Das Rusinische hat große Ähnlichkeiten mit dem Ukrainischen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
