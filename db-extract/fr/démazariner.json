                "senses": [
                    {
                        "sense_id": "e2872c2f-22fe-3358-ae11-fa5b0426b160",
                        "entry_id": "4ed11b51-0233-304c-8e09-6516c6cb4807",
                        "glosses": [
                            "Faire perdre son caractère lié au cardinal Mazarin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c178c80b-a3c4-423c-9f14-e091c62a4a94",
                                "sense_id": "e2872c2f-22fe-3358-ae11-fa5b0426b160",
                                "text": "La reine injustement soupçonnée de démazariner."
                            },
                            {
                                "example_id": "e7cd3c77-0eb7-475d-a8d6-0d7e6272f063",
                                "sense_id": "e2872c2f-22fe-3358-ae11-fa5b0426b160",
                                "text": "Paris n'aura pas plutôt remué, qu'il remuera toute la France : les villes qui sont maintenant dans l'indifférence se détermineront à l'imitation de la capitale : vous verrez que les plus chauds Mazarins seront démazarinés par leur propre peur, lorsqu'ils verront que les peuples se mettront en état de démazariner tout de bon la pauvre France."
                            }
                        ]
                    }
                ],
