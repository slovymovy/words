        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c79f17d-e114-3b89-aacc-dedfd086398e",
                    "sense_definition": "de toestand nadat het leven is geëindigd",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "overlijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vele mensen vrezen de <w>dood</w> en wat daarna komt.",
                            "target_lang_translations": {
                                "en": "Many people fear <w>death</w> and what comes after.",
                                "ru": "Многие люди боятся <w>смерти</w> и того, что будет после."
                            }
                        },
                        {
                            "text": "Zijn plotselinge <w>dood</w> was een grote schok voor de familie.",
                            "target_lang_translations": {
                                "en": "His sudden <w>death</w> was a great shock to the family.",
                                "ru": "Его внезапная <w>смерть</w> стала большим шоком для семьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "levenseinde",
                        "overlijden"
                    ],
                    "antonyms": [
                        "leven"
                    ],
                    "common_phrases": [
                        "de dood nabij"
                    ],
                    "target_lang_definitions": {
                        "en": "the state after life has ended",
                        "ru": "состояние после окончания жизни"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "death",
                                "target_lang_sense_clarification": "the state of being dead"
                            }
