        "fr-extract.jsonl": [
            {
                "entry_id": "e541a291-def1-3ad7-9482-e24d176538a3",
                "word": "quintaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f7f3da7-b0f9-4ff8-af19-667e3e67df94",
                        "entry_id": "e541a291-def1-3ad7-9482-e24d176538a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "quintaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7da4bd7-f3ee-3590-b9b6-b8ec42d7a5c0",
                        "entry_id": "e541a291-def1-3ad7-9482-e24d176538a3",
                        "glosses": [
                            "Poteau fiché en terre, contre lequel on s’exerce à courir avec la lance ou à jeter des flèches."
                        ],
                        "tags": [
                            "Manège"
                        ],
                        "examples": [
                            {
                                "example_id": "fb3d8f98-b30c-4f75-92e3-4f7cc03a7fff",
                                "sense_id": "f7da4bd7-f3ee-3590-b9b6-b8ec42d7a5c0",
                                "text": "Du premier coup de lance Élie perce les écus, démaille les hauberts et renverse les poteaux de la quintaine."
                            },
                            {
                                "example_id": "7bd440bd-cf50-4253-86fe-b763d01ea96e",
                                "sense_id": "f7da4bd7-f3ee-3590-b9b6-b8ec42d7a5c0",
                                "text": "Les joutes à la quintaine étaient un des exercices favoris dans les tournois."
                            }
                        ]
                    },
                    {
                        "sense_id": "b71aab87-b9cb-3da8-9e69-4926cc94bdef",
                        "entry_id": "e541a291-def1-3ad7-9482-e24d176538a3",
                        "glosses": [
                            "Mannequin monté sur un pivot et armé d’un bâton qui frappait celui qui le touchait maladroitement avec la lance."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "9bb451a5-6a46-4a0d-b144-3c20b386222b",
                                "sense_id": "b71aab87-b9cb-3da8-9e69-4926cc94bdef",
                                "text": "L’habileté individuelle au maniement de la lance s’acquiert d’abord par l’exercice de la quintaine ; il s’agit pour l’essentiel de frapper de sa pointe, en pleine vitesse, le bouclier porté par le bras transversal d’un mannequin fixé à un poteau et d’esquiver le choc du coup en retour déclenché par l’autre bras armé du mannequin."
                            }
                        ]
                    },
                    {
                        "sense_id": "2edac484-9ff2-3441-b0cc-ab08b167cc57",
                        "entry_id": "e541a291-def1-3ad7-9482-e24d176538a3",
                        "glosses": [
                            "Meuble représentant le poteau du même nom dans les armoiries. Il est généralement représenté en pal. Il est composé d’un petit écu généralement plain et d’un mât au pied aiguisé. On blasonne l’écu en premier, le mât en second quand il est d’un autre émail."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "459d7ea4-5593-4ec2-af55-8bf40c5430ba",
                                "sense_id": "2edac484-9ff2-3441-b0cc-ab08b167cc57",
                                "text": "D’or au dauphin d’azur, à la quintaine d’argent au mât de gueules brochant sur le tout ; à la filière du même, qui est de la commune de Jaligny-sur-Besbre de l’Allier → voir illustration « armoiries avec une quintaine »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7208217-b51e-41d9-99d5-8c7612b1339a",
                        "source_entry_id": "e541a291-def1-3ad7-9482-e24d176538a3",
                        "target_lang_word": "quintain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quintain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb3f96f-681a-3c3d-8c24-70360a099406",
                                        "entry_id": "4e62bc9e-4e86-3363-9dff-f4df786f75a6",
                                        "glosses": [
                                            "An object (generally a post or plank on a support) set up as a target to be tilted at in jousting, or otherwise used as target practice."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1cc00da-a2f8-48ec-aeff-1a074d40e2f1",
                                                "sense_id": "dfb3f96f-681a-3c3d-8c24-70360a099406",
                                                "text": "My better parts\nAre all thrown down; and that which here stands up\nIs but a quintain, a mere lifeless block."
                                            },
                                            {
                                                "example_id": "4266907b-fc66-4770-80ef-453131184aac",
                                                "sense_id": "dfb3f96f-681a-3c3d-8c24-70360a099406",
                                                "text": "At Offham, in Kent, tilting at the quintain provides a climax to the day's revels."
                                            },
                                            {
                                                "example_id": "2228b8fb-d6ba-4f4a-8d9b-7b3065239571",
                                                "sense_id": "dfb3f96f-681a-3c3d-8c24-70360a099406",
                                                "text": "In the tiltyard, his companions felt the juddering impact of his sword-blows and saw the muscled precision of his archery and his tilting at the quintain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
