                ],
                "senses": [
                    {
                        "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                        "entry_id": "b9002155-d3d2-3dfe-86de-600598dbdf33",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57ceb8e-db8e-4203-ac94-3ea4b7cdbc16",
                                "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                                "text": "Frau Knechtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "06df4761-1496-418e-a073-746019215203",
                                "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                                "text": "Herr Knechtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e96b7313-b6a2-43c9-9107-eb2f9964d0c4",
                                "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                                "text": "Die Knechtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e8ba473e-6adc-4859-9aa1-c582498853f0",
                                "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                                "text": "Der Knechtle trägt nie die Schals, die die Knechtle ihm strickt."
                            },
                            {
                                "example_id": "7931b77c-275c-479e-b5c3-bf1d30394bd8",
                                "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knechtle kommt, geht der Herr Knechtle.“"
                            },
                            {
                                "example_id": "f4567f9f-014f-464d-bdc4-ec369dc5b9e1",
                                "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                                "text": "Knechtle kommt und geht."
                            },
                            {
                                "example_id": "7ed511b9-d603-45f5-a782-ee7645585a27",
                                "sense_id": "45829027-637f-33c9-b57c-982bc5b28284",
                                "text": "Knechtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
