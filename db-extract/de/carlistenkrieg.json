                "senses": [
                    {
                        "sense_id": "4ecf06c1-b7d5-3a60-bf35-591f738b8263",
                        "entry_id": "f9e7ecfd-c2cd-3c1c-8bbc-0fb769813cd9",
                        "glosses": [
                            "einer der drei spanischen Bürgerkriege des 19. Jahrhunderts (1834, 1840, 1872), die für die Thronfolge des spanischen Kronprinzen und Kronprätendenten Carlos (1788 – 1855) und gegen die weibliche Thronfolge auf dem spanischen Thron geführt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6cbeb36-2528-4598-9b90-1f166752794e",
                                "sense_id": "4ecf06c1-b7d5-3a60-bf35-591f738b8263",
                                "text": "„Die Carlisten jedenfalls fühlten sich übergangen, und von 1847 bis 1849 schloss sich mit dem Zweiten Carlistenkrieg ein weiterer spanischer Bürgerkrieg an.“"
                            },
                            {
                                "example_id": "c921ab15-c6bf-4655-8a85-8cb9d4760059",
                                "sense_id": "4ecf06c1-b7d5-3a60-bf35-591f738b8263",
                                "text": "„Im Jahre 1876 wurde der dritte Carlistenkrieg schließlich beendet und es folgte eine Zeitspanne relativer Stabilität […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
