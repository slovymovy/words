                "senses": [
                    {
                        "sense_id": "8a5f48e2-6241-35de-90b3-f8b27fdbf9d7",
                        "entry_id": "ea3f2094-f2fa-3ddb-8f9f-9ccb6a3f4fa2",
                        "glosses": [
                            "Défilement rapide des idées lors d’états anxieux ou insomniaques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1484f727-d7cc-4adc-879c-c92776147299",
                                "sense_id": "8a5f48e2-6241-35de-90b3-f8b27fdbf9d7",
                                "text": "Le mentisme est une rumination intellectuelle avec défilé idéique rapide et incoercible."
                            },
                            {
                                "example_id": "bdb338e6-ff7e-4522-8cfd-ce507cf2c56d",
                                "sense_id": "8a5f48e2-6241-35de-90b3-f8b27fdbf9d7",
                                "text": "Ma tête me fait mal dès que j’ouvre les yeux, surtout si je fais des projets. Il m’a coupée : quel genre de projets ? J’hésitais à lui répondre : je ne sais pas, j’invente des solutions, je saute d’une pensée à une autre. Il a ajouté ravi : c'est ce qu’on appelle des mentismes, la fuite des pensées."
                            },
                            {
                                "example_id": "199ade76-886a-4735-945a-2c19e6ad4b1c",
                                "sense_id": "8a5f48e2-6241-35de-90b3-f8b27fdbf9d7",
                                "text": "Le psychiatre, qui s’habille comme un personnage secondaire d’un album de Tintin, m’a expliqué que ça s’appelle du mentisme obsédant, ou de la rumination morbide."
                            }
                        ]
                    }
