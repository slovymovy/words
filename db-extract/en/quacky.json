                "senses": [
                    {
                        "sense_id": "4bdee248-387f-3ad8-90f6-d6640180602f",
                        "entry_id": "bbd6f3ba-0a1a-3e42-aed9-7aa27ad0f2ba",
                        "glosses": [
                            "That resembles the quack of a duck."
                        ],
                        "tags": [
                            "of a voice or sound"
                        ],
                        "examples": [
                            {
                                "example_id": "59fa872f-77d7-40ca-a652-517bf1a863f8",
                                "sense_id": "4bdee248-387f-3ad8-90f6-d6640180602f",
                                "text": "With progressive prostration (which is more marked in young infants) and with a tone to the cry which is a sort of a thin, crowing, quacky sound, points to the existence of retropharyngeal lymphadenitis."
                            },
                            {
                                "example_id": "ab903b69-af78-4820-9f2e-8274e2ae4f0d",
                                "sense_id": "4bdee248-387f-3ad8-90f6-d6640180602f",
                                "text": "Suddenly I hear a roar like a lion then a gagging sound like someone is getting choked to death then high-pitched voices little quacky voices like the Chipmunks on the radio calling back and forth to one another Christmas Christmas time is here time for joy and time for cheer."
                            }
                        ]
                    },
                    {
                        "sense_id": "09651c48-e0e5-31a3-97dd-da80bca86881",
                        "entry_id": "bbd6f3ba-0a1a-3e42-aed9-7aa27ad0f2ba",
                        "glosses": [
                            "Fraudulent; characterised by or using the methods of quackery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b925b9-a6c8-43fa-958a-9dcc08218867",
                                "sense_id": "09651c48-e0e5-31a3-97dd-da80bca86881",
                                "text": "The Doctor says that some of the quackiest of the quacks are in the army."
                            },
                            {
                                "example_id": "041f2c85-3fda-4cf6-b69e-d399114d0246",
                                "sense_id": "09651c48-e0e5-31a3-97dd-da80bca86881",
                                "text": "1998 September 9, Joni Mitchell, interview quoted in 2003, Alan Hecht, Polio, page 72,\nI know this sounds real quacky but they did some mysterious good to the problem and I feel fine."
                            },
                            {
                                "example_id": "2fab0658-df33-4411-a45d-cf8f8a8e0122",
                                "sense_id": "09651c48-e0e5-31a3-97dd-da80bca86881",
                                "text": "Although some of the moments surrounding my coming out may seem humorous in retrospect, the underlying harsh fact is that thousands of desperate people are willing to embrace the quackiest of measures to cure homosexuality in themselves or in loved ones, and this is anything but funny."
                            },
                            {
                                "example_id": "524d47d9-3010-4b4d-ac7d-d3805756b96a",
                                "sense_id": "09651c48-e0e5-31a3-97dd-da80bca86881",
                                "text": "David's expression changes. A quack? All this act is about some quacky, pseudo science, right on, I know something you don't cult thing."
                            },
                            {
                                "example_id": "7e699b77-3d76-4de8-a85d-66539f8f7a85",
                                "sense_id": "09651c48-e0e5-31a3-97dd-da80bca86881",
                                "text": "Dr. Torrent described the signs and symptoms of RP,^([retinitis pigmentosa]) surveyed the established research into causes of the disease, and summarized the failed attempts to develop a cure, including a barbaric method pioneered in the USSR involving the injection of quacky medicine directly into the patient's eyeball."
                            },
                            {
                                "example_id": "4a43b80a-eaf0-4bd8-947f-50f213f0f656",
                                "sense_id": "09651c48-e0e5-31a3-97dd-da80bca86881",
                                "text": "The housemother was a relief housemother, and she was quacky, and we didn't think she knew anything."
                            }
                        ]
                    },
                    {
                        "sense_id": "296be53b-280e-3e21-8b66-7958414d3f09",
                        "entry_id": "bbd6f3ba-0a1a-3e42-aed9-7aa27ad0f2ba",
                        "glosses": [
                            "Infested with quackgrass."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "5f0680a6-8008-452b-9f23-023cdabaa1ba",
                                "sense_id": "296be53b-280e-3e21-8b66-7958414d3f09",
                                "text": "1859, The Cultivator, Volume 7, 3rd Series, page 54,\nAfter the first hoeing of a quacky crop, it is often well to go over it lightly in the middle of a hot day, just skimming the surface of the soil, and cutting off the young grass."
                            },
                            {
                                "example_id": "29d88ee1-b34d-443c-a501-eebfe64b1ca1",
                                "sense_id": "296be53b-280e-3e21-8b66-7958414d3f09",
                                "text": "Always work quacky land when it is driest."
                            },
                            {
                                "example_id": "609ddb7e-b477-43c6-8bf8-12ec3e6133f0",
                                "sense_id": "296be53b-280e-3e21-8b66-7958414d3f09",
                                "text": "1914, New York (State) Department of Agriculture, Annual Report, Volume 1, Part 2, page 544,\nWhen would you advise plowing sandy soil that is quacky for beans?"
                            }
                        ]
                    }
