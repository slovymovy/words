                        "examples": [
                            {
                                "example_id": "97462a7d-5870-44e7-9980-0226db438134",
                                "sense_id": "c08516b8-b75d-38bb-ba2a-e27fef575cb2",
                                "text": "„Aber mit Hilfe der Überwachungskameras und der DNA, die an den Handfesseln gefunden wurde, kommen die Ermittler Khedache und seiner Bande bald auf die Spur.“"
                            },
                            {
                                "example_id": "43887245-0460-4b20-8ba3-46b4bf16a87b",
                                "sense_id": "c08516b8-b75d-38bb-ba2a-e27fef575cb2",
                                "text": "„Tóvó regte sich auf, weil die Kette zwischen den Handfesseln so kurz war, dass er mit gefalteten Händen dastehen musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
