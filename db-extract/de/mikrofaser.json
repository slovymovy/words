                        "cross_references": [
                            {
                                "target_word": "microfibre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dacca27-4994-33e1-b733-86a809f97fd9",
                                        "entry_id": "5037ac03-1d37-331d-98f0-8d169de38495",
                                        "glosses": [
                                            "Fibre textile dont la masse linéique (ou titre) est inférieure à un décitex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e12717-e1bb-488b-9a02-3915403078d2",
                                                "sense_id": "3dacca27-4994-33e1-b733-86a809f97fd9",
                                                "text": "La microfibre est un tissu synthétique. Lorsque l’on parle de pollution, nous pensons d’abord aux sacs et bouteilles plastiques jetés négligemment. Mais les vêtements en synthétique font aussi partie du problème. Au cours du lavage de nos vêtements, des fibres plastiques brisées pénètrent dans les eaux usées et ne peuvent être filtrées efficacement ni par les lave-linges ni par les stations d’épuration. Si l’on additionne ainsi tous les ménages, il en résulte une pollution gigantesque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
