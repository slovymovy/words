                "senses": [
                    {
                        "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                        "entry_id": "8fed6143-3aae-337a-b199-9ff3b4d6ca99",
                        "glosses": [
                            "Musikinstrument, bei dem die Töne durch meist mehrere schwingende Saiten erzeugt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11afeed0-f2cc-4275-9511-036b1d41627c",
                                "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                                "text": "Er würde lieber ein Saiteninstrument erlernen."
                            },
                            {
                                "example_id": "e6632bec-b5a0-4e57-85b4-016a3f883318",
                                "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                                "text": "„Die Pferde von der Station gehen auf der Wiese umher und knabbern hier und dort ein wenig Gras, ein Stück weiter an einer Hauswand spielt jemand auf einem Saiteninstrument und singt dazu.“"
                            },
                            {
                                "example_id": "bf211619-8506-4f89-a28f-fb970225997b",
                                "sense_id": "75108ccd-fa77-311b-a49d-a39e19517453",
                                "text": "„Sie spielten auf Banjos, Bouzoukia, Baglamades und anderen Saiteninstrumenten den griechischen Blues.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
