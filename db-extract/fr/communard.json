                "senses": [
                    {
                        "sense_id": "47221264-9cbd-3c2b-8255-1d72d318cf15",
                        "entry_id": "5b345d13-a14e-3d84-822d-fb319bf5c39a",
                        "glosses": [
                            "Espèce de petit poisson de lagon en Nouvelle-Calédonie."
                        ],
                        "tags": [
                            "Nouvelle-Calédonie"
                        ],
                        "examples": [
                            {
                                "example_id": "3f551659-8c61-40c5-be74-863997c6e3e6",
                                "sense_id": "47221264-9cbd-3c2b-8255-1d72d318cf15",
                                "text": "Les petits communards ( 10-20 cm) sont très abondants sur les fonds sableux et herbeux. Ils mordent facilement et détruisent les appâts des pêcheurs qui leur préfèrent des poissons plus gros."
                            },
                            {
                                "example_id": "4029d4c2-a5a2-407d-b7bf-a4de13274593",
                                "sense_id": "47221264-9cbd-3c2b-8255-1d72d318cf15",
                                "text": "Le communard est un poisson très commun du lagon, et très apprécié des Calédoniens en friture. Comment se pêche-t-il ?\nAvec une ligne ou, depuis quelques années, avec une petite canne à pêche, à bord d’une plate ou d’un bateau plus imposant, et en se laissant dériver au gré du courant. On fait ainsi « une dérive aux communards »."
                            }
                        ]
                    }
