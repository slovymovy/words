                                            {
                                                "example_id": "ea85c52e-e4a2-4681-802d-1af646623f89",
                                                "sense_id": "c3383b9b-cbc4-346c-ab26-2250adc20e92",
                                                "text": "Er spritzte sich eine letale Dosis Heroin."
