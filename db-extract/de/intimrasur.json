                ],
                "senses": [
                    {
                        "sense_id": "49f4cfa7-bdc9-32cd-adde-c0a111fdf2dd",
                        "entry_id": "8d709027-c79a-3f30-9ebf-c94ac7bf46d8",
                        "glosses": [
                            "Rasur im Intimbereich; der Vorgang des Entfernens der Schambehaarung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2eb265b-bf66-4459-a0ec-8c19f62c8063",
                                "sense_id": "49f4cfa7-bdc9-32cd-adde-c0a111fdf2dd",
                                "text": "Eine Folge der Intimrasur kann die Bildung von Entzündungen, Pusteln und eingewachsenen Haaren in den Folgetagen nach der Rasur sein."
                            },
                            {
                                "example_id": "1429b96f-9ed5-4517-aeef-9c47036dbbc7",
                                "sense_id": "49f4cfa7-bdc9-32cd-adde-c0a111fdf2dd",
                                "text": "Die im westlichen Kulturkreis am weitesten verbreitete Modifikation ist die Intimrasur, das heißt die teilweise oder vollständige Entfernung der Schambehaarung."
                            },
                            {
                                "example_id": "4ae16f6d-847d-4f6e-9f37-d145b4a699d1",
                                "sense_id": "49f4cfa7-bdc9-32cd-adde-c0a111fdf2dd",
                                "text": "Genau wie bei Markenkleidung sei es auch im Falle der Intimrasur wichtig, zur Gruppe zu gehören."
                            },
                            {
                                "example_id": "4be1d9c5-e7ce-4c6f-9ac3-8b5668dd363e",
                                "sense_id": "49f4cfa7-bdc9-32cd-adde-c0a111fdf2dd",
                                "text": "Und Victoria Beckham, die Gattin des englischen Fußballidols, forderte gar in einem Zeitungsinterview, für Frauen ab 18 sollte eine Intimrasur Pflicht sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
