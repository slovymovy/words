                        "cross_references": []
                    },
                    {
                        "translation_id": "5fe2c18c-4d22-4398-8686-b1da78698695",
                        "source_entry_id": "d1b6c254-d30c-33d3-8688-0fb60f0e3127",
                        "source_sense_id": "cdb6f9e7-d4d6-3422-b6bc-a27d64119017",
                        "target_lang_word": "einäschern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einäschern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98ae9b34-762c-3494-ae38-b7e59444b676",
                                        "entry_id": "04ea38cc-ed35-3bd2-8dd1-646471c2d189",
                                        "glosses": [
                                            "durch Feuer vollständig zerstören"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e928450a-44c2-4502-b2a2-7c4f87049b37",
                                                "sense_id": "98ae9b34-762c-3494-ae38-b7e59444b676",
                                                "text": "„Es wird vor fünfzig Jahren auch ohne die Errungenschaften des Fortschritts nicht sehr viel anders gewesen sein. Etwas einfacher und rustikaler wohl, denn ein Großteil der Gebäude ist erst nach dem Krieg entstanden, nach den Bombardements, die weite Teile des Dorfes einäscherten.“"
                                            },
                                            {
                                                "example_id": "13b37e32-2932-422d-a4dd-2281dcb2891a",
                                                "sense_id": "98ae9b34-762c-3494-ae38-b7e59444b676",
                                                "text": "„Städte, Oasen und ganze Landstriche wurden eingeäschert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45ade7b5-2362-329e-99ca-718c491ddfaf",
                                        "entry_id": "04ea38cc-ed35-3bd2-8dd1-646471c2d189",
                                        "glosses": [
                                            "einen Leichnam verbrennen, um die Asche in einer Urne beizusetzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71b98fc0-ed6e-46e6-90d3-bff9d055d979",
                                                "sense_id": "45ade7b5-2362-329e-99ca-718c491ddfaf",
                                                "text": "„»Meine Mutter wollte eingeäschert werden.« »Eingeäschert!«, wiederholte Owen entsetzt, als hätte Chyna gerade gesagt, ihre Mutter wollte in eine Häckselmaschine geworfen werden.“"
                                            },
                                            {
                                                "example_id": "dfa5fa9f-b31e-4db7-8003-fa153dde0a38",
                                                "sense_id": "45ade7b5-2362-329e-99ca-718c491ddfaf",
                                                "text": "„Als Jude darf meine Leiche eigentlich nicht eingeäschert werden, aber ich bin Reformjude und möchte eine Feuerbestattung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af2e6f05-6135-46a5-b689-ca830a0d8e6d",
                        "source_entry_id": "d1b6c254-d30c-33d3-8688-0fb60f0e3127",
