                    {
                        "sense_id": "19ee0539-8fc4-324f-a5ec-48e2fd60a5ea",
                        "entry_id": "924bae95-7bbc-3e2f-b387-67728ebe86af",
                        "glosses": [
                            "zeer groot vliegtuig, de Boeing-747, is een viermotorig passagiers- en vrachtvliegtuig van de Amerikaanse fabrikant Boeing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27757322-d472-4ea9-a2cf-9309168b0db5",
                                "sense_id": "19ee0539-8fc4-324f-a5ec-48e2fd60a5ea",
                                "text": "Luchtvaartmaatschappijen vinden de nieuwe jumbojet van Boeing ouderwets en niet milieuvriendelijk. British Airways bestelt liever Airbustoestellen."
                            },
                            {
                                "example_id": "efcc05a8-a0b8-424b-8392-1aab4e2e51eb",
                                "sense_id": "19ee0539-8fc4-324f-a5ec-48e2fd60a5ea",
                                "text": "Boeing overweegt productiestop van beroemde jumbojet, de 747. Na bijna 50 jaar is het einde van wellicht het beroemdste vliegtuig in zicht: de Boeing 747. De iconische 'Queen of the Skies'-jumbojet was van 1970 tot 2007 het grootste passagiersvliegtuig ter wereld - tot het gepasseerd werd door de nog grotere Airbus A380. De 747 is volgens Boeing uit de gratie geraakt omdat de nieuwste - kleinere en dus zuiniger - vliegtuigen populairder zijn geworden."
                            }
                        ]
                    }
