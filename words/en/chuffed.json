                            }
                        },
                        {
                            "text": "He seemed noticeably <w>chuffed</w> by the sudden change in their travel arrangements.",
                            "target_lang_translations": {
                                "tr": "Seyahat planlarındaki ani değişiklikten gözle görülür şekilde <w>hoşnutsuz</w> görünüyordu."
                            }
                        }
                    ],
                    "synonyms": [
