{
    "word_family": [
        "wreathe"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07c8b88e-c2ff-3099-88fc-a59b626a8836",
                    "sense_definition": "An ornamental circular band made of plaited flowers, leaves, or twigs, used as decoration or as a symbol of honor.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every December, they hang a Christmas <w>wreath</w> on their front door.",
                            "target_lang_translations": {
                                "tr": "Her aralık ayında ön kapılarına bir Noel <w>çelengi</w> asarlar.",
                                "zh": "每年十二月，他们都会在正门上挂一个圣诞<w>花环</w>。"
                            }
                        },
                        {
                            "text": "The winner of the race was presented with a laurel <w>wreath</w>.",
                            "target_lang_translations": {
                                "tr": "Yarışın kazananına bir defne <w>çelengi</w> takdim edildi.",
                                "zh": "比赛的获胜者被授予了一顶月桂<w>花环</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "laurel wreath",
                        "Christmas wreath"
                    ],
                    "target_lang_definitions": {
                        "tr": "Süsleme amacıyla veya onur sembolü olarak kullanılan, örülmüş çiçek, yaprak veya dallardan yapılmış dairesel halka.",
                        "zh": "一种由花、叶或枝条编织而成的环状装饰物，用作装饰或荣誉的象征。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çelenk",
                                "target_lang_sense_clarification": "çiçek ve dallardan yapılan dairesel halka"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花环",
                                "target_lang_sense_clarification": "用花草编织的环状物"
                            },
                            {
                                "target_lang_word": "桂冠",
                                "target_lang_sense_clarification": "象征荣誉的月桂花环"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c53bb62-1f97-346c-ab80-f262c89f660f",
                    "sense_definition": "A ring, curl, or spiral shape formed by smoke, mist, clouds, or similar soft materials.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thin <w>wreath</w> of smoke rose from the chimney into the cold morning air.",
                            "target_lang_translations": {
                                "tr": "Bacadan soğuk sabah havasına ince bir duman <w>halkası</w> yükseldi.",
                                "zh": "一缕细细的<w>烟圈</w>从烟囱升起，飘入寒冷的晨空。"
                            }
                        },
                        {
                            "text": "Thick <w>wreaths</w> of fog covered the valley before sunrise.",
                            "target_lang_translations": {
                                "tr": "Güneş doğmadan önce yoğun sis <w>kümeleri</w> vadiyi kapladı.",
                                "zh": "日出前，浓重的<w>雾霭</w>笼罩了整个山谷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wreath of smoke",
                        "wreath of fog"
                    ],
                    "target_lang_definitions": {
                        "tr": "Duman, sis, bulut veya benzeri hafif maddelerin oluşturduğu halka, kıvrım veya sarmal biçim.",
                        "zh": "由烟雾、薄雾、云层或其他类似轻柔物质形成的环状、卷曲或螺旋状形态。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "halka",
                                "target_lang_sense_clarification": "duman veya sis halkası"
                            },
                            {
                                "target_lang_word": "kıvrım",
                                "target_lang_sense_clarification": "duman veya bulut kümesi"
                            },
                            {
                                "target_lang_word": "küme",
                                "target_lang_sense_clarification": "sis veya duman katmanı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烟圈",
                                "target_lang_sense_clarification": "烟雾形成的环状物"
                            },
                            {
                                "target_lang_word": "缭绕的烟雾",
                                "target_lang_sense_clarification": "形容烟雾盘旋的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "087b34f8-30bb-3e0f-bdf0-ca7254264775",
                    "sense_definition": "A twisted band of silk or ribbon placed above a shield in heraldry to support the crest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms featured a gold and blue <w>wreath</w> under the lion crest.",
                            "target_lang_translations": {
                                "tr": "Armada, aslan tepeliğinin altında altın ve mavi renkli bir <w>burma bağ</w> yer alıyordu.",
                                "zh": "该纹章在狮子冠饰下方绘有一条金蓝相间的<w>花冠饰</w>。"
                            }
                        },
                        {
                            "text": "In heraldry, the knight's crest was mounted directly upon a silk <w>wreath</w>.",
                            "target_lang_translations": {
                                "tr": "Arma biliminde, şövalyenin tepeliği doğrudan ipek bir <w>burma bağ</w> üzerine monte edilirdi.",
                                "zh": "在纹章学中，骑士的冠饰直接安装在丝绸<w>花冠饰</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orle",
                        "torse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Arma biliminde (heraldik) miğfer tepeliğini desteklemek için kalkanın üzerine yerleştirilen burmalı ipek veya şerit bağ.",
                        "zh": "纹章学中，放置在盾徽上方用于支撑冠饰的扭曲丝带或布条。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "burma bağ",
                                "target_lang_sense_clarification": "armada miğfer üstü bağ"
                            },
                            {
                                "target_lang_word": "sarık",
                                "target_lang_sense_clarification": "heraldik burma çelenk"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花冠饰",
                                "target_lang_sense_clarification": "纹章学中支撑冠饰的扭曲带"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab96eb26-2383-368f-8046-094042b7080c",
                    "sense_definition": "A structural defect or irregularity formed during the manufacturing of glass.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan discarded the bottle because of a visible <w>wreath</w> in the glass.",
                            "target_lang_translations": {
                                "tr": "Zanaatkar, camdaki görünür bir <w>kusur</w> nedeniyle şişeyi çöpe attı.",
                                "zh": "工匠丢弃了那个瓶子，因为玻璃上有明显的<w>瑕疵</w>。"
                            }
                        },
                        {
                            "text": "Inspectors checked the window pane for any internal <w>wreath</w> or flaw.",
                            "target_lang_translations": {
                                "tr": "Müfettişler pencere camını herhangi bir iç <w>pürüz</w> veya kusur açısından kontrol etti.",
                                "zh": "检查员仔细查看了窗玻璃，看是否有内部<w>瑕疵</w>或缺陷。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "technical glassmaking term"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Cam üretimi sırasında oluşan yapısal bir kusur veya düzensizlik.",
                        "zh": "玻璃制造过程中形成的结构性缺陷或不规则痕迹。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cam hatası",
                                "target_lang_sense_clarification": "üretim sırasındaki yapısal kusur"
                            },
                            {
                                "target_lang_word": "pürüz",
                                "target_lang_sense_clarification": "cam içi düzensizlik"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玻璃瑕疵",
                                "target_lang_sense_clarification": "制造过程中产生的结构缺陷"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba0564f3-1975-325b-b54f-49246f72e990",
                    "sense_definition": "Alternative spelling of <w>wreathe</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ivy began to <w>wreath</w> around the old stone pillars of the ruin.",
                            "target_lang_translations": {
                                "tr": "Sarmaşıklar kalıntının eski taş sütunlarını <w>sarmaya</w> başladı.",
                                "zh": "常春藤开始<w>缠绕</w>在废墟古老的石柱上。"
                            }
                        },
                        {
                            "text": "Dark clouds <w>wreathed</w> the mountain peak as the storm approached.",
                            "target_lang_translations": {
                                "tr": "Fırtına yaklaşırken kara bulutlar dağın zirvesini <w>bürüdü</w>.",
                                "zh": "随着风暴临近，乌云<w>笼罩</w>了山峰。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "archaic spelling variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"Wreathe\" sözcüğünün alternatif yazılışı (sarmak, kaplamak, çelenk yapmak).",
                        "zh": "“wreathe”的变体拼写，意为缠绕、环绕或覆盖。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sarmak",
                                "target_lang_sense_clarification": "etrafını dolanmak"
                            },
                            {
                                "target_lang_word": "bürümek",
                                "target_lang_sense_clarification": "etrafını kaplamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缠绕",
                                "target_lang_sense_clarification": "环绕在某物周围"
                            },
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "覆盖或包围某物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}