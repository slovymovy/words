                "senses": [
                    {
                        "sense_id": "129c89bc-c620-35fb-82b5-866465fee09f",
                        "entry_id": "e4ec3086-76dd-3190-a11a-470f9591a281",
                        "glosses": [
                            "Labyrinth (Irrgarten), das aus Spiegeln statt Hecken besteht, wodurch man schnell die Orientierung verliert, besonders häufig zu finden auf Jahrmärkten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82695494-0ac1-4f2a-8166-2ac3253d2100",
                                "sense_id": "129c89bc-c620-35fb-82b5-866465fee09f",
                                "text": "„Immer lustloser spaziere ich durch ein Spiegellabyrinth, komme an jaulenden Spinden und Kontinenten aus Wasserbeuteln vorbei.“"
                            },
                            {
                                "example_id": "ced0d689-cb86-4827-be90-198831896d51",
                                "sense_id": "129c89bc-c620-35fb-82b5-866465fee09f",
                                "text": "„Eigens entwickelt wurde ein Entnazifizierungs-Monopoly, das den gesellschaftlichen und persönlichen Opportunismus herauskalkuliert, ein Restitutionspuzzle, das im Spiegellabyrinth des kreativen Kollektivsadismus endet.“"
                            },
                            {
                                "example_id": "9f12a88d-f6c6-421c-8eaa-9a4f2faf06f2",
                                "sense_id": "129c89bc-c620-35fb-82b5-866465fee09f",
                                "text": "„Heute findet der Besucher auf der Bürgerweide direkt hinter dem Hauptbahnhof alle handelsüblichen Desorientiermaschinen, ein Riesenrad, eine Wasserbahn, aber auch Nostalgisches wie Geisterbahn, Kettenkarussell und Spiegellabyrinth.“"
                            },
                            {
                                "example_id": "6405ac40-0e78-4411-a847-c461fd36c8d4",
                                "sense_id": "129c89bc-c620-35fb-82b5-866465fee09f",
                                "text": "„In diesem Spiegellabyrinth aus optischen Metaphern steckt schon die ganze Botschaft, und sie strahlt, wie so oft bei Spielberg, sehr klar und schlicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
