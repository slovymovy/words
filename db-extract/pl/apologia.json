                "senses": [
                    {
                        "sense_id": "ff700d9b-e49d-3040-bf6b-f22dddd36c45",
                        "entry_id": "f7dd76db-9670-3688-bfe1-27ec1566d3aa",
                        "glosses": [
                            "obrona rzeczy, sprawy lub osoby zawierająca ich usprawiedliwienie, a często także jawną lub ukrytą pochwałę; także utwór literacki mający formę mowy obrończej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d373b2-b73e-496e-b604-473e6d723407",
                                "sense_id": "ff700d9b-e49d-3040-bf6b-f22dddd36c45",
                                "text": "Niesłychany sukces Nowej Heloizy, apologia miłości, kobiecości, uczuć, nie mogą jednak przesłonić przesłania innego z dzieł wielkiego genewczyka - Emila, traktatu w pięciu księgach, poświęconego wychowaniu dzieci"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f690abf-175f-4d9c-9b5c-ab276c44574e",
                        "source_entry_id": "f7dd76db-9670-3688-bfe1-27ec1566d3aa",
                        "source_sense_id": "ff700d9b-e49d-3040-bf6b-f22dddd36c45",
                        "target_lang_word": "apology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "An expression of remorse or regret for having said or done something that harmed another: an instance of apologizing (saying that one is sorry)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e440391a-1bb5-4616-8e47-eba142947025",
                                                "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                                "text": "What he said really hurt my feelings, but his apology sounded so sincere that I couldn't help but forgive him."
                                            },
                                            {
                                                "example_id": "4893a22b-2bc7-4b7a-a3b9-444e9778351e",
                                                "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                                "text": "The CEO made a public apology for the scandal, and promised full cooperation with the authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838813eb-a2fd-3d4a-b162-d4a88c90eb58",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "A formal justification, defence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe05163-bf41-4d36-adab-ee22ea223b6e",
                                                "sense_id": "838813eb-a2fd-3d4a-b162-d4a88c90eb58",
                                                "text": "the Apology of Socrates"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "Anything provided as a substitute; a makeshift."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fb20be-5a51-4e83-91d0-2c57fa904da6",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "a poor apology for a hotel room"
                                            },
                                            {
                                                "example_id": "89e11b3a-fa4f-47c9-bc75-3d1184d917fd",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "[He] goes to work devising apologies for window curtains."
                                            },
                                            {
                                                "example_id": "3306ef70-97a8-428f-b31e-9e7b5eff570f",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "The response to firing is remarkable, and though the 280 lb. pressure seems more in the nature of a reserve for emergencies than a continuous working figure, even with the present-day apology for coal it seldom fell below 250 lb., and could always be brought up to blowing-off point with little difficulty. To this liveliness of steaming the thermic syphons are doubtless the chief contributory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54b1ec93-1ad1-4a05-ae85-3dc176887a5b",
                        "source_entry_id": "f7dd76db-9670-3688-bfe1-27ec1566d3aa",
                        "source_sense_id": "ff700d9b-e49d-3040-bf6b-f22dddd36c45",
                        "target_lang_word": "apologia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                        "entry_id": "3ac13585-470d-3c6e-996e-e15d1ecf59aa",
                                        "glosses": [
                                            "A written defense of a position or belief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee946b17-a3af-42e4-ada8-790d0c9b0c05",
                                                "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                                "text": "Although I've enumerated some of the academic traditions and debates that have animated this book, it is not my purpose to offer a full apologia in these brief pages."
                                            },
                                            {
                                                "example_id": "3a781a5e-0908-42f2-a0b1-ff40e0f8ef1f",
                                                "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                                "text": "“Gone With the Wind” was published in 1936, and despite heroic efforts over the last seven decades to transform it into something else, the novel stands as an apologia for the Old South — […]"
                                            },
                                            {
                                                "example_id": "c62801d2-6efe-4324-8df0-285e2848da43",
                                                "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                                "text": "The apologia his [Gabriel García Márquez] sons contribute at the beginning of the book is unconvincing, and their final excuse is particularly hard to swallow:[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9056ab65-eead-4e71-9839-dd461fce2721",
                        "source_entry_id": "f7dd76db-9670-3688-bfe1-27ec1566d3aa",
                        "source_sense_id": "ff700d9b-e49d-3040-bf6b-f22dddd36c45",
                        "target_lang_word": "apologism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7acc8afa-90d6-3873-b0c7-40525ec9c4e9",
                                        "entry_id": "97f3e7ff-4028-36c8-8083-38f4d27172b0",
                                        "glosses": [
                                            "A defence or excuse; a speech or written answer made to justify someone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f2bf11b-9d43-4090-aaeb-5d98ddf1d7a0",
                        "source_entry_id": "f7dd76db-9670-3688-bfe1-27ec1566d3aa",
                        "source_sense_id": "ff700d9b-e49d-3040-bf6b-f22dddd36c45",
                        "target_lang_word": "apologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                        "entry_id": "8fb6163f-f561-375a-a1fe-434516423793",
                                        "glosses": [
                                            "Paroles ou écrits destinés à justifier ou à défendre quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852bb901-d0c0-4f9d-a625-90a69ecc4467",
                                                "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                                "text": "Mme Surville n’a laissé sur son frère que quelques pages insignifiantes, une apologie froide, banale, où nous n'avons pas une seule note à prendre, pas un seul document à retenir."
                                            },
                                            {
                                                "example_id": "187747da-2b20-4fb8-b31b-25d6834c9fa4",
                                                "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                                "text": "Quelques jours plus tard, en réponse à une longue apologie du célibat et de la chasteté due à la plume de notre « Sphinx ariégeois » de plus en plus dégoûté de la vie, je répliquais :\n Toute femme est faite pour rivancher comme dit l'argot des barrières, et ensuite pour reproduire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ceba07-1353-4d48-b11e-52890e57621e",
                        "source_entry_id": "f7dd76db-9670-3688-bfe1-27ec1566d3aa",
