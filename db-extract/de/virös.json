                    }
                ],
                "senses": [
                    {
                        "sense_id": "86ce1626-cfeb-35cf-a906-7927f7655fc2",
                        "entry_id": "d4421db0-7296-3fe8-92cc-97c4078cc51a",
                        "glosses": [
                            "durch Viren verursacht, durch Viren bedingt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e73ca303-9373-430c-ab9d-573e204ea1b1",
                                "sense_id": "86ce1626-cfeb-35cf-a906-7927f7655fc2",
                                "text": "„Sie sind mit Schleimhaut ausgekleidet und stehen mit dem Nasenraum in Verbindung. Wenn ein Schnupfen, also eine viröse oder bakterielle Entzündung der Nasenschleimhaut.“"
                            },
                            {
                                "example_id": "044451ed-ca0f-4d29-b3de-c4708953416e",
                                "sense_id": "86ce1626-cfeb-35cf-a906-7927f7655fc2",
                                "text": "„Es zeigt sich also, dass eine viröse Infektion die Anfälligkeit der Engerlinge gegenüber der Mykose erhöht; Mykosefälle sind hier 1,5 bis 3mal zahlreicher als in den Vergleichsserien.“"
                            },
                            {
                                "example_id": "dea9e4c8-ba5b-4489-8abb-4d251524066d",
                                "sense_id": "86ce1626-cfeb-35cf-a906-7927f7655fc2",
                                "text": "„‚Swollen shoot‘ trat zuerst in Afrika auf und ist bisher noch nicht in der Neuen Welt beobachtet worden, wenn auch ähnliche Symptome einer virösen Erkrankung von Ceylon berichtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35f0f817-4f36-3612-91b5-27f373d71803",
                        "entry_id": "d4421db0-7296-3fe8-92cc-97c4078cc51a",
                        "glosses": [
                            "von Viren befallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ced9443-e21a-4315-818b-6be92002ac46",
                                "sense_id": "35f0f817-4f36-3612-91b5-27f373d71803",
                                "text": "„In der Hypodermis hat sich der Anteil viröser Zellen auf 50 % erhöht, erreicht jedoch noch nicht den Stand von 70 % bei den Kontrolltieren.“"
                            },
                            {
                                "example_id": "89343f4a-fb5e-4449-88bd-007a0d8dac36",
                                "sense_id": "35f0f817-4f36-3612-91b5-27f373d71803",
                                "text": "„Im Phosphatgehalt hatten die virösen Pflanzen sowohl im Blatt als auch in der Wurzel ein deutliches Mehr. Der Sulfatgehalt war im Gegensatz dazu bei den gesunden Pflanzen höher.“"
                            },
                            {
                                "example_id": "f4b5c793-7316-401e-af2c-9d55b92e531c",
                                "sense_id": "35f0f817-4f36-3612-91b5-27f373d71803",
                                "text": "„Die virösen Läuse bewirkten Ertragsausfälle von 25 und 30 %.“"
                            },
                            {
                                "example_id": "aaafe0b2-616c-4c53-8137-21aa3a5897c9",
                                "sense_id": "35f0f817-4f36-3612-91b5-27f373d71803",
                                "text": "„Die virösen Zelleinschlüsse reagieren je nach ihrer chemischen Zusammensetzung auf unterschiedliche Färbemittel, wobei sich die Virusaggregate nach der Färbung deutlich von den normalen Zellbestandteilen unterscheiden.“"
