                        {
                            "text": "Un grave <w>malheur</w> est arrivé à cette famille l'hiver dernier.",
                            "target_lang_translations": {
                                "en": "A serious <w>misfortune</w> struck this family last winter.",
                                "ru": "Прошлой зимой в этой семье случилось тяжёлое <w>несчастье</w>.",
                                "nl": "Afgelopen winter overkwam deze familie een zwaar <w>ongeluk</w>.",
                                "de": "Letzten Winter traf diese Familie ein schweres <w>Unglück</w>.",
                                "pl": "Zeszłej zimy ta rodzina przeżyła poważne <w>nieszczęście</w>.",
                                "it": "Lo scorso inverno a questa famiglia è capitata una grave <w>disgrazia</w>.",
                                "cs": "Minulou zimu tuto rodinu postihlo vážné <w>neštěstí</w>.",
                                "tr": "Geçen kış bu ailenin başına ağır bir <w>talihsizlik</w> geldi.",
                                "es": "El invierno pasado a esta familia le ocurrió una grave <w>desgracia</w>.",
                                "zh": "去年冬天，这个家庭遭遇了一场严重的<w>不幸</w>。"
                            }
                        },
                        {
                            "text": "Ce terrible <w>malheur</w> a plongé tout le village dans la tristesse et le deuil.",
                            "target_lang_translations": {
                                "en": "This terrible <w>calamity</w> plunged the whole village into sadness and mourning.",
                                "ru": "Это страшное <w>несчастье</w> повергло всю деревню в печаль и траур.",
                                "nl": "Deze verschrikkelijke <w>ramp</w> heeft het hele dorp in verdriet en rouw gedompeld.",
                                "de": "Dieses furchtbare <w>Unglück</w> stürzte das ganze Dorf in Traurigkeit und Trauer.",
                                "pl": "To straszne <w>nieszczęście</w> pogrążyło całą wieś w smutku i żałobie.",
                                "it": "Questa terribile <w>sciagura</w> ha gettato tutto il villaggio nella tristezza e nel lutto.",
                                "cs": "Tato strašná <w>pohroma</w> uvrhla celou vesnici do smutku a žalu.",
                                "tr": "Bu korkunç <w>felaket</w> tüm köyü hüzne ve yasa gömdü.",
                                "es": "Esta terrible <w>desgracia</w> sumió a todo el pueblo en la tristeza y el luto.",
                                "zh": "这场可怕的<w>灾难</w>让整个村庄陷入了悲伤与哀悼之中。"
                            }
                        }
