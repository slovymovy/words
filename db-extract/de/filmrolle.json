                    {
                        "sense_id": "8d8af0f7-2644-38d9-8c99-38b8446041a8",
                        "entry_id": "ec48b2e6-c27a-3005-a826-cc665b6cc3f2",
                        "glosses": [
                            "Spule, auf der ein Film aufgerollt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfcc7955-6cea-4e82-bcc2-0cdd119ebedb",
                                "sense_id": "8d8af0f7-2644-38d9-8c99-38b8446041a8",
                                "text": "„Die Filmrollen waren eingelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8020bc13-c565-332e-b28c-95eac69ea966",
                        "entry_id": "ec48b2e6-c27a-3005-a826-cc665b6cc3f2",
                        "glosses": [
                            "Rolle eines Filmschauspielers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02310273-9640-4dc6-815c-8715ad06b1a3",
                                "sense_id": "8020bc13-c565-332e-b28c-95eac69ea966",
                                "text": "„Die Schauspielerin übernahm nach wie vor Film-, Fernseh- und Theaterrollen, und ihr beruflicher Standort waren die USA.“"
                            },
                            {
                                "example_id": "d6c38482-66fe-4f71-af8a-86682e388651",
                                "sense_id": "8020bc13-c565-332e-b28c-95eac69ea966",
                                "text": "„Aber Gründgens bekam 1934 für eine Filmrolle etwa 25000 Mark (und wirkte allein 1934 in vier Filmen mit), und dass 58000 Reichsmark für ein Schloss mit Nebengebäuden und Parkgrundstück am See nicht viel waren, konnte ihm nicht verborgen bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
