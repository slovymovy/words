                                                "example_id": "ef9f2b3c-3b91-47a7-abdf-d745c9b0b405",
                                                "sense_id": "4cd8ca61-c2a4-3e32-8a66-27b3fb1d221f",
                                                "text": "Dumping social."
                                            }
                                        ]
                                    }
