                    {
                        "translation_id": "e02f8ef6-0992-45c6-9d92-0b422b411831",
                        "source_entry_id": "e39d46e6-6b0f-352d-a2cf-9ddfcc067d86",
                        "source_sense_id": "9e86ef90-e552-3d17-b763-9da2168db9e3",
                        "target_lang_word": "Lager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0148b8df-2fca-37ff-a6a4-9678c7d72ee7",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Raum oder Gebäude zur geordneten Unterbringung von Waren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8cfc03e-3fd3-44b3-b2fc-9282177a1a1c",
                                                "sense_id": "0148b8df-2fca-37ff-a6a4-9678c7d72ee7",
                                                "text": "Dieser Raum dient als Lager für Computerzubehör."
                                            },
                                            {
                                                "example_id": "bac2ca80-9ecf-42f3-a102-b577a95a8c6b",
                                                "sense_id": "0148b8df-2fca-37ff-a6a4-9678c7d72ee7",
                                                "text": "„Meinen Fenstern vis-à-vis befand sich das unfertige große Krankenhausgebäude, in dem Magazine, irgendwelche Lager untergebracht waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1397ee5c-ca1f-3b86-8d57-6e4da63b7e99",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Gelände zur Unterbringung von großen Materialmengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efade310-3876-4386-83cc-a87933234ea3",
                                                "sense_id": "1397ee5c-ca1f-3b86-8d57-6e4da63b7e99",
                                                "text": "Das Gelände am Fluss dient dem Kraftwerk als Lager für die Kohle."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "438a3c7d-2250-383e-a2ff-0055eb7aa283",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "vorübergehende (provisorische) Unterkunft/Unterbringung, insbesondere militärisch"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "039fe1ae-aa25-4155-a7f4-fdb7620f4491",
                                                "sense_id": "438a3c7d-2250-383e-a2ff-0055eb7aa283",
                                                "text": "Wir schlugen unser Lager auf der Lichtung auf."
                                            },
                                            {
                                                "example_id": "a337dc4c-0c56-47ae-ae5a-dbd33e8071a4",
                                                "sense_id": "438a3c7d-2250-383e-a2ff-0055eb7aa283",
                                                "text": "„Wichtige Zwischenstation und Versorgungspunkt war das Lager Hedemünden an einer Furt der Werra.“"
                                            },
                                            {
                                                "example_id": "8ffd796e-dde0-499c-878e-700c6f8fbc98",
                                                "sense_id": "438a3c7d-2250-383e-a2ff-0055eb7aa283",
                                                "text": "„Bis wir ein Lager aufgeschlagen, ein Feuer entfacht und unser Abendessen zubereitet hatten, war es meistens stockdunkel, nur der klare Sternenhimmel funkelte über uns.“"
                                            },
                                            {
                                                "example_id": "445126c4-0e93-46b7-8902-3c3634a23032",
                                                "sense_id": "438a3c7d-2250-383e-a2ff-0055eb7aa283",
                                                "text": "„Sie bezogen ein Lager am Flussufer.“"
                                            },
                                            {
                                                "example_id": "a02dbd90-8692-4d9e-ab82-869c97601563",
                                                "sense_id": "438a3c7d-2250-383e-a2ff-0055eb7aa283",
                                                "text": "„Das zuerst besorgt, dachte er nun auch an sein eigenes Lager und trat in das Haus, um unter dem schützenden Dach desselben den matten Körper zu rasten und für neue Anstrengungen zu stärken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "737c3116-485e-32e9-a4b5-f371f49eeba4",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Erz- oder Gesteinsschicht"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "91de9a61-d0fc-3f81-8aaa-17e8aca94d66",
                                        "entry_id": "6399a9fe-62f6-3f3c-81a6-92f3e601a464",
                                        "glosses": [
                                            "Maschinenelement, das ein schwingendes oder sich drehendes Element aufnimmt"
                                        ],
                                        "tags": [
                                            "Maschinenbau",
