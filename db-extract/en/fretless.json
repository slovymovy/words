            {
                "entry_id": "22948146-132f-3854-85d8-1f4f32a07405",
                "word": "fretless",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3dfbbbff-0f6c-4126-95a3-da9540183b4e",
                        "entry_id": "22948146-132f-3854-85d8-1f4f32a07405",
                        "tags": [
                            "plural"
