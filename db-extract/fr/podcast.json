                        "form": "podcasts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "149a1a64-aba2-3b7f-8873-59ddbb65f519",
                        "entry_id": "4ce81dde-064e-3384-bcbe-fdfde41b2fa3",
                        "glosses": [
                            "Émission audio ou vidéo diffusé par Internet, souvent en série."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c30fa206-542a-42b1-8ea9-cb1eed281afe",
                                "sense_id": "149a1a64-aba2-3b7f-8873-59ddbb65f519",
                                "text": "En 2015, 270 millions de podcasts Radio France ont été téléchargés, 95 millions d’Europe1. Et du côté de RFI, environ 4,6 millions de podcasts par mois ont été écoutés en 2015."
                            },
                            {
                                "example_id": "d3e7acd8-c9da-48e9-8b3a-7d57043d5554",
                                "sense_id": "149a1a64-aba2-3b7f-8873-59ddbb65f519",
                                "text": "La journaliste Hélène Goutany ne mâche pas ses mots, pas plus qu’elle ne ménage ses efforts dans les deux épisodes d’enquête qu’elle livre au podcast Programme B."
                            },
                            {
                                "example_id": "4d3e273f-c6c1-4e83-a341-52f8315532f5",
                                "sense_id": "149a1a64-aba2-3b7f-8873-59ddbb65f519",
                                "text": "J'ai … débranché les écouteurs le temps de me déshabiller; le podcast s'est poursuivi sur le haut-parleur de mon téléphone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3f293be-67b7-49bf-89e5-220d7fd97d2f",
                        "source_entry_id": "4ce81dde-064e-3384-bcbe-fdfde41b2fa3",
                        "source_sense_id": "149a1a64-aba2-3b7f-8873-59ddbb65f519",
                        "target_lang_word": "Podcast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Podcast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84ad7665-1767-3795-b969-b7186df1e304",
                                        "entry_id": "b3523642-8442-321a-a317-b8e756f85f53",
                                        "glosses": [
                                            "Serie per Internet abonnierbarer Audio- oder Videobeiträge"
                                        ],
                                        "tags": [
                                            "Medien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4356001-328d-4012-9c87-f50eb3126c36",
                                                "sense_id": "84ad7665-1767-3795-b969-b7186df1e304",
                                                "text": "Podcasts gehören zu einem typischen Element des Web 2.0."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0061262-5a0f-397f-bc10-9f3c6c456ffa",
                                        "entry_id": "b3523642-8442-321a-a317-b8e756f85f53",
                                        "glosses": [
                                            "einzelner Beitrag aus [1]"
                                        ],
                                        "tags": [
                                            "Medien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b524a382-12e6-461a-aab8-ca767321ca2f",
                                                "sense_id": "a0061262-5a0f-397f-bc10-9f3c6c456ffa",
                                                "text": "„Stein begleitet mich, wir hören elektronische Musik und Podcasts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0a8aa0e-0e95-477c-bc5f-6f57e8380c7f",
                        "source_entry_id": "4ce81dde-064e-3384-bcbe-fdfde41b2fa3",
                        "source_sense_id": "149a1a64-aba2-3b7f-8873-59ddbb65f519",
                        "target_lang_word": "podcast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                        "entry_id": "686815b3-5d92-3343-abb2-c255eb052b8e",
                                        "glosses": [
                                            "A program, especially an audio program, produced on a regular basis, delivered over the Internet in a compressed digital format and designed for playback on computers or portable devices such as mobile phones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa6db37-0b3f-4d09-91f2-7dc2b4b9af4f",
                                                "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                                "text": "There's no restriction for what a podcast should and should not be. Of course, if you cover all these topics and more, you may find it harder to find an audience than if you focus on a narrower range and cover it well. Finding listeners is simpler if your podcast can be summarized in a sentence. More people will sample your show if it fits in a category in a podcast directory—like that found in the iTunes Store—than if it ends up lumped in a generic catch-all list."
                                            },
                                            {
                                                "example_id": "91521821-5437-40c3-b128-568dc17c8ce0",
                                                "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                                "text": "Try listening to a mix of well-known podcasts. You'll soon find that the best always feature hosts that have their own unique voice."
                                            },
                                            {
                                                "example_id": "a68d554a-8dec-46f3-b5f0-95526b62cb12",
                                                "sense_id": "19c1929f-97e5-34e1-aaa5-63af518013ef",
                                                "text": "Yet some Monday-morning quarterbacks also noted that, just as 1960 was the first TV election and 2016 was the first social-media election, the 2024 Presidential campaign was the first to be conducted largely on live streams and long-form podcasts, media that happen to be thoroughly dominated by MAGA bros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99593d27-593a-368a-b31f-ecae0a1c1d18",
                                        "entry_id": "686815b3-5d92-3343-abb2-c255eb052b8e",
                                        "glosses": [
                                            "An individual episode of such a program."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "podcast",
                                "target_lang_code": "en",
                                "target_senses": [
