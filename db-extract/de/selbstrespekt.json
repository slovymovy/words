                        "glosses": [
                            "Respekt vor sich selbst, den eigenen Bedürfnissen und Fähigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee9fe1c4-bc2e-43b3-96c1-299a6318c565",
                                "sense_id": "0ab01956-8b8a-332b-93a4-24a4d85f00ca",
                                "text": "„Sonst verlor man den Selbstrespekt und den Glauben an die Sache und fing an, sich zu fragen: wofür?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
