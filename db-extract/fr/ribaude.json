                "senses": [
                    {
                        "sense_id": "2e2110d6-e6a1-3b70-8bb9-3c7b470b79fb",
                        "entry_id": "2c6d473a-1d59-3607-90d1-96439a5709a2",
                        "glosses": [
                            "Femme de mauvaise vie ; femme qui se livre à la prostitution."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "23fe715d-bb94-4c9d-beb0-8bca36013975",
                                "sense_id": "2e2110d6-e6a1-3b70-8bb9-3c7b470b79fb",
                                "text": "Qui aurait pu reconnaître, en cette belle ribaude, la mercière du Cheapside, revêche, dévote et sempiternellement vêtue de noir ?"
                            },
                            {
                                "example_id": "67a47c6f-46cf-4b04-b7e2-3eafbe67becc",
                                "sense_id": "2e2110d6-e6a1-3b70-8bb9-3c7b470b79fb",
                                "text": "« En vérité, j'étais une ribaude, une fille à soldats : mon cœur, mon lâche cœur préférait l'aventurier à l'intellectuel »"
                            },
                            {
                                "example_id": "7e34f362-366d-4886-863e-6fd1a99e6d21",
                                "sense_id": "2e2110d6-e6a1-3b70-8bb9-3c7b470b79fb",
                                "text": "Les garces ! hurla-t-elle. Après tout ce que j’ai fait pour elles, après les mariages que je leur ai arrangés… Se faire pincer comme des ribaudes. Eh bien ! qu’elles perdent tout ! Qu’on les enferme, qu’on les empale, qu’on les pende !"
                            },
                            {
                                "example_id": "93880750-c488-4c30-ae39-be3ba8585a06",
                                "sense_id": "2e2110d6-e6a1-3b70-8bb9-3c7b470b79fb",
                                "text": "Je ne lui ai rien dit de tel, Monseigneur ! Cette ribaude ricane et échafaude !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77003e84-4cca-4458-ae7c-507bd96cb124",
                        "source_entry_id": "2c6d473a-1d59-3607-90d1-96439a5709a2",
                        "source_sense_id": "2e2110d6-e6a1-3b70-8bb9-3c7b470b79fb",
                        "target_lang_word": "ramera",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ramera",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ca10de41-8752-39d8-9e92-32952597623f",
                                        "entry_id": "4d57f591-e881-3e2c-9593-4f72aa48aded",
                                        "glosses": [
                                            "Mujer que mantiene relaciones sexuales por dinero."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b88dc6-3082-4165-b9b7-ed992ecff442",
                                                "sense_id": "ca10de41-8752-39d8-9e92-32952597623f",
                                                "text": "Ca hauiendo se ella enel palacio & sala del emperador mas como ramera que como dueña honesta."
                                            },
                                            {
                                                "example_id": "10a52424-7686-412e-87a2-036599f6c65f",
                                                "sense_id": "ca10de41-8752-39d8-9e92-32952597623f",
                                                "text": "Era tanta su bestialidad, o por mejor decir su torpedad, que no podían ofrescer en aquel templo ninguna mujer que fuese casada o viuda, sino virgen muy honrada, la cual mal aventurada, en torno de un año, y dentro del mismo templo, de virgen sagrada, se tornaba ramera pública."
                                            },
                                            {
                                                "example_id": "6a2b2c64-33df-44dc-9d8c-4f9bea2d486d",
                                                "sense_id": "ca10de41-8752-39d8-9e92-32952597623f",
                                                "text": "Con toda el alma sintió el deseo, religioso y profundo, de que si Mendizábal tenía una hija, ésta terminara de ramera, vendiéndose en la calle como la puta más infeliz, como la más desgraciada e infeliz de las putas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
