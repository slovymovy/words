                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6484890e-86b5-34c5-9e0f-d5a3ff72408d",
                        "entry_id": "e354f3fd-7cd2-3cda-a0ad-c0b85a61feab",
                        "glosses": [
                            "From bottom to top."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3a1c99b7-11df-4ae0-b705-b530869d60f3",
                                "sense_id": "6484890e-86b5-34c5-9e0f-d5a3ff72408d",
                                "text": "One hundred per cent penetration can be obtained by welding in a slight vertical weld uphand on metal up to eight gages."
                            },
                            {
                                "example_id": "fdacf3ed-fa5e-4473-b876-8d15371984e4",
                                "sense_id": "6484890e-86b5-34c5-9e0f-d5a3ff72408d",
                                "text": "It is made uphand, pushing the arc with the torch steeply inclined 15° to 20° to the pipe."
                            }
                        ]
                    },
                    {
                        "sense_id": "72c5a27c-dfd9-3407-bc73-c6be0f46f618",
                        "entry_id": "e354f3fd-7cd2-3cda-a0ad-c0b85a61feab",
                        "glosses": [
                            "Moved by hand in an upward direction."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8f092988-6663-4cb4-b86a-e323ef93345c",
                                "sense_id": "72c5a27c-dfd9-3407-bc73-c6be0f46f618",
                                "text": "As by a leaf to fling On the glass of wind Or up transparent leaf-sides over and over Uphand to swing Into the airy sockets of light And the broad plates tread like a bird Kissing light."
                            },
                            {
                                "example_id": "3a167042-ef88-432c-99aa-369b200ca4f1",
                                "sense_id": "72c5a27c-dfd9-3407-bc73-c6be0f46f618",
                                "text": "...noise shifted uphand by the noise shaper) are responsible for the observed filter ripples and a notable roll-off of the ..."
                            }
                        ]
                    }
