{
    "word_family": [
        "rafter",
        "rafting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d2325a5-718b-3cf9-9308-b072f52a4e94",
                    "sense_definition": "A flat-bottomed floating structure used for transport or as a platform on water.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "watercraft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They floated down the river on an inflatable <w>raft</w>.",
                            "target_lang_translations": {
                                "ru": "Они плыли вниз по реке на надувном <w>плоту</w>."
                            }
                        },
                        {
                            "text": "The group used a <w>raft</w> to cross the wide river safely.",
                            "target_lang_translations": {
                                "ru": "Группа использовала <w>плот</w>, чтобы безопасно пересечь широкую реку."
                            }
                        }
                    ],
                    "synonyms": [
                        "pontoon"
                    ],
                    "common_phrases": [
                        "inflatable raft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоскодонное плавучее сооружение, используемое для перевозки или в качестве платформы на воде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плот",
                                "target_lang_sense_clarification": "плавательное средство, представляющее собой плавучую площадку"
                            },
                            {
                                "target_lang_word": "рафт",
                                "target_lang_sense_clarification": "надувной плот для сплава по порожистым рекам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c689e082-d7c0-3ce0-909a-1de777ee96dd",
                    "sense_definition": "A large, unspecified number or quantity of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced a <w>raft</w> of complaints after the new update.",
                            "target_lang_translations": {
                                "ru": "Компания столкнулась с <w>множеством</w> жалоб после нового обновления."
                            }
                        },
                        {
                            "text": "The manager presented a <w>raft</w> of new ideas during the meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер представил <w>кучу</w> новых идей во время встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "multitude",
                        "abundance"
                    ],
                    "common_phrases": [
                        "raft of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое, неопределенное количество или множество чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "множество",
                                "target_lang_sense_clarification": "большое количество, изобилие"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "разговорное обозначение большого количества чего-либо"
                            },
                            {
                                "target_lang_word": "уйма",
                                "target_lang_sense_clarification": "разговорное обозначение очень большого количества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82ee4662-f707-3ec5-9f32-befc656000cf",
                    "sense_definition": "A large, dense group of swimming seabirds or sea mammals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>raft</w> of penguins gathered near the icy shore.",
                            "target_lang_translations": {
                                "ru": "Большая <w>стая</w> пингвинов собралась у ледяного берега."
                            }
                        },
                        {
                            "text": "The researchers observed a <w>raft</w> of seabirds floating together.",
                            "target_lang_translations": {
                                "ru": "Исследователи наблюдали, как <w>скопление</w> морских птиц плавает вместе."
                            }
                        }
                    ],
                    "synonyms": [
                        "flock",
                        "colony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая, плотная группа плавающих морских птиц или морских млекопитающих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа птиц или животных, держащихся вместе"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "большое количество собравшихся вместе существ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c98e1cff-4398-3595-8d4f-d06e6cc5e992",
                    "sense_definition": "To travel or navigate on water using a raft.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>raft</w> down the rapids this summer.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>сплавиться</w> по порогам этим летом."
                            }
                        },
                        {
                            "text": "It is exciting to <w>raft</w> through the mountain river.",
                            "target_lang_translations": {
                                "ru": "Захватывающе <w>сплавляться</w> по горной реке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "raft down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать или перемещаться по воде на плоту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплавляться",
                                "target_lang_sense_clarification": "передвигаться по реке на плоту или лодке"
                            },
                            {
                                "target_lang_word": "рафтить",
                                "target_lang_sense_clarification": "заниматься сплавом на рафте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53c81430-f47f-3176-89a9-7dbb8624b6be",
                    "sense_definition": "To transport goods or materials by placing them on a raft.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Loggers <w>raft</w> the timber down the river to the mill.",
                            "target_lang_translations": {
                                "ru": "Лесорубы <w>сплавляют</w> бревна вниз по реке на лесопилку."
                            }
                        },
                        {
                            "text": "They had to <w>raft</w> the supplies across the flooded valley.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>переправлять</w> припасы через затопленную долину."
                            }
                        }
                    ],
                    "synonyms": [
                        "transport",
                        "ship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить товары или материалы, размещая их на плоту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплавлять",
                                "target_lang_sense_clarification": "транспортировать груз (обычно лес) по воде"
                            },
                            {
                                "target_lang_word": "переправлять",
                                "target_lang_sense_clarification": "перевозить грузы через водную преграду"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}