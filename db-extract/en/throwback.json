                                            {
                                                "example_id": "0982eedf-391b-4b05-94d9-8b06e7713dea",
                                                "sense_id": "615166eb-27ba-3158-81c8-a6918c3874ef",
                                                "text": "Wenn dieses Gesetz durchkommt, wäre das ein Rückfall in die Zeit vor der Emanzipation."
                                            }
