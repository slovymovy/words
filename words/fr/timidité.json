                },
                {
                    "sense_id": "9f2a15cd-7616-3beb-ab87-a2983eacb37d",
                    "sense_definition": "Manque d'audace, de force ou d'envergure dans une action, un choix ou une réalisation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les critiques ont regretté la <w>timidité</w> de la mise en scène, jugée trop classique."
