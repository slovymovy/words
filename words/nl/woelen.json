{
    "word_family": [
        "gewoel",
        "woeling",
        "omwoelen",
        "doorwoelen",
        "woelwater",
        "woelgeest"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81cff220-d73c-3d13-9a47-fa17c7ea097a",
                    "sense_definition": "onrustig heen en weer bewegen, vooral in bed als men niet kan slapen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onrustig bewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik lag de hele nacht te <w>woelen</w> omdat ik me zorgen maakte over het examen.",
                            "target_lang_translations": {
                                "en": "I lay <w>tossing and turning</w> all night because I was worried about the exam."
                            }
                        },
                        {
                            "text": "Door de hitte bleef hij maar <w>woelen</w> in bed zonder in slaap te vallen.",
                            "target_lang_translations": {
                                "en": "Because of the heat, he kept <w>tossing</w> in bed without falling asleep."
                            }
                        }
                    ],
                    "synonyms": [
                        "draaien",
                        "omdraaien"
                    ],
                    "antonyms": [
                        "stilslaan",
                        "rusten"
                    ],
                    "common_phrases": [
                        "liggen te woelen",
                        "woelen in bed"
                    ],
                    "target_lang_definitions": {
                        "en": "To move restlessly back and forth, especially in bed when unable to sleep"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "toss and turn",
                                "target_lang_sense_clarification": "moving restlessly in bed"
                            },
                            {
                                "target_lang_word": "toss",
                                "target_lang_sense_clarification": "moving restlessly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ff82ad7-01c8-3ba2-8654-4efd18a5fc4b",
                    "sense_definition": "met de handen of een snuit in iets graven of roeren, vaak in de aarde",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "graven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De varkens <w>woelen</w> de hele dag in de modder op zoek naar eten.",
                            "target_lang_translations": {
                                "en": "The pigs <w>root</w> in the mud all day looking for food."
                            }
                        },
                        {
                            "text": "Het kind hield ervan om met zijn vingers in het zand te <w>woelen</w>.",
                            "target_lang_translations": {
                                "en": "The child loved to <w>dig</w> in the sand with his fingers."
                            }
                        }
                    ],
                    "synonyms": [
                        "wroeten",
                        "graven",
                        "omwoelen"
                    ],
                    "common_phrases": [
                        "woelen in de aarde",
                        "in het zand woelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To dig or stir in something with hands or a snout, often in soil"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "root",
                                "target_lang_sense_clarification": "digging with a snout or hands"
                            },
                            {
                                "target_lang_word": "dig",
                                "target_lang_sense_clarification": "moving material out of the way"
                            },
                            {
                                "target_lang_word": "grub",
                                "target_lang_sense_clarification": "digging or rooting around"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05c43660-e767-38d4-af16-4838addf10a2",
                    "sense_definition": "figuurlijk bezig blijven met pijnlijke gedachten of herinneringen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale onrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet gezond om constant te <w>woelen</w> in het verleden.",
                            "target_lang_translations": {
                                "en": "It is not healthy to constantly <w>dwell</w> on the past."
                            }
                        },
                        {
                            "text": "Zij bleef in haar herinneringen <w>woelen</w> om een antwoord te vinden op haar vragen.",
                            "target_lang_translations": {
                                "en": "She kept <w>digging</w> through her memories to find an answer to her questions."
                            }
                        }
                    ],
                    "synonyms": [
                        "graven",
                        "wroeten"
                    ],
                    "antonyms": [
                        "loslaten"
                    ],
                    "common_phrases": [
                        "woelen in het verleden"
                    ],
                    "target_lang_definitions": {
                        "en": "To figuratively dwell on or stir up painful thoughts or memories"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dwell on",
                                "target_lang_sense_clarification": "thinking about something painful"
                            },
                            {
                                "target_lang_word": "rake up",
                                "target_lang_sense_clarification": "reviving old memories"
                            },
                            {
                                "target_lang_word": "dig into",
                                "target_lang_sense_clarification": "investigating the past"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a56ceb05-3c0e-3133-a4c0-7d0813b302fa",
                    "sense_definition": "het losmaken of omroeren van een vaste laag, zoals grond of water",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke beroering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke stroming deed het slib op de bodem van de rivier <w>woelen</w>.",
                            "target_lang_translations": {
                                "en": "The strong current caused the silt on the riverbed to <w>churn up</w>."
                            }
                        },
                        {
                            "text": "De boer moet de grond grondig <w>woelen</w> voordat hij kan zaaien.",
                            "target_lang_translations": {
                                "en": "The farmer must <w>till</w> the soil thoroughly before he can sow."
                            }
                        }
                    ],
                    "synonyms": [
                        "omroeren",
                        "omwentelen"
                    ],
                    "common_phrases": [
                        "de bodem woelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To loosen or stir up a solid layer, such as soil or water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "churn up",
                                "target_lang_sense_clarification": "stirring up sediment or water"
                            },
                            {
                                "target_lang_word": "till",
                                "target_lang_sense_clarification": "loosening soil"
                            },
                            {
                                "target_lang_word": "agitate",
                                "target_lang_sense_clarification": "disturbing a surface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}