                                        "glosses": [
                                            "powyginany w kształcie fal, układający się w fale, przypominający pod jakimkolwiek względem falę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68618d9b-2021-46c0-acfe-f15bade2061b",
                                                "sense_id": "ba194e82-47ff-390b-bfe7-8efa7b91f0b5",
                                                "text": "Górna powierzchnia dachu jest falista."
                                            },
                                            {
                                                "example_id": "24bca07c-c29e-441b-94bb-362f594dec6b",
                                                "sense_id": "ba194e82-47ff-390b-bfe7-8efa7b91f0b5",
                                                "text": "Pas publicznego traktu przecinał okolicę, ciągnąc się po falistych pagórkach i rozpłaszczonych nizinach."
                                            },
                                            {
                                                "example_id": "ea5324f7-ca23-44f0-b6da-9eb40d5511c0",
                                                "sense_id": "ba194e82-47ff-390b-bfe7-8efa7b91f0b5",
                                                "text": "W malarstwie typowo secesyjnym posługiwano się najczęściej liniami falistymi, operując półtonami, a jeśli już pełnymi barwami, to raczej zgaszonymi."
                                            }
                                        ],
