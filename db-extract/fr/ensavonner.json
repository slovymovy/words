                "senses": [
                    {
                        "sense_id": "bc980974-fb31-346e-aecf-a0ce9d3f5613",
                        "entry_id": "afe5bac1-6733-3370-98ec-c73ed35c1a06",
                        "glosses": [
                            "Enduire de savon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b491ceef-9056-4a17-8605-a431ca2be55e",
                                "sense_id": "bc980974-fb31-346e-aecf-a0ce9d3f5613",
                                "text": "Toutes boutiques à rue, largement ouvertes; le patient regarde le public qui circule, et ne se doute évidemment pas de la figure drôle qu’il fait quand on l’ensavonne."
                            },
                            {
                                "example_id": "3f1aede9-ffd4-401e-8ee3-2a9cab133eb3",
                                "sense_id": "bc980974-fb31-346e-aecf-a0ce9d3f5613",
                                "text": "C’est elle, en effet, qui, chez les barbiers de la capitale, ensavonne les clients et armée de l’instrument tranchant, que vous connaissez, caresse les mentons poilus avec une maestria déconcertante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c4f71ba-2b63-47e2-af03-8a0f72112796",
                        "source_entry_id": "afe5bac1-6733-3370-98ec-c73ed35c1a06",
                        "source_sense_id": "bc980974-fb31-346e-aecf-a0ce9d3f5613",
                        "target_lang_word": "enjabonar",
