                            {
                                "example_id": "4d2e8e20-e1c3-4774-af21-24ada4d403ca",
                                "sense_id": "e2e5dd5d-a73f-3fbc-a05d-18bb6e3ce109",
                                "text": "Voor de begrafenis van zijn vader had de zwerver zich zowaar gewassen en een pak met stropdas aangetrokken."
                            },
                            {
                                "example_id": "fe24bf2a-be06-4243-9637-0099e016041d",
                                "sense_id": "e2e5dd5d-a73f-3fbc-a05d-18bb6e3ce109",
                                "text": "Als we 's middags weer aan 't werk zijn komt er een dame aan en deze keer maakt luit Bom zowaar een praatje met haar."
                            },
                            {
                                "example_id": "40c8e7e4-51e8-4031-8845-ea018de247c9",
                                "sense_id": "e2e5dd5d-a73f-3fbc-a05d-18bb6e3ce109",
                                "text": "Tot haar verbazing lichten Johannes' ogen op - haar echtgenoot lijkt zowaar blij te zijn dat hij haar ziet."
                            }
                        ]
                    }
