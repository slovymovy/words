                        ]
                    },
                    {
                        "translation_id": "37894cbc-d133-41c0-923c-61397511c69f",
                        "source_entry_id": "f8794485-4c7c-3b5e-8a9a-d5bed5d5afa2",
                        "source_sense_id": "fbf3aefc-cabf-3445-8ee8-c429a5cf8d94",
                        "source_sense_description": "(Belgique) (Suisse) Subvention, fonds que l’État accorde à une entreprise pour la soutenir.",
