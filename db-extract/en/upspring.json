                        "glosses": [
                            "To spring up, rise up, originate, come into being."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6c7e3c65-a330-4142-ad1c-013a55f27575",
                                "sense_id": "d287171f-6952-3773-b93c-c9d5ac6e46b4",
                                "text": "In diamond light upspring the dazzling peaks Of Pyramids"
                            },
                            {
                                "example_id": "71f657f6-df43-4cc9-8fba-8e848dc8c3ad",
                                "sense_id": "d287171f-6952-3773-b93c-c9d5ac6e46b4",
                                "text": "Might not its waters upspring in this new land, whose discovery was the great marvel of the age, and which men looked upon as the unknown east of Asia?"
                            }
                        ]
                    }
