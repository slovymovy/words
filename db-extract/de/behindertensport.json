                        "sense_id": "000c227c-041c-3bdf-aa2d-4191d60d3c65",
                        "entry_id": "7f6a8266-02e0-3d8b-bd3c-b5ff6bc7ebd4",
                        "glosses": [
                            "Sport, der speziell auch von Behinderten ausgeführt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24bd2663-441e-4a08-81ba-fbb272f5e505",
                                "sense_id": "000c227c-041c-3bdf-aa2d-4191d60d3c65",
                                "text": "„Die Förderung von Behindertensport ist für die Stadt Hamburg eine Selbstverständlichkeit.“"
                            },
                            {
                                "example_id": "68be4682-88cc-4d9b-a495-534cb28fb5ae",
                                "sense_id": "000c227c-041c-3bdf-aa2d-4191d60d3c65",
                                "text": "„Der Weltmarktführer in der Prothetik, bei Orthesen und Rollstühlen engagiert sich im Behindertensport und ist seit mehr als 30 Jahren der Topsponsor bei paralympischen Sommer- und Winterspielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd0b9ec9-965d-4559-86b6-9f0ba9ad8490",
                        "source_entry_id": "7f6a8266-02e0-3d8b-bd3c-b5ff6bc7ebd4",
                        "source_sense_id": "000c227c-041c-3bdf-aa2d-4191d60d3c65",
