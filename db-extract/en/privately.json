                                                "sense_id": "56e2e4bb-de78-3e0a-8ff7-56ec68f49aa3",
                                                "text": "Ningún hombre o descendencia de hombre, colectiva o privadamente tiene derecho a la administración del gobierno, como no lo tenga al talento"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
