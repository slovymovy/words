                    {
                        "sense_id": "a165f6ad-859e-39af-b132-b1cad361300a",
                        "entry_id": "c8f0a5d6-d12e-3efc-bdd6-2049fc20883c",
                        "glosses": [
                            "Krieger/Soldat beziehungsweise neuerdings Sportler, der mit Pfeil und Bogen schießt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a11799-b963-4b3b-9367-280770711029",
                                "sense_id": "a165f6ad-859e-39af-b132-b1cad361300a",
                                "text": "„Der Bogner kann seine Waffe nicht mit ungeschützten Händen spannen. Die Finger würden schon nach wenigen Schüssen unter dem Druck und der Reibung der Sehne wund und blutig werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "577aaa2b-b9ce-3823-a8f2-c00c10f3fcdd",
                        "entry_id": "c8f0a5d6-d12e-3efc-bdd6-2049fc20883c",
                        "glosses": [
                            "Handwerker, der Bogen (und/oder Armbrüste) fertigt"
                        ],
                        "tags": [
                            "historical",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a4fca0b2-042e-4ccc-b012-454805e8f976",
                                "sense_id": "577aaa2b-b9ce-3823-a8f2-c00c10f3fcdd",
                                "text": "„Die Technik der Hornbogenherstellung für Armbruste übernahmen die Europäer im späten Hochmittelalter wahrscheinlich aus dem islamischen Kulturkreis, wobei auch muslimische Bogner in Europa wirkten und Armbruste fertigten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
