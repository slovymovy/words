                        "sense_id": "17e02688-7330-336a-a7c5-6d93cb69be78",
                        "entry_id": "cc986bf5-aa0d-30cd-b776-73220b5fdd28",
                        "glosses": [
                            "Relatif au Moyen-Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f79df8-e1c0-45d4-ab68-337cd0822693",
                                "sense_id": "17e02688-7330-336a-a7c5-6d93cb69be78",
                                "text": "Il est compréhensible que les Européens continuent à observer avec a plus grande suspicion les événements au Sud qui traduisent l’échec pour le moins gênant de leurs politiques moyen-orientales depuis un demi-siècle."
                            },
                            {
                                "example_id": "5a8e40b4-39e0-41cb-9835-69ae5c90dc47",
                                "sense_id": "17e02688-7330-336a-a7c5-6d93cb69be78",
                                "text": "Ici, la cuisine est une combinaison de recettes moyen-orientales, dont la plupart sont des spécialités régionales: kebsas, viandes grillées et soupes sont parmi les préférés de la clientèle."
                            }
                        ]
                    }
