                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beiprogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c0665a-7356-3b11-b56d-1991f741785e",
                                        "entry_id": "d03fab9a-965e-3c22-ae4c-62310f9ae209",
                                        "glosses": [
                                            "zusätzliche Veranstaltung/Angebot neben dem Hauptprogramm, neben dem Hauptfilm im Kino"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35726223-2809-4e9a-8c33-657285e3bb5b",
                                                "sense_id": "f8c0665a-7356-3b11-b56d-1991f741785e",
                                                "text": "Das Beiprogramm für die Begleitpersonen der geladenen Gäste war von den Veranstaltern sorgfältig ausgewählt worden."
                                            },
                                            {
                                                "example_id": "88961ab2-2334-4718-bdb4-10eed3fe2361",
                                                "sense_id": "f8c0665a-7356-3b11-b56d-1991f741785e",
                                                "text": "„Zusätzlich zu der abendfüllenden Fassung des Filmes sollte die Nova noch eine kürzere Fassung von 7–800 Metern herstellen; diese sollte im Beiprogramm laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7dd9afd-8ba9-49d8-9b19-011649213399",
                        "source_entry_id": "bfe813fb-7bd5-3f7f-b468-94839b710874",
                        "source_sense_description": "minor attraction at a larger event",
                        "target_lang_word": "Nebenschauplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebenschauplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "513bd877-c220-3f16-a977-70d551670422",
                                        "entry_id": "c079f454-664b-3607-9390-54697b16a642",
                                        "glosses": [
                                            "Handlungsort abseits des Kerngeschehens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac40504-829a-446e-ad62-7741cb97d963",
                                                "sense_id": "513bd877-c220-3f16-a977-70d551670422",
                                                "text": "„Im hessischen Mörfelden versuchten Anfang der achtziger Jahre gar Demonstranten die Strommasten umzusägen – die Trasse wurde zum Nebenschauplatz des Widerstands gegen die Frankfurter Startbahn West.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8327d4d7-d990-31f9-a8bd-22eda4d20a57",
                                        "entry_id": "c079f454-664b-3607-9390-54697b16a642",
                                        "glosses": [
                                            "nebensächliches Thema, Diskussionszweig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70943dbb-3b49-48c0-a847-e9057087c953",
                                                "sense_id": "8327d4d7-d990-31f9-a8bd-22eda4d20a57",
                                                "text": "„Die Austrocknung von Steueroasen ist da nur ein Nebenschauplatz. Das Thema mag wahlwirksam sein, für die Wirtschaft wären aber ganz andere Maßnahmen wichtig […].“"
                                            },
                                            {
                                                "example_id": "37675f46-6666-4bdf-a3ad-f378c0d59121",
                                                "sense_id": "8327d4d7-d990-31f9-a8bd-22eda4d20a57",
                                                "text": "„Mit ihrer Idee, Wagner für Kinder zu spielen, begeben sie sich auf einen Nebenschauplatz, denn Nachwuchssorgen sind das Letzte, woran die zehnfach überbuchten Festspiele kranken.“"
                                            },
                                            {
                                                "example_id": "c6cd1b4a-db00-45ad-b86d-f662a3ca1ed4",
                                                "sense_id": "8327d4d7-d990-31f9-a8bd-22eda4d20a57",
                                                "text": "„Zudem sollten sie einen Nebenschauplatz der Reformdebatte meiden.“"
                                            },
                                            {
                                                "example_id": "29518fd3-d3d7-4312-8adf-afae378a72bb",
                                                "sense_id": "8327d4d7-d990-31f9-a8bd-22eda4d20a57",
                                                "text": "„Einen Nebenschauplatz im Streit um das gute und richtige Deutsch macht der Verein Deutsche Sprache (VDS) auf: Dort beschwert man sich über die englischen Begriffe der Deutschen Telekom.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
