                "translations": [
                    {
                        "translation_id": "727d0768-6205-4a2f-a6b9-400e697fcf53",
                        "source_entry_id": "abf7bdfb-15e6-3f13-930d-5230535100e1",
                        "source_sense_id": "5ae82348-909f-3cbf-8e98-27a243eb1eb0",
                        "target_lang_word": "Kreisverkehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreisverkehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb7f45fb-5bc0-3218-9770-9c509dd0008f",
                                        "entry_id": "1ea4c9bb-e321-3eb5-86fb-88a1721b3866",
                                        "glosses": [
                                            "kreisförmiger Straßenverlauf mit Ein- und Ausfahrten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ac30c3c-ed22-44d0-a547-b3885afd3ab5",
                                                "sense_id": "fb7f45fb-5bc0-3218-9770-9c509dd0008f",
                                                "text": "Beachten Sie die Fußgänger beim Austreten aus dem Kreisverkehr."
                                            },
                                            {
                                                "example_id": "b1a93dfb-b106-4f78-ba66-f7f29dab95d4",
                                                "sense_id": "fb7f45fb-5bc0-3218-9770-9c509dd0008f",
                                                "text": "„Der Ausbau mit einem Kreisverkehr verbessert sowohl den Verkehrsfluss als auch die Sicherheit an der viel befahrenen Straße\", sagte Verkehrsminister Volker Schlotmann /SPD).“"
                                            },
                                            {
                                                "example_id": "d9c6df58-7ed9-43a3-8bd3-aa9dd6c67c13",
                                                "sense_id": "fb7f45fb-5bc0-3218-9770-9c509dd0008f",
                                                "text": "„Das Herz ist ein Kreisverkehr auf einer Anhöhe, der die Straßen der Siedlungen miteinander verbindet wie ein großes Kreuz.“"
                                            },
                                            {
                                                "example_id": "422673aa-30ee-4e9c-a2b5-137eb85520ab",
                                                "sense_id": "fb7f45fb-5bc0-3218-9770-9c509dd0008f",
                                                "text": "„Er blieb am Kreisverkehr der Industrie stehen, um wieder zu Atem zu kommen.“"
                                            },
                                            {
                                                "example_id": "b038d964-7d37-4d8f-9bc6-bc532dcf4c18",
                                                "sense_id": "fb7f45fb-5bc0-3218-9770-9c509dd0008f",
                                                "text": "„Wir passieren einen weiteren Kreisverkehr und biegen auf eine kleine Straße ab, die wider Erwarten nicht an den Fluß führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08f61376-4455-4252-a978-730dd1643196",
                        "source_entry_id": "abf7bdfb-15e6-3f13-930d-5230535100e1",
                        "source_sense_id": "5ae82348-909f-3cbf-8e98-27a243eb1eb0",
                        "target_lang_word": "roundabout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roundabout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afaf4dcc-a0fd-34a0-bbc2-f0854e1e0ec1",
                                        "entry_id": "a26b8105-a00c-3841-99db-891e3e10db1a",
                                        "glosses": [
                                            "Indirect, circuitous, or circumlocutionary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c3eef5-11d8-4005-b971-5f2f0ac7a179",
                                                "sense_id": "afaf4dcc-a0fd-34a0-bbc2-f0854e1e0ec1",
                                                "text": "[S]he fled, running like a deer, doubling and turning through alleys and back streets until by a very roundabout road she reached her own room."
                                            },
                                            {
                                                "example_id": "fc81a5e5-a1de-418a-97a3-b7f29ef96c81",
                                                "sense_id": "afaf4dcc-a0fd-34a0-bbc2-f0854e1e0ec1",
                                                "text": "\"Really, Bill, I think your best plan would be to go straight to father and tell him the whole thing.—You don't want him to hear about it in a roundabout way.\""
                                            },
                                            {
                                                "example_id": "7ef7afb7-bc4d-46a4-8e63-db7168b93d9d",
                                                "sense_id": "afaf4dcc-a0fd-34a0-bbc2-f0854e1e0ec1",
                                                "text": "Mr. Rather flew to the area in a roundabout fashion, first landing in Bahrain, from there flying to Islamabad and then heading to Kabul by land."
                                            },
                                            {
                                                "example_id": "5c59f439-280f-42a5-aa45-4086cc7a7637",
                                                "sense_id": "afaf4dcc-a0fd-34a0-bbc2-f0854e1e0ec1",
                                                "text": "Descartes is compelled to fall back upon a curious roundabout argument to prove that there is a world. He must first prove that God exists, and then argue that God would not deceive us into thinking that it exists when it does not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b06e6b2-69b7-386f-9186-40001523f396",
                                        "entry_id": "a26b8105-a00c-3841-99db-891e3e10db1a",
                                        "glosses": [
                                            "Encircling; enveloping; comprehensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccbaf8d-28db-44d0-b1c7-f6d6261b635d",
                                                "sense_id": "8b06e6b2-69b7-386f-9186-40001523f396",
                                                "text": "The third sort is of those who readily and sincerely follow reason, but for want of having that which one may call a large, sound, roundabout sense, have not a full view of all that relates to the question."
                                            }
                                        ]
                                    }
                                ]
                            },
