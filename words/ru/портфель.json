                },
                {
                    "sense_id": "a43c1aaf-6319-3fff-8a3b-33de97a4ab10",
                    "sense_definition": "Прямоугольная сумка с ручкой, предназначенная для переноски деловых бумаг и документов.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отец всегда носил на работу старый кожаный <w>портфель</w>.",
                            "target_lang_translations": {
                                "en": "Father always carried an old leather <w>briefcase</w> to work.",
                                "de": "Der Vater trug immer eine alte lederne <w>Aktentasche</w> zur Arbeit."
                            }
                        },
                        {
                            "text": "Он открыл <w>портфель</w> и достал оттуда важный договор.",
                            "target_lang_translations": {
                                "en": "He opened the <w>briefcase</w> and took out an important contract.",
                                "de": "Er öffnete die <w>Aktentasche</w> und holte einen wichtigen Vertrag heraus."
                            }
                        }
                    ],
                    "common_phrases": [
                        "кожаный портфель",
                        "открыть портфель",
                        "забыть портфель"
                    ],
                    "target_lang_definitions": {
