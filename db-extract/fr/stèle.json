                "forms": [
                    {
                        "form_id": "ebe0dc1a-e9c8-4985-b625-89dae39771a0",
                        "entry_id": "685059a1-04ce-3edb-a75b-13adf48fdf79",
                        "tags": [
                            "plural"
                        ],
                        "form": "stèles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8141f262-e7c2-38ee-9465-c44d95c29e1f",
                        "entry_id": "685059a1-04ce-3edb-a75b-13adf48fdf79",
                        "glosses": [
                            "Monument monolithe ayant la forme d’un fût de colonne, d’un obélisque, d’une dalle dressée et sculptée ou peinte, qui sert le plus souvent à marquer l’emplacement d’une sépulture."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "a90ffafa-1bd0-455f-af79-5b3a45500d11",
                                "sense_id": "8141f262-e7c2-38ee-9465-c44d95c29e1f",
                                "text": "Une stèle votive."
                            },
                            {
                                "example_id": "f2e6b092-2bef-4936-ba75-b2210eef4ef1",
                                "sense_id": "8141f262-e7c2-38ee-9465-c44d95c29e1f",
                                "text": "Au fond, à demi cachée par l’enchevêtrement des branches, on aperçoit une clairière déserte où se dresse une petite statue d’Aphrodite sur une stèle enguirlandée de roses."
                            }
                        ]
                    },
                    {
                        "sense_id": "128c06f5-4cba-3679-b8da-5405a0ce062d",
                        "entry_id": "685059a1-04ce-3edb-a75b-13adf48fdf79",
                        "glosses": [
                            "Partie centrale des tiges et des racines des plantes vasculaires entourée de l'endoderme et comprenant la moelle, le bois, le liber et les formations libéroligneuses."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8a2bdd5-c6b6-4749-b1dc-e7c60b13ffac",
                        "source_entry_id": "685059a1-04ce-3edb-a75b-13adf48fdf79",
                        "target_lang_word": "Stele",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stele",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf37775-1f5f-30c7-a6d2-f4066eb77322",
                                        "entry_id": "b43a1c20-113a-389f-9dd7-dad1fc68d87b",
                                        "glosses": [
                                            "Grabstein, Gedenkstein der Antike, Pfeiler mit einer Inschrift- oder Bildtafel; heute auch moderne freistehende Informationstafel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a6be32e-98dd-4a63-8863-7f56a07d02a5",
                                                "sense_id": "7bf37775-1f5f-30c7-a6d2-f4066eb77322",
                                                "text": "„Die Stele mit dem lebensgroßen Relief König Sargons des Zweiten wurde nun auf der Insel Cypern aufgestellt und verbreitete Schrecken und Furcht unter der Bevölkerung.“"
                                            },
                                            {
                                                "example_id": "7a7f19ee-5505-4e85-bccf-67d74de32622",
                                                "sense_id": "7bf37775-1f5f-30c7-a6d2-f4066eb77322",
                                                "text": "„Ein Relief auf einer der Stelen zeigt eine Jagdszene.“"
                                            },
                                            {
                                                "example_id": "3fb1e4e6-a6b2-4871-a1f0-35a06755a55b",
                                                "sense_id": "7bf37775-1f5f-30c7-a6d2-f4066eb77322",
                                                "text": "„Die Tempel und Stelen besitzen kunstvolle Reliefs, die aber oft grausame Szenen schildern.“"
                                            },
                                            {
                                                "example_id": "74266192-f5df-4b64-8894-01b80efebb15",
                                                "sense_id": "7bf37775-1f5f-30c7-a6d2-f4066eb77322",
                                                "text": "„Denn der »Stein«, den die beiden Schüler entdeckten, war ein keltischer Menhir, eine Stele aus Buntsandstein, die in der Hallstattzeit einen Grabhügel gekrönt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f916d2ad-40b0-3efa-8e16-ec6f4e538947",
                                        "entry_id": "b43a1c20-113a-389f-9dd7-dad1fc68d87b",
                                        "glosses": [
                                            "Leitbündelstrang im Spross, Blatt oder in der Wurzel von Pflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28009fd1-1065-4541-b365-8664207b80d8",
                                                "sense_id": "f916d2ad-40b0-3efa-8e16-ec6f4e538947",
                                                "text": "Nach der Stelärtheorie lassen sich die unterschiedlichen Typen der Stele auf einen gemeinsamen stammesgeschichtlichen Ursprung zurückführen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7ba792e-46f4-496d-a1ed-f91f3631a9fd",
                        "source_entry_id": "685059a1-04ce-3edb-a75b-13adf48fdf79",
                        "target_lang_word": "Gedenkstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gedenkstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33f81e36-8f03-39d7-9fae-a083f15ff5e8",
                                        "entry_id": "61830336-82e9-3de8-9d3c-ac1b11118bc4",
                                        "glosses": [
                                            "gestalteter und öffentlich aufgestellter Steinblock, der an etwas oder jemanden erinnert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af216aed-54ce-4e68-ae82-e1b304b0add1",
                                                "sense_id": "33f81e36-8f03-39d7-9fae-a083f15ff5e8",
                                                "text": "„Um 11:00 Uhr wurde am Hafen Strucklahnungshörn auf Nordstrand der Gedenkstein für die Seebestatteten von der Ideengeberin Rita Dethlefs im Beisein Ihres Chefs Sven Paulsen enthüllt.“"
                                            },
                                            {
                                                "example_id": "daec0421-d63a-4a3d-b755-2e85e194cd11",
                                                "sense_id": "33f81e36-8f03-39d7-9fae-a083f15ff5e8",
                                                "text": "„Erst sechs Jahre später wurde in Babij Jar ein kleiner Gedenkstein niedergelegt.“"
                                            },
                                            {
                                                "example_id": "431d4190-6841-4f1e-9f6e-8c3de4235c1e",
                                                "sense_id": "33f81e36-8f03-39d7-9fae-a083f15ff5e8",
                                                "text": "„Heute steht dort eine sowjetische Skulptur aus Beton, die den Gedenkstein des Briten ersetzt.“"
                                            },
                                            {
                                                "example_id": "3c80d353-c276-41fe-ab4c-95d3a0533607",
                                                "sense_id": "33f81e36-8f03-39d7-9fae-a083f15ff5e8",
                                                "text": "„Auf dem Weg zum Schiff entdecken wir an der Rheinpromenade einen Gedenkstein mit bronzener Platte für den großen französischen Romancier Victor Hugo, der auf seiner Rheinreise im Oktober 1840 die Stadt besuchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "840ed559-0d36-4aea-8aa0-7a6473016d83",
                        "source_entry_id": "685059a1-04ce-3edb-a75b-13adf48fdf79",
                        "target_lang_word": "Denkmalstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8eb45497-1385-458d-8a99-05f9ff3f54f3",
                        "source_entry_id": "685059a1-04ce-3edb-a75b-13adf48fdf79",
                        "target_lang_word": "stele",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stele",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                        "entry_id": "7d9de7b7-414e-3bc8-af3e-127c2048c7c8",
                                        "glosses": [
                                            "An upright (or formerly upright) slab containing engraved or painted decorations or inscriptions; a stela."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ce308c-3838-4c3f-b9d6-ca95f326e9f1",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "A superior class of members...had their names inscribed upon a marble stélé or column."
                                            },
                                            {
                                                "example_id": "09a3172a-a02b-4298-93a0-2eb42ce0e7c0",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "It appears, that when any one of the family died, a stelè to his memory was added to the tomb."
                                            },
                                            {
                                                "example_id": "43da9797-2922-4f17-aedb-2618b6db7dbf",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "In Egypt [obelisks] belonged to the class of steles (commemorative pillars)."
                                            },
                                            {
                                                "example_id": "78f9efde-9526-4f63-b500-252948753f8a",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "The Australian stele, or grave-pillar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c6e1bd3-581b-3c63-b5f9-efdcefb2cd2f",
                                        "entry_id": "7d9de7b7-414e-3bc8-af3e-127c2048c7c8",
                                        "glosses": [
                                            "Any carved or engraved surface."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4dce9ca-8cb3-4a72-adc6-1217fb74088c",
                                                "sense_id": "0c6e1bd3-581b-3c63-b5f9-efdcefb2cd2f",
                                                "text": "Two large hieroglyphed steles incised upon the face of a projecting mass of boldly rounded cliff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87630c59-8488-30b1-be2c-c8a6607a93ab",
                                        "entry_id": "7d9de7b7-414e-3bc8-af3e-127c2048c7c8",
                                        "glosses": [
                                            "An acroterion, the decoration on the ridge of an ancient Greek building such as a temple."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eefa58c3-9ecf-49a9-9f69-9579d03488cb",
                                                "sense_id": "87630c59-8488-30b1-be2c-c8a6607a93ab",
                                                "text": "Stele. The ornaments on the ridge of a Greek temple, answering to the antefixæ on the summit of the flank entablatures, are thus designated."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stele",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59b893d1-2d15-33c5-847e-40e795020ac1",
                                        "entry_id": "a2183909-be66-32b5-bc4a-72f39d592351",
                                        "glosses": [
                                            "The central core of a plant's root and stem system, especially including the vascular tissue and developed from the plerome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe1e953-a7cc-4ffc-9839-6bfdc6f37fcd",
                                                "sense_id": "59b893d1-2d15-33c5-847e-40e795020ac1",
                                                "text": "The stele may have—in different structures—one to many protoxylem (primitive wood) groups, and is accordingly described as monarch...diarch...triarch...tetrarch...polyarch."
                                            },
                                            {
                                                "example_id": "ee915523-5cad-4b1b-927d-016ff41aa83b",
                                                "sense_id": "59b893d1-2d15-33c5-847e-40e795020ac1",
                                                "text": "The so-called central cylinder, for which Van Tieghem has proposed the name stele (column)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
