        "de-extract.jsonl": [
            {
                "entry_id": "ff30d699-d4c5-3089-b989-3ce5203deeab",
                "word": "athénée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c7454b33-c15e-323b-bd1d-e99cb1732f3b",
                        "entry_id": "ff30d699-d4c5-3089-b989-3ce5203deeab",
                        "glosses": [
                            "Athenäum, Gymnasium"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a325a33f-b767-48ac-a960-b4c6ca54d73a",
                        "source_entry_id": "ff30d699-d4c5-3089-b989-3ce5203deeab",
                        "source_sense_id": "c7454b33-c15e-323b-bd1d-e99cb1732f3b",
                        "source_sense_description": "Athenäum, Gymnasium",
                        "target_lang_word": "Athenäum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Athenäum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24180427-a599-391f-bb06-c9978dc585ac",
                                        "entry_id": "de1a9c2c-4e89-3e72-b5f9-3cd3a480d7d6",
                                        "glosses": [
                                            "der Göttin Athene geweihter Tempel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3789d1d5-40a8-4925-8d8a-0f185289b479",
                                                "sense_id": "24180427-a599-391f-bb06-c9978dc585ac",
                                                "text": "Das Athenäum war ein prächtiger Bau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                        "entry_id": "de1a9c2c-4e89-3e72-b5f9-3cd3a480d7d6",
                                        "glosses": [
                                            "Form einer weiterführenden Schule (insbesondere in Belgien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e6000e-cdad-4e4f-8d67-393d180a653f",
                                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                                "text": "„In der Mensa des Athenäums in Eupen ist ausreichend Platz für die rund ein Dutzend Familien, die das Angebot wahrnehmen.“"
                                            },
                                            {
                                                "example_id": "382e2c02-7fe8-4b63-87e9-baa418f7ee6f",
                                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                                "text": "„Das Institut für Weiterbildung im César-Franck-Athenäum Kelmis bietet Abendkurse für Erwachsene.“"
                                            },
                                            {
                                                "example_id": "86b63211-a69f-418b-b461-92122d3b6ae9",
                                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                                "text": "„Im Königlichen Athenäum in Eupen wird in ausgewählten Klassen des ersten und zweiten Jahres eine unkonventionelle Unterrichtsform angewandt.“"
                                            },
                                            {
                                                "example_id": "cf62535f-1480-4561-b608-7dc30bf8b801",
                                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                                "text": "„Seine Mutter Rosalia, die sich als Haushälterin bei begüterten Leuten verdingte, war aber von der Begabung ihres Sohnes überzeugt und erreichte für ihn einen Studienplatz im Königlichen Athenäum, einer staatlichen Schule.“"
                                            },
                                            {
                                                "example_id": "4638fd77-6e8e-46ad-bdcc-a0827e970898",
                                                "sense_id": "fd121807-549e-34fb-b2b3-f03abaf2d798",
                                                "text": "„Nachdem die Familie an die belgische Seeküste umgesiedelt war, studierte René am Königlichen Athenäum in Brügge, wo er 1939 als Primus seiner Klasse die Schullaufbahn beendete."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78a3181f-7675-42b6-a191-1eae0b6ea856",
                        "source_entry_id": "ff30d699-d4c5-3089-b989-3ce5203deeab",
                        "source_sense_id": "c7454b33-c15e-323b-bd1d-e99cb1732f3b",
                        "source_sense_description": "Athenäum, Gymnasium",
                        "target_lang_word": "Gymnasium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gymnasium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a57b0b2c-a750-382a-a4d6-b661f08d9f84",
                                        "entry_id": "3a15d3ed-7c39-3af9-a0c2-dd2486b95351",
                                        "glosses": [
                                            "weiterführende Schule mit dem Abitur (bzw. der Matura) als Abschluss"
                                        ],
                                        "tags": [
                                            "Ausbildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a250e7b-6989-426d-b76e-dd73749e80d8",
                                                "sense_id": "a57b0b2c-a750-382a-a4d6-b661f08d9f84",
                                                "text": "Nach der Grundschule besuche ich das Gymnasium, um ein Abitur zu bekommen."
                                            },
                                            {
                                                "example_id": "a6a77766-156c-4843-9179-6a5f75f94663",
                                                "sense_id": "a57b0b2c-a750-382a-a4d6-b661f08d9f84",
                                                "text": "„Die Poesie als Dienerin der Beredsamkeit: dies war auch der didaktische Grundsatz von Christian Weise, der als Rektor des Gymnasiums zu Zittau und als Verfasser von Schauspielen, Romanen und zahlreichen Lehrbüchern gleichzeitig mit Thomasius und vielleicht wirkungsvoller noch als dieser der deutschen Stilbildung im 18. Jahrhundert den Weg gewiesen hat.“"
                                            },
                                            {
                                                "example_id": "0788defa-e5f9-4322-a791-90836a298eb4",
                                                "sense_id": "a57b0b2c-a750-382a-a4d6-b661f08d9f84",
                                                "text": "„Die Kriegsteilnehmer des Gymnasiums haben es besser gehabt.“"
                                            },
                                            {
                                                "example_id": "c6a0c0a1-5264-4064-a303-3f8748be1a4b",
                                                "sense_id": "a57b0b2c-a750-382a-a4d6-b661f08d9f84",
                                                "text": "„Im Zweifel werden Einwandererkinder auf die Hauptschule geschickt, obwohl sie es auch auf der Realschule oder auf dem Gymnasium schaffen könnten.“"
                                            },
                                            {
                                                "example_id": "c75037af-823b-44c8-823a-c480bf10ef45",
                                                "sense_id": "a57b0b2c-a750-382a-a4d6-b661f08d9f84",
                                                "text": "„Schickt man ernsthaft sein Kind an ein [privates] bilinguales Gymnasium mit Segeln als Schulsport und zahlt 200 Euro Schulgeld im Monat - einfach nur weil der Schulweg kürzer ist? Hält [die SPD-Ministerpräsidentin Mecklenburg-Vorpommerns Manuela] Schwesig die Leute für so blöd, das zu glauben? …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fee654f2-3831-3fec-a1c7-4820cab62ca1",
                                        "entry_id": "3a15d3ed-7c39-3af9-a0c2-dd2486b95351",
                                        "glosses": [
                                            "Gebäude, in dem sich [1] befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cfaa53-c219-422b-8d69-45e1caeaebd2",
                                                "sense_id": "fee654f2-3831-3fec-a1c7-4820cab62ca1",
                                                "text": "Das Gymnasium wird dieses Jahr komplett saniert und verschönert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1147621-3f6a-396e-8552-8d29d5b0aecd",
                                        "entry_id": "3a15d3ed-7c39-3af9-a0c2-dd2486b95351",
                                        "glosses": [
                                            "Übungs- und Wettkampfanlage, die der Jugend zur körperlichen Ertüchtigung dient"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e093c88-f583-49b9-a610-1c592f6a960f",
                                                "sense_id": "b1147621-3f6a-396e-8552-8d29d5b0aecd",
                                                "text": "„An dieses größere Gymnasium schließt sich ein kleineres ummauertes an, welches von seiner Gestalt das Viereck heißt. Hier befinden sich Uebungsplätze für die Ringer, in welchen sich die Athleten, wenn sie mit den Ringübungen zu Ende sind, noch im Faustkampfe mit den weicheren Handriemen üben.“ (1854)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
