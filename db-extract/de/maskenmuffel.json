                "senses": [
                    {
                        "sense_id": "f264f610-4c24-3a00-83fe-b36f99bf23cc",
                        "entry_id": "e6586c30-8167-30bf-8a1c-d64d55534775",
                        "glosses": [
                            "jemand, der keine oder nur ungern eine Maske (zu einem bestimmten Anlass wie Karneval, Maskenball oder Ähnlichem) trägt; jemand, der den vorgeschriebenen Mund-Nasen-Schutz/Mund-Nasen-Maske (Alltagsmaske, Klinikmaske oder sonstiger Schutzmasken) gar nicht oder nur ungern trägt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a24c4294-38b8-4af9-9743-abf87aada7dd",
                                "sense_id": "f264f610-4c24-3a00-83fe-b36f99bf23cc",
                                "text": "„Karneval im Sommer? […] Für Maskierte ist der Eintritt frei, Maskenmuffel zahlen 50 Schilling.“"
                            },
                            {
                                "example_id": "e13d3d75-161f-4c45-9131-fcf18ed3ba90",
                                "sense_id": "f264f610-4c24-3a00-83fe-b36f99bf23cc",
                                "text": "„Wer am Neumarkt ohne Schutzmaske angetroffen wird, müsse notfalls mit einem Bußgeld bewegt werden, Vorsorge für seine eigene Gesundheit zu treffen. Das OS-Team habe deshalb Anweisung bekommen, Maskenmuffel mit 10 Euro zur Kasse zu bitten.“"
                            },
                            {
                                "example_id": "7b0bb5fe-1bd5-42ad-9352-95db0b2092c3",
                                "sense_id": "f264f610-4c24-3a00-83fe-b36f99bf23cc",
                                "text": "„In den vergangenen Wochen konnte man den Eindruck gewinnen, dass es immer mehr Maskenmuffel gibt – auch wenn sich die Mehrheit noch an die Maskenpflicht in Bussen, Bahnen, Geschäften und Innenräumen hält.“"
                            },
                            {
                                "example_id": "86bad7e8-ab51-4aa9-8be8-c853e30940dc",
                                "sense_id": "f264f610-4c24-3a00-83fe-b36f99bf23cc",
                                "text": "„‚Maskenmuffel‘ in Berliner Bussen und der U-Bahn müssen nunmehr gleich doppelt mit Strafe rechnen.“"
                            },
                            {
                                "example_id": "dc9494a7-5bee-455f-a4fe-c234a65cb940",
                                "sense_id": "f264f610-4c24-3a00-83fe-b36f99bf23cc",
                                "text": "„Maskenmuffel trifft man in Stuttgart überall – es beginnt gleich morgens in der Stadtbahn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
