                                "target_lang_word": "estupendo",
                                "target_lang_sense_clarification": "bueno, agradable"
                            },
                            {
                                "target_lang_word": "bien",
                                "target_lang_sense_clarification": "correcto o aceptable"
                            }
                        ]
