                                "target_senses": [
                                    {
                                        "sense_id": "6e243f97-3351-367e-937e-2df9898d5bd7",
                                        "entry_id": "4779f29d-f552-337d-b033-dac4eeaa8140",
                                        "glosses": [
                                            "Of or pertaining to ejaculation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90dda84c-a128-4f85-813b-ee9fdd84dd01",
                                                "sense_id": "6e243f97-3351-367e-937e-2df9898d5bd7",
                                                "text": "No differences were found in the mounting behavior of anogenitally stimulated females and their controls, and none of the females showed the ejaculatory response."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bac122a-0c25-3c58-8def-ca8f60b1b7a5",
                                        "entry_id": "4779f29d-f552-337d-b033-dac4eeaa8140",
                                        "glosses": [
                                            "Of speech, exclamatory."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a5147e-ccd4-47a3-92c9-19c1aa1eeaba",
                                                "sense_id": "5bac122a-0c25-3c58-8def-ca8f60b1b7a5",
                                                "text": "There his story became ejaculatory."
                                            },
                                            {
                                                "example_id": "798c477d-1fa3-4f43-bee7-a258af4f028d",
                                                "sense_id": "5bac122a-0c25-3c58-8def-ca8f60b1b7a5",
                                                "text": "By one token in particular you may tell every member of the tribe. It is the token of the ejaculatory comment."
                                            }
                                        ]
