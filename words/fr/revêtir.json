    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85f54b81-6b66-3855-864b-96098773636c",
                    "sense_definition": "Prendre ou présenter un aspect, une forme, une qualité ou une portée particulière.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision politique <w>revêt</w> une importance capitale pour l'avenir de toute la région."
                        },
                        {
                            "text": "Le conflit a fini par <w>revêtir</w> une dimension internationale inattendue au fil des semaines."
                        }
                    ],
                    "synonyms": [
                        "prendre",
                        "présenter"
                    ],
                    "common_phrases": [
                        "revêtir une importance",
                        "revêtir une forme"
                    ]
                },
                {
                    "sense_id": "2386e40e-2933-338e-b414-5484ab94a0f1",
                    "sense_definition": "Mettre sur soi un habit, en particulier un vêtement officiel, solennel ou distinctif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "habillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a soigneusement <w>revêtu</w> sa toge noire avant d'entrer dans la salle d'audience."
                        },
                        {
                            "text": "Pour la cérémonie officielle, les délégués <w>revêtent</w> leur tenue traditionnelle d'apparat."
                        }
                    ],
                    "synonyms": [
                        "endosser",
                        "enfiler",
                        "porter"
                    ],
                    "antonyms": [
                        "quitter",
                        "ôter"
                    ],
                    "common_phrases": [
                        "revêtir une toge"
                    ]
                },
                {
                    "sense_id": "2ab738b0-6ed7-3875-8e61-9ae7ce17ec1b",
                    "sense_definition": "Recouvrir une surface ou un ouvrage d'une matière protectrice ou décorative.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recouvrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers vont <w>revêtir</w> les murs de la cuisine d'un carrelage imperméable."
                        },
                        {
                            "text": "On a <w>revêtu</w> le sol de parquet massif dans toutes les chambres de l'appartement."
                        }
                    ],
                    "synonyms": [
                        "recouvrir",
                        "doubler",
                        "garnir"
                    ],
                    "antonyms": [
                        "dégarnir",
                        "dénuder"
                    ],
                    "common_phrases": [
                        "revêtir de marbre"
                    ]
                },
                {
                    "sense_id": "a8b6360b-7079-3825-9627-b2ad97dd6c9e",
                    "sense_definition": "Investir quelqu'un d'un pouvoir, d'une autorité, d'une fonction ou d'une dignité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parlement a <w>revêtu</w> le Premier ministre des pleins pouvoirs pour gérer la crise."
                        },
                        {
                            "text": "Il est désormais <w>revêtu</w> de l'autorité nécessaire pour signer ces accords diplomatiques majeurs."
                        }
                    ],
                    "synonyms": [
                        "investir",
                        "pourvoir"
                    ],
                    "antonyms": [
                        "destituer",
                        "dépouiller"
                    ],
                    "common_phrases": [
                        "revêtu d'une autorité",
                        "revêtu des pouvoirs"
                    ]
                }
            ]
        }
    ]
}