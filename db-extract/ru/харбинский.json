                                        "glosses": [
                                            "związany z Harbinem, dotyczący Harbinu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b46e776f-084a-437f-bcd1-079c3dabc9d8",
                                                "sense_id": "710eb03d-6cf8-3c2f-b57b-1f2eb3cfc58e",
                                                "text": "Wybuch wojny przekreślił realizację nakreślonych planów i księża chrystusowcy nigdy nie objęli harbińskiej placówki"
                                            }
