{
    "word_family": [
        "naivety",
        "naively",
        "naiveness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5c9f51e-a170-3691-86d2-cc2299fb396f",
                    "sense_definition": "Lacking worldly experience, wisdom, or judgement; unsophisticated.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would be <w>naive</w> to think that such a complex problem has a simple solution.",
                            "target_lang_translations": {
                                "ru": "Было бы <w>наивно</w> полагать, что у такой сложной проблемы есть простое решение.",
                                "zh": "认为如此复杂的问题会有简单的解决方法，这太<w>天真</w>了。"
                            }
                        },
                        {
                            "text": "She had a <w>naive</w> belief that everyone she met was kind and honest.",
                            "target_lang_translations": {
                                "ru": "У неё была <w>наивная</w> вера в то, что все, кого она встречала, были добрыми и честными.",
                                "zh": "她有一种<w>单纯</w>的信念，认为她遇到的每个人都是善良且诚实的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unsophisticated",
                        "innocent",
                        "artless",
                        "guileless",
                        "credulous",
                        "green",
                        "unworldly",
                        "simple",
                        "childlike",
                        "clueless"
                    ],
                    "antonyms": [
                        "sophisticated",
                        "worldly",
                        "wily",
                        "mature"
                    ],
                    "common_phrases": [
                        "naive assumption",
                        "politically naive",
                        "naive view",
                        "somewhat naive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий жизненного опыта, мудрости или рассудительности; простодушный.",
                        "zh": "缺乏社会经验、智慧或判断力；天真、单纯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наивный",
                                "target_lang_sense_clarification": "неопытный, доверчивый"
                            },
                            {
                                "target_lang_word": "простодушный",
                                "target_lang_sense_clarification": "открытый, бесхитростный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天真",
                                "target_lang_sense_clarification": "形容人单纯、缺乏经验"
                            },
                            {
                                "target_lang_word": "单纯",
                                "target_lang_sense_clarification": "形容人思想简单、不复杂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19d155be-1e51-3997-b088-fc18131a6d74",
                    "sense_definition": "Produced in a simple, childlike style, deliberately rejecting sophisticated techniques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum is famous for its collection of <w>naive</w> art from the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Музей славится своей коллекцией <w>наивного</w> искусства начала двадцатого века.",
                                "zh": "这家博物馆以其收藏的二十世纪初的<w>稚拙</w>艺术作品而闻名。"
                            }
                        },
                        {
                            "text": "He paints in a <w>naive</w> style that uses bright colors and ignores traditional perspective.",
                            "target_lang_translations": {
                                "ru": "Он пишет в <w>наивном</w> стиле, используя яркие цвета и игнорируя традиционную перспективу.",
                                "zh": "他的画风<w>稚拙</w>，喜欢使用明亮的色彩，且不讲究传统的透视法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "simple",
                        "childlike",
                        "unpretentious",
                        "artless"
                    ],
                    "antonyms": [
                        "sophisticated",
                        "pretentious",
                        "affected"
                    ],
                    "common_phrases": [
                        "naive art",
                        "naive painter",
                        "naive style"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (art)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполненный в простом, детском стиле, намеренно отвергающий сложные техники (об искусстве).",
                        "zh": "指艺术创作中风格简单、稚拙，刻意摒弃复杂技巧的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наивный",
                                "target_lang_sense_clarification": "относящийся к наивному искусству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稚拙",
                                "target_lang_sense_clarification": "形容艺术风格简单、像儿童画"
                            },
                            {
                                "target_lang_word": "原始主义",
                                "target_lang_sense_clarification": "艺术流派中的一种风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc87b86a-fdd7-3ed2-8eac-9254dcc421fd",
                    "sense_definition": "Not having been exposed to something, often used in medical or scientific contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study required <w>naive</w> subjects who had never taken the medication before.",
                            "target_lang_translations": {
                                "ru": "Для исследования требовались <w>ранее не лечившиеся</w> испытуемые, которые никогда раньше не принимали этот препарат.",
                                "zh": "这项研究需要从未服用过该药物的<w>未受过治疗的</w>受试者。"
                            }
                        },
                        {
                            "text": "Because the population was immunologically <w>naive</w>, the virus spread rapidly.",
                            "target_lang_translations": {
                                "ru": "Поскольку популяция была иммунологически <w>наивной</w>, вирус распространялся быстро.",
                                "zh": "由于该人群对病毒<w>初次接触</w>，缺乏免疫力，病毒传播得非常快。"
                            }
                        }
                    ],
                    "synonyms": [
                        "untested",
                        "virgin"
                    ],
                    "common_phrases": [
                        "immunologically naive",
                        "naive patient",
                        "naive subject"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (medicine/biology)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подвергавшийся ранее воздействию чего-либо (обычно о пациентах или организмах в медицине).",
                        "zh": "指未曾接触过某事物，常用于医学或科学领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наивный",
                                "target_lang_sense_clarification": "мед. термин: ранее не леченный, интактный"
                            },
                            {
                                "target_lang_word": "нелеченный",
                                "target_lang_sense_clarification": "не получавший терапии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未受过治疗的",
                                "target_lang_sense_clarification": "医学上指未接受过特定药物或疗法"
                            },
                            {
                                "target_lang_word": "初次接触的",
                                "target_lang_sense_clarification": "指生物体对某种病原体无免疫力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16a603de-209e-3add-b108-a60a7b20a4fc",
                    "sense_definition": "Intuitive; designed to follow the way ordinary people approach a problem.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>naive</w> algorithm is often easy to write but may not be the most efficient solution.",
                            "target_lang_translations": {
                                "ru": "<w>Наивный</w> алгоритм часто легко написать, но он может быть не самым эффективным решением.",
                                "zh": "一种<w>朴素</w>的算法通常很容易编写，但可能不是最高效的解决方案。"
                            }
                        },
                        {
                            "text": "We compared the optimized method against a <w>naive</w> approach to see the performance difference.",
                            "target_lang_translations": {
                                "ru": "Мы сравнили оптимизированный метод с <w>наивным</w> подходом, чтобы увидеть разницу в производительности.",
                                "zh": "我们将优化后的方法与一种<w>朴素</w>的方法进行了对比，以观察性能差异。"
                            }
                        }
                    ],
                    "synonyms": [
                        "simple"
                    ],
                    "antonyms": [
                        "sophisticated"
                    ],
                    "common_phrases": [
                        "naive algorithm",
                        "naive approach",
                        "naive solution"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (computing)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Интуитивный; основанный на простом, обывательском подходе к проблеме (в информатике).",
                        "zh": "指算法或方法简单、直观，未经过复杂优化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наивный",
                                "target_lang_sense_clarification": "простой, прямолинейный (об алгоритмах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朴素",
                                "target_lang_sense_clarification": "计算机科学中指最直接、简单的算法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc0679e2-d3b8-338e-a6d7-e7436f8385a2",
                    "sense_definition": "A naive person; a greenhorn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is full of <w>naives</w> who arrive with big dreams and little money.",
                            "target_lang_translations": {
                                "ru": "Город полон <w>простаков</w>, которые приезжают с большими мечтами и малым количеством денег.",
                                "zh": "这座城市里满是怀揣梦想却身无分文的<w>单纯的人</w>。"
                            }
                        },
                        {
                            "text": "He realized he was just one of many <w>naives</w> that the scammer had targeted.",
                            "target_lang_translations": {
                                "ru": "Он понял, что был лишь одним из многих <w>наивных людей</w>, на которых нацелился мошенник.",
                                "zh": "他意识到自己只是骗子盯上的众多<w>老实人</w>之一。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наивный человек; новичок, которого легко обмануть.",
                        "zh": "指天真、容易受骗的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простак",
                                "target_lang_sense_clarification": "наивный, доверчивый человек"
                            },
                            {
                                "target_lang_word": "наивная душа",
                                "target_lang_sense_clarification": "разговорное выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单纯的人",
                                "target_lang_sense_clarification": "指缺乏社会经验的人"
                            },
                            {
                                "target_lang_word": "老实人",
                                "target_lang_sense_clarification": "指容易被利用的诚实人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}