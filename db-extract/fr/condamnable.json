                ],
                "senses": [
                    {
                        "sense_id": "ae5ec2ae-fae8-36f4-85b5-abb3fe29c114",
                        "entry_id": "6210210c-49fd-3dd3-a56d-6d6ad8220061",
                        "glosses": [
                            "Qui mérite d’être condamné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3042dbbd-ab9c-455b-8a6a-746b23cd13e2",
                                "sense_id": "ae5ec2ae-fae8-36f4-85b5-abb3fe29c114",
                                "text": "Action, opinion, maxime condamnable. Il est condamnable dans sa conduite."
                            },
                            {
                                "example_id": "d185be6e-49ef-4333-a12c-7eadbaf3c73d",
                                "sense_id": "ae5ec2ae-fae8-36f4-85b5-abb3fe29c114",
                                "text": "L’affaire, évidemment très condamnable, de son bodyguard particulier, amateur de baston et d’honneurs, qui a pris le melon en croyant avoir le gros bras très long, n’est pas pour autant une affaire d’État."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24efca9c-3377-41b1-88b9-842d57f30707",
                        "source_entry_id": "6210210c-49fd-3dd3-a56d-6d6ad8220061",
                        "source_sense_id": "ae5ec2ae-fae8-36f4-85b5-abb3fe29c114",
                        "target_lang_word": "condemnable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condemnable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3220f137-24b1-3b38-93e3-21eda7007a83",
                                        "entry_id": "8e1df932-87fa-365a-b7d9-04706b3e13ae",
                                        "glosses": [
                                            "Deserving of condemnation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50908677-a522-4c5e-a8e8-4c3a30ab7e02",
                                                "sense_id": "3220f137-24b1-3b38-93e3-21eda7007a83",
                                                "text": "It is not the fault of any creed, but of the complicated nature of human affairs, […] that hardly any kind of action can safely be laid down as either always obligatory or always condemnable."
                                            },
                                            {
                                                "example_id": "d15928da-3625-413b-9a16-10aec5f2b2b1",
                                                "sense_id": "3220f137-24b1-3b38-93e3-21eda7007a83",
                                                "text": "He’s got the one issue that’s utterly condemnable, but he was really quite open."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
