                ],
                "senses": [
                    {
                        "sense_id": "3a3b3a12-39f8-3c70-9758-8c50a416945b",
                        "entry_id": "48cf1062-0c9b-3655-8665-6c1ac05ba9f9",
                        "glosses": [
                            "устар. почувствовать сильный голод, очень захотеть есть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2423b402-ad93-4942-a3c7-5fe8b92fa7bf",
                                "sense_id": "3a3b3a12-39f8-3c70-9758-8c50a416945b",
                                "text": "И, постившись сорок дней и сорок ночей, напоследок взалкал."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cfd8120-0b78-33cc-96ec-0479ceabd93a",
                        "entry_id": "48cf1062-0c9b-3655-8665-6c1ac05ba9f9",
                        "glosses": [
                            "перен., поэт. страстно захотеть чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245ce7c6-2795-495f-8d34-687d3fcbc186",
                                "sense_id": "2cfd8120-0b78-33cc-96ec-0479ceabd93a",
                                "text": "Взалкал отец Федор. Захотелось ему богатства. Понесло его по России за гарнитуром генеральши Поповой, в котором, надо признаться, ни черта нет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c45f5ff8-f5da-451e-9733-e7628f18be4b",
                        "source_entry_id": "48cf1062-0c9b-3655-8665-6c1ac05ba9f9",
                        "target_lang_word": "hunger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7bbec11-c6c0-3118-8ede-bbe2e18011e8",
                                        "entry_id": "0bbacaf7-adc1-3c7d-b8c5-7cb981de7653",
                                        "glosses": [
                                            "A need or compelling desire for food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6799d3c6-5c05-3939-ab13-57d07c0e6a86",
                                        "entry_id": "0bbacaf7-adc1-3c7d-b8c5-7cb981de7653",
                                        "glosses": [
                                            "Any strong desire or need."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2673c562-0af0-418f-b9ab-74f5665a71f1",
                                                "sense_id": "6799d3c6-5c05-3939-ab13-57d07c0e6a86",
                                                "text": "I have a hunger to win."
                                            },
                                            {
                                                "example_id": "90bee9ca-99d5-46a9-89e3-4fd7d0926b26",
                                                "sense_id": "6799d3c6-5c05-3939-ab13-57d07c0e6a86",
                                                "text": "O sacred hunger of ambitious minds!"
                                            },
                                            {
                                                "example_id": "874e8660-f54d-4cda-aac6-550bde8f1022",
                                                "sense_id": "6799d3c6-5c05-3939-ab13-57d07c0e6a86",
                                                "text": "When gangsters bump my shit, can they feel my hunger?"
                                            },
                                            {
                                                "example_id": "4db9976a-b9c9-4d8c-9f49-3ca66830313f",
                                                "sense_id": "6799d3c6-5c05-3939-ab13-57d07c0e6a86",
                                                "text": "Putin's unwillingness to declare another partial reserve call up has created a wider manpower hunger in the Russian military and border service, and Putin alone maintains the ability to remedy this issue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hunger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a809396-c2ad-3e0e-8c5f-86b87576f8b2",
                                        "entry_id": "fe5099c7-235a-37d7-abe8-6b0e9d35fc71",
                                        "glosses": [
                                            "To be in need of food."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2602ae-61c0-45e4-9dab-c4b1d9889b7d",
                                                "sense_id": "9a809396-c2ad-3e0e-8c5f-86b87576f8b2",
                                                "text": "Therefore if thine enemie hunger, feed him: if he thirst, giue him drink. For in so doing thou shalt heape coales of fire on his head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c9a1e71-9f3d-3c67-addd-db2f6d49eae5",
                                        "entry_id": "fe5099c7-235a-37d7-abe8-6b0e9d35fc71",
                                        "glosses": [
                                            "To have a desire (for); to long; to yearn."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8829649-f3f1-4cb6-bc9f-ffc9894016c3",
                                                "sense_id": "5c9a1e71-9f3d-3c67-addd-db2f6d49eae5",
                                                "text": "I hungered for your love."
                                            },
                                            {
                                                "example_id": "bde34caa-87a7-4b8e-810b-b22c6d602956",
                                                "sense_id": "5c9a1e71-9f3d-3c67-addd-db2f6d49eae5",
                                                "text": "Blessed are they which doe hunger and thirst after righteousnesse: for they shall be filled."
                                            },
                                            {
                                                "example_id": "89446185-16e8-4731-8c50-9aeca8ef8b02",
                                                "sense_id": "5c9a1e71-9f3d-3c67-addd-db2f6d49eae5",
                                                "text": "In our lives we hunger for those we cannot touch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f069c46-514e-3293-b738-8bbfa1c36a16",
                                        "entry_id": "fe5099c7-235a-37d7-abe8-6b0e9d35fc71",
                                        "glosses": [
                                            "To make hungry; to famish."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
