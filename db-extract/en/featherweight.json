                    {
                        "sense_id": "7be5a5bb-6cb9-33bd-a311-4afea6b384dc",
                        "entry_id": "b77b1db0-2508-396a-9b69-06646c2337a4",
                        "glosses": [
                            "A weight class in many combat sports; e.g. in professional boxing of a maximum of 126 pounds or 57.2 kilograms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b4cd34-e91e-4037-be32-f32cf2915348",
                                "sense_id": "7be5a5bb-6cb9-33bd-a311-4afea6b384dc",
                                "text": "Safety and fairness in female sport was one of the most prominent topics at this summer’s Olympic Games, where boxers Imane Khelif and Lin Yu Ting took gold in the women’s welterweight and featherweight categories respectively."
                            }
                        ]
                    },
                    {
                        "sense_id": "7003cc39-3ae6-3be0-8ed0-fd5b1b180c9c",
                        "entry_id": "b77b1db0-2508-396a-9b69-06646c2337a4",
                        "glosses": [
                            "A sportsman who fights in this division."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5404e2bf-ad64-4f35-a3a9-c191a7db24b6",
                                "sense_id": "7003cc39-3ae6-3be0-8ed0-fd5b1b180c9c",
                                "text": "Watson specializes in adiposeness; none of his chorus beauties may be considered featherweights."
                            }
                        ]
                    },
                    {
                        "sense_id": "46cbd20a-4be3-3768-87d5-9473cc9648fc",
                        "entry_id": "b77b1db0-2508-396a-9b69-06646c2337a4",
                        "glosses": [
                            "The lightest weight that may be carried by a racehorse."
                        ],
                        "tags": [],
                        "examples": []
                    }
