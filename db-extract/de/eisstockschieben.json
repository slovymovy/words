                "senses": [
                    {
                        "sense_id": "a7d2958e-1be1-355e-871d-8f8d3d7cf3a8",
                        "entry_id": "082d922d-59a5-348f-a12f-50234b6d6d6f",
                        "glosses": [
                            "alpenländischer Volkssport auf einer Eisfläche, bei dem zwei Mannschaften versuchen, ihre Eisstöcke möglichst nah an einem Ziel, der Daube, zu platzieren"
                        ],
                        "tags": [
                            "Wintersport"
                        ],
                        "examples": [
                            {
                                "example_id": "bd1069a1-a219-4b92-b4ee-022d9d14ec24",
                                "sense_id": "a7d2958e-1be1-355e-871d-8f8d3d7cf3a8",
                                "text": "„Besonders beim Eisstockschieben wurde so mancher Wintersportler schon beim Doping erwischt. In Filchendorf ist das nicht weiter schlimm, er lässt dann die anderen auch mal trinken und jeder hat dann wieder die gleichen Wettkampfbedingungen.“"
                            },
                            {
                                "example_id": "d105456e-5826-4c1b-9a6a-9f7e581260c8",
                                "sense_id": "a7d2958e-1be1-355e-871d-8f8d3d7cf3a8",
                                "text": "„[…] Eltern zogen ihren Nachwuchs auf Schlitten durch die Gegend und die reifere Generation frönte dem Eisstockschieben oder wärmte sich an einer der zahlreichen Feuertonnen auf.“"
                            },
                            {
                                "example_id": "65a26900-c19e-45ea-b92f-2c7fc50dbc5f",
                                "sense_id": "a7d2958e-1be1-355e-871d-8f8d3d7cf3a8",
                                "text": "„Der Jubilar ist rüstig und noch immer ausgesprochen sportlich. Er geht gerne Kegeln, Laufen oder Eisstockschieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
