                    }
                ],
                "senses": [
                    {
                        "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                        "entry_id": "1d3acfad-975c-3601-9850-e9601928d034",
                        "glosses": [
                            "amtlich angeordnete, polizeiliche Durchsuchung eines Gebäudes, einer Wohnung oder von Geschäftsräumen zur Sicherstellung von Gegenständen (zum Beispiel Beweismitteln) oder Auffinden von Tatverdächtigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fa6ae33-a77e-4c29-9310-9ca9c008a453",
                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                "text": "Bei deiner Hausdurchsuchung wurde ein halbes Kilo Kokain sichergestellt."
                            },
                            {
                                "example_id": "c11fc042-93e4-4fde-b396-d526ffb018b3",
                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                "text": "„Beide haben nach Hausdurchsuchungen in Klausen mit ihren Knechten, wie zwischen König Ferdinand dem Landesfürsten und Bischof Georg von Brixen vereinbart, noch das landesfürstliche Gufidaun durchsucht, sind dort in das Mesnerhaus eingedrungen und haben die drei festgenommen.“"
                            },
                            {
                                "example_id": "5b48a625-f7b2-4453-b684-04447ae39036",
                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                "text": "„Nicht nur sorgte sie sich um das Leben ihres steckbrieflich gesuchten Mannes, sondern sie musste auch eine Hausdurchsuchung der Polizei über sich ergehen lassen.“"
                            },
                            {
                                "example_id": "4ba56c3a-4c85-4a22-b9ab-bfe992e15aca",
                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                "text": "„Bei der Hausdurchsuchung fand ich nichts weiter als die erwartete Anzahl von Emailschüsseln, Nähmaschinen, antiseptischen Mitteln und einen Haufen zwei Jahre alter Berliner Modejournale.“"
                            },
                            {
                                "example_id": "3a8ca529-0aad-455c-8451-d50b04acc4fa",
                                "sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                                "text": "„Es gab Hausdurchsuchungen und Anklagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0d4d666-b069-4e53-9b49-796762bd299a",
                        "source_entry_id": "1d3acfad-975c-3601-9850-e9601928d034",
                        "source_sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                        "source_sense_description": "amtlich angeordnete, polizeiliche Durchsuchung",
                        "target_lang_word": "house search",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "764bec5f-aa12-4d77-9d7d-da581d7f796b",
                        "source_entry_id": "1d3acfad-975c-3601-9850-e9601928d034",
                        "source_sense_id": "141a33be-d120-3ab6-95f1-80176df7ed04",
                        "source_sense_description": "amtlich angeordnete, polizeiliche Durchsuchung",
                        "target_lang_word": "perquisition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perquisition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                                        "entry_id": "977cdb2b-d484-3f43-bc58-be13c720f92e",
                                        "glosses": [
                                            "Recherche exacte que l’on fait de quelque chose, de quelque personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a929c881-0b85-4ac9-9c38-4362f24f4ac0",
                                                "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                                                "text": "Alors, malgré l’inutilité de sa première perquisition, il en recommença une seconde"
                                            },
                                            {
                                                "example_id": "39dc3709-3841-4952-a7dc-9027b86a5715",
                                                "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                                                "text": "Personne ne croit plus que les chrétiens se réfugiaient dans des carrières souter­raines pour échapper aux perquisitions de la police ; les catacombes furent creusées, à très grands frais, par des communautés disposant d'importantes ressources."
                                            },
                                            {
                                                "example_id": "6fb65557-3099-456b-bef8-52d08415160c",
                                                "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                                                "text": "Une perquisition chez lui nous a permis de mettre la main sur un fax, deux fusils de chasse à canon scié, des munitions, un attirail pour la fabrication de bombes artisanales, des manuels pour la manipulation des explosifs, des tracts signés Abou Kalybse, et une liste recensant vingt-trois intellectuels dont huit cochés d’une croix parmi lesquels figurent le poète Jamal Armad, Sissane Miloud de la télé et l’homme de spectacle Aït Méziane…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
