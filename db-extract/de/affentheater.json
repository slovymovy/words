                "translations": [
                    {
                        "translation_id": "78c7ce4f-bc4d-4c48-b8df-57c1e96388c2",
                        "source_entry_id": "f9bc53ce-3cff-3a45-826f-856ea8ee321c",
                        "source_sense_id": "e24ee853-4ede-3aea-af94-574ef24af99b",
                        "source_sense_description": "in einem bestimmten Kontext als sinnlos, lästig, albern empfundenes Tun",
                        "target_lang_word": "charade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "345513fc-569d-3e14-a1d3-31d5ee79bd6f",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A genre of riddles where the clues to the answer are descriptions or puns on its syllables, with a final clue to the whole."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4600d201-2d49-4d00-b76a-a8bf6c10f134",
                                                "sense_id": "345513fc-569d-3e14-a1d3-31d5ee79bd6f",
                                                "text": "CHARADE, a trifling species of composition, or quasi-literary form of amusement, which may perhaps be best defined as a punning enigma propounded in a series of descriptions. A word is taken of two or more syllables, each forming a distinct word; each of these is described in verse or prose, as aptly and enigmatically as possible; and the same process is applied to the whole word. The neater and briefer the descriptive parts of the problem, the better the charade will be. In selecting words for charades, special attention should be paid to the absolute quality of the syllables composing them, inaccuracy in trifles of this sort depriving them of what little claim to merit they may possess. The brilliant rhythmic trifles of W. Mackworth Praed are well known. Of representative prose charades, the following specimens are perhaps as good as could be selected:—“My first, with the most rooted antipathy to a Frenchman, prides himself, whenever they meet, upon sticking close to his jacket; my second has many virtues, nor is its least that it gives its name to my first; my whole may I never catch!” “My first is company; my second shuns company; my third collects company; and my whole amuses company.” The solutions are Tar-tar and Co-nun-drum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69508b52-2de1-3b10-9bff-c439e295b90c",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A single round of the game charades, an acted form of the earlier riddles."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a1c0bf-2d56-4496-9470-048bbedd89b7",
                                                "sense_id": "69508b52-2de1-3b10-9bff-c439e295b90c",
                                                "text": "...The most popular form of this amusement is the acted charade, in which the meaning of the different syllables is acted out on the stage, the audience being left to guess each syllable and thus, combining the meaning of all the syllables, the whole word. A brilliant example of the acted charade is described in Thackeray’s Vanity Fair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc172070-af13-36c1-a0dc-2afdd1c548f0",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A play resembling the game charades, particularly due to poor acting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51c9e6c1-c544-3ca6-aef0-ee46f1673913",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A deception or pretense, originally an absurdly obvious one but now in general use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b98d2e-d2dd-493f-a812-d92ee9f55c1a",
                                                "sense_id": "51c9e6c1-c544-3ca6-aef0-ee46f1673913",
                                                "text": "This whole charade is absurd."
                                            },
                                            {
                                                "example_id": "fa3009f9-04f2-4752-b140-34d3b7a4e39b",
                                                "sense_id": "51c9e6c1-c544-3ca6-aef0-ee46f1673913",
                                                "text": "The woman lying dead in the morgue was the woman at the party. Well, Victor, maybe I'm missing something here. You call it fake, a charade… Do you mind telling me what kind of fuckin' charade ends up with somebody turning up dead?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A form of wordplay where several words are placed together to form a new word or part thereof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdffa613-3d43-4b50-b8b2-9f68b6c10ecb",
                                                "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                                "text": "Sometimes the tricks above may be used in combination: a homophone may come in two pieces like a charade (RAINBOW sounding like REIGN + BEAU) or a charade may be reversed (TACKLE having ELK + CAT backwards)."
                                            },
                                            {
                                                "example_id": "f2d0e968-56c3-434b-83ca-92e8b8edf6a3",
                                                "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                                "text": "Takes is a bit of a charade indicator here, telling you that one word takes on or adds on to another."
                                            },
                                            {
                                                "example_id": "01da1f92-b476-4724-a476-59a822ca19e6",
                                                "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                                "text": "Try solving the following clues. They are all charades, some of which use link words of the types described above."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "charade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                        "entry_id": "c6f8cca5-9e5c-347d-aa36-b507cca04795",
                                        "glosses": [
                                            "To act out a charade (of); to gesture; to pretend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012390de-f47a-4d06-a366-816e2472adbc",
                                                "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                                "text": "I'm not trying to say: let's try to get away from power rituals because power manifestation is a very important part of sex. It is when it takes the form of charading gay punishment, punishing one of our own in order to allow him a gay contact."
                                            },
                                            {
                                                "example_id": "f8657788-2cc8-4e93-aeb7-0c841d8da29e",
                                                "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                                "text": "She flaps her hands and arms, eyes glaring, head shaking – charading Non, non, NON!"
                                            },
                                            {
                                                "example_id": "8485bc10-8d87-476f-847f-40b4c2e85117",
                                                "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                                "text": "Private, wholesome family time could no longer charade as being either private or wholly wholesome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b70f9c19-ee04-4af1-859d-264d8b1c230f",
                        "source_entry_id": "f9bc53ce-3cff-3a45-826f-856ea8ee321c",
                        "source_sense_id": "e24ee853-4ede-3aea-af94-574ef24af99b",
                        "source_sense_description": "in einem bestimmten Kontext als sinnlos, lästig, albern empfundenes Tun",
                        "target_lang_word": "cirque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "defedcd3-95ac-3e79-801b-3f5378f12f06",
                                        "entry_id": "a3b1168f-9d8c-38e7-8c75-65975b91fb32",
                                        "glosses": [
                                            "Lieu destiné, chez les Romains, à accueillir les jeux publics, et particulièrement les diverses formes de lutte et les courses de chevaux et de chars."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5005ce5e-efca-4964-b9e9-875f30ece3b4",
                                                "sense_id": "defedcd3-95ac-3e79-801b-3f5378f12f06",
                                                "text": "Comment concilier la passion immodérée des Romains pour les combats du cirque, et l'infamie dont ils couvraient les instrumens de ces cruels spectacles, les arénaires, bestiaires, gladiateurs ?"
                                            },
                                            {
                                                "example_id": "908309d2-9486-49cd-a915-ed382eec9c0a",
                                                "sense_id": "defedcd3-95ac-3e79-801b-3f5378f12f06",
                                                "text": "Je ne suis pas seule en face du cirque abandonné, ils sont là, les spectateurs cruels et splendides, ils font passer en moi leur frénésie."
                                            },
                                            {
                                                "example_id": "f689001c-5355-49da-b2b5-785e77feb7e5",
                                                "sense_id": "defedcd3-95ac-3e79-801b-3f5378f12f06",
                                                "text": "Les cirques étaient ordinairement de forme ovale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6607fdd7-302a-3cb1-8a2d-104d8deec35c",
                                        "entry_id": "a3b1168f-9d8c-38e7-8c75-65975b91fb32",
                                        "glosses": [
                                            "Entreprise de spectacle qui organise des jeux et exercices de ce genre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4552b7f-038b-4736-9f16-8a78fa33266c",
                                                "sense_id": "6607fdd7-302a-3cb1-8a2d-104d8deec35c",
                                                "text": "Le maître du cirque de la barrière du Combat profitait des vacances de Pâques pour envoyer ses ours et ses dogues donner quelques représentations à Meaux. Toute cette ménagerie voyageait à pied."
                                            },
                                            {
                                                "example_id": "be2bd1a8-76a5-4d5a-b56b-ebc76c47dacb",
                                                "sense_id": "6607fdd7-302a-3cb1-8a2d-104d8deec35c",
                                                "text": "Peu d’années après sa création, le cirque fermé et couvert trouva le moyen de devenir nomade. La tente de toile ou « chapiteau » soutenue par un mât central, les gradins démontables, une enceinte formée de matériaux légers, ont permis au cirque de transporter son spectacle de ville en ville."
                                            },
                                            {
                                                "example_id": "ea1d9f0d-b70b-42f5-a028-8c02df664d65",
                                                "sense_id": "6607fdd7-302a-3cb1-8a2d-104d8deec35c",
                                                "text": "Il avait appartenu, en qualité de porteur, à une troupe d’acrobates de cirque, puis s’était entraîné au tapis, en vue d’un numéro de « flic-flac » avec rattrape sur les épaules."
                                            },
                                            {
                                                "example_id": "7547ce31-9676-4885-a761-1f71fb2bf489",
                                                "sense_id": "6607fdd7-302a-3cb1-8a2d-104d8deec35c",
                                                "text": "À Rochechouard, « Médrano », a rajeuni le cirque Fernando, et dans le souvenir du clown Boum-Boum, a trouvé un heureux déroulement de spectacle."
                                            },
                                            {
                                                "example_id": "d49dea23-cd10-41d9-b28f-55167b8c4ad5",
                                                "sense_id": "6607fdd7-302a-3cb1-8a2d-104d8deec35c",
                                                "text": "[…] les trompettes et les tambours du cirque couvraient les valses des chevaux de bois, et le crépitement des tirs scandait d’un pointillé sonore ce vacarme étourdissant et faux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2fc5a4a-fb07-393e-8be0-fb239f31905d",
                                        "entry_id": "a3b1168f-9d8c-38e7-8c75-65975b91fb32",
                                        "glosses": [
                                            "Bassin de montagnes disposé circulairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c33ac2-d61d-4c81-a382-80905347a6bd",
                                                "sense_id": "a2fc5a4a-fb07-393e-8be0-fb239f31905d",
                                                "text": "A nos pieds, dans un vaste cirque encadré de crêtes noires et déjà tout envahi par les ombres crépusculaires, apparaît une énorme agglomération de tentes grises, […]: la m’halla!"
                                            },
                                            {
                                                "example_id": "548b1121-7c72-419c-b9db-ea2ac0343d4c",
                                                "sense_id": "a2fc5a4a-fb07-393e-8be0-fb239f31905d",
                                                "text": "Les vallées sans rivières qui alvéolent le calcaire des Grands Fonds prenaient des aspects de cirques sélénites."
                                            },
                                            {
                                                "example_id": "789c9f9c-75b2-47e5-9431-71b60ebba0a0",
                                                "sense_id": "a2fc5a4a-fb07-393e-8be0-fb239f31905d",
                                                "text": "Elles sont dans un cirque, Olfrig, un volcan avec une seule issue appellée « le bûcher des géants »..."
                                            },
                                            {
                                                "example_id": "fde57b55-374f-41a7-8e80-92bb6612a896",
                                                "sense_id": "a2fc5a4a-fb07-393e-8be0-fb239f31905d",
                                                "text": "D'un rivage, contempler la mer à l'horizon; d'un village, regarder le cirque des sommets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "318dd9c3-85b0-3c72-9085-6c82fb2b320d",
                                        "entry_id": "a3b1168f-9d8c-38e7-8c75-65975b91fb32",
                                        "glosses": [
                                            "Situation chaotique ; désordre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1ffd02-1ce7-4782-bb21-e8160d23ee9c",
                                                "sense_id": "318dd9c3-85b0-3c72-9085-6c82fb2b320d",
                                                "text": "D’autres expressions sont moins flatteuses et l’on n'hésite pas, face à un désordre, à s’exclamer \"Quel cirque !\" alors que les dictionnaires les moins laxistes mettent à notre disposition des mots comme bazar, bordel ou merdier."
                                            },
                                            {
                                                "example_id": "fe57528b-eee4-48ce-8d2e-32418d62d8d5",
                                                "sense_id": "318dd9c3-85b0-3c72-9085-6c82fb2b320d",
                                                "text": "Quelques alcoolos faisaient un cirque vaseux. Les alcoolos m’emmerdent, ils ne sont jamais drôles."
                                            },
                                            {
                                                "example_id": "33b9e8ef-8225-48c5-bce8-627b5b984e9f",
                                                "sense_id": "318dd9c3-85b0-3c72-9085-6c82fb2b320d",
                                                "text": "À l’œil nu, en arrivant, il aurait pu risquer de tomber à la renverse en apercevant le cirque géant des Panzers-Divisions filant vers l'ouest."
                                            },
                                            {
                                                "example_id": "d4f7ede6-a77b-4282-9273-564b1dddfd31",
                                                "sense_id": "318dd9c3-85b0-3c72-9085-6c82fb2b320d",
                                                "text": "Les événements du 6 janvier et leurs suites ont révélé une fracture dans le Parti républicain et des divisions dans la droite qui devraient réconforter les démocrates et réjouir ceux et celles qui se désolent du cirque qu’est devenue la politique américaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a39b803a-4b54-3927-8ab4-8ef29bb80ffc",
                                        "entry_id": "a3b1168f-9d8c-38e7-8c75-65975b91fb32",
                                        "glosses": [
                                            "Comportement outrancier ; exagération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b7b23e-2661-4110-8574-fc75c31691e4",
                                                "sense_id": "a39b803a-4b54-3927-8ab4-8ef29bb80ffc",
                                                "text": "[…] D’ailleurs, il arrive aujourd’hui que le mot « cirque » soit remplacé par « psychodrame ». Autrement dit : arrête de faire des histoires, cesse d’amplifier les choses ! Qui fait un « cirque » ou un « psychodrame » est … un emmerdeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
