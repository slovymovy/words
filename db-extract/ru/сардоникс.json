                    },
                    {
                        "translation_id": "3ec2ec86-17c2-4266-9f72-aaccf409c46b",
                        "source_entry_id": "9552113d-f001-3ae4-b628-7ddee3fac709",
                        "source_sense_id": "a7fd2580-6557-362b-8b4a-d59359f30929",
                        "target_lang_word": "sardoine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sardoine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c86ded1-d4de-3328-b43d-3581f5832c4a",
                                        "entry_id": "79069fef-f659-3759-8b79-bc2c49c99c58",
                                        "glosses": [
                                            "Sorte d’agate, d’une couleur brune, avec des reflets orangés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e475354-d778-4d08-8ba1-b360e58cd94c",
                                                "sense_id": "2c86ded1-d4de-3328-b43d-3581f5832c4a",
                                                "text": "Anne lui apparut plus belle que de coutume, belle de la beauté de ces sardoines afghanes qui, parvenues à la moitié de leur carrière, se mettent à flamber tout à coup d’une flamme éclatante et triste."
                                            },
                                            {
                                                "example_id": "2ffe2793-fbc0-484a-97c5-c78b1efed70e",
                                                "sense_id": "2c86ded1-d4de-3328-b43d-3581f5832c4a",
                                                "text": "Elle montait parfois les deux marches qui menaient aux profondes embrasures des fenêtres pour exposer aux derniers rayons du soleil la transparence des sardoines, et, tout enveloppée de l'or oblique du crépuscule, Valentine elle-même semblait diaphane comme ses gemmes."
                                            },
                                            {
                                                "example_id": "6ba7c5d8-8e35-479f-a1d8-78a24e39adc3",
                                                "sense_id": "2c86ded1-d4de-3328-b43d-3581f5832c4a",
                                                "text": "émeraudes, jaspe, rubis, sardoines, escarboucles."
                                            },
                                            {
                                                "example_id": "de740087-401e-41c6-8fc6-aacc53043aa0",
                                                "sense_id": "2c86ded1-d4de-3328-b43d-3581f5832c4a",
                                                "text": "Nous avons acquis un précieux calice fait d’une seule sardoine massive, ainsi qu’un autre vase de même matière, mais non de même forme, ressemblant à une amphore, et encore un autre vase qui semble comme de béryl ou de cristal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0621cc64-89fd-4537-bbd7-0199343817cb",
                        "source_entry_id": "9552113d-f001-3ae4-b628-7ddee3fac709",
                        "source_sense_id": "a7fd2580-6557-362b-8b4a-d59359f30929",
                        "target_lang_word": "sardonyx",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sardonyx",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33c09b93-be8c-35ec-a945-780ce05981b1",
                                        "entry_id": "c65b7b96-844e-3e42-85d2-25f4ea13952f",
                                        "glosses": [
                                            "Sardoine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab819f74-7aa5-49e9-9519-3b1a60f7f261",
                                                "sense_id": "33c09b93-be8c-35ec-a945-780ce05981b1",
                                                "text": "Une agate rubanée, c'est-à-dire une sardoine associée à une couche de chalcédoine et à une couche d'onyx, qui ne sont, comme elle, que des nuances de l'agate, devient une sardonyx et se prête admirablement au talent du graveur en camée, quand ses couches sont bien tranchées, ou à l'habileté du joaillier pour être taillée en vases et en coupes, quand les nuances de ses couches se fondent ensemble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
