                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81bc9d9f-a92f-42d0-a326-3eb24305eeb2",
                                                "sense_id": "e95f7d7d-6ad0-3d68-845a-5a6498862870",
                                                "text": "GILDEROY was a bonnie boy, / Had roſes tull his ſhoone, / His ſtockings were of ſilken ſoy, / Wi' garters hanging doune: […]"
                                            },
                                            {
                                                "example_id": "8dc05908-b0fc-48a1-9878-d1285a3f1346",
                                                "sense_id": "e95f7d7d-6ad0-3d68-845a-5a6498862870",
                                                "text": "Our tents are spread with gossamer thread, / More delicate far than silken soy."
                                            },
                                            {
                                                "example_id": "6e1fadf8-edd9-42fb-9f82-1f633dd98428",
                                                "sense_id": "e95f7d7d-6ad0-3d68-845a-5a6498862870",
                                                "text": "Now two and two the host comes by; / And first the pikemen, stout and slow; / Next, under pennons flaunting high, / Barons in cloaks of silken soy / And caps of velvet go."
                                            }
                                        ]
                                    }
                                ]
                            }
