                        "examples": [
                            {
                                "example_id": "e813b814-b6b5-4a9b-9ee6-0f361eab2e0a",
                                "sense_id": "08933c73-e841-398b-83c9-0d81e0526983",
                                "text": "J’aime parler de ma vie, cuisinouiller, sortir et chanter quand ca va mal."
                            },
                            {
                                "example_id": "369b264d-ff59-401c-8143-3e109a80cc57",
                                "sense_id": "08933c73-e841-398b-83c9-0d81e0526983",
                                "text": "S’amuser à écrire une bafouille de temps en temps, rigolote si possible, s’amuser à cuisinouiller des machins et à les prendre en photos quand on y pense, s’amuser en rencontrant des gens adorables au milieu de la pas-toujours-adorable blogochose, s’amuser quoi."
                            },
                            {
                                "example_id": "e0b4f27d-0b2a-4b93-baf3-675ebf10f708",
                                "sense_id": "08933c73-e841-398b-83c9-0d81e0526983",
                                "text": "Elle glandouille mais aussi elle cuisinouille."
                            },
                            {
                                "example_id": "47b1ffdc-22bf-4a23-8162-264f410918a0",
                                "sense_id": "08933c73-e841-398b-83c9-0d81e0526983",
                                "text": "Maintenant, il doit ménager, nettoyasser, lingeasser, cuisinouiller…"
                            }
                        ]
                    }
