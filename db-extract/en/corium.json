                                "example_id": "8f0a405c-cebc-403c-bf9e-88b0358852f2",
                                "sense_id": "526df053-3ee9-35c8-a250-a74b1648be6e",
                                "text": "Passing by the Corium Bubulum of the Classical Ancients, we see in an old charter, dated 1036, \"Stallus Sutoris Vaccæ,\" i. e. the stall of a shoe-maker who used cow-skin."
                            }
                        ]
