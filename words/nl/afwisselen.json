                                "target_lang_word": "alternate",
                                "target_lang_sense_clarification": "to perform or cause to succeed by turns"
                            },
                            {
                                "target_lang_word": "switch between",
                                "target_lang_sense_clarification": "to change back and forth between two things"
                            }
                        ]
                    }
                },
                {
