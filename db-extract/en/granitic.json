                        "glosses": [
                            "Of, pertaining to, or containing granite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c8e729-bf84-4c9e-a346-394b257a1d12",
                                "sense_id": "53e13b8d-3196-3a4b-b909-401c84eedf12",
                                "text": "Castles and houses [...] sat on top of mountains and granitic outcroppings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "234decb2-6893-426e-bfe8-5df28b3f55e0",
                        "source_entry_id": "7ffe2072-8237-3fe2-b75d-2ca9fc45261a",
                        "source_sense_id": "53e13b8d-3196-3a4b-b909-401c84eedf12",
                        "source_sense_description": "of, pertaining to, or containing granite",
                        "target_lang_word": "granitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "granitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dafef800-6570-3598-bfaf-54344e4fccac",
                                        "entry_id": "719bdd2e-1f14-3c2d-8d66-451083dd1989",
                                        "glosses": [
                                            "Qui est de la nature du granit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987c95a9-043a-47e1-a88a-87abc980dc26",
                                                "sense_id": "dafef800-6570-3598-bfaf-54344e4fccac",
                                                "text": "L'archipel de Chausey est essentiellement formé par une roche granitique d'un bleu pâle, divisée en couches plus ou moins épaisses …."
                                            },
                                            {
                                                "example_id": "d92a9281-7703-400d-b3f1-2d63c452684c",
                                                "sense_id": "dafef800-6570-3598-bfaf-54344e4fccac",
                                                "text": "Il se dressa debout sur le lit granitique\nOù, tranquille, depuis dix siècles révolus,\nIl s’était endormi pour ne s’éveiller plus ;\nPuis il regarda l’ombre et le désert antique,\nEt sur l’ampleur du sein croisa ses bras velus."
                                            },
                                            {
                                                "example_id": "f05a3efa-18bc-4269-ba00-1921c678f838",
                                                "sense_id": "dafef800-6570-3598-bfaf-54344e4fccac",
                                                "text": "Ils paissent sur des landes granitiques ou dans les dépressions plus humides des plateaux caussenards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62f5be1-2bae-3525-816c-61f856134fa9",
                                        "entry_id": "719bdd2e-1f14-3c2d-8d66-451083dd1989",
                                        "glosses": [
                                            "Solide, imperturbable, inébranlable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20acb177-6361-4633-91f6-3118c0e9202d",
                                                "sense_id": "e62f5be1-2bae-3525-816c-61f856134fa9",
                                                "text": "Mais ce système qui enseigne à tous la constante obligation de « changer » est lui d’une immobilité granitique — tout est dit ou presque quand Libération, l’organe du moderne intransitif, fait chroniquer Alain Duhamel depuis cent ans."
                                            },
                                            {
                                                "example_id": "9ec98ff8-5156-42a6-aa1e-cc174d164fc5",
                                                "sense_id": "e62f5be1-2bae-3525-816c-61f856134fa9",
                                                "text": "Serge Halimi et Pierre Rimbert, eux, avaient choisi de se ranger sous une drôle de dénomination, prémonitoire d'après leurs détracteurs : « la direction granitique »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
