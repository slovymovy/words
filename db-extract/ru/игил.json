                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ISIS",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf48f68d-0cae-398a-8221-6adad895bb87",
                                        "entry_id": "29311ea4-c234-36ba-a7fb-33c095a331dc",
                                        "glosses": [
                                            "A Salafist group mainly active in Iraq and Syria, where it has proclaimed itself as a (unrecognized) state and later caliphate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed1913e-d8da-4391-82f6-8af8ec3f5f3d",
                                                "sense_id": "bf48f68d-0cae-398a-8221-6adad895bb87",
                                                "text": "They didn't know the room was too big, because they didn't have anybody there. How are they going to beat ISIS? I don't think it's gonna happen."
                                            },
                                            {
                                                "example_id": "617bfa95-44fd-49e1-9b64-6bb5e37075de",
                                                "sense_id": "bf48f68d-0cae-398a-8221-6adad895bb87",
                                                "text": "Despite territorial defeats in Iraq and Syria, ISIS continues to draw support from HVEs in the United States and the group’s global calls for attacks have intensified since the death last year of senior leader Abu Bakr al-Baghdadi."
                                            },
                                            {
                                                "example_id": "fe21ff98-f57a-4c69-925a-23ad6d5065c0",
                                                "sense_id": "bf48f68d-0cae-398a-8221-6adad895bb87",
                                                "text": "Terror groups linked to al Qaeda and ISIS have been active in Niger for years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38ee9e97-12dd-4e51-b4f2-e28a44725212",
                        "source_entry_id": "e0baa141-bfd7-34c4-a61f-0a016077b6eb",
