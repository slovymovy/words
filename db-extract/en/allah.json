                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "710d7afa-f564-45f9-90a0-e0f3aef26b65",
                                "sense_id": "cc75176a-26db-33de-be9a-c7fae879d7f1",
                                "text": "What is the Shia Islamic view on the attributes of Allah?"
                            },
                            {
                                "example_id": "d9942307-9d57-41ae-8cbc-15810334b16a",
                                "sense_id": "cc75176a-26db-33de-be9a-c7fae879d7f1",
                                "text": "We are too much men and women; we are yet formed in the image of the Creator, and what can we say of Him with any certainty except that He, whoever He may be—Christ, Yahweh, Allah—He made us, did He not, because even He in His Infinite Perfection could not bear to be alone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dde3279-2bd5-4f24-974b-4d4edb39f82a",
                        "source_entry_id": "64944d78-05df-3adf-87c5-24f01c1246f0",
                        "source_sense_id": "cc75176a-26db-33de-be9a-c7fae879d7f1",
                        "source_sense_description": "God, in Islam",
                        "target_lang_word": "Alláh",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alláh",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2977b5e7-6bc8-335a-8f6b-a37b8fe67814",
                                        "entry_id": "091515e1-82a9-3c26-b0c5-93bece15e914",
                                        "glosses": [
                                            "islámský bůh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1fc0b29-2e1d-424f-96df-eebc4d796896",
                                                "sense_id": "2977b5e7-6bc8-335a-8f6b-a37b8fe67814",
                                                "text": "Jsou lidé, kteří ve své bibli (ať je to kterákoliv) mají odpověď na všechno; nemusí si ničím trápit hlavičku; jejich Alláh jest velik a rozhodl v této věci tak a tak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e13fbdb0-e971-420e-bc8b-ebd837d17b37",
                        "source_entry_id": "64944d78-05df-3adf-87c5-24f01c1246f0",
                        "source_sense_id": "cc75176a-26db-33de-be9a-c7fae879d7f1",
