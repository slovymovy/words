                                "target_senses": [
                                    {
                                        "sense_id": "cd8c6667-0494-3853-8e26-c557edcad979",
                                        "entry_id": "3e523df0-e7b9-363b-9491-dfff4140de6d",
                                        "glosses": [
                                            "vztahující se k luteránství"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5602c5f3-61fa-472a-b028-b8cef11bacc8",
                                                "sense_id": "cd8c6667-0494-3853-8e26-c557edcad979",
                                                "text": "Kommissaři císařští sjížděli celé markrabství sem i tam, odstraňovali ze všech far a kollatur kněžstvo luteránské a doplňovali je kněžími katolickými."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c08c070-2c48-4184-8dfc-9a2bfd73a785",
                        "source_entry_id": "3abd0009-c643-39ed-9f3e-21d869943b06",
                        "source_sense_id": "5c4ecb65-8099-3486-8a77-da6af84f9692",
                        "target_lang_word": "luterano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luterano",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "efe10582-9e70-36e1-aab5-b490decf7511",
                                        "entry_id": "1cd661d2-dbe6-3c72-9b08-c5869085adfa",
                                        "glosses": [
                                            "Que pertenece o concierne al religioso protestante Martín Lutero o el luteranismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59aacfd4-6e4d-40e9-a013-89bd910e6514",
                                                "sense_id": "efe10582-9e70-36e1-aab5-b490decf7511",
                                                "text": "En el séptimo los libros luteranos que se abrasan sobre un altar y unas letras que dicen."
                                            },
                                            {
                                                "example_id": "b7ec706a-b936-4277-bb44-25a45c9a4928",
                                                "sense_id": "efe10582-9e70-36e1-aab5-b490decf7511",
                                                "text": "hubo bala tan desmandada que estando en la iglesia mayor haciendo sus oraciones luteranas, entró y, se barrió las piernas de seis que estaban sentados en un banco."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                        "entry_id": "1cd661d2-dbe6-3c72-9b08-c5869085adfa",
                                        "glosses": [
                                            "Seguidor del luteranismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b844933-c892-4a8f-acdb-899760336f87",
                                                "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                                "text": "Antes, vosotros recebistes en vuestro ejército los luteranos que se vinieron huyendo de Alemaña, y con ellos hicistes guerra al Emperador."
                                            },
                                            {
                                                "example_id": "33588642-b511-40ef-9835-df2e71952bb9",
                                                "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                                "text": "La herejía era el rejalgar que, una vez en la entraña, daba al traste con la más firme entereza, y, según él, ya el tósigo estaba en parte sorbido. Valladolid era un foco de luteranos. Salamanca, un seminario de herejes."
                                            },
                                            {
                                                "example_id": "fbc87cc3-0c81-4e6f-b5b1-57108fc38130",
                                                "sense_id": "920f4d44-b5f5-3b70-8eaf-845e2b22be82",
                                                "text": "En España se persiguió la doctrina de los hebreos, como se persiguió la de los luteranos o calvinistas. Y se persiguió por ser, todo eso, herejía."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
