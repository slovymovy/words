                        ],
                        "form": "die Hamsterkäufe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d2faa03-0d92-3a02-acc3-63fb36de2b4a",
                        "entry_id": "0d777089-ed4f-3c22-98f6-868bf3a61011",
                        "glosses": [
                            "Einkäufe, die man macht, um für bevorstehende Krisenzeiten vorzusorgen; Anlegen eines Vorrats an Lebensmitteln, Wasser und so weiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd114947-c36a-4db6-aa9e-f28a7592fb6e",
                                "sense_id": "6d2faa03-0d92-3a02-acc3-63fb36de2b4a",
                                "text": "Während der Zeit des kalten Krieges tätigten viele Hausfrauen Hamsterkäufe, da sie vermuteten, dass ein neuer Weltkrieg bevorsteht."
                            },
                            {
                                "example_id": "e71b129f-9d1c-4764-9a8c-c3df73827102",
                                "sense_id": "6d2faa03-0d92-3a02-acc3-63fb36de2b4a",
                                "text": "„Es kam zu Hamsterkäufen wie schon in den letzten Juli- und ersten Augusttagen 1914.“"
                            },
                            {
                                "example_id": "e20885e4-2477-497c-b401-40a8b2fa13c7",
                                "sense_id": "6d2faa03-0d92-3a02-acc3-63fb36de2b4a",
                                "text": "Für mehr als 85 Millionen Menschen in mindestens 20 Bundesstaaten gelten Wetterwarnungen. Viele haben sich in Hamsterkäufen mit Lebensmitteln eingedeckt, um die Zeit zu überstehen."
                            },
                            {
                                "example_id": "90a52e23-a387-4245-8fb0-3ca35d55e231",
                                "sense_id": "6d2faa03-0d92-3a02-acc3-63fb36de2b4a",
                                "text": "Nach der Meldung über den Putsch habe es erstmal ratlose Gesichter gegeben, dann Hamsterkäufe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
