                ],
                "senses": [
                    {
                        "sense_id": "e8e27d78-f4b4-3937-9a9e-9d000f0b7b84",
                        "entry_id": "78e14637-fc82-342e-ad63-124711826caf",
                        "glosses": [
                            "aus zwei Prämissen gezogener Schluss vom Allgemeinen zum Besonderen"
                        ],
                        "tags": [
                            "Logik"
                        ],
                        "examples": [
                            {
                                "example_id": "566165e6-8e37-4d3c-83d8-09a1207a5ad5",
                                "sense_id": "e8e27d78-f4b4-3937-9a9e-9d000f0b7b84",
                                "text": "Ein Beispiel für einen Syllogismus, einen logisch richtigen Schluss: 1. Alle Menschen sind sterblich. 2. Sokrates ist ein Mensch. => Sokrates ist sterblich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfb4f5ff-3c59-46c4-ab45-99dae566810f",
                        "source_entry_id": "78e14637-fc82-342e-ad63-124711826caf",
                        "source_sense_id": "e8e27d78-f4b4-3937-9a9e-9d000f0b7b84",
                        "source_sense_description": "Logik: aus zwei Prämissen gezogener Schluss vom Allgemeinen zum Besonderen",
                        "target_lang_word": "syllogism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syllogism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27e7c1cd-1945-30b7-97ab-b623c9a128f8",
                                        "entry_id": "6b4547a1-6f24-375f-ac0e-5dd9acc58dc3",
                                        "glosses": [
                                            "An argument whose conclusion is supported by two premises, of which one contains the term that is the predicate of the conclusion, and the other contains the term that is the subject of the conclusion; common to both premises is a term that is excluded from the conclusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d07434-52a4-4e22-8276-fc0cb1cff92e",
                                                "sense_id": "27e7c1cd-1945-30b7-97ab-b623c9a128f8",
                                                "text": "Ever since Aristotle, syllogism has occupied a central place in logic and cast a fateful shadow upon the power of reason. Recognized to be the great conveyor of rationality, allowing reason to reach conclusions of unparalleled universality and necessity, syllogism has equally been acknowledged to be beset by limits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87022125-1578-3bc1-be6f-592ba147cd3b",
                                        "entry_id": "6b4547a1-6f24-375f-ac0e-5dd9acc58dc3",
                                        "glosses": [
                                            "A trick, artifice; an extremely subtle, sophisticated, or deceptive argument; a sophism."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "950e1f51-88f1-4d0c-8da5-9fc1a2027dc5",
                        "source_entry_id": "78e14637-fc82-342e-ad63-124711826caf",
                        "source_sense_id": "e8e27d78-f4b4-3937-9a9e-9d000f0b7b84",
                        "source_sense_description": "Logik: aus zwei Prämissen gezogener Schluss vom Allgemeinen zum Besonderen",
                        "target_lang_word": "syllogisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syllogisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b5715a-104b-3db9-acda-c4508871162b",
                                        "entry_id": "8e5fdd51-3982-3d3e-950b-99f969eab266",
                                        "glosses": [
                                            "Raisonnement composé de trois propositions, la majeure, la mineure et la conclusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84adf3f-6f22-42d8-986c-743be11477cb",
                                                "sense_id": "c3b5715a-104b-3db9-acda-c4508871162b",
                                                "text": "« Tous les hommes sont mortels, Socrate est un homme, donc Socrate est mortel. » est un syllogisme."
                                            },
                                            {
                                                "example_id": "7423bc7d-6f70-471c-b3ed-ea233fb2b444",
                                                "sense_id": "c3b5715a-104b-3db9-acda-c4508871162b",
                                                "text": "Toute cette dialectique en syllogismes constituait une gymnastique excellente. Je dois la clarté de mon esprit, en particulier une certaine habileté dans l’art de diviser (art capital, une des conditions de l’art d’écrire), aux exercices de la scolastique et surtout à la géométrie, qui est l’application par excellence de la méthode syllogistique."
                                            },
                                            {
                                                "example_id": "c904ea41-68b7-49eb-8954-6168e57403e8",
                                                "sense_id": "c3b5715a-104b-3db9-acda-c4508871162b",
                                                "text": "… un adversaire emmuré dans la cotte de maille du syllogisme, ferme sur ses étriers, mobile, porté çà et là soudain par la fougue de son cheval, Mauvaise-Foi, et pointant Donc, sa lance de douze coudées."
                                            },
                                            {
                                                "example_id": "51dfb38e-2029-45d1-bb0f-682900404ffd",
                                                "sense_id": "c3b5715a-104b-3db9-acda-c4508871162b",
                                                "text": "Un syllogisme de l’espèce la plus simple et la seule qui fût accessible à son esprit fatigué lui démontra que, « un » étant contenu dans « deux », s’il ne pouvait soulever un seau, il serait encore moins capable de déambuler avec la paire."
                                            },
                                            {
                                                "example_id": "7464eaec-adf6-43ed-af5e-0454581807d8",
                                                "sense_id": "c3b5715a-104b-3db9-acda-c4508871162b",
                                                "text": "La conclusion d’un syllogisme est contenue dans les prémisses, et c’est pourquoi on ne saurait accepter les prémisses et rejeter la conclusion sans contradiction."
                                            },
                                            {
                                                "example_id": "426ecd4b-b70b-417d-9be5-b5931261ba33",
                                                "sense_id": "c3b5715a-104b-3db9-acda-c4508871162b",
                                                "text": "En fait le syllogisme est la combinaison des propositions : une majeure (« tous les humains sont mortels »), une mineure (« tous les Grecs sont des humains »), une conclusion (« tous les Grecs sont mortels)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c825867-a472-4a04-89a8-bf132dd74d09",
                        "source_entry_id": "78e14637-fc82-342e-ad63-124711826caf",
                        "source_sense_id": "e8e27d78-f4b4-3937-9a9e-9d000f0b7b84",
