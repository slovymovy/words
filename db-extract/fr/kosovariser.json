                "senses": [
                    {
                        "sense_id": "1e283706-1df1-3394-a25a-9e9929718c15",
                        "entry_id": "6bfd09d5-ebce-3581-8734-3e307518d382",
                        "glosses": [
                            "Donner un caractère kosovar, ou rappelant le Kosovo, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bfd03df-e4b1-4dc1-a972-984d49f60c9d",
                                "sense_id": "1e283706-1df1-3394-a25a-9e9929718c15",
                                "text": "Il faut européaniser les Balkans, pas les kosovariser !, explique le ministre serbe des Affaires étrangères."
                            },
                            {
                                "example_id": "1f494a67-95d8-4970-b28d-ea0d707707ca",
                                "sense_id": "1e283706-1df1-3394-a25a-9e9929718c15",
                                "text": "Poursuivant le mouvement de transfert des compétences de la Mission de l'ONU au gouvernement du Kosovo, l'Envoyé de l'ONU a annoncé des mesures dans le domaine de l'économie afin de « kosovariser » les organes de gestion, c'est-à-dire obtenir une majorité de Kosovars au lieu du personnel international."
                            },
                            {
                                "example_id": "fc9cf6e7-95c4-44a9-a1a5-97e8bfb2cda5",
                                "sense_id": "1e283706-1df1-3394-a25a-9e9929718c15",
                                "text": "A savoir la Minuk, la mission onusienne, prisonnière, de manière générale, des espoirs qu'elle a créés et qui a, désormais, «kosovarisé» le management de la KEK."
                            }
                        ]
                    }
