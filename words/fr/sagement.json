            "senses": [
                {
                    "sense_id": "8ab7d28c-b691-34be-82e6-7402a6318996",
                    "sense_definition": "De manière calme et obéissante, sans faire de bruit ni de bêtises.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comportement_docile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant que leur mère prépare le dîner, les enfants jouent <w>sagement</w> dans le salon.",
                            "target_lang_translations": {
                                "en": "While their mother prepares dinner, the children play <w>quietly</w> in the living room.",
                                "ru": "Пока их мать готовит ужин, дети <w>тихо</w> играют в гостиной.",
                                "de": "Während ihre Mutter das Abendessen zubereitet, spielen die Kinder <w>brav</w> im Wohnzimmer.",
                                "es": "Mientras su madre prepara la cena, los niños juegan <w>tranquilamente</w> en el salón.",
                                "zh": "妈妈做饭的时候，孩子们在客厅里<w>乖乖地</w>玩。"
                            }
                        },
                        {
                            "text": "Le chien attend <w>sagement</w> devant la porte le retour de sa maîtresse.",
                            "target_lang_translations": {
                                "en": "The dog waits <w>obediently</w> at the door for its mistress to return.",
                                "ru": "Собака <w>послушно</w> ждёт у двери, пока вернётся её хозяйка.",
                                "de": "Der Hund wartet <w>brav</w> vor der Tür auf die Rückkehr seines Frauchens.",
                                "es": "El perro espera <w>obedientemente</w> ante la puerta el regreso de su dueña.",
                                "zh": "小狗在门口<w>老老实实地</w>等女主人回来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "docilement",
                        "gentiment",
                        "tranquillement"
                    ],
                    "antonyms": [
                        "bruyamment"
                    ],
                    "common_phrases": [
                        "attendre sagement",
                        "jouer sagement",
                        "écouter sagement"
                    ],
                    "target_lang_definitions": {
