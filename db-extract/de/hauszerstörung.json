                        "examples": [
                            {
                                "example_id": "f2d8c47f-7337-4b6f-beaa-c21d63ee2b25",
                                "sense_id": "50d3e25a-3d14-3f6b-8f71-45cf7429bf4a",
                                "text": "„Insbesondere solche Siedlungen, die wie in Ost-Jerusalem oder Hebron inmitten palästinensischer Wohngebiete liegen, bringen starke Belastungen für die lokale Bevölkerung mit sich, führen oft zu ihrer Verdrängung und provozieren immer wieder Zusammenstöße und bewaffnete Auseinandersetzungen. Zu dieser Verdrängung trägt auch die israelische Politik der Hauszerstörungen bei.“"
                            }
                        ],
