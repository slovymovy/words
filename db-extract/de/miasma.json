                "senses": [
                    {
                        "sense_id": "90701ca2-9bb6-386a-841b-fdd37a5cdd27",
                        "entry_id": "6365a40c-13e4-39ed-ab54-c15f8abcfbcf",
                        "glosses": [
                            "Krankheit auslösender Stoff in der Luft oder der Erde"
                        ],
                        "tags": [
                            "in der klassischen Medizin"
                        ],
                        "examples": [
                            {
                                "example_id": "3b0e2253-7c8e-4659-b039-192c5c234be4",
                                "sense_id": "90701ca2-9bb6-386a-841b-fdd37a5cdd27",
                                "text": "Noch Mitte des 19. Jahrhunderts glaubten Mediziner, dass Seuchen wie Cholera durch üble Gerüche, also Miasmen verbreitet würden."
                            },
                            {
                                "example_id": "2b8bdb31-2229-4481-9de0-fea4d5018ed4",
                                "sense_id": "90701ca2-9bb6-386a-841b-fdd37a5cdd27",
                                "text": "„Wahrscheinlich lag der Grundwasserspiegel hier so hoch, daß die Luft der Hochsommerhitze von krankheitserregenden Miasmen gesättigt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c16c456e-d90d-3b01-98a5-ebdf91dd64cc",
                        "entry_id": "6365a40c-13e4-39ed-ab54-c15f8abcfbcf",
                        "glosses": [
                            "allgemein für üble Gerüche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e76a2ef4-8c29-46da-a24c-085478db4321",
                                "sense_id": "c16c456e-d90d-3b01-98a5-ebdf91dd64cc",
                                "text": "„Ein paar Handbreit über dem Sumpf der Gesichter schwebte ein flimmerndes Miasma von Alkohol: von bernsteinfarbenem Whisky, von Martinis, hastig hinuntergekippt zwischen Nachhausekommen und Abendessen, kurz bevor der Babysitter eintraf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
