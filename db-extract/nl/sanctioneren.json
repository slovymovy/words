        "nl-extract.jsonl": [
            {
                "entry_id": "0e82399a-ae7d-3b3e-b559-e4a616a09291",
                "word": "sanctioneren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f5f7733-da61-3618-a4a3-d113f9cf5b64",
                        "entry_id": "0e82399a-ae7d-3b3e-b559-e4a616a09291",
                        "glosses": [
                            "toestemming verlenen voor"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1828f505-1614-42e4-be36-3d73e9ac6393",
                                "sense_id": "4f5f7733-da61-3618-a4a3-d113f9cf5b64",
                                "text": "Toch is de vraag of het sporttribunaal de nu door het IOC gecreëerde rechtsongelijkheid kan sanctioneren. Waarom zou Amerika voormalige dopinggebruikers als Tyson Gay en Justin Gatlin wel mogen afvaardigen naar Rio? En kan het tribunaal wel binnen tien dagen bijna 400 Russische sporters screenen? Bach: 'Het wordt een uitdaging, maar we hadden geen keuze."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfd37799-144e-3add-8057-40f311839bd6",
                        "entry_id": "0e82399a-ae7d-3b3e-b559-e4a616a09291",
                        "glosses": [
                            "garanderen, waarborgen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9e468fe4-5aca-3deb-a951-55058c16c532",
                        "entry_id": "0e82399a-ae7d-3b3e-b559-e4a616a09291",
                        "glosses": [
                            "onderwerpen aan een sanctie [1]"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "999cbfeb-58fc-4224-b0f7-51009fa49ee9",
                                "sense_id": "9e468fe4-5aca-3deb-a951-55058c16c532",
                                "text": "Over naar Nederland. Zet een paar puntjes op de u’s en voeg wat hoofdletters toe, en het stuk dat Marcel ten Hooven zojuist voor De Groene schreef kan direct in een Duitse krant. Tegenwoordig jongleren beleidsmakers met de rechtsstaat, zegt Ten Hooven. Met een beroep op veiligheid harkt de staat macht en bevoegdheden naar zich toe, met als doel ‘dieper te kunnen interveniëren, scherper te controleren, meer te sanctioneren’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e85621f-e6be-4a34-a8b8-3532f631719f",
                        "source_entry_id": "0e82399a-ae7d-3b3e-b559-e4a616a09291",
                        "source_sense_id": "4f5f7733-da61-3618-a4a3-d113f9cf5b64",
                        "source_sense_description": "toestemming verlenen voor",
                        "target_lang_word": "approve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b78f03a-06d0-3242-a145-b9f3eb267660",
                                        "entry_id": "891bb1ce-1cc8-3a46-a615-525d0978c796",
                                        "glosses": [
                                            "To officially sanction; to ratify; to confirm; to set as satisfactory."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46f2badc-54b5-4bda-a18d-1ce4baea2872",
                                                "sense_id": "9b78f03a-06d0-3242-a145-b9f3eb267660",
                                                "text": "Although we may disagree with it, we must nevertheless approve the sentence handed down by the court-martial."
                                            },
                                            {
                                                "example_id": "4b9fb3cf-9b06-4f3b-b049-c90905e2e391",
                                                "sense_id": "9b78f03a-06d0-3242-a145-b9f3eb267660",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f057a53-9908-3c3c-8612-bcb23fbdcf41",
                                        "entry_id": "891bb1ce-1cc8-3a46-a615-525d0978c796",
                                        "glosses": [
                                            "To regard as good; to commend; to be pleased with; to think well of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40f21f4-6d69-4c0f-a9f8-3f9131153eb6",
                                                "sense_id": "4f057a53-9908-3c3c-8612-bcb23fbdcf41",
                                                "text": "We approve the measure of the administration, for it is an excellent decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3314973f-ca99-3732-95a4-f1cdd7389a0f",
                                        "entry_id": "891bb1ce-1cc8-3a46-a615-525d0978c796",
                                        "glosses": [
                                            "To make proof of; to demonstrate; to prove or show practically."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2c0e57-b1e7-41c3-80c4-981dcd4e12b0",
                                                "sense_id": "3314973f-ca99-3732-95a4-f1cdd7389a0f",
                                                "text": "He had long burned with impatience to approve his valour."
                                            },
                                            {
                                                "example_id": "c04dd9ee-b3e2-4001-9e14-f66a21b847a9",
                                                "sense_id": "3314973f-ca99-3732-95a4-f1cdd7389a0f",
                                                "text": "1812–1818, Lord Byron, Child Harolde's Piligrimage\n'T is an old lesson; Time approves it true."
                                            },
                                            {
                                                "example_id": "c1aa6c13-7ad4-416b-a5f3-87215936c38c",
                                                "sense_id": "3314973f-ca99-3732-95a4-f1cdd7389a0f",
                                                "text": "Opportunities to approve[…]worth."
                                            },
                                            {
                                                "example_id": "950ae313-b1af-42aa-bbf9-ccef1ca0a32c",
                                                "sense_id": "3314973f-ca99-3732-95a4-f1cdd7389a0f",
                                                "text": "He had approved himself a great warrior."
                                            },
                                            {
                                                "example_id": "dae85bc3-1f61-40b2-a66e-cb7574710229",
                                                "sense_id": "3314973f-ca99-3732-95a4-f1cdd7389a0f",
                                                "text": "Sore against our will did we of Witchland join with the Demons in that war, foreseeing (as hath been bloodily approved) that the issue must be but the puffing up of the Demons, who desire no other thing than to be lords and tyrants of all the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf8d97a9-527e-30ae-b5ab-22d881eb000f",
                                        "entry_id": "891bb1ce-1cc8-3a46-a615-525d0978c796",
                                        "glosses": [
                                            "To consider worthy (to); to be pleased (with); to accept."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cebe183-cf90-4094-88a1-50340df687b3",
                                                "sense_id": "cf8d97a9-527e-30ae-b5ab-22d881eb000f",
                                                "text": "Her mother never approves of any of her boyfriends. She thinks nobody is good enough for her little girl."
                                            },
                                            {
                                                "example_id": "df2671a4-8314-42b0-90ac-c98e91e7f9e0",
                                                "sense_id": "cf8d97a9-527e-30ae-b5ab-22d881eb000f",
                                                "text": "Their address was in the most dutiful manner, approving of what her majesty had done toward a peace, and dissolve her parliament"
                                            },
                                            {
                                                "example_id": "7da4a297-e250-40b7-a2f8-2c7477d1cc54",
                                                "sense_id": "cf8d97a9-527e-30ae-b5ab-22d881eb000f",
                                                "text": "They had not approved of the deposition of James."
                                            },
                                            {
                                                "example_id": "0a1c345c-a3f6-4db3-a967-255b6dc90189",
                                                "sense_id": "cf8d97a9-527e-30ae-b5ab-22d881eb000f",
                                                "text": "Dad didn't approve of me, do you? I'm alive with something inside of me."
                                            },
                                            {
                                                "example_id": "03442bba-d811-411b-a37e-0ec32c970abe",
                                                "sense_id": "cf8d97a9-527e-30ae-b5ab-22d881eb000f",
                                                "text": "Your mother wouldn't approve of how my mother raised me. But I do, I think I do. And you're an all-American boy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1119212-7cb9-3f67-919a-ec1cac672eec",
                                        "entry_id": "891bb1ce-1cc8-3a46-a615-525d0978c796",
                                        "glosses": [
                                            "To show to be worthy; to demonstrate the merits of."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f71e1954-72f8-43c8-8e05-fa5e53022e8f",
                                                "sense_id": "c1119212-7cb9-3f67-919a-ec1cac672eec",
                                                "text": "The first care and concern must be to approve himself to God."
                                            }
                                        ]
                                    }
                                ]
                            },
