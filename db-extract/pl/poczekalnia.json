                ],
                "senses": [
                    {
                        "sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "glosses": [
                            "miejsce dla osób, które czekają"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65eaae5-d506-44f9-805e-9d5e7dea6776",
                                "sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                                "text": "Podróżni zachowywali się milcząco, przyzwoicie, powściągliwie, jak w poczekalniach kolejowych pierwszej i drugiej klasy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b52b4531-d1ef-4c94-ae4f-4e2fa372df06",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "waiting room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waiting room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                        "entry_id": "53220167-0377-3de3-97a2-324d5a3860af",
                                        "glosses": [
                                            "A room in a public place for people to wait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47267aba-5967-4a83-bbb4-efe4142ff607",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "In the third place, by its situation it serves only for a waiting-room, and a passage to the principal apartments, instead of being reserved, as it ought to be, for entertaining company […]"
                                            },
                                            {
                                                "example_id": "5e25ec93-d852-4299-b76f-2f396a16e924",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "A blind bearing the monogram G.V.T. is pulled down over the waiting room window as if still in mourning for the passing of the railway."
                                            },
                                            {
                                                "example_id": "6347a7e7-e6c5-4c2d-800b-d59a63dd8252",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "To lovers of Victoriana it will not be necessary to enlarge on the original beauty of many [old stations], but to the modern traveller romantic nostalgia will not compensate for bleak, draughty waiting rooms, ancient sanitation, uncomfortable grimy seats and gas lighting; he is likely to prefer the comforts of a modern car on a winter's morning."
                                            },
                                            {
                                                "example_id": "feabf2a8-dba2-4582-b8cf-2606fdfdd818",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "At Hanwell, two lifts have been installed along with a refurbished ticket office with accessible window. A new waiting room is being installed on Platform 2, while the one on Platform 3 is being refurbished."
                                            },
                                            {
                                                "example_id": "e12b718b-5ac8-4214-a198-7578e70e0ce5",
                                                "sense_id": "fd49bd7a-b9a6-3f3f-9457-b256dd9350a7",
                                                "text": "\"This is a particularly good example of a timber railway station, with its Royal connection giving rise to some outstanding internal and external detailing. The swan-necked iron lamps, the porte-cochère and outstanding decoration in the Royal waiting room set the station apart.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1bcb262-3ed3-47a8-97a1-3476dd546165",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "čekárna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čekárna",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0413f2ec-8b70-395a-a41d-360a987ba5a1",
                                        "entry_id": "419cd700-5972-366c-bed9-938ad11a473e",
                                        "glosses": [
                                            "místnost, určená pro čekání na někoho či na něco"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b189e8-8061-45ab-b658-72bcb89ffeb5",
                                                "sense_id": "0413f2ec-8b70-395a-a41d-360a987ba5a1",
                                                "text": "Vyčkejte v čekárně, dokud Vás setra nepozve do ordinace."
                                            },
                                            {
                                                "example_id": "e6e851bf-ad8a-41bb-9ca5-0f8d15f22c9b",
                                                "sense_id": "0413f2ec-8b70-395a-a41d-360a987ba5a1",
                                                "text": "Dějištěm incidentu byla čekárna místního nádraží."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9463b024-5447-44d4-953b-90e8a4036d62",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "salle d'attente",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4cb5f4cb-318f-4357-a423-b26aba8dc187",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "sala de espera",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "37a722b7-ac44-4079-8ad9-10149bd3298f",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "wachtzaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wachtzaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c281ee1e-d5e5-3ca3-88b3-ff2700bc22b9",
                                        "entry_id": "0e68b613-777b-3e47-b721-2000b131deda",
                                        "glosses": [
                                            "grote ruimte in een gebouw waar mensen enige tijd kunnen verblijven voordat zij verder gaan naar hun eigenlijke bestemming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51dd861-513e-434e-ba00-889f1465b847",
                                                "sense_id": "c281ee1e-d5e5-3ca3-88b3-ff2700bc22b9",
                                                "text": "Ook in het Institut Hospitalier in het naburige Massy is de hitte het gespreksonderwerp van de patiënten in de wachtzaal van de dienst spoedgevallen."
                                            },
                                            {
                                                "example_id": "b34e09e2-216b-4d14-bb46-6f09c0c7353c",
                                                "sense_id": "c281ee1e-d5e5-3ca3-88b3-ff2700bc22b9",
                                                "text": "Ik was intusschen nieuwsgierig om den vriend te zien, en toen ik de wachtzaal binnentrad, waar de geneesheer van het gesticht, volgens gewoonte, eene korte samenspraak met de leerlingen hield, alvorens de visiet te beginnen, zochten mijne oogen ongeduldig den vriend Salviani in hun midden te onderscheiden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "275e6171-529d-38b5-bfb2-29519db3b214",
                                        "entry_id": "0e68b613-777b-3e47-b721-2000b131deda",
                                        "glosses": [
                                            "grote ruimte in een gebouw voor de bewakers daarvan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51779218-c8bb-402e-8df0-c3b6eff314ab",
                                                "sense_id": "275e6171-529d-38b5-bfb2-29519db3b214",
                                                "text": "Waar zijn mijn wachten? vroeg hij ruw. - Hier, Heer.... wees ijverig de eunuch en hij naderde reeds de kleine, bronzen deur ter zijde. In Dareios' wachtzaal, ik meen.... in de uwe, Heer."
                                            },
                                            {
                                                "example_id": "4497c11c-756b-42b1-8113-37166e23a9a3",
                                                "sense_id": "275e6171-529d-38b5-bfb2-29519db3b214",
                                                "text": "Onder de groote poort van 's konings paleis, ter linkerzijde van den zuilengang, lag eene tamelijk groote kamer, welke tot wachtzaal was bestemd. Hier bevonden zich als naar gewoonte eenige Weermannen, die bij den ingang van 's heeren woning moesten waken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d699bd16-79c3-42d6-8eef-afceb8c2a165",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "Wartezimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wartezimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                        "entry_id": "6b67a1ac-71ef-37e0-a101-5f2d7f863caa",
                                        "glosses": [
                                            "Raum, in dem man sich während einer Wartezeit aufhalten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11faff94-ae1b-4088-8bdb-085ec03fa4f8",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "Im Winter sind die Wartezimmer in den Arztpraxen noch voller als sonst."
                                            },
                                            {
                                                "example_id": "f19aa3b9-ab9b-4d87-b8f2-bfcc15739dd8",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "Ich habe gestern fast zwei Stunden im Wartezimmer verbracht."
                                            },
                                            {
                                                "example_id": "8f69be7d-acf4-4f0c-8b2a-f7eb3cdd72d1",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„Man saß wie im Wartezimmer des Zahnarztes, solidarisch in der Erwartung einer unangenehmen Erfahrung, die allen bevorstand.“"
                                            },
                                            {
                                                "example_id": "842d6080-3e90-459f-a139-b18be112582c",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„Beim ersten Arzt sitzt das ganze Wartezimmer voll.“"
                                            },
                                            {
                                                "example_id": "93633ee0-36a7-4150-acdf-397994eb7684",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„So was geht einem durch den Kopf, wenn man selbst in einem Berliner Wartezimmer sitzt und seiner Vorsorgeuntersuchung entgegensieht.“"
                                            },
                                            {
                                                "example_id": "76243b6f-c920-4e43-91a0-e02af6959e9f",
                                                "sense_id": "720e124b-a1a3-36dc-bc2a-117e8dfed15b",
                                                "text": "„Dann sitze ich im Wartezimmer und habe Angst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "474573f9-6e02-44f3-a86e-c2b074b1bcdf",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "ожидальня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ожидальня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f06cbf7f-2f59-3f16-ad16-624c0f21359b",
                                        "entry_id": "1cf91f0a-3c91-39ff-97c3-3ab8dccfd93f",
                                        "glosses": [
                                            "разг. помещение где ожидают"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728d9315-3c46-41a1-b3a2-19cbc7041fb6",
                                                "sense_id": "f06cbf7f-2f59-3f16-ad16-624c0f21359b",
                                                "text": "В большом помещении, носившем название «ожидальня», потому что зимой в ней сотни рабочих ожидали расчета, кипела работа."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22968ac2-696d-442f-b1b7-8644f7196f17",
                        "source_entry_id": "be72a878-baf2-3c46-98a9-b5a5e189aebc",
                        "source_sense_id": "f8e0e859-f788-3c43-8757-22b3f9430099",
                        "target_lang_word": "приёмная",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "приёмная",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e243496d-7a40-39a3-8059-704fe92821d1",
                                        "entry_id": "b165de7e-f992-3a61-891e-9c9db14f62e9",
                                        "glosses": [
                                            "комната, в которой принимают посетителей или в которой посетители ждут приёма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1dfb915-0a31-4b2d-ac80-1a7220f526c5",
                                                "sense_id": "e243496d-7a40-39a3-8059-704fe92821d1",
                                                "text": "В приёмной было людно, посетители, в большинстве женщины, стояли в очереди к окошечкам, некоторые сидели на диванах, старик в очках с толстыми стёклами заполнял за столом какой-то листок."
                                            },
                                            {
                                                "example_id": "96564144-cede-4489-9c11-0da43de5637e",
                                                "sense_id": "e243496d-7a40-39a3-8059-704fe92821d1",
                                                "text": "Мы вошли в огромную приёмную, где за столом, уставленным множеством телефонов, сидела немолодая женщина, довольно полная брюнетка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c8954ef-66e5-3f81-876d-286f57048e04",
                                        "entry_id": "b165de7e-f992-3a61-891e-9c9db14f62e9",
                                        "glosses": [
                                            "помещение, в котором производится приём, приёмка каких-либо товаров, продуктов и т. п."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
