                                        "sense_id": "065c2d5f-8f7a-3295-bf31-5a983faffad5",
                                        "entry_id": "c903bf74-4c80-37c0-b307-4470412de9b3",
                                        "glosses": [
                                            "An often childish display or fit of bad temper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fb201ad-8fc5-4afc-a6af-d80384451a22",
                                                "sense_id": "065c2d5f-8f7a-3295-bf31-5a983faffad5",
                                                "text": "Many parents become embarrassed by their children throwing tantrums in public places."
                                            },
                                            {
                                                "example_id": "778f16dd-49e7-4c0d-93e7-e121effeb839",
                                                "sense_id": "065c2d5f-8f7a-3295-bf31-5a983faffad5",
                                                "text": "Baby Shawn threw a tantrum when he was told the bicycle was not his."
                                            },
                                            {
                                                "example_id": "808e6752-8f99-449b-b864-059eae91c2b1",
                                                "sense_id": "065c2d5f-8f7a-3295-bf31-5a983faffad5",
                                                "text": "When he became frustrated, he threw a tantrum, and his mother would attempt to comfort him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tantrum",
