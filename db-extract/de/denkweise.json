                    },
                    {
                        "form_id": "6cd5396b-f0ca-4d01-8100-c6442a6b9377",
                        "entry_id": "b237a1aa-76a9-3038-ab7b-7db6a22f45d4",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Denkweise"
                    },
                    {
                        "form_id": "e7d0643e-0930-4896-9347-0c96bda3348d",
                        "entry_id": "b237a1aa-76a9-3038-ab7b-7db6a22f45d4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Denkweisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                        "entry_id": "b237a1aa-76a9-3038-ab7b-7db6a22f45d4",
                        "glosses": [
                            "Art und Weise zu denken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fecbcb32-c42f-42c8-95e8-6d68dcce3c7e",
                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                "text": "Die Denkweise verändert sich beim Menschen, wenn er Stress ausgesetzt ist."
                            },
                            {
                                "example_id": "14883cae-b8a4-4aad-b9a7-d4a80ef51de7",
                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                "text": "Mit dieser eingeschränkten Denkweise kommt das Projekt nicht vorwärts."
                            },
                            {
                                "example_id": "9931cba1-4c69-4c33-8565-75b007b9049f",
                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                "text": "„Wir können sagen, daß die Naturphilosophen die ersten Schritte in Richtung einer wissenschaftlichen Denkweise machten.“"
                            },
                            {
                                "example_id": "d47610b6-07d8-4d0a-948b-95c3fd8850c4",
                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                "text": "„Doktor Vielguts Denkweise ist in der Forschung weit verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                        "entry_id": "b237a1aa-76a9-3038-ab7b-7db6a22f45d4",
                        "glosses": [
                            "geistige und sittliche Grundhaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89984a33-ea85-4247-ba62-d020a5079349",
                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                "text": "„Die Medizin war in jenen Jahren eng mit der Philosophie verbunden, begünstigt von der aufklärerischen, empiristischen Denkweise.“"
                            },
                            {
                                "example_id": "ac8bcda4-0ea7-4d31-8ee6-d1c363409fd8",
                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                "text": "„Das setzt eine Denkweise voraus, die nicht nur dem eigenen Interesse folgt, sondern für das Ganze Verantwortung übernehmen kann.“"
                            },
                            {
                                "example_id": "38788282-a578-4d66-95c4-4f09be86f6f6",
                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                "text": "„Er kochte vor Wut angesichts dieses Senators, der die stumpfsinnige Korrektheit und Beschränktheit seiner Denkweise ganz einfach auf diese ganz neu aufgetauchten Aufgaben des Adels übertragen wollte.“"
                            },
                            {
                                "example_id": "f5d7a4fe-1385-4295-bb32-8ae478d1bcd1",
                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                "text": "„Diese Ignoranten in Rom sind ihrer Denkweise nach völlig antiquiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
