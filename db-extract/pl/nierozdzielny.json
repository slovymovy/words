                                        "entry_id": "d9a2b6f0-e762-3f10-b657-f95eaec368ea",
                                        "glosses": [
                                            "Lasting; indestructible; not possible to dissolve, disintegrate or break up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61a0de0-b6b7-46a2-ad48-bfa219c87550",
                                                "sense_id": "27d1a618-996b-3a08-b7f6-ff8ad10bd601",
                                                "text": "It connected in one indissoluble bond."
                                            },
                                            {
                                                "example_id": "606acfc9-0264-4558-83a6-4251963bc05b",
                                                "sense_id": "27d1a618-996b-3a08-b7f6-ff8ad10bd601",
                                                "text": "They have an indissoluble friendship."
                                            }
                                        ]
                                    }
                                ]
                            }
