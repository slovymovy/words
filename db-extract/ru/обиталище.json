                "senses": [
                    {
                        "sense_id": "012d0970-54a0-37fd-a67b-a2f82ca900a4",
                        "entry_id": "74930310-5f00-37ac-8356-a7d5849814dc",
                        "glosses": [
                            "книжн. устар., теперь шутл. жилище"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23418b2f-8d00-4b99-947d-577227243991",
                                "sense_id": "012d0970-54a0-37fd-a67b-a2f82ca900a4",
                                "text": "До нашего обиталища близко — третья станция"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411c7c77-57cd-4e96-a15b-c909b325d1c7",
                        "source_entry_id": "74930310-5f00-37ac-8356-a7d5849814dc",
                        "source_sense_id": "012d0970-54a0-37fd-a67b-a2f82ca900a4",
                        "target_lang_word": "demeure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demeure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbdfa1b9-5ea7-3428-af7a-270322617a63",
                                        "entry_id": "87924172-06d3-3841-a640-13ba3a6af376",
                                        "glosses": [
                                            "Habitation, domicile."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc784819-e373-4b0b-84ea-c63802dd51d3",
                                                "sense_id": "dbdfa1b9-5ea7-3428-af7a-270322617a63",
                                                "text": "Le jour est tombé, et dans la nuit sans lune les misérables relais avec leur lampe fumeuse apparaissent tout d'un coup comme la demeure du veilleur des morts."
                                            },
                                            {
                                                "example_id": "019a5bed-4eef-4876-81b4-1dc81dead5e5",
                                                "sense_id": "dbdfa1b9-5ea7-3428-af7a-270322617a63",
                                                "text": "Cette demeure me rappelait tout à fait celle des paysans canariens : elle se composait de deux petites pièces éclairées par des lucarnes qui ne s'ouvraient point; […]."
                                            },
                                            {
                                                "example_id": "7dc1ed3c-76f5-4e12-ac32-015f2be25ee0",
                                                "sense_id": "dbdfa1b9-5ea7-3428-af7a-270322617a63",
                                                "text": "C’était la première demeure qui offrit l’invite hospitalière d’une porte ouverte, […]."
                                            },
                                            {
                                                "example_id": "e5c8cccd-60fa-4a8f-882d-b951b08c44de",
                                                "sense_id": "dbdfa1b9-5ea7-3428-af7a-270322617a63",
                                                "text": "Rares et maigres, pauvres et silencieuses étaient les localités traversées et, dans celles-ci, nombreuses étaient les demeures manifestement abandonnées, les bicoques délabrées où tout en fait des ruines."
                                            },
                                            {
                                                "example_id": "764feb8b-a0df-469d-a7fa-5916dc22206d",
                                                "sense_id": "dbdfa1b9-5ea7-3428-af7a-270322617a63",
                                                "text": "Nous étions loin des igloos de neige, demeures primitives des Groenlandais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3408f2-7b10-36a4-9717-a257c115baa2",
                                        "entry_id": "87924172-06d3-3841-a640-13ba3a6af376",
                                        "glosses": [
                                            "Retard, temps qui court au-delà du terme où l’on est tenu de payer ou de faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee35f18-7c4d-49b5-9971-53ca62b4f775",
                                                "sense_id": "6e3408f2-7b10-36a4-9717-a257c115baa2",
                                                "text": "Être en demeure de livrer une chose."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demeure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8513ca6-5012-3dc7-9e33-f0c9c183759f",
                                        "entry_id": "a3c9e157-cebd-39ab-b9dc-741a145e6f89",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de demeurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50a30deb-cc3b-312a-9330-a1d8cd15b134",
                                        "entry_id": "a3c9e157-cebd-39ab-b9dc-741a145e6f89",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de demeurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5747f1f-13bd-4a0a-8b01-78093bd1baa7",
                                                "sense_id": "50a30deb-cc3b-312a-9330-a1d8cd15b134",
                                                "text": "La respiration demeure calme, le cœur est encore bon, mais le sang lui dégouline du crâne sur le nez, dans les yeux, poisse la chemise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82236c6e-11cc-3e94-af13-ed75412bf0b8",
                                        "entry_id": "a3c9e157-cebd-39ab-b9dc-741a145e6f89",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de demeurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54a46256-0081-3f21-bfc2-e7f9c7882b14",
                                        "entry_id": "a3c9e157-cebd-39ab-b9dc-741a145e6f89",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de demeurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "477ba7f0-1c9c-48bd-b847-be702c8f8316",
                                                "sense_id": "54a46256-0081-3f21-bfc2-e7f9c7882b14",
                                                "text": "Produire propre, telle est la devise des fromagers d’aujourd'hui qui traquent avec acharnement le staphylo et la lystéria, tout en essayant de préserver le lait et sa biologie particulière pour qu’il demeure aussi fromageable qu’il y a 30 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "944f0ae4-4ff4-3232-9a93-b08f6ab8be6a",
                                        "entry_id": "a3c9e157-cebd-39ab-b9dc-741a145e6f89",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de demeurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
