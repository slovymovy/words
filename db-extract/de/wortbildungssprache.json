                "senses": [
                    {
                        "sense_id": "9344c26f-d749-319b-a68d-3d1218652e26",
                        "entry_id": "277d2bf9-73fe-351c-bc37-85af1ee1dddc",
                        "glosses": [
                            "Sprache, die von den Möglichkeiten der Wortbildung reichlich Gebrauch macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70a6224d-5bf0-48f1-9454-521fc71c1cba",
                                "sense_id": "9344c26f-d749-319b-a68d-3d1218652e26",
                                "text": "„Das Deutsche ist eine Wortbildungssprache.“"
                            },
                            {
                                "example_id": "e0a771e7-32b9-494a-b083-a5361837ae3f",
                                "sense_id": "9344c26f-d749-319b-a68d-3d1218652e26",
                                "text": "„Wenn das Deutsche als ›Wortbildungssprache‹ bezeichnet wird, schwingt oft genug ebenfalls etwas von Wertungen dieser Art mit.“"
                            },
                            {
                                "example_id": "80c2ffd1-0a02-42bb-981b-c000b295b973",
                                "sense_id": "9344c26f-d749-319b-a68d-3d1218652e26",
                                "text": "„Die Linguistin Katrin Hein bietet in ihrem Vortrag Das Deutsche als Wortbildungssprache einen Überblick über die wichtigsten Mittel zur Schaffung neuer Lexeme und untersucht die spezifische Qualität der so entstandenen Wörter, auch in ihrem textlichen Umfeld.“"
                            },
                            {
                                "example_id": "8d27d838-1477-4ea5-b312-cb6f5165ed20",
                                "sense_id": "9344c26f-d749-319b-a68d-3d1218652e26",
                                "text": "„Damit leugne man, daß das Deutsche eine Wortbildungssprache ist, kritisiert Henne.“"
                            },
                            {
                                "example_id": "2d2a828e-fd87-42d2-b22c-8ed844839bcb",
                                "sense_id": "9344c26f-d749-319b-a68d-3d1218652e26",
                                "text": "„Im Unterschied zu anderen germanischen Sprachen wird das Deutsche als eine ausgeprägte Wortbildungssprache bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
