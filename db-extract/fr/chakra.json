                "senses": [
                    {
                        "sense_id": "2890f33d-457e-37c0-9ce7-b9892631a80d",
                        "entry_id": "97b2ef63-d4f3-3fa0-a47e-421ee48fd342",
                        "glosses": [
                            "Région du corps dans le yoga tantrique."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "c8fdf6a5-e94a-4114-b168-2583cd60c4ff",
                                "sense_id": "2890f33d-457e-37c0-9ce7-b9892631a80d",
                                "text": "Une mandale, chérie, je lui ai collé une petite mandale pour qu’il nous raconte ce qui s’était passé. […] Ça lui a réaligné les chakras, c’est comme ça que ça marche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3aee681-874b-43d4-83f0-f52f21c3b826",
                        "source_entry_id": "97b2ef63-d4f3-3fa0-a47e-421ee48fd342",
                        "source_sense_id": "2890f33d-457e-37c0-9ce7-b9892631a80d",
                        "target_lang_word": "Chakra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chakra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                        "entry_id": "80b84ffe-53a3-3496-98ad-156c1d69e69d",
                                        "glosses": [
                                            "Akupunktur, Esoterik, Meditation, Spiritualismus, Bezeichnung für eins der energetischen Zentren des Körpers, verantwortlich für den Austausch von Bioenergie; energetischer Wirbel, Zentrum für spiritueller Kraft oder psychische Energie"
                                        ],
                                        "tags": [
                                            "Yoga (indische Lehre)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52133feb-9bbe-4e52-a29d-0eee4a71e7a3",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "Die Energie, die durch das Sex-Chakra fließt, nennt man Kundalini."
                                            },
                                            {
                                                "example_id": "ee76027d-924c-4fdb-b283-8e6b0c82245b",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "„Stellen Sie sich vor, dass die Seele, die Prinzessin Diana war, genau auf diese Weise zu sterben wählte, wie sie es tat, um das Herz-Chakra Englands zu öffnen.“"
                                            },
                                            {
                                                "example_id": "b1504764-b61e-49f3-9ac8-d54aa1273d76",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "„Man geht davon aus, dass jedes Chakra physischen und psychischen Einfluss auf uns Menschen hat.“"
                                            },
                                            {
                                                "example_id": "4cd54778-52ce-4cd1-a3ee-51a4afc9f409",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "„Mein Freund hat durch viel Übung permanent alle Chakren offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64a17a2c-27a3-496c-8508-7807b7de615e",
                        "source_entry_id": "97b2ef63-d4f3-3fa0-a47e-421ee48fd342",
                        "source_sense_id": "2890f33d-457e-37c0-9ce7-b9892631a80d",
                        "target_lang_word": "chakra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chakra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e8c67dc-5787-33c3-8b17-e5b87c455286",
                                        "entry_id": "cd66d207-1aa1-3dc7-9cb9-67e7328f643c",
                                        "glosses": [
                                            "Any of (at least) seven centres of spiritual energy in or near the body, according to Ayurveda philosophy."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dac9572-a8d6-4cbf-b0ea-9f602bad8adc",
                                                "sense_id": "3e8c67dc-5787-33c3-8b17-e5b87c455286",
                                                "text": "In the etheric body of a yogini in meditation, the polarity is, therefore, not between the brain and the genitals, the second and sixth chakras, but between the inner sexuality of the womb and the heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a82c5fc-6d2d-361a-aac9-88088cb3ca69",
                                        "entry_id": "cd66d207-1aa1-3dc7-9cb9-67e7328f643c",
                                        "glosses": [
                                            "Synonym of hackery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "808ad520-b2a0-4abf-8cbe-37076dedbdf2",
                                                "sense_id": "4a82c5fc-6d2d-361a-aac9-88088cb3ca69",
                                                "text": "...bahlis, chakras, bullock-carts, dolis, tattus, palkis, miyanas, kharkharinas, bajras and chaupalas, were the common vehicles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
