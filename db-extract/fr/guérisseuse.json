                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf267fe8-56e3-40d2-9d0d-afa3b06d8152",
                        "entry_id": "0da8fcd7-f446-3957-a5e5-245a8fc04970",
                        "tags": [
                            "plural"
                        ],
                        "form": "guérisseuses"
                    },
                    {
                        "form_id": "d348db13-329b-483f-b7ee-3709f477c0be",
                        "entry_id": "0da8fcd7-f446-3957-a5e5-245a8fc04970",
                        "tags": [
                            "masculine"
                        ],
                        "form": "guérisseur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80053c0e-d049-3586-98b9-6653e5da822e",
                        "entry_id": "0da8fcd7-f446-3957-a5e5-245a8fc04970",
                        "glosses": [
                            "Celle qui prétend guérir, qui fait profession de guérir par des moyens empiriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c71f20-d3ee-40fd-89c1-0d4d92e1979b",
                                "sense_id": "80053c0e-d049-3586-98b9-6653e5da822e",
                                "text": "Quoique très nettement perceptibles dans le discours, ces oppositions théoriques servant à métaphoriser une frontière inaliénable fonctionnent à l’insu des malades, probablement aussi de la guérisseuse."
                            },
                            {
                                "example_id": "b4933f64-f882-4bf6-ba64-d748659cdbc3",
                                "sense_id": "80053c0e-d049-3586-98b9-6653e5da822e",
                                "text": "Prières musulmanes, pharmacopée traditionnelle, cérémonies de désenvoûtement: la guérisseuse conjugue ces méthodes dans un pays majoritairement musulman aux infrastructures de santé défaillantes et où les croyances traditionnelles restent vivaces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "086ae7cf-5a4f-440d-a54e-0e02e32fa53d",
                        "source_entry_id": "0da8fcd7-f446-3957-a5e5-245a8fc04970",
                        "source_sense_id": "80053c0e-d049-3586-98b9-6653e5da822e",
                        "target_lang_word": "Heilerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heilerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9eeff76f-daa7-3046-aa11-7c1fde8cb475",
                                        "entry_id": "2113d5cd-25cb-349c-b8f3-c9ea690581b2",
                                        "glosses": [
                                            "weibliche Person, die Heilung verschafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120ac709-3585-4429-a013-0c60c0d1e55b",
                                                "sense_id": "9eeff76f-daa7-3046-aa11-7c1fde8cb475",
                                                "text": "„Durch die Anwendung des Katzenhaares wird die raubkatzenförmig vorgestellte Göttin Sachmet symbolisch eingebunden, die als Auslöserin und gleichzeitig als Heilerin von Krankheiten aller Art gilt.“"
                                            },
                                            {
                                                "example_id": "c6516501-735f-4e96-9956-7ba2d9ea7cd9",
                                                "sense_id": "9eeff76f-daa7-3046-aa11-7c1fde8cb475",
                                                "text": "„Heilerinnen gab es im Stadtteil keine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20def910-b15e-4bac-accd-fa5737b60d30",
                        "source_entry_id": "0da8fcd7-f446-3957-a5e5-245a8fc04970",
