                                            {
                                                "example_id": "c3ba59c9-676f-43e4-93fe-b76db981add0",
                                                "sense_id": "48751a69-4018-3f63-b9a6-b34b5a11057e",
                                                "text": "a gradual increase of knowledge; a gradual decline"
                                            },
                                            {
                                                "example_id": "8159f747-3f4f-41e2-a42b-97a615f51560",
                                                "sense_id": "48751a69-4018-3f63-b9a6-b34b5a11057e",
                                                "text": "Creatures animate with gradual life / Of growth, sense, reason, all summed up in man."
                                            }
                                        ]
