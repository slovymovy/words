                "senses": [
                    {
                        "sense_id": "d1196f29-dcb2-381f-8667-a8ebdddef6a4",
                        "entry_id": "cf764a0d-9dcb-3bf9-a0c7-612796717e59",
                        "glosses": [
                            "ein Dokument, das die Staatsbürgerschaft bestätigt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "6b5d3b85-6f04-4e4b-b266-59d1fa7a727f",
                                "sense_id": "d1196f29-dcb2-381f-8667-a8ebdddef6a4",
                                "text": "„Die von den Behörden des anderen Vertragsstaates ausgestellten Personalausweise (Reisepässe, Staatsbürgerschaftsnachweis etc.), die durch die Einbürgerung ungültig werden, sind bei der Einbürgerung einzuziehen und der Mitteilung beizufügen.“"
                            },
                            {
                                "example_id": "75d0485d-5c1b-4d0f-9619-8066c452a959",
                                "sense_id": "d1196f29-dcb2-381f-8667-a8ebdddef6a4",
                                "text": "„Sie hatte ihren Staatsbürgerschaftsnachweis vergessen und durfte deshalb nicht zur Prüfung antreten.“"
                            },
                            {
                                "example_id": "3c763a15-b853-4acc-a800-088363e8755a",
                                "sense_id": "d1196f29-dcb2-381f-8667-a8ebdddef6a4",
                                "text": "„Seit Jahresbeginn stellen im Zuge der Bemühungen der Stadt Wien um Verwaltungsvereinfachung nun auch die Magistratischen Bezirksämter (MBA) den Staatsbürgerschaftsnachweis aus.“"
                            },
                            {
                                "example_id": "7574d854-7de2-4a23-b3ef-9025356936bc",
                                "sense_id": "d1196f29-dcb2-381f-8667-a8ebdddef6a4",
                                "text": "„Inspektor ‚Fleche le Bosseur‘ ist laut Staatsbürgerschaftsnachweis ein belgischer Schäferhund und laut Geburtsurkunde am 24. Mai 2001 in Waidhofen an der Thaya im Waldviertel geboren.“"
                            },
                            {
                                "example_id": "8646c5cb-0f4d-4c66-81f7-1de50cb9275b",
                                "sense_id": "d1196f29-dcb2-381f-8667-a8ebdddef6a4",
                                "text": "„Drei Wochen später war Jasmine österreichische Staatsbürgerin und hielt ihren Staatsbürgerschaftsnachweis in der Hand.“"
                            },
                            {
                                "example_id": "7b99581e-81c0-4c70-8433-13527fdde955",
                                "sense_id": "d1196f29-dcb2-381f-8667-a8ebdddef6a4",
                                "text": "„Um [die Geburtsurkunde des Kindes] zu erhalten, braucht die Mutter für sich einen Staatsbürgerschaftsnachweis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
