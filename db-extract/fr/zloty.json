                        "examples": [
                            {
                                "example_id": "2534ca10-deba-4802-a9fe-eb166b2a1334",
                                "sense_id": "87919002-035e-388d-805f-0035b5043368",
                                "text": "Un zloty vaut 100 groszy."
                            },
                            {
                                "example_id": "e9c993fb-2b83-4e84-a117-f4ff081cf53e",
                                "sense_id": "87919002-035e-388d-805f-0035b5043368",
                                "text": "La valeur du zloty est soutenue grâce à un fonds de stabilisation garanti par l’aide occidentale à la Pologne."
                            },
                            {
                                "example_id": "20750d8b-7fc5-4cee-9f4c-ce2d0e70f6ed",
                                "sense_id": "87919002-035e-388d-805f-0035b5043368",
                                "text": "L’invitation à dîner n’en était pas une, l’addition me fut présentée, non pas en zlotys mais en dollars, et ce n’était pas rien : 150 dollars."
                            }
                        ]
