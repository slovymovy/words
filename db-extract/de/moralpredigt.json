                    }
                ],
                "senses": [
                    {
                        "sense_id": "517481f7-186c-3320-aa02-b65f01623990",
                        "entry_id": "a8a46d89-433e-36bc-a23d-16bc2177b773",
                        "glosses": [
                            "intensive Aufforderung zu sittlichem Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35525377-8a13-445a-8092-5d8405735707",
                                "sense_id": "517481f7-186c-3320-aa02-b65f01623990",
                                "text": "„Der moderne Mensch möchte in dem, worüber er lacht, nicht auch noch belehrt werden; er ist allergisch gegen jede Moralpredigt.“"
                            },
                            {
                                "example_id": "ed10ad3a-88d3-40f2-9e4e-febdae38a3dd",
                                "sense_id": "517481f7-186c-3320-aa02-b65f01623990",
                                "text": "„Alles ist hier schön an seinem Ort, Hoffmann führt Regie, und wir spüren, daß es ihm sehr viel leichter fällt, einen Maler einen alten Geizhals prellen zu lassen, als einer vornehmen französischen Dame eine Moralpredigt in den Mund zu legen.“"
                            },
                            {
                                "example_id": "d82aeeca-2344-4e89-bb36-c3c6c6faf3f0",
                                "sense_id": "517481f7-186c-3320-aa02-b65f01623990",
                                "text": "„Signor Grimani nahm mich wieder nach Hause mit und hielt mir unterwegs eine Moralpredigt, über die ich nur lachen konnte.“"
                            },
                            {
                                "example_id": "9361d0f0-94b8-4f49-b554-d6a6c08094be",
                                "sense_id": "517481f7-186c-3320-aa02-b65f01623990",
                                "text": "„Wie genervt er von Bess' und Hermans Moralpredigten war, ließ er sich nicht anmerken, nicht zuletzt, weil er ihre Kinder liebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
