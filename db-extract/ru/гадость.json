                        "entry_id": "bd7182aa-30ae-3b9e-a4cd-0a9112ee63f0",
                        "glosses": [
                            "нечто крайне неприятное, вредное, некрасивое, грязное, подлое, невкусное и т. п."
                        ],
                        "tags": [],
