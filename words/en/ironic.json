{
    "word_family": [
        "irony",
        "ironically",
        "ironist",
        "unironic"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                    "sense_definition": "Relating to a situation that is strange or funny because things happen in a way that seems the opposite of what you expected.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "situational_irony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>ironic</w> that the memory expert forgot where he parked his car.",
                            "target_lang_translations": {
                                "ru": "<w>Иронично</w>, что эксперт по памяти забыл, где припарковал свою машину."
                            }
                        },
                        {
                            "text": "The <w>ironic</w> twist in the story made the ending very memorable for the readers.",
                            "target_lang_translations": {
                                "ru": "<w>Ироничный</w> поворот в сюжете сделал финал очень запоминающимся для читателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "ironical"
                    ],
                    "common_phrases": [
                        "ironic twist",
                        "ironic situation",
                        "ironic coincidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к ситуации, которая кажется странной или забавной, потому что события происходят вопреки ожиданиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ироничный",
                                "target_lang_sense_clarification": "о ситуации или совпадении"
                            },
                            {
                                "target_lang_word": "парадоксальный",
                                "target_lang_sense_clarification": "противоречащий ожиданиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e51c42a-f78a-35f8-b2bf-1dd068d12348",
                    "sense_definition": "Using words that mean the opposite of what you really think in order to be funny or to make a point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_irony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave an <w>ironic</w> smile when he saw the mess in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Он <w>иронически</w> улыбнулся, когда увидел беспорядок на кухне."
                            }
                        },
                        {
                            "text": "Her <w>ironic</w> tone suggested that she wasn't actually happy about the news.",
                            "target_lang_translations": {
                                "ru": "Ее <w>ироничный</w> тон намекал на то, что на самом деле она не была рада новостям."
                            }
                        }
                    ],
                    "synonyms": [
                        "ironical"
                    ],
                    "antonyms": [
                        "sincere"
                    ],
                    "common_phrases": [
                        "ironic tone",
                        "ironic comment",
                        "ironic smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование слов, имеющих противоположное значение тому, что вы на самом деле думаете, ради шутки или чтобы подчеркнуть мысль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иронический",
                                "target_lang_sense_clarification": "о тоне, улыбке или стиле речи"
                            },
                            {
                                "target_lang_word": "ироничный",
                                "target_lang_sense_clarification": "содержащий иронию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa5eab24-ba43-31e4-9f45-e5626c4d420f",
                    "sense_definition": "Acting in a way that is not serious, often teasing or mocking others in a playful manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal_irony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't take his comments seriously; he is just being <w>ironic</w> to lighten the mood.",
                            "target_lang_translations": {
                                "ru": "Не принимайте его слова всерьез; он просто <w>иронизирует</w>, чтобы разрядить обстановку."
                            }
                        },
                        {
                            "text": "The group shared an <w>ironic</w> laugh about their failed attempt to cook dinner.",
                            "target_lang_translations": {
                                "ru": "Группа <w>иронично</w> посмеялась над своей неудачной попыткой приготовить ужин."
                            }
                        }
                    ],
                    "antonyms": [
                        "serious"
                    ],
                    "common_phrases": [
                        "being ironic",
                        "ironic humor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поведение, которое не является серьезным, часто подшучивание или насмешка в игривой манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ироничный",
                                "target_lang_sense_clarification": "о поведении или чувстве юмора"
                            },
                            {
                                "target_lang_word": "насмешливый",
                                "target_lang_sense_clarification": "в шутливой форме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}