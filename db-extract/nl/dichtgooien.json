                    {
                        "translation_id": "b6969b3a-f4af-4461-b446-b6c493c0756f",
                        "source_entry_id": "00e113aa-f54b-3aff-8753-e4456e5844cc",
                        "source_sense_id": "440ada01-4361-3c4b-a8ed-1dd9b6a0c725",
