                "senses": [
                    {
                        "sense_id": "a64c4cba-3672-3aa1-8e6e-10245a6c0272",
                        "entry_id": "44b5ff34-b466-3789-9597-01b087bd5191",
                        "glosses": [
                            "кочевница, представительница народа, живущего в пустынях Передней Азии и Северной Африки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63eb7997-e181-406a-a167-67b6c7a09135",
                                "sense_id": "a64c4cba-3672-3aa1-8e6e-10245a6c0272",
                                "text": "Только одна бедуинка пристала к нашему каравану, куря трубку и догоняя наших лошадей и верблюдов."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c87ba97-fe87-3a48-8a8e-ccdd975e4255",
                        "entry_id": "44b5ff34-b466-3789-9597-01b087bd5191",
                        "glosses": [
                            "неодуш., устар. вид дамского шарфа 3 2 13."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52a0bb0-1fd0-4ac3-b4d7-e80bf2988cfb",
                                "sense_id": "7c87ba97-fe87-3a48-8a8e-ccdd975e4255",
                                "text": "Несколько дней спустя, по Невскому несся щегольской фаэтон. В нем сидела в роскошной бедуинке Моничка."
                            },
                            {
                                "example_id": "8d6f13ee-21d5-4157-863e-e4764e59877c",
                                "sense_id": "7c87ba97-fe87-3a48-8a8e-ccdd975e4255",
                                "text": "Какой гибкий стан, как драпируется на нем белая, как снег бедуинка, ярко вырезающаяся на голубом платье."
                            }
                        ]
                    }
