                ],
                "senses": [
                    {
                        "sense_id": "05cd866d-c871-37e7-be16-0246f6a2ac58",
                        "entry_id": "8c1cbe66-6b4e-37ef-8ddf-41b490acf771",
                        "glosses": [
                            "Réparer (une carrosserie qui a été emboutie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c116671-849f-49a1-8177-75341e9def2a",
                                "sense_id": "05cd866d-c871-37e7-be16-0246f6a2ac58",
                                "text": "Installé en Corse, officiellement pour y implanter des machines à désemboutir les carrosseries dans les casses de voitures, Paul Grimaldi transforme en fait, selon les gendarmes, des jeux électroniques en machines à sous avec des systèmes de cartes à puce fabriqués en Auvergne par la société Techtronic."
                            },
                            {
                                "example_id": "6b5a3bae-dbea-4afb-8fc9-f690d668ecda",
                                "sense_id": "05cd866d-c871-37e7-be16-0246f6a2ac58",
                                "text": "Cinq mille francs, j’ai de quoi désemboutir mon aile et m’offrir quelques babioles."
                            }
                        ]
                    },
                    {
                        "sense_id": "bee27cd2-03dc-37de-b506-1a045b2c43fc",
                        "entry_id": "8c1cbe66-6b4e-37ef-8ddf-41b490acf771",
                        "glosses": [
                            "Perdre son caractère embouti, arrondi."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0799c39e-5d9a-43d4-aa07-85d1b16fa27f",
                                "sense_id": "bee27cd2-03dc-37de-b506-1a045b2c43fc",
                                "text": "Il en est de même des poulies en tôle emboutie, qui soumises à de fortes charges et à de grandes vitesses, tendent à se désemboutir."
                            }
                        ]
                    }
                ],
