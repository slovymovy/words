                                        "sense_id": "a484cd27-1a22-37e1-ac5c-0bce470a137d",
                                        "entry_id": "388c054a-4547-313f-afe5-91b0684ade48",
                                        "glosses": [
                                            "Of, from, or pertaining to the Congo or any Congolese state."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
