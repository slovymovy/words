                                        "examples": [
                                            {
                                                "example_id": "8f013da7-0aad-44ce-b810-af378814e0fe",
                                                "sense_id": "03ec5dba-290e-3de6-ba83-b6fdc059d878",
                                                "text": "Er schürfte sich bei dem Sturz vom Fahrrad sein Knie."
                                            }
                                        ],
