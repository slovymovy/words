                "senses": [
                    {
                        "sense_id": "15d5ac05-40a2-3bc8-8563-3e243e800f71",
                        "entry_id": "6da56ff5-770c-36b2-9145-e2b56dcc18be",
                        "glosses": [
                            "To move (something) with short, quick motions; to wobble."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ed777e1b-93e6-470b-bab7-34f6c4de339b",
                                "sense_id": "15d5ac05-40a2-3bc8-8563-3e243e800f71",
                                "text": "The Mole waggled his toes from sheer happiness, spread his chest with a sigh of full contentment, and leaned back blissfully into the soft cushions."
                            },
                            {
                                "example_id": "ea3e1c61-8a9a-4655-bd2e-a26cdfb8fd0d",
                                "sense_id": "15d5ac05-40a2-3bc8-8563-3e243e800f71",
                                "text": "Oscar turned to someone who wasn't there and waggled his head. \"Hoo, boy,\" he said."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b14472d-0fee-3785-8ab2-cab2a804f259",
                        "entry_id": "6da56ff5-770c-36b2-9145-e2b56dcc18be",
                        "glosses": [
                            "To quickly raise and lower in rapid succession, usually as an implication of slyness, smugness, or suggestiveness."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "92861db9-1a80-3164-a1d9-218a7973aa21",
                        "entry_id": "6da56ff5-770c-36b2-9145-e2b56dcc18be",
                        "glosses": [
                            "To reel, sway, or move from side to side; to move with a wagging motion; to waddle."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4e81721b-ce1e-4768-9202-84e0e7799b2b",
                                "sense_id": "92861db9-1a80-3164-a1d9-218a7973aa21",
                                "text": "I know you by the waggling of your head."
                            },
                            {
                                "example_id": "74ec83f0-6a71-4cb6-ad9f-e61d860f6ba6",
                                "sense_id": "92861db9-1a80-3164-a1d9-218a7973aa21",
                                "text": "Why do you go Nodding and Waggling so like a Fool, as if you were Hipshot? says the Goose to her Gosselin."
                            },
                            {
                                "example_id": "ef606d0c-5db7-478a-90a7-500f8fe4e1f6",
                                "sense_id": "92861db9-1a80-3164-a1d9-218a7973aa21",
                                "text": "The tassel on the end of his pigtail waggled all down the path and, as he turned out of the gate, it gave a special little flip."
                            }
                        ]
                    }
                ],
