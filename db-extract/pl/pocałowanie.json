                        "glosses": [
                            "dotknięcie ustami kogoś, rzadziej czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c488931-4a9c-4407-ad8c-ff7be40a5be2",
                                "sense_id": "b5e72909-ca66-3e65-8650-2b46fef0a86a",
                                "text": "Vimes, stworzony przez naturę jako jeden z tych mężczyzn, którzy nie są zdolni do pocałowania publicznie własnej żony, poklepał ją bezradnie po ramieniu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e3150d26-6610-3d83-a613-4dee1c9fe997",
                        "entry_id": "cbd9d0af-545f-31f1-8f46-382722fc0efe",
                        "glosses": [
                            "pocałunek"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "dec13007-b894-4a2d-9c23-d4a3b66f8954",
                                "sense_id": "e3150d26-6610-3d83-a613-4dee1c9fe997",
                                "text": "Najprzód w Ogrójcu wziął pocałowanie, // tam Judasz zdrajca dał był Żydom znamię: // Oto, Żydowie, mego mistrza macie, // tegoż imajcie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
