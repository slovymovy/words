                        "phare maritime"
                    ]
                },
                {
                    "sense_id": "ad7bee67-ffa2-387b-9d1a-d8b711670d25",
                    "sense_definition": "Projecteur puissant installé à l'avant d'un véhicule permettant d'éclairer la route.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eclairage_vehicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu devrais allumer les <w>phares</w> de ta voiture, car le brouillard devient vraiment très épais."
                        },
                        {
                            "text": "L'automobiliste en face a oublié d'éteindre ses pleins <w>phares</w>, ce qui nous a complètement éblouis."
                        }
                    ],
                    "synonyms": [
                        "projecteur"
                    ],
                    "common_phrases": [
                        "pleins phares",
                        "allumer les phares",
                        "coup de phares"
                    ]
                },
                {
                    "sense_id": "448fbb11-3f3a-314a-a235-06b47cf036d1",
                    "sense_definition": "Personne remarquable ou œuvre marquante qui guide et influence profondément son époque.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "luminaire_spirituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur talentueux a longtemps été considéré comme un véritable <w>phare</w> de la littérature contemporaine."
                        },
                        {
                            "text": "Ses réflexions philosophiques ont servi de <w>phare</w> pour toute une génération d'intellectuels engagés."
