                        "form": "polysyndètes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18df2bf5-b9d3-357c-9fe0-ecd1fc7657e4",
                        "entry_id": "05229cd7-8f01-3679-9725-d433bd78f4ec",
                        "glosses": [
                            "Figure de style reposant sur un mode de liaison consistant à mettre une conjonction de coordination plus souvent que ne l'exige l'ordre grammatical."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "8d4c9d61-2131-47b8-b74e-d655f1e0e136",
                                "sense_id": "18df2bf5-b9d3-357c-9fe0-ecd1fc7657e4",
                                "text": "La polysyndète permet donc de créer la figure de l’hyperbate : le membre nouvellement coordonné transgresse la clôture précédemment posée."
                            },
                            {
                                "example_id": "44fe36a2-18ce-407d-b2d9-e6d8cd40ad6e",
                                "sense_id": "18df2bf5-b9d3-357c-9fe0-ecd1fc7657e4",
                                "text": "Vous laisserez de côté la parataxe, avec l'asyndète et la polysyndète : ce serait faire trop de bruit pour une seule phrase ; ce serait en faire trop pour toute une œuvre qui ne hausse jamais le ton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "492c1c3f-c502-400c-8cac-0e46e59ab121",
                        "source_entry_id": "05229cd7-8f01-3679-9725-d433bd78f4ec",
                        "source_sense_id": "18df2bf5-b9d3-357c-9fe0-ecd1fc7657e4",
                        "target_lang_word": "polysyndeton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polysyndeton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "016098c1-36ff-38c4-9eb0-0b68174cb690",
                                        "entry_id": "cf2d0fe2-49cf-3736-8aea-560907fa0dae",
                                        "glosses": [
                                            "The use of many conjunctions to achieve an overwhelming effect in a sentence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "580c2898-2c5e-47c4-8a5f-ae8eacec6d26",
                                                "sense_id": "016098c1-36ff-38c4-9eb0-0b68174cb690",
                                                "text": "In Polysyndeton conjunctions flow,\nAnd every word its copulative will shew."
                                            },
                                            {
                                                "example_id": "3e7d3f63-6f17-43fe-bec7-103167907504",
                                                "sense_id": "016098c1-36ff-38c4-9eb0-0b68174cb690",
                                                "text": "[Hemingway] often employs a variety of polysyndeton—a frequent use of conjunctions, most notably “and”—linking elements in a sentence together in a way that implies all parts are of equal importance, while in fact one unit of the series may be much more significant than the others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
