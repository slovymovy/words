                ],
                "senses": [
                    {
                        "sense_id": "0fa85a2c-b7ca-3766-b5fe-7481f0c40418",
                        "entry_id": "ad58e74a-59a8-3498-bff7-28029c1d2812",
                        "glosses": [
                            "Qui a prêté serment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e2bd100-f83d-4f87-a3a2-7caa2d9e8664",
                                "sense_id": "0fa85a2c-b7ca-3766-b5fe-7481f0c40418",
                                "text": "Avec six autres membres, en effet, Bosch paie sa quote-part pour assister au banquet traditionnel de la Confrérie de Notre-Dame organisé en l’honneur de frères nouvellement assermentés […]"
                            },
                            {
                                "example_id": "bc596165-0c51-426d-a76d-85b9a9ea5a3b",
                                "sense_id": "0fa85a2c-b7ca-3766-b5fe-7481f0c40418",
                                "text": "Garde assermenté. Expert assermenté. Traducteur assermenté."
                            },
                            {
                                "example_id": "70e171fa-ba4d-42cc-8a27-e4ff511d1407",
                                "sense_id": "0fa85a2c-b7ca-3766-b5fe-7481f0c40418",
                                "text": "La préfecture la somme de prouver qu’elle a bien obtenu la nationalité cinquante ans plus tôt – extrait de l’acte de naissance, traduction par un professionnel assermenté, copie de l’acte de mariage, du jugement de divorce, et bien d’autres documents qui n’arrivent jamais au bon endroit, qui se perdent dans des services où on s’en fout, il faut recommencer à zéro, ainsi que la photo non conforme, trop de frange, eh non, encore raté, pas de foulard autour du cou, désolée madame, c’est pas moi qui fais la loi."
                            }
                        ]
                    },
                    {
                        "sense_id": "12b0798b-96eb-3700-b440-001f0f698cee",
                        "entry_id": "ad58e74a-59a8-3498-bff7-28029c1d2812",
                        "glosses": [
                            "Qualifiait les prêtres qui avaient prêté serment à la constitution civile du clergé."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "a209ff2a-ac46-41a8-8950-edfdee41c8b0",
                                "sense_id": "12b0798b-96eb-3700-b440-001f0f698cee",
                                "text": "Vous avez donné asile, reprit-il, à un vénérable prêtre non assermenté, qui a miraculeusement échappé aux massacres des Carmes."
                            },
                            {
                                "example_id": "76846baf-43b5-48e2-b793-bb2d339fe3b9",
                                "sense_id": "12b0798b-96eb-3700-b440-001f0f698cee",
                                "text": "Ne rencontrant personne dans sa famille avec qui son âme, tout expansive mais toujours comprimée depuis notre séparation, pût sympathiser, il se réfugia chez son oncle, nommé son tuteur, et qui, chassé de sa cure en sa qualité de prêtre assermenté, était venu demeurer à Blois."
                            }
                        ]
                    }
