                ],
                "senses": [
                    {
                        "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                        "entry_id": "d9d3d60c-d3c1-337a-a295-4731b9e3a8cc",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "458f9ddd-38de-4a0b-861d-1583f267a41e",
                                "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                                "text": "Frau Holbein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b94f6b17-712a-4531-9fa1-bacd64dd1361",
                                "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                                "text": "Herr Holbein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0b32729d-0cdb-4e6f-be13-cedf7ee4411c",
                                "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                                "text": "Die Holbeins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4cdbdb91-de84-4f6b-b0fc-8d4c34d65d80",
                                "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                                "text": "Der Holbein trägt nie die Schals, die die Holbein ihm strickt."
                            },
                            {
                                "example_id": "ec00d4b7-36e2-41e4-8d1c-c6c72e63dcb8",
                                "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Holbein kommt, geht der Herr Holbein.“"
                            },
                            {
                                "example_id": "cc09dcba-9150-46d3-9122-4f5272c1d8e1",
                                "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                                "text": "Holbein kommt und geht."
                            },
                            {
                                "example_id": "5e4ab123-a1c8-4475-b75a-27b7a3c628d3",
                                "sense_id": "22f88ca7-9fd1-3d13-ad18-be5a2c9a0f29",
                                "text": "Holbeins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
