                "senses": [
                    {
                        "sense_id": "5635fe4b-3689-3c7a-8dba-e4af094f6637",
                        "entry_id": "c49738d2-3f8a-3cdc-b09d-5e53752d54f8",
                        "glosses": [
                            "Zustand oder Eigenschaft, in einer bestimmten Sache unterlegen (schwächer, schlechter) zu sein"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "282740ff-9040-4599-848f-6fb082209fa4",
                                "sense_id": "5635fe4b-3689-3c7a-8dba-e4af094f6637",
                                "text": "„Bin ich selbstverliebt, bloß weil ich zu oft in den Spiegel schaue und andere Menschen vielleicht zu oft ihre Unterlegenheit spüren lasse?“"
                            },
                            {
                                "example_id": "e9d2f015-112e-47f8-b182-8d39bf6b044d",
                                "sense_id": "5635fe4b-3689-3c7a-8dba-e4af094f6637",
                                "text": "„Wie schon so oft wurde Sabina sich ihrer Unterlegenheit bewußt, spürte sie das Drohen riesiger Gefahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
