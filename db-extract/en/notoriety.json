                        "form": "notorieties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17f05999-acf4-3950-894e-821d8a550718",
                        "entry_id": "0cd5e1f2-ea2b-3570-ac38-904dd9a53e17",
                        "glosses": [
                            "An infamous or notorious condition or reputation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9e6b2cd4-c35c-4c18-b4ca-fd2fe407e24e",
                                "sense_id": "17f05999-acf4-3950-894e-821d8a550718",
                                "text": "[H]e who portrays examples of disinterestedness and intrepidity, confers on virtue the notoriety and homage that are due to it, and rouses in the spectators, the spirit of salutary emulation."
                            },
                            {
                                "example_id": "0a9999e5-b3ee-4140-919e-c89daf861383",
                                "sense_id": "17f05999-acf4-3950-894e-821d8a550718",
                                "text": "I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me. I look upon notoriety with the same indifference as on the buttons on a man's shirt-front, or the crest on his note-paper."
                            },
                            {
                                "example_id": "b00c1451-6f11-4549-bda4-e231c7004a86",
                                "sense_id": "17f05999-acf4-3950-894e-821d8a550718",
                                "text": "This seems to me to be a reasonable request, and I will try to explain to you what it is that has given me this false notoriety; so please give me your attention."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
