                ],
                "senses": [
                    {
                        "sense_id": "a0d0c2d2-9271-30b1-914a-2017ca5ecd73",
                        "entry_id": "fb10734a-b2a0-3ead-bf8b-acc5dda7232c",
                        "glosses": [
                            "Celui qui ordonne, qui dispose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ffa36e7-3cfe-4b49-b789-a70d1acf1d76",
                                "sense_id": "a0d0c2d2-9271-30b1-914a-2017ca5ecd73",
                                "text": "Ordonnateur d’une fête publique, d’un banquet."
                            },
                            {
                                "example_id": "2c95658c-2d65-4b89-bfb6-4e202ff0e453",
                                "sense_id": "a0d0c2d2-9271-30b1-914a-2017ca5ecd73",
                                "text": "Ordonnateur des pompes funèbres."
                            },
                            {
                                "example_id": "23314597-1a83-4a52-b61f-7fde51143ea4",
                                "sense_id": "a0d0c2d2-9271-30b1-914a-2017ca5ecd73",
                                "text": "Tout à fait devant, conduisant le cortège, l’ordonnateur avec sa canne à pommeau d’argent et son bicorne à cocarde."
                            },
                            {
                                "example_id": "f983a8dc-8ada-47e5-87c9-e3328e9e1dcf",
                                "sense_id": "a0d0c2d2-9271-30b1-914a-2017ca5ecd73",
                                "text": "Les ordonnatrices d’une vente de charité."
                            },
                            {
                                "example_id": "6aeadb0a-bc21-49ef-8b78-02dcaea013bb",
                                "sense_id": "a0d0c2d2-9271-30b1-914a-2017ca5ecd73",
                                "text": "Une grande fête, lorsque Paul Fort en est l’ordonnateur, prend aussitôt des proportions immenses."
                            }
                        ]
                    },
                    {
                        "sense_id": "a36026e9-5e48-36d2-a9e7-e6b60f9e2d0c",
                        "entry_id": "fb10734a-b2a0-3ead-bf8b-acc5dda7232c",
                        "glosses": [
                            "Celui qui est qualifié pour ordonnancer des paiements."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "627773a0-e4f0-4f20-be31-8d64d797bda4",
                                "sense_id": "a36026e9-5e48-36d2-a9e7-e6b60f9e2d0c",
                                "text": "Tout d’abord, ce régime était complexe, puisque deux régimes de responsabilité coexistaient : les comptables publics étaient jugés par la Cour des comptes et les CRTC, tandis que les ordonnateurs et autres gestionnaires publics, dès lors qu’ils prenaient des décisions en matière financière, relevaient de la CBDF."
                            },
                            {
                                "example_id": "36341ac7-0108-4d4f-b6ae-664c511facee",
                                "sense_id": "a36026e9-5e48-36d2-a9e7-e6b60f9e2d0c",
                                "text": "Ce mandat doit porter la signature de l’ordonnateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5545aa6e-77dc-47ab-9c02-748ee1be219c",
                        "source_entry_id": "fb10734a-b2a0-3ead-bf8b-acc5dda7232c",
