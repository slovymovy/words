                "senses": [
                    {
                        "sense_id": "1427c4cf-d47f-39bc-8217-23583af69b94",
                        "entry_id": "ffab1030-b192-38af-84d5-30272ebc0528",
                        "glosses": [
                            "erneute Urbarmachung von durch menschlichen Einfluss (meist Bergbau oder Deponien) unfruchtbar gewordenem Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5760c5c-3348-4041-9278-cf0cb3a332e7",
                                "sense_id": "1427c4cf-d47f-39bc-8217-23583af69b94",
                                "text": "„Man müsse im Vorfeld wissen, wie die Gesamtplanung aussehe, wenn Anfragen von Fachbehörden oder Ämtern, vor allem mit der Fragestellung der Rekultivierung, kämen.“"
                            },
                            {
                                "example_id": "6198a1d4-fe80-434c-b650-4bd84a85ae9e",
                                "sense_id": "1427c4cf-d47f-39bc-8217-23583af69b94",
                                "text": "„Der Zweckverband Abfallwirtschaft Oberes Elbetal bekommt vom Land 425 000 Euro Fördermittel für die Rekultivierung der Deponie Nossen (Landkreis Meißen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
