                "senses": [
                    {
                        "sense_id": "2d0d049e-a304-3f85-846c-08c0b7655c6b",
                        "entry_id": "6f3d4df0-ec08-3291-9def-6da7ad10dc2f",
                        "glosses": [
                            "Werbefachmann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e7a28bfc-315b-47f6-b16a-0e4576c54b69",
                                "sense_id": "2d0d049e-a304-3f85-846c-08c0b7655c6b",
                                "text": "„Du sollst einfach nicht mit Werbeheinis arbeiten, die zu Hause immer noch an Benny Goodmans Klarinette nuckeln.“"
                            },
                            {
                                "example_id": "325809b4-0449-4717-bfba-9c9fa4a212b0",
                                "sense_id": "2d0d049e-a304-3f85-846c-08c0b7655c6b",
                                "text": "„Wir regen uns da auch teilweise auf über diese sehr teuer bezahlten Werbeheinis, die teilweise den grössten Mist zusammen bauen.“"
                            },
                            {
                                "example_id": "31e4fdbb-8be2-4682-96ce-b0f1f38347c8",
                                "sense_id": "2d0d049e-a304-3f85-846c-08c0b7655c6b",
                                "text": "„Zum Glück hat Regisseur Torsten Wacker eine ganze Reihe hochkarätiger Darsteller um den tumben Werbeheini herum gruppiert, die diese Komödie kurzweilig gestalten.“"
                            },
                            {
                                "example_id": "7ceb8fea-c4a6-4224-aa2b-05b1e1a28931",
                                "sense_id": "2d0d049e-a304-3f85-846c-08c0b7655c6b",
                                "text": "„Zum Beispiel im Frühjahr, als Werbeheinis sich überlegt haben, dass es cooler ist, wenn Capri Sonne jetzt Capri Sun heißt.“"
                            },
                            {
                                "example_id": "68303ffc-d1e9-4aaa-a516-ca7b0f1f884d",
                                "sense_id": "2d0d049e-a304-3f85-846c-08c0b7655c6b",
                                "text": "„Aber Werbeheinis, Jugendportal-Autoren und Trendforscher sollen aufhören, aus Normalität ein Phänomen zu konstruieren - und sie damit nicht nur zur peinlichen Identitätsfindung, sondern auch zur Problematisierung freizugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
