                "senses": [
                    {
                        "sense_id": "03439137-e689-328a-8aa9-b1ac79f56d8b",
                        "entry_id": "a675ccc5-0446-3c6c-8860-8b668a5c164c",
                        "glosses": [
                            "związany z Smalandią, dotyczący Smalandii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fd64a92-c4c3-4b9f-bbe8-0e6673238de6",
                                "sense_id": "03439137-e689-328a-8aa9-b1ac79f56d8b",
                                "text": "Na prawym skrzydle stał regiment smalandzki pod dowództwem płk. Krusego (800 koni, osiem szwadronów) oraz 60 piechurów pod dowództwem kpt. Kafle"
                            },
                            {
                                "example_id": "bb139a65-2ce5-45c5-9392-edc94664aacf",
                                "sense_id": "03439137-e689-328a-8aa9-b1ac79f56d8b",
                                "text": "Narzutniaki smalandzkie należą do najmniej licznych. Jedynie czerwony granit smalandzki jest dość pospolity"
                            },
                            {
                                "example_id": "f2ffca3c-0c71-4a33-8a8c-eca1c89c8554",
                                "sense_id": "03439137-e689-328a-8aa9-b1ac79f56d8b",
                                "text": "Jest wysoce prawdopodobne, że żelazo smalandzkie wędrowało za ozdoby na Olandię i Gotlandię, zaś zboże skańskie za bydło do Vastergótland i Halland"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
