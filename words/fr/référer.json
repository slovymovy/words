{
    "word_family": [
        "référence",
        "référencer",
        "référencement",
        "référent",
        "référentiel",
        "référé"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16b057be-bfc7-3665-9259-b53c7ef2d8b1",
                    "sense_definition": "Prendre quelque chose ou quelqu'un comme source, comme modèle ou comme autorité en consultant son avis ou son contenu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consulter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour répondre à cette question difficile, vous pouvez vous <w>référer</w> aux consignes données au début du devoir."
                        },
                        {
                            "text": "L'auteur se <w>réfère</w> souvent aux textes des grands philosophes classiques pour appuyer son argumentation."
                        }
                    ],
                    "synonyms": [
                        "recourir",
                        "consulter"
                    ],
                    "common_phrases": [
                        "se référer au texte",
                        "se référer aux consignes"
                    ]
                },
                {
                    "sense_id": "edc5b281-825c-3b54-b7e5-89ccbbf1fd2c",
                    "sense_definition": "Soumettre une décision, un problème ou une question litigieuse à une autorité compétente pour obtenir son arbitrage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soumettre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de signer cet accord important, le directeur doit en <w>référer</w> à son conseil d'administration."
                        },
                        {
                            "text": "En cas de litige grave, les employés ont préféré en <w>référer</w> immédiatement à leur supérieur hiérarchique."
                        }
                    ],
                    "synonyms": [
                        "rendre compte",
                        "rapporter"
                    ],
                    "common_phrases": [
                        "en référer à la hiérarchie",
                        "en référer au supérieur"
                    ]
                },
                {
                    "sense_id": "a414f22c-b36a-3eee-9920-a4f8893d2107",
                    "sense_definition": "Renvoyer à un passage, une note ou un élément précis d'un texte.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "renvoyer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet astérisque placé en bas de page se <w>réfère</w> directement au chapitre précédent de l'ouvrage."
                        },
                        {
                            "text": "Toutes les annotations de ce livre se <w>réfèrent</w> à la première édition publiée en 1980."
                        }
                    ],
                    "synonyms": [
                        "renvoyer",
                        "concerner"
                    ],
                    "common_phrases": [
                        "se référer à une note"
                    ]
                },
                {
                    "sense_id": "0d0bcb98-4926-3dea-8b75-5638f211b3b1",
                    "sense_definition": "Diriger ou orienter une personne vers un spécialiste ou un service compétent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "orienter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin généraliste a décidé de <w>référer</w> le patient à un neurologue pour des examens approfondis."
                        },
                        {
                            "text": "L'assistante sociale a <w>référé</w> cette famille vers un service d'aide au logement temporaire."
                        }
                    ],
                    "synonyms": [
                        "orienter",
                        "adresser",
                        "diriger"
                    ],
                    "common_phrases": [
                        "référer un patient"
                    ]
                },
                {
                    "sense_id": "8c67fbb8-c74a-3dd2-9b93-bc2a83e16784",
                    "sense_definition": "Rapporter un fait, une idée ou un phénomène à un principe ou à une cause déterminée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rapporter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chercheur tente de <w>référer</w> ces résultats surprenants aux hypothèses formulées au tout début de l'étude."
                        },
                        {
                            "text": "On ne peut pas simplement <w>référer</w> ces comportements sociaux complexes à une cause purement biologique."
                        }
                    ],
                    "synonyms": [
                        "rapporter",
                        "rattacher",
                        "attribuer"
                    ]
                },
                {
                    "sense_id": "9a7c303e-2764-35e1-8eb8-5048b084bd61",
                    "sense_definition": "Avoir pour référent ou pour signifié un objet ou une réalité du monde extérieur.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "renvoyer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette phrase complexe, le pronom neutre ne <w>réfère</w> à aucun objet concret déjà mentionné."
                        },
                        {
                            "text": "Le linguiste démontre comment ce terme technique <w>réfère</w> à un ensemble précis de pratiques sociales."
                        }
                    ],
                    "synonyms": [
                        "dénoter",
                        "désigner"
                    ]
                },
                {
                    "sense_id": "77202c55-0666-3316-ae55-d01fde755721",
                    "sense_definition": "Renvoyer à la partie adverse la prestation d'un serment décisoire qu'elle avait elle-même proposé.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a formellement conseillé à son client de ne point <w>référer</w> ce serment devant les juges."
                        },
                        {
                            "text": "Après une longue réflexion, le défendeur <w>référa</w> le serment à sa partie adverse pour clore le procès."
                        }
                    ],
                    "common_phrases": [
                        "référer le serment"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Terme juridique spécialisé et vieilli"
                        }
                    ]
                }
            ]
        }
    ]
}