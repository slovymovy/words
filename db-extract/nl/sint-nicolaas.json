                        "entry_id": "45325e39-e4e4-337a-8c01-fcf697ce13b2",
                        "glosses": [
                            "Nicolaas van Myra, een heilig verklaarde bisschop uit de 4e eeuw\\nHij is de beschermheilige van onder meer kinderen en zeelieden. Zijn naamdag, 6 december, vormt de oorsprong van de sinterklaasavond op 5 december. Myra ligt aan de zuidkust van het tegenwoordige Turkije."
                        ],
                        "tags": [
                            "katholiek"
                        ],
                        "examples": [
                            {
                                "example_id": "a606e607-4197-4073-a520-e011518f0ed6",
                                "sense_id": "6133634a-45ae-3340-bee4-015b83a7d1a1",
                                "text": "Sint-Nicolaas was, zoals bekend, de bisschop van Myra. Op religieuze afbeeldingen draagt hij dan ook het gangbare bisschopskostuum."
                            }
                        ]
                    },
                    {
                        "sense_id": "adaaff53-3927-3a81-b273-e651730c8159",
                        "entry_id": "45325e39-e4e4-337a-8c01-fcf697ce13b2",
                        "glosses": [
                            "de volgens de traditie uit Spanje afkomstige bisschop die de spil is van het Sinterklaasfeest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309ac495-32cb-42f3-9d32-b00f1389dff7",
                                "sense_id": "adaaff53-3927-3a81-b273-e651730c8159",
                                "text": "Sint-Nicolaas heeft zijn tweeledige bezigheid, het straffen en het belonen, eeuwenlang op eigen kracht verricht."
                            }
                        ]
                    }
