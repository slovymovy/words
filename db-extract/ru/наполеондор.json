                "senses": [
                    {
                        "sense_id": "ed63d94c-2e25-3f0b-9947-23d67b0a8a1d",
                        "entry_id": "af0500c9-3927-34be-8f4b-50eb31e39dd3",
                        "glosses": [
                            "истор. французская золотая монета в 20 франков с изображением Наполеона Бонапарта, выпускавшаяся в 1803—1815 гг."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e1c2c6-f759-44fb-9d92-07e0959a4060",
                                "sense_id": "ed63d94c-2e25-3f0b-9947-23d67b0a8a1d",
                                "text": "В окна заглядывали люди, державшие в руках наполеондоры и пятифранковые монеты с чеканным профилем императора. Эти «портреты» на деньгах они сравнивали с лицами гостей за столом."
                            }
                        ]
                    },
                    {
                        "sense_id": "52a59af5-c1fe-387b-95fb-52edd40eb906",
                        "entry_id": "af0500c9-3927-34be-8f4b-50eb31e39dd3",
                        "glosses": [
                            "истор. любая французская золотая монета в 20 франков, выпускавшаяся в XIX и начале XX в."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fb4aec2-8c12-481a-bdf2-ed3fba57e3cc",
                                "sense_id": "52a59af5-c1fe-387b-95fb-52edd40eb906",
                                "text": "Если у вас французское золото, то поберегите его до Сайгона: там банк меняет наполеондоры на пиастры почти без лажа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a29468bd-abab-4dbd-9b33-b0a8eb6f6dd2",
                        "source_entry_id": "af0500c9-3927-34be-8f4b-50eb31e39dd3",
                        "target_lang_word": "napoleon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "napoleon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c91c615-b046-317e-b9ee-0e17003d3166",
                                        "entry_id": "a73aed5f-85f7-3a93-ad0c-52f12a05f666",
                                        "glosses": [
                                            "The franc germinal: a 20-franc gold coin issued under Napoleon I of France."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c52c7ce-612d-312c-b671-572397e9f7e1",
                                        "entry_id": "a73aed5f-85f7-3a93-ad0c-52f12a05f666",
                                        "glosses": [
                                            "Other subsequent 20-franc coins, notes, or values."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e009cd2-eee0-4286-9914-929be9574319",
                                                "sense_id": "2c52c7ce-612d-312c-b671-572397e9f7e1",
                                                "text": "We had occasion some months ago to strengthen our resources, and borrowed, for that purpose, thirty thousand napoleons from the Bank of France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4afccc-2306-3d8c-883c-a85f75791452",
                                        "entry_id": "a73aed5f-85f7-3a93-ad0c-52f12a05f666",
                                        "glosses": [
                                            "A person resembling Napoleon Bonaparte, (usually) in having come to dominate an area or sphere of activity through ruthlessness or illegality as well as surpassing ability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2429930f-4b0b-4c4b-8240-ecc12522da72",
                                                "sense_id": "3f4afccc-2306-3d8c-883c-a85f75791452",
                                                "text": "He [sc. James Moriarty] is the Napoleon of crime, Watson. He is the organizer of half that is evil and of nearly all that is undetected in this great city [sc. London]. He is a genius, a philosopher, an abstract thinker."
                                            },
                                            {
                                                "example_id": "aade6807-c82d-40bb-b647-9981e337a89e",
                                                "sense_id": "3f4afccc-2306-3d8c-883c-a85f75791452",
                                                "text": "He [sc. McKinley] has been called the Napoleon of protection, as other men have been called Napoleons of finance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dbca73d-c8a6-354c-9b71-e01adc103df1",
                                        "entry_id": "a73aed5f-85f7-3a93-ad0c-52f12a05f666",
                                        "glosses": [
                                            "Clipping of Napoleon boot, a form of topboot worn by officers during the Napoleonic Wars."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "707b2041-4c05-4cb8-acce-094770f6962b",
                                                "sense_id": "3dbca73d-c8a6-354c-9b71-e01adc103df1",
                                                "text": "Always an eloquent speaker, Polk became known as the Napoleon of the stump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21fa79a6-f503-3517-ba92-1dba4fc55fd2",
                                        "entry_id": "a73aed5f-85f7-3a93-ad0c-52f12a05f666",
                                        "glosses": [
                                            "Clipping of Napoleon gun, a 12-pounder cannon first used by the Second French Empire."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7585b64-d1e2-352e-918b-4e99f0a4c460",
                                        "entry_id": "a73aed5f-85f7-3a93-ad0c-52f12a05f666",
                                        "glosses": [
                                            "A 19th-century five-card trick-taking game simplified from euchre."
                                        ],
