                "senses": [
                    {
                        "sense_id": "ce5552e1-b4f5-30cd-903a-d4da24620cd2",
                        "entry_id": "fb3969b4-df2d-3ee4-90bf-a598f4bc067f",
                        "glosses": [
                            "von Studenten verfasste und herausgegebene Zeitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57bdc882-f923-4f42-a670-4e274ac1041a",
                                "sense_id": "ce5552e1-b4f5-30cd-903a-d4da24620cd2",
                                "text": "„Vor Kurzem noch hatte meine Zukunft mich keinen Deut interessiert. Da war ich Student an der Sophia (Joichi) University mitten in Tokio gewesen und hatte ein Diplom in vergleichender Literaturwissenschaft angestrebt und für die Studentenzeitung geschrieben.“"
                            },
                            {
                                "example_id": "8b72fdad-b13b-446f-bbe9-e2d0c151441e",
                                "sense_id": "ce5552e1-b4f5-30cd-903a-d4da24620cd2",
                                "text": "„Im Dezember 1966 berichtete Kollek in der Studentenzeitung Bat Kol der Bar-Ilan-Universität über weitere Schritte, die die Verwaltung neben dem Verzicht auf ein neues Rathaus in Richtung Wiedervereinigung unternommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
