{
    "word_family": [
        "équivalence",
        "équivalent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fac60f63-121a-3aff-9d21-336fceab391f",
                    "sense_definition": "Être égal en valeur, en quantité ou en mesure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "valeur_mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En musique, une blanche <w>équivaut</w> exactement à deux noires."
                        },
                        {
                            "text": "Un mille marin n'<w>équivaut</w> pas tout à fait à deux kilomètres terrestres."
                        }
                    ],
                    "synonyms": [
                        "égaler",
                        "valoir"
                    ],
                    "common_phrases": [
                        "équivaloir à"
                    ]
                },
                {
                    "sense_id": "6f40fb38-07a8-3135-a17d-2b06d2813fbb",
                    "sense_definition": "Avoir le même effet ou la même portée morale qu'une autre chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sens_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Garder le silence dans cette situation critique <w>équivaut</w> à un aveu de culpabilité."
                        },
                        {
                            "text": "Abandonner le projet maintenant <w>équivaudrait</w> à gaspiller deux années de travail intensif."
                        }
                    ],
                    "synonyms": [
                        "revenir à",
                        "s'apparenter à"
                    ],
                    "common_phrases": [
                        "équivaloir à un aveu"
                    ]
                },
                {
                    "sense_id": "56f4ceee-bae5-34ec-8463-0f9bb7c8b801",
                    "sense_definition": "Être d'égale valeur, de force comparable ou de niveau semblable les uns par rapport aux autres.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reciproque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur le plan des compétences professionnelles, ces deux candidats remarquables s'<w>équivalent</w> totalement."
                        },
                        {
                            "text": "Malgré des styles très différents, leurs deux derniers romans s'<w>équivalaient</w> en intensité dramatique."
                        }
                    ],
                    "synonyms": [
                        "se valoir"
                    ],
                    "common_phrases": [
                        "s'équivaloir en tout"
                    ]
                }
            ]
        }
    ]
}