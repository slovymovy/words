                ],
                "senses": [
                    {
                        "sense_id": "6dd40d7b-b10f-370d-a20f-273a85828908",
                        "entry_id": "42714bad-7d10-3f8f-b3ca-c2641766ffb4",
                        "glosses": [
                            "Person, die hauptsächlich auf befestigten (asphaltierten) Straßen / Wegen läuft"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "9effd8f8-d0c0-4467-b612-df8db6945966",
                                "sense_id": "6dd40d7b-b10f-370d-a20f-273a85828908",
                                "text": "„Man glaubt gar nicht, welche Muskeln da plötzlich alles beansprucht werden, wenn man als reiner Asphaltläufer plötzlich durch Sand und über weichen Waldboden läuft.“"
                            },
                            {
                                "example_id": "0a59dfe9-7a24-470a-a02e-859b86e359a6",
                                "sense_id": "6dd40d7b-b10f-370d-a20f-273a85828908",
                                "text": "„Wir haben ein großes Sortiment und besten Service, egal ob für Asphaltläufer, Trailrunnner oder Laufband-Profi.“"
                            },
                            {
                                "example_id": "a594dd83-983d-4b2b-bbd2-05c123c116ec",
                                "sense_id": "6dd40d7b-b10f-370d-a20f-273a85828908",
                                "text": "„Für Asphaltläufer ist ein tiefes Profil nicht nötig, hier spielen Komfort oder eben Dynamik – je nach Lauftempo – eine übergeordnete Rolle.“"
                            },
                            {
                                "example_id": "51056feb-7a27-448d-b6f5-3d5016bf079c",
                                "sense_id": "6dd40d7b-b10f-370d-a20f-273a85828908",
                                "text": "„Es gibt Sohlen die für Asphaltläufer optimiert sind (wie z.B. der Brooks Ghost 7) oder für Trailrunner die häufig im Gelände joggen (wie z.B. dem Salomon Speedcross 3).“"
                            },
                            {
                                "example_id": "61c315ca-19b9-491b-b1fc-4e89d0d82e68",
                                "sense_id": "6dd40d7b-b10f-370d-a20f-273a85828908",
                                "text": "„Der Schuh bietet sich auch für Läufer an, harte Asphaltläufer sollten aber eventuell über einen gedämpfteren Schuh nachdenken, besonders, wenn die Gelenke und/oder die Wirbelsäule bereits Probleme machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
