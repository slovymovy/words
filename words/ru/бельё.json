    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e5903fc-6f9d-36e8-b9cd-67a5b696b06d",
                    "sense_definition": "предметы одежды, надеваемые непосредственно на тело",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно купить новое <w>бельё</w> для занятий спортом.",
                            "target_lang_translations": {
                                "en": "I need to buy new <w>underwear</w> for sports."
                            }
                        },
                        {
                            "text": "Она аккуратно сложила чистое <w>бельё</w> в комод.",
                            "target_lang_translations": {
                                "en": "She neatly folded the clean <w>underwear</w> into the dresser."
                            }
                        }
                    ],
                    "common_phrases": [
                        "нижнее бельё"
                    ],
                    "target_lang_definitions": {
                        "en": "Clothing items worn directly against the skin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "underwear",
                                "target_lang_sense_clarification": "General term for garments worn under outer clothing."
                            },
                            {
                                "target_lang_word": "lingerie",
                                "target_lang_sense_clarification": "Specifically refers to women's decorative or intimate underwear."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2ef206-198c-3775-898f-872186c2e57d",
                    "sense_definition": "тканевые изделия для домашнего быта, такие как простыни, наволочки и пододеяльники",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "быт",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пора сменить постельное <w>бельё</w> на свежее.",
                            "target_lang_translations": {
                                "en": "It's time to change the <w>bed linen</w> for fresh ones."
                            }
                        },
                        {
                            "text": "В отеле всегда выдают чистое <w>бельё</w> каждому гостю.",
                            "target_lang_translations": {
                                "en": "The hotel always provides clean <w>bed linen</w> to every guest."
                            }
                        }
                    ],
                    "common_phrases": [
                        "постельное бельё"
                    ],
                    "target_lang_definitions": {
                        "en": "Household textile items such as sheets, pillowcases, and duvet covers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bed linen",
                                "target_lang_sense_clarification": "Standard term for sheets and bedding covers."
                            },
                            {
                                "target_lang_word": "bedding",
                                "target_lang_sense_clarification": "Broader term including sheets, blankets, and pillows."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46b508f5-1945-3ef7-b760-f8079998b294",
                    "sense_definition": "текстильные изделия, которые необходимо постирать или которые уже постираны",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "быт",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама развесила мокрое <w>бельё</w> на балконе.",
                            "target_lang_translations": {
                                "en": "Mom hung the wet <w>laundry</w> on the balcony."
                            }
                        },
                        {
                            "text": "Стиральная машина закончила стирать <w>бельё</w> полчаса назад.",
                            "target_lang_translations": {
                                "en": "The washing machine finished washing the <w>laundry</w> half an hour ago."
                            }
                        }
                    ],
                    "common_phrases": [
                        "стирать бельё"
                    ],
                    "target_lang_definitions": {
                        "en": "Textile items that need to be washed or have just been washed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "laundry",
                                "target_lang_sense_clarification": "General term for clothes and linens that are being or need to be washed."
                            },
                            {
                                "target_lang_word": "wash",
                                "target_lang_sense_clarification": "Used to refer to a batch of clothes being washed."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "680cfff7-4cd7-32df-b912-df6548dfef53",
                    "sense_definition": "нерасписанные изделия из белого фарфора",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "искусство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Художник наносит узоры на фарфоровое <w>бельё</w> перед обжигом.",
                            "target_lang_translations": {
                                "en": "The artist applies patterns to the <w>white porcelain</w> before firing."
                            }
                        },
                        {
                            "text": "Качество глазури на этом <w>бельё</w> очень высокое.",
                            "target_lang_translations": {
                                "en": "The quality of the glaze on this <w>white porcelain</w> is very high."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "профессиональный термин"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Unpainted items made of white porcelain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "white porcelain",
                                "target_lang_sense_clarification": "Refers to the raw, unglazed or unpainted ceramic base."
                            },
                            {
                                "target_lang_word": "blank porcelain",
                                "target_lang_sense_clarification": "Technical term for porcelain ready for decoration."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}