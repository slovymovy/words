                "senses": [
                    {
                        "sense_id": "3d4a4ead-3181-3ea8-9868-28a069bbfb4d",
                        "entry_id": "8955f776-269b-333a-bef9-c46b275bd29f",
                        "glosses": [
                            "Papoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1fa4f38-b0a0-4db5-98d3-be2fa3158a4d",
                                "sense_id": "3d4a4ead-3181-3ea8-9868-28a069bbfb4d",
                                "text": "Je passe donc la journée à papotailler ici et là, non vraiment, oui, absolument, ahahah, tu vois le genre."
                            },
                            {
                                "example_id": "a09e02be-16f2-4644-b48a-a287f78fbd37",
                                "sense_id": "3d4a4ead-3181-3ea8-9868-28a069bbfb4d",
                                "text": "Bref, après 17 ans de commerce, comme j’adore papotailler et chantailler en m’enjaillant, je me suis souvent retrouvée bien accompagnée en scène ouverte avec toute une bande de potes."
                            },
                            {
                                "example_id": "f67c6ef4-5760-4748-a1c0-9905f2bae8e2",
                                "sense_id": "3d4a4ead-3181-3ea8-9868-28a069bbfb4d",
                                "text": "Guillaume, Fuck et la ptite Lucie prennent de l’avance pendant que derrière, Charlotte et moi on trainaille et papotaille dans les belles couleurs de l’automne à Antalya."
                            }
                        ]
                    }
