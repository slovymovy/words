                                        "glosses": [
                                            "site waar men kosteloos zelfgemaakt videomateriaal kan neerzetten en bekijken, tevens de grootste videosite ter wereld"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
