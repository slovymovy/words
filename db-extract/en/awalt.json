                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "d3a67cd2-f5b9-41d7-9819-720484c09a49",
                                "sense_id": "c1c757b0-80a6-3288-b09e-8cc831c60c16",
                                "text": "I'm from Russia. It's not better there than it is anywhere else... . stop thinking different places are better about women or whatnot. You're forgetting the single most important rule. AWALT [All Women Are Like That]."
                            },
                            {
                                "example_id": "7bb7531f-4e1b-463b-bfa4-3b95b747eb47",
                                "sense_id": "c1c757b0-80a6-3288-b09e-8cc831c60c16",
                                "text": "In expressing any attitude beyond the “it’s over” narrative, or refusing to believe AWALT, the incel is denoted as “coping”, a negatively charged label indicating that you have yet to completely swallow the blackpill, and are therefore naïve and “low IQ”."
                            },
                            {
                                "example_id": "61707391-d346-404a-8e47-eb5ba833f467",
                                "sense_id": "c1c757b0-80a6-3288-b09e-8cc831c60c16",
                                "text": "Personal stories about unhappy relationships, cheating partners and manipulative ex-wives were often described in detail, usually to illustrate AWALT and serve as the basis for the MGTOW lifestyle."
                            }
                        ]
                    }
