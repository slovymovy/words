                                        "glosses": [
                                            "A person who makes, sells, or repairs hats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21cbc10a-ae79-341a-8678-6410dfc14cb4",
                                        "entry_id": "2363c6ee-8934-3697-a3a9-a4e406bb091f",
                                        "glosses": [
                                            "A person who lives alone in the bush."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11c3bcf7-fbf8-4a83-8d31-6cc9bf87a94e",
                                                "sense_id": "21cbc10a-ae79-341a-8678-6410dfc14cb4",
                                                "text": "Lonely hut where drought’s eternal, suffocating atmosphere\nWhere the God-forgotten hatter dreams of city life and beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ae6371-48ff-3f95-b31d-2392b93a2d4c",
                                        "entry_id": "2363c6ee-8934-3697-a3a9-a4e406bb091f",
                                        "glosses": [
                                            "A miner who works by himself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "064ad406-50bc-3387-a000-49507bf5f02a",
                                        "entry_id": "093e8309-39a1-35de-9c80-7e2619342a2d",
                                        "glosses": [
                                            "To tire or worry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7865712f-dc5a-4176-82a0-efd1e29422ca",
                                                "sense_id": "064ad406-50bc-3387-a000-49507bf5f02a",
                                                "text": "They may Hatter an indifferent Beauty; but the Excellencies of Nature can have no Right done to them"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc28e0f6-0a17-40b2-b9ea-0d2c158ad6d0",
                        "source_entry_id": "48013899-3eaf-350f-919c-1f1cfeb0b90a",
                        "source_sense_id": "055c306e-daec-30aa-8e26-241f33a63860",
