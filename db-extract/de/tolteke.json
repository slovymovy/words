                ],
                "senses": [
                    {
                        "sense_id": "3d98d232-af62-38fc-be27-6d35dfcd40e8",
                        "entry_id": "066b7c54-ae91-397d-8390-bc2cc7eb2b68",
                        "glosses": [
                            "Angehöriger einer mesoamerikanischen Kultur in Zentralmexiko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "935816f5-cbee-4832-902a-3ecba013f305",
                                "sense_id": "3d98d232-af62-38fc-be27-6d35dfcd40e8",
                                "text": "„Ganz anders war es mit der Überlieferung zu der seit etwa Christi Geburt aufblühenden Kultur von Teōtihuahcān und der noch späteren der Tolteken, die beide ihre Zentren im nördlichen Hochtal von Mexiko hatten.“"
                            },
                            {
                                "example_id": "f0cf2a5f-26cc-46dc-acc9-798df18f4672",
                                "sense_id": "3d98d232-af62-38fc-be27-6d35dfcd40e8",
                                "text": "„Denn alle späteren Besucher von draußen waren Angehörige engstirniger örtlich angesiedelter Volksgruppen gewesen, die nichts über die größere Welt gewusst hatten - bestenfalls zählten sie zu den Mayas, Tolteken oder Azteken, überwiegend jedoch zu den ungebildeten Indianerstämmen der Prärie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
