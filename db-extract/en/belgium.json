                                    {
                                        "sense_id": "7bbaa507-9c1b-31e7-8863-42e135c7bab2",
                                        "entry_id": "5568c6f5-6f58-3572-903e-c48d3a95848c",
                                        "glosses": [
                                            "přímořský stát v západní Evropě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1304ab5-faa8-4bc5-b9eb-b16b3418f4c2",
                                                "sense_id": "7bbaa507-9c1b-31e7-8863-42e135c7bab2",
                                                "text": "Belgie může spoléhati na samozřejmost, že ani Anglie ani Francie ve vlastním zájmu nemohou dopustiti, aby byla zabrána Německem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd0866b2-401b-4066-9f08-e22b22491062",
