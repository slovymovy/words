                        "examples": [
                            {
                                "example_id": "8dab5e6e-cbd2-42f4-b3ad-aba60c74d541",
                                "sense_id": "017ead1f-a9fd-3c7f-885e-1fea54629540",
                                "text": "De gedeputeerden Jaap Lodders van de VVD, Marc Witteman van de PvdA en Jan Nico Appelman van het CDA stapten vorige maand op na een kritisch rapport over de ontwikkeling van het natuurproject Oostvaarderswold."
                            },
                            {
                                "example_id": "780f9888-e858-47f3-8316-01a6f7cb6e99",
                                "sense_id": "017ead1f-a9fd-3c7f-885e-1fea54629540",
                                "text": "Als een provincie of een gemeente wil bouwen, moet er verplicht ter compensatie geld worden uitgeven aan een natuurproject. Het CDA denkt dat er veel geld bespaard kan worden als er alleen nog geïnvesteerd wordt in de zogeheten Ecologische Hoofdstructuur, een aaneenschakeling van bestaande natuurgebieden."
                            }
