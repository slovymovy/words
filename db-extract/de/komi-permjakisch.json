                "senses": [
                    {
                        "sense_id": "c15918d0-7698-31a4-80c9-db3b2d8400bd",
                        "entry_id": "9a31788a-295c-3572-8524-74a4493c7df8",
                        "glosses": [
                            "eine Sprache, die in Nordwestrussland gesprochen wird; wird teilweise gemeinsam mit dem Komi-Syrjänischen als Varietät des Komi betrachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e47ba18-f1c0-424d-85e7-e80616608132",
                                "sense_id": "c15918d0-7698-31a4-80c9-db3b2d8400bd",
                                "text": "„Während das Komi in der Republik Komi seit 1992 einen offiziellen Status neben dem Russischen besitzt, gilt dies weder für das Udmurtische noch für das Komi-Permjakische.“"
                            },
                            {
                                "example_id": "b143e61b-5325-4ebd-b0b9-3b6b879cc742",
                                "sense_id": "c15918d0-7698-31a4-80c9-db3b2d8400bd",
                                "text": "„Russische Entlehnungen sind in allen drei permischen Sprachen verbreitet. Im Komi-Permjakischen kommen sie am meisten vor, fast die Hälfte […] sind russischen Ursprungs.“"
                            },
                            {
                                "example_id": "7c88b00c-bda9-463c-9e78-bd57195f9192",
                                "sense_id": "c15918d0-7698-31a4-80c9-db3b2d8400bd",
                                "text": "„Das Syrjänische hat drei Hauptdialekte: Komi-Syrjänisch, Komi-Permjakisch und Ostpermjakisch (Jazva-Dialekt).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
