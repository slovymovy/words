                    }
                ],
                "senses": [
                    {
                        "sense_id": "de5f15a7-5c94-33ce-a3b3-7bf117a4d582",
                        "entry_id": "349117f4-ae7d-3198-a8c2-8ed9805a3860",
                        "glosses": [
                            "Partie de l’armure du XVᵉ siècle qui embrasse la partie inférieure du corps, elle est souvent formée de plusieurs lames articulées."
                        ],
                        "tags": [
                            "Armurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "ed352ef7-fb5a-4502-b879-684f18da765c",
                                "sense_id": "de5f15a7-5c94-33ce-a3b3-7bf117a4d582",
                                "text": "Elle était échancrée au cou et aux bras : c’est là le plastron proprement dit : il s’attachait à la pansière, devant et derrière, à l’extrémité de la pointe, soit par un rivet, soit par une courroie à boucle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f41978d3-4df4-4a7d-9313-586aa6fb605f",
                        "source_entry_id": "349117f4-ae7d-3198-a8c2-8ed9805a3860",
                        "source_sense_id": "de5f15a7-5c94-33ce-a3b3-7bf117a4d582",
                        "target_lang_word": "placard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18a067a7-9a0a-34d6-934f-7011da1c7a8c",
                                        "entry_id": "59ed317c-8f4c-32a6-9f5f-71c066157fe6",
                                        "glosses": [
                                            "A sheet of paper or cardboard with a written or printed announcement on one side for display in a public place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fef8e46-2408-43b6-8e24-dd19bfa6e679",
                                                "sense_id": "18a067a7-9a0a-34d6-934f-7011da1c7a8c",
                                                "text": "Especially from Mr. Borthrop Trumbull, a distinguished bachelor and auctioneer of those parts, much concerned in the sale of land and cattle: a public character, indeed, whose name was seen on widely distributed placards, and who might reasonably be sorry for those who did not know of him."
                                            },
                                            {
                                                "example_id": "a101609f-e2e1-4a59-abb2-007cef20e7eb",
                                                "sense_id": "18a067a7-9a0a-34d6-934f-7011da1c7a8c",
                                                "text": "He brought out the placard, which was quite a work of art. It was nearly two feet long, printed on calendered paper, with a selection of colors so bright that they shone even in the moonlight."
                                            },
                                            {
                                                "example_id": "149f9365-0a76-4f5e-a260-54c905887057",
                                                "sense_id": "18a067a7-9a0a-34d6-934f-7011da1c7a8c",
                                                "text": "While her husband read the placards pasted on the brick announcing the hours at which certain ships would sail for Scotland, Mrs. Ambrose did her best to find information."
                                            },
                                            {
                                                "example_id": "7b9f22ad-c156-42aa-8c85-6540e48c2a44",
                                                "sense_id": "18a067a7-9a0a-34d6-934f-7011da1c7a8c",
                                                "text": "Towards the end of August, the Southern Railway decided to adopt a novel form of publicity to popularise the services. Sandwich board men were employed at Charing Cross and Cannon Street to display placards, and distribute leaflet timetables, calling attention to the vacant seats on the services via Nunhead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023c577e-8468-3579-8855-ed710663ae97",
                                        "entry_id": "59ed317c-8f4c-32a6-9f5f-71c066157fe6",
                                        "glosses": [
                                            "A public proclamation; a manifesto or edict issued by authority."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6158b8a0-ac88-4d7f-9336-fb56d59f7fd1",
                                                "sense_id": "023c577e-8468-3579-8855-ed710663ae97",
                                                "text": "All placards or edicts are published in his name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3d41b9f-fb59-3910-b8e7-efd91b99fb8d",
                                        "entry_id": "59ed317c-8f4c-32a6-9f5f-71c066157fe6",
                                        "glosses": [
                                            "Permission given by authority; a license."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8783676e-945b-4503-b31c-8e4b4a78ffd9",
                                                "sense_id": "a3d41b9f-fb59-3910-b8e7-efd91b99fb8d",
                                                "text": "to give a placard to do something"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86df42e5-d48b-3c3c-8abc-c266b36597ea",
                                        "entry_id": "59ed317c-8f4c-32a6-9f5f-71c066157fe6",
                                        "glosses": [
                                            "An extra plate on the lower part of the breastplate or backplate of armour."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05f30fb0-4539-3d64-8e8c-fd49af2a942c",
                                        "entry_id": "59ed317c-8f4c-32a6-9f5f-71c066157fe6",
                                        "glosses": [
                                            "A kind of stomacher, often adorned with jewels, worn in the fifteenth century and later."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fa14131-082b-3c92-a94b-4d13ed031045",
                                        "entry_id": "59ed317c-8f4c-32a6-9f5f-71c066157fe6",
                                        "glosses": [
                                            "The woodwork and frame of the door of a closet etc."
                                        ],
                                        "tags": [],
