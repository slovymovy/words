                                        "entry_id": "bbf3d1a5-3f00-3fe9-81e3-bb8c756e4599",
                                        "glosses": [
                                            "A tank or vivarium containing both aquatic and terrestrial elements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03f2b6a0-348e-483d-bec7-bf827a8b20a1",
                                                "sense_id": "1f2c606b-65ba-3b3c-b4ff-b89246006f9f",
                                                "text": "This is one of the most valuable plants for paludariums and terrariums."
                                            },
                                            {
                                                "example_id": "47b8d501-7ae0-468e-83a4-39b7248a8fb3",
                                                "sense_id": "1f2c606b-65ba-3b3c-b4ff-b89246006f9f",
                                                "text": "The plant then develops another stem which grows will in aquaterrariums and paludariums, where the leaves become a pale-green colour."
                                            },
                                            {
                                                "example_id": "e3f0922f-ca91-4bfd-9916-e48e6baf7ab2",
                                                "sense_id": "1f2c606b-65ba-3b3c-b4ff-b89246006f9f",
                                                "text": "Sizes of commercially available paludaria range from 25 gallon up to 500-gallon models."
                                            },
                                            {
                                                "example_id": "67d09bcc-ca89-46c1-92cb-efbfeb193594",
                                                "sense_id": "1f2c606b-65ba-3b3c-b4ff-b89246006f9f",
                                                "text": "Choose an appropriate substrate for the paludarium. Fine sand, mud, or a mix of both is recommended."
                                            }
                                        ]
