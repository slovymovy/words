                        "entry_id": "bd79ade3-4512-379b-98ab-0fad20a81969",
                        "glosses": [
                            "перен., разг. добраться одним махом, одним броском"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2aee84-ef61-4995-ae73-7bb06a436134",
                                "sense_id": "4066695f-762d-31b4-b369-b9708e4512e9",
                                "text": "А волк-то махнул за ней, да не домахнул…"
                            }
                        ]
                    }
