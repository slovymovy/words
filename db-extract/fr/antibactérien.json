                ],
                "senses": [
                    {
                        "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                        "entry_id": "ac6285b2-7316-3137-a868-2750ac543420",
                        "glosses": [
                            "Qui détruit les bactéries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13028584-4361-440f-9963-98b43e18b33e",
                                "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                                "text": "Sous la pression des événements, le regard occidental sur cette arme antibactérienne commence à changer."
                            },
                            {
                                "example_id": "a4cda747-df1e-4b3b-9c31-20914783e0f5",
                                "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                                "text": "Il a vu ses marques d’entretien ménager progresser de 19 % en 2020, l’un de ses produits antibactériens progressant même de 22,5 %."
                            },
                            {
                                "example_id": "d3946753-267d-43b5-b303-d9524fac0e1b",
                                "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                                "text": "Nos résultats démontrent que cette espèce utilisée à dose suffisante présente aussi des propriétés antibactériennes et antifongiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3317aa28-305b-4a1a-895c-e56c07d86878",
                        "source_entry_id": "ac6285b2-7316-3137-a868-2750ac543420",
