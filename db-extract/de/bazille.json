                "senses": [
                    {
                        "sense_id": "8f09bc82-409b-3ed3-ae64-5e7f087d103d",
                        "entry_id": "7401f719-3c0d-3e71-b161-ed010081520d",
                        "glosses": [
                            "Bazillus"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4153f0a3-4a38-472f-bd1b-bb98d08898e5",
                                "sense_id": "8f09bc82-409b-3ed3-ae64-5e7f087d103d",
                                "text": "Immer wieder fanden sie auffällig häufig Antikörper gegen die Bazille im Blut von Herz-Kreislauf-Kranken, doch nur um in anderen Studien mit gegenteiligen Befunden konfrontiert zu werden."
                            },
                            {
                                "example_id": "0a89a2c4-c01e-436c-a1d5-016c7ade532f",
                                "sense_id": "8f09bc82-409b-3ed3-ae64-5e7f087d103d",
                                "text": "Die Bazillen dauerhaft klein zu kriegen, ist eine Sisyphusarbeit, denn innerhalb von Stunden besiedeln die Mikroben frisch gereinigte Zahnoberflächen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee6930d0-52f0-429c-8a01-b748600b0ec7",
                        "source_entry_id": "7401f719-3c0d-3e71-b161-ed010081520d",
                        "source_sense_id": "8f09bc82-409b-3ed3-ae64-5e7f087d103d",
                        "source_sense_description": "umgangssprachlich: Bazillus",
                        "target_lang_word": "bacillus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bacillus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Any of various rod-shaped, spore-forming aerobic bacteria in the genus Bacillus, some of which cause disease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a02569c-af85-4bd8-9246-6cf42b93dd29",
                                                "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                                "text": "'This again,' said the Bacteriologist, slipping a glass slide under the microscope, 'is a preparation of the celebrated Bacillus of cholera - the cholera germ.'"
                                            },
                                            {
                                                "example_id": "68dd02c2-2e0c-433e-8821-bbc9361e38b1",
                                                "sense_id": "c34e8a40-3a31-3731-bd5f-c49aec342269",
                                                "text": "\"You will conceive a bunch of grapes,\" said he, \"which are covered by some infinitesimal but noxious bacillus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c2b6d5c-13c0-37b9-bab1-14b156ed13bd",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Any bacilliform (rod-shaped) bacterium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0814ad19-bdbc-398b-ad11-847e35841ac3",
                                        "entry_id": "321d7e8b-924a-37a1-9a02-2b8e9f86425d",
                                        "glosses": [
                                            "Something which spreads like bacterial infection."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd968b0-9b42-4d3a-a30e-aad34322cffb",
                                                "sense_id": "0814ad19-bdbc-398b-ad11-847e35841ac3",
                                                "text": "The “bacillus of boom or depression,” he wrote, travels freely “from country to country.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "802f8ad3-0438-40d1-abfb-097da82124a5",
                        "source_entry_id": "7401f719-3c0d-3e71-b161-ed010081520d",
                        "source_sense_id": "8f09bc82-409b-3ed3-ae64-5e7f087d103d",
