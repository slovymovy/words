                "senses": [
                    {
                        "sense_id": "a4c285e8-1d9b-35a2-868e-b022b7f5652c",
                        "entry_id": "0d1167c8-8534-3ec2-a90f-4f037231f3d5",
                        "glosses": [
                            "een horizontale bodemlaag bestaande uit klei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dd34c1a-e673-4303-b839-e5a923c9f0f1",
                                "sense_id": "a4c285e8-1d9b-35a2-868e-b022b7f5652c",
                                "text": "ECN-onderzoeker Paul Cobden: \"Bij het vervaardigen van staal en ijzer komt gas vrij met een beperkte verbrandingswaarde als gevolg van een fors bestanddeel CO2. Met onze techniek vangen we deze CO2 af in een kleilaag en blijft er gas over met een hoog calorische waarde. Dit gas kan vervolgens worden gebruikt voor het aandrijven van een stoomturbines voor elektriciteit opwekking.\""
                            },
                            {
                                "example_id": "283083e2-7d88-4fa7-9fce-1d312406f04e",
                                "sense_id": "a4c285e8-1d9b-35a2-868e-b022b7f5652c",
                                "text": "De tanden, door archeologen gevonden in een meter dikke kleilaag in de Fuyangrot, zijn zeker van onze voorouders, zo is door wetenschappers vastgesteld."
                            }
                        ]
                    }
