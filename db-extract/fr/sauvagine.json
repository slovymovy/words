            {
                "entry_id": "5eeb15f6-180d-3a9c-87cb-6444c3dbb624",
                "word": "sauvagine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f480f26c-7f22-4c76-b60e-47aeafec4507",
                        "entry_id": "5eeb15f6-180d-3a9c-87cb-6444c3dbb624",
                        "tags": [
                            "plural"
                        ],
                        "form": "sauvagines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64430ffa-5e53-309e-ad89-259f27af5af5",
                        "entry_id": "5eeb15f6-180d-3a9c-87cb-6444c3dbb624",
                        "glosses": [
                            "Ensemble des oiseaux de mer, d’étang et de marais qui ont le goût sauvagin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e53a2b-a76c-49a5-bcfb-6735d8d2b1f3",
                                "sense_id": "64430ffa-5e53-309e-ad89-259f27af5af5",
                                "text": "C’est plein de sauvagine ce pays."
                            },
                            {
                                "example_id": "ea1f67f9-8f74-49e1-aabe-21abbeae4e9a",
                                "sense_id": "64430ffa-5e53-309e-ad89-259f27af5af5",
                                "text": "C’est un pays de lacs et d’étangs, tout y est plein de sauvagine, on y trouve beaucoup de sauvagine."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e15e885-84e4-3c16-8e18-091f192ccb7e",
                        "entry_id": "5eeb15f6-180d-3a9c-87cb-6444c3dbb624",
                        "glosses": [
                            "Ensemble des gibiers à plume qui effectuent des migrations."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "96020dbc-bf01-42d6-889b-84c6824efc9b",
                                "sense_id": "7e15e885-84e4-3c16-8e18-091f192ccb7e",
                                "text": "Michel La Haye est un vieux routier dans le domaine de la chasse à ces gibiers ailés. En plus d’être conférencier et enseignant des appels à la sauvagine, il guide aux frontières de l’Ontario, dans le secteur de Hawkesbury et de Vankleek Hill."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a043dca-cfa9-3896-82f1-0ffcbbcb49a1",
                        "entry_id": "5eeb15f6-180d-3a9c-87cb-6444c3dbb624",
                        "glosses": [
                            "Odeur de ces oiseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ec7b78-7a01-4691-a3b3-ffb16451d2e7",
                                "sense_id": "1a043dca-cfa9-3896-82f1-0ffcbbcb49a1",
                                "text": "Cela sent la sauvagine."
                            }
                        ]
                    },
                    {
                        "sense_id": "89792359-48d5-34c0-afa6-739e72ced916",
                        "entry_id": "5eeb15f6-180d-3a9c-87cb-6444c3dbb624",
                        "glosses": [
                            "Carnassier sauvage à fourrure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488a6627-9356-4d70-acc6-f3fa0f980714",
                                "sense_id": "89792359-48d5-34c0-afa6-739e72ced916",
                                "text": "Il referma la porte pour ne pas qu’une sauvagine rapplique en sentant l’odeur de la charogne, puis il rentra dans sa maison et décrocha son fusil de la poutre et le chargea avec des cartouches de chevrotine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b5233f7-0a48-4014-9193-68d1fa858aed",
                        "source_entry_id": "5eeb15f6-180d-3a9c-87cb-6444c3dbb624",
                        "source_sense_id": "64430ffa-5e53-309e-ad89-259f27af5af5",
                        "source_sense_description": "(Chasse) Oiseaux au goût sauvagin",
                        "target_lang_word": "wildfowl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wildfowl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fea24dfa-85c4-380d-9b26-435fd4ba779e",
                                        "entry_id": "099ccb6d-f078-3a49-898b-0fe2bef1f3da",
                                        "glosses": [
                                            "Any wild bird such as ducks, geese or swans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c67ba7-2908-483d-944c-d201d6de8882",
                                                "sense_id": "fea24dfa-85c4-380d-9b26-435fd4ba779e",
                                                "text": "Near-synonyms: gamefowl, game bird"
                                            },
                                            {
                                                "example_id": "ee2ff6a4-eab6-4f4d-9251-e3c3e890e699",
                                                "sense_id": "fea24dfa-85c4-380d-9b26-435fd4ba779e",
                                                "text": "[…] Whoso seeks an audit here\nPropitious, pays his tribute, game or fish,\nWildfowl or ven’son, and his errand speeds."
                                            },
                                            {
                                                "example_id": "d3c8775a-f47c-4edb-a406-5a8aecffa71f",
                                                "sense_id": "fea24dfa-85c4-380d-9b26-435fd4ba779e",
                                                "text": "In these early days of the journey we eat well. We have brought salted meat, flour, beans, dried fruit, and there are wildfowl to shoot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wildfowl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5589797-024f-326c-985d-bd5f940d5453",
                                        "entry_id": "e9e37edd-613f-3196-beb3-6e5b4f3e1b1d",
                                        "glosses": [
                                            "To hunt wildfowl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2046f541-ef01-4019-87ca-bc7984e62084",
                                                "sense_id": "a5589797-024f-326c-985d-bd5f940d5453",
                                                "text": "The hunting of the kind of winged creatures, taken as a whole, is called wildfowling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
