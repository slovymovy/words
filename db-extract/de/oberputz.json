                "senses": [
                    {
                        "sense_id": "4a2994eb-7d97-31a5-b865-51701119a402",
                        "entry_id": "af68d6fd-996e-3e7d-a302-f459e5211570",
                        "glosses": [
                            "obere schützende Putzschicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3184153c-349c-4a39-b437-98c5af310ad6",
                                "sense_id": "4a2994eb-7d97-31a5-b865-51701119a402",
                                "text": "„Die Hauptschicht wird als Unterputz und die Dekorschicht als Oberputz (letzte Lage) bezeichnet.“"
                            },
                            {
                                "example_id": "f151b7a0-6b35-4754-8052-095a2d1ce25f",
                                "sense_id": "4a2994eb-7d97-31a5-b865-51701119a402",
                                "text": "„Grundsätzlich gilt, daß der Unterputz mindestens die gleiche Festigkeit wie der spätere Oberputz erreichen soll.“"
                            },
                            {
                                "example_id": "87ff75b5-b4e4-4cef-b8b3-719936ca3be1",
                                "sense_id": "4a2994eb-7d97-31a5-b865-51701119a402",
                                "text": "„Sie empfiehlt einen Putz mit sieben Millimetern Gewebespachtelung plus drei Millimetern Oberputz.“"
                            },
                            {
                                "example_id": "5a87a939-47d8-4f96-9eaa-60a6c802640b",
                                "sense_id": "4a2994eb-7d97-31a5-b865-51701119a402",
                                "text": "„Beim Mauern verputzen werden zwei Schichten verwendet: Der Unter- und der Oberputz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
