                ],
                "senses": [
                    {
                        "sense_id": "0d72bc34-e0ff-3e25-b326-5ea47d3d090b",
                        "entry_id": "790abce6-232a-33f7-a52b-0cfadf0d9017",
                        "glosses": [
                            "Congrès du parti, convention de parti."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ab1c36-76b2-45ed-b78a-844a0fc5d74f",
                                "sense_id": "0d72bc34-e0ff-3e25-b326-5ea47d3d090b",
                                "text": "Auf den meisten Parteitagen sind nicht alle Parteimitglieder, sondern aus organisatorischen Gründen nur eine festgelegte Anzahl von Delegierten anwesend.",
                                "translation": "La plupart des congrès du parti ne rassemblent pas tous les membres du parti, mais, pour des raisons d'organisation, seulement un nombre fixe de délégués."
                            },
                            {
                                "example_id": "74b0f880-18c0-4476-acf4-1d5b83a888b4",
                                "sense_id": "0d72bc34-e0ff-3e25-b326-5ea47d3d090b",
                                "text": "Ob Joe Biden das sehnsuchtsvolle Lied auch wirklich hörte, darf angezweifelt werden – schließlich befindet sich der US-Präsident derzeit in Chicago, wo er gestern Abend beim Parteitag der US-Demokraten auftrat.",
                                "translation": "On peut douter que Joe Biden ait réellement entendu cette chanson pleine de nostalgie - après tout, le président américain se trouve actuellement à Chicago, où il s’est produit hier soir lors de la convention du parti démocrate américain."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
