                ],
                "senses": [
                    {
                        "sense_id": "b7bcf0e7-8f81-30f5-bce9-ba1602deb809",
                        "entry_id": "ed8813b1-d4ea-370c-b902-4e9c5ef104f0",
                        "glosses": [
                            "Organisation, die Aus- und Weiterbildung im Bereich des Laufsports anbietet"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8a3bf22e-bed1-46b6-8fc3-366950989c1d",
                                "sense_id": "b7bcf0e7-8f81-30f5-bce9-ba1602deb809",
                                "text": "„Im zweiten geht´s darum, wann die Laufakademie startet.“"
                            },
                            {
                                "example_id": "4b17acec-88b4-41b6-b149-8e89cfad9393",
                                "sense_id": "b7bcf0e7-8f81-30f5-bce9-ba1602deb809",
                                "text": "„Zusätzlich bietet der Verein regelmäßig Nordic-Walking-Einsteiger-Intensivkurse an, die von Ausbildern durchgeführt werden, die ihre Lizenz beim Fußball- und Leichtathletikverband Westfalen e. V. (Laufakademie Kaiserau) erworben haben.“"
                            },
                            {
                                "example_id": "a16c4e4c-ce34-4a39-9364-7840bfa9c2cc",
                                "sense_id": "b7bcf0e7-8f81-30f5-bce9-ba1602deb809",
                                "text": "„Der zweifache deutsche Mannschaftsmeister im Gehen war aufgrund seiner hohen fachlichen Kompetenz im FLVW auch Kampfrichter-Lehrwart, Mitglied des Breitensportausschusses und Mitbegründer der westfälischen Laufakademie.“"
                            },
                            {
                                "example_id": "149d7048-12a8-4197-8009-ebc317f769ee",
                                "sense_id": "b7bcf0e7-8f81-30f5-bce9-ba1602deb809",
                                "text": "„Aber ganz besonders freue ich mich jetzt schon auf die 2 Wochen an der Laufakademie von Andreas Butz für die Ausbildung zum Lauftrainer (B-Lizenz).“"
                            },
                            {
                                "example_id": "d44cb771-37ee-4193-998e-2b36bd52c170",
                                "sense_id": "b7bcf0e7-8f81-30f5-bce9-ba1602deb809",
                                "text": "„Die westfälische Laufakademie des Fußball- und Leichtathletikverbandes Westfalen ist ebenfalls Kooperationspartner und führt ab sofort ein Mentorenprogramm zur gesundheitsorientierten langfristigen Trainingsvorbereitung durch.“"
                            },
                            {
                                "example_id": "8a727efc-b0bc-4fc2-b56f-f461f83d98b4",
                                "sense_id": "b7bcf0e7-8f81-30f5-bce9-ba1602deb809",
                                "text": "„An den Wochenenden 11. bis 12. Juni und 24. bis 26. Juni haben Interessierte, die eine Lizenz der Laufakademie als Walking-Trainer erhalten möchten, Gelegenheit, die 45 Unterrichtsstunden umfassende Ausbildung in der Weserlandklinik Bad Seebruch in Vlotho zu absolvieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
