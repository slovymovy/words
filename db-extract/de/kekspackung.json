                        "examples": [
                            {
                                "example_id": "9be228f5-0675-4d04-9bc8-161facbe3436",
                                "sense_id": "1a1c6e3e-8d46-3b5a-a354-715041ae78b6",
                                "text": "„Er holte eine knisternde Kekspackung heraus, die er mir gleich darauf auffordernd hinhielt.“"
                            },
                            {
                                "example_id": "24875fa8-db05-4bf1-b7fe-727f757fb916",
                                "sense_id": "1a1c6e3e-8d46-3b5a-a354-715041ae78b6",
                                "text": "„Es kam ihm vor, als versteckten sie etwas hinter ihren Rücken, und er hatte den Verdacht, dass die Kekspackung oben im Schrank nicht mehr an ihrem Platz war.“"
                            }
                        ],
