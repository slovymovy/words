                "senses": [
                    {
                        "sense_id": "691f12b5-dfdd-391a-994e-b347bbb03fab",
                        "entry_id": "1076b880-5cca-3a72-a697-1d7f86236532",
                        "glosses": [
                            "„Gesamtheit aller wirtschaftlichen, technischen, wissenschaftlichen, politischen, rechtlichen, administrativen und gesellschaftlichen Einrichtungen, Verfahren, Prinzipien und Regeln, die die Nutzung, den Transport, den Handel, den Erhalt und den Schutz von Wald durch den Menschen betreffen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc7869e-6485-4c3e-b761-fdb479e6b528",
                                "sense_id": "691f12b5-dfdd-391a-994e-b347bbb03fab",
                                "text": "„Im März wollen sich Abgeordnete und Betroffene im Agrarausschuss des Landtages an einen Tisch setzen und über mögliche Alternativen zur Entlassungswelle im Forstwesen beraten.“"
                            },
                            {
                                "example_id": "a040291c-b0bc-4137-bd37-bfd1debe5330",
                                "sense_id": "691f12b5-dfdd-391a-994e-b347bbb03fab",
                                "text": "„Früher konnte man auch ohne Schulabschluß in der Landwirtschaft, im Forstwesen, in der Fabrik, bei der Seefahrt und im Straßenbau unterkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
