                ],
                "senses": [
                    {
                        "sense_id": "058bff5b-6476-3fb7-8da0-70d14fe3b4f5",
                        "entry_id": "32b1aba1-16b4-3c25-adb8-da2985f5931b",
                        "glosses": [
                            "Enlever les escarbilles des cendres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35cb6041-8999-4933-9f23-43af21f7452a",
                                "sense_id": "058bff5b-6476-3fb7-8da0-70d14fe3b4f5",
                                "text": "Son noyau d’agonie n’en finissait pas d’éborgner le rivage ou de l’escarbiller."
                            },
                            {
                                "example_id": "3250e2d2-c75e-49ec-945a-848ccd0a45e1",
                                "sense_id": "058bff5b-6476-3fb7-8da0-70d14fe3b4f5",
                                "text": "Afin de maintenir les côtés des paquets à la même température, on commence par escarbiller une moitié de la grille, et à la fin de l’opération, on escarbille l’autre, de façon à intervertir la température des deux parois du four."
                            },
                            {
                                "example_id": "858855ba-0143-45a9-8380-cc1d29dffc5f",
                                "sense_id": "058bff5b-6476-3fb7-8da0-70d14fe3b4f5",
                                "text": "Les chauffeurs, lorsqu’ils ne sont pas surveillés de très près, ont une tendance à escarbiller la grille avant que le carbone contenu dans les immondices n’ait été complètement brûlé."
                            }
                        ]
                    },
                    {
                        "sense_id": "467a440c-456f-3f46-8f08-25e9596d52b8",
                        "entry_id": "32b1aba1-16b4-3c25-adb8-da2985f5931b",
                        "glosses": [
                            "en gastronomie, au cours du repas, vider son assiette des coquilles vides de fruits de mer"
                        ],
