                                        "sense_id": "86b7ceb7-404f-31c2-8185-4525a2967877",
                                        "entry_id": "20d8ad55-e71f-310e-b532-ebbd5131e23a",
                                        "glosses": [
                                            "Pays d’Afrique, bordé par le Niger et le Burkina Faso au nord, le Nigeria à l’est, le golfe du Bénin au sud, et le Togo à l’ouest. Sa capitale est Porto-Novo."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9dc03d2-613a-4c7e-a07d-0257ad8b5fe4",
                                                "sense_id": "86b7ceb7-404f-31c2-8185-4525a2967877",
                                                "text": "Au Bénin, trois strates ont été retenues : le milieu urbain, le milieu semi-urbain et le milieu rural."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60446459-3fa8-3c37-a7e1-5926d8be32c2",
                                        "entry_id": "20d8ad55-e71f-310e-b532-ebbd5131e23a",
                                        "glosses": [
                                            "Royaume disparu situé au Nigéria actuel."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e986630e-49ba-4ef1-9fc2-7d7137275753",
                                                "sense_id": "60446459-3fa8-3c37-a7e1-5926d8be32c2",
                                                "text": "Le royaume de Benin, dont les bornes ne sont pas déterminées avec beaucoup de certitude, paraît situé entre le 8ᵉ degré nord et l’équateur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
