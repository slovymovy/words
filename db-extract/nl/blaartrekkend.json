                        "glosses": [
                            "blaren in de huid veroorzakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eab58f5-797f-4cbb-92b1-8bf7c0f433aa",
                                "sense_id": "1c113073-b866-3edf-b4c7-de6dcca63d85",
                                "text": "Een ander chemisch wapen is mosterdgas. Het is een vloeistof die, wanneer de damp wordt ingeademd, sterk prikkelend en blaartrekkend werkt. De huid wordt rood en bij voldoende blootstelling vormen zich na verloop van tijd blaren. Ook op de longen en de ogen heeft het een verwoestend effect. Het kan bij hogere doses blindheid en doofheid veroorzaken."
                            }
                        ]
