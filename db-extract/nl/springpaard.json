                                        "entry_id": "b4292a0c-cf88-36fb-9a2b-121444c811b5",
                                        "glosses": [
                                            "A spring to impel the starwheel, or a pawl to lock fast a wheel, in a repeating timepiece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86c15873-aadc-3280-a088-3aef725ef4b1",
                                        "entry_id": "b4292a0c-cf88-36fb-9a2b-121444c811b5",
                                        "glosses": [
                                            "A shot in which the player releases the ball at the highest point of a jump; a jump shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57a4428-6e40-4050-86a9-1508c328f854",
                                                "sense_id": "86c15873-aadc-3280-a088-3aef725ef4b1",
                                                "text": "[Markieff] Morris isn’t quite the post-up threat that [Enes] Kanter is, and he can play both the 4 spot and 5 spot instead of just center, like Kanter. He is capable of playing a similar way, backing defenders down in the post. He prefers getting his buckets there with a bevy of fade-aways and jumpers. He’s a heat checker. And he can get hot on the block."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d8fd076-984d-39a2-8a46-0355c00b7e35",
                                        "entry_id": "b4292a0c-cf88-36fb-9a2b-121444c811b5",
                                        "glosses": [
                                            "A nuclear power plant worker who repairs equipment in areas with extremely high levels of radiation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30744210-62df-4db5-bd14-786701784f0d",
                                                "sense_id": "2d8fd076-984d-39a2-8a46-0355c00b7e35",
                                                "text": "In nuclear plants, robots toil for hours at a time in highly radioactive areas in place of hundreds of employees, called jumpers or glowboys, who worked in short relays so as to minimize their exposure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5e7c4ad-473e-36f3-b5f4-d01751448bb3",
                                        "entry_id": "b4292a0c-cf88-36fb-9a2b-121444c811b5",
                                        "glosses": [
                                            "A platform game based around jumping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fa3dd0-5263-49de-8bb1-dbd4e2cee142",
                                                "sense_id": "a5e7c4ad-473e-36f3-b5f4-d01751448bb3",
                                                "text": "This is an extremely hard to find platform jumper centered around everyone's favorite dot eating hero."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad629b3-302f-3113-aa40-110569cef5a8",
