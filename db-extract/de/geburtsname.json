                    {
                        "form_id": "9e181b49-4554-462e-a411-5f1bca0fab4e",
                        "entry_id": "342ceb50-194e-32fa-8a18-54dc7923b419",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Geburtsnamen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c1df845-b355-33c3-bae7-84944a5cde5b",
                        "entry_id": "342ceb50-194e-32fa-8a18-54dc7923b419",
                        "glosses": [
                            "Name, den jemand als ersten nach seiner Geburt erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68eef89-9326-4c6e-9ab5-1159a5095070",
                                "sense_id": "2c1df845-b355-33c3-bae7-84944a5cde5b",
                                "text": "„Lumumba ist nicht sein Geburtsname, aber so nennen sie ihn bald.“"
                            },
                            {
                                "example_id": "b6c09f26-2c37-40d5-af7d-a6e4319e82fc",
                                "sense_id": "2c1df845-b355-33c3-bae7-84944a5cde5b",
                                "text": "„Den zweifellos nüchternen Geburtsnamen Erich Paul Remark »verschönerte« er, indem er Paul durch Maria ersetzte, und – legitimiert durch den französischen Ursprung seiner Vorfahren – aus Remark wurde Remarque.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3e2de5a7-53a2-333d-9fa5-a4f833f4879e",
                        "entry_id": "342ceb50-194e-32fa-8a18-54dc7923b419",
                        "glosses": [
                            "anders als durch Ehe (oder Lebenspartnerschaft) (gegebenenfalls auch noch lange nach der Geburt) erworbener (früherer) Familienname"
                        ],
                        "tags": [
                            "Germany",
                            "law"
                        ],
                        "examples": [
                            {
                                "example_id": "f772687c-69ce-471c-a003-bb02065a57c4",
                                "sense_id": "3e2de5a7-53a2-333d-9fa5-a4f833f4879e",
                                "text": "„Da die Eheschließenden heute den Geburtsnamen vom Mann oder von der Frau als gemeinsamen Namen wählen können, sprechen die rechtlichen Vorschriften vom Ehenamen.“"
                            },
                            {
                                "example_id": "42ca2640-bb18-42db-85ab-82c9e8057fee",
                                "sense_id": "3e2de5a7-53a2-333d-9fa5-a4f833f4879e",
                                "text": "„Wahrscheinlich ist nur wichtig, daß die Leute überhaupt ausreisen; mein Name samt Geburtsnamen, das Geburtsdatum und der Geburtsort werden notiert, der letztere in seiner neuen, polonisierten Fassung: Rumsko statt Rumbske.“"
                            },
                            {
                                "example_id": "8d90f53a-80d2-4fef-a1c1-e68c508b3279",
                                "sense_id": "3e2de5a7-53a2-333d-9fa5-a4f833f4879e",
                                "text": "„Ein wichtiger Grund für die Änderung des Geburtsnamens eines Ehegatten wird nur selten vorliegen. Die Änderung ist aber möglich, z.B. wenn dieser Name für die Eltern und Geschwister des Ehegatten gleichzeitig geändert wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dfebf1c-d17e-4531-a926-23e20375fa70",
                        "source_entry_id": "342ceb50-194e-32fa-8a18-54dc7923b419",
                        "source_sense_id": "2c1df845-b355-33c3-bae7-84944a5cde5b",
