                "senses": [
                    {
                        "sense_id": "f18805e9-5d26-39bb-bc36-90a3cb88d88e",
                        "entry_id": "0ae3ede4-f92b-30a0-9972-dd77a0437bd0",
                        "glosses": [
                            "so groß wie eine Stecknadel, die Größe einer Stecknadel habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "566eaf22-5279-4e77-aae5-e608da1e5fd1",
                                "sense_id": "f18805e9-5d26-39bb-bc36-90a3cb88d88e",
                                "text": "„Er hielt auf ein stecknadelgroßes Licht zu, das vor ihm allmählich zur Größe eines Daumennagels anwuchs.“"
                            },
                            {
                                "example_id": "b814127c-f4e4-4009-93a3-ac82ed254d81",
                                "sense_id": "f18805e9-5d26-39bb-bc36-90a3cb88d88e",
                                "text": "„Als ich Lee anschaute, fiel mir auf, dass seine Pupillen schon wieder stecknadelgroß waren, ein sicheres Anzeichen dafür, dass er auf dem nächsten Benzedrintrip war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
