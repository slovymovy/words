                "senses": [
                    {
                        "sense_id": "202e6011-2508-3c56-89b1-3c17b24ebce7",
                        "entry_id": "71d18674-c9b7-3a8f-9703-5226b7b62cf6",
                        "glosses": [
                            "Veste ayant une coupe de type chemise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8c131ab-2120-4b6f-8363-b2922f5040e7",
                                "sense_id": "202e6011-2508-3c56-89b1-3c17b24ebce7",
                                "text": "Une surchemise finalement, c’est un vêtement que l’on va mettre en 5 secondes le matin avant de partir par dessus un haut, qu’il s’agisse d’un simple t-shirt, d’un polo et même d’une chemise. Un vêtement qui n’aura pas le style et la rigueur d’une veste de costume, d’un blazer ou d’un vêtement trop épais comme un manteau."
                            },
                            {
                                "example_id": "287eb7f7-3aa8-47d2-896f-0290b643daee",
                                "sense_id": "202e6011-2508-3c56-89b1-3c17b24ebce7",
                                "text": "Esprit saharienne, workwear ou bûcheron, la surchemise sert de veste en automne et se glisse sous un manteau pour tenir chaud l’hiver."
                            },
                            {
                                "example_id": "75d9d139-f352-4404-a3d8-84786503d3b0",
                                "sense_id": "202e6011-2508-3c56-89b1-3c17b24ebce7",
                                "text": "Après la saison 4, les recherches sur les Check Shacket, ces surchemises à carreaux portées par Eleven et Mike, ont fait un bond de 3 000 %, selon les chiffres de LTK."
                            }
                        ]
                    }
                ],
                "translations": [
