                "senses": [
                    {
                        "sense_id": "0b851b99-c0dd-38d9-a877-870767de99ea",
                        "entry_id": "b0090837-2d0e-340f-abdd-90c64dd82bad",
                        "glosses": [
                            "technische Einrichtung, die den Bremsvorgang eines Fahrzeugs kontrolliert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "828b92bb-c934-4426-adba-beffa5a123bd",
                                "sense_id": "0b851b99-c0dd-38d9-a877-870767de99ea",
                                "text": "„Der zur Bremssteuerung eingesetzte Bordcomputer errechnet abhängig von Beladungszustand, Radhaftung an der Straße und Stärke der Bremsung die optimale Verteilung der Bremskraft an die verschiedenen Bremsen.“"
                            },
                            {
                                "example_id": "9775ba0d-17ad-4917-8610-83d8d2a8d06f",
                                "sense_id": "0b851b99-c0dd-38d9-a877-870767de99ea",
                                "text": "„Weil auch die Bremssteuerung der Fahrzeuge der neuesten Baureihe 481 konstruktionsbedingt bei Notbremsungen nicht optimal funktioniert, muss zudem die Software angepasst werden.“"
                            }
                        ],
