                        "cross_references": [
                            {
                                "target_word": "declaration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6c201b4-b013-3af5-98ab-7ebdef440c77",
                                        "entry_id": "305aa63a-d35b-3e70-9360-6db40cfb076a",
                                        "glosses": [
                                            "An emphatic or formal act of saying, telling or asserting something, by speech or writing; a decisive assertion or proclamation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ced243-9cba-4591-a8ae-68f7f0d9c11f",
                                                "sense_id": "e6c201b4-b013-3af5-98ab-7ebdef440c77",
                                                "text": "The weather was not tempting enough to draw the two others from their pencil and their book, in spite of Marianne's declaration that the day would be lastingly fair […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36984f29-17a3-36bd-8054-34a351e8f30c",
                                        "entry_id": "305aa63a-d35b-3e70-9360-6db40cfb076a",
                                        "glosses": [
                                            "Specifically, a declaration of love."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccaab1ce-cae8-444a-8b9e-901937a1a235",
                                                "sense_id": "36984f29-17a3-36bd-8054-34a351e8f30c",
                                                "text": "He blushed a great deal when the others chaffed him for his obvious preference. He made the first declaration in his life to Fräulein Hedwig, but unfortunately it was an accident […]."
                                            },
                                            {
                                                "example_id": "144153c4-a038-44d0-896a-a0ad6471d2d9",
                                                "sense_id": "36984f29-17a3-36bd-8054-34a351e8f30c",
                                                "text": "I went to Miss Mills's, fraught with a declaration."
                                            }
                                        ]
                                    },
