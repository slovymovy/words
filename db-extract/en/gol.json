                        "examples": [
                            {
                                "example_id": "c182e4d4-f33c-443b-aec1-ca8248613e18",
                                "sense_id": "4a93f03c-0083-3fab-86a2-daf996eaab21",
                                "text": "Any info about optimal GOL-algorithms are also welcome. The algorithm I figured is quite fast, but certainly not optimal.. I am using 320x198 (=63360) array of cells, and with my machine I am getting about 7.7 generations per second, but with some assembly optimizing I could be even faster."
                            },
                            {
                                "example_id": "13adb113-3236-443b-bfa5-4790d96517f2",
                                "sense_id": "4a93f03c-0083-3fab-86a2-daf996eaab21",
                                "text": "Can someone please tell me if/where there is a central repository or web site to which GoL pattern files may be posted? I have been doing some modest engineering/artwork in GoL that I wud like 2 share with others."
                            },
                            {
                                "example_id": "848a4fdd-6bca-4654-95c6-c021be377d9f",
                                "sense_id": "4a93f03c-0083-3fab-86a2-daf996eaab21",
                                "text": "Let's count a number of rules that can be built in GoL-like automatas."
                            }
                        ]
                    }
