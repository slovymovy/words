    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b418bf9-e7a1-3243-abb5-2db128d4c95f",
                    "sense_definition": "Специальное помещение в магазине, где покупатель может примерить одежду перед покупкой.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "торговля",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я пошла в <w>примерочную</w>, чтобы примерить новое платье.",
                            "target_lang_translations": {
                                "en": "I went to the <w>fitting room</w> to try on a new dress."
                            }
                        },
                        {
                            "text": "Где находится <w>примерочная</w> в этом магазине?",
                            "target_lang_translations": {
                                "en": "Where is the <w>fitting room</w> in this store?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "зайти в примерочную",
                        "свободная примерочная"
                    ],
                    "target_lang_definitions": {
                        "en": "A small room in a shop where a customer can try on clothes before purchasing them."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fitting room",
                                "target_lang_sense_clarification": "The most common term used in retail stores for trying on clothes."
                            },
                            {
                                "target_lang_word": "changing room",
                                "target_lang_sense_clarification": "A common alternative term for a room where one changes clothes, often used in retail or sports contexts."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4aa376f0-f674-356e-a012-d9de713973b0",
                    "sense_definition": "Женская форма единственного числа прилагательного <w>примерочный</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "грамматика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта <w>примерочная</w> кабина была очень тесной.",
                            "target_lang_translations": {
                                "en": "This <w>fitting</w> booth was very cramped."
                            }
                        },
                        {
                            "text": "Нам нужна <w>примерочная</w> зона для клиентов.",
                            "target_lang_translations": {
                                "en": "We need a <w>fitting</w> area for customers."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The feminine singular form of the adjective 'fitting' or 'changing', used to describe a room or area designated for trying on clothes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fitting",
                                "target_lang_sense_clarification": "Used as an adjective to describe a room or area (e.g., fitting area)."
                            }
                        ]
                    }
                }
            ]
        }
    ]
