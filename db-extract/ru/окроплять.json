                "translations": [
                    {
                        "translation_id": "61fddcd7-853b-4d81-b1b0-88f16db8987e",
                        "source_entry_id": "26d07111-ff12-3bd8-9af9-0701cd487ea0",
                        "source_sense_id": "94858886-fb25-3829-958f-2df4e148b974",
                        "target_lang_word": "sprinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65be0e86-033e-3cd2-ae7b-007039036809",
                                        "entry_id": "ba5dc3bf-631e-371e-9d06-147d83c489e5",
                                        "glosses": [
                                            "To cause (a substance) to fall in fine drops (for a liquid substance) or small pieces (for a solid substance)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f7aa5fa-2f50-4bf1-a4bf-e978eceff8a6",
                                                "sense_id": "65be0e86-033e-3cd2-ae7b-007039036809",
                                                "text": "The confectioner sprinkled icing sugar over the cakes."
                                            },
                                            {
                                                "example_id": "02e4286b-9339-42dd-8c14-e4c763d27bb0",
                                                "sense_id": "65be0e86-033e-3cd2-ae7b-007039036809",
                                                "text": "And the priest shall[…]sprinkle of the oil with his finger seven times before the Lord."
                                            },
                                            {
                                                "example_id": "61ab7ba6-2f0c-4431-a6e0-a56aad2335c4",
                                                "sense_id": "65be0e86-033e-3cd2-ae7b-007039036809",
                                                "text": "At twilight in the summer[…]the mice come out. They[…]eat the luncheon crumbs. Mr. Checkly, for instance, always brought his dinner in a paper parcel in his coat-tail pocket, and ate it when so disposed, sprinkling crumbs lavishly[…]on the floor."
                                            },
                                            {
                                                "example_id": "87d96771-ad74-4b79-b717-5bfccd2c704b",
                                                "sense_id": "65be0e86-033e-3cd2-ae7b-007039036809",
                                                "text": "Over the centuries the movement of clans and tribes of people has provided the kind of crop that would emerge if a blind god had sprinkled seeds at random on a field[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10989538-6542-398a-89b4-c4c49f045689",
                                        "entry_id": "ba5dc3bf-631e-371e-9d06-147d83c489e5",
                                        "glosses": [
                                            "To cover (an object) by sprinkling a substance on to it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a92eb3e3-396f-4cba-b773-706919e1056a",
                                                "sense_id": "10989538-6542-398a-89b4-c4c49f045689",
                                                "text": "The confectioner sprinkled the cakes with icing sugar."
                                            },
                                            {
                                                "example_id": "2cd7465d-f7d1-4d5b-bb7c-c5fad059bea6",
                                                "sense_id": "10989538-6542-398a-89b4-c4c49f045689",
                                                "text": "Most of the passengers watched from the enclosed promenade deck, but Sandra found her way to the higher, open promenade where she shivered and watched the city lights fade and the stars sprinkle themselves across a dark blue velvet sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a26098-27fa-3e0c-af60-e49b2c5ddfcf",
                                        "entry_id": "ba5dc3bf-631e-371e-9d06-147d83c489e5",
                                        "glosses": [
                                            "To drip in fine drops, sometimes sporadically."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c16e9b1-071a-456f-a79d-eadcffb7e662",
                                                "sense_id": "f6a26098-27fa-3e0c-af60-e49b2c5ddfcf",
                                                "text": "It sprinkled outside all day long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09810298-a048-3401-a3c5-90efc611a0ea",
                                        "entry_id": "ba5dc3bf-631e-371e-9d06-147d83c489e5",
                                        "glosses": [
                                            "To rain very lightly outside."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3fd877-0d9e-4760-97c4-4a7e63e4a4c6",
                                                "sense_id": "09810298-a048-3401-a3c5-90efc611a0ea",
                                                "text": "It sprinkled very early in the morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f29e2f7-0101-3e0e-9fdf-d922068f754a",
                                        "entry_id": "ba5dc3bf-631e-371e-9d06-147d83c489e5",
                                        "glosses": [
                                            "To baptize by the application of a few drops, or a small quantity, of water; hence, to cleanse; to purify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66bbe210-2168-480e-befd-0e8e9b7f2868",
                                                "sense_id": "8f29e2f7-0101-3e0e-9fdf-d922068f754a",
                                                "text": "having our hearts sprinkled from an evil conscience"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sprinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98628e5f-d741-371c-a0ef-af3632cb0519",
                                        "entry_id": "603e7fdb-c6f7-35b3-81cc-60b46ac9d134",
                                        "glosses": [
                                            "A light covering with a sprinkled substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b49d333-2312-4ff7-9dc5-8929020b8d44",
                                                "sense_id": "98628e5f-d741-371c-a0ef-af3632cb0519",
                                                "text": "He decorated the Christmas card with a sprinkle of glitter."
                                            },
                                            {
                                                "example_id": "7f926fd9-b428-403b-8a64-f7c5b141830e",
                                                "sense_id": "98628e5f-d741-371c-a0ef-af3632cb0519",
                                                "text": "My memory leaves me with a constant and deep burning, my eyes stinging and red from short sprinkles of tears which have been sneaking up on me for days now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f98a94-a9cd-3578-b794-0a4cb54cb45b",
                                        "entry_id": "603e7fdb-c6f7-35b3-81cc-60b46ac9d134",
                                        "glosses": [
                                            "A light rain shower."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "453cabe5-939a-33af-8e62-48b385070bd9",
                                        "entry_id": "603e7fdb-c6f7-35b3-81cc-60b46ac9d134",
                                        "glosses": [
                                            "An aspersorium or utensil for sprinkling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83b32d08-69a9-3d27-a18b-a3a3045e38c2",
                                        "entry_id": "603e7fdb-c6f7-35b3-81cc-60b46ac9d134",
                                        "glosses": [
                                            "A small hard piece of sugar and starch, or chocolate, used to decorate cakes etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbd9e080-0edc-4f33-93cc-3162c6733127",
                        "source_entry_id": "26d07111-ff12-3bd8-9af9-0701cd487ea0",
                        "source_sense_id": "94858886-fb25-3829-958f-2df4e148b974",
                        "target_lang_word": "besprinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besprinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9c62d0-b359-3270-911b-f44a153c87f4",
                                        "entry_id": "f0cb123f-595e-3fd6-95ba-824e9f2ae56b",
                                        "glosses": [
                                            "To sprinkle."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "393e4cf0-9b55-4a6b-b0b6-17cdb85e705b",
                                                "sense_id": "aa9c62d0-b359-3270-911b-f44a153c87f4",
                                                "text": "At this crisis the Sabine women, from the outrage on whom the war had arisen, with dishevelled hair and torn garments, the timidity natural to women being overcome by the sense of their calamities, were emboldened to fling themselves into the midst of the flying weapons, and, rushing across, to part the incensed combatants and assuage their wrath: imploring their fathers on the one hand and their husbands on the other, as fathers-in-law and sons-in-law, not to besprinkle themselves with impious blood, nor to fix the stain of murder on their offspring, the one side on their grandchildren, the other on their children."
                                            },
                                            {
                                                "example_id": "25464ed7-b37e-4242-9074-66b932fd04b2",
                                                "sense_id": "aa9c62d0-b359-3270-911b-f44a153c87f4",
                                                "text": "We could still recognize the troughs that served for the manipulation of the bread, and the oven, the arch of which is intact, with the cavity that retained the ashes, the vase for water to besprinkle the crust and make it shiny, and, finally, the triple-flued pipe that carried off the smoke — an excellent system revealed by the Pompeian excavations and successfully imitated since then."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
