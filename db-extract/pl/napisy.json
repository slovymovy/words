                    {
                        "translation_id": "f1423a91-7123-4ab8-beae-04da6a5c3344",
                        "source_entry_id": "dc32d9eb-9a09-362e-9f3a-8cc37b76faac",
                        "source_sense_id": "24ad36af-7d9a-3eea-9ae1-af18ac7bb152",
                        "target_lang_word": "Untertitel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untertitel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "ein zweiter Titel, der unter dem ersten steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddc149-15d5-446b-b281-4478669eac4b",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "Die deutsche Version des Buches trägt den Untertitel: „Ein Paar am Rande der Trennung“."
                                            },
                                            {
                                                "example_id": "3cd84ebe-98a3-4fda-a2fd-b9ceaf8a7baa",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Sie ermorde den jüdischen Witz, heißt es im Untertitel seiner Kritik.“"
                                            },
                                            {
                                                "example_id": "d6346b8a-504b-488a-98b0-42c85224922c",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Unter all den durch den Untertitel angekündigten Figuren ist der Fischhändler womöglich die eindrücklichste.“"
                                            },
                                            {
                                                "example_id": "b6926095-9519-4ea2-be0a-c8c68725e8a1",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Mir war bewußt, daß mich noch ein Untertitel erwartete.“"
                                            },
                                            {
                                                "example_id": "d1d547ee-0c6d-4c52-bb98-8df6226a213f",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Wie das im Falle von Neubearbeitungen gern geschieht, werden nicht selten bei Verlagswechsel gleichzeitig Titel oder Untertitel verändert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73f190e4-9fe8-3098-9deb-23c2eb9ae0e2",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "unter dem Bild eingeblendete Schrift in Filmen"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f000a91-fc44-47ee-9823-64cd8ba53d58",
                                                "sense_id": "73f190e4-9fe8-3098-9deb-23c2eb9ae0e2",
                                                "text": "Die DVD hat Untertitel mit Kommentaren zum philosophischem Hintergrund der Geschichte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1463b2b2-f567-3fc5-bfd5-700881049db7",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "unter dem Bild eingeblendete Schrift in Filmen",
                                            "speziell; meist: ausgeschriebenes Gesprochenes des Films oder Übersetzung dessen"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67895bc6-0f06-44d6-ad09-d24d83c50b08",
                                                "sense_id": "1463b2b2-f567-3fc5-bfd5-700881049db7",
                                                "text": "Er schaut die Filme meist auf Koreanisch und mit englischen Untertiteln."
                                            },
                                            {
                                                "example_id": "2553fec0-35af-4b0a-8656-79e5f7abc463",
                                                "sense_id": "1463b2b2-f567-3fc5-bfd5-700881049db7",
                                                "text": "„Natürlich schleppt mich dieser bekloppte Cineast in die Originalfassung, kantonesisch mit englischen Untertiteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "08109458-4377-3b7d-8866-53066facdb27",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "ein Titel oder Kommentar, der unter etwas geschrieben steht und darauf Bezug nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98412f0-2606-467b-92ee-bfb35c6398d8",
                                                "sense_id": "08109458-4377-3b7d-8866-53066facdb27",
                                                "text": "Auf den Bildern befinden sich Untertitel mit humoristischen Anmerkungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
