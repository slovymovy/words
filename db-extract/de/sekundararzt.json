                "senses": [
                    {
                        "sense_id": "694b7d8e-99d8-32eb-890f-090bd240b068",
                        "entry_id": "ea47d2ac-b585-3224-99bc-a29ff7b19776",
                        "glosses": [
                            "Arzt, der sich noch in der Facharztausbildung befindet und unter der Anleitung erfahrenerer Ärzte arbeitet"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "137040e6-58f9-4a68-97aa-f79830fdbc77",
                                "sense_id": "694b7d8e-99d8-32eb-890f-090bd240b068",
                                "text": "„Mit der Wiener Engel-Apotheke am Hof vereinbarte der ehrgeizige Sekundararzt eine Preissenkung.“"
                            },
                            {
                                "example_id": "2e3ecfc8-6abd-4190-a08e-7ffc072aa73b",
                                "sense_id": "694b7d8e-99d8-32eb-890f-090bd240b068",
                                "text": "„Zu weiterem Unglück für mich bekam mein Bruder, der mittlerweile Doktor wurde, die Stelle als Sekundararzt im Allgemeinen Krankenhaus.“"
                            },
                            {
                                "example_id": "f6f66a8a-4769-40b2-bf24-20b6bb49df92",
                                "sense_id": "694b7d8e-99d8-32eb-890f-090bd240b068",
                                "text": "„Ab 1915 wirkte Hermann Rorschach als Sekundararzt am Psychiatrischen Zentrum, seiner Frau Olga blieb eine Anstellung verwehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
