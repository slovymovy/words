                "senses": [
                    {
                        "sense_id": "c16769ea-42be-3659-a170-ba0ebb34d14b",
                        "entry_id": "e1e1d28e-9c27-38fa-b4f9-fc10414bda84",
                        "glosses": [
                            "Garten, der zu einem Kloster gehört und von den Mönchen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c6aa365-6f17-4cf6-abc8-f04c65a8b476",
                                "sense_id": "c16769ea-42be-3659-a170-ba0ebb34d14b",
                                "text": "„Nach einer behutsamen Neuinterpretation der ehemals barocken Klostergärten sind sie nun wieder eine der Hauptattraktionen der Museumsanlage und vermitteln einen nachhaltigen Eindruck von der Gartengeschichte des Klosters Dalheim und der Bedeutung von Klostergärten im Allgemeinen.“"
                            },
                            {
                                "example_id": "6a0cf540-b791-48fd-b27b-8af010c89b5d",
                                "sense_id": "c16769ea-42be-3659-a170-ba0ebb34d14b",
                                "text": "„In warmen Nächten roch das Haus jetzt wie eine Grabkapelle oder ein Klostergarten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
