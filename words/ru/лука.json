    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8448b5b-8813-35c0-a8c2-df2d8b9df92c",
                    "sense_definition": "дугообразный изгиб реки, дороги или береговой линии",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Река делает крутую <w>луку</w> в этом месте.",
                            "target_lang_translations": {
                                "en": "The river makes a sharp <w>bend</w> at this point."
                            }
                        },
                        {
                            "text": "Дорога проходит через большую <w>луку</w> реки.",
                            "target_lang_translations": {
                                "en": "The road passes through a large river <w>bend</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "изгиб",
                        "поворот"
                    ],
                    "common_phrases": [
                        "речная лука"
                    ],
                    "target_lang_definitions": {
                        "en": "A curved section or bend in a river, road, or coastline."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "A curve or turn in a path or geographical feature."
                            },
                            {
                                "target_lang_word": "curve",
                                "target_lang_sense_clarification": "A smooth, gradual change in direction."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4005d5ee-de74-3c92-bde2-8be57315897c",
                    "sense_definition": "выгнутый выступ переднего или заднего края седла",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saddle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всадник крепко держался за переднюю <w>луку</w> седла.",
                            "target_lang_translations": {
                                "en": "The rider held tightly onto the front <w>pommel</w> of the saddle."
                            }
                        },
                        {
                            "text": "Он припал к <w>луке</w> седла во время скачки.",
                            "target_lang_translations": {
                                "en": "He leaned forward over the <w>pommel</w> of the saddle during the ride."
                            }
                        }
                    ],
                    "common_phrases": [
                        "передняя лука",
                        "задняя лука"
                    ],
                    "target_lang_definitions": {
                        "en": "The raised, curved part at the front or back of a saddle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pommel",
                                "target_lang_sense_clarification": "The upward-curving front part of a saddle."
                            },
                            {
                                "target_lang_word": "cantle",
                                "target_lang_sense_clarification": "The raised back part of a saddle."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c0b623ef-09f1-32bc-ba4d-63bb378f4854",
                    "sense_definition": "мужское личное имя",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего друга зовут <w>Лука</w>.",
                            "target_lang_translations": {
                                "en": "My friend's name is <w>Luka</w>."
                            }
                        },
                        {
                            "text": "Сегодня у <w>Луки</w> день рождения.",
                            "target_lang_translations": {
                                "en": "Today is <w>Luka's</w> birthday."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A male given name."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Luka",
                                "target_lang_sense_clarification": "A common male personal name."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0e5b661-7e2e-339e-9872-7660d14a8778",
                    "sense_definition": "форма родительного падежа единственного числа существительного <w>лук</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для салата нужно много <w>лука</w>.",
                            "target_lang_translations": {
                                "en": "You need a lot of <w>onion</w> for the salad."
                            }
                        },
                        {
                            "text": "В супе совсем нет <w>лука</w>.",
                            "target_lang_translations": {
                                "en": "There is no <w>onion</w> at all in the soup."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
