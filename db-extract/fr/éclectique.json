                ],
                "senses": [
                    {
                        "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                        "entry_id": "c62cf9ef-f291-3316-a5df-de3b1792d115",
                        "glosses": [
                            "Personne qui n’adopte pas une doctrine particulière mais choisit, dans les divers systèmes, les opinions qui lui paraissent les plus justes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f898af-6322-4c4b-88e2-c58970014110",
                                "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                "text": "L’éclectique est un philosophe qui foulant aux piés le préjugé, la tradition, l’ancienneté, le consentement universel, l’autorité (...)"
                            },
                            {
                                "example_id": "0e776b11-0f65-4dfc-8f1f-8f9276cd0b57",
                                "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                "text": "Or, vous avez entrepris cette tâche : donc vous êtes vous-même un éclectique."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
