                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6643d184-0be7-496f-bbd0-ddc6c9dc4446",
                                "sense_id": "719b3743-3bfe-3577-8b20-f7f908085672",
                                "text": "„Es heißt weiterhin, dass die Kamelknochen und -schädel mittlerweile zwar von Wind und Wetter gebleicht sind, die Schieferklamm aber nach wie vor nach Tod stinkt.“"
                            },
                            {
                                "example_id": "d2ce9a80-0d7d-44cb-8257-972cfff91f14",
                                "sense_id": "719b3743-3bfe-3577-8b20-f7f908085672",
                                "text": "„Wenn eine Frau einen Kamelknochen in Ringelblumensaft einlegt und sich die Flüssigkeit dann auf die Augenlider streicht, kann sie jeden Mann verhexen, den sie ansieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
