        "de-extract.jsonl": [
            {
                "entry_id": "3ae425fd-0379-36be-9a07-fe6986bbf140",
                "word": "möchten",
                "pos": "verb",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                        "entry_id": "3ae425fd-0379-36be-9a07-fe6986bbf140",
                        "glosses": [
                            "den Wunsch nach etwas hegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b637dbcf-713b-4393-b686-8150c965a95e",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Dies zeugt sowohl von ihrem Wissen, noch etwas sagen zu sollen, als auch markiert es den Versuch, noch etwas sagen zu möchten, jedoch nicht zu wissen, was dies denn sein könnte.“"
                            },
                            {
                                "example_id": "88bbf255-8db2-4d5b-9bae-245abbbb0844",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Michaels Händedruck wird fester. Was Marco dazu bringt, erst mal etwas anderes zu möchten und seine Freunde zu vergessen.“"
                            },
                            {
                                "example_id": "f601bf4f-17b5-4120-a065-8a2c9b852520",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Kinder, die fast nie ein Instrument spielen, geben nur zu 36,7% an, auf das Gymnasium wechseln zu möchten, dies sind über 6% weniger als im Durchschnitt.“"
                            },
                            {
                                "example_id": "30c3fc8e-f1e0-46ab-bdff-a509f9e90368",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Zudem trägt sie dazu bei, sich von der oftmals automatisch auftretenden Reaktion, direkt Rat geben zu möchten, zu lösen […] und eine Metaperspektive einzunehmen […].“"
                            },
                            {
                                "example_id": "4de4f0d0-c71d-4641-9d62-9c0cc3e13b0e",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Er begnügt sich nicht damit, kein Kind zu möchten, er geht weiter und nimmt es auf sich zu bestimmen, was Ingrid auf sich nehmen, daß Ingrid ein Kind möchten soll.“"
                            },
                            {
                                "example_id": "85504111-3a54-4816-a6c6-d971be9cc44b",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Meinen Gedanken allerdings, das habe ich festgestellt, ist es in der Regel NICHT lieber, nichts zu möchten, sondern unlieber, weil sie eigentlich IMMER etwas möchten. “"
                            },
                            {
                                "example_id": "0dd25f76-011d-4772-8887-accf220e0b17",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Möchten kannst du vieles. Nur werden Wünsche nicht immer gewährt.“"
                            },
                            {
                                "example_id": "510ef3ee-cb27-438f-9ab7-ca7dc3bea7bd",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Was hätte Clara bei ihrer Semesterplanung beachten sollen, wenn sie in Mindeststudiendauer hätte bleiben möchten?“"
                            },
                            {
                                "example_id": "be52efec-fe1e-4c6b-8dab-c3cf9e63cd0f",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Tausende Fahrzeuge wären direkt an den Häusern vorbeigefahren. Kunden, die etwas hätten essen möchten, einen Kaffee hätten trinken wollen, sich für Autos interessieren.“"
                            },
                            {
                                "example_id": "19ef9c5c-6bc7-495f-8061-0faf5f1f3a6e",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Er muß tun, was er zwar durchaus nicht gewollt, aber doch von ganzem Herzen gemöchtet hat.“"
                            },
                            {
                                "example_id": "5d36576e-af30-4f75-9d93-a7e8bee80189",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Ich hab’s hundertmal gemöchtet.“"
                            },
                            {
                                "example_id": "bbf54ae1-6c46-4d7c-90df-ce3356bac4c3",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Es ist im nachhinein, wenn man die fertige Oper kennt, leicht, zu urteilen und festzustellen, daß die Ausführung guter Einfälle mehr gemöchtet als gemacht ist. Mehr gewollt als gekonnt.“"
                            },
                            {
                                "example_id": "3a5b3766-cfef-4fb7-a749-58144292c46e",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„‚Angehörige der Kampfgruppen der Berliner Betriebe und Einheiten unserer Nationalen Volksarmee übernahmen den Schutz an diesem Teil unserer Staatsgrenze‘, so kommentierte Grote, deshalb ‚wird [es] nichts mit den erwünschten Provokationen an unseren Grenzen. Nicht etwa, weil die Möchte-gern-Krieger nicht energisch genug gemöchtet hätten‘.“"
                            },
                            {
                                "example_id": "dc153c9e-2974-4646-9d5c-7e53607a46ea",
                                "sense_id": "c50caacc-aa38-35c9-a7ee-3fa137c027a5",
                                "text": "„Soll man hinschreiben: klingt lebenserfahren? Unbedingt. Mal empört naiv, wie Janis es war, dann melancholisch, wie Folk es kaum noch kann, dann bricht ein Möchtegernpunk herein, der besser ist als je ein Punk gemöchtet hätte und dabei dennoch so barock ist wie die Figur des Cellos, das alle umschwirren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
