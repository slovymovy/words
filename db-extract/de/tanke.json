                        "examples": [
                            {
                                "example_id": "e7a5a52a-6263-4c84-9a38-c3296c623426",
                                "sense_id": "135a0e3a-6868-37fd-8ecf-8c4b500b017f",
                                "text": "Ich muss noch mal kurz zur Tanke, Bier kaufen.",
                                "translation": "I have to make a dash to the gas station and buy some beer.",
                                "english": "I have to make a dash to the gas station and buy some beer."
                            },
                            {
                                "example_id": "fdfb07e5-49b8-4e4a-af6b-842218998bd1",
                                "sense_id": "135a0e3a-6868-37fd-8ecf-8c4b500b017f",
                                "text": "Ich weiß, das mit dem Schätzen ist schwierig / Ich find’s nur ätzend, wenn ich auf der Tanke kein Bier krich!",
                                "translation": "I know estimating [age] is difficult / I just find it annoying when I don’t get beer at the petrol station!",
                                "english": "I know estimating [age] is difficult / I just find it annoying when I don’t get beer at the petrol station!"
                            }
                        ]
                    }
