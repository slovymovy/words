                ],
                "senses": [
                    {
                        "sense_id": "a0d57d30-4a89-32d3-93eb-17db483c86ef",
                        "entry_id": "6f5e7db4-dc65-3a8b-8dcb-74b3cee98cc8",
                        "glosses": [
                            "порт. пришить с изнанки, снизу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e360cfd-894a-400c-abd6-619c6a4f8280",
                                "sense_id": "a0d57d30-4a89-32d3-93eb-17db483c86ef",
                                "text": "Подшить рукава. Подшить подкладку."
                            }
                        ]
                    },
                    {
                        "sense_id": "074f117d-7f50-3507-8988-ae8c674f3ab2",
                        "entry_id": "6f5e7db4-dc65-3a8b-8dcb-74b3cee98cc8",
                        "glosses": [
                            "зашить, подгибая узкой полосой край чего-нибудь, подрубить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c187450-83d5-49bf-a096-24f9d479045a",
                                "sense_id": "074f117d-7f50-3507-8988-ae8c674f3ab2",
                                "text": "Подшить платье. Подшить подол. Подшить платки."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb87efb1-4bee-30c9-b17c-b113f709091e",
                        "entry_id": "6f5e7db4-dc65-3a8b-8dcb-74b3cee98cc8",
                        "glosses": [
                            "в сапожном деле: пришить или подбить подметку к обуви"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c1b126-0864-4559-81e6-2ebe1b4f7961",
                                "sense_id": "eb87efb1-4bee-30c9-b17c-b113f709091e",
                                "text": "Подшить сапоги. Подшить валенки."
                            }
                        ]
                    },
                    {
                        "sense_id": "c32d2191-19eb-3836-88c9-a375d41218d5",
                        "entry_id": "6f5e7db4-dc65-3a8b-8dcb-74b3cee98cc8",
                        "glosses": [
                            "в плотницком деле: прибить снизу или прибить к чему-нибудь доски исподнизу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "209cc6a3-01d6-4aa0-b5a9-0ed329c16e7e",
                                "sense_id": "c32d2191-19eb-3836-88c9-a375d41218d5",
                                "text": "Подшить доски. Подшить потолок."
                            }
                        ]
                    },
                    {
                        "sense_id": "e36d13dd-cf7e-3304-827c-5e3dcec3c8ab",
                        "entry_id": "6f5e7db4-dc65-3a8b-8dcb-74b3cee98cc8",
                        "glosses": [
                            "канц. крепить, пришивая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a6ce031-3346-4e98-91b2-768ac14631a4",
                                "sense_id": "e36d13dd-cf7e-3304-827c-5e3dcec3c8ab",
                                "text": "Подшить бумаги. Подшить документы. Подшить протокол к делу."
                            }
                        ]
                    },
                    {
                        "sense_id": "74cc6e61-671c-3c9e-b7c8-efe6eb05e6b0",
                        "entry_id": "6f5e7db4-dc65-3a8b-8dcb-74b3cee98cc8",
                        "glosses": [
                            "разг. перен. приложить к уголовному делу; принять во внимание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4b39f8-70b7-4f6d-9f02-ee7b21ad9525",
                                "sense_id": "74cc6e61-671c-3c9e-b7c8-efe6eb05e6b0",
                                "text": "Руку к делу не подошьешь, зато подошьешь, например, показания десяти омоновцев, которые видели, как ты зиговал на митинге."
                            }
                        ]
                    }
                ],
