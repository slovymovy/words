                "senses": [
                    {
                        "sense_id": "f867d2a0-59d6-3bf9-9292-1014caee7893",
                        "entry_id": "ed8ff48a-d684-3592-9961-599aea1999bf",
                        "glosses": [
                            "een aanleg hebben tot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf3ae92-8a20-4575-842a-99f163c1a231",
                                "sense_id": "f867d2a0-59d6-3bf9-9292-1014caee7893",
                                "text": "'Dat zal nog moeten blijken.' Hij draaide zich om naar Slaoui. 'Aan mij heb je in ieder geval niet het juiste publiek. Mijn collega hier is intellectueler aangelegd. Het is een aardige vent, met hem kun je beter praten.' Hierop beende Driss de deur uit. Om een sigaret te roken, nam hij aan, of om te pissen. Hij bleef alleen achter met het meisje. Zijn blik kruiste de hare."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
