                "senses": [
                    {
                        "sense_id": "1dc80e03-6bde-36f9-a044-60a6b04d86da",
                        "entry_id": "b756f4f9-7666-3d2b-b9ca-6535c3efa36b",
                        "glosses": [
                            "minerał zbudowany głównie z dwutlenku krzemu występujący w wielu odmianach i kolorach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00db4041-0df4-4acf-8bfc-c840989d53f8",
                                "sense_id": "1dc80e03-6bde-36f9-a044-60a6b04d86da",
                                "text": "Kwarc jest najpospolitszym minerałem skorupy ziemskiej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c1c09d2-6c04-4a6a-97ac-782b0feef434",
                        "source_entry_id": "b756f4f9-7666-3d2b-b9ca-6535c3efa36b",
                        "source_sense_id": "1dc80e03-6bde-36f9-a044-60a6b04d86da",
                        "target_lang_word": "quartz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quartz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                        "entry_id": "d8db71e1-f36c-3e8f-a352-058498d2bf42",
                                        "glosses": [
                                            "The most abundant mineral on the earth's surface, of chemical composition silicon dioxide, SiO₂. It occurs in a variety of forms, both crystalline and amorphous. Found in every environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59ddde1-d3f5-4d7a-b092-b2550b761f34",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "The telescope and collimator have each an object-glass consisting of a single lens of quartz 1½ inch diameter and a focal length of 18½ inches for the sodium yellow light, but not more than 16 inches for the highest rays measured."
                                            },
                                            {
                                                "example_id": "d047abc9-5a79-40e7-8546-aea3fb2f54b2",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "Subsequently, the old Malay brought him the present specimen in a state of torpidity, telling him he had found it in a cavity of the quartz reef."
                                            },
                                            {
                                                "example_id": "07799cd9-666e-4635-a24b-bc4340a39776",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "My meat eats me. Who waits at the gate? / Mother of quartz, your words writhe into my ear. / Renew the light, lewd whisper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8cf96da-1039-3a4d-b998-c0ef82e9b45c",
                                        "entry_id": "d8db71e1-f36c-3e8f-a352-058498d2bf42",
                                        "glosses": [
                                            "Crystal meth: methamphetamine hydrochloride."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3be46e7-fbe6-4259-8364-b86e1500af37",
