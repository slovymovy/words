                "senses": [
                    {
                        "sense_id": "c7ee346f-546d-3c7e-bb6f-db85897a8c7b",
                        "entry_id": "efcf2007-69d2-3b4f-a5d3-e5565a0201dc",
                        "glosses": [
                            "een vooral door kinderen gebruikt vervoermiddel op twee wielen dat door het afduwen met de voet aangedreven wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd40917-8ab6-441f-88a5-470810666d1d",
                                "sense_id": "c7ee346f-546d-3c7e-bb6f-db85897a8c7b",
                                "text": "Op een persconferentie beloofde de groep zelf ook een wedstrijd te gaan organiseren: `le premier rallye mondial de la trottinette', een rally voor steprijders."
                            },
                            {
                                "example_id": "5cbed003-aeac-480d-94f5-b935e39e66bc",
                                "sense_id": "c7ee346f-546d-3c7e-bb6f-db85897a8c7b",
                                "text": "Pascales elektrische rolstoel glibbert door de papperige sneeuw. Gostoli’s zoon Kevin (27) tilt de vrouw in haar feloranje skipak op en zet haar met een soepele beweging op de Go To Ski, een door Gostoli bedachte machine. Een andere naam voor deze uitvinding is de Trottiski, naar het Franse woord trottinette (step), en dat is precies waar de constructie op lijkt: een paar ski’s met een stuurtje."
                            },
                            {
                                "example_id": "b010333f-f8ad-479a-8a7d-c960d639e365",
                                "sense_id": "c7ee346f-546d-3c7e-bb6f-db85897a8c7b",
                                "text": "De McLaren puft tevergeefs als een niet geoliede trottinette. Het is meer een symfonie van de knalpot dan van de motor. Eigenlijk is het een belediging voor de tweevoudige wereldkampioen en gekroonde virtuoos."
                            }
                        ]
                    }
