                            }
                        },
                        {
                            "text": "Na een lange dag werken heb ik echt zin in een lekker <w>bakkie</w>.",
                            "target_lang_translations": {
                                "en": "After a long day of work, I'm really in the mood for a nice <w>cup of joe</w>."
                            }
