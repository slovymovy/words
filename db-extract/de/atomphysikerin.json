                "senses": [
                    {
                        "sense_id": "3a50e2ae-5710-3b41-83ba-11700ff64d0f",
                        "entry_id": "e305f2a9-bbed-33bd-a108-a1459035c35e",
                        "glosses": [
                            "Fachfrau beziehungsweise Forscherin/Wissenschaftlerin auf dem Gebiet der Atomphysik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e08172d3-4a81-4789-88a7-f498b9410789",
                                "sense_id": "3a50e2ae-5710-3b41-83ba-11700ff64d0f",
                                "text": "„Eine einzige Frau ist bisher von der Nation in dem Heldentempel geehrt worden: die Atomphysikerin Marie Curie, und auch sie erst 1995.“"
                            },
                            {
                                "example_id": "624b8133-eb9a-4d18-8a39-d2c43026c190",
                                "sense_id": "3a50e2ae-5710-3b41-83ba-11700ff64d0f",
                                "text": "„Wir haben zum Beispiel eine gelernte Atomphysikerin, deren Zeugnisse in Deutschland nicht anerkannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
