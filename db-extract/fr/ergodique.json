                "forms": [
                    {
                        "form_id": "328ddf44-d687-43cc-8014-04adb8fa6a12",
                        "entry_id": "1777821d-bb4c-3c83-ad2b-b3585665afdc",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
