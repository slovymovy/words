                                        "entry_id": "87520ea0-710e-33cf-beb2-cde9c84f4e4a",
                                        "glosses": [
                                            "Not comparable."
                                        ],
                                        "tags": [
                                            "literally",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a3b00a6-d8ea-3c7c-85a6-8e6724c03424",
                                        "entry_id": "87520ea0-710e-33cf-beb2-cde9c84f4e4a",
                                        "glosses": [
                                            "So much better than another as to be beyond comparison."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82ea953-130f-4662-ba9e-00482306a949",
                                                "sense_id": "2a3b00a6-d8ea-3c7c-85a6-8e6724c03424",
                                                "text": "I know of nothing in all drama more incomparable from the point of view of art, nothing more suggestive in its subtlety of observation, than Shakespeare's drawing of Rosencrantz and Guildenstern."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incomparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a8ccf02-198e-3932-a5dc-d1fe07377447",
                                        "entry_id": "74abfcc5-2770-3477-8472-a5ac48a6be84",
                                        "glosses": [
                                            "Something beyond compare; a thing with which there is no comparison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24e18b42-14ec-44e5-b2a9-d072acb039ba",
                        "source_entry_id": "87332dd6-f05c-370a-8629-0eeddc1f7e34",
                        "source_sense_id": "b9981378-ec87-34d5-b71c-9926de196b8d",
                        "target_lang_word": "matchless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matchless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                        "entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                                        "glosses": [
                                            "Having no match; without equal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389fa414-8057-4cc0-b85a-99aa2ddc6970",
                                                "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                                "text": "[T]he Prince was to declare the victor in the first day's tourney, who should receive as prize a warhorse of exquisite beauty and matchless strength."
                                            },
                                            {
                                                "example_id": "0ac65a0a-b116-4410-84d4-6606c6c2cc5d",
                                                "sense_id": "12e57e45-1bc3-3fe8-b10d-71dace8c1788",
                                                "text": "It was not his matchless talent that exalted Koufax beyond his greatest contemporaries so much as it was his knowledge that character was not connected to talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159011ce-8252-33c8-b0f6-95b78e3b17f4",
                                        "entry_id": "3219718b-33ca-3227-8c17-199cbec817c3",
                                        "glosses": [
                                            "Having no mate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4419da4b-12ed-40f6-8773-7a671d0a5cae",
                                                "sense_id": "159011ce-8252-33c8-b0f6-95b78e3b17f4",
                                                "text": "In this comedy, a matchmaker has a matchless daughter. Try as he might, he cannot seem to find anyone for her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matchless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11bb2f77-7c69-39ec-a629-ea9b4bf3f244",
                                        "entry_id": "7afbe612-24a6-3abd-9de4-dafa68f00970",
                                        "glosses": [
                                            "Without the use of matches for ignition."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
