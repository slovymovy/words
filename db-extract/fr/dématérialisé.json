                "senses": [
                    {
                        "sense_id": "703fcea6-e2df-305d-8ab6-582112b4ca5a",
                        "entry_id": "f977d332-b17b-349e-8670-b777ec6c2522",
                        "glosses": [
                            "Dont la valeur ou les données contenues sont conservées sur un support électronique plutôt que sur papier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b4b30a-34bd-4a8f-a0e4-df5a50df6314",
                                "sense_id": "703fcea6-e2df-305d-8ab6-582112b4ca5a",
                                "text": "Si l'on en croit un article publié sur le site du magazine britannique NME, vous ne pouvez pas transmettre vos jeux dématérialisés, parce qu'il ne sont pas exactement à vous."
                            },
                            {
                                "example_id": "806cbb85-c129-4a2e-a2c9-e98488dbb8cd",
                                "sense_id": "703fcea6-e2df-305d-8ab6-582112b4ca5a",
                                "text": "Sony est dans la ligne de mire d’une action collective en justice aux Pays-Bas pour le prix des jeux dématérialisés vendus sur son PlayStation Store."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cdfdedb-dfd7-4828-a0c9-3f7b6f164c0f",
                        "source_entry_id": "f977d332-b17b-349e-8670-b777ec6c2522",
                        "source_sense_id": "703fcea6-e2df-305d-8ab6-582112b4ca5a",
                        "source_sense_description": "dont la valeur ou les données contenues sont conservées sur un support électronique plutôt que sur papier",
                        "target_lang_word": "paperless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
