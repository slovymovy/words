                    "synonyms": [
                        "tether"
                    ],
                    "common_phrases": [
                        "leather hobble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ремень или веревка, используемая для связывания ног животного.",
                        "tr": "Hayvanların hareketini kısıtlamak için ayaklarına bağlanan kayış veya ip."
                    },
                    "translations": {
