                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bf397d4-f184-4c6d-bdc7-8f928ea909a0",
                                                "sense_id": "391e8144-b0f1-3371-ae5a-c533bbb7af90",
                                                "text": "Den Soldaten wurde aufgetragen, die gegnerische Festung vollständig zu rasieren."
                                            }
                                        ],
