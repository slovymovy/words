                        "sense_id": "ad9bd1cf-baab-31a3-8c8b-cefec9a70f09",
                        "entry_id": "059e49bc-7f78-37cd-82fd-92c02868fc8c",
                        "glosses": [
                            "Fraction obtenue en divisant vingt-sept fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
