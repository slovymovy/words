                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e448f02-1cd8-4641-a700-5bbf04a7697e",
                        "source_entry_id": "5b2a2c52-b5b5-3e65-8303-ab9cca725d7c",
