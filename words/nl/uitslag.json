                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oppervlakte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit witte <w>uitslag</w> op de bakstenen muur door het zout in het metselwerk.",
                            "target_lang_translations": {
