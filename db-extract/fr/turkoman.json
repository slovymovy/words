                "senses": [
                    {
                        "sense_id": "516c8e6f-880b-373b-86ee-85271a07d810",
                        "entry_id": "86dc4cea-6a37-3e43-ae91-38961c7555ec",
                        "glosses": [
                            "Celui qui est membre d’un peuple de Transcaucasie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1056f4b1-7c58-46f1-a1a0-8807c9067697",
                                "sense_id": "516c8e6f-880b-373b-86ee-85271a07d810",
                                "text": "Ayez donc appris […] que les diverses populations nomades des gouvernements de la Transcaucasie se décomposent ainsi par familles : Kalmouks, descendants des Éleuthes, quinze mille ; Kirghizes, d’origine musulmane, huit mille ; Tartares de Koundrof, onze cents ; Tartares de Sartof, cent douze ; Nogaïs, huit mille cinq cents ; Turkomans, près de quatre mille !"
                            },
                            {
                                "example_id": "090eb66b-e632-496b-9f28-f9085858aff0",
                                "sense_id": "516c8e6f-880b-373b-86ee-85271a07d810",
                                "text": "Les Turkomanes riches portent aux bras et aux pieds des bracelets pour la plupart en argent et ornés de turquoises, des ceintures et des colliers enrichis de pierreries et d'énormes boucles d’oreilles, le tout en argent."
                            }
                        ]
                    }
