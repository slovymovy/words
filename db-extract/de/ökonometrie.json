                                "sense_id": "f23e8e11-7621-3212-8208-c64891da9141",
                                "text": "Ziel der Ökonometrie ist es, funktionale Beziehungen zwischen ökonomischen Variablen aufzuspüren und zu messen."
                            }
                        ],
                        "sense_index_json": "\"1\""
