                    {
                        "translation_id": "b21f8ce7-2093-41aa-97fa-4e9d1c250ecc",
                        "source_entry_id": "b9ed4618-783d-3a95-838a-5d306cac32ec",
                        "source_sense_description": "maid that waits at hand",
                        "target_lang_word": "Dienerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dienerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                        "entry_id": "addaba31-885a-36c9-b794-c8a37695da70",
                                        "glosses": [
                                            "weibliche Person, die für jemanden bestimmte Pflichten erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5261afb2-8919-4b3b-b11d-f09e80a91a3c",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die Einzigen von ihnen, die jemals ihren Fuß in die Stadt setzten, waren die schwarzen Diener und Dienerinnen, welche die Plantagenbesitzer von den karibischen Inseln mitbrachten, wenn sie Frankreich einen Besuch abstatteten.“"
                                            },
                                            {
                                                "example_id": "23e0e027-b2f0-4402-9912-cae80d315623",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die Dienerin brachte Simen Tjing eine Tasse Tee.“"
                                            },
                                            {
                                                "example_id": "19c03b3c-f5c9-42f2-accf-3776148569b3",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die Dummheit einer Dienerin ist viel gefährlicher als ihre Bosheit und belastet den Herrn weit mehr, denn eine Bösartige kann man mit Recht bestrafen, eine Dumme aber nicht; man kann sie nur fortschicken und sich damit abfinden.“"
                                            },
                                            {
                                                "example_id": "3cb7f09d-34c2-4e01-9463-ee038ab8cf68",
                                                "sense_id": "610ba24f-8aa4-391b-9da5-bedc0cceb5d8",
                                                "text": "„Die alte Dienerin knickste, die Patronin legte den Deckel auf die Suppenschüssel und winkte leicht mit der Hand, der Patron, dessen Schnurrbart noch schwärzer als vordem glänzte, warf einen prüfenden Blick über Tisch und Gast, wobei er das Tischtuch andeutend zurechtzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab8b8248-9a99-39ce-aa85-f86c7522aa23",
                                        "entry_id": "addaba31-885a-36c9-b794-c8a37695da70",
                                        "glosses": [
                                            "weibliche Person, die sich von sich aus für jemanden oder etwas einsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64621054-12ea-4066-a7a4-c8c87f966a09",
                        "source_entry_id": "b9ed4618-783d-3a95-838a-5d306cac32ec",
                        "source_sense_description": "maid that waits at hand",
                        "target_lang_word": "Zofe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zofe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                        "entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                                        "glosses": [
                                            "Bedienstete einer vornehmen, höhergestellten Dame, Herrin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7343627a-6b15-4c18-b2f1-3f92c45a206e",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Eine Zofe, ebenfalls im historischen Kostüm, bringt frisch geräucherte Forellen.“"
                                            },
                                            {
                                                "example_id": "7c958ba5-1cfb-4940-85a2-ffc4981b10fb",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Natürlich hatte die Gräfin außer dem Butler noch anderes Personal: Zimmermädchen, Koch, Köchin, Gärtner, Zofe, Chauffeur.“"
                                            },
                                            {
                                                "example_id": "c058ca1e-aaab-4ead-b105-544be056e8f4",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Bald darauf bemerkte er, wie die kleine Zofe Lenzfreude in der Dunkelheit die Mauer erkletterte und scheinbar die Katze rief.“"
                                            },
                                            {
                                                "example_id": "5827404a-edd4-42fe-b9f8-70ebbee8a41a",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Die kleine Fürstin erhob sich aus ihrem Lehnstuhl, läutete nach der Zofe und begann flink und vergnügt einen Plan für die Toilette der Prinzessin Marja zu entwerfen und auszuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
