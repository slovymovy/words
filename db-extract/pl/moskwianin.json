                    {
                        "translation_id": "7a9dc659-93a0-4863-a1ca-b768700e0d5a",
                        "source_entry_id": "25df0ae8-7bd3-3fe2-9a42-6c5c6dccc352",
                        "source_sense_id": "0482192a-05a8-310c-b31a-96e03aa01ec7",
                        "target_lang_word": "Moskauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moskauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf6f37f-a342-3581-bf91-32f3943f2a3c",
                                        "entry_id": "cf257967-729d-358f-9628-ba10a90bc24c",
                                        "glosses": [
                                            "ein Einwohner, Bewohner der Stadt Moskau, eine in Moskau geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c691ef-00ea-4261-aa2a-184b2230d29c",
                                                "sense_id": "6bf6f37f-a342-3581-bf91-32f3943f2a3c",
                                                "text": "Er ist gebürtiger Moskauer."
                                            },
                                            {
                                                "example_id": "3c7230e1-3845-460c-a59f-ce866006680d",
                                                "sense_id": "6bf6f37f-a342-3581-bf91-32f3943f2a3c",
                                                "text": "„Die Moskauer feierten auf jeden Fall ihre Siege.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Moskauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "617c530b-be7a-31de-9be8-30ff5e302632",
                                        "entry_id": "28a940c6-43d9-3652-834e-65a0853ca78a",
                                        "glosses": [
                                            "sich auf die Stadt Moskau beziehend, in der Art und Weise dieses Ortes, aus Moskau kommend, stammend, Moskau betreffend, zu Moskau gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde49259-957a-4569-816e-296acccbac45",
                                                "sense_id": "617c530b-be7a-31de-9be8-30ff5e302632",
                                                "text": "Die Moskauer Straßen sind eigentlich immer verstopft."
                                            },
                                            {
                                                "example_id": "2e5055b7-9643-4e46-9987-b7f507d66df5",
                                                "sense_id": "617c530b-be7a-31de-9be8-30ff5e302632",
                                                "text": "„Eine Flugpassagierin hat nach der Landung auf dem Moskauer Flughafen eine ungewollte Ehrenrunde gedreht: Die ältere Dame habe beim Griff nach ihrem Gepäck auf dem Gepäckband das Gleichgewicht verloren, sei auf das rotierende Band gestürzt und von diesem bis in den Frachtraum getragen worden, erklärte die Polizei des Flughafens Scheremetjewo am Sonntag gegenüber russischen Medien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "187dc8dd-42e3-459b-8d73-b6f9acd21a0d",
                        "source_entry_id": "25df0ae8-7bd3-3fe2-9a42-6c5c6dccc352",
                        "source_sense_id": "0482192a-05a8-310c-b31a-96e03aa01ec7",
                        "target_lang_word": "Moskowiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moskowiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e3b377-8eae-32b2-bc3d-79fa32f5fb1c",
                                        "entry_id": "9d425f51-cfa0-3cd7-b5c7-8e51b0ff2ea3",
                                        "glosses": [
                                            "ein Einwohner, Bewohner der Hauptstadt Russlands, eine in Moskau geborene Person"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb1a387-31b0-4a5e-a39e-e0f23a90db3c",
                                                "sense_id": "e0e3b377-8eae-32b2-bc3d-79fa32f5fb1c",
                                                "text": "„Nur durch Mundpropaganda erfuhren die Moskowiter, was wirklich im Zentrum der Stadt geschehen war.“"
                                            },
                                            {
                                                "example_id": "4298191f-1eb2-4305-8a91-2e769f91ca7f",
                                                "sense_id": "e0e3b377-8eae-32b2-bc3d-79fa32f5fb1c",
                                                "text": "„Den Moskowitern kam es entgegen, dass die christlichen Georgier und Armenier sich von den muslimischen Nachbarn bedroht fühlten.“"
                                            },
                                            {
                                                "example_id": "ff79a90d-e307-4285-8899-f1711404e5cb",
                                                "sense_id": "e0e3b377-8eae-32b2-bc3d-79fa32f5fb1c",
                                                "text": "„Rastoptschin suchte den Moskowitern in seinen Proklamationen einzuschärfen, dass ein Verlassen Moskaus schimpflich sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a936e778-af2c-3f54-8f82-e91d54a473fe",
                                        "entry_id": "9d425f51-cfa0-3cd7-b5c7-8e51b0ff2ea3",
                                        "glosses": [
                                            "Einwohner/Bewohner des Moskauer Fürstentums"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "088df9b3-87c2-415c-aa00-3f4b45172b65",
                        "source_entry_id": "25df0ae8-7bd3-3fe2-9a42-6c5c6dccc352",
                        "source_sense_id": "0482192a-05a8-310c-b31a-96e03aa01ec7",
                        "target_lang_word": "москвич",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "москвич",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1d85f19f-5269-338c-a1d3-efb3b35454d2",
                                        "entry_id": "38f61221-6ef9-39fe-b8b9-a81fa9e64ad6",
                                        "glosses": [
                                            "житель или уроженец города Москвы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19895aba-c27f-4bc1-a224-256e1f075c8c",
                                                "sense_id": "1d85f19f-5269-338c-a1d3-efb3b35454d2",
                                                "text": "Мы встречаемся каждый день у колодца, на бульваре; я употребляю все свои силы на то, чтоб отвлекать её обожателей, блестящих адъютантов, бледных москвичей и других, ― и мне почти всегда удаётся."
                                            },
                                            {
                                                "example_id": "cbd716dc-7910-49d5-8238-115db62c2ea1",
                                                "sense_id": "1d85f19f-5269-338c-a1d3-efb3b35454d2",
                                                "text": "Я ― коренной москвич, да и женат уже был к тому времени."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea1569e-6c54-3918-bce9-96e9e8091b0c",
                                        "entry_id": "38f61221-6ef9-39fe-b8b9-a81fa9e64ad6",
                                        "glosses": [
                                            "автомобиль марки «Москвич»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2291f531-5c8f-4133-8a6c-e0a66291646f",
                                                "sense_id": "6ea1569e-6c54-3918-bce9-96e9e8091b0c",
                                                "text": "Ездит россиянин на российских «жигулях»―«москвичах»―«волгах» и радуется."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
