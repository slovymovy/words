                        "glosses": [
                            "Se retirer soi-même de la corne des pieds (en parlant d’un cheval)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bcee588-02a4-4ac3-b3bd-08843c59261d",
                                "sense_id": "b2911848-4392-3d77-ac24-d45d28654083",
                                "text": "Ah, mais le problème Soquette c'est que avec le sol sur lequel il vit (pré tendre), il ne peut pas vraiment efficacement s'autoparer."
                            },
                            {
                                "example_id": "442e0bb7-086f-4f45-93a0-5df8b90bb963",
                                "sense_id": "b2911848-4392-3d77-ac24-d45d28654083",
                                "text": "Parer 3 fois par an n'est pas suffisant pour moi (ou alors, il faut préciser que les chevaux marchent suffisamment sur tout terrain pour s'autoparer)"
                            },
                            {
                                "example_id": "3fa75c28-5332-4730-9b93-7c24ca929bbf",
                                "sense_id": "b2911848-4392-3d77-ac24-d45d28654083",
                                "text": "Parce que Quelly n'arrive pas à s'autoparer, sa corne continue à bien pousser."
                            }
                        ]
                    }
