                "translations": [
                    {
                        "translation_id": "b1950d9d-432d-4657-899c-febe94550d65",
                        "source_entry_id": "d29e9f8a-d9f3-3ee3-a352-934d3c71dc6d",
                        "source_sense_id": "c237371e-038d-33d6-b915-26185a99836e",
                        "target_lang_word": "staff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "256227ea-6c13-3750-82be-fc3ed35d3d84",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "A long, straight, thick wooden rod or stick, especially one used to assist in walking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2de66f1-5766-4afa-abe5-6bc79065bc13",
                                                "sense_id": "256227ea-6c13-3750-82be-fc3ed35d3d84",
                                                "text": "And thus ſhall ye eate it [the lamb]: with your loines girded, your ſhooes on your feet, and your ſtaffe in your hand: and ye ſhall eate it in haſte: it is the Lords Paſſeouer."
                                            },
                                            {
                                                "example_id": "db63ae72-e90c-46aa-a381-1844756553b4",
                                                "sense_id": "256227ea-6c13-3750-82be-fc3ed35d3d84",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e9730f-8fc8-3b0a-8c1a-8bc6ae862095",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "A series of horizontal lines on which musical notes are written; a stave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c45099fe-a141-34b9-a7a7-aa1c2b2af197",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "The employees of a business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a62c42d-5d17-444c-bac0-5a8a7ddf5b00",
                                                "sense_id": "c45099fe-a141-34b9-a7a7-aa1c2b2af197",
                                                "text": "The company employed 10 new members of staff this month."
                                            },
                                            {
                                                "example_id": "75045453-909f-4e9d-9b73-16d0431ecb53",
                                                "sense_id": "c45099fe-a141-34b9-a7a7-aa1c2b2af197",
                                                "text": "The company has taken on 1600 more highly-paid staff."
                                            },
                                            {
                                                "example_id": "471b73ad-b4e5-45d0-bffd-bec675db34ae",
                                                "sense_id": "c45099fe-a141-34b9-a7a7-aa1c2b2af197",
                                                "text": "No department of the Southern Railway escaped some share of the work involved, and the outdoor traffic and locomotive staffs in particular were engaged literally night and day, snatching a few hours' sleep as opportunity offered, until the task was completed."
                                            },
                                            {
                                                "example_id": "6ab2db9b-0784-4f49-8840-e001c1435f66",
                                                "sense_id": "c45099fe-a141-34b9-a7a7-aa1c2b2af197",
                                                "text": "Most staff do not have the skills to cope with such challenging patients, who too often receive \"impersonal\" care and suffer from boredom, the first National Audit of Dementia found. It says hospitals should introduce \"dementia champions\"."
                                            },
                                            {
                                                "example_id": "edd603b2-4945-4ccb-880c-387956a9a853",
                                                "sense_id": "c45099fe-a141-34b9-a7a7-aa1c2b2af197",
                                                "text": "It turns out that, in journalistic terms, and especially at the FT, where many staff see out their entire careers, seven years is nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "106f4ab3-2200-3477-a1f1-d28fd14b9abe",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "A mixture of plaster and fibre used as a temporary exterior wall covering.ᵂ"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a1f06f0-5f76-3c4c-b93e-3b45a79d7824",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "A pole, stick, or wand borne as an ensign of authority; a badge of office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1bde178-310e-45e0-aa11-779263431ac6",
                                                "sense_id": "2a1f06f0-5f76-3c4c-b93e-3b45a79d7824",
                                                "text": "a constable's staff"
                                            },
                                            {
                                                "example_id": "7643a143-4e96-43ba-a52c-0f19e618b9b0",
                                                "sense_id": "2a1f06f0-5f76-3c4c-b93e-3b45a79d7824",
                                                "text": "Me thought this ſtaffe mine Office-badge in Court / Was broke in twaine:"
                                            },
                                            {
                                                "example_id": "64a5e4f4-6fa8-414f-b8d4-9d8a9803348b",
                                                "sense_id": "2a1f06f0-5f76-3c4c-b93e-3b45a79d7824",
                                                "text": "All his officers brake their staves; but at their return new staves were delivered unto them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c180ab-272f-331b-921e-97a66c4e0514",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "A pole upon which a flag is supported and displayed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a588fd26-b807-3057-be26-e5ba8d84dd3b",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "The rung of a ladder."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9524fe2-9105-4c7c-a899-704fc72e24f8",
                                                "sense_id": "a588fd26-b807-3057-be26-e5ba8d84dd3b",
                                                "text": "I ascend at one [ladder] of six hundred and thirty-nine staves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e4ce7da-555f-3b2c-9335-003ecf0fc60f",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "A series of verses so disposed that, when it is concluded, the same order begins again; a stanza; a stave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e9ac26-8e39-40bf-811d-8ce7acb30704",
                                                "sense_id": "0e4ce7da-555f-3b2c-9335-003ecf0fc60f",
                                                "text": "Mr. Cowley had found out, that no kind of Staff is proper for an Heroick Poem; as being all too lirical:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe82ca34-1606-3a28-8461-e1808ea8d5fb",
                                        "entry_id": "81c4e020-5535-3f8f-9cfa-25274cd59165",
                                        "glosses": [
                                            "An arbor, as of a wheel or a pinion of a watch."
                                        ],
