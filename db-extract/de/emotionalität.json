                "senses": [
                    {
                        "sense_id": "dd6f2c7f-9a13-3a77-a9db-2dd36b0423a4",
                        "entry_id": "86e684d3-faf0-3187-893f-4f927af1f86f",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße gefühlsbetontes (emotionales) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15934e7-cc28-41c2-8986-ac626a9d36df",
                                "sense_id": "dd6f2c7f-9a13-3a77-a9db-2dd36b0423a4",
                                "text": "„Rückblickend muss man hier kritisch anmerken, dass im ersten Fall der Prozess der Ausgründung zwar in der Vorbereitung sorgfältig und gut gewesen ist, die Umsetzung in der Organisation jedoch von sehr viel Hektik und auch Emotionalität getragen wurde.“"
                            },
                            {
                                "example_id": "85e0e8a9-b5d6-4745-aa69-163f2f694a04",
                                "sense_id": "dd6f2c7f-9a13-3a77-a9db-2dd36b0423a4",
                                "text": "„Um die beschriebene Dystopie zu verhindern, müssen menschliche Individuen als wertvolle Ressource im Arbeitsprozess anerkannt werden und ihre Emotionalität und ihr kreatives Potential mehr Wertschätzung erfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
