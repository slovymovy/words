                    {
                        "sense_id": "c78a4669-b1aa-365b-ae3a-eb160ec9770d",
                        "entry_id": "2a737247-f90c-36b2-95bd-3f01f78354f1",
                        "glosses": [
                            "die Wissenschaft von den Pflanzenkrankheiten und deren Behandlung beziehungsweise Verhütung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24dbe2d-d17a-4303-bb01-50dee90847a4",
                                "sense_id": "c78a4669-b1aa-365b-ae3a-eb160ec9770d",
                                "text": "„Der Begriff ‚Phytomedizin‘ wird erkenntnistheoretisch als Einheit von Phytopathologie und Pflanzenschutz bzw. der diese konstituierenden Teildisziplinen gedacht.“"
                            },
                            {
                                "example_id": "3c00fdea-c60b-42b2-8cf1-3c5e8397a1c3",
                                "sense_id": "c78a4669-b1aa-365b-ae3a-eb160ec9770d",
                                "text": "„Die Agrarwissenschaftlerin leitet an der Hochschule in Geisenheim das Institut für Phytomedizin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
