{
    "word_family": [
        "kim"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f9862dc-5047-32ea-802f-0de7eb30ff6d",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>kim</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verre <w>kimmen</w> kleurden langzaam oranje bij zonsopgang.",
                            "target_lang_translations": {
                                "en": "The distant <w>horizons</w> slowly turned orange at sunrise."
                            }
                        },
                        {
                            "text": "Vanaf de toren kon hij de uitgestrekte <w>kimmen</w> overzien.",
                            "target_lang_translations": {
                                "en": "From the tower, he could look out over the vast <w>horizons</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of horizon or skyline; the lines where earth and sky appear to meet"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "horizons",
                                "target_lang_sense_clarification": "plural of horizon"
                            },
                            {
                                "target_lang_word": "skylines",
                                "target_lang_sense_clarification": "plural of skyline"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9d7336f-a371-3cc6-99f8-4c588c60239b",
                    "sense_definition": "een schip voorttrekken vanaf de wal met behulp van een paard",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger zag men langs het kanaal vaak paarden die een zware boot moesten <w>kimmen</w>.",
                            "target_lang_translations": {
                                "en": "In the past, one often saw horses along the canal that had to <w>tow</w> a heavy boat."
                            }
                        },
                        {
                            "text": "De schipper liet zijn boot rustig door het water <w>kimmen</w>.",
                            "target_lang_translations": {
                                "en": "The skipper had his boat quietly <w>towed</w> through the water."
                            }
                        }
                    ],
                    "synonyms": [
                        "jagen",
                        "scheepsjagen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historische scheepvaartterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to tow or track a boat from the shore using a horse"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tow",
                                "target_lang_sense_clarification": "a boat from the towpath"
                            },
                            {
                                "target_lang_word": "track",
                                "target_lang_sense_clarification": "haul a vessel from the bank"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77b2786b-b50f-31ed-b17a-1c672f77efdd",
                    "sense_definition": "op één kant hellen of liggen van een schip in het water",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de sterke zijwind begon het kleine vaartuig gevaarlijk te <w>kimmen</w>.",
                            "target_lang_translations": {
                                "en": "Because of the strong crosswind, the small craft began to <w>heel</w> dangerously."
                            }
                        },
                        {
                            "text": "De bemanning merkte direct dat de boot slagzij maakte en begon te <w>kimmen</w>.",
                            "target_lang_translations": {
                                "en": "The crew noticed immediately that the boat was taking on a list and began to <w>heel over</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "oude scheepvaartterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to heel, list, or lean to one side (of a ship in the water)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heel",
                                "target_lang_sense_clarification": "lean to one side"
                            },
                            {
                                "target_lang_word": "list",
                                "target_lang_sense_clarification": "tilt sideways"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e134479e-a3a7-32fc-b6bc-643aad715e67",
                    "sense_definition": "een schip op het droge op één zij trekken om reparaties aan de romp uit te voeren",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De scheepstimmerman besloot het houten vaartuig op het strand te <w>kimmen</w>.",
                            "target_lang_translations": {
                                "en": "The shipwright decided to <w>careen</w> the wooden vessel on the beach."
                            }
                        },
                        {
                            "text": "Ze moesten de boot voorzichtig <w>kimmen</w> om het lek aan de onderzijde te dichten.",
                            "target_lang_translations": {
                                "en": "They had to carefully <w>heave down</w> the boat to seal the leak on the bottom."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "oude scheepvaartterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to careen or turn a vessel onto its side on dry land or a beach for repairs"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "careen",
                                "target_lang_sense_clarification": "turn a ship on its side for repair"
                            },
                            {
                                "target_lang_word": "heave down",
                                "target_lang_sense_clarification": "haul over on one side"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd08c8f1-d3f9-3811-8587-f893740302da",
                    "sense_definition": "de naar binnen gerichte, schuine rand aan de boven- of onderkant van een houten vat maken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kuiperij",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kuiper leerde zijn leerling hoe hij de duigen van het vat moest <w>kimmen</w>.",
                            "target_lang_translations": {
                                "en": "The cooper taught his apprentice how to <w>chime</w> the staves of the barrel."
                            }
                        },
                        {
                            "text": "Het vereist veel precisie om een houten ton op de juiste wijze te <w>kimmen</w>.",
                            "target_lang_translations": {
                                "en": "It requires great precision to properly <w>chime</w> a wooden barrel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vaktaal uit de kuiperij"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to chime or groove the end of barrel staves (cooperage)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chime",
                                "target_lang_sense_clarification": "bevel or notch the ends of barrel staves"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}