                                                "sense_id": "75bfd403-9e4f-3a28-8eed-8944b151ce66",
                                                "text": "Glas zeigt eine hohe Beständigkeit gegen sehr viele Säuren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a93487fd-7f10-350f-af6f-4d9272c348a3",
                                        "entry_id": "1ad1eca4-6b69-3483-a74a-cb82d43b9369",
                                        "glosses": [
                                            "konstante Regelmäßigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "395f2563-9772-4e0e-a3ce-c7539fa08837",
                                                "sense_id": "a93487fd-7f10-350f-af6f-4d9272c348a3",
                                                "text": "„Vielleicht ist der Wunsch nach Beständigkeit so groß, dass Menschen froh sind, wenn Namen, an die sie sich gewöhnt haben, weiter in der Zeitung stehen.“"
                                            },
                                            {
                                                "example_id": "cb39d766-7270-4e5a-86b9-3e0d404dec65",
                                                "sense_id": "a93487fd-7f10-350f-af6f-4d9272c348a3",
                                                "text": "„Am Samstagabend verließ mich seine Tochter mit einer traurigeren Miene als sonst und wandte das Gesicht ab, als ich ihr einen Kuß geben wollte, mit dem ich sie doch nur meiner Beständigkeit zu versichern suchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
