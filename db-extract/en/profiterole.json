                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "858555ab-bf40-45fc-b254-4c910a2b00d6",
                        "entry_id": "b45afeab-60a7-3a15-8c53-382572560e41",
                        "tags": [
                            "plural"
