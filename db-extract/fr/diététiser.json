                "senses": [
                    {
                        "sense_id": "24f3a0e9-6446-33da-9f07-87e0d47f5c0e",
                        "entry_id": "7c242ecf-fbe9-3e8b-bad1-aa4083b6a0c8",
                        "glosses": [
                            "Donner un caractère diététique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "057fadca-1bc5-4283-985d-6304d1344fb1",
                                "sense_id": "24f3a0e9-6446-33da-9f07-87e0d47f5c0e",
                                "text": "Je voudrais vraiment lui faire plaisir et aussi je voudrais prouver que l'on peut diététiser une recette à fond sans la massacrer."
                            },
                            {
                                "example_id": "c08e0f4f-e48d-4505-ba0a-143cfce81570",
                                "sense_id": "24f3a0e9-6446-33da-9f07-87e0d47f5c0e",
                                "text": "Attention à ne pas \"diététiser\" à outrance son alimentation : PARFOIS, CE QUI EST BON POUR LA TÊTE L'EST POUR LE CORPS…"
                            },
                            {
                                "example_id": "e7f6b01e-3d77-435c-950a-6f5e399bc2ab",
                                "sense_id": "24f3a0e9-6446-33da-9f07-87e0d47f5c0e",
                                "text": "On est en train de les \"diététiser\", les embrigader dans une morale alimentaire."
                            }
                        ]
                    }
