    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "daf85d0c-ace8-38b4-8f57-c9c56938aa6b",
                    "sense_definition": "Rendre sale ou couvrir de taches et d'impuretés.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rendre_sale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais bien attention à ne pas <w>salir</w> ta chemise blanche pendant le repas."
                        },
                        {
                            "text": "Les enfants ont joué dans la boue et ils ont <w>sali</w> toutes leurs chaussures."
                        }
                    ],
                    "synonyms": [
                        "encrasser",
                        "souiller",
                        "tacher"
                    ],
                    "antonyms": [
                        "laver",
                        "nettoyer"
                    ],
                    "common_phrases": [
                        "se salir les mains",
                        "salir ses vêtements"
                    ]
                },
                {
                    "sense_id": "4da162f6-498e-3a35-97c0-8e1bd7774621",
                    "sense_definition": "Déshonorer ou porter atteinte à la considération et à l'honneur de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "atteinte_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces fausses accusations visent uniquement à <w>salir</w> la réputation de notre collègue."
                        },
                        {
                            "text": "Il refuse de parler aux journalistes pour ne pas <w>salir</w> la mémoire de sa famille."
                        }
                    ],
                    "synonyms": [
                        "entacher",
                        "souiller",
                        "ternir"
                    ],
                    "antonyms": [
                        "honorer"
                    ],
                    "common_phrases": [
                        "salir la réputation",
                        "salir la mémoire",
                        "salir son honneur"
                    ]
                },
                {
                    "sense_id": "d3f16f6d-cc22-3402-a9a3-2f4911a47a8b",
                    "sense_definition": "Corrompre moralement en suggérant des idées contraires à la décence ou à la pureté.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "atteinte_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce genre de spectacle vulgaire ne fait que <w>salir</w> l'esprit du jeune public."
                        },
                        {
                            "text": "Certains critiques affirment que ce roman médiocre <w>salit</w> l'imagination des lecteurs."
                        }
                    ],
                    "synonyms": [
                        "corrompre",
                        "dévoyer"
                    ],
                    "antonyms": [
                        "élever",
                        "purifier"
                    ],
                    "common_phrases": [
                        "salir l'esprit",
                        "salir l'imagination"
                    ]
                },
                {
                    "sense_id": "02cfdff6-e615-3b9b-b535-7b394763798f",
                    "sense_definition": "Se couvrir d'adventices ou d'herbes indésirables, en parlant d'une terre cultivée ou d'une coupe de bois.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans un désherbage régulier, cette parcelle agricole va rapidement se <w>salir</w>."
                        },
                        {
                            "text": "Le parterre forestier se <w>salit</w> sous l'invasion progressive des graminées sauvages."
                        }
                    ],
                    "synonyms": [
                        "s'enherber"
                    ],
                    "common_phrases": [
                        "se salir rapidement"
                    ]
                }
            ]
        }
    ]
}