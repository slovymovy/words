                "senses": [
                    {
                        "sense_id": "4672562e-2c04-3f6e-b175-22c3de685c2c",
                        "entry_id": "6d7067e8-aee5-3ec5-a6d3-aa87627ab7ea",
                        "glosses": [
                            "Menge der Schriftzeichen einer bestimmten Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75fb42d4-97c0-4efc-8012-f55466335d27",
                                "sense_id": "4672562e-2c04-3f6e-b175-22c3de685c2c",
                                "text": "„Denn aus ihrer Geschichte läßt sich eine Gesetzmäßigkeit klar ablesen: je abstrakter die Elemente eines Schriftsystems sind, desto geringer ist ihre Anzahl.“"
                            },
                            {
                                "example_id": "0c334090-5734-43bb-a896-d7284d839676",
                                "sense_id": "4672562e-2c04-3f6e-b175-22c3de685c2c",
                                "text": "„Das chinesische Schriftsystem gehört zum logographischen Schrifttyp.“"
                            },
                            {
                                "example_id": "b3a5ed24-1ad3-41d4-8694-addc16f6a0f8",
                                "sense_id": "4672562e-2c04-3f6e-b175-22c3de685c2c",
                                "text": "„Alle mehr oder weniger direkt von der phönizischen Schrift abgeleiteten Schriftsysteme enthalten nur Konsonanten.“"
                            },
                            {
                                "example_id": "932c66dd-483d-4aba-a995-98e140e994d7",
                                "sense_id": "4672562e-2c04-3f6e-b175-22c3de685c2c",
                                "text": "„Laotisch, die heutige alleinige Amtssprache, verwendet ein vom altindischen Brahmi abstammendes Schriftsystem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
