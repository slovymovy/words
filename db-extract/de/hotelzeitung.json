                        "glosses": [
                            "Zeitung, die ein Hotel herausgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "200eb25b-0f14-4e35-b7c9-094671486b4b",
                                "sense_id": "eb8f6881-2f0b-3c69-9eb8-52a75b98b62b",
                                "text": "„Er setzte sich auf die Bank, auf der Almuth scheinbar oft saß, zündete eine Zigarette an, blätterte in der Hotelzeitung und betrachtete danach die Parklandschaft: Der Terrassengarten, elegant in den Hang gebaut, leicht zum Meer hin gesenkt, war ziemlich im Verfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a575bedf-1fea-3838-b562-288f5f8abf6f",
                        "entry_id": "89a18d3c-ee41-36e6-bf2f-ad400683f9e2",
                        "glosses": [
                            "Zeitung für das Hotelgewerbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851c34d2-4a17-43b8-b257-60570b658dbc",
                                "sense_id": "a575bedf-1fea-3838-b562-288f5f8abf6f",
                                "text": "„Die Ergebnisse dieser Forschung einer breiten (Fach-)Öffentlichkeit zugänglich zu machen, darin sehe ich auch einer meiner Aufgaben als Chefredakteur der Österreichischen Gastronomie- und Hotelzeitung ÖGZ.“"
                            }
                        ],
