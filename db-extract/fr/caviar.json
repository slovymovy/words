        "fr-extract.jsonl": [
            {
                "entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                "word": "caviar",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "46921024-df62-4f05-a427-99808809074d",
                        "entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                        "tags": [
                            "plural"
                        ],
                        "form": "caviars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c9ab7a5-ac6f-3a32-b622-c0ce05984147",
                        "entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                        "glosses": [
                            "Mets fait avec des œufs d’esturgeon, en particulier en Russie."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c7c9cf5-0afb-4fbd-b97b-ca265a8ec355",
                                "sense_id": "4c9ab7a5-ac6f-3a32-b622-c0ce05984147",
                                "text": "Pendant de longues années, ce Russe envoya à mon père et au professeur Charcot, aux environs de la Noël, un pain de caviar exquis, non pas fluent, mais compact, analogue à la savoureuse poutargue des Martigues."
                            },
                            {
                                "example_id": "c8a40998-3397-45e1-9a07-ec5b23ecb880",
                                "sense_id": "4c9ab7a5-ac6f-3a32-b622-c0ce05984147",
                                "text": "Ce patrimoine c’est aussi le caviar de Chenac-Saint-Seurin-d’Uzet, l’architecture royannaise, évidemment."
                            },
                            {
                                "example_id": "171355ab-1c79-4b86-ac35-a2c706213751",
                                "sense_id": "4c9ab7a5-ac6f-3a32-b622-c0ce05984147",
                                "text": "Au carrefour des années 1900, l’estuaire de la Gironde faisait partie des rares endroits où on pouvait trouver les esturgeons, localement appelés créac, en grande quantité. C’est spécifiquement au Saint-Seurin-d’Uzet (17), appelé capitale du caviar, que l’activité était la plus fructueuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "300ac5e3-e3e4-390e-a5a5-2ff1b598d1b4",
                        "entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                        "glosses": [
                            "Mets fait avec des œufs autres que les œufs d’esturgeons."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "71cfb8af-c2ba-4786-9c20-0e75e34d8f30",
                                "sense_id": "300ac5e3-e3e4-390e-a5a5-2ff1b598d1b4",
                                "text": "Du caviar d’escargot, de brochet…"
                            }
                        ]
                    },
                    {
                        "sense_id": "08cfbc74-bed1-395b-a961-ef27504de3fb",
                        "entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                        "glosses": [
                            "Mets délicat qui rappelle le luxe."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1f0a3b07-e6d1-4700-a324-7c583e71c8e9",
                                "sense_id": "08cfbc74-bed1-395b-a961-ef27504de3fb",
                                "text": "… qu'est-ce que le foin? C'est le caviar du cheval. C'est ce qu'il aime; …"
                            }
                        ]
                    },
                    {
                        "sense_id": "a7ad0387-fa37-3d9b-84e0-b76778822354",
                        "entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                        "glosses": [
                            "Mets dont la consistance rappelle les œufs d’esturgeon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c6bafe-2ec6-4128-b275-fcea14a244a5",
                                "sense_id": "a7ad0387-fa37-3d9b-84e0-b76778822354",
                                "text": "Du caviar d’aubergine."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd6bfe8b-ad0a-3c18-a0c3-60e16a79b8ef",
                        "entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                        "glosses": [
                            "Passe faite à un joueur lui donnant une occasion de but presque immanquable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10e24e1-43d6-41b7-9aea-22eff058ced1",
                                "sense_id": "dd6bfe8b-ad0a-3c18-a0c3-60e16a79b8ef",
                                "text": "Ben reçoit un caviar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97949e38-ea83-41f0-a152-44750f02d65d",
                        "source_entry_id": "647adcf5-e2b7-3125-80e8-9962f96db449",
                        "source_sense_description": "Mets fait avec des œufs d’esturgeon.",
                        "target_lang_word": "Kaviar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaviar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9c04189-35ee-3021-861d-3d1607291f3d",
                                        "entry_id": "6f992eb3-3bbd-3720-8ec1-c1869339a374",
                                        "glosses": [
                                            "gereinigter und gesalzener Rogen (Eier) von verschiedenen Störarten, welche hauptsächlich im Schwarzen Meer, Asowschen Meer, Nordpolarmeer und Kaspischen Meer gefangen werden, zum Beispiel Beluga, Osietra, Sevruga"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0028493d-9ef7-4765-b717-743cd20029e0",
                                                "sense_id": "c9c04189-35ee-3021-861d-3d1607291f3d",
                                                "text": "Heute Morgen aßen wir Kaviar."
                                            },
                                            {
                                                "example_id": "3aa8db42-d720-446d-9f08-4cebd80b4d1f",
                                                "sense_id": "c9c04189-35ee-3021-861d-3d1607291f3d",
                                                "text": "„Möchtest du mal von dem Kaviar probieren?“"
                                            },
                                            {
                                                "example_id": "a50a50c7-43bf-4895-a778-af0c8b993983",
                                                "sense_id": "c9c04189-35ee-3021-861d-3d1607291f3d",
                                                "text": "„Popper war ein Lebemann mit hohem Verbrauch an Champagner und Kaviar.“"
                                            },
                                            {
                                                "example_id": "6b9e7fd8-b775-483b-baeb-41bc28afc086",
                                                "sense_id": "c9c04189-35ee-3021-861d-3d1607291f3d",
                                                "text": "„Die Perser wollen jetzt mit borsäurefreier Ware einspringen, und für Kaviar ist wieder grünes Licht in der bundesdeutschen Speiseröhre.“"
                                            },
                                            {
                                                "example_id": "8fa59870-fa2d-41f7-a610-af2aebda4654",
                                                "sense_id": "c9c04189-35ee-3021-861d-3d1607291f3d",
                                                "text": "„Als Vorspeise gab es gekochten Steinbutt, umlegt mit gebackenen Austern und übergossen mit einer feinen Holländischen Sauce, in welche Kaviar gerührt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
