                "senses": [
                    {
                        "sense_id": "0df2b5c1-ed8f-3b19-8184-c96f8ca2d099",
                        "entry_id": "92d745a9-3dd9-30bd-af28-d6d18d3e2008",
                        "glosses": [
                            "falsche, verdrehte Darstellung, Auslegung von Tatsachen (übertrieben positiv oder auch verharmlosend), um jemanden zu täuschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389683d1-1514-42ed-97ec-f1d5c67df532",
                                "sense_id": "0df2b5c1-ed8f-3b19-8184-c96f8ca2d099",
                                "text": "„Eine neue Bankenwelt ist vom G-20-Gipfel nicht zu erwarten – zu egoistisch sind die Interessen. Was nach Einigkeit aussieht, ist vor allem Augenwischerei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d81f73b2-4d2e-4eb4-bb77-2ba0647151be",
                        "source_entry_id": "92d745a9-3dd9-30bd-af28-d6d18d3e2008",
                        "source_sense_id": "0df2b5c1-ed8f-3b19-8184-c96f8ca2d099",
                        "source_sense_description": "falsche, verdrehte Darstellung, Auslegung von Tatsachen, um jemanden zu täuschen",
                        "target_lang_word": "eyewash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eyewash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75607de5-98a7-3285-a574-d3668d4e0e0d",
                                        "entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                                        "glosses": [
                                            "The washing out of the eyes with copious solution (usually water alone) to quickly remove an irritant, as for example in laboratories and industrial plants; the washing solution itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd56a898-2483-4ae9-abce-d5e5af203555",
                                                "sense_id": "75607de5-98a7-3285-a574-d3668d4e0e0d",
                                                "text": "an eyewash station on every floor of the building"
                                            },
                                            {
                                                "example_id": "4d6c2064-b32e-4d57-85a2-6c3e82f4e286",
                                                "sense_id": "75607de5-98a7-3285-a574-d3668d4e0e0d",
                                                "text": "a bottle of eyewash"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d67b81-c934-328f-a803-0b5352724e7f",
                                        "entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                                        "glosses": [
                                            "A soothing medicated lotion for the eyes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a10b4a28-7568-3ad6-8be2-3702693dbe32",
                                        "entry_id": "f9dd371d-9129-33c5-ad5c-db2e390beb39",
                                        "glosses": [
                                            "Camouflage; disguise; false front; pretense; nonsense."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ec5f6b-ff88-46dd-bad8-9b541369248c",
                                                "sense_id": "a10b4a28-7568-3ad6-8be2-3702693dbe32",
                                                "text": "Near-synonyms: whitewash, window dressing"
                                            },
                                            {
                                                "example_id": "3f707ee2-5b43-4834-a36a-05c23fe2df26",
                                                "sense_id": "a10b4a28-7568-3ad6-8be2-3702693dbe32",
                                                "text": "Talking of being eaten by dogs, there's a dachshund at Brinkley who when you first meet him will give you the impression that he plans to convert you into a light snack between his regular meals. Pay no attention. It's all eyewash. […] He wouldn't hurt a fly, but he has to put up a front because his name's Poppet. One can readily appreciate that when a dog hears himself addressed day in and day out as Poppet, he feels he must throw his weight about. His self-respect demands it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eyewash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e882040-746f-3040-9d79-7bc16f1ee5dd",
                                        "entry_id": "ef7874d0-9723-3328-8922-bae98bebcd4f",
                                        "glosses": [
                                            "To fool with nonsense or flattery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d71be99-fc78-32cd-851e-3676cb51b5c1",
                                        "entry_id": "ef7874d0-9723-3328-8922-bae98bebcd4f",
                                        "glosses": [
                                            "To keep information secret by sending false information to many people in one's own organization, and correct information to a select few."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98db7a30-396f-4f05-a330-d9bf40129c74",
                                                "sense_id": "7d71be99-fc78-32cd-851e-3676cb51b5c1",
                                                "text": "But others said that eyewashing was a standard security practice that had been in existence for decades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4596c784-2d6e-4961-a267-f99f10313e71",
                        "source_entry_id": "92d745a9-3dd9-30bd-af28-d6d18d3e2008",
                        "source_sense_id": "0df2b5c1-ed8f-3b19-8184-c96f8ca2d099",
                        "source_sense_description": "falsche, verdrehte Darstellung, Auslegung von Tatsachen, um jemanden zu täuschen",
                        "target_lang_word": "window dressing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "window dressing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2287ec2a-2ded-3f92-a7a2-3491ffe62cd1",
                                        "entry_id": "0786d4a1-36f3-377d-ba80-6dcb287ed11c",
                                        "glosses": [
                                            "The decorative display of retail merchandise in store windows; the goods and trimmings used in such a display."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "073e4eaa-8773-4ec7-b3ed-6791795e9d2f",
                                                "sense_id": "2287ec2a-2ded-3f92-a7a2-3491ffe62cd1",
                                                "text": "The linen-draper at the corner under the town clock was divided between keeping an eye on his apprentices to see that they did not spar with yard sticks, and mentally criticising the ludicrous and meretricious window-dressing of his next-door neighbour."
                                            },
                                            {
                                                "example_id": "50307090-8534-4611-bae6-4b25a35ce211",
                                                "sense_id": "2287ec2a-2ded-3f92-a7a2-3491ffe62cd1",
                                                "text": "[…] a shop where a shingle could be had for two shillings in the same building as a coffin-maker’s who worked in oak, elm or lead: no window-dressing but one child’s coffin dusty with disuse and the list of hairdressing prices."
                                            },
                                            {
                                                "example_id": "d0a2a3a8-6a3a-42d1-914a-54cef17e6975",
                                                "sense_id": "2287ec2a-2ded-3f92-a7a2-3491ffe62cd1",
                                                "text": "On Sundays when the Red Light District is closed until 6 P.M., many Dutch families use the window dressings as the textbook for their children’s sex education."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3a4b32e-012f-3a64-914c-3423978b768c",
                                        "entry_id": "0786d4a1-36f3-377d-ba80-6dcb287ed11c",
                                        "glosses": [
                                            "The process, skill or task of creating such a display."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d051f27f-9760-447d-805c-fa1ee1d71cac",
                                                "sense_id": "d3a4b32e-012f-3a64-914c-3423978b768c",
                                                "text": "Such days as there was no window-dressing there was a mighty carrying and lifting of blocks and bales of goods into piles and stacks."
                                            },
                                            {
                                                "example_id": "6c7aa5d0-3df2-41ee-9e76-cc5587545c5e",
                                                "sense_id": "d3a4b32e-012f-3a64-914c-3423978b768c",
                                                "text": "Down in the village Ras Beebe began his twice-a-year window dressing, removing the caps, candy, sweaters, oil heaters, patent medicines and mittens to substitute bathing suits, candy, straw hats, toy shovels, patent medicines and caps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b21841-1b49-3513-a535-0c5a8da12c64",
                                        "entry_id": "0786d4a1-36f3-377d-ba80-6dcb287ed11c",
                                        "glosses": [
                                            "A means of creating a deceptively favourable impression of something or someone; something for appearance only."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2cd8a2-d158-4465-a86a-97c735201c2d",
                                                "sense_id": "97b21841-1b49-3513-a535-0c5a8da12c64",
                                                "text": "These latest modifications are mere window dressing; the same problems remain."
                                            },
                                            {
                                                "example_id": "1af0b4b2-868f-492f-9abe-5fe0f86ad119",
                                                "sense_id": "97b21841-1b49-3513-a535-0c5a8da12c64",
                                                "text": "Meanwhile, the left is deliberately running more ethnically diverse candidates in the parliamentary elections next year, claiming Sarkozy's one-time \"rainbow\" cabinet of racially diverse women had turned out to be window dressing."
                                            },
                                            {
                                                "example_id": "08161c76-7741-4d6e-986e-64ca9b121d5d",
                                                "sense_id": "97b21841-1b49-3513-a535-0c5a8da12c64",
                                                "text": "The corruption and conflicts of interests Mr. Mitsotakis pledged to root out not only still exist but also, in many respects, appear to have concentrated and deepened. Far from having been overhauled, the Greek state has received only a cosmetic makeover, a managerial window dressing."
                                            },
                                            {
                                                "example_id": "120f9ec4-f76a-46ca-aa01-b42955cefd9a",
                                                "sense_id": "97b21841-1b49-3513-a535-0c5a8da12c64",
                                                "text": "In all likelihood, the re-tendering promise will be a window dressing exercise to appease a number of Conservative MPs who are at odds with an approach that extends nationalisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48b0aea0-d820-445a-bc15-b05e14f2d3aa",
                        "source_entry_id": "92d745a9-3dd9-30bd-af28-d6d18d3e2008",
                        "source_sense_id": "0df2b5c1-ed8f-3b19-8184-c96f8ca2d099",
                        "source_sense_description": "falsche, verdrehte Darstellung, Auslegung von Tatsachen, um jemanden zu täuschen",
                        "target_lang_word": "poudre aux yeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poudre aux yeux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                        "entry_id": "920a48ac-980c-38a1-9e59-b853b81b4cee",
                                        "glosses": [
                                            "Apparence flatteuse, mais toujours trompeuse, que l’on donne volontairement pour en cacher une autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a20728-73b1-4f00-8ebb-b49a37dc55f2",
                                                "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                                "text": "Nous n’en avons qu’une seule à adopter, mon cher monsieur ; c’est de contre-examiner les témoins, de nous fier à l’éloquence de Snubbin, de jeter de la poudre aux yeux des juges, et de nous en rapporter au jury."
                                            },
                                            {
                                                "example_id": "27808929-5a10-49db-9b53-8a1cf4b75bfb",
                                                "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                                "text": "Mon vieil instinct d’individualiste me tient lieu de morale. Assez de blagues, de conventions, de poudre aux yeux. L’homme se dresse, les poings serrés."
                                            },
                                            {
                                                "example_id": "31b8f0a2-5b13-4991-8ed0-e8f82e2ce358",
                                                "sense_id": "f32fd751-b41d-3b90-a0c5-bdffb17a2c4e",
                                                "text": "C’est de nous dire, dans les mots les plus simples et les plus clairs possible, ce qu’il en est. Sans poudre aux yeux ni bullshit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
