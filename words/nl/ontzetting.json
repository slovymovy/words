    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12ee9f51-3cd3-363b-9478-51ab5a190126",
                    "sense_definition": "een gevoel van grote schrik, verbijstering of verslagenheid door een onverwachte gebeurtenis",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ontzetting</w> stond op zijn gezicht af te lezen toen hij het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "The <w>dismay</w> was written all over his face when he heard the bad news."
                            }
                        },
                        {
                            "text": "Tot grote <w>ontzetting</w> van de buurtbewoners werd het oude park plotseling gesloten.",
                            "target_lang_translations": {
                                "en": "To the great <w>consternation</w> of the local residents, the old park was suddenly closed."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbijstering",
                        "consternatie",
                        "ontsteltenis",
                        "schrik"
                    ],
                    "antonyms": [
                        "kalmte",
                        "gelatenheid"
                    ],
                    "common_phrases": [
                        "tot grote ontzetting",
                        "met ontzetting vernemen"
                    ],
                    "target_lang_definitions": {
                        "en": "a feeling of great shock, bewilderment, or dismay caused by an unexpected event"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismay",
                                "target_lang_sense_clarification": "a feeling of shock and distress"
                            },
                            {
                                "target_lang_word": "consternation",
                                "target_lang_sense_clarification": "feelings of anxiety or dismay, typically at something unexpected"
                            },
                            {
                                "target_lang_word": "horror",
                                "target_lang_sense_clarification": "an intense feeling of fear, shock, or disgust"
                            },
                            {
                                "target_lang_word": "shock",
                                "target_lang_sense_clarification": "a sudden upsetting or surprising event or experience"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e22732b2-1db2-34f2-a1c3-94590616c7e1",
                    "sense_definition": "een gerechtelijke straf waarbij iemand uit een ambt wordt gezet of bepaalde rechten verliest",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter sprak de <w>ontzetting</w> uit het ambt uit na het schandaal rond de politicus.",
                            "target_lang_translations": {
                                "en": "The judge pronounced the <w>removal</w> from office following the scandal surrounding the politician."
                            }
                        },
                        {
                            "text": "Een <w>ontzetting</w> uit de ouderlijke macht is een zeer ingrijpende juridische maatregel.",
                            "target_lang_translations": {
                                "en": "A <w>deprivation</w> of parental authority is a very drastic legal measure."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzetting",
                        "verlies"
                    ],
                    "common_phrases": [
                        "ontzetting uit het ambt",
                        "ontzetting uit de ouderlijke macht"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridisch jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a judicial penalty whereby someone is removed from office or loses certain rights"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "removal",
                                "target_lang_sense_clarification": "the dismissal of someone from a job or office"
                            },
                            {
                                "target_lang_word": "deprivation",
                                "target_lang_sense_clarification": "the legal act of taking away a right or title"
                            },
                            {
                                "target_lang_word": "disqualification",
                                "target_lang_sense_clarification": "the act of stopping someone from being fit for a position or right"
                            },
                            {
                                "target_lang_word": "forfeiture",
