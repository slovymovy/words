                                "sense_id": "04c9a9e9-5de2-3733-81dd-248c830f12a7",
                                "text": "Nous remarquerons ici en passant que l’oseille désagace les dents ;"
                            },
                            {
                                "example_id": "afb4869d-0b35-4787-b34d-b349f46648a3",
                                "sense_id": "04c9a9e9-5de2-3733-81dd-248c830f12a7",
                                "text": "Il souffle très doucement pour se désagacer, mais il ne voudrait pas humilier Rachel."
                            },
                            {
                                "example_id": "3a1c1b6c-62f4-4ca4-be70-cda814737701",
                                "sense_id": "04c9a9e9-5de2-3733-81dd-248c830f12a7",
                                "text": "Pour te désagacer, sache que la Sylphide et Bouilhet ne s’écrivent plus."
                            }
                        ]
