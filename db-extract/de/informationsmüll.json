                    {
                        "sense_id": "e22fe1a7-b63e-3f39-be9a-fb64de59cd3f",
                        "entry_id": "43f2e620-7006-3c22-b038-9b238a4b530a",
                        "glosses": [
                            "Ansammlung von Informationen, die keinen Mehrwert bietet und ein Ballast ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85ba687-0d70-4c09-9b98-b7826ff33776",
                                "sense_id": "e22fe1a7-b63e-3f39-be9a-fb64de59cd3f",
                                "text": "Beitragende hinterlassen weltweit in freien Wissensportalen einen großen Haufen von Informationsmüll hinter sich."
                            },
                            {
                                "example_id": "e967439a-8fe9-47d8-94d4-97fd78827f2c",
                                "sense_id": "e22fe1a7-b63e-3f39-be9a-fb64de59cd3f",
                                "text": "„Da man in dem Meer von Informationsmüll immer wieder auf Perlen stößt, kann man mit dem Sammeln und Kopieren gar nicht mehr aufhören.“"
                            },
                            {
                                "example_id": "60ab7c11-f66c-45e2-b3c2-3a93efc3e145",
                                "sense_id": "e22fe1a7-b63e-3f39-be9a-fb64de59cd3f",
                                "text": "„Das Wichtige ist, man braucht jemanden, der ausreichend klug und mutig ist, Informationsmüll und unverwertbares Wissen auszusondern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
