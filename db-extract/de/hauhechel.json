                                        "sense_id": "1b8310e3-6acc-3407-905e-92adcd2c18b6",
                                        "entry_id": "11b584c8-9de8-3802-aef0-f9827f0ce6ed",
                                        "glosses": [
                                            "Any of various species of small shrubs making up the genus Ononis, especially common restharrow (Ononis repens), which has pink flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430f5073-462f-4d3e-80dc-a9fc9eb5adc4",
                                                "sense_id": "1b8310e3-6acc-3407-905e-92adcd2c18b6",
                                                "text": "Common Restharrow rises up with diverse rough, woody twigs, half a yard or a yard high, set at the joints without order [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a37e4ef-4f3c-42a4-b7bd-cab10240cdec",
                        "source_entry_id": "d60c5611-eaa3-3987-8381-b972d372f771",
                        "source_sense_id": "b33975b8-de1b-3f04-b05d-244b73ab857a",
                        "source_sense_description": "Botanik: Vertreter der Pflanzengattung Ononis aus der Familie der Hülsenfrüchtler",
                        "target_lang_word": "bugrane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bugrane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60615826-b663-3676-ada5-5f22427f23ec",
                                        "entry_id": "966d4a47-92da-31e8-9633-d37cf8c92d60",
                                        "glosses": [
                                            "Légumineuse (fabacée) du genre Ononis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed265bb-be9a-4bb1-8727-00cff77bca40",
                                                "sense_id": "60615826-b663-3676-ada5-5f22427f23ec",
                                                "text": "L’ononis jaune, aussi appelé bugrane puante…"
                                            },
                                            {
                                                "example_id": "ada8045b-b63c-4766-b389-f464741ce59e",
                                                "sense_id": "60615826-b663-3676-ada5-5f22427f23ec",
                                                "text": "La bugrane élevée produit un bel effet dans les grands parterres, par ses larges touffes et ses longs épis."
                                            },
                                            {
                                                "example_id": "083bab16-ad15-4a1b-b860-031c710684d9",
                                                "sense_id": "60615826-b663-3676-ada5-5f22427f23ec",
                                                "text": "Aux instants d’émotion, je respirais sur elle l’odeur de cette plante… allons, cette papilionacée à fleurs roses… qui sent la blonde en moiteur… La bugrane, merci."
                                            },
                                            {
                                                "example_id": "7d3f780f-345a-4360-aaf9-ad6ae9f9c4a0",
                                                "sense_id": "60615826-b663-3676-ada5-5f22427f23ec",
                                                "text": "Le papillon de nuit (hétérocère) suivant se nourrit de bugranes :\nnoctuelle de la cardère, Heliothis viriplaca (Noctuidae)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
