                "senses": [
                    {
                        "sense_id": "d8902b54-b507-3a54-8e98-a23868a7717c",
                        "entry_id": "7f9a8b5b-eac8-32b1-bf5f-5b5be54caddf",
                        "glosses": [
                            "die Verkürzung der gemessenen Wellenlänge elektromagnetischer Wellen gegenüber der ursprünglich emittierten Strahlung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "891d1178-c9ac-4470-8635-0402fbf86444",
                                "sense_id": "d8902b54-b507-3a54-8e98-a23868a7717c",
                                "text": "„Bei Spiralgalaxien, die wir von der Seite sehen, lässt sich mit Hilfe des Dopplereffekts messen, wie schnell die Scheibe rotiert: Eine Hälfte der Scheibe kommt auf uns zu und zeigt eine Blauverschiebung, und die andere Hälfte zeigt eine Rotverschiebung.“"
                            },
                            {
                                "example_id": "29daa74e-6d4c-47a9-a08d-b0c85068756e",
                                "sense_id": "d8902b54-b507-3a54-8e98-a23868a7717c",
                                "text": "„Die Andromedagalaxie ist eine der wenigen Galaxien im Universum, deren Spektrum eine Blauverschiebung aufweist: Die Andromedagalaxie und das Milchstraßensystem bewegen sich mit einer Geschwindigkeit von 120 km/s aufeinander zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
