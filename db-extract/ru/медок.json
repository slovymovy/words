                    {
                        "translation_id": "556d4126-5256-410d-b325-3da8f5f358c8",
                        "source_entry_id": "1411e66e-2640-3e1b-b6a7-3dc932d66f60",
                        "source_sense_id": "a3a52185-c9cc-3193-9132-ae846600f557",
                        "target_lang_word": "Médoc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Médoc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "255329d7-79fb-38ee-8877-31bc4b722ec1",
                                        "entry_id": "6e98ece2-cdc3-3772-b6a3-2bc48dd39025",
                                        "glosses": [
                                            "Péninsule du nord de la Gascogne, en Gironde, limitée par l’océan Atlantique, l’estuaire de la Gironde, la pointe de Grave, la forêt des Landes et les marais de Bruges —aux portes de Bordeaux."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571dccb3-ed26-4f9c-96c8-eab621c3675f",
                                                "sense_id": "255329d7-79fb-38ee-8877-31bc4b722ec1",
                                                "text": "Chacun sait que ce qu’on paye cher dans ces grands crus du Médoc, c’est surtout la réputation."
                                            },
                                            {
                                                "example_id": "e9417e36-6b82-4a77-94e7-d3fe599208fb",
                                                "sense_id": "255329d7-79fb-38ee-8877-31bc4b722ec1",
                                                "text": "Son père, un percepteur du Médoc (je me souvenais de cette histoire), avait abandonné sa femme, joué, dilapidé plusieurs millions, et on l’avait trouvé pendu dans une grange."
                                            },
                                            {
                                                "example_id": "c8f3de6a-4995-43b1-9fe8-bfebb3ab29f2",
                                                "sense_id": "255329d7-79fb-38ee-8877-31bc4b722ec1",
                                                "text": "A la pointe du Médoc, sur sa façade sur l’estuaire, le Bas Médoc est un petit pays rural, très différent du Haut Médoc viticole."
                                            },
                                            {
                                                "example_id": "f2aa1067-acb1-40e2-91d9-247dacb3ad02",
                                                "sense_id": "255329d7-79fb-38ee-8877-31bc4b722ec1",
                                                "text": "Placé au sud de la commune de Vendays-Montalivet, sur le littoral du Médoc à 85 kilomètres au nord-ouest de Bordeaux, le centre héliomarin de Vendays-Montalivet (dit CHM ou « Monta ») est depuis 1950 le plus ancien centre de vacances naturiste familial du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
