                        "form": "den Geschichtsschreibungen"
                    },
                    {
                        "form_id": "486d2548-f0a6-4daa-9c98-e481710b91c2",
                        "entry_id": "f4ddff23-2d66-31d2-845d-a02637b65f56",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Geschichtsschreibung"
                    },
                    {
                        "form_id": "ac4083a0-42ed-4cbb-9c3e-303d0c0f4e49",
                        "entry_id": "f4ddff23-2d66-31d2-845d-a02637b65f56",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Geschichtsschreibungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bdbd6fdb-9376-3842-98f2-3060bac538ab",
                        "entry_id": "f4ddff23-2d66-31d2-845d-a02637b65f56",
                        "glosses": [
                            "die schriftliche Darstellung geschichtlicher Vorgänge, Zustände und Gestalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8166a918-7e53-496f-b46e-fb7df394fff0",
                                "sense_id": "bdbd6fdb-9376-3842-98f2-3060bac538ab",
                                "text": "„Herodot gilt seit Cicero als ‚Vater der Geschichtsschreibung‘ […].“"
                            },
                            {
                                "example_id": "3351c6e4-59ac-4f19-b99a-63da172c73a6",
                                "sense_id": "bdbd6fdb-9376-3842-98f2-3060bac538ab",
                                "text": "„Mit Sabrows brillanter Studie wird ein neues Kapitel in der Erforschung der DDR-Geschichtsschreibung aufgeschlagen. […] Man wünschte sich endlich eine ebenso kritische Untersuchung der westdeutschen Geschichtsschreibung der fünfziger und frühen sechziger Jahre.“"
                            },
                            {
                                "example_id": "db1755ab-0626-40ec-b180-a6ffaec072f2",
                                "sense_id": "bdbd6fdb-9376-3842-98f2-3060bac538ab",
                                "text": "„Richtig aufmerksam wird die Geschichtsschreibung der Spätantike auf Geiserich erst, als er, zusammen mit rund 15000 Kriegern und deren Familien, im Jahr 429 von Gibraltar nach Nordafrika übersetzt.“"
                            },
                            {
                                "example_id": "93ce953c-59a3-41b9-94a3-7677d97be50e",
                                "sense_id": "bdbd6fdb-9376-3842-98f2-3060bac538ab",
                                "text": "„Erst nach 1989, nach der Öffnung der so lange geheimen Archive, werden die Lügen der sozialistischen Geschichtsschreibung offenbar.“"
                            },
                            {
                                "example_id": "7d744570-c4f1-433e-a329-61ba239e78f1",
                                "sense_id": "bdbd6fdb-9376-3842-98f2-3060bac538ab",
                                "text": "„Das Reich der Saken fand über die Mythologie Eingang in die antike Geschichtsschreibung: So war der Saken-Herrscher Gondophares das historische Vorbild für Kasper, einen der drei Weisen aus dem Morgenland; zudem soll der heilige Thomas in Gondophares' Reich missioniert haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "042202e7-631e-43d4-be0a-8166d4847f22",
                        "source_entry_id": "f4ddff23-2d66-31d2-845d-a02637b65f56",
                        "source_sense_id": "bdbd6fdb-9376-3842-98f2-3060bac538ab",
                        "source_sense_description": "die schriftliche Darstellung geschichtlicher Vorgänge, Zustände und Gestalten",
                        "target_lang_word": "historiography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historiography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4d4af90-4d9f-3852-952c-bdd50a8a1037",
                                        "entry_id": "f31895e2-73f7-32d4-9f91-ec3a0ed881f0",
                                        "glosses": [
                                            "The writing of history; a written history."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc90b3d-e92f-4f5e-8e10-856938d67fb6",
                                                "sense_id": "e4d4af90-4d9f-3852-952c-bdd50a8a1037",
                                                "text": "As was mentioned on p.31, value-judgments are generally considered the most conspicuous source of subjectivity in historiography."
                                            },
                                            {
                                                "example_id": "f02851f0-6e45-4a93-b08f-737e87a755e9",
                                                "sense_id": "e4d4af90-4d9f-3852-952c-bdd50a8a1037",
                                                "text": "We limited the discussion to historiographies examining the development of the modern Middle East from World War I onward."
                                            },
                                            {
                                                "example_id": "abe215a0-f193-495c-97c7-3e4092464c0d",
                                                "sense_id": "e4d4af90-4d9f-3852-952c-bdd50a8a1037",
                                                "text": "This article examines the usages of the notion of “revival” in the context of nineteenth-century Balkan history and, more precisely, in different national historiographies in the region."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3f0e08e-fb19-3620-8eba-3fd74301f931",
                                        "entry_id": "f31895e2-73f7-32d4-9f91-ec3a0ed881f0",
                                        "glosses": [
                                            "The study of the discipline and practice of history and the writings of past historians."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79533f6e-cf77-433e-b1df-b29695262548",
                                                "sense_id": "c3f0e08e-fb19-3620-8eba-3fd74301f931",
                                                "text": "In its broadest sense, historiography has to do with the process of historical writing, the identification and use of source material, and the techniques and methods applied to the analysis of these data."
                                            },
                                            {
                                                "example_id": "2d0bcfd1-2fc3-4c1d-847b-694af0938be5",
                                                "sense_id": "c3f0e08e-fb19-3620-8eba-3fd74301f931",
                                                "text": "Consistently the most underestimated and neglected debate in recent British historiography is that between Perry Anderson and Edward Thompson conducted in the mid-1960s in the pages of the New Left Review and the Socialist Register."
                                            },
                                            {
                                                "example_id": "29ac9346-c0c1-40eb-b49a-295a47151897",
                                                "sense_id": "c3f0e08e-fb19-3620-8eba-3fd74301f931",
                                                "text": "Thus in this brief and schematic survey of modern Indian historiography an emphasis is placed on the role of the concept of the Indian nation in the writing of Indian history; this will provide contextual knowledge for the following chapters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
