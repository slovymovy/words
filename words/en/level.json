{
    "word_family": [
        "leveler",
        "leveller",
        "levelly",
        "levelness",
        "unlevel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4dce2f6c-e782-31d3-a239-1343e000606d",
                    "sense_definition": "A specific degree, amount, or intensity of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noise <w>level</w> in the library was surprisingly high today.",
                            "target_lang_translations": {
                                "ru": "<w>Уровень</w> шума в библиотеке сегодня был на удивление высоким."
                            }
                        },
                        {
                            "text": "We need to maintain a high <w>level</w> of service for our customers.",
                            "target_lang_translations": {
                                "ru": "Нам необходимо поддерживать высокий <w>уровень</w> обслуживания наших клиентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "noise level",
                        "high level",
                        "level of success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная степень, количество или интенсивность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "степень развития или величина"
                            },
                            {
                                "target_lang_word": "степень",
                                "target_lang_sense_clarification": "мера интенсивности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f87b9e00-562e-30f6-8ef7-3f6fcbb51088",
                    "sense_definition": "A floor or story within a building or structure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please meet me on the ground <w>level</w> near the main entrance.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, встретьте меня на первом <w>этаже</w> рядом с главным входом."
                            }
                        },
                        {
                            "text": "The parking garage has a ground <w>level</w> and three underground floors.",
                            "target_lang_translations": {
                                "ru": "В паркинге есть наземный <w>уровень</w> и три подземных этажа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ground level",
                        "lower level",
                        "split level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Этаж или ярус внутри здания или сооружения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "ярус или этаж"
                            },
                            {
                                "target_lang_word": "этаж",
                                "target_lang_sense_clarification": "ярус здания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c696dcd-8bee-3ace-831e-3d27ae40f76f",
                    "sense_definition": "A discrete stage in a video game, often increasing in difficulty.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I finally reached the next <w>level</w> after playing for three hours.",
                            "target_lang_translations": {
                                "ru": "Я наконец-то достиг следующего <w>уровня</w> после трех часов игры."
                            }
                        },
                        {
                            "text": "The boss at the end of this <w>level</w> is very difficult to beat.",
                            "target_lang_translations": {
                                "ru": "Босса в конце этого <w>уровня</w> очень трудно победить."
                            }
                        }
                    ],
                    "synonyms": [
                        "stage",
                        "zone",
                        "world"
                    ],
                    "common_phrases": [
                        "next level",
                        "bonus level",
                        "final level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный этап в компьютерной игре, часто с возрастающей сложностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "этап в игре"
                            },
                            {
                                "target_lang_word": "этап",
                                "target_lang_sense_clarification": "часть игрового процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "358a1c27-7ef3-3a73-92b2-d14ad9aafa7d",
                    "sense_definition": "The height or position of something relative to a reference point like the ground or sea.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water <w>level</w> in the lake rose significantly after the heavy rain.",
                            "target_lang_translations": {
                                "ru": "<w>Уровень</w> воды в озере значительно поднялся после сильного дождя."
                            }
                        },
                        {
                            "text": "The city is located at sea <w>level</w> and is prone to flooding.",
                            "target_lang_translations": {
                                "ru": "Город расположен на <w>уровне</w> моря и подвержен наводнениям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sea level",
                        "water level",
                        "eye level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высота или положение чего-либо относительно точки отсчета, например, земли или моря."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "высота относительно отметки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dcb663f-3cad-31de-a557-4ca2d8c6c483",
                    "sense_definition": "A tool used to determine if a surface is perfectly horizontal or vertical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a spirit <w>level</w> to make sure the shelf is perfectly straight.",
                            "target_lang_translations": {
                                "ru": "Используйте спиртовой <w>уровень</w>, чтобы убедиться, что полка висит идеально ровно."
                            }
                        },
                        {
                            "text": "The carpenter checked the floor with a spirit <w>level</w> before installing the tiles.",
                            "target_lang_translations": {
                                "ru": "Плотник проверил пол <w>уровнем</w> перед укладкой плитки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spirit level",
                        "bubble level",
                        "laser level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, используемый для определения того, является ли поверхность идеально горизонтальной или вертикальной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уровень",
                                "target_lang_sense_clarification": "строительный инструмент"
                            },
                            {
                                "target_lang_word": "ватерпас",
                                "target_lang_sense_clarification": "плотницкий инструмент для проверки горизонтали"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05a7d1e8-0f7c-310a-b62b-6f3471c935de",
                    "sense_definition": "Having a flat and even surface; not sloping or tilting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "flatness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to find a <w>level</w> surface to set up the tent.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти <w>ровную</w> поверхность, чтобы поставить палатку."
                            }
                        },
                        {
                            "text": "The floor is not <w>level</w> surface, so the table wobbles.",
                            "target_lang_translations": {
                                "ru": "Пол — не <w>ровная</w> поверхность, поэтому стол качается."
                            }
                        }
                    ],
                    "synonyms": [
                        "flush"
                    ],
                    "antonyms": [
                        "tilted",
                        "uneven"
                    ],
                    "common_phrases": [
                        "level surface",
                        "level ground",
                        "perfectly level"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий плоскую и ровную поверхность; без наклона или перекоса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ровный",
                                "target_lang_sense_clarification": "плоский и гладкий"
                            },
                            {
                                "target_lang_word": "горизонтальный",
                                "target_lang_sense_clarification": "параллельный горизонту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0e136c0-ef51-382e-a730-1c4c78460654",
                    "sense_definition": "At the same height or position as something else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The top of the fence is <w>level</w> with the bottom of the window.",
                            "target_lang_translations": {
                                "ru": "Верх забора находится <w>вровень</w> с нижней частью окна."
                            }
                        },
                        {
                            "text": "Try to keep your chin <w>level</w> with the floor during the exercise.",
                            "target_lang_translations": {
                                "ru": "Старайтесь держать подбородок <w>параллельно</w> полу во время упражнения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "level with"
                    ],
                    "target_lang_definitions": {
                        "ru": "На той же высоте или в том же положении, что и что-то другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на одном уровне",
                                "target_lang_sense_clarification": "вровень с чем-либо"
                            },
                            {
                                "target_lang_word": "вровень",
                                "target_lang_sense_clarification": "на одинаковой высоте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec790c5b-3cc4-3b13-834e-e40e48c82e98",
                    "sense_definition": "Calm, steady, and sensible, especially in a difficult situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to keep a <w>level</w> head during the emergency.",
                            "target_lang_translations": {
                                "ru": "Ей удалось сохранить <w>трезвую</w> голову во время чрезвычайной ситуации."
                            }
                        },
                        {
                            "text": "He spoke in a <w>level</w> voice to avoid showing his anger.",
                            "target_lang_translations": {
                                "ru": "Он говорил <w>ровным</w> голосом, чтобы не выдать своего гнева."
                            }
                        }
                    ],
                    "antonyms": [
                        "unbalanced"
                    ],
                    "common_phrases": [
                        "level head",
                        "level voice",
                        "level gaze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спокойный, уравновешенный и разумный, особенно в трудной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спокойный",
                                "target_lang_sense_clarification": "уравновешенный"
                            },
                            {
                                "target_lang_word": "ровный",
                                "target_lang_sense_clarification": "о голосе или характере"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd1dc437-19e4-3a7e-89de-393ecb39381b",
                    "sense_definition": "To make a surface flat, horizontal, or even.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flattening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>level</w> the ground before they could pour the concrete.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>выровнять</w> землю, прежде чем заливать бетон."
                            }
                        },
                        {
                            "text": "You can <w>level</w> the table by adjusting the screws on the legs.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>выровнять</w> стол, отрегулировав винты на ножках."
                            }
                        }
                    ],
                    "synonyms": [
                        "equalize"
                    ],
                    "common_phrases": [
                        "level the ground",
                        "level the playing field"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать поверхность плоской, горизонтальной или ровной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выравнивать",
                                "target_lang_sense_clarification": "делать ровным"
                            },
                            {
                                "target_lang_word": "разровнять",
                                "target_lang_sense_clarification": "сделать поверхность гладкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "459b7492-4013-39ec-9ad0-364b0af26d47",
                    "sense_definition": "To completely destroy a building or area by knocking it down to the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The powerful earthquake threatened to <w>level</w> the entire city.",
                            "target_lang_translations": {
                                "ru": "Мощное землетрясение грозило <w>сровнять с землей</w> весь город."
                            }
                        },
                        {
                            "text": "The old factory was <w>leveled</w> to make room for a new park.",
                            "target_lang_translations": {
                                "ru": "Старую фабрику <w>снесли</w>, чтобы освободить место для нового парка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "level to the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью разрушить здание или территорию, сровняв их с землей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сровнять с землей",
                                "target_lang_sense_clarification": "полностью разрушить"
                            },
                            {
                                "target_lang_word": "сносить",
                                "target_lang_sense_clarification": "разрушать до основания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30c6e7fb-f541-3165-ba64-3f573ce5b61a",
                    "sense_definition": "To speak honestly and directly with someone, without hiding anything.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to <w>level</w> with you; the situation is quite serious.",
                            "target_lang_translations": {
                                "ru": "Я буду с вами <w>откровенен</w>: ситуация довольно серьезная."
                            }
                        },
                        {
                            "text": "He decided to <w>level</w> with his boss about the mistake he made.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>честно признаться</w> боссу в совершенной ошибке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "level with someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'level with someone'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить с кем-то честно и прямо, ничего не скрывая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить на чистоту",
                                "target_lang_sense_clarification": "быть откровенным"
                            },
                            {
                                "target_lang_word": "быть честным",
                                "target_lang_sense_clarification": "не скрывать правду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e8767d6-3dd5-3d7d-a3e8-5bc59f1ea6fc",
                    "sense_definition": "To aim a weapon or a direct statement (like an accusation) at someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecutor <w>leveled</w> an accusation of theft against the defendant.",
                            "target_lang_translations": {
                                "ru": "Прокурор <w>выдвинул</w> обвинение в краже против подсудимого."
                            }
                        },
                        {
                            "text": "The soldier <w>leveled</w> his rifle at the target.",
                            "target_lang_translations": {
                                "ru": "Солдат <w>направил</w> винтовку на цель."
                            }
                        }
                    ],
                    "common_phrases": [
                        "level an accusation",
                        "level a charge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направить оружие или прямое высказывание (например, обвинение) на кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "целиться или адресовать"
                            },
                            {
                                "target_lang_word": "выдвигать",
                                "target_lang_sense_clarification": "предъявлять обвинение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fa645935-2433-310c-a6e5-070cd70fb974",
                    "sense_definition": "A surname of French origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Level</w> family has lived in this region for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Левель</w> жила в этом регионе на протяжении поколений."
                            }
                        },
                        {
                            "text": "We are researching the genealogy of the <w>Levels</w>.",
                            "target_lang_translations": {
                                "ru": "Мы изучаем генеалогию семьи <w>Левель</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "French origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия французского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Левель",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}