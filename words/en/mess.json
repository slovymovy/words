                    "target_lang_definitions": {
                        "ru": "Здание или комната, где питаются и общаются военнослужащие.",
                        "tr": "Askeri personelin yemek yediği ve vakit geçirdiği bina veya salon.",
                        "zh": "军队中供军人用餐和社交的场所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столовая",
                                "target_lang_sense_clarification": "место приема пищи"
                            },
                            {
                                "target_lang_word": "офицерская столовая",
                                "target_lang_sense_clarification": "специализированное помещение для офицеров"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yemekhane",
                                "target_lang_sense_clarification": "askeri yemek yenen yer"
                            },
                            {
                                "target_lang_word": "gazino",
                                "target_lang_sense_clarification": "askeri sosyal tesis / subay gazinosu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "食堂",
                                "target_lang_sense_clarification": "通用的用餐场所"
                            },
                            {
                                "target_lang_word": "军官餐厅",
                                "target_lang_sense_clarification": "特指军官用餐处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbfcda41-fb77-3349-9642-07c25981a2f2",
                    "sense_definition": "A large quantity or number of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He caught a whole <w>mess</w> of fish during his weekend trip to the lake.",
                            "target_lang_translations": {
                                "ru": "Он поймал целую <w>кучу</w> рыбы во время поездки на озеро в выходные.",
                                "tr": "Hafta sonu göl gezisinde bir <w>sürü</w> balık tuttu.",
                                "zh": "周末去湖边旅行时，他钓到了<w>一大堆</w>鱼。"
                            }
                        },
                        {
                            "text": "We have a <w>mess</w> of trouble on our hands if we do not fix this problem soon.",
                            "target_lang_translations": {
                                "ru": "У нас будет <w>куча</w> неприятностей, если мы скоро не решим эту проблему.",
                                "tr": "Bu sorunu yakında çözmezsek başımızda bir <w>yığın</w> dert olacak.",
                                "zh": "如果我们不尽快解决这个问题，就会有<w>一大堆</w>麻烦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a mess of"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US South and Midland"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или число чего-либо.",
                        "tr": "Bir şeyin büyük miktarı veya çok sayıda olması.",
                        "zh": "指大量或许多某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "разговорное; большое количество"
                            },
                            {
                                "target_lang_word": "уйма",
                                "target_lang_sense_clarification": "разговорное; множество"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yığın",
                                "target_lang_sense_clarification": "büyük miktar"
                            },
                            {
                                "target_lang_word": "sürü",
                                "target_lang_sense_clarification": "bir sürü, çok fazla"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一大堆",
                                "target_lang_sense_clarification": "口语中表示数量多"
                            },
                            {
                                "target_lang_word": "许多",
                                "target_lang_sense_clarification": "表示数量多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33bdfe89-4f43-388a-8b4f-c6b2f9be53c6",
                    "sense_definition": "A dessert made of fruit (usually strawberries), meringue, and cream.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dessert, we served a traditional Eton <w>mess</w> with fresh strawberries.",
                            "target_lang_translations": {
                                "ru": "На десерт мы подали традиционный Итон <w>месс</w> со свежей клубникой.",
                                "tr": "Tatlı olarak taze çilekli geleneksel bir Eton <w>mess</w> ikram ettik.",
                                "zh": "作为甜点，我们供应了传统的草莓<w>伊顿杂烩</w>。"
                            }
                        },
                        {
                            "text": "The children loved the sweet mixture of cream and crushed meringue in the <w>mess</w>.",
                            "target_lang_translations": {
                                "ru": "Детям понравилась сладкая смесь сливок и измельченного безе в этом <w>десерте</w>.",
                                "tr": "Çocuklar bu <w>tatlıdaki</w> krema ve ufalanmış bezenin tatlı karışımını çok sevdi.",
                                "zh": "孩子们很喜欢这道<w>伊顿杂烩</w>里奶油和碎蛋白酥的甜美混合口感。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Eton mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Десерт из фруктов (обычно клубники), безе и сливок.",
                        "tr": "Meyve (genellikle çilek), beze ve kremayla yapılan bir İngiliz tatlısı.",
                        "zh": "一种由水果（通常是草莓）、蛋白酥和奶油制成的英式甜点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Итон месс",
                                "target_lang_sense_clarification": "название десерта"
                            },
                            {
                                "target_lang_word": "мешанина",
                                "target_lang_sense_clarification": "буквальный перевод, описывающий консистенцию"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Eton mess",
                                "target_lang_sense_clarification": "özel tatlı adı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伊顿杂烩",
                                "target_lang_sense_clarification": "该甜点的中文译名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad63ae19-11f0-3933-bdac-c39c7f0c878c",
                    "sense_definition": "To make something dirty, untidy, or disordered.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disorder_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>mess</w> the floor with your muddy boots.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>пачкай</w> пол своими грязными ботинками.",
                                "tr": "Lütfen çamurlu botlarınla yeri <w>kirletme</w>.",
                                "zh": "请不要用你那沾满泥的靴子把地板<w>弄脏</w>。"
                            }
                        },
                        {
                            "text": "The wind will <w>mess</w> your hair if you do not wear a hat outside.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>растреплет</w> твои волосы, если ты не наденешь шапку на улице.",
                                "tr": "Dışarıda şapka takmazsan rüzgar saçını <w>bozacak</w>.",
                                "zh": "如果你在外面不戴帽子，风会把你的头发<w>弄乱</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mess up",
                        "mess about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо грязным, неопрятным или приводить в беспорядок.",
                        "tr": "Bir şeyi kirletmek, dağıtmak veya düzensiz hale getirmek.",
                        "zh": "使某物变脏、杂乱或无序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "делать грязным"
                            },
                            {
                                "target_lang_word": "приводить в беспорядок",
                                "target_lang_sense_clarification": "нарушать порядок"
                            },
                            {
                                "target_lang_word": "растрепать",
                                "target_lang_sense_clarification": "о волосах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kirletmek",
                                "target_lang_sense_clarification": "pis hale getirmek"
                            },
                            {
                                "target_lang_word": "dağıtmak",
                                "target_lang_sense_clarification": "düzenini bozmak"
                            },
                            {
                                "target_lang_word": "bozmak",
                                "target_lang_sense_clarification": "saçı veya düzeni bozmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "使变脏"
                            },
                            {
                                "target_lang_word": "弄乱",
                                "target_lang_sense_clarification": "使失去秩序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a3c02ee-7e4e-36ef-accc-e8f265efb9ed",
                    "sense_definition": "To interfere or meddle with someone or something, often causing trouble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interference_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>mess</w> with the electrical wiring if you are not a professional.",
