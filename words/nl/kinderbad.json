                {
                    "sense_id": "60a391da-bc24-3cc1-9875-128caf544772",
                    "sense_definition": "Ondiep zwembassin dat speciaal bedoeld is voor kleine kinderen om veilig in te spelen of te zwemmen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zwemfaciliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De peuters spetteren vrolijk in het ondiepe <w>kinderbad</w> van het zwemparadijs.",
                            "target_lang_translations": {
                                "en": "The toddlers are splashing happily in the shallow <w>children's pool</w> at the water park."
                            }
                        },
                        {
                            "text": "Ouders moeten altijd toezicht houden wanneer hun kind in het <w>kinderbad</w> speelt.",
                            "target_lang_translations": {
                                "en": "Parents should always supervise when their child is playing in the <w>paddling pool</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "peuterbad",
                        "pierenbad"
                    ],
                    "common_phrases": [
                        "ondiep kinderbad",
                        "spelen in het kinderbad"
                    ],
                    "target_lang_definitions": {
                        "en": "Shallow swimming pool specially intended for young children to play or swim safely."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "paddling pool",
