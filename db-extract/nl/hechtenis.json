                                "target_senses": [
                                    {
                                        "sense_id": "b4738dfd-569e-369b-8fe7-de479d7c59ae",
                                        "entry_id": "ea5327e2-e661-3096-839b-d14c85b856d7",
                                        "glosses": [
                                            "The legal right to take care of something or somebody, especially children."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269f06a6-424f-4133-a7ee-38980c93dff0",
                                                "sense_id": "b4738dfd-569e-369b-8fe7-de479d7c59ae",
                                                "text": "The court awarded custody to the child's father."
                                            },
                                            {
                                                "example_id": "4b5bfe69-c0f1-40eb-8ae4-7b5a13901e1a",
                                                "sense_id": "b4738dfd-569e-369b-8fe7-de479d7c59ae",
                                                "text": "The mother gained custody of the children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da9f370-27a6-3746-ae49-4d650e407e00",
                                        "entry_id": "ea5327e2-e661-3096-839b-d14c85b856d7",
                                        "glosses": [
                                            "Temporary possession or care of somebody else's property."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9175ccf4-33a1-491d-ab0c-4df59aabe092",
                                                "sense_id": "8da9f370-27a6-3746-ae49-4d650e407e00",
                                                "text": "I couldn't pay the bill and now my passport is in custody of the hotel management."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9cef2af-4cb4-3d04-92f7-d8aea155bdc2",
                                        "entry_id": "ea5327e2-e661-3096-839b-d14c85b856d7",
                                        "glosses": [
                                            "The state of being imprisoned or detained, usually pending a trial."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f252b207-7815-41e8-8c5f-20c32cc7c79b",
                                                "sense_id": "b9cef2af-4cb4-3d04-92f7-d8aea155bdc2",
                                                "text": "He was mistreated while in police custody."
                                            },
                                            {
                                                "example_id": "9fdc30db-53e2-4923-ba23-b8bf44dae74b",
                                                "sense_id": "b9cef2af-4cb4-3d04-92f7-d8aea155bdc2",
                                                "text": "Original petition for writ of habeas corpus to obtain release from custody under sentence to five years imprisonment for aiding coprisoners in endeavors to escape from jail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7e2409d-24d3-3246-9bde-6b2635443d11",
                                        "entry_id": "ea5327e2-e661-3096-839b-d14c85b856d7",
                                        "glosses": [
                                            "An area under the jurisdiction of a custos within the Order of Friars Minor."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb07e891-f312-480b-a482-2738b8bf8d5c",
                                                "sense_id": "b7e2409d-24d3-3246-9bde-6b2635443d11",
                                                "text": "The Custody of the Holy Land includes the monasteries of Bethlehem, Nazareth, and Jerusalem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec04b29c-75a8-4389-8cda-0666b50c4af1",
                        "source_entry_id": "188e0923-004a-373a-811c-858275aa75a0",
                        "source_sense_id": "192c3bbd-9b70-3d41-82bd-63b6de716a90",
                        "source_sense_description": "arrest, gevangenschap",
                        "target_lang_word": "garde à vue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garde à vue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ebb4068-0704-313c-b96d-b883491c1c7a",
                                        "entry_id": "f7df3e19-8fa2-338c-9f05-14c43ae1396f",
                                        "glosses": [
                                            "En procédure pénale, retenue par la police d’une personne suspectée d’avoir commis une infraction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b7c7a17-8bc9-4c6e-9f82-2b713b27b205",
                                                "sense_id": "1ebb4068-0704-313c-b96d-b883491c1c7a",
                                                "text": "Du côté du parti socialiste, on se félicite que le MR et le CDH, qui avaient refusé la prolongation du délai de garde à vue à 48 heures, se soient finalement rallié à une telle proposition."
                                            },
                                            {
                                                "example_id": "4d8b56b1-d476-4d07-be5a-be3ef30b36fb",
                                                "sense_id": "1ebb4068-0704-313c-b96d-b883491c1c7a",
                                                "text": "Selon la loi nippone, une garde à vue de soixante-douze heures peut être prolongée de dix jours à deux reprises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d95a8c03-9335-3b6b-933a-876b1da493ed",
                                        "entry_id": "f7df3e19-8fa2-338c-9f05-14c43ae1396f",
                                        "glosses": [
                                            "Mesure de contrainte par laquelle un officier de police judiciaire maintient à la disposition des enquêteurs une personne plausiblement soupçonnée d’avoir perpétré un crime ou délit."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51314ae1-55eb-4454-8968-0982ccbd7e89",
                                                "sense_id": "d95a8c03-9335-3b6b-933a-876b1da493ed",
                                                "text": "Hier, dans un communiqué commun, Christophe Castaner et Jean-Michel Blanquer expliquaient que deux personnes avaient été placées en garde à vue « dès vendredi » par les policiers du Val-de-Marne, « dans le but de faire toute la lumière sur ces agissements ». L’enquête se poursuit."
                                            },
                                            {
                                                "example_id": "5f4cad60-cdbc-4a4c-9bbe-8d7baa2e05c8",
                                                "sense_id": "d95a8c03-9335-3b6b-933a-876b1da493ed",
                                                "text": "En justice préalable et préventive, tout individu relaxé après 48 heures de garde à vue a besoin d’une bonne quinzaine de jours de repos pour se relaxer tant physiquement qu’intellectuellement à effet de se remettre au garde à soi."
                                            },
                                            {
                                                "example_id": "9e6c0316-6e60-4edb-a216-82e1a94aef70",
                                                "sense_id": "d95a8c03-9335-3b6b-933a-876b1da493ed",
                                                "text": "Les deux individus, âgés de 19 et 22 ans, ont été placés en garde à vue au commissariat de police de Villeneuve-sur-Lot, pour outrages et violences sur agents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
