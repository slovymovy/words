                                        "glosses": [
                                            "The shore or beach of the sea or ocean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036703ab-44a0-4f1b-b3e0-057accc054f0",
                                                "sense_id": "44615ef9-a19a-3b7b-8b32-87b84883c340",
                                                "text": "Grand Strand"
                                            },
                                            {
                                                "example_id": "59f7a3dc-492b-4da1-8ba0-97b736ca4ab0",
                                                "sense_id": "44615ef9-a19a-3b7b-8b32-87b84883c340",
                                                "text": "A woman that wandring in our coaſtes hath bought / A plot for price: where ſhe a citie ſet: / To whom we gaue the ſtrond for to manure."
                                            },
                                            {
                                                "example_id": "f0683e78-d676-4b4e-b6ad-935208d3612a",
                                                "sense_id": "44615ef9-a19a-3b7b-8b32-87b84883c340",
                                                "text": "They rowed about a League; and then ſet me down on a Strand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a033b83c-18d8-383c-813c-8416e82229b1",
                                        "entry_id": "2c6cae1b-2aff-3235-92e3-10404b7cb785",
                                        "glosses": [
