            "senses": [
                {
                    "sense_id": "4d06c849-be40-3c70-989e-d2dce20f9b44",
                    "sense_definition": "Bliska osoba, z którą łączą nas więzi sympatii, zaufania i szczerości, niebędąca członkiem rodziny",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relacje_osobiste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój najlepszy <w>przyjaciel</w> mieszka w innym mieście.",
                            "target_lang_translations": {
                                "ru": "Мой лучший <w>друг</w> живёт в другом городе.",
                                "de": "Mein bester <w>Freund</w> wohnt in einer anderen Stadt."
                            }
                        },
                        {
                            "text": "Prawdziwych <w>przyjaciół</w> poznaje się w biedzie.",
                            "target_lang_translations": {
                                "ru": "Настоящие <w>друзья</w> познаются в беде.",
                                "de": "Wahre <w>Freunde</w> erkennt man in der Not."
                            }
                        }
                    ],
                    "synonyms": [
                        "druh",
                        "towarzysz"
                    ],
                    "antonyms": [
                        "wróg",
                        "nieprzyjaciel"
                    ],
                    "common_phrases": [
                        "najlepszy przyjaciel",
                        "wierny przyjaciel",
                        "fałszywy przyjaciel",
                        "serdeczny przyjaciel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Близкий человек, с которым связывают отношения симпатии, доверия и искренности, не являющийся членом семьи",
                        "de": "Eine nahestehende Person, mit der man freundschaftliche Gefühle teilt, die jedoch kein Familienmitglied ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "друг",
                                "target_lang_sense_clarification": "близкий человек"
                            },
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "товарищ, знакомый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Freund",
                                "target_lang_sense_clarification": "eine Person, zu der man eine freundschaftliche Beziehung hat"
