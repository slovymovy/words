                {
                    "sense_id": "3db5e851-6b8a-343b-8d53-f4ee9ef908e0",
                    "sense_definition": "Qui est considérable, excessif, hors du commun.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excessif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche, il est rentré avec un appétit <w>effrayant</w>.",
                            "target_lang_translations": {
                                "en": "After a long day of walking, he came home with an <w>enormous</w> appetite.",
                                "ru": "После долгого дня ходьбы он вернулся домой с <w>огромным</w> аппетитом.",
                                "de": "Nach einem langen Wandertag kam er mit einem <w>riesigen</w> Appetit nach Hause.",
                                "es": "Después de un largo día de caminata, volvió a casa con un apetito <w>enorme</w>.",
                                "zh": "走了一整天的路，他回到家时带着<w>巨大</w>的食欲。"
                            }
                        },
                        {
                            "text": "Ce projet d'infrastructure exige un investissement financier d'une ampleur <w>effrayante</w>.",
                            "target_lang_translations": {
                                "en": "This infrastructure project requires financial investment on a <w>tremendous</w> scale.",
                                "ru": "Этот инфраструктурный проект требует финансовых вложений <w>колоссального</w> масштаба.",
                                "de": "Dieses Infrastrukturprojekt erfordert eine finanzielle Investition von <w>enormem</w> Umfang.",
                                "es": "Este proyecto de infraestructura exige una inversión financiera de una magnitud <w>tremenda</w>.",
                                "zh": "这项基础设施建设需要规模<w>庞大</w>的资金投入。"
                            }
                        }
                    ],
