                "translations": [
                    {
                        "translation_id": "bf91886a-c23a-465b-986e-19bfaf7f986c",
                        "source_entry_id": "5a343b92-2b61-37b2-a05e-b9a4c405a408",
                        "source_sense_id": "1478ccdb-8d1c-3afe-9272-128e8e49f5c0",
