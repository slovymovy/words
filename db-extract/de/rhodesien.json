                                    {
                                        "sense_id": "8e33475e-d433-313a-bc93-f7b51470f241",
                                        "entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                                        "glosses": [
                                            "A former country in Southern Africa, in what is now Zimbabwe, originally called Southern Rhodesia, named after its founder, Cecil Rhodes."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0999b7e3-eaea-4413-a5ba-d1df8a74b79f",
                                                "sense_id": "8e33475e-d433-313a-bc93-f7b51470f241",
                                                "text": "If you did that in Rhodesia, you could be punished with many years in prison."
                                            },
                                            {
                                                "example_id": "b54ad6d5-6455-4056-8426-f8d9edd136c4",
                                                "sense_id": "8e33475e-d433-313a-bc93-f7b51470f241",
                                                "text": "After independence, Rhodesia changed its name to Zimbabwe, Nyasaland to Malawi, and Bechuanaland to Botswana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3c2015-cb93-3b4d-9bbb-490667e843f1",
                                        "entry_id": "938ff4d8-4e8d-3857-814b-84d3aaa27f58",
                                        "glosses": [
                                            "A historical region of Southern Africa, the area now occupied by Zimbabwe and Zambia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
