                "senses": [
                    {
                        "sense_id": "b7c4f918-0692-3c8a-b8e9-8c6e465b47a4",
                        "entry_id": "72c54477-6824-3a9d-8a07-fd0dbd97a756",
                        "glosses": [
                            "Ehepartner von Geschwistern beziehungsweise Geschwister des Ehepartners"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b7779b17-d09c-404a-9766-3409bcbeed57",
                                "sense_id": "b7c4f918-0692-3c8a-b8e9-8c6e465b47a4",
                                "text": "„Die Hochzeitsplaner des Schiffs denken an Scheidung, ein geheilter Krebspatient gönnt sich und seiner Frau eine Traumreise, zwei Schwiegergeschwister entdecken ihre Liebe füreinander.“"
                            },
                            {
                                "example_id": "7fe4facb-c3c4-49d2-9551-54cab58a3730",
                                "sense_id": "b7c4f918-0692-3c8a-b8e9-8c6e465b47a4",
                                "text": "„Zu diesem Kreis zählen Partnerin oder Partner, Eltern, Kinder und Enkel, sowie die Geschwister und Schwiegergeschwister der oder des Verstorbenen.“"
                            },
                            {
                                "example_id": "2f50670b-c6da-4cf7-a5dd-41922b499f3a",
                                "sense_id": "b7c4f918-0692-3c8a-b8e9-8c6e465b47a4",
                                "text": "„Er selbst wohnt in dem Haus, gemeinsam mit seiner Freundin, den Schwiegergeschwistern und der Schwiegermutter in spe.“"
                            },
                            {
                                "example_id": "cb3f566f-b6a2-4a64-9769-1f3e52f8321e",
                                "sense_id": "b7c4f918-0692-3c8a-b8e9-8c6e465b47a4",
                                "text": "„Unter ‚Großfamilie‘ werden eventuell auch Tanten, Onkel, Cousins, Neffen, Nichten und Schwiegergeschwister verstanden.“"
                            },
                            {
                                "example_id": "90852748-cc72-49fb-9305-12ef3cc94ca2",
                                "sense_id": "b7c4f918-0692-3c8a-b8e9-8c6e465b47a4",
                                "text": "„Unerhört freilich wären solche Vorgänge, wie sie Bayern schildert, nicht; erfahren wir doch aus dem 6. Hefte der Zeitschrift für Ethnologie […], dass die Dieyerie der in das Grab gelegten Leiche das Fett abschneiden, das sodann von den durch Bemalung bezeichneten Verwandten verzehrt wird, indem die Mutter von Kindern, die Kinder von der Mutter, Schwiegergeschwister von einander, Onkel, Tante, Neffen, Nichten, Enkel und Grosseltern von einander essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
