                        "entry_id": "19b76d2f-292a-34d0-92a1-c7276b5b5c2a",
                        "glosses": [
                            "een lantaarn met een gasvlam als lichtbron"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f045713f-2362-47f8-b89f-d5fdb40913bf",
                                "sense_id": "52f106f1-9b59-3e72-8ef3-bd9a166e5dde",
                                "text": "Vroeger was ook in huis een gaslamp als lichtbron heel gewoon."
                            }
                        ]
