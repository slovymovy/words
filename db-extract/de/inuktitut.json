                "senses": [
                    {
                        "sense_id": "7cffc1ea-7cc1-3a5d-92c2-1f932aa92467",
                        "entry_id": "3f48689d-c48a-394d-9bec-c03fab83e687",
                        "glosses": [
                            "die Sprache der Inuit, die aus mehreren Varietäten (Kalaallisut oder Grönländisch, Inupiaq) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca22b7c-b67b-4380-ac2c-032f6a8d8994",
                                "sense_id": "7cffc1ea-7cc1-3a5d-92c2-1f932aa92467",
                                "text": "Im kanadischen Territorium Nunavut können seit 2008 Angelegenheiten bei Behörden oder in Krankenhäusern auf Inuktitut geregelt werden."
                            },
                            {
                                "example_id": "0d6b63c7-6d91-47ee-a9ec-3a99b3982d67",
                                "sense_id": "7cffc1ea-7cc1-3a5d-92c2-1f932aa92467",
                                "text": "„Die ersten schriftlichen Zeugnisse des Inuktitut stammen aus dem 18. Jahrhundert aus Labrador, in anderen Gebieten teilweise aus dem ersten Viertel des 20. Jahrhunderts.“"
                            },
                            {
                                "example_id": "7f99c700-ea6e-4862-a8d8-78266ccbe8ac",
                                "sense_id": "7cffc1ea-7cc1-3a5d-92c2-1f932aa92467",
                                "text": "„Das Gesangbuch ist wie alles im Land komplett zweisprachig geschrieben, in Inuktitut und Dänisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c1880e1-afbc-4555-abf5-2f5341f89e69",
                        "source_entry_id": "3f48689d-c48a-394d-9bec-c03fab83e687",
                        "source_sense_id": "7cffc1ea-7cc1-3a5d-92c2-1f932aa92467",
                        "source_sense_description": "die Sprache der Inuit, die aus mehreren Varietäten (Kalaallisut oder Grönländisch, Inupiaq) besteht",
                        "target_lang_word": "Inuktitut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inuktitut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb3ecf6b-0d4e-33a4-a0ff-5f06be8ea009",
                                        "entry_id": "8c1d7d90-25cb-37f6-9077-dc5d9428e52c",
                                        "glosses": [
                                            "The language of the Inuit people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c944ec-6573-4f3c-9b87-a46cc2dabfaa",
                                                "sense_id": "bb3ecf6b-0d4e-33a4-a0ff-5f06be8ea009",
                                                "text": "I can hear a swell of laughter and boisterous merriment in Inuktitut."
                                            },
                                            {
                                                "example_id": "a5bf9634-c29b-485c-a699-9da2440b7ee8",
                                                "sense_id": "bb3ecf6b-0d4e-33a4-a0ff-5f06be8ea009",
                                                "text": "In the Northwest Territories, the languages with official status are English, French, Dëne Sųłıné (Chipewyan), Nēhiyawēwin (Cree), Dene Kǝdǝ́ (Northern Slavey), Dene Zhatıé (Southern Slavey), Dinjii Zhu’ Ginjik (Gwich’in), Inuinnaqtun, Inuktitut, Inuvialuktun and Tłįcho."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13befc53-1659-4db1-9751-eec3f420ebef",
                        "source_entry_id": "3f48689d-c48a-394d-9bec-c03fab83e687",
                        "source_sense_id": "7cffc1ea-7cc1-3a5d-92c2-1f932aa92467",
                        "source_sense_description": "die Sprache der Inuit, die aus mehreren Varietäten (Kalaallisut oder Grönländisch, Inupiaq) besteht",
                        "target_lang_word": "inuktitut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inuktitut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6653b0fd-ce41-355c-a630-a0250e40de83",
                                        "entry_id": "a28f49d0-101d-3c77-ad74-7264add40bfd",
                                        "glosses": [
                                            "Un des quatre grands ensembles linguistiques de l’inuit, parlé dans le nord du Québec et dans le Nunavut (Nord oriental canadien)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b816578d-8d26-4db6-be39-14a812a1d3f7",
                                                "sense_id": "6653b0fd-ce41-355c-a630-a0250e40de83",
                                                "text": "En 2001, 31,945 habitants du nord du Québec et du Nunavut maîtrisaient encore l’inuktitut; leur nombre a même augmenté de près de 10 % de 1996 à 2001. L’inuktitut résonne dans les cours de récréation, car plus des deux tiers des enfants inuits s’expriment d’abord dans leur langue. […] Le cri et l’ojibwa sont, avec l’inuktitut, les seules langues indigènes dont les linguistes ne prévoient pas l’extinction prochaine."
                                            },
                                            {
                                                "example_id": "5da05808-11d6-4000-86f2-3623e74d2d86",
                                                "sense_id": "6653b0fd-ce41-355c-a630-a0250e40de83",
                                                "text": "M. Tapardjuk a déposé deux projets de loi sur les langues au Nunavut. Le premier, une loi sur les langues officielles, ferait de l’anglais, du français et de l’inuktitut les langues officielles du territoire. Le second, une loi sur la protection de la langue inuite, imposerait l’utilisation de l’inuktitut sur les panneaux de signalisation et dans le secteur des services afin de faire en sorte que l’utilisation des trois langues demeure sur un pied d’égalité. […] Comme le français l’était au Québec, l’inuktitut est menacé par l’utilisation de l’anglais. « Si vous allez dans un restaurant, vous ne verrez pas de menu en inuktitut. Tout est en anglais, a déploré le ministre. Dans les magasins régionaux, la majorité des clients sont des Inuits, mais la majorité de l’affichage est en anglais. On se demande qui est vraiment servi. » […] Une étude de Statistique Canada, publiée la semaine dernière, indiquait que l’inuktitut était une des langues autochtones les mieux préservées au pays. Plus de la moitié des 30,000 Inuits du Canada le considèrent comme leur langue maternelle et c’est la langue la plus souvent parlée à la maison par 43 % d’entre eux. Toutefois, l’utilisation de l’inuktitut décline chez les jeunes, moins susceptibles de le parler couramment."
                                            },
                                            {
                                                "example_id": "b5003598-30cb-4939-8102-9aa78e729ac7",
                                                "sense_id": "6653b0fd-ce41-355c-a630-a0250e40de83",
                                                "text": "Et comme l’inuktitut est parlé par 99 % des Inuits du Nunavik (Nord québécois), c’est dans cette langue — un peu mêlée d’anglais, faut-il dire — que les jeunes rappeurs se produisent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inuktitut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdab5f46-0152-3754-a19f-10c6a333fd0b",
                                        "entry_id": "857f189e-d9ce-3fc8-a3d7-0c498f56606b",
                                        "glosses": [
                                            "Relatif à l’inuktitut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3958681-bb86-4f7d-b5b8-2125f526cff9",
                                                "sense_id": "bdab5f46-0152-3754-a19f-10c6a333fd0b",
                                                "text": "Il n’est envisageable d’associer les jeunes [Inuits] au savoir traditionnel qu’en passant par la langue inuktitute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
