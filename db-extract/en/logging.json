                                        "examples": [
                                            {
                                                "example_id": "f730a833-ed65-4668-84ac-e217fc311483",
                                                "sense_id": "8921c89e-173a-3519-a1b2-edfe06b0b85b",
                                                "text": "Einen Grundriss / einen Weg auf Papier aufzeichnen"
                                            },
                                            {
                                                "example_id": "5184a19c-85a9-4b11-aea7-5ce7c888e0fe",
                                                "sense_id": "8921c89e-173a-3519-a1b2-edfe06b0b85b",
                                                "text": "Ich kann mir von deinen Plänen noch gar kein Bild machen. Kannst du mir das bitte einmal aufzeichnen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d198b1d7-2f04-3be2-93d5-3701e27f0282",
                                        "entry_id": "a3c93dc9-764f-3517-a4f4-850730e5e513",
                                        "glosses": [
                                            "in schriftlicher oder elektronischer Form festhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf4fd64-3e26-4f86-95c6-1dcde5a7b0ba",
                                                "sense_id": "d198b1d7-2f04-3be2-93d5-3701e27f0282",
                                                "text": "Gedanken, Gefühle, Ideen im Tagebuch aufzeichnen."
                                            },
                                            {
                                                "example_id": "2a8184ce-fff7-4f18-ba66-94f43b9e32ef",
                                                "sense_id": "d198b1d7-2f04-3be2-93d5-3701e27f0282",
                                                "text": "Das Gespräch wurde schon vor der Sendung aufgezeichnet."
                                            },
                                            {
                                                "example_id": "151127d0-ee3a-48ed-afc7-275739d1aa32",
                                                "sense_id": "d198b1d7-2f04-3be2-93d5-3701e27f0282",
                                                "text": "„Jedes Telefonat mit einem Bankmitarbeiter muss zukünftig aufgezeichnet werden“"
                                            },
                                            {
                                                "example_id": "0d32d60d-14a0-44c4-820f-224df02805e9",
                                                "sense_id": "d198b1d7-2f04-3be2-93d5-3701e27f0282",
                                                "text": "„Transitvisa sind besorgt, an der Frontscheibe ist eine Kamera angebracht, die die Fahrt aufzeichnen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
