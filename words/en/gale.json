                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mirto de Brabante",
                                "target_lang_sense_clarification": "arbusto Myrica gale"
                            },
                            {
                                "target_lang_word": "mirto de turbera",
                                "target_lang_sense_clarification": "arbusto Myrica gale"
                            }
                        ]
                    }
