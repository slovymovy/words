                "forms": [],
                "senses": [
                    {
                        "sense_id": "27c2da96-8de8-345c-a25a-3b08623d0bf4",
                        "entry_id": "66f05445-7eee-3d1d-b244-b53da6b29d67",
                        "glosses": [
                            "gericht op het behoud van iets; bederf remmend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761d049f-425d-487f-8763-58792e93e5c4",
                                "sense_id": "27c2da96-8de8-345c-a25a-3b08623d0bf4",
                                "text": "Onder uitvaartondernemers in Twente is een principiële discussie losgebarsten over de vraag of er binnenkort na de wetswijziging medewerking verleend moet worden aan het balsemen van stoffelijke overschotten. De meningen daarover zijn zeer verdeeld.blijft. De aanpassing van de Wet op de Lijkbezorging moet het mogelijk maken dat deze conserverende behandeling wettelijk wordt Balsemen van lijken ter discussiemtoegestaan.[sic!]"
                            },
                            {
                                "example_id": "89f8d933-6925-4e5f-9391-ccf4d10760ac",
                                "sense_id": "27c2da96-8de8-345c-a25a-3b08623d0bf4",
                                "text": "De acceptatie onder tandartsen ligt erg lastig, zegt Gert Stel, kindertandarts en hoofd conserverende tandheelkunde bij het UMC Groningen. 'De meeste tandartsen zijn opgeleid om gaatjes te vullen. Deze methode gaat tegen hun onderbuikgevoel in.'"
                            },
                            {
                                "example_id": "fb572dd8-45cf-400b-adda-3a0ecf78ba9e",
                                "sense_id": "27c2da96-8de8-345c-a25a-3b08623d0bf4",
                                "text": "Mest heeft net als veen een conserverende werking."
                            }
                        ]
                    }
