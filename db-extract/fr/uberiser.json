                "senses": [
                    {
                        "sense_id": "27b059e6-a60f-32c6-8b0a-fecc1c9960dc",
                        "entry_id": "bb80f2c5-f44e-3f4c-b856-dd632e4da9d3",
                        "glosses": [
                            "Modifier un marché ou un domaine en prenant Uber comme exemple."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "5f97aedd-9443-4a0d-b412-40693ed85035",
                                "sense_id": "27b059e6-a60f-32c6-8b0a-fecc1c9960dc",
                                "text": "Si vous ne croyez pas que votre métier puisse être uberisé, vous allez vous faire surprendre par des acteurs qui ne sont pas des historiques de votre métier."
                            }
                        ]
                    },
                    {
                        "sense_id": "d348e851-78e5-317a-bad1-e466e8cf624f",
                        "entry_id": "bb80f2c5-f44e-3f4c-b856-dd632e4da9d3",
                        "glosses": [
                            "Ringardiser, faire disparaître, un concurrent dépassé par l’innovation technologique."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c33918cb-2f9f-47e6-8383-f05dc21c3c11",
                                "sense_id": "d348e851-78e5-317a-bad1-e466e8cf624f",
                                "text": "Tout le monde a peur de se faire uberiser"
                            }
                        ]
                    }
