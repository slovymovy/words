                        "sense_id": "5ea3ce99-f1e7-3a8c-bfca-5dd805dc0fb8",
                        "entry_id": "0eeac88b-880d-3767-9997-7d11f5c2534e",
                        "glosses": [
                            "włoski płaski chleb, doprawiony olejem lub innymi składnikami, pieczony w piekarniku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4299b936-dbdf-430c-aac4-b15afd82c2ed",
                                "sense_id": "5ea3ce99-f1e7-3a8c-bfca-5dd805dc0fb8",
                                "text": "Podstawową różnicą pomiędzy focaccią a konwencjonalną pizzą jest czas wyrastania ciasta"
                            },
                            {
                                "example_id": "2755f06e-1ee3-4691-884f-edfce9440aab",
                                "sense_id": "5ea3ce99-f1e7-3a8c-bfca-5dd805dc0fb8",
                                "text": "Przy plaży dostaliśmy parę kawałków focaccii z ziołami i czarnymi oliwkami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
