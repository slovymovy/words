                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9627ba52-5242-40ed-a0df-f73335e24930",
                                                "sense_id": "03017235-86fd-389e-934e-1fef07486403",
                                                "text": "The hospital was shamefully underequipped."
                                            }
                                        ]
                                    }
                                ]
