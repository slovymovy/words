                "senses": [
                    {
                        "sense_id": "bdddb6d8-9177-3d97-826b-0b48dd09091b",
                        "entry_id": "d73fff85-eee9-3b2d-a543-7c4ef7f0b81d",
                        "glosses": [
                            "aus einem von einer Billiarde gleich großen Teilen bestehend"
                        ],
                        "tags": [
                            "Bruchzahl",
                            "bei Maßeinheiten"
                        ],
                        "examples": [
                            {
                                "example_id": "e6d1a74c-48be-449b-a54e-1b04462e472d",
                                "sense_id": "bdddb6d8-9177-3d97-826b-0b48dd09091b",
                                "text": "Ein Femtometer (fm) ist ein billiardstel Meter."
                            },
                            {
                                "example_id": "c8de1887-0c1c-499b-a80e-4f780557ab05",
                                "sense_id": "bdddb6d8-9177-3d97-826b-0b48dd09091b",
                                "text": "„Die Atomdetektive bearbeiten die Stoffe mit Raster-Elektronenmikroskopen, beschießen sie mit Röntgenstrahlen; so lassen sich Partikelspuren von waffenfähigem Uran bis auf ein billiardstel Gramm nachweisen.“"
                            },
                            {
                                "example_id": "89b443f2-4431-4b92-909b-0786c4899638",
                                "sense_id": "bdddb6d8-9177-3d97-826b-0b48dd09091b",
                                "text": "„Selbst wenn nur noch ein billiardstel Gramm der Substanz im Haar zurückgeblieben ist, lässt sich das aufspüren.“"
                            },
                            {
                                "example_id": "afbe79d3-ec65-4484-bc5a-276fd2f87b6e",
                                "sense_id": "bdddb6d8-9177-3d97-826b-0b48dd09091b",
                                "text": "„Mit einem goldbeschichteten Siliziumblättchen haben Forscher des Oak Ridge National Laboratoriums in Tennessee winzige Massen von wenigen billiardstel Gramm gemessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
