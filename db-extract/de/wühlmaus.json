                ],
                "senses": [
                    {
                        "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                        "entry_id": "767b1538-8d6e-3f60-9075-6a296c13ddc3",
                        "glosses": [
                            "kleines, plumpes, kurzschwänziges Nagetier innerhalb der Unterfamilie der Wühler, mit dickem Kopf, kurzen Ohren und stumpfer Schnauze, das in Europa, Asien und Nordamerika verbreitet ist und unter der Erde Gänge wühlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae61812-0761-49b2-9ef1-f19454e086e8",
                                "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                                "text": "„Wühlmäuse markieren ihr Revier durch Kot und Urin und reagieren echt sauer, wenn eine andere Wühlmaus in die Nähe kommt.“"
                            },
                            {
                                "example_id": "b3f51a38-4e03-4624-95fb-8b7e73d0b8b1",
                                "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                                "text": "„Wenn die Frühlingssonne die Erde vom Frost befreit, machen sich Maulwurf und Wühlmaus bereit.“"
                            },
                            {
                                "example_id": "b01ad8f5-8a1c-4e19-8980-34312056697c",
                                "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                                "text": "„Die Wühlmaus frisst in einer Woche das Sechsfache ihres Körpergewichts, während das Nashorn nur ein Drittel seines Gewichts als Grünfutter aufnimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ff211c4-bae4-33b6-8437-8f3bdcd40d1a",
                        "entry_id": "767b1538-8d6e-3f60-9075-6a296c13ddc3",
                        "glosses": [
                            "artenreiche Unterfamilie der Wühler"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "43dd3fd7-e5ab-47ad-9773-4d62fa9c330a",
                                "sense_id": "6ff211c4-bae4-33b6-8437-8f3bdcd40d1a",
                                "text": "„Unter Gartenfreunden wird sie schlicht Wühlmaus genannt, obwohl die Feldmaus auch zur Familie der Wühlmäuse gehört. Biologisch korrekt heißt sie Ostschermaus (Arvicola terrestris). Sie ist ein Gartenschädling allerersten Ranges.“"
                            },
                            {
                                "example_id": "8e2ea0b6-d607-4a3f-b40e-3d585b7f5adf",
                                "sense_id": "6ff211c4-bae4-33b6-8437-8f3bdcd40d1a",
                                "text": "„Sie [die Bisamratte] gehört nicht zu den Ratten, sondern zu den Wühlmäusen, die aber auch keine Echten Mäuse sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "de5ee417-0401-3d2d-afcd-3803206ccf75",
                        "entry_id": "767b1538-8d6e-3f60-9075-6a296c13ddc3",
                        "glosses": [
                            "Person, die im Verborgenen feindselig handelt"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
