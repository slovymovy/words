                "senses": [
                    {
                        "sense_id": "6a137d95-1337-304f-8421-50c544361476",
                        "entry_id": "9db2fdd2-c8c7-3e16-b1f8-8c18f4112914",
                        "glosses": [
                            "das Gebiet der chinesischen Provinzen Henan, Hubei und Hunan"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "84e64dcb-3852-4928-95be-7dd6c0a14593",
                                "sense_id": "6a137d95-1337-304f-8421-50c544361476",
                                "text": "„Mittelchina zeigt einen merklichen Einschlag von tropischen Elementen, unter denen besonders die reiche Ausbildung von Graphidaceen ins Auge fällt […].“"
                            },
                            {
                                "example_id": "94f5c8e2-6c85-4089-8aab-29d93734c60b",
                                "sense_id": "6a137d95-1337-304f-8421-50c544361476",
                                "text": "„Seit der Wohlstandsgürtel an der Küste aber zunehmend gesättigt scheint und dort auch die Löhne steigen, suchen Autobauer und andere Unternehmen im Westen neue Produktionsstandorte und Märkte - insbesondere in den sogenannten Millionenstädten der \"zweiten Ebene\". Die Volkswagenwerke in Chengdu im Südwesten und Changsha in Mittelchina sind dafür Beispiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
