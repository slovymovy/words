{
    "word_family": [
        "жаловать",
        "жалоба",
        "жалование",
        "жалостливый",
        "жалость"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1897677-42db-36fb-8ba1-3bb0da34c76f",
                    "sense_definition": "Прийти, посетить кого-либо (часто в вежливой или ироничной форме).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кто к нам <w>пожаловал</w> в такой поздний час?",
                            "target_lang_translations": {
                                "cs": "Kdo nás to <w>poctil návštěvou</w> v tak pozdní hodinu?"
                            }
                        },
                        {
                            "text": "Гости <w>пожаловали</w> к нам без предупреждения, но мы были рады.",
                            "target_lang_translations": {
                                "cs": "Hosté se k nám <w>dostavili</w> bez ohlášení, ale měli jsme radost."
                            }
                        }
                    ],
                    "synonyms": [
                        "прийти",
                        "нагрянуть"
                    ],
                    "common_phrases": [
                        "добро пожаловать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в ироничном контексте"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přijít na návštěvu nebo se dostavit někam (často zdvořile nebo ironicky)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dostavit se",
                                "target_lang_sense_clarification": "formální nebo ironické vyjádření příchodu"
                            },
                            {
                                "target_lang_word": "poctít návštěvou",
                                "target_lang_sense_clarification": "často používané v ironickém kontextu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "529de241-b713-3098-8f47-169a0b0a899b",
                    "sense_definition": "Явиться, прибыть куда-либо (устаревшее или высокое выражение).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Господин полковник изволил <w>пожаловать</w> на бал ровно в восемь.",
                            "target_lang_translations": {
                                "cs": "Pan plukovník ráčil <w>se dostavit</w> na ples přesně v osm."
                            }
                        },
                        {
                            "text": "Просим вас <w>пожаловать</w> в наш театр завтра вечером.",
                            "target_lang_translations": {
                                "cs": "Prosíme vás, abyste <w>poctili návštěvou</w> naše divadlo zítra večer."
                            }
                        }
                    ],
                    "synonyms": [
                        "прибыть",
                        "явиться"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее или торжественное"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dostavit se nebo přijet někam (zastaralý nebo slavnostní výraz)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ráčit se dostavit",
                                "target_lang_sense_clarification": "velmi zdvořilé, archaické vyjádření"
                            },
                            {
                                "target_lang_word": "přijít",
                                "target_lang_sense_clarification": "v kontextu pozvání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae041a33-96a5-3896-9f75-ce1d2787b6c8",
                    "sense_definition": "Даровать, наградить чем-либо (высокий стиль).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Царь <w>пожаловал</w> верному слуге новые земли.",
                            "target_lang_translations": {
                                "cs": "Car <w>udělil</w> věrnému sluhovi nové pozemky."
                            }
                        },
                        {
                            "text": "За заслуги перед отечеством его <w>пожаловали</w> высоким чином.",
                            "target_lang_translations": {
                                "cs": "Za zásluhy o vlast byl <w>obdarován</w> vysokou hodností."
                            }
                        }
                    ],
                    "synonyms": [
                        "даровать",
                        "наградить"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "высокий стиль, исторический контекст"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Darovat, udělit nebo obdarovat někoho něčím (vysoký styl)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "udělit",
                                "target_lang_sense_clarification": "udělení titulu nebo vyznamenání"
                            },
                            {
                                "target_lang_word": "obdarovat",
                                "target_lang_sense_clarification": "darovat něco někomu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed5d578d-d22f-38c4-bdae-0a956c2ffd44",
                    "sense_definition": "Наделить кого-то чем-то, оказать милость (устаревшее).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Князь был <w>пожалован</w> деревнями за верную службу.",
                            "target_lang_translations": {
                                "cs": "Kníže byl za věrnou službu <w>obdarován</w> vesnicemi."
                            }
                        },
                        {
                            "text": "Монарх <w>пожаловал</w> ему право на владение домом.",
                            "target_lang_translations": {
                                "cs": "Panovník mu <w>udělil</w> právo vlastnit dům."
                            }
                        }
                    ],
                    "synonyms": [
                        "наделить"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Propůjčit někomu práva nebo prokázat milost (zastaralé)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "propůjčit",
                                "target_lang_sense_clarification": "udělení práva nebo majetku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "749a09ec-3b95-337d-ab1e-91ab054bd291",
                    "sense_definition": "Оказать милость, помиловать или простить (устаревшее).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mercy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Царь <w>пожаловал</w> провинившихся стрельцов и отпустил их.",
                            "target_lang_translations": {
                                "cs": "Car <w>omilostnil</w> provinilé střelce a propustil je."
                            }
                        },
                        {
                            "text": "Смилуйся, государь, <w>пожалуй</w> нас!",
                            "target_lang_translations": {
                                "cs": "Smiluj se, pane, <w>prokaž nám milost</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "помиловать",
                        "простить"
                    ],
                    "antonyms": [
                        "наказать"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Prokázat milost, omilostnit nebo odpustit (zastaralé)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "omilostnit",
                                "target_lang_sense_clarification": "odpustit trest"
                            },
                            {
                                "target_lang_word": "prokázat milost",
                                "target_lang_sense_clarification": "udělit milost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "043b3d62-3702-3f05-bbd1-267c10d1e78f",
                    "sense_definition": "Передать в дар представителю более низкого ранга (устаревшее).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Государь <w>пожаловал</w> ему новый чин.",
                            "target_lang_translations": {
                                "cs": "Panovník mu <w>udělil</w> novou hodnost."
                            }
                        },
                        {
                            "text": "Боярин <w>пожаловал</w> крестьянам зерно из своих запасов.",
                            "target_lang_translations": {
                                "cs": "Bojar <w>daroval</w> rolníkům obilí ze svých zásob."
                            }
                        }
                    ],
                    "synonyms": [
                        "даровать"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Předat dar nebo hodnost podřízenému (zastaralé)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "darovat",
                                "target_lang_sense_clarification": "předat jako dar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9146baf2-96a2-3b0a-99e1-241cd186a521",
                    "sense_definition": "Относиться с благосклонностью, любить (устаревшее).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mercy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не <w>пожаловал</w> своим вниманием никого из присутствующих.",
                            "target_lang_translations": {
                                "cs": "Nikoho z přítomných <w>nepoctil</w> svou pozorností."
                            }
                        },
                        {
                            "text": "Царь <w>пожаловал</w> его своей милостью.",
                            "target_lang_translations": {
                                "cs": "Car ho <w>obdařil</w> svou přízní."
                            }
                        }
                    ],
                    "synonyms": [
                        "благоволить"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Projevovat přízeň nebo náklonnost (zastaralé)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "projevovat přízeň",
                                "target_lang_sense_clarification": "být někomu nakloněn"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}