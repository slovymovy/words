                        "glosses": [
                            "Sorte de fonctionnaire de l'administration coloniale danoise."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "9cac9819-c2f7-4bde-99d9-27fa37beb11c",
                                "sense_id": "0fd77156-090d-351f-a651-54877d1d6ade",
                                "text": "Les cantons sont administrés sous la direction de l'amtmand par des fonctionnaires qu'on nomme sysselmand, et qui sont chargés de publier les actes du gouvernement dans leur ressort, de faire exécuter les mesures prescrites par l'autorité supérieure, et de percevoir les dimes et les impôts."
                            },
                            {
                                "example_id": "51b2d267-974d-429c-873e-9fd643dc6f71",
                                "sense_id": "0fd77156-090d-351f-a651-54877d1d6ade",
                                "text": "[…]; ce doit être un habile homme, à en juger par la multiplicité de ses fonctions : il est sysselmand, titre qui correspond à celui de maire, avec cette différence qu'un sysselmand exerce aussi des fonctions judiciaires; il est en outre maître de poste; il est même sénateur; enfin il est marchand et vend de tout, voire des œufs et du fromage."
                            }
                        ]
                    }
