    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                "word": "obduracy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2f5b989c-5685-40e8-b3d9-53494da0278f",
                        "entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                        "tags": [
                            "plural"
                        ],
                        "form": "obduracies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                        "entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                        "glosses": [
                            "The state of being obdurate, intractable, or stubbornly inflexible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9346fe4e-cc29-4c91-ab33-29a89c47664d",
                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                "text": "By this hand thou, thinkeſt me as farre in the diuels booke, as thou and Falſtaffe, for obduracie and perſiſtancie, let the end trie the man, [...]"
                            },
                            {
                                "example_id": "24cdf459-20f8-4a65-a6bd-3652eece2565",
                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                "text": "It might also serve to condemn the obduracy and hard-heartedness of the Jews, who relented not, when even the earth trembled and the rocks rent."
                            },
                            {
                                "example_id": "c9d9321e-e65c-4242-80c4-0b0ba996c639",
                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                "text": "True mountain Liberty alone may heal\nThe pain which Custom's obduracies bring."
                            },
                            {
                                "example_id": "ba5b085f-ad93-46ff-9474-e482f69594eb",
                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                "text": "She snatched up a stick and hit Cora across the rump with it. The stick was rotten and broke, without having caused Cora to budge an inch. Exasperated at an image of obduracy, the old woman scrabbled up another stick and began whacking at Cora with it[.]"
                            },
                            {
                                "example_id": "67aa3e0a-67ac-4b92-aea4-2e1bcc8e469c",
                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                "text": "Chanderpaul's obduracy might have broken lesser men, but Panesar more than matched him for relentlessness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc28c19f-4c87-4366-ae9e-4a4021d440a8",
                        "source_entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                        "source_sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                        "source_sense_description": "The state of being obdurate, intractable, or stubbornly inflexible",
                        "target_lang_word": "koppigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koppigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "40c9c6c0-1434-318a-b5b4-6c9e344a6d4b",
                                        "entry_id": "167b920c-6031-309a-abd4-02163d31e452",
                                        "glosses": [
                                            "de mate van koppigheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2a31b69-8117-459a-af79-35cd7c4b79ea",
                                                "sense_id": "40c9c6c0-1434-318a-b5b4-6c9e344a6d4b",
                                                "text": "Het meisje deed al die vervelende dingen alleen maar uit koppigheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f015c3-579f-3784-b718-97bf6ff30b4a",
                                        "entry_id": "167b920c-6031-309a-abd4-02163d31e452",
                                        "glosses": [
                                            "zaken die gedaan worden door een koppig iemand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1beb63e0-d234-42e2-a02a-389d74a14a45",
                                                "sense_id": "f9f015c3-579f-3784-b718-97bf6ff30b4a",
                                                "text": "Het veel te laat thuiskomen was een van zijn koppigheden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5b679f2-4aaa-4c02-88a9-fcc2ffb53f0c",
                        "source_entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                        "source_sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                        "source_sense_description": "The state of being obdurate, intractable, or stubbornly inflexible",
                        "target_lang_word": "entêtement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entêtement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                        "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                                        "glosses": [
                                            "Attachement opiniâtre d’une personne à ses opinions, à ses goûts, à ses vues, à ses projets, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a3111a-bf9a-4bfd-8755-dc21fb456da3",
                                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                                "text": "Il était d’un entêtement de brute ; devant une volonté étrangère, nettement formulée, il se serait emporté grossièrement jusqu’à battre les gens."
                                            },
                                            {
                                                "example_id": "be9aa9d9-358d-41d4-8b6e-2d5650f95d57",
                                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                                "text": "Sur le même ton caustique, elle décrivait ses trois mariages soldés par deux divorces et un veuvage, son entêtement obsessionnel pour racheter sa bastide, mais aussi ses souvenirs de jeunesse à l’époque des gemmeurs et de la splendeur des Nogaro."
                                            },
                                            {
                                                "example_id": "08f60b9f-6831-4b0e-bbcb-76c7dc2d9a58",
                                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                                "text": "Une nouvelle trajectoire budgétaire « crédible » doit être présentée en septembre à la Commission européenne, qui a ouvert une procédure de déficit excessif visant la France, l’entêtement des gouvernements macronistes à ne pas augmenter les impôts ayant conduit à un dérapage des finances publiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                        "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                                        "glosses": [
                                            "Engouement pour une personne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5e96f9-af16-4bfc-ae60-791cbc17b22e",
                                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                                "text": "Il a un grand entêtement pour cette femme."
                                            },
                                            {
                                                "example_id": "1f776b7b-cc35-4588-8571-a0f45a1e4fb4",
                                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                                "text": "Rien ne la lasse, elle tient bon ! Je le lui dis, ce n’est pas de l’amour, c’est de l’entêtement."
                                            },
                                            {
                                                "example_id": "72e15f3a-3911-4184-9ce9-0b27e7a48653",
                                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                                "text": "Maintes fois tu m’as blessée en entretenant Juliette ou Abel de ce qui eût dû rester entre toi et moi, et c’est bien là ce qui, longtemps avant que tu t’en doutes, m’a fait penser que ton amour était surtout un amour de tête, un bel entêtement intellectuel de tendresse et de fidélité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "110a2507-69e4-4984-964c-f178cc790fc9",
                        "source_entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                        "source_sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                        "source_sense_description": "The state of being obdurate, intractable, or stubbornly inflexible",
                        "target_lang_word": "obstination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                        "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                                        "glosses": [
                                            "Action de s’obstiner, de s’attacher opiniâtrement à une idée, à un sentiment, à une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972d2eb0-447b-422f-b6d2-0b1f16a0be5c",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Me voilà donc partagé entre travail et amusement, une vie de patachon qui inquiète maman, tandis qu'Alphonse est surtout embarrassé par mon obstination à vouloir embrasser une carrière d'artiste."
                                            },
                                            {
                                                "example_id": "aff67e05-7b30-4dd6-962b-537919578aea",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Bert, avec l’obstination convulsive de l’instinct, s’étaya contre les parois, jusqu’à ce que le ballon piquât du nez."
                                            },
                                            {
                                                "example_id": "5be05d1d-d382-460d-928b-389a81431b76",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Tout vous révèle qu’entre Le Havre et Rouen se poursuit avec obstination la création d’une zone où, inévitablement, le colossal et l’extraordinaire sont en genèse."
                                            },
                                            {
                                                "example_id": "dde59327-a008-4bf0-a59d-4be24a1c2d72",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Il était célèbre par une obstination admirable à apprendre à écrire et à lire ; le résultat ne fut pas étonnant ; il faut croire qu’il est bien difficile d'apprendre à lire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                        "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                                        "glosses": [
                                            "Qualité de celui qui est obstiné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ce6648-3fbc-43f5-a51e-a5aa281e99bd",
                                                "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                                "text": "Il lui a fallu beaucoup d’obstination pour réussir dans son examen."
                                            },
                                            {
                                                "example_id": "e78b43aa-b59a-4477-afdd-a974f29de28b",
                                                "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                                "text": "Obstination au travail, à l’étude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "584069cc-1b91-48d4-ba8d-1d49b9986851",
                        "source_entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                        "source_sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                        "source_sense_description": "The state of being obdurate, intractable, or stubbornly inflexible",
                        "target_lang_word": "Verstocktheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstocktheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf9aa78-887a-3c9f-944c-40da33c838f0",
                                        "entry_id": "cba059de-78c5-3179-9b6a-c78c3a966e4b",
                                        "glosses": [
                                            "besonders starke Uneinsichtigkeit"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dd0e3b5-1ae9-4188-a4ad-bb30f869633b",
                                                "sense_id": "bcf9aa78-887a-3c9f-944c-40da33c838f0",
                                                "text": "Hans vermutet hinter Arnes Verstocktheit ein tiefes Geheimnis."
                                            },
                                            {
                                                "example_id": "3e5b37bf-efa6-481e-b885-d194ea443260",
                                                "sense_id": "bcf9aa78-887a-3c9f-944c-40da33c838f0",
                                                "text": "„Ihm wurde rasch klar, dass aus Not und Elend kein geistiger Aufbruch entstehen konnte, und dass nicht Verstocktheit die Deutschen hemmte, sich mit ihrer Vergangenheit zu beschäftigen, sondern die auslaugende Anstrengung des schieren Überlebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2f09d99-11c8-42a9-b4e8-d5fd492dde20",
