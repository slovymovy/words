            "senses": [
                {
                    "sense_id": "33e2eafa-1e29-346e-969d-9ceb776f6384",
                    "sense_definition": "a gully or a deep channel in a moor or hillside; a variant spelling of <w>grough</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to navigate through deep <w>gruffs</w> in the peaty moorland.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось пробираться через глубокие <w>размывы</w> в торфянистой местности.",
                                "cs": "Turisté museli procházet hlubokými <w>roklemi</w> v rašeliništích."
                            }
                        },
                        {
                            "text": "Sheep often find shelter from the wind inside a narrow <w>gruff</w> on the hillside.",
                            "target_lang_translations": {
                                "ru": "Овцы часто находят укрытие от ветра в узком <w>овраге</w> на склоне холма.",
                                "cs": "Ovce často nacházejí úkryt před větrem v úzké <w>vymleté strouze</w> na svahu kopce."
                            }
                        }
                    ],
                    "synonyms": [
                        "gully",
                        "channel",
                        "ravine"
                    ],
                    "common_phrases": [
                        "peaty gruffs"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern England"
                        },
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of grough"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "овраг или глубокий канал в болотистой местности или на склоне холма",
