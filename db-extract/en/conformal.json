{
    "word": "conformal",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                "word": "conformal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2f75fcdd-d2d6-45ad-84da-29698d5b424b",
                        "entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more conformal"
                    },
                    {
                        "form_id": "22503ee6-59d3-4d90-ac11-f39edca62865",
                        "entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most conformal"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81b4aabf-e3a1-390a-9040-11f0041b72f5",
                        "entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                        "glosses": [
                            "That conforms, especially to the shape of something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54a5c8af-0bde-4582-8de0-0bc9ce082213",
                                "sense_id": "81b4aabf-e3a1-390a-9040-11f0041b72f5",
                                "text": "Some are realizable in practical computational times; others giving ‘more conformal’ 3D dose distributions take longer and some invoke technology which is not readily available, such as intensity-modulated fields."
                            },
                            {
                                "example_id": "b32b3373-90db-40c6-bf82-2953ab9159ed",
                                "sense_id": "81b4aabf-e3a1-390a-9040-11f0041b72f5",
                                "text": "CVD^([Chemical Vapor Deposition]) is generally more conformal than physical vapor deposition, meaning that it covers a rough surface relatively uniformly, tracking the morphology rather than resulting in thin, low-quality coatings on vertical walls of the substrate, as is the case for physical vapor deposition methods."
                            },
                            {
                                "example_id": "f4eb5c58-ac99-477e-ac67-e4029f639f34",
                                "sense_id": "81b4aabf-e3a1-390a-9040-11f0041b72f5",
                                "text": "One method for delivering high doses of radiation to a small area is by using more conformal types of radiotherapy."
                            }
                        ]
                    },
                    {
                        "sense_id": "96e8ab41-3da7-3dff-a16e-cf1f80ec17a0",
                        "entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                        "glosses": [
                            "That preserves angles between intersecting curves."
                        ],
                        "tags": [
                            "of a transformation"
                        ],
                        "examples": [
                            {
                                "example_id": "cced0877-4ba5-4749-90ad-c52718d83764",
                                "sense_id": "96e8ab41-3da7-3dff-a16e-cf1f80ec17a0",
                                "text": "1991 [Elsevier Science], Roland Schinzinger, Patricio A. A. Laura, Conformal Mapping: Methods and Applications, 2003, Dover, page 508,\nThis would have been tantamount to a conformal transformation."
                            },
                            {
                                "example_id": "b9976fcd-6736-4b77-8988-3c5e86183eab",
                                "sense_id": "96e8ab41-3da7-3dff-a16e-cf1f80ec17a0",
                                "text": "Let us find all conformal transformations in d dimensions."
                            },
                            {
                                "example_id": "d298db4d-ccf4-4177-9bc9-d18bb1cbc371",
                                "sense_id": "96e8ab41-3da7-3dff-a16e-cf1f80ec17a0",
                                "text": "In regions of S where the packings become more deeply embedded in purely hexagonal generations during refinement, the local dilatation approaches 1 and the maps become progressively more conformal."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb3e94f0-2be5-39f8-8c8c-516bbc44ba1c",
                        "entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                        "glosses": [
                            "That preserves relative angles over small scales, at all but a limited number of distinct points."
                        ],
                        "tags": [
                            "of a map projection"
                        ],
                        "examples": [
                            {
                                "example_id": "81b24bd6-6a8d-4f1e-8a8e-5c244f4d7f33",
                                "sense_id": "eb3e94f0-2be5-39f8-8c8c-516bbc44ba1c",
                                "text": "On conformal map projections, the scale depends on location only and not direction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf06c22c-15d2-4543-96f1-97e4d0345357",
                        "source_entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                        "source_sense_description": "that conforms (to a shape or form)",
                        "target_lang_word": "konform",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konform",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a95f3da8-dc14-33fd-b252-f5b3ed039a1f",
                                        "entry_id": "d5256023-a0f0-38cb-875a-3c7aee68f615",
                                        "glosses": [
                                            "übereinstimmend, einiggehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf159eb-9d42-46c9-9df2-d2e5187cfdde",
                                                "sense_id": "a95f3da8-dc14-33fd-b252-f5b3ed039a1f",
                                                "text": "Beide Seiten nutzen diese Situation zu ihren Gunsten aus: der Kaiser, um Maßnahmen durchzusetzen, die nicht unbedingt konform mit der Reichsverfassung gingen; daraufhin würden die Protestanten Frankreich als wortbrüchig anklagen, weil sie dem Kaiser dabei assistieren, zugleich aber ihren Willen am Erhalt des Reiches betonen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e54b0347-a48b-40cf-8fef-130a5df00090",
                        "source_entry_id": "f64eb0b3-4813-34ad-bba5-523267d95069",
                        "source_sense_description": "mathematics: that preserves angles unchanged",
                        "target_lang_word": "conforme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conforme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                        "entry_id": "b7db1741-c735-3d57-ae17-4bb5d71060cc",
                                        "glosses": [
                                            "Qui a la même forme ; qui est semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000da24a-26c0-4103-9186-4e4d991d4646",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "Les théoriciens de la version alternative […] échafaudent des hypothèses conformes à leurs convictions sans apporter de preuves indiscutables."
                                            },
                                            {
                                                "example_id": "7433d2ec-12c5-4238-9019-f44a895286d0",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "La copie est conforme à l’original."
                                            },
                                            {
                                                "example_id": "5ea9a414-3d13-44c5-b4b1-bdeeea6a153a",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "Ces écritures sont conformes."
                                            },
                                            {
                                                "example_id": "b7705fb7-a503-4043-bab4-4bbf5032ffd8",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "Son humeur est conforme à la vôtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                        "entry_id": "b7db1741-c735-3d57-ae17-4bb5d71060cc",
                                        "glosses": [
                                            "Convenable, qui s’accorde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fe7f23-e353-41a9-a03b-37dec43fb2c4",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Mener une vie conforme à sa profession."
                                            },
                                            {
                                                "example_id": "78c54556-54db-47dd-a457-af4b23da3c7a",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Avoir des sentiments conformes à sa naissance."
                                            },
                                            {
                                                "example_id": "57386f30-9398-4365-a86c-9f618e5b383d",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Cela est parfaitement conforme à ses vues."
                                            },
                                            {
                                                "example_id": "8552951c-efea-4a0e-8558-5b5b5fb207a1",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Ses mœurs ne sont pas conformes à sa doctrine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71e09b68-3d0b-3a11-b002-8d694d2221e2",
                                        "entry_id": "b7db1741-c735-3d57-ae17-4bb5d71060cc",
                                        "glosses": [
                                            "Qui correspond à un standard, à une norme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adc5b3d5-0526-4d95-8557-134d69f437c9",
                                                "sense_id": "71e09b68-3d0b-3a11-b002-8d694d2221e2",
                                                "text": "Chargée d’une mission inédite, la CIIVISE a adopté une organisation conforme aux standards institutionnels du genre avec des ajustements résultant du caractère inédit de sa mission."
                                            },
                                            {
                                                "example_id": "996aab51-d266-42bd-afbb-c54ab7db3b0d",
                                                "sense_id": "71e09b68-3d0b-3a11-b002-8d694d2221e2",
                                                "text": "Un bouton d’arrêt d’urgence conforme aux standards de sécurité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conforme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b676c12e-a8fe-37ed-ad54-1e6497dab400",
