                            {
                                "target_lang_word": "mrzutý",
                                "target_lang_sense_clarification": "o vystupování"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55221845-23bf-3eca-8488-7310ed11683c",
                    "sense_definition": "referring to goods or cargo that are bulky or coarse in nature",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship was loaded with <w>gruff</w> cargoes of raw materials and heavy timber.",
                            "target_lang_translations": {
                                "ru": "Корабль был загружен <w>грубыми</w> грузами сырья и тяжелой древесины.",
                                "cs": "Loď byla naložena <w>hrubým</w> nákladem surovin a těžkého dřeva."
                            }
                        },
                        {
                            "text": "Merchants often traded <w>gruff</w> goods like rice and salt alongside finer silks.",
                            "target_lang_translations": {
                                "ru": "Купцы часто торговали <w>необработанными</w> товарами, такими как рис и соль, наряду с изысканным шелком.",
                                "cs": "Obchodníci často prodávali <w>nezpracované</w> zboží, jako je rýže a sůl, vedle jemnějšího hedvábí."
                            }
                        }
                    ],
                    "synonyms": [
