                ],
                "senses": [
                    {
                        "sense_id": "5cf04dba-a4bc-34c5-88bf-63588db51abf",
                        "entry_id": "b1d311c9-cd48-3e13-bda2-8c6b19fac7fb",
                        "glosses": [
                            "Brigadier; Anrede vom SS-Brigadeführer und SA-Brigadeführer"
                        ],
                        "tags": [
                            "Heer",
                            "Luftwaffe",
                            "Schutzstaffel",
                            "Sturmabteilung"
                        ],
                        "examples": [
                            {
                                "example_id": "18d90a7e-160b-4ca6-8324-c3e62fe701f1",
                                "sense_id": "5cf04dba-a4bc-34c5-88bf-63588db51abf",
                                "text": "„Aber dass die FPÖ in Sachen NS-Vergangenheit jede wirklich klare und deutliche Abgrenzung vermeidet, ja dass sie dies angesichts ihrer Gründungsgeschichte vermeiden muss – das hat nichts mehr mit Europapolitik zu tun, sondern betrifft die Substanz einer politischen Gruppierung, die in ihren ersten Jahren von dem SS-Mann Anton Reinthaller (Ehrenrang: Brigadeführer) geführt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d9318948-42cf-30ba-8b22-9f20ad491e48",
                        "entry_id": "b1d311c9-cd48-3e13-bda2-8c6b19fac7fb",
                        "glosses": [
                            "General im Range eines SS-Brigadeführers oder SA-Brigadeführers"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "466ff611-81f1-437e-96c9-834d54c6a9c6",
                                "sense_id": "d9318948-42cf-30ba-8b22-9f20ad491e48",
                                "text": "„Während Himmlers Masseur in Stockholm mit dem amerikanischen Sonderbeauftragten Hewitt an den Bedingungen einer keineswegs bedingungslosen Einstellung der Kriegshandlungen bosselt, bereitet sein Brigadeführer Schellenberg eine Luftlandeoperation à la Skorzeny in Iran vor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "126079b7-4233-3b75-a553-148bd2da54fb",
                        "entry_id": "b1d311c9-cd48-3e13-bda2-8c6b19fac7fb",
                        "glosses": [
                            "Führer einer Brigade aus Arbeitern"
                        ],
                        "tags": [
                            "Deutsche Demokratische Republik"
                        ],
                        "examples": [
                            {
                                "example_id": "f0b1c89c-6a18-4c2b-b8ec-74a8839188d1",
                                "sense_id": "126079b7-4233-3b75-a553-148bd2da54fb",
                                "text": "„Vater Otto, überzeugter Sozialist und Brigadeführer auf der Großbaustelle Stalinallee, verteufelt die Flucht in den Kapitalismus.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
