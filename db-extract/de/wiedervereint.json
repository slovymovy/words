                ],
                "senses": [
                    {
                        "sense_id": "d5b91894-2894-3755-841f-52c5db7ab45b",
                        "entry_id": "6b704b35-13e9-3bfc-a348-14468761a9ab",
                        "glosses": [
                            "nach einer Zeit der Trennung erneut zusammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5963b943-50e6-4c3c-ace5-84ba472ee84e",
                                "sense_id": "d5b91894-2894-3755-841f-52c5db7ab45b",
                                "text": "[Richard von Weizsäcker:] „In seiner zweiten Amtszeit wurde er 1990 das erste Staatsoberhaupt des wiedervereinten Deutschlands.“"
                            },
                            {
                                "example_id": "0d9ae446-68c2-417e-b054-aecc0372af61",
                                "sense_id": "d5b91894-2894-3755-841f-52c5db7ab45b",
                                "text": "[Stasi-Akten:] „Dafür wurde im wiedervereinten Deutschland extra ein neues Amt geschaffen.“"
                            },
                            {
                                "example_id": "f8b710f5-b011-4a0f-b1df-fbe9e88ca160",
                                "sense_id": "d5b91894-2894-3755-841f-52c5db7ab45b",
                                "text": "„Viele Menschen sprechen heute, nach mehr als 30 Jahren, in einer wiedervereinten Stadt und in unserem wiedervereinten Land, von einer „Mauer in den Köpfen“ der Ost- und Westdeutschen: Eine unsichtbare Mauer trenne die Menschen bis heute.“"
                            },
                            {
                                "example_id": "e4a329d0-d31f-4943-b9b9-6051402bd3bc",
                                "sense_id": "d5b91894-2894-3755-841f-52c5db7ab45b",
                                "text": "Das wiedervereinte Vietnam trägt seit dem 2. Juli 1976 den offiziellen Namen: Sozialistische Republik Vietnam."
                            },
                            {
                                "example_id": "0d4abc37-dec7-4dc4-bb01-13b687a12cb7",
                                "sense_id": "d5b91894-2894-3755-841f-52c5db7ab45b",
                                "text": "„Famagusta einschließlich der Geisterstadt Varosha soll zu einer Modellstadt für ein künftig wiedervereintes Zypern werden, zu einem Ort des Austausches und der Kooperation.“"
                            },
                            {
