                                            {
                                                "example_id": "eee8d8f3-3bee-42d3-8827-3ff4f8a3767f",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "My cousin is an expert pianist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Characteristic of an expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4400dc18-9d2f-4229-8859-303d3ebe0aeb",
                                                "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                                "text": "This problem requires expert knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9aa305-7602-3c0a-82df-44e4726b49c1",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
