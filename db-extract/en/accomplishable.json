                        "entry_id": "f038ed7d-7ad4-33ba-adf8-8d7955d3c80a",
                        "glosses": [
                            "Capable of being accomplished; practicable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f7a8a4-e4a4-4397-9260-9a2ceb345490",
                                "sense_id": "279c5dcc-ba19-3688-b72c-9c6ab7f0db40",
                                "text": "With proper planning, even the most difficult task can be accomplishable."
                            },
                            {
                                "example_id": "269bee22-4a91-47c4-9825-0132e88129ad",
                                "sense_id": "279c5dcc-ba19-3688-b72c-9c6ab7f0db40",
                                "text": "The project seemed barely accomplishable within the given deadline."
                            },
                            {
                                "example_id": "6c144424-4eae-4a4c-af5c-05c09f422e55",
                                "sense_id": "279c5dcc-ba19-3688-b72c-9c6ab7f0db40",
                                "text": "They set accomplishable goals to keep the team motivated and focused."
                            },
                            {
                                "example_id": "6829b5b8-370a-4878-a14d-bd6ec19a5d8e",
                                "sense_id": "279c5dcc-ba19-3688-b72c-9c6ab7f0db40",
                                "text": "Climbing the mountain was only accomplishable with expert guidance."
                            },
                            {
                                "example_id": "685fd97a-1855-4fee-afc3-65edd80f65e8",
                                "sense_id": "279c5dcc-ba19-3688-b72c-9c6ab7f0db40",
                                "text": "Breaking the work into smaller steps made it more accomplishable."
                            }
                        ]
                    }
