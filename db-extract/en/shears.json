                "senses": [
                    {
                        "sense_id": "a314e3da-035f-3f29-8ba1-d8ee153b1739",
                        "entry_id": "d9218efb-a121-3a81-9fb8-244d08d9060c",
                        "glosses": [
                            "A tool consisting of two blades with bevel edges, connected by a pivot, used for cutting cloth, or for removing the fleece from sheep etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a11efa1-b541-4b38-9c29-944bb8e30b53",
                                "sense_id": "a314e3da-035f-3f29-8ba1-d8ee153b1739",
                                "text": "Cut with a shears using long, even strokes."
                            },
                            {
                                "example_id": "add40d78-33f2-4955-be7d-b28f9f466918",
                                "sense_id": "a314e3da-035f-3f29-8ba1-d8ee153b1739",
                                "text": "Near-synonym: scissors"
                            }
                        ]
                    },
                    {
