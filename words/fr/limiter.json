            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95e7ec54-1e14-3a59-9ac2-0fa6b6040b32",
                    "sense_definition": "Restreindre quelque chose dans certaines bornes de quantité, de nombre, de prix ou de durée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour faire des économies ce mois-ci, nous devons <w>limiter</w> les dépenses non essentielles."
                        },
                        {
                            "text": "La nouvelle loi cherche à <w>limiter</w> la vitesse des automobilistes en centre-ville."
                        }
                    ],
                    "synonyms": [
                        "restreindre"
                    ],
                    "common_phrases": [
                        "limiter les dépenses",
                        "limiter la vitesse"
                    ]
                },
                {
                    "sense_id": "47dd2ca5-8679-3e0f-8358-cea424e42a91",
                    "sense_definition": "Se fixer des bornes, s'en tenir à un cadre précis sans aller au-delà.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'exposé, vous devez vous <w>limiter</w> au sujet principal sans trop vous disperser."
                        },
                        {
                            "text": "Il préfère se <w>limiter</w> à une tasse de café par jour pour mieux dormir la nuit."
                        }
                    ],
                    "common_phrases": [
                        "se limiter à"
                    ]
                },
                {
                    "sense_id": "fa5275f6-f38b-347b-be2a-3f2d8fa67d9d",
                    "sense_definition": "Former la frontière d'un lieu ou marquer la séparation physique d'un terrain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frontiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une haute haie de buissons <w>limite</w> le jardin du côté de la route."
                        },
                        {
                            "text": "Le cours du fleuve vient <w>limiter</w> naturellement le territoire de la commune au sud."
                        }
                    ],
                    "synonyms": [
                        "délimiter"
                    ]
                }
            ]
        }
