                "senses": [
                    {
                        "sense_id": "6329a317-ee2b-32d9-adcf-5bafd867f2f5",
                        "entry_id": "d74d36d9-5449-3605-94b6-eed4881368e7",
                        "glosses": [
                            "de gangbare benaming voor het tekstboekje van een opera, operette, ballet of musical"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732768c4-9dcb-413d-bf8f-9f194175a73b",
                                "sense_id": "6329a317-ee2b-32d9-adcf-5bafd867f2f5",
                                "text": "De Britse auteur David Mitchell, schrijver van talloze internationale bestsellers, schrijft het libretto voor 'Wake', de opera die op 13 mei 2010, tien jaar na de Vuurwerkramp in Enschede, in première gaat."
                            },
                            {
                                "example_id": "1f39918a-083e-44d3-a261-cce5369601e0",
                                "sense_id": "6329a317-ee2b-32d9-adcf-5bafd867f2f5",
                                "text": "Dan het verhaal. Tobi is een door het regime geknakte kunstenaar. Zijn dichtende zus Isa is dankzij Tobi’s activiteiten ook verdacht. Een serie statische scènes moet hun strijd en lijden uitlichten, maar het libretto laveert tussen vaagheden en gemeenplaatsen. ‘Is het verstandig om bang te zijn?’ Zonder navoelbaar gevaar blijft zo’n vraag steken in retoriek."
                            }
                        ]
                    }
                ],
