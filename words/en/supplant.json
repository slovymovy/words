{
    "word_family": [
        "supplanter",
        "supplantation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "077077c7-c47e-39d4-9b21-e3235a83eb5a",
                    "sense_definition": "To take the place of, especially to supersede another, often by force, scheming, or technological advancement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "replace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people wonder if digital books will completely <w>supplant</w> traditional paper books in the future.",
                            "target_lang_translations": {
                                "ru": "Многие люди задаются вопросом, смогут ли цифровые книги в будущем полностью <w>вытеснить</w> традиционные бумажные книги."
                            }
                        },
                        {
                            "text": "The new technology threatens to <w>supplant</w> older methods of manufacturing within the next decade.",
                            "target_lang_translations": {
                                "ru": "Новая технология угрожает <w>заменить</w> старые методы производства в течение следующего десятилетия."
                            }
                        }
                    ],
                    "synonyms": [
                        "replace",
                        "supersede",
                        "oust",
                        "take over from"
                    ],
                    "common_phrases": [
                        "threatens to supplant",
                        "completely supplant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять место другого, особенно вытеснить или заменить кого-то или что-то, часто силой, интригами или в результате технологического прогресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытеснять",
                                "target_lang_sense_clarification": "заменять собой, делая менее употребительным"
                            },
                            {
                                "target_lang_word": "заменять",
                                "target_lang_sense_clarification": "становиться на место другого"
                            },
                            {
                                "target_lang_word": "выживать",
                                "target_lang_sense_clarification": "вынуждать покинуть место или должность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de9c4874-41d8-39f4-b85c-2a6406fb779f",
                    "sense_definition": "To uproot or remove violently.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "remove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violent storm managed to <w>supplant</w> several ancient trees from the town square.",
                            "target_lang_translations": {
                                "ru": "Сильному шторму удалось <w>вырвать с корнем</w> несколько вековых деревьев на городской площади."
                            }
                        },
                        {
                            "text": "In his anger, he threatened to <w>supplant</w> his opponent's teeth with a single blow.",
                            "target_lang_translations": {
                                "ru": "В гневе он пригрозил одним ударом <w>выбить</w> зубы своему противнику."
                            }
                        }
                    ],
                    "synonyms": [
                        "uproot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of physical uprooting or violent removal is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вырвать с корнем или насильственно удалить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искоренять",
                                "target_lang_sense_clarification": "вырывать с корнем, полностью уничтожать"
                            },
                            {
                                "target_lang_word": "вырывать",
                                "target_lang_sense_clarification": "насильственно извлекать с корнем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}