                ],
                "senses": [
                    {
                        "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                        "entry_id": "4981edc6-895e-3fb6-a4eb-4de7b58a41d4",
                        "glosses": [
                            "pakistanischer Geheimdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb03ddc4-7e86-4471-ae5b-20a20f328be2",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„In dieser Periode war er bekannt für seine engen Beziehungen zum Militär und dem pakistanischen Geheimdienst ISI.“"
                            },
                            {
                                "example_id": "50cbdd03-5074-4b1b-b26b-1fd48ceba2ec",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„Er fliegt von Paris nach Islamabad. Dort geht er erst einmal zum ISI; in dessen Reihen, nehmen wir an, hat er einen Maulwurf der al-Qaida, der seine Auftraggeber umgehend vom Auftauchen unseres lebendigen Harry informiert.“"
                            },
                            {
                                "example_id": "ce4d6aac-e899-4dca-abd8-fdda21648fb4",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„Anfang der achtziger Jahre schuf der ISI aus über achtzig Widerstandsgruppen sieben Parteien, die sogenannten Peschawar-Parteien, und festigte deren Stellung als politische Aushängeschilder des afghanischen Widerstands durch massive finanzielle Zuwendungen.“"
                            },
                            {
                                "example_id": "173c528a-7a94-4a30-afd3-8d3c65bd209b",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„'Der ISI soll mal ein Wörtchen mit ihm reden.'“"
                            },
                            {
                                "example_id": "fe44120b-66c6-44a6-b68d-5754be518ca6",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„Wir wurden zur Kooperation mit dem ISI gezwungen und zu dem Zeitpunkt, als wir das Gelände erreichten, waren die Taliban bereits mit unseren Männern in der Stadt untergetaucht.“"
                            },
                            {
                                "example_id": "f7b911fb-d4a0-4ea5-8d1b-c0fd97f460b4",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„Obwohl das Gebäude durch nichts als Hauptquartier des ISI - des Inter Services Intelligence - gekennzeichnet war, wusste so gut wie jeder, worum es sich bei dem Haus handelte.“"
                            },
                            {
                                "example_id": "399ff783-5d73-4897-9e20-e967b8667a5e",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„Bezeichnenderweise war Maulana Rehman jetzt ein politischer Verbündeter von Premierministerin Benazir Bhutto und hatte freien Zugang zur Regierung, zur Armee und zum Geheimdienst (ISI) Pakistans, dem er die neu in Erscheinung getretene Macht der Taliban vorstellte.“"
                            },
                            {
                                "example_id": "33d5dce6-52ab-4230-87f8-694c0e59f35f",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„Der ISI und die Generale bereichern sich an diesem Handel und kaufen Waffen und Mudjaheddin ein.“"
                            },
                            {
                                "example_id": "3fae23b1-660a-443f-8457-7b9b1d2ab0b2",
                                "sense_id": "7f45c0a0-06b7-3795-9374-210d150aab1d",
                                "text": "„Der berüchtigte pakistanische Geheimdienst ISI hatte seine persönlichen Daten eifersüchtig gehütet, um zu verhindern, dass Leute wie ich seinen brillanten Schüler ins Visier nahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
