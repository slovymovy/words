                    {
                        "sense_id": "400aff49-ae67-3b41-bfe0-575e211e9fb6",
                        "entry_id": "3864ce57-0adb-34f9-8500-4d075e356360",
                        "glosses": [
                            "aus gemahlenen Maiskörnern hergestelltes Mehl"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "8acf8fe2-07b6-4c29-a37b-3cd2af52c361",
                                "sense_id": "400aff49-ae67-3b41-bfe0-575e211e9fb6",
                                "text": "„Die NGO hat bereits in Bamako zwei Tonnen Maismehl gekauft.“"
                            },
                            {
                                "example_id": "a88cc894-0247-4b3e-a1dd-142a3435511a",
                                "sense_id": "400aff49-ae67-3b41-bfe0-575e211e9fb6",
                                "text": "„Die Indianer versorgten ihre Gäste mit auf Handmühlen geriebenem Maismehl, Wildbret, Buffalofleisch und Geflügel, wofür die Seeräuber ihnen Feuergewehre, Kleidungsstücke und selbst Luxusartikel brachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
