    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "579cf284-c4cd-356d-bae3-d17f5ae35d33",
                    "sense_definition": "Het jong van een uil.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de holle boom zat een klein <w>uilskuiken</w> te wachten op zijn ouders.",
                            "target_lang_translations": {
                                "de": "Im hohlen Baum saß ein kleines <w>Eulenküken</w> und wartete auf seine Eltern."
                            }
                        },
                        {
                            "text": "De boswachter maakte een foto van het jonge <w>uilskuiken</w> in het nest.",
                            "target_lang_translations": {
                                "de": "Der Förster machte ein Foto von dem jungen <w>Eulenküken</w> im Nest."
                            }
                        }
                    ],
                    "synonyms": [
                        "uilenjong"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Junge einer Eule."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Eulenküken",
                                "target_lang_sense_clarification": "Jungvogel einer Eule"
                            },
                            {
                                "target_lang_word": "Eulenjunge",
                                "target_lang_sense_clarification": "junges Tier einer Eule"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81205c55-39d1-3239-95f6-7ab97bec7ca9",
                    "sense_definition": "Iemand die domme fouten maakt of niet erg slim overkomt.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dom_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat ben ik toch ook een <w>uilskuiken</w> dat ik mijn sleutels weer ben vergeten!",
                            "target_lang_translations": {
                                "de": "Was bin ich doch für ein <w>Dummkopf</w>, dass ich meine Schlüssel schon wieder vergessen habe!"
                            }
                        },
                        {
                            "text": "Hij gedroeg zich als een <w>uilskuiken</w> door zonder jas de kou in te lopen.",
                            "target_lang_translations": {
                                "de": "Er verhielt sich wie ein <w>Trottel</w>, indem er ohne Jacke in die Kälte hinausging."
                            }
                        }
                    ],
                    "synonyms": [
                        "domoor",
                        "domkop",
                        "oen",
                        "sukkel",
                        "oelewapper"
                    ],
                    "common_phrases": [
                        "een groot uilskuiken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a mild, often playful insult."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die dumme Fehler macht oder sich unklug verhält; Dummkopf."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dummkopf",
                                "target_lang_sense_clarification": "Person, die unklug handelt"
                            },
                            {
                                "target_lang_word": "Trottel",
                                "target_lang_sense_clarification": "ungeschickte oder törichte Person"
                            },
                            {
                                "target_lang_word": "Einfaltspinsel",
                                "target_lang_sense_clarification": "leichtgläubige oder naive Person"
                            },
                            {
                                "target_lang_word": "Schafskopf",
                                "target_lang_sense_clarification": "umgangssprachlich für eine dumme Person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
