                "senses": [
                    {
                        "sense_id": "0cf09934-4d09-339e-a055-1eba3c2346cc",
                        "entry_id": "2903fda6-38e2-3ee7-bb7e-182fec3a5fd9",
                        "glosses": [
                            "River à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbddfd8b-fd3a-4ae7-9080-250246ebed03",
                                "sense_id": "0cf09934-4d09-339e-a055-1eba3c2346cc",
                                "text": "Dériver l'ancienne chaine, dériver la nouvelle, reriver la nouvelle sur l'ancienne, tirer, dériver les 2 chaines, reriver la nouvelle sur elle-même."
                            },
                            {
                                "example_id": "14886c49-fd15-4ae4-b3f9-079f5200d4fd",
                                "sense_id": "0cf09934-4d09-339e-a055-1eba3c2346cc",
                                "text": "Dériver, insérer un nouveau crochet et reriver."
                            },
                            {
                                "example_id": "6f8f4573-8d98-4e73-a398-8bc94b3d9764",
                                "sense_id": "0cf09934-4d09-339e-a055-1eba3c2346cc",
                                "text": "Normalement tu dois le reriver avec un rivet ampoule, le plus simple est de monter une attache rapide sram."
                            },
                            {
                                "example_id": "a4f6d3b7-5757-458f-a4f9-e1c8f1ea6ac5",
                                "sense_id": "0cf09934-4d09-339e-a055-1eba3c2346cc",
                                "text": "Et demain, je vais me lever, je vais aller prendre un choco cho au soleil et je vais me reriver les yeux sur le PC toute la sainte journée."
                            }
                        ]
                    }
