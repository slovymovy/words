                                        "examples": [
                                            {
                                                "example_id": "f9928722-d82f-4b40-8021-6ec282c89cb5",
                                                "sense_id": "89863f25-ee1e-3d78-b2cc-9004c244a288",
                                                "text": "Dein neuer Verlobter ist aber ein feiner Pinkel."
                                            },
                                            {
                                                "example_id": "2f1003af-30f8-4e78-b88d-cd5a7d50baac",
                                                "sense_id": "89863f25-ee1e-3d78-b2cc-9004c244a288",
                                                "text": "„Das war ein feiner Pinkel, der beim Aufzeigen immer mit den Fingern schnippte.“"
                                            },
                                            {
                                                "example_id": "7b84b792-aced-4916-bc88-07f8c165ddf4",
                                                "sense_id": "89863f25-ee1e-3d78-b2cc-9004c244a288",
                                                "text": "„An ihrer Stelle, neben Schlump, setzte sich ein feiner Pinkel hin, mit hohem Kragen und flottem Mundwerk.“"
                                            },
                                            {
                                                "example_id": "79513e90-b3a9-4950-bfa8-3d88f1d9b5f1",
                                                "sense_id": "89863f25-ee1e-3d78-b2cc-9004c244a288",
                                                "text": "„Man bekommt mehr Subventionen und bessere Kredite, gilt als feinerer Pinkel und braucht im Herbst nicht seine Freunde zu schlachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pinkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb6bb1e-4d2e-3dca-a2df-75781ea409b9",
                                        "entry_id": "c7c7fa6b-439d-3cb7-b4a0-37bb1aec342f",
                                        "glosses": [
                                            "geräucherte Kohlwurst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb021332-d291-4528-b761-d4e0d5b0c445",
                                                "sense_id": "2eb6bb1e-4d2e-3dca-a2df-75781ea409b9",
                                                "text": "Als Tagesgericht servieren wir Grünkohl und Pinkel."
                                            }
