        "fr-extract.jsonl": [
            {
                "entry_id": "7ada3445-01ca-30de-a195-ddc00113e331",
                "word": "lorgnon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "55e57d5c-2f48-4c26-9c23-4e18e4499543",
                        "entry_id": "7ada3445-01ca-30de-a195-ddc00113e331",
                        "tags": [
                            "plural"
                        ],
                        "form": "lorgnons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98d7a7c0-d0c6-3a56-8e15-c40cb60f32da",
                        "entry_id": "7ada3445-01ca-30de-a195-ddc00113e331",
                        "glosses": [
                            "Monocle à monture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf0577b-d985-46cd-a15f-ab2f51f4a2cb",
                                "sense_id": "98d7a7c0-d0c6-3a56-8e15-c40cb60f32da",
                                "text": "Ils discutèrent pendant dix bonnes minutes en s’appuyant de nombreux exemples, de comparaisons, tout en tournant autour de moi, la tête penchée, le lorgnon fiché dans l’œil."
                            },
                            {
                                "example_id": "1cc6c561-fef3-4559-9870-d0483938b652",
                                "sense_id": "98d7a7c0-d0c6-3a56-8e15-c40cb60f32da",
                                "text": "Elle n’intéressait pas seulement, avec les entrepreneurs, ces pauvres « buvetiers et cantiniers », mais une foule d’élégants jeunes hommes au menton haut sur cravate, gantés trop juste, lorgnon à l’œil et stick en main."
                            }
                        ]
                    },
                    {
                        "sense_id": "451698bd-d94e-30a7-b7da-3e3b6e62d7f7",
                        "entry_id": "7ada3445-01ca-30de-a195-ddc00113e331",
                        "glosses": [
                            "Paire de lunettes sans branches qui tient sur le nez grâce au pincement d’un ressort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7a07e68-6f94-4376-8a07-cfd198c55862",
                                "sense_id": "451698bd-d94e-30a7-b7da-3e3b6e62d7f7",
                                "text": "Ses yeux, un peu myopes, se dérobaient derrière un lorgnon à monture d’argent, qui prenait son point d’appui sur un nez long, droit, dont les narines mobiles « semblaient aspirer l’espace »."
                            },
                            {
                                "example_id": "e6fc9373-26bd-42a6-b60e-d110e7f5f920",
                                "sense_id": "451698bd-d94e-30a7-b7da-3e3b6e62d7f7",
                                "text": "[…] ; Balouard, dont le lorgnon était brisé, reçoit de l’horloger une série de toutes les dyoptries jusqu’à 18."
                            },
                            {
                                "example_id": "cdaed896-c53b-45bb-927f-d457f54ac6be",
                                "sense_id": "451698bd-d94e-30a7-b7da-3e3b6e62d7f7",
                                "text": "C’est un petit homme insignifiant, légèrement chauve, le lorgnon sur le nez."
                            },
                            {
                                "example_id": "e8dd9571-2a1e-480c-9efb-be64bd2af687",
                                "sense_id": "451698bd-d94e-30a7-b7da-3e3b6e62d7f7",
                                "text": "En vis-à-vis du bâtiment vétuste, l’établissement des jeunes élèves-maîtresses, guindées en leur costume sévère sous le chapeau de feutre sans élégance. Le plupart portent lorgnons."
                            },
                            {
                                "example_id": "5d208fed-0144-4d24-bd83-ac3f43acf5cc",
                                "sense_id": "451698bd-d94e-30a7-b7da-3e3b6e62d7f7",
                                "text": "Elle me regarde à travers son lorgnon, les verres agrandissent ses yeux mordorés, ils paraissent immenses, emplis de naïveté, d’innocence, de bonhomie…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18381f8a-ab5c-4744-bf16-79b34e182459",
                        "source_entry_id": "7ada3445-01ca-30de-a195-ddc00113e331",
                        "target_lang_word": "Augenglas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenglas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18e80be7-d1d4-34f1-bf66-50b312a114c4",
                                        "entry_id": "ae0997ff-6ee4-3043-9eed-e8c788499047",
                                        "glosses": [
                                            "Sehhilfe aus Glas"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23fbd435-0b52-4394-b448-5d4f9fc686dd",
                                                "sense_id": "18e80be7-d1d4-34f1-bf66-50b312a114c4",
                                                "text": "„Andererseits passen sich auch die Religionen den Veränderungen an: Galt ein Augenglas im Mittelalter noch als Teufelswerk, tragen heuer auch Päpste eine Brille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6b373f7-244a-3806-a6be-659f06433006",
                                        "entry_id": "ae0997ff-6ee4-3043-9eed-e8c788499047",
                                        "glosses": [
                                            "Brille"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2efd75c8-fedf-489b-be98-90d33ecf21c0",
                                                "sense_id": "e6b373f7-244a-3806-a6be-659f06433006",
                                                "text": "Ich habe schon wieder meine Augengläser verlegt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c7dd86f-c132-4cc0-be4b-37401e5270bd",
                        "source_entry_id": "7ada3445-01ca-30de-a195-ddc00113e331",
                        "target_lang_word": "Lorgnon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lorgnon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                        "entry_id": "6349b85f-3207-3322-a843-32517c00775e",
                                        "glosses": [
                                            "Sehhilfe für ein Auge, die mit einem Stiel vor das Auge gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54488105-0312-4260-ab9d-74515242097f",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "Ich brauche zum Lesen mein Lorgnon."
                                            },
                                            {
                                                "example_id": "575475dc-ee3d-4b18-9f24-51740524efee",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Im abgedunkelten Bibliothekszimmer meines verstorbenen Vaters - in den Kriegsnächten - beschwor er sie in improvisierten Gespensternoveletten, während geisterhaft Rainer Maria Rilke ihm vom Diwan durch sein Lorgnon zusah.“"
                                            },
                                            {
                                                "example_id": "7971a1da-b104-4a12-aeba-9b8bc97c7dcb",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Der Hausherr selbst hatte eine Adlernase und trug das einzige wirkliche Lorgnon, das ich jemals in meinem Leben auf einer Bauernnase gesehen habe.“"
                                            },
                                            {
                                                "example_id": "6630d18d-4587-4991-8617-66152dff46d9",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Fräulein Oppermann hielt sich etwas vor die Augen, das ich nur aus alten Romanen kannte, ein Lorgnon, und musterte mich wie eine aufgespießte Spinne.“"
                                            },
                                            {
                                                "example_id": "8373b173-4b0c-46f4-8a5e-2d36ae25ab61",
                                                "sense_id": "c12cdac9-b90f-32d5-b1e3-ee5a24994e2a",
                                                "text": "„Die beiden Burschen konfiszierten ein Lorgnon meiner Großmutter, über dessen Verlust sie bis zum Ende ihres Lebens in den Sechzigerjahren klagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "552a713e-3b33-4a23-a2d4-ea303171f1a8",
                        "source_entry_id": "7ada3445-01ca-30de-a195-ddc00113e331",
                        "target_lang_word": "Zwicker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwicker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                        "entry_id": "c16228c3-ddb7-319e-93a9-9f1b1dca5726",
                                        "glosses": [
                                            "Brille, die keine Bügel hat und nur auf die Nase geklemmt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c50b791c-728e-4200-960c-ae6556248b7c",
                                                "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                                "text": "Zwicker sind im 20. Jahrhundert aus der Mode gekommen."
                                            },
                                            {
                                                "example_id": "a1210667-50d7-4917-bc1a-b6c9325c7d95",
                                                "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                                "text": "„Frau Grünberg, eine Frau mit wirrem Haar und einem Zwicker, hörte ihn geduldig an.“"
                                            },
                                            {
                                                "example_id": "1d6eb631-ec65-4c0b-ad27-a783cab710de",
                                                "sense_id": "f87761c2-e024-3d73-b000-8353716cc266",
                                                "text": "„Dieser Herr hieß Eduardo Baixa, war ganz in Schwarz gekleidet und trug einen Zwicker an einem schwarzen Seidenband.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c907b50e-b2c5-3930-9e93-b9303b1b663b",
                                        "entry_id": "c16228c3-ddb7-319e-93a9-9f1b1dca5726",
                                        "glosses": [
                                            "eine etwas einfachere Variante des Edelzwickers, die aus einem Cuveé der einfachen Grundtrauben Gutedel und Silvaner hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52304fcf-e331-406d-b353-4c324a5c4a9f",
                                                "sense_id": "c907b50e-b2c5-3930-9e93-b9303b1b663b",
                                                "text": "Ein Zwicker ist vielen Weintrinkern zu sauer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
