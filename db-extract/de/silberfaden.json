                ],
                "senses": [
                    {
                        "sense_id": "207cd858-4499-3aca-af57-744b7bd35d12",
                        "entry_id": "34e44125-090c-3981-b486-b7228588a6c6",
                        "glosses": [
                            "Faden aus Silber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe8fbcd-e59b-40be-8b4c-40c96f68a28f",
                                "sense_id": "207cd858-4499-3aca-af57-744b7bd35d12",
                                "text": "„Silberfäden hielten ihren Haarknoten, der rings herum mit Spangen und Kämmen, voll von eingelegten Goldzierraten, besteckt war.“"
                            },
                            {
                                "example_id": "2a8bf891-6f2a-400f-82b9-89d1ffdeb3d1",
                                "sense_id": "207cd858-4499-3aca-af57-744b7bd35d12",
                                "text": "„Man bestickte mit Gold- und Silberfäden Ganduras (eine Art unter dem Burnus getragenes Hemd), Gürtel und Hosen sowie die Schuhe der Emire und Höflinge.“"
                            },
                            {
                                "example_id": "f7350340-d2ac-4aa3-ab15-6e4b1cc6afdc",
                                "sense_id": "207cd858-4499-3aca-af57-744b7bd35d12",
                                "text": "„Es war dicht gewebt und mit kleinen Silberfäden durchwirkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ecf833f-6109-324c-bea4-4efd2995a1a6",
                        "entry_id": "34e44125-090c-3981-b486-b7228588a6c6",
                        "glosses": [
                            "silbern schimmernder Faden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb628760-af20-4199-a688-e09341f26a51",
                                "sense_id": "9ecf833f-6109-324c-bea4-4efd2995a1a6",
                                "text": "„Altweibersommer hat die braunen Ackerschollen mit Silberfäden überspannt, die wie die Saiten einer Gottesharfe im Sonnengolde hell erglänzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
