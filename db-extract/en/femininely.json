                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83282cc3-38ea-4867-b54a-04caf27e8a3c",
                                                "sense_id": "4a1ac0ec-dc86-30cb-a7dc-b7bbcb0b38cc",
                                                "text": "Était-ce l'effet de la beauté éblouissante de cet homme, peut-être plus fémininement beau qu'elle ?"
                                            },
                                            {
                                                "example_id": "bd9060cd-8622-48d2-9656-d136cb89fba2",
                                                "sense_id": "4a1ac0ec-dc86-30cb-a7dc-b7bbcb0b38cc",
                                                "text": "A-t-on besoin de la santé pour soi ou les siens, veut-on faire fortune, […] rester éternellement et fémininement jeune, etc., c'est indifféremment au bon Dieu qu'on demande tout cela."
                                            },
                                            {
                                                "example_id": "a20ee15e-bc39-4175-86d6-6bf64938a3cc",
                                                "sense_id": "4a1ac0ec-dc86-30cb-a7dc-b7bbcb0b38cc",
                                                "text": "Je suis un portraitiste curieux de son modèle, et qui, après d’illustres devanciers, a tenté de peindre pour vous, fémininement, une figure de femme."
                                            }
                                        ]
                                    }
                                ]
