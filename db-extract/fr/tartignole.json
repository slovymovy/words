                "senses": [
                    {
                        "sense_id": "dd9c4593-123c-3bba-b719-004990452397",
                        "entry_id": "ae6c9959-cb6d-30ac-8163-9529d87f3333",
                        "glosses": [
                            "Ridicule, laid, vulgaire."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6da8caa8-08e5-46e0-b61d-fe693887a788",
                                "sense_id": "dd9c4593-123c-3bba-b719-004990452397",
                                "text": "A l'instar de sa localisation, une vieille bâtisse fougeraise, la Tivabro est décorée à la mode Bretagne d'antan, avec goût et sans folklore tartignole."
                            },
                            {
                                "example_id": "7f2ab4ac-4aee-42cc-b42a-d9e910026a41",
                                "sense_id": "dd9c4593-123c-3bba-b719-004990452397",
                                "text": "Ce qu'il préfère entre tout : accomplir son petit chemin de croix très personnel sur la tartignole place Émile-Bockstael dans la plus grande désolation urbaine et mentale."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f9dc813-0363-3e57-ba76-b007d8902966",
                        "entry_id": "ae6c9959-cb6d-30ac-8163-9529d87f3333",
                        "glosses": [
                            "Inutilement compliqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04c16bdc-c0d6-49d9-ac78-d49594aad94b",
                                "sense_id": "4f9dc813-0363-3e57-ba76-b007d8902966",
                                "text": "Et la vie est parfois tellement tartignole que je préfère le prendre avec humour."
                            },
                            {
                                "example_id": "6230bbdd-9e20-4c6f-bc2f-4a68725828bc",
                                "sense_id": "4f9dc813-0363-3e57-ba76-b007d8902966",
                                "text": "Je sais que les voies du Seigneur sont parfois tartignoles, mais si ce danseur de tango périmé était le Christ, ça me ferait mal au c…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96450cbe-ee37-4bb0-ba7a-fcdf1a36d336",
                        "source_entry_id": "ae6c9959-cb6d-30ac-8163-9529d87f3333",
                        "target_lang_word": "ridiculous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ridiculous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                        "entry_id": "88e3ad00-8d78-3702-80e3-ddfe5ffeec7d",
                                        "glosses": [
                                            "Deserving of ridicule; foolish, absurd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d529c7e-e0fa-44e4-9a56-ee6fb70aec70",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "That hairstyle looks ridiculous."
                                            },
                                            {
                                                "example_id": "c235b4fb-100a-4bbb-9413-ec874bf3c3a3",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "It's ridiculous to charge so much for a little souvenir."
                                            },
                                            {
                                                "example_id": "bfd06d10-398b-41ea-b03d-56d22dc50c01",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "You make ridiculous statements a lot, like saying that UFOs are real."
                                            },
                                            {
                                                "example_id": "79021443-2e46-4847-ab24-c34ef886ebae",
                                                "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                                                "text": "Many of the so-called rites of these secret societies were so patently ridiculous, that it is quite obvious that they were merely an excuse for men and women to indulge in sex-play and lustful gratification, frequently of an abnormal kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4446182f-d01e-3a60-9437-07e0c58aff45",
                                        "entry_id": "88e3ad00-8d78-3702-80e3-ddfe5ffeec7d",
                                        "glosses": [
                                            "Astonishing, extreme, unbelievable."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46fb735-e954-4250-b0ee-ebe1d2ba87c4",
                                                "sense_id": "4446182f-d01e-3a60-9437-07e0c58aff45",
                                                "text": "In a ridiculous feat of engineering, the team can calculate the difference in arrival time to within one-tenth of a nanosecond."
                                            },
                                            {
                                                "example_id": "f35917a1-1a6b-40e7-9695-e923e46a4686",
                                                "sense_id": "4446182f-d01e-3a60-9437-07e0c58aff45",
                                                "text": "Gaines is a classic motor player with a low center of gravity and ridiculous strength."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
