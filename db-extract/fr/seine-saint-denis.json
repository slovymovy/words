                    {
                        "sense_id": "5f694cd3-7a48-3174-9bd0-8c0626d4fdaf",
                        "entry_id": "1e3f4abf-15fb-3d90-865d-7d88a238b219",
                        "glosses": [
                            "Département français de la région d’Île-de-France, qui porte le numéro 93."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e62116-f834-4b3d-a190-550fd7397436",
                                "sense_id": "5f694cd3-7a48-3174-9bd0-8c0626d4fdaf",
                                "text": "Une recherche-action, conduite dans le département de la Seine-Saint-Denis durant deux ans par deux sociologues, a impliqué une soixantaine d’auxiliaires de puériculture volontaires venues d’une quinzaine de crèches départementales."
                            },
                            {
                                "example_id": "65f6bf02-f71a-4877-9ca8-47b3c7a2b59c",
                                "sense_id": "5f694cd3-7a48-3174-9bd0-8c0626d4fdaf",
                                "text": "Après vingt-deux ans passés à La Courneuve (Seine-Saint-Denis), la Fête de l’Huma s’est vu contrainte de quitter son mythique terrain de jeu, puisqu’il accueillera le village des médias des Jeux olympiques de 2024."
                            },
                            {
                                "example_id": "7887ab5b-107a-4da5-ae0f-24cdabe5d1e9",
                                "sense_id": "5f694cd3-7a48-3174-9bd0-8c0626d4fdaf",
                                "text": "Bienvenue à Épinay-sur-Seine, ville de 50 000 âmes située au cœur de la Seine-Saint-Denis…"
                            }
                        ]
                    }
