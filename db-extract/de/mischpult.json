                        "source_sense_id": "1d8b5ef2-5bd8-3cd8-8c72-47f3914a8942",
                        "source_sense_description": "Musik: elektronisches Gerät zum Überlagern von Ton- und/oder Bildsignalen",
                        "target_lang_word": "table de mixage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "table de mixage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a1f843-2b3c-36c2-913f-4bb15e2061ae",
                                        "entry_id": "f752279d-b57d-3635-aaba-a29b510a0ef2",
                                        "glosses": [
                                            "Appareil électronique destiné au mixage d'un ou plusieurs signaux audio (voire multimédia) reçus afin de produire en direct un ou plusieurs signaux combinés ou transformés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d68647-a832-4d15-9e8c-24b762ff6993",
                                                "sense_id": "d6a1f843-2b3c-36c2-913f-4bb15e2061ae",
                                                "text": "La régie du DJ est composée de deux platines et un micro connectés à une table de mixage, qui produit le signal audio fourni aux haut-parleurs."
                                            },
                                            {
                                                "example_id": "bc510866-7258-46d8-b7e1-1003dbbc828f",
                                                "sense_id": "d6a1f843-2b3c-36c2-913f-4bb15e2061ae",
                                                "text": "Sans la salle carrelée de blanc et encore décorée par des guirlandes de Noël, deux infirmières sont debout derrière une table de mixage, face à une trentaine de patients en tenue de sport, sandales aux pieds, qui dansent sur du trip hop, les yeux fermés et les bras levés au ciel, comme lors d’une messe païenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4981d539-dc77-447c-9858-de4f88c20081",
                        "source_entry_id": "287e1c6d-91fa-3578-8f40-7e4cdfff5b50",
                        "source_sense_id": "1d8b5ef2-5bd8-3cd8-8c72-47f3914a8942",
                        "source_sense_description": "Musik: elektronisches Gerät zum Überlagern von Ton- und/oder Bildsignalen",
                        "target_lang_word": "mengpaneel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mengpaneel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e61d8869-c3ea-3026-9ddb-6328876e1178",
                                        "entry_id": "fd8de288-eefe-35a7-9e85-7a3241714282",
                                        "glosses": [
                                            "paneel waarop verschillende geluidsbronnen gemengd worden waarbij men de sterkte en de plaats in het stereobeeld van de verschillende bronnen kan bepalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f5819df-9a62-48d8-ba85-4cd1ee1181d4",
                                                "sense_id": "e61d8869-c3ea-3026-9ddb-6328876e1178",
                                                "text": "Zelfs als er digitale middelen werden ingezet, gold de regel: less is more. Voor hun prikkelende muzieksolo’s hadden Marieke Dermul en Lester Arias niet meer nodig dan een mengpaneel, micro, synthesizer en laptop."
                                            },
                                            {
                                                "example_id": "cc032499-8caf-482e-94c3-f5077e482c0e",
                                                "sense_id": "e61d8869-c3ea-3026-9ddb-6328876e1178",
                                                "text": "Ronnie Flex kreeg de afgelopen maanden heel wat bierdouches te verwerken. Meerdere keren liet hij weten het optreden af te blazen als het weer zou gebeuren, maar gisteravond was het niet de rapper die het zat was. Tijdens het First Day of Summer Festival in Geesteren raakte een biertje het mengpaneel, waardoor het over en uit was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
