                                    },
                                    {
                                        "sense_id": "4775062c-93b0-3f25-834f-d26b98392ea9",
                                        "entry_id": "0eef8d78-0cc4-30dd-bcb3-3852b299634f",
                                        "glosses": [
                                            "Partie distincte d’un tout.",
                                            "Chacune des deux quantités d’une équation, qui sont séparées par le signe d’égalité."
                                        ],
                                        "tags": [],
