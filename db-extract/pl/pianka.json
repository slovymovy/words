                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "16241b4e-4e51-363e-b905-49ea0650b672",
                        "entry_id": "c3200523-d563-3ce4-be11-dcefdf63ef9e",
                        "glosses": [
                            "słodki, spieniony deser, np. z produktów mlecznych i jajek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad6b0f6-b10f-45ed-946e-3de4835965ad",
                                "sense_id": "16241b4e-4e51-363e-b905-49ea0650b672",
                                "text": "Nie wiedziałem, że piankę można zrobić, dodając bitą śmietanę do galaretki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "44253a83-961c-3f1d-a2c3-3e7eb7e9b50a",
                        "entry_id": "c3200523-d563-3ce4-be11-dcefdf63ef9e",
                        "glosses": [
                            "marshmallow"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "17c019b9-2656-3de3-b8f0-24e338fbc626",
                        "entry_id": "c3200523-d563-3ce4-be11-dcefdf63ef9e",
                        "glosses": [
                            "spieniony kosmetyk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914ab1d5-d579-40e2-b9f8-f706fd2e8265",
                                "sense_id": "17c019b9-2656-3de3-b8f0-24e338fbc626",
                                "text": "Umieścić uchwyt z aplikatorem pianki w otworze na szczycie nakrywki, tak aby aplikator pianki był niewidoczny."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "baa8633b-abea-3989-bfcd-648ba7692890",
                        "entry_id": "c3200523-d563-3ce4-be11-dcefdf63ef9e",
                        "glosses": [
                            "pęcherzyki powietrza gęsto zatopione w przezroczystym materiale"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "ce4accbb-944a-3ebd-9956-48cbfbc6d793",
                        "entry_id": "c3200523-d563-3ce4-be11-dcefdf63ef9e",
                        "glosses": [
                            "kombinezon izolujący ciało przed zimnem i wodą"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b568ee62-0f57-42b8-93d6-9b67c682c3e1",
                                "sense_id": "ce4accbb-944a-3ebd-9956-48cbfbc6d793",
                                "text": "Dalej, zakładaj piankę, bierz akwalung i nurkuj."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    },
                    {
                        "sense_id": "3ec6ddcf-d17e-341b-a9ec-7067c5f104e5",
                        "entry_id": "c3200523-d563-3ce4-be11-dcefdf63ef9e",
                        "glosses": [
