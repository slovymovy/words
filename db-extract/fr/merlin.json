            {
                "entry_id": "e940d3aa-15a3-3bd4-8256-214b9a7d5d9e",
                "word": "merlin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79f3f728-d35d-49f1-a270-a1b8ba0d2682",
                        "entry_id": "e940d3aa-15a3-3bd4-8256-214b9a7d5d9e",
                        "tags": [
                            "plural"
                        ],
                        "form": "merlins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce0360cb-2192-32b8-a173-61202f5fa57f",
                        "entry_id": "e940d3aa-15a3-3bd4-8256-214b9a7d5d9e",
                        "glosses": [
                            "Long marteau dont les bouchers se servent pour assommer les bœufs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a3db01-f073-4d82-a71e-568d1e162583",
                                "sense_id": "ce0360cb-2192-32b8-a173-61202f5fa57f",
                                "text": "Le second, qui était une espèce de colosse, portait, par le milieu du manche et la cognée en bas, un merlin à assommer les bœufs."
                            },
                            {
                                "example_id": "166aaa8f-d2dd-4c67-9bd0-92c4c64d062e",
                                "sense_id": "ce0360cb-2192-32b8-a173-61202f5fa57f",
                                "text": "Lorsque le malheureux bœuf recevait le coup de merlin entre ses cornes, et tombait sur les genoux, j’admirais simplement la force du boucher, et la victoire de l’homme sur la bête."
                            },
                            {
                                "example_id": "43dc7d16-e94a-4e72-83e9-2d2c9921ac49",
                                "sense_id": "ce0360cb-2192-32b8-a173-61202f5fa57f",
                                "text": "Le Suisse leva sur lui l’œil désespéré du bœuf voyant s’abattre le merlin du boucher : […]"
                            },
                            {
                                "example_id": "a81af320-941a-451d-b13d-7f10e442668b",
                                "sense_id": "ce0360cb-2192-32b8-a173-61202f5fa57f",
                                "text": "Ciseaux et masses pour déjointer les pierres des remparts, merlins d’acier pour briser les serrures, grands filets à mailles solides que l’on porte à deux cavaliers pour \"capter\" des prisonniers en rase campagne, lacets - sortes de lassos - pour \"jeter bas\" cavaliers ou sentinelles, lourds poignards dont le manche peut servir de matraque."
                            }
                        ]
                    },
                    {
                        "sense_id": "feefee92-aed1-3435-beb2-7dedcf7cf3bf",
                        "entry_id": "e940d3aa-15a3-3bd4-8256-214b9a7d5d9e",
                        "glosses": [
                            "Cognée ou hache pour fendre le bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae4bdaf-8aa7-4946-8b2a-f0d0de05e4a1",
                                "sense_id": "feefee92-aed1-3435-beb2-7dedcf7cf3bf",
                                "text": "Il y a là le merlin à fendre le bois, mais c’est trop lourd pour vous."
                            }
                        ]
                    }
                ],
