                "senses": [
                    {
                        "sense_id": "980b7fd2-88c2-3993-aa68-7f98296c98b0",
                        "entry_id": "011bc08f-d595-3e6c-aa41-976e065f0fb9",
                        "glosses": [
                            "商朝"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "121202af-771b-4ab3-a27b-14ab3292f25f",
                                "sense_id": "980b7fd2-88c2-3993-aa68-7f98296c98b0",
                                "text": "Wilma Fairbank strongly supports the piece mold theory but points out that the mastery of bronze technology by the Shang people was an outgrowth of their earlier mastery of ceramic technology.",
                                "translation": "威尔玛·费尔班克强烈支持坯模理论，但她指出，商代人对青铜技术的掌握是他们早期对陶瓷技术的掌握的产物。"
                            },
                            {
                                "example_id": "6fb21bdc-fe68-499a-b62a-78e12215dd5b",
                                "sense_id": "980b7fd2-88c2-3993-aa68-7f98296c98b0",
                                "text": "In the Shang and Chou periods our knowledge from archaeology of ordinary dwellings is thus far poor, but something can be said of the more pretentious edifices.",
                                "translation": "我们对商周时期普通民居的考古发现了解甚少，但对于一些较为奢华的建筑，我们还是可以了解一些的。"
                            },
                            {
                                "example_id": "f11a71fe-f5be-4733-b89c-e018a551420d",
                                "sense_id": "980b7fd2-88c2-3993-aa68-7f98296c98b0",
                                "text": "Hsing-t'ai, Han-tan, and Shih-chia-chuang are thus among the numerous Shang sites marked by heavy upper Erh-li-kang cultural manifestations.",
                                "translation": "因此，邢台、邯郸、石家庄等众多商代遗址都具有浓厚的二里岗文化特征。"
                            }
                        ]
                    }
                ],
