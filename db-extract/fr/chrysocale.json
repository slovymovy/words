                "senses": [
                    {
                        "sense_id": "f4719f89-983e-3ce5-854d-0b59656c6b39",
                        "entry_id": "4631bee1-2164-3173-8905-15e0c5ea1c0c",
                        "glosses": [
                            "Variante de chrysochalque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686dc937-a626-401d-b408-9e780d0921da",
                                "sense_id": "f4719f89-983e-3ce5-854d-0b59656c6b39",
                                "text": "Et tout cela brossé, quasi propre, orné d’une montre attachée par une chaîne en chrysocale."
                            },
                            {
                                "example_id": "8a284a83-387b-4db5-af89-6a879f5aa0a1",
                                "sense_id": "f4719f89-983e-3ce5-854d-0b59656c6b39",
                                "text": "Elle avait aux oreilles, au cou, à la ceinture, aux poignets, au moins deux livres pesant de bijoux en chrysocale ou en pierres fausses."
                            },
                            {
                                "example_id": "f017bac0-768e-4e69-9d9a-cf1f49066d1a",
                                "sense_id": "f4719f89-983e-3ce5-854d-0b59656c6b39",
                                "text": "Ce qu’on appelle honneurs et dignités, et même honneur et dignité, est généralement en chrysocale."
                            },
                            {
                                "example_id": "cdc3e1f8-3271-4a3e-8b66-a10a55cd776c",
                                "sense_id": "f4719f89-983e-3ce5-854d-0b59656c6b39",
                                "text": "Elle avait aux doigts des bagues en chrysocale ornées de pierres fausses."
                            }
                        ]
                    }
                ],
