                            "comment": "technical usage in textile industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять волокна материала, такого как шерсть или лен.",
                        "tr": "Yün veya keten gibi bir malzemenin liflerini ayırmak.",
                        "zh": "分离纤维材料，如羊毛或亚麻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чесать",
                                "target_lang_sense_clarification": "очищать и разравнивать волокна (лен, шерсть)"
                            },
                            {
                                "target_lang_word": "расчесывать",
                                "target_lang_sense_clarification": "разделять спутанные волокна"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "didiklemek",
                                "target_lang_sense_clarification": "lifleri birbirinden ayırmak"
                            },
                            {
                                "target_lang_word": "taramak",
                                "target_lang_sense_clarification": "yün veya lifleri temizleyip düzeltmek"
                            }
