                "senses": [
                    {
                        "sense_id": "d4cf42b8-56c5-3ed2-bd97-2c77c361b38d",
                        "entry_id": "4c1fdf5b-0469-35c4-b659-b1a0b1737fc2",
                        "glosses": [
                            "van, uit, betreffende of als in de plaats Sparta (waarbij het meestal om de Griekse stadstaat uit de klassieke oudheid gaat)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "448961d9-322f-4fd7-92f9-c45d0a89d1d3",
                                "sense_id": "d4cf42b8-56c5-3ed2-bd97-2c77c361b38d",
                                "text": "De Spartaanse jeugd kreeg een spartaanse opvoeding."
                            },
                            {
                                "example_id": "cf2b0161-7f66-4d2e-a632-ada65c25ac28",
                                "sense_id": "d4cf42b8-56c5-3ed2-bd97-2c77c361b38d",
                                "text": "De vestingen die vroeger onder Spartaans gezag stonden, kregen, nadat zij van de Spartaanse zeggenschap waren bevrijd, de naam van ‘vrije Laconiërs’."
                            }
                        ]
                    },
                    {
                        "sense_id": "644ccb4c-4ee4-3898-9ce4-2cdbaf3b9173",
                        "entry_id": "4c1fdf5b-0469-35c4-b659-b1a0b1737fc2",
                        "glosses": [
                            "van, horend bij, betreffend de club Sparta (waarbij het meestal gaat om een sportclub die naar de stad uit de klassieke oudheid is genoemd)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e13290-7ac1-427d-9596-5f7ff1c594e7",
                                "sense_id": "644ccb4c-4ee4-3898-9ce4-2cdbaf3b9173",
                                "text": "In plaats van bij Spartaans balverlies de bal meteen de diepte in te sturen en de snelle aanvallers te bedienen, verkoos Oulida te soleren en de bal \"te brengen\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cfa857c-6965-32a7-ab34-a3f7bfb306a4",
                        "entry_id": "4c1fdf5b-0469-35c4-b659-b1a0b1737fc2",
                        "glosses": [
                            "partitief van de stellende trap van Spartaans"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "920c43bb-35d3-45e3-8fd7-4e65f0f5aa12",
                                "sense_id": "8cfa857c-6965-32a7-ab34-a3f7bfb306a4",
                                "text": "Het ontbreken van stadsmuren was echt iets Spartaans."
                            }
                        ]
                    }
