                        "glosses": [
                            "Prêcher pour convertir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a72b7a4f-acd4-4ad0-85d6-3648cdb62ba4",
                                "sense_id": "d37bd141-2309-35c3-9826-502d91103cf8",
                                "text": "Je disais que tout humain a le choix entre servir Dieu, et peu ou prou utiliser les outils possibles pour ce faire (ses pieds pour missionner en Afrique, ou sa fusée pour apostoliser sur Vénus, n'importe !) et s'asservir comme les anges rebelles à leur propre personne glorifiant les réussites techniques ou fantastiques qu'il inventera pour cela. (Forum catholique)"
                            }
                        ]
