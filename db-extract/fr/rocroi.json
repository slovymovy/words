            {
                "entry_id": "4709d5ad-2188-380f-a715-5df7182ed952",
                "word": "Rocroi",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8eaaf0e1-c3c1-4c50-9fab-fb0daafd8e0c",
                        "entry_id": "4709d5ad-2188-380f-a715-5df7182ed952",
