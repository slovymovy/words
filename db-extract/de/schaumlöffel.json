                ],
                "senses": [
                    {
                        "sense_id": "46ea7770-1bda-3b91-80af-d3d4a2bdafd8",
                        "entry_id": "29605185-c439-3d87-9d01-697c291c0831",
                        "glosses": [
                            "durchlöcherter Schöpflöffel, mit dem man den Schaum von Flüssigkeiten entfernen oder Speisen aus heißer Flüssigkeit entnehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8de908-e7e4-4e16-8a6b-39ace48d22e4",
                                "sense_id": "46ea7770-1bda-3b91-80af-d3d4a2bdafd8",
                                "text": "Beim Zubereiten einer Soße empfiehlt es sich, aufsteigenden Schaum mit dem Schaumlöffel abzuschöpfen."
                            },
                            {
                                "example_id": "2ba3f05e-5744-4274-a6b1-0475fbe949b1",
                                "sense_id": "46ea7770-1bda-3b91-80af-d3d4a2bdafd8",
                                "text": "„Sie erstanden die Geräte eines verkrachten Destillateurs, und bald kamen Siebe, Fäßchen, Trichter, Schaumlöffel, Filtrierbeutel und Waagen ins Haus, ohne eine Schleifschale mit Kugel und einen Destillierkolben mitzuzählen, der einen Schmelzofen mit Rauchfang erforderlich machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdbb1c61-8efb-4a70-b7ed-40bcd17084c5",
