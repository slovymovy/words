                        "glosses": [
                            "een opsomming die openbaar wordt gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9691dfa8-1805-4beb-9d75-245f5e71e456",
                                "sense_id": "dd31e092-0e17-337a-9435-01e174834d26",
                                "text": "Kwaadwillenden proberen zo uit handen te blijven van schuldeisers of om sociale fraude te plegen. Het merendeel is echter wel te goeder trouw en is vergeten de verhuizing goed te regelen. Maar ook dat kan grote gevolgen hebben. Ze kunnen bijvoorbeeld al hun rechten op sociale zekerheid kwijtraken. Ook zij komen daarom op de publicatielijst van vermiste Almelose burgers."
                            }
                        ]
