        "fr-extract.jsonl": [
            {
                "entry_id": "ec15f0ee-f9a4-34df-ba2a-93981c971c9b",
                "word": "Bâle",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ae744d3-df27-3627-8e97-2a7205db85cb",
                        "entry_id": "ec15f0ee-f9a4-34df-ba2a-93981c971c9b",
                        "glosses": [
                            "Ville et commune du canton de Bâle-Ville en Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7a41e56-6705-454a-b277-2113103ab03b",
                                "sense_id": "8ae744d3-df27-3627-8e97-2a7205db85cb",
                                "text": "Durant le second séjour de Holbein à Bâle, de 1528 à 1532, […], il a de nouveau portraituré Érasme à plusieurs reprises, mais vraisemblablement une seule fois d’après nature, puisque l'humaniste quitta déjà Bâle en 1529."
                            },
                            {
                                "example_id": "6d805dae-f90f-483a-8e45-d3cbca3592b6",
                                "sense_id": "8ae744d3-df27-3627-8e97-2a7205db85cb",
                                "text": "Comme nous passions par Bâle, nous avons suivi avec les badauds une cinquantaine d’hommes qui jouaient du fifre et du tambour."
                            },
                            {
                                "example_id": "c69d78fa-19c7-4c1a-913d-a076c65d5097",
                                "sense_id": "8ae744d3-df27-3627-8e97-2a7205db85cb",
                                "text": "Réunies à Vienne, en congrès, les puissances vainqueures de l'empereur décident d'attribuer le territoire de l'Ancien évêché de Bâle au canton de Berne, donc à la Confédération helvétique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ec028ee-1edd-40f3-a880-3f9f3e086691",
                        "source_entry_id": "ec15f0ee-f9a4-34df-ba2a-93981c971c9b",
                        "source_sense_id": "8ae744d3-df27-3627-8e97-2a7205db85cb",
                        "target_lang_word": "Basel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                        "entry_id": "1934e2d5-08c9-395f-9d8a-2f7239396394",
                                        "glosses": [
                                            "eine Stadt in der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3baaed1-bb9b-45f2-8dc1-b14757c9dcf3",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "Basel ist der grösste Messeplatz der Schweiz."
                                            },
                                            {
                                                "example_id": "f0c19096-f027-4d72-9c59-7cb7ea5ebab8",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "„Die ehemaligen Römerstädte Köln, Mainz, Worms, Speyer, Straßburg und Basel gewannen wirtschaftliche Bedeutung, seit der Warenaustausch mit Italien nicht mehr hauptsächlich über Marseille und Fos auf dem Seeweg, sondern immer mehr über die Alpenpässe abgewickelt wurde.“"
                                            },
                                            {
                                                "example_id": "323b2365-73a9-4e55-ad9e-1029411a394e",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "„Wir erzählen, dass wir in Basel waren und dass es dort eine richtige Badekultur gebe.“"
                                            },
                                            {
                                                "example_id": "144dcb7e-0c6e-4baf-8391-22da7c17d192",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "„Um die weitere Ausbreitung des Japankäfers zu verhindern, setzt die Schweizer Großstadt Basel erstmals Fadenwürmer gegen den Schädling in öffentlichen Parks und Sportanlagen ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e2d9721-abdc-34e5-b8a2-0246d28e2d14",
                                        "entry_id": "1934e2d5-08c9-395f-9d8a-2f7239396394",
                                        "glosses": [
                                            "Name zweier Schweizer Halbkantone (Basel-Stadt, Basel-Landschaft)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
