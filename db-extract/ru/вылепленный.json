                "senses": [
                    {
                        "sense_id": "bd74ce71-d8f8-3ca3-86ac-487d1d6172b9",
                        "entry_id": "9bf140dd-12dd-32fa-a76e-450101b7dc99",
                        "glosses": [
                            "past passive perfective participle of вы́лепить (výlepitʹ)"
                        ],
                        "tags": [
                            "form-of",
                            "participle",
                            "passive",
                            "past",
                            "perfective"
                        ],
                        "examples": [
                            {
                                "example_id": "91e7919b-cfca-4620-8d40-efaef153e90c",
                                "sense_id": "bd74ce71-d8f8-3ca3-86ac-487d1d6172b9",
                                "text": "Знал, что надлежи́т уничто́жить фо́рму, столь поро́чную, и смять гли́ну, из кото́рой вы́леплено так мно́го дурно́го. Не хоте́л ду́мать, что э́то он сам — тот, кто вы́леплен из э́той гли́ны, — споко́йно отдава́л себя́ ве́чно творя́щей и ве́чно разруша́ющей во́ле и безбоя́зненно ждал исполне́ния своего́ сро́ка.",
                                "translation": "Fyodor Sologub",
                                "english": "Fyodor Sologub"
                            }
                        ]
                    }
