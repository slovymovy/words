                        "sense_id": "3dbd26cf-593e-3c4f-9f3b-bb12942d2bc6",
                        "entry_id": "3d79de21-b557-3f1c-9a4b-77f899bdd9c8",
                        "glosses": [
                            "Instrument en forme de poinçon qui sert à épisser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22778da6-bb5a-4e79-a51a-02ec1a42d143",
                                "sense_id": "3dbd26cf-593e-3c4f-9f3b-bb12942d2bc6",
                                "text": "À ses pieds, on voit encore les traces de l’épissoir, planté dans le sol, mais, par suite d’une malencontreuse lacune, il n’est plus possible de décrire exactement le rôle qu’il joue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fed48c2d-d79a-4ac3-a3e2-7ff35723a9c1",
