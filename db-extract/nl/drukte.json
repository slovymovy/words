                                            {
                                                "example_id": "fd173f24-5987-4929-b110-417e91015804",
                                                "sense_id": "c40256ba-0388-3626-8d52-674345426f0a",
                                                "text": "Hektik im Job bringt die Balance der Lebensbereiche durcheinander."
                                            },
                                            {
                                                "example_id": "bcb2fe5c-4b99-4765-9e42-1832e1cf3a62",
                                                "sense_id": "c40256ba-0388-3626-8d52-674345426f0a",
                                                "text": "„Auch wenn in manchen Ballungsgebieten das Wohnraum-Angebot knapp ist - beim Immobilienkauf ist Hektik kein guter Ratgeber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bdcc5b3-04a9-43c8-9faa-e5d4c8de6e8b",
