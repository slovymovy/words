                        "glosses": [
                            "Faire perdre sa protection par brevet à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aebed3ed-cd73-4402-a764-7803637ced00",
                                "sense_id": "27eb299e-d3e4-34f3-a5ac-98f26b54c05e",
                                "text": "Le médicament bientôt \" débreveté \" ?"
                            },
                            {
                                "example_id": "6670934a-c2ae-46f4-8e6d-f001061f5418",
                                "sense_id": "27eb299e-d3e4-34f3-a5ac-98f26b54c05e",
                                "text": "La thèse étudie le comportement de la demande face au choix entre un médicament de marque débreveté et ses copies génériques."
                            },
                            {
                                "example_id": "65a1ab83-ab33-466b-8a96-5d52c1db9c57",
                                "sense_id": "27eb299e-d3e4-34f3-a5ac-98f26b54c05e",
                                "text": "Il s’agit de débreveter tout brevet portant sur l’appropriation d’une partie ou d’un tout vivant."
                            }
                        ]
                    }
