                        "entry_id": "9385a2ca-5c4d-3a68-b43c-35511d233ccd",
                        "glosses": [
                            "Message à la presse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12cc3082-58d7-46cc-a97d-ebe251b9d16c",
                                "sense_id": "680694a8-abd6-3e95-911c-3a9db0aa0499",
                                "text": "Elie montra à Hoffmeister un communiqué paru dans Le Courrier, selon lequel un agent de la Sécurité malgache avait été décoré."
                            },
                            {
                                "example_id": "9befddcd-39b8-43fa-b69a-e64d655d287e",
                                "sense_id": "680694a8-abd6-3e95-911c-3a9db0aa0499",
                                "text": "Pfizer a annoncé dans un communiqué travailler un vaccin ciblant les BA4 et BA5."
                            }
                        ]
                    },
                    {
