                "senses": [
                    {
                        "sense_id": "32531645-ee92-355d-86fb-62725a0405e1",
                        "entry_id": "5ee808d2-484d-3152-948e-986f270f58e5",
                        "glosses": [
                            "Qui a quatre lobes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8f1e3c-721d-4abb-a8ab-b2ce14cc3364",
                                "sense_id": "32531645-ee92-355d-86fb-62725a0405e1",
                                "text": "Corolle obringentiforme, à limbe amplifié, divisé en deux segmens, l’intérieur quadrilobé au sommet, l’extérieur tantôt bifide jusqu'à la base, tantôt indivis."
                            }
                        ]
                    },
                    {
                        "sense_id": "be5e7a6d-dc42-304c-b5b3-a097512938b8",
                        "entry_id": "5ee808d2-484d-3152-948e-986f270f58e5",
                        "glosses": [
                            "Pourvu de quatre lobes ; en forme de quadrilobe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30923389-63c3-4489-8df6-e460817bfd00",
                                "sense_id": "be5e7a6d-dc42-304c-b5b3-a097512938b8",
                                "text": "Le tabernacle et le triptyque quadrilobé, attribués à Broederlam, ne sauraient faire oublier les charmans panneaux du maître d’Ypres, dans le retable du duc Philippe le Hardi, au musée de Dijon ; c’est bien, d’ailleurs, dans la détrempe, la même touche légère, vive et claire, à la manière des vieux Siennois et des Colonais, leurs élèves, la même façon d’associer les naïvetés et les rusticités flamandes à la grâce un peu alourdie des réminiscences toscanes."
                            }
                        ]
                    }
