{
    "word_family": [
        "deprave",
        "depraved",
        "depraving"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "867a54fc-31d9-3c7a-ae5c-a6b81c9dd40d",
                    "sense_definition": "The state or condition of being morally corrupt or wicked.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel explores the depths of human <w>depravity</w> during the height of the war.",
                            "target_lang_translations": {
                                "ru": "Роман исследует глубины человеческой <w>порочности</w> в разгар войны."
                            }
                        },
                        {
                            "text": "The judge was shocked by the utter <w>depravity</w> of the crimes committed by the defendant.",
                            "target_lang_translations": {
                                "ru": "Судья был потрясен крайней <w>безнравственностью</w> преступлений, совершенных подсудимым."
                            }
                        }
                    ],
                    "synonyms": [
                        "wickedness"
                    ],
                    "antonyms": [
                        "virtue",
                        "purity",
                        "morality"
                    ],
                    "common_phrases": [
                        "moral depravity",
                        "depths of depravity",
                        "utter depravity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество моральной испорченности или порочности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочность",
                                "target_lang_sense_clarification": "склонность к пороку и моральное разложение"
                            },
                            {
                                "target_lang_word": "разврат",
                                "target_lang_sense_clarification": "крайняя степень морального падения"
                            },
                            {
                                "target_lang_word": "безнравственность",
                                "target_lang_sense_clarification": "отсутствие моральных принципов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ba04b1a-4c26-31c9-afd0-787791c1d725",
                    "sense_definition": "The theological concept of inborn corruption, suggesting human nature is inherently contaminated by sin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theological corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sermon focused on the doctrine of total <w>depravity</w> and the need for divine grace.",
                            "target_lang_translations": {
                                "ru": "Проповедь была посвящена доктрине о полной <w>греховности</w> и необходимости божественной благодати."
                            }
                        },
                        {
                            "text": "Many religious scholars debated the extent of human <w>depravity</w> in their philosophical writings.",
                            "target_lang_translations": {
                                "ru": "Многие религиозные ученые обсуждали степень человеческой <w>испорченности</w> в своих философских трудах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "total depravity",
                        "innate depravity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "theological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Богословская концепция врожденной испорченности, согласно которой человеческая природа изначально осквернена грехом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греховность",
                                "target_lang_sense_clarification": "в контексте врожденной испорченности человеческой природы"
                            },
                            {
                                "target_lang_word": "испорченность",
                                "target_lang_sense_clarification": "в теологическом смысле поврежденности натуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2245ac51-12e4-3e24-9ee0-e09403a21534",
                    "sense_definition": "A specific act or behavior that is considered morally corrupt or wicked.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "moral corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history books are filled with the various <w>depravities</w> of the ancient tyrant.",
                            "target_lang_translations": {
                                "ru": "Исторические книги полны описаний различных <w>пороков</w> древнего тирана."
                            }
                        },
                        {
                            "text": "He was accused of committing several abominable <w>depravities</w> against the local population.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в совершении нескольких чудовищных <w>злодеяний</w> против местного населения."
                            }
                        }
                    ],
                    "synonyms": [
                        "wickedness"
                    ],
                    "common_phrases": [
                        "abominable depravities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный поступок или поведение, считающееся морально развращенным или порочным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочность",
                                "target_lang_sense_clarification": "проявление аморального поведения"
                            },
                            {
                                "target_lang_word": "низость",
                                "target_lang_sense_clarification": "подлый или бесчестный поступок"
                            },
                            {
                                "target_lang_word": "развращенность",
                                "target_lang_sense_clarification": "конкретные проявления испорченности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}