                                "zh": "当市长在电视直播中丢了裤子时，整个局面变得完全<w>荒唐</w>了。"
                            }
                        },
                        {
                            "text": "The team's performance turned into a <w>farcical</w> situation after three players scored goals for the opposing side.",
                            "target_lang_translations": {
                                "zh": "在三名队员为对方球队进球后，这支队伍的表现变成了一场<w>闹剧</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absurd",
                        "ludicrous",
                        "ridiculous",
                        "preposterous"
                    ],
                    "antonyms": [
                        "serious",
                        "sensible",
                        "solemn"
                    ],
                    "common_phrases": [
                        "farcical situation",
                        "farcical attempt",
                        "turn farcical"
                    ],
                    "target_lang_definitions": {
                        "zh": "指极其愚蠢、不合理或不合时宜，以至于显得滑稽或荒唐。"
