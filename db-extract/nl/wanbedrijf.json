                        "examples": [
                            {
                                "example_id": "67d01e82-be3a-4dc5-ba34-2e8c5d364adf",
                                "sense_id": "11f12ed0-9416-35ed-b32c-121f7fbed572",
                                "text": "De NMBS overhandigde het hele aankoopdossier aan het parket in Brussel. Volgens de krant De Tijd gebeurde dat omdat de wet bepaalt dat een overheid, een overheidsinstantie of een ambtenaar melding moet maken van elke misdaad of wanbedrijf waarvan die op de hoogte is."
                            },
                            {
                                "example_id": "3f5d1043-1bde-4719-a63d-d7d6813040db",
                                "sense_id": "11f12ed0-9416-35ed-b32c-121f7fbed572",
                                "text": "Dat de regenten het nog niet bonter maakten dan ze al deden, was volgens Fruin niet aan de veredeling van hun karakter toe te schrijven, “maar alleen aan de verbetering van onze staatsinstellingen, en bovenal aan de publiciteit, die hun wanbedrijf vergeldt met wat het waard is, de algemene verachting” (Uit: Nederlandsche Spectator, 1864)."
                            }
                        ]
                    }
