                                "target_senses": [
                                    {
                                        "sense_id": "2b807590-294c-35a2-b5bd-0b5b89194a00",
                                        "entry_id": "85bdd096-a4cc-3cd3-b4bd-a97df5975292",
                                        "glosses": [
                                            "To rend (a solid material) by holding or restraining in two places and pulling apart, whether intentionally or not; to destroy or separate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c11f0380-257e-44f1-bbfe-ece322013737",
                                                "sense_id": "2b807590-294c-35a2-b5bd-0b5b89194a00",
                                                "text": "He tore his coat on the nail."
                                            },
                                            {
                                                "example_id": "e46749f1-a23a-4a42-9477-f3d43950dab9",
                                                "sense_id": "2b807590-294c-35a2-b5bd-0b5b89194a00",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season.\nHe suffered, poor man, at seeing her so badly dressed, with laceless boots, and the arm-holes of her pinafore torn down to the hips; for the charwoman took no care of her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ec864ca-5f6d-3fd3-95eb-76143728dd4b",
                                        "entry_id": "85bdd096-a4cc-3cd3-b4bd-a97df5975292",
                                        "glosses": [
                                            "To injure as if by pulling apart."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2334b1bd-51ec-473d-b96d-a3b0a68aa259",
                                                "sense_id": "3ec864ca-5f6d-3fd3-95eb-76143728dd4b",
                                                "text": "He tore some muscles in a weight-lifting accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c049fe7a-7163-34c6-a8f8-97a87e3f2ca1",
                                        "entry_id": "85bdd096-a4cc-3cd3-b4bd-a97df5975292",
                                        "glosses": [
                                            "To destroy or reduce abstract unity or coherence, such as social, political or emotional."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ab7ee9-d323-4d31-9727-954fc994989e",
                                                "sense_id": "c049fe7a-7163-34c6-a8f8-97a87e3f2ca1",
                                                "text": "He was torn by conflicting emotions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc29f34c-d142-39b6-9bc2-c167e6032472",
                                        "entry_id": "85bdd096-a4cc-3cd3-b4bd-a97df5975292",
                                        "glosses": [
                                            "To make (an opening) with force or energy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f71a75ef-6e79-4212-a551-a2822356e69f",
                                                "sense_id": "bc29f34c-d142-39b6-9bc2-c167e6032472",
                                                "text": "A piece of debris tore a tiny straight channel through the satellite."
                                            },
                                            {
                                                "example_id": "8e9d4931-f804-4c6a-af0e-a80ae18e511f",
                                                "sense_id": "bc29f34c-d142-39b6-9bc2-c167e6032472",
                                                "text": "His boss will tear him a new one when he finds out."
                                            },
                                            {
                                                "example_id": "31aa56e5-f7f5-4621-be45-815824135dad",
                                                "sense_id": "bc29f34c-d142-39b6-9bc2-c167e6032472",
                                                "text": "The artillery tore a gap in the line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42b031f4-e4ac-3f1b-b0f2-f03db627e6e3",
                                        "entry_id": "85bdd096-a4cc-3cd3-b4bd-a97df5975292",
                                        "glosses": [
                                            "To remove by tearing, or with sudden great force."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352978c8-9bef-40f9-8764-e24bb17ba15a",
                                                "sense_id": "42b031f4-e4ac-3f1b-b0f2-f03db627e6e3",
                                                "text": "Tear the coupon out of the newspaper."
                                            },
                                            {
                                                "example_id": "0933c7c3-7569-4767-9d44-2eb177599ec6",
                                                "sense_id": "42b031f4-e4ac-3f1b-b0f2-f03db627e6e3",
