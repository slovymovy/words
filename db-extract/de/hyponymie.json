                "senses": [
                    {
                        "sense_id": "40e17986-3827-37eb-b073-49074832b8bd",
                        "entry_id": "345d04da-c299-355b-af97-245e18ebfa56",
                        "glosses": [
                            "Hyponymie, relation sémantique entre des mots, dont un, l'hyponyme est subordonné à l’autre car une relation d'importance."
                        ],
                        "tags": [
                            "Sémantique lexicale"
                        ],
                        "examples": [
                            {
                                "example_id": "2f95eba0-b123-44b4-a1c0-7c1a9d8af081",
                                "sense_id": "40e17986-3827-37eb-b073-49074832b8bd",
                                "text": "Zwischen den Wörtern Tanne und Baum besteht die Bedeutungsbeziehung der Hyponymie, da \"Tanne\" eine besondere Art von \"Baum\" ist. — Entre les mots de sapin et arbre, s'établit une relation d'hyponymie, parce que « sapin » d’un type particulier « d’arbre »."
                            }
                        ]
                    }
