                "senses": [
                    {
                        "sense_id": "e68bce26-8565-3598-90bc-7b7708605686",
                        "entry_id": "c41dd841-7825-3272-974d-0ae4921f52c7",
                        "glosses": [
                            "szybka, cięta i trafna odpowiedź"
                        ],
                        "tags": [],
