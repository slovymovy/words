                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a86faef-e7c9-462d-8643-7560bc8ee9a3",
                                                "sense_id": "e5acedc9-273a-3632-9b9d-71e9c073d8ab",
                                                "text": "Claimants of unemployment benefits will see the biggest fall in the value of their payments in 50 years on Monday, anti-poverty campaigners have said, as Britons grapple with the worst cost of living crisis since 1972."
                                            }
                                        ]
                                    }
                                ]
