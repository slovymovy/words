                "forms": [
                    {
                        "form_id": "00fb96d0-3605-4a1e-8511-c6490867a137",
                        "entry_id": "8162e52f-35c6-306a-a846-0fb0b852553c",
                        "tags": [
                            "plural"
                        ],
                        "form": "firestorms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7141f8e-889e-3dcb-bae3-45a638e65fef",
                        "entry_id": "8162e52f-35c6-306a-a846-0fb0b852553c",
                        "glosses": [
                            "A fire whose intensity is greatly increased by inrushing winds."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0ce4e757-87c8-3720-abe6-614c0bf28e40",
                        "entry_id": "8162e52f-35c6-306a-a846-0fb0b852553c",
                        "glosses": [
                            "An intense or violent altercation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "409f6c2a-4f60-46bb-8cf4-55c2a5b670e9",
                                "sense_id": "0ce4e757-87c8-3720-abe6-614c0bf28e40",
                                "text": "In the print firestorm that followed the publication of the royal couple's letters, the generalissima was one polemical touchstone. The Annotations to The Kings Cabinet Opened itself depicted the queen as an enemy to king and country: […]"
                            },
                            {
                                "example_id": "e7f3555c-5f1b-4278-bc47-d20fbc46ecd6",
                                "sense_id": "0ce4e757-87c8-3720-abe6-614c0bf28e40",
                                "text": "This past weekend, Rabbi Shmuley Boteach set off a firestorm with his full-page ad in the New York Times accusing National Security Adviser Susan E. Rice of turning a blind eye to the Rwandan genocide when she was on President Bill Clinton’s national security team in the 1990s."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8b7d87b-833d-4aa2-810e-fff58b30f09e",
                        "source_entry_id": "8162e52f-35c6-306a-a846-0fb0b852553c",
                        "source_sense_description": "Fire intensity greatly increased by winds",
                        "target_lang_word": "Feuersturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuersturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ec46e6-a681-3c47-9136-156688b3bb30",
                                        "entry_id": "f210995c-243d-3708-97a1-7d2b47053a30",
                                        "glosses": [
                                            "extreme Luftbewegung durch einen verheerenden Brand, der immer neue frische Luft ansaugt und sich dadurch selbst verstärkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688357fd-fb3c-40e1-b923-b83ffc0ceceb",
                                                "sense_id": "a3ec46e6-a681-3c47-9136-156688b3bb30",
                                                "text": "„960 Flugzeuge sollten in drei Wellen Spreng- und Phosphorbomben abwerfen und einen Feuersturm entfachen.“"
                                            },
                                            {
                                                "example_id": "90ea0b2d-bb84-4c57-bbe3-112cf93468a1",
                                                "sense_id": "a3ec46e6-a681-3c47-9136-156688b3bb30",
                                                "text": "„Vom Westen her mischen sich ins letzte Tageslicht schon die Fackeln der Nacht: Gehöfte oder ganze Dörfer, die im Feuersturm versinken.“"
                                            },
                                            {
                                                "example_id": "c192f20a-6d2c-4fd2-aa30-3bae04acf27e",
                                                "sense_id": "a3ec46e6-a681-3c47-9136-156688b3bb30",
                                                "text": "„Es entstand ein Feuersturm wie im Juli 1943 in Hamburg und vier Wochen zuvor in Dresden.“"
                                            },
                                            {
                                                "example_id": "b6909319-a560-4192-a4f9-5d832251f900",
                                                "sense_id": "a3ec46e6-a681-3c47-9136-156688b3bb30",
                                                "text": "„Es gab Feuersbrünste und Feuerwände und Feuerstürme, es gab feurige Tote, und es gab feurige Verletzte, die schreiend aus den Häusern brachen und rasend im Kreise rannten, bis sie niederstürzten und krochen und heiser fauchten und dann nur noch zuckten und röchelten und nach verbranntem Fleisch stanken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
