                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daa41b2c-9dd2-467a-a070-c9833421a3d4",
                                "sense_id": "b8df0ee8-ffc0-3198-a889-e19a22487198",
                                "text": "C’était le bahutier en livraison, le raquetier qu’elle avait vu au jeu de paume, un trompette qui lui avait autrefois rapporté des lettres de son prince, le jardinier de Saulrupt qui devait s’arroser le gosier plus souvent que les plants de Son Altesse."
                            },
                            {
                                "example_id": "c0c5b2c2-2a91-4a7e-bbef-d20db19cdf19",
                                "sense_id": "b8df0ee8-ffc0-3198-a889-e19a22487198",
                                "text": "C’était alors l’époque des tripots, nom qui alternait avec celui de jeux de paume, l’époque des tripotiers, des paumiers et des raquetiers."
                            }
                        ]
                    }
