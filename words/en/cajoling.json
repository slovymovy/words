    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a8c62e2-fca6-32fa-90f0-9d6d0121c6b7",
                    "sense_definition": "present participle and gerund of <w>cajole</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The zookeeper was <w>cajoling</w> the lion back into its cage.",
                            "target_lang_translations": {
                                "de": "Der Tierpfleger <w>redete</w> dem Löwen gut <w>zu</w>, um ihn zurück in seinen Käfig zu bewegen."
                            }
                        },
                        {
                            "text": "She spent the whole morning <w>cajoling</w> him into coming to the party.",
                            "target_lang_translations": {
                                "de": "Sie verbrachte den ganzen Vormittag damit, ihn zur Party zu <w>überreden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "coaxing",
                        "wheedling"
                    ],
                    "common_phrases": [
                        "cajoling into"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „cajole“; jemanden mit Schmeicheleien oder sanfter Überredungskunst zu etwas bringen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beschwatzen",
                                "target_lang_sense_clarification": "jemanden mit Worten überreden"
                            },
                            {
                                "target_lang_word": "überreden",
                                "target_lang_sense_clarification": "durch Zureden dazu bringen, etwas zu tun"
                            },
                            {
                                "target_lang_word": "gut zureden",
                                "target_lang_sense_clarification": "freundlich überzeugen oder beruhigen"
                            },
                            {
                                "target_lang_word": "schmeicheln",
                                "target_lang_sense_clarification": "durch Schmeichelei bewegen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb5556d6-83ed-3548-92a4-4c225bcbf08b",
                    "sense_definition": "The act of persuading someone by flattery or gentle urging.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Threats and gentle <w>cajoling</w> failed to convince her to change her mind.",
                            "target_lang_translations": {
                                "de": "Drohungen und sanftes <w>Zureden</w> konnten sie nicht dazu bewegen, ihre Meinung zu ändern."
                            }
                        },
                        {
                            "text": "After much <w>cajoling</w>, he finally agreed to sign the contract.",
                            "target_lang_translations": {
                                "de": "Nach vielem <w>Schmeicheln</w> erklärte er sich schließlich bereit, den Vertrag zu unterschreiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "coaxing",
                        "cajolery",
                        "wheedling",
                        "flattery"
                    ],
                    "common_phrases": [
                        "gentle cajoling",
                        "much cajoling"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Überreden oder Bewegen von jemandem durch Schmeicheleien oder beharrliches, sanftes Zureden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Schmeichelei",
                                "target_lang_sense_clarification": "das Schmeicheln zum Zweck der Überredung"
                            },
                            {
                                "target_lang_word": "das Zureden",
                                "target_lang_sense_clarification": "das Überzeugen durch beharrliches Sprechen"
                            },
                            {
                                "target_lang_word": "die Überredung",
                                "target_lang_sense_clarification": "das Überzeugen durch Schmeicheln oder Worte"
                            },
                            {
                                "target_lang_word": "die Bauchpinselei",
                                "target_lang_sense_clarification": "umgangssprachlich für schmeichelndes Überreden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}