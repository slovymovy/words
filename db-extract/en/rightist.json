                "senses": [
                    {
                        "sense_id": "79a2d41f-fc92-36fb-b414-748486dfd240",
                        "entry_id": "14c9c543-7256-398d-9a43-3f98ec7c3fa0",
                        "glosses": [
                            "One who believes in the politics or policies of the political right."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b524b3-ee09-430c-a0a0-bbb374c1cf33",
                                "sense_id": "79a2d41f-fc92-36fb-b414-748486dfd240",
                                "text": "To summarize: on the average, rightists are made more anxious by ambiguity and have a stronger need for closure, dislike novelty, are more comforted by structure and hierarchy, more readily perceive circumstances as threatening, and are more parochial in their empathy."
                            }
                        ]
                    },
                    {
                        "sense_id": "b31e640e-42dc-3665-9f8a-401c46bc831e",
                        "entry_id": "14c9c543-7256-398d-9a43-3f98ec7c3fa0",
                        "glosses": [
                            "One who supports the rights of a specified group."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "5ebed41c-6b68-42de-99b9-19c656bcd96e",
                                "sense_id": "b31e640e-42dc-3665-9f8a-401c46bc831e",
                                "text": "an animal rightist"
                            }
                        ]
                    }
                ],
