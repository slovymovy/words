                        "examples": [
                            {
                                "example_id": "3137e44f-f7f8-4132-942a-f3446f41885a",
                                "sense_id": "e6df7eed-9d3b-35d2-b847-166cd49d4340",
                                "text": "„Unfallchirurgin Stella Prosquill hat in ihrer Ordination bisher noch keinen Patienten erlebt, bei dem die Stoßwellentherapie gar nicht funktioniert hat, sie warnt jedoch vor falscher Hoffnung: \"Es gibt ganz klare Richtlinien und eindeutige Krankheitsbilder, bei denen Stoßwellen angewandt werden können.\"“"
                            },
                            {
                                "example_id": "bdcd8189-490b-4d1b-b79a-c1e1e220c9a4",
                                "sense_id": "e6df7eed-9d3b-35d2-b847-166cd49d4340",
                                "text": "„Zehn Jahre an Forschung hat die Unfallchirurgin Annelie-Martina Weinberg in ihre Entwicklung investiert.“"
                            }
                        ],
