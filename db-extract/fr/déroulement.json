                                        "sense_id": "274486b7-aefd-365a-91b9-f3a2590791c5",
                                        "entry_id": "b4d228f6-633f-38dc-b4aa-f68f10166278",
                                        "glosses": [
                                            "The process by which something unfolds or becomes revealed."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often"
