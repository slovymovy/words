                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                        "entry_id": "4647b093-7318-3091-8a21-85400bc768d0",
                                        "glosses": [
                                            "Hauptstadt von Island"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a4c7e9-555e-456b-879f-40451a2739b4",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "Meine letzten Sommerferien verbrachte ich in Reykjavík."
                                            },
                                            {
                                                "example_id": "0fde356e-ee62-4048-a3aa-49f73b9a09f4",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "„Zurück in Reykjavík kämpfe ich mich durch einen heftigen Sturm…“"
                                            },
                                            {
                                                "example_id": "d70de014-25e2-4f43-99e2-1a7632b5ce3e",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "„Ich fahre zu schnell, als dass ich mich auf die Schönheit Reykjavíks konzentrieren könnte - denn man hat mir gesagt, bisweilen sei die Stadt auf ihre besondere Art schön, obwohl mir das noch nie aufgefallen ist.“"
                                            },
                                            {
                                                "example_id": "bb118d9b-ece7-46d6-8fa0-d47c9618f2ff",
                                                "sense_id": "c6f6ee0e-31bb-303d-9304-302db108d990",
                                                "text": "„Die meisten stellen sich Reykjavík vermutlich als ein hutzeliges Dorf vor, mit rauchenden Schornsteinen und beschlagenen Fensterscheiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
