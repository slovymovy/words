                        "glosses": [
                            "D'une manière pluvieuse ; d'une manière déterminée par un temps pluvieux."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0b06a83b-e58f-4008-8830-0f20194e62b4",
                                "sense_id": "b5c650fe-aa86-3d66-9057-a2833a340416",
                                "text": "Les deux tours montent vers un ciel bas, pluvieusement nocturne. Le parvis mouillé, où les réverbères se reflètent, reluit comme un fleuve."
                            },
                            {
                                "example_id": "dc2ea0b0-d322-41e3-9cf0-059cfc754e89",
                                "sense_id": "b5c650fe-aa86-3d66-9057-a2833a340416",
                                "text": "Aux coins d'autres quais, des chapelets de pêcheurs semaient fils et bouchons un peu partout dans la Seine pluvieusement engrossie et limoneuse."
                            },
                            {
                                "example_id": "84a67a82-d91d-4a4d-897a-599525a9bbe5",
                                "sense_id": "b5c650fe-aa86-3d66-9057-a2833a340416",
                                "text": "Pleuvait-il, un jour qu’il méditait sur les raisons qui avaient poussé le président San Juan à le trahir, le mécontentement du colonel devenait une pluie interminable et tous ses souvenirs s’écoulaient pluvieusement autour de lui."
                            }
                        ]
                    }
