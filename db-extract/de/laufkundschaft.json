                        "entry_id": "975f795f-7ce0-3baf-96f4-9ae2c92c3c1a",
                        "glosses": [
                            "nicht ständig oder gewohnheitsmäßig in einem Geschäft einkaufende oder einen Dienstleister in Anspruch nehmende Personengruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf437956-8368-41d3-86ef-80870a991a03",
                                "sense_id": "6e45d21b-bf1f-3a69-8be9-7b44f1bad167",
                                "text": "„Ihre Kunden seien nicht nur Saunagäste gewesen; es habe sich auch Laufkundschaft darunter befunden.“"
                            },
                            {
                                "example_id": "60ebafba-e689-41b6-bb9a-f8b8dd1ee0d2",
                                "sense_id": "6e45d21b-bf1f-3a69-8be9-7b44f1bad167",
                                "text": "„Wenn der Mann nur Laufkundschaft wäre, würde er sie nicht mit Namen ansprechen.“"
                            },
                            {
                                "example_id": "b6deee45-27ea-43ec-92bd-abaec7c7915c",
                                "sense_id": "6e45d21b-bf1f-3a69-8be9-7b44f1bad167",
                                "text": "„Die Knödelköchin verkaufte an Laufkundschaft handfeste Knödel (einen großen Semmelknödel um einen Kreuzer, aber auch Kirschen- oder Zwetschkenknödel).“"
                            }
                        ],
