                        "entry_id": "360c1657-ed0e-3e45-b906-465215d98795",
                        "glosses": [
                            "Écoulement rejeté hors de quelque lieu (sans altération particulière)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674f8294-27d3-4140-b888-6762e7982eca",
                                "sense_id": "18866337-8391-379d-94d9-efa282bb3e62",
                                "text": "La collecte des eaux résiduaires, pluviales et tout type d’effluent."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf1d0c0a-dfbe-3a26-803a-282bd4d283aa",
                        "entry_id": "360c1657-ed0e-3e45-b906-465215d98795",
                        "glosses": [
                            "Écoulement, contaminé, pollué ou autrement altéré, rejeté sous forme liquide (effluent liquide, eaux usées) ou gazeuse (effluent gazeux)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ff3b92-06f4-4466-9f21-9cebe99afe1a",
                                "sense_id": "cf1d0c0a-dfbe-3a26-803a-282bd4d283aa",
                                "text": "Le traitement des effluents industriels."
                            },
                            {
                                "example_id": "b0cd5689-9da3-4962-ad1b-41af1c02e092",
                                "sense_id": "cf1d0c0a-dfbe-3a26-803a-282bd4d283aa",
                                "text": "Effluent radioactif, liquide ou gaz radioactif dégagé dans une opération quelconque."
                            },
                            {
                                "example_id": "95359cde-43b6-4914-9f93-05033bc15810",
                                "sense_id": "cf1d0c0a-dfbe-3a26-803a-282bd4d283aa",
                                "text": "Une installation septique permet le traitement des eaux usées et en évacue l’effluent dans les eaux souterraines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8214a38-ef02-4a8d-9b10-4d964d9a13ba",
                        "source_entry_id": "360c1657-ed0e-3e45-b906-465215d98795",
