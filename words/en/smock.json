    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d4867ad-027a-328f-9492-5205167be734",
                    "sense_definition": "A loose protective garment worn over clothes, often by artists or workers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "garment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist wore a paint-stained <w>smock</w> while working on the large canvas.",
                            "target_lang_translations": {
                                "pl": "Artysta miał na sobie poplamiony farbą <w>kitel</w> podczas pracy nad dużym płótnem."
                            }
                        },
                        {
                            "text": "She put on a protective <w>smock</w> before starting her shift in the laboratory.",
                            "target_lang_translations": {
                                "pl": "Założyła ochronny <w>fartuch</w> przed rozpoczęciem zmiany w laboratorium."
                            }
                        }
                    ],
                    "synonyms": [
                        "apron"
                    ],
                    "common_phrases": [
                        "artists smock"
                    ],
                    "target_lang_definitions": {
                        "pl": "Luźne ubranie ochronne noszone na wierzchu, często przez artystów lub pracowników."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kitel",
                                "target_lang_sense_clarification": "lekkie ubranie ochronne noszone w pracy"
                            },
                            {
                                "target_lang_word": "fartuch",
                                "target_lang_sense_clarification": "odzież ochronna używana w warsztacie lub laboratorium"
                            }
                        ]
                    }
                },
                {
