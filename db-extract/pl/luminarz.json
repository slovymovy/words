                "senses": [
                    {
                        "sense_id": "b89b4785-445c-30b7-a098-24666dbf1fcf",
                        "entry_id": "5dfa5f8c-854c-32b6-a1c5-b7f50ebad296",
                        "glosses": [
                            "człowiek wybitnie wykształcony, znany w kręgach naukowych lub kulturalnych"
                        ],
                        "tags": [],
