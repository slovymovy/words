                        {
                            "text": "Die <w>wahrscheinliche</w> Ursache des Unfalls war überhöhte Geschwindigkeit auf der Autobahn.",
                            "target_lang_translations": {
                                "en": "The <w>likely</w> cause of the accident was excessive speed on the highway.",
                                "ru": "<w>Вероятной</w> причиной аварии было превышение скорости на автобане.",
                                "nl": "De <w>waarschijnlijke</w> oorzaak van het ongeluk was te hoge snelheid op de snelweg.",
                                "pl": "<w>Prawdopodobną</w> przyczyną wypadku była nadmierna prędkość na autostradzie.",
                                "fr": "La cause <w>probable</w> de l'accident était une vitesse excessive sur l'autoroute.",
                                "it": "La <w>probabile</w> causa dell'incidente è stata la velocità eccessiva in autostrada.",
                                "cs": "<w>Pravděpodobnou</w> příčinou nehody byla nepřiměřená rychlost na dálnici.",
                                "tr": "Kazanın <w>muhtemel</w> nedeni otoyoldaki aşırı hızdı.",
                                "es": "La <w>probable</w> causa del accidente fue el exceso de velocidad en la autopista.",
                                "zh": "事故<w>可能的</w>原因是高速公路上的超速驾驶。"
                            }
                        },
                        {
                            "text": "Es ist sehr <w>wahrscheinlich</w>, dass das Konzert wegen des starken Regens ausfällt.",
                            "target_lang_translations": {
                                "en": "It is very <w>likely</w> that the concert will be cancelled because of the heavy rain.",
                                "ru": "Очень <w>вероятно</w>, что концерт отменят из-за сильного дождя.",
                                "nl": "Het is zeer <w>waarschijnlijk</w> dat het concert vanwege de zware regen wordt afgelast.",
                                "pl": "Jest bardzo <w>prawdopodobne</w>, że koncert zostanie odwołany z powodu ulewnego deszczu.",
                                "fr": "Il est très <w>probable</w> que le concert soit annulé en raison de la forte pluie.",
                                "it": "È molto <w>probabile</w> che il concerto venga annullato a causa della forte pioggia.",
                                "cs": "Je velmi <w>pravděpodobné</w>, že bude koncert kvůli silnému dešti zrušen.",
                                "tr": "Şiddetli yağmur yüzünden konserin iptal olması çok <w>muhtemel</w>.",
                                "es": "Es muy <w>probable</w> que el concierto se cancele debido a la fuerte lluvia.",
                                "zh": "由于大雨，音乐会被取消是极<w>可能的</w>。"
                            }
                        }
