                        "glosses": [
                            "Nom donné aux fenêtres de toit, même si elles ne sont pas de la marque Velux®."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb79900b-30d7-4da4-a363-e0d865f3c35c",
                                "sense_id": "c06b4643-c470-3df1-9f04-5cb63a5aec58",
                                "text": "Le soir venu, quand Anthony faisait un dernier tour à vélo dans son quartier, il pouvait renifler l’odeur de cette came si spéciale qui filtrait par les velux entrouverts."
                            }
                        ]
                    },
