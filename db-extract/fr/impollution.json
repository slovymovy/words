                        "examples": [
                            {
                                "example_id": "477b0ec2-9f08-44e1-81cf-18868105dd3a",
                                "sense_id": "5e5338ae-3421-3a68-be9a-1d022d074a41",
                                "text": "Gide a-t-il raison d'associer la valorisation poétique de la montagne à la morale calviniste suisse ? (goût de la pureté, ou plutôt de l´impollution, que souligne la phobie protestante du microbe – valeur morale de l'ascension, de l'effort vers les cimes)."
                            },
                            {
                                "example_id": "144bd6c6-0eca-42fe-84a1-c0d679cab02b",
                                "sense_id": "5e5338ae-3421-3a68-be9a-1d022d074a41",
                                "text": "Comment concilier avec cette condition primordiale [un prix bas] l'exigence des garanties de propreté, de pureté, d´impollution sans quoi il [le lait] devient le véhicule et le propagateur de quelques-unes des pires maladies qui affligent l'humanité ?"
                            }
                        ]
                    }
