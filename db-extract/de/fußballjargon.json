                ],
                "senses": [
                    {
                        "sense_id": "d73b73e4-b174-32a7-9fb8-8a996595ebcc",
                        "entry_id": "173e7ac0-ef18-3653-82e6-b1f8fc5d2e52",
                        "glosses": [
                            "Sondersprache mit speziellem Wortschatz, die in Äußerungen über Themen aus dem Bereich des Fußballs benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f21bb1-5f5d-48cd-bdab-b0f03642dcad",
                                "sense_id": "d73b73e4-b174-32a7-9fb8-8a996595ebcc",
                                "text": "„Mitunter sind Heinrichs zeitgeschichtliche Wertungen etwas unklar, zumal dann, wenn er allzu ballverliebt dem Fußballjargon anhängt.“"
                            },
                            {
                                "example_id": "61fe1407-ff29-44c4-b816-48f395f06fba",
                                "sense_id": "d73b73e4-b174-32a7-9fb8-8a996595ebcc",
                                "text": "„Eigentlich, so wähnte man, sollte die bundesdeutsche Mannschaft spielen, und nun war die DDR-Elf da und dies wegen eines Mannes, der Sparwasser heißt und Herrn Maier aus München in Hamburg den Ball in die Maschen gejagt hatte, wie es früher im Fußballjargon hieß.“"
                            },
                            {
                                "example_id": "24c3c2b7-110c-457b-aac4-abc764b3d91c",
                                "sense_id": "d73b73e4-b174-32a7-9fb8-8a996595ebcc",
                                "text": "„In der Sondersprache Fußballjargon entstand im Laufe der Zeit eine Vielzahl von Metaphern, also von Begriffen, die aus anderen Bereichen der deutschen Sprache hierher übertragen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
