                ],
                "senses": [
                    {
                        "sense_id": "77228767-cc0d-3431-a0a8-fc2c2d9a10d3",
                        "entry_id": "8f045442-ae2d-34cb-aa79-2c5e1f43a971",
                        "glosses": [
                            "Block aus Gold mit einem bestimmten Gewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f999501-34c7-4324-9175-63c529ba6c0b",
                                "sense_id": "77228767-cc0d-3431-a0a8-fc2c2d9a10d3",
                                "text": "Die Geldanlage in zinslosen Münzen und Goldbarren soll der Krisensicherung dienen."
                            },
                            {
                                "example_id": "c86c1058-8d8d-4b08-93e8-5b835c8cd924",
                                "sense_id": "77228767-cc0d-3431-a0a8-fc2c2d9a10d3",
                                "text": "Wer Goldbarren zu Anlagezwecken kauft, ist mit größeren Gewichten gut beraten."
                            },
                            {
                                "example_id": "2ffa8f0b-6ae9-4d00-a617-b22eab357c24",
                                "sense_id": "77228767-cc0d-3431-a0a8-fc2c2d9a10d3",
                                "text": "„Im 16. Jahrhundert berichtet ein marokkanischer Besucher Timbuktus, dass der Herrscher der Stadt über einen riesigen Schatz aus enormen Goldbarren verfüge, über 3000 berittene Soldaten und unzählige Fußtruppen.“"
                            },
                            {
                                "example_id": "36635886-5567-4695-91e5-c2cf90b23fbf",
                                "sense_id": "77228767-cc0d-3431-a0a8-fc2c2d9a10d3",
                                "text": "„Er gehörte dahin wie ein Goldbarren in einen Aschehaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
