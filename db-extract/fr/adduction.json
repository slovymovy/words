                    }
                ],
                "senses": [
                    {
                        "sense_id": "204e11e4-7472-3357-9638-9a19d009e208",
                        "entry_id": "b581ae8d-9ca4-3fca-a0f2-cd98cfc73bc2",
                        "glosses": [
                            "Action d’amener."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db947c73-c49a-4326-80b8-01d18c3889a2",
                                "sense_id": "204e11e4-7472-3357-9638-9a19d009e208",
                                "text": "L’adduction des eaux d’une source."
                            },
                            {
                                "example_id": "30a3581f-4f71-4e78-b83a-762dbf5d8cf4",
                                "sense_id": "204e11e4-7472-3357-9638-9a19d009e208",
                                "text": "La privatisation de la gestion des réseaux d’adduction d’eau est l’une des solutions pour relancer ce secteur."
                            },
                            {
                                "example_id": "02e9cc8f-f4f2-42de-a4b9-c4ac729b8e4b",
                                "sense_id": "204e11e4-7472-3357-9638-9a19d009e208",
                                "text": "Place à une nouvelle architecture électrique redondée, de nouveaux groupes électrogènes, une double adduction réseau vers Londres et bien sûr le refroidissement OVH « in-house », soit la panoplie classique du datacenter OVH."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2008475-90e9-30f6-be2c-7eebf04be2a7",
                        "entry_id": "b581ae8d-9ca4-3fca-a0f2-cd98cfc73bc2",
                        "glosses": [
                            "Action des muscles adducteurs."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6117cd4a-867d-34ba-9aa2-ae77a64630a2",
                        "entry_id": "b581ae8d-9ca4-3fca-a0f2-cd98cfc73bc2",
                        "glosses": [
                            "Action des muscles adducteurs.",
                            "Rapprochement d’un membre vers l’axe sagittal du corps."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8482103-4031-4ec6-bfeb-6e4d785cbef4",
