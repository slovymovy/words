                "senses": [
                    {
                        "sense_id": "b0bcb540-7682-3618-83d8-a422a799f41e",
                        "entry_id": "1fc985df-d4f2-3402-9400-8af6c0551d73",
                        "glosses": [
                            "außerhalb eines Gebäudes befindliche Treppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56cb1a9c-31a2-478e-b208-7acf82b8a3b9",
                                "sense_id": "b0bcb540-7682-3618-83d8-a422a799f41e",
                                "text": "„Jetzt versank man […] in den laubgedüngten, sumpfartigen Boden und hatte Mühe die ausgetretenen Spuren der in den Felsen gehauenen Freitreppe zu finden […].“"
                            },
                            {
                                "example_id": "48d48fab-d36f-4721-9840-27b22dcd57e3",
                                "sense_id": "b0bcb540-7682-3618-83d8-a422a799f41e",
                                "text": "„Perlmann setzte die Sonnenbrille auf, grüßte mit einer knappen Handbewegung und ohne den Schritt zu verlangsamen, und ging die Freitreppe hinunter.“"
                            },
                            {
                                "example_id": "d98b93d7-da67-434d-8c76-bc22c54e790a",
                                "sense_id": "b0bcb540-7682-3618-83d8-a422a799f41e",
                                "text": "„Geschirr wird auf der Freitreppe so reichlich zerschlagen, als sei es im Überfluß vorhanden wie je.“"
                            },
                            {
                                "example_id": "57c5c088-1cdd-492f-8529-dd8bd13bb3c4",
                                "sense_id": "b0bcb540-7682-3618-83d8-a422a799f41e",
                                "text": "„Nach einer Stunde war die ganze Jagdgesellschaft vor der Freitreppe versammelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8f4b5b6-f517-3556-aeff-fb50612f5600",
                        "entry_id": "1fc985df-d4f2-3402-9400-8af6c0551d73",
                        "glosses": [
                            "prächtige und repräsentative Treppenanlage, die einem Gebäude vorgelagert ist und – häufig von zwei Seiten – zum Hauptportal hinaufführt, wo sie ein Podest bildet"
                        ],
                        "tags": [
                            "in der Architektur insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "e3d35bfb-bf3e-4627-b53b-04658b034773",
                                "sense_id": "c8f4b5b6-f517-3556-aeff-fb50612f5600",
                                "text": "„Perlmann setzte die Sonnenbrille auf, grüßte mit einer knappen Handbewegung und ohne den Schritt zu verlangsamen, und ging die Freitreppe hinunter.“"
                            },
                            {
                                "example_id": "70bfdfe0-3846-4575-9c07-09ab5da69b38",
                                "sense_id": "c8f4b5b6-f517-3556-aeff-fb50612f5600",
                                "text": "„Geschirr wird auf der Freitreppe so reichlich zerschlagen, als sei es im Überfluß vorhanden wie je.“"
                            },
                            {
                                "example_id": "92dda0bc-e679-41bb-af2a-b9689c2c288d",
                                "sense_id": "c8f4b5b6-f517-3556-aeff-fb50612f5600",
                                "text": "„Nach einer Stunde war die ganze Jagdgesellschaft vor der Freitreppe versammelt.“"
                            },
                            {
                                "example_id": "a8ed0d86-76b5-46ed-86a6-7d3530faeafd",
                                "sense_id": "c8f4b5b6-f517-3556-aeff-fb50612f5600",
                                "text": "„Der Eingang mit der Freitreppe war hell erleuchtet.“"
                            },
                            {
                                "example_id": "18e935ba-ac07-4f1e-a4d9-feb2a8539491",
                                "sense_id": "c8f4b5b6-f517-3556-aeff-fb50612f5600",
                                "text": "„Nach der Abendandacht rannten sie über die große Freitreppe in die Schrankzimmer hinunter, hängten ihre Anzüge weg und sausten in den langen Nachthemden wieder treppauf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
