                ],
                "senses": [
                    {
                        "sense_id": "e21478e7-940c-3ac9-8145-2ff991685b40",
                        "entry_id": "431d2f32-f9d5-3cd6-9a1d-da8af15f22ba",
                        "glosses": [
                            "тот, кто вдохновляет, воодушевляет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad67513-3658-495a-981e-243c217cf304",
                                "sense_id": "e21478e7-940c-3ac9-8145-2ff991685b40",
                                "text": "А ты цвети, певец, наш вдохновитель, // Младый душой под снегом старых дней"
                            }
                        ]
                    },
                    {
                        "sense_id": "28dc1b62-1e71-3141-aca7-664619ef748d",
                        "entry_id": "431d2f32-f9d5-3cd6-9a1d-da8af15f22ba",
                        "glosses": [
                            "разг. инициатор, зачинщик"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c70c787-a907-4f26-87c2-457b21cbd809",
                        "source_entry_id": "431d2f32-f9d5-3cd6-9a1d-da8af15f22ba",
                        "target_lang_word": "mastermind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastermind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaaca12-6ca3-3dfa-8cd5-aa23b54be5c4",
                                        "entry_id": "32203b00-a9ab-3bf0-9444-2ab7c2b539c6",
                                        "glosses": [
                                            "A person with an extraordinary intellect or skill that is markedly superior to their peers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e834ae5-a12f-4664-9213-f24c83573dc6",
                                                "sense_id": "eeaaca12-6ca3-3dfa-8cd5-aa23b54be5c4",
                                                "text": "At long intervals some master-minds appeared, looking upon each advance in practical science as a retro-gradation in the true utility."
                                            },
                                            {
                                                "example_id": "9981d7c0-b6cb-4513-9ebb-2b039fcb7eb5",
                                                "sense_id": "eeaaca12-6ca3-3dfa-8cd5-aa23b54be5c4",
                                                "text": "His first outside hire wasn't an electronics whiz or a mechanical mastermind, but a young industrial designer, a creature hitherto unknown at DEKA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52022125-b8ef-34d8-bb2d-0e1011d51e8b",
                                        "entry_id": "32203b00-a9ab-3bf0-9444-2ab7c2b539c6",
                                        "glosses": [
                                            "A person responsible for the highest level of planning and execution of a major operation."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed42e11f-8f50-4646-8268-cccd4329e26d",
                                                "sense_id": "52022125-b8ef-34d8-bb2d-0e1011d51e8b",
                                                "text": "The first was with none other than Khalid Sheikh Mohammad (KSM), mastermind of the 9/11 attacks."
                                            },
                                            {
                                                "example_id": "952f1a37-d4f2-43e8-b210-07da5054a277",
                                                "sense_id": "52022125-b8ef-34d8-bb2d-0e1011d51e8b",
                                                "text": "Prosecutors later suspected that Wang, chairman of Ciji Temple in Tainan's Syuejia District, was the mastermind behind the shootings, but the court acquitted him of the charge because of insufficient evidence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mastermind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6dfe73-1156-3c60-81b7-9d5ede22b203",
                                        "entry_id": "07e00545-fe1c-37c5-aa9f-4fe20c36b935",
                                        "glosses": [
                                            "To act in the role of mastermind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44e09cc-8868-4cbb-ab15-09428976bcd4",
                                                "sense_id": "6c6dfe73-1156-3c60-81b7-9d5ede22b203",
                                                "text": "It would later be revealed that the corporation contributed over a quarter of a million dollars to the effort—a whopping 93 percent of the total coffer—and hired a team of media and political experts to mastermind it."
                                            },
                                            {
                                                "example_id": "7aa5d96c-f6e1-48b2-a10b-555ed7a2e9bf",
                                                "sense_id": "6c6dfe73-1156-3c60-81b7-9d5ede22b203",
                                                "text": "Travelling over the route today, it is well to remember the ongoing role of the Friends of the S&C and the work of the late Ron Cotton. He masterminded its revival, thereby reversing the role he had been given by BR to bring about its closure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
