{
    "word_family": [
        "insouciance",
        "insouciant",
        "insoucieusement",
        "souci",
        "soucieux"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "83ade4cc-3317-365e-a38c-2cfcaf6980a8",
                    "sense_definition": "Prendre intérêt à quelqu'un ou à quelque chose, s'en inquiéter ou y attacher de l'importance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inquietude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle ne se <w>soucie</w> pas du regard des autres lorsqu'elle prend la parole en public."
                        },
                        {
                            "text": "Tu devrais te <w>soucier</w> davantage de ta santé et consulter un médecin sans tarder."
                        }
                    ],
                    "common_phrases": [
                        "ne se soucier de rien",
                        "se soucier de l'avenir"
                    ]
                },
                {
                    "sense_id": "1b269978-89ab-3094-b50f-d32ed49582b4",
                    "sense_definition": "N'attacher aucune importance à quelque chose ou à quelqu'un, s'en moquer complètement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "indifference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>soucie</w> bien de son avis, il peut dire tout ce qu'il veut !"
                        },
                        {
                            "text": "Elle se <w>souciait</w> bien de leurs remarques et continuait son travail sans les écouter."
                        }
                    ],
                    "common_phrases": [
                        "se soucier bien de"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé par antiphrase, souvent avec « bien »"
                        }
                    ]
                },
                {
                    "sense_id": "aa4d4deb-5ddc-3417-bb81-37cefb0849ed",
                    "sense_definition": "Causer du souci, de l'inquiétude ou du tourment à quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inquietude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette étrange nouvelle le <w>souciait</w> depuis le matin sans qu'il pût s'en détacher."
                        },
                        {
                            "text": "Rien ne semblait pouvoir <w>soucier</w> cet homme d'un naturel toujours calme et réfléchi."
                        }
                    ],
                    "synonyms": [
                        "préoccuper"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vieilli dans l'usage transitif direct"
                        }
                    ]
                }
            ]
        }
    ]
}