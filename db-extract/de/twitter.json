        "de-extract.jsonl": [
            {
                "entry_id": "dab6580f-a474-364d-a85b-de0da1c81c14",
                "word": "Twitter",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "badf06d0-8d4b-411c-91fe-79b2e818562f",
                        "entry_id": "dab6580f-a474-364d-a85b-de0da1c81c14",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "Twitters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce08aa25-7bb2-3bdf-b9a9-251062a1090c",
                        "entry_id": "dab6580f-a474-364d-a85b-de0da1c81c14",
                        "glosses": [
                            "ein Internetdienst zur schnellen Übermittlung von Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61415ba8-d47f-4029-86d3-4212e48ad03c",
                                "sense_id": "ce08aa25-7bb2-3bdf-b9a9-251062a1090c",
                                "text": "Die einzelnen Beiträge in Twitter heißen Tweets."
                            },
                            {
                                "example_id": "e1bd561e-2269-4007-81b9-237f6214653b",
                                "sense_id": "ce08aa25-7bb2-3bdf-b9a9-251062a1090c",
                                "text": "„Twitter ist das derzeit wohl am schnellsten wachsende soziale Netzwerk und eine Mischung aus Kurznachrichten, Blogeinträgen und Chats.“"
                            },
                            {
                                "example_id": "38cfb2b1-1234-4aeb-aed3-89fbcd3d77fb",
                                "sense_id": "ce08aa25-7bb2-3bdf-b9a9-251062a1090c",
                                "text": "„Seitdem Steinbach sich bei Twitter angemeldet hat, sind ihre Möglichkeiten, andere zu reizen, quasi unbegrenzt.“"
                            },
                            {
                                "example_id": "24e43118-df3c-4a8e-9350-d2a96dfb1de4",
                                "sense_id": "ce08aa25-7bb2-3bdf-b9a9-251062a1090c",
                                "text": "„Verwundert schütteln meine Eltern den Kopf, wenn ich ihnen von E-Mail, Skype, Twitter und Facebook erzähle.“"
                            },
                            {
                                "example_id": "5a6658b5-14ec-48c3-938c-11e3d26328a5",
                                "sense_id": "ce08aa25-7bb2-3bdf-b9a9-251062a1090c",
                                "text": "„Selbst Donald Trump kommt bei Twitter nicht an sie heran, bei Instagram folgen ihm gerade einmal sechs Millionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf8e5ceb-a183-4f73-b14a-0cd0cea3d1bd",
