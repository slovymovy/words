        "fr-extract.jsonl": [
            {
                "entry_id": "821b5636-c9cd-39cc-a371-7fd663a2104c",
                "word": "glaciologue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "39882e16-0b00-483e-98c4-ff61c3b0838e",
                        "entry_id": "821b5636-c9cd-39cc-a371-7fd663a2104c",
                        "tags": [
                            "plural"
                        ],
