                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c44bed-3ab4-47b0-b2c5-301c0f2e268b",
                                                "sense_id": "c5f35c29-e588-3228-9230-8905bfb60d80",
                                                "text": "De meeste meercellige organismen behoren tot de eukaryoten."
                                            },
                                            {
                                                "example_id": "38c1d00d-9113-4d8a-89c4-2fa84076657f",
                                                "sense_id": "c5f35c29-e588-3228-9230-8905bfb60d80",
                                                "text": "Woese concludeerde na genetisch onderzoek dat bacteriën en archaea twee verschillende domeinen van leven vormen, naast het derde domein, van cellen met complexe celculturen: de eukaryoten."
                                            }
