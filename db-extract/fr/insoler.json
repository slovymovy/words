                ],
                "senses": [
                    {
                        "sense_id": "97ebf35d-2a7a-3855-b1a8-8ca04dc7be6a",
                        "entry_id": "afb41358-1923-348f-9c74-63bd9febf2c0",
                        "glosses": [
                            "Exposer au soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3180e9-e54e-457e-a172-41cb05fb1c7d",
                                "sense_id": "97ebf35d-2a7a-3855-b1a8-8ca04dc7be6a",
                                "text": "Colin et Chloé, l'un près de l'autre, se laissaient insoler sans rien dire et leurs coeurs battaient, tous deux, sur un rythme de boogie."
                            },
                            {
                                "example_id": "ba36e36c-6f5d-446f-b576-217d14bc7507",
                                "sense_id": "97ebf35d-2a7a-3855-b1a8-8ca04dc7be6a",
                                "text": "— J’ai soif, se plaint Mimosa en vacillant sur ses ergots de poulet insolé."
                            }
                        ]
                    },
                    {
                        "sense_id": "831104c7-c6c8-351d-8d5a-26ddd0cff32c",
                        "entry_id": "afb41358-1923-348f-9c74-63bd9febf2c0",
                        "glosses": [
                            "Reporter les motifs dessinés sur un typon transparent sur une plaque à époxy pré-sensibilisée afin de graver ces motifs par la suite, pour la fabrication de circuits imprimés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1945ce73-907c-4b1b-83ac-c7a203ce1c4b",
                                "sense_id": "831104c7-c6c8-351d-8d5a-26ddd0cff32c",
                                "text": "Quoi qu’il en soit, il faudra faire attention à bien superposer les deux faces au moment d’insoler le circuit. Pour l’ensemble des montages nous avons utilisé des plaques époxy pré-sensibilisées de type Barnier de 16 dixièmes."
                            }
                        ]
                    }
