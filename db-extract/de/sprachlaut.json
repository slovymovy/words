                    {
                        "form_id": "996b3eb7-389c-4497-9397-cc28de7f67dc",
                        "entry_id": "fffae9f9-b61b-3ab8-ba3b-8ff71ae284b4",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Sprachlaut"
                    },
                    {
                        "form_id": "96e0a463-164b-4fc4-98eb-fa0b26ee7911",
                        "entry_id": "fffae9f9-b61b-3ab8-ba3b-8ff71ae284b4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sprachlaute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ffda33a-f296-37b1-86b8-726b35ee4f7a",
                        "entry_id": "fffae9f9-b61b-3ab8-ba3b-8ff71ae284b4",
                        "glosses": [
                            "kleinstes Lautsegment der gesprochenen Sprache; Element des Lautsystems einer Sprache."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf16c65-c3eb-45e5-9784-7cee9a171056",
                                "sense_id": "0ffda33a-f296-37b1-86b8-726b35ee4f7a",
                                "text": "In dem Wort \"Bild\" kommen als Sprachlaute des Deutschen vor: [b] + [ɪ] + [l] + [t]."
                            },
                            {
                                "example_id": "e4400428-a69d-45bd-8637-6c0917a36a07",
                                "sense_id": "0ffda33a-f296-37b1-86b8-726b35ee4f7a",
                                "text": "„Etwa zur gleichen Zeit, als Kempelen (um) 1769 seinen »Schachtürken« entwickelte, befasste er sich auch intensiv mit der Idee, zumindest einzelne Sprachlaute in irgendeiner Weise synthetisch zu erzeugen.“"
                            },
                            {
                                "example_id": "996a14ee-f749-48fc-b436-f7cb0a3ba45b",
                                "sense_id": "0ffda33a-f296-37b1-86b8-726b35ee4f7a",
                                "text": "Sprachlaute sind nur segmentiert; um Sprachlaute Phonemen zuordnen zu können, müssen sie noch zusätzlich nach ihrer kommunikativen Funktion klassifiziert werden."
                            },
                            {
                                "example_id": "83ce09cc-6870-4d79-b443-e05e3a7b1b1a",
                                "sense_id": "0ffda33a-f296-37b1-86b8-726b35ee4f7a",
                                "text": "„Ein Sprachlaut (Phon, Laut) unterscheidet sich von einem anderen zum einen durch verschiedene Qualität, das heißt durch verschiedene Klangfarbe (zum Beispiel [a] gegenüber [o]) oder durch Unterschiede im hervorgebrachten Geräusch (zum Beispiel [f] gegenüber [s].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e109473a-ae16-3be1-96dd-5a0a4feb0edf",
                        "entry_id": "fffae9f9-b61b-3ab8-ba3b-8ff71ae284b4",
                        "glosses": [
                            "in der menschlichen Kommunikation genutzter Laut, im Gegensatz zu anderen menschlichen Lauten (z.B. Räuspern, Stöhnen) oder zu Tierlauten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39f2f975-9736-49f7-872d-002174b2da8f",
                                "sense_id": "e109473a-ae16-3be1-96dd-5a0a4feb0edf",
                                "text": "Man muss Sprachlaute von anderen Lauten oder Geräuschen unterscheiden."
                            },
                            {
                                "example_id": "1af2a122-9444-42c7-918e-5476037da014",
                                "sense_id": "e109473a-ae16-3be1-96dd-5a0a4feb0edf",
                                "text": "„Das Alphabet ist also ein sehr ökonomisches und praktisches Mittel zur Wiedergabe der Sprachlaute.“"
                            },
                            {
                                "example_id": "e1944d5b-15c2-4525-a6fd-b3889ea035af",
                                "sense_id": "e109473a-ae16-3be1-96dd-5a0a4feb0edf",
                                "text": "„Elias Canetti erzählt später, dass er auf die Sprache, die er nicht verstand, eifersüchtig war und durch Nachahmung der Sprachlaute versuchte, in diesen Sprachbezirk der Eltern einzudringen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a827cb3d-4715-4115-bcf0-c72bb63853f5",
                        "source_entry_id": "fffae9f9-b61b-3ab8-ba3b-8ff71ae284b4",
                        "source_sense_id": "0ffda33a-f296-37b1-86b8-726b35ee4f7a",
                        "target_lang_word": "phone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                        "entry_id": "79af60ff-0e3f-3809-9a68-84bd7592fa2b",
                                        "glosses": [
                                            "A device for transmitting conversations and other sounds in real time across distances, now often a small portable unit also capable of running software etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed998575-8f7d-4759-a701-514c9b65a2db",
                                                "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                                "text": "Daragh's on the phone at the moment. He'll call you when he's finished."
                                            },
                                            {
                                                "example_id": "e5207909-3890-4461-b3a4-e5e5143ccca7",
                                                "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                                "text": "My phone ran out of battery."
                                            },
                                            {
                                                "example_id": "318f3d33-984d-454d-8718-a39fea120dab",
                                                "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                                "text": "There's an old-fashioned phone in the doctor's waiting room - it doesn't work anymore, of course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e39cdaa-5446-3bbf-9663-a39665d53a7d",
                                        "entry_id": "79af60ff-0e3f-3809-9a68-84bd7592fa2b",
                                        "glosses": [
                                            "A person's telephone number (as a means of contact); digits."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f647c94f-2684-4325-96b6-fcbfb59e4dde",
                                                "sense_id": "6e39cdaa-5446-3bbf-9663-a39665d53a7d",
                                                "text": "It was a clear black night, a clear white moon / Warren G was on the streets tryin' to consume / Some skirts for the eve so I can get some phones / Rollin' in my ride, chillin' all alone"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                        "entry_id": "38e42d31-3d09-34aa-aab8-b0a590266ff5",
                                        "glosses": [
                                            "To call (someone) using a telephone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377ecea2-32e1-47b1-8fcd-133a9cdd060a",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "Phone me as soon as you land at the airport."
                                            },
                                            {
                                                "example_id": "51471a3c-1670-4233-80ff-420184db114f",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "Her father told her to phone him to pick her up in case it started raining heavily."
                                            },
                                            {
                                                "example_id": "1ed1f5fb-6e8c-49e6-b0a1-5f3d2320eb60",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "It wasn’t like he was dying to get it off his chest. I think he only phoned because he knew how excited I’d be to hear about it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d02e5199-4002-30b1-a74a-58cc4518d58f",
                                        "entry_id": "39a27697-bef8-390e-bb94-002a3da181b7",
                                        "glosses": [
                                            "A speech segment that possesses distinct physical or perceptual properties, considered as a physical event without regard to its place in the phonology of a language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
