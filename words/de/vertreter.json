                    "semantic_group_id": "mathematik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aus jeder disjunkten Teilmenge wird genau ein <w>Vertreter</w> bestimmt, um die Struktur zu beschreiben."
                        },
                        {
                            "text": "Zur praktischen Berechnung wählt man meistens den kleinsten positiven <w>Vertreter</w> der jeweiligen Restklasse."
