                        "glosses": [
                            "Celle qui compile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c8748f5-9c9b-4ba9-bfd6-2bb7e9696ec9",
                                "sense_id": "487fba74-3951-3f18-9477-df0b356d531a",
                                "text": "Les anecdotes que relate Christine sont distribuées selon l’ordre des raisons fixées au départ, mais à l’intérieur de ce cadre la compilatrice use d’une grande liberté."
                            },
                            {
                                "example_id": "88fd1698-ab48-4fbe-bf97-9c00f1be26a1",
                                "sense_id": "487fba74-3951-3f18-9477-df0b356d531a",
                                "text": "Débat critique Christine de Pizan, au cours des siècles qui nous séparent d’elle, fut tour à tour admirée et dédaignée, considérée comme une compilatrice verbeuse et sans génie ou comme « un esprit étonnamment moderne »."
                            }
                        ]
                    }
