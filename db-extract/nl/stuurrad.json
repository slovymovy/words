        "nl-extract.jsonl": [
            {
                "entry_id": "9375de1e-5993-3f46-9734-da541e7951e8",
                "word": "stuurrad",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "067850b7-789c-4081-bc1c-38cdce093b2a",
                        "entry_id": "9375de1e-5993-3f46-9734-da541e7951e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "stuurraderen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c0b339c-362c-37ed-ae1e-3b19421deb3a",
                        "entry_id": "9375de1e-5993-3f46-9734-da541e7951e8",
                        "glosses": [
                            "het grote wiel met uitstaande spaken waarmee men het roer van een boot bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91c29b6c-a785-43d4-8cb4-fe42c3342976",
                                "sense_id": "2c0b339c-362c-37ed-ae1e-3b19421deb3a",
                                "text": "Midden op het IJ viel de motor van onze zeewaardige boot uit. Eén van mijn broers stond aan het stuurrad en riep dat er iets mis was. Niemand reageerde op zijn roep; we gingen rustig door met ademhalen, boeken lezen en rosé drinken."
                            },
                            {
                                "example_id": "6a842075-e138-4720-b411-660527fe1081",
                                "sense_id": "2c0b339c-362c-37ed-ae1e-3b19421deb3a",
                                "text": "Een gevoel van opwinding; anders is het niet te zeggen. De zeilboot van mijn vriend is een juweel. Eigenlijk nog nieuw en in perfecte staat. Belangeloos heeft hij mij de boot geleend. Als ik er maar zuinig op ben. Wel, dat lijkt me geen punt. Mijn haar wappert in de wind en met een onbedwingbaar gevoel van trots sta ik achter het grote stuurrad van het schip van mijn vriend."
                            },
                            {
                                "example_id": "849c73ee-7cfd-45aa-a388-9fa00194ba9e",
                                "sense_id": "2c0b339c-362c-37ed-ae1e-3b19421deb3a",
                                "text": "Van Waarts volgende onderdeel in de rondleiding is het dubbele stuurrad dat al gereed is voor gebruik. „Er stond altijd twee man aan het roer en door het dubbel te maken, kon tijdens een storm vier mannen het roer in bedwang houden.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b64865a-3aee-4a4d-99d9-4c2ded8c18b8",
                        "source_entry_id": "9375de1e-5993-3f46-9734-da541e7951e8",
                        "source_sense_id": "2c0b339c-362c-37ed-ae1e-3b19421deb3a",
                        "target_lang_word": "handle-bar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "123b91fa-97ed-459c-bb04-c4f5179f9e98",
                        "source_entry_id": "9375de1e-5993-3f46-9734-da541e7951e8",
                        "source_sense_id": "2c0b339c-362c-37ed-ae1e-3b19421deb3a",
                        "target_lang_word": "steering wheel spoke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "13144832-482e-401c-af92-f723dd93c786",
                        "source_entry_id": "9375de1e-5993-3f46-9734-da541e7951e8",
                        "source_sense_id": "2c0b339c-362c-37ed-ae1e-3b19421deb3a",
                        "target_lang_word": "steering-wheel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steering-wheel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25329955-16cd-39b1-a0e3-f843873fa8cf",
                                        "entry_id": "f10ae1be-c2dc-3398-adc8-9fa0b66dc554",
                                        "glosses": [
                                            "Dated form of steering wheel."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98922e03-2919-41ba-8a8c-e7be94340e39",
                                                "sense_id": "25329955-16cd-39b1-a0e3-f843873fa8cf",
                                                "text": "I might have completely fell out of my seat and bumped my head on my steering-wheel had my too kind and loving wife not woke me up when she reached over and tried to wipe the drool off of my chin."
                                            },
                                            {
                                                "example_id": "1bba0811-492d-441f-b72e-7a4f05806724",
                                                "sense_id": "25329955-16cd-39b1-a0e3-f843873fa8cf",
                                                "text": "An Experiment has been made of the New Steering-wheel, invented by Lieutenant Savage, on board his Majeſty’s Ship Fowey, in the Paſſage from Plymouth to Boſton in North America, which is found to ſteer with Eaſe and Safety, and allowed by ſeveral Officers of the Navy, and other eminent Mechanics who have examined it, to be a moſt uſeful and a very ingenious Invention."
                                            },
                                            {
                                                "example_id": "573db31b-9cdb-4c2e-82ac-7c0e11a6b51c",
                                                "sense_id": "25329955-16cd-39b1-a0e3-f843873fa8cf",
                                                "text": "After going once to Blackpool, I was on the dodgem cars at the fairground when Cecil Moores came alongside. (I didn’t know then it was him). He said: “Have you got a match?” But I wouldn’t let go of my steering-wheel. I just laughed and shook my head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
