                {
                    "sense_id": "7210aed4-ca0c-3136-8f11-15160abbaaca",
                    "sense_definition": "Personnage dont la fonction officielle était de faire rire et divertir un souverain ou une cour noble.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metier_historique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>bouffon</w> du roi était le seul qui pouvait critiquer le monarque sans être puni.",
                            "target_lang_translations": {
                                "en": "The king's <w>jester</w> was the only one who could criticize the monarch without being punished.",
                                "ru": "Королевский <w>шут</w> был единственным, кто мог критиковать монарха безнаказанно.",
                                "de": "Der <w>Hofnarr</w> des Königs war der Einzige, der den Monarchen kritisieren konnte, ohne bestraft zu werden.",
                                "es": "El <w>bufón</w> del rey era el único que podía criticar al monarca sin ser castigado.",
                                "zh": "国王的<w>弄臣</w>是唯一敢批评君主而不受惩罚的人。"
                            }
                        },
                        {
                            "text": "Autrefois, chaque grand seigneur avait son <w>bouffon</w> pour divertir ses invités lors des banquets.",
                            "target_lang_translations": {
                                "en": "In the past, every great lord had his own <w>jester</w> to entertain his guests at banquets.",
                                "ru": "Раньше у каждого знатного вельможи был свой <w>шут</w>, чтобы развлекать гостей на пирах.",
                                "de": "Früher hatte jeder große Adlige seinen eigenen <w>Hofnarren</w>, der seine Gäste bei Festmahlen unterhielt.",
                                "es": "Antiguamente, cada gran señor tenía su <w>bufón</w> para entretener a sus invitados en los banquetes.",
                                "zh": "从前，每位大贵族都有自己的<w>弄臣</w>，在宴会上逗宾客开心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fou"
                    ],
                    "common_phrases": [
                        "bouffon du roi",
                        "bouffon de cour"
                    ],
                    "target_lang_definitions": {
                        "en": "A person employed to amuse a ruler or noble court with jokes and antics.",
                        "ru": "Придворный, в обязанности которого входило развлекать государя или знатный двор шутками и выходками.",
                        "de": "Historischer Hofunterhalter, der Herrscher oder Adlige mit Späßen und Possen belustigte.",
                        "es": "Personaje que, en la corte de un rey o de un noble, tenía por oficio divertir a su señor con bromas y payasadas.",
                        "zh": "历史上受君主或贵族雇用，以说笑和表演为主人取乐的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jester",
                                "target_lang_sense_clarification": "royal court entertainer, historical"
                            },
