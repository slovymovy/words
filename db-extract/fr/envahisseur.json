                    {
                        "translation_id": "7b0ea589-79a5-4edf-a97c-5c26501d0505",
                        "source_entry_id": "9db2f13a-10f0-32ac-820e-bde174c6ea9e",
                        "source_sense_id": "496b9b4d-db5b-3c38-9049-95b3d894ece9",
                        "target_lang_word": "захватчик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "захватчик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a29fab3d-14e8-348b-9ebb-e83118d04e92",
                                        "entry_id": "87e35557-4525-39a2-9985-84094a661afc",
                                        "glosses": [
                                            "неодобр. тот, кто осуществляет захват, насильственно овладевает чем-либо; завоеватель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919cf3c9-ba3c-42e3-8a87-a48ceb548922",
                                                "sense_id": "a29fab3d-14e8-348b-9ebb-e83118d04e92",
                                                "text": "Наконец, действительно «всенародное» правительство не могло бы остаться одиноким, всеми покинутым — на волю кучки захватчиков власти."
                                            },
                                            {
                                                "example_id": "24eb12bc-3805-4ded-9ee6-7086275089bc",
                                                "sense_id": "a29fab3d-14e8-348b-9ebb-e83118d04e92",
                                                "text": "Самгин вспоминал себя в Москве, когда он тоже был осведомителем и оракулом, было досадно, что эта позиция занята, занята легко, мимоходом, и не ценится захватчиком."
                                            },
                                            {
                                                "example_id": "b5ac5da5-0ea0-41eb-aa32-45c597b9d121",
                                                "sense_id": "a29fab3d-14e8-348b-9ebb-e83118d04e92",
                                                "text": "Предупреждаю, что каждый насильственный захват кем-либо личных владений граждан Польского государства или их имущества будет считаться грабежом, и с захватчиками будет поступлено, как с бандитами."
                                            },
                                            {
                                                "example_id": "376f66fc-6d85-4741-a70d-658c0ce982a0",
                                                "sense_id": "a29fab3d-14e8-348b-9ebb-e83118d04e92",
                                                "text": "И лучшие мысли своего века, и имя родины, и любовь к ней он пронес ещё раз, на этот раз в войне, в той народной войне с захватчиком, которого он ненавидел."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
