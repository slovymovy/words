                                        "sense_id": "e743d6ad-cb31-3bcf-928e-e728067d1e2c",
                                        "entry_id": "55383178-e9e3-3345-976c-a146b73cb7b4",
                                        "glosses": [
                                            "Of fluid motion, smooth and regular, flowing as though in different layers."
                                        ],
