                        "examples": [
                            {
                                "example_id": "97158da0-cf33-4942-ad48-70a58edf0363",
                                "sense_id": "89096720-070c-3482-ae0c-355081f1ce4a",
                                "text": "Не переусе́рдствуй с ко́фе.",
                                "translation": "Let's not overdo it with the coffee.",
                                "english": "Let's not overdo it with the coffee."
                            },
                            {
                                "example_id": "46ff2d73-6bf5-4c7b-8063-c19c37dde429",
                                "sense_id": "89096720-070c-3482-ae0c-355081f1ce4a",
                                "text": "Я переусе́рдствовала при приня́тии со́лнечных ванн.",
                                "translation": "I overdid it while sunbathing.",
                                "english": "I overdid it while sunbathing."
                            }
