                                        "examples": [
                                            {
                                                "example_id": "1f61ce99-7c05-4ded-8daf-3b5df3244f23",
                                                "sense_id": "8d921dfd-e580-3787-8c7e-c03b7adf82e0",
                                                "text": "I will die fighting for my people, because my people are all."
                                            },
                                            {
                                                "example_id": "2f2a20b1-fa7b-4eef-a1ae-9a7dbf8d5c13",
                                                "sense_id": "8d921dfd-e580-3787-8c7e-c03b7adf82e0",
                                                "text": "All are one and one is all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7af102be-1f62-3b39-820e-e54805d26b6b",
                                        "entry_id": "ed48c117-5b8e-36e8-a90a-45dd867ec736",
                                        "glosses": [
                                            "Although."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c3c66d7-8689-443a-be4c-9634804c7613",
                                                "sense_id": "7af102be-1f62-3b39-820e-e54805d26b6b",
                                                "text": "And those two froward sisters, their faire loves, / Came with them eke, all they were wondrous loth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22eee059-8182-37c1-af22-97e2f745e67d",
                                        "entry_id": "c3366342-1b64-30da-85d1-15e78d7cabae",
                                        "glosses": [
                                            "All gone; dead."
                                        ],
                                        "tags": [
                                            "Pennsylvania",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad49a16-723d-4714-89ce-728429b92b44",
                                                "sense_id": "22eee059-8182-37c1-af22-97e2f745e67d",
                                                "text": "The butter is all."
                                            }
                                        ]
                                    }
                                ]
                            }
