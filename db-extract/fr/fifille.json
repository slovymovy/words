                        ],
                        "form": "fifilles"
                    },
                    {
                        "form_id": "6f23a9cc-8667-4c4e-95b8-f442ba24050e",
                        "entry_id": "9f8b44dc-fd4f-346f-9a68-6f6bac2cc4a0",
                        "tags": [
                            "masculine"
                        ],
                        "form": "fifils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                        "entry_id": "9f8b44dc-fd4f-346f-9a68-6f6bac2cc4a0",
                        "glosses": [
                            "Fille, chouchoute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb5500a7-b19a-4ba9-aa2e-bd47e3f88ffc",
                                "sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                                "text": "Eh ! bien, fifille, cette noisette est cause d’une révolution au logis."
                            },
                            {
                                "example_id": "138bd04a-d034-4ce0-9ed1-637ae39b59dc",
                                "sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                                "text": "Laure vint avec sa fifille qui depuis hier sait dire Tutus !!!"
                            },
                            {
                                "example_id": "0f8109a1-1c95-4fee-8bce-84f82e94ee27",
                                "sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                                "text": "– Oui, dit-elle, si l’un d’eux ou l’une d’elles m’a connue quand j’étais Elizabeh Baldridge la guenon arriviste, ambitieuse et carriériste, la fifille à sa maman agressive et arrogante, que va-t-il se passer ?"
                            },
                            {
                                "example_id": "b57b6acc-961a-42f6-9373-9f309fd95ef2",
                                "sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                                "text": "De retour de Moscou, fifille s’est aussi laissé abuser par un lecteur du « Parisien »."
                            },
                            {
                                "example_id": "2076e74c-80d3-42bb-8dde-5ce10c3feb44",
                                "sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                                "text": "Une bonne fifille qui veut juste un bon chocolat. Alors elle a fait un 180 et attrapé un sachet d’arôme cacao nano-certifié. — (Daniel Nayeri, Notre-Dame des Traîtres, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 243)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1564d00-9de0-4f30-b522-429818f53b56",
                        "source_entry_id": "9f8b44dc-fd4f-346f-9a68-6f6bac2cc4a0",
                        "source_sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                        "target_lang_word": "Töchterchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Töchterchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                        "entry_id": "f47e5695-202a-3668-85b3-bfd07d3d4610",
                                        "glosses": [
                                            "kleine Tochter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac790d3-64fd-4270-893a-73492f8f77f4",
                                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                                "text": "Meine Schwester bekam vor ein paar Wochen ein süßes Töchterchen."
                                            },
                                            {
                                                "example_id": "731a5c95-7a9e-42f6-8ef9-be98f7058c42",
                                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                                "text": "„Ich lese, dass ein Jahr nach der Geburt von Klein-Gretchen, seinem ersten Kind, am 21. Mai ein weiteres Töchterchen geboren wurde.“"
                                            },
                                            {
                                                "example_id": "b876be31-e135-463e-8fd0-cd15a1ce6f62",
                                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                                "text": "„Ich will meinem Töchterchen eine ganz, ganz winzige Atombombe schenken.“"
                                            },
                                            {
                                                "example_id": "026f04fc-577e-495c-abfa-7c16f5a509c2",
                                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                                "text": "„Da Zwillinge sowieso nicht immer in große Verhältnisse hineingeboren werden, erkundigte sich ein kleiner Beamter tiefbekümmert beim Frauenarzt, weshalb in seiner jungen Ehe zuerst ein einziges Töchterchen ankam, danach ein Zwillingspärchen, und jetzt, im dritten Jahr, schon reguläre Drillinge.“"
                                            },
                                            {
                                                "example_id": "e638f8b3-d582-435a-9bad-f5653f94d831",
                                                "sense_id": "a81e2f06-2ba3-3786-aaaa-967bdc595e32",
                                                "text": "„Am 10. September holt Fallada seine Frau Suse und das sieben Wochen alte Töchterchen Lore von der Berliner Klinik ins Hotel »Deutsches Haus« in Feldberg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f282a61c-20f3-4ed9-8e40-88b53591f8a9",
                        "source_entry_id": "9f8b44dc-fd4f-346f-9a68-6f6bac2cc4a0",
                        "source_sense_id": "91394e38-ad1a-3831-82fa-611196a84b4a",
                        "target_lang_word": "little girl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "little girl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f70308-441c-37d8-ac13-ee0507eb0969",
                                        "entry_id": "a894f86f-5f61-3a86-8fa4-c0925c053eff",
                                        "glosses": [
                                            "A female child, especially one younger than ten years of age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58a1a8b-74c0-4a82-aba9-ac5afc3435e9",
                                                "sense_id": "c1f70308-441c-37d8-ac13-ee0507eb0969",
                                                "text": "More than ever I wished she was my sister and that mother could watch over her. She would gladly, I knew. A little girl, barely twelve years old and not large for her age."
                                            },
                                            {
                                                "example_id": "8daec3ab-01df-4d0c-adcd-678ff044a97f",
                                                "sense_id": "c1f70308-441c-37d8-ac13-ee0507eb0969",
                                                "text": "My ... what a sweet little girl!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d6b7d7-765d-3a71-8c3a-d8250b4b5b1f",
                                        "entry_id": "a894f86f-5f61-3a86-8fa4-c0925c053eff",
                                        "glosses": [
                                            "One's daughter."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11da11a8-1984-499f-916a-721dbe9a0c18",
                                                "sense_id": "66d6b7d7-765d-3a71-8c3a-d8250b4b5b1f",
                                                "text": "My little girl's getting married next week!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f06f69-4383-3d4c-894e-ed84cf2d66b5",
                                        "entry_id": "a894f86f-5f61-3a86-8fa4-c0925c053eff",
                                        "glosses": [
                                            "A weak-willed or effeminate person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8acf2ce8-2f35-4fce-81b2-9770585d5ef9",
                                                "sense_id": "66f06f69-4383-3d4c-894e-ed84cf2d66b5",
                                                "text": "Laurie tells him to stop being such a little girl and do something bad for once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
