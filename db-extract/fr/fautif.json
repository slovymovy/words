                                    {
                                        "sense_id": "24d2ba3d-956d-35d3-8b55-37cfebad6c29",
                                        "entry_id": "edbdb22f-9e03-37aa-ba3d-ba3467c9a8ad",
                                        "glosses": [
                                            "hesitancy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ae2943-2757-4da3-8615-6bc5e8e9b6a7",
                                                "sense_id": "24d2ba3d-956d-35d3-8b55-37cfebad6c29",
                                                "text": "But it is the doubt thrown on the prospect of arrival, the falterings of purpose and belief, the renewals of hope that give the novel its drive and energy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec95f76d-299c-4ac8-a631-1df1d9211cd2",
                        "source_entry_id": "5ad162a1-6b05-3a26-80d7-ffeb9a8a211c",
                        "target_lang_word": "faulty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faulty",
