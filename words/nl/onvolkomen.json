                                "target_lang_word": "mangelhaft",
                                "target_lang_sense_clarification": "mit Mängeln behaftet"
                            },
                            {
                                "target_lang_word": "unzulänglich",
                                "target_lang_sense_clarification": "nicht ausreichend oder ungenügend"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "imperfect",
                                "target_lang_sense_clarification": "having flaws or mistakes"
                            },
                            {
