                ],
                "senses": [
                    {
                        "sense_id": "c26cc3c1-a571-318c-af70-8f47f479fe53",
                        "entry_id": "fd5e626c-24db-3340-af00-6455020dc581",
                        "glosses": [
                            "The state of being synchronous or simultaneous."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2a42cdfd-5a3d-328a-8c31-9691d75522af",
                        "entry_id": "fd5e626c-24db-3340-af00-6455020dc581",
                        "glosses": [
                            "Coincidences that seem to be meaningfully related; supposedly the result of \\\"universal forces\\\"."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b169a0b3-fabd-4218-9c34-3810f1dcb8d3",
                        "source_entry_id": "fd5e626c-24db-3340-af00-6455020dc581",
                        "source_sense_description": "the state of being synchronous or simultaneous",
                        "target_lang_word": "synchroniciteit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synchroniciteit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b2a280-d1b7-3bad-bb8d-dbb56ae6b459",
                                        "entry_id": "e81d775d-3e8f-33e1-b261-8a57a759f8e1",
                                        "glosses": [
                                            "overeenkomstige handelingen of ervaringen op hetzelfde moment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce75eae-9f24-4c66-b727-df82189bec2a",
                                                "sense_id": "e6b2a280-d1b7-3bad-bb8d-dbb56ae6b459",
                                                "text": "Volgens Van Ransbeek moet je die livestreams niet zien als een registratie van de theatervoorstelling, maar als „een filmische kijk op de theaterervaring”. Het live-aspect is daarbij cruciaal. „Je dwingt een groep mensen tot synchroniciteit: iedereen koopt een kaartje, committeert zich aan een bepaalde tijd en je behoudt de spanning van een live-event. Zo blijft een groot deel van het theaterritueel in stand."
                                            },
                                            {
                                                "example_id": "15bb2394-3655-46d9-887e-ea71942a74b5",
                                                "sense_id": "e6b2a280-d1b7-3bad-bb8d-dbb56ae6b459",
                                                "text": "Niemand weet hoe dat precies werkt. Maar ons lijf zit vol met datgene wat muziek definieert: golven, ritmes, cycli en patronen. Ik denk dat de interactie met onze gevoelens verloopt via synchroniciteiten tussen het lichaam en de muziek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3077ab2-9874-3fba-a2cd-2874717e5d52",
                                        "entry_id": "e81d775d-3e8f-33e1-b261-8a57a759f8e1",
                                        "glosses": [
                                            "Bij Carl Gustav Jung het samenvallen in de tijd van twee of meer niet causaal op elkaar betrekking hebbende gebeurtenissen, die voor de betrokkene toch als betekenisvol worden ervaren."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6642b9f-b60e-4bd4-ab66-ba1cf0da8c20",
                                                "sense_id": "c3077ab2-9874-3fba-a2cd-2874717e5d52",
                                                "text": "Jung bracht de werking van astrologie, tarot en I Tjing in verband met synchroniciteit en niet met causaliteit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f169204-8de1-4aa6-9667-378cb25b2fdd",
                        "source_entry_id": "fd5e626c-24db-3340-af00-6455020dc581",
                        "source_sense_description": "the state of being synchronous or simultaneous",
                        "target_lang_word": "synchronicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synchronicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac41287e-093f-37ce-b46d-9bcdeed7042d",
                                        "entry_id": "9622954b-8094-3f0d-bcec-a7442d5c2bb8",
                                        "glosses": [
                                            "Qualité de ce qui est synchronique, de ce qui se passe en même temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d475b42-3fc6-47ba-954f-ab8892f638c1",
                                                "sense_id": "ac41287e-093f-37ce-b46d-9bcdeed7042d",
                                                "text": "Le chercheur associé au Centre canadien de politiques alternatives observait une synchronicité dans l’apparition d’une bulle immobilière dans les six principaux marchés canadiens pour la première fois en 30 ans."
                                            },
                                            {
                                                "example_id": "846226e0-694a-4d84-aafc-5d12ae2f527b",
                                                "sense_id": "ac41287e-093f-37ce-b46d-9bcdeed7042d",
                                                "text": "J’ai lu un long article qu’il avait écrit dans une revue de sciences humaines, il y développait des considérations assez curieuses sur le Destin, sur la possibilité de développer une nouvelle religion basée sur le principe de synchronicité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95a74faf-ec4e-3587-88a1-781fef71ca6a",
                                        "entry_id": "9622954b-8094-3f0d-bcec-a7442d5c2bb8",
                                        "glosses": [
                                            "Occurrence simultanée d’au moins deux événements qui ne présentent pas de lien de causalité, mais dont l’association prend un sens pour la personne qui les perçoit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39ab985-2dd4-4f60-816a-4b34b8c14ee8",
                                                "sense_id": "95a74faf-ec4e-3587-88a1-781fef71ca6a",
                                                "text": "Pour les adeptes de Bouddha, la synchronicité représente la « magie ordinaire », qui suggère que tout est lié ou interdépendant et, donc, qu’il existe toujours un lien de cause à effet."
                                            },
                                            {
                                                "example_id": "56fa1ad6-6a04-40b8-bc88-497a2d467b4b",
                                                "sense_id": "95a74faf-ec4e-3587-88a1-781fef71ca6a",
                                                "text": "- Tu peux dire ce que tu veux, cela s’est quand même produit. C’est ça, la synchronicité.\n- Qu’est-ce que c’est ?\n- Le phénomène qui fait que lorsqu’on commence une action il se produit autour de soi des événements liés à cette action. C’est une notion proposée par le psychologue Carl Jung."
                                            },
                                            {
                                                "example_id": "62bcea36-daf7-422f-a4f2-e9411ae004b0",
                                                "sense_id": "95a74faf-ec4e-3587-88a1-781fef71ca6a",
                                                "text": "Le concept de la synchronicité est devenu un prêt-à-porter, une méthode que l’on vous vend plutôt qu’un questionnement sur le sens."
                                            },
                                            {
                                                "example_id": "6bdcbdd0-13f1-4f6c-a696-8ef27d90de4b",
                                                "sense_id": "95a74faf-ec4e-3587-88a1-781fef71ca6a",
                                                "text": "Tout à fait dans l’esprit de son temps, il choisit de parler de hasard plutôt que de s’étendre sur une notion aux allures nettement plus ésotériques qui sera nommée « synchronicité » par Carl Gustav Jung."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79968360-468d-4ffe-84e3-91988747596d",
                        "source_entry_id": "fd5e626c-24db-3340-af00-6455020dc581",
                        "source_sense_description": "the state of being synchronous or simultaneous",
                        "target_lang_word": "Synchronizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Synchronizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c63c72c2-3b8f-3222-9a0b-e53bb46d54d6",
                                        "entry_id": "870d3b99-890c-305b-ad0b-6a28ac359a54",
                                        "glosses": [
                                            "Eigenschaft, zur gleichen Zeit (synchron) zu geschehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6e3916-3993-4262-8d3d-8e9f4b2fbca3",
                                                "sense_id": "c63c72c2-3b8f-3222-9a0b-e53bb46d54d6",
                                                "text": "„Ein weiteres Ziel war die Synchronizität der Bewegungen aller Soldaten einer Einheit.“"
                                            },
                                            {
                                                "example_id": "74c4569e-6165-47e1-9e85-c7b52e375704",
                                                "sense_id": "c63c72c2-3b8f-3222-9a0b-e53bb46d54d6",
                                                "text": "Die Synchronizität der Ereignisse war schon verblüffend. Erst treffe ich meinen einen Onkel auf der Straße und abends ruft der andere Onkel aus Amerika an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80ddc772-4178-3a1b-9d1b-434cb05e49dc",
                                        "entry_id": "870d3b99-890c-305b-ad0b-6a28ac359a54",
                                        "glosses": [
                                            "zeitliche Übereinstimmung, Gleichlauf von Bild und Ton, Parallelität von Handlungslinien"
                                        ],
                                        "tags": [
                                            "Fernsehen",
                                            "Film",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed134ab-7461-496a-a381-94142ac43d27",
                                                "sense_id": "80ddc772-4178-3a1b-9d1b-434cb05e49dc",
                                                "text": "„Beim Thema ‚Clip-Forschung‘ wendet sich die Autorin der ‚Synchronizität zwischen Bild und Ton‘ zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c153517-2cc2-34f9-a120-4624d045ee5d",
                                        "entry_id": "870d3b99-890c-305b-ad0b-6a28ac359a54",
                                        "glosses": [
                                            "das zeitgleiche Zusammentreffen von nicht zusammenhängenden Ereignissen"
                                        ],
                                        "tags": [
                                            "nach Jung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f5a988-166d-46bb-8bf0-1f275c5bbe97",
                                                "sense_id": "9c153517-2cc2-34f9-a120-4624d045ee5d",
                                                "text": "Die Synchronizität der Ereignisse war schon verblüffend. Erst treffe ich meinen einen Onkel auf der Straße und abends ruft der andere Onkel aus Amerika an."
                                            },
                                            {
                                                "example_id": "b99bca8a-86b4-4557-be0a-3d7979b5d32d",
                                                "sense_id": "9c153517-2cc2-34f9-a120-4624d045ee5d",
                                                "text": "„Synchronizität bezeichnet Koinzidenzen, die eine Verbindung aufweisen, ohne dass zwischen ihnen ein Kausalzusammenhang besteht. Das sind beispielsweise Gefühle oder Gedanken, verknüpft mit einem äußeren Ereignis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
