                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants adorent pêcher des petits crabes restés prisonniers dans la <w>bâche</w> d'eau."
