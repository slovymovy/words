                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "symbol_decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's helmet was adorned with a magnificent feather <w>crest</w>.",
