                "entry_id": "e54615a7-aa7c-3814-9b19-8606b4267e4a",
                "word": "malignancy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1003323c-3315-4292-81c6-5bcbded39ad6",
                        "entry_id": "e54615a7-aa7c-3814-9b19-8606b4267e4a",
                        "tags": [
                            "plural"
                        ],
                        "form": "malignancies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "043362c2-9fdc-35d7-81b3-f28576660b97",
                        "entry_id": "e54615a7-aa7c-3814-9b19-8606b4267e4a",
                        "glosses": [
                            "The state of being malignant or diseased."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "534a8f8e-b7da-3d9c-9b04-ae671821d04c",
                        "entry_id": "e54615a7-aa7c-3814-9b19-8606b4267e4a",
                        "glosses": [
                            "A malignant cancer; specifically, any neoplasm that is invasive or otherwise not benign."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "201114af-53d7-38fe-a864-ee5d69ff288a",
                        "entry_id": "e54615a7-aa7c-3814-9b19-8606b4267e4a",
                        "glosses": [
                            "That which is malign; evil, depravity, malevolence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1aff7f35-6295-4911-9165-2d1d9057ed4e",
                                "sense_id": "201114af-53d7-38fe-a864-ee5d69ff288a",
                                "text": "[T]he malignancie of my fate, might perhaps diſtemper yours; […]"
                            },
                            {
                                "example_id": "5bb58f57-2425-4405-bcb6-27c497c1a1c1",
                                "sense_id": "201114af-53d7-38fe-a864-ee5d69ff288a",
                                "text": "A cold wind swept down from it and set us shivering. Somewhere there, on that desolate plain, was lurking this fiendish man, hiding in a burrow like a wild beast, his heart full of malignancy against the whole race which had cast him out."
                            },
                            {
                                "example_id": "f89d3a44-a42a-4345-af3b-03e6c86c57b3",
                                "sense_id": "201114af-53d7-38fe-a864-ee5d69ff288a",
                                "text": "Because of the dearth of recent feminist writing about conditions in mental institutions, it's possible for us to image that they must have improved since the mid-'70s. Millett reminds us forcefully of the hellishness and malignancy of these places, where mind-altering drugs are prescribed punitively or at random, attendants are abusive, food is unhealthy, and numbing boredom, ugliness, pain and filth prevail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83e0a7fd-67d8-400d-8ed0-c0203b10f1df",
                        "source_entry_id": "e54615a7-aa7c-3814-9b19-8606b4267e4a",
                        "source_sense_description": "state of being malignant",
                        "target_lang_word": "zhoubnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9342b696-f699-4b7b-87c8-77430caed7ba",
                        "source_entry_id": "e54615a7-aa7c-3814-9b19-8606b4267e4a",
                        "source_sense_description": "state of being malignant",
                        "target_lang_word": "malignita",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malignita",
