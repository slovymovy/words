                "senses": [
                    {
                        "sense_id": "241b9504-2400-3b5d-8c4f-48c71128b44b",
                        "entry_id": "d6423f78-96c7-3267-9052-a5bbd5bf686f",
                        "glosses": [
                            "домашняя птица (курица, утка и т. п.), несущая яйца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd6fbbc-3c65-4041-8b68-282ffd5daec6",
                                "sense_id": "241b9504-2400-3b5d-8c4f-48c71128b44b",
                                "text": "«Птичку-невеличку» теперь чаще держат ради её мелких, но необычайно полезных яиц. Правда, в качестве несушки используют не обыкновенную дикую перепелку, а специально выведенную из неё японскую перепелку. В начале века японские селекционеры сделали её отменной несушкой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "896c0792-cf21-4528-b838-c894ae6ec145",
                        "source_entry_id": "d6423f78-96c7-3267-9052-a5bbd5bf686f",
                        "source_sense_id": "241b9504-2400-3b5d-8c4f-48c71128b44b",
                        "target_lang_word": "layer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "layer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e69f3f-41c7-3a8c-873d-d1af8479c682",
                                        "entry_id": "3b52bb8e-0c40-3620-9190-da0bdc0736bd",
                                        "glosses": [
                                            "A single thickness of some material covering a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "709774e2-3012-4893-a0a9-83be5bd4e133",
                                                "sense_id": "b1e69f3f-41c7-3a8c-873d-d1af8479c682",
                                                "text": "Wrap the loaf in two layers of aluminum foil before putting it in the oven."
                                            },
                                            {
                                                "example_id": "b981320e-472f-4d3e-82c5-c7725df701eb",
                                                "sense_id": "b1e69f3f-41c7-3a8c-873d-d1af8479c682",
                                                "text": "After the first coat of paint dried, he applied another layer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87bfdc1b-4cb6-3dfc-a418-a903a766539f",
                                        "entry_id": "3b52bb8e-0c40-3620-9190-da0bdc0736bd",
                                        "glosses": [
                                            "A single thickness of some material covering a surface.",
                                            "An item of clothing worn under or over another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5807bdb-2d44-4645-9c00-e4db060f3435",
                                                "sense_id": "87bfdc1b-4cb6-3dfc-a418-a903a766539f",
                                                "text": "It's cold now but it will warm up this afternoon. Make sure you wear layers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f4cfb0-ea1a-3a46-84ac-a2add38f062b",
                                        "entry_id": "3b52bb8e-0c40-3620-9190-da0bdc0736bd",
                                        "glosses": [
                                            "A (usually) horizontal deposit; a stratum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed10c30-1c90-44ca-beb3-4ec291b93d0e",
                                                "sense_id": "a3f4cfb0-ea1a-3a46-84ac-a2add38f062b",
                                                "text": "I find seven-layer cake a bit too rich."
                                            },
                                            {
                                                "example_id": "e60efa7c-68c4-4d99-a374-d11ab18efa0c",
                                                "sense_id": "a3f4cfb0-ea1a-3a46-84ac-a2add38f062b",
                                                "text": "Sometimes, the underlying layers are exposed by erosion, revealing the story of the rocks like an open book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94eaf3fb-7ca3-36ea-a230-5852bc2fb889",
                                        "entry_id": "3b52bb8e-0c40-3620-9190-da0bdc0736bd",
                                        "glosses": [
                                            "One of the items in a hierarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0041ed06-c996-4f07-b9f0-872a8234f835",
                                                "sense_id": "94eaf3fb-7ca3-36ea-a230-5852bc2fb889",
                                                "text": "Right above the database access layer sits a number cruncher that performs any calculations that a particular request may require, such as computing a standard deviation. In many cases, this layer just forwards raw numbers."
                                            },
                                            {
                                                "example_id": "f90744f1-7213-49db-aece-f2f98ca71e5e",
                                                "sense_id": "94eaf3fb-7ca3-36ea-a230-5852bc2fb889",
                                                "text": "mired in layers of deceit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2463b4a3-84cc-3eed-bfd3-d500a095f3c7",
                                        "entry_id": "3b52bb8e-0c40-3620-9190-da0bdc0736bd",
                                        "glosses": [
                                            "One in a stack of (initially transparent) drawing surfaces that comprise an image; used to keep elements of an image separate so that they can be modified independently from one another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d799119-f0ff-3cd3-b834-2f4918194bb6",
                                        "entry_id": "3b52bb8e-0c40-3620-9190-da0bdc0736bd",
                                        "glosses": [
                                            "One of the seven network switch pieces in the Open Systems Interconnection model: application, presentation, session, transport, network, data link, and physical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "467d0aa5-da06-3ee4-af67-d241296df17f",
