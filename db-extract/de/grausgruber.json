                ],
                "senses": [
                    {
                        "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                        "entry_id": "95812fe0-fff0-354a-8ddb-b3980d35c218",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb84b7fc-0b7c-41b6-b914-33a784e227d0",
                                "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                                "text": "Frau Grausgruber ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "89277196-75db-42d9-8935-e22d781cca9f",
                                "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                                "text": "Herr Grausgruber wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d06d6322-c7f8-46dc-a208-6f40b44a1c82",
                                "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                                "text": "Die Grausgrubers fahren heute in den Wienerwald."
                            },
                            {
                                "example_id": "e41bd11d-3641-4b12-8bd6-9c9cd3bb49f9",
                                "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                                "text": "Der Grausgruber trägt nie die Schals, die die Grausgruber ihm strickt."
                            },
                            {
                                "example_id": "5061c876-9931-4ea7-a96b-28045d9823ca",
                                "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grausgruber kommt, geht der Herr Grausgruber.“"
                            },
                            {
                                "example_id": "8f2405bb-e517-4a29-a7f3-925eda7a6c5a",
                                "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                                "text": "Grausgruber kommt und geht."
                            },
                            {
                                "example_id": "3786a4e1-5e4a-4557-9084-932c939ead46",
                                "sense_id": "fa614b5b-a09d-34c7-9340-0ab17d6baef9",
                                "text": "Grausgrubers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
