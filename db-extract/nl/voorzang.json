                    {
                        "sense_id": "c7c3f9ae-ed08-3c25-9c1b-a852744e81e6",
                        "entry_id": "b75b7c73-4a31-3634-aad2-955a3e18d9b9",
                        "glosses": [
                            "gezang van iemand die voorzingt en zo een groep van zangers leidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2a977e-4b75-4a20-b8dd-fb14b8ed3b88",
                                "sense_id": "c7c3f9ae-ed08-3c25-9c1b-a852744e81e6",
                                "text": "De bijhorende muziek is geboren uit de behoefte om de teksten te overwegen en te heroverwegen in een gemeenschap. Je hebt de voorzang, die gevolgd wordt door een antwoord of responsorium. Letterlijk een herhaling."
                            },
                            {
                                "example_id": "a188a2c1-5b50-4938-ad14-a8dfb5cbb5f2",
                                "sense_id": "c7c3f9ae-ed08-3c25-9c1b-a852744e81e6",
                                "text": "'Maar kanaries kweken, is een hobby die een grote inzet vraagt. Je hebt er eigenlijk elke dag werk aan: kweken, opleiden, voorbereiden voor wedstrijden... En je moet elk jaar opnieuw beginnen, want enkel jonge vogels mogen aan de wedstrijden deelnemen. De goede oude vogels worden bewaard om te kweken of voor de voorzang.'"
                            }
                        ]
                    }
