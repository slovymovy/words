        "fr-extract.jsonl": [
            {
                "entry_id": "1ef0964d-3532-3a6a-8920-2b581ce4ed06",
                "word": "milicien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3769dc77-9d28-4c0a-a0ce-2e46a0743b57",
                        "entry_id": "1ef0964d-3532-3a6a-8920-2b581ce4ed06",
                        "tags": [
