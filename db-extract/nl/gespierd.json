                "senses": [
                    {
                        "sense_id": "86006310-07b5-3f72-acdb-e114cfe10489",
                        "entry_id": "b7fe7e6a-c08c-3687-a95b-ae6ca53b4607",
                        "glosses": [
                            "met sterk ontwikkelde stevige spieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b132b0c4-2a54-4587-addf-a6ee98910604",
                                "sense_id": "86006310-07b5-3f72-acdb-e114cfe10489",
                                "text": "Ik was goed in vorm, waardoor ik des te gekker opkeek toen iemand mij toch inhaalde. Deze persoon had gigantisch gespierde kuiten en twee lange blonde vlechten onder een versleten baseballcap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88521826-1316-4274-9550-b55e18e5386b",
                        "source_entry_id": "b7fe7e6a-c08c-3687-a95b-ae6ca53b4607",
                        "source_sense_id": "86006310-07b5-3f72-acdb-e114cfe10489",
                        "source_sense_description": "met sterk ontwikkelde stevige spieren",
                        "target_lang_word": "muskulös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muskulös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3d7d89b-cb9c-3be0-9956-cf7e23884af5",
                                        "entry_id": "04e6b791-6926-37fa-b7d7-88b65fc4514c",
                                        "glosses": [
                                            "kräftige Muskeln habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "039c191f-f1f2-48ac-ab11-132ea33dec0c",
                                                "sense_id": "a3d7d89b-cb9c-3be0-9956-cf7e23884af5",
                                                "text": "Sie hat vom Radfahren muskulöse Schenkel bekommen."
                                            },
                                            {
                                                "example_id": "caf1c5f8-b2c8-417e-b8d2-fb7a97066a2c",
                                                "sense_id": "a3d7d89b-cb9c-3be0-9956-cf7e23884af5",
                                                "text": "Viele Männer und Frauen rennen heute ins Sportstudio: beide wollen gut aussehen, die Männer muskulös, die Frauen sehnig schlank."
                                            },
                                            {
                                                "example_id": "c41882b5-5cab-41c8-897d-1b7f9cac35af",
                                                "sense_id": "a3d7d89b-cb9c-3be0-9956-cf7e23884af5",
                                                "text": "„Mein Traummann? Ein großer Mann mit schönen Händen, vollem Haar und rehbraunen Augen. Muskulös, klug, herzlich, humorvoll, tatkräftig, erfolgreich, treu und verlässlich. Ja, ich weiß, so einen gibt es nicht. Aber man wird doch noch träumen dürfen.“"
                                            },
                                            {
                                                "example_id": "7b2353ac-a125-4d79-bf79-99e8f5274a81",
                                                "sense_id": "a3d7d89b-cb9c-3be0-9956-cf7e23884af5",
                                                "text": "Manch einer hält sich für 'n Mann, wenn er muskulös ist, kräftig ist […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f1cb288-2749-4198-afdc-812aa5be228e",
                        "source_entry_id": "b7fe7e6a-c08c-3687-a95b-ae6ca53b4607",
                        "source_sense_id": "86006310-07b5-3f72-acdb-e114cfe10489",
                        "source_sense_description": "met sterk ontwikkelde stevige spieren",
                        "target_lang_word": "muscular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muscular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9087e41d-4b1d-376c-9d02-fa4e16624b6c",
                                        "entry_id": "87b7ddd7-dbeb-3a3a-8d8c-baa9513de3c9",
                                        "glosses": [
                                            "Of, relating to, or connected with muscles."
                                        ],
                                        "tags": [
                                            "relational"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f7985fc-4314-4b46-bb1c-88c771cc6b91",
                                                "sense_id": "9087e41d-4b1d-376c-9d02-fa4e16624b6c",
                                                "text": "It was an effort of the mind, of the will, of the nerves; not muscular, for I could not move even so much as my little finger, but none the less mighty for all that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e57f4e4-bc8b-300b-9a1b-25a03cbca376",
                                        "entry_id": "87b7ddd7-dbeb-3a3a-8d8c-baa9513de3c9",
                                        "glosses": [
                                            "Brawny, thewy, having strength."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ca727e7-bb3a-4f11-9efe-b9a2c0afd74e",
                                                "sense_id": "0e57f4e4-bc8b-300b-9a1b-25a03cbca376",
                                                "text": "It was a strange figure—like a child: yet not so like a child as like an old man, [...] The arms were very long and muscular; the hands the same, as if its hold were of uncommon strength."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c3d201-a495-354b-aabb-be11ed88a691",
                                        "entry_id": "87b7ddd7-dbeb-3a3a-8d8c-baa9513de3c9",
                                        "glosses": [
                                            "Having large, well-developed muscles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7d4d1ca-b5f0-3c42-90a7-5dbb07a8ffab",
                                        "entry_id": "87b7ddd7-dbeb-3a3a-8d8c-baa9513de3c9",
                                        "glosses": [
                                            "Robust, strong."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8be9eec2-0db4-43b3-8e51-5f6f8b580fb9",
                                                "sense_id": "c7d4d1ca-b5f0-3c42-90a7-5dbb07a8ffab",
                                                "text": "Future prime ministers may struggle to replicate the sort of muscular countrywide support that [Narendra] Modi was able to earn."
                                            },
                                            {
                                                "example_id": "8709b064-3193-4d1e-9ecf-71b2dcb4e858",
                                                "sense_id": "c7d4d1ca-b5f0-3c42-90a7-5dbb07a8ffab",
                                                "text": "The conservative movement faces real internal contradictions. On the one hand, there is deep skepticism of Washington-based power — think of the tea party and its “Don’t tread on me” bumper stickers. On the other, there is an eager embrace of a muscular view of the presidency for Trump, and before him, George W. Bush and Dick Cheney."
                                            },
                                            {
                                                "example_id": "bc69f6bd-bca3-44d2-9e48-f2bd204f095f",
                                                "sense_id": "c7d4d1ca-b5f0-3c42-90a7-5dbb07a8ffab",
                                                "text": "Playing out now, with Florida leading, is one of the most muscular policing movements in modern times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc96ed0-795a-32af-9ea6-cdc7040c9098",
                                        "entry_id": "87b7ddd7-dbeb-3a3a-8d8c-baa9513de3c9",
                                        "glosses": [
                                            "Full-bodied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac3c8b74-9ab7-416d-a0e6-701c913a8c0a",
                                                "sense_id": "4cc96ed0-795a-32af-9ea6-cdc7040c9098",
                                                "text": "muscular wine"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "348c9e82-2287-4ddc-895b-426e3daec47b",
                        "source_entry_id": "b7fe7e6a-c08c-3687-a95b-ae6ca53b4607",
