                                "sense_id": "f6f88cf5-e140-397a-9aa5-cfa97233edb2",
                                "text": "W transporterze opancerzonym przewożeni żołnierze są zwani desantem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d44dba4c-b871-3e49-b6d9-3dc9f9a74c94",
