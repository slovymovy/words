{
    "word_family": [
        "concession",
        "concessionnaire",
        "concessif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34ccc9dd-9a62-3dd0-9f0c-aaec69fe8dc9",
                    "sense_definition": "Admettre ou reconnaître un fait ou un argument adverse dans une discussion ou un débat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "debat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue discussion, il a fini par <w>concéder</w> que son adversaire avait raison."
                        },
                        {
                            "text": "Le ministre a dû <w>concéder</w> un point important lors des négociations avec les syndicats."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "reconnaître",
                        "avouer"
                    ],
                    "antonyms": [
                        "contester",
                        "nier"
                    ],
                    "common_phrases": [
                        "concéder un point",
                        "concéder sa défaite"
                    ]
                },
                {
                    "sense_id": "bc96ae20-9913-3ef0-a34a-252a1b173668",
                    "sense_definition": "Accorder un droit, un avantage ou un privilège à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "octroi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a refusé de lui <w>concéder</w> les jours de congé supplémentaires demandés."
                        },
                        {
                            "text": "L'accord signé hier va <w>concéder</w> de nouveaux droits aux représentants des salariés."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "octroyer",
                        "céder"
                    ],
                    "antonyms": [
                        "refuser",
                        "retirer"
                    ],
                    "common_phrases": [
                        "concéder un avantage",
                        "concéder un privilège"
                    ]
                },
                {
                    "sense_id": "b63c8d0d-ec93-350d-8e71-357b1eeffbe8",
                    "sense_definition": "Attribuer à une entreprise ou un tiers l'exploitation d'un service public ou la gestion d'un bien collectif.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "octroi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a choisi de <w>concéder</w> la gestion de l'eau à une entreprise privée."
                        },
                        {
                            "text": "L'État a décidé de <w>concéder</w> une ligne ferroviaire pour une durée de trente ans."
                        }
                    ],
                    "synonyms": [
                        "affermer",
                        "déléguer"
                    ],
                    "common_phrases": [
                        "concéder une licence",
                        "concéder une ligne"
                    ]
                }
            ]
        }
    ]
}