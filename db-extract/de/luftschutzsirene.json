                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa8ed60-4e92-4147-812f-5c18fbbd816e",
                                "sense_id": "46d1c95f-3b00-3f11-af28-39be5e7f5674",
                                "text": "„Die erste Luftschutzsirene seines Lebens vergisst man nicht.“"
                            },
                            {
                                "example_id": "3b43a725-f04d-41a0-ba4d-81a1a3a90774",
                                "sense_id": "46d1c95f-3b00-3f11-af28-39be5e7f5674",
                                "text": "„Zu Beginn des Herbstes, als sie nach einer Lesung mit André Spire gerade die leeren Flaschen und die Stühle wegräumten, gingen die Luftschutzsirenen los.“"
                            }
                        ],
