                    {
                        "sense_id": "b48d414e-eeeb-3787-89fa-848ffc4851e3",
                        "entry_id": "ae8771b5-fc79-34a5-bca2-8899ed8738e1",
                        "glosses": [
                            "warstwa płaszcza ziemskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47b6b32f-27b9-45e4-9bbe-6c78a9db662a",
                                "sense_id": "b48d414e-eeeb-3787-89fa-848ffc4851e3",
                                "text": "Górna granica astenosfery leży na głębokości od 10 do 100 km."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1443b31f-d809-4637-ae38-6520cb6745c4",
                        "source_entry_id": "ae8771b5-fc79-34a5-bca2-8899ed8738e1",
                        "source_sense_id": "b48d414e-eeeb-3787-89fa-848ffc4851e3",
                        "target_lang_word": "asthenosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asthenosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da6ba96-ee25-334d-98d0-2e7a3861bebb",
                                        "entry_id": "015fdca8-90c4-3778-a27b-faee62f78040",
                                        "glosses": [
                                            "The zone of the Earth's upper mantle, below the lithosphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4eb8d3-c7eb-47fc-8f96-1808ba449555",
                                                "sense_id": "0da6ba96-ee25-334d-98d0-2e7a3861bebb",
                                                "text": "To say that the lithosphere floats on top of the asthenosphere suggests a degree of easy buoyancy that isn't quite right."
                                            },
                                            {
                                                "example_id": "0681ce27-f75e-4aab-aa4a-0b8dd128dd5f",
                                                "sense_id": "0da6ba96-ee25-334d-98d0-2e7a3861bebb",
                                                "text": "The asthenosphere that underlies the surface plates is not liquid in any vernacular sense, although it is relatively plastic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e541491-057b-4ad4-8b5f-c79af79fae8e",
                        "source_entry_id": "ae8771b5-fc79-34a5-bca2-8899ed8738e1",
                        "source_sense_id": "b48d414e-eeeb-3787-89fa-848ffc4851e3",
                        "target_lang_word": "asthénosphère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asthénosphère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b1dcf49-3a83-36bd-a952-74086a638bb5",
                                        "entry_id": "df8f8669-fff6-3239-aad3-47828d49b9fe",
                                        "glosses": [
                                            "Partie ductile du manteau terrestre, située entre la lithosphère et la mésosphère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b88294db-218f-4450-9cd5-0a719d885238",
                                                "sense_id": "9b1dcf49-3a83-36bd-a952-74086a638bb5",
                                                "text": "Les masses volumiques de la lithosphère et de l’asthénosphère sont supposées égales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc640ada-cfa1-4128-9b0a-453f10ab5441",
                        "source_entry_id": "ae8771b5-fc79-34a5-bca2-8899ed8738e1",
                        "source_sense_id": "b48d414e-eeeb-3787-89fa-848ffc4851e3",
                        "target_lang_word": "astenosfera",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astenosfera",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e3107af2-3308-3ae7-afa1-d3436c70bb92",
                                        "entry_id": "afd36e08-a944-3a07-ac1b-414ec0f40863",
                                        "glosses": [
                                            "Zona del manto terrestre que está inmediatamente debajo de la litosfera, aproximadamente entre 100 y 240 kilómetros por debajo de la superficie de la Tierra. Esta compuesta de roca solida dúctil, con cierta fluidez."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c66e1bd-338c-473e-9caf-ffca2dfb37bf",
                        "source_entry_id": "ae8771b5-fc79-34a5-bca2-8899ed8738e1",
                        "source_sense_id": "b48d414e-eeeb-3787-89fa-848ffc4851e3",
                        "target_lang_word": "Asthenosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asthenosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bad72764-632f-346b-8f96-7b43b87cbab8",
                                        "entry_id": "e8a906ab-5d12-31db-bb9c-2ab779aeb617",
                                        "glosses": [
                                            "Schicht des Erdmantels, die plastisch verformbar ist und sich unterhalb der Lithosphäre befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdeff22a-a426-4afc-9729-4f6d22825986",
                                                "sense_id": "bad72764-632f-346b-8f96-7b43b87cbab8",
                                                "text": "„Es findet Konvektion statt, indem die unteren Schichten der Asthenosphäre aufgeheizt werden.“"
                                            },
                                            {
                                                "example_id": "0171f657-c469-457d-a10f-1c4c2df821a6",
                                                "sense_id": "bad72764-632f-346b-8f96-7b43b87cbab8",
                                                "text": "„Die Asthenosphäre ist ein paar Milliarden mal zäher als Honig, aber eben nicht ganz starr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f595076e-78f3-4443-bc73-693e6ecb9c34",
                        "source_entry_id": "ae8771b5-fc79-34a5-bca2-8899ed8738e1",
                        "source_sense_id": "b48d414e-eeeb-3787-89fa-848ffc4851e3",
