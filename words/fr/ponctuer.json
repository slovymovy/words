    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b81559e-853c-3efe-8268-077826b9733a",
                    "sense_definition": "Insérer des signes de ponctuation dans un texte écrit pour en structurer et clarifier la lecture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut apprendre à bien <w>ponctuer</w> un texte pour en faciliter la compréhension."
                        },
                        {
                            "text": "L'élève oublie souvent de <w>ponctuer</w> ses phrases avec des virgules."
                        }
                    ],
                    "common_phrases": [
                        "ponctuer une phrase",
                        "ponctuer un texte"
                    ]
                },
                {
                    "sense_id": "b79866ab-fd0d-397b-927c-43463d7341be",
                    "sense_definition": "Rythmer, marquer ou interrompre une action, un discours par des manifestations sonores ou des gestes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rythme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur aimait <w>ponctuer</w> son discours de silences calculés pour capter l'attention."
                        },
                        {
                            "text": "Des rires chaleureux venaient régulièrement <w>ponctuer</w> la discussion entre amis."
                        }
                    ],
                    "common_phrases": [
                        "ponctuer de rires",
                        "ponctuer son discours"
                    ]
                },
                {
                    "sense_id": "280bf3c1-4bb2-3151-a417-1fb9d0b577b5",
                    "sense_definition": "Être disséminé çà et là dans l'espace, parsemer un ensemble visuel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De petits villages blancs viennent <w>ponctuer</w> le paysage aride de la vallée."
                        },
                        {
                            "text": "Des touches d'or <w>ponctuent</w> l'obscurité de cette magnifique toile peinte."
                        }
                    ],
                    "synonyms": [
                        "parsemer"
                    ],
                    "common_phrases": [
                        "ponctuer le paysage"
                    ]
                },
                {
                    "sense_id": "4bdd4934-16db-3c60-8395-ae8fb3f28607",
                    "sense_definition": "Marquer les repos et délimiter les phrases mélodiques dans une composition musicale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le compositeur a choisi de <w>ponctuer</w> le thème par de brefs accords de cordes."
                        },
                        {
                            "text": "Ces silences expressifs permettent de <w>ponctuer</w> avec élégance chaque mouvement musical."
                        }
                    ]
                }
            ]
        }
    ]
