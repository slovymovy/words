                "senses": [
                    {
                        "sense_id": "daec0ac5-ba81-38e4-b5e2-b81fe0d8bf38",
                        "entry_id": "fb57fcd4-91f7-3896-a2a9-0337f64923dc",
                        "glosses": [
                            "od: mątwa"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "91d2199c-fcb6-41dd-8041-189cd3f1ee6e",
                                "sense_id": "daec0ac5-ba81-38e4-b5e2-b81fe0d8bf38",
                                "text": "Najłatwiej gotować pamułę ze śliwek (…). Gdy się już rozgotują, rozfyrta (rozmąci) się je mątewką, zatrzepie mąką i soli nieco"
                            },
                            {
                                "example_id": "79102f92-6ec1-470b-8c69-252776968936",
                                "sense_id": "daec0ac5-ba81-38e4-b5e2-b81fe0d8bf38",
                                "text": "Znikomek spożył kęs nieba i miesza złotą mątewką • Cień własny z cieniem brzóz kilku. A brzozy śnią się i szumią…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c796e3a5-04b8-39c4-a651-871f8a793906",
                        "entry_id": "fb57fcd4-91f7-3896-a2a9-0337f64923dc",
                        "glosses": [
                            "proste narzędzie do mieszania i rozmącania mąki w wodzie lub śmietanie, wykonane z rosochatej gałązki"
                        ],
                        "tags": [],
                        "examples": [],
