                                "sense_id": "02a5f58f-63cd-3478-811b-f2549faffd6f",
                                "text": "„Er kam im Watschelgang zum Schreibtisch und setzte sich auf den Besucherstuhl.“"
                            },
                            {
                                "example_id": "a9d68f8e-a913-47be-8511-3e7941fd6f0c",
                                "sense_id": "02a5f58f-63cd-3478-811b-f2549faffd6f",
                                "text": "„Ich setzte mich neben Amalia auf den einzigen Besucherstuhl und wartete.“"
                            }
