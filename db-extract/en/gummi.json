                                "target_senses": [
                                    {
                                        "sense_id": "58c923fa-6174-386b-accc-54d5effaed81",
                                        "entry_id": "f8efc4ce-51c3-31a3-84aa-a3b99f01b41f",
                                        "glosses": [
                                            "Kautschukprodukt, Material für weitere Endprodukte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "669d8b99-0e5b-424a-8eb7-7bf52673e683",
                                                "sense_id": "58c923fa-6174-386b-accc-54d5effaed81",
                                                "text": "Dieser Reifen besteht aus Gummi."
                                            },
                                            {
                                                "example_id": "d00fc305-7afe-438a-b37c-8e9bb2ec140a",
                                                "sense_id": "58c923fa-6174-386b-accc-54d5effaed81",
                                                "text": "„Die Flure waren groß, leer, muffig und rochen nach Gummi, weil in den Fahrradkellern Autoreifen gelagert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44e8e70b-438a-3f69-bcb2-3c37ed78ec1a",
                                        "entry_id": "f8efc4ce-51c3-31a3-84aa-a3b99f01b41f",
                                        "glosses": [
                                            "Gummiring, Gummiband"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "253c44f1-04ed-4084-9772-c59299661eae",
                                                "sense_id": "44e8e70b-438a-3f69-bcb2-3c37ed78ec1a",
                                                "text": "Ein Gummi war darum gespannt, um es zusammenzuhalten."
                                            },
                                            {
                                                "example_id": "df16bb07-901c-4977-8361-e5bcc0ee3d73",
                                                "sense_id": "44e8e70b-438a-3f69-bcb2-3c37ed78ec1a",
                                                "text": "„Tanz den Gummitwist! Ta ta ta ta tanz tanz tanz! Tanz den Gummi tanz den Gummi! Co Co Co Co Com Com Com! Computer Computer! Bin 'ne kleine Stubenfliege, nichts gelernt und weiß nicht viel, verstehe nichts von Mikro-Chips, Kernkraftbomben und so'n Zeugs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ac6325c2-dcb0-34c7-8ccb-25787144a5e5",
                                        "entry_id": "f8efc4ce-51c3-31a3-84aa-a3b99f01b41f",
                                        "glosses": [
                                            "Kondom"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb57835c-3b17-4541-90b1-3c95cf23e182",
                                                "sense_id": "ac6325c2-dcb0-34c7-8ccb-25787144a5e5",
                                                "text": "Hast du ein(en) Gummi dabei?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8303a5cf-cb0e-300a-ba28-4a5d5d90e023",
                                        "entry_id": "f8efc4ce-51c3-31a3-84aa-a3b99f01b41f",
                                        "glosses": [
                                            "Radiergummi"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f846908b-4eea-4958-8d4a-b58ecb2e7be1",
                                                "sense_id": "8303a5cf-cb0e-300a-ba28-4a5d5d90e023",
                                                "text": "Könntest du mir bitte mal das/den Gummi reichen?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
