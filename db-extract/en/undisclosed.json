                                                "sense_id": "2adc2808-2d5c-3c6f-b287-401d9b079f4a",
                                                "text": "Der ständige stille Vorwurf in den Augen der Mutter schmerzte ihn."
                                            },
                                            {
                                                "example_id": "3d8d0bb4-f333-45ce-a68b-eeb37ee53464",
                                                "sense_id": "2adc2808-2d5c-3c6f-b287-401d9b079f4a",
                                                "text": "Er war schon immer ein stilles Kind."
                                            },
                                            {
                                                "example_id": "d8baf5a0-e84c-402d-ac24-4a29ed7ba5df",
                                                "sense_id": "2adc2808-2d5c-3c6f-b287-401d9b079f4a",
                                                "text": "Plötzlich wurde es so still, dass man eine Stecknadel hätte fallen hören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b2b9f84b-d198-335c-912a-e8b5726e58a1",
                                        "entry_id": "5e8d44f8-720c-3217-a6c1-2730e1295bf0",
                                        "glosses": [
                                            "im Zustand der Zurückgezogenheit, der Verborgenheit, der Heimlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a9034a-f4c4-41e6-b832-16857b6b3925",
                                                "sense_id": "b2b9f84b-d198-335c-912a-e8b5726e58a1",
                                                "text": "Von unserem stillen Gesellschafter kennen nur wenige den Namen."
                                            },
                                            {
                                                "example_id": "3b1d89ba-94db-4fe1-a55d-6991403cc1e1",
                                                "sense_id": "b2b9f84b-d198-335c-912a-e8b5726e58a1",
                                                "text": "Ich habe ja noch die stille Hoffnung, dass sich das ändert, wenn sie zurückkommt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
