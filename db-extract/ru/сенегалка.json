                "senses": [
                    {
                        "sense_id": "db0e490d-7929-34a0-83f9-3135d23c96c9",
                        "entry_id": "25e90c20-96c1-3ec7-b692-0bc6f82f147d",
                        "glosses": [
                            "гражданка, жительница или уроженка Сенегала"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc3cf2c-9b39-4b00-80cb-3d12dc5ff5a0",
                                "sense_id": "db0e490d-7929-34a0-83f9-3135d23c96c9",
                                "text": "Я догадывалась, что ни французу Жану-Люку, ни голландцу Брэгу, ни испанцу Филиппу, Кэти — ирландке, сенегалке Сильвии, входящим в состав миссии, не понятно, странно зачем их шеф жену сюда приволок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa30afc7-ce04-4f8c-9443-ed1b9ea9bee8",
                        "source_entry_id": "25e90c20-96c1-3ec7-b692-0bc6f82f147d",
                        "source_sense_id": "db0e490d-7929-34a0-83f9-3135d23c96c9",
                        "target_lang_word": "Senegalese",
