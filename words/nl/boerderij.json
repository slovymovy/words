                            {
                                "target_lang_word": "farm",
                                "target_lang_sense_clarification": "the agricultural enterprise or land"
                            },
                            {
                                "target_lang_word": "farming operation",
                                "target_lang_sense_clarification": "the business aspect of agriculture"
                            },
                            {
                                "target_lang_word": "holding",
                                "target_lang_sense_clarification": "a piece of land used for farming"
                            }
                        ]
                    }
