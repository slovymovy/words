                    }
                ],
                "senses": [
                    {
                        "sense_id": "91d6ddf2-0aed-3a3a-81fe-b583aea24ea0",
                        "entry_id": "31a5efa6-07e6-3984-b342-f53615230f10",
                        "glosses": [
                            "Doctrine positiviste tentant d’expliquer tous les phénomènes par les lois de la physique ; doctrine de l’École d'Ionie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8253e18f-8a1f-4336-afce-36a1b15fc975",
                                "sense_id": "91d6ddf2-0aed-3a3a-81fe-b583aea24ea0",
                                "text": "Que la doctrine secrète des pythagoriciens se réduisît à croire à une sorte de physicisme, par lequel l'âme, sans conséquence avec la moralité de la vie, aurait passé de corps en corps, voilà qui est radicalement absurde."
                            }
                        ]
                    },
                    {
                        "sense_id": "1396a8b3-664d-34b1-b71e-7d8c16d674f0",
                        "entry_id": "31a5efa6-07e6-3984-b342-f53615230f10",
                        "glosses": [
                            "Tendance positiviste de tout accorder → voir vitalisme, solidisme et matérialisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676f86a9-6fba-4a82-ad1c-b564f97ddedb",
                                "sense_id": "1396a8b3-664d-34b1-b71e-7d8c16d674f0",
                                "text": "[La philosophie chrétienne] va réintroduire progressivement un peu de ce physicisme, dont les moralistes tendaient à se désintéresser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2c5fa8a-1a65-41c5-a6cf-583b0b702f9a",
                        "source_entry_id": "31a5efa6-07e6-3984-b342-f53615230f10",
                        "target_lang_word": "physicism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
