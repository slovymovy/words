                "senses": [
                    {
                        "sense_id": "28c3fc01-e1da-3474-855b-7f62105b14ee",
                        "entry_id": "05f8c14c-a3d7-33f8-9286-40bddd1ed7f8",
                        "glosses": [
                            "„Konstellation, bei der die Sonne einerseits sowie der Mond oder einer der Planeten andererseits auf gleicher geozentrischer ekliptikaler Länge stehen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348ab32e-aaf3-436c-ad1c-822f9d184e16",
                                "sense_id": "28c3fc01-e1da-3474-855b-7f62105b14ee",
                                "text": "„Bei der ersten Syzygie sagt man vom Monde, der zwischen der Erde und der Sonne steht, er sei in der Konjunktion.“ (1847)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19c6343b-e015-388b-ab6c-f3c0da7f4823",
                        "entry_id": "05f8c14c-a3d7-33f8-9286-40bddd1ed7f8",
                        "glosses": [
                            "Bildung eines Verstaktes aus der Verbindung zweier Versfüße"
                        ],
                        "tags": [
                            "antike Metrik"
                        ],
                        "examples": [
                            {
                                "example_id": "b6fcdb09-1779-4481-970a-328126ab0b48",
                                "sense_id": "19c6343b-e015-388b-ab6c-f3c0da7f4823",
                                "text": "„Hefästion bestimmt den Begriff logaödischer Verse so, dass sie mit Daktylen anfangen, und mit einer trochäischen Syzygie (Dipodie) endigen […].“ (1834)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a57c0cf3-ab8a-3cf7-84f1-799da016684d",
                        "entry_id": "05f8c14c-a3d7-33f8-9286-40bddd1ed7f8",
                        "glosses": [
                            "bestimmte Relation (nicht-triviale Beziehung) zwischen Polynomen (zwei Objekten)"
                        ],
                        "tags": [
                            "Algebra"
                        ],
                        "examples": [
                            {
                                "example_id": "b15c663e-6de8-4c5f-9a17-92813e635ef0",
                                "sense_id": "a57c0cf3-ab8a-3cf7-84f1-799da016684d",
                                "text": "s heißt Syzygie von g, wenn die Summe aller s1g1 bis sngn gleich 0 ist"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2810e71d-5f05-45fd-b161-e9a72322ed33",
                        "source_entry_id": "05f8c14c-a3d7-33f8-9286-40bddd1ed7f8",
                        "source_sense_id": "28c3fc01-e1da-3474-855b-7f62105b14ee",
                        "source_sense_description": "astronomische Konstellation",
                        "target_lang_word": "syzygy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syzygy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69234ef5-6bd3-3099-82b1-0d3d07b0836a",
                                        "entry_id": "cd921c67-e841-33d8-a504-dd748f9f046b",
                                        "glosses": [
                                            "An alignment of three celestial bodies (for example, the Sun, Earth, and Moon) such that one body is directly between the other two, such as occurs at an eclipse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec1c02d-780f-47f5-8251-d3b21497d91a",
                                                "sense_id": "69234ef5-6bd3-3099-82b1-0d3d07b0836a",
                                                "text": "The duration of an eclipse depends on the relative positions of the sun, moon, and earth in their syzygy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72863a5-4a86-3f5a-8a72-4a6151c6e550",
                                        "entry_id": "cd921c67-e841-33d8-a504-dd748f9f046b",
                                        "glosses": [
                                            "An archetypal pairing of contrasexual opposites, symbolizing the communication of the conscious and unconscious minds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dca9f845-79b0-4829-9b94-3934f1fc8648",
                                                "sense_id": "f72863a5-4a86-3f5a-8a72-4a6151c6e550",
                                                "text": "In 1936 Jung defends his concept of animus and anima by reference to the idea of the syzygy, concluding from the evidence in many different mythologies of the divine couple, united by a sacred marriage, that this motif is as universal as the existence of men and women. He postulates that in the syzygy the archetypal union of the parents is expressed, the mother corresponding to the anima."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d14dd6b-3d54-3b35-8f6b-3f17b5d511ec",
                                        "entry_id": "cd921c67-e841-33d8-a504-dd748f9f046b",
                                        "glosses": [
                                            "A relation between generators of a module."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7faca7d5-d697-408e-b8b6-208ff578ecd4",
                                                "sense_id": "1d14dd6b-3d54-3b35-8f6b-3f17b5d511ec",
                                                "text": "A finitely presented module is an A-module M given by a finite number of generators and relations. Therefore it is a module with a finite generator set having a finitely generated syzygy module."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72d89d9c-34c9-36b1-804b-97911825f24e",
                                        "entry_id": "cd921c67-e841-33d8-a504-dd748f9f046b",
                                        "glosses": [
                                            "The fusion of some or all of the organs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f8ec2df-5d58-364d-acd4-555872013bc9",
                                        "entry_id": "cd921c67-e841-33d8-a504-dd748f9f046b",
                                        "glosses": [
                                            "The association of two protozoa end-to-end or laterally for the purpose of asexual exchange of genetic material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "161e651e-4683-4477-9618-fa33658ec4a1",
                                                "sense_id": "8f8ec2df-5d58-364d-acd4-555872013bc9",
                                                "text": "When two or more arm-joints meet transversely by a rigid suture, and only the upper one is pinnule-bearing, those joints form a syzygy, whether their apposed faces are striated, dotted, or smooth."
                                            },
                                            {
                                                "example_id": "5bf75504-f623-4b60-9af2-5a7fafade8e1",
                                                "sense_id": "8f8ec2df-5d58-364d-acd4-555872013bc9",
                                                "text": "These include syzygy, fusion of larvae or adults of flatworms, fusion of buds of some Tunicata, somatic fertilization (fusion of spermatozoa with somatic cells), composite zygotes of some Cestoda and Insecta, and fusion of cells in various tissues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f2e34b1-8f9d-3fcd-8d1d-c2b2c7ef0205",
                                        "entry_id": "cd921c67-e841-33d8-a504-dd748f9f046b",
                                        "glosses": [
                                            "The pairing of chromosomes in meiosis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d510a91c-b413-3c21-8d6f-0b52d9420d87",
                                        "entry_id": "cd921c67-e841-33d8-a504-dd748f9f046b",
                                        "glosses": [
                                            "Complementary female–male pairings of the emanations known as Aeons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
