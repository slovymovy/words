                "senses": [
                    {
                        "sense_id": "0d7315d3-f98d-32dc-b028-4c114ec0200c",
                        "entry_id": "82bc7089-e85d-3108-b32c-b704b53d2ca4",
                        "glosses": [
                            "Aurore australe."
                        ],
                        "tags": [
                            "Géophysique"
                        ],
                        "examples": [
                            {
                                "example_id": "ad890b05-e3bd-445a-b853-7dbdefa690ce",
                                "sense_id": "0d7315d3-f98d-32dc-b028-4c114ec0200c",
                                "text": "Das Südlicht entsteht wesentlich über der südlichen Polkappe durch Fluoreszierung, wenn geladene und durch das Erdmagnetfeld gelenkte Teilchen aus dem Sonnenwind mit Atomen der Atmosphäre kollidieren.",
                                "translation": "Une aurore australe se forme essentiellement au-dessus de la calotte polaire sud par fluorescence, lorsque des particules chargées et guidées par le champ magnétique terrestre entrent en collision avec des atomes de l’atmosphère."
                            }
                        ]
                    }
                ],
