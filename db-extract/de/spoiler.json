                ],
                "senses": [
                    {
                        "sense_id": "424f2b90-6fca-3d05-bbcf-28b0c69e94e8",
                        "entry_id": "a0abfbc6-8932-3c12-9f8c-dc028d321234",
                        "glosses": [
                            "Fahrzeuganbauteil, welches die Fahrzeugumströmung verändern soll"
                        ],
                        "tags": [
                            "Automobil"
                        ],
                        "examples": [
                            {
                                "example_id": "41d96236-9a9b-4316-ac3c-6556713909b4",
                                "sense_id": "424f2b90-6fca-3d05-bbcf-28b0c69e94e8",
                                "text": "Der Spoiler presste den Rennwagen an die Straße."
                            },
                            {
                                "example_id": "47057a9b-7d02-4fff-a9ea-1ae924a12e20",
                                "sense_id": "424f2b90-6fca-3d05-bbcf-28b0c69e94e8",
                                "text": "„Deshalb wurden die 02er-Modelle rasch nachgeschoben, zweitürige Klein-Rabauken mit scharfen Vierzylindern, bis hin zum provokanten BMW 2002 Turbo, der mit seiner pubertierenden Modellbezeichnung in Spiegelschrift auf dem vorderen Spoiler („Kriegsbemalung“) für das Überholprestige sorgen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "325b91a6-f034-3471-b5a5-fc305b6d3f36",
                        "entry_id": "a0abfbc6-8932-3c12-9f8c-dc028d321234",
                        "glosses": [
                            "bewegliche Klappe auf der Oberseite der Tragflächen von Flugzeugen"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "19e886a2-34a8-4e93-ac63-f0d715488e48",
                                "sense_id": "325b91a6-f034-3471-b5a5-fc305b6d3f36",
                                "text": "Ohne die Spoiler wäre das Flugzeug über die Landebahn hinausgeschossen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "36bdc70b-ebda-3fc2-a952-35baa76e5fcc",
                        "entry_id": "a0abfbc6-8932-3c12-9f8c-dc028d321234",
                        "glosses": [
                            "Spannung verderbende Inhaltsangabe"
                        ],
                        "tags": [
                            "Medien"
                        ],
                        "examples": [
                            {
                                "example_id": "bc385faa-5f19-463d-b85c-ea393a663bf5",
                                "sense_id": "36bdc70b-ebda-3fc2-a952-35baa76e5fcc",
                                "text": "Der Spoiler ruinierte den ganzen Film."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c75aad4-babd-4706-ba7e-6b939534e8be",
                        "source_entry_id": "a0abfbc6-8932-3c12-9f8c-dc028d321234",
                        "source_sense_id": "424f2b90-6fca-3d05-bbcf-28b0c69e94e8",
                        "source_sense_description": "Automobil: Fahrzeuganbauteil, welches die Fahrzeugumströmung verändern soll",
                        "target_lang_word": "spoiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spoiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f290ac0a-2dd5-3347-8c64-97f512a8700f",
                                        "entry_id": "409c27fb-e568-33f4-bb48-61206393d3ed",
                                        "glosses": [
                                            "Dispositif aérodynamique amovible visant à diminuer la portance d’un véhicule (voiture, avion)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b281ed4-8368-4bb3-b406-5fca4b524bd3",
                                                "sense_id": "f290ac0a-2dd5-3347-8c64-97f512a8700f",
                                                "text": "Jacob Mkezi, Cake Mullins et lui entourent la Subaru bleue, équipée d'un spoiler, garée dans l'allée de la villa de Cake Mullins à Constantia."
                                            },
                                            {
                                                "example_id": "6c0d8a94-cb1c-4dc9-a160-03ba37c7d34a",
                                                "sense_id": "f290ac0a-2dd5-3347-8c64-97f512a8700f",
                                                "text": "Suite au crash de l'American 965, un débat fit rage au sujet de non rentrée automatique des spoilers lorsque le pilote appliqua la poussée maximale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "329a7c12-86c8-377e-a13f-e6ab848cc93d",
                                        "entry_id": "409c27fb-e568-33f4-bb48-61206393d3ed",
                                        "glosses": [
                                            "Divulgation prématurée d’un élément clé (d’une intrigue, d’un jeu, etc.) susceptible de gâcher, de spolier une partie du plaisir."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "747e60b7-65a5-4a12-b537-1df0c71b160d",
                                                "sense_id": "329a7c12-86c8-377e-a13f-e6ab848cc93d",
                                                "text": "Néanmoins, nous avons pris soin d'éviter de gâter le plaisir en éventant les rebondissements inattendus et autres effets de surprise. Les spoilers contenus dans le présent ouvrage sont comparables à ceux qu'on peut rencontrer dans une discussion générale sur ces histoires. Autrement dit, quelques éléments peuvent être dévoilés, mais pas d'inquiétude : rien ne sera gâché."
                                            },
                                            {
                                                "example_id": "5fe09e82-ebc8-44f5-9a52-a30a29c40113",
                                                "sense_id": "329a7c12-86c8-377e-a13f-e6ab848cc93d",
                                                "text": "Faute de place ici, et tant pis pour le spoiler, je vais directement au terme de la saison : la fin du suspense est marquée, comme il se doit, par la défaite du pauvre Clemens, imprudent devant l'ambitieux prélat stagiaire. Georg triomphe ! C'est amoral, je sais, mais c'est le choix du scénariste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spoiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1abf1c9-3718-3542-be17-080d5577c00b",
                                        "entry_id": "3cbe3926-8ac2-381f-85aa-c5233a06951a",
                                        "glosses": [
                                            "Dévoiler à l’avance ou divulguer prématurément un élément clé (d’une intrigue, d’une annonce, etc.) ; donner un spoiler."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cc5efb6-c42c-47d5-98c6-ac64adac6707",
                                                "sense_id": "f1abf1c9-3718-3542-be17-080d5577c00b",
                                                "text": "Oui, l'un et l'autre sont beaucoup de choses mais ils ne spoilent pas les films sans s'en rendre compte, ne disparaissent pas, ne se douchent pas pendant trois heures, ne perdent pas la notion du temps, […]."
                                            },
                                            {
                                                "example_id": "909613b6-46e6-493c-ab41-19183dbb65ab",
                                                "sense_id": "f1abf1c9-3718-3542-be17-080d5577c00b",
                                                "text": "Baylet spoile une partie du gouvernement. [Concernant la divulgation du nom de certains ministres avant leur annonce officielle.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
