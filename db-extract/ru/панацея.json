                                                "example_id": "275e73fc-bee2-43d9-9f2f-d702afc307d6",
                                                "sense_id": "49fc2155-df04-3867-9339-33b9bc021ede",
                                                "text": "Es wäre naiv zu glauben, dass es sich um eine Panazee handle."
                                            }
