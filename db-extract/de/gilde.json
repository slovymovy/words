                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e5486e1-a471-3f86-8dee-84b1c6301eb9",
                                        "entry_id": "e6a05a82-daaf-32ee-ae39-a4eef59b9e76",
                                        "glosses": [
                                            "Au Moyen Âge en Europe, corporation de personnes, en général des artisans, des marchands ou des artistes, partageant et promouvant des intérêts communs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734e5270-5bfc-43bc-8257-e360db599c73",
                                                "sense_id": "5e5486e1-a471-3f86-8dee-84b1c6301eb9",
                                                "text": "Tandis que la guerre et la peste font éclater les cadres féodaux, ceux de la guilde et de la corporation deviennent, eux aussi, trop étroits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7408e4d4-bee4-3964-abd8-01aafac4519e",
                                        "entry_id": "e6a05a82-daaf-32ee-ae39-a4eef59b9e76",
                                        "glosses": [
                                            "Association privée présentant des avantages particuliers à ses membres ou visant à promouvoir un objectif particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f830a3bb-ce8c-40e0-8c91-d400cd621a2b",
                                                "sense_id": "7408e4d4-bee4-3964-abd8-01aafac4519e",
                                                "text": "Grâce à la guilde du livre, dont je suis adhérent, j'ai pu acheter cet ouvrage à tarif préférentiel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8976b958-0b69-38fd-a8c0-da2e962f0a1c",
                                        "entry_id": "e6a05a82-daaf-32ee-ae39-a4eef59b9e76",
                                        "glosses": [
                                            "Communauté de joueurs, notamment pour les jeux de rôle en ligne massivement multijoueurs."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de972a3-26a1-479a-ad6f-d75bc4bb5309",
                                                "sense_id": "8976b958-0b69-38fd-a8c0-da2e962f0a1c",
                                                "text": "Il participe activement à la vie de sa guilde en aidant les nouveaux joueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dcc2b9c-8428-3011-94ab-46f6a9c6b169",
                                        "entry_id": "e6a05a82-daaf-32ee-ae39-a4eef59b9e76",
                                        "glosses": [
                                            "Ensemble d’espèces appartenant à un même groupe taxonomique ou fonctionnel qui exploitent une ressource commune de la même manière en même temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fd31e8b-41d2-40b4-a9f4-16e01539f8cf",
                                                "sense_id": "2dcc2b9c-8428-3011-94ab-46f6a9c6b169",
                                                "text": "Il existe des espèces phylogénétiquement proches au sein d’une même guilde d’oviposition appartenant aux genres Mimosestes et Stator (Morse et Farell, 2005 ; Kato et al., 2006)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
