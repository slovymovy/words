                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea23d66c-4cfa-4ec1-8ea8-e69ccdcddebb",
                        "entry_id": "358e39f2-cc3e-3f5d-b17a-92379ef6508a",
