                        "zh": "在扑克中把自己剩下的全部筹码一次押上。",
                        "cs": "Vsadit všechny zbývající žetony v pokerové hře."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти ва-банк",
                                "target_lang_sense_clarification": "рисковать всем"
