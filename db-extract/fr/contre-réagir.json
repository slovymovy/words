                                "example_id": "4ab14f85-b92b-40f0-bebb-b51dd78baa9b",
                                "sense_id": "f5911bc6-3ded-344e-b2f5-5ec10e2aea92",
                                "text": "Les sujets hautement hypnotisables échouent souvent à contre-réagir aux suggestions de défi (ils ne plient pas le bras) tout en donnant l’apparence de s’efforcer à le faire."
                            },
                            {
                                "example_id": "6ba68d55-5294-4317-989c-dfa376bdd7fb",
                                "sense_id": "f5911bc6-3ded-344e-b2f5-5ec10e2aea92",
                                "text": "Plutôt que de contre-réagir, le rejeté ne peut que modestement adopter la position de repli propre au désarroi."
                            }
                        ]
