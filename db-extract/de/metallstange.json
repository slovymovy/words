                            {
                                "example_id": "c9a66db1-bdb0-4500-95df-1774de3e8a62",
                                "sense_id": "3e5b114c-ba3e-33ac-9c9e-3ca608b244a9",
                                "text": "„Das Tor bestand aus Metallstangen, die zu massiv waren, um sie zu rammen, außerdem war es elektrifiziert, und die Wachen hatten den Wagen fast erreicht.“"
                            },
                            {
                                "example_id": "9f8ee373-38d1-4ffe-8f69-81e06d4393ce",
                                "sense_id": "3e5b114c-ba3e-33ac-9c9e-3ca608b244a9",
                                "text": "„Ich hörte ihn tief einatmen, dann legte er die Hände auf die Metallstangen der Reling, die er fest umschloss.“"
                            }
                        ],
