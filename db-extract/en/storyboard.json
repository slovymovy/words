                        "entry_id": "410d1a24-bd03-3165-91ab-bc875cd8ed80",
                        "glosses": [
                            "Any sequence of drawings or diagrams which illustrate a sequence of events, e.g. in an accident or as a flowsheet for computer programming."
                        ],
