                "senses": [
                    {
                        "sense_id": "e5f8fd7f-dcd9-3e40-afca-9d4b08567546",
                        "entry_id": "aba7f791-8723-3dac-8ee7-7372b08cc6b4",
                        "glosses": [
                            "Trahir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd4297e-2160-4366-80f1-3c7851e9666e",
                                "sense_id": "e5f8fd7f-dcd9-3e40-afca-9d4b08567546",
                                "text": "Les maréchaux, qui avaient à peine eu le temps de trahir l'empereur pour le roi, durent retrahir le roi pour l'empereur."
                            },
                            {
                                "example_id": "bbf7282e-2fec-450e-a4e3-92287b2ed05a",
                                "sense_id": "e5f8fd7f-dcd9-3e40-afca-9d4b08567546",
                                "text": "Le Roy donna de celuy jour à trente jours le jour des armes à cheval, puis en sa chambre se retrahir."
                            }
                        ]
                    }
