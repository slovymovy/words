{
    "word_family": [
        "tautological",
        "tautologically",
        "tautologize",
        "tautologist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "795e78c0-f1ae-3cb8-a0f8-b86d7036aa79",
                    "sense_definition": "The redundant use of words to express the same idea; unnecessary repetition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rhetoric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avoid unnecessary <w>tautology</w> in your essays to keep your writing clear and concise."
                        },
                        {
                            "text": "The editor noted that the manuscript suffered from excessive <w>tautology</w>."
                        },
                        {
                            "text": "The phrase \"free gift\" is a common <w>tautology</w> because all gifts are inherently free."
                        },
                        {
                            "text": "Using phrase like \"unnecessary <w>tautology</w>\" is itself repetitive."
                        }
                    ],
                    "synonyms": [
                        "pleonasm",
                        "redundancy"
                    ],
                    "common_phrases": [
                        "unnecessary tautology",
                        "avoid tautology"
                    ]
                },
                {
                    "sense_id": "b9470173-8b27-3e9b-b73d-f072e247c751",
                    "sense_definition": "A statement or phrase that repeats an idea using different words.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rhetoric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expression \"raze to the ground\" is a <w>tautology</w> since the word \"raze\" already includes the notion of being on the ground."
                        },
                        {
                            "text": "Saying that a person is a \"single bachelor\" is a classic <w>tautology</w>."
                        }
                    ],
                    "synonyms": [
                        "pleonasm"
                    ],
                    "common_phrases": [
                        "classic tautology"
                    ]
                },
                {
                    "sense_id": "f2fed6b4-8a50-34d4-932c-972d19192f71",
                    "sense_definition": "In logic, a statement that is necessarily true in all possible contexts or interpretations.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, a statement such as \"A or not A\" is considered a logical <w>tautology</w>."
                        },
                        {
                            "text": "The mathematical proof relies on a logical <w>tautology</w> that holds true under every condition."
                        }
                    ],
                    "antonyms": [
                        "contradiction"
                    ],
                    "common_phrases": [
                        "logical tautology"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical logic domain"
                        }
                    ]
                }
            ]
        }
    ]
}