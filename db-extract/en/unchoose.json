                "senses": [
                    {
                        "sense_id": "d76247be-228d-3f8f-b83a-e9d986df2c77",
                        "entry_id": "69a546d3-478d-3adf-8d1e-5c23a7c71d75",
                        "glosses": [
                            "To not choose; choose against; deselect; reject."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a3fe5abe-5bd2-434e-8d07-32c27def7d11",
                                "sense_id": "d76247be-228d-3f8f-b83a-e9d986df2c77",
                                "text": "At the point where a goal is perceived as too easy to be worth investment of effort, effort is reduced as we “unchoose” the goal."
                            },
                            {
                                "example_id": "fa57f060-a2ac-42f1-8cb5-69d6c38ad5fb",
                                "sense_id": "d76247be-228d-3f8f-b83a-e9d986df2c77",
                                "text": "One glory of a family is you'd never choose your kin and can't unchoose your daddy's hazel eyes — no more than you could unchoose your hand."
                            },
                            {
                                "example_id": "ae9d7b44-3ef8-4d63-8a84-a468212d8f4a",
                                "sense_id": "d76247be-228d-3f8f-b83a-e9d986df2c77",
                                "text": "In other words, if the depression is a survival mechanism chosen by the woman when she was a child, then it is within her power to unchoose depression and to heal."
                            }
                        ]
                    }
