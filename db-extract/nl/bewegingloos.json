                        "examples": [
                            {
                                "example_id": "89495192-4930-42d1-b0d8-befdd6d18be4",
                                "sense_id": "1cad3b15-7095-39e2-a37a-0aaf7700a035",
                                "text": "Bewegingloos loerde de poes naar het vogeltje dat hij wilde vangen."
                            },
                            {
                                "example_id": "948a29a4-dc6c-452c-80da-45e8afaf2277",
                                "sense_id": "1cad3b15-7095-39e2-a37a-0aaf7700a035",
                                "text": "Hoewel de drang groot was om hem wakker te maken en te vertellen dat zij elke minuut van de dag aan hem dacht en er altijd voor hem zou zijn, bleef zij bijna bewegingloos op de afschuwelijke stoel zitten."
                            }
                        ]
                    }
