                "senses": [
                    {
                        "sense_id": "eb665739-0a71-3b99-affc-eb2364ff846a",
                        "entry_id": "3617884b-029c-36be-a48d-093fa87cf614",
                        "glosses": [
                            "het vermogen om het leven in te richten zonder hulp van anderen"
