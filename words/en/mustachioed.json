{
    "word_family": [
        "mustache",
        "mustachio"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07ca7c64-9a1c-38be-b4cb-ea68d8e9eec5",
                    "sense_definition": "Having or wearing a mustache.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "facial_hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A tall, <w>mustachioed</w> man in a suit greeted us warmly at the front entrance.",
                            "target_lang_translations": {
                                "de": "Ein großer, <w>schnurrbärtiger</w> Mann im Anzug begrüßte uns herzlich am Haupteingang."
                            }
                        },
                        {
                            "text": "The detective remembered seeing a <w>mustachioed</w> suspect running away from the scene.",
                            "target_lang_translations": {
                                "de": "Der Detektiv erinnerte sich daran, einen Tatverdächtigen <w>mit Schnurrbart</w> vom Tatort fliehen gesehen zu haben."
                            }
                        }
                    ],
                    "synonyms": [
                        "moustachioed"
                    ],
                    "antonyms": [
                        "clean-shaven",
                        "beardless"
                    ],
                    "common_phrases": [
                        "mustachioed man",
                        "mustachioed gentleman"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Schnurrbart habend oder tragend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schnurrbärtig",
                                "target_lang_sense_clarification": "einen Schnurrbart tragend"
                            },
                            {
                                "target_lang_word": "mit Schnurrbart",
                                "target_lang_sense_clarification": "präpositionale Wendung für schnurrbärtig"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4dad398-3e20-3ec2-b369-dd5389860c74",
                    "sense_definition": "simple past and past participle of <w>mustachio</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "facial_hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The playful artist <w>mustachioed</w> the famous portrait with thick black ink.",
                            "target_lang_translations": {
                                "de": "Der verspielte Künstler <w>versah</w> das berühmte Porträt mit dicker schwarzer Tinte <w>mit einem Schnurrbart</w>."
                            }
                        },
                        {
                            "text": "He was extravagantly <w>mustachioed</w> for his starring role in the historical drama.",
                            "target_lang_translations": {
                                "de": "Für seine Hauptrolle im Historiendrama wurde er extravagant <w>mit einem Schnurrbart ausgestattet</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Präteritum und Partizip Perfekt von 'mustachio' (mit einem Schnurrbart versehen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mit einem Schnurrbart versehen",
                                "target_lang_sense_clarification": "jemandem oder etwas einen Schnurrbart verpassen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
