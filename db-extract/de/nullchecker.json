                        "entry_id": "4b24a691-03ee-3e18-850b-e907b5c965c6",
                        "glosses": [
                            "eine Person, die nichts begreift"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "da3f6e78-c0f4-4b72-8da6-138191f6ad24",
                                "sense_id": "93ab9cff-7f41-36e2-8d88-2db06df94453",
                                "text": "„Dann sind Sie vermutlich ein Ü-20er und ein echter Nullchecker.“"
                            },
                            {
                                "example_id": "fb9fdc2b-f248-4140-b505-462f80588bfc",
                                "sense_id": "93ab9cff-7f41-36e2-8d88-2db06df94453",
                                "text": "„Und der sich einiges anhören muss vom Kleinen, der ihn mal „Nullchecker“ mal „Knirps“ tituliert.“"
                            },
                            {
                                "example_id": "0472382b-0d73-4518-8cdd-b927ed27be47",
                                "sense_id": "93ab9cff-7f41-36e2-8d88-2db06df94453",
                                "text": "„I bims 1 Nullchecker!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
