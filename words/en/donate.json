    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "188109f6-9847-3e2d-aec5-0cf803719f57",
                    "sense_definition": "To give money, goods, or services to a person or organization, especially a charity, to help them.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>donates</w> 100 dollars to the Red Cross every year to help those in need.",
                            "target_lang_translations": {
                                "ru": "Она ежегодно <w>жертвует</w> 100 долларов Красному Кресту, чтобы помочь нуждающимся."
                            }
                        },
                        {
                            "text": "He <w>donated</w> a rare etching from his own collection to the new art gallery.",
                            "target_lang_translations": {
                                "ru": "Он <w>передал в дар</w> новой художественной галерее редкую гравюру из своей собственной коллекции."
                            }
                        },
                        {
                            "text": "Many people choose to <w>donate</w> money to local food banks during the holiday season.",
                            "target_lang_translations": {
                                "ru": "Многие люди предпочитают <w>жертвовать</w> деньги местным продовольственным фондам во время праздников."
                            }
                        }
                    ],
                    "synonyms": [
                        "contribute",
                        "give",
                        "bestow",
                        "present"
                    ],
                    "antonyms": [
                        "receive",
                        "take",
                        "keep",
                        "withdraw"
                    ],
                    "common_phrases": [
                        "donate money",
                        "donate blood",
                        "donate clothes",
                        "donate generously"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать деньги, товары или услуги человеку или организации, особенно благотворительной, в качестве помощи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жертвовать",
                                "target_lang_sense_clarification": "добровольно отдавать в дар, обычно на благотворительность"
                            },
                            {
                                "target_lang_word": "пожертвовать",
                                "target_lang_sense_clarification": "совершить акт дарения (совершенный вид)"
                            },
                            {
                                "target_lang_word": "передавать",
