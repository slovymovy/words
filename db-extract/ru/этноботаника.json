                                        "entry_id": "71a446f8-a010-35a1-b5ba-69065316236e",
                                        "glosses": [
                                            "Qui concerne l’étude des relations entre les peuples et les plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
