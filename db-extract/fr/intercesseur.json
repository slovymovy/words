                        ],
                        "form": "intercesseuse"
                    },
                    {
                        "form_id": "7fb13b58-e5f4-44cc-b254-dde906c9799e",
                        "entry_id": "fa869e2e-daf0-3536-8720-972d8d567ed9",
                        "tags": [
                            "feminine"
                        ],
                        "form": "intercessrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                        "entry_id": "fa869e2e-daf0-3536-8720-972d8d567ed9",
                        "glosses": [
                            "Celui qui intercède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c41da0e-d76d-43d5-b3f5-3f46f5e67592",
                                "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                                "text": "Selon lui, il n’y avait qu’un seul intercesseur pour renouer le contact avec Roger Fu-Seng : l’ambassade de Chine populaire à Paris."
                            },
                            {
                                "example_id": "d3b50153-e53a-4cc1-91e4-b5a2b438e84e",
                                "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                                "text": "Une sorte de préalable nécessaire, bénéfique à l'écriture, de geste propitiatoire — le premier d'une série qui me fera plus tard retourner dans divers endroits — ou de prière, comme si le lieu pouvait être un obscur intercesseur entre la réalité passée et l'écriture."
                            },
                            {
                                "example_id": "b2163a59-03b8-4e0f-b31c-1587e2b4985a",
                                "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                                "text": "Il lui semblait s’offrir, comme aux intercesseurs d’un dieu inconnu, à ces paquebots énormes, hérissés, chargés de destinées, indifférents à lui jusqu’à la haine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eeecd472-ed4d-4fe5-aa76-26b48f39c595",
                        "source_entry_id": "fa869e2e-daf0-3536-8720-972d8d567ed9",
                        "source_sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
