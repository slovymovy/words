                                "target_senses": [
                                    {
                                        "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                        "entry_id": "3c1d5119-1b7f-31c6-866e-a991eac75f2e",
                                        "glosses": [
                                            "größeres Gefäß für Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e315f8b-6dff-4b27-8bf4-0414a405c318",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "In diese Kanne passen 1,8 Liter."
                                            },
                                            {
                                                "example_id": "3a285f67-ff00-44f0-8adf-c10ce7100f58",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "„Lenzfreude holte nun die Kanne hervor und brachte sie nach den hinteren Räumen.“"
                                            },
                                            {
                                                "example_id": "706056a1-237a-484c-bba4-e6cd520088ae",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "„Der Kaffee war in einer Kanne und der Zucker daneben.“"
                                            },
                                            {
                                                "example_id": "8263fa93-6791-4cad-9edf-3868e352bf6e",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "„Ich starrte die Kanne in der Kaffeemaschine an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2de365c-9d2c-4ba8-b047-2fcf5420c78f",
                        "source_entry_id": "2b029111-b859-3c23-bacc-d911ac714dd3",
                        "target_lang_word": "Wasserkanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserkanne",
