                                        "glosses": [
                                            "The nasal part of the pharynx, lying behind the nose and above the level of the soft palate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0bd8e08-d65e-45df-9859-c9b6e562be7c",
                                                "sense_id": "a77b52a1-b6a2-385b-8bb0-c0cfc401ddac",
                                                "text": "Occasionally she gasped out \"Joe!\" — a flat animal cry that her slack vocal cords made unfemininely deep, that her nasopharynx, choked with mucus, robbed of all resonance."
                                            }
                                        ]
                                    }
                                ]
                            }
