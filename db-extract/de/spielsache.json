                    {
                        "form_id": "b0b0f309-cb0d-45bc-8db7-c9b69d9e6f18",
                        "entry_id": "64cd4ca0-e504-3095-8f8b-39c2656acbe5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Spielsachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76dc3ec9-8dc4-3f5a-be7d-5cb740755a84",
                        "entry_id": "64cd4ca0-e504-3095-8f8b-39c2656acbe5",
                        "glosses": [
                            "Gegenstand, mit dem gespielt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46a56db-8de7-4631-ba82-541c7487cd23",
                                "sense_id": "76dc3ec9-8dc4-3f5a-be7d-5cb740755a84",
                                "text": "„Das Kind signalisierte durch seinen Blick Zweifel, fing unter den Spielsachen zu suchen an, fand die Katze und gab sie dem Versuchsleiter.“"
                            },
                            {
                                "example_id": "b4262df0-abeb-4430-a40e-6d8a4f138d92",
                                "sense_id": "76dc3ec9-8dc4-3f5a-be7d-5cb740755a84",
                                "text": "„Im Prinzip, sagt er, könne jedes Spielzeug in einer bestimmten Situation ‚gut‘ sein – denn Kinder entschieden selbst, welche ‚Funktion‘ sie einer Spielsache verleihen.“"
                            },
                            {
                                "example_id": "6ff8a25a-d891-46cb-b85a-a85e9285338f",
                                "sense_id": "76dc3ec9-8dc4-3f5a-be7d-5cb740755a84",
                                "text": "„Zu den glücklichsten Erfahrungen zählte damals neben meinen Aktivitäten auf der Straße das Spielen mit meinen Spielsachen in der Wohnung.“"
                            },
                            {
                                "example_id": "b3f9628d-a8d2-4ba4-9843-8b24dad83d22",
                                "sense_id": "76dc3ec9-8dc4-3f5a-be7d-5cb740755a84",
                                "text": "„Die Flammen vernichteten das Stoffbild mit dem Fischerboot und auch die wenigen Spielsachen der Kinder, unter anderem Chrissis einzige Strohpuppe mit dunkelbraunen Knopfaugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18d4af2f-b0ba-466a-bb56-d4bd124c6525",
                        "source_entry_id": "64cd4ca0-e504-3095-8f8b-39c2656acbe5",
                        "source_sense_id": "76dc3ec9-8dc4-3f5a-be7d-5cb740755a84",
                        "source_sense_description": "Gegenstand, mit dem gespielt werden kann",
                        "target_lang_word": "игрушка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "игрушка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "96220e8f-66e6-34b2-af93-72496c55f318",
                                        "entry_id": "29fe5cfa-51d1-338b-b974-15cbb58ea014",
                                        "glosses": [
                                            "вещь, предназначенная детям для игры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ce7b17-d2d2-43d4-900a-2a2df04969ba",
                                                "sense_id": "96220e8f-66e6-34b2-af93-72496c55f318",
                                                "text": "Когда ему показали несколько игрушек, он пришёл в восторг от искусно сделанного жокея на собаке: собака перебирала ногами, а жокей качался взад и вперёд и натягивал вожжи, как живой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0e36b90-8574-35a5-8b8a-ed5684f37704",
                                        "entry_id": "29fe5cfa-51d1-338b-b974-15cbb58ea014",
                                        "glosses": [
                                            "предмет забавы, развлечение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a00d5c-fc15-4eef-99bf-150154114520",
                                                "sense_id": "e0e36b90-8574-35a5-8b8a-ed5684f37704",
                                                "text": "Жизнь не игрушка, а трудное дело."
                                            },
                                            {
                                                "example_id": "a04913bc-c45a-4b42-92ae-0c7e29553c1e",
                                                "sense_id": "e0e36b90-8574-35a5-8b8a-ed5684f37704",
                                                "text": "Это вам — не игрушка!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2475db8-ad89-3cf7-aeb5-8728bffa2e34",
                                        "entry_id": "29fe5cfa-51d1-338b-b974-15cbb58ea014",
                                        "glosses": [
                                            "разг., уменьш. к игра, игровая программа (часто о компьютерных и видеоиграх)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9df0a6c5-02bd-4a3a-baca-7379c9ecbd71",
                                                "sense_id": "e2475db8-ad89-3cf7-aeb5-8728bffa2e34",
                                                "text": "Поставил на компьютер новую игрушку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cf26743-29f5-3331-a39f-dd82651b4b37",
                                        "entry_id": "29fe5cfa-51d1-338b-b974-15cbb58ea014",
                                        "glosses": [
                                            "перен., книжн. о ком-то или чём-то, являющемся орудием в чьих-то руках, слепым инструментом, действующим по чужой воле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8838e86-6abc-4df9-bf98-3348bf077f74",
                                                "sense_id": "8cf26743-29f5-3331-a39f-dd82651b4b37",
                                                "text": "Мне надоели обычные развлечения, а хорошо шутить можно только одним способом: делать из людей игрушки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e200bf-623f-3f99-a461-df0d8b265547",
                                        "entry_id": "29fe5cfa-51d1-338b-b974-15cbb58ea014",
                                        "glosses": [
                                            "разг., фам., о ком-чём-н. изящном, нарядном"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого и в сравнениях"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "869e0504-27d1-40ec-8320-aa77bab31758",
                                                "sense_id": "23e200bf-623f-3f99-a461-df0d8b265547",
                                                "text": "Паровоз выпустили — прямо игрушка!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
