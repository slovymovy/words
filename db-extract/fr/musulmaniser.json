                "senses": [
                    {
                        "sense_id": "cbf33879-fd70-3882-a108-776cd9c4d647",
                        "entry_id": "2cd05165-43f9-3d4e-a0ac-722a012a9edf",
                        "glosses": [
                            "Donner un caractère musulman à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c76a97c5-a321-4fa8-99b4-b0f74365943c",
                                "sense_id": "cbf33879-fd70-3882-a108-776cd9c4d647",
                                "text": "Tu n’essayes donc pas d’hindouiser tes musulmans ni de musulmaniser mes hindous."
                            },
                            {
                                "example_id": "f99354e3-2244-4c50-8d50-513158e8cfb7",
                                "sense_id": "cbf33879-fd70-3882-a108-776cd9c4d647",
                                "text": "Sambel achète à grands frais des costumes orientaux, en revêt tous les prisonniers, ses confrères, qui veulent bien se laisser musulmaniser ainsi ; il a ses ulémas, ses esclaves noirs (au moyen d’un masque, il est vrai)."
                            }
                        ]
                    }
