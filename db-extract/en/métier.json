                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9fdc80-9c36-3274-967c-537f541888ae",
                                        "entry_id": "55b6baa7-2218-367f-8d98-6bb08d8481ea",
                                        "glosses": [
                                            "Arbeitsbereich, den jemand erlernt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d0310d4-5201-47d1-bcfc-b8d560e0f24b",
                                                "sense_id": "2a9fdc80-9c36-3274-967c-537f541888ae",
                                                "text": "In seinem Metier kennt er sich aus."
                                            },
                                            {
                                                "example_id": "be50dc6e-6949-4484-b7aa-9bf1fb885371",
                                                "sense_id": "2a9fdc80-9c36-3274-967c-537f541888ae",
                                                "text": "„Und weil seit dem Mittelalter lange Zeit nur Juden solche Geschäfte ausüben durften, vom Handel und vom Handwerk ferngehalten wurden, lieferte das Metier auch gängige Vorwände für Antisemitismus.“"
                                            },
                                            {
                                                "example_id": "1b94a990-504f-47c6-b259-bf3483d079f1",
                                                "sense_id": "2a9fdc80-9c36-3274-967c-537f541888ae",
                                                "text": "„Das waren die Augenblicke, in denen ich unwiderruflich begriff, dass ich für dieses Metier nicht taugte.“"
                                            },
                                            {
                                                "example_id": "6d533f24-43c2-4d81-9394-a9a9eec66119",
                                                "sense_id": "2a9fdc80-9c36-3274-967c-537f541888ae",
                                                "text": "„Winnie, die Fotografin, hatte die Bewegungen ihres Metiers angenommen, ein klein wenig lässig, doch stets mit dem Ruch des klug Arrangierten.“"
                                            },
                                            {
                                                "example_id": "b44129cb-deca-484f-a4da-227d9656bd66",
                                                "sense_id": "2a9fdc80-9c36-3274-967c-537f541888ae",
                                                "text": "„Interessant sind diese Dinge nur für denjenigen, der den Entwicklungsgang Wilhelm Buschs in seinem Metier verfolgen will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
