                        "glosses": [
                            "To surpass in waving; to wave more than."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "78d9eddf-b35b-45ca-ad50-20226d410387",
                                "sense_id": "02b50ef3-5f2b-38bd-a31b-5b6a3e6f549a",
                                "text": "Down in the courtyard the crowd cheered and waved back. Frog, beside herself with excitement, outsmiled and outwaved them all."
                            }
                        ]
                    },
                    {
                        "sense_id": "24c9b406-514e-3c36-a34f-fa622e322e78",
                        "entry_id": "723d8ccb-24da-33f1-ac67-0a03c658a2b8",
                        "glosses": [
                            "To wave outward."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "43e32318-9497-47b3-9b1a-1163bbf6cbbb",
                                "sense_id": "24c9b406-514e-3c36-a34f-fa622e322e78",
                                "text": "The cowering eagle screamed its joy, / Its pinions plumed anew, / And proudly to the winds outwaved / Our flag of star and blue."
                            }
                        ]
                    }
