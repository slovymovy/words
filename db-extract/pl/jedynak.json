                            {
                                "example_id": "b1ee8c64-dd9d-4419-8b66-b2593f9689f4",
                                "sense_id": "8921cd41-38f6-3515-b11f-27a5778ceca4",
                                "text": "Mój kolega Tomek jest jedynakiem."
