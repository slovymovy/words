                        "sense_id": "32bebaae-31b0-32f2-b987-b59346136cbe",
                        "entry_id": "365fe25b-282e-38e9-9ac3-c60585c8dbab",
                        "glosses": [
                            "Boisson qui provient de la fermentation alcoolique d'un mélange de jus de pommes et de jus de poires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85287ba6-b6e3-4f42-84d9-e3f1c7968087",
                                "sense_id": "32bebaae-31b0-32f2-b987-b59346136cbe",
                                "text": "La Revue pomologique, le Cidre et le Poiré, Argentan, 1ᵉʳ octobre 1889, contient: Le bouilleur de crû; le cidre malade ; fermentation; de la greffe; le halbit (ou halbique, mélange de jus de pommes et de poires) ; les cidres américains, […]."
                            },
                            {
                                "example_id": "91a6f82f-6b51-4c2f-a26c-51c7723c9c41",
                                "sense_id": "32bebaae-31b0-32f2-b987-b59346136cbe",
                                "text": "Halbis, cidre moitié pommé, moitié poiré. Half-buck, half-bikjà, danois, moitié bouc, moitié chèvre. On devrait dire: halbique."
                            }
                        ]
                    }
