                "senses": [
                    {
                        "sense_id": "f509e181-f7eb-34c7-a216-fe11848bec27",
                        "entry_id": "858d860f-4b4a-324b-a826-22e2bd9c23df",
                        "glosses": [
                            "zur Betätigung der Krallen des Geflügels geeignete Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1b56a32-1462-4e5c-a656-b2ca26105941",
                                "sense_id": "f509e181-f7eb-34c7-a216-fe11848bec27",
                                "text": "„In jedem der mobilen Ställe haben die Hühner an den Seiten jeweils zwei Scharrräume.“"
                            },
                            {
                                "example_id": "49610674-0210-4fc2-934c-e67223dfdb51",
                                "sense_id": "f509e181-f7eb-34c7-a216-fe11848bec27",
                                "text": "„In diesen Haltungssystemen ist eine entsprechende Einstreufläche als Scharrraum vorzusehen, ebenso sind eine entsprechende Anzahl von Sitzstangen bzw. Schlafplätzen anzubieten.“"
                            },
                            {
                                "example_id": "dc2d0530-0e97-45a9-be90-b1f553a95ce1",
                                "sense_id": "f509e181-f7eb-34c7-a216-fe11848bec27",
                                "text": "„Der Scharrraum wird von den Legehennen zum Picken, Scharren und Sandbaden genutzt.“"
                            },
                            {
                                "example_id": "18e03b57-7168-48cb-8381-be0d834f424b",
                                "sense_id": "f509e181-f7eb-34c7-a216-fe11848bec27",
                                "text": "„Das Abteil gliedert sich in den Kotbunker mit Sitzstangen und den Scharrraum mit Tiefstreu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
