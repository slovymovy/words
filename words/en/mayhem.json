{
    "word_family": [
        "maim"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27304ff8-df47-3746-af74-5f51a41cedf3",
                    "sense_definition": "A state of extreme disorder, confusion, or chaotic activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden storm caused absolute <w>mayhem</w> at the outdoor music festival.",
                            "target_lang_translations": {
                                "zh": "突如其来的暴风雨在户外音乐节上引发了一场彻底的<w>大混乱</w>。"
                            }
                        },
                        {
                            "text": "There was total <w>mayhem</w> in the store when the sale started.",
                            "target_lang_translations": {
                                "zh": "大减价开始时，商场里一片<w>混乱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "disorder",
                        "pandemonium",
                        "turmoil"
                    ],
                    "common_phrases": [
                        "wreak mayhem",
                        "cause mayhem"
                    ],
                    "target_lang_definitions": {
                        "zh": "混乱，极度的混乱、骚乱或失控状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "极度的骚乱或无序"
                            },
                            {
                                "target_lang_word": "大混乱",
                                "target_lang_sense_clarification": "极大规模的骚乱失控"
                            },
                            {
                                "target_lang_word": "骚乱",
                                "target_lang_sense_clarification": "动荡、喧闹的混乱状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a38c3836-94d2-34a0-bb59-573608a5c2fb",
                    "sense_definition": "A criminal act of intentionally injuring or disfiguring a person, especially by removing a limb or body part.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant was charged with <w>mayhem</w> after the brutal physical attack.",
                            "target_lang_translations": {
                                "zh": "在发生残暴的身体袭击后，被告被指控犯有<w>重伤罪</w>。"
                            }
                        },
                        {
                            "text": "Historically, the legal definition of <w>mayhem</w> involved the permanent loss of a body part.",
                            "target_lang_translations": {
                                "zh": "历史上，<w>残害肢体罪</w>的法律定义包括导致身体部位的永久丧失。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maiming"
                    ],
                    "common_phrases": [
                        "commit mayhem"
                    ],
                    "target_lang_definitions": {
                        "zh": "（法律上的）重伤害罪，蓄意使人残废或毁容的罪行（尤指割除肢体或器官）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "重伤罪",
                                "target_lang_sense_clarification": "致人残疾的严重伤害罪"
                            },
                            {
                                "target_lang_word": "残害肢体罪",
                                "target_lang_sense_clarification": "蓄意致残罪行"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbfa698d-471c-34aa-8a30-27e28fac2c9b",
                    "sense_definition": "To cause severe physical injury or to create a state of violent disorder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rioters sought to <w>mayhem</w> the city streets during the protest.",
                            "target_lang_translations": {
                                "zh": "暴乱分子试图在抗议期间<w>使</w>城市街道<w>陷入混乱</w>。"
                            }
                        },
                        {
                            "text": "He was accused of attempting to <w>mayhem</w> his opponent in the fight.",
                            "target_lang_translations": {
                                "zh": "他被指控在打斗中企图<w>严重伤害</w>对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maim",
                        "mutilate"
                    ],
                    "target_lang_definitions": {
                        "zh": "造成严重人身伤害，或制造暴力混乱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "严重伤害",
                                "target_lang_sense_clarification": "致伤致残"
                            },
                            {
                                "target_lang_word": "使陷入混乱",
                                "target_lang_sense_clarification": "制造严重混乱"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}