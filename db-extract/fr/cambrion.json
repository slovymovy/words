                                                "example_id": "aa3a9291-5535-450d-86a1-1bdf3533f53d",
                                                "sense_id": "e3b33c8f-f250-3046-824a-c953a9a293f4",
                                                "text": "AMANDA: Going now? You're joking! Why, it's only the shank of the evening, Mr. O’Connor!"
