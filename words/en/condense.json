                    "sense_definition": "To change a gas into a liquid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "phase_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cooling the steam will <w>condense</w> it into water droplets."
                        },
                        {
                            "text": "The machine is designed to <w>condense</w> vapor into liquid fuel."
                        }
                    ]
                },
                {
                    "sense_id": "601dc07e-4c76-3cdb-a5ad-08de6b3136a0",
                    "sense_definition": "To turn from a gas into a liquid.",
