                        "sense_id": "35783f30-64bc-3d0f-bb6d-86098efffae7",
                        "entry_id": "3eadb139-1062-31a2-af13-9fa49a79d95b",
                        "glosses": [
                            "silne zdenerwowanie spowodowane czyimś nieodpowiednim, niewłaściwym lub niesprawiedliwym zachowaniem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4790bcc-c56b-4fe1-b557-1803e217746b",
                                "sense_id": "35783f30-64bc-3d0f-bb6d-86098efffae7",
                                "text": "Wylej na nich swoje oburzenie, / niech ich ogarnie żar Twojego gniewu!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0077318-57c5-4137-866a-d93024b79ca1",
                        "source_entry_id": "3eadb139-1062-31a2-af13-9fa49a79d95b",
                        "source_sense_id": "35783f30-64bc-3d0f-bb6d-86098efffae7",
                        "target_lang_word": "indignation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indignation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca9d5700-d0c2-33a2-be44-6976f09674b3",
                                        "entry_id": "c20ae4d4-b66f-3e14-ae72-e102a2cbc5ac",
                                        "glosses": [
                                            "An anger aroused by something perceived as an indignity, notably an offense or injustice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da34d63c-b862-4acb-ba62-a8c003e19eff",
                                                "sense_id": "ca9d5700-d0c2-33a2-be44-6976f09674b3",
                                                "text": "He protested in indignation."
                                            },
                                            {
                                                "example_id": "0c73b90d-9dcc-434d-baa0-0c15e6d572ac",
                                                "sense_id": "ca9d5700-d0c2-33a2-be44-6976f09674b3",
                                                "text": "The Iron of it ſelfe, though heate red hot, / Approaching neere theſe eyes, would drinke my teares, / And quench this fierie indignation, / Euen in the matter of mine innocence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb5e2a75-324f-341a-b2fc-5e38b60df618",
                                        "entry_id": "c20ae4d4-b66f-3e14-ae72-e102a2cbc5ac",
                                        "glosses": [
                                            "A self-righteous anger or disgust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ee56b0f-550e-454f-9522-f8c1f235addd",
                        "source_entry_id": "3eadb139-1062-31a2-af13-9fa49a79d95b",
                        "source_sense_id": "35783f30-64bc-3d0f-bb6d-86098efffae7",
                        "target_lang_word": "indignation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indignation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5b5e8b0-ae57-3902-8530-9e0deb7d08c2",
                                        "entry_id": "c0e2c6be-1a41-39ea-baf2-d348bb2c0f7a",
                                        "glosses": [
                                            "Sentiment de colère qui peut être mêlé de mépris qu’excite une injustice criante, une action mauvaise ou honteuse, un ouvrage, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a758aece-ce36-4478-a6da-949c7fb50174",
                                                "sense_id": "d5b5e8b0-ae57-3902-8530-9e0deb7d08c2",
                                                "text": "La France démocratique, dans un accès d’indignation, renversa le gouvernement de la France bourgeoise et se proclama libre sous un gouvernement républicain."
                                            },
                                            {
                                                "example_id": "aecd6bbd-b17f-4b9a-b500-e3a944c30df7",
                                                "sense_id": "d5b5e8b0-ae57-3902-8530-9e0deb7d08c2",
                                                "text": "Elle s’était dégagée presque brusquement de l’étreinte de Jacques, et elle cracha à terre, avec dédain, en un mouvement d’indignation sauvage."
                                            },
                                            {
                                                "example_id": "4f0c89fc-badd-46b3-858a-228ef66e2738",
                                                "sense_id": "d5b5e8b0-ae57-3902-8530-9e0deb7d08c2",
                                                "text": "Au cours du procès Zola, les antisémites recrutèrent des troupes de manifestants soldés, qui étaient chargés d'exprimer les indignations patriotiques ; le gouvernement de Méline protégeait ces manœuvres."
                                            },
                                            {
                                                "example_id": "52f7419b-3246-4809-8422-ec98e6a1ab30",
                                                "sense_id": "d5b5e8b0-ae57-3902-8530-9e0deb7d08c2",
                                                "text": "Les propos de Yannick Jouaen, conseiller municipal d’opposition à La Feuillée, sur le choix du département d’indemniser les agriculteurs venus prêter main-forte dans les monts d’Arrée lors des incendies de la semaine passée, ont suscité de nombreux commentaires et l’indignation du maire de la commune, Jean-François Dumonteil."
                                            },
                                            {
                                                "example_id": "01d5dec0-bf27-42cd-a881-e66ccadbe345",
                                                "sense_id": "d5b5e8b0-ae57-3902-8530-9e0deb7d08c2",
                                                "text": "Toutes les belles âmes de la gauche enseignante, les sociologues qui nous expliquent à longueur de temps qu’il faut cesser de discriminer les élèves défavorisés en leur imposant les grandes œuvres de la littérature, ceux qui nous jurent sans rire que le niveau monte, ceux qui ont cru malin de proclamer qu’il fallait placer l’enfant au centre du système, ont rivalisé dans l’indignation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82583c2a-ffb8-4dbc-b1d1-cef89fa9e47f",
                        "source_entry_id": "3eadb139-1062-31a2-af13-9fa49a79d95b",
                        "source_sense_id": "35783f30-64bc-3d0f-bb6d-86098efffae7",
