                            {
                                "target_lang_word": "carload",
                                "target_lang_sense_clarification": "the amount that fills a car or railcar"
                            },
                            {
                                "target_lang_word": "truckload",
                                "target_lang_sense_clarification": "the amount that fills a truck"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "целая машина",
                                "target_lang_sense_clarification": "объем груза, заполняющий один автомобиль"
                            },
                            {
                                "target_lang_word": "вагон",
                                "target_lang_sense_clarification": "количество груза, заполняющее железнодорожный вагон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0c4762b-ad1e-3367-a34d-9d26713cce90",
                    "sense_definition": "meervoud van <w>waag</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude steden zie je vaak nog historische <w>wagen</w> waar vroeger goederen werden gewogen.",
                            "target_lang_translations": {
                                "en": "In old cities, you often still see historical <w>weighing houses</w> where goods used to be weighed.",
                                "ru": "В старых городах часто еще можно увидеть исторические <w>весовые</w>, где раньше взвешивали товары."
                            }
                        },
                        {
                            "text": "De architect bestudeerde de verschillende <w>wagen</w> in de provincie Utrecht.",
                            "target_lang_translations": {
                                "en": "The architect studied the various <w>weighing houses</w> in the province of Utrecht.",
                                "ru": "Архитектор изучал различные <w>весовые</w> в провинции Утрехт."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'waag' (historical weighing house)",
                        "ru": "множественное число от 'waag' (историческое здание весовой)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weighing houses",
                                "target_lang_sense_clarification": "historical buildings where goods were weighed"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "весовые",
                                "target_lang_sense_clarification": "исторические здания, где взвешивали товары"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a9192c3-29ca-3cc8-a7f2-7b483ce3f6f6",
                    "sense_definition": "iets riskants ondernemen of proberen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik liep ten slotte bijna elke dag dezelfde afstand, dus dacht ik een kansje te kunnen <w>wagen</w>.",
                            "target_lang_translations": {
                                "en": "After all, I walked the same distance almost every day, so I thought I could <w>take</w> a little chance.",
                                "ru": "В конце концов, я проходил одно и то же расстояние почти каждый день, поэтому подумал, что могу <w>рискнуть</w>."
                            }
                        },
                        {
                            "text": "De laatste keer dat ik een poging had willen <w>wagen</w> was tijdens dat etentje.",
                            "target_lang_translations": {
                                "en": "The last time I had wanted to <w>venture</w> an attempt was during that dinner.",
                                "ru": "Последний раз, когда я хотел <w>предпринять</w> попытку, был во время того ужина."
                            }
                        }
                    ],
                    "synonyms": [
                        "riskeren",
                        "durven",
                        "proberen"
                    ],
                    "common_phrases": [
                        "een poging wagen",
                        "een gokje wagen",
                        "een kansje wagen"
                    ],
                    "target_lang_definitions": {
                        "en": "to undertake or try something risky",
                        "ru": "предпринять что-то рискованное или попытаться сделать что-то, несмотря на риск"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to venture",
                                "target_lang_sense_clarification": "to dare to do something or go somewhere risky"
                            },
                            {
                                "target_lang_word": "to risk",
                                "target_lang_sense_clarification": "to take a chance on something"
                            },
                            {
                                "target_lang_word": "to dare",
                                "target_lang_sense_clarification": "to have the courage to try something"
                            },
                            {
                                "target_lang_word": "to hazard",
                                "target_lang_sense_clarification": "to suggest or try something despite risk"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отважиться",
                                "target_lang_sense_clarification": "решиться на смелый поступок"
                            },
                            {
                                "target_lang_word": "рискнуть",
                                "target_lang_sense_clarification": "пойти на риск"
                            },
                            {
                                "target_lang_word": "попробовать",
                                "target_lang_sense_clarification": "сделать попытку в рискованной ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad4da20-5510-37cb-ae8b-c74258e3a7ab",
                    "sense_definition": "iets kostbaars in gevaar brengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde zijn goede reputatie niet <w>wagen</w> voor een klein financieel gewin.",
                            "target_lang_translations": {
                                "en": "He did not want to <w>risk</w> his good reputation for a small financial gain.",
                                "ru": "Он не хотел <w>рисковать</w> своей доброй репутацией ради небольшой финансовой выгоды."
                            }
                        },
                        {
                            "text": "De soldaten moesten hun leven <w>wagen</w> om de burgers in veiligheid te brengen.",
                            "target_lang_translations": {
                                "en": "The soldiers had to <w>risk</w> their lives to bring the citizens to safety.",
                                "ru": "Солдатам пришлось <w>рисковать</w> своими жизнями, чтобы доставить граждан в безопасное место."
                            }
                        }
                    ],
                    "synonyms": [
                        "riskeren"
                    ],
                    "common_phrases": [
                        "zijn leven wagen"
                    ],
                    "target_lang_definitions": {
                        "en": "to put something valuable at risk",
                        "ru": "подвергать опасности что-то ценное"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to risk",
                                "target_lang_sense_clarification": "to expose something to danger or loss"
                            },
                            {
                                "target_lang_word": "to stake",
                                "target_lang_sense_clarification": "to gamble or risk something important on an outcome"
                            },
                            {
                                "target_lang_word": "to endanger",
                                "target_lang_sense_clarification": "to put someone or something in a dangerous situation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "подвергать опасности жизнь, репутацию и т.д."
                            },
                            {
                                "target_lang_word": "ставить на карту",
                                "target_lang_sense_clarification": "подвергать серьезному риску что-то важное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16949402-6e14-3ada-95f9-51e9cc04f39e",
                    "sense_definition": "zich ergens aan blootstellen of ergens mee bezig gaan ondanks het gevaar",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risico",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daar <w>waagde</w> hij zich niet aan omdat het te gevaarlijk was.",
                            "target_lang_translations": {
                                "en": "He did not <w>venture</w> into that because it was too dangerous.",
                                "ru": "Он не <w>решился</w> на это, потому что это было слишком опасно."
                            }
                        },
                        {
                            "text": "Ondanks alle verboden <w>wagen</w> een paar muzikanten zich later die avond op straat.",
                            "target_lang_translations": {
                                "en": "Despite all the prohibitions, a few musicians <w>venture</w> out onto the street later that evening.",
                                "ru": "Несмотря на все запреты, несколько музыкантов <w>отважились</w> выйти на улицу позже тем вечером."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich wagen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to expose oneself to something or engage with it despite danger",
                        "ru": "решиться на что-то или заняться чем-то, несмотря на возможную опасность"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to venture",
                                "target_lang_sense_clarification": "to cautiously engage in a risky activity"
                            },
                            {
                                "target_lang_word": "to dare",
                                "target_lang_sense_clarification": "to be brave enough to face a situation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "решаться",
                                "target_lang_sense_clarification": "осмелиться заняться чем-то опасным"
                            },
                            {
                                "target_lang_word": "отваживаться",
                                "target_lang_sense_clarification": "проявлять смелость, приступая к чему-либо"
                            }
                        ]
                    }
