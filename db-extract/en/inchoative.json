        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e7680671-4b95-3aaf-a64c-b9b31f793850",
                "word": "inchoative",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d1eaf706-af98-38a4-996b-d9620b7ed6d7",
                        "entry_id": "e7680671-4b95-3aaf-a64c-b9b31f793850",
                        "glosses": [
                            "At the beginning, still in an unformed state."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f8e1cda-0b91-4ae1-ac19-747c8065903e",
                                "sense_id": "d1eaf706-af98-38a4-996b-d9620b7ed6d7",
                                "text": "[T]he day-Star […] ſhall be riſen in our hearts; vvhereof theſe acts of our intellect ſeem to be ſome inchoative or imperfect rays, […]"
                            },
                            {
                                "example_id": "b51252df-db7b-4fb2-8308-1244ccaf5abf",
                                "sense_id": "d1eaf706-af98-38a4-996b-d9620b7ed6d7",
                                "text": "Our first Piece is of Winter, or late Autumn, 1771,—while the solution of the Polish Business is still in its inchoative stages; …"
                            }
                        ]
                    },
                    {
                        "sense_id": "3f8ca6ee-10da-302a-ab7d-3933360d584b",
                        "entry_id": "e7680671-4b95-3aaf-a64c-b9b31f793850",
                        "glosses": [
                            "Aspectually indicating that a state is about to be entered or is in the process of being entered."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d6082dcb-ac81-484f-9ae3-cb4ee28abc83",
                                "sense_id": "3f8ca6ee-10da-302a-ab7d-3933360d584b",
                                "text": "The inchoative (inceptive) aspect of a verb expresses the beginning of an action. Example: He is beginning to crawl."
                            }
                        ]
                    },
                    {
                        "sense_id": "af6d4cf6-bd64-37f0-bcd2-e87b0ff31078",
                        "entry_id": "e7680671-4b95-3aaf-a64c-b9b31f793850",
                        "glosses": [
                            "Inflected in or relating to the inchoative aspect."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
