                "senses": [
                    {
                        "sense_id": "1931a24d-7fd3-379c-b9f9-0e556805439f",
                        "entry_id": "e5467bcb-a4f3-3e8e-a478-eabe55392dff",
                        "glosses": [
                            "Mütze, die zur Ausrüstung eines Soldaten gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edae2748-a484-4f74-99a0-bdb3879554c1",
                                "sense_id": "1931a24d-7fd3-379c-b9f9-0e556805439f",
                                "text": "„Und Platons ganze Erscheinung in dem strickumgürteten französischen Mantel, der Soldatenmütze und den Bastschuhen hatte etwas Rundes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df1976b8-1280-4030-b1d6-2e1cf140cd9b",
                        "source_entry_id": "e5467bcb-a4f3-3e8e-a478-eabe55392dff",
                        "source_sense_id": "1931a24d-7fd3-379c-b9f9-0e556805439f",
                        "source_sense_description": "Mütze, die zur Ausrüstung eines Soldaten gehört",
                        "target_lang_word": "bonnet de police",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonnet de police",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0745c8b0-9b85-34ec-9250-7c9db7f92772",
                                        "entry_id": "b794a53d-d04f-3b2d-9e0a-9c31fe506f80",
                                        "glosses": [
                                            "Calot, coiffure de soldat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2498986d-3243-4be9-9ec9-e3c8c3b96a12",
                                                "sense_id": "0745c8b0-9b85-34ec-9250-7c9db7f92772",
                                                "text": "Ces messieurs étaient furieux, car ils croyaient deviner que Lucien les prenait pour des sots. Aussi il fallait voir leur air hautain quand il se trompait sur la durée que, d’après les ordonnances, doit avoir le pantalon d’écurie ou le bonnet de police."
                                            },
                                            {
                                                "example_id": "f86ba4bf-2d93-445e-8622-102e075ef953",
                                                "sense_id": "0745c8b0-9b85-34ec-9250-7c9db7f92772",
                                                "text": "Auprès de lui trois chiens tassés sous sa chaise se chauffaient sans remuer. Un caniche blanc, un barbet noir, et une petite chienne grise à la mine futée et douce ; le caniche était coiffé d’un vieux bonnet de police retenu sous son menton par une lanière de cuir."
                                            },
                                            {
                                                "example_id": "601f8d60-5ed3-4acd-8a7e-223be59af8bc",
                                                "sense_id": "0745c8b0-9b85-34ec-9250-7c9db7f92772",
                                                "text": "Il entra et reconnut le vieux Georges qu’il avait toujours connu vieux, bourru, méchant, coiffé d’un bonnet de police, avec des moustaches de phoque et d’épais sourcils à la Clemenceau."
                                            },
                                            {
                                                "example_id": "594a9e5f-3bb5-4dfc-a6db-d06dccaaad33",
                                                "sense_id": "0745c8b0-9b85-34ec-9250-7c9db7f92772",
                                                "text": "Il chargea ses armes, il les installa à portée de sa main : « Et maintenant, dit-il, je fais le bourgeois », et il assura son bonnet de police en casseur d’assiettes."
                                            },
                                            {
                                                "example_id": "884221eb-1de7-48a1-a8fd-f82b49c8416e",
                                                "sense_id": "0745c8b0-9b85-34ec-9250-7c9db7f92772",
                                                "text": "Des charlatans vêtus en dompteurs avec brandebourgs, soutaches, bonnets de police à glands d'or faisaient l'article pour des pommades et des fioles."
                                            },
                                            {
                                                "example_id": "b014576e-36ab-4470-8f65-f501596bcd40",
                                                "sense_id": "0745c8b0-9b85-34ec-9250-7c9db7f92772",
                                                "text": "Dans la joie retrouvée, les grands élèves confectionnent en papier crépon des bonnets de police qui ressemblent plutôt à des bonnets phrygiens : des bleus, des blancs, des rouges.\nIls s’en coiffent et, placés les uns à côté des autres, ils forment en marchant un long drapeau mouvant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
