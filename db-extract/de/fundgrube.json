                        "form": "die Fundgrube"
                    },
                    {
                        "form_id": "0c629bae-ac85-4479-8085-c22580c7416b",
                        "entry_id": "7da89691-f376-3916-a1cf-c26eb0f64990",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fundgruben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0117e3ca-e2ed-3de5-bf7c-73d3cb813ea5",
                        "entry_id": "7da89691-f376-3916-a1cf-c26eb0f64990",
                        "glosses": [
                            "Stelle, wo ein Erzgang zuerst entblößt wird"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "2db866e8-9c45-40f5-8b0b-d039a63ca853",
                                "sense_id": "0117e3ca-e2ed-3de5-bf7c-73d3cb813ea5",
                                "text": "„Die Größe des Grubenfeldes einer Fundgrube war in der jeweiligen Bergordnung geregelt und variierte zwischen den verschiedenen Revieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d630eacb-41ff-3101-ba3b-3c85e8a51f1c",
                        "entry_id": "7da89691-f376-3916-a1cf-c26eb0f64990",
                        "glosses": [
                            "etwas (eine Sammlung oder Ähnliches), das für Interessierte viel Neues, noch Überraschendes, Unentdecktes bietet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "8acc889b-09b2-40fa-8e0c-b7e17452510f",
                                "sense_id": "d630eacb-41ff-3101-ba3b-3c85e8a51f1c",
                                "text": "„Der Band ist jedoch herrlich illustriert, die Grafiken sind erhellend und die zahlreichen farbigen Karten eine unglaubliche Fundgrube.“"
                            },
                            {
                                "example_id": "80f4d493-9f18-4c68-a7da-657a20a182ad",
                                "sense_id": "d630eacb-41ff-3101-ba3b-3c85e8a51f1c",
                                "text": "„Die Familie Well ist eine einzige musikalische Fundgrube, bissig in der Sache, bayerisch im Tonfall.“"
                            },
                            {
                                "example_id": "f950a7d3-80dc-4653-9a9b-633f6f912741",
                                "sense_id": "d630eacb-41ff-3101-ba3b-3c85e8a51f1c",
                                "text": "„Die besten Witze macht das Leben selbst, und eine Fundgrube sind darum die schriftlichen Fehlleistungen in Briefen von Ungebildeten oder Schreibungewohnten, soweit sie überhaupt ans Licht der Öffentlichkeit gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60b03916-eb02-4a33-9125-23aad0eb8cea",
                        "source_entry_id": "7da89691-f376-3916-a1cf-c26eb0f64990",
                        "source_sense_id": "d630eacb-41ff-3101-ba3b-3c85e8a51f1c",
                        "target_lang_word": "gold mine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold mine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80b2e5b2-53a5-398b-83e5-53dcc87a5eba",
                                        "entry_id": "001ed901-e180-3873-9a53-15932f166bdb",
                                        "glosses": [
                                            "A mine for gold ore or metal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00be5797-a108-483a-a67c-3be1ea167f36",
                                                "sense_id": "80b2e5b2-53a5-398b-83e5-53dcc87a5eba",
                                                "text": "South Africa has many goldmines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                        "entry_id": "001ed901-e180-3873-9a53-15932f166bdb",
                                        "glosses": [
                                            "A very profitable economic venture."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95de3e4f-87de-40af-b469-037d7e68d13b",
                                                "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                                "text": "This oil deposit is a regular gold mine. We make more and more money every year!"
                                            },
                                            {
                                                "example_id": "8d2f9943-d43f-4b1c-9587-c0c1ffa0ed21",
                                                "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                                "text": "The possessors of Salisbury & Yeovil Railway shares had ample compensation for the anxiety which the first few years of the company's existence had given them, for the concern proved a veritable gold mine."
                                            },
                                            {
                                                "example_id": "6f740adf-fd65-48f8-a9ca-09e71fbdcbdb",
                                                "sense_id": "90327d4e-e67f-3472-a11c-511fe0d3ed94",
                                                "text": "[Hal Varian] went to work helping Page, Brin, and Schmidt develop more efficient auction algorithms and build the auction model that became such a gold mine for Google."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbb3ddd-764d-394e-9b1b-893d98cd23dc",
                                        "entry_id": "001ed901-e180-3873-9a53-15932f166bdb",
                                        "glosses": [
                                            "A plentiful stockpile of something sought-after."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa67e532-9603-4c22-8b5e-8cd66a1ea704",
                                                "sense_id": "efbb3ddd-764d-394e-9b1b-893d98cd23dc",
                                                "text": "The Smithsonian Institution is a goldmine of knowledge, but like most mines, you have to dig for the good stuff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "601eb42c-9166-4f5a-839b-18e38574f040",
                        "source_entry_id": "7da89691-f376-3916-a1cf-c26eb0f64990",
                        "source_sense_id": "d630eacb-41ff-3101-ba3b-3c85e8a51f1c",
