        "fr-extract.jsonl": [
            {
                "entry_id": "77de19f6-e4da-3eff-9772-7017180a40fa",
                "word": "déveine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "10273941-b1c8-48f0-95eb-a3235506f8db",
                        "entry_id": "77de19f6-e4da-3eff-9772-7017180a40fa",
                        "tags": [
                            "plural"
                        ],
                        "form": "déveines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0de2d6d7-8e7e-3b90-85ba-65b5d332cfb8",
                        "entry_id": "77de19f6-e4da-3eff-9772-7017180a40fa",
                        "glosses": [
                            "Mauvaise chance persistante, surtout au jeu."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d7c76227-a534-4455-ac54-cb122de5ebfb",
                                "sense_id": "0de2d6d7-8e7e-3b90-85ba-65b5d332cfb8",
                                "text": "Ce n’était pas la première fois que Sainte-Austreberthe perdait 20,000 francs, car malgré la juste réputation qui lui était faite de gagner toujours, il avait parfois des moments de déveine où la fortune lui était contraire."
                            },
                            {
                                "example_id": "70d4a38e-3a94-41a4-961e-51ae95644fdd",
                                "sense_id": "0de2d6d7-8e7e-3b90-85ba-65b5d332cfb8",
                                "text": "Il était déjà arrivé, certes, une chance extraordinaire, et aussi une déveine hors du commun, plus d’une fois un joueur riche et audacieux avait fait sauter la banque d’un casino."
                            },
                            {
                                "example_id": "3ec24290-7f01-4195-8c0d-70b46fd66250",
                                "sense_id": "0de2d6d7-8e7e-3b90-85ba-65b5d332cfb8",
                                "text": "Si la réussite d'un pétanquiste chevronné est imputable à sa capacité technique, il en va autrement de l'échec. Celui-ci est attribué à des causes extérieures au joueur, qui pour l'expliquer invoque la « déveine »."
                            }
                        ]
                    }
                ],
