                    }
                ],
                "translations": [
                    {
                        "translation_id": "f694ab5e-0d9c-428c-aeac-a6bd6418e7c4",
                        "source_entry_id": "47c235e3-3ad1-33e5-90a4-5293ae5e97be",
                        "source_sense_id": "7f5fd702-4abf-3ce7-992b-7c61508498cc",
                        "target_lang_word": "vamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "248eec3f-3fdc-3576-bd56-2b538c906afb",
                                        "entry_id": "3c56335a-ea26-341a-8169-b4e6cb7f7727",
                                        "glosses": [
                                            "The top part of a boot or shoe, above the sole and welt and in front of the ankle seam, that covers the instep and toes; the front part of an upper; the analogous part of a stocking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a45bac8-95e7-4ee0-ba85-fc7ed7a29310",
                                                "sense_id": "248eec3f-3fdc-3576-bd56-2b538c906afb",
                                                "text": "The flow of water was in my ears, and in my eyes a hazy spreading, and upon my brain a closure, as a cobbler sews a vamp up."
                                            },
                                            {
                                                "example_id": "1ddbe0ba-eea3-41c1-ad27-08937fb90335",
                                                "sense_id": "248eec3f-3fdc-3576-bd56-2b538c906afb",
                                                "text": "'Yes, I am rather cracked in the vamp,' he said freely, seeing that the eyes of the shepherd's wife fell upon his boots, 'and I am not well fitted either. I have had rough times lately, and have been forced to pick up what I can get in the way of wearing, but I must find a suit better fit for working days when I reach home.'"
                                            },
                                            {
                                                "example_id": "ec9eba88-9dcc-4e2a-8a70-7c471882c8d1",
                                                "sense_id": "248eec3f-3fdc-3576-bd56-2b538c906afb",
                                                "text": "Their dark brown shoes had hand-stitched vamps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3419c09d-aab1-3574-8a37-a35ef36656f0",
                                        "entry_id": "3c56335a-ea26-341a-8169-b4e6cb7f7727",
                                        "glosses": [
                                            "Something added to give an old thing a new appearance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40a15898-6355-3ccb-a7f8-b91a808df2a5",
                                        "entry_id": "3c56335a-ea26-341a-8169-b4e6cb7f7727",
                                        "glosses": [
                                            "Something patched up, pieced together, improvised, or refurbished."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc81487e-f28b-311a-baf5-3161706cc2a0",
                                        "entry_id": "3c56335a-ea26-341a-8169-b4e6cb7f7727",
                                        "glosses": [
                                            "A repeated and often improvised accompaniment, usually consisting of one or two measures, often a single chord or simple chord progression, repeated as necessary, for example, to accommodate dialogue or to anticipate the entrance of a soloist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2dabe3d-0edc-4744-a00a-8835be02a790",
                                                "sense_id": "cc81487e-f28b-311a-baf5-3161706cc2a0",
                                                "text": "I would go even further and say that, once [Stephen] Sondheim had ceased to compose classical music with its nonspecific accompaniments, he began to explore how effectively a vamp can flesh out a character for the stage. He had little need to write distinctive vamps for his Williams [College] shows, but already in 1954—before the highly characteristic vamps in West Side Story—we see him growing in his ability to get under a character's skin through his accompaniment."
                                            },
                                            {
                                                "example_id": "8c5f5a38-2824-4672-9191-74ed37ce61c3",
                                                "sense_id": "cc81487e-f28b-311a-baf5-3161706cc2a0",
                                                "text": "On the mega-rave circuit, a pop hardcore sound gradually emerged, fusing the piano vamps and shrieking divas of 1989-era Italo house with Belgian hardcore's monster-riffs and Shut Up and Dance style breakbeats and rumblin' bass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da82d0ba-4805-3bf7-b27b-b04dd162e038",
                                        "entry_id": "3c56335a-ea26-341a-8169-b4e6cb7f7727",
                                        "glosses": [
                                            "An activity or speech intended to fill or stall for time."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c01a0e36-d46a-369f-aa9f-e629b9395c5f",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "To patch, repair, or refurbish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f752a04-a579-4f49-aa46-6475c5c223e9",
                                                "sense_id": "c01a0e36-d46a-369f-aa9f-e629b9395c5f",
                                                "text": "'Set me some great task, ye gods! and I will show my spirit.' 'Not so,' says the good Heaven; 'plod and plough, vamp your old coats and hats, weave a shoestring; great affairs and the best wine by and by.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61db1f68-3aa1-30b6-9d9e-7dfa69319bc9",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "Often as vamp up: to fabricate or put together (something) from existing material, or by adding new material to something existing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f015c6b8-2275-4c37-adfd-22cbfa275f1e",
                                                "sense_id": "61db1f68-3aa1-30b6-9d9e-7dfa69319bc9",
                                                "text": "He has vamp'd an old speech, and the court to their sorrow, / Shall hear him harangue against Prior to morrow."
                                            },
                                            {
                                                "example_id": "280d1677-37e0-4fb5-a0b9-0d34bf886abd",
                                                "sense_id": "61db1f68-3aa1-30b6-9d9e-7dfa69319bc9",
                                                "text": "For instance, you take the uncompleted books of living authors, fresh from their hands, wet from the press, cut, hack, and carve them to the powers and capacities of your actors, and the capability of your theatres, finish unfinished works, hastily and crudely vamp up ideas not yet worked out by their original projector, but which have doubtless cost him many thoughtful days and sleepless nights; […]"
                                            },
                                            {
                                                "example_id": "1aee2835-a546-4138-8389-ce3e5047e27c",
                                                "sense_id": "61db1f68-3aa1-30b6-9d9e-7dfa69319bc9",
                                                "text": "With real though rude art, the harlequin danced slowly backwards out of the door into the garden, which was full of moonlight and stillness. The vamped dress of silver paper and paste, which had been too glaring in the footlights, looked more and more magical and silvery as it danced away under a brilliant moon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "053c3734-00b9-39fe-8a80-510760eaa398",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "To cobble together, to extemporize, to improvise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca56679d-43ed-4c14-9a0f-583101d129b1",
                                                "sense_id": "053c3734-00b9-39fe-8a80-510760eaa398",
                                                "text": "A paſt, vamp'd, future, old, reviv'd, nevv piece, / 'Tvvixt Plautus, Fletcher, Congreve, and Corneille, / Can make a C——r, Jo——n, or O——ll."
                                            },
                                            {
                                                "example_id": "f7678076-511b-4d3e-834a-a3d33aa9fc88",
                                                "sense_id": "053c3734-00b9-39fe-8a80-510760eaa398",
                                                "text": "Two pence he had gotten by begging, that 's all; / One bought him a bruſh, and one a black ball; / […] / Thus vamp'd and accoutred, with clouts, ball, and bruſh, / He gallantly ventur'd his fortune to puſh; […]"
                                            },
                                            {
                                                "example_id": "8230e1cd-9660-41af-a7cf-9a47b85fdb8c",
                                                "sense_id": "053c3734-00b9-39fe-8a80-510760eaa398",
                                                "text": "[S]ome men, nay, even some monks and brothers of this very house, are so envious of my state and foes to my peace of mind, that whenever they see me more happy and fuller of hope than common, they vamp me up some story or conjure some spectrum to disquiet me and sadden me!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5cb220b-9055-3b4a-a17b-81a8dc3585f3",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "To cobble together, to extemporize, to improvise.",
                                            "To perform a vamp (“a repeated, often improvised accompaniment, for example, under dialogue or while waiting for a soloist to be ready”)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "specifically",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "718dbd9b-5268-4e5d-9d5d-fc46e92fa548",
                                                "sense_id": "a5cb220b-9055-3b4a-a17b-81a8dc3585f3",
                                                "text": "\"It is so unkind to joke about it,\" said the beautiful young lady. \"What shall I do? If somebody will vamp an accompaniment, I can get on very well without any music. But if I try to play for myself I shall break down.\""
                                            },
                                            {
                                                "example_id": "ea90b5d8-8d1a-4dcb-a320-6234fcaac307",
                                                "sense_id": "a5cb220b-9055-3b4a-a17b-81a8dc3585f3",
                                                "text": "The band played ceaselessly. Even when the other instruments were resting the pianist kept up his monotonous vamping, with a dreary furbelow for embellishment here and there, to which some few of the dancers continued to shuffle round the floor."
                                            },
                                            {
                                                "example_id": "be1f86f0-4314-4f1d-bc66-3270652f06a7",
                                                "sense_id": "a5cb220b-9055-3b4a-a17b-81a8dc3585f3",
                                                "text": "[W]hen she [Billie Holiday] finally emerged from her dressing room, she would take her time getting to the stage, stopping and greeting people and even having drinks at the bar while her accompanists vamped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d515396b-4264-37e3-83cd-7be4d2fcc6e7",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "To attach a vamp (to footwear)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a06809d5-a3cf-4ea6-80ee-1345540f6665",
                                                "sense_id": "d515396b-4264-37e3-83cd-7be4d2fcc6e7",
                                                "text": "The shoe is now ready to be vamped after the eyelets are put in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21eb96cb-de17-3c99-be7b-d21991b97127",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "To travel by foot; to walk."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b2d629-486d-4dfa-a881-a24f51244e13",
                                                "sense_id": "21eb96cb-de17-3c99-be7b-d21991b97127",
                                                "text": "Well, vamp on to Marlott, will 'ee, and order that carriage, and maybe I'll drive round and inspect the club."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3045275-14e3-3386-b9b7-d83f005dc0c9",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "To delay or stall for time, as for an audience."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a4da34-52cd-4b02-af02-6e5f35fb042e",
                                                "sense_id": "d3045275-14e3-3386-b9b7-d83f005dc0c9",
                                                "text": "Keep vamping! Something’s wrong with the mic!"
                                            },
                                            {
                                                "example_id": "de144467-0a3c-4480-9e8a-87ee44d9e2cf",
                                                "sense_id": "d3045275-14e3-3386-b9b7-d83f005dc0c9",
                                                "text": "She went out there to vamp since the speaker was late arriving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19d5d028-d2dc-3fff-9a4e-64dcfc5d355f",
                                        "entry_id": "e5308fde-d648-3d2b-aff0-03dc0333a278",
                                        "glosses": [
                                            "To pawn."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b720bf-8296-421c-9a45-d84f8ff13e8a",
                                                "sense_id": "19d5d028-d2dc-3fff-9a4e-64dcfc5d355f",
                                                "text": "'I'll find my own fencing cove or else vamp it to a pawnbroker.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52154deb-30f2-3b34-9e45-af91e1de843f",
                                        "entry_id": "1eea3689-c149-3076-8152-dc5f65535e98",
                                        "glosses": [
                                            "A flirtatious, seductive woman, especially one who exploits men by using their sexual desire for her; femme fatale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6319ca5a-40f0-47a3-8ab1-4d96b3a4546d",
                                                "sense_id": "52154deb-30f2-3b34-9e45-af91e1de843f",
                                                "text": "[…]strait-laced Sandy, played by Olivia Newton-John, transformed herself into a vamp to bag the man of her dreams"
                                            },
                                            {
                                                "example_id": "e43d79b2-ba08-471a-906a-f41d62270bbb",
                                                "sense_id": "52154deb-30f2-3b34-9e45-af91e1de843f",
                                                "text": "It is the vamp who has a sense of humor that can really hold a man. She laughs at him, even as she is seeking to allure him—and he adores it."
                                            },
                                            {
                                                "example_id": "bc4a8773-f878-4e90-b24c-d347eb235de8",
                                                "sense_id": "52154deb-30f2-3b34-9e45-af91e1de843f",
                                                "text": "She was got up to the best of her ability as a siren, more popularly a \"vamp\"—a picker up and thrower away of men, an unscrupulous and fundamentally unmoved toyer with affections."
                                            },
                                            {
                                                "example_id": "07bfb002-a7f7-4659-ad21-825e93bc1955",
                                                "sense_id": "52154deb-30f2-3b34-9e45-af91e1de843f",
                                                "text": "\"Lady Miriam?\" said Jarvis in surprise. \"Oh, yes. … I suppose you mean that she looks a queer sort of vamp. But you've no notion what even the ladies of the best families are looking like nowadays.[…]\""
                                            },
                                            {
                                                "example_id": "e0de1109-64ad-4fc2-87dd-41a2cbd234fa",
                                                "sense_id": "52154deb-30f2-3b34-9e45-af91e1de843f",
                                                "text": "Well, her seclusion is considered suspicious. She annoys them by being good-looking and even what is called good style. And all the young men are warned against her as a vamp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a52aff7-e11d-36d4-a487-f065640fa4b3",
                                        "entry_id": "1eea3689-c149-3076-8152-dc5f65535e98",
                                        "glosses": [
                                            "A vampire."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dcc9f9c-dce3-4f52-beb8-39f400b4f2c9",
                                                "sense_id": "5a52aff7-e11d-36d4-a487-f065640fa4b3",
                                                "text": "The leader of the vampire cult (played by Ramon D'Salva) leads his cult of fellow vamps in an attack against some nasty werewolves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a09db8ec-f5a3-3733-8513-446c302909fd",
                                        "entry_id": "3870af56-cd05-34a6-92d3-bd3bfea1b5b5",
                                        "glosses": [
                                            "To seduce or exploit someone."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae3a3581-f5c5-4e62-8257-6ffedd4646b2",
                                                "sense_id": "a09db8ec-f5a3-3733-8513-446c302909fd",
                                                "text": "We want a musical-comedy star to vamp a Senator or a member of the Cabinet; we want the protective tariff revised up or down because of an actress' whim; we want scarlet scandal in high life. And we are not likely to get them."
                                            },
                                            {
                                                "example_id": "a0352d0b-24c5-4116-bb52-756792175e09",
                                                "sense_id": "a09db8ec-f5a3-3733-8513-446c302909fd",
                                                "text": "\"People who lose all their charity generally lose all their logic,\" remarked Father Brown. \"It's rather ridiculous to complain that she keeps to herself; and then accuse her of vamping the whole male population.\""
                                            },
                                            {
                                                "example_id": "76e6ee3f-df26-4c6c-bcd5-3dbb1ff767ad",
                                                "sense_id": "a09db8ec-f5a3-3733-8513-446c302909fd",
                                                "text": "She smiled again. Batted her lashes and laid down a few more mascara tracks. Vamping in order to maintain composure."
                                            },
                                            {
                                                "example_id": "cf07c0c7-4e97-46e8-8840-5300304cb680",
                                                "sense_id": "a09db8ec-f5a3-3733-8513-446c302909fd",
                                                "text": "She vamps this month on the cover of British Vogue, a portrait of artfully crafted provocation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af8c6065-2631-3160-a30e-ff22d2eed19a",
                                        "entry_id": "3870af56-cd05-34a6-92d3-bd3bfea1b5b5",
                                        "glosses": [
                                            "To turn (someone) into a vampire."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17cd0a24-acb9-4018-9caf-f8efc3a2d796",
                                                "sense_id": "af8c6065-2631-3160-a30e-ff22d2eed19a",
                                                "text": "If I knew what I know now before I got vamped, I'd do the same thing."
                                            },
                                            {
                                                "example_id": "fe3afe0f-8e11-4284-adeb-3a35d1f92739",
                                                "sense_id": "af8c6065-2631-3160-a30e-ff22d2eed19a",
                                                "text": "Astonishing how few peasants and regular people got vamped back in the olden days, when it wasn't regulated."
                                            },
                                            {
                                                "example_id": "2b64c930-c27a-4f0e-92ad-2779b3a2ac04",
                                                "sense_id": "af8c6065-2631-3160-a30e-ff22d2eed19a",
                                                "text": "Nobody ever got the drop on Shades, not even when he was alive, and certainly not in the fifty years since he got vamped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ce36545-47d1-369a-ba50-19e18ffb58a9",
                                        "entry_id": "3870af56-cd05-34a6-92d3-bd3bfea1b5b5",
                                        "glosses": [
                                            "To cosplay a vampire."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ed929d2-4fc5-403b-baad-daa980b4f2d6",
                                                "sense_id": "3ce36545-47d1-369a-ba50-19e18ffb58a9",
                                                "text": "I'm planning to vamp real hard at Friday night's party."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7db67201-0bc9-3e5f-babd-e1be30eb0eab",
                                        "entry_id": "b4030b6b-2062-32ce-9f24-d10608cbfec5",
                                        "glosses": [
                                            "A volunteer firefighter."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52632441-c19f-4b65-8709-8bad04a23cd6",
                                                "sense_id": "7db67201-0bc9-3e5f-babd-e1be30eb0eab",
                                                "text": "John Mackin is one of the old-timers of the new Department. He was a volunteer fireman as well, […] John Mackin was among the number of \"old vamps\" who made application to the first Board of Fire Commissioners for appointment in the Paid Department."
                                            },
                                            {
                                                "example_id": "07ba51c9-d85c-4721-8bd5-83ba295debc5",
                                                "sense_id": "7db67201-0bc9-3e5f-babd-e1be30eb0eab",
                                                "text": "The vamps had to carry their equipment to the fire on foot!"
                                            },
                                            {
                                                "example_id": "dfbaf5fe-d392-466e-9ebf-da61c1833e97",
                                                "sense_id": "7db67201-0bc9-3e5f-babd-e1be30eb0eab",
                                                "text": "Volunteer firemen are called vamps because they often went to fires on foot, vamp being an old English word for \"walk.\" Syosset's first vamps responded quickly to fires and formed bucket brigades to extinguish them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
