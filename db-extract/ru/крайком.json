                "senses": [
                    {
                        "sense_id": "f50275de-76b7-3bc0-9a51-c8ff71bbd069",
                        "entry_id": "f7f13018-1c0c-3c3e-ab9c-589853808cd6",
                        "glosses": [
                            "советск. краевой комитет КПСС"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58a69f84-871b-4e79-9f86-2b768f8dfd89",
                                "sense_id": "f50275de-76b7-3bc0-9a51-c8ff71bbd069",
                                "text": "Размахивали молотами секретарь крайкома, члены правительства, начальник Севера и Юга и гости."
                            },
                            {
                                "example_id": "a810f1ff-dc88-4f5e-984b-40bcac99627f",
                                "sense_id": "f50275de-76b7-3bc0-9a51-c8ff71bbd069",
                                "text": "― Мы добьёмся через крайком в порядке шефства, чтоб теперь же у вас был технический комбинат!"
                            },
                            {
                                "example_id": "2477cabe-eea4-401e-83d6-d5d4f809ba2a",
                                "sense_id": "f50275de-76b7-3bc0-9a51-c8ff71bbd069",
                                "text": "Андреев, нынешний секретарь ЦК партии, а тогда секретарь Северо-Кавказскаго крайкома партии, получил на эту тему специальную и личную директиву от Сталина."
                            }
                        ]
                    }
