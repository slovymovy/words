                "senses": [
                    {
                        "sense_id": "97eaae12-f088-346a-928f-a99a2b107c53",
                        "entry_id": "cb96659a-ae96-31f5-b1e9-4542c1cc2870",
                        "glosses": [
                            "eine durch eine Pilzinfektion unentwickelte oder dürre Frucht des Pflaumen- oder Zwetschgenbaums, die von diesem massenhaft vor der Reife abgeworfen wird"
                        ],
                        "tags": [
                            "Phytopathologie"
                        ],
                        "examples": [
                            {
                                "example_id": "abad782b-d5f5-459d-973e-bdfb3868785f",
                                "sense_id": "97eaae12-f088-346a-928f-a99a2b107c53",
                                "text": "\"Diese an Zwetschge und Pflaume auftretende Pilzkrankheit befällt die heranwachsenden Früchte, die dann sehr eigentümliche Formen (\"Taschen\") aufweisen. Statt normaler Früchte entstehen langgestreckte, flache, hohle, steinlose \"Hungerzwetschgen\", deren Oberhaut erst grün, dann bräunlich gefärbt und mehr oder weniger runzelig ist und mehlig weiß bepudert erscheint.\""
                            },
                            {
                                "example_id": "eee131f5-2446-435a-ab38-9a2194556459",
                                "sense_id": "97eaae12-f088-346a-928f-a99a2b107c53",
                                "text": "„In diesen Hungerzwetschgen treten die Hyphen zwischen den Epidermiszellen hervor und verzweigen sich zwischen Epidermis und Kutikula […]“"
                            },
                            {
                                "example_id": "1d9cef61-56db-4f95-bd3b-abb3fd2cee42",
                                "sense_id": "97eaae12-f088-346a-928f-a99a2b107c53",
                                "text": "Zur Bekämpfung der Narrentaschenkrankheit ist es sehr wichtig, frühzeitig alle Hungerzwetschgen abzupflücken und zu vernichten."
                            },
                            {
                                "example_id": "65ad7461-aebf-45d4-9bd6-49cbae74c509",
                                "sense_id": "97eaae12-f088-346a-928f-a99a2b107c53",
                                "text": "Seit sechs Wochen hat es nicht geregnet, das wird vielleicht wieder Hungerzwetschgen geben dieses Jahr!"
                            },
                            {
                                "example_id": "f6b055b7-10b2-44cc-bdbc-51402d1da541",
                                "sense_id": "97eaae12-f088-346a-928f-a99a2b107c53",
                                "text": "„[…] Man nennt sie auch Narren-, Taschen-, Schoten- oder Hungerzwetschgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
