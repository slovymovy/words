                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doe niet zo <w>blij</w>, man, we moeten nu echt serieus blijven.",
