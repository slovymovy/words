                ],
                "senses": [
                    {
                        "sense_id": "5eb943fe-f528-35fc-8a07-239b5ddb466f",
                        "entry_id": "3c855750-069a-34d5-903a-e14846cc3078",
                        "glosses": [
                            "Savanne im Norden Tansanias bis zum Süden Kenias mit einer Fläche von etwa 30.000 Quadratkilometern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "730a2a64-b9a7-4a1b-aaa2-753d74ec64ee",
                                "sense_id": "5eb943fe-f528-35fc-8a07-239b5ddb466f",
                                "text": "Die Serengeti ist nicht nur ein herausragendes Naturreservat, welches seit 1981 offiziell zum »Welterbe« der UNESCO gehört."
                            },
                            {
                                "example_id": "256d2c75-264d-41a8-989f-acd7c4f5b5df",
                                "sense_id": "5eb943fe-f528-35fc-8a07-239b5ddb466f",
                                "text": "In der Serengeti gibt es nämlich Tausende von Löwen, Leoparden, Geparden, Tüpfel- und Streifenhyänen sowie Schabracken-, Gold- und Streifenschakale."
                            },
                            {
                                "example_id": "cb4525bd-72c7-4b2c-b727-6590c0c8962f",
                                "sense_id": "5eb943fe-f528-35fc-8a07-239b5ddb466f",
                                "text": "Marabustörche sind in der Serengeti weit verbreitet."
                            },
                            {
                                "example_id": "12e9525e-4425-4552-83a1-08c297144cca",
                                "sense_id": "5eb943fe-f528-35fc-8a07-239b5ddb466f",
                                "text": "Am Ende der Trockenzeit ziehen praktisch alle großen Säugetiere in die Masai Mara, ein Gebiet, das in Kenia liegt und nur zehn Prozent der Fläche der Serengeti ausmacht."
                            },
                            {
                                "example_id": "fa2d55ad-b6f8-4519-a6b1-4e0691913a81",
                                "sense_id": "5eb943fe-f528-35fc-8a07-239b5ddb466f",
                                "text": "In der Masai Mara ist die einzige Chance, am Ende der Trockenperiode noch Wasser zu finden, und so tummeln sich dort für kurze Zeit fast die gesamten Antilopenherden der Serengeti."
                            },
                            {
                                "example_id": "e3ad6083-5848-4c6f-926c-26479dcc248c",
                                "sense_id": "5eb943fe-f528-35fc-8a07-239b5ddb466f",
                                "text": "Die Serengeti ist überall bekannt, als Wildpark im baumarmen Savannenland."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
