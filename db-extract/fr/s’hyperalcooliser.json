                ],
                "senses": [
                    {
                        "sense_id": "f9079a16-3fa5-3c00-8f82-da4e29a1f5be",
                        "entry_id": "4bd84c62-a0cd-3af9-9faf-1b8862e5cff9",
                        "glosses": [
                            "Forme pronominale de hyperalcooliser : Consommer des quantités très importantes d’alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e49a984-9d89-419a-9134-4f777dc008f9",
                                "sense_id": "f9079a16-3fa5-3c00-8f82-da4e29a1f5be",
                                "text": "Cousin du « jackass » —un jeu idiot qui consiste à exécuter des cascades dangereuses—, arrosé de « binge drinking » —cette mode britannique qui consiste à s’hyperalcooliser— le « balconing » aurait fait des ravages cet été en Espagne."
                            },
                            {
                                "example_id": "5b1b5c9f-9a48-4a73-b9ae-063c471fd022",
                                "sense_id": "f9079a16-3fa5-3c00-8f82-da4e29a1f5be",
                                "text": "Certains jeunes se retrouvent également dans des appartements pour s’hyperalcooliser."
                            },
                            {
                                "example_id": "722b9d8f-94c4-4919-a45a-a3aa87b16e77",
                                "sense_id": "f9079a16-3fa5-3c00-8f82-da4e29a1f5be",
                                "text": "Après une semaine à nous faire un sang d’encre quand au destin de Mathias, égaré quelque part Place du Parlement de Bretagne, à s’hyperalcooliser entre deux punks à chiens, quelle ne fut pas notre surprise de le retrouver frais et dispo, les cheveux propres et l’haleine mentholée."
                            }
                        ]
                    }
                ],
