                                                "sense_id": "849fc2d4-feb1-3453-aa22-f6b31b75ae35",
                                                "text": "Proloog Georgioupolis Georgioupolis bevindt zich in het noordwesten van Kreta, tussen de steden Rethimnon en Chania."
                                            },
                                            {
                                                "example_id": "2eb3ed44-2499-4316-9e42-7806c75e78ab",
                                                "sense_id": "849fc2d4-feb1-3453-aa22-f6b31b75ae35",
                                                "text": "Het van oorsprong kleine vissersdorpje Georgioupolis is inmiddels uitgegroeid tot een populaire badplaats met het langste zandstrand van Kreta."
                                            },
                                            {
                                                "example_id": "e7d4d609-ed83-4eae-8cbd-7b37459d1579",
                                                "sense_id": "849fc2d4-feb1-3453-aa22-f6b31b75ae35",
