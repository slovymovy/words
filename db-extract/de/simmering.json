                ],
                "senses": [
                    {
                        "sense_id": "204f5971-c5a2-3f44-a122-f06a8ceb3a5c",
                        "entry_id": "b9a5d4a2-c00d-3b1e-8722-e82ebe982dda",
                        "glosses": [
                            "elfter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f38b872-8643-4456-ace1-0dccdd2be847",
                                "sense_id": "204f5971-c5a2-3f44-a122-f06a8ceb3a5c",
                                "text": "So ist der höchste Bevölkerungsstand der Geschichte Simmerings auch der aktuelle, der Anfang 2015 95.162 Personen betrug."
                            },
                            {
                                "example_id": "0fefb1e4-0bce-4fe4-99cb-1dea2ce3a661",
                                "sense_id": "204f5971-c5a2-3f44-a122-f06a8ceb3a5c",
                                "text": "Die Stadt Wien forciert mit dem neuen Biomassekraftwerk in Simmering oder dem Kleinwasserkraftwerk Nussdorf besonders umweltfreundliche Kraftwerke."
                            },
                            {
                                "example_id": "9ae6ca0c-e669-4967-bca9-514eca6697c7",
                                "sense_id": "204f5971-c5a2-3f44-a122-f06a8ceb3a5c",
                                "text": "Die schillerndste in der Ausstellung präsentierte Persönlichkeit ist Antonia Lautenschläger (1859–1910), nach der in Simmering heute eine Gasse benannt ist."
                            },
                            {
                                "example_id": "b7c96cbc-f101-411b-b320-4305afcce424",
                                "sense_id": "204f5971-c5a2-3f44-a122-f06a8ceb3a5c",
                                "text": "Die beiden Flächenbezirke Floridsdorf und Simmering sind nun blaue Hochburgen, die SP ist nur noch Zweiter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c846bbf4-df12-335c-afed-60f0d4212f0c",
                        "entry_id": "b9a5d4a2-c00d-3b1e-8722-e82ebe982dda",
                        "glosses": [
                            "ehemaliges Dorf, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de7f660-a935-4ebe-a36c-d98bd141eae4",
                                "sense_id": "c846bbf4-df12-335c-afed-60f0d4212f0c",
                                "text": "1713 litt Simmering unter der Pestepidemie."
                            },
                            {
                                "example_id": "8b9d3177-e651-4b93-9760-6e0b0ce8f562",
                                "sense_id": "c846bbf4-df12-335c-afed-60f0d4212f0c",
                                "text": "1568-1575 ließ Kaiser Maximilian II. zwischen Simmering und Kaiserebersdorf das \"Neugebäude\" errichten."
                            },
                            {
                                "example_id": "8407ca17-196a-434c-90aa-dfed73d99681",
                                "sense_id": "c846bbf4-df12-335c-afed-60f0d4212f0c",
                                "text": "Bis etwa 1860 behielt Simmering seine dörflichen Strukturen, danach wurden die Rinnböckhäuser angelegt, die damals zweitgrößte Wohnhausanlage im Raum Wien."
                            },
                            {
                                "example_id": "99d5284a-1e03-4869-a448-242cbb825ea0",
                                "sense_id": "c846bbf4-df12-335c-afed-60f0d4212f0c",
                                "text": "Der an der alten Römerstraße nach Ungarn gelegene Vorort Simmering wurde 1890/92 unter Einbeziehung von Kaiserebersdorf und Teilen des Ortes Albern eingemeindet; …"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
