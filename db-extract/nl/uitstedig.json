                    },
                    {
                        "sense_id": "7802b840-b7fd-3424-8530-5ace821927cd",
                        "entry_id": "bd58a6a4-cee4-3ede-b5f2-ec17faf63e2b",
                        "glosses": [
                            "afwezig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caec96b6-3c99-47c4-b903-ca84056fb55d",
                                "sense_id": "7802b840-b7fd-3424-8530-5ace821927cd",
                                "text": "Bij de inhuldiging van Juliana meldde de halve fractie van de Communistische Partij Nederland (CPN) zich af. Fractievoorzitter Gerben Wagenaar was 'uitstedig', een ander was in het buitenland, een derde kon niet komen 'wegens ongesteldheid'. De vierde afwezige gaf niet aan waarom hij niet kwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9419d4b2-b703-48e6-9db2-942932b9276d",
                        "source_entry_id": "bd58a6a4-cee4-3ede-b5f2-ec17faf63e2b",
                        "source_sense_id": "7802b840-b7fd-3424-8530-5ace821927cd",
                        "source_sense_description": "afwezig",
                        "target_lang_word": "absent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "620acb9c-3d0c-353f-9e6f-c713c92ac0db",
                                        "entry_id": "e4edd7ac-1cbb-3bf0-b5c6-708b86055e13",
                                        "glosses": [
                                            "Being away from a place; withdrawn from a place; existing but not present; (sometimes) missing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aa56361-5b63-49bd-a872-75939b8bce50",
                                                "sense_id": "620acb9c-3d0c-353f-9e6f-c713c92ac0db",
                                                "text": "Owing to his own illness and then his family's, Ramzi has often been absent from class this month. We will help him catch up with his studies."
                                            },
                                            {
                                                "example_id": "27bd0116-b961-4074-b07e-2a81b8ea9180",
                                                "sense_id": "620acb9c-3d0c-353f-9e6f-c713c92ac0db",
                                                "text": "When they were able to return to the clinic some months later, certain pieces of equipment were absent."
                                            },
                                            {
                                                "example_id": "105038e5-3694-4d22-a559-adb33efec119",
                                                "sense_id": "620acb9c-3d0c-353f-9e6f-c713c92ac0db",
                                                "text": "Expecting absent friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9a1ac4-67e2-3563-8568-36800c313e79",
                                        "entry_id": "e4edd7ac-1cbb-3bf0-b5c6-708b86055e13",
                                        "glosses": [
                                            "Not existing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b47c47fc-d35d-48ba-9c96-210f204f1c03",
                                                "sense_id": "dc9a1ac4-67e2-3563-8568-36800c313e79",
                                                "text": "The body part was rudimentary or absent in 1% of specimens."
                                            },
                                            {
                                                "example_id": "e3f6780f-8380-4a5b-93bd-cad01e6e6013",
                                                "sense_id": "dc9a1ac4-67e2-3563-8568-36800c313e79",
                                                "text": "Empathy seemed to be absent from the messages."
                                            },
                                            {
                                                "example_id": "ad3b94aa-9f76-457d-b815-48127d4728e1",
                                                "sense_id": "dc9a1ac4-67e2-3563-8568-36800c313e79",
                                                "text": "Signs of forced entry were absent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b4bf0a1-8a83-31b0-bbaf-b548309795c7",
                                        "entry_id": "e4edd7ac-1cbb-3bf0-b5c6-708b86055e13",
                                        "glosses": [
                                            "Inattentive to what is passing; absent-minded; preoccupied."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e231eb96-33a9-4c46-b848-d2af0974c741",
                                                "sense_id": "0b4bf0a1-8a83-31b0-bbaf-b548309795c7",
                                                "text": "Tom was there, but he seemed absent and withdrawn. Normally he is quite present [= engaged] during a meeting."
                                            },
                                            {
                                                "example_id": "789dfe81-a6ab-4901-a3b0-bab2ce588a5c",
                                                "sense_id": "0b4bf0a1-8a83-31b0-bbaf-b548309795c7",
                                                "text": "What is commonly called an absent man is commonly either a very weak or a very affected man."
                                            },
                                            {
                                                "example_id": "0a46e8f2-60f0-4f6d-a735-21d56bae2f48",
                                                "sense_id": "0b4bf0a1-8a83-31b0-bbaf-b548309795c7",
                                                "text": "For days Ailie had an absent eye and a sad face, and it so fell out that in all that time young Heriotside, who had scarce missed a day, was laid up with a broken arm and never came near her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de405151-035e-362a-bc1f-05ee14313095",
                                        "entry_id": "2f47efb5-dc93-3cca-b0a5-f56dad659388",
                                        "glosses": [
                                            "Something absent, especially absent people collectively; those who were or are not there."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdbe2ed0-f7a2-4ab3-9e11-b9a6872b187e",
                                                "sense_id": "de405151-035e-362a-bc1f-05ee14313095",
                                                "text": "The Applause he met with exceeds all belief of the Absent."
                                            },
                                            {
                                                "example_id": "3df5128f-daa3-4ae9-b8e6-4ac46b3d1a9b",
                                                "sense_id": "de405151-035e-362a-bc1f-05ee14313095",
                                                "text": "That very sense of longing, of yearning for the absent, which 'nostalgia' conveys to us now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42538da8-d04b-34eb-bcc3-a8f4f2496a72",
                                        "entry_id": "2f47efb5-dc93-3cca-b0a5-f56dad659388",
                                        "glosses": [
                                            "An absentee; a person who is not there."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "absent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0acea5d-dc73-389e-bce6-c495b589295d",
                                        "entry_id": "69764307-09bd-3367-a8f3-7cbc314fca26",
                                        "glosses": [
                                            "In the absence of; without; except."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95b9dd12-fbef-4772-b620-efac42f52592",
                                                "sense_id": "d0acea5d-dc73-389e-bce6-c495b589295d",
                                                "text": "Absent taxes modern governments cannot function."
                                            },
                                            {
                                                "example_id": "c2804f08-7027-4f2d-a0cd-4275d1f6fdf4",
                                                "sense_id": "d0acea5d-dc73-389e-bce6-c495b589295d",
                                                "text": "If the accused refuse upon demand to pay money or deliver property (absent any excuse or excusing circumstance) which came into his hands as a bailee, such refusal might well constitute some evidence of conversion, with the requisite fraudulent intent required by the statute."
                                            },
                                            {
                                                "example_id": "ff332591-65e1-4003-9b1f-26341a084ea8",
                                                "sense_id": "d0acea5d-dc73-389e-bce6-c495b589295d",
                                                "text": "the Princess Caroline case […] established that – absent a measurable ‘public interest’ in publication – she was safe from being photographed while out shopping."
                                            },
                                            {
                                                "example_id": "40789e76-4533-4e53-b096-e3acdcdd9f6c",
                                                "sense_id": "d0acea5d-dc73-389e-bce6-c495b589295d",
                                                "text": "About 25 percent of Russia’s large farms continue to be unprofitable, and that number would be considerably higher absent government subsidies and assistance programs."
                                            },
                                            {
                                                "example_id": "d1a0f2c5-6e2b-48e0-a704-51b20fe6dd9c",
                                                "sense_id": "d0acea5d-dc73-389e-bce6-c495b589295d",
                                                "text": "And the distraction-management software Freedom offers a mode that won’t unlock affected apps absent a telephone-support call."
                                            },
                                            {
                                                "example_id": "c6e06b86-2d2e-47aa-97f1-fdae989e44b7",
                                                "sense_id": "d0acea5d-dc73-389e-bce6-c495b589295d",
                                                "text": "California cannot promulgate regulations that are inconsistent with US federal laws absent an explicit waiver from the federal government."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4b14771-c05c-3d48-b6ae-d072d95ba586",
                                        "entry_id": "54f48f20-53f3-336e-90cb-26cc4015b910",
                                        "glosses": [
                                            "To keep (oneself) away."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "949f2a1e-b240-400f-8db9-3c72f5cb1931",
                                                "sense_id": "c4b14771-c05c-3d48-b6ae-d072d95ba586",
                                                "text": "Most of the men are retired, jobless, or have otherwise temporarily absented themselves from the workplace."
                                            },
                                            {
                                                "example_id": "44b43232-5aa5-4033-a474-fd7d5db30cac",
                                                "sense_id": "c4b14771-c05c-3d48-b6ae-d072d95ba586",
                                                "text": "If after due summons any member absents himself, he is to be fined."
                                            },
                                            {
                                                "example_id": "25544e1d-d52d-477f-bec7-4a746eb998fd",
                                                "sense_id": "c4b14771-c05c-3d48-b6ae-d072d95ba586",
                                                "text": "This work was strictly voluntary, but any animal who absented himself from it would have his rations reduced by half."
                                            },
                                            {
                                                "example_id": "a4951f48-5965-4abf-b198-6886185065c5",
                                                "sense_id": "c4b14771-c05c-3d48-b6ae-d072d95ba586",
                                                "text": "Some people expect that the news should be written \"professionally,\" that it should conform to certain \"journalistic standards,\" and that it should not \"editorialize.\" And this is tantamount to saying it should be written objectively, that we should absent ourselves when writing copy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdb869f-b2b4-33b1-930b-44e5cb8d5564",
                                        "entry_id": "54f48f20-53f3-336e-90cb-26cc4015b910",
                                        "glosses": [
                                            "To keep (someone) away."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "142480ef-1e45-4bc5-9e31-cd6b2496f9b6",
                                                "sense_id": "4fdb869f-b2b4-33b1-930b-44e5cb8d5564",
                                                "text": "Go; for thy stay, not free, absents thee more;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc93bba7-e4ce-3f09-bce3-63858461cbbc",
                                        "entry_id": "54f48f20-53f3-336e-90cb-26cc4015b910",
                                        "glosses": [
                                            "Stay away; withdraw."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1a94fe6-0ebf-46a9-b78a-b04de0e07610",
                                                "sense_id": "cc93bba7-e4ce-3f09-bce3-63858461cbbc",
                                                "text": "The iron rule of the plantation, always passionately and violently enforced in that neighborhood, makes flogging the penalty of failing to be in the field before sunrise in the morning, unless special permission be given to the absenting slave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "871f30d7-a478-3247-ab8d-80b3f06ca824",
                                        "entry_id": "54f48f20-53f3-336e-90cb-26cc4015b910",
                                        "glosses": [
                                            "Leave."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aed80713-a5ef-3928-8f42-4614ef30b9c2",
                                        "entry_id": "54f48f20-53f3-336e-90cb-26cc4015b910",
                                        "glosses": [
                                            "To omit."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ca3f6e8-3956-494b-bf20-6a4a026e588b",
                                                "sense_id": "aed80713-a5ef-3928-8f42-4614ef30b9c2",
                                                "text": "When we realize that the digitalisation of the image involves - by reducing and even absenting - the role of 'the physical', the 'sensuous' (by reducing and eventually absenting the indexical aspects of the image) […]"
                                            },
                                            {
                                                "example_id": "a36b96f8-26b8-4855-83d5-2737e85edcb3",
                                                "sense_id": "aed80713-a5ef-3928-8f42-4614ef30b9c2",
                                                "text": "Such sequences draw attention to the affective appeals that environmental documentary typically makes, precisely by absenting those appeals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
