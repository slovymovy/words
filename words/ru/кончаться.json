{
    "word_family": [
        "конец",
        "кончать",
        "кончина",
        "конечный",
        "окончание",
        "окончательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd04a391-8374-3f93-85f6-176475d92dbf",
                    "sense_definition": "Приходить к концу, завершаться или прекращаться (о процессах, событиях, периодах времени).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "завершение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Уроки обычно <w>кончаются</w> в два часа дня.",
                            "target_lang_translations": {
                                "tr": "Dersler genellikle saat ikide <w>biter</w>."
                            }
                        },
                        {
                            "text": "Лето быстро <w>кончается</w>, и скоро наступит холодная осень.",
                            "target_lang_translations": {
                                "tr": "Yaz hızlıca <w>bitiyor</w> ve yakında soğuk sonbahar gelecek."
                            }
                        }
                    ],
                    "synonyms": [
                        "завершаться",
                        "заканчиваться",
                        "прекращаться"
                    ],
                    "antonyms": [
                        "начинаться"
                    ],
                    "common_phrases": [
                        "уроки кончаются",
                        "лето кончается"
                    ],
                    "target_lang_definitions": {
                        "tr": "Süreçlerin, olayların veya zaman dilimlerinin sona ermesi, bitmesi veya durması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bitmek",
                                "target_lang_sense_clarification": "sona ermek"
                            },
                            {
                                "target_lang_word": "sona ermek",
                                "target_lang_sense_clarification": "tamamlanmak"
                            },
                            {
                                "target_lang_word": "tükenmek",
                                "target_lang_sense_clarification": "zaman veya süreç için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaff1895-b695-3b34-b1d4-9b1bfda9e5cb",
                    "sense_definition": "Иссякать, расходоваться, подходить к концу (о запасах, деньгах, продуктах).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "исчерпание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас <w>кончаются</w> деньги, поэтому нужно экономить.",
                            "target_lang_translations": {
                                "tr": "Paramız <w>tükeniyor</w>, bu yüzden tasarruf etmemiz gerek."
                            }
                        },
                        {
                            "text": "В баке быстро <w>кончается</w> бензин, надо заехать на заправку.",
                            "target_lang_translations": {
                                "tr": "Depodaki benzin hızlıca <w>bitiyor</w>, benzinliğe uğramak lazım."
                            }
                        }
                    ],
                    "synonyms": [
                        "подходить к концу",
                        "исчерпываться"
                    ],
                    "common_phrases": [
                        "деньги кончаются",
                        "терпение кончается"
                    ],
                    "target_lang_definitions": {
                        "tr": "Stokların, paranın veya ürünlerin tükenmesi, azalması, sonuna gelinmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tükenmek",
                                "target_lang_sense_clarification": "kaynaklar veya para için"
                            },
                            {
                                "target_lang_word": "bitmek",
                                "target_lang_sense_clarification": "stok veya malzeme için"
                            },
                            {
                                "target_lang_word": "azalmak",
                                "target_lang_sense_clarification": "sona yaklaşmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "302f14aa-4db7-3b4b-a4b2-337e031dc1fd",
                    "sense_definition": "Разговорный эвфемизм: находиться при смерти, умирать.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "смерть",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач приехал слишком поздно, когда больной уже <w>кончался</w>.",
                            "target_lang_translations": {
                                "tr": "Doktor çok geç geldi, hasta zaten <w>can çekişiyordu</w>."
                            }
                        },
                        {
                            "text": "Она плакала у постели дедушки, понимая, что он <w>кончается</w>.",
                            "target_lang_translations": {
                                "tr": "Dedisinin başucunda ağlıyor, onun <w>ölmek üzere olduğunu</w> anlıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "умирать",
                        "отдавать концы"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется как эвфемизм"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ölmek üzere olmak, can çekişmek (konuşma dilinde hafifletici söz)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "can çekişmek",
                                "target_lang_sense_clarification": "ölmek üzere olmak"
                            },
                            {
                                "target_lang_word": "gözlerini yummak",
                                "target_lang_sense_clarification": "ölmek üzere olmak anlamında"
                            },
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "hayatını kaybetmek üzere olmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}