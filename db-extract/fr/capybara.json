                                    },
                                    {
                                        "sense_id": "89c65a82-617d-3990-8c93-dd665154c279",
                                        "entry_id": "5207568c-9aa2-3dbe-950a-a17e06becb17",
                                        "glosses": [
                                            "The greater capybara."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743e694e-89d8-4fa1-b98a-0542e4bcb6f0",
                                                "sense_id": "89c65a82-617d-3990-8c93-dd665154c279",
                                                "text": "“Our fires burned well,” continued Tom, “and we roasted our young capybara to perfection; we only wanted salt and pepper, and an onion or two to make it delicious.[…]\""
                                            },
                                            {
                                                "example_id": "d31d464f-260e-4443-8dc6-b5d6bcf8dd38",
                                                "sense_id": "89c65a82-617d-3990-8c93-dd665154c279",
                                                "text": "It was tenanted by the small caymans and by capybaras—the largest known rodent, a huge aquatic guinea-pig, the size of a small sheep."
                                            },
                                            {
                                                "example_id": "1b077f70-33d8-4f8f-9558-ee4065fb1795",
                                                "sense_id": "89c65a82-617d-3990-8c93-dd665154c279",
                                                "text": "The largest of all the 1,729 rodent species, the semi-aquatic capybara is extremely agile in the water, using its partly webbed toes like tiny paddles. Troops containing up to 20 animals live along riverbanks where young capybaras are sometimes preyed on by caimans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
