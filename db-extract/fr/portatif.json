                    {
                        "form_id": "a798d76a-12fc-4f5d-8f4a-97b5ce78c5f7",
                        "entry_id": "b6ca4ce2-e3c6-3d14-95a0-3b310d565d5e",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "portative"
                    },
                    {
                        "form_id": "15fc1030-1705-42cd-889a-7c62f16341de",
                        "entry_id": "b6ca4ce2-e3c6-3d14-95a0-3b310d565d5e",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "portatives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0191d7f3-cd01-3f20-b5ac-c31e31290450",
                        "entry_id": "b6ca4ce2-e3c6-3d14-95a0-3b310d565d5e",
                        "glosses": [
                            "Que l’on peut aisément porter pour le déplacer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a9f639c-2b51-4d08-b05f-8fe9c8fa597a",
                                "sense_id": "0191d7f3-cd01-3f20-b5ac-c31e31290450",
                                "text": "Les peuples préhistoriques ont eu des conventions monétaires, de coquillages, pierres, pépites ou lingots de métaux précieux, de valeur intrinsèque relative constante, pour acheter des objets moins portatifs dont le possesseur était titulaire. C'était des constitutions financières démocratiques de l'âge d'or."
                            },
                            {
                                "example_id": "31bfc047-04d3-4091-86e5-37585cacc978",
                                "sense_id": "0191d7f3-cd01-3f20-b5ac-c31e31290450",
                                "text": "Pourquoi personne n’a pensé à acheter des purificateurs d’air portatifs comme le recommande Québec solidaire ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f0d9209-7e6a-42ba-8dbc-9298156e1771",
                        "source_entry_id": "b6ca4ce2-e3c6-3d14-95a0-3b310d565d5e",
                        "source_sense_id": "0191d7f3-cd01-3f20-b5ac-c31e31290450",
                        "target_lang_word": "portable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "175bb157-def7-3eff-82b4-64aabe5005db",
                                        "entry_id": "8c2f4059-7a5c-3f3b-a1ca-1a178c43b6b6",
                                        "glosses": [
                                            "Able to be carried or easily moved."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8161cdf-fbf9-395b-b0be-e1db69784696",
                                        "entry_id": "8c2f4059-7a5c-3f3b-a1ca-1a178c43b6b6",
                                        "glosses": [
                                            "Able to be transferred from one organization to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e4aad3-4222-4c76-be70-9ce9d9c4d702",
                                                "sense_id": "b8161cdf-fbf9-395b-b0be-e1db69784696",
                                                "text": "a portable pension plan"
                                            },
                                            {
                                                "example_id": "47227893-5df8-4cc3-9823-3075ce606770",
                                                "sense_id": "b8161cdf-fbf9-395b-b0be-e1db69784696",
                                                "text": "Even though Houston’s moment was already fading by the late 2000s, the city’s hip-hop culture proved to be endlessly portable and disseminatable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0acb2ee6-c1b7-3779-b7cc-ae5b9bfbcc00",
                                        "entry_id": "8c2f4059-7a5c-3f3b-a1ca-1a178c43b6b6",
                                        "glosses": [
                                            "Of software: able to be run on multiple hardware or operating systems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf8ec44-5655-496e-8323-2c8b059c8e10",
                                                "sense_id": "0acb2ee6-c1b7-3779-b7cc-ae5b9bfbcc00",
                                                "text": "How do Java and C# create cross-platform, portable programs, and why can't C++ do the same?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f2e7ea6-fbc1-3542-9754-c777b4381a10",
                                        "entry_id": "8c2f4059-7a5c-3f3b-a1ca-1a178c43b6b6",
                                        "glosses": [
                                            "Of a program: able to be copied directly from one machine to another without the use of an installer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f23ae2-4f70-4d06-ae44-0f4828128f2e",
                                                "sense_id": "0f2e7ea6-fbc1-3542-9754-c777b4381a10",
                                                "text": "Starting with release 1.7, a portable version allows all Host Attachment Kit commands to be run without installing the Host Attachment Kit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa60150-5dad-3427-845c-5eb84291699e",
                                        "entry_id": "8c2f4059-7a5c-3f3b-a1ca-1a178c43b6b6",
                                        "glosses": [
                                            "Bearable, endurable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9b39417-fca1-4ca5-8946-d6d22949e5b5",
                                                "sense_id": "2aa60150-5dad-3427-845c-5eb84291699e",
                                                "text": "How light and portable my paine ſeemes now, / When that which makes me bend, makes the King bow."
                                            },
                                            {
                                                "example_id": "69a79eea-35bb-4fbb-9c6c-255d94225b92",
                                                "sense_id": "2aa60150-5dad-3427-845c-5eb84291699e",
                                                "text": "Christianity consists in a blessed exchange of yokes between Christ and a pious soul. He takes our uneasy yoke, and gives his easy yoke: the soul puts upon him that unsupportable yoke of transgressions, and takes from him the portable yoke of his commandments."
                                            },
                                            {
                                                "example_id": "728018c8-b428-4f1e-a490-fb6e56118e01",
                                                "sense_id": "2aa60150-5dad-3427-845c-5eb84291699e",
                                                "text": "It was also objected against John Chrystie in Spittell that he not being ane residenter within this burgh could not vote. To quhich it was answered that he is ane burges of the burgh and hes borne portable burding with the remanent burgesses these xxiiij yeares bygone."
                                            },
                                            {
                                                "example_id": "8b96d57d-c3d6-4c71-b447-2831e0fff35d",
                                                "sense_id": "2aa60150-5dad-3427-845c-5eb84291699e",
                                                "text": "[N]one be choſen to be upon the Council but Magiſtrats and Craftſmen, actual and real Burgeſſes dwelling within the Town, and bearing all portable charges within the ſame; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "portable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ab7433-dd63-3e39-9391-51d9e6143d7b",
                                        "entry_id": "a2e7c99a-8e60-34dc-901d-18538aaca39d",
                                        "glosses": [
                                            "A portable building used for temporary purposes",
                                            "Clipping of portable toilet."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25dc7660-c5fc-3e65-a26c-70151e021d2e",
                                        "entry_id": "a2e7c99a-8e60-34dc-901d-18538aaca39d",
                                        "glosses": [
                                            "A portable building used for temporary purposes",
                                            "A trailer or other movable structure used for classes at a school."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b5f49c-3143-33e2-9816-d345d84a9b2b",
                                        "entry_id": "a2e7c99a-8e60-34dc-901d-18538aaca39d",
                                        "glosses": [
                                            "Clipping of portable computer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d64ec9c-831c-4fd4-b98d-c866fc94547d",
                                                "sense_id": "54b5f49c-3143-33e2-9816-d345d84a9b2b",
                                                "text": "A few portables, particularly the small laphelds, go one step further and come with software built into the computer."
                                            },
                                            {
                                                "example_id": "96cacea2-5797-46f4-8fac-49d12662796c",
                                                "sense_id": "54b5f49c-3143-33e2-9816-d345d84a9b2b",
                                                "text": "Compaq portables have grown lighter and more powerful since then. Their newest luggable, the Compaq Portable III, is six times more powerful and 10 pounds lighter than the original model."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6550fd77-3651-34bd-80ce-9dc8952fe201",
                                        "entry_id": "a2e7c99a-8e60-34dc-901d-18538aaca39d",
                                        "glosses": [
                                            "A hand-held video gaming device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
