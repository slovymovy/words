                "senses": [
                    {
                        "sense_id": "6f14410f-366f-348f-a2f0-5e9834f95e92",
                        "entry_id": "972e0bb0-6c8d-3d6b-a079-525af55708a6",
                        "glosses": [
                            "Appât (pour hameçon, pour casier ou pour attirer le poisson autour des filets de pêche)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aaebc1f-f736-4cd9-8d19-75385f62ec92",
                                "sense_id": "6f14410f-366f-348f-a2f0-5e9834f95e92",
                                "text": "Autrefois, le capelan était en abondance sur les côtes des Iles de la Madeleine. Ce poisson servait de bouette pour la morue. Mais des pêcheurs ambitieux en trop grand nombre le pêchaient le dimanche afin de prendre de l'avance pour le lundi matin."
                            },
                            {
                                "example_id": "e5ca977a-983d-40d7-a0a8-e8eb674fd89f",
                                "sense_id": "6f14410f-366f-348f-a2f0-5e9834f95e92",
                                "text": "Actuellement on utilise la bouette pour mettre dans les casiers de pèche."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "975f226c-6431-3abd-9588-4e6df2e74d2b",
                "word": "bouette",
