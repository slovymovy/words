                                    },
                                    {
                                        "sense_id": "3faeb5b0-caa0-338b-870b-73475db636ce",
                                        "entry_id": "fee823dc-24d2-31ca-86c6-9c540dba1c84",
                                        "glosses": [
                                            "A base or fundamental component; something that is irreducible."
                                        ],
