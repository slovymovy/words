                "senses": [
                    {
                        "sense_id": "5510fe54-9e07-390d-8fd0-e001baff2340",
                        "entry_id": "38df9180-e673-3a7a-a7d8-a14e9e2d2e59",
                        "glosses": [
                            "Action de remettre à la fonte, en parlant spécialement des monnaies dont on fait de nouvelles espèces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f84bc06-77f3-4920-ae6f-5cb0ed5aeebb",
                                "sense_id": "5510fe54-9e07-390d-8fd0-e001baff2340",
                                "text": "Depuis la refonte des monnaies."
                            }
                        ]
                    },
                    {
                        "sense_id": "d18814c4-253f-30f3-9b43-d6cbebeb3be8",
                        "entry_id": "38df9180-e673-3a7a-a7d8-a14e9e2d2e59",
                        "glosses": [
                            "Réfection de la forme, de l’ordre, en parlant d’un ouvrage de l’esprit, d’une loi, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2980a371-f5c9-41a9-8d04-2615d1f60da2",
                                "sense_id": "d18814c4-253f-30f3-9b43-d6cbebeb3be8",
                                "text": "La refonte du gouvernement islamique sur le modèle perse, par exemple, continua d'être rejetée et ignorée par les musulmans arabes."
                            },
                            {
                                "example_id": "2d74bf46-11db-4fb5-b629-0144ad58ed8d",
                                "sense_id": "d18814c4-253f-30f3-9b43-d6cbebeb3be8",
                                "text": "La législation fut soumise à une refonte complète."
                            },
                            {
                                "example_id": "a43f7d8b-debc-44ab-becd-be1633951e8e",
                                "sense_id": "d18814c4-253f-30f3-9b43-d6cbebeb3be8",
                                "text": "Son florilège […] mêle chansons connues et moins connues, enregistrements d'origine et refontes, plus un titre inédit (Les filles qui font la gueule)."
                            }
                        ]
                    },
                    {
                        "sense_id": "035d4a8e-441a-3010-9ee2-cab2d41a9dc6",
                        "entry_id": "38df9180-e673-3a7a-a7d8-a14e9e2d2e59",
                        "glosses": [
                            "Action de relooker un site Internet."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7f92aaa2-8f99-4372-a982-93114cb847c3",
                                "sense_id": "035d4a8e-441a-3010-9ee2-cab2d41a9dc6",
                                "text": "D’abord la création ensuite la refonte."
                            }
                        ]
                    },
                    {
                        "sense_id": "73ad6e83-e3cd-3fbd-bdc0-bdc1a3bf2687",
                        "entry_id": "38df9180-e673-3a7a-a7d8-a14e9e2d2e59",
                        "glosses": [
                            "Opération consistant à refaire systématiquement la rédaction d’une carte, en modifiant éventuellement les modes d’expression ou de représentation et qui s’accompagne généralement d’une révision cartographique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa37a68b-b9ff-473d-a88e-17f5ce81c9c8",
                        "source_entry_id": "38df9180-e673-3a7a-a7d8-a14e9e2d2e59",
                        "target_lang_word": "overhaul",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overhaul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1052ae7e-9761-34c5-a4c8-d7867137007d",
                                        "entry_id": "868df81f-773e-3319-b498-8562664908e8",
                                        "glosses": [
                                            "A major repair, renovation, or revision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c61bb0a6-bc9e-4811-9f51-8f2c2e352f11",
                                                "sense_id": "1052ae7e-9761-34c5-a4c8-d7867137007d",
                                                "text": "The engine required a complete overhaul to run properly."
                                            },
                                            {
                                                "example_id": "2c092fb7-d6a1-46b7-a626-1aff08a78fd8",
                                                "sense_id": "1052ae7e-9761-34c5-a4c8-d7867137007d",
                                                "text": "One aim of the move [from Nine Elms] had been to speed up the overhaul of the company's locomotive stock and to reduce costs with more efficient workshop facilities, in what Dugald Drummond claimed to be \"the most complete and up-to-date works owned by any railway company\"."
                                            },
                                            {
                                                "example_id": "ea196682-5f10-4c9b-8785-afdf080f2c4f",
                                                "sense_id": "1052ae7e-9761-34c5-a4c8-d7867137007d",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, […]. A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul. Instead it offers fixes and patches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc772faa-851e-3bc2-932a-d067e21dfec3",
                                        "entry_id": "868df81f-773e-3319-b498-8562664908e8",
                                        "glosses": [
                                            "The process after the fire appears extinguished in which the firefighters search the structure for signs of hot spots that may cause the structure to reignite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "overhaul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "189fae26-de5b-3ad1-a26f-05cb98305d0a",
                                        "entry_id": "4c5a1ef2-f50e-3387-b4ce-0ae9241085de",
                                        "glosses": [
                                            "To modernize, repair, renovate, or revise completely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385915a8-73d3-4691-9e44-353f4e058820",
                                                "sense_id": "189fae26-de5b-3ad1-a26f-05cb98305d0a",
                                                "text": "While the engines are dealt with in the diesel shop, their parent locomotives are overhauled in the erecting shop."
                                            },
                                            {
                                                "example_id": "2df6fd96-2ed6-40ef-bb55-b070c74f2e70",
                                                "sense_id": "189fae26-de5b-3ad1-a26f-05cb98305d0a",
                                                "text": "In his senior year, he had run across an old '66 Chevy Super Sport headed for the junkyard, bought it for a song, and overhauled it with his dad's help, turning it into the big red muscle car it was back in its day."
                                            },
                                            {
                                                "example_id": "827e741f-088a-4226-b74a-6a3fb1c67139",
                                                "sense_id": "189fae26-de5b-3ad1-a26f-05cb98305d0a",
                                                "text": "Although they believe they can overhaul their 2-0 deficit, they cannot afford to be as lethargic as this at Camp Nou, and the time is surely approaching when Manuel Pellegrini's faith in Martín Demichelis wavers."
                                            },
                                            {
                                                "example_id": "c93d92fa-c352-44e5-a38a-5eece4b34ead",
                                                "sense_id": "189fae26-de5b-3ad1-a26f-05cb98305d0a",
                                                "text": "A non-hormonal birth control capsule that women can insert just before sex. A rape kit that gives victims more agency and streamlines the evidence collection process. An overhauled design for a 150-year-old tool used in postpartum vaginal tearing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b322c879-f1ef-382f-9b2c-b52c98e750e5",
                                        "entry_id": "4c5a1ef2-f50e-3387-b4ce-0ae9241085de",
                                        "glosses": [
                                            "To pass, overtake, or travel past."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6bf885-aa32-4f23-a9d8-38bcbd5eb252",
                                                "sense_id": "b322c879-f1ef-382f-9b2c-b52c98e750e5",
                                                "text": "An amusing incident on the first of these journeys was the checking by signal of the flyer about 3 miles out of Paris, with the result that it was overhauled by the 6.25 p.m. semi-fast from Paris to Montargis, to the unconcealed delight of passengers in the latter."
                                            },
                                            {
                                                "example_id": "c142dae8-60f5-4ed6-9e8a-055e2db6351f",
                                                "sense_id": "b322c879-f1ef-382f-9b2c-b52c98e750e5",
                                                "text": "In theory there was a runner ahead of him who would pause to sleep. Who would falter and fall. Who would despair at the size of the desert. Because Logan did none of these he would overhaul the runner and kill him."
                                            },
                                            {
                                                "example_id": "cf518a40-1e82-4bb4-9e71-7c7820f8efc2",
                                                "sense_id": "b322c879-f1ef-382f-9b2c-b52c98e750e5",
                                                "text": "The slowing New Jersey has veered out of line, and is forced to check its fire briefly as Iowa overhauls it, but then resumes fire as damage-control crews work hard below. Admiral Lee's other two ships, coming up behind, take Yamato under fire with their forward guns as well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6d11feb-0866-3e5d-9f3d-797e7ef4337c",
                                        "entry_id": "4c5a1ef2-f50e-3387-b4ce-0ae9241085de",
                                        "glosses": [
                                            "To keep (running rigging) clear, and see that no hitch occurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ed7eeaf-f30b-3a9d-932d-a03faf641cfb",
                                        "entry_id": "4c5a1ef2-f50e-3387-b4ce-0ae9241085de",
                                        "glosses": [
                                            "To search (a ship) for contraband goods."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f936df58-3c0d-4efc-8277-8d90f51d9b35",
                        "source_entry_id": "38df9180-e673-3a7a-a7d8-a14e9e2d2e59",
                        "target_lang_word": "recast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recast",
