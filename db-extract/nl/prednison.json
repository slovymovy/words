                "senses": [
                    {
                        "sense_id": "b3efa646-5394-3286-a5c9-5de001ecc51e",
                        "entry_id": "56bedb9d-7539-322c-8e31-86a966a5f415",
                        "glosses": [
                            "synthetisch steroïd dat men gebruikt als ontstekingsremmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0226a74-0fd9-4c9f-b225-28275723f31f",
                                "sense_id": "b3efa646-5394-3286-a5c9-5de001ecc51e",
                                "text": "Het is voor het eerst dat er ook voetballers worden genoemd die medische attesten kregen. Kuyt gebruikte bij het WK de steroïden dexamethason. Dexamethason werkt 25 keer zo sterk als hydrocortison en ongeveer vijf keer zo sterk als het vergelijkbare prednison."
                            },
                            {
                                "example_id": "14733c8e-73b4-437f-91d8-a4231acf613e",
                                "sense_id": "b3efa646-5394-3286-a5c9-5de001ecc51e",
                                "text": "In 2014 kreeg Chris Froome toestemming om tijdens de Ronde van Romandië prednison (een paardenmiddel dat ontstekingen remt, maar ook een euforisch gevoel kan geven) te gebruiken."
                            },
                            {
                                "example_id": "5d6ffa38-10c9-4ab7-8b1d-96fc32465778",
                                "sense_id": "b3efa646-5394-3286-a5c9-5de001ecc51e",
                                "text": "Bridget Maasland (43) is tijdens de opnames van het RTL4-programma Dance Dance Dance zo ziek geweest dat ze haar eerste solodans stoned moest opvoeren. Volgens de RTL Boulevard-reporter was ze 'doodziek' en moest ze zelfs een dosis van het sterke medicijn Prednison nemen."
                            }
                        ]
                    }
                ],
