{
    "word_family": [
        "ambler",
        "ambling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86ab9f45-c265-30f3-94fa-63b5471576b3",
                    "sense_definition": "To walk in a slow, relaxed, and leisurely manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>amble</w> along the beach at sunset.",
                            "target_lang_translations": {
                                "nl": "Ze besloten bij zonsondergang langs het strand te <w>slenteren</w>."
                            }
                        },
                        {
                            "text": "Tourists <w>ambled</w> through the narrow streets of the old town.",
                            "target_lang_translations": {
                                "nl": "Toeristen <w>slenterden</w> door de smalle straatjes van de oude stad."
                            }
                        }
                    ],
                    "synonyms": [
                        "saunter"
                    ],
                    "common_phrases": [
                        "amble through"
                    ],
                    "target_lang_definitions": {
                        "nl": "Langzaam, ontspannen en op je gemak lopen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "slenteren",
                                "target_lang_sense_clarification": "langzaam en ontspannen wandelen, vaak zonder haast of vast doel"
                            },
                            {
                                "target_lang_word": "kuieren",
                                "target_lang_sense_clarification": "rustig en op je gemak lopen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acb9154a-0456-3510-aa41-866953c5ff88",
                    "sense_definition": "Of a horse or other four-legged animal, to move by lifting both legs on one side simultaneously, then both legs on the other side.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse began to <w>amble</w> across the field with a smooth, rhythmic motion.",
                            "target_lang_translations": {
                                "nl": "Het paard begon in een soepele, ritmische <w>telgang</w> over het veld te gaan."
                            }
                        },
                        {
                            "text": "Some breeds are trained to <w>amble</w> rather than trot for a more comfortable ride.",
                            "target_lang_translations": {
                                "nl": "Sommige rassen worden getraind om in <w>telgang</w> te lopen in plaats van te draven, voor een comfortabelere rit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Van een paard of ander viervoetig dier: zich voortbewegen door eerst beide benen aan de ene kant en daarna beide benen aan de andere kant op te tillen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "in telgang lopen",
                                "target_lang_sense_clarification": "van een paard: zich voortbewegen in een laterale viertaktgang"
                            },
                            {
                                "target_lang_word": "gangen",
                                "target_lang_sense_clarification": "van een paard: een zachte, gelijkmatige gang maken die geen gewone draf is"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f96571df-64b6-3c90-84cd-35fbbe1c9d85",
                    "sense_definition": "A slow, relaxed, and leisurely walk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a pleasant <w>amble</w> through the quiet woods.",
                            "target_lang_translations": {
                                "nl": "We maakten een aangename <w>wandeling</w> door het stille bos."
                            }
                        },
                        {
                            "text": "After dinner, they enjoyed a short <w>amble</w> around the garden.",
                            "target_lang_translations": {
                                "nl": "Na het eten genoten ze van een korte <w>wandeling</w> door de tuin."
                            }
                        }
                    ],
                    "synonyms": [
                        "saunter"
                    ],
                    "common_phrases": [
                        "leisurely amble"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een langzame, ontspannen wandeling."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wandeling",
                                "target_lang_sense_clarification": "een rustige, ontspannen wandeling"
                            },
                            {
                                "target_lang_word": "slentertocht",
                                "target_lang_sense_clarification": "een doelloze, langzame wandeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18e7c712-67ec-3b91-a3ad-55f407aa4058",
                    "sense_definition": "A smooth, easy gait of a horse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider appreciated the horse's steady <w>amble</w> during the long journey.",
                            "target_lang_translations": {
                                "nl": "De ruiter waardeerde de gelijkmatige <w>telgang</w> van het paard tijdens de lange reis."
                            }
                        },
                        {
                            "text": "The animal maintained a comfortable <w>amble</w> over the uneven ground.",
                            "target_lang_translations": {
                                "nl": "Het dier hield een comfortabele <w>telgang</w> aan over de oneffen grond."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een soepele, gemakkelijke gang van een paard."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "telgang",
                                "target_lang_sense_clarification": "de zachte, gelijkmatige gang van een paard"
                            },
                            {
                                "target_lang_word": "gang",
                                "target_lang_sense_clarification": "een comfortabele, vloeiende paardengang"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58474474-d950-31b9-a63d-8992d2d5de56",
                    "sense_definition": "Something that follows a preamble.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main body of the report serves as an <w>amble</w> to the initial summary.",
                            "target_lang_translations": {
                                "nl": "Het hoofdgedeelte van het rapport dient als een <w>vervolg</w> op de inleidende samenvatting."
                            }
                        },
                        {
                            "text": "The document contains a brief introduction followed by an <w>amble</w> detailing the specific requirements.",
                            "target_lang_translations": {
                                "nl": "Het document bevat een korte inleiding, gevolgd door een <w>vervolgdeel</w> waarin de specifieke vereisten worden beschreven."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets wat op een preambule of inleiding volgt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vervolg",
                                "target_lang_sense_clarification": "datgene wat op een inleiding volgt"
                            },
                            {
                                "target_lang_word": "vervolgdeel",
                                "target_lang_sense_clarification": "deel dat na een preambule of inleiding komt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "32ce8ca4-3209-30fb-a5a0-97208c8cf094",
                    "sense_definition": "A town in Northumberland, England.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The coastal town of <w>Amble</w> is known for its beautiful harbour.",
                            "target_lang_translations": {
                                "nl": "De kustplaats <w>Amble</w> staat bekend om haar mooie haven."
                            }
                        },
                        {
                            "text": "Many tourists visit <w>Amble</w> to enjoy the fresh sea air.",
                            "target_lang_translations": {
                                "nl": "Veel toeristen bezoeken <w>Amble</w> om van de frisse zeelucht te genieten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een stadje in Northumberland, Engeland."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Amble",
                                "target_lang_sense_clarification": "plaatsnaam in Northumberland, Engeland"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62408aeb-e110-3e59-9d57-5a739825fbb9",
                    "sense_definition": "A river in Cornwall, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The river <w>Amble</w> flows gently into the Camel estuary.",
                            "target_lang_translations": {
                                "nl": "De rivier <w>Amble</w> stroomt rustig de monding van de Camel in."
                            }
                        },
                        {
                            "text": "Wildlife thrives along the banks of the <w>Amble</w>.",
                            "target_lang_translations": {
                                "nl": "Langs de oevers van de <w>Amble</w> gedijt veel wilde fauna."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een rivier in Cornwall, Engeland."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Amble",
                                "target_lang_sense_clarification": "naam van een rivier in Cornwall, Engeland"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd81d9c6-6fc3-3239-bae4-36744631d770",
                    "sense_definition": "A community in Michigan, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Amble</w> is located in Montcalm County.",
                            "target_lang_translations": {
                                "nl": "De kleine gemeenschap <w>Amble</w> ligt in Montcalm County."
                            }
                        },
                        {
                            "text": "Life in <w>Amble</w> is quiet and rural.",
                            "target_lang_translations": {
                                "nl": "Het leven in <w>Amble</w> is rustig en landelijk."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gemeenschap in Michigan, Verenigde Staten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Amble",
                                "target_lang_sense_clarification": "plaatsnaam in Michigan, Verenigde Staten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}