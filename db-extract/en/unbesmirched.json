    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0bb5e95f-a8cc-36a2-87d5-5eb4dbfdd487",
                "word": "unbesmirched",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3b67a99a-eeb8-4d4a-ae48-9e17747b1918",
                        "entry_id": "0bb5e95f-a8cc-36a2-87d5-5eb4dbfdd487",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more unbesmirched"
                    },
                    {
                        "form_id": "ad9ec8dd-1fe4-4487-bd0a-40fe98f0ead9",
                        "entry_id": "0bb5e95f-a8cc-36a2-87d5-5eb4dbfdd487",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unbesmirched"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff4c2723-9399-3fb5-baf5-5d45e8073b34",
                        "entry_id": "0bb5e95f-a8cc-36a2-87d5-5eb4dbfdd487",
                        "glosses": [
                            "Not besmirched; not spoiled or blemished."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb3da5ee-ff81-407f-ba65-7c3538582554",
                                "sense_id": "ff4c2723-9399-3fb5-baf5-5d45e8073b34",
                                "text": "The prime minister's reputation has remained unbesmirched throughout her career."
                            },
                            {
                                "example_id": "44d5342a-936d-4942-8a76-26ca51f103bc",
                                "sense_id": "ff4c2723-9399-3fb5-baf5-5d45e8073b34",
                                "text": "My husband and I were aghast as we pondered a major stove upgrade, but then we recalled acquaintances with gorgeous Viking stoves that sit unbesmirched by actual cooking, almost as if the stainless professional-quality stove is more prop than appliance, a requirement for kitchen happiness in the modern world."
                            },
                            {
                                "example_id": "d623b09c-3b5e-4092-bc7a-0ceec7b5b662",
                                "sense_id": "ff4c2723-9399-3fb5-baf5-5d45e8073b34",
                                "text": "By this I mean Fordwich is unbesmirched by Londoners, who, as I write, lie a mere 63 miles away and are now reading that Dan Smith, an ex-Clove Club chef, has taken harness of a gargantuan country boozer in this tiny town."
                            },
                            {
                                "example_id": "70ccfca8-bbe2-4974-a6ea-d2677f629d08",
                                "sense_id": "ff4c2723-9399-3fb5-baf5-5d45e8073b34",
                                "text": "And as president of the Los Angeles Memorial Coliseum Commission she [Janice Hahn] is calling for USC to renegotiate the 16-year, $69-million deal that it struck with United Airlines, leaving the hallowed entrance arches of the Coliseum unbesmirched by brand names and corporate logos."
                            },
                            {
                                "example_id": "94bdc7ff-4164-480a-810a-96fe79bbb7c1",
                                "sense_id": "ff4c2723-9399-3fb5-baf5-5d45e8073b34",
                                "text": "The girl behind that mask is Leonor, the 14-year-old heir to the Spanish throne, whose fresh face and unbesmirched character stand in contrast to that of her 82-year-old grandfather, Juan Carlos."
                            }
                        ]
                    }
                ],
