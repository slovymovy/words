                "senses": [
                    {
                        "sense_id": "5c4cd792-c3a0-3ebc-8fe7-421d190c68df",
                        "entry_id": "82be1519-b099-3159-a0dc-3e93c45442c3",
                        "glosses": [
                            "Sous-discipline naissante de la biologie de synthèse qui vise la mise au point de formes de vie étrangères, du point de vue chimique et informationnel, à celles jusqu’alors connues sur Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "569faf7a-b0ea-440c-9229-412283d5c09e",
                                "sense_id": "5c4cd792-c3a0-3ebc-8fe7-421d190c68df",
                                "text": "La xénobiologie est l’étude des formes de vie créées par la biologie de synthèse."
                            },
                            {
                                "example_id": "9e5171c1-f66b-4a1e-b995-94187bda3606",
                                "sense_id": "5c4cd792-c3a0-3ebc-8fe7-421d190c68df",
                                "text": "« Leur conclusion me pousse à accélérer la voie de recherche dans laquelle je suis engagée, la xénobiologie », ajoute Philippe Marlière, à propos d’une biochimie qui consiste à créer des molécules encore plus éloignées de notre arbre de vie en utilisant d’autres acides aminés que les vingt existants, par exemple, ou des atomes comme le silicium."
                            }
                        ]
                    }
                ],
