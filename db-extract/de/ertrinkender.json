                "senses": [
                    {
                        "sense_id": "af1cfe9a-a51c-3f3e-97a1-f3ec3844e614",
                        "entry_id": "de92b98f-4293-3b0f-99ea-a4ce0ba5c03e",
                        "glosses": [
                            "Person, die ertrinkt, in Wasser untergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f89a86-e5ed-4b6a-b6f7-1745cf3de5fa",
                                "sense_id": "af1cfe9a-a51c-3f3e-97a1-f3ec3844e614",
                                "text": "„Doch als er sie umarmte, sich an sie klammerte wie ein Ertrinkender, wurde ihr klar, dass etwas sehr Schlimmes passiert sein musste.“"
                            },
                            {
                                "example_id": "12675577-44de-4188-96f2-987a0e3567a4",
                                "sense_id": "af1cfe9a-a51c-3f3e-97a1-f3ec3844e614",
                                "text": "„Aber gleichzeitig greift ein Ertrinkender nach allem, um sich über Wasser zu halten, und deswegen fragte ich mich, ob Einstein wohl am Ertrinken war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
