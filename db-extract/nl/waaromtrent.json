                                ]
                            },
                            {
                                "target_word": "whereabouts",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27ed74de-acc0-3b6c-b4a2-9cf50bcd82b8",
                                        "entry_id": "8876ae62-7653-3d80-8948-3e5082ca18dd",
                                        "glosses": [
                                            "A location; where something is situated."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75c026d8-5740-40df-bc20-5c9f340c3486",
                                                "sense_id": "27ed74de-acc0-3b6c-b4a2-9cf50bcd82b8",
                                                "text": "Further clues are provided by milk-floats bearing the legend 'Lord Rayleigh's Dairies: A Family Business', and a number of signs indicating the whereabouts of various departments of Lord Rayleigh's Farms."
                                            },
                                            {
                                                "example_id": "f3eefbf8-adc9-47e2-9f96-591b4129d87a",
                                                "sense_id": "27ed74de-acc0-3b6c-b4a2-9cf50bcd82b8",
                                                "text": "In the Middle Ages Rhabdomancers were employed to discover mines, and the whereabouts of precious stones."
                                            },
                                            {
                                                "example_id": "c0125a55-8634-411b-9123-f816ff001f97",
                                                "sense_id": "27ed74de-acc0-3b6c-b4a2-9cf50bcd82b8",
                                                "text": "the effectively functioning group of relatives is likely to be much smaller owing, for instance, to death of the older generation or far distant whereabouts of other relatives."
                                            },
                                            {
                                                "example_id": "226d364a-7c0c-4e41-b5ba-80a18436e2c5",
                                                "sense_id": "27ed74de-acc0-3b6c-b4a2-9cf50bcd82b8",
                                                "text": "It might feel like forever ago, but you're probably still wondering about the whereabouts of fireman-turned-deckhand Bobby Giancola, English second stew Julia d'Albert Pusey, and of course, Danny Zureikat, the deckhand who didn't quite make it to the end of the charter season. Well, we have answers—and some of their whereabouts might surprise you."
                                            },
                                            {
                                                "example_id": "d5c0ed59-bbce-4810-83c9-b716b0e55d19",
                                                "sense_id": "27ed74de-acc0-3b6c-b4a2-9cf50bcd82b8",
                                                "text": "Mr. Zerón’s exact whereabouts is not known and he could not be reached for comment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca8cec32-7fb8-3616-a215-7036e142e9c4",
                                        "entry_id": "8876ae62-7653-3d80-8948-3e5082ca18dd",
                                        "glosses": [
                                            "Information about an elite athlete's future whereabouts, supplied to antidoping authorities to facilitate random out-of-competition testing."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abb8a49-3ced-4062-9aa5-6770a9ec84fa",
                                                "sense_id": "ca8cec32-7fb8-3616-a215-7036e142e9c4",
                                                "text": "The IPC reminds all athletes in their Registered Testing Pool to remain vigilant when it comes to filing and updating their whereabouts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
