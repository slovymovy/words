{
    "word_family": [
        "discordant",
        "discordance",
        "discordancy",
        "discordantly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79977b35-1026-3e1f-8c8e-d0547e9f42cd",
                    "sense_definition": "Tension or strife resulting from a lack of agreement or harmony between people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>discord</w> between the two political parties made it impossible to pass any new laws.",
                            "target_lang_translations": {
                                "ru": "Постоянный <w>раздор</w> между двумя политическими партиями сделал невозможным принятие новых законов."
                            }
                        },
                        {
                            "text": "He was known as a man who would sow <w>discord</w> among his colleagues to gain an advantage.",
                            "target_lang_translations": {
                                "ru": "Он был известен как человек, который сеял <w>раздор</w> среди коллег, чтобы получить преимущество."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "harmony",
                        "concord",
                        "agreement"
                    ],
                    "common_phrases": [
                        "sow discord",
                        "marital discord",
                        "civil discord"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напряженность или борьба, возникающая из-за отсутствия согласия или гармонии между людьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздор",
                                "target_lang_sense_clarification": "серьезное несогласие или вражда"
                            },
                            {
                                "target_lang_word": "разногласие",
                                "target_lang_sense_clarification": "отсутствие единства во мнениях"
                            },
                            {
                                "target_lang_word": "разлад",
                                "target_lang_sense_clarification": "нарушение добрых отношений"
                            },
                            {
                                "target_lang_word": "несогласие",
                                "target_lang_sense_clarification": "отсутствие взаимного согласия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c956c9ad-8468-3cb8-9d9f-ca927f8c282c",
                    "sense_definition": "An inharmonious combination of musical tones sounded together; a lack of musical harmony.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer used intentional <w>discord</w> to create a feeling of unease in the audience.",
                            "target_lang_translations": {
                                "ru": "Композитор намеренно использовал <w>диссонанс</w>, чтобы вызвать у слушателей чувство тревоги."
                            }
                        },
                        {
                            "text": "The harsh <w>discord</w> of the out-of-tune instruments was painful to the ears of the conductor.",
                            "target_lang_translations": {
                                "ru": "Резкая <w>нестройность</w> расстроенных инструментов резала слух дирижеру."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "harmony",
                        "consonance"
                    ],
                    "common_phrases": [
                        "harsh discord",
                        "musical discord"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неблагозвучное сочетание музыкальных тонов, звучащих одновременно; отсутствие музыкальной гармонии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диссонанс",
                                "target_lang_sense_clarification": "музыкальный термин"
                            },
                            {
                                "target_lang_word": "нестройность",
                                "target_lang_sense_clarification": "отсутствие лада в звучании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fa9c8ba-3df6-3996-9c59-6a55da872a2c",
                    "sense_definition": "Any harsh, unpleasant noise or a confused mingling of sounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>discord</w> of the busy city streets kept the tourists awake all through the night.",
                            "target_lang_translations": {
                                "ru": "<w>Разноголосица</w> оживленных городских улиц не давала туристам уснуть всю ночь."
                            }
                        },
                        {
                            "text": "A sudden <w>discord</w> of shouting and breaking glass erupted from the alleyway behind the house.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>шум</w> криков и бьющегося стекла донесся из переулка за домом."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "silence",
                        "melody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой резкий, неприятный шум или беспорядочное смешение звуков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диссонанс",
                                "target_lang_sense_clarification": "неприятное для слуха сочетание звуков"
                            },
                            {
                                "target_lang_word": "разноголосица",
                                "target_lang_sense_clarification": "беспорядочное смешение звуков"
                            },
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "неприятные звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbb733a6-4fc3-3eae-9dab-8e708cc9cb93",
                    "sense_definition": "A specific server or community hosted on the Discord communication platform.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to join the <w>Discord</w> for my favorite video game to find people to play with.",
                            "target_lang_translations": {
                                "ru": "Я решил вступить в <w>дискорд-сервер</w> моей любимой видеоигры, чтобы найти напарников."
                            }
                        },
                        {
                            "text": "Many streamers have private <w>Discords</w> where they interact directly with their most loyal fans.",
                            "target_lang_translations": {
                                "ru": "У многих стримеров есть частные <w>дискорд-каналы</w>, где они общаются напрямую со своими самыми преданными фанатами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "join the Discord",
                        "Discord server"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный сервер или сообщество на платформе Discord."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дискорд-сервер",
                                "target_lang_sense_clarification": "сообщество в приложении"
                            },
                            {
                                "target_lang_word": "дискорд",
                                "target_lang_sense_clarification": "разговорное название сервера"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a4d7e2a2-fa20-34bc-bd5c-e37ba1fb528d",
                    "sense_definition": "A social platform for instant messaging and VoIP, primarily used by gamers and communities.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "We usually hang out on <w>Discord</w> every evening to talk while we play games together.",
                            "target_lang_translations": {
                                "ru": "Обычно мы каждый вечер сидим в <w>Дискорде</w> и общаемся, пока играем вместе."
                            }
                        },
                        {
                            "text": "You can download <w>Discord</w> on your phone or use it directly in your web browser.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать <w>Дискорд</w> на телефон или использовать его прямо в браузере."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "on Discord",
                        "Discord account"
                    ],
                    "target_lang_definitions": {
                        "ru": "Социальная платформа для обмена сообщениями и голосового общения, популярная среди геймеров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дискорд",
                                "target_lang_sense_clarification": "название мессенджера"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00a57a0e-ca70-37d4-ba82-3d2f65777ba7",
                    "sense_definition": "To disagree or to fail to be in harmony with something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness's testimony seemed to <w>discord</w> with the physical evidence found at the scene.",
                            "target_lang_translations": {
                                "ru": "Показания свидетеля, казалось, <w>противоречили</w> вещественным доказательствам, найденным на месте происшествия."
                            }
                        },
                        {
                            "text": "His modern lifestyle began to <w>discord</w> with the traditional values of his small hometown.",
                            "target_lang_translations": {
                                "ru": "Его современный образ жизни начал <w>расходиться</w> с традиционными ценностями его маленького родного городка."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "accord",
                        "harmonize",
                        "agree"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расходиться во мнениях или не гармонировать с чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоречить",
                                "target_lang_sense_clarification": "не соответствовать чему-либо"
                            },
                            {
                                "target_lang_word": "расходиться",
                                "target_lang_sense_clarification": "быть в несогласии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}