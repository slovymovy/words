                "senses": [
                    {
                        "sense_id": "ce92d74b-b1cb-354a-ac70-c94e43f1d34c",
                        "entry_id": "2d8c6588-090f-3061-ac4c-33594782b414",
                        "glosses": [
                            "Montrer un caractère d'ours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216d8860-15f6-4a71-93d6-3be701ec25e6",
                                "sense_id": "ce92d74b-b1cb-354a-ac70-c94e43f1d34c",
                                "text": "Et puis, ne préférait-il pas, selon son expression, « oursonner » entre deux veilles créatrices devant sa petite table ?"
                            },
                            {
                                "example_id": "f3b516f1-3170-42d9-889e-6b5b92af3728",
                                "sense_id": "ce92d74b-b1cb-354a-ac70-c94e43f1d34c",
                                "text": "Quand vous aurez fini d'oursonner comme un idiot! dit la femme."
                            }
                        ]
                    },
                    {
                        "sense_id": "87565e8c-e2d4-38aa-b6fa-a76d53082bf5",
                        "entry_id": "2d8c6588-090f-3061-ac4c-33594782b414",
                        "glosses": [
                            "Fabriquer des oursons."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "11c675a8-49b1-49d4-8ee4-af5956f7545c",
                                "sense_id": "87565e8c-e2d4-38aa-b6fa-a76d53082bf5",
                                "text": "Il faut malgré tout garder le moral et quoi d'autre que d'oursonner !"
                            }
                        ]
                    }
