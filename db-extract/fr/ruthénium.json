                                "target_senses": [
                                    {
                                        "sense_id": "2e4421a2-5dcd-3cbf-8c7a-4809902003bb",
                                        "entry_id": "72888f81-a6de-3857-90e6-3041f28f51c5",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 44, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c7b025d-786d-4cac-a197-7650d6c63814",
                                                "sense_id": "2e4421a2-5dcd-3cbf-8c7a-4809902003bb",
                                                "text": "Ruthenium ist ein hartes, sprödes, grauweißes Metall."
                                            },
                                            {
                                                "example_id": "7866eed7-b060-43ac-9e1b-ce7a2428c470",
                                                "sense_id": "2e4421a2-5dcd-3cbf-8c7a-4809902003bb",
                                                "text": "„2017 legte sich wie aus dem Nichts ein Schleier von radioaktivem Ruthenium über Europa.“"
                                            },
                                            {
                                                "example_id": "c9b66ab3-c24b-4142-a81c-5f8a85545f0a",
                                                "sense_id": "2e4421a2-5dcd-3cbf-8c7a-4809902003bb",
                                                "text": "„Diese Gesteine enthalten Spuren des Metalls Ruthenium, das die anorganische Methanbildung auch bei niedrigen Temperaturen katalysiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
