                                    {
                                        "sense_id": "58aeb0ec-4e2f-3447-a69b-3d2c1aa33757",
                                        "entry_id": "a8c326f6-ed7b-3e76-b167-8d8e618837a4",
                                        "glosses": [
                                            "ścisłe trzymanie się litery przepisów w danym działaniu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277718fc-fa7d-4836-97f7-67c9c5909b9d",
                                                "sense_id": "58aeb0ec-4e2f-3447-a69b-3d2c1aa33757",
                                                "text": "Formalizm nie zbawi was od chaosu. Lepiej już pogodzić się z duchem czasu"
                                            },
                                            {
                                                "example_id": "4ce74a5e-95e3-4bb3-b482-d22f26e47011",
                                                "sense_id": "58aeb0ec-4e2f-3447-a69b-3d2c1aa33757",
                                                "text": "Pani Monroe wprowadziła większą ekskluzywność, formalizm i protokół do wystawnych przyjęć w Białym Domu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "2cfd90ac-189e-38c6-b6ab-e6837e1374ed",
                                        "entry_id": "a8c326f6-ed7b-3e76-b167-8d8e618837a4",
                                        "glosses": [
                                            "stanowisko filozoficzne stawiające na formę przy ocenie dzieła"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "224e4a97-571b-3aad-a9fd-1f9adfe0196e",
                                        "entry_id": "a8c326f6-ed7b-3e76-b167-8d8e618837a4",
                                        "glosses": [
                                            "nurt w filozofii matematycznej widzący matematykę jako system formalny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9647534-3d0f-44da-994d-c859f71cb521",
                                                "sense_id": "224e4a97-571b-3aad-a9fd-1f9adfe0196e",
                                                "text": "Dodać należy, że o ile intuicjonizm i formalizm pozostają wierne poglądom i ideom swych twórców, o tyle logicyzm uległ pewnym zmianom – występuje on dziś głównie w postaci tzw. logicyzmu pluralistycznego"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
