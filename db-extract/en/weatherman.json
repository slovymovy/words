                ],
                "senses": [
                    {
                        "sense_id": "27a1b2b8-0981-3a90-bd19-90b3cb9c15d6",
                        "entry_id": "6f22183a-d4b5-39d1-a596-ae4c1f9fb3b8",
                        "glosses": [
                            "A person, especially a male one, who reports the weather conditions or forecasts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43ac033-efc6-4f94-bc06-d098a6b18795",
                                "sense_id": "27a1b2b8-0981-3a90-bd19-90b3cb9c15d6",
                                "text": "“Cool and brisk in the morning, warming to the low seventies by afternoon,” Ruby said anticipating the weatherman's words."
                            },
                            {
                                "example_id": "6445c995-9339-427f-b2cf-40a052de2d98",
                                "sense_id": "27a1b2b8-0981-3a90-bd19-90b3cb9c15d6",
                                "text": "We were watching the weather that night. The weather man couldn't even fathom what was about to be the worst flooding that we had ever experienced in our area."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ca2f242-05db-464d-9a8d-28ae36087f96",
