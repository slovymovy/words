    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d22713e2-1a48-3174-b5bc-7b23efc828a8",
                    "sense_definition": "royaal van geld of middelen voorzien",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Volgens critici is de 'colataks' vooral bedoeld om de schatkist te <w>spekken</w>.",
                            "target_lang_translations": {
                                "en": "According to critics, the 'soda tax' is primarily intended to <w>fill</w> the treasury.",
                                "ru": "По мнению критиков, «налог на колу» предназначен в первую очередь для того, чтобы <w>набить</w> казну."
                            }
                        },
                        {
                            "text": "Met deze extra inkomsten kunnen we de clubkas flink <w>spekken</w>.",
                            "target_lang_translations": {
                                "en": "With this extra income, we can significantly <w>boost</w> the club's funds.",
                                "ru": "Благодаря этим дополнительным доходам мы можем значительно <w>пополнить</w> кассу клуба."
                            }
                        }
                    ],
                    "synonyms": [
                        "financieren",
                        "sponsoren"
                    ],
                    "antonyms": [
                        "plunderen",
                        "leegroven"
                    ],
                    "common_phrases": [
                        "de schatkist spekken",
                        "de clubkas spekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To generously provide with money or resources, especially to line or fill a treasury or coffer.",
                        "ru": "щедро снабжать деньгами или средствами"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fill",
                                "target_lang_sense_clarification": "to make full, as in filling a treasury or coffer"
                            },
                            {
                                "target_lang_word": "line",
                                "target_lang_sense_clarification": "to fill with money, as in lining one's pockets"
                            },
                            {
                                "target_lang_word": "feather",
                                "target_lang_sense_clarification": "to enrich, as in feathering one's nest"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "набивать",
                                "target_lang_sense_clarification": "кошелек, казну деньгами"
                            },
                            {
                                "target_lang_word": "пополнять",
                                "target_lang_sense_clarification": "финансовые запасы, казну"
                            },
                            {
                                "target_lang_word": "финансировать",
                                "target_lang_sense_clarification": "снабжать средствами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5726529-2caa-36a5-8c20-ab1807690f4f",
                    "sense_definition": "vlees larderen met reepjes spek",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kok besloot het magere wildvlees te <w>spekken</w> voor het braden.",
                            "target_lang_translations": {
                                "en": "The chef decided to <w>lard</w> the lean game meat before roasting.",
                                "ru": "Повар решил <w>нашпиговать</w> постную дичь перед запеканием."
                            }
                        },
                        {
                            "text": "Door het vlees te <w>spekken</w> blijft het tijdens de bereiding heerlijk mals.",
                            "target_lang_translations": {
                                "en": "By <w>larding</w> the meat, it remains wonderfully tender during cooking.",
                                "ru": "Благодаря <w>шпигованию</w> мясо остается очень нежным во время приготовления."
                            }
                        }
                    ],
                    "synonyms": [
                        "larderen"
                    ],
                    "common_phrases": [
                        "vlees spekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To lard meat with strips of bacon or fat before cooking.",
                        "ru": "шпиговать мясо полосками сала"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lard",
                                "target_lang_sense_clarification": "to insert strips of fat into meat before cooking"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шпиговать",
