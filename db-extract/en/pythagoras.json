                                            {
                                                "example_id": "89a858a3-f02e-44ce-8ff7-d707fb78f34e",
                                                "sense_id": "c6de01ab-9cda-335a-9a08-72f0ab2d1aec",
                                                "text": "Vrouwen werden geassocieerd met de aarde, het lichaam en het materiële. Mannen met de hemel, het bovenaardse en het etherische, waaronder Pythagoras en zijn volgelingen al snel ook getallen, wiskunde en abstract denken schaarden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3401a168-c339-47ce-b4d1-9746943012b2",
                        "source_entry_id": "40c9de98-383d-319a-9221-9b4bbe087f0b",
