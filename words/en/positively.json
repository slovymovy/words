{
    "word_family": [
        "positive",
        "positivity",
        "positiveness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "861bcff0-06f3-3dcf-b5fe-32e0c373b696",
                    "sense_definition": "In a way that shows agreement, optimism, or confidence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He approached the difficult interview <w>positively</w> and with a smile.",
                            "target_lang_translations": {
                                "ru": "Он подошел к трудному собеседованию <w>позитивно</w> и с улыбкой.",
                                "zh": "他带着微笑，<w>积极地</w>面对那场艰难的面试。",
                                "es": "Afrontó la difícil entrevista <w>positivamente</w> y con una sonrisa.",
                                "tr": "Zorlu mülakata <w>olumlu</w> bir yaklaşımla ve gülümseyerek girdi.",
                                "de": "Er ging das schwierige Vorstellungsgespräch <w>positiv</w> und mit einem Lächeln an."
                            }
                        },
                        {
                            "text": "The audience responded <w>positively</w> to the band's new song.",
                            "target_lang_translations": {
                                "ru": "Публика отреагировала на новую песню группы <w>положительно</w>.",
                                "zh": "观众对乐队的新歌反响<w>积极</w>。",
                                "es": "El público respondió <w>positivamente</w> a la nueva canción del grupo.",
                                "tr": "Dinleyiciler grubun yeni şarkısına <w>olumlu</w> tepki verdi.",
                                "de": "Das Publikum reagierte <w>positiv</w> auf das neue Lied der Band."
                            }
                        }
                    ],
                    "synonyms": [
                        "optimistically",
                        "favorably",
                        "constructively",
                        "encouragingly",
                        "confidently",
                        "well"
                    ],
                    "antonyms": [
                        "negatively",
                        "pessimistically"
                    ],
                    "common_phrases": [
                        "think positively",
                        "react positively",
                        "respond positively",
                        "act positively"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, выражающим согласие, оптимизм или уверенность.",
                        "zh": "以一种表现出赞同、乐观或自信的方式。",
                        "es": "De una manera que muestra acuerdo, optimismo o confianza.",
                        "tr": "Anlaşma, iyimserlik veya güven gösteren bir şekilde.",
                        "de": "Auf eine Weise, die Zustimmung, Optimismus oder Zuversicht zeigt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положительно",
                                "target_lang_sense_clarification": "одобрительно, благоприятно"
                            },
                            {
                                "target_lang_word": "позитивно",
                                "target_lang_sense_clarification": "с оптимизмом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "积极地",
                                "target_lang_sense_clarification": "以乐观或建设性的态度"
                            },
                            {
                                "target_lang_word": "肯定地",
                                "target_lang_sense_clarification": "表示赞同或支持"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "positivamente",
                                "target_lang_sense_clarification": "de forma optimista o favorable"
                            },
                            {
                                "target_lang_word": "de manera positiva",
                                "target_lang_sense_clarification": "con una actitud constructiva"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olumlu",
                                "target_lang_sense_clarification": "onaylayan veya yapıcı bir şekilde"
                            },
                            {
                                "target_lang_word": "pozitif",
                                "target_lang_sense_clarification": "iyimser veya yapıcı bir tavırla"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "positiv",
                                "target_lang_sense_clarification": "Zustimmung zum Ausdruck bringend oder optimistisch"
                            },
                            {
                                "target_lang_word": "wohlgesinnt",
                                "target_lang_sense_clarification": "eine freundliche Einstellung habend"
                            }
                        ]
