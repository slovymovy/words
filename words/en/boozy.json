{
    "word_family": [
        "booze",
        "boozer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4df9f0c9-2997-3d73-951a-04d69849292b",
                    "sense_definition": "Characterized by or involving the consumption of a large amount of alcohol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alcohol_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We all had terrible hangovers after a <w>boozy</w> weekend in town.",
                            "target_lang_translations": {
                                "fr": "Nous avions tous une terrible gueule de bois après un week-end <w>bien arrosé</w> en ville."
                            }
                        },
                        {
                            "text": "They celebrated their promotion with a long and <w>boozy</w> lunch on Friday.",
                            "target_lang_translations": {
                                "fr": "Ils ont fêté leur promotion avec un déjeuner long et <w>arrosé</w> vendredi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boozy lunch",
                        "boozy brunch",
                        "boozy weekend"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal tone"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Caractérisé par une grande consommation d'alcool, ou où l'alcool coule à flots."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "arrosé",
                                "target_lang_sense_clarification": "d'un événement, d'un repas"
                            },
                            {
                                "target_lang_word": "bien arrosé",
                                "target_lang_sense_clarification": "d'une soirée ou d'une fête"
                            },
                            {
                                "target_lang_word": "alcoolisé",
                                "target_lang_sense_clarification": "d'une occasion festive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a8f8909-693e-3cf0-aee6-772396d33684",
                    "sense_definition": "Affected by drinking too much alcohol; intoxicated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alcohol_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A crowd of <w>boozy</w> fans sang loudly as they left the stadium.",
                            "target_lang_translations": {
                                "fr": "Une foule de supporters <w>éméchés</w> chantait à tue-tête en quittant le stade."
                            }
                        },
                        {
                            "text": "He sounded slightly <w>boozy</w> when he called late in the evening.",
                            "target_lang_translations": {
                                "fr": "Il avait l'air légèrement <w>pompette</w> quand il a appelé tard dans la soirée."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal tone"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Sous l'effet de l'alcool ; éméché ou ivre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "éméché",
                                "target_lang_sense_clarification": "légèrement ivre"
                            },
                            {
                                "target_lang_word": "pompette",
                                "target_lang_sense_clarification": "gai, légèrement ivre"
                            },
                            {
                                "target_lang_word": "bourré",
                                "target_lang_sense_clarification": "très familier, ivre"
                            },
                            {
                                "target_lang_word": "ivre",
                                "target_lang_sense_clarification": "intoxiqué par l'alcool"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb1c5a4-720e-3b78-8a0a-ca86bdf27d36",
                    "sense_definition": "Containing, flavored with, or cooked with alcohol.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alcohol_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dessert, the hosts treated us to a helping of <w>boozy</w> apple pie.",
                            "target_lang_translations": {
                                "fr": "Au dessert, les hôtes nous ont régalés d'une part de tarte aux pommes <w>alcoolisée</w>."
                            }
                        },
                        {
                            "text": "Sweetened cream complements the rich and <w>boozy</w> chocolate sauce perfectly.",
                            "target_lang_translations": {
                                "fr": "La crème sucrée complète à merveille la sauce au chocolat riche et <w>bien alcoolisée</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "alcoholic"
                    ],
                    "common_phrases": [
                        "boozy dessert"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal tone"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui contient de l'alcool ou qui en a le goût."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "alcoolisé",
                                "target_lang_sense_clarification": "contenant de l'alcool"
                            },
                            {
                                "target_lang_word": "fort en alcool",
                                "target_lang_sense_clarification": "au goût d'alcool prononcé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71e1bb91-fa96-3b12-ad8b-9d9df6586dc8",
                    "sense_definition": "Habitually drinking a lot of alcohol; prone to drunkenness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alcohol_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was notorious around town as an unreliable and <w>boozy</w> character.",
                            "target_lang_translations": {
                                "fr": "Il était connu dans toute la ville comme un personnage peu fiable et <w>porté sur la boisson</w>."
                            }
                        },
                        {
                            "text": "Her uncle was a <w>boozy</w> old sailor with endless stories to tell.",
                            "target_lang_translations": {
                                "fr": "Son oncle était un vieux marin <w>buveur</w> avec d'innombrables histoires à raconter."
                            }
                        }
                    ],
                    "synonyms": [
                        "sottish"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal tone"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui a l'habitude de boire beaucoup d'alcool ; porté sur la boisson."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "buveur",
                                "target_lang_sense_clarification": "qui a un penchant pour l'alcool"
                            },
                            {
                                "target_lang_word": "ivrogne",
                                "target_lang_sense_clarification": "souvent employé comme nom ou attribut"
                            },
                            {
                                "target_lang_word": "porté sur la bouteille",
                                "target_lang_sense_clarification": "qui boit fréquemment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}