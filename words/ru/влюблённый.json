{
    "word_family": [
        "влюбить",
        "влюбиться",
        "влюбчивый",
        "влюблённость",
        "любить",
        "любовь"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "db3167de-3cbc-36a9-94c5-20466d625972",
                    "sense_definition": "Испытывающий чувство любовного влечения к кому-либо, влюбившийся в кого-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "любовное_влечение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он был тайно <w>влюблён</w> в свою одноклассницу на протяжении многих лет.",
                            "target_lang_translations": {
                                "en": "He was secretly <w>in love</w> with his classmate for many years."
                            }
                        },
                        {
                            "text": "Она выглядела невероятно счастливой, как по-настоящему <w>влюблённая</w> женщина.",
                            "target_lang_translations": {
                                "en": "She looked incredibly happy, like a woman truly <w>in love</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "любящий"
                    ],
                    "antonyms": [
                        "равнодушный",
                        "безразличный"
                    ],
                    "common_phrases": [
                        "влюблён по уши",
                        "безумно влюблённый"
                    ],
                    "target_lang_definitions": {
                        "en": "Feeling a sense of romantic attraction to someone, having fallen in love with someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in love",
                                "target_lang_sense_clarification": "feeling deep romantic affection for someone"
                            },
                            {
                                "target_lang_word": "enamored",
                                "target_lang_sense_clarification": "having a strong liking or love for someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bea7b7d-be56-39eb-a8b8-caeeec1397fb",
                    "sense_definition": "Выражающий чувство любовного влечения, восхищения, любви к кому-либо (о взгляде, голосе и т. д.).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "выражение_чувств",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он смотрел на неё долгим <w>влюблённым</w> взглядом, не замечая никого вокруг.",
                            "target_lang_translations": {
                                "en": "He looked at her with a long, <w>loving</w> gaze, noticing no one around."
                            }
                        },
                        {
                            "text": "Она говорила о нём с нежным, <w>влюблённым</w> голосом.",
                            "target_lang_translations": {
                                "en": "She spoke of him in a gentle, <w>loving</w> voice."
                            }
                        }
                    ],
                    "common_phrases": [
                        "влюблённый взгляд",
                        "влюблённые глаза"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing a feeling of romantic attraction, admiration, or love for someone (of a look, voice, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loving",
                                "target_lang_sense_clarification": "affectionate and showing love"
                            },
                            {
                                "target_lang_word": "amorous",
                                "target_lang_sense_clarification": "expressive of love or sexual desire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "040042ef-2fd4-3203-bbe6-58f9f8c5d202",
                    "sense_definition": "Испытывающий чувство восхищения, сильной увлечённости чем-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "увлеченность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш учитель — человек, страстно <w>влюблённый</w> в своё дело.",
                            "target_lang_translations": {
                                "en": "Our teacher is a person passionately <w>in love</w> with his work."
                            }
                        },
                        {
                            "text": "Они были <w>влюблены</w> в море и проводили на побережье всё свободное время.",
                            "target_lang_translations": {
                                "en": "They were <w>in love</w> with the sea and spent all their free time on the coast."
                            }
                        }
                    ],
                    "antonyms": [
                        "равнодушный",
                        "безразличный"
                    ],
                    "common_phrases": [
                        "влюблённый в работу",
                        "влюблённый в искусство"
                    ],
                    "target_lang_definitions": {
                        "en": "Feeling a sense of admiration or strong passion for something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in love",
                                "target_lang_sense_clarification": "very fond of or passionate about an activity or concept"
                            },
                            {
                                "target_lang_word": "enamored",
                                "target_lang_sense_clarification": "captivated or fascinated by something"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d80ea2b-0acc-3265-ac0d-753a17142407",
                    "sense_definition": "Человек, испытывающий любовное влечение к кому-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "люди",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодые <w>влюблённые</w> гуляли по парку до самого вечера.",
                            "target_lang_translations": {
                                "en": "The young <w>lovers</w> walked in the park until the very evening."
                            }
                        },
                        {
                            "text": "На скамейке сидели <w>влюблённые</w> и тихо разговаривали.",
                            "target_lang_translations": {
                                "en": "The <w>lovers</w> sat on the bench, talking quietly."
                            }
                        }
                    ],
                    "synonyms": [
                        "голубок"
                    ],
                    "common_phrases": [
                        "счастливые влюблённые"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is in love or experiencing romantic attraction to someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lovers",
                                "target_lang_sense_clarification": "people who are in love with each other"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}