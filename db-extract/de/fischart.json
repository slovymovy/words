                "senses": [
                    {
                        "sense_id": "851f3739-1611-34e6-ab7d-5177c3760f03",
                        "entry_id": "0e5026d8-8afe-3e8b-94c8-f95c261b4395",
                        "glosses": [
                            "von anderen Fischen nach bestimmten Merkmalen abgegrenzte Gruppe von Fischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab9c440-72e6-4f97-bb1e-7ac946104c26",
                                "sense_id": "851f3739-1611-34e6-ab7d-5177c3760f03",
                                "text": "„Die weltweit zunehmende Aquakultur kann zu einem Rückgang wild lebender Fischarten führen.“"
                            },
                            {
                                "example_id": "3f829b2b-0123-4601-85e6-8dfde9c013df",
                                "sense_id": "851f3739-1611-34e6-ab7d-5177c3760f03",
                                "text": "„Obwohl im Rhein wieder dutzende Fischarten schwimmen und sommers Kinder baden, bleibt doch ein Zwiespalt hängen an einem Ort wie Remagen.“"
                            },
                            {
                                "example_id": "58505bbe-e4b1-4d73-b31f-8cb1f0436514",
                                "sense_id": "851f3739-1611-34e6-ab7d-5177c3760f03",
                                "text": "„Wenn beide Fischarten vorhanden sind, ist der Spezialköder immer besser als der Neutralköder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
