                "senses": [
                    {
                        "sense_id": "a09edfb9-b0f8-3649-aa91-1c4511a12f00",
                        "entry_id": "04e243cb-11c0-35aa-b334-4f1289f7cc2a",
                        "glosses": [
                            "Zeitalter der militärischen und/oder zivilen Nutzung der Kernspaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f932a9-9d08-48da-83bd-e3293b7dcbb3",
                                "sense_id": "a09edfb9-b0f8-3649-aa91-1c4511a12f00",
                                "text": "„Und jetzt, mitten im Atomzeitalter, haben sich die Mathematisierungen im Gefolge des Computers, die den zweifelhaften Segen einer weiteren Vielfalt mit sich brachten, aus dem Geist logischen Weiterdenkens herauskristallisiert.“"
                            },
                            {
                                "example_id": "bd49a7b5-1dc3-4807-bb08-841274a47091",
                                "sense_id": "a09edfb9-b0f8-3649-aa91-1c4511a12f00",
                                "text": "„Das Atomzeitalter stand vor der Haustür.“"
                            },
                            {
                                "example_id": "146e333f-2c48-43f2-a6de-a182dbe94056",
                                "sense_id": "a09edfb9-b0f8-3649-aa91-1c4511a12f00",
                                "text": "„Und es brach das Atomzeitalter an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
