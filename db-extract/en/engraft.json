                    {
                        "translation_id": "d09f5147-c09f-487a-80c1-0479291937aa",
                        "source_entry_id": "169e3d0c-51c2-318b-b446-b0698736fbf4",
                        "source_sense_id": "0d8c9b33-72b8-3526-b668-a931ea59ec05",
                        "source_sense_description": "aufpfropfen, pfropfen, transplantieren",
                        "target_lang_word": "aufpfropfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufpfropfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a0e94f9-788f-327a-9537-d347b013bfca",
                                        "entry_id": "40561d97-c7b4-397d-bc52-edb5a21dcf67",
                                        "glosses": [
                                            "eine (edles/edleres) Reis mit einem neuen/alten pflanzlichen Untergrund/Ast/Trieb verbinden, damit es dort weiterwächst (und seine eigenen Früchte hervorbringt)"
                                        ],
                                        "tags": [
                                            "Gartenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f36b40-cc3c-4f92-802e-d29aae34d441",
                                                "sense_id": "3a0e94f9-788f-327a-9537-d347b013bfca",
                                                "text": "Wenn dieser Apfelbaum zwei Sorten Äpfel tragen soll, muss man eben die zweite Sorte dadurch ermöglichen, das man gesunde Zweige der neuen Sorte hier auf das bestehende Astwerk aufpfropft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35780ee5-32d0-35e4-982d-32dd0fd2fc62",
                                        "entry_id": "40561d97-c7b4-397d-bc52-edb5a21dcf67",
                                        "glosses": [
                                            "etwas Eigenes auf etwas Fremdes draufdrücken/drüberstülpen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f80140c-4fab-4ad4-af65-7736adca1e23",
                                                "sense_id": "35780ee5-32d0-35e4-982d-32dd0fd2fc62",
                                                "text": "Eine Veränderung lässt sich selten dadurch bewerkstelligen, dass man einer alten Gewohnheit oder Regel lediglich eine neue aufpfropft."
                                            },
                                            {
                                                "example_id": "4bf77e4f-41b5-4a5e-832a-19670350f567",
                                                "sense_id": "35780ee5-32d0-35e4-982d-32dd0fd2fc62",
                                                "text": "„Die einzige zivilisatorische Kraft, die jemals das ganze Land erreicht hat, war die katholische Kirche, und auch das wurde nur dadurch erreicht, dass schlaue Jesuiten ihre römischen Mysterien überlieferten Riten und Vorstellungen aufpfropften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1808774-38ea-4c3a-a881-0544166fdb65",
                        "source_entry_id": "169e3d0c-51c2-318b-b446-b0698736fbf4",
                        "source_sense_id": "0d8c9b33-72b8-3526-b668-a931ea59ec05",
