                "senses": [
                    {
                        "sense_id": "3bf2c363-d2c1-3157-9f51-5c8a5bc3f899",
                        "entry_id": "ada8843a-1c62-3228-9b0a-a2e192c9d993",
                        "glosses": [
                            "Gotteshaus zu Ehren Jesu als des Christus, das unregelmäßig für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0afed11e-23fa-47ed-bf06-ba38e3e486eb",
                                "sense_id": "3bf2c363-d2c1-3157-9f51-5c8a5bc3f899",
                                "text": "„Zwischen 1966 und 1970 erhielt dann die Christuskapelle in Gösmes ihr heutiges Aussehen.“"
                            },
                            {
                                "example_id": "b91d5f48-366e-485c-ae1c-89d6551420f0",
                                "sense_id": "3bf2c363-d2c1-3157-9f51-5c8a5bc3f899",
                                "text": "„Der Grundstein für die Soltendiecker Christuskapelle wurde am Michaelistag, dem 29.9.1972, gelegt.“"
                            },
                            {
                                "example_id": "93583840-aa1c-4d93-bb32-439bf78757f2",
                                "sense_id": "3bf2c363-d2c1-3157-9f51-5c8a5bc3f899",
                                "text": "„Die Christuskapelle auf dem Knüllköpfchen bei Schwarzenborn ist das geistliche Zentrum der Anglikanischen Kirche in Deutschland.“"
                            },
                            {
                                "example_id": "82a829d1-ef84-4404-951c-325e0148e907",
                                "sense_id": "3bf2c363-d2c1-3157-9f51-5c8a5bc3f899",
                                "text": "„Pater Markus ließ 1970 als Ersatz für die abgerissene Büster Kapelle im Keltergarten die Christuskapelle errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
