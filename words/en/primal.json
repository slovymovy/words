                    "frequency": "VeryLow",
                    "semantic_group_id": "therapy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began <w>primaling</w> on the floor as they recalled a traumatic memory.",
                            "target_lang_translations": {
                                "ru": "Пациент начал <w>проходить через первичную терапию</w> на полу, вспоминая травмирующее событие."
                            }
                        },
                        {
                            "text": "He spent the weekend <w>primalling</w> at a specialized retreat in the mountains.",
                            "target_lang_translations": {
                                "ru": "Он провел выходные, <w>занимаясь первичной терапией</w> в специализированном центре в горах."
