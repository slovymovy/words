                "senses": [
                    {
                        "sense_id": "dc8080f5-443b-3a27-a54d-6e78f1a45e17",
                        "entry_id": "57931c50-eb4e-3291-b6d0-2e143ed2095b",
                        "glosses": [
                            "закрытый не до конца, не совсем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "393649fc-1eec-467f-9d60-eec5a64cd1e7",
                                "sense_id": "dc8080f5-443b-3a27-a54d-6e78f1a45e17",
                                "text": "Полузакрытые, на тонкой подошве, обычно без шнурков и застёжек, с маленьким язычком на подъёме стопы — слиперы невероятно удобны, это их главная черта."
                            }
                        ]
                    }
                ],
