                                    },
                                    {
                                        "sense_id": "dedc3a85-7d93-3781-93eb-c20fd130447c",
                                        "entry_id": "1f285322-4c57-3af8-b982-ac6fc3c390e8",
                                        "glosses": [
                                            "A harsh critic; one who slates or denigrates something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc07e89a-a9a2-47b5-811b-cc4ec01d1140",
                                                "sense_id": "dedc3a85-7d93-3781-93eb-c20fd130447c",
                                                "text": "Plain speaking, now and then, is very necessary. The author will call the critic a “blackguard slater,\" of course, but he need not be a blackguard. Ferocity of language only hurts his effect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f72fb976-6761-49ce-9aa2-f995584d5366",
                        "source_entry_id": "e774f14b-dbac-3440-8f00-f2d4660f7374",
                        "source_sense_description": "celui qui fait les couvertures d'un bâtiment",
                        "target_lang_word": "roofer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roofer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20a29289-925e-3e21-9015-34bcc6819acc",
                                        "entry_id": "6f72fd6d-934f-3526-beb4-d84502070263",
                                        "glosses": [
                                            "A craftsman who lays, or repairs roofs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                        "entry_id": "6f72fd6d-934f-3526-beb4-d84502070263",
                                        "glosses": [
                                            "A daredevil who performs stunts on tops of skyscrapers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0ddadc-db57-4ddd-8efd-61b0b5ef4839",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "Ivan, Kirill and Vasilisa are “roofers,” a loose-knit group of insanely non-acrophobic daredevils who scam and sneak their way to the tops of Russia’s highest buildings."
                                            },
                                            {
                                                "example_id": "472c9a1f-3faf-48f0-83cd-9df0c7d8678e",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "This year, as part of his annual “Troublemaker Award,” the startup mentor and entrepreneur decided to spotlight a Ukrainian stunt-climber -- or, \"roofer\" -- who struck a blow for his home nation by sticking it to neighboring Russia."
                                            },
                                            {
                                                "example_id": "40353474-d31a-44e4-af22-1dfde3b03119",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "“There aren’t many places in Latin America for the roofer to get on so our main aim was to climb Christ the Redeemer,” he said."
                                            },
                                            {
                                                "example_id": "df5deebc-cbd8-4362-9f5b-f5f8bee04bf2",
                                                "sense_id": "502278e6-14da-3f74-94af-dfd2bba2cca9",
                                                "text": "Many people say that I don’t look like roofer, which is really good when I try to get into a building which is really good secured. I started roofing two years ago with some friends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
