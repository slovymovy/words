                                                "sense_id": "c2f9029b-0692-3dc5-9983-7d7924424464",
                                                "text": "Het is weer de drieëntwintig die het niet doet, kunnen we die niet simpel vervangen?"
                                            },
                                            {
                                                "example_id": "74202a9d-2db8-474d-b0d7-772e2e5b627d",
                                                "sense_id": "c2f9029b-0692-3dc5-9983-7d7924424464",
                                                "text": "Haar vierentwintigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de drieëntwintig eenmaal voorbij was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed8c46a-3583-3b27-a376-1a647b65d949",
                                        "entry_id": "62ec121b-adf5-36bc-b583-7b410e2b32b0",
                                        "glosses": [
                                            "groep van 23 eenheden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
