                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "be propelled by wind"
                            },
                            {
                                "target_lang_word": "be blown",
                                "target_lang_sense_clarification": "passive movement by wind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b7c7736-6c21-325f-898f-8d1c6defaee5",
                    "sense_definition": "heen en weer bewegen in de wind",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vlaggen op het plein <w>waaien</w> vrolijk in de wind.",
                            "target_lang_translations": {
                                "en": "The flags on the square <w>flutter</w> cheerfully in the wind."
                            }
                        },
                        {
                            "text": "Haar lange haren <w>waaiden</w> alle kanten op tijdens de fietstocht.",
                            "target_lang_translations": {
                                "en": "Her long hair <w>blew</w> in all directions during the bike ride."
                            }
