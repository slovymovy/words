        "fr-extract.jsonl": [
            {
                "entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                "word": "querelleur",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7b44d21-cecd-43b5-863e-a3320f554ca3",
                        "entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "querelleurs"
                    },
                    {
                        "form_id": "153f4262-3b13-4318-b022-753eddfaee33",
                        "entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "querelleuse"
                    },
                    {
                        "form_id": "dd2766b3-66e9-4ecf-88d1-c6c49b0687d5",
                        "entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "querelleuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                        "entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                        "glosses": [
                            "Qui aime chercher querelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd4194e-6d8d-4dc5-bb10-7bf899596bb3",
                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                "text": "Ces indigènes étaient tous Bochjesmen, gens laborieux, peu irritables, peu querelleurs, capables de supporter de grandes fatigues physiques."
                            },
                            {
                                "example_id": "c09c240a-42f9-4552-a1de-ddf313ea8f1a",
                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                "text": "Tout comme Cormon, je suis moi aussi sous le charme de ce jeune garçon, dans lequel je me reconnais par le comportement insolent et querelleur."
                            },
                            {
                                "example_id": "cd4eabb2-c48e-4bbd-98d5-5180f6913116",
                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                "text": "Je n’en doute pas, noble dame ; mais le peuple d’Angleterre est une race fière, querelleuse et toujours prête aux troubles intérieurs ; …."
                            },
                            {
                                "example_id": "daa4570c-f2d7-4baa-a321-ef2fe48cc53a",
                                "sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                                "text": "Ce siècle qui vient de finir est un siècle querelleur, belliqueux et assassin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91370fe9-4716-450e-942a-0889553bfe0a",
                        "source_entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                        "source_sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
                        "target_lang_word": "zanksüchtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zanksüchtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c30c105f-4824-3610-a8e9-c1bc35d3cee4",
                                        "entry_id": "fc31690e-eb73-33bc-8117-d15db8a72b28",
                                        "glosses": [
                                            "streitsüchtig, Streit suchend, Zank und Ärger verbreitend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd5bfc3c-7663-42ca-bb12-b3c28ebb1878",
                                                "sense_id": "c30c105f-4824-3610-a8e9-c1bc35d3cee4",
                                                "text": "Als besonders Beispiel gilt die Gattin des Sokrates, die Xanthippe, da sie gewöhnlich als sehr mürrisch und zänkisch geschildert und von ihr mehre ungünstige Anekdoten erzählt werden, sprichwörtlich eine böse, zanksüchtige Ehefrau."
                                            },
                                            {
                                                "example_id": "d06b9fc4-d30a-4862-8e0a-84f2407ffb9d",
                                                "sense_id": "c30c105f-4824-3610-a8e9-c1bc35d3cee4",
                                                "text": "„Das Ganze ist geschrieben mit der Herzenswärme einer klugen Patriotin, die in dem kühl rechnenden, aus politischen Erwägungen religiös toleranten Oranier das eigentlich Bedeutende und Große erkannt hat: daß er mit unerhörter Willensstärke und Zähigkeit sein ganzes Leben – zwischen zanksüchtigen Calvinisten, Lutheranern und Katholiken geschickt lavierend – der Sache des niederländischen Volkes opferte und, ehe er sein Werk vollenden konnte, durch Mörderhand sterben mußte.“"
                                            },
                                            {
                                                "example_id": "6479f3a0-5f33-4076-b92c-3b0982998177",
                                                "sense_id": "c30c105f-4824-3610-a8e9-c1bc35d3cee4",
                                                "text": "„Valentin, der ein deutscher Chaplin hätte werden können, wird auch in diesem Film zu einer Kinocharge mißbraucht, spielt einen zanksüchtigen Gärtner als skurrilen Sonderling.“"
                                            },
                                            {
                                                "example_id": "c4b310ec-9b35-4f8b-8fe0-8e73a4904039",
                                                "sense_id": "c30c105f-4824-3610-a8e9-c1bc35d3cee4",
                                                "text": "„Schließlich erzählt Majakowski davon, daß er als junger Mensch das war, was man zu der Zeit einen „Hooligan“ nannte, ein Nichtsnutz, faul und arbeitsscheu und zanksüchtig: »Von Lernen keine Rede. Es hagelt Vieren. Wurde nach Tertia nur deshalb versetzt, weil ich mit einem Stein ein Loch in den Kopf bekommen hatte (Keilerei am Rion).«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27fced27-14f2-456f-9b45-bd41dd6f4709",
                        "source_entry_id": "6ab577a8-4a4a-31c8-bef4-f3d203fcb11d",
                        "source_sense_id": "5e692be9-3c06-359f-8b31-aa72641554e6",
