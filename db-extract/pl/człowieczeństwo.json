                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56121117-601d-4520-9c61-292f0473f31a",
                                "sense_id": "eb278e26-6889-3bf5-bb12-c04905177c00",
                                "text": "W umiłowaniu maluczkich przejawiało się jego człowieczeństwo."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f6c8320a-69c5-3aa5-b88f-dd3f5a7e4267",
                        "entry_id": "6e4371be-b35c-34f1-8407-1f59b6d389a6",
                        "glosses": [
                            "rodzaj ludzki"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffd488e6-377d-4e5a-9fca-045b8934489d",
                        "source_entry_id": "6e4371be-b35c-34f1-8407-1f59b6d389a6",
                        "source_sense_id": "eb278e26-6889-3bf5-bb12-c04905177c00",
                        "target_lang_word": "humanity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca511cc-404e-373d-8960-8a0b2d3bee0e",
                                        "entry_id": "f8d4e27d-9df7-3d97-a70d-630d93576862",
                                        "glosses": [
                                            "Humankind; human beings as a group."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a89d32e7-c3b4-4b98-abcf-93a9ce1254b1",
                                                "sense_id": "1ca511cc-404e-373d-8960-8a0b2d3bee0e",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            },
                                            {
                                                "example_id": "f99198a1-ff5f-4bb3-8695-7a2188a9c00d",
                                                "sense_id": "1ca511cc-404e-373d-8960-8a0b2d3bee0e",
                                                "text": "At last the concourse is relatively clear of humanity and the task of clearing up can begin."
                                            },
                                            {
                                                "example_id": "405df05d-3e01-4f0e-b2f1-8be6c44253da",
                                                "sense_id": "1ca511cc-404e-373d-8960-8a0b2d3bee0e",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: […]; perhaps to moralise on the oneness or fragility of the planet, or to see humanity for the small and circumscribed thing that it is; […]."
                                            },
                                            {
                                                "example_id": "459a57bb-4c2e-451f-848a-f52062bc8181",
                                                "sense_id": "1ca511cc-404e-373d-8960-8a0b2d3bee0e",
                                                "text": "“The internet”, Eric Schmidt, former chairman of Google, famously observed, “is the first thing that humanity' has built that humanity doesn’t understand, the largest experiment in anarchy that we have ever had.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22040e28-4d98-3e98-855b-53fd64605f7c",
                                        "entry_id": "f8d4e27d-9df7-3d97-a70d-630d93576862",
                                        "glosses": [
                                            "The human condition or nature."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c574426e-8ed7-3807-9d10-b8e9a0035370",
                                        "entry_id": "f8d4e27d-9df7-3d97-a70d-630d93576862",
                                        "glosses": [
                                            "The quality of being benevolent; humane traits of character; humane qualities or aspects."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8dfb45f-72ff-40c6-a138-2790ae4d17e9",
                                                "sense_id": "c574426e-8ed7-3807-9d10-b8e9a0035370",
                                                "text": "Think of that; by that sweet girl that old man had a child: hold ye then there can be any utter, hopeless harm in Ahab? No, no, my lad; stricken, blasted, if he be, Ahab has his humanities!"
                                            },
                                            {
                                                "example_id": "91b1d018-eb83-4e66-ad66-ccb2e70c1595",
                                                "sense_id": "c574426e-8ed7-3807-9d10-b8e9a0035370",
                                                "text": "Killing Animals Humanely. Humanity requires that animals be killed in the quickest and least painful manner. The following circular has been sent by our American Humane Education Society very widely through the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "407f36d1-469b-3993-ad17-55cc5f9ba40c",
                                        "entry_id": "f8d4e27d-9df7-3d97-a70d-630d93576862",
                                        "glosses": [
                                            "Any academic subject belonging to the humanities."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0058789-9e20-4e47-b5e6-aeadd9683479",
                                                "sense_id": "407f36d1-469b-3993-ad17-55cc5f9ba40c",
                                                "text": "Philosophy is a humanity while psychology is a science."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2312b80-57ef-442b-b6b6-a57ee115530b",
                        "source_entry_id": "6e4371be-b35c-34f1-8407-1f59b6d389a6",
                        "source_sense_id": "eb278e26-6889-3bf5-bb12-c04905177c00",
                        "target_lang_word": "humanness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4da31fbf-022b-391c-bc6d-1af0898fecd5",
                                        "entry_id": "ad2aede2-e903-33ed-a5f1-992fc5f0f43f",
                                        "glosses": [
                                            "The condition or quality of being human."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8629da82-49ab-4bd0-b9f6-7ff823cd640d",
                                                "sense_id": "4da31fbf-022b-391c-bc6d-1af0898fecd5",
                                                "text": "Too often, children become an \"it\" in their homes and their humanness is devalued."
                                            },
                                            {
                                                "example_id": "77a994ff-74a5-43de-83c6-5c0ed14a17d3",
                                                "sense_id": "4da31fbf-022b-391c-bc6d-1af0898fecd5",
                                                "text": "Though he had no hard data, his intuition was that increasing humanness in a robot was positive only up to a certain point."
                                            },
                                            {
                                                "example_id": "8305e5a8-13e9-41ab-b717-1a7b486fddc7",
                                                "sense_id": "4da31fbf-022b-391c-bc6d-1af0898fecd5",
                                                "text": "These examples reveal that the shared personhood of hunters and prey was mutually comprehensible, such that hunters could see the animalness of themselves and the humanness of prey, and prey could see the humanness of themselves […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33650915-1c36-4f83-89ae-df5a51554d57",
                        "source_entry_id": "6e4371be-b35c-34f1-8407-1f59b6d389a6",
                        "source_sense_id": "eb278e26-6889-3bf5-bb12-c04905177c00",
                        "target_lang_word": "Menschlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52b90d5a-bc7d-3345-b337-2b708a208c25",
                                        "entry_id": "ebebf2ca-b2cc-3e65-9cfb-a5638e109629",
                                        "glosses": [
                                            "ohne Plural: menschliche Gesinnung, menschliche Art und Weise des Handelns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1804ba-9a4c-41e8-8678-dad1883f0cc5",
                                                "sense_id": "52b90d5a-bc7d-3345-b337-2b708a208c25",
                                                "text": "Es war ein Verbrechen gegen die Menschlichkeit."
                                            },
                                            {
                                                "example_id": "ae983f73-ff2e-47c8-97ec-c39c63c63348",
                                                "sense_id": "52b90d5a-bc7d-3345-b337-2b708a208c25",
                                                "text": "Zu helfen ist ein Gebot der Menschlichkeit."
                                            },
                                            {
                                                "example_id": "26719bdf-e999-4de9-93dd-6dd068e63ca2",
                                                "sense_id": "52b90d5a-bc7d-3345-b337-2b708a208c25",
                                                "text": "„Verbrechen gegen die Menschlichkeit und organisiertem Massenmord wie in Auschwitz und anderen Konzentrationslagern sei damit nicht beizukommen.“"
                                            },
                                            {
                                                "example_id": "df2e0d2c-f99c-4e25-8509-d29cd500926f",
                                                "sense_id": "52b90d5a-bc7d-3345-b337-2b708a208c25",
                                                "text": "„Bewegend versteht es Remarque, in unzähligen Szenen auf dieses Grundelement der Menschlichkeit hinzuweisen.“"
                                            },
                                            {
                                                "example_id": "2bfd6aac-6b79-44a0-8269-ceff7b3da644",
                                                "sense_id": "52b90d5a-bc7d-3345-b337-2b708a208c25",
                                                "text": "„Das aber ist kein Lob. Ganz im Gegenteil – eine solche Verkopftheit trennt uns von unserer geerdeten Menschlichkeit, die in unserer Fähigkeit begründet ist, Körper, sowohl Geist als auch Materie zu sein.“"
                                            },
                                            {
                                                "example_id": "7d6339ae-c621-4718-b504-5c76e6fa50fe",
                                                "sense_id": "52b90d5a-bc7d-3345-b337-2b708a208c25",
                                                "text": "„Andere Passagen zeugen von Kästners Empathie und Menschlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bcfe0e18-12a8-349b-9484-6d56f53dc42f",
                                        "entry_id": "ebebf2ca-b2cc-3e65-9cfb-a5638e109629",
                                        "glosses": [
                                            "menschliche Schwäche"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecccdf06-a229-4b01-b2b4-db5ce3de2712",
                                                "sense_id": "bcfe0e18-12a8-349b-9484-6d56f53dc42f",
                                                "text": "Seine kleinen Menschlichkeiten konnte man ihm leicht verzeihen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
