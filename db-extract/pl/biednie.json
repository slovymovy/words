                                                "sense_id": "dff24d7f-bde6-3e81-952b-3a0d9d6f102d",
                                                "text": "Schafhirten führen ein ärmliches Leben."
                                            },
                                            {
                                                "example_id": "8ebca0a1-56b5-476f-87b3-4bfb23710436",
                                                "sense_id": "dff24d7f-bde6-3e81-952b-3a0d9d6f102d",
                                                "text": "Sie leben in ärmlichen Verhältnissen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1334cfdb-9b0e-3297-bfab-67ff878ff8b0",
                                        "entry_id": "e59fda31-6b78-3ee1-aaf5-78672d757012",
                                        "glosses": [
                                            "mangelhaft, unzureichend, gering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ceda4b0-809f-4603-bcff-b0a94ce7a7a2",
                                                "sense_id": "1334cfdb-9b0e-3297-bfab-67ff878ff8b0",
                                                "text": "Die Qualität dieses Fotos ist recht ärmlich."
                                            },
                                            {
                                                "example_id": "024ac3c7-4777-4f9b-8395-165dc3424524",
                                                "sense_id": "1334cfdb-9b0e-3297-bfab-67ff878ff8b0",
                                                "text": "Es gab nur eine ärmliche Beteiligung an der Diskussion."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
