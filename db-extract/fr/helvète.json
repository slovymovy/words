                                "target_senses": [
                                    {
                                        "sense_id": "198f12d5-b99e-303b-bf3d-7b533f3cc7a5",
                                        "entry_id": "6ef83a65-1c5e-3632-b8ec-9c4ac7c6f7c9",
                                        "glosses": [
                                            "Angehörige der gleichnamigen Bevölkerungsgruppe der Kelten, die anfangs in Südwestdeutschland ansässig war und später im Bereich der heutigen Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cdc8d5f-fa8d-4691-9318-bb1a2f09dc6e",
                                                "sense_id": "198f12d5-b99e-303b-bf3d-7b533f3cc7a5",
                                                "text": "Die Helvetier und Helvetierinnen waren in das heutige Gebiet der Schweiz eingewandert."
