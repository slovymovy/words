                        "entry_id": "66f608bc-2d43-339c-a6dd-e2e2e7728753",
                        "glosses": [
                            "Qui accroît la part du bénéfice par actionnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09c4e860-ce5a-43c5-82e2-3d0b80e5ad39",
                                "sense_id": "3a856cc9-3517-306e-a7f8-48fdca207637",
                                "text": "Schneider […] attend de fortes synergies d'Areva Distribution et estime que l’acquisition serait relutive pour son bénéfice net par action 'dès la première année'."
                            }
                        ]
                    },
                    {
                        "sense_id": "09f48915-bcd0-3be8-83a8-eb02df64a552",
                        "entry_id": "66f608bc-2d43-339c-a6dd-e2e2e7728753",
                        "glosses": [
                            "Se dit aussi d'une opération financière qui occasionne un gain immédiat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5113f7a-3675-4b5f-aeed-e38a20579069",
                                "sense_id": "09f48915-bcd0-3be8-83a8-eb02df64a552",
                                "text": "L'effet relutif s'obtient en diminuant le capital, par achat par la société de ses propres actions, le bénefice restant égal par ailleurs."
                            }
                        ]
                    }
                ],
