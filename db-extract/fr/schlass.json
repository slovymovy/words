                                                "sense_id": "ac496760-dc9e-3b6e-9d03-90c6aee38f9a",
                                                "text": "The old home had plastered walls rather than drywall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9836e509-856c-345d-a2bf-e4acb7087444",
                                        "entry_id": "9b230d52-7426-3609-b6b1-3c53daa61cdb",
                                        "glosses": [
                                            "Drunk, intoxicated."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68e42a0b-ad4e-4c23-aade-9e5bf12d35ec",
                                                "sense_id": "9836e509-856c-345d-a2bf-e4acb7087444",
                                                "text": "The only way he could deal with the grief following his wife's death was to get so plastered that he passed out."
                                            },
                                            {
                                                "example_id": "5130b200-0093-4380-88c7-bef8d6cabf72",
                                                "sense_id": "9836e509-856c-345d-a2bf-e4acb7087444",
                                                "text": "Every Monday morning my boss would come in plastered, with a squash about 50 pounds in size."
                                            }
