                        "source_sense_id": "9696d8bf-9f2c-3078-9e1d-88a6a03665db",
                        "target_lang_word": "rötlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rötlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37e9d612-ac5b-36b9-900e-e00e671cceba",
                                        "entry_id": "dce622e8-680d-3438-880e-7bcdcd5b6645",
                                        "glosses": [
                                            "ins Rote spielend, leicht rot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1cc247f-797d-4741-9441-719c4a028ace",
                                                "sense_id": "37e9d612-ac5b-36b9-900e-e00e671cceba",
                                                "text": "„Er war ein ungefähr vierzigjähriger Mann von mittlerer Größe und Figur, nur die rötliche Gesichtsfarbe verriet den ausgeprägten Sanguiniker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b5c2489-54b0-488b-ba77-2b9d22f8ba46",
                        "source_entry_id": "d6bbc687-c685-3976-88ae-1d42c6c72964",
                        "source_sense_id": "9696d8bf-9f2c-3078-9e1d-88a6a03665db",
                        "target_lang_word": "reddish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reddish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2fed7ec-cd0d-3dce-adcc-45c408707a25",
                                        "entry_id": "858822f1-54e2-3609-97de-efbe2bc5c026",
                                        "glosses": [
                                            "Somewhat red."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f0d4e0b-39a4-4f8e-8fd4-57175f20e0b3",
                                                "sense_id": "d2fed7ec-cd0d-3dce-adcc-45c408707a25",
                                                "text": "\"Chocolate and cream,\" the standard colours of G.W.R. rolling stock for 21 years, are now being replaced by an all-over utility coating of reddish-brown. This is the third time that a uniform brown has been adopted as the standard livery of G.W.R. carriages."
                                            },
                                            {
                                                "example_id": "d5e46ef1-93d0-4e0a-916c-d13d6ae5f1ed",
                                                "sense_id": "d2fed7ec-cd0d-3dce-adcc-45c408707a25",
                                                "text": "Although the track is ballasted, it does not prevent clouds of reddish dust from the laterite soil blowing about when the train is in motion; after a journey with the windows open a bath is a necessity!"
                                            },
                                            {
                                                "example_id": "53d040a6-3146-409f-b499-be6f8199c952",
                                                "sense_id": "d2fed7ec-cd0d-3dce-adcc-45c408707a25",
                                                "text": "Most of the older buildings are of reddish-brown ironstone with mossy-tiled roofs, and almost all have stone-embanked gardens, richly planted and expertly maintained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aec3b634-c3f8-470d-8270-f2c3696260f5",
                        "source_entry_id": "d6bbc687-c685-3976-88ae-1d42c6c72964",
                        "source_sense_id": "9696d8bf-9f2c-3078-9e1d-88a6a03665db",
                        "target_lang_word": "rougeâtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rougeâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1497df9-571a-339d-b2dd-228d5a836fd5",
                                        "entry_id": "1dbf938d-be0c-33b2-a629-b81bb0334c1c",
                                        "glosses": [
                                            "Qui tire sur le rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ac5df2-9eda-4239-ac9e-d09c9de61320",
                                                "sense_id": "c1497df9-571a-339d-b2dd-228d5a836fd5",
                                                "text": "Le front pointu, mal caché par des cheveux plats, rares, et qui tombaient comme des filaments de verre soufflé, couronnait par des rugosités rougeâtres une face grimaude."
                                            },
                                            {
                                                "example_id": "aee69c4a-57d5-4efd-8aa6-94bc5cb982b4",
                                                "sense_id": "c1497df9-571a-339d-b2dd-228d5a836fd5",
                                                "text": "La vigogne a une toison formée de poils laineux très fins et d’une grande douceur. La couleur est brun rougeâtre ou brun fauve."
                                            },
                                            {
                                                "example_id": "bcf8cb15-fa1f-43f8-a8d0-294cab396754",
                                                "sense_id": "c1497df9-571a-339d-b2dd-228d5a836fd5",
                                                "text": "Il se gratte le front qu’un prurit tenace ne cesse de taquiner, et où fleurissent des taches rougeâtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45976a07-f565-4088-a4fb-06a197fb8a82",
                        "source_entry_id": "d6bbc687-c685-3976-88ae-1d42c6c72964",
                        "source_sense_id": "9696d8bf-9f2c-3078-9e1d-88a6a03665db",
                        "target_lang_word": "rojizo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rojizo",
