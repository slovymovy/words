                "senses": [
                    {
                        "sense_id": "5e2154dc-8a69-3780-8de8-fd5e448bc0a0",
                        "entry_id": "82bcbed9-5259-3880-9f65-12f2b8f542b2",
                        "glosses": [
                            "садиться, занимая место, располагаясь где-либо (обычно удобно или надолго)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72606ef3-8224-4a12-8175-b8ec0e5be3b2",
                                "sense_id": "5e2154dc-8a69-3780-8de8-fd5e448bc0a0",
                                "text": "Приходил на обед, усаживался с газетой на диване."
                            },
                            {
                                "example_id": "ca7b2ee0-5433-42f5-ac50-8ba02c0c85be",
                                "sense_id": "5e2154dc-8a69-3780-8de8-fd5e448bc0a0",
                                "text": "Усаживаемся в углу ждать рассвета, который по прогнозам должен наступить к 5 утра."
                            }
                        ]
                    },
                    {
                        "sense_id": "946ce65d-9d51-34ae-a261-ecef2aa205bd",
                        "entry_id": "82bcbed9-5259-3880-9f65-12f2b8f542b2",
                        "glosses": [
                            "заходя в транспортное средство, занимать место для поездки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2264d3d4-de70-4c5a-a420-15a2372c252f",
                                "sense_id": "946ce65d-9d51-34ae-a261-ecef2aa205bd",
                                "text": "Я всегда усаживаюсь в машину и мне даже в голову не приходит подумать о моём спутнике."
                            }
                        ]
                    },
