                "senses": [
                    {
                        "sense_id": "59deeab1-9282-3c57-9c1f-eeea57f64647",
                        "entry_id": "420f9819-5d1a-3617-85f0-b03922cb16a6",
                        "glosses": [
                            "Sortir du placard."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3295a9a0-81ef-4203-a2a6-5d647112e7f9",
                                "sense_id": "59deeab1-9282-3c57-9c1f-eeea57f64647",
                                "text": "Déplacardiser l’histoire du colonialisme et de la francophonie comme condition de la cohabitation de demain."
                            },
                            {
                                "example_id": "98a3de97-65b7-4dd3-b1cd-fb0ce8f6200d",
                                "sense_id": "59deeab1-9282-3c57-9c1f-eeea57f64647",
                                "text": "C’est ainsi que l’on essaiera de faire taire les imprudents qui, à propos de l’Algérie et du reste, continueront de croire qu’il faut, coûte que coûte, rendre à la France sa mémoire, chercher dans ses trous noirs, déplacardiser la vérité."
                            }
                        ]
                    }
                ],
