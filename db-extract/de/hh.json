                            {
                                "example_id": "746892f4-9abb-47e7-982b-0cf06b5c5464",
                                "sense_id": "cef9df3a-8061-334a-a0ff-a011517b819b",
                                "text": "„39 öffentliche Gebäude werden demnächst an eine französische Sparkassengruppe verkauft, 815 Millionen Euro springen für HH heraus.“"
                            },
                            {
                                "example_id": "c8e59a27-046b-42e5-af76-8a52b5082ffc",
                                "sense_id": "cef9df3a-8061-334a-a0ff-a011517b819b",
                                "text": "„Beim Marathonbummel vom Prenzlauer Berg zum Kurfürstendamm entdeckt man mehr Weinbars als Wurstbuden, und sowieso stammt das sich in den Straßen tummelnde Volk überwiegend aus HH und Ffm.“"
                            },
                            {
                                "example_id": "f712d3da-9efc-4090-83b7-1ec2350100dd",
                                "sense_id": "cef9df3a-8061-334a-a0ff-a011517b819b",
                                "text": "„Wie ist die Entwicklung der Zahl der Arbeitslosen in HH seit 2005?“"
                            },
                            {
                                "example_id": "f5e8b530-6ea6-437a-abe1-6977aac38dd2",
                                "sense_id": "cef9df3a-8061-334a-a0ff-a011517b819b",
                                "text": "„Kennst du schon den FDP-Wahlwerbespot für die Bürgerschaftswahlen in HH?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
