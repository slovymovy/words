                "senses": [
                    {
                        "sense_id": "723aee6b-ff60-3a7a-bfff-5652a451810b",
                        "entry_id": "2670e669-81cf-392d-9dac-5827b132fb6e",
                        "glosses": [
                            "Maçonnerie de briques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3d65a5-adfd-447d-8133-29452f4728d0",
                                "sense_id": "723aee6b-ff60-3a7a-bfff-5652a451810b",
                                "text": "Construire en briquetage."
                            },
                            {
                                "example_id": "f8f3ac6d-edf3-4dcb-accd-e9e0c76175e6",
                                "sense_id": "723aee6b-ff60-3a7a-bfff-5652a451810b",
                                "text": "Quasiment neuve, la bâtisse en briquetage rouge aux balcons blancs, qui aurait pu servir de décor à \"Sissi impératrice fait le Québec\", défigurait le paysage sur cinq étages et trois cents pieds de long."
                            },
                            {
                                "example_id": "35669569-529e-4161-aab7-0c2ba5d25579",
                                "sense_id": "723aee6b-ff60-3a7a-bfff-5652a451810b",
                                "text": "Les moules d’argile cuite évaporant la saumure sont cassés lors du démoulage et forment des tessons appelés briquetages."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f1ac435-7da2-39c9-bfa3-8cb33ae36ae1",
                        "entry_id": "2670e669-81cf-392d-9dac-5827b132fb6e",
                        "glosses": [
                            "Enduit sur lequel on trace des joints et des refends pour donner à une construction l’apparence de la brique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eced6436-49f4-454e-9a4b-2fef60789e1f",
                                "sense_id": "2f1ac435-7da2-39c9-bfa3-8cb33ae36ae1",
                                "text": "Revêtir de briquetage un mur, une façade."
                            },
                            {
                                "example_id": "1f34641e-1f73-440f-855d-49b7e457625c",
                                "sense_id": "2f1ac435-7da2-39c9-bfa3-8cb33ae36ae1",
                                "text": "Tout le devant de la maison n’est que de briquetage."
                            }
                        ]
                    }
                ],
