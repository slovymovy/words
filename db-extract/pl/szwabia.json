                                        "entry_id": "08ba38fb-d0f5-3f5a-aaaa-6f098df118eb",
                                        "glosses": [
                                            "Région historique d’Allemagne, partagée entre le Bade-Wurtemberg et la Bavière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b863151-f190-42db-8a38-1565e3ca4dbf",
                                                "sense_id": "fecd8d8b-2ff8-341d-8adc-f89ce7901f56",
                                                "text": "Le duc de Marlborough était prince de Mindelheim en Souabe, de même que le duc de Wellington était prince de Waterloo en Belgique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e9a17a-5601-38c9-8982-caedfce807be",
                                        "entry_id": "08ba38fb-d0f5-3f5a-aaaa-6f098df118eb",
                                        "glosses": [
                                            "District d’Allemagne, situé dans le sud-ouest du Land de Bavière. Son chef-lieu est Augsbourg."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
