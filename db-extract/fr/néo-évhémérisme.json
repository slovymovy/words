                    {
                        "sense_id": "f32ff0a7-955b-380e-ade2-0758d60b76f7",
                        "entry_id": "62ea9333-ccd6-3995-952b-58abef3d62c7",
                        "glosses": [
                            "Relecture évhémériste renouvelée des mythes anciens qui considère les dieux comme des personnages historiques (rois, chefs, héros) et explique les récits mythologiques par des faits humains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f8a8d4a-2f27-406a-bf2a-3baec6c893aa",
                                "sense_id": "f32ff0a7-955b-380e-ade2-0758d60b76f7",
                                "text": "Le néo-évhémérisme a produit des peintures de manuscrits qui montrent Zeus costumé en basileus et les statues des Olympiens juchées sur des colonnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f958252b-260c-3c1c-8224-02aa6633ba49",
                        "entry_id": "62ea9333-ccd6-3995-952b-58abef3d62c7",
                        "glosses": [
                            "Théorie spéculative reprenant le concept de l’évhémérisme, mais en affirmant en plus que les dieux antiques étaient des aliens humanoïdes."
                        ],
                        "tags": [
                            "broadly",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a7bcc4f3-ea59-4982-83ea-3ffd1c36fff8",
                                "sense_id": "f958252b-260c-3c1c-8224-02aa6633ba49",
                                "text": "Ce sont des mythes, ils ont été inventés de toute pièce et la théorie des anciens astronautes c’est du néo-évhémérisme, c’est à dire qu’ils prennent des mythes et des fictions et ils tiennent le même raisonnement : … là ce sont les extraterrestres qui expliquent tout.."
                            }
                        ]
                    }
