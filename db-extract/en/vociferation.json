                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "682cb837-c36e-42cb-9fc6-4ed60938720e",
                        "source_entry_id": "54fca156-b42c-3421-b44c-5b993acbc2a5",
                        "source_sense_id": "fab2e63b-fe7d-335d-887d-89197c596c95",
                        "source_sense_description": "act of exclaiming; violent outcry",
                        "target_lang_word": "крик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3df99d-b5bc-36e0-a3c2-bf0d1e6f3088",
                                        "entry_id": "8a2e7085-6a2e-3d40-82d8-91d638ee4389",
                                        "glosses": [
                                            "напряжённый, как правило, сильный и громкий звук голоса; громкие звуки, издаваемые животными и птицами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6bea280-c0d7-4bd0-b609-4ce547322d5a",
                                                "sense_id": "1e3df99d-b5bc-36e0-a3c2-bf0d1e6f3088",
                                                "text": "[Переводчик] говорил обыкновенным голосом, а иногда вдруг возвышал его на каком-нибудь слове до крика."
                                            },
                                            {
                                                "example_id": "da040857-6cc1-498d-bc8f-34b695105739",
                                                "sense_id": "1e3df99d-b5bc-36e0-a3c2-bf0d1e6f3088",
                                                "text": "Послышались крики."
                                            },
                                            {
                                                "example_id": "fd83a4b3-1f56-41b8-803d-1be4fb728e4a",
                                                "sense_id": "1e3df99d-b5bc-36e0-a3c2-bf0d1e6f3088",
                                                "text": "Издать крик."
                                            },
                                            {
                                                "example_id": "9509eb58-ef02-49bf-8503-b788ea1bc538",
                                                "sense_id": "1e3df99d-b5bc-36e0-a3c2-bf0d1e6f3088",
                                                "text": "В окно ветер нёс крики грачей."
                                            },
                                            {
                                                "example_id": "b7643851-f4cc-42fb-a12e-94ba0b84dafb",
                                                "sense_id": "1e3df99d-b5bc-36e0-a3c2-bf0d1e6f3088",
                                                "text": "Иногда дикие гуси .. садятся на воду и кричат. Тревожный их крик далеко разносится по берегу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d8c1eb5-6f2c-3c53-bf01-33632f1f1b45",
                                        "entry_id": "8a2e7085-6a2e-3d40-82d8-91d638ee4389",
                                        "glosses": [
                                            "шумное выражение эмоций, мыслей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b165a50b-811b-4630-bddc-666f3ba73dcc",
                                                "sense_id": "3d8c1eb5-6f2c-3c53-bf01-33632f1f1b45",
                                                "text": "Криком здесь ничего не докажешь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1f51806-bccb-3c38-a1a6-b1ecda1578a3",
                                        "entry_id": "8a2e7085-6a2e-3d40-82d8-91d638ee4389",
                                        "glosses": [
                                            "перен. яркое проявление, выражение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "675bd3a1-e832-4b4f-b0e6-63c912d0bf2f",
                                                "sense_id": "d1f51806-bccb-3c38-a1a6-b1ecda1578a3",
                                                "text": "Последний крик моды."
                                            },
                                            {
                                                "example_id": "e08d6b2e-c799-4507-89d4-308064ad9b0f",
                                                "sense_id": "d1f51806-bccb-3c38-a1a6-b1ecda1578a3",
                                                "text": "Не называйте слабостью крик вашего сердца, которое не хочет отдаться без любви."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98ce303a-25a0-3a17-ac5f-0b6756c8f4d5",
                                        "entry_id": "8a2e7085-6a2e-3d40-82d8-91d638ee4389",
                                        "glosses": [
                                            "упрёки, нападки в повышенном тоне; брань, ругань, ссора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabd2647-0f86-4903-bc3a-64c275dc27d8",
                                                "sense_id": "98ce303a-25a0-3a17-ac5f-0b6756c8f4d5",
                                                "text": "Между достойными супругами начался крик, спор."
                                            },
                                            {
                                                "example_id": "042b794f-9132-46f2-9614-e1ae249801bc",
                                                "sense_id": "98ce303a-25a0-3a17-ac5f-0b6756c8f4d5",
                                                "text": "— Когда у него [отца] чего-нибудь нет — это крик на весь дом."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "крик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98b7b593-677f-3911-a904-9c34f93949fb",
                                        "entry_id": "10018ee0-d472-3202-8429-6000a1701e67",
                                        "glosses": [
                                            "геогр. периодически пересыхающая река или временный ручей; водоток в Австралии"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
