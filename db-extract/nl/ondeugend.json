                                        "examples": [
                                            {
                                                "example_id": "db289853-bf4f-40c5-b052-d9f39cfcd498",
                                                "sense_id": "e3d12d04-6b94-3a1f-b561-f485a653ed42",
                                                "text": "I bought some naughty lingerie for my honeymoon."
                                            },
                                            {
                                                "example_id": "a0c45221-e431-41ad-b516-a7f36c3f845e",
                                                "sense_id": "e3d12d04-6b94-3a1f-b561-f485a653ed42",
                                                "text": "If I see you send another naughty email to your friends, you will be forbidden from using the computer!"
