                                            {
                                                "example_id": "81a6381c-be5b-4bf3-80ce-dfcba33062e4",
                                                "sense_id": "db569187-4448-395b-b4ae-48c58b3191a7",
                                                "text": "Mein Leipzig lob' ich mir! Es ist ein klein Paris und bildet seine Leute."
                                            },
                                            {
                                                "example_id": "83196089-996d-4b40-93d7-c6411de6904c",
                                                "sense_id": "db569187-4448-395b-b4ae-48c58b3191a7",
                                                "text": "Ich komme nach Leipzig, an einen Ort, wo man die ganze Welt im kleinen sehen kann."
                                            },
                                            {
                                                "example_id": "41d6f7ea-fd66-44a3-963f-c4b77674af72",
                                                "sense_id": "db569187-4448-395b-b4ae-48c58b3191a7",
                                                "text": "„Aber auch und vor allem Leipzig gilt als traditionelles Zentrum der Onomastik, wie Fachwissenschaftler die Namenkunde nennen.“"
                                            },
                                            {
                                                "example_id": "2d059928-98d7-4dc8-96fc-2c0a164651fc",
                                                "sense_id": "db569187-4448-395b-b4ae-48c58b3191a7",
                                                "text": "„Er wurde 1893 als Sohn eines Karrierejuristen in Greifswald geboren, wuchs in Berlin, später in Leipzig auf und war ein schwieriges, unglückliches Kind, vom Pech verfolgt, von Unfällen und Krankheiten geplagt, eigenbrötlerisch, aufbrausend und arrogant.“"
                                            },
                                            {
                                                "example_id": "67a7b0b0-8df1-4176-85ab-f62c14dcf07b",
                                                "sense_id": "db569187-4448-395b-b4ae-48c58b3191a7",
                                                "text": "Ich bin in Leipzig geboren."
                                            },
                                            {
                                                "example_id": "3a86c394-6ad2-43f3-87f3-bfa35c7bbd58",
                                                "sense_id": "db569187-4448-395b-b4ae-48c58b3191a7",
                                                "text": "Ich habe in Leipzig meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "f0d6720b-5401-49db-a53f-acb88e696fbb",
                                                "sense_id": "db569187-4448-395b-b4ae-48c58b3191a7",
                                                "text": "Nach Leipzig führen viele Wege."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
