                        "glosses": [
                            "Casserolade ; concert de casseroles."
                        ],
                        "tags": [
                            "Hispanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "13de0805-1ccb-4ade-8825-1b4ad18f4615",
                                "sense_id": "44f255a5-e807-3025-8726-c3e79b26ae30",
                                "text": "« Moi je n’achète pas de dollars, mais on doit avoir la liberté de faire ce que l’on veut avec son argent », dit à l’AFP Augusto, tout en tapant sur son tambour lors d’un « cacerolazo » (« Coup de casserole ») dans l’élégante avenue Santa Fe, dans le centre de la capitale."
                            },
                            {
                                "example_id": "a657edbc-682d-42b3-95fe-32faaa83ba06",
                                "sense_id": "44f255a5-e807-3025-8726-c3e79b26ae30",
                                "text": "Dans le quartier de Caballito, les habitants et entrepreneurs voulaient organiser un cacerolazo."
                            },
                            {
                                "example_id": "f8e7a669-1cfe-4007-af8e-6b876c42dc8f",
                                "sense_id": "44f255a5-e807-3025-8726-c3e79b26ae30",
                                "text": "Le versant civil du mécontentement s’est exprimé à son tour le 10 mars 1992 par un « cacerolazo » – bruit de casseroles."
                            }
                        ]
                    }
                ],
