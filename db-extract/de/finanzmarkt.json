                "senses": [
                    {
                        "sense_id": "765016ba-6b87-3b7e-9474-51c72934ea0f",
                        "entry_id": "1cfe7691-1dac-3251-8ea3-9722cacabcc7",
                        "glosses": [
                            "Gesamtheit der Märkte, bei denen Finanzmittel gehandelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b60510-205a-4fe6-9c86-b9c4a248fa48",
                                "sense_id": "765016ba-6b87-3b7e-9474-51c72934ea0f",
                                "text": "„Es ist das erste Mal in der Geschichte der USA, dass die Regierung in Washington damit leben muss, an den Finanzmärkten nicht mehr allerhöchstes Ansehen zu genießen.“"
                            },
                            {
                                "example_id": "c0498222-0831-4dd0-907e-bfd82d668755",
                                "sense_id": "765016ba-6b87-3b7e-9474-51c72934ea0f",
                                "text": "„Dabei habe ich mich doch nicht auf die dubiosen Gefühle von Herrn Zimmermann, sondern auf seine präzisen Modelle verlassen, von denen er behauptete, sie könnten die Entwicklungen am Finanzmarkt eindeutig vorausberechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
