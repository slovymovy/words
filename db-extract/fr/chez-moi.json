            {
                "entry_id": "770027e1-c8e8-3623-b718-63a8dcc01e59",
                "word": "chez-moi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5eba80fd-db86-3354-8a54-78a90a2a8e0b",
                        "entry_id": "770027e1-c8e8-3623-b718-63a8dcc01e59",
                        "glosses": [
                            "La maison, l’intérieur du sujet."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "fc071e37-47b2-4e12-a382-42513157bc62",
                                "sense_id": "5eba80fd-db86-3354-8a54-78a90a2a8e0b",
                                "text": "J’ai trouvé la sortie du labyrinthe. J’ai retrouvé mon chez-moi."
                            },
                            {
                                "example_id": "57ca798c-c9b6-4c53-a2c3-6a711e5e9e61",
                                "sense_id": "5eba80fd-db86-3354-8a54-78a90a2a8e0b",
                                "text": "Et elles n’ont pas pour perspective de sortir avant longtemps. Certaines n’ont pas de “chez-moi”, certaines n’y sont pas les bienvenues, d’autres n’ont pas envie de partir, car ici personne ne les juge, ne les attache, ne les oblige à prendre des médicaments ou ne les houspille quand elles ne les ont pas pris depuis plusieurs jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d98a877c-d14f-4f4b-b89c-8f3ad809b0fe",
                        "source_entry_id": "770027e1-c8e8-3623-b718-63a8dcc01e59",
                        "source_sense_id": "5eba80fd-db86-3354-8a54-78a90a2a8e0b",
                        "target_lang_word": "Zuhause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuhause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aac77b9c-b837-35c3-b3fc-08810f5e962a",
                                        "entry_id": "96176460-9840-319b-9ef1-f7a6f2cd45af",
                                        "glosses": [
                                            "die Räumlichkeiten, in denen man wohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29834187-67f9-41be-9af6-161f702f2f6a",
                                                "sense_id": "aac77b9c-b837-35c3-b3fc-08810f5e962a",
                                                "text": "Diese Wohnung ist nun bis auf Weiteres mein Zuhause."
                                            },
                                            {
                                                "example_id": "ec4006f8-c1c4-4cbb-abb3-b8706ed3050d",
                                                "sense_id": "aac77b9c-b837-35c3-b3fc-08810f5e962a",
                                                "text": "„Während der vergangenen 3,7 Milliarden Jahre haben sich die Lebewesen überall auf der Welt ausgebreitet. Ihr Zuhause ist die Biosphäre, die den gesamten Planeten umgibt.“"
                                            },
                                            {
                                                "example_id": "574eca69-ce05-4c36-b9e2-9b7a2a575842",
                                                "sense_id": "aac77b9c-b837-35c3-b3fc-08810f5e962a",
                                                "text": "„Wir waren noch bis spät in die Nacht auf und dachten mit Tränen in den Augen an unser Zuhause zurück.“"
                                            },
                                            {
                                                "example_id": "c53c304c-2a3d-4bf6-9bd2-84237cedc2e6",
                                                "sense_id": "aac77b9c-b837-35c3-b3fc-08810f5e962a",
                                                "text": "„Das also war mein neues Zuhause.“"
                                            },
                                            {
                                                "example_id": "d23eff3d-14d0-417f-aee3-a766169624c7",
                                                "sense_id": "aac77b9c-b837-35c3-b3fc-08810f5e962a",
                                                "text": "„Teddy, der grauhaarige Terrier, der die Buchhandlung zu seinem Zuhause und den Sylvia zu ihrem Gefährten erkoren hatte, bellte fröhlich, als wollte er den Gruß seiner Herrin wiederholen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
