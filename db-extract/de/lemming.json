                    }
                ],
                "senses": [
                    {
                        "sense_id": "e11b40c8-2f29-3a58-b744-919d5d8df80d",
                        "entry_id": "bb39a4ae-812e-3eea-bb94-81db9ead78c3",
                        "glosses": [
                            "Nagetier aus der Unterfamilie der Wühlmäuse (Arvicolinae), das vor allem in Nordeuropa, Nordasien und Nordamerika vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7d1d2b6-f052-49e8-86aa-a21d532445d4",
                                "sense_id": "e11b40c8-2f29-3a58-b744-919d5d8df80d",
                                "text": "Ihr Vorkommen ist dabei von den Bestandsschwankungen der Lemminge, ihrer Hauptbeute, abhängig."
                            },
                            {
                                "example_id": "338f55a8-56dc-494d-9e17-57c705ac8e15",
                                "sense_id": "e11b40c8-2f29-3a58-b744-919d5d8df80d",
                                "text": "„Demographen beobachten ähnliche Phänomene, wenn sie untersuchen, wie Populationen von Ameisen, Lemmingen oder Menschen anwachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7c2131a-967a-45f2-b42c-d536bbe0ba38",
                        "source_entry_id": "bb39a4ae-812e-3eea-bb94-81db9ead78c3",
                        "source_sense_id": "e11b40c8-2f29-3a58-b744-919d5d8df80d",
                        "target_lang_word": "lemming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "009c4bc0-3936-3041-9197-6f62e1919ba6",
                                        "entry_id": "1b72e009-28af-3472-bdba-6e93cf148639",
                                        "glosses": [
                                            "A small arctic and subarctic rodent of the tribes Lemmini, Dicrostonychini and Lagurini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2132e0cc-b058-4cb7-a3ad-b62c063ce8a9",
                                                "sense_id": "009c4bc0-3936-3041-9197-6f62e1919ba6",
                                                "text": "The well-known lemmings, in severe winters, at long intervals, move down from the mountains of Scandinavia in immense numbers, crossing lakes and rivers, eating their way through haystacks, and surmounting every obstacle till they reach the sea, whence very few return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968e179e-7ffe-3fb6-8229-3ec32336cc42",
                                        "entry_id": "1b72e009-28af-3472-bdba-6e93cf148639",
                                        "glosses": [
                                            "Any member of a group given to conformity or groupthink, especially a group poised to follow a leader off a cliff."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23374f3d-d4be-4fe8-8ef2-e2d0e36fd21c",
                                                "sense_id": "968e179e-7ffe-3fb6-8229-3ec32336cc42",
                                                "text": "Lemmings are strongly cohesive, but could be, in organisational terms, highly destructive for the business."
                                            },
                                            {
                                                "example_id": "42bd7697-332e-46a5-b8eb-d24382353c92",
                                                "sense_id": "968e179e-7ffe-3fb6-8229-3ec32336cc42",
                                                "text": "Like a lemming, I followed the crowd, got to the right line and was concentrating hard when queried by the customs officer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac1ad6c5-cc1d-4963-90d7-8f7bab1b73e8",
                        "source_entry_id": "bb39a4ae-812e-3eea-bb94-81db9ead78c3",
                        "source_sense_id": "e11b40c8-2f29-3a58-b744-919d5d8df80d",
                        "target_lang_word": "lemming",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemming",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                        "entry_id": "da3045a4-fcc0-3d99-a360-8ef68214d9e0",
                                        "glosses": [
                                            "Petit rongeur subnival vivant généralement dans les régions arctiques, et migrateur."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34f4bae0-43fe-4485-938e-ecbb1bc82ab2",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "Linné est le premier naturaliste qui ait étudié les Lemmings dans les montagnes de la Laponie, mais il n’assista point à une migration."
                                            },
                                            {
                                                "example_id": "84ce2321-2a66-4075-b434-b30e1aa58c3e",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "En tête du cortège, les lemmings au pelage tacheté de jaune ambré, de roux et de noir."
                                            },
                                            {
                                                "example_id": "d68d230a-bb4a-473d-81e5-e7934fc81ef6",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "Quand au danger que pourraient représenter les rapaces pour les oies, il est négligeable. S'ils ne dédaignent pas un oison à l'occasion, ils préfèrent de loin les lemmings."
                                            },
                                            {
                                                "example_id": "bc7f0461-2d00-46e3-a5af-cae111eb0941",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "Les migrations du lemming dans les contrées septentrionales."
                                            },
                                            {
                                                "example_id": "3b1b443c-5768-4e81-8933-9ad38b911770",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "En mentant de façon flagrante sur l’intégrité du vote, il a galvanisé les dizaines de millions d’Américains qui le suivent tels des lemmings vers le précipice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6ac4e40-562f-45bb-bf35-c7bf05931058",
                        "source_entry_id": "bb39a4ae-812e-3eea-bb94-81db9ead78c3",
