                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a03e059-6cd5-4c1a-8853-24819144eb54",
                                "sense_id": "1d66d11d-ecae-317d-bcf5-34bf98473efb",
                                "text": "„In der Ukraine-Krise gibt es eine neue diplomatische Initiative zur Entschärfung der Lage.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "e66db6ad-3356-39a6-a5df-d2fd3861a267",
                        "entry_id": "933b43fe-0104-3f06-a1f1-9a306f4db189",
                        "glosses": [
                            "das Entschärfen",
                            "einer Bombe oder eines Sprengkörpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2f4b97-a20a-442e-b595-ea846bc1fa97",
                                "sense_id": "e66db6ad-3356-39a6-a5df-d2fd3861a267",
                                "text": "Viele Bomben aus dem zweiten Weltkrieg sind Blindgänger und müssen entschärft werden, jedoch drohen bei der Entschärfung Gefahren oder die Bombe kann gar nicht erst entschärft werden und muss gesprengt werden."
                            },
                            {
                                "example_id": "1116b66f-b6e5-4357-bd2e-24c965c88e8a",
                                "sense_id": "e66db6ad-3356-39a6-a5df-d2fd3861a267",
                                "text": "„Eine Entschärfung ist hierbei deutlich schwieriger als bei einer rein mechanisch funktionierenden Bombe mit Aufschlagzünder.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
