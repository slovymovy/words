                    "frequency": "Middle",
                    "semantic_group_id": "bezwingen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwei mutige Passanten konnten den bewaffneten Täter rechtzeitig <w>überwältigen</w>."
                        },
                        {
                            "text": "Die Spezialeinheit der Polizei <w>überwältigte</w> den Verdächtigen in seiner Wohnung."
                        }
                    ],
                    "antonyms": [
