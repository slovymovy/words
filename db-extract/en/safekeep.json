                        "sense_id": "0bbb877f-8865-35e5-8ac2-44b6b749aaa9",
                        "entry_id": "7baabeb8-b0f4-3352-9f02-9600e4a854b3",
                        "glosses": [
                            "To keep safe; to preserve from harm or loss."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "13c241c7-31f8-4074-b538-09c0c8dbfc40",
                                "sense_id": "0bbb877f-8865-35e5-8ac2-44b6b749aaa9",
                                "text": "If a customer wants $1 million of General Motors Acceptance Corporation (GMAC) paper, the bank carries out the transaction between the customer and GMAC and safekeeps the paper for the customer until it matures."
                            },
                            {
                                "example_id": "edad354c-c36f-41bb-b194-1329418df5ce",
                                "sense_id": "0bbb877f-8865-35e5-8ac2-44b6b749aaa9",
                                "text": "During the mid-1960s, Federal Reserve officials focused on developing institutional arrangements that would facilitate the conversion to book-entry form of definitive securities already safekept at Reserve Banks; they did not address the possibility of a larger system."
                            }
                        ]
                    }
