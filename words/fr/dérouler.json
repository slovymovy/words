                    "frequency": "High",
                    "semantic_group_id": "avoir_lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cérémonie va se <w>dérouler</w> dans la grande salle des fêtes de la mairie."
                        },
                        {
                            "text": "Tout semble se <w>dérouler</w> comme prévu malgré le retard initial des invités."
                        }
                    ],
                    "synonyms": [
                        "avoir lieu",
                        "se passer"
                    ],
                    "common_phrases": [
