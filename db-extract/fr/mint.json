                            {
                                "example_id": "76c7da38-bfc9-481f-a41b-e992ba04f9ec",
                                "sense_id": "b9b6f3cd-ed0d-3e2d-8e18-6128cda11d83",
                                "text": "C’était la deuxième marche nocturne et féministe organisée par l’intercollectif. Elle a rassemblé une centaine de marcheuses sous la pluie, parties de la place de l’Amérique-Latine. « C’est une marche pour les meufs et les Mint. »"
                            },
                            {
                                "example_id": "9892e5bc-d8a1-46ca-8c3b-36ea00d9c222",
                                "sense_id": "b9b6f3cd-ed0d-3e2d-8e18-6128cda11d83",
                                "text": "C’est aussi un camp pluriel avec des espaces non-mixtes pour les MINT (« meufs, intersex, non binaires et trans ») et les personnes dites racisées."
                            }
                        ]
                    }
