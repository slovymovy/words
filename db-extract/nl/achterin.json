                        "examples": [
                            {
                                "example_id": "ff23dc8f-4bb7-43f4-bb33-1fabdb75a293",
                                "sense_id": "b5e7a709-a7ad-3abc-ac85-950a2881016f",
                                "text": "Wil je voorin gaan zitten of achterin?"
                            },
                            {
                                "example_id": "a500b0cf-1cca-4d3f-af71-705951b5efe1",
                                "sense_id": "b5e7a709-a7ad-3abc-ac85-950a2881016f",
                                "text": "Hoewel haar tuin niet groot was, stond hij vol bomen en struiken, roze stokrozen en nog meer kamperfoelie, met helemaal achterin een kleine wildernis."
                            },
                            {
                                "example_id": "bfaaa049-c04c-4be4-a498-c05f86d903df",
                                "sense_id": "b5e7a709-a7ad-3abc-ac85-950a2881016f",
                                "text": "En ineens stonden ze voor een hol en zagen achterin de gloed van een vuur. Er was een lelijk oud wijf dat, zachtjes mompelend, in een pot boven het vuur stond te roeren."
                            }
                        ]
                    }
                ],
