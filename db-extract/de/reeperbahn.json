                        "form": "die Reeperbahn"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61d0da81-e8ee-3590-b3c4-df2cc24110d9",
                        "entry_id": "1f7c3d97-b48f-3a0f-9563-76fb9b529e1e",
                        "glosses": [
                            "Eigenname, Straße in verschiedenen norddeutschen Orten Ahrensbök, Anklam, Buxtehude, Eckernförde, Elmshorn, Fehmarn, Kappeln, Schlei, Niederelbe, Ueckermünde, Uetersen, Verden (Aller), Wischhafen; die bekannteste davon in Hamburg, Stadtteil St. Pauli, eine bekannte Partymeile und Vergnügungsstraße, in der sich Nachtclubs und Bars befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e62fe32-1d75-4857-a4b5-b765918306b5",
                                "sense_id": "61d0da81-e8ee-3590-b3c4-df2cc24110d9",
                                "text": "Die Reeperbahn ist einen halben Kilometer lang."
                            },
                            {
                                "example_id": "cf56061a-acea-4657-a847-ddc8ae31f0e0",
                                "sense_id": "61d0da81-e8ee-3590-b3c4-df2cc24110d9",
                                "text": "Familie Mustermann wohnt in der Reeperbahn 66."
                            },
                            {
                                "example_id": "e1308f69-1d32-4c15-88f7-e9f30d727cce",
                                "sense_id": "61d0da81-e8ee-3590-b3c4-df2cc24110d9",
                                "text": "Die Reeperbahn ist wegen Bauarbeiten gesperrt."
                            },
                            {
                                "example_id": "d41c49fb-455e-4525-b39f-d5779237c075",
                                "sense_id": "61d0da81-e8ee-3590-b3c4-df2cc24110d9",
                                "text": "Wohnt deine Geliebte in der Reeperbahn 66?"
                            },
                            {
                                "example_id": "aa000dc7-3081-4d48-b870-1c8cf890b641",
                                "sense_id": "61d0da81-e8ee-3590-b3c4-df2cc24110d9",
                                "text": "„Und man gibt ihn sowohl an der Börse als auch auf der Reeperbahn zum besten – sofern die Erzähler aus Altona stammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
