                    "synonyms": [
                        "chef",
                        "dirigeant"
                    ],
                    "common_phrases": [
                        "maître de maison",
                        "maître du jeu",
                        "maître de la situation"
                    ]
                },
                {
                    "sense_id": "9a99bc42-54c5-3fc0-8a14-fa5670ec7e2a",
