                        "source_sense_id": "d6abca20-f45a-3435-b327-a0d2e9d47936",
                        "source_sense_description": "Kompressionsverband, der durch mechanischen Druck auf blutende Gefäße eine Blutstillung bewirkt",
                        "target_lang_word": "garrot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garrot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40e9420e-a3d7-3064-bbd5-7a706586561f",
                                        "entry_id": "80ae3594-d607-3832-b020-653be13ab37e",
                                        "glosses": [
                                            "Partie du corps de certains quadrupèdes, et principalement du cheval, qui est située au-dessus des épaules et qui termine le cou, l’encolure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c8828d-b3be-4972-8680-d0545a01da7c",
                                                "sense_id": "40e9420e-a3d7-3064-bbd5-7a706586561f",
                                                "text": "Ce cheval a été blessé au garrot."
                                            },
                                            {
                                                "example_id": "f95b14b5-be27-4b26-a17d-db6b12f7ed0a",
                                                "sense_id": "40e9420e-a3d7-3064-bbd5-7a706586561f",
                                                "text": "L’oryx algazelle mesure au garrot 120 cm pour un poids de 200 kg."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garrot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d19c6c2b-03f0-33e7-872d-f8ee820dd8ae",
                                        "entry_id": "e86346f6-57b9-33a8-b62d-2e4e8912fb25",
                                        "glosses": [
                                            "Trait d’arbalète. Synonyme de carreau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce5c2e1-9627-48d1-84ba-1f35a8208043",
                                                "sense_id": "d19c6c2b-03f0-33e7-872d-f8ee820dd8ae",
                                                "text": "Et suis comme la biche à qui l’on a percé\nLe flanc mortellement d’un garrot traversé !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5782a931-33c1-3def-95ed-a47a53a9fe0d",
                                        "entry_id": "e86346f6-57b9-33a8-b62d-2e4e8912fb25",
                                        "glosses": [
                                            "Morceau de bois court qu’on passe dans une corde, dans un lien quelconque, pour le serrer en tordant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1397413c-8e50-48aa-9e65-c8d812f537b8",
                                                "sense_id": "5782a931-33c1-3def-95ed-a47a53a9fe0d",
                                                "text": "Le supplice du garrot."
                                            },
                                            {
                                                "example_id": "5b6c8550-d7f2-4c0a-8479-8174ab19c623",
                                                "sense_id": "5782a931-33c1-3def-95ed-a47a53a9fe0d",
                                                "text": "Serrez davantage le garrot de cette scie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8f3edff-c5a9-3f05-9d68-ee5c04284c3d",
                                        "entry_id": "e86346f6-57b9-33a8-b62d-2e4e8912fb25",
                                        "glosses": [
                                            "Supplice de la strangulation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3caec03c-a2bf-3dfa-95b2-6f185faed258",
                                        "entry_id": "e86346f6-57b9-33a8-b62d-2e4e8912fb25",
                                        "glosses": [
                                            "Appareil qui sert en chirurgie pour comprimer une plaie, une artère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3791a7e-3de3-429a-8cc7-da6aceb28722",
                                                "sense_id": "3caec03c-a2bf-3dfa-95b2-6f185faed258",
                                                "text": "La main tout entière était broyée. Une pression de plusieurs milliers de kilos. Des brûlures jusqu’au coude : un volume de matière en fusion exactement égal à celui de la chair et des os qui emplissait le moule avait fusé par les joints.\nOn lui fit un garrot. L’ambulance arriva. Les autres ouvriers retournèrent à leurs presses."
                                            },
                                            {
                                                "example_id": "0ca50e3a-a57d-4eae-9d41-cc9c55e67f67",
                                                "sense_id": "3caec03c-a2bf-3dfa-95b2-6f185faed258",
                                                "text": "Puis le chef des Mujao a pris mon avant-bras droit et l’a ligoté avec une chambre à air de bicyclette, comme un garrot."
                                            },
                                            {
                                                "example_id": "1f060cbe-389d-40c7-8ef0-b4dafbd9fd9d",
                                                "sense_id": "3caec03c-a2bf-3dfa-95b2-6f185faed258",
                                                "text": "« Il y a tellement de personnes sans jambes. Du sang, du sang partout. Des os, des fragments, c’est dégoûtant », poursuit le jeune homme, occupé à poser des garrots sur les membres blessés de ses compagnons de course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57609c05-bbc5-3078-b22b-80a2c70a3acd",
                                        "entry_id": "e86346f6-57b9-33a8-b62d-2e4e8912fb25",
                                        "glosses": [
                                            "Dispositif mis en place pour juguler un flux de personnes ou de véhicules."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c13baae1-2af2-46e0-bc56-6358a014369e",
                                                "sense_id": "57609c05-bbc5-3078-b22b-80a2c70a3acd",
                                                "text": "Sur toutes les routes et même les chemins, un garrot de képis et de barricades contenait un petit caillot noir de charrettes, de voitures et de gens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "993d2ac5-8ae2-3dd2-a4bf-0b52b634719b",
                                        "entry_id": "e86346f6-57b9-33a8-b62d-2e4e8912fb25",
                                        "glosses": [
                                            "Bâton qui sert pour forcer une branche à changer de direction."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
