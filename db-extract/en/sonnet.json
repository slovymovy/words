                                        "entry_id": "9e37d2df-6301-3d6f-abe5-3a4f3d7a8ade",
                                        "glosses": [
                                            "metrisch gedicht bestaande uit ofwel twee vierregelige en twee drieregelige strofen (Italiaans sonnet), of uit drie vierregelige strofen en één tweeregelige strofe (Engels sonnet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d6bf12-18a5-4eae-b85c-f3ce90ed411c",
                                                "sense_id": "59ac2c5f-b0e9-3f92-8e24-31abf466645a",
                                                "text": "Op de muur staat ook een sonnet, een gedicht van 14 regels, over de geschiedenis van het dorpje."
                                            }
