                "forms": [],
                "senses": [
                    {
                        "sense_id": "16555c82-48c5-347d-a2ee-b25ff78ffb7c",
                        "entry_id": "d7ab804d-a419-36fb-bc55-ead4aa224d37",
                        "glosses": [
                            "das Automobil, der Personenkraftwagen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bd3a81d2-9e37-3604-b420-7f7fd4761fbe",
                        "entry_id": "d7ab804d-a419-36fb-bc55-ead4aa224d37",
                        "glosses": [
                            "der mittels eigener Motoren angetriebene Wagen einer Bahn"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "860921b5-5eaf-4001-9dd5-e0661b454e62",
                        "source_entry_id": "d7ab804d-a419-36fb-bc55-ead4aa224d37",
                        "source_sense_id": "16555c82-48c5-347d-a2ee-b25ff78ffb7c",
                        "source_sense_description": "das Automobil, der Personenkraftwagen",
                        "target_lang_word": "Personenkraftwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Personenkraftwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0701dc6-51f6-398b-8c45-890d7f884e1c",
                                        "entry_id": "339f8a3f-6cde-310a-b70a-76a73aeb624c",
                                        "glosses": [
                                            "Automobil zur Beförderung von Personen"
                                        ],
                                        "tags": [
                                            "vorwiegend amtlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840b2c2d-e897-4c03-a9bf-0bd5342c5bbb",
                                                "sense_id": "a0701dc6-51f6-398b-8c45-890d7f884e1c",
                                                "text": "„Das Reichsverkehrsministerium erlässt für das Deutsche Reich mit Wirkung vom 1. April des Jahres ein Verbot für Privatfahrten mit Personenkraftwagen.“"
                                            },
                                            {
                                                "example_id": "ef187f74-9f92-4ce3-9cde-3f911bcd6af9",
                                                "sense_id": "a0701dc6-51f6-398b-8c45-890d7f884e1c",
                                                "text": "„Weil sie sich insoweit nicht erinnerungsfähig zeigte, als sie sich eitel aufgeführt hatte, als die Leidenschaft sie verdummt hatte, las er ihr zur Unterstützung ihres Gedächtnisses aus doppelten Schulheften vor, die er an einem ihr nicht zugänglichen Ort, nämlich im Kofferraum seines Personenkraftwagens, sorgfältig zu verwahren pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7958cfa1-f9d6-4d2e-a805-00d338865274",
                        "source_entry_id": "d7ab804d-a419-36fb-bc55-ead4aa224d37",
                        "source_sense_id": "16555c82-48c5-347d-a2ee-b25ff78ffb7c",
                        "source_sense_description": "das Automobil, der Personenkraftwagen",
                        "target_lang_word": "Auto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a656b3f5-fdf3-4c57-bd50-2f029a8aec2f",
                        "source_entry_id": "d7ab804d-a419-36fb-bc55-ead4aa224d37",
                        "source_sense_id": "16555c82-48c5-347d-a2ee-b25ff78ffb7c",
                        "source_sense_description": "das Automobil, der Personenkraftwagen",
                        "target_lang_word": "Automobil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Automobil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6da80e06-207c-3dea-bdd3-03637ab66ea8",
                                        "entry_id": "25d9c01e-857c-3dbb-8cbb-8dbb54572154",
                                        "glosses": [
                                            "von einem Motor angetriebenes Fahrzeug, meist zur Beförderung von Personen vorgesehen"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "917c36a1-17d3-4945-b97c-6ebfb89107de",
                                                "sense_id": "6da80e06-207c-3dea-bdd3-03637ab66ea8",
                                                "text": "Ich fahre mit meinem Automobil nach Italien."
                                            },
                                            {
                                                "example_id": "a5b1376d-9936-42ea-84f6-5c7a73200206",
                                                "sense_id": "6da80e06-207c-3dea-bdd3-03637ab66ea8",
                                                "text": "„Der ‚moderne‘ Mensch nennt dies Sentimentalität; er liebt die Dinge nicht mehr, nicht einmal sein Heiligstes, sein Automobil, das er baldmöglichst gegen eine bessere Marke hofft tauschen zu können.“"
                                            },
                                            {
                                                "example_id": "492367f5-02ba-4387-beac-fee4702ec396",
                                                "sense_id": "6da80e06-207c-3dea-bdd3-03637ab66ea8",
                                                "text": "„Und schließlich wird die Power von Automobilen nach wie vor in PS, also Pferdestärken, gemessen, auch wenn offiziell die Bezeichnung kw gültig ist.“"
                                            },
                                            {
                                                "example_id": "9c0e16d7-caea-43d7-ab55-f289b6d76329",
                                                "sense_id": "6da80e06-207c-3dea-bdd3-03637ab66ea8",
                                                "text": "„Sie habe noch nie in einem Automobil gesessen.“"
                                            },
                                            {
                                                "example_id": "20fb2fe4-cda8-4f6d-aa6f-78963714d7bb",
                                                "sense_id": "6da80e06-207c-3dea-bdd3-03637ab66ea8",
                                                "text": "„In der Kurve bei Allans Hütte musste Gustavsson nervös geworden sein (falls nicht sogar Gott oder die Vorsehung irgendwie eingriffen), jedenfalls bockte die Schaltung, und Gustavsson fuhr mitsamt seinem Automobil geradewegs in die Kiesgrube hinter der kleinen Hütte, statt rechts daran vorbeizusteuern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58946e73-4edb-4f87-b034-6f2e14917978",
                        "source_entry_id": "d7ab804d-a419-36fb-bc55-ead4aa224d37",
                        "source_sense_id": "16555c82-48c5-347d-a2ee-b25ff78ffb7c",
                        "source_sense_description": "das Automobil, der Personenkraftwagen",
                        "target_lang_word": "Kraftfahrzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kraftfahrzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3b182d-3b1c-3cbc-b33f-29d6edb0f834",
                                        "entry_id": "01fe6f93-0ccf-3940-8116-d82d6ec5f732",
                                        "glosses": [
                                            "jedes nicht an Gleise gebundene Landfahrzeug (Straßenfahrzeug), das sich mit Hilfe eines ein- oder angebauten Motors aus eigener Kraft fortbewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00bcb416-bf40-4b3e-978d-758e1b3c2d98",
                                                "sense_id": "1c3b182d-3b1c-3cbc-b33f-29d6edb0f834",
                                                "text": "Ein Amphibienfahrzeug an Land ist auch ein Kraftfahrzeug."
                                            },
                                            {
                                                "example_id": "0d254094-fa99-46a4-89b1-d5208580e939",
                                                "sense_id": "1c3b182d-3b1c-3cbc-b33f-29d6edb0f834",
                                                "text": "Ein Fuhrwerk ist kein Kraftfahrzeug."
                                            },
                                            {
                                                "example_id": "15942fe1-5530-4252-8812-db07a07f5f0e",
                                                "sense_id": "1c3b182d-3b1c-3cbc-b33f-29d6edb0f834",
                                                "text": "„Denn für Frauen ist das Kraftfahrzeug eines von sehr vielen Accessoires und wird teilweise genau so gehandhabt wie beispielsweise die Handtasche:…“"
                                            },
                                            {
                                                "example_id": "35aa2c16-966e-4b19-89da-2aaeea58f000",
                                                "sense_id": "1c3b182d-3b1c-3cbc-b33f-29d6edb0f834",
                                                "text": "„Vielleicht liegt es tatsächlich am Erfinderstolz, dass die Deutschen dermaßen vernarrt in ihre Kraftfahrzeuge sind.“"
                                            },
                                            {
                                                "example_id": "3dfb1702-ed59-4a26-b253-aaa574e3260b",
                                                "sense_id": "1c3b182d-3b1c-3cbc-b33f-29d6edb0f834",
                                                "text": "„Die hunderttausend Kraftfahrzeuge, die mittlerweile in der Hauptstadt zugelassen waren, schienen alle den gleichen Weg zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
