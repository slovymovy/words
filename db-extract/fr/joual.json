                "senses": [
                    {
                        "sense_id": "fb8746b2-fcc6-3d2c-a8b2-7dc2623306ec",
                        "entry_id": "3baca459-5ee1-3952-a07e-f0ce37fb273e",
                        "glosses": [
                            "Relatif au joual."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7656b9ae-082a-48e1-96a4-41d60d2c4750",
                                "sense_id": "fb8746b2-fcc6-3d2c-a8b2-7dc2623306ec",
                                "text": "Cocasseries, sermons jouals, défense des paillardes et des vadrouillards, apologie des ivrognes voilà le fond de scène de ses romans […]"
                            },
                            {
                                "example_id": "7b0d9045-21de-4831-8b65-58f0b6d247bc",
                                "sense_id": "fb8746b2-fcc6-3d2c-a8b2-7dc2623306ec",
                                "text": "[…] on a voulu récupérer […] la langue du Québec — qu’on appelle la langue jouale — […]"
                            },
                            {
                                "example_id": "c56aa2b1-8583-4a98-a0a1-9d07d5ff6cab",
                                "sense_id": "fb8746b2-fcc6-3d2c-a8b2-7dc2623306ec",
                                "text": "[…] mais après les premières œuvres jouales, le monde québecois a changé […]"
                            },
                            {
                                "example_id": "d783a005-3313-49a2-a991-8ef97c8a0fa0",
                                "sense_id": "fb8746b2-fcc6-3d2c-a8b2-7dc2623306ec",
                                "text": "Ce parler et cette pensée jouals sont typiquement canadiens-français […]"
                            },
                            {
                                "example_id": "ad24d94f-21ca-496f-8762-9874e2267255",
                                "sense_id": "fb8746b2-fcc6-3d2c-a8b2-7dc2623306ec",
                                "text": "[…] des poèmes structurés en rythmes et mots jouals."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ed74ff2-cd05-472b-8943-b4237b174a4d",
                        "source_entry_id": "3baca459-5ee1-3952-a07e-f0ce37fb273e",
                        "source_sense_id": "fb8746b2-fcc6-3d2c-a8b2-7dc2623306ec",
                        "target_lang_word": "joual",
