                ],
                "senses": [
                    {
                        "sense_id": "3e56995c-7719-3f1f-a9b9-8bd27fc52052",
                        "entry_id": "39501ec2-89ef-3d78-ac9d-7a68413047f6",
                        "glosses": [
                            "Chanter en barytone."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "434aadbd-7868-4208-859c-2ad1d87528f2",
                                "sense_id": "3e56995c-7719-3f1f-a9b9-8bd27fc52052",
                                "text": "Quand il pleut, je laisse pleuvoir. Quand il tonne, je barytone."
                            },
                            {
                                "example_id": "6311bc41-73aa-4cec-8162-26e786656290",
                                "sense_id": "3e56995c-7719-3f1f-a9b9-8bd27fc52052",
                                "text": "Le batteur battait, la chanteuse chantait, l'accordéon soufflait sur ses anches, le saxophone barytonait, et moi, Alex, je souffrais de plus en plus du ventre, assis en érection sur mon banc mais le clapet fermé."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5cd02a1-bffd-3aea-a4cb-5f3732841ae3",
                        "entry_id": "39501ec2-89ef-3d78-ac9d-7a68413047f6",
                        "glosses": [
                            "Prendre la tessiture du barytone"
                        ],
                        "tags": [
                            "broadly",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "13b42112-c3ff-42ba-aa82-b3f305202619",
                                "sense_id": "f5cd02a1-bffd-3aea-a4cb-5f3732841ae3",
                                "text": "Leur voix éraillée se barytone; l'habitude de rouler des cigarettes imprime à leurs doigts des stigmates jaunes indélébiles."
                            }
                        ]
                    }
                ],
