                "senses": [
                    {
                        "sense_id": "34a3bc35-a5c3-3c30-87c5-ef43bc9f3f85",
                        "entry_id": "bff202b6-757c-3afc-88c5-1deed26d9764",
                        "glosses": [
                            "eine technische Schutzvorrichtung für elektrische Geräte vor Überspannung (=Innerer Blitzschutz) auf ein sicheres Maß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31772433-6c29-4ec3-9761-16dc2747d826",
                                "sense_id": "34a3bc35-a5c3-3c30-87c5-ef43bc9f3f85",
                                "text": "„Überspannungsschutz ist die Begrenzung von transienten Überspannungen auf ein für elektrische Anlagen und Endgeräten ungefährliches Maß (siehe Bild 1)“"
                            },
                            {
                                "example_id": "3c341d85-b4e5-4ed6-ab4e-570f64519fdb",
                                "sense_id": "34a3bc35-a5c3-3c30-87c5-ef43bc9f3f85",
                                "text": "„Diese Schutzgeräte müssen vor jedem empfindlichen elektronischen Gerät und in jede angeschlossene Leitung (Strom, Telefon, Fernseher) immer dann eingesetzt werden, wenn ein Überspannungsschutz realisiert wird.“"
                            },
                            {
                                "example_id": "7cd2150e-fb51-4330-bec5-345995e770c9",
                                "sense_id": "34a3bc35-a5c3-3c30-87c5-ef43bc9f3f85",
                                "text": "„Durch den Einsatz eines Überspannungsschutzes lassen sich diese Schäden und die daraus hervorgehenden Kosten vermeiden.“"
                            },
                            {
                                "example_id": "d76e8d49-3fec-4561-84db-24cd0662018f",
                                "sense_id": "34a3bc35-a5c3-3c30-87c5-ef43bc9f3f85",
                                "text": "„Welchen Stellenwert Sie dem Überspannungsschutz zuordnen, hängt von Ihrer Risikobereitschaft ab.“"
                            },
                            {
                                "example_id": "26fa0f23-d686-48ec-be11-a91ad3a33c4b",
                                "sense_id": "34a3bc35-a5c3-3c30-87c5-ef43bc9f3f85",
                                "text": "„Feinschutzgeräte sind der unverzichtbare Überspannungsschutz für alle Geräte mit elektronischen Bauteilen, wie z. B. Fernseher, Radiogeräte, Computer, Wasch- und Spülmaschinen, Telefone, Anrufbeantworter, Alarmanlagen usw.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
