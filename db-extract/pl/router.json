                        "cross_references": []
                    },
                    {
                        "translation_id": "ea133baf-44c7-4a92-8b4f-be8b159e8cd3",
                        "source_entry_id": "ab96d414-3194-3358-94f0-2a8673a7ca12",
                        "source_sense_id": "a49f0d34-7e6e-302b-955a-1cf17b4185c0",
