                    "common_phrases": [
                        "score the winner",
                        "late winner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гол или очко, принесшие победу в соревновании.",
                        "fr": "But, point ou action décisive qui permet de remporter une compétition."
                    },
