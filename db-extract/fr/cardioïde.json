                        "entry_id": "45c0abb2-eda5-3d0f-a7fc-49f39cde7893",
                        "glosses": [
                            "Courbe plane engendrée par un point d’un cercle qui roule sans glisser sur un cercle de même diamètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcfc5836-7de6-4f74-86aa-40727415fb0c",
                                "sense_id": "45f2316e-291d-36a3-9c17-e67379335677",
                                "text": "La voiture décrivit une élégante cardioïde et s'arrêta en bas des marches."
                            },
                            {
                                "example_id": "6d763762-613e-42a8-b626-7d3e3915ca05",
                                "sense_id": "45f2316e-291d-36a3-9c17-e67379335677",
                                "text": "La courbe de directivité des microphones directionnels les plus simples est une cardioïde."
                            }
                        ]
                    }
                ],
