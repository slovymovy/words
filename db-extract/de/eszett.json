                                        "entry_id": "a205807c-5a5b-3b08-95f4-9d19bf394db7",
                                        "glosses": [
                                            "La lettre ß utilisée en allemand. Elle porte le numéro 223 dans le répertoire Unicode."
                                        ],
                                        "tags": [
                                            "Germanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e70bfc-a622-46a2-b633-52a3d49caf4e",
                                                "sense_id": "0149a38e-8658-3da3-becc-b14164a7eabe",
                                                "text": "L'eszett (prononcé \"essetsette\"), c'est le nom officiel de cette drôle de lettre qui est unique à l'alphabet allemand."
                                            }
                                        ]
                                    }
                                ]
