                                "target_senses": [
                                    {
                                        "sense_id": "9d16d773-79e5-3327-8b96-a81b103d3be8",
                                        "entry_id": "dee9c448-a75b-3a1c-adaa-9b09eb55e34b",
                                        "glosses": [
                                            "The layer of skin between the epidermis and the subcutaneous tissues; the dermis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fb7ee43-5e86-36f4-8064-02081eb1e358",
                                        "entry_id": "dee9c448-a75b-3a1c-adaa-9b09eb55e34b",
                                        "glosses": [
                                            "The deep layer of mucous membranes beneath the epithelium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "526df053-3ee9-35c8-a250-a74b1648be6e",
                                        "entry_id": "dee9c448-a75b-3a1c-adaa-9b09eb55e34b",
                                        "glosses": [
                                            "Armour made of leather, particularly that used by the Romans."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f0a405c-cebc-403c-bf9e-88b0358852f2",
                                                "sense_id": "526df053-3ee9-35c8-a250-a74b1648be6e",
                                                "text": "Passing by the Corium Bubulum of the Classical Ancients, we see in an old charter, dated 1036, \"Stallus Sutoris Vaccæ,\" i. e. the stall of a shoe-maker who used cow-skin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8e6fd6-8f9c-37b9-8da3-76058e2e2bb3",
                                        "entry_id": "2b914b27-6724-31d4-8b3d-e5f29f5454ea",
                                        "glosses": [
                                            "A lavalike mixture of fissile material created in a nuclear reactor's core during a nuclear meltdown."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7851ee8a-264e-4136-9d9a-3974be8dc225",
                                                "sense_id": "ff8e6fd6-8f9c-37b9-8da3-76058e2e2bb3",
                                                "text": "Mexico was given $100,000 to do a series of experiments in which small amounts (10 to 20 grams) of stainless steel and corium (a mixture of 55 percent iron, 10 percent zirconium, and 35 percent uranium dioxide) will be melted and then flooded with water in an arc-melting chamber."
                                            },
                                            {
                                                "example_id": "53469ef0-06b5-4056-bb6c-7a1f1eba4eeb",
                                                "sense_id": "ff8e6fd6-8f9c-37b9-8da3-76058e2e2bb3",
                                                "text": "Previous studies of the thermal behavior of corium in a degraded nuclear reactor have focussed primarily on the process of heat transfer within the corium."
                                            },
                                            {
                                                "example_id": "a1091ce4-e053-44a3-8856-59af89794977",
                                                "sense_id": "ff8e6fd6-8f9c-37b9-8da3-76058e2e2bb3",
                                                "text": "The materials of the nuclear reactor—nuclear oxide fuel and fission products, cladding, metallic alloys, moderator, absorbers, structural materials, coolants, concrete, and so on, could melt to form complex, multiphases, and aggressive mixtures known by the general term corium."
                                            },
                                            {
                                                "example_id": "8d901a41-ff11-4029-94d2-93b07ba91e47",
                                                "sense_id": "ff8e6fd6-8f9c-37b9-8da3-76058e2e2bb3",
                                                "text": "CORIUM: INIS: 1977-10-17; ETDE: 1977-06-02 Molten mixture of fuel, cladding and other core structural material resulting from a meltdown accident."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbb8b33c-723b-40a3-9c63-4be5b8845ea1",
                        "source_entry_id": "8f2fe784-83e0-302d-8f6a-28a9af70cf1a",
