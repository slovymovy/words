                "senses": [
                    {
                        "sense_id": "347514a1-7164-31ca-ae07-140303fd1fb5",
                        "entry_id": "f33ed13b-bf99-3af7-9f78-66d7229901c1",
                        "glosses": [
                            "Vorsitzender einer Landesregierung"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "c119ab5c-630d-4101-ac96-10f6019c8ccd",
                                "sense_id": "347514a1-7164-31ca-ae07-140303fd1fb5",
                                "text": "„Solange Wien die Hauptstadt von Niederösterreich war, war der Landeshauptmann von Niederösterreich auch für Wien zuständig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42f5b02e-f823-3b5d-bc1d-2b0218422d59",
                        "entry_id": "f33ed13b-bf99-3af7-9f78-66d7229901c1",
                        "glosses": [
                            "Leiter einer Provinzverwaltung"
                        ],
                        "tags": [
                            "Preußen",
                            "bis 1933"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05a22e4e-6b67-4ea1-9189-2d022ffe9409",
                        "source_entry_id": "f33ed13b-bf99-3af7-9f78-66d7229901c1",
                        "source_sense_id": "347514a1-7164-31ca-ae07-140303fd1fb5",
                        "target_lang_word": "governor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "governor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "The chief executive officer of a first-level administrative division of a country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34a36f9-8980-4397-bdda-4f85634bc13a",
                                                "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                                "text": "Younger voters are more libertarian in political philosophy than older voters and are credited with the success of libertarian governor Jesse Ventura of Minnesota."
                                            },
                                            {
                                                "example_id": "fee4a3d3-5c79-4884-bcc1-2d95e698df74",
                                                "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                                "text": "Top aides and people close to Kamala Harris have divided over whether she should head home to run for California governor in 2026 — and it all comes down to whether they believe she could win the Democratic nomination for president in an expected competitive primary in 2028."
                                            },
                                            {
                                                "example_id": "ce4e11aa-5e59-4c64-907a-21a73a11b876",
                                                "sense_id": "85984639-b289-3c27-b496-c52eb006efc3",
                                                "text": "But gender is a factor both candidates will navigate in a country that has elected just 51 female state governors in its history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00fa6075-f930-3214-8d8a-065a9cf4a628",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "A device which regulates or controls some action of a machine through automatic feedback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04affa7e-fe96-4722-adbd-2f0b7fe1b213",
                                                "sense_id": "00fa6075-f930-3214-8d8a-065a9cf4a628",
                                                "text": "Generator excitation is obtained by a combination of the separately-excited and self-excited fields, and the output is controlled by a resistance in the separate field circuit adjusted by the load regulator under the control of the engine governor."
                                            },
                                            {
                                                "example_id": "4b866fff-8cc1-4dd3-a370-6cd0d5bef059",
                                                "sense_id": "00fa6075-f930-3214-8d8a-065a9cf4a628",
                                                "text": "The turning point came in 1923, says Norton, when 42,000 Cincinnati residents signed a petition for a ballot initiative that would require all cars to have a governor limiting them to 25 miles per hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb7bc73-3b66-3eb2-973c-f93c8f79746e",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "A member of a decision-making body (such as a committee) for a larger organization or entity (including some public agencies), similar to or equivalent to a board of directors (used especially for banks); a member of the board of governors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c925c049-cfa5-4885-a5c6-73663ea53d1a",
                                                "sense_id": "0bb7bc73-3b66-3eb2-973c-f93c8f79746e",
                                                "text": "The seven members of the Board of Governors of the Federal Reserve System are nominated by the President and confirmed by the Senate."
                                            },
                                            {
                                                "example_id": "f25ae21c-b9d9-4672-bd91-90ecf9d04e54",
                                                "sense_id": "0bb7bc73-3b66-3eb2-973c-f93c8f79746e",
                                                "text": "Pan Gongsheng, governor of the People’s Bank of China (PBOC) and head of the country’s foreign exchange regulator, chaired a symposium with representatives from foreign companies, including JP Morgan, Tesla (TSLA), HSBC (HSBC), Deutsche Bank (DB), BNP Paribas, Japan’s MUFG Bank, German chemical producer BASF, commodities trader Trafigura and Schneider Electric, according to a statement posted on the websites of the PBOC and the State Administration of Foreign Exchange (SAFE)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "408f6091-1d69-35fa-9c18-a1ab2f422bcb",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "Father."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aea504b5-cbee-4e51-a361-63d4d3187a25",
                                                "sense_id": "408f6091-1d69-35fa-9c18-a1ab2f422bcb",
                                                "text": "\"Say 'father.' We never called him papa; and if one of my brothers had addressed him as 'governor,' as boys do now, I really think he'd have him cut off with a shilling.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c118cc21-83f1-38ce-a28c-434a0cddf7ab",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "Boss; employer; gaffer."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "347259e4-c70a-3721-a1ae-34640bed7df9",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "Term of address to a man; guv'nor."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "307d0ee0-dc00-3b71-b076-b83ba5a78b3a",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "A constituent of a phrase that governs another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbeef936-5396-3ea5-96be-1cde9bfcf3b3",
                                        "entry_id": "e1747f0e-9bdb-3d3d-b500-65a1175c4bc2",
                                        "glosses": [
                                            "One who has the care or guardianship of a young man; a tutor; a guardian."
                                        ],
                                        "tags": [
