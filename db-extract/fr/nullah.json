                        "examples": [
                            {
                                "example_id": "ff2ba45d-f2fe-447f-aed9-bf37727a891d",
                                "sense_id": "57ee8567-d441-3f7f-ba18-d5eb133888ad",
                                "text": "Une pluie violente ne tarda pas à assaillir les voyageurs ; au-dessous d’eux, les chemins coupés par des “nullahs”, sortes de torrents momentanés, devenaient impraticables, embarrassés d’ailleurs de buissons épineux et de lianes gigantesques."
                            },
                            {
                                "example_id": "a9e09355-10d4-40b9-8012-619c4797bb5b",
                                "sense_id": "57ee8567-d441-3f7f-ba18-d5eb133888ad",
                                "text": "« Y a une sorte de nullah, mon lieut'nant, que j'fais, mais j'ai déjà pied. » Pas étonnant. J'étais encore à trois pas du bord, à peine. « Un nullah ! Dites plutôt un estuaire », qu'y dit le lieut'nant."
                            }
                        ]
                    }
