{
    "word_family": [
        "fluttery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "425ff6aa-2bc8-3976-9bbc-9f7373cef5ad",
                    "sense_definition": "To flap or wave quickly but irregularly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The colorful flags <w>fluttered</w> in the strong breeze.",
                            "target_lang_translations": {
                                "cs": "Barevné vlajky <w>vlály</w> v silném vánku."
                            }
                        },
                        {
                            "text": "Her eyelids <w>fluttered</w> as she slowly woke up from her nap.",
                            "target_lang_translations": {
                                "cs": "Její víčka se <w>zachvěla</w>, když se pomalu probouzela ze šlofíka."
                            }
                        }
                    ],
                    "synonyms": [
                        "flap",
                        "wave",
                        "flicker"
                    ],
                    "common_phrases": [
                        "flags flutter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle, ale nepravidelně mávat nebo se vlnit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třepetat se",
                                "target_lang_sense_clarification": "pohybovat se sem a tam, často ve větru"
                            },
                            {
                                "target_lang_word": "vlát",
                                "target_lang_sense_clarification": "pohybovat se ve větru (např. vlajka)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6da8731-3ccf-30a3-9939-497f980c2631",
                    "sense_definition": "Of a winged animal: to flap the wings without flying or to fly with light, quick wing beats.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bird <w>fluttered</w> from branch to branch in the garden.",
                            "target_lang_translations": {
                                "cs": "Malý ptáček <w>poletoval</w> ze větve na větev v zahradě."
                            }
                        },
                        {
                            "text": "Butterflies <w>fluttered</w> around the bright flowers in the meadow.",
                            "target_lang_translations": {
                                "cs": "Motýli <w>poletovali</w> kolem jasných květin na louce."
                            }
                        }
                    ],
                    "synonyms": [
                        "flit"
                    ],
                    "common_phrases": [
                        "birds flutter"
                    ],
                    "target_lang_definitions": {
                        "cs": "U okřídlených zvířat: mávat křídly bez létání nebo létat lehkými, rychlými pohyby křídel."
                    },
                    "translations": {
