                                    {
                                        "sense_id": "e03bd910-62ee-38e6-94f3-ce12bf703708",
                                        "entry_id": "bb90ea27-ad2e-3184-810b-07fbecac3c35",
                                        "glosses": [
                                            "The making of boasts."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efbc1879-65a8-32d8-995d-727dd627465c",
                                        "entry_id": "bb90ea27-ad2e-3184-810b-07fbecac3c35",
                                        "glosses": [
                                            "An individual boast or bout of boasting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5a0827-024f-4dcd-904a-e9bc0610191c",
                                                "sense_id": "efbc1879-65a8-32d8-995d-727dd627465c",
                                                "text": "Solomon says, \"Pride goes before destruction, and a haughty spirit before a fall.\" Some, as soon as their vain boastings were uttered, were made monuments of divine justice."
                                            },
                                            {
                                                "example_id": "c44d3927-ae3b-452e-9908-e950643c2a88",
                                                "sense_id": "efbc1879-65a8-32d8-995d-727dd627465c",
                                                "text": "After that there were boastings in Hereot! Then did the warriors brag before their stainless queen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eab17542-4d91-4983-b704-ac192332f35a",
