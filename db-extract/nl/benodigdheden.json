                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "375d3e6c-44e1-3a32-add7-88f1c69c3606",
                        "entry_id": "9af44ebf-e625-3e79-8877-4c83bff2bfb9",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord benodigdheid"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4eaac06f-09aa-4bde-ad0f-2e6db2e24591",
                                "sense_id": "375d3e6c-44e1-3a32-add7-88f1c69c3606",
                                "text": "Deze gravure toont ons een man met voor zich een tafel gevuld met benodigdheden voor het houden van kanaries (we herkennen o.a. voeder- en drinkbakjes)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ede33b69-e919-3fdc-b644-0ee275e78677",
                        "entry_id": "9af44ebf-e625-3e79-8877-4c83bff2bfb9",
                        "glosses": [
                            "dingen die iemand nodig heeft"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3977a0cf-6252-47d4-9c39-b775aabdd4f5",
                                "sense_id": "ede33b69-e919-3fdc-b644-0ee275e78677",
                                "text": "Van wrakstukken, natuurlijke materialen en door de bemanning achtergelaten benodigdheden wist de scheepsjongen enkele hutten en een versterkt ‘kasteel’ te bouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2c5f3aa-f181-35bf-9f03-5fe489a481ca",
                        "entry_id": "9af44ebf-e625-3e79-8877-4c83bff2bfb9",
                        "glosses": [
                            "voorwerp of handeling als voorgeschreven onderdeel van een ritueel"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2a95054a-4315-4488-babc-95e1199dcc33",
                                "sense_id": "f2c5f3aa-f181-35bf-9f03-5fe489a481ca",
                                "text": "Wat me hier gebracht heeft... precies wat jij afgoderij had genoemd! Ik ben gekome om je een bijdrage te verzoeken. Wij allemaal in die familie moeten onze benodigdheden gaan doen."
                            }
                        ]
                    }
                ],
