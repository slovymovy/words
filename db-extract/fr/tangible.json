        "fr-extract.jsonl": [
            {
                "entry_id": "e8f7ecd6-e887-327b-902f-e3878cf46849",
                "word": "tangible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5a38415b-38cc-444a-aa73-eef0614a41d7",
                        "entry_id": "e8f7ecd6-e887-327b-902f-e3878cf46849",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "tangibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b54c085-18b4-3d25-8ee5-1eae5a4c36e6",
                        "entry_id": "e8f7ecd6-e887-327b-902f-e3878cf46849",
                        "glosses": [
                            "Qui peut être touché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aadecc15-cd79-4d4e-9ee0-2770217df9fc",
                                "sense_id": "7b54c085-18b4-3d25-8ee5-1eae5a4c36e6",
                                "text": "L'armée est la manifestation la plus claire, la plus tangible et la plus solidement rattachée aux origines que l'on puisse avoir de l'État."
                            },
                            {
                                "example_id": "ae74565c-efd7-4d17-909e-4aa05271351d",
                                "sense_id": "7b54c085-18b4-3d25-8ee5-1eae5a4c36e6",
                                "text": "[…], Mimile faisait de temps à autre claquer vigoureusement son fouet pour, d’une façon précise et tangible, rappeler au sentiment de la discipline ses tributaires encornés se bousculant dans les ornières boueuses de l’étroit chemin."
                            },
                            {
                                "example_id": "b5c69959-c342-44d1-b6e7-75dcf449cc6b",
                                "sense_id": "7b54c085-18b4-3d25-8ee5-1eae5a4c36e6",
                                "text": "La victoire armée du peuple cubain sur la dictature de Batista […] a démontré de façon tangible que, par la guérilla, un peuple peut se libérer d'un gouvernement qui l’opprime."
                            },
                            {
                                "example_id": "0bd3010e-ba13-47ab-949c-5f2cc164534b",
                                "sense_id": "7b54c085-18b4-3d25-8ee5-1eae5a4c36e6",
                                "text": "Il fallait, aussi, substituer aux grandes percées, rocades ou radiales, la continuation du réseau viaire parisien, en abandonnant la multitude d’alignements nouveaux envisagés à la période précédente et dont le résultat le plus tangible avait été la création de ces « dents creuses » qui déparent tant de rues parisiennes, sans espoir de voir l’alignement général de la voie réalisé dans un délai raisonnable."
                            },
                            {
                                "example_id": "f6a635be-a99f-4fdf-96f6-8be7646ce4a9",
                                "sense_id": "7b54c085-18b4-3d25-8ee5-1eae5a4c36e6",
                                "text": "Comment ?… une femme noire oser, même en paroles, se rebeller contre l’autorité maritale et essayer de tenir tête à ses démonstrations habituelles tangibles et ultra-convaincantes ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2f851e2-f0db-41e7-a311-0b7d7718649a",
                        "source_entry_id": "e8f7ecd6-e887-327b-902f-e3878cf46849",
                        "source_sense_id": "7b54c085-18b4-3d25-8ee5-1eae5a4c36e6",
                        "target_lang_word": "tangible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tangible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89d4ba3a-9747-35ca-a451-475ac63efcb3",
                                        "entry_id": "581ccbd6-817e-3d0c-a94a-f95bc5275b28",
                                        "glosses": [
                                            "Touchable; able to be touched or felt; perceptible by the sense of touch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cce98a2-65f1-384e-885b-c057201a60ec",
                                        "entry_id": "581ccbd6-817e-3d0c-a94a-f95bc5275b28",
                                        "glosses": [
                                            "Perceptible; able to be perceived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610a369b-5fb6-4274-81a7-129c9ead637f",
                                                "sense_id": "0cce98a2-65f1-384e-885b-c057201a60ec",
                                                "text": "While the SCP universe is, of course, filled with things that we would certainly not consider \"real\", most of the SCPs are tangible or perceivable in some way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edcca2c8-cf07-35a2-8d89-6c6adb7e3942",
                                        "entry_id": "581ccbd6-817e-3d0c-a94a-f95bc5275b28",
                                        "glosses": [
                                            "Able to be treated as fact; real or concrete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65dddc07-9734-4479-b2d3-9fe65cadb025",
                                                "sense_id": "edcca2c8-cf07-35a2-8d89-6c6adb7e3942",
                                                "text": "And for Rodgers, who cleaned up with Celtic in Scotland, this was another significant addition to his CV, as his expert guidance of Leicester - who are in a strong position to finish in the Premier League's top four and face Chelsea again at Stamford Bridge on Tuesday - now has a tangible reward in the shape of the FA Cup."
                                            },
                                            {
                                                "example_id": "9c9a5a39-f252-4e32-8b52-3eb1c7bbd948",
                                                "sense_id": "edcca2c8-cf07-35a2-8d89-6c6adb7e3942",
                                                "text": "Leaders say they have struggled with the latest generation's tangible challenges, including being late to work and meetings often, not wearing office-appropriate clothing, and [not] using language appropriate for the workspace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5ec410e-a4eb-3d5d-b3de-646c2049c28a",
                                        "entry_id": "581ccbd6-817e-3d0c-a94a-f95bc5275b28",
                                        "glosses": [
                                            "Comprehensible by the mind; understandable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tangible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fe64400-7648-320d-a3d9-fe275e333b9a",
                                        "entry_id": "99a105fa-8e2b-33b1-bf76-7f1d3c0503fb",
                                        "glosses": [
                                            "A physical object; something that can be touched."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5dcdcf4-cf7f-3151-a50d-66da21c661e8",
                                        "entry_id": "99a105fa-8e2b-33b1-bf76-7f1d3c0503fb",
                                        "glosses": [
                                            "Real or concrete results."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "417a3f69-be2c-4864-b7db-a69778b83e2d",
                                                "sense_id": "b5dcdcf4-cf7f-3151-a50d-66da21c661e8",
                                                "text": "Yes, but what are the tangibles?"
                                            }
                                        ]
                                    }
                                ]
                            }
