                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "77403234-4954-4ca8-adcd-3fae0435a5fc",
                                "sense_id": "8c468d03-aa63-36fd-a772-0c14b7aac5f2",
                                "text": "A la façon dont je serais appelé, à la pension Beauséjour, j’apprendrais vite à savoir quel sort me serait réservé : Etienne Lieutaud servirait aux jours de sortie et aux rencontres de ma mère avec M. Sarrazin."
                            }
                        ]
                    }
