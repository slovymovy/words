                "senses": [
                    {
                        "sense_id": "e31e1697-153b-39a3-8565-0c58544318ea",
                        "entry_id": "f4b480f7-1089-3f39-ba8b-4999d0aa9303",
                        "glosses": [
                            "Artiste dont la création suit les principes du cubisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea520c83-10a2-415f-9faa-60d005e3a141",
                                "sense_id": "e31e1697-153b-39a3-8565-0c58544318ea",
                                "text": "Cézanne est un précurseur des cubistes."
                            },
                            {
                                "example_id": "79bf68ad-039d-486b-b776-e6d40efbb46a",
                                "sense_id": "e31e1697-153b-39a3-8565-0c58544318ea",
                                "text": "Par analogie il sera capable de distinguer deux peintres ou deux musiciens, puis, par la suite, de généraliser ses acquis et de distinguer un peintre impressionniste d’un cubiste, un musicien baroque d’un romantique par exemple."
                            }
                        ]
                    }
                ],
