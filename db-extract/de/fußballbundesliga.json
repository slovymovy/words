                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea41a1df-b188-4928-9ffd-56c91ab430ca",
                                "sense_id": "9dbbb0a2-97c2-3e4c-8ef5-e6643e1453a5",
                                "text": "Wir sehen uns am Wochenende ein Spiel in der Fußballbundesliga im Stadion an."
                            },
                            {
                                "example_id": "2f57e67e-a64f-4804-9a2e-6329f75fdb83",
                                "sense_id": "9dbbb0a2-97c2-3e4c-8ef5-e6643e1453a5",
                                "text": "Der Verein ist nun endlich in die Fußballbundesliga aufgestiegen."
                            },
                            {
                                "example_id": "2f65645d-cdca-4421-878c-b8d55f1ea0ce",
                                "sense_id": "9dbbb0a2-97c2-3e4c-8ef5-e6643e1453a5",
                                "text": "Marei interessiert sich nicht sehr für den Saisonverlauf in den Fußballbundesligen. Sie schaut nur die Spiele der Nationalmannschaften."
                            }
                        ],
