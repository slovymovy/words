                ],
                "senses": [
                    {
                        "sense_id": "32ce92b8-17c8-357e-aaf1-ce570e022205",
                        "entry_id": "90227bf0-f6b5-3324-b109-ec1cdf32ce38",
                        "glosses": [
                            "lasterhafter Ort, Stätte sündiger Ausschweifungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ab5fb2-268e-49e5-b36b-b1471e019738",
                                "sense_id": "32ce92b8-17c8-357e-aaf1-ce570e022205",
                                "text": "„Evangelikale Netzwerke schicken sich nämlich derzeit an, im Sündenbabel Hollywood Fuß zu fassen und aufzuräumen.“"
                            },
                            {
                                "example_id": "520b4c9b-cf48-4d84-bce8-cb3f36b58a57",
                                "sense_id": "32ce92b8-17c8-357e-aaf1-ce570e022205",
                                "text": "„Solche Maßnahmen verstäkrten die Kluft zwischen Stadt und Land und führten dazu, dass gerade die Mujahedin Kabul als ein «Sündenbabel» sahen, «wo Frauen nackt herumliefen».“"
                            },
                            {
                                "example_id": "98bdf9cd-915d-45fe-80b4-d23b1b3e54cd",
                                "sense_id": "32ce92b8-17c8-357e-aaf1-ce570e022205",
                                "text": "„Als wir Neulinge unser künftiges Aufgabengebiet zugeteilt bekamen, wurde ich in die Hölle geschickt – zur Sittenpolizei. Ich war inzwischen seit etwa drei Jahren verheiratet, und Frau Sunao Adelstein war nicht gerade erfreut darüber, dass ich mich ins Sündenbabel begeben sollte.“"
                            },
                            {
                                "example_id": "921cf239-944a-49b9-9350-22bde2996516",
                                "sense_id": "32ce92b8-17c8-357e-aaf1-ce570e022205",
                                "text": "„Siegel sollte einer der zu trauriger Berühmtheit gelangten Murder Inc. werden, später Gründervater des Sündenbabels Las Vegas und offizieller Erpresser der Mafia in Hollywood.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
