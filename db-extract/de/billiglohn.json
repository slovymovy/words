                "senses": [
                    {
                        "sense_id": "1132e91a-3bd1-321c-9399-270d0a56ab76",
                        "entry_id": "734dc454-138b-3305-9d8a-7b55a2b67908",
                        "glosses": [
                            "unter dem Durchschnitt liegende Bezahlung für eine Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d8fadd-5a81-421c-b860-cd32e8ddc6fe",
                                "sense_id": "1132e91a-3bd1-321c-9399-270d0a56ab76",
                                "text": "Für die Arbeit als Putzfrau bekommt sie nur einen Billiglohn."
                            },
                            {
                                "example_id": "4b0322c9-22a1-4b30-92ad-a805adf24690",
                                "sense_id": "1132e91a-3bd1-321c-9399-270d0a56ab76",
                                "text": "Viele ausländische Arbeitskräfte bekommen nur einen Billiglohn."
                            },
                            {
                                "example_id": "61fd7d3c-73ab-4d67-a47a-5bb13aae93ea",
                                "sense_id": "1132e91a-3bd1-321c-9399-270d0a56ab76",
                                "text": "„Für Billiglöhne arbeiteten sie in den Städten oder als Vorarbeiter auf den Plantagen.“"
                            }
                        ],
