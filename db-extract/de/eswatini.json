                "senses": [
                    {
                        "sense_id": "f8014f2d-ef75-3a4a-8c05-ff2766c6547b",
                        "entry_id": "ae8e6f2c-4920-3b8b-9a20-b8f56057a813",
                        "glosses": [
                            "Staat im südlichen Afrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03246dc1-5e1a-41c0-b638-56ff37ab958a",
                                "sense_id": "f8014f2d-ef75-3a4a-8c05-ff2766c6547b",
                                "text": "„Eswatini (bis 19. April 2018 Swasiland) wurde 1968 von Großbritannien unabhängig. Seit der Aufhebung der britischen Verfassung durch König Sobhuza II, dem Vater des jetzigen Königs Mswati III, im Jahr 1973 wird Eswatini als absolute Monarchie regiert, die letzte Afrikas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1169c648-d226-4ad9-ad65-0fbef5cda5dc",
                        "source_entry_id": "ae8e6f2c-4920-3b8b-9a20-b8f56057a813",
                        "source_sense_id": "f8014f2d-ef75-3a4a-8c05-ff2766c6547b",
                        "source_sense_description": "Staat im südlichen Afrika",
                        "target_lang_word": "Eswatini",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eswatini",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30a97607-cc37-33bf-81f9-69b17f37a40b",
                                        "entry_id": "412cb8c5-eea2-3b03-833c-cc3927398c7d",
                                        "glosses": [
                                            "A country in Southern Africa, formerly called Swaziland. Official name: Kingdom of Eswatini. Capitals: Mbabane and Lobamba."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6e8dc2-8718-4203-a0f5-268a04e37df2",
                                                "sense_id": "30a97607-cc37-33bf-81f9-69b17f37a40b",
                                                "text": "Taiwan's ambassador to the Kingdom of Eswatini, Jeremy Liang (梁洪昇), told the paper that he had just been informed of the situation and that \"the matter was being looked into.\" Liang said he had helped the students process their applications to the university and had not been aware of the conditions of the workplace they were to be assigned to."
                                            },
                                            {
                                                "example_id": "10b16971-feba-4b83-9a66-212aeafe64bc",
                                                "sense_id": "30a97607-cc37-33bf-81f9-69b17f37a40b",
                                                "text": "In February, Mswati announced that he had recovered from Covid-19 after undergoing treatment “for a couple of days” with an undisclosed antiviral medication from Taiwan. Eswatini enjoys a blossoming diplomatic tie with Taiwan — currently the East Asian country’s only ally in Africa."
                                            },
                                            {
                                                "example_id": "f528da4c-7db4-4264-abdb-837698487143",
                                                "sense_id": "30a97607-cc37-33bf-81f9-69b17f37a40b",
                                                "text": "Governed by a monarch who has absolute power, Eswatini is one of four African countries that have struck a deal with the Trump administration to receive foreign deportees, along with Rwanda, South Sudan and Uganda."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78b98bf0-7fd0-401f-894b-67bce7f3b6bd",
                        "source_entry_id": "ae8e6f2c-4920-3b8b-9a20-b8f56057a813",
                        "source_sense_id": "f8014f2d-ef75-3a4a-8c05-ff2766c6547b",
                        "source_sense_description": "Staat im südlichen Afrika",
                        "target_lang_word": "eSwatini",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eSwatini",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e494e9fa-a39b-31ae-8b8f-051e574e6924",
                                        "entry_id": "897a59c9-2e17-324a-a573-baf58af62ea3",
                                        "glosses": [
                                            "Alternative letter-case form of Eswatini."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b35269d-6a1a-4711-9e8d-ce8830e9bf93",
                                                "sense_id": "e494e9fa-a39b-31ae-8b8f-051e574e6924",
                                                "text": "As this tiny Kingdom of eSwatini joins the rest of the world in commemorating the International Mother Language Day, an event celebrated on February 21, every year, one cannot resist the temptation of penning a piece to remind the Swazi nation about the essence of the mother tongue in the society."
                                            },
                                            {
                                                "example_id": "f40656af-e9eb-41bb-82e4-55b5ce13d1ae",
                                                "sense_id": "e494e9fa-a39b-31ae-8b8f-051e574e6924",
                                                "text": "The Kingdom of eSwatini would also like to commend the leadership of the new Secretary-General, who is committed to transforming the UN to be fit for the 21st century."
                                            },
                                            {
                                                "example_id": "37efc46d-94be-4bd1-affb-3f2ebf920e71",
                                                "sense_id": "e494e9fa-a39b-31ae-8b8f-051e574e6924",
                                                "text": "Therefore, I have the pleasure to present to you, on this historic day, a new name for the kingdom. Our country will now be called: “Kingdom of eSwatini”."
                                            },
                                            {
                                                "example_id": "d25ddf8a-1a76-421b-ab90-68938c0c961c",
                                                "sense_id": "e494e9fa-a39b-31ae-8b8f-051e574e6924",
                                                "text": "Time will tell if Swaziland—er, eSwatini—has better luck."
                                            },
                                            {
                                                "example_id": "8337da65-5509-4c83-90c4-646960220a9b",
                                                "sense_id": "e494e9fa-a39b-31ae-8b8f-051e574e6924",
                                                "text": "But the acting eSwatini President of the Economic Freedom Fighters accused the military of having a more sinister purpose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aea8b031-ef68-4c76-827e-44075f8e61b5",
                        "source_entry_id": "ae8e6f2c-4920-3b8b-9a20-b8f56057a813",
                        "source_sense_id": "f8014f2d-ef75-3a4a-8c05-ff2766c6547b",
                        "source_sense_description": "Staat im südlichen Afrika",
                        "target_lang_word": "Eswatini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eswatini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "249e7a32-9107-3db7-adb9-703bbf588003",
                                        "entry_id": "55d50f07-9387-37bb-baef-6351f7f89bb0",
                                        "glosses": [
                                            "Pays situé en Afrique australe, entre l’Afrique du Sud et le Mozambique. Il a pour capitales Mbabane et Lobamba."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b726dfbe-53dc-4ef5-93af-8b777423422f",
                                                "sense_id": "249e7a32-9107-3db7-adb9-703bbf588003",
                                                "text": "Yann PRADEAU, Ambassadeur de France au Mozambique et en Eswatini."
                                            },
                                            {
                                                "example_id": "b5154c7f-43de-4e25-a48c-04a5601d4636",
                                                "sense_id": "249e7a32-9107-3db7-adb9-703bbf588003",
                                                "text": "Ce projet vise à aider le Ministère des affaires étrangères et de la coopération internationale d’Eswatini à renforcer les capacités permettant au Gouvernement de mobiliser sa diaspora aux fins du développement social et économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daf77c3a-e16e-49e8-84a3-d4107d788697",
                        "source_entry_id": "ae8e6f2c-4920-3b8b-9a20-b8f56057a813",
                        "source_sense_id": "f8014f2d-ef75-3a4a-8c05-ff2766c6547b",
                        "source_sense_description": "Staat im südlichen Afrika",
                        "target_lang_word": "eSwatini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eSwatini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fc27100-ed2a-34b5-90b7-ac0bf4d8d369",
                                        "entry_id": "20ee3893-d5a0-3218-bc72-ad306e14eb19",
                                        "glosses": [
                                            "Pays situé en Afrique australe, entre l’Afrique du Sud et le Mozambique. Il a pour capitales Mbabane et Lobamba."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a3c1e5-d744-4cff-9e58-992dff83e8c7",
                                                "sense_id": "9fc27100-ed2a-34b5-90b7-ac0bf4d8d369",
                                                "text": "Le roi avait déjà utilisé à plusieurs reprises ces dernières années le nom « eSwatini », qui signifie « le pays des Swazis » dans la langue locale, y compris lors de son discours devant l’Assemblée générale de l’Onu en 2017. Mswati III a expliqué ce changement d’appellation par le fait que le nom « Swaziland » semait la confusion à l’étranger où il était selon lui souvent confondu avec celui de « Switzerland », la Suisse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
