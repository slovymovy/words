                        "examples": [
                            {
                                "example_id": "25b6efbc-12ac-4a57-b8c9-c61e45c34ef7",
                                "sense_id": "dfd746de-954e-3a13-b9fa-10a15f8c2276",
                                "text": "La collection Défis est ouverte, comme l’avenir que ne sauraient pré-circonscrire nos prêts-à-penser."
                            },
                            {
                                "example_id": "f139bab0-55b2-4f95-9c4b-fe645679b9f3",
                                "sense_id": "dfd746de-954e-3a13-b9fa-10a15f8c2276",
                                "text": "Dans celle de Corneille, on invente à titre vulgarisant (je veux dire pour un public qui ne sera pas pré-circonscrit, et dans un langage qui ne s’interdira aucun type de pensée et de parole) un mode d’existence en société, un mixage aléatoire (…)"
                            }
                        ]
