                    "common_phrases": [
                        "keep possession",
                        "lose possession",
                        "regain possession"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контроль над мячом или шайбой во время спортивной игры.",
                        "zh": "在体育比赛中对球的控制权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владе́ние",
                                "target_lang_sense_clarification": "мячом или шайбой в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "控球",
                                "target_lang_sense_clarification": "指在比赛中控制球权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9089ad7c-938e-3f6a-a038-e6def2de044d",
                    "sense_definition": "A territory under the rule of another country.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "territory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The island was once a French <w>possession</w> in the Caribbean.",
                            "target_lang_translations": {
                                "ru": "Остров когда-то был французским <w>владением</w> в Карибском море.",
                                "zh": "这座岛屿曾是法国在加勒比海的一块<w>属地</w>。"
                            }
