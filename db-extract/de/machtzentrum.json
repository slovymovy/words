                ],
                "senses": [
                    {
                        "sense_id": "4eca0b20-e026-30ee-9a08-ac8f4eb1a79b",
                        "entry_id": "9a035b52-85ea-3772-be98-f47be9089b97",
                        "glosses": [
                            "Person/Institution, von der wesentliche Entscheidungen für ihren Bereich getroffen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae243947-96a3-4375-b5bb-3184b412cb9d",
                                "sense_id": "4eca0b20-e026-30ee-9a08-ac8f4eb1a79b",
                                "text": "„Das Machtzentrum im Ort ist das Gutshaus.“"
                            },
                            {
                                "example_id": "08a9ff29-1e8e-4201-be4f-e6cb2c7dd55f",
                                "sense_id": "4eca0b20-e026-30ee-9a08-ac8f4eb1a79b",
                                "text": "„Und im Machtzentrum lauerte Verrat.“"
                            },
                            {
                                "example_id": "06087e79-d1f8-4ac0-bc44-7d77f17a20aa",
                                "sense_id": "4eca0b20-e026-30ee-9a08-ac8f4eb1a79b",
                                "text": "„Das Volkstribunat, das sich in den vergangenen Dekaden zum eigentlichen Machtzentrum entwickelt hatte, schaffte er ab.“"
                            },
                            {
                                "example_id": "404d9a8f-524d-4fb0-bcdf-e007cc211656",
                                "sense_id": "4eca0b20-e026-30ee-9a08-ac8f4eb1a79b",
                                "text": "„Neue Akzente im Ringen der streitenden Reiche wurden im 9. Jahrhundert gesetzt, als die Rashtrakutas, einst Vasallen der Chalukyas, ihr Machtzentrum im nördlichen Teil des Hochlands errichteten, während gleichzeitig die Gurjaras-Pratiharas in Kanauj ihre Herrschaft festigten und im Osten die Pala-Dynastie eine Reihe fähiger Herrscher hervorbrachte.“"
                            },
                            {
                                "example_id": "05e5d95f-eeb5-4083-8936-7e5d2d2987dd",
                                "sense_id": "4eca0b20-e026-30ee-9a08-ac8f4eb1a79b",
                                "text": "„Viele betrachten daher das Hauptquartier der Armee, das sich in Rawalpindi in direkter Nachbarschaft von Islamabad befindet, als das eigentliche Machtzentrum Pakistans.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
