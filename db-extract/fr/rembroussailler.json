                ],
                "senses": [
                    {
                        "sense_id": "1d01a313-cec8-399b-b429-6e1f6d8473c5",
                        "entry_id": "8fc97e66-03d0-3606-b355-bf211ea9c737",
                        "glosses": [
                            "Embroussailler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7758f9e-0927-4aa3-87d9-df952bdc79e2",
                                "sense_id": "1d01a313-cec8-399b-b429-6e1f6d8473c5",
                                "text": "Le lecteur voudra bien par sa lecture laisser repousser la végétation, retrouver les allées « buissonnières », rembroussailler les lieux pour les remettre en l'état où nous les avons trouvés en y pénétrant."
                            },
                            {
                                "example_id": "58d86364-f5b0-4ed0-bd09-c38c78ef36b0",
                                "sense_id": "1d01a313-cec8-399b-b429-6e1f6d8473c5",
                                "text": "Mais il sera impossible, non de reboiser, mais même de « rembroussailler » tant que le bétail vagabondera sur les pentes."
                            },
                            {
                                "example_id": "5bd9c161-5adf-4736-8f4e-315fa33458c2",
                                "sense_id": "1d01a313-cec8-399b-b429-6e1f6d8473c5",
                                "text": "J’ai fait appel aux sapeurs pompiers pour débroussailler, et pour que ça ne se rembroussaille pas, j’ai fait mettre cet éleveur, j’ai pas trouvé de moutons."
                            }
                        ]
                    }
                ],
