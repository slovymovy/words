                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyhistor",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "aa59656c-025d-339b-9a17-28c6b1073700",
                                        "entry_id": "3513c37d-7208-3f2e-b44e-6688f773167d",
                                        "glosses": [
                                            "člověk, který se orientuje (nebo dokonce exceluje, vyniká) ve více oborech, zejména od sebe navzájem vzdálených"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb385a6-399f-4a2d-83e7-977974f595b1",
                                                "sense_id": "aa59656c-025d-339b-9a17-28c6b1073700",
                                                "text": "Typickými polyhistory byli Leonardo da Vinci nebo náš Jára da Cimrman."
                                            }
                                        ]
