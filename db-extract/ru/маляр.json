                    }
                ],
                "senses": [
                    {
                        "sense_id": "025721c9-0f4c-388e-80e5-47860065442a",
                        "entry_id": "e9f352e8-0ef0-391f-902c-46b8b7193244",
                        "glosses": [
                            "рабочий, специалист, занимающийся окраской зданий, сооружений, оборудования, инструмента и прочих предметов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560066f9-5eb2-48d1-a4ce-2489198b234d",
                                "sense_id": "025721c9-0f4c-388e-80e5-47860065442a",
                                "text": "Арестант, бывший на родине плотником, несет здесь настоящую каторгу, и в этом отношении он гораздо несчастливее маляра или кровельщика."
                            },
                            {
                                "example_id": "62adb5d8-16f1-47da-84c7-30632bd7a643",
                                "sense_id": "025721c9-0f4c-388e-80e5-47860065442a",
                                "text": "Сотни маляров торопливо мазали длинными кистями фасады зданий, акробатически бесстрашно покачиваясь высоко в воздухе, подвешенные на веревках, которые издали казались тоненькими нитками."
                            },
                            {
                                "example_id": "ef5930b3-5fbb-4378-a389-c7e138fb8073",
                                "sense_id": "025721c9-0f4c-388e-80e5-47860065442a",
                                "text": "Подле реставрированных тщанием Главнауки Красных ворот расположились заляпанные известкой маляры со своими саженными кистями, плотники с пилами, штукатуры и каменщики."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a7bf0ec-e6d0-3ab9-b30b-c34a2ca28ddb",
                        "entry_id": "e9f352e8-0ef0-391f-902c-46b8b7193244",
                        "glosses": [
                            "перен. плохой художник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8385a9b-c8f4-4bbc-a547-a8381215b098",
                                "sense_id": "6a7bf0ec-e6d0-3ab9-b30b-c34a2ca28ddb",
                                "text": "Некоторые товарищества состоят всего-навсего из двух человек, между которыми все-таки существует трогательное согласие в том, что художники прочих групп ― маляры и бездарности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92efd6b4-769a-492f-9b96-7dd4bba0e3bd",
                        "source_entry_id": "e9f352e8-0ef0-391f-902c-46b8b7193244",
                        "source_sense_description": "рабочий по покраске",
                        "target_lang_word": "painter",
