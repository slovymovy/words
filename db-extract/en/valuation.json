                                "target_senses": [
                                    {
                                        "sense_id": "9d001e83-ff80-3398-a3a5-13c502ce3147",
                                        "entry_id": "b2bdacc8-0c7f-3356-a3a0-4b47b5717960",
                                        "glosses": [
                                            "ungefährer Wert, der durch Schätzung ermittelt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931780f4-51c7-441d-8cfd-73f8fadc86e4",
                                                "sense_id": "9d001e83-ff80-3398-a3a5-13c502ce3147",
                                                "text": "Der Schätzwert des Bildes lag deutlich über den Erwartungen der Interessenten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2023ecc-f892-4316-9184-ec84b669a9e0",
                        "source_entry_id": "cc53e694-5892-3ebc-86c4-74439bc51466",
                        "source_sense_id": "2040309a-2249-3bc1-a9eb-57fa5bc3a989",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Schätzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schätzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                        "entry_id": "fed284b8-7460-3d27-a746-f8307f2faa21",
                                        "glosses": [
                                            "grobe ungefähre oder vorläufige Einstufung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9a98c3-d8ba-4432-9fa4-ee27fdfcad8c",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "Nach ersten Schätzungen wird das Geld nicht reichen."
                                            },
                                            {
                                                "example_id": "7acd4aa8-76e9-4a41-b1fe-0f93f80ef5b3",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Es handelt sich offenbar um approximative und ungesicherte Schätzungen; aber die Größenordnungen und Gesamtentwicklungen können als tragfähig gelten.“"
                                            },
                                            {
                                                "example_id": "b2130b37-52b0-48e1-b56e-b4461c152dac",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Schätzungen gehen davon aus, dass der Kohlendioxidgehalt der Atmosphäre in der Oberkreide vor knapp 100 Millionen Jahren – bedingt durch die große vulkanische Aktivität auf der Erde – etwa fünf- bis zehnmal so hoch war wie heute.“"
                                            },
                                            {
                                                "example_id": "b214d17e-51ac-4e7a-b7a8-e69598b3c9ba",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Unsere Arbeitsaufteilung war jedenfalls klar: Ich würde mich um die Begutachtung und Schätzung der für uns relevanten Gegenstände kümmern und Amalia sich ums Verhandeln, Vergraulen der Konkurrenz und Knüpfen von Kontakten.“"
                                            },
                                            {
                                                "example_id": "decf02a6-3d70-479d-9be0-830fbd125bd6",
                                                "sense_id": "b5eded53-c189-3df9-baea-0427225abdf5",
                                                "text": "„Die Schätzung Prudhommes nahm er für wahr: genau eine Million Opfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e187f799-a190-3ebf-8e49-a4f03b160f61",
                                        "entry_id": "fed284b8-7460-3d27-a746-f8307f2faa21",
                                        "glosses": [
                                            "hohe Wertung einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d14fb1b-e4db-41cc-9b75-69a2d36232e2",
                                                "sense_id": "e187f799-a190-3ebf-8e49-a4f03b160f61",
                                                "text": "Die Schätzung der Dorfältesten war Tradition."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cca1550f-a548-4957-b7d7-b7d1d9400b2a",
                        "source_entry_id": "cc53e694-5892-3ebc-86c4-74439bc51466",
                        "source_sense_id": "2040309a-2249-3bc1-a9eb-57fa5bc3a989",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Bewertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                        "entry_id": "d44be6a1-8671-3d1d-9731-593a577de843",
                                        "glosses": [
                                            "Vorgang, der den Wert von etwas abschätzt, festlegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9759dd1e-7e58-4a16-bba4-97ba8ae994da",
                                                "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                                "text": "Trotz intensiven Trainings bekam die Turnerin in der Bewertung nur fünf Punkte."
                                            },
                                            {
                                                "example_id": "e33ed869-bb76-44cd-b57b-d21943030559",
                                                "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                                "text": "Die Bewertungen der Schüler fielen in diesem Jahr im Schnitt schlechter aus, als im letzten Jahr."
                                            },
                                            {
                                                "example_id": "697d5c7f-81b1-4550-9931-840473228593",
                                                "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                                "text": "Die Bewertung durch die Kritiker wird dem Kunstwerk nicht gerecht."
                                            },
                                            {
                                                "example_id": "84d208c1-800e-41a9-ae47-6c2ad90ae56c",
                                                "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                                "text": "„Sprachkritik ist die Beschreibung, Analyse und Bewertung von sprachlichen Äußerungen.“"
                                            },
                                            {
                                                "example_id": "c9f5ca4e-7f3a-4f61-aede-d98918fa14b0",
                                                "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                                "text": "„Die schlechte Bewertung bezüglich der Bearbeitungszeit der Asylanträge ist den damals gegebenen Begleitumständen, die plötzlich rapide ansteigende Anzahl von Asylanträgen, zuzuschreiben.“"
                                            },
                                            {
                                                "example_id": "cf56a053-00cc-4061-978f-43696b3493cb",
                                                "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                                "text": "„Und wo Bewertungen sind, da gibt es auch Rang- und Positionsunterschiede."
                                            },
                                            {
                                                "example_id": "9073216a-8824-4fc1-ab4a-56c0e245b762",
                                                "sense_id": "809c8c56-b06b-3181-8597-1b4424846b6c",
                                                "text": "„Für die völkerrechtliche Bewertung der israelischen Kriegsverbrechen in Gaza ist das Srebrenica-Urteil von 2007 des Internationalen Gerichtshofs maßgeblich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
