                        ],
                        "examples": [
                            {
                                "example_id": "44632d48-47f5-431e-9ef1-ee5423c596f2",
                                "sense_id": "c14db4cf-3504-3d3a-9d3c-68d75565f724",
                                "text": "In dem Satz „Es geschah, als es dunkel wurde“ ist der Gliedsatz „als es dunkel wurde“ ein Temporalsatz; er macht eine Zeitangabe. Viele Temporalsätze werden mit „als“, „bevor“, „nachdem“, „während“ und ähnlichen Subjunktionen eingeleitet."
                            }
                        ],
