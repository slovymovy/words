                    "frequency": "Low",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>philosophes</w> des Lumières ont combattu les préjugés et l'intolérance religieuse."
                        },
                        {
                            "text": "Ce <w>philosophe</w> soutenait ardemment le projet démocratique et la liberté d'expression."
