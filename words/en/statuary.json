{
    "word_family": [
        "statue",
        "statuesque",
        "statuette"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5226cd8e-88b1-39ac-8db9-a237dc7022d0",
                    "sense_definition": "Statues considered collectively as a group or art form.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "statues",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The palace garden was renowned for its classical marble <w>statuary</w> depicting mythological scenes.",
                            "target_lang_translations": {
                                "ru": "Дворцовый сад славился своей классической мраморной <w>скульптурой</w>, изображающей мифологические сюжеты."
                            }
                        },
                        {
                            "text": "Visitors admired the ancient Roman <w>statuary</w> preserved in the main gallery of the museum.",
                            "target_lang_translations": {
                                "ru": "Посетители восхищались древнеримскими <w>статуями</w>, сохранившимися в главной галерее музея."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpture",
                        "statues"
                    ],
                    "common_phrases": [
                        "classical statuary",
                        "garden statuary",
                        "marble statuary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Статуи, рассматриваемые собирательно как группа или вид искусства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скульптура",
                                "target_lang_sense_clarification": "совокупность статуй"
                            },
                            {
                                "target_lang_word": "статуи",
                                "target_lang_sense_clarification": "множество изваяний"
                            },
                            {
                                "target_lang_word": "изваяния",
                                "target_lang_sense_clarification": "скульптурные изображения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ab44689-991b-3676-a368-279baece3e3c",
                    "sense_definition": "The art or craft of making statues.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the Renaissance, the art of <w>statuary</w> reached new heights of realistic detail.",
                            "target_lang_translations": {
                                "ru": "В эпоху Возрождения искусство <w>ваяния</w> достигло новых высот реалистичной детализации."
                            }
                        },
                        {
                            "text": "He apprenticed under a master to learn bronze casting and the fundamentals of <w>statuary</w>.",
                            "target_lang_translations": {
                                "ru": "Он поступил в ученики к мастеру, чтобы освоить литьё из бронзы и основы <w>скульптурного искусства</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpting",
                        "sculpture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство или ремесло создания статуй."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скульптура",
                                "target_lang_sense_clarification": "вид изобразительного искусства"
                            },
                            {
                                "target_lang_word": "ваяние",
                                "target_lang_sense_clarification": "традиционное или возвышенное обозначение искусства лепки и резьбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82fd14da-84b4-35e3-9479-50a3ee9df8cd",
                    "sense_definition": "A sculptor or dealer who produces or sells statues.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>statuary</w> accepted a commission to carve a commemorative figure of the mayor.",
                            "target_lang_translations": {
                                "ru": "Местный <w>скульптор</w> принял заказ на высекание памятной фигуры мэра."
                            }
                        },
                        {
                            "text": "Several wealthy patrons visited the skilled <w>statuary</w> to inspect his latest marble carvings.",
                            "target_lang_translations": {
                                "ru": "Несколько богатых покровителей посетили искусного <w>ваятеля</w>, чтобы осмотреть его последние работы из мрамора."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculptor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English in favor of sculptor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скульптор или торговец, изготавливающий или продающий статуи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скульптор",
                                "target_lang_sense_clarification": "мастер, создающий статуи"
                            },
                            {
                                "target_lang_word": "ваятель",
                                "target_lang_sense_clarification": "устаревшее обозначение скульптора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "17749148-7551-306b-87c5-157205117a77",
                    "sense_definition": "Relating to or characteristic of statues.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statues",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer froze into a <w>statuary</w> pose at the dramatic conclusion of the performance.",
                            "target_lang_translations": {
                                "ru": "В драматическом финале выступления танцор застыл в <w>статуарной</w> позе."
                            }
                        },
                        {
                            "text": "They chose a high-grade <w>statuary</w> marble that possessed an immaculate white surface.",
                            "target_lang_translations": {
                                "ru": "Они выбрали высокосортный <w>скульптурный</w> мрамор с безупречно белой поверхностью."
                            }
                        }
                    ],
                    "synonyms": [
                        "statuesque"
                    ],
                    "common_phrases": [
                        "statuary marble",
                        "statuary pose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к статуям или свойственный им."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скульптурный",
                                "target_lang_sense_clarification": "относящийся к скульптуре или используемый для неё"
                            },
                            {
                                "target_lang_word": "статуарный",
                                "target_lang_sense_clarification": "напоминающий застывшую позу статуи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}