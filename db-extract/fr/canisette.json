                "senses": [
                    {
                        "sense_id": "02160da9-afaf-377b-af6c-85cee27483a0",
                        "entry_id": "5710a476-29b3-3416-9eef-c732de65b8af",
                        "glosses": [
                            "Petit aménagement urbain destiné à recevoir les déjections canines."
                        ],
                        "tags": [
                            "Urbanisme",
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "94b5c5fb-d7e9-4a0d-9f5f-e56ddfaaa99d",
                                "sense_id": "02160da9-afaf-377b-af6c-85cee27483a0",
                                "text": "D'ailleurs, une riveraine avait rédigé cet appel, accroché à la grille d'un immeuble de la rue : «La rue de Bizerte (XVIIe) ne veut plus être la canisette de tous les chiens du quartier. Ramassez, SVP. »"
                            },
                            {
                                "example_id": "6ffebda4-803a-4bb3-9a1f-2b3cbb4f6c53",
                                "sense_id": "02160da9-afaf-377b-af6c-85cee27483a0",
                                "text": "Il y a une canisette là-bas, lui expliqua Averil en tendant le bras vers un carré garni de cailloux, au bord de la plage. Une fois que la chienne eut fait ses besoins, elles s'engagèrent sur le sable parsemé de galets."
                            },
                            {
                                "example_id": "3a4429da-833e-4cdd-9811-98bdeebb6202",
                                "sense_id": "02160da9-afaf-377b-af6c-85cee27483a0",
                                "text": "Pour les envies pressantes des toutous, des canisettes sont aménagées."
                            }
                        ]
                    }
