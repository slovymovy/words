                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f6edde2e-7fa5-45c1-a34b-e043f17b4a7c",
                        "source_entry_id": "ecc41e59-d34f-362f-b8db-20df035e8f7a",
                        "source_sense_id": "e150ab64-c086-3527-a1d9-6f348457dfe4",
                        "target_lang_word": "奴隶贩卖",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0d781bbe-ba22-4e05-a0ae-5122f48bfd44",
                        "source_entry_id": "ecc41e59-d34f-362f-b8db-20df035e8f7a",
                        "source_sense_id": "e150ab64-c086-3527-a1d9-6f348457dfe4",
                        "target_lang_word": "Sklavenhandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sklavenhandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14189dc0-ff59-322e-badc-ad0d37f72f8e",
                                        "entry_id": "89ac542a-4068-3d48-8c73-63515542ec5c",
                                        "glosses": [
                                            "Handel mit Sklaven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa12c69e-2b7e-4dac-ad68-a1eb45291a9f",
                                                "sense_id": "14189dc0-ff59-322e-badc-ad0d37f72f8e",
                                                "text": "„Drei Tage lang wurde der Text im Kongress hitzig diskutiert und umgeändert und am Ende um ein Viertel gekürzt, vor allem um die von Jefferson selbst verfassten Absätze, die den Sklavenhandel verdammten.“"
                                            },
                                            {
                                                "example_id": "96a11602-fa58-4eb0-b5c1-6d2cb416ecc2",
                                                "sense_id": "14189dc0-ff59-322e-badc-ad0d37f72f8e",
                                                "text": "„Ich hatte eben ein Buch über den Sklavenhandel im Gebiet des Kongo veröffentlicht, und wahrscheinlich wollte man aus diesem Grund meinen Rat einholen.“"
                                            },
                                            {
                                                "example_id": "ca7c4235-4de1-4547-afaf-6920f220a08b",
                                                "sense_id": "14189dc0-ff59-322e-badc-ad0d37f72f8e",
                                                "text": "„Ich verabscheue den Sklavenhandel auf das entschiedenste und würde ihn lieber heute als morgen abgeschafft sehen.“"
                                            },
                                            {
                                                "example_id": "6262fc9e-f2a6-416b-b00f-de24151b8e97",
                                                "sense_id": "14189dc0-ff59-322e-badc-ad0d37f72f8e",
                                                "text": "„Der Sklavenhandel indes wurde international verboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d32c135-bf13-4a2c-b895-2afb750d6224",
                        "source_entry_id": "ecc41e59-d34f-362f-b8db-20df035e8f7a",
                        "source_sense_id": "e150ab64-c086-3527-a1d9-6f348457dfe4",
                        "target_lang_word": "Menschenhandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschenhandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d47ec2-4672-3d89-a916-df513b30fd09",
                                        "entry_id": "22149361-ca95-3d7d-a00b-b91f8315b687",
                                        "glosses": [
                                            "Handel mit Menschen als Ware"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9bbe8bf-69e4-43ea-9b57-6ba3be09a82c",
                                                "sense_id": "e2d47ec2-4672-3d89-a916-df513b30fd09",
                                                "text": "„Bei Menschenhandel zum Zweck der sexuellen Ausbeutung (§ 232 StGB) und Menschenhandel zum Zweck der Ausbeutung der Arbeitskraft (§ 233 StGB) handelt es sich um unterschiedliche Deliktsausprägungen, die auch hinsichtlich des Bekämpfungsansatzes (z. B. Verdachtsgewinnung und Beweisführung) in weiten Teilen differenziert betrachtet werden müssen. Deshalb werden sie im Bundeslagebild Menschenhandel getrennt beschrieben.“"
                                            },
                                            {
                                                "example_id": "91e405b2-a5dc-4728-88a4-9888cf1e32c8",
                                                "sense_id": "e2d47ec2-4672-3d89-a916-df513b30fd09",
                                                "text": "„Unter der neuen Herrschaft wird der Menschenhandel aus der zerstörten Hauptstadt Savi nach Ouidah verlegt.“"
                                            },
                                            {
                                                "example_id": "5e88b405-ae82-4fc1-95db-a19951626b36",
                                                "sense_id": "e2d47ec2-4672-3d89-a916-df513b30fd09",
                                                "text": "„Schon erstaunlich, dass die vornehmen Araber Sansibars mit dem Sklavenhandel direkt nichts zu tun haben wollten, sich aber der Sklaven für Haus- und Plantagenarbeit zu Tausenden bedienten und vom Menschenhandel auch finanziell kräftig profitierten.“"
                                            },
                                            {
                                                "example_id": "c7b19e68-7280-4df8-a513-63fdc8bfe06d",
                                                "sense_id": "e2d47ec2-4672-3d89-a916-df513b30fd09",
                                                "text": "„Schimmelmann hatte Kontakt zu Vertretern der Aufklärung, las Rousseau und Voltaire und förderte Dichter wie Matthias Claudius, der in seinen Versen den Menschenhandel kritisierte.“"
                                            },
