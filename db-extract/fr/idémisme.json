                        "glosses": [
                            "Comportement idémiste."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d9231639-0b84-49ed-9101-c6c05d9cae69",
                                "sense_id": "4d144a40-200b-33f1-a390-5ed389a5a202",
                                "text": "Le Salon des Artistes Français se modernise. Est-ce une lame de fond qui vient troubler la quiétude intellectuelle et l’idémisme de ces peintres tranquilles et le plus souvent routiniers?"
                            },
                            {
                                "example_id": "8091b2fe-3240-47b8-885b-c2b486cfc3e6",
                                "sense_id": "4d144a40-200b-33f1-a390-5ed389a5a202",
                                "text": "Donner des démentis est à la portée du premier imbécile venu. C'est une forme de l’idémisme, de l'automatisme mental. Mais réfuter une objection ! Voilà qui n'est pas votre fait."
                            },
                            {
                                "example_id": "058234e7-76fc-4a62-ab4e-d346922ed3d6",
                                "sense_id": "4d144a40-200b-33f1-a390-5ed389a5a202",
                                "text": "La satiété de la beauté connue, le désir du contraste autant que les nuances plus complexes du sentiment et les modifications de vérités reconnues ne sont-ils point propres à combattre les idémismes de l'atavisme."
                            }
                        ]
                    }
