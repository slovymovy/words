                "senses": [
                    {
                        "sense_id": "d607291c-8bad-3ca1-ad0f-7255240f0a38",
                        "entry_id": "5ff821e2-8bf3-3e69-b797-7915e5fb40c2",
                        "glosses": [
                            "große Ansammlung von Gräbern in der Antike oder in der Vorgeschichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc679f7-0ac0-4a6b-9c80-e0815f80ce25",
                                "sense_id": "d607291c-8bad-3ca1-ad0f-7255240f0a38",
                                "text": "„Auf unseren Wanderungen werden wir noch viele solcher schaurig-schönen Totenstädte durchstreifen.“"
                            },
                            {
                                "example_id": "7c634ea6-46d5-4d5c-9b8c-c602613d67fb",
                                "sense_id": "d607291c-8bad-3ca1-ad0f-7255240f0a38",
                                "text": "„Im Einzugsbereich der altägyptischen Reichshauptstadt Memphis erstreckt sich über Dutzende von Kilometern und parallel zum Verlauf des Nils eine gewaltige Nekropole. Die Totenstadt war nahezu während der gesamten 3000-jährigen pharaonischen Geschichte in Benutzung.“"
                            },
                            {
                                "example_id": "103a8b67-49dd-4daf-9a00-d532eb0bb1d8",
                                "sense_id": "d607291c-8bad-3ca1-ad0f-7255240f0a38",
                                "text": "„Neben den zufällig gefundenen Gräbern kamen bei den genauen Untersuchungen zwei riesige Begräbnisstätten und eine Nekropole, eine Totenstadt, ans Tageslicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23fb40fc-fd15-4f1b-8319-7f82254227b1",
                        "source_entry_id": "5ff821e2-8bf3-3e69-b797-7915e5fb40c2",
                        "source_sense_id": "d607291c-8bad-3ca1-ad0f-7255240f0a38",
