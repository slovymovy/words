                "senses": [
                    {
                        "sense_id": "17b08e86-0471-3e6c-9246-3a882e04936d",
                        "entry_id": "e9c4c02b-b602-3f27-8031-e1023bf86d2e",
                        "glosses": [
                            "Cueillir en plusieurs fois les fruits d’un arbre en tenant compte des degrés différents de maturité."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "34b8e584-2e55-47c0-a1a1-9704fe5b657b",
                                "sense_id": "17b08e86-0471-3e6c-9246-3a882e04936d",
                                "text": "Entre-cueillir les fruits d’un poirier."
                            },
                            {
                                "example_id": "0eaff038-9db0-436b-a0ee-d48b8bee02ae",
                                "sense_id": "17b08e86-0471-3e6c-9246-3a882e04936d",
                                "text": "Il ne faut pas oublier que les poires d’été et d’automne demandent à être entre-cueillies, c’est-à-dire qu’il faut opérer la cueillette en plusieurs fois à quelques jours d’intervalle ; sans cette précaution, tous les fruits du même arbre arrivent à maturité presque au même jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "286cfd6f-3945-3cde-b913-1c8067f4f7fa",
                        "entry_id": "e9c4c02b-b602-3f27-8031-e1023bf86d2e",
                        "glosses": [
                            "Il se dit aussi de l’arbre lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef283422-308e-4947-b545-ca4450b6549e",
                                "sense_id": "286cfd6f-3945-3cde-b913-1c8067f4f7fa",
                                "text": "Entre-cueillir un poirier."
                            }
                        ]
                    }
