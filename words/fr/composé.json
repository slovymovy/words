                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mot coffre-fort est un nom <w>composé</w> qui prend un trait d'union."
                        },
                        {
                            "text": "Certains adjectifs possèdent également une forme <w>composée</w> comme aigre-doux."
                        }
                    ],
                    "antonyms": [
