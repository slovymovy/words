                ],
                "senses": [
                    {
                        "sense_id": "5e8ce87a-38d6-31d1-8680-b2fbdf2e43a4",
                        "entry_id": "8aced2e1-0dbf-326b-a3a6-1f2c2edb2ffe",
                        "glosses": [
                            "Salat mit Wurst als Hauptbestandteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6fbcc5a-735b-426a-a734-1c543de8a447",
                                "sense_id": "5e8ce87a-38d6-31d1-8680-b2fbdf2e43a4",
                                "text": "Dein Wurstsalat schmeckt vorzüglich."
                            },
                            {
                                "example_id": "6bf341c7-bbe4-4ed5-b9ac-8c1ef6d91ff1",
                                "sense_id": "5e8ce87a-38d6-31d1-8680-b2fbdf2e43a4",
                                "text": "Den Wurstsalat bereiten wir frisch zu und er schmeckt dann wesentlich besser."
                            },
                            {
                                "example_id": "ba150cdf-7d2e-4575-9283-5cd60e848ef7",
                                "sense_id": "5e8ce87a-38d6-31d1-8680-b2fbdf2e43a4",
                                "text": "„Es gibt Wurstsalat, wie toll, ein Königreich, den ganzen Rhein und alle Kreuzfahrtschiffe für einen Wurstsalat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
