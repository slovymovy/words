                        "form": "die Fuhrparke"
                    },
                    {
                        "form_id": "d49fbb5e-d3b8-4e3d-814b-c59e0c901bf3",
                        "entry_id": "9760dcbd-04bf-30f4-9f21-80c7869f6b4a",
                        "tags": [
                            "accusative",
