                        "glosses": [
                            "een stukje geschreven tekst dat men in een dagboek schrijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e41e3837-bd09-4f86-832b-1d3f1d9dcd90",
                                "sense_id": "d1817ce2-3824-3d3e-8e49-27c7709570fa",
                                "text": "Hij bladert het schrift door en vindt het een vreemde mix van leerstof en een soort dagboeknotities. Beide stukken zijn zonder meer in hetzelfde handschrift opgetekend, al zijn de dagboekaantekeningen slordiger geschreven."
                            },
                            {
                                "example_id": "450959d2-fecc-4fb4-b06d-6369e7f6c4b9",
                                "sense_id": "d1817ce2-3824-3d3e-8e49-27c7709570fa",
                                "text": "Op scholengemeenschap Het Assink Lyceum zijn ze onder de indruk van de prestatie van de meisjes. Quinty Simmelink (13) en Elles Wiericx (14) kwamen op het idee om het wereldberoemd geworden dagboek van Anne Frank voort te zetten vanaf het moment dat het abrupt ophield. Na Annes laatste dagboekaantekening van 1 augustus 1944 hebben de twee vmbo-2 scholieren per 4 augustus de draad opgepakt: de dag waarop na het verraad van de onderduikers de bewoners van het Achterhuis worden opgepakt."
                            }
                        ]
                    }
