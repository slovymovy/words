                        "entry_id": "f5b90220-e597-3937-83de-823f20317c34",
                        "glosses": [
                            "Qui est capable d’augmenter le calibre des bronches en relâchant les fibres musculaires lisses bronchiques."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "ec1345ff-f66d-42d4-925a-c6e7db10cb09",
                                "sense_id": "e7fcb4d8-0872-3a5d-90b8-6d1a7b3ff85b",
                                "text": "Ce composé possède des propriétés sympathomimétiques indirectes, libérant les catécholamines de leurs granules de stockage, responsables de l’effet bronchodilatateur."
                            },
                            {
                                "example_id": "5947dc64-6c79-4157-9010-5e07fae19323",
                                "sense_id": "e7fcb4d8-0872-3a5d-90b8-6d1a7b3ff85b",
                                "text": "Représentation des mécanismes de l’action bronchodilatatrice de la théophylline."
                            }
                        ]
                    }
                ],
