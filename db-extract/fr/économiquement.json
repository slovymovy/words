                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d374424-d105-3b0a-911e-30061a528fe1",
                        "entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                        "glosses": [
                            "Avec économie, à peu de frais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94337bb3-3ee2-482a-aeeb-17b6cd1b5a51",
                                "sense_id": "7d374424-d105-3b0a-911e-30061a528fe1",
                                "text": "Certaines personnes essaient de vivre économiquement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b073c32-5b60-3879-b9fa-306c78aa4189",
                        "entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                        "glosses": [
                            "Selon les principes de l'économie politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c05a67e-cda8-4a88-a8d2-6e770fcbadf6",
                                "sense_id": "9b073c32-5b60-3879-b9fa-306c78aa4189",
                                "text": "La fissiparité qui accompagne les crises économiques sera d'autant plus grande que l'entité considérée sera elle-même hétérogène économiquement et politiquement : or, l'Union européenne n'est justement pas un État-nation aux aux compétences fortes, stables et incontestées."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fd8a05f-12b6-3210-8399-c48a717e885f",
                        "entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                        "glosses": [
                            "Du point de vue économique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09ad70b-baa9-4e01-a028-df1769487077",
                                "sense_id": "5fd8a05f-12b6-3210-8399-c48a717e885f",
                                "text": "Dans une société économiquement complexe et culturellement diversifiée comme la nôtre, plusieurs sont en position d'autorité pour parler d'un sujet précis en raison de leur profession ou de leur expérience personnelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eee5ecc-8eed-4a73-a150-60fd3ddcd94a",
                        "source_entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                        "source_sense_id": "7d374424-d105-3b0a-911e-30061a528fe1",
                        "source_sense_description": "Avec économie, à peu de frais",
                        "target_lang_word": "sparsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sparsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                        "entry_id": "fb73e362-7b90-3096-af54-5b1366cde21b",
                                        "glosses": [
                                            "so, dass eine Ressource (zum Beispiel Geld, Wasser oder Ähnliches) möglichst lange reicht; wenig verbrauchend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88072074-fd81-4ed9-9bd5-5c48a6b76b70",
                                                "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                                "text": "Meine Großeltern waren sehr sparsame Menschen."
                                            },
                                            {
                                                "example_id": "5d0060af-c159-459e-8ce1-61c4990701ec",
                                                "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                                "text": "Mit dem Trinkwasser müssen wir sparsam umgehen."
                                            },
                                            {
                                                "example_id": "d41966c2-7a81-41a0-aad3-059f4c8a62da",
                                                "sense_id": "4890857a-2c0d-382c-b888-c6deee8704d9",
                                                "text": "„Weil die Insulaner sparsame Menschen sind, kaufen sie wegen des Preisvorteils immer mehr seine und immer weniger die Nüsse der anderen Bauern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68c17660-7abc-3b9d-ab1d-6987334566c6",
                                        "entry_id": "fb73e362-7b90-3096-af54-5b1366cde21b",
                                        "glosses": [
                                            "knapp bemessen, kaum ausreichend, spärlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b039ec2-1d8b-4e6d-a002-8a80a4de97a3",
                                                "sense_id": "68c17660-7abc-3b9d-ab1d-6987334566c6",
                                                "text": "„Hammond führte Janson durch einen kahlen Gang mit abgenutztem Linoleumboden in ein geräumiges, aber sparsam eingerichtetes Büro im hinteren Bereich des Gebäudes.“"
                                            },
                                            {
                                                "example_id": "c7355288-6d16-4ec4-aad7-b33693158c70",
                                                "sense_id": "68c17660-7abc-3b9d-ab1d-6987334566c6",
                                                "text": "„Sie opferte ihre gesamte Energie, ihre Zeit und ihr sparsames Gehalt für ihre Eltern und Söhne, ohne dass sie deswegen fühlte, auch nur einen Schritt voran zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3be3e09-2e17-3763-898e-a77384bb3893",
                                        "entry_id": "fb73e362-7b90-3096-af54-5b1366cde21b",
                                        "glosses": [
                                            "von geringem Ausmaß; wenig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b5f5fa-9cf3-4b8b-bb7c-1647c5e8e426",
                                                "sense_id": "e3be3e09-2e17-3763-898e-a77384bb3893",
                                                "text": "„Als wir um eine kleine, mit Fichten sparsam bewachsene Landzunge gebogen waren, lag die östliche Ecke von Usedom vor uns.“"
                                            },
                                            {
                                                "example_id": "acb67295-cd2e-40fa-a0c5-892631f32c8c",
                                                "sense_id": "e3be3e09-2e17-3763-898e-a77384bb3893",
                                                "text": "„Allmählich erfuhr er von ihr in sparsamen Worten von seinem Vater, seiner Mutter und seiner Schwester.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa3d9216-4403-4333-a806-23ecee27dd46",
