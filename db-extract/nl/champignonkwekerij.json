                        "examples": [
                            {
                                "example_id": "b5a6ae6a-1388-4091-ad64-02b8e4e6399e",
                                "sense_id": "4484bda2-214c-382e-a1ee-5cc703820a73",
                                "text": "Uit onderzoek van de inspectie blijkt dat plukkers voor de champignonkwekerij met mooie verhalen in Polen werden geworven, maar dat alle beloften over loon, huisvesting en arbeidsomstandigheden niet werden nagekomen."
                            },
                            {
                                "example_id": "5668c2ea-b13c-4947-b59b-f8f6d4bd3f9b",
                                "sense_id": "4484bda2-214c-382e-a1ee-5cc703820a73",
                                "text": "In Winschoten is een schaftkeet op een terrein van voormalig champignonkwekerij Synergon uitgebrand. Een voorbijganger zag het vuur en waarschuwde de hulpdiensten. De politie onderzoekt of de brand is aangestoken."
                            }
                        ]
                    }
