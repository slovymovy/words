                    {
                        "sense_id": "9718be4b-ba9f-3afa-8b08-944d7cc5dab9",
                        "entry_id": "3903f1de-e9f3-3c5c-ae03-0b98f6cb2f6e",
                        "glosses": [
                            "Person, die ihren beruflichen Werdegang beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81f477c-2c63-409b-9b01-c096106635d4",
                                "sense_id": "9718be4b-ba9f-3afa-8b08-944d7cc5dab9",
                                "text": "„Die Fluktuation sei enorm, weil Berufseinsteiger schlecht bezahlt würden und nach zwei bis drei Jahren lieber woanders hingingen, wo sie mehr verdienen.“"
                            },
                            {
                                "example_id": "93d5604f-060b-4002-b3f3-d222f1919c3a",
                                "sense_id": "9718be4b-ba9f-3afa-8b08-944d7cc5dab9",
                                "text": "„Deshalb ist es besonders für Orientierung suchende Berufseinsteiger wichtig, so etwas wie einen ethnischen Code bzw. eine eigene Philosophie zu entwickeln.“"
                            },
                            {
                                "example_id": "1bf72894-b6ab-41d0-83dc-2623b4a180ab",
                                "sense_id": "9718be4b-ba9f-3afa-8b08-944d7cc5dab9",
                                "text": "Berufseinsteigerin Erna und Berufseinsteiger Erwin kamen morgens gemeinsam ins Büro und das machte sie verdächtig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
