                        ],
                        "examples": [
                            {
                                "example_id": "4d8c99c3-10e4-46da-bca5-1176b8c4b4bd",
                                "sense_id": "d412b97a-4aec-3b90-985c-1786ddc3254e",
                                "text": "Béatrice, l’épouse d’Aymon de Greysier, était mayoresse de Sion, de son propre droit"
                            }
                        ]
                    },
                    {
                        "sense_id": "c0e9e7ca-1794-3247-ac8f-9580c18dd894",
                        "entry_id": "386aaa96-5dff-358d-8daf-5e9d89a4f73c",
                        "glosses": [
                            "Épouse d’un mayor."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "551fcf8d-debd-4500-ab2e-cae1d05051d9",
                                "sense_id": "c0e9e7ca-1794-3247-ac8f-9580c18dd894",
                                "text": "Guillaume et Aymon, frères, fils de P(ierre) de Morestel, chevalier, confessent, à Sion, le 12 des kalendes d’avril 1296, qu’ils doivent à la noble femme Béatrice, mayoresse de Sion, un fichelin de sénevé, de cense."
                            }
                        ]
                    },
                    {
                        "sense_id": "89a8593a-4bba-3a30-92fc-f70531d875d9",
                        "entry_id": "386aaa96-5dff-358d-8daf-5e9d89a4f73c",
                        "glosses": [
                            "Épouse d’un mayor anglais ou d’un Lord Mayor."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abf893e6-f148-4fab-965d-6668e8afc47e",
                        "source_entry_id": "386aaa96-5dff-358d-8daf-5e9d89a4f73c",
                        "source_sense_id": "89a8593a-4bba-3a30-92fc-f70531d875d9",
                        "source_sense_description": "Épouse d’un mayor anglais",
                        "target_lang_word": "mayoress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mayoress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b299553b-b805-394f-9eb9-dea9b5fa7d8e",
                                        "entry_id": "6535a64a-a50a-3461-a0d9-a51e7bdd1478",
                                        "glosses": [
                                            "A female mayor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9e15920-69e7-4cc2-b115-0226aacab94d",
                                                "sense_id": "b299553b-b805-394f-9eb9-dea9b5fa7d8e",
                                                "text": "The blonde mayoress was apparently a member of the MPLA and there were indications that spies in the town were sending radio messages to the enemy. Life was monotonous and the troops took to fishing to supplement their rations."
                                            },
                                            {
                                                "example_id": "2cf8cf1c-02a0-4743-9a07-1b3626d1bfa9",
                                                "sense_id": "b299553b-b805-394f-9eb9-dea9b5fa7d8e",
                                                "text": "With the Spanish port of Cadiz doubling for the Cuban capital Havana, its striking blonde Mayoress Teofila Martinez was offered a small role as a nurse, but she politely declined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d3a8e4-9ebd-3f9d-a7d9-bda0a40e242e",
                                        "entry_id": "6535a64a-a50a-3461-a0d9-a51e7bdd1478",
                                        "glosses": [
                                            "The wife of a (male) mayor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee7d476-5ec8-4c60-900f-0cfe11458f53",
                                                "sense_id": "05d3a8e4-9ebd-3f9d-a7d9-bda0a40e242e",
                                                "text": "To a Lady Majoress.\nWHen I behold your head and limbs all shaking\nMuch like a Custard newly come from baking,\nYour Velvet hood on tipto rais’d upright\nAs if your Hinch boy challenge would to fight.\nYour pretty mouth, like Oyster gaping wide,\nAs if it did expect ere long the tyde;\nYour Chin like Aple, both so red and shrivel’d,\nSo scalded by a hot rhume hourly drivel’d."
                                            },
                                            {
                                                "example_id": "4aa121cd-51cc-44d7-b614-0f7b6dc861ce",
                                                "sense_id": "05d3a8e4-9ebd-3f9d-a7d9-bda0a40e242e",
                                                "text": "Prophets wives were anciently called Prophetesses; like as Bishops wives (saith à Lapide the Jesuit) were also called Bishoppesses, Presbyters wives Presbyteresses, Deacons wives Deaconesses: Jesuits have still their Jesuitesses, as Majors their Majoresses, &c."
                                            },
                                            {
                                                "example_id": "17d20db0-063f-4531-ae87-02596c595f7c",
                                                "sense_id": "05d3a8e4-9ebd-3f9d-a7d9-bda0a40e242e",
                                                "text": "No Roman-Empress ever did out-shine,\nA Lady Majoress when she would be fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47870fe-72a4-327f-af49-e99319e23fa7",
                                        "entry_id": "6535a64a-a50a-3461-a0d9-a51e7bdd1478",
                                        "glosses": [
                                            "A daughter or female friend of a male mayor chosen by him to hold the title mayoress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
