                                "target_senses": [
                                    {
                                        "sense_id": "71891f94-5c6c-3b52-8b0e-7602d78e85d8",
                                        "entry_id": "9352b232-d852-30ae-afeb-160330d7cb0e",
                                        "glosses": [
                                            "Nom de famille, très connu via Alexandre Dumas (1802-1870), dit « Alexandre Dumas père », écrivain français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5687f450-6c93-4d23-be07-9c5ba7c4e21d",
                                                "sense_id": "71891f94-5c6c-3b52-8b0e-7602d78e85d8",
                                                "text": "J’assistai seulement aux représentations que le dimanche et le mardi matin Georges Dumas nous donnait à Sainte-Anne, avec le concours de quelques fous."
                                            },
                                            {
                                                "example_id": "355b120e-8ea3-452e-a233-9ff10db861d1",
                                                "sense_id": "71891f94-5c6c-3b52-8b0e-7602d78e85d8",
                                                "text": "On pourrait presque croire qu’Alexandre Dumas a écrit Les Trois Mousquetaires pour Vincent Cassel (Athos), François Civil (D’Artagnan), Pio Marmaï (Porthos) et Romain Duris (Aramis)."
                                            },
                                            {
                                                "example_id": "0111c14b-b89b-4839-9a6f-101101c1fcf9",
                                                "sense_id": "71891f94-5c6c-3b52-8b0e-7602d78e85d8",
                                                "text": "Co-organisé avec Samuel Dumas, fondateur d’Acadee, un organisme de formation à la blockchain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
