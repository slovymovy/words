                    {
                        "translation_id": "8c89b620-036e-4346-9ec3-e3dd3c5aee27",
                        "source_entry_id": "d84d0131-df2c-3af1-b238-650553ecece3",
                        "source_sense_id": "eef9ba86-5348-37f2-99ca-a6880ebfedf6",
                        "target_lang_word": "glycolyse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glycolyse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88dc0e58-d97b-3f64-b6e4-407e39279138",
                                        "entry_id": "174679d6-288e-3374-9feb-1f1fee718638",
                                        "glosses": [
                                            "Voie métabolique d’assimilation du glucose et de production d'énergie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceea7332-86aa-4b19-8678-e82f1d1d792f",
                                                "sense_id": "88dc0e58-d97b-3f64-b6e4-407e39279138",
                                                "text": "Afin d’entrer dans la glycolyse les carbones des glucides de réserve comme l’amidon, le saccharose ou les fructosanes, doit d'abord être hydrolysé sous forme de glucose ou de fructose puis converti en fructose-1,6-biphosphate."
                                            },
                                            {
                                                "example_id": "7e83e72c-b039-4479-a2c3-457983f8ea54",
                                                "sense_id": "88dc0e58-d97b-3f64-b6e4-407e39279138",
                                                "text": "L’ATP est produit dans le myocarde par deux voies différentes qui sont d'ailleurs reliées entre elles : la glycolyse et les phosphorylations oxydatives."
                                            },
                                            {
                                                "example_id": "50c5bb07-bf70-4e51-9d28-886e8f0815cf",
                                                "sense_id": "88dc0e58-d97b-3f64-b6e4-407e39279138",
                                                "text": "La glycolyse se produit dans le cytoplasme de la cellule, à l'extérieur de la mitochondrie, et ne nécessite pas la présence d’oxygène."
                                            },
                                            {
                                                "example_id": "2dd1e622-2344-40e6-9248-45900039a25d",
                                                "sense_id": "88dc0e58-d97b-3f64-b6e4-407e39279138",
                                                "text": "Le glucose-1'-phosphate, le glucose-6'-phosphate et le glycéraldéhyde-3'-phosphate jouent, par exemple, des rôles déterminants dans la glycolyse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
