                        ],
                        "form": "die Schneeballschlachten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76b46890-4ced-38a5-b0b5-c7920c1c32d6",
                        "entry_id": "ee2344f9-bc43-3d46-884f-052a42f18173",
                        "glosses": [
                            "eine spielerische Rauferei im Schnee, bei der man sich gegenseitig mit Schneebällen bewirft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8013ae41-d4a8-45bd-892e-c9b4ecc0ec43",
                                "sense_id": "76b46890-4ced-38a5-b0b5-c7920c1c32d6",
                                "text": "Während die Eltern im Schnee spazieren gingen, machten die Kinder lieber eine Schneeballschlacht."
                            },
                            {
                                "example_id": "26c4f11d-9da4-405b-be94-e9165faa70ae",
                                "sense_id": "76b46890-4ced-38a5-b0b5-c7920c1c32d6",
                                "text": "„Auf schneebedeckter Rasenfläche – (denn der Schnee der vorigen Nacht war im Garten nicht zerronnen wie auf den Straßen) – wälzten sich, miteinander ringend, seine beiden Söhne, der junge Kardinal Don Giovanni und der fünfzehnjährige Don Gracia und mit ihnen ein in blauen Pelz gekleidetes Mädchen, das sich vergeblich abmühte, die beiden Kämpfenden zu trennen, während eine andere Damigella in grüner Pelzjacke, Pelzhandschuhen und Pelzstiefeln daneben stand, ratlos die behandschuhten Fäuste an die Wangen pressend, nicht imstande, dem Spiel (das keine unschuldige Schneeballschlacht war) ein Ende zu machen.“"
                            },
                            {
                                "example_id": "161bebd2-f0be-4307-b043-777899890e57",
                                "sense_id": "76b46890-4ced-38a5-b0b5-c7920c1c32d6",
                                "text": "„Aber ich sehe noch einen Mittag vor mir, als in einer großen Schneeballschlacht die Prenzlauer durch ganze Straßen zurückweichen mußten.“"
                            },
                            {
                                "example_id": "a3a66cf4-ef8b-448b-8fff-d01ff12db5f4",
                                "sense_id": "76b46890-4ced-38a5-b0b5-c7920c1c32d6",
                                "text": "„Wenn es darauf ankommt, sind seine Politiker nicht einmal in der Lage, eine Schneeballschlacht im Tiergarten zu organisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc8141fa-96ef-4425-8207-becbf891be1d",
                        "source_entry_id": "ee2344f9-bc43-3d46-884f-052a42f18173",
                        "source_sense_id": "76b46890-4ced-38a5-b0b5-c7920c1c32d6",
                        "source_sense_description": "eine spielerische Rauferei im Schnee, bei der man sich gegenseitig mit Schneebällen bewirft",
                        "target_lang_word": "snowball fight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowball fight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4cec6e-ad3d-3059-bddc-a86ff337946d",
                                        "entry_id": "fba9f336-9d7e-3468-80a7-cd4712aaf2f9",
                                        "glosses": [
                                            "A scuffle or play fight whose object is to hit opponents with snowballs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ef3b9c-b559-4305-9f97-1cd51d23d9fb",
                                                "sense_id": "bc4cec6e-ad3d-3059-bddc-a86ff337946d",
                                                "text": "\"Oh, I mean a snowball fight. This is probably the last of the season, and I was thinking we could get a lot of fellows together, make a fort, and have a regular battle like we read about in Cæsar to-day. It would be no end of sport.\""
                                            }
                                        ]
                                    }
                                ]
                            }
