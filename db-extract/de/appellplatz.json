                "senses": [
                    {
                        "sense_id": "eead493a-0c68-324a-8ed1-49f6180c14c8",
                        "entry_id": "225a0555-f376-3b1f-8cdd-9bcc240c5b16",
                        "glosses": [
                            "(zentraler) Platz innerhalb eines Kasernen-/Lagergeländes, auf dem Soldaten/Häftlinge sich geordnet aufstellen müssen, um Befehle zu empfangen, Nachrichten entgegenzunehmen, überprüft zu werden oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f726ff-d91f-4eb5-89c4-15ed13f1604b",
                                "sense_id": "eead493a-0c68-324a-8ed1-49f6180c14c8",
                                "text": "„Weber, der SS-Lagerführer, saß rittlings auf einem Holzstuhl, den man auf den Appellplatz hinausgestellt hatte.“"
                            },
                            {
                                "example_id": "53151dca-00da-43fe-9f07-3bb2ef4a40ea",
                                "sense_id": "eead493a-0c68-324a-8ed1-49f6180c14c8",
                                "text": "„Um vier Uhr früh wird geweckt, um viertel vor fünf steht man auf dem Appellplatz, dann heißt es Steine einen Kilometer vom Steinbruch ins Lager schleppen, zwölf bis vierzehn Stunden lang – die Lagerstraße wird gerade gebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
