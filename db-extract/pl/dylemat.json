                                    {
                                        "sense_id": "e9577879-3cd5-34ff-aa9d-be4ca9759b65",
                                        "entry_id": "e8300c90-86f6-3882-852c-4fa446c204ac",
                                        "glosses": [
                                            "A definite class, state or condition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5051a93-28e3-3f8f-a3f4-70f62f7d4d9a",
                                        "entry_id": "e8300c90-86f6-3882-852c-4fa446c204ac",
                                        "glosses": [
                                            "An unfortunate or trying position or condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685e3ad7-623c-4802-8e15-347afe6e0824",
                                                "sense_id": "f5051a93-28e3-3f8f-a3f4-70f62f7d4d9a",
                                                "text": "Culture, for me, is the effort to provide a coherent set of answers to the existential predicaments that confront all human beings in the passage of their life."
                                            },
                                            {
                                                "example_id": "c5cbc2a1-e485-484e-b394-01b109d33acb",
                                                "sense_id": "f5051a93-28e3-3f8f-a3f4-70f62f7d4d9a",
                                                "text": "The Midlanders will hope the victory will kickstart a campaign that looked to have hit the buffers, but the sense of trepidation enveloping the Reebok Stadium heading into the new year underlines the seriousness of the predicament facing Owen Coyle's men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4339f8d4-d625-3b66-a8e7-f0a5ebd0f9eb",
                                        "entry_id": "e8300c90-86f6-3882-852c-4fa446c204ac",
                                        "glosses": [
                                            "That which is predicated; a category."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "940e33a3-f1e5-4928-8443-51a81badc594",
                        "source_entry_id": "79ca7543-8231-38b0-ac34-0a3bef2d4e9a",
                        "source_sense_id": "624a0a74-bef7-31f3-8b87-c8c51b736248",
                        "target_lang_word": "quandary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quandary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbda977d-3c75-3e28-906c-4a20c852a74a",
                                        "entry_id": "433abada-3de5-3475-9c1c-66f116369ab3",
                                        "glosses": [
                                            "A state of not knowing what to decide; a state of difficulty or perplexity; a state of uncertainty, hesitation or puzzlement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5578f77-f074-44e6-a9fc-1f2bf7c1af61",
                                                "sense_id": "cbda977d-3c75-3e28-906c-4a20c852a74a",
                                                "text": "As a Hitchin signalman once pointed out to me, when a regulating quandary arises concerning a fast-moving Class A train there is no time to consult Control and get their answer before the express is on one's doorstep."
                                            },
                                            {
                                                "example_id": "e700e29f-6d19-4b3c-8080-8ee74a28959e",
                                                "sense_id": "cbda977d-3c75-3e28-906c-4a20c852a74a",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc19d48e-b881-377e-9c0a-409f66a994c4",
                                        "entry_id": "433abada-3de5-3475-9c1c-66f116369ab3",
                                        "glosses": [
                                            "A dilemma, a difficult decision or choice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d5da94-e595-468e-b072-03e358db77d2",
                                                "sense_id": "fc19d48e-b881-377e-9c0a-409f66a994c4",
                                                "text": "To quote the oracle of Delphi, / Love thou thy neighbor as thyself, aye, / And hate him as thyself thou hatest. / There quandary is at its greatest."
                                            },
                                            {
                                                "example_id": "cba2bbb3-2753-4983-b6c8-49cf8a000601",
                                                "sense_id": "fc19d48e-b881-377e-9c0a-409f66a994c4",
                                                "text": "But we may suppose that John has set his priorities in such a way that the quandary is spurious."
                                            },
                                            {
                                                "example_id": "3ebeaa2b-b802-4ced-8954-498e54a9d789",
                                                "sense_id": "fc19d48e-b881-377e-9c0a-409f66a994c4",
                                                "text": "What a difficult quandary for a bright, talented child!"
                                            },
                                            {
                                                "example_id": "84a806d1-4b12-42c7-81a4-fa3c1f2fe894",
                                                "sense_id": "fc19d48e-b881-377e-9c0a-409f66a994c4",
                                                "text": "Then I would begin contemplating the next quandary: \"Does the Torah say it's okay to portray a hooker, and is a heart of gold a mitigating factor?\""
                                            },
                                            {
                                                "example_id": "3be7f2e2-200d-4f57-bd40-8836f1f74339",
                                                "sense_id": "fc19d48e-b881-377e-9c0a-409f66a994c4",
                                                "text": "The film explores Oppenheimer’s moral quandary over his role in creating the most destructive weapon ever made, but nuclear disarmament campaigners fear its power to persuade people of the existential threat posed by nuclear arms may be diminished by its focus on scientific achievement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
