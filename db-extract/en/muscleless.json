                        "entry_id": "e41a3f82-2a06-3a66-a982-398b2ecfc7c3",
                        "glosses": [
                            "Feeble, weak, lacking strength or power."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7be23b-d4a3-48be-a919-68d9457b3fdc",
                                "sense_id": "23c45f25-1cd3-38c5-8cb8-586eff515038",
                                "text": "As they came near, even Marcia could note the sleek, soft look of the men, and their listless, muscleless gait; while their leader's hair and person literally reeked with perfumes."
                            },
                            {
                                "example_id": "74bd8d10-f13f-46cb-8c8d-7edbf3b2c148",
                                "sense_id": "23c45f25-1cd3-38c5-8cb8-586eff515038",
                                "text": "I stress that a golfer cannot ever be too boneless or too loose, nor too muscleless."
