                            }
                        ]
                    },
                    {
                        "translation_id": "5ef14477-e3b0-4b28-8c80-d9da2589b7a5",
                        "source_entry_id": "adb94c82-f956-3b5e-8f0d-4a95a55c1f0e",
                        "source_sense_id": "334f85bc-4801-3427-b0aa-cedddbe7667b",
                        "source_sense_description": "Zoologie: eine Art aus der Familie der Pinguine",
                        "target_lang_word": "manchot royal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manchot royal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66d3e758-0423-352d-8c52-88458958cf20",
                                        "entry_id": "56fc7c26-741f-32e3-8d51-0dc48c3345cb",
                                        "glosses": [
                                            "Manchot vivant dans des régions froides de l’hémisphère sud, un peu moins grand que le manchot empereur, de nom scientifique Aptenodytes patagonicus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f32e035-06e5-469d-9d60-b08fcaca09cc",
                                                "sense_id": "66d3e758-0423-352d-8c52-88458958cf20",
                                                "text": "Le manchot empereur pèse jusqu’à plus de 40 kg pour une taille d’environ 1 m, tandis que le manchot royal pèse jusqu’à 13-14 kg avant la reproduction (15-16 kg avant la mue) pour une taille de 0,7 m."
                                            },
                                            {
                                                "example_id": "a1b9c3d5-3c4c-4c58-aa56-1c330e08f4da",
                                                "sense_id": "66d3e758-0423-352d-8c52-88458958cf20",
                                                "text": "Le comportement d’éveil et de sommeil des manchots royaux, des grands « pingouins » hauts de un mètre, a été particulièrement bien étudié par d’excellents chercheurs dans l’île Crozet où il existe des colonies de cinq cent mille manchots."
                                            },
                                            {
                                                "example_id": "61e23cef-62c1-4941-b372-57a24a3aab1e",
                                                "sense_id": "66d3e758-0423-352d-8c52-88458958cf20",
                                                "text": "Un photographe en pleine séance d’observation animalière a eu la surprise de tomber sur un manchot royal entièrement jaune et blanc, un phénomène rare de la nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
