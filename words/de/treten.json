                    "sense_definition": "den Fuß auf etwas setzen und sein Gewicht darauf verlagern",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
