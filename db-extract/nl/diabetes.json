                                    {
                                        "sense_id": "d58c8092-cac7-32df-952d-0bb63448763c",
                                        "entry_id": "ffcace9a-e268-3227-9ef3-26a361ed54c2",
                                        "glosses": [
                                            "Diabetes mellitus; any of a group of metabolic diseases whereby a person (or other animal) has high blood sugar due to an inability to produce, or inability to metabolize, sufficient quantities of the hormone insulin."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a285caf-3ac4-442c-8d96-f1536ac23abc",
                                                "sense_id": "d58c8092-cac7-32df-952d-0bb63448763c",
                                                "text": "In the UK, one in 10 people over 40 live with type 2 diabetes, while one in four have high blood pressure, a condition described as a “silent killer” because it increases the risk of heart attack and stroke but rarely causes symptoms beforehand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43057708-e697-3582-85aa-c68579c1b3a9",
                                        "entry_id": "ffcace9a-e268-3227-9ef3-26a361ed54c2",
                                        "glosses": [
                                            "Any food or beverage with a high amount of sugar."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617535bf-2270-4f06-b732-c9c952964bb3",
                                                "sense_id": "43057708-e697-3582-85aa-c68579c1b3a9",
                                                "text": "This milkshake is pure diabetes, as my friends and I agreed on as a joke when we first came to Black Tap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93840143-66a3-3d7e-aa70-0db3ccbe8601",
                                        "entry_id": "ffcace9a-e268-3227-9ef3-26a361ed54c2",
                                        "glosses": [
                                            "Diabetes insipidus; any condition characterized by excessive or incontinent urine, now specifically as caused by impaired production of, or response to, the antidiuretic hormone vasopressin."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a173774b-ecb4-4c55-849d-310fab1ec0b4",
                                                "sense_id": "93840143-66a3-3d7e-aa70-0db3ccbe8601",
                                                "text": "A Sheeps or Goats bladder being burnt, and the ashes given inwardly, helps the Diabetes, or continuall pissing."
                                            },
                                            {
                                                "example_id": "2cd02d6b-aeb5-44e9-ba64-3e0ee0d55fc5",
                                                "sense_id": "93840143-66a3-3d7e-aa70-0db3ccbe8601",
                                                "text": "The lady laboured under a Diabetes, in consequence of having used the waters injudiciously for another complaint; and, that she might not be an impediment to the carriage, by ordering it to halt,as often as she should have occasion to disembogue, she had provided herself with a leathern contrivance […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
