        "fr-extract.jsonl": [
            {
                "entry_id": "81db20c4-a29b-3c7b-ac65-6db1fc863141",
                "word": "grossiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1fc94b7b-f071-4efa-b046-8c5f5dd0a6f2",
                        "entry_id": "81db20c4-a29b-3c7b-ac65-6db1fc863141",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "grossistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af41949f-01c0-3269-bf58-224886c92a07",
                        "entry_id": "81db20c4-a29b-3c7b-ac65-6db1fc863141",
                        "glosses": [
                            "Personne ou entreprise qui fait le commerce en gros, c’est-à-dire l’intermédiaire entre producteur et détaillant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82203c3d-43d0-4821-b74a-4fe8d5e0d210",
                                "sense_id": "af41949f-01c0-3269-bf58-224886c92a07",
                                "text": "Le grossiste assume une fonction qui consiste à acheter la production ou à l’importation des marchandises d’une façon continue, en quantités importantes, à les stocker, à y incorporer éventuellement du service, et à assurer l’approvisionnement régulier des utilisateurs professionnels (détaillants, collectivités, artisans…)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68e2ea58-c990-45c5-808e-3d8efb2c96ac",
                        "source_entry_id": "81db20c4-a29b-3c7b-ac65-6db1fc863141",
                        "source_sense_id": "af41949f-01c0-3269-bf58-224886c92a07",
                        "source_sense_description": "Celui qui fait le commerce en gros",
                        "target_lang_word": "Großhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bbadffa-e42c-3a50-8c08-288c162aa131",
                                        "entry_id": "4cc246f7-df9f-3533-a8c7-c25b9d2f5156",
                                        "glosses": [
                                            "Person oder Firma, die Großhandel betreibt, also Waren von Produzenten bezieht und weitervertreibt, zum Beispiel an Einzelhändler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2838d4ac-1f8c-4a2f-a2d5-1017d2286afc",
                                                "sense_id": "1bbadffa-e42c-3a50-8c08-288c162aa131",
                                                "text": "„Doch sicherheitshalber verkaufte er nicht an die Großhändler der unmittelbaren Umgebung, denn da war die Gefahr zu groß, dass mal einer hereinschneite und feststellte, dass auf Bosses Hof kein einziges Huhn seine Körner pickte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc7eac9b-d20a-4eba-ac72-27eb8fcec44f",
                        "source_entry_id": "81db20c4-a29b-3c7b-ac65-6db1fc863141",
                        "source_sense_id": "af41949f-01c0-3269-bf58-224886c92a07",
                        "source_sense_description": "Celui qui fait le commerce en gros",
                        "target_lang_word": "wholesaler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wholesaler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd4991f-3b47-38fd-ab2b-ec020ed22c49",
                                        "entry_id": "661a672c-5a97-363d-9755-2a325dc08faf",
                                        "glosses": [
                                            "A person or company that buys merchandise from manufacturers, importers, or distributors and resells the merchandise to retail businesses and to business and institutional end users."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6c2332-b751-4224-8809-f50cb3ececac",
                                                "sense_id": "1fd4991f-3b47-38fd-ab2b-ec020ed22c49",
                                                "text": "He observed that a wholesaler who supplied my grandfather with goods continued to advertise the implements of a new game, called \"Sphairistike.\""
                                            },
                                            {
                                                "example_id": "fe5050fe-8f03-4ed5-9d65-26d60d067f9e",
                                                "sense_id": "1fd4991f-3b47-38fd-ab2b-ec020ed22c49",
                                                "text": "Your market gardener is not a well-breeched man, dependant as he is on the imponderables of glut, the inequities of distribution, and the greeds of wholesaler and retailer."
                                            },
                                            {
                                                "example_id": "27536a3f-7b71-4a1e-a526-becde8d0528a",
                                                "sense_id": "1fd4991f-3b47-38fd-ab2b-ec020ed22c49",
                                                "text": "Among wholesalers, voluntary and cooperatives carry a far wider range and number of items in private brands than do unaffiliateds."
                                            },
                                            {
                                                "example_id": "fa7b6293-5259-42a3-a52d-48f882d19632",
                                                "sense_id": "1fd4991f-3b47-38fd-ab2b-ec020ed22c49",
                                                "text": "The packinghouse usually delivers shrimp to a few regular customers, such as breaders, freezers, canners, or wholesalers of fresh shrimp."
                                            },
                                            {
                                                "example_id": "eaa0d529-b40d-4a04-92e9-f6cc22de5761",
                                                "sense_id": "1fd4991f-3b47-38fd-ab2b-ec020ed22c49",
                                                "text": "Now it seems parent company Anheuser-Busch is taking steps to help wholesalers who have taken a hit."
                                            },
                                            {
                                                "example_id": "c8894a92-8ef8-4936-b61f-7dc7f13711ba",
                                                "sense_id": "1fd4991f-3b47-38fd-ab2b-ec020ed22c49",
                                                "text": "Do it Best is a member-owned wholesaler that sells hardware, lumber and other home goods to independent stores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13b7647c-ae60-4c67-80b1-0c1ab68ec048",
                        "source_entry_id": "81db20c4-a29b-3c7b-ac65-6db1fc863141",
