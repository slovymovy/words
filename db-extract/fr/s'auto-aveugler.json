                "senses": [
                    {
                        "sense_id": "89588eeb-4a85-3bb3-a857-24b074604560",
                        "entry_id": "d00d18c0-4416-3197-9533-8af9c47983cd",
                        "glosses": [
                            "S’aveugler soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8981b4-d3b7-49a7-9a53-e97cd9b409d5",
                                "sense_id": "89588eeb-4a85-3bb3-a857-24b074604560",
                                "text": "Pourquoi choisirait-il de s’auto-aveugler pour ne nous fixer que de cet inquiétant \"oeil du temps\" ?"
                            },
                            {
                                "example_id": "55a03614-30d0-4de8-96dd-0ba76103bc1f",
                                "sense_id": "89588eeb-4a85-3bb3-a857-24b074604560",
                                "text": "Puisque les hommes ont tendance à s’auto-aveugler, il s’agit à la fois, en une double tactique, de montrer les vertus sociales de cet aveuglement et les vertus pour soi, plus grandes encore, de la clarté."
                            }
                        ]
                    }
