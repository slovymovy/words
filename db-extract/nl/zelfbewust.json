                        ],
                        "examples": [
                            {
                                "example_id": "67dacdfb-2c27-437d-84e7-02abc0f04b29",
                                "sense_id": "00640868-74a0-3c02-873f-5fb493212add",
                                "text": "Hij is vaak erg zelfbewust en onzeker als hij voor een groot publiek moet spreken.",
                                "translation": "He is often very self-conscious and insecure when he has to address a large audience.",
                                "english": "He is often very self-conscious and insecure when he has to address a large audience."
                            }
