                                    {
                                        "sense_id": "a31f5729-a674-3f36-ac45-e595c2a3cdb0",
                                        "entry_id": "423aaeea-4ecd-3d42-99f6-e2b8b250fdf0",
                                        "glosses": [
                                            "maior e mais importante artéria do sistema circulatório do corpo humano"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a666598-aa85-4062-acea-f43aa07cfea3",
                                                "sense_id": "a31f5729-a674-3f36-ac45-e595c2a3cdb0",
                                                "text": "O coração artificial fica do lado de fora do corpo da criança. É como uma câmara, com uma membrana dentro, ligada ao coração por duas cânulas - uma conectada à veia aorta, a outra ao ventrículo esquerdo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
