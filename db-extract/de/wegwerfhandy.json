                "senses": [
                    {
                        "sense_id": "17c082b3-87e7-3dd0-a013-171ab9eb0213",
                        "entry_id": "af47c042-cd18-30f5-92cb-882faaeef11b",
                        "glosses": [
                            "Handy für den einmaligen Gebrauch, das nach einem Anruf weggeworfen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f68fb5b-cff9-4c10-8508-a05dc76618c6",
                                "sense_id": "17c082b3-87e7-3dd0-a013-171ab9eb0213",
                                "text": "„›Spielt keine Rolle. Ein Wegwerfhandy. Ich werde jedes Mal mit einer neuen Nummer anrufen.‹“"
                            },
                            {
                                "example_id": "ee8e10a3-edf4-412f-972a-92bb54dfb525",
                                "sense_id": "17c082b3-87e7-3dd0-a013-171ab9eb0213",
                                "text": "„›Es handelt sich um ein Wegwerfhandy, das sich nicht orten lässt.‹“"
                            },
                            {
                                "example_id": "1299f973-3cc9-4298-b5a6-06978fd4042e",
                                "sense_id": "17c082b3-87e7-3dd0-a013-171ab9eb0213",
                                "text": "„Mit einem Blick zu Harris und Santana hinüber sagt Michael: ›Sie benutzen Wegwerfhandys, um mit diesen beiden Schwachköpfen und anderen zu kommunizieren.‹“"
                            },
                            {
                                "example_id": "b54d63c0-5090-4a88-b934-d69ca7940bb9",
                                "sense_id": "17c082b3-87e7-3dd0-a013-171ab9eb0213",
                                "text": "„›Und ihr wisst, wo irgendetwas Illegales im Gange ist, stehen die Chancen immer hoch, dass auch Wegwerfhandys im Spiel sind.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
