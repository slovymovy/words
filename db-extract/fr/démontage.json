                                                "sense_id": "cbbfbcf6-e656-3d0d-ad44-f05dc29d429c",
                                                "text": "Abbau zu Boizenburg , Abbaue zu Scharnebeck"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
