    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "03ab94d8-6972-3281-a767-86225c246539",
                "word": "bookend",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "74dcf2d7-bbfd-4431-bb37-4bea0776d65e",
                        "entry_id": "03ab94d8-6972-3281-a767-86225c246539",
                        "tags": [
                            "plural"
                        ],
                        "form": "bookends"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22b215f2-6d5e-3876-8788-685e46861ee2",
                        "entry_id": "03ab94d8-6972-3281-a767-86225c246539",
                        "glosses": [
                            "A heavy object or moveable support placed at one or both ends of a row of books for the purpose of keeping them upright."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c31b184d-d387-3952-9da4-783ffb54892d",
                        "entry_id": "03ab94d8-6972-3281-a767-86225c246539",
                        "glosses": [
                            "Something that comes before, after, or at both sides of something else."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "30714394-bfa7-4a0c-aa53-3bd6aa36571f",
                                "sense_id": "c31b184d-d387-3952-9da4-783ffb54892d",
                                "text": "The cabinet minister's appearance served as something of a bookend to her grilling by the Home Affairs select committee in April this year[…]"
                            },
                            {
                                "example_id": "dce789f3-5c12-4357-a05f-887ff6ab8704",
                                "sense_id": "c31b184d-d387-3952-9da4-783ffb54892d",
                                "text": "In both Episode 1 and Episode 9, which serve as bookends, Burns found fascinating footage of a 1938 event at which President Franklin Roosevelt spoke to living veterans who wore the Blue and the Gray; […]"
                            },
                            {
                                "example_id": "36ec82a4-4477-48a0-8342-42e9be48557b",
                                "sense_id": "c31b184d-d387-3952-9da4-783ffb54892d",
                                "text": "[…] radio techniques, including the use of sound montage and the placement of musical \"bookends\" at the beginning and end of radio programs […]"
                            },
                            {
                                "example_id": "1bf71e4d-4eda-4ca1-8d01-4c78861b5f62",
                                "sense_id": "c31b184d-d387-3952-9da4-783ffb54892d",
                                "text": "And it seemed, perhaps fancifully, that those two moments had become the bookends of a generation and of a nation’s frayed sense of equilibrium."
                            },
                            {
                                "example_id": "6ea10aa2-cf76-4f14-ac16-2a0d49a22a73",
                                "sense_id": "c31b184d-d387-3952-9da4-783ffb54892d",
                                "text": "In the factory, a colourful woodland of knitted trees points towards a collection of bookends commissioned from Scottish designers and inspired by the globetrotting travels in 1894 of Dundee Courier journalists Marie Imandt and Bessie Maxwell."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "421609f2-fe95-4f4a-a095-0e381e99b380",
                        "source_entry_id": "03ab94d8-6972-3281-a767-86225c246539",
                        "source_sense_description": "object designed to keep books upright",
                        "target_lang_word": "boekensteun",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boekensteun",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ac374e51-8d04-32d4-ba1f-d79ed5e12888",
                                        "entry_id": "2180371a-6420-3857-9c57-73f68db915b6",
                                        "glosses": [
                                            "hulpmiddel dat ervoor zorgt dat boeken rechtop blijven staan op een niet geheel gevulde boekenplank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849ce3ad-eb28-432e-8977-349c530a3234",
                                                "sense_id": "ac374e51-8d04-32d4-ba1f-d79ed5e12888",
                                                "text": "De dijk van de Enkele Wiericke is smal en steil. \"Dat betekent het risico dat de dijk zich van onder gaat verbreden en als een soort pudding in elkaar zakt. Daarom versterken we de dijk aan de voet door er als het ware een boekensteun tegenaan te zetten.\""
                                            },
                                            {
                                                "example_id": "dff0ecae-509e-4705-97db-e84a5450d22c",
                                                "sense_id": "ac374e51-8d04-32d4-ba1f-d79ed5e12888",
                                                "text": "In Tsjechië heeft de familie van een vermoorde man een klacht ingediend tegen de politie omdat de agenten de schedel van het slachtoffer gebruikten als boekensteun. Dat melden lokale kranten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f4d9f2-bd62-38a3-92c6-48ea676413de",
                                        "entry_id": "2180371a-6420-3857-9c57-73f68db915b6",
                                        "glosses": [
                                            "hulpmiddel dat een boek schuin omhoog houdt zodat men het boek makkelijker kan lezen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
