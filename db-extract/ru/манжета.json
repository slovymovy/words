                ],
                "senses": [
                    {
                        "sense_id": "377ba18e-3666-39ab-b475-65cb5a8ecc54",
                        "entry_id": "7a4ca3dc-2cc1-3fcd-9bae-f912b4bb616a",
                        "glosses": [
                            "пристегнутый или пришитый обшлаг рукава сорочки, блузы и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d453e0c5-728e-46ec-b276-88e912f22f5a",
                                "sense_id": "377ba18e-3666-39ab-b475-65cb5a8ecc54",
                                "text": "Ещё до войны жена сбежала от него с проезжим актёром, пленясь его бархатной курткой и кружевными манжетами."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fbe96ca-87a6-3134-910e-c82860686163",
                        "entry_id": "7a4ca3dc-2cc1-3fcd-9bae-f912b4bb616a",
                        "glosses": [
                            "техн. приспособление в виде кольца, имеющее различное назначение"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d2e703f-4050-4986-bdbd-ec81d74fea0b",
                        "source_entry_id": "7a4ca3dc-2cc1-3fcd-9bae-f912b4bb616a",
                        "source_sense_description": "пристегнутый или пришитый обшлаг рукава",
                        "target_lang_word": "Manschette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manschette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "772e8d37-0ff9-3944-9281-9c56bd076a2b",
                                        "entry_id": "609e0599-3869-3221-9535-9200ca61f372",
                                        "glosses": [
                                            "verstärktes Ende eines Oberhemdärmels; Ärmelabschluss oder auch um den Hals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9806234a-e069-4f0e-b753-376b28ee0a17",
                                                "sense_id": "772e8d37-0ff9-3944-9281-9c56bd076a2b",
                                                "text": "Manch wunderbarer Manschettenknopf ziert die Manschetten eines Herrenhemdes."
                                            },
                                            {
                                                "example_id": "38f8b04d-0ee9-4da4-8bb1-d63a7a65beb1",
                                                "sense_id": "772e8d37-0ff9-3944-9281-9c56bd076a2b",
                                                "text": "„Dann lächelte Rudolf Lehmberg dünn, verstand die Aufforderung, horchte nach Recha, knöpfte sich schnell die Manschetten auf und strich das Hemd an dem mageren Arm empor.“"
                                            },
                                            {
                                                "example_id": "b030582d-376e-4406-bc22-21808b0ab9dd",
                                                "sense_id": "772e8d37-0ff9-3944-9281-9c56bd076a2b",
                                                "text": "„Ida zog, ohne zur Tür zu sehen, die Manschette über die Uhr an ihrem Handgelenk.“"
                                            },
                                            {
                                                "example_id": "2ca80659-d111-4786-8082-126903ac4225",
                                                "sense_id": "772e8d37-0ff9-3944-9281-9c56bd076a2b",
                                                "text": "„Er wohnte seit zwei Tagen im gleichen Gasthof und trug Trauerkleidung, dazu ein Hemd mit ausgefransten Manschetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d013e42-c377-332b-afa4-2e31c8ef5c83",
                                        "entry_id": "609e0599-3869-3221-9535-9200ca61f372",
                                        "glosses": [
                                            "aus Gummi oder Leder bestehender Dichtungsring mit Wulst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56d2cde3-f46e-4ec8-9e8c-287819ecbd4d",
                                                "sense_id": "8d013e42-c377-332b-afa4-2e31c8ef5c83",
                                                "text": "Der TÜV prüft bei der Kfz.-Abnahme auch die Manschetten der Antriebswelle und der Achsen."
                                            },
                                            {
                                                "example_id": "0ceb86c2-aacb-4f3f-a824-38c643d2d97d",
                                                "sense_id": "8d013e42-c377-332b-afa4-2e31c8ef5c83",
                                                "text": "„Unsere Manschetten dienen als flexibles Verbindungsstück zur Montage in Rohrleitungen für chemische Abluft und sind in verschiedenen Ausführungen erhältlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c31da3e5-2115-3b29-a75c-379ef5de76ba",
                                        "entry_id": "609e0599-3869-3221-9535-9200ca61f372",
                                        "glosses": [
                                            "aufblasbarer Schlauch, der zur Blutdruckmessung um den Oberarm gelegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8805296b-01b7-4eb5-9baa-338fd007e72d",
                                                "sense_id": "c31da3e5-2115-3b29-a75c-379ef5de76ba",
                                                "text": "Den Blutdruck misst man durch eine angelegte, aufblasbare Manschette am Oberarm, welche die Arterie mit einem bestimmten Druck staut."
                                            },
                                            {
                                                "example_id": "f5033812-b9e8-4c06-9802-038dde2e8655",
                                                "sense_id": "c31da3e5-2115-3b29-a75c-379ef5de76ba",
                                                "text": "„Die Manschette füllte sich mit Luft und der Ton veränderte sich, wurde mit zunehmendem Druck höher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "aaae922c-b3fc-313a-8538-0bd4561dbd1e",
                                        "entry_id": "609e0599-3869-3221-9535-9200ca61f372",
                                        "glosses": [
                                            "verbotener Würgegriff beim sportlichen Ringen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2ed4e732-e94f-3153-9b26-67fee6be1798",
                                        "entry_id": "609e0599-3869-3221-9535-9200ca61f372",
                                        "glosses": [
                                            "zierende Rosette aus Krepppapier um einen Blumentopf oder Blumenstrauß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ddb4bc1-63e7-47eb-8a41-6f6534990089",
                                                "sense_id": "2ed4e732-e94f-3153-9b26-67fee6be1798",
                                                "text": "Für das Usambaraveilchen hätte ich die Manschette gerne in altrosa."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
