                                "target_senses": [
                                    {
                                        "sense_id": "e59bb82f-9b09-3764-bc9d-b19884ae5d6b",
                                        "entry_id": "be92eb6b-c4a7-362a-bf91-e18f8dd7c4a2",
                                        "glosses": [
                                            "Bruit de souffle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b30e428-8fe2-45d4-96ad-b8d0df1323e0",
                                                "sense_id": "e59bb82f-9b09-3764-bc9d-b19884ae5d6b",
                                                "text": "— Grégory, enfin ! Le Tram arrive.\n— Désolé pff, pff. Répondit-il essoufflé. Je n'ai pas vu l’heure passer et j'ai dû me dépêcher. Merci de m'avoir attendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2943bb9-fb37-338e-8b00-4f18d0989e9b",
                                        "entry_id": "be92eb6b-c4a7-362a-bf91-e18f8dd7c4a2",
                                        "glosses": [
                                            "Bruit d'un soupir de fatigue, de soulagement, de bonheur, d’agacement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48dc4eba-08a3-4459-90b9-48f58948d808",
                                                "sense_id": "f2943bb9-fb37-338e-8b00-4f18d0989e9b",
                                                "text": "Pff… j'en peux plus."
                                            },
                                            {
                                                "example_id": "f9c6fc93-5c03-40d2-960d-e6ee25dfa772",
                                                "sense_id": "f2943bb9-fb37-338e-8b00-4f18d0989e9b",
                                                "text": "Surtout, borde ben l’couv’-pied d’ton côté, conseilla Buddy dans l'obscurité en poussant un pff... de bien-être."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e594b26b-6cf5-375b-a47b-afd3461d4349",
                                        "entry_id": "be92eb6b-c4a7-362a-bf91-e18f8dd7c4a2",
                                        "glosses": [
                                            "Bruit d'un soupir d'agacement ou d'exaspération."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17cf5d5d-8568-4fd2-8352-3cac41117dee",
                                                "sense_id": "e594b26b-6cf5-375b-a47b-afd3461d4349",
                                                "text": "Pff… moi aussi je peux faire ça."
                                            },
                                            {
                                                "example_id": "7e810e40-6f50-4afb-8ce1-e59410158af4",
                                                "sense_id": "e594b26b-6cf5-375b-a47b-afd3461d4349",
                                                "text": "— Pff... encore cette vieille histoire sordide ! Le vieux Jacobus est mort maintenant. Et puis quel rapport ça a avec Marius à la fin ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
