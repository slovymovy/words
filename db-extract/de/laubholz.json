                        ],
                        "examples": [
                            {
                                "example_id": "4ceb2c69-0ac7-4d13-958c-f179afaa1a8d",
                                "sense_id": "7a041dbf-cb7e-3e48-a6d6-875609420130",
                                "text": "Buche ist ein hartes Laubholz.",
                                "translation": "Beech is a hard hardwood.",
                                "english": "Beech is a hard hardwood."
                            },
                            {
                                "example_id": "e2d23b90-f4b7-4490-89af-47a89a4e9b9c",
                                "sense_id": "7a041dbf-cb7e-3e48-a6d6-875609420130",
                                "text": "Ahorn ist ein mittelmäßig hartes Laubholz.",
                                "translation": "Maple is a moderately hard hardwood.",
                                "english": "Maple is a moderately hard hardwood."
                            },
                            {
                                "example_id": "cfa0ac78-7f78-464a-b1e6-de64c1ff70a3",
                                "sense_id": "7a041dbf-cb7e-3e48-a6d6-875609420130",
                                "text": "Erle ist ein weicheres Laubholz.",
                                "translation": "Alder is a softer hardwood.",
                                "english": "Alder is a softer hardwood."
                            },
                            {
                                "example_id": "ae1c21fc-ec07-4f83-99d5-e4980c731c03",
                                "sense_id": "7a041dbf-cb7e-3e48-a6d6-875609420130",
                                "text": "Pappel ist ein sehr weiches Laubholz.",
                                "translation": "Poplar is a very soft hardwood.",
                                "english": "Poplar is a very soft hardwood."
                            }
                        ]
                    }
