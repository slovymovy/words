                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf16030-1629-45a8-a47d-e219f74f9e5e",
                                "sense_id": "9a2932a5-b8f7-3ae4-b715-206711d2bd9c",
                                "text": "„Frau Ava, eine Klausnerin im Umkreis des Klosters Melk, stirbt der Überlieferung nach in Kleinwien bei Göttweig.“"
                            },
                            {
                                "example_id": "31fd05a2-12e5-468d-9fe5-7f31adc1d9ca",
                                "sense_id": "9a2932a5-b8f7-3ae4-b715-206711d2bd9c",
                                "text": "„Ich antwortete meiner lieben Klausnerin sofort und wollte ihr, wie sie mich geheißen hatte, nur vier oder sechs Zeilen schreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
