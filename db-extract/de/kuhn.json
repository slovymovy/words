                ],
                "senses": [
                    {
                        "sense_id": "1db53a84-1e5c-3f68-8ecf-6cbb42321cdc",
                        "entry_id": "3cd4cdbe-6729-36d7-921e-4b70fdaa2a19",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ec39de2-203b-4390-86b2-dabe9a2b0551",
                                "sense_id": "1db53a84-1e5c-3f68-8ecf-6cbb42321cdc",
                                "text": "Herr Kuhn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1b6ee334-ac21-4e62-9c50-fbe367e22cb8",
                                "sense_id": "1db53a84-1e5c-3f68-8ecf-6cbb42321cdc",
                                "text": "Die Kuhns fliegen heute nach Kanada."
                            },
                            {
                                "example_id": "1ca91597-6f46-46b1-abce-f8baba51b1f1",
                                "sense_id": "1db53a84-1e5c-3f68-8ecf-6cbb42321cdc",
                                "text": "Der Kuhn trägt nie die Pullover, die die Kuhn ihm strickt."
                            },
                            {
                                "example_id": "a7446708-997d-4f40-898e-9945faede725",
                                "sense_id": "1db53a84-1e5c-3f68-8ecf-6cbb42321cdc",
                                "text": "Frau Kuhn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f4905a9d-c651-4e41-9d70-8b3909fd2705",
                                "sense_id": "1db53a84-1e5c-3f68-8ecf-6cbb42321cdc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kuhn kommt, geht der Herr Kuhn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
