                "senses": [
                    {
                        "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                        "entry_id": "ce032dde-0e7e-34b3-a39d-23676be1cdc5",
                        "glosses": [
                            "Raum in einem Gebäude, der zum Zweck des Betens eingerichtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9be919bb-5eb8-4618-bdf1-095f3d8c3f07",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Der Gebetsraum ist mit 53 m Länge und 51 m Breite fast quadratisch.“"
                            },
                            {
                                "example_id": "2fcb7e2d-db96-4b68-99d3-a398be9bfa08",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„1200 Gläubige fasst der Gebetsraum, der noch spärlich besucht ist.“"
                            },
                            {
                                "example_id": "fdf16dd6-66b2-42a3-8ab8-9b9f2674ade2",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Der Großteil des Materials wurde aus der Türkei importiert, inklusive des cremefarbenen Natursteins im Gebetsraum des Gotteshauses.“"
                            },
                            {
                                "example_id": "6164e043-7364-49d4-9ad6-709a4b77dbcb",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Ilan Shalom beginnt das Nachmittagsgebet. Sein Oberkörper wiegt vor und zurück, er ist konzentriert. Selbst als ein paar kleine Jungen,“ […] „durch den Gebetsraum flitzen und hinter ihm durch eine Flügeltür zum Musikunterricht verschwinden, lässt er sich nichts anmerken.“"
                            },
                            {
                                "example_id": "41b1b9df-07e5-467a-b0a6-8518fc1588e7",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Vor dem Betreten des Gebetsraumes zieht man die Schuhe aus.“"
                            },
                            {
                                "example_id": "a8dcb8c9-076f-494c-ae03-8c3311036951",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Die Männer treten aus dem Gebetsraum und holen ihre Schuhe aus dem Regal. Eine Handvoll Gläubige ist an diesem Abend zum Gebet gekommen.“"
                            },
                            {
                                "example_id": "38cc2c99-c025-45ed-9338-a04a261f2017",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Es mag verwundern in einem Land, das Statistiken pflegt und gerne Ordnung hält. Aber niemand kennt die Zahl der Moscheen und islamischen Gebetsräume in Deutschland.“"
                            },
                            {
                                "example_id": "a713902c-6cfb-44e7-8e8e-123cd04920f8",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "[Schlagzeile:] „Mob verwüstet muslimischen Gebetsraum auf Korsika“"
                            },
                            {
                                "example_id": "ffab3db0-ba99-47e5-8309-5b6e7c136297",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Ohnehin war der Gebetsraum in einem Hinterhof für die Gemeinde zu klein geworden.“"
                            },
                            {
                                "example_id": "6afdec77-428d-4b29-9fa3-4ef07842280f",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Im Zentrum steht der Gebetsraum, in dem die Gebetsrichtung (Arabisch: „Qibla“) unbedingt angezeigt werden muss.“"
                            },
                            {
                                "example_id": "68bcf9d8-cc55-462a-b92d-3f1338d06420",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Der islamisch-albanische Kulturverein kauft eine alte Garage. Darin entstehen ein Gebetsraum und Seminarräume.“"
                            },
                            {
                                "example_id": "d9915349-642a-4b9d-96ba-3b42e6402fbc",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Schon allein, dass im Gebetsraum einer Moschee gesungen wird, sei eigentlich nicht üblich, erzählt Nigar Yardim, Mitarbeiterin der Merkez-Begegnungsstätte“ […]."
                            },
                            {
                                "example_id": "4d9e02c7-ac9c-4ec4-a942-26d9e4f489e8",
                                "sense_id": "f034e84f-6438-32ca-b585-2ae6c90bab19",
                                "text": "„Das Rednerpult kann zum Altar umgebaut werden, an der Decke zeigt eine Lampe die Himmelsrichtungen an: In einem Seniorenheim teilen sich Christen, Juden, Muslime und Buddhisten einen symbolneutralen Gebetsraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
