                        "sense_id": "cde1f202-a00b-36f7-b352-38ed5b8272cf",
                        "entry_id": "bb7a56d7-ca9a-32d1-8710-896c65eebcf9",
                        "glosses": [
                            "To knit together; to unite closely; to intertwine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd717d5-0f04-4e78-a0ca-c2571af33e5d",
                                "sense_id": "cde1f202-a00b-36f7-b352-38ed5b8272cf",
                                "text": "Also that I might rear as fits my house\nMy children, and, giving brothers to thy sons,\nBind them in one, and having interknit\nMy family, live on in happy case."
                            },
                            {
                                "example_id": "4227d45c-9208-421c-8044-cb512c4c1efc",
                                "sense_id": "cde1f202-a00b-36f7-b352-38ed5b8272cf",
                                "text": "\"You know how close I feel to you. Interknitted. Brother and brother.\""
                            }
                        ]
                    }
                ],
