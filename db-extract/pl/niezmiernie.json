                "senses": [
                    {
                        "sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "glosses": [
                            "w sposób niezmierny; bardzo, wielce, intensywnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ebb901-6d9c-4cff-86c4-b7e7210b5c2e",
                                "sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                                "text": "Dbałość o estetyczne szczegóły jest niezmiernie potrzebna do właściwej identyfikacji firmy lub regionu na rynku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad84e8f8-de63-4de9-8ab4-e29b009d1e8a",
                        "source_entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "source_sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "target_lang_word": "inordinately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inordinately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb19ea0-b9bb-397f-b41f-d1a77fa454d5",
                                        "entry_id": "4cfb12af-fbed-3e00-850e-dff7893de764",
                                        "glosses": [
                                            "In an inordinate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5951d470-5af3-43c7-9f51-9f906c0ae1ef",
                                                "sense_id": "5fb19ea0-b9bb-397f-b41f-d1a77fa454d5",
                                                "text": "Every being, which during its natural lifetime produces several eggs or seeds, must suffer destruction during some period of its life, and during some season or occasional year, otherwise, on the principle of geometrical increase, its numbers would quickly become so inordinately great that no country could support the product."
                                            },
                                            {
                                                "example_id": "c2ed6d95-5d93-4a44-8bfc-9c827d8faf29",
                                                "sense_id": "5fb19ea0-b9bb-397f-b41f-d1a77fa454d5",
                                                "text": "And then she giggles, inordinately pleased by her own cleverness."
                                            },
                                            {
                                                "example_id": "9c2808ac-3329-441c-b810-8d93114f0c52",
                                                "sense_id": "5fb19ea0-b9bb-397f-b41f-d1a77fa454d5",
                                                "text": "The emphasis on boosting “meaningful social interactions” between friends and family meant that the feed leant towards reshared material, which was often misinformed and toxic. “Misinformation, toxicity and violent content are inordinately prevalent among reshares,” said internal research."
                                            },
                                            {
                                                "example_id": "53e3f09f-d164-47d1-95c2-0752683a813b",
                                                "sense_id": "5fb19ea0-b9bb-397f-b41f-d1a77fa454d5",
                                                "text": "They’d [nucelar reactors] become inordinately expensive to build and maintain, in any case, especially compared to solar and wind installations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3437d925-4cbe-42b3-b518-3b708b46844b",
                        "source_entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "source_sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "target_lang_word": "extremely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                        "entry_id": "e5bf5b87-4cf8-366d-9216-d93d791e806f",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b11ba7-cbeb-4ade-a797-8de651f7a86b",
                                                "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                                "text": "The National Center for Health Statistics' latest data indicate that quintuplets are extremely rare, with 66 reported sets of five or more babies in 2013."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f25dff60-4726-4d51-9640-c35017bd6df5",
                        "source_entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "source_sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "target_lang_word": "exceedingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exceedingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5da69fff-3d73-37bb-a7b0-5da8592f5734",
                                        "entry_id": "14c22dbc-187a-37ee-9095-5fb03d96c16e",
                                        "glosses": [
                                            "To a great or unusual degree, extent, etc.; extremely"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "360a3171-705b-447e-baed-c8cd2e6543ae",
                                                "sense_id": "5da69fff-3d73-37bb-a7b0-5da8592f5734",
                                                "text": "1865, Henry David Thoreau, Cape Cod, Chapter II. \"Stage-coach Views\", page 16.\nThis coach was an exceedingly narrow one […]"
                                            },
                                            {
                                                "example_id": "6f608a8b-5134-4d42-a80a-1f00d437610f",
                                                "sense_id": "5da69fff-3d73-37bb-a7b0-5da8592f5734",
                                                "text": "I gasped and nearly sank to the ground, for I knew that such a situation must result in some dreadful tragedy, of which it seemed exceedingly probable to me that I should be the first victim."
                                            },
                                            {
                                                "example_id": "c5c894a4-9193-4316-8696-26438161e1b0",
                                                "sense_id": "5da69fff-3d73-37bb-a7b0-5da8592f5734",
                                                "text": "It is an exceedingly easy thing for a Governor or a President to go along with the drift of the tide, to veto vicious legislation, to give honest administration, to lead a perfectly peaceful life, and to avoid criticism or attack. Of such are the hundreds of forgotten Governors and the dozens of Presidents whom we have to look up in a history book."
                                            },
                                            {
                                                "example_id": "e7a9b4f0-d473-4d07-9ad8-981e5396c884",
                                                "sense_id": "5da69fff-3d73-37bb-a7b0-5da8592f5734",
                                                "text": "American Eagle released a campaign starring the exceedingly charismatic actress Sydney Sweeney."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84ea9ed7-02ad-4918-bc3b-f770c71c112b",
                        "source_entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "source_sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "target_lang_word": "immensely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immensely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                        "entry_id": "f0599c2e-414a-3c02-a7bb-95c23ddb8e57",
                                        "glosses": [
                                            "Greatly; hugely; extremely; vastly; to a great extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa08dbe-1a69-423a-b149-5f26818e4a14",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "I enjoyed the party immensely."
                                            },
                                            {
                                                "example_id": "b0dd134c-6a32-46e6-a5dd-5b5c3e32cf53",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "This question is immensely difficult."
                                            },
                                            {
                                                "example_id": "21a48fe3-7741-4033-9d95-fbf0a3618600",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "Then, too, he was always ready to constitute himself a hostile army or a band of marauding Indians on the shortest possible notice: in brief, a distinctly able man, with talents, so far as we could judge, immensely above the majority."
                                            },
                                            {
                                                "example_id": "bb1888cc-c08e-42ec-91f2-eb5a9d25285a",
                                                "sense_id": "f11a6fa6-cff0-30ad-9e34-ee16b65f6256",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\"[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5430d2b9-b1d1-4f33-8b26-b20e66689574",
                        "source_entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "source_sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "target_lang_word": "vastly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vastly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "503e62d1-eb23-398f-9f5a-04f6bb8a8a03",
                                        "entry_id": "a297b871-a756-3a4c-bf92-cae4546d039a",
                                        "glosses": [
                                            "Greatly, in a vast manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ee650a-1127-499b-8414-6b73c39c3cd1",
                                                "sense_id": "503e62d1-eb23-398f-9f5a-04f6bb8a8a03",
                                                "text": "“I have visited my quarters, and find them very comfortable.[…]Steerage is like everything else maritime[…]vastly improved since Robert Louis Stevenson took his trip third class to New York.”"
                                            },
                                            {
                                                "example_id": "b7f2d41c-e2b6-4301-b6ec-9a6764d92604",
                                                "sense_id": "503e62d1-eb23-398f-9f5a-04f6bb8a8a03",
                                                "text": "After Trump spoke with Canadian Prime Minister Justin Trudeau in April 2017, the two sides offered vastly different accounts of what was discussed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46557c2b-c625-4acb-a5fa-d8e9bdeabad8",
                        "source_entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "source_sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "target_lang_word": "infiniment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infiniment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a35e2f-8b0a-30e1-a0cf-97772c9c67e6",
                                        "entry_id": "b8bd67f3-18dc-3a7e-9393-e2756ffab4c7",
                                        "glosses": [
                                            "D’une manière infinie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d60f3ae-9ddc-4398-b1c1-27af550c8f8e",
                                                "sense_id": "a6a35e2f-8b0a-30e1-a0cf-97772c9c67e6",
                                                "text": "L’espace, le temps étendu infiniment."
                                            },
                                            {
                                                "example_id": "7f473acd-0706-4ca7-836c-5006c12428d9",
                                                "sense_id": "a6a35e2f-8b0a-30e1-a0cf-97772c9c67e6",
                                                "text": "Étant infiniment puissant, comme il est infiniment bon, il [Dieu] veut tout le bien qu’il peut faire, et il fait tout le bien qu’il veut."
                                            },
                                            {
                                                "example_id": "ec523f93-a568-469a-982f-dd69872d764a",
                                                "sense_id": "a6a35e2f-8b0a-30e1-a0cf-97772c9c67e6",
                                                "text": "Cette idée [de Leibnitz, qu’il n'y a pas deux objets absolument semblables dans la nature] est grande ; il paraît qu’il n'y a qu’un être tout-puissant qui ait pu faire des choses infinies infiniment différentes."
                                            },
                                            {
                                                "example_id": "71431096-6a59-409d-a9d7-64909c624788",
                                                "sense_id": "a6a35e2f-8b0a-30e1-a0cf-97772c9c67e6",
                                                "text": "Notre globe est infiniment moins qu’un grain de sable en comparaison de ces millions de milliards d’univers devant lesquels nous disparaissons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10712fef-275b-3340-bba6-655dbc15e8c0",
                                        "entry_id": "b8bd67f3-18dc-3a7e-9393-e2756ffab4c7",
                                        "glosses": [
                                            "Extrêmement ; beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3c1494-596a-48a4-8aa8-3ac43a645234",
                                                "sense_id": "10712fef-275b-3340-bba6-655dbc15e8c0",
                                                "text": "Quand je ne considérerais point mes intérêts, je ne me pourrais empêcher de regretter infiniment une personne de qui vous étiez infiniment aimée."
                                            },
                                            {
                                                "example_id": "7c361432-cdca-4aea-9782-db8822e6a5b5",
                                                "sense_id": "10712fef-275b-3340-bba6-655dbc15e8c0",
                                                "text": "Ce serait le reconnaître [le pape] pour infaillible, blesser infiniment nos libertés, ruiner les appels au concile général."
                                            },
                                            {
                                                "example_id": "c6326786-8ac3-4efe-bbb4-3f9b19e77cd0",
                                                "sense_id": "10712fef-275b-3340-bba6-655dbc15e8c0",
                                                "text": "Nous suivons toujours la route qui nous avait menés à Sokhrat Ed-Djeja, il y a près d'un mois. Mais la campagne, verte et fleurie, est infiniment plus jolie qu’alors."
                                            },
                                            {
                                                "example_id": "4de9b511-81dd-4602-9679-58775277ed36",
                                                "sense_id": "10712fef-275b-3340-bba6-655dbc15e8c0",
                                                "text": "Autour de lui la forêt frouait infiniment, à croire qu'un vol immense de ramier très bas, occupait tout le ciel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "497c8af3-c712-324d-a4cf-e31825687457",
                                        "entry_id": "b8bd67f3-18dc-3a7e-9393-e2756ffab4c7",
                                        "glosses": [
                                            "Extrêmement beaucoup de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af58c770-f7b6-44be-a8a1-9f3a082ac749",
                                                "sense_id": "497c8af3-c712-324d-a4cf-e31825687457",
                                                "text": "M. Aurélien Scholl ne me croira pas, mais M. de B… avait lu Schopenhauer, il le goûtait beaucoup, et, détail inexplicable, il avait infiniment d’esprit avec infiniment de bonté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "830cf3ae-9b96-42ba-b5f5-eb8b990e3d0c",
                        "source_entry_id": "0bb9d70c-45f3-3bba-9efb-980665cd39d3",
                        "source_sense_id": "013cb202-e371-3616-b667-b53e2cc5dab4",
                        "target_lang_word": "unermesslich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unermesslich",
