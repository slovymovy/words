                    "frequency": "Low",
                    "semantic_group_id": "verwaarlozing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De controle door vakgenoten mag nooit <w>verslappen</w> om de kwaliteit van het onderzoek te waarborgen.",
                            "target_lang_translations": {
