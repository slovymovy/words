                "senses": [
                    {
                        "sense_id": "7518962b-3172-3a1a-af81-04c4eb7591d0",
                        "entry_id": "9933e435-4932-33f1-a095-f8721f433687",
                        "glosses": [
                            "Appareil portatif qui intègre dans le même boîtier une caméra électronique et un magnétoscope."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "43fd32df-b233-4d7b-9237-c8f5e5857976",
                                "sense_id": "7518962b-3172-3a1a-af81-04c4eb7591d0",
                                "text": "Un caméscope numérique."
                            },
                            {
                                "example_id": "8fd76db2-4350-46bb-9d91-5a1c0c2ec72b",
                                "sense_id": "7518962b-3172-3a1a-af81-04c4eb7591d0",
                                "text": "Une caméra et un magnétoscope en un seul appareil, cela donne le caméscope, successeur surdoué du cinéma d’amateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e144ec4b-9315-4814-ac92-7dfb7fd25b39",
                        "source_entry_id": "9933e435-4932-33f1-a095-f8721f433687",
                        "source_sense_id": "7518962b-3172-3a1a-af81-04c4eb7591d0",
                        "target_lang_word": "camcorder",
                        "target_lang_code": "en",
