                ],
                "senses": [
                    {
                        "sense_id": "6e9ddd03-bbb9-3dc7-9253-8cd7bdee096d",
                        "entry_id": "d654e91c-36f2-356f-8bd4-0a2e4a9b0bb4",
                        "glosses": [
                            "gęsta, nieco sztywna, szeleszcząca tkanina jedwabna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cbaf0fb-7d0a-4e31-8b95-60e0c338f3eb",
                                "sense_id": "6e9ddd03-bbb9-3dc7-9253-8cd7bdee096d",
                                "text": "Podczas kolacji, jak wymaga tego gościnność, krążyła od stolika do stolika, od gościa do gościa, z każdym zamieniała kilka słów, zgrabna, prosto od fryzjera, z wielkim kwiatem z tafty w butonierce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77b36212-1ac9-48c4-af9a-b4eb73bd6ebf",
                        "source_entry_id": "d654e91c-36f2-356f-8bd4-0a2e4a9b0bb4",
                        "source_sense_id": "6e9ddd03-bbb9-3dc7-9253-8cd7bdee096d",
                        "target_lang_word": "taffeta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taffeta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df15a160-7a16-39cf-88cb-0e460a77e4d9",
                                        "entry_id": "317efbb3-a181-33db-b649-684b0bb905b9",
                                        "glosses": [
                                            "A crisp, smooth woven fabric made from silk or synthetic fibers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a8883f-07f1-4e80-9622-de4fee6e2a8d",
                                                "sense_id": "df15a160-7a16-39cf-88cb-0e460a77e4d9",
                                                "text": "Could a Taff'ta ſcarf, a long Eſtridge vvhing, / A ſtiffe Iron Doublet, and a Brazeel Pole / Tempt thee from Cambrick ſheets, fine active Thighs, / From Caudles vvhere the precious Amber ſvvims?"
                                            },
                                            {
                                                "example_id": "a7aa70f4-3def-48fd-bccc-509f20d630b2",
                                                "sense_id": "df15a160-7a16-39cf-88cb-0e460a77e4d9",
                                                "text": "For a festive dinner, the belles pull out the stops. “Pull it tighter,” one urges as her corset is laced. Having unearthed their taffeta gowns from deep storage, they show off pinched waists, bare arms, throats and shoulders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cd32c39-5955-4e2a-9ff3-08e77ed9041b",
                        "source_entry_id": "d654e91c-36f2-356f-8bd4-0a2e4a9b0bb4",
                        "source_sense_id": "6e9ddd03-bbb9-3dc7-9253-8cd7bdee096d",
                        "target_lang_word": "taffetas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taffetas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29a48b22-5f0b-3b10-979e-0118aca631cc",
                                        "entry_id": "5ab6ef9f-32a9-387f-92a1-c1ee87218b63",
                                        "glosses": [
                                            "Peur."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "taffetas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bfdf474-3a42-3d50-9c40-25dd64a3d99c",
                                        "entry_id": "d534b97b-ba2e-3360-8e3a-391fc116ad1d",
                                        "glosses": [
                                            "Étoffe de soie très mince et tissée comme de la toile."
                                        ],
                                        "tags": [
                                            "Soierie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb84ac28-36b4-4e0b-b65a-9517237a2636",
                                                "sense_id": "6bfdf474-3a42-3d50-9c40-25dd64a3d99c",
                                                "text": "Madame Grandet mettait constamment une robe de levantine verdâtre, qu'elle s'était accoutumée à faire durer près d'une année ; elle portait un grand fichu de cotonnade blanche, un chapeau de paille cousue, et gardait presque toujours un tablier de taffetas noir. Sortant peu du logis, elle usait peu de souliers."
                                            },
                                            {
                                                "example_id": "8a975c96-62dd-40c9-ad8d-33479d42200f",
                                                "sense_id": "6bfdf474-3a42-3d50-9c40-25dd64a3d99c",
                                                "text": "Voici d’abord, assis dans les stalles sculptées qui entourent le chœur, le sire de Trinquelage, en habit de taffetas saumon, et près de lui tous les nobles seigneurs invités."
                                            },
                                            {
                                                "example_id": "d8d921c5-ba59-4e91-889d-3edd1e947be4",
                                                "sense_id": "6bfdf474-3a42-3d50-9c40-25dd64a3d99c",
                                                "text": "Rappelons cependant que Chardon était de tenue négligée. En 1780, il possédait :\nUn surtout de sirsacas rayé jaune et blanc.\nUne redingote de taffetas à petits carreaux."
                                            },
                                            {
                                                "example_id": "dd45fa67-1208-425a-83cf-7b04cd0bbf0f",
                                                "sense_id": "6bfdf474-3a42-3d50-9c40-25dd64a3d99c",
                                                "text": "Elles croyaient devoir manifester leur dévotion par l’extravagance de leurs toilettes ; elles portaient des corsages en taffetas changeant, à manches gigot, avec des guimpes baleinées ; leurs jupes balayaient le plancher."
                                            },
                                            {
                                                "example_id": "79a44dba-5d6f-46d4-a9b8-d9eb01997b18",
                                                "sense_id": "6bfdf474-3a42-3d50-9c40-25dd64a3d99c",
                                                "text": "parmi nous circulait une dame absolument décidée à épingler sur chaque veston, pour un franc, une fleur d'oranger de taffetas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df7111dc-b8a5-3c92-8682-c5eb72c8b4c9",
                                        "entry_id": "d534b97b-ba2e-3360-8e3a-391fc116ad1d",
                                        "glosses": [
                                            "Pansement, morceau d'étoffe imprégné d'un cicatrisant."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2e3e30-1153-4212-8c5f-1dd0122853e5",
                                                "sense_id": "df7111dc-b8a5-3c92-8682-c5eb72c8b4c9",
                                                "text": "Taffetas d’Angleterre, taffetas gommé, taffetas gommé d’un côté qu’on applique sur les coupures."
                                            },
                                            {
                                                "example_id": "a5a41059-a65a-40af-bb37-fc0c38c42f49",
                                                "sense_id": "df7111dc-b8a5-3c92-8682-c5eb72c8b4c9",
                                                "text": "Au premier pharmacien qu’il rencontre le voici qui montre son mal. L’homme de l’art sourit, vieillard verdâtre, d’aspect malsain, qui cueille dans une boîte un petit rond de taffetas, passe dessus sa large langue et…"
                                            },
                                            {
                                                "example_id": "ea7eee76-a97c-4ccc-8b9d-f5f8456feb25",
                                                "sense_id": "df7111dc-b8a5-3c92-8682-c5eb72c8b4c9",
                                                "text": "Telcide est arrêtée par Marie, qui s’est enfoncé une aiguille dans le doigt et qui cherche le carnet de taffetas gommé."
                                            },
                                            {
                                                "example_id": "bb2068ac-aa2e-4893-9b5e-a59a4b8efbc1",
                                                "sense_id": "df7111dc-b8a5-3c92-8682-c5eb72c8b4c9",
                                                "text": "Quelques dames de la Croix-Rouge, fortes d’une inaction prolongée, les traînèrent d’autorité au dispensaire pour coller du taffetas anglais sur les entailles de leur menton rasé de trop près…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e548a5a-a693-463f-886a-680b4a15cabf",
                        "source_entry_id": "d654e91c-36f2-356f-8bd4-0a2e4a9b0bb4",
                        "source_sense_id": "6e9ddd03-bbb9-3dc7-9253-8cd7bdee096d",
                        "target_lang_word": "Taft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                                        "entry_id": "0e7c5e50-c903-306d-8756-c16ea9fb0ddf",
                                        "glosses": [
                                            "aus Seide oder Kunstseide gewobener, glänzender Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09375433-5337-435e-bbe2-7e2e2932f518",
                                                "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                                                "text": "Sie trug ein Kleid aus schwarzem Taft."
                                            },
                                            {
                                                "example_id": "3fe9bda2-efa0-4d0a-bd1b-5e27ec3ce1af",
                                                "sense_id": "bf9ced3a-e7ac-32fd-a85d-755e3625d5c6",
                                                "text": "„C. C. trug nur ein kurzes Mieder aus Taft und einen Rock aus dem gleichen Stoff; das war alles, was sie anhatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
