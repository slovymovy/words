                                "target_senses": [
                                    {
                                        "sense_id": "f9181ccb-3812-3a0a-8c96-94b38c66696a",
                                        "entry_id": "07eec09a-a4a6-35b3-9420-6caad50a537e",
                                        "glosses": [
                                            "To form or cause to form a helix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "220f5f2a-1bf4-40c9-bc64-b232bb87b106",
                                                "sense_id": "f9181ccb-3812-3a0a-8c96-94b38c66696a",
                                                "text": "A large positive inclination gives a chip which will helix out of the space between the face mill and the workpiece."
                                            },
                                            {
                                                "example_id": "67898835-854c-489a-8d41-8bf6456fdcc9",
                                                "sense_id": "f9181ccb-3812-3a0a-8c96-94b38c66696a",
                                                "text": "When the shaft is unsupported, the large torque tends to helix the inner core, and if the casing is not stiff enough, it will helix the casing also."
                                            },
                                            {
                                                "example_id": "335e3b28-0588-4155-94eb-91ab5877be6b",
                                                "sense_id": "f9181ccb-3812-3a0a-8c96-94b38c66696a",
                                                "text": "The decrease in d enhances the probability that remaining SDLs will helix, leading to an outward traveling wave of helixing and a jump in 5d."
                                            },
                                            {
                                                "example_id": "92f021ea-8311-4c54-9c6a-383def6227e5",
                                                "sense_id": "f9181ccb-3812-3a0a-8c96-94b38c66696a",
                                                "text": "Conceptually, this field will helix up from the genital tip, here modelled as the caudal singularity of the left and right domains of the H-CFs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b1aed8b-265c-4a72-8fb9-67514f67d104",
                        "source_entry_id": "8d06d25c-1a21-32dd-a24a-12c4d455e0f7",
                        "source_sense_id": "25d90765-9dff-3bf8-b0da-c860402b85a1",
                        "target_lang_word": "hélice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hélice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0b8553a-f64f-3408-ae5d-40c98efbbed0",
                                        "entry_id": "2e9530fe-e773-39cd-9c06-6049784004a3",
                                        "glosses": [
                                            "Ligne tracée en forme de vis autour d’un cylindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb30c151-b4c1-460b-8929-edddecda9c0c",
                                                "sense_id": "b0b8553a-f64f-3408-ae5d-40c98efbbed0",
                                                "text": "Un escalier en hélice est composé de marches qui tournent avec la même inclinaison autour d’un pilier cylindrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5748d82-0ccb-3976-a824-dda51d236f33",
                                        "entry_id": "2e9530fe-e773-39cd-9c06-6049784004a3",
                                        "glosses": [
                                            "Petites volutes qui entrent dans la composition du chapiteau corinthien."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dbe94cb-6c0d-3b46-a926-9f70ff098053",
                                        "entry_id": "2e9530fe-e773-39cd-9c06-6049784004a3",
                                        "glosses": [
                                            "Certains coquillages univalves, contournés en spirale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f016d2e-cfb0-4a67-8300-f69a9037f6a7",
                                                "sense_id": "8dbe94cb-6c0d-3b46-a926-9f70ff098053",
                                                "text": "C’est un consommateur effréné d’insectes de tout ordre. Mes archives de chasseur naturaliste font foi du contenu de son gésier. On y trouve tout le petit peuple des guérets : larves et charançons de toutes espèces, criquets, opatres, cassides, chrysomèles, grillons, forficules, fourmis, araignées, cloportes, hélices, iules et tant d’autres."
                                            },
                                            {
                                                "example_id": "02475f4e-3aa7-40b7-b132-f8f87fff34c6",
                                                "sense_id": "8dbe94cb-6c0d-3b46-a926-9f70ff098053",
                                                "text": "Le limaçon est une hélice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ce405be-e3be-3842-bbfe-9200c23f7201",
                                        "entry_id": "2e9530fe-e773-39cd-9c06-6049784004a3",
                                        "glosses": [
                                            "Appareil de propulsion qui rappelle la forme de la vis, composé de plusieurs branches et mis en action par un moteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05db0695-a9ac-4e32-9d39-811af46dffc1",
                                                "sense_id": "8ce405be-e3be-3842-bbfe-9200c23f7201",
                                                "text": "— Le voyageur qui s’embarque sur le méchant petit bateau qui fait trois fois par semaine le service entre Algésiras et Tanger, jouit à mesure que tourne l’hélice d’un spectacle véritablement beau."
                                            },
                                            {
                                                "example_id": "2a1f06f6-230c-456e-973c-febe00aea8f0",
                                                "sense_id": "8ce405be-e3be-3842-bbfe-9200c23f7201",
                                                "text": "— Bien protégé derrière le pare-brise, le déplacement d'air provoqué par la rotation de l'hélice m'effleurait à peine les joues."
                                            },
                                            {
                                                "example_id": "1acedfc1-33b5-4059-b435-9f7a38708534",
                                                "sense_id": "8ce405be-e3be-3842-bbfe-9200c23f7201",
                                                "text": "L’hélice tournait plus lentement, pour maintenir seulement l’aéronat contre la brise, et son ronflement était beaucoup plus perceptible […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb86974-e7d4-3cfd-a210-9dd118538b5d",
                                        "entry_id": "2e9530fe-e773-39cd-9c06-6049784004a3",
                                        "glosses": [
                                            "Hélice bipale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa4c713a-37b6-3506-9d3c-63cae0b38ed1",
                                        "entry_id": "2e9530fe-e773-39cd-9c06-6049784004a3",
                                        "glosses": [
                                            "Structure tridimensionnelle en forme d'hélice de certaines molécules ou de certaines parties de molécules."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
