{
    "word_family": [
        "mangaka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ea381f8-6d5d-3cfa-a218-ddc9c9f74d8e",
                    "sense_definition": "A comic book or graphic novel originating in Japan.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "japanese_comics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves reading <w>manga</w> on the weekends.",
                            "target_lang_translations": {
                                "ru": "Она любит читать <w>мангу</w> по выходным.",
                                "zh": "她喜欢在周末看<w>漫画</w>。",
                                "es": "Le encanta leer <w>manga</w> los fines de semana."
                            }
                        },
                        {
                            "text": "Many popular anime series are based on a best-selling <w>manga</w>.",
                            "target_lang_translations": {
                                "ru": "Многие популярные аниме-сериалы основаны на бестселлерах <w>манги</w>.",
                                "zh": "许多热门动画系列都是根据一部畅销<w>漫画</w>改编的。",
                                "es": "Muchas series de anime populares están basadas en un <w>manga</w> superventas."
                            }
                        }
                    ],
                    "synonyms": [
                        "Japanese comic",
                        "graphic novel"
                    ],
                    "common_phrases": [
                        "read manga",
                        "manga series",
                        "manga artist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Японские комиксы или графические романы.",
                        "zh": "起源于日本的漫画书或图像小说。",
                        "es": "Cómic o novela gráfica de origen japonés."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ма́нга",
                                "target_lang_sense_clarification": "японские комиксы"
                            },
                            {
                                "target_lang_word": "япо́нские ко́миксы",
                                "target_lang_sense_clarification": "описание жанра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漫画",
                                "target_lang_sense_clarification": "源自日本的漫画作品"
                            },
                            {
                                "target_lang_word": "日本漫画",
                                "target_lang_sense_clarification": "强调日本来源"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "manga",
                                "target_lang_sense_clarification": "género de historietas japonesas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcab3096-1694-3889-bdee-c79ccd9f8776",
                    "sense_definition": "An artistic style of drawing heavily associated with Japanese comics.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "japanese_comics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character was drawn in a distinct <w>manga</w> style.",
                            "target_lang_translations": {
                                "ru": "Персонаж был нарисован в характерном стиле <w>манга</w>.",
                                "zh": "这个角色是以一种鲜明的<w>漫画风格</w>画出来的。",
                                "es": "El personaje fue dibujado con un estilo <w>manga</w> distintivo."
                            }
                        },
                        {
                            "text": "Many young artists try to imitate the <w>manga</w> aesthetic.",
                            "target_lang_translations": {
                                "ru": "Многие молодые художники пытаются подражать эстетике <w>манги</w>.",
                                "zh": "许多年轻艺术家都试图模仿这种<w>漫画风格</w>的审美。",
                                "es": "Muchos artistas jóvenes intentan imitar la estética <w>manga</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "manga style",
                        "manga art"
                    ],
                    "target_lang_definitions": {
                        "ru": "Художественный стиль рисования, тесно связанный с японскими комиксами.",
                        "zh": "一种与日本漫画密切相关的绘画艺术风格。",
                        "es": "Estilo artístico de dibujo asociado a los cómics japoneses."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиль манга",
                                "target_lang_sense_clarification": "художественный стиль"
                            },
                            {
                                "target_lang_word": "ма́нга",
                                "target_lang_sense_clarification": "как стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漫画风格",
                                "target_lang_sense_clarification": "与日本漫画相关的绘画风格"
                            },
                            {
                                "target_lang_word": "日漫风格",
                                "target_lang_sense_clarification": "强调日本漫画特色的风格"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "estilo manga",
                                "target_lang_sense_clarification": "estilo artístico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e074e72-554d-31d2-a116-0411449f3170",
                    "sense_definition": "A comic created in the Japanese style, regardless of its country of origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "japanese_comics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is writing a French <w>manga</w> set in Paris.",
                            "target_lang_translations": {
                                "ru": "Он пишет французскую <w>мангу</w>, действие которой происходит в Париже.",
                                "zh": "他正在创作一部以巴黎为背景的法国<w>日式漫画</w>。",
                                "es": "Él está escribiendo un <w>manga</w> francés ambientado en París."
                            }
                        },
                        {
                            "text": "Global publishers are producing original <w>manga</w> for international audiences.",
                            "target_lang_translations": {
                                "ru": "Мировые издатели выпускают оригинальную <w>мангу</w> для международной аудитории.",
                                "zh": "世界各地的出版商正在为国际读者推出原创<w>日式漫画</w>。",
                                "es": "Las editoriales globales están produciendo <w>manga</w> original para audiencias internacionales."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комикс, созданный в японском стиле, вне зависимости от страны происхождения.",
                        "zh": "按日本漫画风格创作的漫画，不论其原产国为何。",
                        "es": "Cómic creado al estilo japonés, independientemente de su origen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ма́нга",
                                "target_lang_sense_clarification": "в японском стиле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日式漫画",
                                "target_lang_sense_clarification": "不论产地、但采用日式漫画表现方式的作品"
                            },
                            {
                                "target_lang_word": "漫画风作品",
                                "target_lang_sense_clarification": "强调按日本漫画风格创作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "manga",
                                "target_lang_sense_clarification": "estilo de cómic"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cfd7c68-00b5-3a18-b6c2-76a31544245e",
                    "sense_definition": "An obsolete spelling of <w>mango</w> (the fruit).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old recipe called for a ripe <w>manga</w>.",
                            "target_lang_translations": {
                                "ru": "В старинном рецепте требовалось спелое <w>манго</w>.",
                                "zh": "这份老食谱要求用一个熟透的<w>芒果</w>。",
                                "es": "La receta antigua requería un <w>mango</w> maduro."
                            }
                        },
                        {
                            "text": "Travelers in the 17th century described the sweet taste of the <w>manga</w>.",
                            "target_lang_translations": {
                                "ru": "Путешественники в XVII веке описывали сладкий вкус <w>манго</w>.",
                                "zh": "17世纪的旅行者描述了这种<w>芒果</w>的甜味。",
                                "es": "Los viajeros del siglo XVII describieron el sabor dulce del <w>mango</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "form of mango"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова «манго» (фрукт).",
                        "zh": "“mango”（芒果）的过时拼写。",
                        "es": "Forma antigua de escribir la palabra mango (la fruta)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манго",
                                "target_lang_sense_clarification": "фрукт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芒果",
                                "target_lang_sense_clarification": "水果；mango 的旧写法"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mango",
                                "target_lang_sense_clarification": "fruta"
                            }
                        ]
                    }
