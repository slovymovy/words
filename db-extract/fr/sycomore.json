            {
                "entry_id": "c5e509a3-4215-302f-a924-aa182034c110",
                "word": "sycomore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa622fa0-8809-4e37-bb53-76d5491f4fde",
                        "entry_id": "c5e509a3-4215-302f-a924-aa182034c110",
                        "tags": [
                            "plural"
                        ],
