                    {
                        "sense_id": "d0a2b7fc-bfe6-3517-a792-d63b64131463",
                        "entry_id": "ed97ee55-3a74-3b67-b5c7-2b872f1d0364",
                        "glosses": [
                            "Of or pertaining to the ant subfamily Myrmicinae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "411c0d04-a2c6-4994-b604-11f2a9fb1e55",
                                "sense_id": "d0a2b7fc-bfe6-3517-a792-d63b64131463",
                                "text": "The discovery of tandem calling with pheromones in Leptothorax throws considerable light on the evolution of chemical recruitment techniques in myrmicine ants generally."
                            },
                            {
                                "example_id": "a4b43e80-f052-48ef-b2b6-1267f9d79112",
                                "sense_id": "d0a2b7fc-bfe6-3517-a792-d63b64131463",
                                "text": "The chemistry of the myrmicine genus Solenopsis is so aberrant that it reduces generalizations about ant venoms to the absurd."
                            }
                        ]
                    },
                    {
                        "sense_id": "43c00369-aa36-32c7-9b74-b3790cf3c9a5",
                        "entry_id": "ed97ee55-3a74-3b67-b5c7-2b872f1d0364",
                        "glosses": [
                            "Of or pertaining to the ant genus Myrmica."
                        ],
