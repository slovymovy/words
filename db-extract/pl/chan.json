                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79f6cee5-ef99-3fc0-88fe-2b3d3635c973",
                                        "entry_id": "bf2633f9-0a3b-3611-b30c-47503ccee3a7",
                                        "glosses": [
                                            "A ruler over various Turkic and Mongol peoples in the Middle Ages."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b52b4955-bb7e-3b7e-924d-1e30ac2ded0c",
                                        "entry_id": "bf2633f9-0a3b-3611-b30c-47503ccee3a7",
                                        "glosses": [
                                            "An Ottoman sultan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7d56131-9792-3410-a2d5-cb233ea30fc3",
                                        "entry_id": "bf2633f9-0a3b-3611-b30c-47503ccee3a7",
                                        "glosses": [
                                            "A noble or man of rank in various Muslim countries of Central Asia, including Afghanistan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "khan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d17e0949-7cb3-3570-a1ec-0a3f73228a5c",
                                        "entry_id": "3d6b2a02-69f6-354a-88b0-ac9cfa4fe59c",
                                        "glosses": [
                                            "Synonym of caravanserai (particularly in Middle Eastern contexts)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc19bbc-87d1-4f80-998d-2be5bbf38d3c",
                                                "sense_id": "d17e0949-7cb3-3570-a1ec-0a3f73228a5c",
                                                "text": "‘Guess the name of that,’ she said, pointing to her delicate parts. The porter tried this name and that and ended by asking her to tell him and cease her slapping. ‘The khān of Abu-Mansur,’ she replied."
                                            },
                                            {
                                                "example_id": "633ce4e3-af84-4307-957b-0da1199b0999",
                                                "sense_id": "d17e0949-7cb3-3570-a1ec-0a3f73228a5c",
                                                "text": "At each of these stations there is a hostelry which they call a khan, where travellers alight with their beasts, and outside each khan is a public watering-place and a shop at which the traveller may buy what he requires for himself and his beast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb3a61c-6179-3664-855c-5f73803a6968",
                                        "entry_id": "3d6b2a02-69f6-354a-88b0-ac9cfa4fe59c",
                                        "glosses": [
                                            "Synonym of fonduk (“inn or hotel in Middle Eastern contexts”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98690d92-a66a-44f1-9417-fff93cd9110c",
                        "source_entry_id": "77eb2ecd-9330-39ee-ae8e-314a647dc869",
                        "source_sense_id": "0ce4ae29-beab-33db-91fc-c0f220245503",
                        "target_lang_word": "chán",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c318a23e-8cde-49d6-b791-e0003c204442",
                        "source_entry_id": "77eb2ecd-9330-39ee-ae8e-314a647dc869",
                        "source_sense_id": "0ce4ae29-beab-33db-91fc-c0f220245503",
                        "target_lang_word": "khan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c35609-b0c7-3d1e-9ca1-d26d446ab058",
                                        "entry_id": "39dab922-0de8-3013-aada-5bd4c363a468",
                                        "glosses": [
                                            "Prince commandant chez les Mongols (autrefois appelés Tartares), les chefs d’État de Perse d’origine mongole, etc. Qagan (qaganus en latin) pour l’empereur déjà chez les Huns vers 450."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b12f5f5a-df51-4ef0-9ceb-3d92e5925ab9",
                                                "sense_id": "f5c35609-b0c7-3d1e-9ca1-d26d446ab058",
                                                "text": "Ainsi, les institutions d’inspiration gengiskhanide mutèrent-elles pour répondre à des circonstances que les prédécesseurs de Möngke-Temur n’auraient pu imaginer. La flexibilité propre à ce modèle y fut rarement aussi évidente. Sous son régime, le khan parvint à équilibrer les pouvoirs de ses rivaux au sein de l’empire, à imposer la loi et l’ordre mongols à des sujets sédentaires totalement étrangers à cette culture politique."
                                            },
                                            {
                                                "example_id": "f1db0a4a-ed77-4c1d-9648-cde4c06db8b0",
                                                "sense_id": "f5c35609-b0c7-3d1e-9ca1-d26d446ab058",
                                                "text": "Mais, d’une génération à l’autre, les khans turcs avaient acquis les fâcheuses manies des monarques persans. Ils se considéraient comme des demi-dieux, s’entourant d’un cérémonial de plus en plus complexe, incompréhensible et même humiliant pour leurs officiers."
                                            },
                                            {
                                                "example_id": "8cc86c87-6876-4f8f-a758-c19d04c58436",
                                                "sense_id": "f5c35609-b0c7-3d1e-9ca1-d26d446ab058",
                                                "text": "J’y visite un palais des Khans, pur produit de l’architecture du temps de Schahriar et de Schéhérazade, « fille de la Lune », […]."
                                            },
                                            {
                                                "example_id": "ae07bd2c-538b-42b8-945f-7262872848fd",
                                                "sense_id": "f5c35609-b0c7-3d1e-9ca1-d26d446ab058",
                                                "text": "Les tribus turcomanes qui nomadisent au nord de Khiva reconnaissent depuis longtemps la souveraineté nominale du khan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "khan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a719c67a-3010-3d59-b4f3-98aa61ee573b",
                                        "entry_id": "c979a624-1f5b-3d36-9e79-898245a5922c",
                                        "glosses": [
                                            "Lieu où les caravanes se reposent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "480c539b-a20c-469f-b20a-95358cb2d9a5",
                                                "sense_id": "a719c67a-3010-3d59-b4f3-98aa61ee573b",
                                                "text": "Nous atteignîmes le khan avant la nuit."
                                            },
                                            {
                                                "example_id": "b4d1d6d1-c8f6-4400-b25f-b372fc5c170b",
                                                "sense_id": "a719c67a-3010-3d59-b4f3-98aa61ee573b",
                                                "text": "Au bord de ce torrent desséché, et au centre à peu près de ces monticules, nous rencontrâmes un kan ombragé de deux platanes et rafraîchi par une petite fontaine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "khan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5864c63b-4a0e-382c-a5db-daecbfceac3a",
                                        "entry_id": "d5f11343-599b-39c1-ac3e-2c7980de496e",
                                        "glosses": [
                                            "Vingt-deuxième lettre de l’alphabet géorgien, ka."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
