                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c9cb82-9f59-463d-8c8c-1ee2bccfb7d0",
                                "sense_id": "5a16b09f-320a-33ef-b30c-f049e0f0d7b6",
                                "text": "Il pleure, rentre et réhiberne quarante jours jusqu'aux Quarante Martyrs (9-10 mars)."
                            },
                            {
                                "example_id": "770eb5d3-7cf0-43f0-93d5-12fd4ccb0180",
                                "sense_id": "5a16b09f-320a-33ef-b30c-f049e0f0d7b6",
                                "text": "Il se réveille tous les 30 ans pour se nourrir du foie de ses victimes, avant de réhiberner."
                            },
