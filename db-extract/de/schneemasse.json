                ],
                "senses": [
                    {
                        "sense_id": "708e969c-eae4-3ab1-b201-4459ba24f2bf",
                        "entry_id": "56bc12cc-5484-3c5d-becc-170a8535d98c",
                        "glosses": [
                            "eine (große) Menge Schnee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17294e8d-a3ce-4ff5-97a6-ff9781bfd428",
                                "sense_id": "708e969c-eae4-3ab1-b201-4459ba24f2bf",
                                "text": "Eine herabstürzende Schneemasse nennt man Lawine."
                            },
                            {
                                "example_id": "80d0c75e-c003-4271-a731-a6c3a72faf35",
                                "sense_id": "708e969c-eae4-3ab1-b201-4459ba24f2bf",
                                "text": "„Erst Anfang des Jahres verunglückte aber ein Österreicher in den Alpen, obwohl er sich dank eines Lawinen-Airbags aus der Schneemasse befreien konnte.“"
                            },
                            {
                                "example_id": "93cb0c85-7ae6-4816-bdf5-b964e51a369e",
                                "sense_id": "708e969c-eae4-3ab1-b201-4459ba24f2bf",
                                "text": "„Es wird vermutet, dass das Dach des Fertigbaus unter den Schneemassen zusammenbrach.“"
                            },
                            {
                                "example_id": "1ae63bc7-0f12-40a9-ac4b-55786e053bee",
                                "sense_id": "708e969c-eae4-3ab1-b201-4459ba24f2bf",
                                "text": "„Oft zu sehen dieser Tage im Süden und Nordosten der USA: Eine Schneepflugkolonne versucht den plötzlichen Schneemassen zu trotzen.“"
                            },
                            {
                                "example_id": "04c9151e-0c8d-4427-ba29-3442617fbf4b",
                                "sense_id": "708e969c-eae4-3ab1-b201-4459ba24f2bf",
                                "text": "„Eine beliebte Skiroute oberhalb von Mittenwald wurde wegen der lockeren Schneemassen in den Steilhängen gesperrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
