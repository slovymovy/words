                                "target_senses": [
                                    {
                                        "sense_id": "7a021fb7-f672-3c19-8225-c865b39d8fa4",
                                        "entry_id": "89364e48-f345-30f5-9ff3-798eabfbaa81",
                                        "glosses": [
                                            "Personne qui pratique le canoé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98539c9c-457b-442f-985a-041ba947f647",
                                                "sense_id": "7a021fb7-f672-3c19-8225-c865b39d8fa4",
                                                "text": "Un canoéiste qui ne pagaierait que d’un côté tournerait indéfiniment en rond."
                                            },
                                            {
                                                "example_id": "81a7a3a6-80cf-433d-9576-b9cea57b637f",
                                                "sense_id": "7a021fb7-f672-3c19-8225-c865b39d8fa4",
                                                "text": "Et pour cause : le GIP, coprésidé par l’ancien douanier Bernard Lapasset et le canoéiste triple champion olympique Tony Estanguet a dessiné une grille salariale mettant le futur président du Cojo, un certain Estanguet Tony, sur la première marche du podium, avec 452 000 euros par an."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a565c48-306b-4c6b-bab9-632d609fb8d9",
                        "source_entry_id": "56e19fcd-adc6-3e9b-bdb8-62c0193841f9",
                        "source_sense_id": "68797484-3046-36ad-8e99-3b13388da37d",
                        "source_sense_description": "person who travels by canoe",
                        "target_lang_word": "Kanufahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanufahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                                        "entry_id": "a72791a9-5b9d-393b-8f9d-5e4508a10906",
                                        "glosses": [
                                            "jemand, der Kanu fährt; der das Kanufahren betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8829ed1c-da3b-40aa-b42c-26f5fda8f100",
                                                "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                                                "text": "Die Kanufahrer trainierten eifrig für die Weltmeisterschaft."
                                            },
                                            {
                                                "example_id": "acde9567-6d6d-4500-b810-86ca28690d84",
                                                "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                                                "text": "„Donnerstagvormittag herrscht an der Neuen Donau jenseits der Steinspornbrücke noch die übliche beschauliche Ruhe: Radfahrer und Inlineskater rollen am Ufer entlang, Kanufahrer gleiten über das Wasser, nur zwischendurch gellt aus dem sommertrockenen Gras ein Quietschen, wo sich zwei Nagetiere in die Quere geraten sind.“"
                                            },
                                            {
                                                "example_id": "58c05b5a-24df-443d-a104-517bdc8576dd",
                                                "sense_id": "45265745-af99-3f6d-8d0a-6bdf7301496a",
                                                "text": "„In der Moesa fahren mehr als 80 Kanufahrer um den Sieg im Classic-Rennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1acf1bbe-bc5c-4cc3-b41f-ed5fc545b808",
