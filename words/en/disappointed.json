    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "062951df-bb40-3c5e-94aa-0ed46f17b17b",
                    "sense_definition": "Feeling sad, unhappy, or displeased because something was not as good as expected or because something did not happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feeling_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was deeply <w>disappointed</w> when she did not get the job she wanted.",
                            "target_lang_translations": {
                                "ru": "Она была глубоко <w>разочарована</w>, когда не получила желаемую работу.",
                                "tr": "İstediği işi alamayınca derin bir <w>hayal kırıklığına uğradı</w>."
                            }
                        },
                        {
                            "text": "I am <w>disappointed</w> in your behavior during the meeting.",
                            "target_lang_translations": {
                                "ru": "Я <w>разочарован</w> твоим поведением во время встречи.",
                                "tr": "Toplantı sırasındaki davranışından dolayı hayal kırıklığına <w>uğradım</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "satisfied",
                        "pleased",
                        "delighted"
                    ],
                    "common_phrases": [
                        "deeply disappointed",
                        "bitterly disappointed",
                        "disappointed with",
                        "disappointed in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий грусть или недовольство из-за того, что ожидания не оправдались.",
                        "tr": "Bir şeyin beklenildiği kadar iyi olmaması veya gerçekleşmemesi nedeniyle üzgün, mutsuz veya hoşnutsuz hissetme durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разочарованный",
                                "target_lang_sense_clarification": "о чувстве"
                            },
                            {
                                "target_lang_word": "расстроенный",
                                "target_lang_sense_clarification": "опечаленный чем-то"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hayal kırıklığına uğramış",
                                "target_lang_sense_clarification": "beklentisi karşılanmamış olma durumu"
                            },
                            {
                                "target_lang_word": "kırgın",
                                "target_lang_sense_clarification": "birine karşı duyulan düş kırıklığı"
                            },
                            {
                                "target_lang_word": "üzgün",
                                "target_lang_sense_clarification": "beklentisi boşa çıktığı için mutsuz"
                            }
                        ]
