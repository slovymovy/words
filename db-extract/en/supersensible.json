                        "glosses": [
                            "Beyond the range of what is perceptible by the senses; not belonging to the experienceable physical world."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0526d47-81a1-4e0c-be31-585ea78302da",
                                "sense_id": "3a8efe1b-6ad2-3b2c-aa84-4d22fee52ef4",
                                "text": "Heaven is a supersensible realm."
                            },
                            {
                                "example_id": "dec81bdc-371d-42db-8a83-1449b67698ec",
                                "sense_id": "3a8efe1b-6ad2-3b2c-aa84-4d22fee52ef4",
                                "text": "The imagination, therefore, must furnish to religion and to metaphysics those large ideas tinctured with passion, those supersensible forms shrouded in awe, in which alone a mind of great sweep and vitality can find its congenial objects."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd70b9fb-e79c-36ed-943e-572d40b5f708",
                        "entry_id": "85b2174c-d4e4-3010-9089-bde42a9102f1",
                        "glosses": [
                            "Extremely sensible; excessively sensitive or aware of something."
                        ],
                        "tags": [],
                        "examples": [
                            {
