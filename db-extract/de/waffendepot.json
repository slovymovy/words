                "senses": [
                    {
                        "sense_id": "d54604de-30ec-3b01-ac6b-3aa8746ce608",
                        "entry_id": "36fb0410-14ff-3e02-9e33-92490982c017",
                        "glosses": [
                            "Ort, an dem Waffen gelagert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "809296e8-e608-44e1-80bf-1a771c4e0040",
                                "sense_id": "d54604de-30ec-3b01-ac6b-3aa8746ce608",
                                "text": "„Das war zunächst wenig sensationell, da beide Guerillaarmeen zur Rückversicherung solche Waffendepots angelegt hatten.“"
                            },
                            {
                                "example_id": "43f6caf9-5aed-4263-add0-0b7381013490",
                                "sense_id": "d54604de-30ec-3b01-ac6b-3aa8746ce608",
                                "text": "„Jede Einheit musste im Wechsel das Waffendepot der Universität bewachen, das der Zuständigkeit der Stadtgarnison unterlag.“"
                            },
                            {
                                "example_id": "71f36654-9889-4f54-9335-6daa74c5c28a",
                                "sense_id": "d54604de-30ec-3b01-ac6b-3aa8746ce608",
                                "text": "„So entdeckte man bei einer Razzia in dem südlibanesischen Dorf Sultaniyah, das nur wenige Kilometer von dem Ort des Überfalls auf den israelischen Konvoi entfernt lag, im Keller eines privaten Wohnhauses ein vermutlich von der Hisbollah angelegtes Waffendepot, in dem sich rund hundert Raketen - Kaliber 122 Millimeter mit einer Reichweite von 20 Kilometern - und zahlreiche Panzerfäuste befanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
