                    {
                        "sense_id": "4f2f80c2-38fd-3b1a-a2d9-8fd42edf08fb",
                        "entry_id": "6f0dca33-3f8a-3c83-a1b6-a96541617ef2",
                        "glosses": [
                            "Person oder Programm, die etwas in die gewünschte Form bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b03c45b-e8c9-4e28-8e80-5d537fbbeb81",
                                "sense_id": "4f2f80c2-38fd-3b1a-a2d9-8fd42edf08fb",
                                "text": "„Liegt es womöglich daran, dass die jeweiligen Musikchefs und ‚Formatierer‘ der Sendeflächen hinter dem Songtitel einen Schlager vermuten und noch gar nicht hineingehört haben?“"
                            },
                            {
                                "example_id": "aa11761b-07e2-4805-b431-e95ac60ba8c1",
                                "sense_id": "4f2f80c2-38fd-3b1a-a2d9-8fd42edf08fb",
                                "text": "„Nur, falls Ihre Kinder bald sagen: ‚Mama, ich möchte Formatierer werden.‘“"
                            },
                            {
                                "example_id": "e006da78-98fe-4b8e-9453-bceb94dabadf",
                                "sense_id": "4f2f80c2-38fd-3b1a-a2d9-8fd42edf08fb",
                                "text": "„Wenn Sie einen anderen Formatierer mit dem passenden Namen installiert haben, können Sie auch diesen benutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
