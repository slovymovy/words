                "senses": [
                    {
                        "sense_id": "d7685ac7-de8e-393b-adae-5db23fd32262",
                        "entry_id": "ac8392a7-a4c7-3f1a-b351-faf400ad46cf",
                        "glosses": [
                            "Annuler la grâce accordée à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b755b821-ef22-4d69-8e12-2ca8e5d2193c",
                                "sense_id": "d7685ac7-de8e-393b-adae-5db23fd32262",
                                "text": "Mais, quand on lui expliqua qu’il fallait partir, il se fâcha et entreprit des démarches de manière à se faire « dégracier » et à rester interné jusqu’à sa mort."
                            },
                            {
                                "example_id": "077272cc-ce2f-4dc3-af7b-3864491ef387",
                                "sense_id": "d7685ac7-de8e-393b-adae-5db23fd32262",
                                "text": "Le pédophile espagnol, gracié puis dégracié par le roi du Maroc, a été arrêté à Murcie, en Espagne."
                            }
                        ]
                    }
