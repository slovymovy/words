                ],
                "senses": [
                    {
                        "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                        "entry_id": "1ee4c852-74e0-324d-afe1-9d1b5237d512",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "411967e3-423c-4358-b7e3-3aac15dddd1d",
                                "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                                "text": "Frau Chemnitzer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e0631a30-daed-4d1a-9e15-93f6d3b9b4f6",
                                "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                                "text": "Herr Chemnitzer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3a279eb6-9d38-49ca-8df6-cdea3734f397",
                                "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                                "text": "Die Chemnitzers kommen heute aus der Oberlausitz."
                            },
                            {
                                "example_id": "07e4ca3a-8a8f-4f34-aacb-c4e25bc6e80e",
                                "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                                "text": "Der Chemnitzer trägt nie die Schals, die die Chemnitzer ihm strickt."
                            },
                            {
                                "example_id": "32c66dec-fdfe-4310-86cc-e225417d2e24",
                                "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Chemnitzer kommt, geht der Herr Chemnitzer.“"
                            },
                            {
                                "example_id": "04bc78a8-bbfa-4bdb-a08b-5e8d1e099eef",
                                "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                                "text": "Chemnitzer kommt und geht."
                            },
                            {
                                "example_id": "1dd64a20-841a-4c3d-a82f-e0a3e000bb63",
                                "sense_id": "c8da2bfa-ba0d-3c3d-964d-a61d2864434f",
                                "text": "Chemnitzers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
