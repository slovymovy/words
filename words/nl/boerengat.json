                    "sense_id": "ea778bd3-cd1c-3ade-a3a4-7f7bb863e098",
                    "sense_definition": "een klein gehucht of dorp dat ver van de grote stad ligt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afgelegen plaats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben opgegroeid in een <w>boerengat</w> waar bijna nooit iets spannends gebeurde.",
                            "target_lang_translations": {
                                "en": "I grew up in a <w>backwater</w> where almost nothing exciting ever happened."
                            }
                        },
                        {
                            "text": "Om te winkelen moet ik vanuit dit <w>boerengat</w> minstens een uur rijden naar de stad.",
                            "target_lang_translations": {
                                "en": "To go shopping, I have to drive at least an hour to the city from this <w>one-horse town</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dorp",
                        "gehucht"
                    ],
                    "antonyms": [
                        "wereldstad",
                        "metropool"
                    ],
                    "common_phrases": [
