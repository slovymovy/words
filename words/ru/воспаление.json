                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В тесной избе стояло такое <w>воспаление</w>, что трудно было дышать.",
                            "target_lang_translations": {
                                "en": "There was such <w>intense heat</w> in the cramped hut that it was difficult to breathe.",
                                "nl": "In de krappe hut was het zo <w>broeierig</w> dat het moeilijk was om te ademen.",
                                "pl": "W ciasnej izbie panował taki <w>zaduch</w>, że trudno było oddychać.",
                                "de": "In der engen Hütte herrschte eine solche <w>Gluthitze</w>, dass es schwer war zu atmen.",
                                "fr": "Il régnait dans la cabane étroite une telle <w>chaleur intense</w> qu'il était difficile de respirer.",
                                "it": "Nella capanna angusta c'era un tale <w>caldo intenso</w> che era difficile respirare.",
                                "cs": "V těsné jizbě bylo takové <w>horko</w>, že se dalo stěží dýchat.",
                                "tr": "Dar kulübede o kadar <w>boğucu bir sıcak</w> vardı ki nefes almak zordu.",
                                "es": "En la pequeña cabaña hacía un <w>calor intenso</w> que dificultaba la respiración.",
                                "zh": "狭窄的小屋里闷热得让人难以呼吸，简直是<w>酷热</w>难耐。"
                            }
