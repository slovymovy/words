                ],
                "senses": [
                    {
                        "sense_id": "1354a68f-51f5-3c15-86d3-a0dca8d1fb52",
                        "entry_id": "7ad272f8-ad27-356f-bcbb-2a6224dd2987",
                        "glosses": [
                            "Herstellungsverfahren von Grünköpern an Wänden von Gipsformen oder porösen Kunststoffformen durch Dehydratation (Wasserentzug) des Schlickers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597af9d9-2e5d-47f5-96c2-9c1377bcb7a3",
                                "sense_id": "1354a68f-51f5-3c15-86d3-a0dca8d1fb52",
                                "text": "Der Schlickerguss wird zum Beispiel bei der klassischen Porzellanherstellung verwendet."
                            },
                            {
                                "example_id": "829fcc25-d7a0-480c-a061-4e1d311bb221",
                                "sense_id": "1354a68f-51f5-3c15-86d3-a0dca8d1fb52",
                                "text": "„Mit dem Schlickerguss können wir sehr komplexe Bauteile präzise mit geringem technischen Aufwand fertigen“, erklärt David Karl vom Forschungsteam."
                            },
                            {
                                "example_id": "6337c5e0-d99f-478b-9677-7e6207d531d9",
                                "sense_id": "1354a68f-51f5-3c15-86d3-a0dca8d1fb52",
                                "text": "Der Schlickerguss hat ein großes Potential, da komplex geformte Keramiken auf einfache, kostengünstige und umweltfreundliche Weise hergestellt werden können."
                            },
                            {
                                "example_id": "44eb9aea-5c57-485a-abe7-2d64ece69c08",
                                "sense_id": "1354a68f-51f5-3c15-86d3-a0dca8d1fb52",
                                "text": "Beim keramischen Schlickerguß wird eine stabile Suspension, der sog. Schlicker, in eine poröse, saugfähige Gipsform gegossen."
                            },
                            {
                                "example_id": "2da1688e-4473-41dd-a92e-c308879081bb",
                                "sense_id": "1354a68f-51f5-3c15-86d3-a0dca8d1fb52",
                                "text": "Für tonbasierte Zusammensetzungen sind zwei Formgebungsverfahren gebräuchlich: das hydroplastische Formen (auch „bildsame Formgebung“) und der Schlickerguss."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
