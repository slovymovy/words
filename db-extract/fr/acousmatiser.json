                ],
                "senses": [
                    {
                        "sense_id": "f3f56de0-770c-3fad-9e74-46de93377ea7",
                        "entry_id": "9339e953-9865-347e-b78c-889d012dfd42",
                        "glosses": [
                            "Donner un caractère acousmatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec6a2d4-9f23-4844-8694-9dbfcaaa22d2",
                                "sense_id": "f3f56de0-770c-3fad-9e74-46de93377ea7",
                                "text": "Le fait même d’intégrer sa voix acousmatisée implique l’auto-réflexivité."
                            },
                            {
                                "example_id": "c831753f-8a4e-4f25-8280-39ab65eb742d",
                                "sense_id": "f3f56de0-770c-3fad-9e74-46de93377ea7",
                                "text": "Et ici justement, la présence de la mère et la terreur qu'elle inspire sont dues d’abord à sa voix, souvent «acousmatisée»."
                            },
                            {
                                "example_id": "ee95d1f3-a045-44f7-bdae-567e95393dc1",
                                "sense_id": "f3f56de0-770c-3fad-9e74-46de93377ea7",
                                "text": "Ce type de narrateur peut, en revanche, se présenter à nous d’abord, et donner lieu, ensuite, au récit transémiotisé, afin de s’acousmatiser, pourrait-on dire."
                            }
                        ]
                    }
