                                    {
                                        "sense_id": "438d7337-2417-304a-a0d3-35379bcb189e",
                                        "entry_id": "e6050c22-b411-36ff-a028-959d2d919656",
                                        "glosses": [
                                            "Person, die eine Billion von einer Währungseinheit besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e53360b-4784-4e1c-bc06-c55598282c8a",
                                                "sense_id": "438d7337-2417-304a-a0d3-35379bcb189e",
                                                "text": "„Vergnügt, wie ein echter Potentat, lebte Rakkóx, ein mehrfacher Billionär, in den Großstädten Asiens und Europas und vergeudete natürlich sein Geld in Centnersäcken – er hatte es ja dazu.“"
                                            },
                                            {
                                                "example_id": "1358a3fa-5979-4d74-8995-4d889bad5394",
                                                "sense_id": "438d7337-2417-304a-a0d3-35379bcb189e",
                                                "text": "„Als der Texaner Reggie Theus entdeckte, dass er dank eines Fehlers in der Software seiner Bank zum mehrfachen Billionär geworden war, bot er seinen Landsleuten spontan an, die Staatsschulden zu bezahlen.“"
                                            },
                                            {
                                                "example_id": "6fad2324-8cdc-41c6-8bb0-9f6f0f143aac",
                                                "sense_id": "438d7337-2417-304a-a0d3-35379bcb189e",
                                                "text": "„Gibt es im 21. Jahrhundert den ersten Billionär?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
