{
    "word_family": [
        "ridesharing",
        "ridesharer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df801fab-7806-306b-af22-722fed4bf2d5",
                    "sense_definition": "A vehicle or service hired through a mobile application to transport passengers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will call a <w>rideshare</w> to get to the airport on time.",
                            "target_lang_translations": {
                                "ru": "Я вызову <w>машину</w>, чтобы добраться до аэропорта вовремя."
                            }
                        },
                        {
                            "text": "He took an Uber <w>rideshare</w> to the other side of town.",
                            "target_lang_translations": {
                                "ru": "Он поехал на другой конец города на <w>такси</w> Uber."
                            }
                        }
                    ],
                    "synonyms": [
                        "ride-hail"
                    ],
                    "common_phrases": [
                        "call a rideshare",
                        "order a rideshare",
                        "rideshare app"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство или услуга, заказанная через мобильное приложение для перевозки пассажиров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "райдшеринг",
                                "target_lang_sense_clarification": "сервис заказа поездок"
                            },
                            {
                                "target_lang_word": "такси",
                                "target_lang_sense_clarification": "в контексте приложений типа Uber"
                            },
                            {
                                "target_lang_word": "поездка",
                                "target_lang_sense_clarification": "заказанная через приложение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9dd50e2-8960-36b4-a4f6-6080b599f5d4",
                    "sense_definition": "An arrangement where people travel together in one car to share costs or reduce traffic.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors decided on a <w>rideshare</w> to get their kids to school.",
                            "target_lang_translations": {
                                "ru": "Соседи договорились о <w>совместных поездках</w>, чтобы возить детей в школу."
                            }
                        },
                        {
                            "text": "Setting up a <w>rideshare</w> program at work can help reduce parking issues.",
                            "target_lang_translations": {
                                "ru": "Организация программы <w>карпулинга</w> на работе может помочь решить проблемы с парковкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "carpool"
                    ],
                    "common_phrases": [
                        "rideshare program",
                        "daily rideshare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Договоренность о совместной поездке нескольких человек в одном автомобиле для разделения расходов или уменьшения трафика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карпулинг",
                                "target_lang_sense_clarification": "совместное использование автомобиля"
                            },
                            {
                                "target_lang_word": "совместная поездка",
                                "target_lang_sense_clarification": "с разделением расходов"
                            },
                            {
                                "target_lang_word": "попутка",
                                "target_lang_sense_clarification": "организованная через сервис"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c00abdb-175f-335b-a637-fc7a1554ca71",
                    "sense_definition": "To travel in a vehicle with others as part of a shared arrangement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many employees <w>rideshare</w> to the office to save money on gas.",
                            "target_lang_translations": {
                                "ru": "Многие сотрудники <w>ездят вместе</w> в офис, чтобы сэкономить на бензине."
                            }
                        },
                        {
                            "text": "If we <w>rideshare</w> every morning, we can use the carpool lane.",
                            "target_lang_translations": {
                                "ru": "Если мы будем <w>ездить на одной машине</w> каждое утро, мы сможем пользоваться полосой для спецтранспорта."
                            }
                        }
                    ],
                    "synonyms": [
                        "carpool"
                    ],
                    "common_phrases": [
                        "rideshare to work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ездить в одном транспортном средстве с другими людьми в рамках договоренности о совместном использовании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ездить вместе",
                                "target_lang_sense_clarification": "на одной машине"
                            },
                            {
                                "target_lang_word": "использовать карпулинг",
                                "target_lang_sense_clarification": "для совместных поездок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "556114f6-a7c7-33a4-8836-86a89be70fd7",
                    "sense_definition": "To work as a driver for a ride-hailing service.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transportation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>rideshare</w> on weekends to earn some extra income.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>подрабатывать извозом</w> по выходным, чтобы получить дополнительный доход."
                            }
                        },
                        {
                            "text": "She has been <w>ridesharing</w> for three years using her own car.",
                            "target_lang_translations": {
                                "ru": "Она уже три года <w>работает в такси</w> на своей собственной машине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rideshare for extra income"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать водителем в сервисе по заказу поездок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подрабатывать в такси",
                                "target_lang_sense_clarification": "через агрегаторы"
                            },
                            {
                                "target_lang_word": "работать в райдшеринге",
                                "target_lang_sense_clarification": "водителем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}