                    "sense_definition": "Stolen; recently taken illegally and therefore dangerous to possess.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police caught him trying to sell <w>hot</w> merchandise in the alley.",
