                    {
                        "form_id": "e1bb12ab-c853-4085-886d-6c41b80031cb",
                        "entry_id": "ed807a3d-6b4c-3a59-a747-7bb44fc46823",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "капу́стны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3273a4a4-d240-3e6a-bb17-0abe2afb49f2",
                        "entry_id": "ed807a3d-6b4c-3a59-a747-7bb44fc46823",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным капуста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "808bd6d1-44f9-46fe-ac04-8c97351289ac",
                                "sense_id": "3273a4a4-d240-3e6a-bb17-0abe2afb49f2",
                                "text": "В сенцах муругая коза гложет капустные кочерыжки."
                            },
                            {
                                "example_id": "1be1971d-52a9-462e-a64c-325d8279f0ff",
                                "sense_id": "3273a4a4-d240-3e6a-bb17-0abe2afb49f2",
                                "text": "Несколько капель лимонного сока, добавленных в воду, в которой варится капуста, избавят от капустного запаха и помогут сохранить яркий цвет капусты."
                            }
                        ]
                    },
                    {
                        "sense_id": "2118e175-8d24-347d-9da7-75dbd115b6f4",
                        "entry_id": "ed807a3d-6b4c-3a59-a747-7bb44fc46823",
                        "glosses": [
                            "приготовленный из капусты или с капустой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09e7c042-068a-4957-a094-2195366005f7",
                                "sense_id": "2118e175-8d24-347d-9da7-75dbd115b6f4",
                                "text": "Бабушка на кухне жарила капустные котлеты."
                            }
                        ]
                    },
                    {
