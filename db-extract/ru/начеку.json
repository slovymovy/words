                                "sense_id": "d5545070-855b-399e-a345-610fc55b2d57",
                                "text": "Будь начеку́.",
                                "translation": "Be on guard / stay alert / watch out / heads up.",
                                "english": "Be on guard / stay alert / watch out / heads up."
                            },
                            {
                                "example_id": "63c59866-c071-4b71-ae06-ec20fb304760",
                                "sense_id": "d5545070-855b-399e-a345-610fc55b2d57",
                                "text": "Про́сто, что́бы ты был начеку́.",
                                "translation": "Just to give you a heads up.",
                                "english": "Just to give you a heads up."
                            },
                            {
                                "example_id": "594fbd89-ed28-4be9-ae3d-578ab581bdff",
                                "sense_id": "d5545070-855b-399e-a345-610fc55b2d57",
                                "text": "Райо́нный ванда́л де́ржит мои́х сосе́дей начеку́.",
                                "translation": "The neighborhood vandal keeps my neighbors on edge.",
                                "english": "The neighborhood vandal keeps my neighbors on edge."
                            },
                            {
                                "example_id": "8d151775-f961-4180-b6f9-3186ca3b7b33",
                                "sense_id": "d5545070-855b-399e-a345-610fc55b2d57",
                                "text": "Я бу́ду начеку́, е́сли произойдёт что́-то подозри́тельное.",
                                "translation": "I'll keep an eye out for anything suspicious.",
                                "english": "I'll keep an eye out for anything suspicious."
                            }
                        ]
                    }
