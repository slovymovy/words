                ],
                "senses": [
                    {
                        "sense_id": "3bca057d-5b27-3c18-8430-b4d8cf2b84d5",
                        "entry_id": "73104256-9c37-3dce-823c-220810728b21",
                        "glosses": [
                            "Rendre précoce, semer de façon précoce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648ab9d8-2d21-456f-9f53-89c571d8c310",
                                "sense_id": "3bca057d-5b27-3c18-8430-b4d8cf2b84d5",
                                "text": "Cette année, il a souhaité précocifier dans une parcelle de 6 ha pour sécuriser la récolte et l'irrigation, et gagner des tours d'eau."
                            },
                            {
                                "example_id": "eef08260-870e-4eb6-801e-18881f742d04",
                                "sense_id": "3bca057d-5b27-3c18-8430-b4d8cf2b84d5",
                                "text": "L'agriculteur a tout intérêt à améliorer ses conditions de semis et à les précocifier."
                            },
                            {
                                "example_id": "b6b5db83-0855-4eac-b118-0bb4693a7d92",
                                "sense_id": "3bca057d-5b27-3c18-8430-b4d8cf2b84d5",
                                "text": "Les semis des céréales à paille ont tendance à se précocifier depuis plusieurs années, hors ils accentuent souvent certains accidents en culture par la suite."
                            }
                        ]
                    },
                    {
                        "sense_id": "15daa968-71ea-3ad9-9ce7-931e1c3b6eb1",
                        "entry_id": "73104256-9c37-3dce-823c-220810728b21",
                        "glosses": [
                            "Avoir lieu de façon de plus en plus précoce."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bb7566c1-f115-4de7-a046-b52034764e18",
                                "sense_id": "15daa968-71ea-3ad9-9ce7-931e1c3b6eb1",
                                "text": "Le fonds des savoirs communs augmentait. L’agilité d’esprit grandissait, les apprentissages se précocifiaient et la lenteur de l’école désespérait les jeunes qui tapaient des sms à toute allure sur leur mobile."
                            }
                        ]
                    }
