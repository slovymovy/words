                    {
                        "sense_id": "96f067aa-498b-3d48-a3cc-fddf4893133f",
                        "entry_id": "3eb6a241-7bf1-3e04-9262-dfb74bea5981",
                        "glosses": [
                            "Seife mit einer hautschonenden Zusammensetzung"
                        ],
                        "tags": [
                            "Körperpflege"
                        ],
                        "examples": [
                            {
                                "example_id": "79aa68dc-948a-4e1b-b92b-29d69e7ce098",
                                "sense_id": "96f067aa-498b-3d48-a3cc-fddf4893133f",
                                "text": "„Arztseife sorgt dafür, dass die Erreger auf den Händen sorgfältig entfernt werden.“"
                            },
                            {
                                "example_id": "0ffb541b-3cdd-4c77-bb5b-2e22055cd522",
                                "sense_id": "96f067aa-498b-3d48-a3cc-fddf4893133f",
                                "text": "„Schließlich verlangt er nach heißen Tüchern und einem Fass Arztseife, um sich die Hände zu waschen wie ein Herzchirurg vor seiner ersten Transplantation.“"
                            },
                            {
                                "example_id": "1990c02d-d25d-428c-b46a-2b61a7f41e76",
                                "sense_id": "96f067aa-498b-3d48-a3cc-fddf4893133f",
                                "text": "„Sogenannte Arztseifen oder Medizinische Seifen sind Seifen mit angeblich hautschonenden Zusammensetzungen. „Arztseife“ ist nicht unbedingt desinfizierend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
