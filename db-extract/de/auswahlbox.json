                "senses": [
                    {
                        "sense_id": "f877b7de-ca08-3d3b-a81b-e24f915f8a7f",
                        "entry_id": "5f06d703-c27b-343c-a451-4ae0a4bf307a",
                        "glosses": [
                            "Element von grafischen Bedieneroberflächen zur Auswahl einer Option unter einer genau vorgegebenen Auswahlmenge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32690e86-2f62-4a05-b68b-563137158276",
                                "sense_id": "f877b7de-ca08-3d3b-a81b-e24f915f8a7f",
                                "text": "„In der aufgeklappten Auswahlbox wird deutlich, dass hier nach sehr vielen Kriterien differenziert gesucht werden kann.“"
                            },
                            {
                                "example_id": "8bfc3c99-08b5-4645-bedc-4cc22bd2ee1d",
                                "sense_id": "f877b7de-ca08-3d3b-a81b-e24f915f8a7f",
                                "text": "„Sie werden feststellen, dass sich die Farbe bequem aus einer Auswahlbox auswählen lässt.“"
                            },
                            {
                                "example_id": "8cdb48ad-9396-4f09-b8f0-dd317a1c44b9",
                                "sense_id": "f877b7de-ca08-3d3b-a81b-e24f915f8a7f",
                                "text": "„Microsoft hat die Auswahlbox wesentlich dicker als in den vorherigen Versionen gemacht, so dass besser zu erkennen ist, welches Objekt gerade ausgewählt ist.“"
                            },
                            {
                                "example_id": "a0a8d926-1a11-4e2f-aadc-4ea0aab604ba",
                                "sense_id": "f877b7de-ca08-3d3b-a81b-e24f915f8a7f",
                                "text": "„Als Ergebnis wird am 30. Mai auf der Webseite www.ruhrpilot.de die Abfragemaske für die Routenplanung um eine unscheinbare Auswahlbox ergänzt.“"
                            },
                            {
                                "example_id": "3b123073-f77f-4de9-92ad-a4754fdbfe97",
                                "sense_id": "f877b7de-ca08-3d3b-a81b-e24f915f8a7f",
                                "text": "„Deren Ausrichtung wird über die Auswahlbox Position bestimmt, in der u.a. rechts- und linksbündig oder zentriert zur Auswahl bereitstehen.“"
                            },
                            {
                                "example_id": "05c5cfdd-e461-435f-a0a7-edeb7b3a71ba",
                                "sense_id": "f877b7de-ca08-3d3b-a81b-e24f915f8a7f",
                                "text": "„In der Auswahlbox Werkzeugkorrektur wird eingestellt, ob der Verfahrweg bezüglich des Werkzeugradius links, rechts oder auf der Profilkontur in Richtung der Bearbeitung verrechnet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
