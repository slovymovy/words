{
    "word_family": [
        "rendement",
        "reddition",
        "rente",
        "rentier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90687ada-bbd6-33ff-af14-f05dbffa99ec",
                    "sense_definition": "Restituer un objet ou une somme à la personne à qui elle appartient.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>rendre</w> ce livre à la bibliothèque avant la fin de la semaine."
                        },
                        {
                            "text": "Il a promis de me <w>rendre</w> tout l'argent emprunté dès le mois prochain."
                        }
                    ],
                    "synonyms": [
                        "restituer"
                    ],
                    "antonyms": [
                        "emprunter",
                        "garder"
                    ],
                    "common_phrases": [
                        "rendre un livre",
                        "rendre l'argent"
                    ]
                },
                {
                    "sense_id": "e5469ad6-f12b-3940-aa11-81218e385c0e",
                    "sense_definition": "Faire devenir ou amener dans un état particulier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "changement_d_etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette merveilleuse nouvelle va sans aucun doute le <w>rendre</w> très heureux."
                        },
                        {
                            "text": "Le bruit incessant des travaux commence vraiment à me <w>rendre</w> fou."
                        }
                    ],
                    "common_phrases": [
                        "rendre fou",
                        "rendre heureux",
                        "rendre triste"
                    ]
                },
                {
                    "sense_id": "b99df485-8971-38d3-a237-78a1fee2676a",
                    "sense_definition": "Donner en échange ou accomplir un acte envers autrui en réponse à une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "echange_ou_devoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est toujours prêt à <w>rendre</w> service quand un voisin a besoin d'aide."
                        },
                        {
                            "text": "Les citoyens se sont réunis pour <w>rendre</w> un hommage solennel aux victimes."
                        }
                    ],
                    "common_phrases": [
                        "rendre hommage",
                        "rendre la pareille",
                        "rendre service",
                        "rendre visite"
                    ]
                },
                {
                    "sense_id": "a66527cc-e6ed-34ac-9f1f-ea5c23e9fd00",
                    "sense_definition": "Aller dans un endroit déterminé ; s'y transporter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ministres doivent se <w>rendre</w> à Bruxelles pour une réunion importante."
                        },
                        {
                            "text": "Elle a décidé de se <w>rendre</w> sur place afin de constater les dégâts."
                        }
                    ],
                    "synonyms": [
                        "aller",
                        "se déplacer"
                    ],
                    "common_phrases": [
                        "se rendre au travail",
                        "se rendre sur place"
                    ]
                },
                {
                    "sense_id": "f03437c9-b204-374f-b49a-f0d425779aa8",
                    "sense_definition": "Cesser la lutte, s'avouer vaincu et se placer sous l'autorité d'un adversaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soumission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures d'encerclement, les soldats ennemis ont fini par se <w>rendre</w>."
                        },
                        {
                            "text": "Le voleur a préféré se <w>rendre</w> à la police plutôt que de fuir."
                        }
                    ],
                    "synonyms": [
                        "capituler",
                        "céder"
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "se rendre sans condition"
                    ]
                },
                {
                    "sense_id": "519b9d1d-b512-32e1-b5a3-572ea6c92c10",
                    "sense_definition": "Exprimer, dépeindre ou reproduire fidèlement une impression, une idée ou une réalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tableau parvient à merveilleusement bien <w>rendre</w> la lumière du couchant."
                        },
                        {
                            "text": "Les mots ne suffisent pas toujours pour <w>rendre</w> la complexité de cette émotion."
                        }
                    ],
                    "synonyms": [
                        "exprimer",
                        "restituer",
                        "traduire"
                    ],
                    "common_phrases": [
                        "bien rendre l'atmosphère"
                    ]
                },
                {
                    "sense_id": "186d12f5-b96a-3cef-b1f7-889fdb2a9598",
                    "sense_definition": "Rejeter par la bouche des matières contenues dans l'estomac.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rejet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient a commencé à <w>rendre</w> son repas à cause d'une intoxication alimentaire."
                        },
                        {
                            "text": "L'enfant était tellement malade qu'il a tout <w>rendu</w> au milieu de la nuit."
                        }
                    ],
                    "synonyms": [
                        "rejeter",
                        "vomir"
                    ],
                    "antonyms": [
                        "avaler",
                        "garder"
                    ],
                    "common_phrases": [
                        "rendre son repas"
                    ]
                }
            ]
        }
    ]
}