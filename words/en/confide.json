{
    "word_family": [
        "confidence",
        "confident",
        "confidential",
        "confidant",
        "confidante"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91535254-8fbd-3dd8-8cc9-3ae61c719d1b",
                    "sense_definition": "To share secrets or private matters with someone you trust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confide_secrets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She needed someone to <w>confide</w> in after a very difficult week at work."
                        },
                        {
                            "text": "It is important to have a close friend you can <w>confide</w> in during tough times."
                        }
                    ],
                    "synonyms": [
                        "trust"
                    ],
                    "common_phrases": [
                        "confide in a friend",
                        "confide in someone"
                    ]
                },
                {
                    "sense_id": "483ee1bb-9149-3ff1-81b1-d86d67b93446",
                    "sense_definition": "To tell something secret or personal to someone in confidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confide_secrets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>confided</w> her deepest fears to her sister during their long walk."
                        },
                        {
                            "text": "He <w>confided</w> that he was planning to leave the company next month."
                        }
                    ],
                    "synonyms": [
                        "reveal",
                        "disclose"
                    ],
                    "antonyms": [
                        "conceal",
                        "hide"
                    ],
                    "common_phrases": [
                        "confide a secret",
                        "confide one's fears"
                    ]
                },
                {
                    "sense_id": "22ecb075-e179-3642-bb33-2b91217187a4",
                    "sense_definition": "To place trust or have faith in someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trust_faith",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must <w>confide</w> in his ability to lead us through this crisis."
                        },
                        {
                            "text": "In times of uncertainty, they <w>confide</w> in the wisdom of their elders."
                        }
                    ],
                    "synonyms": [
                        "trust",
                        "rely"
                    ],
                    "antonyms": [
                        "distrust",
                        "mistrust"
                    ],
                    "common_phrases": [
                        "confide in someone's judgment"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense of trusting or having faith in is less common in modern English than sharing secrets."
                        }
                    ]
                },
                {
                    "sense_id": "310b8941-4917-33d0-9965-f3e192006651",
                    "sense_definition": "To entrust a task, duty, or object to the care of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to <w>confide</w> the important project to his most reliable employee."
                        },
                        {
                            "text": "Before leaving the country, she <w>confided</w> her estate to a trusted lawyer."
                        }
                    ],
                    "synonyms": [
                        "entrust",
                        "commit",
                        "consign"
                    ],
                    "common_phrases": [
                        "confide a task to"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Entrust is much more commonly used in modern English for this meaning."
                        }
                    ]
                }
            ]
        }
    ]
}