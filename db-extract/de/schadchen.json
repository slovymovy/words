                        "source_entry_id": "cbfc0f3c-d658-3024-83b2-79458439ffea",
                        "source_sense_id": "08a7f8d2-74b9-3847-9e6d-e13d843213d6",
                        "source_sense_description": "eine (jüdische) Person, die (gewerbsmäßig) Ehen vermittelt beziehungsweise Kuppelei betreibt",
                        "target_lang_word": "marieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a631092-c2d4-363c-b999-289d32980c96",
                                        "entry_id": "4b97e2a9-7def-3ca6-9588-8a0e378de523",
                                        "glosses": [
                                            "Femme arrangeant un mariage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba56f2f-9ce7-444a-a9f5-3c2d59d5c96c",
                                                "sense_id": "4a631092-c2d4-363c-b999-289d32980c96",
                                                "text": "On racontait des histoires de soldats affamés, errant au milieu de landes désolées, et recueillis par des marieuses à l’affût."
                                            },
                                            {
                                                "example_id": "07319e90-9506-446a-b4b1-5de83abd2734",
                                                "sense_id": "4a631092-c2d4-363c-b999-289d32980c96",
                                                "text": "Mais les malhabiles le sont en tout : à s’offrir comme à se refuser. Les marieuses le savent bien qui commencent à allumer les partenaires en affirmant à chacun que l’autre l’a distingué."
                                            },
                                            {
                                                "example_id": "dbac2d40-d21e-4764-bf9b-f0325e3bab1c",
                                                "sense_id": "4a631092-c2d4-363c-b999-289d32980c96",
                                                "text": "La baronne, marieuse bénévole comme le sont d’instinct tant de femmes de son âge et de son monde, les laisse beaucoup seuls."
                                            },
                                            {
                                                "example_id": "da27be8a-b500-413e-ab1b-1e9b9922677c",
                                                "sense_id": "4a631092-c2d4-363c-b999-289d32980c96",
                                                "text": "Elle a bien réussi à maîtriser FaceTime. Je sens qu’elle va nous demander comment organiser un cocktail de la Saint-Valentin sur Zoom.\n Qu’à cela ne tienne, la marieuse en chef ne se laissera pas intimider par la technologie."
                                            },
                                            {
                                                "example_id": "0b00665e-10fa-43a2-9699-944bebfc0c3d",
                                                "sense_id": "4a631092-c2d4-363c-b999-289d32980c96",
                                                "text": "La belle-mère s’avançait, donnait une pièce d’argent aux marieuses, soulevait le voile qui couvrait le visage de sa bru qui tenait ses yeux fermés, l’embrassait légèrement sur la joue et laissait retomber le voile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b729222b-6b38-3b46-bbd9-925f080b6acc",
                                        "entry_id": "4b97e2a9-7def-3ca6-9588-8a0e378de523",
                                        "glosses": [
                                            "Femme pratiquant la fécondation artificielle de la fleur de vanille dans les régions où l'insecte pollinisateur est absent. → voir mélipone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "735cf6f8-f213-4a23-9488-27ec525eb6be",
                                                "sense_id": "b729222b-6b38-3b46-bbd9-925f080b6acc",
                                                "text": "Un bon marieur ou une marieuse bien entrainée peuvent polliniser 1500 à 3000 fleurs par journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
