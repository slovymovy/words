                                        "entry_id": "720771d8-1a58-3165-a97b-93044549ef3b",
                                        "glosses": [
                                            "учитывая возможную опасность, не делая опрометчивых движений"
                                        ],
                                        "tags": [
                                            "нареч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eccb2225-f7ca-4cae-adc5-522357a0882c",
                                                "sense_id": "6f11152f-8f1c-30cf-a214-ec0d33e10019",
                                                "text": "Кошка осторожно пробиралась по ветке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b885fd95-6bbb-3379-b2d8-cef0b0d6d6c2",
                                        "entry_id": "720771d8-1a58-3165-a97b-93044549ef3b",
                                        "glosses": [
                                            "перен. слабо, нерешительно, тихо"
                                        ],
                                        "tags": [
                                            "нареч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b78f7e-505f-4a69-9a11-4f3f5c695095",
                                                "sense_id": "b885fd95-6bbb-3379-b2d8-cef0b0d6d6c2",
                                                "text": "Осторожно зазвучала скрипка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e45b35-9681-369e-b734-6ce2cd20ae18",
                                        "entry_id": "720771d8-1a58-3165-a97b-93044549ef3b",
                                        "glosses": [
                                            "перен. внимательно, бережно, деликатно по отношению к кому-либо, чему-либо"
                                        ],
                                        "tags": [
                                            "нареч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08195bc6-036a-4ad5-9426-fd5f27f21cb2",
                                                "sense_id": "c3e45b35-9681-369e-b734-6ce2cd20ae18",
                                                "text": "Он осторожно спросил о детях."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4616160-9595-35b3-9ad2-9c9fe5beec1d",
                                        "entry_id": "720771d8-1a58-3165-a97b-93044549ef3b",
                                        "glosses": [
                                            "призыв к соблюдению осторожности"
                                        ],
                                        "tags": [
                                            "межд."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee72b330-6463-48ae-bec5-d93e5c6a30e7",
                                                "sense_id": "b4616160-9595-35b3-9ad2-9c9fe5beec1d",
                                                "text": "Осторожно, скользкий асфальт!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea3fea9-0f55-3ab7-94ad-8cc0c8f4b2d9",
                                        "entry_id": "720771d8-1a58-3165-a97b-93044549ef3b",
                                        "glosses": [
                                            "предик. оценочная характеристика чего-либо как отличающегося осторожностью"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
