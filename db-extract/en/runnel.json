                ],
                "translations": [
                    {
                        "translation_id": "116098c0-b0c7-44ea-9955-17510aba0e24",
                        "source_entry_id": "023cf15f-0198-3ec9-b26b-429975b48369",
                        "source_sense_id": "9c5a2a29-d165-3f51-ad0d-32a0dad968b0",
                        "source_sense_description": "(veraltet) Bach, Rinnsal, Rinne, Rinnstein",
                        "target_lang_word": "Bach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                        "entry_id": "681a7179-8b4d-326c-b9b5-a5de57418e6e",
                                        "glosses": [
                                            "kleiner, natürlicher Wasserlauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd6e2ac6-6e4d-4d35-aa7f-8046c3189bd0",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„Auf jeden Fall war dieser Bach die spirituelle Quelle unseres Bezirks.“"
                                            },
                                            {
                                                "example_id": "475fc62a-570b-411d-9f49-ab5f861eb7fa",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "Es führte ein kleiner Steg über den Bach."
                                            },
                                            {
                                                "example_id": "0f01df32-1e95-4548-8997-27351eb3afcc",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„Lustig quasselt der seichte Bach. / Scheinchen scheppern darüber flach.“"
                                            },
                                            {
                                                "example_id": "ed315401-9ab6-4e90-9c29-7303e2bb3467",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„An den schulfreien Nachmittagen pflegten wir in den Bächen und Teichen vor der Stadt Molche und Fische zu fangen und auf den Wiesen Schmetterlinge und Käfer.“"
                                            },
                                            {
                                                "example_id": "30196c18-fb3f-4510-9493-b70b346783b6",
                                                "sense_id": "0ff83911-2fe2-3a69-a706-9df06d8a9583",
                                                "text": "„Plötzlich, vor einer Bodensenke, in die sich ein Bach ergoß, warf sich das Tier seitwärts, sprang in den Grund, und sie wurde kopfüber aus dem Sattel geschmissen, und, ehe sie sich's versah, lag sie auf dem Boden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17f610da-0048-3a94-9094-e251f9ca5d7a",
                                        "entry_id": "681a7179-8b4d-326c-b9b5-a5de57418e6e",
                                        "glosses": [
                                            "der Asteroid mit der Nummer 1814"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e6e958-ee5b-4f36-ac08-892fa5c8588e",
                                                "sense_id": "17f610da-0048-3a94-9094-e251f9ca5d7a",
                                                "text": "Bach wurde im Januar 1932 von K. Reinmuth in Heidelberg entdeckt. Benannt ist er nach Johann Sebastian Bach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8de61d00-ad5c-3e0d-b481-58ca2e723cd3",
                                        "entry_id": "681a7179-8b4d-326c-b9b5-a5de57418e6e",
                                        "glosses": [
                                            "Fachausdruck für mehrere untereinander stehende Wortzwischenräume, die sich dem Auge des Betrachters zu einem „Bach“ [1] verbinden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab255c1d-bd9a-4391-a28c-5dc50be47552",
                                                "sense_id": "8de61d00-ad5c-3e0d-b481-58ca2e723cd3",
                                                "text": "Bäche „lassen sich oft mit wenig Aufwand durch leichte Variation in Schriftgröße, Breite des Satzspiegels oder Silbentrennung eines langen Wortes am Ende einer der vorangehenden Zeilen beheben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                        "entry_id": "ac7a665b-87b4-3b7a-8538-47ca6a77fed4",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname, auch in der Form von Bach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab60170a-97b7-4785-927f-d993140f6666",
                                                "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                                "text": "Günter Bach unternimmt seit 1995 keine Wattwanderungen mehr."
                                            },
                                            {
                                                "example_id": "61afefd1-96d6-4397-9ad9-2d60f0627fce",
                                                "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                                "text": "Bachs haben wieder Äpfel aus dem Alten Land mitgebracht."
                                            },
                                            {
                                                "example_id": "c4e3347e-4c14-4947-bbce-de012ba99806",
                                                "sense_id": "12feff37-3364-39b1-94a2-6e372c066113",
                                                "text": "Die Bach konnte noch auf einen Mülleimer hüpfen, aber der Bach wurde vom Hund gebissen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "580b57ce-911d-3f48-a09e-ae5d6e76e006",
                                        "entry_id": "fed597b3-9dda-3b30-8cf1-d8acfe924431",
                                        "glosses": [
                                            "Name mehrerer Orte in Österreich und Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "798985a7-b24f-4780-87f5-440906102c1c",
                                                "sense_id": "580b57ce-911d-3f48-a09e-ae5d6e76e006",
                                                "text": "Ich komme gerade aus Bach."
                                            },
                                            {
                                                "example_id": "a4e45447-6738-4253-97b9-499e2b116afb",
                                                "sense_id": "580b57ce-911d-3f48-a09e-ae5d6e76e006",
                                                "text": "das Bach der fünfziger Jahre"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68e6b302-a812-4b82-99f4-c4ddc367244f",
                        "source_entry_id": "023cf15f-0198-3ec9-b26b-429975b48369",
                        "source_sense_id": "9c5a2a29-d165-3f51-ad0d-32a0dad968b0",
                        "source_sense_description": "(veraltet) Bach, Rinnsal, Rinne, Rinnstein",
                        "target_lang_word": "Rinnsal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rinnsal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                        "entry_id": "9fcb3876-0ab3-379d-87ca-6f1f02008418",
                                        "glosses": [
                                            "sehr kleines, sacht fließendes Gewässer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c8b2a3-e483-47c4-a53e-5ca239f2ed84",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "„Die Saison ist rum und der Neckar ein Rinnsal.“"
                                            },
                                            {
                                                "example_id": "7809600a-a6d9-4cb0-a424-95902a779dd4",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "„Dieses Jahr ist der Fluß, der hier Firat heißt, schon jetzt im Juni vom mächtigen Strom zum spärlichen Rinnsal geschrumpft.“"
                                            },
                                            {
                                                "example_id": "58ee0ba7-e295-4b83-800f-5b31a682c093",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "[Klimakrise – Trockenheit in Südeuropa 2022:] „Der Po, eigentlich ein mächtiger Strom, hat sich in ein trauriges, schmales Rinnsal verwandelt.“"
                                            },
                                            {
                                                "example_id": "2fc3cf0e-3c5a-4d94-865d-d226059f3892",
                                                "sense_id": "d0e5c2a7-549f-32ac-9267-f5a8bfb48df5",
                                                "text": "„Der Tungufluß fließt ruhig und breit in seinen tiefen Rinnsalen und ergießt sich östlich vom Bischofssitz Skálholt in den Hvitfluß, den Jökullstrom.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                        "entry_id": "9fcb3876-0ab3-379d-87ca-6f1f02008418",
                                        "glosses": [
                                            "Flüssigkeit, die in einer kleineren Menge irgendwohin rinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38abde2-b705-41d8-a7cd-3e7c0fd43036",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Sie starrte hinab auf das bleiche Antlitz, über das sich jetzt ein dünnes rotes Rinnsal hinzog.“"
                                            },
                                            {
                                                "example_id": "4bbe5d13-b88e-40f2-b877-9fe9c4073d22",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Schwarze Rinnsale liefen die schwarzen Scheiben hinab.“"
                                            },
                                            {
                                                "example_id": "94a86628-b5cc-4adf-87e3-f69c77320fea",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Ganz profan gossen Männer schwungvoll Wasser über den Boden und schrubbten, während die Fahrgäste über die sich ausbreitenden Rinnsale hinwegstiegen.“"
                                            },
                                            {
                                                "example_id": "68c0a064-9ba9-421f-acb2-124930d7376a",
                                                "sense_id": "763d1474-30c5-3ac3-aae4-e3c993318d8e",
                                                "text": "„Pavel schloss die Augen und versuchte sich an das letzte Mal zu erinnern, dass er Fleisch gegessen hatte. Als er die Augen wieder öffnete, sabberte er, wie ein Rinnsal rann ihm die Spucke übers Kinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0240a65b-1281-4b49-8f3e-50f58903f0fc",
                        "source_entry_id": "023cf15f-0198-3ec9-b26b-429975b48369",
                        "source_sense_id": "9c5a2a29-d165-3f51-ad0d-32a0dad968b0",
                        "source_sense_description": "(veraltet) Bach, Rinnsal, Rinne, Rinnstein",
                        "target_lang_word": "Rinne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "schmale, längliche Vertiefung, durch die Wasser fließen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f3b0f6-a626-45b8-a32a-1b75f4af6d60",
                                                "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                                "text": "„Für Wanderer gibt es zwischen den Wänden, Graten und Rinnen kaum Platz, doch die wenigen Möglichkeiten sind atemberaubend.“"
                                            },
                                            {
                                                "example_id": "41fe96ad-7f5b-4873-a018-3709465dad51",
                                                "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                                "text": "„Als wir dicht herankamen, sah ich, dass eine tiefe Rinne hinaufführte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "Kurzform für die Fahrrinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26d96a4-b850-4b2f-8b63-22c356bd521d",
                                                "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                                "text": "Sitzt man am Rhein, so kann man die Frachtschiffe in der Rinne fahren sehen."
                                            },
                                            {
                                                "example_id": "1c865252-3630-4558-a52f-59c8bb44baca",
                                                "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                                "text": "Die Fahrrinne im Fluss wird extra durch Bojen gekennzeichnet, da diese Rinne im Flussbett auch bei Niedrigwasser immer \"Eine handbreit Platz unter dem Kiel\" bedeutet!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "schmaler, langer, in Form einer Halbschale ausgehöhlter Körper aus Blech, Holz usw. in der etwas abfließen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edd48ac-e091-4190-8bf9-03ff8544ad1b",
                                                "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                                "text": "Die Rinne des Daches wird im Herbst oftmals durch Laub verstopft."
                                            },
                                            {
                                                "example_id": "8ed662ff-3d68-49ac-bf31-2b7e213b11a6",
                                                "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                                "text": "„Papa stellte zwei Leitern dran, und dann sollten Volker und ich mit Rundspachteln den Kniest aus der Rinne schaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2839fa11-26d9-3f10-8380-a5b30daeb1bf",
                                        "entry_id": "625098f3-7aab-330a-9506-437dca503037",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b7128c-04a7-45f2-9b78-7a2ed54c7130",
                                                "sense_id": "2839fa11-26d9-3f10-8380-a5b30daeb1bf",
                                                "text": "„Friedrich Heinrich (Fritz) Rinne (* 1852 in Eilsen; † 2. März 1924 in Berlin) war ein deutscher Chirurg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "191d8581-2780-3699-87ba-6c091b6e730c",
