                    {
                        "translation_id": "533a9a6c-62c0-4393-889a-8b363860b3b1",
                        "source_entry_id": "24400fd2-c1a8-3ae5-94db-d4b361d9d67a",
                        "source_sense_id": "e7fbf832-106e-3b8c-9c25-2f90b9b3f9ed",
                        "target_lang_word": "prendre un ris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prendre un ris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "543e66d7-f5ab-337c-bf44-f5edb3bfd29c",
                                        "entry_id": "cf4cf40c-6743-3b81-b582-2911d46c713e",
                                        "glosses": [
                                            "Diminuer la surface d’une voile exposée au vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e17157c-1d1a-4ecb-8074-a3c9d95a3a30",
                                                "sense_id": "543e66d7-f5ab-337c-bf44-f5edb3bfd29c",
                                                "text": "Généralement on ne prend un ris que lorsque la brise augmente et que l’on pense qu’elle se maintiendra au degré de force qui oblige à cette mesure."
                                            },
                                            {
                                                "example_id": "45a77f29-7775-4d70-bd34-c55d13da04f9",
                                                "sense_id": "543e66d7-f5ab-337c-bf44-f5edb3bfd29c",
                                                "text": "En général, on prend un ris à une allure proche du vent. On choque l’écoute et le hale-bas pour laisser s’échapper le vent et plus tard étarquer sans résistance."
                                            },
                                            {
                                                "example_id": "147ece63-6c4a-4f39-a108-18a2317d0eda",
                                                "sense_id": "543e66d7-f5ab-337c-bf44-f5edb3bfd29c",
                                                "text": "Sur un voilier quand le vent monte, il faut savoir réduire la voile. Autrement dit être capable de prendre un ris. On dit aussi « ariser »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
