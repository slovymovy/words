                    {
                        "translation_id": "bc76942b-5c4e-44ae-9307-103927bafdd0",
                        "source_entry_id": "476f2b8d-58d7-33e0-a052-0797f966aabf",
                        "source_sense_id": "0e033e30-5290-33f6-aa5c-bb8ff2de0b09",
