                        "source_sense_id": "74e12861-9696-3500-9927-b562461368a3",
                        "target_lang_word": "abbröckeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abbröckeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a92cd037-27f3-3cde-85e7-4cbec8421505",
                                        "entry_id": "0d0b7ae6-1d60-3570-b0f0-6244c0be626c",
                                        "glosses": [
                                            "etwas löst sich brockenartig, brockenförmig ab, bricht stückchenweise auseinander"
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b3a9a3-0b9d-4333-8ac4-794bab81ab0a",
                                                "sense_id": "a92cd037-27f3-3cde-85e7-4cbec8421505",
                                                "text": "Von der Wand bröckelt der alte Putz ab."
                                            },
                                            {
                                                "example_id": "96e74663-bf05-4afa-a15f-8d262ef5eb09",
                                                "sense_id": "a92cd037-27f3-3cde-85e7-4cbec8421505",
                                                "text": "„Ob Ruinen abbröckeln, ist gleichgültig!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c616ef4-c376-30e4-9305-6cc3c5f95020",
                                        "entry_id": "0d0b7ae6-1d60-3570-b0f0-6244c0be626c",
                                        "glosses": [
                                            "allmählich heruntergehen: die Preise sinken, gehen in den Keller; die Börsenkurse verfallen"
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "323f6ee8-9dd6-497c-a5cc-072995fb9dd6",
                                                "sense_id": "7c616ef4-c376-30e4-9305-6cc3c5f95020",
                                                "text": "Am Morgen hatte das Börsenbarometer kurzfristig zwar die Marke von 7100 Punkten zurückerobert, die Gewinne waren dann aber Stück für Stück wieder abgebröckelt."
                                            },
                                            {
                                                "example_id": "152d6c7a-46b1-4722-8694-4b79ca30fb5d",
                                                "sense_id": "7c616ef4-c376-30e4-9305-6cc3c5f95020",
                                                "text": "Noch schneller als die Nachfrage nach dem Seeweg sind jedoch Konkurrenz und Angebot gestiegen, so daß die Passagepreise in den vergangenen zwei Jahren um rund zehn Prozent abbröckelten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "403f84f2-84f3-4c4c-8b80-19c456c680bb",
                        "source_entry_id": "2cddac23-9563-3e65-9f10-3c1619837610",
                        "source_sense_id": "74e12861-9696-3500-9927-b562461368a3",
                        "target_lang_word": "bröckeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bröckeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15582648-585f-3d9f-8b3f-cf86142dcd87",
                                        "entry_id": "a79ff876-17f6-3812-a45e-12066dc55988",
                                        "glosses": [
                                            "zu kleinen Brocken, in kleine Stücke zerfallen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b946bc03-0514-4dd0-9089-6f4e6a7f9ca5",
                                                "sense_id": "15582648-585f-3d9f-8b3f-cf86142dcd87",
                                                "text": "Von ähnlicher Seelenverderbnis befallen, bröckeln die Kartoffeln während des Schälens in Stücken von den Gabeln und platzen, wie von inneren Erdbeben aufgerührt, auseinander."
                                            },
                                            {
                                                "example_id": "aa024fc1-41ec-44fc-8d97-78b106b06c2a",
                                                "sense_id": "15582648-585f-3d9f-8b3f-cf86142dcd87",
                                                "text": "»Der Schacht besteht jedenfalls auch aus Schlammziegeln, welche leicht bröckeln. Da könnte man den Halt verlieren und in die Tiefe stürzen.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a45e8661-e984-3857-a9df-facc912a8b14",
                                        "entry_id": "a79ff876-17f6-3812-a45e-12066dc55988",
                                        "glosses": [
                                            "schwinden (von Aktienkursen, Gefühlen, der Liebe etc.)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a73a5c3d-3d5e-46c1-b96f-b668f72b6c85",
                                                "sense_id": "a45e8661-e984-3857-a9df-facc912a8b14",
                                                "text": "Auch das Ansehen demokratischer Institutionen bröckelt besorgniserregend."
                                            },
                                            {
                                                "example_id": "bbc5410d-c72e-4a46-88e7-5d3f3339b835",
                                                "sense_id": "a45e8661-e984-3857-a9df-facc912a8b14",
                                                "text": "Folgt man der These von Grabka und Frick, hat die soziale Krise des Landes nun auch die Mitte der Gesellschaft erreicht. Es bröckelt nicht nur ihr unterer Rand."
                                            },
                                            {
                                                "example_id": "b0d76200-0b73-4f1e-ae0a-cae40550d7b6",
                                                "sense_id": "a45e8661-e984-3857-a9df-facc912a8b14",
                                                "text": "Dazu bröckelt die Solidarität der Prominenten, die sich bisher gern als Wohltäter bei Unicef einreihten."
                                            },
                                            {
                                                "example_id": "90f04cf4-2cf9-42bd-8e0a-76b9d4a7adce",
                                                "sense_id": "a45e8661-e984-3857-a9df-facc912a8b14",
                                                "text": "„Das Tabu Deutschlands, die Rechten nach den Erfahrungen mit dem Nationalsozialismus konsequent auszuschließen, bröckelt […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bröckeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9653f82a-122b-301f-bfc2-e722089f248f",
                                        "entry_id": "7498e6f4-cf2b-35af-a00c-90908305c99b",
                                        "glosses": [
