                    {
                        "sense_id": "971f05cd-bf36-31fd-9963-542d1a26c27d",
                        "entry_id": "5ac53b3c-2b03-3167-8541-783232100ee5",
                        "glosses": [
                            "Ancienne entreprise française de distribution de prêt-à-porter, focalisée sur le segment de la femme de 20 à 60 ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e4896e-28ec-4a92-856b-9774a5bba685",
                                "sense_id": "971f05cd-bf36-31fd-9963-542d1a26c27d",
                                "text": "Et Camaïeu l’a appris à ses dépends."
                            }
                        ]
