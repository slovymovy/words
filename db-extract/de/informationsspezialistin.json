                    {
                        "sense_id": "c8a088ef-e9da-3c59-9646-1aecf8de7c0b",
                        "entry_id": "4db36f57-4083-3a59-8a6a-5a8b89482d17",
                        "glosses": [
                            "weibliche Person, die sich beruflich mit der Auffindung, Darstellung und Weitergabe von Informationen beschäftigt"
                        ],
                        "tags": [
                            "Medienbranche"
                        ],
                        "examples": [
                            {
                                "example_id": "c2199202-c5cc-44c7-bec2-10caa9317092",
                                "sense_id": "c8a088ef-e9da-3c59-9646-1aecf8de7c0b",
                                "text": "„Hauptberuflich arbeitet sie als Informationsspezialistin ihres Beratungsunternehmens in Frankfurt am Main.“"
                            },
                            {
                                "example_id": "aeb14a63-fb99-48dc-a775-e14fb428b335",
                                "sense_id": "c8a088ef-e9da-3c59-9646-1aecf8de7c0b",
                                "text": "„Darf ich Deine Informationsspezialistin sein?“"
                            },
                            {
                                "example_id": "30e6f91d-371c-4c3e-8446-67ac9d5069da",
                                "sense_id": "c8a088ef-e9da-3c59-9646-1aecf8de7c0b",
                                "text": "„Die Informationsspezialistin Chandra Wei und Hassan Smith, der zweite Mann bei Bodenoperationen, schwebten mit grimmigen Mienen neben ihm.“"
                            },
                            {
                                "example_id": "53112046-e687-4a7d-9fa8-2141cffde5b2",
                                "sense_id": "c8a088ef-e9da-3c59-9646-1aecf8de7c0b",
                                "text": "„All das mag man bedauern; man kann es aber auch als Chance fur junge Mediendokumentare und Informationsspezialistinnen sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
