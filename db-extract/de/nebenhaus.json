                ],
                "senses": [
                    {
                        "sense_id": "8ec0ec02-b76e-3344-8ed5-65cebaed50ed",
                        "entry_id": "8ebda502-0b03-3b72-8bee-d44bec74cc28",
                        "glosses": [
                            "benachbartes Haus, Haus nebenan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8dfcb4-8f8b-4293-98b5-b8788ea438ac",
                                "sense_id": "8ec0ec02-b76e-3344-8ed5-65cebaed50ed",
                                "text": "„Ich ging ins Nebenhaus.“"
                            },
                            {
                                "example_id": "3341b00d-5b41-4153-96a9-8aef3b4fe207",
                                "sense_id": "8ec0ec02-b76e-3344-8ed5-65cebaed50ed",
                                "text": "„Die Behauptung, das Haus habe ursprünglich das Hotel Meißl und Schadn beherbergt, ist irrig; das Hotel befand sich stets im Nebenhaus (1, Neuer Markt 2).“"
                            },
                            {
                                "example_id": "a2b7464d-53e7-46d5-a9de-6ffcd2db145e",
                                "sense_id": "8ec0ec02-b76e-3344-8ed5-65cebaed50ed",
                                "text": "„Hinter dem Portale zum zweiten Hofe befanden sich beiderseits dreiräumige Nebenhäuser, die ein kleines einräumiges Gastzimmer enthielten.“"
                            },
                            {
                                "example_id": "7d3acf16-3978-4d4d-b175-e51949220218",
                                "sense_id": "8ec0ec02-b76e-3344-8ed5-65cebaed50ed",
                                "text": "„Und kaum hatte der Offizier die Klinke wieder losgelassen, als Mawra Kusminitschna kehrt machte und mit ihren schnellen Greisinnenschritten über den Hof zu dem weiter hinten liegenden Nebenhause ging, in dem sie ihr Zimmer hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
