                                "target_senses": [
                                    {
                                        "sense_id": "b7eb227a-01c9-30e2-bac6-2159682cbfd6",
                                        "entry_id": "a557ec21-03b2-34bf-860b-a855d213f486",
                                        "glosses": [
                                            "Plus grande île de Méditerranée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "773d1423-edc7-4ae6-ae14-242f4407caee",
                                                "sense_id": "b7eb227a-01c9-30e2-bac6-2159682cbfd6",
                                                "text": "Cette Messinaise était une petite femme appelée Rosina, fort brune, mais portant dans ses yeux noirs et fendus en amande toutes les ardeurs du soleil de la Sicile."
                                            },
                                            {
                                                "example_id": "d389cedd-3c7e-44cb-8d8f-22e56885413a",
                                                "sense_id": "b7eb227a-01c9-30e2-bac6-2159682cbfd6",
                                                "text": "Il se rappelle que lorsqu’il avait douze ans, et qu’il était berger dans la montagne, il a pris part à la razzia d’un village voisin ; haine et représailles de village à village, vendetta : la vieille Abkhasie peut, sous cet angle, se comparer à la Corse ou à la Sicile."
                                            },
                                            {
                                                "example_id": "008c5793-1a99-4e4e-8aec-e650f0586030",
                                                "sense_id": "b7eb227a-01c9-30e2-bac6-2159682cbfd6",
                                                "text": "Privilégiez les fruits disposant d’une IGP : clémentines et pomelos de Corse, citrons de Menton ou de Syracuse, orange de Sicile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa75474-ed0b-385e-b9fc-764c1a8bc23b",
                                        "entry_id": "a557ec21-03b2-34bf-860b-a855d213f486",
                                        "glosses": [
                                            "Région d’Italie correspondant à cette île."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cc28191-2cbe-4bd3-a496-8ff5fc5f3b2b",
                        "source_entry_id": "483dbbac-e8ff-30f7-b953-f8442ebc96e1",
                        "source_sense_description": "island in the Mediterranean Sea",
                        "target_lang_word": "Sizilien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sizilien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                        "entry_id": "441a1f7d-8ae6-337d-bacf-f61ceb85bf23",
                                        "glosses": [
                                            "Insel im Mittelmeer und autonome Region Italiens"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49463593-3a67-4346-a8b2-f37bfdc0c708",
                                                "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                                "text": "Sizilien liegt wie ein Fußball vor dem italienischen Stiefel."
                                            },
                                            {
                                                "example_id": "115438bb-4d9c-4081-ba14-7162fbe7f284",
                                                "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                                "text": "„Die beharrliche Strategie des Quintus Fabius Maximus, die Siege des Marcus Claudius Marcellus in Sizilien, die Erfolge des Publius Cornelius Scipio in Hispanien und das militärische Geschick des Marcus Livius Salinator und Gaius Claudius Nero in Italien brachten den immer noch unbesiegten Hannibal in Bedrängnis und zwangen ihn, aus Italien abzuziehen.“"
                                            },
                                            {
                                                "example_id": "49dcec38-0824-44c4-b2a5-01caf6e9a3fb",
                                                "sense_id": "25de4e7c-a85b-3821-ad9e-99000b653d27",
                                                "text": "„Und schließlich versucht er, Sizilien aus den Händen der muslimischen Sarazenen zurückzugewinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb5c507d-3d08-3d32-a3b4-af2f417dda21",
                                        "entry_id": "441a1f7d-8ae6-337d-bacf-f61ceb85bf23",
                                        "glosses": [
                                            "Königreich, das durch Zusammenfassung der Königreiche auf Sizilien und auf dem süditalienischen Festland bei Neapel entstand"
                                        ],
                                        "tags": [
                                            "historical",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81bfc086-e961-4311-8247-c87f90269017",
                                                "sense_id": "fb5c507d-3d08-3d32-a3b4-af2f417dda21",
                                                "text": "„Ihr überraschender Aufstieg zur Kaiserin und Königin der beiden Sizilien kam durch rein dynastische und machtpolitische Strategien der männlichen Verwandten zustande.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
