    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94df57a0-272f-33ff-a060-0aa6d8b1b889",
                    "sense_definition": "Organiser dans le temps le déroulement d'une activité ou d'un événement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organisation_temporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>planifier</w> une réunion avec l'équipe pour fixer les nouveaux objectifs."
                        },
                        {
                            "text": "Elle <w>planifie</w> ses vacances d'été plusieurs mois à l'avance pour éviter les imprévus."
                        }
                    ],
                    "synonyms": [
                        "programmer",
                        "agencer"
                    ],
                    "antonyms": [
                        "improviser"
                    ],
                    "common_phrases": [
                        "planifier une réunion",
                        "planifier un voyage",
                        "planifier son emploi du temps"
                    ]
                },
                {
                    "sense_id": "fb9069b6-1c05-31b0-a0d2-db3671163c5a",
                    "sense_definition": "Prévoir ou avoir le projet de réaliser une action future.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intention_prevision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise <w>planifie</w> d'ouvrir une nouvelle succursale au centre-ville dès le mois prochain."
                        },
                        {
                            "text": "Ils <w>planifient</w> de rénover leur appartement dès qu'ils auront obtenu l'accord de la banque."
                        }
                    ],
                    "synonyms": [
                        "prévoir",
                        "envisager",
                        "projeter"
                    ],
                    "common_phrases": [
                        "planifier de faire",
                        "planifier de partir"
                    ]
                },
                {
                    "sense_id": "269f7492-79ab-3c87-8a66-01bcd99e244c",
                    "sense_definition": "Organiser de manière méthodique et globale un ensemble complexe ou une politique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation_methodique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement souhaite <w>planifier</w> la transition énergétique sur une période de vingt ans."
                        },
                        {
                            "text": "Les stratèges ont conçu une opération soigneusement <w>planifiée</w> pour minimiser les pertes."
                        }
                    ],
                    "synonyms": [
                        "structurer",
                        "ordonner"
                    ],
                    "antonyms": [
                        "déréguler"
                    ],
                    "common_phrases": [
                        "planifier l'économie",
                        "stratégie planifiée"
                    ]
                }
            ]
        }
    ]
