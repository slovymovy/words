                "senses": [
                    {
                        "sense_id": "6ec5ee75-c420-3b95-a4e5-d451de69d61a",
                        "entry_id": "d97b609d-e518-3a01-84da-d926ebc97216",
                        "glosses": [
                            "Sans aucune qualité, dépourvu de talent, incompétent, ignorant."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5f448911-44ed-47d1-8a69-2a126e17820b",
                                "sense_id": "6ec5ee75-c420-3b95-a4e5-d451de69d61a",
                                "text": "Finalement l'histoire de ma vie est d'une si triste banalité qu'elle ne mériterait même pas le privilège d'inspirer un scénario nullard pour navet égyptien."
                            },
                            {
                                "example_id": "a46c1ed9-8d18-4580-b164-8d984c306258",
                                "sense_id": "6ec5ee75-c420-3b95-a4e5-d451de69d61a",
                                "text": "Elle a choisi un film nullard. J'ai frissonné pendant deux heures zéro cinq, au rythme d'une histoire insoutenable de meurtres et d'hémoglobine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bd2ff92-7af0-461e-8acd-14415ed39a95",
                        "source_entry_id": "d97b609d-e518-3a01-84da-d926ebc97216",
                        "source_sense_id": "6ec5ee75-c420-3b95-a4e5-d451de69d61a",
                        "source_sense_description": "Sans aucune qualité",
                        "target_lang_word": "unfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bb6297b-1626-375b-bfb8-ae487d2fbe01",
                                        "entry_id": "44306eaa-88c0-3ecf-bd24-0820727e88dd",
                                        "glosses": [
                                            "nicht die nötigen Kenntnisse oder Fertigkeiten für die Erfüllung einer Aufgabe habend; einer Tätigkeit nicht gewachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f65367b7-c343-46a7-b06b-d8f89af70701",
                                                "sense_id": "1bb6297b-1626-375b-bfb8-ae487d2fbe01",
                                                "text": "Die neue Mitarbeiterin ist völlig unfähig."
                                            },
                                            {
                                                "example_id": "d1897241-6d39-425d-91a7-afe4b6045958",
                                                "sense_id": "1bb6297b-1626-375b-bfb8-ae487d2fbe01",
                                                "text": "Er ist aufgrund seiner Ausbildung unfähig solch eine komplizierte Tätigkeit auszuüben."
                                            },
                                            {
                                                "example_id": "4a8efb36-3e27-41f4-a2f6-55c2120c13d5",
                                                "sense_id": "1bb6297b-1626-375b-bfb8-ae487d2fbe01",
                                                "text": "„»Sie waren unfähig, den Ausbau der erneuerbaren Energien herbeizuführen. Sie haben Abwehrkämpfe geführt gegen jede einzelne Windkraftanlage«, sagt Scholz und zeigt dabei auf die Sitzreihen von CDU und CSU.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "322e31b1-420e-39ad-ba44-3dacd00f208e",
                                        "entry_id": "44306eaa-88c0-3ecf-bd24-0820727e88dd",
                                        "glosses": [
                                            "(zeitlich begrenzt) außerstande, etwas bestimmtes zu tun; eine bestimmte Tat nicht mit sich vereinbaren könnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a1e299a-a205-4eed-a197-081e63832d19",
                                                "sense_id": "322e31b1-420e-39ad-ba44-3dacd00f208e",
                                                "text": "Sie war vor Aufregung unfähig, auch nur ein Wort zu sagen."
                                            },
                                            {
                                                "example_id": "bda5fa9d-ef5c-47c8-a82d-deb4ea39fa13",
                                                "sense_id": "322e31b1-420e-39ad-ba44-3dacd00f208e",
                                                "text": "Die Verdächtige ist unfähig eine derart schreckliche Tat zu begehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "151254ae-c50f-3d85-921f-286e836c29be",
