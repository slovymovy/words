    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b100d0e-0001-3f5e-b83c-5050dac14686",
                    "sense_definition": "met een rode kleur op het gezicht door verlegenheid, emotie of lichamelijke inspanning",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het intensieve rennen kwam hij met een <w>blozend</w> gezicht de huiskamer binnen.",
                            "target_lang_translations": {
                                "de": "Nach dem anstrengenden Laufen betrat er mit einem <w>geröteten</w> Gesicht das Wohnzimmer."
                            }
                        },
                        {
                            "text": "Toen ze een compliment kreeg, stonden er meteen twee <w>blozende</w> wangen op haar gezicht.",
                            "target_lang_translations": {
                                "de": "Als sie ein Kompliment bekam, hatte sie sogleich zwei <w>rot glühende</w> Wangen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rood"
                    ],
                    "antonyms": [
                        "bleek"
                    ],
                    "common_phrases": [
                        "met blozende wangen",
                        "blozend gezicht"
                    ],
                    "target_lang_definitions": {
                        "de": "mit gerötetem Gesicht vor Verlegenheit, Aufregung oder körperlicher Anstrengung"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "errötet",
                                "target_lang_sense_clarification": "durch Scham oder Anstrengung rot geworden"
                            },
                            {
                                "target_lang_word": "gerötet",
                                "target_lang_sense_clarification": "rote Wangen oder Gesicht aufweisend"
                            },
                            {
                                "target_lang_word": "rotwangig",
                                "target_lang_sense_clarification": "mit roten Wangen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc187627-0572-3104-9aeb-29df0ef90540",
                    "sense_definition": "er gezond en fris uitziend, gekenmerkt door een gezonde blos",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts zag meteen dat de <w>blozende</w> baby kerngezond en goed gevoed was.",
                            "target_lang_translations": {
                                "de": "Der Arzt sah sofort, dass das <w>blühende</w> Baby kerngesund und gut genährt war."
                            }
                        },
                        {
                            "text": "Na een lange wandeling in de frisse zeelucht zagen de kinderen er weer heerlijk <w>blozend</w> uit.",
                            "target_lang_translations": {
                                "de": "Nach einem langen Spaziergang in der frischen Seeluft sahen die Kinder wieder herrlich <w>rosig</w> aus."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloeiend"
                    ],
                    "antonyms": [
                        "bleek"
                    ],
                    "common_phrases": [
                        "een blozende baby"
                    ],
                    "target_lang_definitions": {
                        "de": "gesund und frisch aussehend, gekennzeichnet durch eine gesunde Gesichtsfarbe"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "blühend",
                                "target_lang_sense_clarification": "frisch und gesund aussehend"
                            },
                            {
                                "target_lang_word": "rosig",
                                "target_lang_sense_clarification": "mit rosiger, frischer Hautfarbe"
                            },
                            {
                                "target_lang_word": "rotbäckig",
                                "target_lang_sense_clarification": "frische, gesunde rote Wangen habend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e521a5f-17f2-390b-93f2-f8ec4558c399",
                    "sense_definition": "onvoltooid deelwoord van <w>blozen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij luisterde stil en <w>blozend</w> naar de mooie woorden die de leraar sprak.",
                            "target_lang_translations": {
                                "de": "Sie lauschte still und <w>errötend</w> den schönen Worten, die der Lehrer sprach."
                            }
                        },
                        {
                            "text": "Verlegen en <w>blozend</w> gaf het jonge meisje haar antwoord aan het publiek.",
                            "target_lang_translations": {
                                "de": "Verlegen und <w>errötend</w> gab das junge Mädchen dem Publikum seine Antwort."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleurend"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens des Verbs 'blozen' (erröten); während man errötet"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "errötend",
                                "target_lang_sense_clarification": "im Zustand des Errötens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
