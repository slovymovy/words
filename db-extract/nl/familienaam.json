        "nl-extract.jsonl": [
            {
                "entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                "word": "familienaam",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9bf60062-8c99-4530-a2e4-f0a13ce148fe",
                        "entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                        "tags": [
                            "plural"
                        ],
                        "form": "familienamen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                        "entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                        "glosses": [
                            "naam die van generatie op generatie en indien gewenst door het huwelijk overgedragen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a44970-12df-41b1-b4e9-deda12a26e1f",
                                "sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                                "text": "In Vlaanderen, in tegenstelling tot Spanje, worden familienamen overgedragen van vader op zoon."
                            },
                            {
                                "example_id": "1cb2d8be-0945-4287-8e27-24be70f0ad1e",
                                "sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                                "text": "In Nederland werden familienamen heel laat, en heel tegen de zin van de inwoners, ingevoerd door Napoleon Bonaparte."
                            },
                            {
                                "example_id": "8146d4b8-9d8b-45a2-9f2d-cc40f749bbd3",
                                "sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                                "text": "Gedurende duizenden jaren hadden mensen namelijk enkel een voornaam. Een bijnaam was dus noodzakelijk om deze of gene Frank of Robert aan te duiden. \"En die bijnamen zijn uiteindelijk geëvolueerd tot de familienamen die we nu hebben\", zegt Magda Devos."
                            },
                            {
                                "example_id": "7311ddef-f527-4255-a72c-cd4c9fcddf9c",
                                "sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                                "text": "In 1811 heeft Napoleon een dekreet uitgevaardigd waardoor de familiebijnaam officiële familienaam werd, althans wanneer geen andere naam werd opgegeven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bedf7f9-7438-41c9-a597-0336b62fa0bf",
                        "source_entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                        "source_sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                        "source_sense_description": "naam die van generatie op generatie en indien gewenst door het huwelijk overgedragen wordt",
                        "target_lang_word": "Familienname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Familienname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c591f08b-c9c8-30d9-80f1-0d8780cd8c1e",
                                        "entry_id": "594179bd-2ea4-33fc-81d1-54935a3bdc0a",
                                        "glosses": [
                                            "der den Mitgliedern einer Familie gemeinsame Teil des (vollständigen) Namens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e07869c6-9efa-4c3f-9fb0-4761e0861bdd",
                                                "sense_id": "c591f08b-c9c8-30d9-80f1-0d8780cd8c1e",
                                                "text": "In der westlichen Kultur steht der Familienname meist hinter dem Vornamen."
                                            },
                                            {
                                                "example_id": "f8b355ff-dfb8-4bdc-9fa8-bc06e7793759",
                                                "sense_id": "c591f08b-c9c8-30d9-80f1-0d8780cd8c1e",
                                                "text": "„Auf dem Gebiet der Anthroponyme dominieren mit großem Abstand die Untersuchungen zu den Personennamen und den Familiennamen.“"
                                            },
                                            {
                                                "example_id": "b52220dd-83b2-4659-800a-eb70f8b3b2db",
                                                "sense_id": "c591f08b-c9c8-30d9-80f1-0d8780cd8c1e",
                                                "text": "„Ihm fiel auf, dass manche Gäste seinen Familiennamen nicht mit der französischen Endbetonung aussprachen, sondern mit der schlichten angelsächsischen.“"
                                            },
                                            {
                                                "example_id": "dc9d62b0-8437-46f0-b17e-9e6f55394b2a",
                                                "sense_id": "c591f08b-c9c8-30d9-80f1-0d8780cd8c1e",
                                                "text": "„Wie groß der Druck auf die Familien in Groß Döbern gewesen ist, den Familiennamen zu ändern, lässt sich heute nicht mehr rekonstruieren.“"
                                            },
                                            {
                                                "example_id": "8c13b921-ae77-4a94-bbfb-0117325fd48f",
                                                "sense_id": "c591f08b-c9c8-30d9-80f1-0d8780cd8c1e",
                                                "text": "„Wollte sie mich beschimpfen, nannte sie mich beim Familiennamen meines Vaters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "523675aa-9bdb-4321-8415-98c34e30f588",
                        "source_entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                        "source_sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                        "source_sense_description": "naam die van generatie op generatie en indien gewenst door het huwelijk overgedragen wordt",
                        "target_lang_word": "Nachname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c74d8288-a22d-3681-9198-462414df66a6",
                                        "entry_id": "35053c87-ca0d-38f3-b89c-94bbfa02507e",
                                        "glosses": [
                                            "im Unterschied zum Vornamen, der nachgestellte Name, der Familienname, der im Deutschen normalerweise geschlechtlich nicht unterschieden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61978098-3949-450c-8c6c-8da9b07d33a9",
                                                "sense_id": "c74d8288-a22d-3681-9198-462414df66a6",
                                                "text": "„Eines Tages während einer Bahnfahrt wurde mir ohne jeden Anlass plötzlich klar, dass eigentlich jede Postsendung per Nachname geschickt wird, aber noch lange nicht jede per Nachnahme.“"
                                            },
                                            {
                                                "example_id": "f936f79b-6c88-4160-913e-eff75650599c",
                                                "sense_id": "c74d8288-a22d-3681-9198-462414df66a6",
                                                "text": "Unterschreibe lieber mit Vor- und Nachnamen."
                                            },
                                            {
                                                "example_id": "d56e16eb-b9bb-4312-b534-87f2cedf06bc",
                                                "sense_id": "c74d8288-a22d-3681-9198-462414df66a6",
                                                "text": "In der russischen Sprache gibt es jeweils eine weibliche und eine männliche Form des Nachnamens."
                                            },
                                            {
                                                "example_id": "c89c32f5-2fd3-476f-a37c-fbace4307a6c",
                                                "sense_id": "c74d8288-a22d-3681-9198-462414df66a6",
                                                "text": "„Auch weibliche Nachnamen bekommen das »a« angehängt.“"
                                            },
                                            {
                                                "example_id": "0bd529e1-1416-4497-808f-f2fcc346188b",
                                                "sense_id": "c74d8288-a22d-3681-9198-462414df66a6",
                                                "text": "„Es gibt in Polen diese wunderbare Eigenart, fremde Menschen nicht mit ihrem Nachnamen anzusprechen.“"
                                            },
                                            {
                                                "example_id": "b70b0afa-cd56-4265-9e47-93eedb75628e",
                                                "sense_id": "c74d8288-a22d-3681-9198-462414df66a6",
                                                "text": "„Als nach der Republikgründung alle Einwohner der Türkei Nachnamen bekommen sollten, durften sie sich diese selbst aussuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51f427f5-01e1-4676-b169-0b572520396f",
                        "source_entry_id": "e895fbe2-1918-35e8-bf14-95daa3f3ac4e",
                        "source_sense_id": "ca608f70-73c5-3f34-9b61-31cc990f8d6f",
                        "source_sense_description": "naam die van generatie op generatie en indien gewenst door het huwelijk overgedragen wordt",
                        "target_lang_word": "surname",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surname",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70fcc6b4-8f90-3b88-ba5e-a7addbbb689d",
                                        "entry_id": "9ada9ba3-9a28-3b59-8453-31df67d4881c",
                                        "glosses": [
                                            "The portion of a person's name that is generally hereditary or treated as an indicator of a person's family, which may be shared with other members of the family, or otherwise derived from their names in some fashion; distinguished from that person's given name(s)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0749908b-4b80-47e6-8add-c87aab661fea",
                                                "sense_id": "70fcc6b4-8f90-3b88-ba5e-a7addbbb689d",
                                                "text": "James is my first name, and Smith is my surname."
                                            },
                                            {
                                                "example_id": "5ebd44b9-123d-4512-9295-9bc9b95419c7",
                                                "sense_id": "70fcc6b4-8f90-3b88-ba5e-a7addbbb689d",
                                                "text": "In late yeeres Surnames have beene given for Christian names among vs, and no where else in Christendom."
                                            },
                                            {
                                                "example_id": "956f1676-e2b5-4fcc-897f-0ec33736534f",
                                                "sense_id": "70fcc6b4-8f90-3b88-ba5e-a7addbbb689d",
                                                "text": "The Norman Conquest...brought with it the novelty of family nomenclature, that is to say, the use of hereditary surnames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad958a23-cf81-3d59-8602-d1410d33f0e3",
                                        "entry_id": "9ada9ba3-9a28-3b59-8453-31df67d4881c",
                                        "glosses": [
                                            "Synonym of epithet, an additional name, particularly those derived from a birthplace, quality, or achievement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22bdb48b-6880-49d7-946f-82a7f88cf805",
                                                "sense_id": "ad958a23-cf81-3d59-8602-d1410d33f0e3",
                                                "text": "Barsabas (whose syrname was Iustus)."
                                            },
                                            {
                                                "example_id": "47327a7e-3117-4f52-b8cf-a131d806c647",
                                                "sense_id": "ad958a23-cf81-3d59-8602-d1410d33f0e3",
                                                "text": "My sirname is Peace-Maker, one that is but poorely regarded in England."
                                            },
                                            {
                                                "example_id": "5a22a668-8cad-49cf-8ae3-24af233cc999",
                                                "sense_id": "ad958a23-cf81-3d59-8602-d1410d33f0e3",
                                                "text": "To his sur-name Coriolanus longs more pride\nThen pitty to our Prayers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b07021be-87eb-31cf-9f9e-c844afde848c",
                                        "entry_id": "9ada9ba3-9a28-3b59-8453-31df67d4881c",
                                        "glosses": [
                                            "Synonym of nickname, an additional name given to a person, place, or thing, a byname."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea6f84ea-8878-422f-86f8-6c6740142468",
                                                "sense_id": "b07021be-87eb-31cf-9f9e-c844afde848c",
                                                "text": "I have before declared that Baal was the Sun, and Baal Peor, a sirname, from a particular place of his worship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc14fc52-4e07-3444-82c8-cfa33af9c9e7",
                                        "entry_id": "9ada9ba3-9a28-3b59-8453-31df67d4881c",
                                        "glosses": [
                                            "The cognomen of Roman names."
                                        ],
                                        "tags": [
                                            "Classical-studies"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5713407d-af91-3423-8856-bca8a9ac2fd8",
                                        "entry_id": "9ada9ba3-9a28-3b59-8453-31df67d4881c",
                                        "glosses": [
                                            "A clan."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "surname",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "041ab861-c38a-3ab3-b088-14cb5c6de214",
