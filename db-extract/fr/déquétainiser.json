                        "entry_id": "f837447b-1f28-37a4-b02a-983e3d91ccd6",
                        "glosses": [
                            "Enlever son caractère quétaine à quelque chose ou quelqu’un."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "219eb0f7-5def-43a9-97a6-a543e08a013c",
                                "sense_id": "f75e5b19-480e-307a-8b9d-36f6c79f236f",
                                "text": "Il faut déquétainiser le folklore, dit-il."
                            },
                            {
                                "example_id": "2f5b8f2c-2422-4cb1-a24c-55b8fbd78754",
                                "sense_id": "f75e5b19-480e-307a-8b9d-36f6c79f236f",
                                "text": "Bien que Lisa Leblanc le déquétainise dans nos contrées."
                            },
                            {
                                "example_id": "82fc05ea-9042-45ad-af62-adc1b226760b",
                                "sense_id": "f75e5b19-480e-307a-8b9d-36f6c79f236f",
                                "text": "Mais, Gigi, gober des barbituriques dans son appart parisien, c’est peut-être du dernier cri mais ce n’est pas obligé pour se déquétainiser."
                            }
                        ]
