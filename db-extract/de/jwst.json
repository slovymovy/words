                                        "examples": [
                                            {
                                                "example_id": "91dfdbf4-8758-438b-85bf-43eeb2ca0b82",
                                                "sense_id": "ae4d648a-dedd-3158-9a2f-13928016a1ee",
                                                "text": "Unlike the Hubble telescope, which orbits a few hundred miles above the Earth’s surface and is relatively accessible for servicing missions, the JWST will be located at what is called the L2 point, a location about a million miles farther away from the sun than the Earth."
                                            }
