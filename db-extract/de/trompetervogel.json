                                        "entry_id": "eb384f65-d01a-39b5-92b2-e82105aed732",
                                        "glosses": [
                                            "Any of three species of bird in the genus Psophia from South America named for the trumpeting threat call of the males."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bfebf25-ed36-3dd3-a133-f95164e21ffe",
                                        "entry_id": "eb384f65-d01a-39b5-92b2-e82105aed732",
                                        "glosses": [
                                            "Any of a number of breeds of fancy pigeon (variety of domestic pigeon (Columba livia), originally bred for their peculiar gurgling voice, a prolonged coo called \\\"trumpeting\\\" or \\\"drumming\\\")."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83f553f0-ccf8-33fe-98a4-4b2fa2410164",
                                        "entry_id": "eb384f65-d01a-39b5-92b2-e82105aed732",
                                        "glosses": [
                                            "One who proclaims, publishes, or denounces."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4060c3d-19b9-4182-b619-675f4bc6f08b",
                                                "sense_id": "83f553f0-ccf8-33fe-98a4-4b2fa2410164",
                                                "text": "These men are good trumpeters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fb7e533-4594-3f3b-908b-f968fc83a4a5",
                                        "entry_id": "eb384f65-d01a-39b5-92b2-e82105aed732",
                                        "glosses": [
                                            "An American swan (Cygnus buccinator) with a very loud honk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226f502d-d54e-45ef-a79a-2f0d99a98f2d",
                                                "sense_id": "1fb7e533-4594-3f3b-908b-f968fc83a4a5",
                                                "text": "The trumpeters' fate seems likely to get tangled with that of the mute swan. Currently there's enough habitat for both species, but that may change if trumpeters flourish and mutes aren't controlled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7591ae75-4caf-3d60-be05-80ff834879fb",
                                        "entry_id": "eb384f65-d01a-39b5-92b2-e82105aed732",
                                        "glosses": [
                                            "A perciform fish of the family Latridae, native to Australia, New Zealand and Chile."
                                        ],
