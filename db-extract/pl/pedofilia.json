                                        "entry_id": "18b4be1d-b9a7-3cff-8711-479602b3db05",
                                        "glosses": [
                                            "sexuelle Neigung Erwachsener zu Kindern und Jugendlichen vor Erreichen der Pubertät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12351ec6-85cc-4662-b7aa-1a6b11b2ebd7",
                                                "sense_id": "ab96447d-4c4b-3496-9e01-755f7c6a2a41",
                                                "text": "„Pädophilie ist die häufigste der inkriminierten sexuellen Abweichungen und macht 25 – 30 % aller Sexualdelikte aus (Schorsch u. Pfäfflin 1994).“"
                                            },
                                            {
                                                "example_id": "c4d78567-08f2-4e6d-9aa5-7f615ec5a9ca",
                                                "sense_id": "ab96447d-4c4b-3496-9e01-755f7c6a2a41",
                                                "text": "„Ziel ist nicht, wie Laien oft denken, die vollkommene Heilung von abnormen sexuellen Verlangen wie der Pädophilie, die in der Medizinersprache als Paraphilie zusammengefasst ist.“"
                                            }
                                        ],
