                    "sense_definition": "Simple past and past participle of <w>chew</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>chewed</w> on the bone for several hours.",
                            "target_lang_translations": {
                                "ru": "Собака <w>грызла</w> кость несколько часов.",
                                "de": "Der Hund <w>nagte</w> mehrere Stunden lang an dem Knochen."
                            }
                        },
                        {
                            "text": "He <w>chewed</w> his food slowly and thoughtfully.",
                            "target_lang_translations": {
                                "ru": "Он медленно и задумчиво <w>жевал</w> свою еду.",
                                "de": "Er <w>kaute</w> sein Essen langsam und nachdenklich."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chewed out",
                        "chewed up",
                        "chewed over"
