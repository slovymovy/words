                    {
                        "sense_id": "3e62da71-9f7a-34fa-80fc-468fd1c0caac",
                        "entry_id": "ef9bb95b-aa8a-3dd2-b806-8aaaba9e4371",
                        "glosses": [
                            "Bundesgerichtshof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380a7082-b9a0-4477-96c1-406f395bbf03",
                                "sense_id": "3e62da71-9f7a-34fa-80fc-468fd1c0caac",
                                "text": "„Der Sitz des BGH ist seit dessen Gründung im Jahr 1950 in Karlsruhe.“"
                            },
                            {
                                "example_id": "0deaaa17-d0de-464f-8e9e-d49ff5201751",
                                "sense_id": "3e62da71-9f7a-34fa-80fc-468fd1c0caac",
                                "text": "„Der Bundesgerichtshof in Karlsruhe (BGH) hat jetzt klargestellt, dass Vermieter die Wohnung bereits kündigen können, wenn mehr als eine Monatsmiete auf dem Konto fehlt – allerdings per fristgerechter Kündigung; dabei müssen die gesetzlichen oder die vereinbarten Fristen beachtet werden.“"
                            }
                        ],
