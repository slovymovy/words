        "fr-extract.jsonl": [
            {
                "entry_id": "02b0cbf2-a80f-3c0c-96fd-39de8bc433cd",
                "word": "magnétique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6754a2ea-b3b1-4d2c-ac67-24d765ed9e17",
                        "entry_id": "02b0cbf2-a80f-3c0c-96fd-39de8bc433cd",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "magnétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7564780-f461-3620-9524-51116429e5c7",
                        "entry_id": "02b0cbf2-a80f-3c0c-96fd-39de8bc433cd",
                        "glosses": [
                            "Relatif à l’aimant, qui a les propriétés de l’aimant, ou qui se rattache à ces propriétés."
                        ],
                        "tags": [
                            "Magnétisme"
                        ],
                        "examples": [
                            {
                                "example_id": "88476152-b92a-4164-ad03-b9b82df0b9ae",
                                "sense_id": "d7564780-f461-3620-9524-51116429e5c7",
                                "text": "L’oxyde de fer qui constitue les octaèdres agit sur l'aiguille aimantée ; aussi on lui donne le nom d’oxyde de fer magnétique, ou, par abréviation, de fer magnétique."
                            },
                            {
                                "example_id": "0f40e8eb-d30c-453c-9a8e-c6a47f0fa3d5",
                                "sense_id": "d7564780-f461-3620-9524-51116429e5c7",
                                "text": "Le magnétite (fer-aimant Fe₃O₄) est le corps ferro-magnétique qui se prête le mieux à une étude complète des propriétés magnétiques au dessus de la température de transformation."
                            },
                            {
                                "example_id": "4340cc3b-7456-470e-93f9-fad1f3e0d1ca",
                                "sense_id": "d7564780-f461-3620-9524-51116429e5c7",
                                "text": "La boussole est en Islande d'un emploi assez difficile, à cause de la variation magnétique."
                            },
                            {
                                "example_id": "ffd42726-cc3c-4dd1-9d98-edc62e138079",
                                "sense_id": "d7564780-f461-3620-9524-51116429e5c7",
                                "text": "A la sortie du broyeur, les ordures passent par un déferrailleur magnétique qui enlève les boites de conserve."
                            }
                        ]
                    },
                    {
                        "sense_id": "318f4921-6ca8-36b9-af77-60cbbbcbf9af",
                        "entry_id": "02b0cbf2-a80f-3c0c-96fd-39de8bc433cd",
                        "glosses": [
                            "Qui a une forte capacité d’attraction."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d7115bd0-9750-4321-90d0-df09829ba250",
                                "sense_id": "318f4921-6ca8-36b9-af77-60cbbbcbf9af",
                                "text": "Son âme fut terrassée, subjuguée, sans qu'elle trouvât la force de se défendre contre le pouvoir magnétique de ce regard, quelque involontairement lancé qu'il fût."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "052a7fb3-2936-4f6a-acb9-2add9f694dfb",
                        "source_entry_id": "02b0cbf2-a80f-3c0c-96fd-39de8bc433cd",
                        "target_lang_word": "magnetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05d7483c-2058-3316-ade2-0b0e5f8893a5",
                                        "entry_id": "e4f0f1c9-c4c4-3a50-82eb-033b21901ecb",
                                        "glosses": [
                                            "den Magnetismus und die Eigenschaften eines Magneten betreffend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e0f3a7-148e-4f2e-a8c0-d37368fae1d6",
                                                "sense_id": "05d7483c-2058-3316-ade2-0b0e5f8893a5",
                                                "text": "„Die magnetische Suszeptibilität ist eng mit der magnetischen Permeabilität verwandt.“"
                                            },
                                            {
                                                "example_id": "625562b8-976d-4083-805e-0b2f8c221178",
                                                "sense_id": "05d7483c-2058-3316-ade2-0b0e5f8893a5",
                                                "text": "„Ganze Messreihen sind im Eimer, wenn nur der Boden zittert, ein magnetisches Feld entsteht – Spuren von Chaos, wie sie nun einmal auftauchen würden, sobald eine Straßenbahn 70 Meter entfernt vom Labor über die Gleise rattert.“"
                                            },
                                            {
                                                "example_id": "334a74eb-97a3-4266-8125-1fd4255d56e7",
                                                "sense_id": "05d7483c-2058-3316-ade2-0b0e5f8893a5",
                                                "text": "„Dies sind nun gerade jene Zellen, die während der Nacht bei Nachtziehenden Zugvögeln das höchste Maß an neuronaler Aktivität zeigen - zu der Zeit also, in der sich Gartengrasmücken magnetisch orientieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30d7be3d-597d-3eef-9c66-d38043e6e859",
                                        "entry_id": "e4f0f1c9-c4c4-3a50-82eb-033b21901ecb",
                                        "glosses": [
                                            "die Eigenschaft eines Magneten habend, Dinge (z. B. aus Eisen) anziehen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0838af6b-e286-402e-a509-2885dd89475b",
                                                "sense_id": "30d7be3d-597d-3eef-9c66-d38043e6e859",
                                                "text": "„Es gibt auch Edelstahlmesser, die hervorragend an magnetischen Wandhalterungen hängen bleiben.“"
                                            },
                                            {
                                                "example_id": "d4d44124-7498-4764-94ec-9a96ed5b80a5",
                                                "sense_id": "30d7be3d-597d-3eef-9c66-d38043e6e859",
                                                "text": "„Die magnetischen Wimpern […] sind in drei verschiedenen Designs von natürlich bis glamourös erhätlich.“"
                                            },
                                            {
                                                "example_id": "194be231-d49e-4db4-80c7-a2ad0d88e6f5",
                                                "sense_id": "30d7be3d-597d-3eef-9c66-d38043e6e859",
                                                "text": "„Magnetische Knete besteht aus sogenannter intelligenten Knete, der Millionen von kleinsten magnetischen Partikeln zugefügt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "883dfee2-f5c0-389e-8762-40a7a0cfa073",
                                        "entry_id": "e4f0f1c9-c4c4-3a50-82eb-033b21901ecb",
                                        "glosses": [
                                            "die Eigenschaft habend, von einem Magnet angezogen werden zu können"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026228c7-fce6-4c47-80c9-8fac301b58e6",
                                                "sense_id": "883dfee2-f5c0-389e-8762-40a7a0cfa073",
                                                "text": "„In der Tat kann Edelstahl sehr wohl magnetisch sein.“"
                                            },
                                            {
                                                "example_id": "eb2c86f2-d0d4-43f5-8871-3d7a3eb9aa4f",
                                                "sense_id": "883dfee2-f5c0-389e-8762-40a7a0cfa073",
                                                "text": "„Die Tafelfolie ist magnetisch und selbstklebend. Sie bietet eine ideale Fläche für Infos und Memos mit Kreide oder für Zettel mit Magneten.“"
                                            },
                                            {
                                                "example_id": "229c6bc2-0862-4cee-ae2b-fa87c4cf0430",
                                                "sense_id": "883dfee2-f5c0-389e-8762-40a7a0cfa073",
                                                "text": "„Whiteboards sind abwischbar und magnetisch, jedoch verfügen diverse Modelle über weitere Besonderheiten.“"
                                            },
                                            {
                                                "example_id": "cd6166bf-cc09-4d4d-b286-b4ee883bd616",
                                                "sense_id": "883dfee2-f5c0-389e-8762-40a7a0cfa073",
                                                "text": "„Zehnjährige Schülerinnen und Schüler führen Experimente zum Magnetismus durch und prüfen, welche Stoffe magnetisch sind.“"
                                            },
                                            {
                                                "example_id": "8ed3ac8b-7535-42b7-bd28-2d6cd5de5012",
                                                "sense_id": "883dfee2-f5c0-389e-8762-40a7a0cfa073",
                                                "text": "„Darüber hinaus hat Holz eine Reihe weiterer spezifischer Eigenschaften, die es als Baustoff für besondere Anwendungen prädestinieren: Holz ist nicht magnetisch und nicht elektrisch aufladbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4bc08638-9491-39ae-aceb-c1f54aeff368",
                                        "entry_id": "e4f0f1c9-c4c4-3a50-82eb-033b21901ecb",
                                        "glosses": [
                                            "eine anziehende Wirkung besitzend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c364f9b7-a403-44e9-ae77-a9e6ba3afd20",
                                                "sense_id": "4bc08638-9491-39ae-aceb-c1f54aeff368",
                                                "text": "Die Geschäfte in der Innenstadt ziehen die Leute magnetisch an."
                                            },
                                            {
                                                "example_id": "d447b48f-751b-4dac-8360-f5a9ecd03378",
                                                "sense_id": "4bc08638-9491-39ae-aceb-c1f54aeff368",
                                                "text": "Ihr magnetischer Blick fixiert den Kollegen wie eine Katze eine Maus."
                                            },
                                            {
                                                "example_id": "b536ab6e-3f30-43f9-a0ba-397f15a995b4",
                                                "sense_id": "4bc08638-9491-39ae-aceb-c1f54aeff368",
                                                "text": "Die neue Attraktion hatte eine magnetische Wirkung auf das Publikum."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
