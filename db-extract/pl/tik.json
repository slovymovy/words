                                "target_senses": [
                                    {
                                        "sense_id": "df1bcd1c-f4e7-3343-9e80-4223b4e47746",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A brief, small (sometimes involuntary) movement out of place and then back again; a spasm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16089c3d-8869-40f1-aec9-4baf130f8fa4",
                                                "sense_id": "df1bcd1c-f4e7-3343-9e80-4223b4e47746",
                                                "text": "I saw a little twitch in the man's face, and knew he was lying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3db2b1aa-1a0f-3f48-aab4-b3b8336bd24b",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "Action of spotting or seeking out a bird, especially a rare one."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa5ab924-81dd-30c2-ab62-a087b5d21529",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A stick with a hole in one end through which passes a loop, which can be drawn tightly over the upper lip or an ear of a horse and twisted to keep the animal quiet during minor surgery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d75655b-f74b-4af1-ad50-d0b11ef3212f",
                                                "sense_id": "fa5ab924-81dd-30c2-ab62-a087b5d21529",
                                                "text": "THE TWITCH is a short stick of strong ash, about the size of a mopstick, with a hole pierced near the end, through which is passed a piece of strong but small cord, and tied in a loop large enough to admit the open hand freely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcea4e96-4246-3cb7-8e68-add358c0097c",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A brief, contractile response of a skeletal muscle elicited by a single maximal volley of impulses in the neurons supplying it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5da1e86-88c7-33a3-a8f7-1eb74e8eef40",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "The sudden narrowing almost to nothing of a vein of ore."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5d76b6f-105d-3dce-b133-39374bfde120",
                                        "entry_id": "107e3a2e-683c-3ee0-8b2b-9ce1340b699e",
                                        "glosses": [
                                            "A trip taken in order to observe a rare bird."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "twitch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dab67821-06d4-3fc6-a861-112d56273e67",
                                        "entry_id": "f148e024-fd5a-3e0f-add7-57f98145b691",
                                        "glosses": [
                                            "To perform a twitch; spasm."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4eade46-7c5a-45e5-8fa0-a88058b51939",
                                                "sense_id": "dab67821-06d4-3fc6-a861-112d56273e67",
                                                "text": "His fingers were nervously twitching."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a709a84e-8693-3376-bb7f-6a125403055e",
                                        "entry_id": "f148e024-fd5a-3e0f-add7-57f98145b691",
                                        "glosses": [
                                            "To cause to twitch; spasm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789abbc6-816b-4e23-a03b-5684f605a3fe",
                                                "sense_id": "a709a84e-8693-3376-bb7f-6a125403055e",
                                                "text": "Their feet padded softly on the ground, and they crept quite close to him, twitching their noses..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd577aa4-8892-3605-97e9-3a285b8b7e05",
                                        "entry_id": "f148e024-fd5a-3e0f-add7-57f98145b691",
                                        "glosses": [
                                            "To jerk sharply and briefly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7034a1d-8f43-449c-9cdd-6b9975123e7d",
                                                "sense_id": "bd577aa4-8892-3605-97e9-3a285b8b7e05",
                                                "text": "to twitch somebody's sleeve for attention"
                                            },
                                            {
                                                "example_id": "b0cffe8b-2366-4c93-aa94-3caf9b69d800",
                                                "sense_id": "bd577aa4-8892-3605-97e9-3a285b8b7e05",
                                                "text": "Thrice they twitched the diamond in her ear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5a0e32-bd1d-3854-8fc5-240073ddba72",
                                        "entry_id": "f148e024-fd5a-3e0f-add7-57f98145b691",
                                        "glosses": [
                                            "To exert oneself."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74f1aa7d-dfe6-34c7-95c4-77f1d1c79645",
                                        "entry_id": "f148e024-fd5a-3e0f-add7-57f98145b691",
                                        "glosses": [
                                            "To spot or seek out a bird, especially a rare one."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d644cd21-8fd8-4b05-80a4-e81578b9abe3",
                                                "sense_id": "74f1aa7d-dfe6-34c7-95c4-77f1d1c79645",
                                                "text": "\"The Birdwatchers Handbook ... will be a clear asset to those who 'twitch' in Europe.\""
                                            },
                                            {
                                                "example_id": "728b9fa7-2e80-4604-bd34-9f43e3372b3b",
                                                "sense_id": "74f1aa7d-dfe6-34c7-95c4-77f1d1c79645",
                                                "text": "\"But the key revelation from twitching that wonderful Iceland Gull on 10 March 1974 wasn't its eroticism. It was the sheer innocence of it.\""
                                            },
                                            {
                                                "example_id": "d6f716b2-fc1f-4297-8196-fffa02915783",
                                                "sense_id": "74f1aa7d-dfe6-34c7-95c4-77f1d1c79645",
                                                "text": "\"I hadn't seen John since I went to Adelaide to (unsuccessfully) twitch the '87 Northern Shoveler, when I was a skinny, eighteen-year-old kid. \""
                                            }
                                        ]
                                    }
                                ]
                            },
