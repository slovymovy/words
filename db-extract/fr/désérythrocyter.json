                "senses": [
                    {
                        "sense_id": "87395670-3b8c-368a-b6f7-86dc0fb0859c",
                        "entry_id": "e3cde311-4d7d-36f9-9c83-53532c2b2920",
                        "glosses": [
                            "Enlever les érythrocytes de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a1556a-2af3-4a6b-8806-cc04490f05e2",
                                "sense_id": "87395670-3b8c-368a-b6f7-86dc0fb0859c",
                                "text": "Les résultats de ces examens seront communiqués au service clinique et au laboratoire de thérapie cellulaire qui prépare les prélèvements afin que la décision de désérythrocyter ou de déplasmatiser le greffon puisse être prise."
                            },
                            {
                                "example_id": "d8f09636-7f2b-4659-a712-257162e296f3",
                                "sense_id": "87395670-3b8c-368a-b6f7-86dc0fb0859c",
                                "text": "Dans ces situations, le greffon devra à la fois être « désérythrocyté » et déplasmatisé par lavage afin d'éviter l'hémolyse des hématies du donneur et du receveur."
                            },
                            {
                                "example_id": "de2ae966-eb33-4537-8f35-eae05b0f5f84",
                                "sense_id": "87395670-3b8c-368a-b6f7-86dc0fb0859c",
                                "text": "Pour les greffes de moelle osseuse non désérythrocytée (donc riche en hématies potentiellement non ABO compatibles), une épreuve de Beth-Vincent doit être réalisée au lit du patient."
                            }
                        ]
                    }
