                "senses": [
                    {
                        "sense_id": "ce5e0593-f9f1-3604-91bf-1aecdfca05e0",
                        "entry_id": "09c33989-0c51-33c3-a2fc-6d9b2012c364",
                        "glosses": [
                            "Schreibstil oder Schriftart mit leicht geneigten, schrägen Buchstaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d7ceb7-a4c7-465f-9724-340e25339789",
                                "sense_id": "ce5e0593-f9f1-3604-91bf-1aecdfca05e0",
                                "text": "„Auch die ausgestellte Herrscherurkunde Karls des Großen vom 8. März 780 – das Stiftsarchiv besitzt zwei Originale des größten Frankenkönigs – ist noch in merowingischer Kursive abgefaßt.“"
                            },
                            {
                                "example_id": "654647ee-29c8-45e5-bd79-10ac1b082cd8",
                                "sense_id": "ce5e0593-f9f1-3604-91bf-1aecdfca05e0",
                                "text": "„Andere typographische Eigenheiten wirken altertümlich, so das von der Fraktur überlieferte Sperren von Kleinbuchstaben als Auszeichnung im Text mangels Kursiven und Kapitälchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc19f590-4576-427b-a9f9-80c0519f7413",
                        "source_entry_id": "09c33989-0c51-33c3-a2fc-6d9b2012c364",
                        "source_sense_id": "ce5e0593-f9f1-3604-91bf-1aecdfca05e0",
                        "source_sense_description": "Schreibstil oder Schriftart mit leicht geneigten, schrägen Buchstaben",
                        "target_lang_word": "italics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "italics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2196f0b6-2ee6-3454-98d5-fb3b5380793a",
                                        "entry_id": "4ca04d77-bfa3-3fc7-9621-d3a5fefecddf",
                                        "glosses": [
                                            "Letters in an italic typeface."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2be423a-e442-4086-898a-5bb2e2950f03",
                                                "sense_id": "2196f0b6-2ee6-3454-98d5-fb3b5380793a",
                                                "text": "There is no need to put the whole paragraph in italics."
                                            },
                                            {
                                                "example_id": "3b3d831a-c348-4dc7-bf49-30c9e142ce08",
                                                "sense_id": "2196f0b6-2ee6-3454-98d5-fb3b5380793a",
                                                "text": "[T]hey [the Catholics and Puritans] encumbered their verſion [of the Bible] with a load of uſeleſs Italics; often without the leaſt neceſſity, and almoſt always to the detriment of the text. In fact, either the words in Italics are virtually implied in the Hebrew, or they are not. In the former caſe they are a real part of the text, and ſhould be printed in the ſame character: in the latter, they are generally ill aſſorted and clumſy ekes, that may well be ſpared; and which often disfigure the narration under pretence of connecting it."
                                            },
                                            {
                                                "example_id": "14f82d30-2bb4-4c79-9c5e-281c09dd8f4c",
                                                "sense_id": "2196f0b6-2ee6-3454-98d5-fb3b5380793a",
                                                "text": "Writing of cyclic diagramming, he speaks of \". . . the practical state of locomotives that pass through any number of engine and maintenance crews' hands in the course of a week's common user working, receiving love from none\". The italics are mine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa46d344-86fc-3921-b720-a4ea28b34707",
                                        "entry_id": "4ca04d77-bfa3-3fc7-9621-d3a5fefecddf",
                                        "glosses": [
                                            "plural of italic: exaggerated intonation or some similar oral speech device by which one or more words is heavily and usually affectedly emphasized or otherwise given sharp prominence"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2bb81c5-4c38-40a9-b88f-c9e5dc7b2993",
                                                "sense_id": "aa46d344-86fc-3921-b720-a4ea28b34707",
                                                "text": "Margaret Long\n[…] was yapping, her silly voice fraught with italics."
                                            },
                                            {
                                                "example_id": "8a07f094-4ea3-4829-b234-81e552c2fb47",
                                                "sense_id": "aa46d344-86fc-3921-b720-a4ea28b34707",
                                                "text": "a woman who has an irritating way of speaking in italics"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
