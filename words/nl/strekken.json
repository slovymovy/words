                    ],
                    "target_lang_definitions": {
                        "en": "To cover a certain distance or reach to a specific point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch",
                                "target_lang_sense_clarification": "to extend physically over an area"
                            },
