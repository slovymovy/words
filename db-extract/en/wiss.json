                        "examples": [
                            {
                                "example_id": "2792dfc9-37d9-4855-9068-ebba60ada992",
                                "sense_id": "91eab9d8-9c8e-3fda-baa9-f03b11c33a87",
                                "text": "Now with their might they downe me pull, and bring me where they woll, the Blood of myne heart I wiss now causeth both Joy and blisse."
                            },
                            {
                                "example_id": "9b1c2aea-7afa-48fc-9f55-e988656f28fe",
                                "sense_id": "91eab9d8-9c8e-3fda-baa9-f03b11c33a87",
                                "text": "And though that the water be gross and heavy, yet nothing so gross as the earth, I wiss; therefore by heat it is vapoured up lightly, and in the air maketh clouds and mists."
                            }
                        ]
                    }
