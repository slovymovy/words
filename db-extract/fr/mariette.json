        "fr-extract.jsonl": [
            {
                "entry_id": "ed4b26a7-9d84-3827-8c45-088e089409a6",
                "word": "Mariette",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6bf50db8-2800-3f45-bba0-ebb58d4df7fe",
                        "entry_id": "ed4b26a7-9d84-3827-8c45-088e089409a6",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15382ef0-db69-437b-b24d-2b43679a2160",
                                "sense_id": "6bf50db8-2800-3f45-bba0-ebb58d4df7fe",
                                "text": "— Mariette, ma fille, dit Lisbeth à la cuisinière qui vint lui ouvrir la porte, comment va ma bonne Adeline ?..."
                            },
                            {
                                "example_id": "4d309a67-48c2-4693-8ff5-e21f7ad90546",
                                "sense_id": "6bf50db8-2800-3f45-bba0-ebb58d4df7fe",
                                "text": "Il lui prépare des pâtées exquises et fait la chasse aux escargots, que Mariette désencoquille d’un prompt coup de bec."
                            },
                            {
                                "example_id": "399fc1e4-1fb9-442c-8683-6d825c3639fa",
                                "sense_id": "6bf50db8-2800-3f45-bba0-ebb58d4df7fe",
                                "text": "Alors, tu la connais, cette Mariette ?"
                            },
                            {
                                "example_id": "f14a7cb2-ec46-4cf6-8b1f-fcec1530e9d7",
                                "sense_id": "6bf50db8-2800-3f45-bba0-ebb58d4df7fe",
                                "text": "En revanche Mariette lui affirme que Gilberte Maraval est encore en vie, tout à fait bien portante – du moins aux dernières nouvelles – et qu’elle habite toujours à Neuvic-sur-l’Isle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fa1d2a1-2cf8-44e3-9cac-fd98e2b2a49d",
                        "source_entry_id": "ed4b26a7-9d84-3827-8c45-088e089409a6",
                        "source_sense_id": "6bf50db8-2800-3f45-bba0-ebb58d4df7fe",
                        "source_sense_description": "diminutif de Marie",
                        "target_lang_word": "Maruška",
