                ],
                "senses": [
                    {
                        "sense_id": "7593e191-ff9a-3ce2-a263-bf72ec6b8c26",
                        "entry_id": "1dab74b4-5c9b-3a67-9fe3-b20d40b83317",
                        "glosses": [
                            "Produkt, das aus ökologischer und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a5cc33-d83d-4257-b972-7af96dddd632",
                                "sense_id": "7593e191-ff9a-3ce2-a263-bf72ec6b8c26",
                                "text": "„40 Prozent der Kunden der auf Bio-Ware spezialisierten Lebensmittel-Kette wollen ‚bisher explizit‘ keinen Kassenbon.“"
                            },
                            {
                                "example_id": "c2ad126a-196e-4771-a402-34e813e35fd6",
                                "sense_id": "7593e191-ff9a-3ce2-a263-bf72ec6b8c26",
                                "text": "„Die nach der Bio-Ware zweitteuerste Eier-Kategorie ist wegen der anhaltenden Vogelgrippe knapp geworden, weil die Geflügelhalter ihre Tiere aus Schutzgründen nicht mehr ins Freie lassen durften.“"
                            },
                            {
                                "example_id": "2cc326b8-93a9-433b-9cde-f09cfdb56de7",
                                "sense_id": "7593e191-ff9a-3ce2-a263-bf72ec6b8c26",
                                "text": "„In der Vergangenheit lagen meist zehn bis zwölf Cent zwischen einem Liter konventioneller Milch und der gleichen Menge Bio-Ware.“"
                            },
                            {
                                "example_id": "2820313c-629d-4c54-bd84-a17cac2e0215",
                                "sense_id": "7593e191-ff9a-3ce2-a263-bf72ec6b8c26",
                                "text": "„Bio-Ware darf man nicht erwarten, wer die verlangt, besucht dem Imbiss besser nicht, oder hält sich, wenn doch, am besten an Fleischloses, das Tzatziki zum Beispiel ist für sich allein einen Weg wert.“"
                            },
                            {
                                "example_id": "33d9c378-61b3-4fab-979e-e743e21f5d4a",
                                "sense_id": "7593e191-ff9a-3ce2-a263-bf72ec6b8c26",
                                "text": "„Förster sieht die Preise für Bio-Ware trotz der starken Nachfrage von Verbrauchern und der allfälligen Klage, hessische Bauern könnten die Kunden im eigenen Land nicht aus eigener Kraft beliefern, unter Druck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
