                "senses": [
                    {
                        "sense_id": "01fa425c-c735-3446-a546-317ef64c3659",
                        "entry_id": "25ac59f9-dc84-31c3-ad27-c3c92d33c6b2",
                        "glosses": [
                            "Ellipsis of Willy Fudd or Willie Fudd (“the E-1 Tracer, a type of airplane used by the U.S. Navy”)."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "3523b8d6-980a-4ec8-b40a-63ca917503c7",
                                "sense_id": "01fa425c-c735-3446-a546-317ef64c3659",
                                "text": "A Fudd that's seen inflight Is such an ugly sight. But one that's crunched in tight Becomes a scenic blight."
                            },
                            {
                                "example_id": "b20b4f02-47e0-41e3-995f-c17756380348",
                                "sense_id": "01fa425c-c735-3446-a546-317ef64c3659",
                                "text": "After boot camp training Mark went to a Naval Air base on the west coast. His assignment . . . Keep the \"Fudds\" flying."
                            },
                            {
                                "example_id": "ea13786c-652c-4388-af54-01b1f02088cc",
                                "sense_id": "01fa425c-c735-3446-a546-317ef64c3659",
                                "text": "A voice from air operations ordered, \"Pilots for the oh four-thirty launch, man your aircraft.\" Then, in deference to our friends who flew the E-1 Tracers, also known as the Willie Fudds, \"and fill the Fudds!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "f108a9b0-4982-392f-8f94-3d5a0d5fa29e",
                        "entry_id": "25ac59f9-dc84-31c3-ad27-c3c92d33c6b2",
                        "glosses": [
                            "Ellipsis of Super Fudd or Superfudd (“the E-2 Hawkeye, a type of airplane used by the U.S. Navy”)."
                        ],
                        "tags": [
