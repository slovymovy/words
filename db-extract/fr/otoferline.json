                        "sense_id": "6d8b8d5f-dfb2-3432-a86d-e27c653eba62",
                        "entry_id": "7d90b8e1-d9a2-34d3-94c2-608db3552c9d",
                        "glosses": [
                            "Protéine présente dans le corps humain, nécessaire aux cellules auditives de l’oreille interne pour convertir les vibrations sonores en signaux chimiques envoyés au cerveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea70c94e-097b-4767-afc4-04b0375a5f91",
                                "sense_id": "6d8b8d5f-dfb2-3432-a86d-e27c653eba62",
                                "text": "Chez les personnes atteintes, un gène défectueux empêche la production d’otoferline, une protéine nécessaire aux cellules auditives sensorielles de l’oreille interne pour convertir les vibrations sonores en signaux chimiques envoyés au cerveau."
                            },
                            {
                                "example_id": "bb963ce1-7e3d-4cca-9025-15128fa0d710",
                                "sense_id": "6d8b8d5f-dfb2-3432-a86d-e27c653eba62",
                                "text": "Concrètement, une copie du gène normal de l’otoferline sera injectée au niveau de l’oreille interne déficiente des enfants."
                            },
                            {
                                "example_id": "7d32c624-c637-4c76-aaa1-85b5661f588b",
                                "sense_id": "6d8b8d5f-dfb2-3432-a86d-e27c653eba62",
                                "text": "Une mutation dans le gène qui code pour l’otoferline peut ainsi affaiblir la liaison entre la protéine et une synapse de calcium dans l’oreille."
                            }
                        ]
                    }
                ],
