                "senses": [
                    {
                        "sense_id": "d54758fd-0e8e-366c-b5cb-9e6790a91a76",
                        "entry_id": "445b70c3-56ce-33d6-87a0-f2c4db154b21",
                        "glosses": [
                            "Débarrasser du graphite qui s'est déposé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "272ed971-34c0-4a3f-a3c3-1f946101a3f3",
                                "sense_id": "d54758fd-0e8e-366c-b5cb-9e6790a91a76",
                                "text": "11 n'est pas nécessaire pour cela d'arrêter le fonctionnement du four ; on peut dégraphiter une ou plusieurs cornues et continuer de charger les autres."
                            },
                            {
                                "example_id": "b8b3b19a-8b09-49dc-a07e-f00a4713620c",
                                "sense_id": "d54758fd-0e8e-366c-b5cb-9e6790a91a76",
                                "text": "D'autre part, le directeur de la Compagnie du gaz de Bordeaux signalait que la distillation du lignite est susceptible de fournir des produits volatils donnant du gaz de qualité, mais son humidité excessive a pour effet de « dégraphiter » les cornues."
                            },
                            {
                                "example_id": "e5d3efc0-d46d-4888-8e7a-9f9957ad72c2",
                                "sense_id": "d54758fd-0e8e-366c-b5cb-9e6790a91a76",
                                "text": "On est alors obligé d’arrêter le travail des cornues pour les décarburer ou dégraphiter."
                            }
                        ]
                    }
