                "senses": [
                    {
                        "sense_id": "3a446391-e0c7-35be-9ea8-87c4e3d6ff3c",
                        "entry_id": "de2eea2c-24b4-3226-bc0f-c79b9efdc601",
                        "glosses": [
                            "продавать купленное у другого (обычно для извлечения выгоды)"
                        ],
