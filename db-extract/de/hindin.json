                "senses": [
                    {
                        "sense_id": "2992d2b8-263f-3d13-bb16-d43de0193f81",
                        "entry_id": "9035034b-207e-311a-a3b7-adef2a674fdf",
                        "glosses": [
                            "weibliches Tier des Rothirsches"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "08b6d60b-8ec5-47d5-823b-24eb3092d189",
                                "sense_id": "2992d2b8-263f-3d13-bb16-d43de0193f81",
                                "text": "„Es giebt zahlreiche mittelalterliche Legenden, welche Reproductionen hievon sind und von dem jungen Helden erzählen, der im Walde verlassen und bald von einer Ziege, bald von einer Hindin genährt wird, derselben, die später dem königlichen Vater bei der Wiederauffindung seines Sohnes, oder dem prinzlichen Gemahl zur Entdeckung der verlassenen Prinzessin, seiner Braut, als Wegweiser dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8161180-3b34-47f4-95df-3528f249afd8",
                        "source_entry_id": "9035034b-207e-311a-a3b7-adef2a674fdf",
                        "source_sense_id": "2992d2b8-263f-3d13-bb16-d43de0193f81",
                        "source_sense_description": "dichterisch: weibliches Tier des Rothirsches",
                        "target_lang_word": "hind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11e98964-6db4-3bee-8ae3-e35e398a0a04",
                                        "entry_id": "8ca9e3fc-e605-3ba3-94f1-2c6d464f9179",
                                        "glosses": [
                                            "Located at the rear (most often said of animals' body parts)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d72e1e33-32bc-47e2-9aec-bb57e93a3711",
                                                "sense_id": "11e98964-6db4-3bee-8ae3-e35e398a0a04",
                                                "text": "Fareweel, my rhyme-compoſing billie! / Your native ſoil was right ill-willie; / But may ye flouriſh like a lily, / Now bonilie! / I'll toaſt ye in my hindmoſt gillie, / Tho' owre the Sea!"
                                            },
                                            {
                                                "example_id": "f6df6f0c-d4ea-45ff-bd2c-27056c9d6f09",
                                                "sense_id": "11e98964-6db4-3bee-8ae3-e35e398a0a04",
                                                "text": "When it had advanced from the wood, it hopped much after the fashion of a kangaroo, using its hind feet and tail to propel it, and when it stood erect, it sat upon its tail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87c94807-459c-39f0-9aec-63952280e325",
                                        "entry_id": "8ca9e3fc-e605-3ba3-94f1-2c6d464f9179",
                                        "glosses": [
                                            "Backward; to the rear."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00362084-07bd-3318-a327-821c59af813d",
                                        "entry_id": "a30aba03-0cdf-3943-8596-da6532a43715",
                                        "glosses": [
                                            "A doe (female deer), especially a red deer at least two years old."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "847b6289-197f-413f-abcb-8a1e8c5d29b6",
                                                "sense_id": "00362084-07bd-3318-a327-821c59af813d",
                                                "text": "Nature binds all creatures to love their young ones; an hen to preserve her brood will run upon a lion, an hind will fight with a bull, a sow with a bear, a silly sheep with a fox."
                                            },
                                            {
                                                "example_id": "487a122a-855f-4250-95fa-58be1739a263",
                                                "sense_id": "00362084-07bd-3318-a327-821c59af813d",
                                                "text": "The ſpring diſplaying her elegant taſte, the proud walk of the gold-feathered pheaſant, the light tread of the ſmall-hoofed hind, and the dancing of the ſtar-trained peacock, infuſed joy into the ſoul of the ſpectator of the aſtoniſhing works of the Creator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "567f26dc-a991-312b-b0cb-a3dc3599ded4",
                                        "entry_id": "a30aba03-0cdf-3943-8596-da6532a43715",
                                        "glosses": [
                                            "A spotted food fish of the genus Epinephelus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "654727fe-a83a-35a2-9f21-55f0d8c9213f",
                                        "entry_id": "06737063-161e-3caa-87e4-f7426d170c36",
                                        "glosses": [
                                            "A servant, especially an agricultural labourer."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55dbd133-384a-4c9b-b236-ec896fdd7f2b",
                                                "sense_id": "654727fe-a83a-35a2-9f21-55f0d8c9213f",
                                                "text": "Attilius Regulus […] writ vnto the common-wealth, that a hynde, or plough-boy whom he had left alone to over-ſee and husband his land (which in all was but ſeaven acres of ground) was run away from his charge[…]."
                                            },
                                            {
                                                "example_id": "a732a1c4-35fe-4813-bab1-ac1b33446810",
                                                "sense_id": "654727fe-a83a-35a2-9f21-55f0d8c9213f",
                                                "text": "The farmers ſervants who have families, and engage by the year, are called hinds, and receive 10 bolls oats, 2 bolls barley, and 1 boll peas, which two laſt articles are called hummel corn, […]"
                                            },
                                            {
                                                "example_id": "30be28fb-442d-47d6-8581-14da7abcd641",
                                                "sense_id": "654727fe-a83a-35a2-9f21-55f0d8c9213f",
                                                "text": "The peaceful tenour of Nina's life was interrupted one morning by the mysterious looks and whisperings of her maids and hinds."
                                            },
                                            {
                                                "example_id": "f69178f7-410c-411f-8338-c984be14fbfb",
                                                "sense_id": "654727fe-a83a-35a2-9f21-55f0d8c9213f",
                                                "text": "that my brother can sit at leisure in a seat and learn something and I must work like a hind, who am your son as well as he!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
