                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51c7464c-f47b-3d85-9d75-c542238b8a3b",
                                        "entry_id": "a253ff5e-bbf6-395b-8375-4e2cf11f35c1",
                                        "glosses": [
                                            "Cavidad creada en la base de la hoja carpelar cerrada, o por la unión de varios carpelos, en la que se hallan los óvulos. Parte inferior del pistilo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f5b5ec31-c67d-3a8d-a711-a816d917619b",
                                        "entry_id": "a253ff5e-bbf6-395b-8375-4e2cf11f35c1",
                                        "glosses": [
                                            "Moldura ornada con óvulos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e2a27bf2-39ed-3b54-ae33-59bce6426f20",
                                        "entry_id": "a253ff5e-bbf6-395b-8375-4e2cf11f35c1",
                                        "glosses": [
                                            "Palabra malsonante adoptada por algunas mujeres para reemplazar la referencia a los testículos masculinos."
                                        ],
                                        "tags": [
                                            "Spain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "298a1d87-07f2-4ccc-bb24-aa8f5583dab0",
                                                "sense_id": "e2a27bf2-39ed-3b54-ae33-59bce6426f20",
                                                "text": "Estoy hasta los ovarios con el desorden de mi marido."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7c7521f-e9f4-4f38-8ab2-58d9cd5560d8",
                        "source_entry_id": "221cc527-1983-3d1c-8855-7072ebbc2aa9",
                        "source_sense_id": "4c5acb20-ddc3-367d-be5c-857345e6152a",
                        "target_lang_word": "Eierstock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eierstock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                        "entry_id": "eb3050fe-827e-3426-8053-7872d2e007ae",
                                        "glosses": [
                                            "paarig angelegtes, primäres, weibliches Geschlechtsorgan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4eff880-9975-43b0-a07e-f65cbc5dbc7b",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "In den Eierstöcken werden die Eizellen gebildet."
                                            },
                                            {
                                                "example_id": "2a45ce32-1fc7-4f7e-8588-ce7fc74c0a67",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Der Eierstock […] produziert die weiblichen Hormone und die Eizellen, die vom Eileiter […] aufgefangen werden, wo die Befruchtung stattfindet.“"
                                            },
                                            {
                                                "example_id": "15e6b491-900e-4ad2-84e0-d72aa6b85c6c",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Sie lernten, zu was der Hoden nutze war, die Funktion der Eierstöcke, und was es mit den Follikeln auf sich hatte.“"
                                            },
                                            {
                                                "example_id": "2b519126-eb98-4e0c-a222-6f23611d3dde",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Eierstöcke, optimal in Szene gesetzt und illuminiert, könnten so aussehen.“"
                                            },
                                            {
                                                "example_id": "e50780fe-047a-4230-8c02-dfd3491c32cc",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Zwischen ihnen stand die Gräfin Bellin als La Vallière, mit dem Gesicht eines gefallenen Engels und vielen Rubinen; Ravic erinnerte sich, ihr vor einem Jahr die Eierstöcke operiert zu haben – auf eine Diagnose Durants hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fce7f74-d402-4f15-9876-eee25034833d",
                        "source_entry_id": "221cc527-1983-3d1c-8855-7072ebbc2aa9",
