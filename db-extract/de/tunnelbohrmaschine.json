                "senses": [
                    {
                        "sense_id": "c2d2a73a-7bac-3bbf-9c20-fabbfef3bf64",
                        "entry_id": "b0bce649-df8e-3213-80c4-bd75dc8ec568",
                        "glosses": [
                            "Maschine, die beim Tunnelbau eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2981d9d-a038-4843-9e43-1d86949baa88",
                                "sense_id": "c2d2a73a-7bac-3bbf-9c20-fabbfef3bf64",
                                "text": "Die Tunnelbohrmaschine wurde an der Baustelle des Tunnels zusammengebaut."
                            },
                            {
                                "example_id": "995d151d-6766-424a-b211-25caef360801",
                                "sense_id": "c2d2a73a-7bac-3bbf-9c20-fabbfef3bf64",
                                "text": "„Denn von hier aus – eben konkret vom Baufeld Triester Straße in Favoriten – frisst sich die in 30 Metern Tiefe startende Tunnelbohrmaschine unterirdisch in Richtung 7. Bezirk.“"
                            },
                            {
                                "example_id": "3c89bd78-ba23-4374-9fa7-ce1e982b1029",
                                "sense_id": "c2d2a73a-7bac-3bbf-9c20-fabbfef3bf64",
                                "text": "„Der Straßenverkehr mache ihn wahnsinnig, twitterte er Ende des vergangenen Jahres und präsentierte sogleich seine Lösung dieses Problems: Einfach eine Tunnelbohrmaschine bauen und graben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e472a4c-33f4-4f68-8604-8d5c3168ce27",
                        "source_entry_id": "b0bce649-df8e-3213-80c4-bd75dc8ec568",
                        "source_sense_id": "c2d2a73a-7bac-3bbf-9c20-fabbfef3bf64",
                        "source_sense_description": "Technik: Maschine, die beim Tunnelbau eingesetzt wird",
                        "target_lang_word": "tunnel boring machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tunnel boring machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63a39dee-596c-30b3-9b2d-06ecc205f3e0",
                                        "entry_id": "e602a44d-4a53-3a49-a1df-92b2a43bd7d1",
                                        "glosses": [
                                            "A large machine used to excavate tunnels with a circular cross section."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db1eb25-caae-440a-8733-f4902460e5a4",
                                                "sense_id": "63a39dee-596c-30b3-9b2d-06ecc205f3e0",
                                                "text": "Images of the first two Tunnel Boring Machines (TBMs) under construction for HS2 were released on May 26.\nEach TBM is 170 metres long and weighs around 2,000 tonnes. Once in use, they will run non-stop for three and a half years, stopping only for Christmas and Bank Holidays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3222daba-a5e5-40d0-8557-8cff7b63046e",
                        "source_entry_id": "b0bce649-df8e-3213-80c4-bd75dc8ec568",
                        "source_sense_id": "c2d2a73a-7bac-3bbf-9c20-fabbfef3bf64",
                        "source_sense_description": "Technik: Maschine, die beim Tunnelbau eingesetzt wird",
                        "target_lang_word": "TBM",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "TBM",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff0188f2-5216-3ed9-96b8-7b6e6501d4b7",
                                        "entry_id": "0456b7d2-0b7b-394d-9565-ccc21fb80cab",
                                        "glosses": [
                                            "Initialism of tunnel boring machine."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a16a849-7cd3-4c64-9202-3e4b65e41e76",
                                                "sense_id": "ff0188f2-5216-3ed9-96b8-7b6e6501d4b7",
                                                "text": "Four other TBMs are currently in the ground, digging twin bore tunnels under the Chilterns and in Greater London."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7febf7d4-e28c-4908-b254-2c7fe2b9936e",
                        "source_entry_id": "b0bce649-df8e-3213-80c4-bd75dc8ec568",
                        "source_sense_id": "c2d2a73a-7bac-3bbf-9c20-fabbfef3bf64",
                        "source_sense_description": "Technik: Maschine, die beim Tunnelbau eingesetzt wird",
                        "target_lang_word": "tunnelier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tunnelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e81e437-9a40-3cbf-aa33-fc1ec79d137b",
                                        "entry_id": "35423b87-937a-34e9-a8a7-f11e7079082e",
                                        "glosses": [
                                            "Ouvrier chargé de creuser des tunnels."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61187fa3-f7dd-34f8-9e0f-c1e77d1a1c05",
                                        "entry_id": "35423b87-937a-34e9-a8a7-f11e7079082e",
                                        "glosses": [
                                            "Engin de génie civil servant à creuser des tunnels, travaillant en continu et à pleine section."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7dca0e-5641-4189-a93e-e77eefaf289f",
                                                "sense_id": "61187fa3-f7dd-34f8-9e0f-c1e77d1a1c05",
                                                "text": "Ce qui m’a le plus frappé, c’est la pureté des glaises, granits, schistes et sables dans lesquels les tunneliers enfoncent leurs énormes fraises."
                                            },
                                            {
                                                "example_id": "e30b1e06-f370-4641-aa57-d838755d9e59",
                                                "sense_id": "61187fa3-f7dd-34f8-9e0f-c1e77d1a1c05",
                                                "text": "Le tunnelier chargé de creuser la ligne B du métro de Rennes a rencontré des difficultés des filons d’antimoine, un minerai semi-métallique dangereux pour la santé, sur le tracé, obligeant la Société d’Économie Mixte des Transports Collectifs de l’Agglomération Rennaise (Semtcar) à recourir à une installation de stockage dédiée."
                                            },
                                            {
                                                "example_id": "e997c115-857f-4847-be4b-3a9d5c666f41",
                                                "sense_id": "61187fa3-f7dd-34f8-9e0f-c1e77d1a1c05",
                                                "text": "Jamais un lien sous-fluvial n’a été réalisé avec un tunnelier aussi large jusqu’ici."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
