                        "examples": [
                            {
                                "example_id": "705410dd-1727-4545-b165-91ac3f66dbb0",
                                "sense_id": "e6904cd8-f49c-3821-a0ff-00287ff26f78",
                                "text": "Profar, binnenvelder van Texas Rangers, vervangt Yurendell de Caster, die in de met 7-6 gewonnen wedstrijd tegen Cuba een voetblessure opliep."
                            },
                            {
                                "example_id": "a138ef80-292d-426c-9b7f-9f5bd19879ef",
                                "sense_id": "e6904cd8-f49c-3821-a0ff-00287ff26f78",
                                "text": "Acht spelers met een Nederlands paspoort kwamen dit seizoen al in actie in de hoogste Amerikaanse honkbalcompetitie. En vrijwel allemaal speelden ze in maart voor Oranje in de World Baseball Classic. De negende, Jonathan Schoop, kan ieder moment zijn debuut maken. De binnenvelder van Baltimore Orioles is dan de dertigste Nederlander in de geschiedenis van de MLB."
                            }
                        ]
