                    "sense_definition": "Having leaks; not fully sealed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "leaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>leaky</w> bucket dripped water all over the floor as I carried it.",
                            "target_lang_translations": {
                                "ru": "Из <w>дырявого</w> ведра, которое я нёс, вода капала прямо на пол."
                            }
                        },
                        {
                            "text": "We had to replace the <w>leaky</w> pipe before the basement flooded.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось заменить <w>протекающую</w> трубу, прежде чем подвал затопило."
                            }
                        }
                    ],
                    "synonyms": [
                        "porous"
                    ],
                    "antonyms": [
                        "watertight",
                        "sealed"
                    ],
                    "common_phrases": [
                        "leaky pipe",
                        "leaky roof",
                        "leaky bucket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий отверстия или щели, через которые просачивается жидкость или газ; негерметичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протекающий",
                                "target_lang_sense_clarification": "о предметах, через которые просачивается жидкость (например, труба, крыша)"
                            },
                            {
                                "target_lang_word": "дырявый",
                                "target_lang_sense_clarification": "разговорный вариант, указывающий на наличие отверстий или дыр"
                            }
                        ]
                    }
                }
            ]
        }
