                    {
                        "sense_id": "a5215fc9-36ee-3e9a-a0ee-fd2d799e9056",
                        "entry_id": "3b8c86c2-0212-3f39-a8e4-7d72923f0c88",
                        "glosses": [
                            "een voortijdige en kunstmatige beëindiging van een zwangerschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7acbe22-8b5d-4b8c-9e03-da3020b3e061",
                                "sense_id": "a5215fc9-36ee-3e9a-a0ee-fd2d799e9056",
                                "text": "Zwangere pubers nemen vaak een zwangerschapsafbreking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a7734ab-5f7a-44a9-982c-394c788ac532",
                        "source_entry_id": "3b8c86c2-0212-3f39-a8e4-7d72923f0c88",
                        "source_sense_id": "a5215fc9-36ee-3e9a-a0ee-fd2d799e9056",
                        "source_sense_description": "een voortijdige en kunstmatige beëindiging van een zwangerschap",
                        "target_lang_word": "Schwangerschaftsabbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwangerschaftsabbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                        "entry_id": "3e201689-ac53-3ece-b2fa-097b25d2bcae",
                                        "glosses": [
                                            "gynäkologisch durchgeführte Abtötung und Entfernung eines Embryos beziehungsweise Fötus aus der Gebärmutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d9569d-a058-44a1-a5fe-b3a6f8112b18",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "Ein Schwangerschaftsabbruch ist unter bestimmten Umständen straffrei."
                                            },
                                            {
                                                "example_id": "39f75e5d-407a-44ca-8b39-54bb271f2f82",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "»Es macht keine Frau leichtsinnig einen Schwangerschaftsabbruch.«"
                                            },
                                            {
                                                "example_id": "8964f2f7-b64f-4d70-a8d8-d4ba6b1aada0",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„Einige werden bedroht, andere lehnen den Eingriff aus ethischen oder religiösen Gründen ab: Immer weniger Ärztinnen und Ärzte nehmen Schwangerschaftsabbrüche vor.“"
                                            },
                                            {
                                                "example_id": "fe7c5dbd-a1aa-4024-ae89-75dbb476d273",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„»Die Versorgungslage [Anmerkung: in Deutschland] zum Schwangerschaftsabbruch ist unterschiedlich von Stadt zu Stadt und von Land zu Land.«“"
                                            },
                                            {
                                                "example_id": "4e0b4a73-4910-47c7-b3bd-1892690237d3",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„Laut Statistischem Bundesamt wurden 2020 in der Altersgruppe der 18- bis 25-jährigen Frauen deutschlandweit insgesamt 23.575 Schwangerschaftsabbrüche registriert (Statistisches Bundesamt).“"
                                            },
                                            {
                                                "example_id": "23589875-87d7-4eab-b9da-c81f91c34a1d",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„Im 4. Quartal 2020 wurden laut dem Statistischen Bundesamt in Deutschland 24.153 Schwangerschaftsabbrüche vorgenommen.“"
                                            },
                                            {
                                                "example_id": "067cd502-bfa0-4ec7-aded-de2a51e0d6d9",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„Das Urteil des Landgerichts Gießen gegen die Ärztin Kristina Hänel wegen Werbung für Schwangerschaftsabbrüche ist aufgehoben worden.“"
                                            },
                                            {
                                                "example_id": "f7269a56-7c84-4796-b60d-e59270447f49",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„Der Grundsatzkonflikt und die Frage, ob Schwangerschaftsabbrüche im Strafgesetz geregelt werden sollten, schwelen bis heute weiter.“"
                                            },
                                            {
                                                "example_id": "dda07ccd-6140-424c-bfc1-a98720912117",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "Es gibt die Bewegung 40 Days for Life zum Beispiel, das sind fundamentalistische Christen, die vor den Beratungsstellen die Frauen versuchen, von einer Beratung zum Schwangerschaftsabbruch abzuhalten."
                                            },
                                            {
                                                "example_id": "104f01f6-5997-46b4-bfce-10327e1bdedb",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„FDP, Linke, Grüne und auch der Koalitionspartner SPD […] kritisierten den Bundesgesundheitsminister scharf für dessen Umgang mit dem Thema Schwangerschaftsabbruch.“"
                                            },
                                            {
                                                "example_id": "d3ee8f51-8b8e-4b0a-a250-995498fbf58f",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "„Im Juni kippte das Oberste Gericht in den USA das landesweit geltende Recht auf einen Schwangerschaftsabbruch.“"
                                            },
                                            {
                                                "example_id": "e2de3056-3f53-4ed3-8116-9e12dc967120",
                                                "sense_id": "e8fa0870-4f3e-3aaa-b081-1bf6d8d612ab",
                                                "text": "Ein medikamentöser Schwangerschaftsabbruch ist eine Alternative zu einer operativen Abtreibung"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c554115-74fd-42b1-b4c6-d9e75cb95054",
                        "source_entry_id": "3b8c86c2-0212-3f39-a8e4-7d72923f0c88",
                        "source_sense_id": "a5215fc9-36ee-3e9a-a0ee-fd2d799e9056",
                        "source_sense_description": "een voortijdige en kunstmatige beëindiging van een zwangerschap",
                        "target_lang_word": "abortion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abortion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b86ad9b-3ccb-3b83-958e-0016fdd3625d",
                                        "entry_id": "d1609287-16a9-31c6-8d18-7ab54f6475c9",
                                        "glosses": [
                                            "The expulsion from the womb of a foetus or embryo before it is fully developed, with loss of the foetus.",
                                            "A spontaneous abortion; a miscarriage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36d21a5-839c-4642-9c70-536078416559",
                                                "sense_id": "6b86ad9b-3ccb-3b83-958e-0016fdd3625d",
                                                "text": "Swines-bread, so used, doth not onely speed / A tardy labour; but (without great heed) / If over it a Child-great Woman stride, / Instant abortion often doth betide."
                                            },
                                            {
                                                "example_id": "839afb2e-9469-444f-a516-e591286228e2",
                                                "sense_id": "6b86ad9b-3ccb-3b83-958e-0016fdd3625d",
                                                "text": "At any time after impregnation, abortion may take place: it is one of the most common complaints of pregnancy, whence it is a matter of no small consequence that every practitioner should well understand it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e4b76e4-ed48-31a6-b86c-612862f8c8b8",
                                        "entry_id": "d1609287-16a9-31c6-8d18-7ab54f6475c9",
                                        "glosses": [
                                            "The expulsion from the womb of a foetus or embryo before it is fully developed, with loss of the foetus.",
                                            "An induced abortion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e976fc41-6e58-4e6d-ab4d-833bc49a2240",
                                                "sense_id": "3e4b76e4-ed48-31a6-b86c-612862f8c8b8",
                                                "text": "Mary decided to have an abortion because she was too young to raise a baby."
                                            },
                                            {
                                                "example_id": "cef98058-0339-491a-91cc-54a4215d61cc",
                                                "sense_id": "3e4b76e4-ed48-31a6-b86c-612862f8c8b8",
                                                "text": "It is impossible for an abortion clinic to have a waiting list of more than nine months."
                                            },
                                            {
                                                "example_id": "49ca8215-d6da-4437-b109-73b76449becd",
                                                "sense_id": "3e4b76e4-ed48-31a6-b86c-612862f8c8b8",
                                                "text": "The story of Ms. He and her mother began in the early 1960s, shortly before the Cultural Revolution shook China. Her young parents, who worked in a pottery factory in Rongchang in present-day Chongqing municipality, conceived her while unmarried. “They were told by the factory, ‘Have an abortion or be fired’,” she said. They chose to keep her and were fired."
                                            },
                                            {
                                                "example_id": "4ee335ae-4497-44a9-9eb9-f033646eddc3",
                                                "sense_id": "3e4b76e4-ed48-31a6-b86c-612862f8c8b8",
                                                "text": "Representative Tim Murphy of Pennsylvania will resign from Congress after claims that the anti-abortion Republican had urged a woman he was having an extramarital affair with to have an abortion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92040410-f67f-3d48-92e4-254954bb8928",
                                        "entry_id": "d1609287-16a9-31c6-8d18-7ab54f6475c9",
                                        "glosses": [
                                            "An aborted foetus; an abortus."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7b7cadd-eb03-4a6c-8980-c9b726e6132b",
                                                "sense_id": "92040410-f67f-3d48-92e4-254954bb8928",
                                                "text": "‘It seems too hairy for an abortion, and too small for a mature birth.’"
                                            },
                                            {
                                                "example_id": "2db01f21-e95c-4597-a91c-089d24e719b9",
                                                "sense_id": "92040410-f67f-3d48-92e4-254954bb8928",
                                                "text": "The Fascist poem, one may fear, will be a horrid little abortion such as one sees in a glass jar in the museum of some county town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f90ead-5f60-36de-b9c1-eb88b4629338",
                                        "entry_id": "d1609287-16a9-31c6-8d18-7ab54f6475c9",
                                        "glosses": [
                                            "A misshapen person or thing; a monstrosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7123105-32b5-4c2a-92e4-946be801dc83",
                                                "sense_id": "62f90ead-5f60-36de-b9c1-eb88b4629338",
                                                "text": "Insomuch that I do honestly believe, there can be no place in the world, where such intolerable abortions, begotten of the sculptor’s chisel, are to be found in such profusion, as in Rome."
                                            },
                                            {
                                                "example_id": "162a0684-81dc-4bb1-b55d-750aa486eb2b",
                                                "sense_id": "62f90ead-5f60-36de-b9c1-eb88b4629338",
                                                "text": "His voice was the most pitiable abortion of a voice I had ever heard."
                                            },
                                            {
                                                "example_id": "0d59f005-91d7-4292-a1ed-c0878e6aa0a8",
                                                "sense_id": "62f90ead-5f60-36de-b9c1-eb88b4629338",
                                                "text": "Dickey on his own manages to turn a simple bo diddley 1-2-3-4 into an absolute abortion of a song."
                                            },
                                            {
                                                "example_id": "ad0669c2-8bf0-4516-b067-280a512fa1a7",
                                                "sense_id": "62f90ead-5f60-36de-b9c1-eb88b4629338",
                                                "text": "an absolute abortion of a book"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f464095-3b89-30ec-8f23-8d5f518117d8",
                                        "entry_id": "d1609287-16a9-31c6-8d18-7ab54f6475c9",
                                        "glosses": [
                                            "Failure or abandonment of a project, promise, goal etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f9bc2a-2e79-4225-8b9b-a22a463c8e07",
                                                "sense_id": "1f464095-3b89-30ec-8f23-8d5f518117d8",
                                                "text": "The returning good sense of our country threatens abortion to their hopes, & they believe that any portion of power confided to me, will be exerted in opposition to their schemes."
                                            },
                                            {
                                                "example_id": "c52f0153-5b3c-46ad-b6f9-5ed182263a5c",
                                                "sense_id": "1f464095-3b89-30ec-8f23-8d5f518117d8",
                                                "text": "The transfer or loss of the project manager before the project is completed will result in lost continuity and delay or the abortion of the project and/or the report."
                                            },
                                            {
                                                "example_id": "b9a183a4-fec7-4a3d-9a5f-89ce74ccc217",
                                                "sense_id": "1f464095-3b89-30ec-8f23-8d5f518117d8",
                                                "text": "[…] the abrupt abortion of the trip after eleven days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4467ebb-262e-389d-8eb7-7b78ebed573d",
                                        "entry_id": "d1609287-16a9-31c6-8d18-7ab54f6475c9",
                                        "glosses": [
                                            "Arrest of development of any organ, so that it remains an imperfect formation or is absorbed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "802bdd83-382c-393b-85e8-6c539c4d45af",
                                        "entry_id": "d1609287-16a9-31c6-8d18-7ab54f6475c9",
                                        "glosses": [
                                            "The cessation of an illness or disease at a very early stage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "975c1539-8d7f-44cd-ae34-e6d37b5c9c02",
