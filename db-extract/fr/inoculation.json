                                "target_senses": [
                                    {
                                        "sense_id": "65771225-fc4c-3e6a-9796-39b0aebbb3e0",
                                        "entry_id": "dd4b2bf2-5af6-3c26-8033-c2510058a777",
                                        "glosses": [
                                            "The introduction of an antigenic substance or vaccine into the body to produce immunity to a specific disease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc3a46c-4dda-4989-9c76-433bfc4b8a58",
                                                "sense_id": "65771225-fc4c-3e6a-9796-39b0aebbb3e0",
                                                "text": "We owe, also, to Lady Mary the introduction of inoculation—the moral courage she displayed; the blessing conferred by her exertions may well silence the harsh judgment which suits so little with our narrow and finite intelligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db4eb34c-4f72-33f9-aaea-6ea4cf0b0121",
                                        "entry_id": "dd4b2bf2-5af6-3c26-8033-c2510058a777",
                                        "glosses": [
                                            "The introduction of a microorganism into a culture medium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
