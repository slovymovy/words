                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e69db6f-fcd0-4f9f-a7be-e4e9ace285aa",
                                "sense_id": "e5aa523d-35ad-3e28-b1be-b0bf12d39ef3",
                                "text": "„Pripjat war eine Stadt mit etwa 50 000 Einwohnern, in der auch die meisten Mitarbeiter des nur drei Kilometer entfernten Kernkraftwerks lebten.“"
                            },
                            {
                                "example_id": "e547a0be-47f3-4abc-b9ea-a64ac1eb89ea",
                                "sense_id": "e5aa523d-35ad-3e28-b1be-b0bf12d39ef3",
                                "text": "„Bereits ab 1970 entstand die Retortenstadt Pripjat in unmittelbarer Reaktornähe und beherbergte bis zur Katastrophe fünfzigtausend Einwohner.“"
                            }
                        ],
