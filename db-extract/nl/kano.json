                                        "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                        "entry_id": "d280d2e8-3025-3587-808f-22c1ed17d9d4",
                                        "glosses": [
                                            "Sportboot, das mit Paddeln bewegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f19b02-2074-4f5d-8fad-57387586095c",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "Viele Inseln wurden mit Kanus besiedelt."
                                            },
                                            {
                                                "example_id": "17965762-ef59-481c-aaa5-d29ff2a53155",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Die Beförderung der Handelswaren von den Kanus zum Lagerhaus im fünf Kilometer entfernten Jakin war Sache von Trägern, die nach Leistung bezahlt wurden.“"
                                            },
                                            {
                                                "example_id": "68b03fde-bfd6-4b10-b3c5-42188706360d",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Dazwischen zogen Tausende von braunen Kanus ihre Bahnen; die Mexica lebten im See und nicht an Land.“"
                                            },
                                            {
                                                "example_id": "b2ee3548-1ff3-4a95-ad27-65116ff47826",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Es waren Männer in Kanus erschienen und hatten auf Muschelhörnern geblasen.“"
                                            },
                                            {
                                                "example_id": "fa446be2-b3bd-4038-9cf7-7032853bbf87",
                                                "sense_id": "c9588dba-4dc2-3439-96ff-772e5e3a7a28",
                                                "text": "„Als wir wieder an Bord des Schoners zurückkehrten, fanden wir ein Kanu, das quer vor den Bug getrieben und festgemacht worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94195676-ea79-4254-b1ae-3f11d8043301",
                        "source_entry_id": "d0ff27bd-7cf5-3e91-986c-3b4069a1e1ec",
