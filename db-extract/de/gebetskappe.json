                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97a81c5-fae9-4610-8231-512b09c97996",
                                "sense_id": "df46ca7c-9036-3391-8d4a-8412e8bec770",
                                "text": "„Auf dem Kopf trug er eine gestrickte Gebetskappe aus weißer Wolle.“"
                            },
                            {
                                "example_id": "b962b810-bd27-4147-a7ee-20a6e43f7e21",
                                "sense_id": "df46ca7c-9036-3391-8d4a-8412e8bec770",
                                "text": "„Beide trugen einfache, westliche Kleidung und Gebetskappen.“"
                            },
                            {
                                "example_id": "108e9334-4c7d-476c-8424-3552541d1a60",
                                "sense_id": "df46ca7c-9036-3391-8d4a-8412e8bec770",
                                "text": "„Der Fahrer trug eine gestrickte Gebetskappe, wie viele andere in dieser strenggläubigen Stadt, und hatte einen Koran auf dem Armaturenbrett liegen.“"
                            }
                        ],
