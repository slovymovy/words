                "senses": [
                    {
                        "sense_id": "ee20e60f-9563-3d73-a668-fe9d9ad8ca00",
                        "entry_id": "a42f6939-107e-3e1e-8f77-1b6a685ae5da",
                        "glosses": [
                            "Schul- oder Ausbildungsveranstaltung, die für Berufstätige konzipiert ist, daher in den Abendstunden stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66cf389e-1318-47a5-ae45-cd54eb3783b1",
                                "sense_id": "ee20e60f-9563-3d73-a668-fe9d9ad8ca00",
                                "text": "„Ein Abendlehrgang in der Flugschule Jesewang einschließlich Verwaltungsgebühren, Unterrichtskosten und Flugstunden liegt bei rund 11.700 Mark.“"
                            },
                            {
                                "example_id": "8070b030-c1a4-4993-8dfb-194d5f5380a0",
                                "sense_id": "ee20e60f-9563-3d73-a668-fe9d9ad8ca00",
                                "text": "„Die sogenannte Erweiterte Oberschule, eine Zwölfjahres-Schule, führt zum Abitur, das außerdem über Berufsschulen, Betriebs- und Dorfakademien sowie (für Erwachsene) über Volkshochschulen und Abendlehrgänge erreicht werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
