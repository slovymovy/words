                ],
                "senses": [
                    {
                        "sense_id": "55d96978-c972-3bb2-897a-d2ac63395df8",
                        "entry_id": "5b003a8b-d740-3637-a2a4-668b1b0ca930",
                        "glosses": [
                            "Teilordnung der Fliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f170200-5f21-4804-8cf2-d9491a689c0d",
                                "sense_id": "55d96978-c972-3bb2-897a-d2ac63395df8",
                                "text": "„Diese und die nächste Unterordnung bilden eine natürliche Gruppe der Zweiflügler, die man als Spaltschlüpfer, Orthorrapha, bezeichnet.“"
                            },
                            {
                                "example_id": "931b57d6-a5ac-4fb5-95b2-3c06e054c9d5",
                                "sense_id": "55d96978-c972-3bb2-897a-d2ac63395df8",
                                "text": "„Die zweite Abteilung der Spaltschlüpfer mit Mumienpuppen bilden die Kurzhörner (Brachycera), zu der ein Teil der Fliegen gehört.“"
                            },
                            {
                                "example_id": "c2340376-81a9-40bb-95b9-d487fa57a726",
                                "sense_id": "55d96978-c972-3bb2-897a-d2ac63395df8",
                                "text": "„Die Dipteren teilt man in zwei Hauptgruppen ein, jene der Spaltschlüpfer oder Orthorrhapha und jene der Deckelschlüpfer oder Cyclorrapha.“"
                            },
                            {
                                "example_id": "f25f78e7-f29d-4a9e-b756-a9d1fb9f9092",
                                "sense_id": "55d96978-c972-3bb2-897a-d2ac63395df8",
                                "text": "„Waffenfliegen, Stratiomyidae, eine Fam. der Spaltschlüpfer, große Tiere mit breitem Hinterleib und Dornen auf dem Brustabschnitt.“"
                            },
                            {
                                "example_id": "473e3b68-f55d-42ab-9f09-f5c10066d36c",
                                "sense_id": "55d96978-c972-3bb2-897a-d2ac63395df8",
                                "text": "„Zwar sind alle Mücken Spaltschlüpfer, aber ebenso nicht wenige Fliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
