                    {
                        "translation_id": "560c0f75-5816-46a9-b48e-bf4a95f9808e",
                        "source_entry_id": "cee14047-6da0-3da9-b670-d7413bf270b0",
                        "source_sense_description": "The human faculty or power to mentally grasp or understand clearly",
                        "target_lang_word": "Auffassungsgabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auffassungsgabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f0203c2-ea81-311b-b070-a2e9fbdf3629",
                                        "entry_id": "4f61767a-e46e-3c66-a6b2-2e1bd71f54f8",
                                        "glosses": [
                                            "Fähigkeit, etwas zu erfassen und geistig zu verarbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bada63ec-096c-4cba-b7b8-236b429baa72",
                                                "sense_id": "8f0203c2-ea81-311b-b070-a2e9fbdf3629",
                                                "text": "Er hat eine große Auffassungsgabe."
                                            },
                                            {
                                                "example_id": "b12aae0a-b711-46b5-925c-418368c5cee3",
                                                "sense_id": "8f0203c2-ea81-311b-b070-a2e9fbdf3629",
                                                "text": "Dieser Organismus hat eine niedrige Auffassungsgabe."
                                            },
                                            {
                                                "example_id": "5be53af0-e01d-4fa7-9b38-c4da378b2fb6",
                                                "sense_id": "8f0203c2-ea81-311b-b070-a2e9fbdf3629",
                                                "text": "„Wie John feststellte, waren seine beiden Schüler ungefähr gleich begabt, nur besaß Jako eine etwas bessere Auffassungsgabe als sein Mitschüler.“"
                                            },
                                            {
                                                "example_id": "4d19ea4c-333e-40d1-8ec5-b5934988551e",
                                                "sense_id": "8f0203c2-ea81-311b-b070-a2e9fbdf3629",
                                                "text": "„Der 1542 geborene Akbar war äußerst wissbegierig, beherrschte das Kriegshandwerk, besaß Mut und eine rasche Auffassungsgabe.“"
                                            },
                                            {
                                                "example_id": "3427ed43-dd56-40a9-88f3-54452ec534dc",
                                                "sense_id": "8f0203c2-ea81-311b-b070-a2e9fbdf3629",
                                                "text": "„Und diese Tränen, deren Ursache die kleine Fürstin nicht begriff, liess sie unruhig werden, so wenig Beobachtungs- und Auffassungsgabe sie sonst auch hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a46b54b-abca-48c8-be2a-cbbc2c9709a9",
