                "senses": [
                    {
                        "sense_id": "f098434f-6da6-3850-b732-8696231b2fa5",
                        "entry_id": "3973ec8c-fafc-30bd-9311-b804365bf0f6",
                        "glosses": [
                            "Schriftstück, in dem die Verwendung eines bestimmten Gegenstands erläutert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa7157d-8ece-407d-82d7-888900a8777c",
                                "sense_id": "f098434f-6da6-3850-b732-8696231b2fa5",
                                "text": "„In einer Gebrauchsanleitung für eine Luftmatratze heißt es: „Wenn das Wetter kalt ist, wird die Puff Unterlage sich langsam puffen.“"
                            },
                            {
                                "example_id": "93467687-202e-4655-9788-11ff9352c2e3",
                                "sense_id": "f098434f-6da6-3850-b732-8696231b2fa5",
                                "text": "„Damit Schneeketten auch richtig montiert werden, ist eine entsprechende Gebrauchsanleitung beizulegen.“"
                            },
                            {
                                "example_id": "316f1817-8079-4932-9b6e-18f65a70ee76",
                                "sense_id": "f098434f-6da6-3850-b732-8696231b2fa5",
                                "text": "„Der sichere Umgang mit Feuerwerk setzt zunächst einmal voraus, dass die Gebrauchsanleitung gelesen wird - und das sollte nicht erst kurz vor Mitternacht geschehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
