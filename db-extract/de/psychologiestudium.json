                "senses": [
                    {
                        "sense_id": "5ecd0c26-d61c-352c-8ac9-c99f06ca3626",
                        "entry_id": "ab688388-0a98-314a-99a0-30865a3b57da",
                        "glosses": [
                            "Studium der Psychologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f85a6b4-13c6-45b9-a7c7-e6921d19a9ba",
                                "sense_id": "5ecd0c26-d61c-352c-8ac9-c99f06ca3626",
                                "text": "„Interessenten sollten aber bedenken, dass ein Psychologiestudium mit besonders hohen Anforderungen verbunden ist.“"
                            },
                            {
                                "example_id": "8cfd4af8-f4cb-4976-96fe-ce6d6ebdb10c",
                                "sense_id": "5ecd0c26-d61c-352c-8ac9-c99f06ca3626",
                                "text": "„Nahezu alle deutschen Universitäten haben das Psychologiestudium mittlerweile auf das Bachelor-/Mastersystem umgestellt.“"
                            },
                            {
                                "example_id": "565a45d1-3108-41b3-9746-438fdc6a55df",
                                "sense_id": "5ecd0c26-d61c-352c-8ac9-c99f06ca3626",
                                "text": "„Wer ein Psychologiestudium an einer Universität beginnen möchte, braucht das Abitur.“"
                            },
                            {
                                "example_id": "0c50bea1-2fc1-4c72-adb8-96eb0dccbcee",
                                "sense_id": "5ecd0c26-d61c-352c-8ac9-c99f06ca3626",
                                "text": "„Als Schülerin demonstrierte ich gegen den Golfkrieg, während meines Psychologiestudiums probte ich mit Häftlingen ein Theaterstück.“"
                            },
                            {
                                "example_id": "793612dc-dcd1-40fb-a835-ccef5e09a5b9",
                                "sense_id": "5ecd0c26-d61c-352c-8ac9-c99f06ca3626",
                                "text": "„Dafür reichten die zwei Jahre Psychologiestudium aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
