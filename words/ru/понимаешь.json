    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26bd1301-e994-3718-aa7c-cbc3a95da3c7",
                    "sense_definition": "форма настоящего времени второго лица единственного числа глагола <w>понимать</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты хорошо <w>понимаешь</w> правила этой игры?",
                            "target_lang_translations": {
                                "de": "Verstehst du die Regeln dieses Spiels gut?"
                            }
                        },
                        {
                            "text": "Почему ты меня не <w>понимаешь</w>?",
                            "target_lang_translations": {
                                "de": "Warum verstehst du mich nicht?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "глагольная форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Präsensform der zweiten Person Singular des Verbs verstehen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verstehst",
                                "target_lang_sense_clarification": "kognitive Erfassung von Informationen oder Inhalten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a7129181-c958-33d7-9190-096a75abd883",
                    "sense_definition": "вводное слово, используемое для привлечения внимания собеседника и придания речи доверительного тона",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conversational_particles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это очень важно, <w>понимаешь</w>, я не могу просто так уйти.",
                            "target_lang_translations": {
                                "de": "Das ist sehr wichtig, <w>verstehst du</w>, ich kann nicht einfach so gehen."
                            }
                        },
                        {
                            "text": "Мы тогда были молодыми, <w>понимаешь</w>, всё казалось таким простым.",
                            "target_lang_translations": {
                                "de": "Wir waren damals jung, <w>weißt du</w>, alles schien so einfach."
                            }
                        }
                    ],
                    "synonyms": [
                        "понимаете",
                        "видишь ли",
                        "понимаешь ли"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einschubwort, um die Aufmerksamkeit des Gesprächspartners zu gewinnen oder einen vertraulichen Ton zu erzeugen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verstehst du",
                                "target_lang_sense_clarification": "als rhetorische Frage oder Einschub zur Bestätigung"
                            },
                            {
                                "target_lang_word": "weißt du",
                                "target_lang_sense_clarification": "um eine Erklärung einzuleiten oder Verständnis zu suchen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "386abc68-a0a2-306b-9a51-35a31f3f95dd",
                    "sense_definition": "вводное слово, выражающее иронию, возмущение или недовольство ситуацией",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conversational_particles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они решили отдохнуть, <w>понимаешь</w>, а всю работу оставили мне.",
                            "target_lang_translations": {
                                "de": "Sie haben beschlossen, sich auszuruhen, <w>stell dir vor</w>, und haben die ganze Arbeit mir überlassen."
                            }
                        },
                        {
                            "text": "Наш сосед купил машину, <w>понимаешь</w>, теперь паркуется прямо на газоне.",
                            "target_lang_translations": {
                                "de": "Unser Nachbar hat sich ein Auto gekauft, <w>man muss sich das mal vorstellen</w>, jetzt parkt er direkt auf dem Rasen."
                            }
                        }
                    ],
                    "synonyms": [
                        "понимаете",
                        "видите ли",
                        "понимаете ли"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einschubwort, das Ironie, Empörung oder Unmut über eine Situation ausdrückt"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "stell dir vor",
                                "target_lang_sense_clarification": "um Empörung über eine unerhörte Situation auszudrücken"
                            },
                            {
                                "target_lang_word": "man muss sich das mal vorstellen",
                                "target_lang_sense_clarification": "um die Absurdität oder Unverschämtheit einer Situation zu betonen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
