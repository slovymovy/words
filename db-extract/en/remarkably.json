                        "sense_id": "aa7d6255-3459-3c7d-af59-385838d96c9d",
                        "entry_id": "c85e7c31-c7c2-399b-b08d-77413b294efe",
                        "glosses": [
                            "In a remarkable manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29575502-5aaf-44d2-b058-c68f8a68a4c5",
                                "sense_id": "aa7d6255-3459-3c7d-af59-385838d96c9d",
                                "text": "He performed the piece remarkably, offering novel interpretations to its nearly cliched passages."
                            }
                        ]
                    },
                    {
                        "sense_id": "834b005e-efb0-3756-a043-1e7c1ae73f37",
                        "entry_id": "c85e7c31-c7c2-399b-b08d-77413b294efe",
                        "glosses": [
                            "To a noteworthy extent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25cd10b1-987f-459c-87e1-380492ff6051",
                                "sense_id": "834b005e-efb0-3756-a043-1e7c1ae73f37",
                                "text": "That dog is remarkably fierce."
                            },
                            {
                                "example_id": "b5d2fbd6-f9dd-464a-a1ff-4d1e6c90b969",
                                "sense_id": "834b005e-efb0-3756-a043-1e7c1ae73f37",
                                "text": "Suggestions that those leaders are irrational and their decisions unfathomable are remarkably shallow. North Korea is not a theocracy led by zealots who preach the rewards of the afterlife."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ad237d1-2f62-39a1-bafd-663656c249d6",
                        "entry_id": "c85e7c31-c7c2-399b-b08d-77413b294efe",
                        "glosses": [
                            "Used to draw special attention to a proposition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ab97f5-b2c4-4f85-9875-a0a505d4dbd0",
                                "sense_id": "8ad237d1-2f62-39a1-bafd-663656c249d6",
                                "text": "Remarkably, three State assembly elections were decided by a total of fewer than one hundred votes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55697d0e-c3d7-4626-a7cf-eb1d203a294b",
                        "source_entry_id": "c85e7c31-c7c2-399b-b08d-77413b294efe",
                        "source_sense_description": "in a remarkable manner",
                        "target_lang_word": "opmerkelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opmerkelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                                        "entry_id": "b52eb207-2485-3069-a504-d0fbb6c473ce",
                                        "glosses": [
                                            "bijzonder genoeg om opgemerkt te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d108c99-9143-442a-9124-69a1ac7780fe",
                                                "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                                                "text": "Is dat echt zoiets opmerkelijks?"
                                            },
                                            {
                                                "example_id": "b6095f45-4d2b-43d3-970c-a10bdddf0860",
                                                "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                                                "text": "Bijna vijftig jaar later zijn er opmerkelijk veel mensen die dat gevoel van toen willen beleven en als urban hippies naar muziekfestivals gaan."
                                            },
                                            {
                                                "example_id": "6b1a4cbd-7dc6-4fa5-8c1d-eb006e94804e",
                                                "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                                                "text": "Na het eten had ze een opmerkelijke gewoonte om een Snicker naast haar hoofd te leggen voor als ze in de nacht een vreetkick kreeg vanwege haar joint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a42ccdcd-fce9-4673-ae08-867a0e1e8d45",
                        "source_entry_id": "c85e7c31-c7c2-399b-b08d-77413b294efe",
                        "source_sense_description": "in a remarkable manner",
                        "target_lang_word": "remarquablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
