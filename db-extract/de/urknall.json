                                    {
                                        "sense_id": "1dc3d922-441d-3ca0-9776-26d67c7935ea",
                                        "entry_id": "17988ac1-00f9-3ef7-bc49-0896b4449687",
                                        "glosses": [
                                            "The cosmic event that marks the beginning of time and the rapid expansion of space for the visible universe. The evolution of the universe since that beginning point is described by the Big Bang Theory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "577e95ca-c593-41c6-b1e4-a0ecac80716f",
                                                "sense_id": "1dc3d922-441d-3ca0-9776-26d67c7935ea",
                                                "text": "On scientific grounds this big bang assumption is much less the palatable of the two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d95c70ad-fd1f-35bb-9048-b1767a9bcc34",
                                        "entry_id": "17988ac1-00f9-3ef7-bc49-0896b4449687",
                                        "glosses": [
                                            "The sudden deregulation of financial markets effected by prime minister Margaret Thatcher in 1986."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
