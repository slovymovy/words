                "senses": [
                    {
                        "sense_id": "a23b0ce1-e290-3e62-958d-df148408ac87",
                        "entry_id": "7845a34e-6c3f-3bfb-9acb-d8bb8073b998",
                        "glosses": [
                            "Raumteil für Gemüse und Obst in einem Kühlschrank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "179c632f-4b4a-4a7d-a5f8-106256e3b834",
                                "sense_id": "a23b0ce1-e290-3e62-958d-df148408ac87",
                                "text": "In den meisten Kühlschränken befindet sich im unteren Teil eine Gemüseschale."
                            },
                            {
                                "example_id": "47cbed05-1958-4d5a-8d2e-f5e0ab26e3c9",
                                "sense_id": "a23b0ce1-e290-3e62-958d-df148408ac87",
                                "text": "Beim Putzen ihres Kühlschrankes erlebte Waltraud Weber eine Überraschung: In der Gemüseschale fand sie zwei Paprika wieder, schon Wochen alt, aber immer noch frisch und knackig wie kurz nach der Ernte."
                            },
                            {
                                "example_id": "8e0b9423-d979-4216-aa86-869c84690124",
                                "sense_id": "a23b0ce1-e290-3e62-958d-df148408ac87",
                                "text": "Wirsing hat einen recht ausgeprägten Eigengeschmack und verträgt kräftige Gewürze wie z. B. schwarzen Pfeffer aus der Mühle oder auch Kümmel. Ein frischer Kopf hält sich in der Gemüseschale des Kühlschranks bis zu sechs Tage. Wer das Optimale herausholen will, kauft ihn aber trotzdem lieber erst am Tag der Zubereitung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c0d7de6-47ea-3f5b-b64f-c82acfac8802",
                        "entry_id": "7845a34e-6c3f-3bfb-9acb-d8bb8073b998",
                        "glosses": [
                            "ein Gemüse umgebende Hülle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f5d3926-4172-4041-ae3d-ec944cb2b27e",
                                "sense_id": "8c0d7de6-47ea-3f5b-b64f-c82acfac8802",
                                "text": "Vor ihm türmen sich Teller mit Soßenklecksen und Häufchen von Gemüseschalen, Brotkrümel, wohin man sieht."
                            },
                            {
                                "example_id": "4548e0d3-d977-4e46-bc44-b335eb0f51ed",
                                "sense_id": "8c0d7de6-47ea-3f5b-b64f-c82acfac8802",
                                "text": "Seit Juli gab er einmal in der Woche eine kleine Schaufel ungelöschten Kalk über die Essensreste und Gemüseschalen."
                            },
                            {
                                "example_id": "a3a5540e-9c60-4486-a0ac-8d3779ba99b2",
                                "sense_id": "8c0d7de6-47ea-3f5b-b64f-c82acfac8802",
                                "text": "Feuchte Abfälle in der Restmülltonne vermeidet man auch, wenn organische Küchenabfälle (vor dem Kochtopf) wie Obst- und Gemüseschalen, Kaffeefilter usw. kompostiert werden."
                            },
                            {
                                "example_id": "fe9517cd-ada7-465a-9e42-fd710b2a9c41",
                                "sense_id": "8c0d7de6-47ea-3f5b-b64f-c82acfac8802",
                                "text": "Das liegt an Kneipen und gutem Essen, für das sich der Schwabe Schlauch erwärmt, während Fischer nach seiner Hungerkur nur noch Selterswasser bevorzugt und lustlos in Gemüseschalen herumstochert."
                            },
                            {
                                "example_id": "585fbf6d-bfcb-446f-8e77-1fd25b76c8f5",
                                "sense_id": "8c0d7de6-47ea-3f5b-b64f-c82acfac8802",
                                "text": "Als die Kölnerin ihre Vorlagen zusammen hatte, bot sie sie dem Mainzer Verlag an. Dieser griff nach Überprüfung wirtschaftlicher Aspekte zu und präsentierte zur Buchmesse im Oktober den Verfalls-Kalender 1999. Verpackt war er typgerecht in einer giftgrünen Gemüseschale, ganz so, als handele es sich um ein Pfund Chicoree."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
