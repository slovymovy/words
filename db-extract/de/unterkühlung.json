                                "target_senses": [
                                    {
                                        "sense_id": "c0f87e43-d800-3c0c-8b50-f7e7a652f4c6",
                                        "entry_id": "84bccfd4-1f50-3e0c-94e7-042418565750",
                                        "glosses": [
                                            "État métastable d’une matière qui demeure en phase liquide alors que sa température est plus basse que son point de solidification."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c46e9fee-d2cc-4588-a5a7-324cd491eff3",
                                                "sense_id": "c0f87e43-d800-3c0c-8b50-f7e7a652f4c6",
                                                "text": "Tout se passe comme si l’eau qui est à la base de toute la vie végétale, animale, et on peut ajouter minérale de la Terre, se trouvait en état de surfusion et retrouvait brusquement son équilibre au contact de l’eau drue."
                                            },
                                            {
                                                "example_id": "43f5b9f1-a958-4db4-ad3e-30ff560bf9cb",
                                                "sense_id": "c0f87e43-d800-3c0c-8b50-f7e7a652f4c6",
                                                "text": "Dans un lac en surfusion, il suffit d’une turbulence hasardeuse à un endroit pour que quelques molécules se cristallisent. S’il y en a suffisamment ça forme un germe stable qui se propage ensuite très rapidement dans tout le lac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
