                "senses": [
                    {
                        "sense_id": "6d6b0a2a-3343-3444-8e85-7c905c5da0ee",
                        "entry_id": "08c190b8-370a-326f-9db4-917a8091149d",
                        "glosses": [
                            "A tumult or disturbance."
                        ],
                        "tags": [
                            "Scotland",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "b182eaa1-f02e-48ae-badb-a931758dfa1f",
                                "sense_id": "6d6b0a2a-3343-3444-8e85-7c905c5da0ee",
                                "text": "This stramash was the first time that I had interposed in the family concerns of my people, for it was against my nature to make or meddle with private actions, saving only such as, in course of nature, came before the Session[…]"
                            },
                            {
                                "example_id": "e3117918-2b9c-4e3f-a717-c5af4172e313",
                                "sense_id": "6d6b0a2a-3343-3444-8e85-7c905c5da0ee",
                                "text": "Then more calling, and bawling,\nAnd squalling, and falling,\nOh! what a fearful stramash they are all in!"
                            },
                            {
                                "example_id": "a6ef1c00-cf0c-4de9-93e1-88c75f950f66",
                                "sense_id": "6d6b0a2a-3343-3444-8e85-7c905c5da0ee",
                                "text": "Last year, I […] had a noble stramash on Folly Bridge. That is the last fighting I have seen."
                            },
                            {
                                "example_id": "af931125-75e0-40b4-b37d-f97d3ee8cd0c",
                                "sense_id": "6d6b0a2a-3343-3444-8e85-7c905c5da0ee",
                                "text": "The Muscular Christians rebelled at these ideas with a stir and stramash audible to all men."
                            }
                        ]
                    }
                ],
