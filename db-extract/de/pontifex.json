                ],
                "senses": [
                    {
                        "sense_id": "aaa68f96-6165-3042-a518-3e82a8e2bf90",
                        "entry_id": "b6dcd4c9-bb46-32f1-91ea-159c7155fc34",
                        "glosses": [
                            "Priester, Oberpriester im antiken Rom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce266c61-5eb3-4d1a-9c50-67997b194a5d",
                                "sense_id": "aaa68f96-6165-3042-a518-3e82a8e2bf90",
                                "text": "„Ursprünglich bestand das Kollegium der Pontifices wohl aus 5, später aus 15 Mitgliedern.“"
                            },
                            {
                                "example_id": "83ecc56e-0987-403c-9824-03e3043e44ff",
                                "sense_id": "aaa68f96-6165-3042-a518-3e82a8e2bf90",
                                "text": "„Gleichzeitig wird er in das Kollegium der Pontifices aufgenommen, das über die sakralen Dienste wacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "119e9820-d979-332c-948c-138c1577a336",
                        "entry_id": "b6dcd4c9-bb46-32f1-91ea-159c7155fc34",
                        "glosses": [
                            "Pontifex maximus; Papst"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "a29be5ea-1dd8-4ed7-899c-e8f67c0ae031",
                                "sense_id": "119e9820-d979-332c-948c-138c1577a336",
                                "text": "„Dahinter kommt dann der Pontifex mit seinen engsten Beratern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e920072c-9d7b-4bbf-b371-b9194e44021f",
                        "source_entry_id": "b6dcd4c9-bb46-32f1-91ea-159c7155fc34",
                        "source_sense_id": "aaa68f96-6165-3042-a518-3e82a8e2bf90",
                        "source_sense_description": "Priester, Oberpriester im antiken Rom",
                        "target_lang_word": "pontifex",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pontifex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c50b13e2-24a1-3808-b64c-c60766d824ee",
                                        "entry_id": "df2b7f6d-6b86-3c5d-8e55-3d78b24e4916",
                                        "glosses": [
                                            "A pontiff, state minister, or high priest, in Ancient Rome."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e8e3056-f0d4-448a-840f-bcedba873213",
                                                "sense_id": "c50b13e2-24a1-3808-b64c-c60766d824ee",
                                                "text": "Every traditional civilization is characterized by the presence of beings who […] embody within the temporal order the living and efficacious presence of a power that comes from above. One of these types of beings is the pontifex, according to the inner meaning of the word and according to the original value of the function that he exercised."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "187fd17c-9019-4632-92d2-9737100d683a",
                        "source_entry_id": "b6dcd4c9-bb46-32f1-91ea-159c7155fc34",
                        "source_sense_id": "aaa68f96-6165-3042-a518-3e82a8e2bf90",
                        "source_sense_description": "Priester, Oberpriester im antiken Rom",
                        "target_lang_word": "pontife",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pontife",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c58eb3a1-d238-3103-baf9-bdd3a602e18b",
                                        "entry_id": "69064a8a-7e68-3fb3-9bf7-00a86f379cfc",
                                        "glosses": [
                                            "Personne revêtue d’un ministère sacré ; ministre d’une religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e66b33-56f9-49a4-b4e4-c92f060ed246",
                                                "sense_id": "c58eb3a1-d238-3103-baf9-bdd3a602e18b",
                                                "text": "Jules II, d'un naturel violent et emporté, réussit dans toutes ses entreprises, sans doute parce que les circonstances dans lesquelles ce pontife gouvernait l'Église demandaient un prince de ce caractère."
                                            },
                                            {
                                                "example_id": "fce6fc5b-db9e-4f9b-a542-5e12f7c01868",
                                                "sense_id": "c58eb3a1-d238-3103-baf9-bdd3a602e18b",
                                                "text": "Enfin le prince mongol résolut d'inviter le suprême pontife, le grand lama, Bouddha en personne, à se rendre dans ses états."
                                            },
                                            {
                                                "example_id": "661589c5-b5cc-4958-9fa8-d0e1ccd856a7",
                                                "sense_id": "c58eb3a1-d238-3103-baf9-bdd3a602e18b",
                                                "text": "Ils célébrèrent le 20 prairial (8 juin) la fête de l’Être suprême. Robespierre, président de la Convention, servit de pontife à cette fête."
                                            },
                                            {
                                                "example_id": "cb7bcb62-b2a4-4c3d-bbde-431fbae0f21d",
                                                "sense_id": "c58eb3a1-d238-3103-baf9-bdd3a602e18b",
                                                "text": "Voilà le cardinal de Noailles et l'engeance quenelliste écrasés sous les pieds du plus grand pontife qui ait paru sur la chaire de Rome."
                                            },
                                            {
                                                "example_id": "fb2f6603-34ea-4961-92db-4abf30832066",
                                                "sense_id": "c58eb3a1-d238-3103-baf9-bdd3a602e18b",
                                                "text": "Michel Maillé noterait que le mot pontife, pontifex en latin, veut dire faiseur de pont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c07b3e-5a34-35a7-ba51-6e9aacb1772c",
                                        "entry_id": "69064a8a-7e68-3fb3-9bf7-00a86f379cfc",
                                        "glosses": [
                                            "Tout ecclésiastique, sans égard à son rang dans la hiérarchie générale."
                                        ],
                                        "tags": [
                                            "Dans le style oratoire ou poétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7851ceb0-29a3-4485-8a6f-f09d27e97edc",
                                                "sense_id": "e9c07b3e-5a34-35a7-ba51-6e9aacb1772c",
                                                "text": "Le trafic des indulgences, qui devenait toujours plus intolérable, ne causa pas moins de préjudice à la cour romaine. Les pontifes français […] dispensèrent, à un prix excessif, toutes sortes de permissions scandaleuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909755a5-711e-3cd9-9dc7-59bf1b94acbe",
                                        "entry_id": "69064a8a-7e68-3fb3-9bf7-00a86f379cfc",
                                        "glosses": [
                                            "Personne qui a des manières, un ton solennel et emphatique."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ecb7beb-bc46-4c91-a4d5-0a8ce0883dca",
                                                "sense_id": "909755a5-711e-3cd9-9dc7-59bf1b94acbe",
                                                "text": "Dès que Dieu et les pontifes de l’économie politique interviennent, on peut être assuré que l’injustice et l’inégalité prévalent."
                                            },
                                            {
                                                "example_id": "b023b225-242a-40d4-a8e9-b3f2d46a3b9a",
                                                "sense_id": "909755a5-711e-3cd9-9dc7-59bf1b94acbe",
                                                "text": "Le beau raisonnement de ces messieurs, des pontifes du devoir social, suppose que la violence ne pourra plus augmenter, […]. Malheureusement pour ces grands penseurs, les choses se passent tout autrement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "128f4671-a6f4-4b31-b635-495b79099b88",
