{
    "word_family": [
        "gedaanteverwisseling",
        "gedaanteloos"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebaca722-51c5-3e3b-b647-4dc0dc732e98",
                    "sense_definition": "de uiterlijke vorm of verschijning van iets of iemand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wolken namen langzaam de <w>gedaante</w> van een groot kasteel aan.",
                            "target_lang_translations": {
                                "en": "The clouds slowly took on the <w>shape</w> of a large castle."
                            }
                        },
                        {
                            "text": "In het sprookje verandert de prins van <w>gedaante</w> na een kus.",
                            "target_lang_translations": {
                                "en": "In the fairy tale, the prince changes <w>form</w> after a kiss."
                            }
                        }
                    ],
                    "synonyms": [
                        "uiterlijk",
                        "verschijning",
                        "vorm"
                    ],
                    "common_phrases": [
                        "van gedaante veranderen",
                        "een andere gedaante aannemen"
                    ],
                    "target_lang_definitions": {
                        "en": "the outward form or appearance of something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "form",
                                "target_lang_sense_clarification": "the visible structure or appearance of something"
                            },
                            {
                                "target_lang_word": "shape",
                                "target_lang_sense_clarification": "the external boundary or outline of an object"
                            },
                            {
                                "target_lang_word": "appearance",
                                "target_lang_sense_clarification": "the way that someone or something looks"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b2d9edf-5174-3228-a6f1-b380382fbfaf",
                    "sense_definition": "de gestalte of het figuur van een mens, vaak gezien van een afstand of in het onduidelijke",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "menselijk_figuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de dichte mist zag ik plotseling een donkere <w>gedaante</w> op de weg staan.",
                            "target_lang_translations": {
                                "en": "In the thick mist, I suddenly saw a dark <w>figure</w> standing on the road."
                            }
                        },
                        {
                            "text": "De frêle <w>gedaante</w> van de vrouw bewoog zich geruisloos door de kamer.",
                            "target_lang_translations": {
                                "en": "The woman's frail <w>figure</w> moved noiselessly through the room."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een duistere gedaante",
                        "een slanke gedaante"
                    ],
                    "target_lang_definitions": {
                        "en": "the stature or figure of a person, often seen from a distance or in the dark"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "figure",
                                "target_lang_sense_clarification": "the shape of a human body, especially when seen indistinctly"
                            },
                            {
                                "target_lang_word": "shape",
                                "target_lang_sense_clarification": "an indistinct form of a person or object"
                            },
                            {
                                "target_lang_word": "silhouette",
                                "target_lang_sense_clarification": "the dark shape and outline of someone visible against a lighter background"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}