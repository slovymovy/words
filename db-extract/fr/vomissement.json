                                "target_senses": [
                                    {
                                        "sense_id": "87a838d8-72c3-34b1-8823-ffffc695cd4f",
                                        "entry_id": "b1efe698-34c8-350f-b145-72af3dab8896",
                                        "glosses": [
                                            "Entleerung des Mageninhalts über den Mund"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
