                        "entry_id": "9e5de392-28b3-32e0-8b96-101236f500fe",
                        "glosses": [
                            "A foreigner, especially a British or a white person."
                        ],
                        "tags": [
                            "British",
                            "India",
                            "South-Asia"
                        ],
                        "examples": [
                            {
                                "example_id": "5fb16634-3f2d-4ded-8522-8f44f931b934",
                                "sense_id": "f7a892ca-786b-39ba-885c-7aded85d4296",
                                "text": "Prem, who knew him slightly from Dehra Dun (where Dhillon had been his junior), remembers Dhillon cheerfully telling everyone that the firangi were glad to have Indians patrolling their wire. This Prem doubted."
                            },
                            {
                                "example_id": "20a4ae85-3d47-4db0-856c-797bba098e3e",
                                "sense_id": "f7a892ca-786b-39ba-885c-7aded85d4296",
                                "text": "Then Kashibayi cleared her throat and told him, \"Maharaj, our Babasaheb Sarkar was a very patriotic king who fought against the firangi fellows. He was betrayed by his own people who were shamelessly treacherous.\""
                            },
                            {
                                "example_id": "1c98731d-73cc-417b-80d6-356f2047a5a7",
                                "sense_id": "f7a892ca-786b-39ba-885c-7aded85d4296",
                                "text": "The neighbouring men had all come to see the firangi, the foreign woman, [...]"
                            }
                        ]
                    }
