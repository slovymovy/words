                                        "entry_id": "3ad38c31-2a1c-3fe6-a16d-cd2f6b3511de",
                                        "glosses": [
                                            "Of, pertaining to, or suitable for childbirth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a4f17ca-b321-4f9f-8192-7ada6309ae79",
                                                "sense_id": "d4eb6c6d-271d-3677-a7e5-1567bf2801ec",
                                                "text": "Women in the latter stages of childbearing should not be permitted to attend the toll of the manufactories."
                                            },
                                            {
                                                "example_id": "d26ef926-4691-419a-9e9f-3f23818aef59",
                                                "sense_id": "d4eb6c6d-271d-3677-a7e5-1567bf2801ec",
                                                "text": "In these cases, fish intake rates specific to females of childbearing age are most appropriate when assessing exposures to developmental toxicants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94c9dc51-66e5-3b64-b8f9-74650a71d2fb",
                                        "entry_id": "3ad38c31-2a1c-3fe6-a16d-cd2f6b3511de",
                                        "glosses": [
                                            "Attractively wide."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810f3e9b-a86f-4073-9a33-f04781ed3620",
                                                "sense_id": "94c9dc51-66e5-3b64-b8f9-74650a71d2fb",
                                                "text": "Hips that in the old country would be considered good childbearing hips, but in this country are too wide."
