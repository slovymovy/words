                        ],
                        "form": "die Staatsgebiete"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5ce5e6d-224e-3fbf-bbe9-4858034b20fb",
                        "entry_id": "0e6728f6-cc59-3b7f-9352-d56ddc377938",
                        "glosses": [
                            "Territorium eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e2493cb-c63d-4238-b2aa-e7f0a67c5a0f",
                                "sense_id": "e5ce5e6d-224e-3fbf-bbe9-4858034b20fb",
                                "text": "„Der Sieg über Veii mündete in der Zerstörung der Stadt und der Inkorporierung des gesamten, ziemlich großen Territoriums, so daß sich das römische Staatsgebiet auf einen Schlag um mehr als 500 km² vergrößerte.“"
                            },
                            {
                                "example_id": "147f8c11-a419-4c84-89d2-69625acb42f9",
                                "sense_id": "e5ce5e6d-224e-3fbf-bbe9-4858034b20fb",
                                "text": "„Die frühen Turkstämme lebten im heutigen Staatsgebiet der Mongolei.“"
                            },
                            {
                                "example_id": "b7a1c622-f18e-4c84-8ad2-9eae4f654d98",
                                "sense_id": "e5ce5e6d-224e-3fbf-bbe9-4858034b20fb",
                                "text": "„Um die Interessen der mehr als 100000 europäischen Siedler in Nordafrika zu schützen, hat Paris das Land bereits 1848 zu französischem Staatsgebiet erklärt.“"
                            },
                            {
                                "example_id": "42e4e068-366d-4f17-b3a6-e08b3d91994e",
                                "sense_id": "e5ce5e6d-224e-3fbf-bbe9-4858034b20fb",
                                "text": "„Das gab Probleme, denn allein in der Rheinprovinz bestanden drei unterschiedliche Gesetzgebungen für das Postwesen, welche unter sich und mit den Regelungen im übrigen preußischen Staatsgebiet kollidierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef478bd0-78ff-4c8c-b89f-b7c2a4c565bd",
