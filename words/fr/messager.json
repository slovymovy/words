    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b34451ca-8ae6-3a21-96c4-84c50860ee51",
                    "sense_definition": "Personne chargée de porter ou de transmettre un message oral ou écrit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi a envoyé un <w>messager</w> rapide pour annoncer la signature de la paix."
                        },
                        {
                            "text": "Dans la mythologie grecque, Hermès était considéré comme le <w>messager</w> des dieux."
                        }
                    ],
                    "synonyms": [
                        "émissaire",
                        "courrier",
                        "porteur"
                    ],
                    "common_phrases": [
                        "messager des dieux",
                        "messager de paix"
                    ]
                },
                {
                    "sense_id": "7e322d3f-41bf-39ef-8e21-d107bd52e219",
                    "sense_definition": "Ce qui annonce ou fait présager un événement futur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annonce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chant des hirondelles est souvent vu comme le <w>messager</w> du printemps."
                        },
                        {
                            "text": "Ce vent glacial est le triste <w>messager</w> d'une tempête imminente."
                        }
                    ],
                    "synonyms": [
                        "annonciateur",
                        "avant-coureur",
                        "présage"
                    ],
                    "common_phrases": [
                        "messager du printemps",
                        "messager de malheur"
                    ]
                },
                {
                    "sense_id": "8b6967e6-eae7-353d-8e46-6647dc789468",
                    "sense_definition": "Personne ou service chargé du transport et de la livraison de lettres ou de colis.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les employés attendent le passage d'un <w>messager</w> pour expédier les documents urgents."
                        },
                        {
                            "text": "Ce pli important a été remis en mains propres par un <w>messager</w> privé."
                        }
                    ],
                    "synonyms": [
                        "coursier",
                        "livreur"
                    ]
                },
                {
                    "sense_id": "88d6d9f4-75b0-3d80-bfc4-d831d3e7087c",
                    "sense_definition": "Molécule intervenant dans la transmission d'informations au sein de la cellule ou de l'organisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette hormone agit comme un <w>messager</w> chimique pour déclencher la réponse immunitaire."
                        },
                        {
                            "text": "Les chercheurs étudient le rôle de ce second <w>messager</w> dans la régulation cellulaire."
                        }
                    ],
                    "common_phrases": [
                        "second messager",
                        "messager chimique"
                    ]
                },
                {
                    "sense_id": "54b847e0-4a90-3f7c-97c0-82fbbe88dfc7",
                    "sense_definition": "Fin cordage destiné à guider une drisse ou un câble à l'intérieur d'un mât.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marin a passé un <w>messager</w> dans le mât avant de tirer la nouvelle drisse."
                        },
                        {
                            "text": "Il faut veiller à ne pas rompre le <w>messager</w> lors de cette manœuvre délicate."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                    "sense_definition": "Qui a pour fonction de porter ou de transmettre un message ou une information biologique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autrefois, le pigeon <w>messager</w> était couramment utilisé pour envoyer des dépêches en temps de guerre."
                        },
                        {
                            "text": "Le vaccin utilise de l'acide ribonucléique <w>messager</w> pour stimuler les défenses du corps."
                        }
                    ],
                    "common_phrases": [
                        "pigeon messager",
                        "ARN messager",
                        "colombe messagère"
                    ]
