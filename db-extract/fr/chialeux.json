            {
                "entry_id": "55375860-5690-3101-ba44-5d9e4974e7c5",
                "word": "chialeux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6328aca8-127f-410c-bf0b-08b2d3b9c3aa",
                        "entry_id": "55375860-5690-3101-ba44-5d9e4974e7c5",
                        "tags": [
                            "feminine"
                        ],
                        "form": "chialeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd791db7-b01e-3088-9ade-a43386181f04",
                        "entry_id": "55375860-5690-3101-ba44-5d9e4974e7c5",
                        "glosses": [
                            "Quelqu’un qui chiale souvent, qui n’arrête pas de se plaindre , qui se morfond."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "60da2aca-ce1f-4222-bcd9-6f4404bb703e",
                                "sense_id": "bd791db7-b01e-3088-9ade-a43386181f04",
                                "text": "Trois flocons de neige un 30 septembre et les chialeux recommencent à chialer: «J’haïs l’hiver, maudit hiver...»"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee9e3dd4-0787-3a35-a3f1-b047c9874074",
                        "entry_id": "55375860-5690-3101-ba44-5d9e4974e7c5",
                        "glosses": [
                            "Qui, à tort ou trop souvent ou exagérément, récrimine, dénonce, se révolte."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e9bebd5c-d723-46eb-9d8d-89e33796a0c2",
                                "sense_id": "ee9e3dd4-0787-3a35-a3f1-b047c9874074",
                                "text": "À la même émission, l’humoriste Cathy Gauthier (qui venait parler de son spectacle qui prendra l’affiche en... 2021) m’a confié : « Je ne suis plus capable de voir qu’on s’aplatit devant des chialeux ! »."
                            }
                        ]
                    }
