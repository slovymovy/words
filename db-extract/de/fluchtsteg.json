                "senses": [
                    {
                        "sense_id": "b7475222-6951-312a-8011-20ba3d6d839f",
                        "entry_id": "cb8b84bb-4b6f-3ee7-9b24-9155fd7f72cd",
                        "glosses": [
                            "spezielle Hilfsbrücke, die es in einer Notsituation ermöglicht, einen Gefahrenbereich zu verlassen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "59bf2569-c1f2-4819-802f-87858aacb557",
                                "sense_id": "b7475222-6951-312a-8011-20ba3d6d839f",
                                "text": "„Ein sicherer Zugang zu den Dalben wird über einen Landsteg gewährleistet, der gleichzeitig als Fluchtsteg dient.“"
                            },
                            {
                                "example_id": "20ed3762-8323-45f8-8665-52916da559b2",
                                "sense_id": "b7475222-6951-312a-8011-20ba3d6d839f",
                                "text": "„Daher soll auf der Nordseite ein Fluchtsteg hin zur Stadtmauer angebaut werden.“"
                            },
                            {
                                "example_id": "fc3eadc3-827f-4414-81a4-10b673eae079",
                                "sense_id": "b7475222-6951-312a-8011-20ba3d6d839f",
                                "text": "„Für die Anbindung des Fluchtsteges an die angrenzenden Räume, waren Wanddurchbrüche an der Nordfassade des Neubaus im 2. OG und am West-Giebel des Altbaus im 2.OG nötig.“"
                            },
                            {
                                "example_id": "e03c13bc-7483-4856-8a3c-7d20038a8299",
                                "sense_id": "b7475222-6951-312a-8011-20ba3d6d839f",
                                "text": "„Direkt unterhalb der Landeplattform befinden sich die Technikebene und ein Fluchtsteg vom Landeplatz zum Aufzugsturm.“"
                            },
                            {
                                "example_id": "cd95b3e7-2435-49bb-9753-6cd1cc52a3fe",
                                "sense_id": "b7475222-6951-312a-8011-20ba3d6d839f",
                                "text": "„Das Brandschutzkonzept sieht auch vor, den Weg vom Fluchtsteg zum Gehweg mit Schotterrasen zu befestigen. Während das für Gemeinderätin Heike Schwarz von der Freien Wählervereinigung (FWV) die Maximallösung ist, kann sich Jörg Molter (FWV) damit nicht anfreunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
