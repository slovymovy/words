                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d7a32376-4813-478a-b8a7-e00edf8eb3d2",
                                "sense_id": "baad4d59-4d53-3fca-9966-d9e2b662461a",
                                "text": "2005, Maria Beaumont, MissFit, Arrow Books, UK, page 175,\nThis evening I′ve been the cheapest, slaggiest slag ever."
                            }
                        ]
                    }
