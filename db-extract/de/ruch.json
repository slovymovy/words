                ],
                "senses": [
                    {
                        "sense_id": "85d68a68-377c-3393-9641-0b8680f79a16",
                        "entry_id": "44eb10cf-87b6-3786-941f-4ba0c70ba062",
                        "glosses": [
                            "zweifelhaftes Ansehen, das jemand bei anderen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e65ce3c-5e8a-43ff-96fe-02329c87b94a",
                                "sense_id": "85d68a68-377c-3393-9641-0b8680f79a16",
                                "text": "„Ein Rest des alten Ruchs hängt der Branche bis heute nach.“"
                            },
                            {
                                "example_id": "e67b8105-ea77-423a-878d-9fc8d87ab824",
                                "sense_id": "85d68a68-377c-3393-9641-0b8680f79a16",
                                "text": "„Winnie, die Fotografin, hatte die Bewegungen ihres Metiers angenommen, ein klein wenig lässig, doch stets mit dem Ruch des klug Arrangierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c12b117e-89b8-3c8d-bb96-bfb11a550849",
                        "entry_id": "44eb10cf-87b6-3786-941f-4ba0c70ba062",
                        "glosses": [
                            "das, was man riecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc3d853-de74-4b05-8290-c5fe909146fe",
                                "sense_id": "c12b117e-89b8-3c8d-bb96-bfb11a550849",
                                "text": "„Ich sehe ein blasses verwischtes Gesicht im Dunkeln, und ein Ruch von Parfüm weht hinter ihr her.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
