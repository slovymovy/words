                        "sense_id": "3d482caf-af3e-3f3e-b6eb-adc51ab9dd27",
                        "entry_id": "b443a217-932e-3084-bfe9-1b1d57cc1386",
                        "glosses": [
                            "Läuferin, die in einem Langstreckenrennen für jemand anderen/für andere die Geschwindigkeit eine gewisse Zeit auf einem konstant hohen Niveau hält, aber in der Regel nicht die ganze Distanz absolviert"
                        ],
                        "tags": [
                            "Leichtathletik"
                        ],
                        "examples": [
                            {
                                "example_id": "c23775a2-6094-44ce-ad34-b1ef63497104",
                                "sense_id": "3d482caf-af3e-3f3e-b6eb-adc51ab9dd27",
                                "text": "„Sie lief lediglich als Schrittmacherin für ihre Landsmännin mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ebf3023-3b9d-3d3f-ad04-431f9d949bc7",
                        "entry_id": "b443a217-932e-3084-bfe9-1b1d57cc1386",
                        "glosses": [
                            "Motorradfahrerin, die folgenden Bahnradsportlern bei bestimmten Rennen Windschatten bietet"
                        ],
                        "tags": [
                            "Radsport"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8dd28f4e-ab5f-3946-95f1-354b40d4f5cb",
                        "entry_id": "b443a217-932e-3084-bfe9-1b1d57cc1386",
                        "glosses": [
                            "weibliche Person oder Institution, Gruppierung oder Ähnliches, die durch ihre Aktivität andere mitreißt, die der Auslöser, Antrieb für einen Fortschritt ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e3cf3b33-4fdf-4ac8-b2d3-25e1ccfba257",
                                "sense_id": "8dd28f4e-ab5f-3946-95f1-354b40d4f5cb",
                                "text": "„Erstmal finde ich es super, dass die Bundeskanzlerin die Schrittmacherin für Europa ist und auch die Bereitschaft zeigt, an die Grenzen des Konsenses zu gehen, um etwas zu erreichen.“"
                            },
                            {
                                "example_id": "6aa8b60f-e568-4a1a-8238-c94cce414be9",
                                "sense_id": "8dd28f4e-ab5f-3946-95f1-354b40d4f5cb",
                                "text": "„Die italienische Industrie war einst Schrittmacherin des Wohlstandes.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
