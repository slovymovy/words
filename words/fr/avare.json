            "senses": [
                {
                    "sense_id": "c6aee71d-9334-3dcd-ac21-645bbfe87fa5",
                    "sense_definition": "Qui a un attachement excessif à l'argent et répugne à faire la moindre dépense.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon oncle est tellement <w>avare</w> qu'il refuse d'allumer le chauffage en plein hiver."
                        },
                        {
                            "text": "Elle n'est pas pauvre mais reste très <w>avare</w> envers les membres de sa famille."
                        }
                    ],
                    "synonyms": [
