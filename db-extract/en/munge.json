                ],
                "senses": [
                    {
                        "sense_id": "726a70c3-8b59-3ca1-93c2-dd80dc042cda",
                        "entry_id": "5b08ace0-53e6-3351-9c99-97e2a8b9c8f1",
                        "glosses": [
                            "To transform data in an undefined or unexplained manner, as for example when data wrangling requires nonsystemic or nonsystematic edits."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad3198dc-6eeb-4a85-9cc4-05f27f499fdf",
                                "sense_id": "726a70c3-8b59-3ca1-93c2-dd80dc042cda",
                                "text": "As a part of the code review with the development team, notify them that you want to have these options as a part of the installation script, rather than you munging the installation scripts during deployment."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4b93b3f-80fd-39c0-b172-91dfea578056",
                        "entry_id": "5b08ace0-53e6-3351-9c99-97e2a8b9c8f1",
                        "glosses": [
                            "To add a spamblock to (an email address)."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "25984b84-e662-4ede-8aef-4c1b3b678936",
                                "sense_id": "c4b93b3f-80fd-39c0-b172-91dfea578056",
                                "text": "Munging is effective — it prevents unwanted email from reaching you by keeping your real email address out of the clutches of the address-harvesting programs."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8092103-cbeb-38da-988c-377fbda3de23",
                        "entry_id": "5b08ace0-53e6-3351-9c99-97e2a8b9c8f1",
                        "glosses": [
                            "To corrupt a record about a person by erroneously merging in information about another person."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "60ed1524-680f-4db5-bfa0-0601d72de81f",
                                "sense_id": "c8092103-cbeb-38da-988c-377fbda3de23",
                                "text": "It looks like this record is munged—it has this person’s birth date, but his father’s death date."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "543b852e-ff15-4cc4-9a10-2d7ecd583b7f",
                        "source_entry_id": "5b08ace0-53e6-3351-9c99-97e2a8b9c8f1",
                        "source_sense_description": "transform data in an undefined/unexplained manner",
                        "target_lang_word": "beschädigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beschädigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                        "entry_id": "0307dfcc-5aea-3069-8ec7-bb92535d885c",
                                        "glosses": [
                                            "etwas einen Schaden zufügen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e72875f-d1a8-4a3a-a9f8-2497d528c9cb",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "Wenn Sie die Ware beschädigt haben, müssen Sie sie kaufen."
                                            },
                                            {
                                                "example_id": "4779913b-08c8-44f1-9fe6-da8cf11a1290",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "Das beschädigte Fahrzeug wird vom Gutachter besichtigt."
                                            },
                                            {
                                                "example_id": "93f59295-5fae-449d-97e1-3903554a55f0",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "„Laut Aussagen des ukrainischen Präsidenten haben russische Raketen- und Drohnenangriffe 30 Prozent der ukrainischen Kraftwerke entweder beschädigt oder zerstört.“"
                                            },
                                            {
                                                "example_id": "2b4da979-ec66-4ab2-814c-7f1b28d27545",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "„Seit dem Entzug des Doktortitels sei Schavan in ihrem Amt beschädigt gewesen.“"
                                            },
                                            {
                                                "example_id": "0f7def62-ca86-43d1-9b60-e5ecb08359ac",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "„Es sind nicht die Medien, die das Amt beschädigen, wie Bundestagspräsident Norbert Lammert es mit seiner Kritik angedeutet hat.“"
                                            },
                                            {
                                                "example_id": "8fb5917d-22f9-4398-99e8-7975c34973da",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "Pass auf, dass du mit solchen Aktionen nicht deinen guten Ruf beschädigst!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e6e6b4d-2560-4ace-bb40-5234f008d74b",
                        "source_entry_id": "5b08ace0-53e6-3351-9c99-97e2a8b9c8f1",
                        "source_sense_description": "transform data in an undefined/unexplained manner",
                        "target_lang_word": "zerstören",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerstören",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                        "entry_id": "8e14d7ff-d8b3-3295-b346-45c64e996c07",
                                        "glosses": [
                                            "etwas sehr stark beschädigen und (damit meist) unbrauchbar machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93cb9819-5f93-4e77-a49b-70272004ed55",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "Streptokokkus ist ein Bakterium, das Zähne zerstört."
                                            },
                                            {
                                                "example_id": "eccc149e-534b-44d8-baa4-5b73978a37c2",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Bevor der Arzt dem Patienten die gentherapeutisch veränderten Blutstammzellen verabreicht, muss er dessen defektes Knochenmark mit einer Chemotherapie zerstören.“"
                                            },
                                            {
                                                "example_id": "4d805e0b-f675-4d83-b3ac-ac2650f12b83",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Ein Blitz hat Dienstagabend in ein Bauernhaus in St. Johann (Pongau) eingeschlagen“ [… Der Blitz] „zerstörte die Haus- und Badtüre, eine Wand im Erdgeschoß, ein Kellerabteil und mehrere Kellerfenster. Der Schaden wird sich auf etwa 5.000 bis 6.000 Euro belaufen“, schätzt Höllwart.“"
                                            },
                                            {
                                                "example_id": "7b2fac6a-e0ef-41bd-9efb-eb56b95d34bd",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Zerstört alle heiligen Stätten, wo die Heiden, die ihr vertreiben werdet, ihren Göttern gedient haben, es sei auf hohen Bergen, auf Hügeln oder unter jedem grünen Baum,“ […]."
                                            },
                                            {
                                                "example_id": "d32e2184-e1cd-4242-bff9-823496a626a5",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„In einer Zeremonie zerstören sie die Trophäen, brechen die Schwerter entzwei und zerschlagen die Schilde.“"
                                            },
                                            {
                                                "example_id": "309d2852-5bf2-4f3c-a8cd-e3e631b67441",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "Durch den Bombenkrieg wurden viele Städte zerstört."
                                            },
                                            {
                                                "example_id": "134d684a-1fe7-434d-9ad1-76bdb07b9e27",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Nachdem eine Feuersbrunst anno 1046 den alten Dom zerstört hatte, schickte sich Azelin an, hier einen neuen zu errichten.“"
                                            },
                                            {
                                                "example_id": "9205695c-41d9-4959-8884-1e3135cb7ce8",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Ungewöhnlich war am Ghorka-Beben unter anderem, dass es an ein- und zweistöckigen Gebäuden vergleichsweise geringe Schäden hinterließ. Dafür zerstörte es vor allem große Gebäude wie den 60 Meter hohen Bhimsen-Turm“: […]."
                                            },
                                            {
                                                "example_id": "2951d3f3-4a7c-4363-8e92-edce89eb4550",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Laut Aussagen des ukrainischen Präsidenten haben russische Raketen- und Drohnenangriffe 30 Prozent der ukrainischen Kraftwerke entweder beschädigt oder zerstört.“"
                                            },
                                            {
                                                "example_id": "d52f0143-bdd7-4697-b800-256a81f40bda",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Bikini-Atoll – Vor siebzig Jahren begannen die amerikanischen Atombombentest“ […] „Die Bravo-Explosion war viel stärker als berechnet: Sie zerstörte drei Inseln, riss einen riesigen Krater ins Riff und katapultierte Abermillionen Tonnen verstrahlten Wassers und Korallenriffstaubs in die Luft.“"
                                            },
                                            {
                                                "example_id": "8ee4418b-cff3-42f2-b8ea-0b8d9e76a9b3",
                                                "sense_id": "1dfc2550-557d-356f-b79e-e2d2c2c6e02f",
                                                "text": "„Torf wird in Mooren abgebaut, die so unwiederbringlich zerstört werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e08c61c-13c5-30c3-83ee-db900dffe4c3",
                                        "entry_id": "8e14d7ff-d8b3-3295-b346-45c64e996c07",
                                        "glosses": [
                                            "zunichtemachen, zugrunde richten, zerrütten"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d4ce6a-e2e6-47ad-b8da-f0cad2ce8ee7",
                                                "sense_id": "0e08c61c-13c5-30c3-83ee-db900dffe4c3",
                                                "text": "Zerstör du meine Ehe, und du wirst deines Lebens nicht mehr glücklich!"
                                            },
                                            {
                                                "example_id": "b935f277-499c-4a7c-a9cb-77a85bb3a391",
                                                "sense_id": "0e08c61c-13c5-30c3-83ee-db900dffe4c3",
                                                "text": "Das Vertrauensverhältnis zwischen uns ist unwiederbringlich zerstört."
                                            },
                                            {
                                                "example_id": "d794c68b-e7ea-4939-9956-f66f31c4691e",
                                                "sense_id": "0e08c61c-13c5-30c3-83ee-db900dffe4c3",
                                                "text": "„Wer einen Stein unter die Vögel wirft, der scheucht sie weg; wer seinen Freund schmäht, der zerstört die Freundschaft.“"
                                            },
                                            {
                                                "example_id": "aa08ab3b-9a5e-490e-bfe9-cbe9c109d8af",
                                                "sense_id": "0e08c61c-13c5-30c3-83ee-db900dffe4c3",
                                                "text": "„Ist das Vertrauensverhältnis zwischen einem Soldaten und seinem Dienstherrn zerstört und daher die Höchstmaßnahme zu verhängen, kann eine überlange Verfahrensdauer nicht mehr maßnahmemildernd wirken.“"
                                            },
                                            {
                                                "example_id": "599338a7-3ebf-482c-9230-5e3f222484fe",
                                                "sense_id": "0e08c61c-13c5-30c3-83ee-db900dffe4c3",
                                                "text": "„Stalkerinnen gehen im Netz meist sehr viel gezielter und hinterhältiger vor als Männer und schrecken auch nicht davor zurück, die Beziehung oder die Karriere ihres Opfers zu zerstören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb5dfaff-14ee-446c-9691-cef6c4b26822",
