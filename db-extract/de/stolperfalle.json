                ],
                "senses": [
                    {
                        "sense_id": "2685e2fa-030f-3544-9d9c-1798a595bdf4",
                        "entry_id": "df88d7e9-7722-3bc2-917e-8fdc3ff95e88",
                        "glosses": [
                            "Falle, die ausgelöst wird, sobald man auf sie tritt; etwas, das eine Gefahr oder Bedrohung darstellt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b5bff85d-482e-4a24-a2a1-6f9cb9cacab7",
                                "sense_id": "2685e2fa-030f-3544-9d9c-1798a595bdf4",
                                "text": "„Links von dem Draht bemerkte sie einen Apparat, welcher ursprünglich mit dem Draht verbunden war und somit eine Stolperfalle darstellte.“"
                            },
                            {
                                "example_id": "68a5644c-30f4-4605-80e7-e898d14e6a5e",
                                "sense_id": "2685e2fa-030f-3544-9d9c-1798a595bdf4",
                                "text": "„Wenn Antonia sich nicht von selbst verletzte, konnte man vielleicht ein paar Stolperfallen bauen.“"
                            },
                            {
                                "example_id": "a9d10a7b-bfb5-41bb-a1d6-3b8830bfe5e1",
                                "sense_id": "2685e2fa-030f-3544-9d9c-1798a595bdf4",
                                "text": "„Das wäre weiterhin nicht schlimm gewesen, wenn er sich an den Büschelbock erinnert hätte, der ihm mit seinen schrägen Holzfüßen zur Stolperfalle wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
