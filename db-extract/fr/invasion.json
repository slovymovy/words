        "fr-extract.jsonl": [
            {
                "entry_id": "a7a26508-31ec-3573-8306-c8bb7abebc44",
                "word": "invasion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "108aa45b-cf31-40b9-9517-16210c27aad1",
                        "entry_id": "a7a26508-31ec-3573-8306-c8bb7abebc44",
                        "tags": [
                            "plural"
                        ],
                        "form": "invasions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f93e12b4-64ae-395c-93be-cef35639a1b4",
                        "entry_id": "a7a26508-31ec-3573-8306-c8bb7abebc44",
                        "glosses": [
                            "Irruption faite dans le dessein de piller un pays, ou de s’en emparer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac4f377-b83f-4b84-bdf1-a4e488e45edf",
                                "sense_id": "f93e12b4-64ae-395c-93be-cef35639a1b4",
                                "text": "[…] les Turcs avaient fait une invasion en Hongrie, et, à l’appel de Louis V, Ludwig était parti avec son frère d’armes le comte Karl de Hombourg […]"
                            },
                            {
                                "example_id": "5c029ca9-22af-49d3-b5fc-0ea40bd791bc",
                                "sense_id": "f93e12b4-64ae-395c-93be-cef35639a1b4",
                                "text": "La terrible défaite de Sedan et l’invasion du territoire, en septembre 1870, mirent fin au régime impérial."
                            },
                            {
                                "example_id": "57828d6b-1b92-470e-ae27-e0051691ceb1",
                                "sense_id": "f93e12b4-64ae-395c-93be-cef35639a1b4",
                                "text": "L’historien d’Attigny pense que ce changement fut occasionné par la dévastation de la paroisse de Montmarin à l’époque de l’invasion du Comte de Bar en Champagne, en 1297."
                            },
                            {
                                "example_id": "f9a083dd-e25b-42d8-aa3a-406dbafabb8f",
                                "sense_id": "f93e12b4-64ae-395c-93be-cef35639a1b4",
                                "text": "Au Vᵉ siècle, l’empire romain, miné par les luttes intestines, tombe en déliquescence. Des invasions de peuples barbares désolent et bouleversent aussi bien Rome que les Gaules."
                            },
                            {
                                "example_id": "cc127319-0d28-42c7-9272-4d3abe3365a4",
                                "sense_id": "f93e12b4-64ae-395c-93be-cef35639a1b4",
                                "text": "Obsédées par la crainte des « francs-tireurs », les troupes d’invasion ont déjà, le 24 août, incendié Haybes et mis à mort soixante civils du lieu, avec une grande cruauté […]"
                            },
                            {
                                "example_id": "75b2be06-8fd9-4cc4-a7ea-03d3167e3e54",
                                "sense_id": "f93e12b4-64ae-395c-93be-cef35639a1b4",
                                "text": "Depuis novembre dernier, Kiev et certains pays occidentaux accusent la Russie d'avoir massé un grand nombre de soldats près de la frontière ukrainienne, y compris en Biélorussie, avec la possible intention de procéder à une \"invasion\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9da4055-216d-3382-a28a-0b0b54364b9e",
                        "entry_id": "a7a26508-31ec-3573-8306-c8bb7abebc44",
                        "glosses": [
                            "Action d’envahir un organisme, en parlant d’agents pathogènes, ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c11a5666-b4fa-424a-b8e3-e9f41c3c0a40",
                                "sense_id": "e9da4055-216d-3382-a28a-0b0b54364b9e",
                                "text": "C’est le signe d’une réaction de l’organisme : le tissu lymphoïde fabrique des phagocytes en abondance pour pouvoir lutter contre l’invasion parasitaire, qui se produit au niveau de la muqueuse intestinale."
                            }
                        ]
                    },
                    {
                        "sense_id": "c20412c2-0dbc-322f-884b-4f2dc4437268",
                        "entry_id": "a7a26508-31ec-3573-8306-c8bb7abebc44",
                        "glosses": [
                            "Afflux important de personnes ou d’animaux plus ou moins indésirables ou gênants."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "aeee983c-968d-4f76-bdac-4bba71b57d2b",
                                "sense_id": "c20412c2-0dbc-322f-884b-4f2dc4437268",
                                "text": "L’aventure du phylloxera fut, d’ailleurs, sur le point de se renouveler quelques années plus tard, lors de l’invasion de l’Europe par le doryphore, vulgairement appelé bête du Colorado et comme son nom l’indique, lui aussi originaire de l’Amérique du Nord, et qui parasite la pomme de terre."
                            },
                            {
                                "example_id": "0e07017c-3f12-4e5d-8685-25b8027e00fe",
                                "sense_id": "c20412c2-0dbc-322f-884b-4f2dc4437268",
                                "text": "Il se produisit à Paris une invasion d’étrangers à l’occasion de l’Exposition universelle de 1900."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2999773-40ff-3f29-88c9-8942af569b7b",
                        "entry_id": "a7a26508-31ec-3573-8306-c8bb7abebc44",
                        "glosses": [
                            "(Invader) Pose de mosaïques du projet artistique Space Invaders dans une zone géographique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4ab088-4d90-4755-981a-ccc906391415",
                                "sense_id": "b2999773-40ff-3f29-88c9-8942af569b7b",
                                "text": "Fontainebleau a subi son invasion le 28 février 2023 avec trois mosaïques."
                            }
                        ]
                    },
                    {
                        "sense_id": "d663e359-98dc-3610-9817-c728875690c8",
                        "entry_id": "a7a26508-31ec-3573-8306-c8bb7abebc44",
                        "glosses": [
                            "Début d'une maladie infectieuse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
