                    {
                        "sense_id": "c1d13cca-5938-39c3-8f6b-5f89d2e69b35",
                        "entry_id": "7b9a3262-3f3b-3439-8b7d-ef7f58019a40",
                        "glosses": [
                            "een speler die van meer dan gemiddeld belang is voor een team, de drijvende kracht, de stuwende kracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30739f5c-ab13-4bef-a972-bea1d13cd8d1",
                                "sense_id": "c1d13cca-5938-39c3-8f6b-5f89d2e69b35",
                                "text": "Tot overmaat van ramp ging in de verloren stadsderby tegen de Clippers ook Anthony Davis na het eerste kwart met enkelproblemen naar de kant, nog een sterkhouder uit het team dat vorig jaar kampioen werd."
                            },
                            {
                                "example_id": "271b9e79-eb72-4482-8bd3-eae8e853cf88",
                                "sense_id": "c1d13cca-5938-39c3-8f6b-5f89d2e69b35",
                                "text": "Na de nog altijd van een zware knieblessure herstellende Virgil van Dijk dreigde Oranje op het EK ook een andere sterkhouder te moeten missen."
                            },
                            {
                                "example_id": "bc9f0715-234b-410b-af06-baed4e0c9001",
                                "sense_id": "c1d13cca-5938-39c3-8f6b-5f89d2e69b35",
                                "text": "Teun Koopmeiners staat nog altijd op het trainingsveld in het Noord-Hollandse Wijdewormer. De 23-jarige middenvelder wordt veel gelinkt aan Italiaanse (top)clubs en zou wel eens de volgende sterkhouder kunnen zijn die voor miljoenen vertrekt."
                            }
                        ]
                    }
