                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2faee225-485d-3d18-9415-a8bb895aad7b",
                                        "entry_id": "54b77a5a-2164-330a-9913-5c47c7b4b073",
                                        "glosses": [
