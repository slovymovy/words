            {
                "entry_id": "67aa5d6a-bf04-3d6a-99ed-864ac00519cc",
                "word": "diplodocus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7a8becaf-62d4-373e-b4fe-742ae14bb032",
                        "entry_id": "67aa5d6a-bf04-3d6a-99ed-864ac00519cc",
                        "glosses": [
                            "Grand dinosaure herbivore du jurassique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1f2e514-47dd-4a1e-9aa8-019ac94c80a3",
                                "sense_id": "7a8becaf-62d4-373e-b4fe-742ae14bb032",
                                "text": "Selon certains savants, les diplodocus étaient bêtes comme des camions : nuit et jour ils pataugeaient dans une boue phosphorescente d’où montaient des fusées comestibles… Puis, tout couverts de goémons moirés et de fientes verdâtres, ils s’en allaient galoper sur un gazon ravissant qu’ils ont esquinté, gazon que nous appelons aujourd’hui Montagnes Rocheuses."
                            },
                            {
                                "example_id": "1f821799-f9bd-459b-91fc-7c59d19666a7",
                                "sense_id": "7a8becaf-62d4-373e-b4fe-742ae14bb032",
                                "text": "Au milieu trônait le squelette du majestueux diplodocus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8411055e-3529-4b5a-a2e7-cb72ec127b4c",
