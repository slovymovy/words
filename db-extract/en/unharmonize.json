                "senses": [
                    {
                        "sense_id": "7b3e9dc0-26e7-3cdf-8c3d-f40590af2971",
                        "entry_id": "f0f6b0cc-dde7-399b-825f-7f555202cad7",
                        "glosses": [
                            "To disturb the harmony of"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ac6b64-b5b8-4916-ac0c-50bb28535588",
                                "sense_id": "7b3e9dc0-26e7-3cdf-8c3d-f40590af2971",
                                "text": "In the exhilarating hope of reaching London on a scale of expence so suitable to her scanty means, and under some sort of protection, it was not in the power of Sir Jacob nor his companion entirely to unharmonize her mind."
                            },
                            {
                                "example_id": "c9617692-61e2-4ee0-b029-485f53d0aba8",
                                "sense_id": "7b3e9dc0-26e7-3cdf-8c3d-f40590af2971",
                                "text": "Disease waits for us in a thousand shapes, ever ready to seize and unharmonize our frail frames, and rob us of the little ease we might otherwise enjoy."
                            },
                            {
                                "example_id": "f8d38671-84d8-42db-98ee-c3bce66db061",
                                "sense_id": "7b3e9dc0-26e7-3cdf-8c3d-f40590af2971",
                                "text": "Threats of a new party are made and fears entertained by some that it will unharmonize the Democratic party."
                            }
                        ]
                    }
