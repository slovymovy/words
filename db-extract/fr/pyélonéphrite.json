                ],
                "senses": [
                    {
                        "sense_id": "0f35937f-b2a5-3787-b9c4-3545c74d94b5",
                        "entry_id": "ab42487a-2f85-30f8-b2a2-b7d80a5da974",
                        "glosses": [
                            "Inflammation urinaire touchant le bassinet et le rein."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53286c8f-14b3-438f-974c-ece87516ff84",
                                "sense_id": "0f35937f-b2a5-3787-b9c4-3545c74d94b5",
                                "text": "Le risque majeur de pyélonéphrite est dans l’immédiat infectieux (septicémie) et à terme la destruction progressive des reins, surtout en cas de lithiase rénale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe14c95c-6030-48e0-8c7a-3ec62e2ae9e2",
                        "source_entry_id": "ab42487a-2f85-30f8-b2a2-b7d80a5da974",
                        "source_sense_id": "0f35937f-b2a5-3787-b9c4-3545c74d94b5",
                        "target_lang_word": "pyelonephritis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyelonephritis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e93acc4c-be30-39e6-9f16-a690ebcaf2ff",
                                        "entry_id": "69de48d2-9f97-35f8-8bc9-16d75af1a2ba",
                                        "glosses": [
                                            "An ascending urinary tract infection of the renal pelvis"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8991f142-d915-4cd2-a1a3-ec619ed24e40",
                                                "sense_id": "e93acc4c-be30-39e6-9f16-a690ebcaf2ff",
                                                "text": "The urinogenous or ascending nephropathies are divisible into two great groups (a) the hydronephrotic nephropathies and (b) the pyelonephritides."
                                            },
                                            {
                                                "example_id": "91cc0d68-881d-4a1b-81fa-88bc23c167b0",
                                                "sense_id": "e93acc4c-be30-39e6-9f16-a690ebcaf2ff",
                                                "text": "The frequent spontaneous resolution of cystopyelic reflux after 10 years of age induces to consider at least part of the apparently primary pyelonephritides as secondary to yet disappeared refluxes and, thus, to allocate in this group most of the so-called atrophic pyelonephritides of the young, often monolateral or mostly affecting one kidney, with sterile urine and almost normal urinary sediment."
                                            },
                                            {
                                                "example_id": "ed469ba2-d850-4cfa-be62-287bbd20727c",
                                                "sense_id": "e93acc4c-be30-39e6-9f16-a690ebcaf2ff",
                                                "text": "2001, Jeffery Hughes, 12: Infectious Diseases, N. A. Hughes, Clinical Pharmacy, Macmillan Health, 2nd Edition, page 215,\nPrimary acute pyelonephritis most commonly occurs in females, with 90% of cases caused by Escherichia coli."
                                            },
                                            {
                                                "example_id": "af63f08b-2e05-453c-8324-d79d3cc7c045",
                                                "sense_id": "e93acc4c-be30-39e6-9f16-a690ebcaf2ff",
                                                "text": "The kidneys of acute pyelonephritis have small white abscesses on the subcapsular surface and on cut surfaces."
                                            },
                                            {
                                                "example_id": "3d7cd60a-ab6b-40c3-841e-505e552696a4",
                                                "sense_id": "e93acc4c-be30-39e6-9f16-a690ebcaf2ff",
                                                "text": "Pyelonephritis is most commonly encountered in younger, nulliparous women in their second trimester. Women with a history of pyelonephritis, renal calculi or anatomic malformations are particularly susceptible to the development of pyelonephritis and should therefore be regularly screened on a monthly basis throughout pregnancy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
