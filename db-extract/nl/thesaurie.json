                        "sense_id": "4d4fae3b-eb2e-3adb-9ed3-872d4a13df39",
                        "entry_id": "4aac4a0c-7dbd-3168-9cf3-f78f3c5dbad9",
                        "glosses": [
                            "plaats waar men het geld van de overheid of een organisatie beheert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069404d4-7469-484e-a1ab-b441cfaf7cb4",
                                "sense_id": "4d4fae3b-eb2e-3adb-9ed3-872d4a13df39",
                                "text": "De Nederlandse overheid moet dit jaar 8,4 miljard euro meer lenen op de geldmarkt dan eerder gedacht. Dat meldde het Agentschap van de Generale Thesaurie vandaag."
                            },
                            {
                                "example_id": "ef42a20f-0430-49df-bca3-4d2ca029fa8e",
                                "sense_id": "4d4fae3b-eb2e-3adb-9ed3-872d4a13df39",
                                "text": "‘Hoe sneller de staat werkt, hoe beter dus voor de gemeentelijke thesaurie. Een vertraging leidt niet alleen tot mogelijke kasproblemen voor de lokale besturen, ze zorgt er ook voor dat middelen waarop een gemeente in een bepaald begrotingsjaar had gerekend, naar een volgend jaar verschuiven’, luidt het bij de VVSG."
                            }
                        ]
                    }
