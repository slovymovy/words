                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d2dc13fc-2348-4b5c-aa27-871508fb0849",
                        "entry_id": "d980023e-862c-3ec9-b267-d7c04d238ea8",
                        "tags": [
                            "plural"
                        ],
                        "form": "appoggiatures"
                    },
                    {
                        "form_id": "6dcd537e-18e4-44e9-abd0-68ab0e5eac52",
                        "entry_id": "d980023e-862c-3ec9-b267-d7c04d238ea8",
                        "tags": [],
                        "form": "appogiature"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "323339fe-4dc0-3c0f-813e-a96cec7fd5e8",
                        "entry_id": "d980023e-862c-3ec9-b267-d7c04d238ea8",
                        "glosses": [
                            "Ornement servant à préparer la note suivante sur laquelle on veut insister. Elle se représente sous la forme d'une petite note liée à la note principale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef443cf-e5d8-47da-9b42-cb2501657338",
                                "sense_id": "323339fe-4dc0-3c0f-813e-a96cec7fd5e8",
                                "text": "Une appoggiature longue, brève, double, barrée, supérieure ou inférieure."
                            },
                            {
                                "example_id": "b251b2d2-f28b-4b75-8e7f-446db70fff4a",
                                "sense_id": "323339fe-4dc0-3c0f-813e-a96cec7fd5e8",
                                "text": "Il importe donc, pour l’interprétation de leurs œuvres, de faire connaître comment ils comprenaient l’emploi et l’exécution de l’appoggiature, du grupetto et du trille."
                            },
                            {
                                "example_id": "608149ec-9224-4bf0-8aaf-70afebbd0407",
                                "sense_id": "323339fe-4dc0-3c0f-813e-a96cec7fd5e8",
                                "text": "Au lieu de se tenir en face de l’œuvre et de la servir du mieux qu’il peut, le voilà qui se met à en faire des tonnes, rajoutant des arpèges par-ci, des mesures par-là, brodant des trilles, des dandinements rythmiques et autres agréments d’exécution que nul ne lui demandait, appoggiatures et gruppetti, …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6e52619-57b8-4b0e-a808-d0b02a4b1867",
                        "source_entry_id": "d980023e-862c-3ec9-b267-d7c04d238ea8",
                        "source_sense_id": "323339fe-4dc0-3c0f-813e-a96cec7fd5e8",
                        "target_lang_word": "Appoggiatura",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6e5590ca-010f-4184-8dab-a4855d6fe557",
                        "source_entry_id": "d980023e-862c-3ec9-b267-d7c04d238ea8",
                        "source_sense_id": "323339fe-4dc0-3c0f-813e-a96cec7fd5e8",
                        "target_lang_word": "Vorschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68d88765-1466-3c31-af62-919ac3fe0466",
                                        "entry_id": "2a4bc842-480e-3119-bef0-406d1840d2b3",
                                        "glosses": [
                                            "Empfehlung oder Rat, etwas auf eine bestimmte Art und Weise zu handhaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b2d083-49cc-491f-8067-e3b872dc0999",
                                                "sense_id": "68d88765-1466-3c31-af62-919ac3fe0466",
                                                "text": "„Einige griffen Armfeldts Vorschlag an, andere traten für ihn ein.“"
                                            },
                                            {
                                                "example_id": "76931b78-fa6e-4562-b6bb-b988655325ac",
                                                "sense_id": "68d88765-1466-3c31-af62-919ac3fe0466",
                                                "text": "Wir hätten auf ihren Vorschlag hören sollen."
                                            },
                                            {
                                                "example_id": "7a519b8b-ee85-47cb-b27a-0ac9951839b5",
                                                "sense_id": "68d88765-1466-3c31-af62-919ac3fe0466",
                                                "text": "„Der Minister hatte seinen Vorschlag vorab prüfen lassen und festgestellt, dass laut Vogelschutzgesetz von 1908 rabenartige Vögel wie Rabenkrähen, Nebelkrähen, Saatkrähen, Elstern und Eichelhäher frei gejagt werden durften.“"
                                            },
                                            {
                                                "example_id": "9c88a13d-67bd-4d46-a54d-6fa6394a267f",
                                                "sense_id": "68d88765-1466-3c31-af62-919ac3fe0466",
                                                "text": "„Es waren schon einige Vorschläge gemacht worden, doch dann kam die schöne Sofie an die Reihe.“"
                                            },
                                            {
                                                "example_id": "e040f1fc-9a2f-44f8-8d15-a1e2888f2767",
                                                "sense_id": "68d88765-1466-3c31-af62-919ac3fe0466",
                                                "text": "„Als ich diesen schönen Vorschlag ganz erfaßt hatte, konnte ich nicht umhin, mehrmals laut herauszulachen; aber ich hörte zu lachen auf, als der Graf rot vor Scham wurde.“"
                                            },
                                            {
                                                "example_id": "7492fcd4-4283-4435-b458-5ecb4b8af684",
                                                "sense_id": "68d88765-1466-3c31-af62-919ac3fe0466",
                                                "text": "[Kaiser Wilhelm II. und Zar Nikolaj II.:] „Eines ist jedoch klar: Wilhelm hat keinen von Nikolajs Vorschlägen zur Lösung des österreichisch-serbischen Konflikts angenommen oder umgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df53069c-6a2b-3b7c-b530-af515122a999",
                                        "entry_id": "2a4bc842-480e-3119-bef0-406d1840d2b3",
                                        "glosses": [
                                            "Verzierung, bei der ein oder mehrere Töne vor dem Hauptton angespielt werden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11cffe30-90e7-40fd-bc89-486838d2e322",
                                                "sense_id": "df53069c-6a2b-3b7c-b530-af515122a999",
                                                "text": "Bitte spiele den Vorschlag in Takt 23 etwas länger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fcef4ed-a030-4049-beca-a7afd87ad78a",
                        "source_entry_id": "d980023e-862c-3ec9-b267-d7c04d238ea8",
