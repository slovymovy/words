                    {
                        "form_id": "04901507-ceb4-423c-8fd4-6a08d9f57a0a",
                        "entry_id": "bd31ae39-9378-369c-acdd-f117dc58b70e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Versprecher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                        "entry_id": "bd31ae39-9378-369c-acdd-f117dc58b70e",
                        "glosses": [
                            "(unbeabsichtigte) sprachliche Fehlleistung beim Sprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "825c604a-3b69-49a5-aff1-cb3a499d9e22",
                                "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                                "text": "Viele Versprecher fallen in Unterhaltungen nicht auf."
                            },
                            {
                                "example_id": "3aa83ea3-5bbe-477b-848c-21a7a8be018c",
                                "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                                "text": "Ein Versprecher wäre: Sie wird an ihrem vertauschten (statt: verstauchten) Fuß behandelt."
                            },
                            {
                                "example_id": "5005cb21-b00a-4532-b628-1d080b56c02d",
                                "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                                "text": "„Leicht sprechbar, um den Sprecher vor Schwierigkeiten und möglichen Versprechern zu bewahren und ihm die Chance zu eröffnen, sich ganz auf eine die Aussage der Sätze unterstützende Intonation zu konzentrieren.“"
                            },
                            {
                                "example_id": "ebff9e9e-20f8-42e4-aabd-c4c33dd4e470",
                                "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                                "text": "„Aber das mache ich nicht, weil ich erst einmal lernen muss, eine Lesung ohne einen einzigen Versprecher und Verleser durchzuhalten.“"
                            },
                            {
                                "example_id": "fb542320-d2b1-4580-bf70-7555cb049a1a",
                                "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                                "text": "„Daraufhin kam ich zum Schluß, daß die akademische Lehre durch Versprecher und ihre Analyse bereichert werden könnte, und habe begonnen, Versprecher zu sammeln.“"
                            },
                            {
                                "example_id": "89ebae17-4912-48c4-85dd-d1191a1b0f54",
                                "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                                "text": "„Versprecher sind am sprecherspezifischen Sprachsystem zu messen.“"
                            },
                            {
                                "example_id": "d1957af8-8751-4446-be2a-669c47fbaf09",
                                "sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                                "text": "„Druckfehler entstehen jedoch nicht einfach nur durch einen technisch-mechanischen Fehler, sondern sie sind wie oft beim Versprechen oder Verhören auch sinnvolle Versprecher im Sinne der Psychoanalyse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "987ab1a8-3aad-4cdf-8fde-449c074888fa",
                        "source_entry_id": "bd31ae39-9378-369c-acdd-f117dc58b70e",
                        "source_sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                        "source_sense_description": "Linguistik: (unbeabsichtigte) sprachliche Fehlleistung beim Sprechen",
                        "target_lang_word": "slip of the tongue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slip of the tongue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d59cd4f-ce3d-32da-8169-1c01f13a2689",
                                        "entry_id": "59efcd3a-f674-3979-99ab-694566bb8156",
                                        "glosses": [
                                            "A mistake in speech."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3cf152-fd5f-4699-ac21-27e557c54ad0",
                                                "sense_id": "9d59cd4f-ce3d-32da-8169-1c01f13a2689",
                                                "text": "It was an unfortunate slip of the tongue, and he did not intend it that way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61b06465-ac4d-4ea3-a150-d4bed1dfdf17",
                        "source_entry_id": "bd31ae39-9378-369c-acdd-f117dc58b70e",
                        "source_sense_id": "ae618ab3-c289-3c03-b59b-cec34374c198",
                        "source_sense_description": "Linguistik: (unbeabsichtigte) sprachliche Fehlleistung beim Sprechen",
                        "target_lang_word": "lapsus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapsus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                                        "entry_id": "19ab62f0-7db3-3763-9d88-0022b493a9a5",
                                        "glosses": [
                                            "Erreur involontaire qui fait dire à une personne autre chose que ce qu’elle avait prévu d’exprimer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b3d9a02-d095-4d33-b70d-db11e07b8b6b",
                                                "sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                                                "text": "Nous sommes foudroyés, dit-il. Il voulait dire « fourvoyés », mais c'était là un lapsus léger et que rendaient excusable, d'ailleurs, ces circonstances exceptionnelles."
                                            },
                                            {
                                                "example_id": "c7adf280-5ce4-4b90-bfc1-56450406d1d7",
                                                "sense_id": "3e0278c6-6c19-371a-9eef-12bd156ae969",
                                                "text": "Un lapsus, une faute de prononciation, le soufflet sur la joue d’un clown, peuvent créer un accès irrésistible avant qu’aucun couple comparatif de concepts ait eu le temps d’intervenir. Le rire a jailli avec la rapidité du réflexe ; il est souvent aussi véloce que le geste d’un instinct élémentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
