                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs monastères de la région appartenaient à la <w>filiation</w> directe de la grande abbaye de Cîteaux."
