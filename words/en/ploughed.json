                    "sense_definition": "simple past and past participle of <w>plough</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer <w>ploughed</w> the field before planting the wheat.",
                            "target_lang_translations": {
                                "de": "Der Bauer <w>pflügte</w> das Feld, bevor er den Weizen säte.",
                                "zh": "农民在种小麦前<w>耕</w>了地。",
                                "es": "El granjero <w>aró</w> el campo antes de sembrar el trigo.",
                                "tr": "Çiftçi buğdayı ekmeden önce tarlayı <w>sürdü</w>."
                            }
                        },
                        {
                            "text": "The tractor <w>ploughed</w> through the deep snow to clear the road.",
                            "target_lang_translations": {
                                "de": "Der Traktor <w>pflügte sich</w> durch den tiefen Schnee, um die Straße freizumachen.",
                                "zh": "拖拉机在厚厚的积雪中<w>开辟</w>出一条路来清理道路。",
                                "es": "El tractor <w>se abrió paso</w> a través de la nieve profunda para despejar la carretera.",
                                "tr": "Traktör yolu açmak için derin karların içinden <w>sürerek</w> geçti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ploughed the field",
                        "ploughed through snow"
                    ],
                    "target_lang_definitions": {
