                "senses": [
                    {
                        "sense_id": "60d9f8b3-dfd0-384e-9097-fd53d3f977c1",
                        "entry_id": "e80b679f-2f8b-3f75-a7e3-57ea3986797e",
                        "glosses": [
                            "An adherent of a religion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9871c87-6e20-4ca4-b174-4d25bc48adc5",
                                "sense_id": "60d9f8b3-dfd0-384e-9097-fd53d3f977c1",
                                "text": "How could Christians and other kinds of religionists justify being ruled by laws and rules, written and unwritten, that go against their faith?"
                            },
                            {
                                "example_id": "6c44b19a-503d-4fe2-a8a0-a32875c77dd5",
                                "sense_id": "60d9f8b3-dfd0-384e-9097-fd53d3f977c1",
                                "text": "With what astoundment would ye, if ye were alive with your merely human perfections, listen to the creed of our, so called, rational religionists!"
                            }
                        ]
                    },
                    {
                        "sense_id": "a707632a-2a09-3be8-913a-22b21f1a7098",
                        "entry_id": "e80b679f-2f8b-3f75-a7e3-57ea3986797e",
                        "glosses": [
                            "An adherent of a religion.",
                            "Especially, a religious zealot."
                        ],
                        "tags": [],
                        "examples": []
                    }
