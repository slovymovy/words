                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "Im Vergleich mit anderen Ländern Afrikas ist Togo ein Kleinstaat."
                                            },
                                            {
                                                "example_id": "e2c0fc40-94f1-432b-bb15-bd3493309091",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "Mein Onkel hat eine Farm in Togo und baut dort Hirse an."
                                            },
                                            {
                                                "example_id": "aee41cce-def3-4e75-b674-f3f68d12c9a7",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "Lomé ist die Hauptstadt von Togo."
                                            },
                                            {
                                                "example_id": "59da2ecc-9827-429b-8361-0307bcf32295",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "„Wie ich Togo überhaupt erreichen sollte, war mir schleierhaft.“"
                                            },
                                            {
                                                "example_id": "ba17150f-8d86-409f-84e9-d3416f3037f2",
                                                "sense_id": "a0560f98-25b3-3642-b727-5600fbc34b90",
                                                "text": "„Togo wurde ab 5.7.1884 deutsche Kolonie, die deutsche Post wurde am 1.3.1888 eröffnet.“"
                                            }
