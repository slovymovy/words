                                                "sense_id": "b26a7865-ec36-32d7-9a07-f2a666761307",
                                                "text": "But no state has voluntarily sought a statewide remedy to segregation in the 70 years since the Brown v. Board of Education decision outlawed government sanctioned, racially separate schools."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
