            {
                "entry_id": "c77a43d4-5e0e-38b3-b852-ab5aec97de5c",
                "word": "invalide",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6aea878a-2433-491a-b641-a38f19d4f679",
                        "entry_id": "c77a43d4-5e0e-38b3-b852-ab5aec97de5c",
                        "tags": [
