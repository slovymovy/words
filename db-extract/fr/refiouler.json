                "senses": [
                    {
                        "sense_id": "468bf4b5-d0b8-3a7c-9be4-f8f6a148d224",
                        "entry_id": "fe859009-0997-3017-9d57-3f2fc8e34a56",
                        "glosses": [
                            "Réapprovisionner un véhicule en carburant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb3fdca5-ff00-45ec-aa86-9c218f3cbb00",
                                "sense_id": "468bf4b5-d0b8-3a7c-9be4-f8f6a148d224",
                                "text": "Alors, tous les 250 km, aux premières lueurs des témoins de réserve, on refioule au sans plomb."
                            },
                            {
                                "example_id": "b66d8978-d9e4-44b8-8236-fb3d543e3c8a",
                                "sense_id": "468bf4b5-d0b8-3a7c-9be4-f8f6a148d224",
                                "text": "Sa consommation est faible (1,7 litre de gasoil au mille à 15 nœuds) et son autonomie (à 15 nœuds, 6 200 milles) est stupéfiante : on peut faire un aller-retour Brest-New York sans refiouler."
                            },
                            {
                                "example_id": "d53d6cae-9e1a-4e02-9aec-69ed0fef417c",
                                "sense_id": "468bf4b5-d0b8-3a7c-9be4-f8f6a148d224",
                                "text": "Pour refiouler en mazout, le jet privé ayant servi à l’évasion de Carlos GHOSN aurait transité par l’aéroport international de Lifou."
                            },
                            {
                                "example_id": "b1f3f55e-621d-4945-a687-279fd5f8ef29",
                                "sense_id": "468bf4b5-d0b8-3a7c-9be4-f8f6a148d224",
                                "text": "je rentrais juste en réserve (de mon premier plein en Corse), je \"refioule\" et là le problème disparait."
                            }
                        ]
                    }
                ],
