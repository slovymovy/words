                    {
                        "translation_id": "7dd616ce-3213-4514-8bba-419f599e3ff8",
                        "source_entry_id": "5890e12f-6230-313f-8cd8-9482bd005326",
                        "source_sense_id": "459b849c-c3f0-3847-bc3f-bcee3a4f6bd3",
