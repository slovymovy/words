                "senses": [
                    {
                        "sense_id": "61834b37-8163-3135-87bc-622927445517",
                        "entry_id": "c4becf05-d188-3f6f-b367-6829b342f58c",
                        "glosses": [
                            "zoals hoort bij een koning, royaal, groots, rijkelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb0aa42-ab9c-4107-bde2-e3cfdfdf0e29",
                                "sense_id": "61834b37-8163-3135-87bc-622927445517",
                                "text": "De direkteur kreeg een vorstelijke belonging voor zijn werk."
                            },
                            {
                                "example_id": "b3b83990-a501-4b4f-911d-b08564eec54e",
                                "sense_id": "61834b37-8163-3135-87bc-622927445517",
                                "text": "De bediende wil de alleen maar buigen voor vorstelijke personen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "339170b3-1bc2-4670-a3ad-ea7f878e6340",
                        "source_entry_id": "c4becf05-d188-3f6f-b367-6829b342f58c",
                        "source_sense_id": "61834b37-8163-3135-87bc-622927445517",
                        "target_lang_word": "regal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff8eba5-0bad-30d6-8198-0bf6657072fb",
                                        "entry_id": "bb8310c4-613b-3a8d-83fe-57e7a91ec574",
                                        "glosses": [
                                            "Of, pertaining to, or suitable for royalty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb5ff63-1633-4b15-81c6-37dbca3cf759",
                                                "sense_id": "8ff8eba5-0bad-30d6-8198-0bf6657072fb",
                                                "text": "regal authority"
                                            },
                                            {
                                                "example_id": "bdf10261-eff9-4c4c-8cc5-05363d08d05a",
                                                "sense_id": "8ff8eba5-0bad-30d6-8198-0bf6657072fb",
                                                "text": "the regal title"
                                            },
                                            {
                                                "example_id": "4f979fa6-7171-4f6c-bdfd-64776ea46a36",
                                                "sense_id": "8ff8eba5-0bad-30d6-8198-0bf6657072fb",
                                                "text": "He made a scorn of his regal oath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0639fd7c-a56e-3243-aa95-c419ee7e847b",
                                        "entry_id": "bb8310c4-613b-3a8d-83fe-57e7a91ec574",
                                        "glosses": [
                                            "Befitting a monarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d79f96e-0223-4e77-b86e-f656c71346a9",
                                                "sense_id": "0639fd7c-a56e-3243-aa95-c419ee7e847b",
                                                "text": "The [Washington] Posts proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal' Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                                            },
                                            {
                                                "example_id": "f5ce10fd-72b2-4585-b7f9-60b0c5eb99de",
                                                "sense_id": "0639fd7c-a56e-3243-aa95-c419ee7e847b",
                                                "text": "Terrific movement from The Queen here. Gets behind the defender, goes one way then cuts back inside. Regal attacking play."
                                            },
                                            {
                                                "example_id": "57ed46da-9371-46b1-91be-7255c5437952",
                                                "sense_id": "0639fd7c-a56e-3243-aa95-c419ee7e847b",
                                                "text": "Kwarteng said he had urged Truss to “slow down” over reforms, but a cabinet minister told the FT that she felt “invincible, almost regal”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "374457c6-0881-32cd-9939-3ed3286eeee2",
                                        "entry_id": "bb8310c4-613b-3a8d-83fe-57e7a91ec574",
                                        "glosses": [
                                            "Befitting a monarch.",
                                            "Befitting a king or emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5d4220-dff7-4145-b409-593e0d17cd95",
                                                "sense_id": "374457c6-0881-32cd-9939-3ed3286eeee2",
                                                "text": "The children to whom I acted as cicerone almost screamed with glee as they saw the four-and-twenty blackbirds emerging from the pie-crust in front of the astonished King; and when the climax of the inconsequential story was reached, by way of the regal counting house and the “reginal” parlour, and a blackbird (presumably one of the four-and-twenty that had been temporarily immured in the pie) was seen about to revenge himself on the innocent nose of the guiltless laundry-maid, a veritable climax of enthusiasm was reached."
                                            },
                                            {
                                                "example_id": "61d7ae44-3e7f-4d45-98d5-2dbac7443d71",
                                                "sense_id": "374457c6-0881-32cd-9939-3ed3286eeee2",
                                                "text": "The crown seals, a regal crown and a reginal crown are unengraved, but from the motif I judge they symbolize King William III of England and Queen Mary, (see 1688, English History) who formerly ruled Holland as Prince William, Consort, and Queen Mary — The House of Orange."
                                            },
                                            {
                                                "example_id": "a203e046-28b7-4ec1-b6a3-7340e046d427",
                                                "sense_id": "374457c6-0881-32cd-9939-3ed3286eeee2",
                                                "text": "In any case, the discrepancy might be explained by the fact that the 9th pylon has not yet disgorged all it blocks; it is in the talatat from this pylon that the masonry of the essentially regal (as opposed to reginal) temples Tni-mnw and Rwd-mnw predominate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "regal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9ba87f6-f2bf-3d65-8eab-f8099f4b26c0",
                                        "entry_id": "edad0bcd-456e-36c3-9800-c03a5cdad8fe",
                                        "glosses": [
                                            "A small, portable organ whose sound is produced by brass beating reeds without amplifying resonators. Its tone is keen and rich in harmonics. The regal was common in the 16th and 17th centuries, and has been revived for the performance of music from those times."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b48253f5-8f90-3a48-a3ba-9f758cd7217a",
                                        "entry_id": "edad0bcd-456e-36c3-9800-c03a5cdad8fe",
                                        "glosses": [
                                            "An organ stop of the reed family, furnished with a normal beating reed, but whose resonator is a fraction of its natural length. In the 16th and 17th centuries these stops took a multitude of forms. Today only one survives that is of universal currency, the so-called vox humana."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d267a33b-a1cb-47ea-abaa-252445fb2b1d",
                        "source_entry_id": "c4becf05-d188-3f6f-b367-6829b342f58c",
                        "source_sense_id": "61834b37-8163-3135-87bc-622927445517",
                        "target_lang_word": "royal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "royal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65da7e00-7b2c-3ec3-ae6e-3a3c28a76c41",
                                        "entry_id": "7f30d447-38b8-3831-82ff-05caab457c20",
                                        "glosses": [
                                            "Of or relating to a monarch or his (or her) family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60fcfc9d-5e22-4011-9595-17a42c4b12ec",
                                                "sense_id": "65da7e00-7b2c-3ec3-ae6e-3a3c28a76c41",
                                                "text": "He tried to persuade Cicely to stay away from the ball-room for a fourth dance. […] But she said she must go back, and when they joined the crowd again her partner was haled off with a frightened look to the royal circle, […]"
                                            },
                                            {
                                                "example_id": "85a3a0ea-fd97-4903-9916-94d493a755dc",
                                                "sense_id": "65da7e00-7b2c-3ec3-ae6e-3a3c28a76c41",
                                                "text": "On the first Friday morning of his kingship he went into the kitchen and called for his royal chef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b4fc34-1a99-365b-9c99-c2b1860cfa13",
                                        "entry_id": "7f30d447-38b8-3831-82ff-05caab457c20",
                                        "glosses": [
                                            "Having the air or demeanour of a monarch; illustrious; magnanimous; of more than common size or excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2186f33-5aff-4311-bed3-2ab88f8c109f",
                                                "sense_id": "e7b4fc34-1a99-365b-9c99-c2b1860cfa13",
                                                "text": "How doth that royal Merchant good Anthonio;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c24c06e4-8000-34ca-a3f6-40bb6885b2aa",
                                        "entry_id": "7f30d447-38b8-3831-82ff-05caab457c20",
                                        "glosses": [
                                            "In large sailing ships, of a mast right above the topgallant mast and its sails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c7984dc-e77c-4b76-a2eb-0c896cedb53c",
                                                "sense_id": "c24c06e4-8000-34ca-a3f6-40bb6885b2aa",
                                                "text": "royal mast;  royal sail"
                                            }
                                        ]
                                    },
                                    {
