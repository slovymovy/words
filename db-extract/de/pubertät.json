                ],
                "senses": [
                    {
                        "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                        "entry_id": "1b98145a-ecb0-3bf4-b26e-21f2e06a85d3",
                        "glosses": [
                            "biologische Übergangsphase des Menschen, in der der Mensch mit diversen Verhaltensweisen und körperlichen Veränderungen aus dem Kinds- zum Erwachsenenstadium wechselt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dcc5a6d-42fb-4d67-9ddb-b19b9238fbb8",
                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                "text": "In der Pubertät kommen die Jugendlichen auf die außergewöhnlichsten Gedanken und stellen alles in Frage."
                            },
                            {
                                "example_id": "7df50769-4a43-4cdf-a68c-5fb318859a50",
                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                "text": "„Es naht der Zeitpunkt, da unsere Tochter in die Pubertät kommt.“"
                            },
                            {
                                "example_id": "9477b59d-a78f-4685-9785-226c3393344a",
                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                "text": "„Die Pubertät hatte früh bei ihm eingesetzt.“"
                            },
                            {
                                "example_id": "0670773f-37e6-4930-a6e4-9bef3935d174",
                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                "text": "„Die waren schon in der Pubertät.“"
                            },
                            {
                                "example_id": "c576b119-37c4-481a-a7d2-5f901f2c5bd0",
                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                "text": "„Was sicherlich daran liegt, dass ich meine Pubertät in Deutschland verbracht habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af66c4bb-0b19-47fb-a9ff-4132dac5911d",
                        "source_entry_id": "1b98145a-ecb0-3bf4-b26e-21f2e06a85d3",
                        "source_sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                        "source_sense_description": "Übergangsphase des Menschen vom Kind zum Erwachsenen",
                        "target_lang_word": "puberty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puberty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b067837-2665-305b-81d6-35dc79331910",
                                        "entry_id": "28ab4cf2-f314-3d8f-bdb0-d1804acb7377",
                                        "glosses": [
                                            "A developmental phase brought about by the action of hormones as part of the maturing process. For humans, there are three in total."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff2ec203-713c-4c20-a67d-0cf11f27196e",
                                                "sense_id": "1b067837-2665-305b-81d6-35dc79331910",
                                                "text": "Girls undergoing puberty show an increase in the total output of cortisol, which is related to stress, while boys show little increase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b09ff8b-22ce-38c4-9317-57b9a1f17355",
                                        "entry_id": "28ab4cf2-f314-3d8f-bdb0-d1804acb7377",
                                        "glosses": [
                                            "A developmental phase brought about by the action of hormones as part of the maturing process. For humans, there are three in total.",
                                            "The process of sexual development that produces secondary sex characteristics and makes a person capable of reproducing sexually."
                                        ],
                                        "tags": [
                                            "common",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2706bd93-10ca-3d96-ae69-8c1aff290cc8",
                                        "entry_id": "28ab4cf2-f314-3d8f-bdb0-d1804acb7377",
                                        "glosses": [
                                            "The age at which a person is first capable of sexual reproduction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332dcda5-1278-4c72-be0b-ae3df6cdf778",
                                                "sense_id": "2706bd93-10ca-3d96-ae69-8c1aff290cc8",
                                                "text": "As shown in Figure 14.4 of the textbook, children reach puberty at different ages in different countries; within those nations, children living in cities tend to reach puberty earlier than those living in rural areas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556dbac3-30e7-3d9d-9939-f32047303a08",
                                        "entry_id": "28ab4cf2-f314-3d8f-bdb0-d1804acb7377",
                                        "glosses": [
                                            "The period when a plant begins to flower."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fd2a576-6d07-440d-a881-1409a1fe6870",
                        "source_entry_id": "1b98145a-ecb0-3bf4-b26e-21f2e06a85d3",
                        "source_sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                        "source_sense_description": "Übergangsphase des Menschen vom Kind zum Erwachsenen",
                        "target_lang_word": "puberté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puberté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea53513-ead6-3b07-b611-b830b5edf32d",
                                        "entry_id": "65c4e7ff-67c0-31c8-9b31-27ebf25cc21e",
                                        "glosses": [
                                            "État des filles et des garçons qui sont en âge d’avoir une relation sexuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8370ee5-ea7c-44fd-a0cf-24cb4a5d1d23",
                                                "sense_id": "7ea53513-ead6-3b07-b611-b830b5edf32d",
                                                "text": "Le jeune bourgeois, au grand déplaisir de ses père et autres parents plus ou moins naturels, doit aujourd’hui dépenser de l’argent pour tuer le temps qui s’écoule entre la puberté et le mariage."
                                            },
                                            {
                                                "example_id": "0bdbd561-6bf3-40aa-a0c5-465ee2310897",
                                                "sense_id": "7ea53513-ead6-3b07-b611-b830b5edf32d",
                                                "text": "Victor. — J’ai montré ça au médecin qui a quitté l’hôtel ce matin, il m’a dit : \"Mon petit, c’est la puberté.\"\nArmandine, assise sur le canapé. — La puberté ! Qu’est-ce que c’est que ça, la puberté ?\nVictor. — Je ne sais pas ! Mais il paraît que j’ai l’âge d’aimer… Ah ! je m’en apercevais bien que c’est la sève qui me travaille."
                                            },
                                            {
                                                "example_id": "9d3d7fa4-f873-4416-bdb7-3602f7669b65",
                                                "sense_id": "7ea53513-ead6-3b07-b611-b830b5edf32d",
                                                "text": "Il me dit qu'il la connaissait depuis bien longtemps, elle et ses amies, bien avant qu'elles eussent atteint « l'âge de la pureté », mais qu'il leur en voulait de choses qu'elles avaient dites de l'hôtel. « Il faut qu'elles ne soient pas bien “illustrées” pour causer ainsi. À moins qu'on ne les ait calomniées. » Je compris aisément que « pureté » était dit pour « puberté »."
                                            },
                                            {
                                                "example_id": "e1565ef7-9be6-4cec-8594-fd89d4c78ee0",
                                                "sense_id": "7ea53513-ead6-3b07-b611-b830b5edf32d",
                                                "text": "Jeune, je me passionnai pour ces aventures fabuleuses où grouille un peuple d’enchanteurs, de dames inégalement chastes et de chevaliers, en même temps que me remuaient au bas-ventre les troubles de la puberté."
                                            },
                                            {
                                                "example_id": "532162e8-dfeb-4fd1-8c93-0c13075ae334",
                                                "sense_id": "7ea53513-ead6-3b07-b611-b830b5edf32d",
                                                "text": "Qu’y a-t-il Héloïse ?\n Le prénom familier rompait l’envoûtement, conjurait le péril. Il la rejetait vers l’enfance, niait sa flamboyante puberté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67ea11f5-9acc-3004-bc94-3555325efecf",
                                        "entry_id": "65c4e7ff-67c0-31c8-9b31-27ebf25cc21e",
                                        "glosses": [
                                            "État de la nature qui s'éveille au printemps."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b24be5-0d0a-4e4a-9173-de00267d13c8",
                                                "sense_id": "67ea11f5-9acc-3004-bc94-3555325efecf",
                                                "text": "Je marchais rapidement, pénétré et comme stimulé par ce bain de lumière, par ces odeurs de végétations naissantes, par ce vif courant de puberté printanière dont l’atmosphère était imprégnée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
