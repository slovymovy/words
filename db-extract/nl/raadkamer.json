                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe135431-6fb9-4a0c-bfa3-eed6357c94b9",
                                "sense_id": "86f063e3-9297-38a7-9e2e-7a9c4c65b626",
                                "text": "De drie verdachten in het dossier over de treinramp in Buizingen, een treinchauffeur, Infrabel en de NMBS, zullen zich voor de politierechtbank moeten verantwoorden. Dat heeft de Brusselse raadkamer vrijdag beslist."
                            },
                            {
                                "example_id": "822f081e-1f23-4759-abe7-066fad3eae70",
                                "sense_id": "86f063e3-9297-38a7-9e2e-7a9c4c65b626",
                                "text": "De man die deze winter in het station Gent Sint-Pieters door de politie werd neergeschoten met een mes, wordt geïnterneerd. Dat heeft de correctionele raadkamer vanochtend beslist."
                            }
                        ]
                    }
