                {
                    "sense_id": "a8ef5120-6b1a-37df-90ff-52d84a0749c1",
                    "sense_definition": "Een klein papiertje met aantekeningen dat stiekem wordt gebruikt om te spieken tijdens een examen of toets.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onderwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar nam het <w>spiekbriefje</w> in beslag toen hij zag dat de leerling onder zijn tafel keek.",
                            "target_lang_translations": {
                                "en": "The teacher confiscated the <w>cheat sheet</w> when he saw the student looking under his desk."
                            }
                        },
                        {
                            "text": "Hij had een klein <w>spiekbriefje</w> gemaakt met alle moeilijke formules voor het wiskunde-examen.",
                            "target_lang_translations": {
                                "en": "He had made a small <w>cheat sheet</w> with all the difficult formulas for the math exam."
                            }
                        }
                    ],
                    "synonyms": [
