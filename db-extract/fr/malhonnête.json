                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f4a20cf-c951-3e8c-97fc-024aada0dc30",
                        "entry_id": "7e93fcd9-9b28-3b71-832b-1af2e5081c46",
                        "glosses": [
                            "Qui manque d’honnêteté, qui est contraire à l’honneur, à la probité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "015cb2af-2f44-4c13-bd97-5cb8dd8993ab",
                                "sense_id": "7f4a20cf-c951-3e8c-97fc-024aada0dc30",
                                "text": "Il a eu avec moi un procédé malhonnête."
                            },
                            {
                                "example_id": "0628767d-21dc-4f24-91c9-ef1bbce6bf2f",
                                "sense_id": "7f4a20cf-c951-3e8c-97fc-024aada0dc30",
                                "text": "Cette action est d’un malhonnête homme."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f6d05a9-5084-3f84-8a62-e3750afcafab",
                        "entry_id": "7e93fcd9-9b28-3b71-832b-1af2e5081c46",
                        "glosses": [
                            "Qui est contraire à la civilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a440f940-c0fc-4d41-963c-429a123a1b55",
                                "sense_id": "6f6d05a9-5084-3f84-8a62-e3750afcafab",
                                "text": "Voilà un enfant bien malhonnête."
                            },
                            {
                                "example_id": "0565e95a-289c-4c19-88bd-6f2c1ef92b34",
                                "sense_id": "6f6d05a9-5084-3f84-8a62-e3750afcafab",
                                "text": "Il a un ton malhonnête, des manières malhonnêtes. Dans ce sens, il suit généralement les noms de personnes auxquels on le joint ; dans le premier sens, au contraire, il les précède ordinairement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c79fde1-e850-457a-9de3-03495ea14ffb",
                        "source_entry_id": "7e93fcd9-9b28-3b71-832b-1af2e5081c46",
