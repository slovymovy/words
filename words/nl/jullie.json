        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "d4b44f9b-3b8d-32e8-82eb-eaa0207146ed",
                    "sense_definition": "Geeft aan dat iets toebehoort aan de personen tegen wie men spreekt (meervoud).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jullie</w> leraar is vandaag helaas ziek.",
                            "target_lang_translations": {
                                "en": "<w>Your</w> teacher is unfortunately sick today.",
                                "ru": "<w>Ваш</w> учитель, к сожалению, сегодня болен.",
                                "pl": "<w>Wasz</w> nauczyciel jest dzisiaj niestety chory.",
                                "de": "<w>Euer</w> Lehrer ist heute leider krank.",
                                "fr": "<w>Votre</w> enseignant est malheureusement malade aujourd'hui.",
                                "it": "Il <w>vostro</w> insegnante purtroppo oggi è malato.",
                                "cs": "<w>Váš</w> učitel je dnes bohužel nemocný.",
                                "tr": "<w>Sizin</w> öğretmeniniz bugün maalesef hasta.",
                                "es": "<w>Vuestro</w> profesor lamentablemente está enfermo hoy."
                            }
                        },
                        {
                            "text": "Ik ben erg benieuwd naar <w>jullie</w> mening over dit onderwerp.",
                            "target_lang_translations": {
                                "en": "I am very curious about <w>your</w> opinion on this subject.",
                                "ru": "Мне очень интересно <w>ваше</w> мнение по этому вопросу.",
                                "pl": "Jestem bardzo ciekawy <w>waszej</w> opinii na ten temat.",
                                "de": "Ich bin sehr gespannt auf <w>eure</w> Meinung zu diesem Thema.",
                                "fr": "Je suis très curieux de connaître <w>votre</w> avis sur ce sujet.",
                                "it": "Sono molto curioso di conoscere la <w>vostra</w> opinione su questo argomento.",
                                "cs": "Jsem velmi zvědavý na <w>váš</w> názor na toto téma.",
                                "tr": "Bu konu hakkındaki <w>sizin</w> fikrinizi çok merak ediyorum.",
                                "es": "Tengo mucha curiosidad por saber <w>vuestra</w> opinión sobre este tema."
                            }
                        }
                    ],
                    "antonyms": [
                        "onze",
                        "hun"
                    ],
                    "common_phrases": [
                        "jullie huis",
                        "jullie mening",
                        "jullie beurt",
                        "jullie ouders"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates that something belongs to the people spoken to (plural).",
                        "ru": "Указывает на принадлежность чего-либо людям, к которым обращаются (во множественном числе).",
                        "pl": "Wskazuje, że coś należy do osób, do których się mówi (w liczbie mnogiej).",
                        "de": "Gibt an, dass etwas den Personen gehört, zu denen man spricht (Plural).",
                        "fr": "Indique que quelque chose appartient aux personnes à qui l'on s'adresse (au pluriel).",
                        "it": "Indica che qualcosa appartiene alle persone a cui ci si rivolge (plurale).",
                        "cs": "Označuje, že něco patří osobám, ke kterým se mluví (množné číslo).",
                        "tr": "Bir şeyin konuşulan kişilere (çoğul) ait olduğunu belirtir.",
                        "es": "Indica que algo pertenece a las personas a las que se habla (en plural)."
                    },
