                    "frequency": "High",
                    "semantic_group_id": "anwesenheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Arzt ist heute leider noch nicht <w>da</w>, kommen Sie bitte später wieder."
