                "senses": [
                    {
                        "sense_id": "a2977a18-e5d5-383f-aeff-f03544a6e3ef",
                        "entry_id": "10c6e7c7-2c9f-3f06-9564-9c3ffdb96e52",
                        "glosses": [
                            "Relatif aux Féroé et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86af2700-84de-43b4-a340-cd19577eea6a",
                                "sense_id": "a2977a18-e5d5-383f-aeff-f03544a6e3ef",
                                "text": "Rien d’ailleurs d’étonnant, ces sympathiques pêcheurs férengiens passant une partie de leur vie à gravir des murailles à pic pour chasser des oiseaux."
                            },
                            {
                                "example_id": "0459d5be-53c8-49b5-acde-3ac9a5e4473b",
                                "sense_id": "a2977a18-e5d5-383f-aeff-f03544a6e3ef",
                                "text": "« Hier, il y a eu deux grind l’un avec 266 prises et l’autre 180 selon le premier bilan », a dit à l’AFP un porte-parole du gouvernement féringien."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ee2c79b-c003-3485-96ce-ed8645e5a948",
                        "entry_id": "10c6e7c7-2c9f-3f06-9564-9c3ffdb96e52",
                        "glosses": [
                            "Relatif à la langue parlée sur les îles Féroé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa544dc-cb8f-4636-b232-dcdb4a8b68a1",
                                "sense_id": "6ee2c79b-c003-3485-96ce-ed8645e5a948",
                                "text": "L’alphabet féringien présente certaines lettres qui n’existent pas en français : le ð est muet, le ø se prononce « eu »."
                            }
                        ]
                    }
                ],
