                        "cross_references": [
                            {
                                "target_word": "gens de mer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cda53210-ba49-373e-afb1-282ace2f72db",
                                        "entry_id": "6a2a68a0-5e63-34b9-86d0-9cf50f0532c5",
                                        "glosses": [
                                            "Pluriel d’homme de mer et de femme de mer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aca355fa-2ef2-460f-8645-1c303818197f",
                                                "sense_id": "cda53210-ba49-373e-afb1-282ace2f72db",
                                                "text": "À ce titre, elle était d’ailleurs la première femme à avoir occupé cette fonction au sein de l’historique société des gens de mer fondée en 1861 : « Cette place, je la dois à Jacques Poulain», confiait-elle au moment de son élection."
                                            }
