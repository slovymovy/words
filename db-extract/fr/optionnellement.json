                    {
                        "sense_id": "05168117-3a80-355f-89ba-10f2a70e84d3",
                        "entry_id": "abde3d13-cd62-3e29-96ac-15609135340d",
                        "glosses": [
                            "De manière optionnelle."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9645ec62-b93f-46dc-87d2-2dfe257ca3d8",
                                "sense_id": "05168117-3a80-355f-89ba-10f2a70e84d3",
                                "text": "La question qui se pose est de savoir comment employer un pluriel optionnellement au sens d’un singulier"
                            },
                            {
                                "example_id": "a817cf4b-7046-426a-a70f-46af8147eb40",
                                "sense_id": "05168117-3a80-355f-89ba-10f2a70e84d3",
                                "text": "Façon d'être, mode de vie, philosophie du geek ou de la geekette, qui implique une dévotion quasi fanatique aux nouvelles technologies, et optionnellement une addiction aux meuporgs et une connaissance encyclopédique de tous les personnages secondaires de Star Wars ou du Seigneur des anneaux."
                            },
                            {
                                "example_id": "7f47966e-07c1-4e48-a378-03e4a66498ee",
                                "sense_id": "05168117-3a80-355f-89ba-10f2a70e84d3",
                                "text": "Le serveur peut optionnellement envoyer une requête au client lui demandant de s’authentifier"
                            }
                        ]
                    }
                ],
