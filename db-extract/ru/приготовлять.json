                                        "glosses": [
                                            "etwas, jemanden oder sich selbst einer Voraussicht oder Zukunftserwartung anpassen; so ändern, dass es sich bei den erwarteten Ereignissen positiv auswirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16343ef9-2449-4507-a97c-e8bbad4291b9",
                                                "sense_id": "4582f8da-cca2-35a6-93ae-9e487872c514",
                                                "text": "Ich muss mich noch auf die morgige Prüfung vorbereiten."
                                            },
                                            {
                                                "example_id": "e09c0a4b-e5c9-4b67-a23e-43abae6c68a3",
                                                "sense_id": "4582f8da-cca2-35a6-93ae-9e487872c514",
                                                "text": "Wir haben das Haus auf den kommenden Sturm bereits vorbereitet."
                                            },
                                            {
                                                "example_id": "a9abcefb-07cb-4072-a79f-74250eeb28e4",
                                                "sense_id": "4582f8da-cca2-35a6-93ae-9e487872c514",
                                                "text": "„Das Team bereitet derzeit eine Veröffentlichung in einem Fachmagazin vor.“"
                                            }
