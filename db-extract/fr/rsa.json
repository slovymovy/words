            {
                "entry_id": "69a41f75-b259-3372-ae68-45b9318d38d8",
                "word": "RSA",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a0f6c5d6-30df-3b1c-ba6f-bbdd6429ce28",
                        "entry_id": "69a41f75-b259-3372-ae68-45b9318d38d8",
                        "glosses": [
                            "Prestation sociale destinée à garantir à ses bénéficiaires qu’ils aient ou non la capacité de travailler, un revenu minimum, avec en contrepartie une obligation de chercher un emploi ou de définir et suivre un projet professionnel visant à améliorer sa situation financière."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "fc1f46cd-89d5-41a6-a5ee-b1cc269c9692",
                                "sense_id": "a0f6c5d6-30df-3b1c-ba6f-bbdd6429ce28",
                                "text": "Le RSA est une mini bouée de sauvetage qui peut permettre de refuser ces pures conditions d’exploitation, et c’est exactement pour ça qu’il est attaqué, comme l’assurance chômage."
                            },
                            {
                                "example_id": "8557fb01-b3aa-46a4-9fac-6131533d6810",
                                "sense_id": "a0f6c5d6-30df-3b1c-ba6f-bbdd6429ce28",
                                "text": "Cette réforme prévoit la mise en place d’un système de contreparties pour les bénéficiaires du RSA."
                            },
                            {
                                "example_id": "391100a3-0380-43bb-83e4-b861329bc097",
                                "sense_id": "a0f6c5d6-30df-3b1c-ba6f-bbdd6429ce28",
                                "text": "Le chef du gouvernement a annoncé la suppression de l’allocation spécifique de solidarité (ASS) pour les chômeurs en fin de droits, qui basculeront au RSA."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
