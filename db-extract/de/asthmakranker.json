                "senses": [
                    {
                        "sense_id": "cde92137-7a17-38cb-847b-2609e519481a",
                        "entry_id": "b2e87eaa-129e-3983-a3d5-59304b1469ef",
                        "glosses": [
                            "Person, die an Asthma leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd9a1f0-8f35-49f0-840e-a12d557babd5",
                                "sense_id": "cde92137-7a17-38cb-847b-2609e519481a",
                                "text": "„Mir wurde bewusst, dass das Geflüster sich von jedem anderen Laut unterschied, den ich je gehört hatte: Trotz der eigentümlichen Reglosigkeit der von dem Schnurrbart verdeckten Lippen besaß es eine Kraft und eine Ausdauer, die erstaunlich waren für einen keuchenden Asthmakranken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13942724-3b0c-4215-98c9-eea728518e8e",
                        "source_entry_id": "b2e87eaa-129e-3983-a3d5-59304b1469ef",
