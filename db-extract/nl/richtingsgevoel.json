                        "examples": [
                            {
                                "example_id": "c1e339bc-ffd3-4062-a5d3-871eb8319695",
                                "sense_id": "b1d5c16a-714b-3732-9426-81288a6952fd",
                                "text": "Wat New Kim zo bijzonder maakt, is dat ze een goed richtingsgevoel heeft maar volgens experts ook een topduif is om mee te fokken. Ook de nakomelingen zullen naar verwachting in de toekomst veel geld opbrengen."
                            },
                            {
                                "example_id": "e198eabb-5ad0-4ace-97a0-316bd724c68d",
                                "sense_id": "b1d5c16a-714b-3732-9426-81288a6952fd",
                                "text": "\"Om het moeilijker te maken, kunnen de organisatoren de kinderen onderweg zelfs blinddoeken, of ze rijden rondjes om hun richtingsgevoel in de war te brengen.\""
                            }
