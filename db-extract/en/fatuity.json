                ],
                "senses": [
                    {
                        "sense_id": "af71f057-5492-3953-976e-ebcadcf4c5b3",
                        "entry_id": "d8c1329c-ffe2-3514-9be5-fabf1e75a473",
                        "glosses": [
                            "Weakness or imbecility of mind; stupidity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6dd91cc6-d14a-3f0f-8200-935a2a6613d3",
                        "entry_id": "d8c1329c-ffe2-3514-9be5-fabf1e75a473",
                        "glosses": [
                            "Something fatuous; a stupid idea or utterance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dde8a169-b3fd-4099-8dd5-5773a4c80063",
                                "sense_id": "6dd91cc6-d14a-3f0f-8200-935a2a6613d3",
                                "text": "Like Joel Miller’s friend, the Senior Wrangler, who bowed to the audience from his box at the play, because he and the king happened to enter the theatre at the same time, only with a fatuity by no means so agreeable to himself, poor Arthur Pendennis felt perfectly convinced that all England would remark the absence of his name from the examination-lists, and talk about his misfortune."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "563d19f0-c22d-49f0-a355-f73e44653fc2",
                        "source_entry_id": "d8c1329c-ffe2-3514-9be5-fabf1e75a473",
                        "source_sense_description": "imbecility of mind; stupidity",
                        "target_lang_word": "dwaasheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwaasheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3331c442-01c2-30e4-bea2-eca575db618c",
                                        "entry_id": "c8b1ff9b-3e05-3587-b742-5599c77b1091",
                                        "glosses": [
                                            "de toestand van dwaas zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08bc3b7a-068a-4ca4-a011-42b1a6020f90",
                                                "sense_id": "3331c442-01c2-30e4-bea2-eca575db618c",
                                                "text": "Dat is de dwaasheid gekroond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                        "entry_id": "c8b1ff9b-3e05-3587-b742-5599c77b1091",
                                        "glosses": [
                                            "een dwaze handeling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32fd4a6-7b3e-4a5f-a046-bf85d14c7054",
                                                "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                                "text": "Hij beging opnieuw dwaasheden, waarvoor hij zwaar gestraft werd."
                                            },
                                            {
                                                "example_id": "3185e904-8bf6-4c0d-bea0-0f5559cef445",
                                                "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                                "text": "Dit boek helpt ons om een kalmere, authentiekere, soms luchtigere relatie aan te gaan met de dwaasheden en obsessies van onze tijd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
