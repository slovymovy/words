                                        "entry_id": "c187693e-f1c8-30fe-ad9f-207286496be1",
                                        "glosses": [
                                            "To formulate plots or schemes; to plot, to scheme."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5199e421-de9c-35db-a189-b2343b4b48ec",
                                        "entry_id": "c187693e-f1c8-30fe-ad9f-207286496be1",
                                        "glosses": [
                                            "To work as an engineer."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3fcc61-b78c-4987-973d-84a099c99cd6",
                                                "sense_id": "5199e421-de9c-35db-a189-b2343b4b48ec",
                                                "text": "What of the grand tools with which we engineer, like kobolds and enchanters,—tunnelling Alps, canalling the American Isthmus, piercing the Arabian desert?"
                                            }
