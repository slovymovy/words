                        "glosses": [
                            "an den Staat für die Nutzung des Internets zu zahlende Abgabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837ff40f-73be-4f2b-aa63-f51b1e5893ea",
                                "sense_id": "a21fbfe1-b6cf-32ae-a812-329780df179c",
                                "text": "„EU-Kommissarin Neelie Kroes hat die von Ungarns Regierung geplante Internetsteuer als inakzeptabel bezeichnet.“"
                            },
                            {
                                "example_id": "27b02271-d7b1-4892-9872-fd3d3b640f76",
                                "sense_id": "a21fbfe1-b6cf-32ae-a812-329780df179c",
                                "text": "„Zur Finanzierung wird eine Neuregelung der Besteuerung, darunter beispielsweise eine Internetsteuer, in Erwägung gezogen.“"
                            },
                            {
                                "example_id": "a9b5a7bd-212c-4faf-993f-3fb606590259",
                                "sense_id": "a21fbfe1-b6cf-32ae-a812-329780df179c",
                                "text": "„Mehr als zehntausend Menschen haben am Sonntagabend in Budapest gegen die geplante Einführung einer Internetsteuer demonstriert.“"
                            }
                        ],
