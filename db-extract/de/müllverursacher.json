                        "glosses": [
                            "(männliche^☆) Person, die Müll verursacht hat; jemand, der die Schuld am angefallenen Müll trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "307e09c8-6ac3-4638-b6ba-c53e7e547482",
                                "sense_id": "33a1d924-f391-3928-9f75-08a4c5c5b0ca",
                                "text": "„Ist der Müllverursacher nicht ausfindig zu machen, zahlen alle“"
                            },
                            {
                                "example_id": "4dad60f1-6bac-4eff-9ed3-7207864ef438",
                                "sense_id": "33a1d924-f391-3928-9f75-08a4c5c5b0ca",
                                "text": "„Schwedische Umweltschützer wollen Müllverursacher vor Gericht zerren“"
                            },
                            {
                                "example_id": "3c542e62-3bc7-4a8e-8347-13a40a559179",
                                "sense_id": "33a1d924-f391-3928-9f75-08a4c5c5b0ca",
                                "text": "„Noch sind die westlichen Nationen (Spitzenreiter USA mit mehr als 730 Kilogramm Hausmüll pro Kopf) weltweit die Haupt-Müllverursacher.“"
                            },
                            {
                                "example_id": "d9bdc8b6-5f6b-410a-b96b-be8668aef683",
                                "sense_id": "33a1d924-f391-3928-9f75-08a4c5c5b0ca",
                                "text": "„Eigentlich sollten die größten Müllverursacher besondere Anstrengungen unternehmen, um ihre Abfälle nachhaltig zu nutzen, doch die Realität sieht anders aus.“"
                            }
                        ],
