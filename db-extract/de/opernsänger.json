                "senses": [
                    {
                        "sense_id": "c5b25e8d-517a-3454-83c7-982a51bb1b83",
                        "entry_id": "66342bd4-6bae-3ee5-991f-119587b4b80b",
                        "glosses": [
                            "Person, die vornehmlich Opern singt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "dc647902-4548-4f90-a782-6ca3a5fa27e2",
                                "sense_id": "c5b25e8d-517a-3454-83c7-982a51bb1b83",
                                "text": "„Der in Salzburg gebürtige Opernsänger Franz Mazura ist am Donnerstag im Alter von 95 Jahren nahe Mannheim gestorben.“"
                            },
                            {
                                "example_id": "9f603a7a-a46a-4bf5-ab4a-6d38f9ae723e",
                                "sense_id": "c5b25e8d-517a-3454-83c7-982a51bb1b83",
                                "text": "„Der österreichische Opernsänger Andreas Schager sammelt Geld, um 20.000 Bäume zu pflanzen – am liebsten in Wiesbaden.“"
                            },
                            {
                                "example_id": "76c91911-b5dd-420f-a54e-3e7ecd8194bc",
                                "sense_id": "c5b25e8d-517a-3454-83c7-982a51bb1b83",
                                "text": "„Acht Sängerinnen und eine Tänzerin hatten der Nachrichtenagentur AP berichtet, der Opernsänger und Dirigent habe sich ihnen unerwünscht sexuell genähert - dieses Verhalten sei lange ein offenes Geheimnis in der Opernwelt gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
