{
    "word_family": [
        "find",
        "finding",
        "found",
        "viewfinder",
        "rangefinder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f64716b9-a2a7-38aa-be56-2d4f547ec4f9",
                    "sense_definition": "A person who discovers or happens upon something, especially something lost or hidden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_discovering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>finder</w> of the lost wallet returned it to the police station immediately.",
                            "target_lang_translations": {
                                "ru": "<w>Нашедший</w> потерянный кошелек немедленно вернул его в полицейский участок."
                            }
                        },
                        {
                            "text": "In the game of <w>finders</w> keepers, the person who sees the item first gets to keep it.",
                            "target_lang_translations": {
                                "ru": "В игре «что <w>нашел</w>, то мое» вещь забирает тот, кто увидел ее первым."
                            }
                        }
                    ],
                    "synonyms": [
                        "discoverer"
                    ],
                    "antonyms": [
                        "loser"
                    ],
                    "common_phrases": [
                        "finders keepers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который находит что-либо, особенно потерянную или спрятанную вещь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нашедший",
                                "target_lang_sense_clarification": "тот, кто обнаружил предмет"
                            },
                            {
                                "target_lang_word": "находчик",
                                "target_lang_sense_clarification": "лицо, совершившее находку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c36aaa-0283-3e7f-9371-689c14f8ab39",
                    "sense_definition": "A small optical or electronic device on a camera or telescope used to locate a target or frame a shot.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "optical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked through the optical <w>finder</w> to make sure the mountain was centered in the photo.",
                            "target_lang_translations": {
                                "ru": "Он посмотрел в оптический <w>видоискатель</w>, чтобы убедиться, что гора находится в центре кадра."
                            }
                        },
                        {
                            "text": "The telescope has a small <w>finder</w> scope attached to help you locate stars more easily.",
                            "target_lang_translations": {
                                "ru": "К телескопу прикреплен небольшой <w>искатель</w>, помогающий легче находить звезды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "optical finder",
                        "finder scope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in compounds like viewfinder"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое оптическое или электронное устройство на камере или телескопе для поиска цели или кадрирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "видоискатель",
                                "target_lang_sense_clarification": "в фотоаппарате"
                            },
                            {
                                "target_lang_word": "искатель",
                                "target_lang_sense_clarification": "вспомогательный телескоп"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "affa4bbe-223c-3eca-93a1-d196986db691",
                    "sense_definition": "A person who makes a living by scavenging and picking up scraps or discarded items to sell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scavenger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street <w>finder</w> spent his mornings searching the market for metal scraps to sell.",
                            "target_lang_translations": {
                                "ru": "Уличный <w>сборщик утиля</w> проводил утро на рынке в поисках металлолома на продажу."
                            }
                        },
                        {
                            "text": "Historical accounts describe the <w>finder</w> as a common figure in the crowded city markets.",
                            "target_lang_translations": {
                                "ru": "Исторические отчеты описывают <w>тряпичника</w> как обычную фигуру на многолюдных городских рынках."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historically used for scavengers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, зарабатывающий на жизнь сбором и перепродажей отходов или выброшенных вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тряпичник",
                                "target_lang_sense_clarification": "собиратель старья"
                            },
                            {
                                "target_lang_word": "сборщик утиля",
                                "target_lang_sense_clarification": "человек, ищущий ценное в мусоре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "63345b94-2c6d-32fc-aa11-c7576f5bf9b9",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Mr. <w>Finder</w>, a prominent member of the community.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь мистера <w>Финдера</w>, видного члена общины."
                            }
                        },
                        {
                            "text": "She researched her family history and discovered that her ancestors used the name <w>Finder</w>.",
                            "target_lang_translations": {
                                "ru": "Она изучила историю своей семьи и обнаружила, что ее предки носили фамилию <w>Финдер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия немецкого происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Финдер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}