                "senses": [
                    {
                        "sense_id": "2785b5bd-3dbf-39bf-8e35-45b6eaaa7479",
                        "entry_id": "f7995acb-b7f1-37dc-816c-1124851e0327",
                        "glosses": [
                            "doortrokken met fijne aders of een fijne tekening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b97591-2986-4953-aa28-309ceb90be6e",
                                "sense_id": "2785b5bd-3dbf-39bf-8e35-45b6eaaa7479",
                                "text": "De woning van het echtpaar uit de jaren dertig is dooraderd met scheuren, het lijkt op een uitgedroogde rivierbedding. Dagelijks rijden meer dan tweehonderd treinen over het spoor en dat is de oorzaak voor de scheuren, aldus het echtpaar Moorman."
                            },
                            {
                                "example_id": "ff37303e-328d-4fe3-aa68-a604c17700b2",
                                "sense_id": "2785b5bd-3dbf-39bf-8e35-45b6eaaa7479",
                                "text": "Mijn grootste schat was een ovale, platte steen. Zijn groene gezicht was dooraderd met gouden lijntjes, als zijden draden in een wandtapijt."
                            }
                        ]
                    }
                ],
