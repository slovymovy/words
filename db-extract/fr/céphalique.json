                "senses": [
                    {
                        "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                        "entry_id": "89bf193b-4a6b-3f49-8e38-87822f7f5bad",
                        "glosses": [
                            "Qui a rapport à la tête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15184bb3-b03f-45da-8b80-d42670b9e91f",
                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                "text": "Toutes les parties de l’oranger, excepté les racines, sont fortifiantes, céphaliques, stomachiques, cordiales, anti-septiques ; les fleurs sont d'un fréquent usage, et les fruits sont très-sains lorsqu'ils sont bien mûrs."
                            },
                            {
                                "example_id": "f2d5ea6c-58b6-484c-9423-d7f2e9afd669",
                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                "text": "— Ah ! nous y voici, madame. Je suis un épicier, un boutiquier, un ancien débitant de pâte d’amande, d’eau de Portugal, d’huile céphalique, on doit me trouver bien honoré d’avoir marié ma fille unique au fils de monsieur le baron Hulot d’Ervy, ma fille sera baronne."
                            },
                            {
                                "example_id": "ec2a21c1-990d-45b6-9d3f-3f03cb6c00f5",
                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                "text": "Souffle céphalique, Léger souffle que l’on constate chez un nouveau-né."
                            },
                            {
                                "example_id": "76abbf7d-8f71-4fdb-b2cb-5dd8cff09a5d",
                                "sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                                "text": "Artère céphalique, Autre nom de l’artère carotide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41a65124-444c-4760-986b-19186a275bab",
                        "source_entry_id": "89bf193b-4a6b-3f49-8e38-87822f7f5bad",
                        "source_sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                        "target_lang_word": "Kopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "oberster beziehungsweise vorderster Körperteil eines Menschen oder Tieres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863ac925-18f7-4acd-9376-2eacba218b5f",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "„Während man jedoch beim Segelfliegen in einem kleinen Cockpit hockt, beim Gleitschirmfliegen in einem Sitz schaukelt, hängt der Drachenflieger unter der Tragfläche, Kopf voraus.“"
                                            },
                                            {
                                                "example_id": "8ea1530d-929e-409a-ac07-616d6903e45d",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "Der Hut ist zu groß für deinen Kopf."
                                            },
                                            {
                                                "example_id": "7ef6e99b-a9d5-47c0-809f-5705609b75dc",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "„Mein Kopf fühlte sich fast völlig leer an, und das war sicher das Beste.“"
                                            },
                                            {
                                                "example_id": "9770ff6b-cf7e-4e53-9135-3e8dae633936",
                                                "sense_id": "8316fb0d-4354-3b67-83cc-a7b46963572b",
                                                "text": "„Sie hob den Kopf, sie hörte jetzt selbst seine Stimme, das Gepolter auf der Treppe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "das oberste Mitglied einer Organisation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c43aa3d-42f8-4788-b46c-f61772abb9eb",
                                                "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                                "text": "Das ist der Kopf der Verbrecherbande."
                                            },
                                            {
                                                "example_id": "cee1056d-8a86-4aa3-a537-0432a1154c09",
                                                "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                                "text": "„Ihr Kopf sitzt in Monrovia im benachbarten Liberia und heißt Charles Taylor, von Beruf Präsident und Kriegsverbrecher.“"
                                            },
                                            {
                                                "example_id": "d15a8bed-bf64-4e09-8945-b899fbcda0ad",
                                                "sense_id": "1b03ed9c-ba8a-3f7a-af3f-d62ed4d552c6",
                                                "text": "„Wichtige Köpfe dieser Bewegung waren Maqbool Butt (1984 in Delhi hingerichtet) sowie Amanullah Khan und Yasin Malik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2d4147f3-c337-39ce-bf9c-98d80d0c6068",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "Wuchsform von Gemüsepflanzen wie dem Kohl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034374e6-a813-4d7e-89f0-52f3d4899d56",
                                                "sense_id": "2d4147f3-c337-39ce-bf9c-98d80d0c6068",
                                                "text": "Ich habe einen Kopf Wirsing gekauft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0aa9d9e1-c2df-3868-978c-6d7aad5e6a44",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "stumpfes Ende von Nägeln, Schrauben, Nadeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ceaacb-3004-46a4-94a5-02443619de8f",
                                                "sense_id": "0aa9d9e1-c2df-3868-978c-6d7aad5e6a44",
                                                "text": "Durch den Kopf einer Stricknadel zieht man den Faden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "cc33fab9-1e5d-3412-b0c8-ee83a65b1bef",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "runder Teil einer Note in der Musik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b0e707-01c1-47eb-857b-64ea1a7e14f5",
                                                "sense_id": "cc33fab9-1e5d-3412-b0c8-ee83a65b1bef",
                                                "text": "Eine ganze Note besteht nur aus dem Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0f1193af-a6f6-3212-ad9e-05608e193979",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "Ende eines Werkzeuges wie eines Hammers oder Schlägels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c2c71e-d39a-4fdc-a93d-f3acd5259344",
                                                "sense_id": "0f1193af-a6f6-3212-ad9e-05608e193979",
                                                "text": "Dieser Hammer hat einen schwereren Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8c54d500-fdc4-3440-9ab8-c205f393de43",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "oberer, vom übrigen Text getrennter Teil einer beschriebenen Seite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3910b89b-8e62-4c5e-8d7e-7a7b215bce3f",
                                                "sense_id": "8c54d500-fdc4-3440-9ab8-c205f393de43",
                                                "text": "Im Kopf des Briefes stand die falsche Adresse."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "33962215-3065-3145-b5c8-82b313d72318",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "jene Seite einer Münze, die eine Abbildung einer Person zeigt"
                                        ],
                                        "tags": [
                                            "Münzwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045f4a4e-41ae-4342-9a5e-cbfec09bca23",
                                                "sense_id": "33962215-3065-3145-b5c8-82b313d72318",
                                                "text": "Lass uns eine Münze werfen; was wählst du, Zahl oder Kopf?"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "b33025ff-c802-3b1e-876d-52e1cc4991fd",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "Bauteil, Gerät, Maschinenteil, das aufgesetzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "828e63c8-a39e-48e4-b8f1-6b44959bd279",
                                                "sense_id": "b33025ff-c802-3b1e-876d-52e1cc4991fd",
                                                "text": "Wir müssen nur noch den Kopf montieren, dann sind wir fertig."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "oberster Teil eines dreieckigen Segels"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f811c8-a667-4758-b53a-1af09fdddeaa",
                                                "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                                "text": "Der Kopf wird meist verstärkt durch ein Brett aus Kunststoff oder Aluminium."
                                            },
                                            {
                                                "example_id": "c7f94487-d4e7-4b10-bbfd-1f684ce96448",
                                                "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                                "text": "„Ein Groß mit horizontalem statt spitz zulaufendem Kopf – das war bisher konventionellen Riggs vorbehalten.“"
                                            },
                                            {
                                                "example_id": "edf66ac6-0170-46f6-8052-5575a244d7a1",
                                                "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                                "text": "„Obwohl es üblich ist, das Vorsegel »irgendwie« in seinen Sack zu stopfen, wenn nur der Kopf obenauf liegt, sollte man das Segel lieber vom Kopf zum Hals hin einrollen, wenn es für längere Zeit weggestaut bleiben soll. So vermeidet man Knicke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d01c388-cfd0-484f-adff-e0fd57d931de",
                        "source_entry_id": "89bf193b-4a6b-3f49-8e38-87822f7f5bad",
                        "source_sense_id": "9df5ef3d-d1b1-3344-bf4b-3b09f1edd59b",
                        "target_lang_word": "cephalic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cephalic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96d4aefd-4204-3998-aa3c-29e21cc9be36",
                                        "entry_id": "63f0129f-9808-323e-949b-a4dd475db86f",
                                        "glosses": [
                                            "Of or relating to the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6d5831-faec-453d-b78a-2400935867ef",
                                                "sense_id": "96d4aefd-4204-3998-aa3c-29e21cc9be36",
                                                "text": "The objective of this study was to identify the factors predictive of the success of external cephalic version (ECV). […] The study shows that transverse foetal presentation, a senior physician operator, multiparity, as well as a non-anterior placental location are factors predictive of the success of ECV."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ae0783a-d561-33f1-8436-d651a6a11d2f",
                                        "entry_id": "63f0129f-9808-323e-949b-a4dd475db86f",
                                        "glosses": [
                                            "Of or relating to the head.",
                                            "Of or relating to the brain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898f590f-993a-4cb7-82a0-f43fff1b3cac",
                                                "sense_id": "7ae0783a-d561-33f1-8436-d651a6a11d2f",
                                                "text": "I was at the Mathematical School, where the Maſter taught his Pupils after a Method ſcarce imaginable to us in Europe. The Propoſition and Demonſtration were fairly written on a thin Wafer, with Ink compoſed of a Cephalick Tincture. This the Student was to ſwallow upon a faſting Stomach, and for three days following eat nothing but Bread and Water. As the Wafer digeſted, the Tincture mounted to his Brain, bearing the Propoſition along with it."
                                            },
                                            {
                                                "example_id": "78f0e173-bacb-4e78-b88d-4abbffcc86ec",
                                                "sense_id": "7ae0783a-d561-33f1-8436-d651a6a11d2f",
                                                "text": "Cephalic phase responses (CPRs) are conditioned anticipatory physiological responses to food cues. They occur before nutrient absorption and are hypothesized to be important for satiation and glucose homeostasis. Cephalic phase insulin responses (CPIRs) and pancreatic polypeptide responses (CPPPRs) are found consistently in animals, but human literature is inconclusive. We performed a systematic review of human studies to determine the magnitude and onset time of these CPRs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf18ae73-a1b6-3aa8-854d-fabc859e3719",
                                        "entry_id": "63f0129f-9808-323e-949b-a4dd475db86f",
                                        "glosses": [
                                            "Of or relating to the head.",
                                            "Of or relating to the cephalon (the head of a trilobite)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "312129e8-18b4-3aea-ba3d-edbf6d6bbc3c",
                                        "entry_id": "63f0129f-9808-323e-949b-a4dd475db86f",
                                        "glosses": [
                                            "Toward the head; in bipeds such as humans, this direction corresponds to superior."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b373571d-50fd-30c4-b905-48c1806554e5",
                                        "entry_id": "63f0129f-9808-323e-949b-a4dd475db86f",
                                        "glosses": [
                                            "Headlike; cephaloid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cephalic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d6c9918-d04d-39fa-a3b6-bdafa5b9214c",
                                        "entry_id": "74ba411d-39c0-3caf-91a2-82cefcbe2431",
                                        "glosses": [
                                            "A remedy that benefits the head or brain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b02a0ba5-15f4-4dc7-9cff-98488232d269",
                                                "sense_id": "6d6c9918-d04d-39fa-a3b6-bdafa5b9214c",
                                                "text": "[…] recover their Sight […] by the use of Bleeding, Purging, Blistering and Cephalics."
                                            },
                                            {
                                                "example_id": "d9f1a015-f723-42bd-87a3-1dc500fca07c",
                                                "sense_id": "6d6c9918-d04d-39fa-a3b6-bdafa5b9214c",
                                                "text": "All that of this Form could be titled Stomachics, we have subjoin'd to this Division, because they are all of the Aromatic kind, and thereby claim equally to be Cephalics. The latter we have given, extend their Influences to the Head and whole nervous System, at the same time that they warm, comfort, and strengthen the Fibres of the Stomach, and dissipate Flatulencies, corrugate the Membranes, and promote Digestion: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
