                        "target_lang_word": "acétamide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acétamide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a775eb9-9722-3fef-8633-a80969ec56c3",
                                        "entry_id": "492840d2-e9be-33d1-9ba8-be8e5a03063d",
                                        "glosses": [
                                            "Composé chimique, de formule CH₃−CONH₂, produit par l’action de l’ammoniaque sur l’éther acétique."
                                        ],
                                        "tags": [
                                            "Chimie organique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b35fe8a-1d2e-44b7-87a5-07f69ab2ab0f",
                                                "sense_id": "6a775eb9-9722-3fef-8633-a80969ec56c3",
                                                "text": "Une simple recristallisation du produit dans l'éther fournit l'acétamide pure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0974fed2-8d52-45ad-b0b5-74921b597810",
                        "source_entry_id": "13617838-437b-3e35-94c4-3d440b456d43",
                        "source_sense_id": "b467f931-5489-32b4-9041-475de542802b",
                        "source_sense_description": "amide of acetic acid",
                        "target_lang_word": "Acetamid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Acetamid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                        "entry_id": "d6c3905b-0722-3f1a-a488-1acc898a86cf",
                                        "glosses": [
                                            "Amid der Essigsäure, das als farbloser kristalliner Körper vorkommt, als Lösungsmittel sowie für die Herstellung von Kunststoffen, Lacken und Sprengstoffen verwendet wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cfeabd3-6cf2-4bb3-96d4-ec922baf5a41",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Die Herstellung von T. erfolgt durch Einwirkung von Phosphor(V)-sulfid auf Acetamid.“"
                                            },
                                            {
                                                "example_id": "1d771ace-34af-45cc-ba0f-0f27bd5ccd26",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Auch andere Säureamide (z.B. Acetamid, Isobutylamid, Crotonamid) können mit diesem Enzym erzeugt werden.“"
                                            },
                                            {
                                                "example_id": "1a739541-10d8-4962-b1d9-aa55c59942b7",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Synthetisch kann es durch die Nitrilsynthese nach Kolbe aus Methyliodid und Alkalicyaniden, durch Dehydratisierung von Acetamid bzw. Acetaldehydoxim und aus Acetylen und Ammoniak hergestellt werden.“"
                                            },
                                            {
                                                "example_id": "7203ca05-d0a5-49a6-a354-bc398babfdce",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„Praktische Bedeutung hat besonders das Anfangsglied der Reihe, das Keten H2C=C=O, u. a. zur Herstellung von Acetanhydrid, Essigester, Acetylchlorid und Acetamid.“"
                                            },
                                            {
                                                "example_id": "f73f38ba-4fc1-4369-bc14-59414dc58093",
                                                "sense_id": "5b34ca35-824f-3df5-8d80-c8cb9491f7a3",
                                                "text": "„A. ist eine sehr reaktive Verbindung, die mit Ammoniak zu Acetamid, mit Alkoholen zu Essigsäureestern und mit primären und sekundären Aminen zu N-substituierten Acetamiden reagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                        "entry_id": "d6c3905b-0722-3f1a-a488-1acc898a86cf",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "336ca606-c817-4858-80f7-05927cc59f16",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Diphenamid ist eine chemische Verbindung aus der Gruppe der Acetamide und ein Herbizid.“"
                                            },
                                            {
                                                "example_id": "ee30eefc-2eb9-458c-8e4a-0040646d40f5",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Wie weitere Funde in der Literatur bestätigen, eignet sich die diskontinuierliche LSE (d-LSE) für die chemische Gruppe der Acetamide am besten.“"
                                            },
                                            {
                                                "example_id": "70eaa0a7-8798-4f02-99f4-62c32630c6b8",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Phenacetin und Methacetin sind chemisch sehr ähnliche Verbindungen, die beide zur Gruppe der Acetamide gehören.“"
                                            },
                                            {
                                                "example_id": "edb2412f-a500-44e6-8bdb-d03addaa04fb",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„In dieser Doktorarbeit wurden die Strukturen und die Dynamik von zwei Formamiden, fünf Acetamiden und zwei Propionamiden untersucht, wobei der Fokus auf die Effekte der internen Rotation und der Quadrupolkopplung gelegt wurde.“"
                                            },
                                            {
                                                "example_id": "030efe23-b40d-45ef-8aa0-ee3592c7f8fe",
                                                "sense_id": "ec0fd121-befa-3569-80e7-638b3e018dbd",
                                                "text": "„Daneben lässt sich Paracetamol auch als Acetamid, also als Amid der Essigsäure auffassen, woraus sich der nach IUPAC-Regularien vergebene Name N-(4-Hydroxyphenyl)acetamid ergibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
