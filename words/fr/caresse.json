                    "frequency": "High",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'endort paisiblement sous la douce <w>caresse</w> de sa mère."
                        },
                        {
                            "text": "Le chat ronronne dès qu'il reçoit une tendre <w>caresse</w> sur la tête."
                        }
                    ],
