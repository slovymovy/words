                    {
                        "translation_id": "8efd4b46-d995-4190-8c81-5e0b0027760b",
                        "source_entry_id": "2ba9f0f9-60c5-3095-8e93-19b870f126b6",
                        "target_lang_word": "Panzerwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panzerwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eec38311-9b4d-3bb0-bbdc-2d380e023650",
                                        "entry_id": "d2b959b3-15ac-3b9e-8773-75e02fe22159",
                                        "glosses": [
                                            "gepanzertes und bewaffnetes Militärfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158d2237-4ab6-455a-b225-c5bd9a209209",
                                                "sense_id": "eec38311-9b4d-3bb0-bbdc-2d380e023650",
                                                "text": "„Die drei Kinder bewegten sich nur noch im Panzerwagen durch die Stadt.“"
                                            },
                                            {
                                                "example_id": "a09df8d9-47b5-4854-8579-3ef6358efa15",
                                                "sense_id": "eec38311-9b4d-3bb0-bbdc-2d380e023650",
                                                "text": "„Der Panzerwagen hätte sich in der Realität kaum bewährt, aber da Vinci wollte damit die mächtigen Herren seiner Zeit beeindrucken, wie in der Ausstellung nachzulesen ist.“"
                                            },
                                            {
                                                "example_id": "aa88c813-61c6-4dd7-b246-9e19fec6f362",
                                                "sense_id": "eec38311-9b4d-3bb0-bbdc-2d380e023650",
                                                "text": "„Wir erlitten sehr schwere Verluste an Panzerwagen und daher verschlechterte sich die Lage rasch.“"
                                            },
                                            {
                                                "example_id": "e2deea87-73b7-4f6f-96b4-5e8cdd29f297",
                                                "sense_id": "eec38311-9b4d-3bb0-bbdc-2d380e023650",
                                                "text": "„Der Exkommissar hasste den Panzerwagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "309824fa-c9cc-468e-a66e-71b3ff2e55dc",
                        "source_entry_id": "2ba9f0f9-60c5-3095-8e93-19b870f126b6",
