                            {
                                "example_id": "a26dfb2c-6974-4cd1-9054-169e8c869fd4",
                                "sense_id": "4d69f137-b0aa-3409-b5c5-7858cfd3a7b4",
                                "text": "In een weiland pal aan de N36 bij Beerzerveld, vlakbij Den Ham, zijn drie drachtige schapen doodgebeten en vijf schapen verwond, waarvan sommige zeer ernstig. De schapenhouder is er van overtuigd dat dit het werk van een wolf is."
                            },
                            {
                                "example_id": "03607faf-6fc4-49a9-ab84-3adaa55d11de",
                                "sense_id": "4d69f137-b0aa-3409-b5c5-7858cfd3a7b4",
                                "text": "Schapenhouder Bart Kemp uit Ede, initiatiefnemer van de actie, rekent op minimaal 750 deelnemers uit Overijssel. „Dat aantal hadden we zaterdag al bereikt. Maar ik verwacht dat er nog veel meer aanmeldingen zullen komen. Voor Twente alleen gaat het zeker om honderden boeren.”"
                            }
                        ]
                    }
