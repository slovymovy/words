                ],
                "senses": [
                    {
                        "sense_id": "5a0f7405-06cf-373c-9f8c-96742b051f7c",
                        "entry_id": "4e7f8a96-a97e-39e2-bcba-b0bf7f844b56",
                        "glosses": [
                            "Lebensmittel, das aus ökologischer und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b66d0edf-c472-4e11-8fd2-df4f932d525d",
                                "sense_id": "5a0f7405-06cf-373c-9f8c-96742b051f7c",
                                "text": "„Doch Nachhaltigkeit in der Geldanlage werde anders ‚erzeugt‘ und koste im Gegensatz zum Bio-Lebensmittel nicht mehr als herkömmliche Investments.“"
                            },
                            {
                                "example_id": "6c8b5bde-9911-4b3d-85b9-a41350e14a69",
                                "sense_id": "5a0f7405-06cf-373c-9f8c-96742b051f7c",
                                "text": "„Er wird von seinem Finanzberater beispielsweise gefragt, ob er bevorzugt Bio-Lebensmittel kauft und Ökostrom bezieht.“"
                            },
                            {
                                "example_id": "e37b5b94-3b54-482b-809e-1d4d767050f8",
                                "sense_id": "5a0f7405-06cf-373c-9f8c-96742b051f7c",
                                "text": "„Es dürften nicht die bestraft werden, die eine alte Ölheizung im Keller hätten, mit älteren Auto vom Land in die Stadt pendelten und sich keine teureren Bio-Lebensmittel leisten könnten.“"
                            },
                            {
                                "example_id": "1e957f1e-d1b5-4997-8d6b-7de581bec6da",
                                "sense_id": "5a0f7405-06cf-373c-9f8c-96742b051f7c",
                                "text": "„Im vergangenen Jahr erzielten die Bio-Lebensmittel einen Rekordumsatz von fast 15 Milliarden Euro – ein Plus von mehr als 20 Prozent.“"
                            },
                            {
                                "example_id": "c3be374c-5c01-4136-8ed2-b5de6e9eff23",
                                "sense_id": "5a0f7405-06cf-373c-9f8c-96742b051f7c",
                                "text": "„Bio-Lebensmittel werden zwar immer beliebter, haben aber nur einen Umsatzanteil von 4 Prozent in der gesamten Lebensmittelbranche.“"
                            },
                            {
                                "example_id": "65ee1c80-9bf6-401a-809b-ded16d971919",
                                "sense_id": "5a0f7405-06cf-373c-9f8c-96742b051f7c",
                                "text": "„Grünen-Fraktionschef Anton Hofreiter will den Hartz-IV-Satz erhöhen, damit die Menschen mehr Bio-Lebensmittel kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
