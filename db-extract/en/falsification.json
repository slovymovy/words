                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9c2b0c6e-f962-461c-a082-20a6c81e0a55",
                        "entry_id": "c209dfc4-808f-3eb6-acb8-8b7694b445c3",
                        "tags": [
                            "plural"
