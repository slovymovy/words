                                                "example_id": "fb4285f6-da48-4a3a-ab10-bda496a7ef17",
                                                "sense_id": "03a84785-98c8-3a2b-8fbe-da84caf20d1d",
                                                "text": "Der Raum wird einseitig belichtet."
                                            }
