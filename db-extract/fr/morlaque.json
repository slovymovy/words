                        "sense_id": "e2ff25e6-0428-3f0d-ad10-817926aaee7d",
                        "entry_id": "d21c05d3-2e6e-3f85-8c88-3ab43be87fa4",
                        "glosses": [
                            "Relatif aux Morlaques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84087bb4-e715-4957-be46-bdbdd8e5a2fe",
                                "sense_id": "e2ff25e6-0428-3f0d-ad10-817926aaee7d",
                                "text": "Notre guide nous précédait, couché de côté sur son cheval, chantant une chanson morlaque, aux monotones modulations, et dont je suivais les paroles avec un singulier intérêt."
                            },
                            {
                                "example_id": "4c90c8d7-5ce5-4227-9c37-3cfa7577fbf0",
                                "sense_id": "e2ff25e6-0428-3f0d-ad10-817926aaee7d",
                                "text": "Le son de plus en plus élevé de la voix des chanteurs, et par moment les notes monotones du fifre morlaque ou d’une rauque cornemuse, annoncèrent la fin du repas et le commencement de la danse."
                            },
                            {
                                "example_id": "d4c4006a-6fd5-4b8e-b7fa-4e8321922c68",
                                "sense_id": "e2ff25e6-0428-3f0d-ad10-817926aaee7d",
                                "text": "Les postillons espagnols sont comme les cochers morlaques, ils se soucient assez peu de ce qui se passe derrière eux, et pourvu qu’ils arrivent, ne fût-ce qu’avec le timon et les petites roues de devant, ils sont satisfaits."
                            }
                        ]
                    }
