                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы все надеемся на светлое <w>завтра</w>.",
                            "target_lang_translations": {
                                "en": "We all hope for a bright <w>tomorrow</w>.",
                                "zh": "我们都期待着光明的<w>未来</w>。",
                                "de": "Wir alle hoffen auf ein helles <w>Morgen</w>.",
                                "nl": "We hopen allemaal op een mooie <w>toekomst</w>.",
                                "pl": "Wszyscy mamy nadzieję na świetlane <w>jutro</w>.",
                                "fr": "Nous espérons tous un <w>avenir</w> radieux.",
                                "it": "Speriamo tutti in un <w>domani</w> luminoso.",
                                "cs": "Všichni doufáme ve světlý <w>zítřek</w>.",
                                "tr": "Hepimiz aydınlık bir <w>yarına</w> umut bağlıyoruz.",
                                "es": "Todos esperamos un <w>mañana</w> brillante."
                            }
                        },
                        {
                            "text": "Нужно думать про своё <w>завтра</w> уже сейчас.",
                            "target_lang_translations": {
                                "en": "One needs to think about one's <w>future</w> right now.",
                                "zh": "现在就得为自己的<w>未来</w>做打算。",
                                "de": "Man muss schon jetzt an sein <w>Morgen</w> denken.",
                                "nl": "Je moet nu al nadenken over je <w>toekomst</w>.",
                                "pl": "Trzeba myśleć o swoim <w>jutrze</w> już teraz.",
                                "fr": "Il faut penser à son <w>avenir</w> dès maintenant.",
                                "it": "Bisogna pensare al proprio <w>domani</w> già da ora.",
                                "cs": "O svém <w>zítřku</w> je třeba přemýšlet už teď.",
                                "tr": "Kendi <w>yarınını</w> şimdiden düşünmelisin.",
                                "es": "Hay que pensar en nuestro <w>mañana</w> desde ahora."
                            }
                        }
