                        "translation_id": "5aa9f36b-8b0d-4d27-b096-571d6c975580",
                        "source_entry_id": "7709c294-dc79-3a1a-8198-eb60bc637160",
                        "source_sense_id": "290aab42-404e-3da5-9943-b3f5c5d3cd05",
                        "target_lang_word": "Reiseleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiseleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                        "entry_id": "2e7f95c3-95d0-3cac-a658-9769f6b3865e",
                                        "glosses": [
                                            "Person, die eine Reisegesellschaft betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccbff61-749b-4c87-a954-a8e3da877b8b",
                                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                                "text": "„Der Reiseleiter, schon in Mantel und Mütze, hat seine letzte Ansprache gehalten.“"
                                            },
                                            {
                                                "example_id": "4795b472-076b-4219-bf2a-04a02101a707",
                                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                                "text": "„Der Reiseleiter bittet uns zu Tisch, es gibt Krabbensuppe und Lammfilet.“"
                                            },
                                            {
                                                "example_id": "fd350a66-e9db-4511-8c54-067b3e3f0d27",
                                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                                "text": "„Die Rettung kam in Gestalt eines rot- und weißgekleideten Reiseleiters, der in ein Megaphon rief, dass alle Gäste willkommen seien und sich zu den Bussen begeben sollten.“"
                                            },
                                            {
                                                "example_id": "d0661ac8-d5ee-4e3b-9fab-4e6eca4b90e6",
                                                "sense_id": "6cc5023a-470b-32f0-bd0b-d7304a1ac7d2",
                                                "text": "„Unter den behutsamen Händen erfahrender Reiseleiter sollen sie in Mindestabständen an einsamen Stromschnellen Irlands verteilt werden, um dort zu angeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
