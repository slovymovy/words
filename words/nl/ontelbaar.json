    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8bf07af-aa19-32f8-a9fc-2ab129c2c5a2",
                    "sense_definition": "in zeer grote aantallen aanwezig, zodat het bijna onmogelijk is om ze allemaal te tellen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staan <w>ontelbare</w> sterren aan de hemel tijdens een heldere nacht.",
                            "target_lang_translations": {
                                "en": "There are <w>countless</w> stars in the sky during a clear night."
                            }
                        },
                        {
                            "text": "De beroemde sportheld kreeg <w>ontelbare</w> eerbewijzen na zijn grote overwinning.",
                            "target_lang_translations": {
                                "en": "The famous sports hero received <w>innumerable</w> honors after his great victory."
                            }
                        }
                    ],
                    "synonyms": [
                        "talloos",
                        "legio",
                        "oneindig"
                    ],
                    "antonyms": [
                        "telbaar"
                    ],
                    "common_phrases": [
                        "ontelbare keren",
                        "ontelbare mogelijkheden"
                    ],
                    "target_lang_definitions": {
                        "en": "Present in very large numbers, making it almost impossible to count them all."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "countless",
                                "target_lang_sense_clarification": "too many to be counted"
                            },
                            {
                                "target_lang_word": "innumerable",
                                "target_lang_sense_clarification": "too many to be numbered"
                            },
                            {
                                "target_lang_word": "myriad",
                                "target_lang_sense_clarification": "a great and varied number"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b2b66bf-d5a2-319f-8dbf-545f1b3bf5bf",
                    "sense_definition": "niet in een precies getal uit te drukken of grammaticaal niet als eenheid te tellen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de taalkunde is water een voorbeeld van een <w>ontelbaar</w> zelfstandig naamwoord.",
                            "target_lang_translations": {
                                "en": "In linguistics, water is an example of an <w>uncountable</w> noun."
                            }
                        },
                        {
                            "text": "De schade aan het historische gebouw is nagenoeg <w>ontelbaar</w> en onvervangbaar.",
                            "target_lang_translations": {
                                "en": "The damage to the historic building is virtually <w>incalculable</w> and irreplaceable."
                            }
                        }
                    ],
                    "synonyms": [
                        "onberekenbaar"
                    ],
                    "antonyms": [
                        "telbaar"
                    ],
                    "common_phrases": [
                        "ontelbaar zelfstandig naamwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "Not expressible as a precise number or grammatically not countable as a unit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncountable",
                                "target_lang_sense_clarification": "in linguistics, referring to mass nouns"
                            },
                            {
                                "target_lang_word": "incalculable",
                                "target_lang_sense_clarification": "too great to be calculated or estimated"
                            },
                            {
                                "target_lang_word": "non-count",
                                "target_lang_sense_clarification": "grammatical term for nouns without a plural form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}