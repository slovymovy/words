                ],
                "senses": [
                    {
                        "sense_id": "9056c0b4-3dec-3dd9-90f3-1a9b11d78376",
                        "entry_id": "4e99b82b-5014-35e0-887d-2377ad55e70e",
                        "glosses": [
                            "beim Sperren von Jungvögeln abgegebener Laut, um von den Vogeleltern gefüttert zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97fadac3-e085-4dcb-8208-6f59ab9e5556",
                                "sense_id": "9056c0b4-3dec-3dd9-90f3-1a9b11d78376",
                                "text": "Der Sperrlaut tritt funktionsgemäß bei den noch nicht selbständigen Jungen bis zum 19. oder 20. Lebenstage vor und bei der Futterübergabe auf."
                            },
                            {
                                "example_id": "8d223ec5-d025-4cc1-aee4-c2fa435c0ed9",
                                "sense_id": "9056c0b4-3dec-3dd9-90f3-1a9b11d78376",
                                "text": "Erst beim Abbau der Sperrhandlung: — der Sperrlaut erlischt, die Sperrdauer nimmt ab, die Begleitbewegungen fallen weg, der Schnabel wird schließlich kaum noch geöffnet — wird die Pickbewegung dominierend."
                            },
                            {
                                "example_id": "ff7a3a0c-03fe-45e8-acde-232a0b50d6d1",
                                "sense_id": "9056c0b4-3dec-3dd9-90f3-1a9b11d78376",
                                "text": "Zu dieser Zeit bringen sie auch den Sperrlaut, ein heiseres eh eh eh."
                            },
                            {
                                "example_id": "8e6bc067-2ef9-4e03-8135-41d8704252bc",
                                "sense_id": "9056c0b4-3dec-3dd9-90f3-1a9b11d78376",
                                "text": "So könnte sich, indem das Sperren gelegentlich die Funktion wechselte, der Haßlaut aus dem Sperrlaut entwickelt haben."
                            },
                            {
                                "example_id": "12794de8-32f6-429f-a774-7dd4e8fd90a4",
                                "sense_id": "9056c0b4-3dec-3dd9-90f3-1a9b11d78376",
                                "text": "Dieses „hip\" ging dann allmählich in die späteren Sperrlaute über (Abb. 2)."
                            },
                            {
                                "example_id": "d0402caf-7c22-4017-a6ce-b2736971165e",
                                "sense_id": "9056c0b4-3dec-3dd9-90f3-1a9b11d78376",
                                "text": "Merkwürdigerweise ähnelt diese Strophe einem ebenso periodisch ausgestoßenen Ruf der Nestjungen Chiroxiphia caudata (dieser Ruf hat nichts mit dem Sperrlaut von Chiroxiphia zu tun, der einem Krähen gleicht)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
