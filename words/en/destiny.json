                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I introduced my friend <w>Destiny</w> to the rest of the group.",
                            "target_lang_translations": {
                                "ru": "Я представил свою подругу <w>Дестини</w> остальной части группы.",
                                "pl": "Przedstawiłem moją przyjaciółkę <w>Destiny</w> reszcie grupy."
                            }
                        },
                        {
                            "text": "The teacher asked <w>Destiny</w> to read the next paragraph aloud.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил <w>Дестини</w> прочитать следующий абзац вслух.",
                                "pl": "Nauczyciel poprosił <w>Destiny</w> o przeczytanie na głos kolejnego akapitu."
                            }
