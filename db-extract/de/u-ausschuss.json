                "senses": [
                    {
                        "sense_id": "0bad0baf-35ba-323e-91b6-1b96a22e9b8c",
                        "entry_id": "9ef5833e-45bf-314d-a317-a68aed98f5a0",
                        "glosses": [
                            "kurz für Untersuchungsausschuss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1198dcf9-71b6-4074-b5b5-427a1d54c910",
                                "sense_id": "0bad0baf-35ba-323e-91b6-1b96a22e9b8c",
                                "text": "„Das erste Dokument, das eintraf, war ein mit 10. März datiertes Schreiben an Nationalratspräsidentin Doris Bures, die nach den neuen Verfahrensregeln dem U-Ausschuss vorsitzt. Darin teilt der steirische Landesschulrat \"nach umfassender Prüfung\" wenig überraschend mit, dass er \"über keine dem Untersuchungsgegenstand zuzuordnende Akten oder Unterlagen verfügt\".“"
                            },
                            {
                                "example_id": "a09933ef-e7f3-430f-a7b2-3136cc6ee942",
                                "sense_id": "0bad0baf-35ba-323e-91b6-1b96a22e9b8c",
                                "text": "„Die SPÖ hat bisher unter Verweis auf das Entschlagungsrecht der Personen, gegen die von der Justiz ermittelt wird, einen U-Ausschuss abgelehnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
