                                        "glosses": [
                                            "Grains concassés de céréales. particulièrement de blé dur, employés dans l’alimentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89226916-8e9c-41c8-b82d-1696d9703139",
                                                "sense_id": "faba09b2-a0ef-3e3b-8944-ff319657e813",
                                                "text": "Ernestine lui annonce que, pour fêter sa guérison, elle servira un gâteau de semoule aux raisins de Corinthe."
                                            },
