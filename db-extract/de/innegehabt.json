                        "glosses": [
                            "etwas (zumeist ein Amt, eine Stellung oder Position) eingenommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149f2a12-785e-4548-ac32-80d1f321abb6",
                                "sense_id": "9f146c62-cc25-3c3a-936f-1078b83052e2",
                                "text": "Als Francke 1699 die bis dahin von ihm innegehabte Professur der orientalischen Sprachen in der Philosophischen Fakultät aufgab, um ein theologisches Ordinariat zu übernehmen, …"
                            },
                            {
                                "example_id": "afd87e0e-90fc-4606-bef8-14f1b23905a4",
                                "sense_id": "9f146c62-cc25-3c3a-936f-1078b83052e2",
                                "text": "Prof. Dr. Wolfgang Rascher, Lehrstuhl für Kinderheilkunde. Prof. Rascher vertritt die innegehabte Professur bis 31. März 2019."
                            },
                            {
                                "example_id": "0a16da18-76b0-4d7b-9bf9-fc600cdadfa2",
                                "sense_id": "9f146c62-cc25-3c3a-936f-1078b83052e2",
                                "text": "Abhängig von den Vorerfahrungen und den bisher innegehabten Positionen der Bewerberin/ des Bewerbers besteht die Bereitschaft zu einer freiwilligen Überzahlung."
                            },
                            {
                                "example_id": "2f0577d9-fd93-43b9-ae08-b63935ec86b3",
                                "sense_id": "9f146c62-cc25-3c3a-936f-1078b83052e2",
                                "text": "Inwieweit dieser Name auf ein innegehabtes Amt zurückgeht, vermögen wir nicht zu sagen, doch ist es anzunehmen."
                            },
                            {
                                "example_id": "a63d0634-5b0a-42c4-8a07-a996223da86b",
                                "sense_id": "9f146c62-cc25-3c3a-936f-1078b83052e2",
                                "text": "… und auch dort bildete die vor dem Krieg innegehabte Position einen wesentlichen Bezugspunkt für die Bemessung der Renten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ae16fc8-28ec-348a-8c8e-5eaf3af5e6f5",
                        "entry_id": "fa263bb5-1dc3-3377-a3c0-d481fdeb9bf1",
                        "glosses": [
                            "etwas besessen, über etwas verfügt habend"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "85b4829b-c483-42ed-8180-94637204523d",
                                "sense_id": "8ae16fc8-28ec-348a-8c8e-5eaf3af5e6f5",
                                "text": "Dienstnehmer, die keinen eigenen Haushalt führen, haben eine von ihnen innegehabte Dienstwohnung binnen einem Monat nach Beendigung des Dienstverhältnisses zu räumen."
                            },
                            {
                                "example_id": "8f1a9f60-0ae5-4bde-ab05-baa1ba5f6443",
                                "sense_id": "8ae16fc8-28ec-348a-8c8e-5eaf3af5e6f5",
                                "text": "Deutschland stand 1952 auf dem dritten Platz mit 17,1 Mill. £ und konnte seine Position gegenüber 1951 um 14,7 v. H. verbessern, da es Japan von dem bisher innegehabten dritten Platz verdrängte."
                            },
                            {
                                "example_id": "1ed8009b-1ec9-4246-9ca8-de06b73a7bb6",
                                "sense_id": "8ae16fc8-28ec-348a-8c8e-5eaf3af5e6f5",
                                "text": "In jenen Ländern jedoch, wo sie schon lange herrscht, tut sie dies mit allen Attributen unverdient lange innegehabter Macht: Korruption, Vetternwirtschaft, Unfähigkeit."
                            },
                            {
                                "example_id": "3d92d796-0109-491c-8608-8f05a5157353",
                                "sense_id": "8ae16fc8-28ec-348a-8c8e-5eaf3af5e6f5",
                                "text": "„Hiermit erheben wir Klage mit dem Antrag, den Beklagten zu verurteilen, die von ihm innegehabte Wohnung zu räumen und an die Klägerin herauszugeben.“"
                            },
                            {
                                "example_id": "724f7260-0f40-4e79-b48c-3c705ce8f709",
                                "sense_id": "8ae16fc8-28ec-348a-8c8e-5eaf3af5e6f5",
                                "text": "Ausser Zweifel steht jedenfalls die seit je innegehabte Rolle einer Vormacht: Die Leichtathletik, insbesondere deren spektakuläre Events, bleibt «made in USA»."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
