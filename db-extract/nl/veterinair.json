                                        "entry_id": "6ea02814-273b-35bd-9888-daea021058ed",
                                        "glosses": [
                                            "Of or relating to the medical or surgical treatment of non-human animals, especially domestic and farm animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cfe26de-0361-4dc6-a2d8-565990d6eacd",
                                                "sense_id": "45e624a8-d980-338f-be0f-6156f8ee81c4",
                                                "text": "Max used all his veterinary knowledge to save the goose stuck in the fence."
                                            },
                                            {
                                                "example_id": "aa899ab3-57a5-4f18-bfbc-59ca435b80fc",
                                                "sense_id": "45e624a8-d980-338f-be0f-6156f8ee81c4",
                                                "text": "The talented artist quickly became fluent in English, found work at a pizzeria and dreamed of becoming a veterinary assistant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "veterinary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "deb6f0a8-5c62-3c24-a215-566a0f18a5e2",
