                    "frequency": "Low",
                    "semantic_group_id": "ciało",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dostał mocno w <w>lampę</w> podczas bójki w barze."
                        },
                        {
                            "text": "Uderzył się w <w>lampę</w> przy wychodzeniu z niskiego pomieszczenia."
