                "senses": [
                    {
                        "sense_id": "b8ee790c-99d2-3524-9a32-ae30ffa0e8c0",
                        "entry_id": "4a93bdd0-37ba-3091-8b5e-a880a12f1d32",
                        "glosses": [
                            "persoon die in een bepaalde plaats of een bepaald land woont"
                        ],
                        "tags": [],
