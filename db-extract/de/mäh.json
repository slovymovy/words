                                "example_id": "a8bb6896-2042-4b0d-a6d3-635fd7e85f74",
                                "sense_id": "b7af13d8-ba39-3213-90e1-6d6f10d949c7",
                                "text": "„Abends, als es Zeit war heimzugehen, fragte er [der älteste Sohn]: ‚Ziege, bist du satt?‘ Die Ziege antwortete: ‚Ich bin so satt, ich mag kein Blatt: mäh! mäh!‘ “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
