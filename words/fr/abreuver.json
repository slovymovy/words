    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65df1e80-655f-3cba-a0f0-8fe041a2a9f5",
                    "sense_definition": "Donner à boire à des animaux, en particulier au bétail ou aux chevaux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier va <w>abreuver</w> les chevaux au bord de la rivière avant la tombée de la nuit."
                        },
                        {
                            "text": "Il faut <w>abreuver</w> le bétail deux fois par jour pendant les périodes de forte chaleur."
                        }
                    ],
                    "antonyms": [
                        "assoiffer"
                    ],
                    "common_phrases": [
                        "abreuver les chevaux",
                        "abreuver le bétail"
                    ]
                },
                {
                    "sense_id": "759e2add-5c00-3c33-84e4-deff10d2e7e8",
                    "sense_definition": "Accabler ou combler quelqu'un d'une grande quantité de paroles, d'actes ou d'attentions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la défaite de son équipe, le public en colère l'a <w>abreuvé</w> d'injures jusqu'au vestiaire."
                        },
                        {
                            "text": "Le directeur a <w>abreuvé</w> son équipe de compliments pour saluer leur travail remarquable."
                        }
                    ],
                    "synonyms": [
                        "accabler",
                        "combler"
                    ],
                    "antonyms": [
                        "priver"
                    ],
                    "common_phrases": [
                        "abreuver d'injures",
                        "abreuver de compliments",
                        "abreuver de reproches"
                    ]
                },
                {
                    "sense_id": "84b8e138-334f-3ab2-9b3b-b3af393f0420",
                    "sense_definition": "Arroser abondamment ou imbiber d'eau une terre ou des végétaux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arroser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pluies abondantes de l'automne ont enfin <w>abreuvé</w> cette terre desséchée par la canicule."
                        },
                        {
                            "text": "Un bel orage d'été est venu <w>abreuver</w> les prairies assoiffées du village."
                        }
                    ],
                    "synonyms": [
                        "arroser"
                    ],
                    "common_phrases": [
                        "abreuver la terre",
                        "abreuver les prairies"
                    ]
                }
            ]
        }
    ]
