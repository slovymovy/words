                "senses": [
                    {
                        "sense_id": "3e45aa4d-ec0f-353f-8a8a-95229a743d78",
                        "entry_id": "46369ddc-743d-3244-8c65-3463851f49b0",
                        "glosses": [
                            "Couronner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "786152f7-9a09-4719-aaf5-900cccbad33c",
                                "sense_id": "3e45aa4d-ec0f-353f-8a8a-95229a743d78",
                                "text": "L’Archevêque de Naples Capece Zurlo homme de pitié édifiante et respectable vieillard octagenaire, se crut obligé d’encouronner un cardinal qui prenait le titre de 1ᵉʳ Pasteur de l’Eglise.^([sic])"
                            },
                            {
                                "example_id": "fe426583-891c-47fd-9bee-7ba7acb3d060",
                                "sense_id": "3e45aa4d-ec0f-353f-8a8a-95229a743d78",
                                "text": "Les heures alenties s'encouronnent. D'une aura triste des cœurs voilés."
                            },
                            {
                                "example_id": "0e0ecb33-bf65-449e-a373-58d0958dfeeb",
                                "sense_id": "3e45aa4d-ec0f-353f-8a8a-95229a743d78",
                                "text": "Les cheveux givrés retrouvent l'or du Levant et s'Encouronnent de floraisons champêtres, de roses et de 7 chandelles !"
                            }
                        ]
                    }
