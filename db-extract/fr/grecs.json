                        ],
                        "form": "Grec"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2be65ef4-780d-378f-8fe0-0ab62b4f9e8c",
                        "entry_id": "9e2ca25f-c180-3e97-afaa-15c0c9543741",
                        "glosses": [
                            "(Précédé de l'article défini les) Peuple de la Grèce antique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f29e42b-c2df-433a-87ac-1b4fdfe48fc1",
                                "sense_id": "2be65ef4-780d-378f-8fe0-0ab62b4f9e8c",
                                "text": "Les Grecs ont fortement inspiré les Romains, notamment en matière de culture, de mythologie et de littérature."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f5afdc2-07a2-3885-8939-ec5c62c8a13c",
                        "entry_id": "9e2ca25f-c180-3e97-afaa-15c0c9543741",
                        "glosses": [
                            "(Précédé de l'article défini les) Philosophes de la Grèce antique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "884a100d-8f9f-46dd-b50e-eda9b02324e5",
                                "sense_id": "4f5afdc2-07a2-3885-8939-ec5c62c8a13c",
                                "text": "Les Grecs sont des amateurs de concepts et d'idées, de pureté idéale et d'envolées métaphysiques. Ils font une philosophie pour philosophes.\nLes Romains se moquent de la métaphysique …."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
