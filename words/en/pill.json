{
    "word_family": [
        "pillbox",
        "pilling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c97e941b-264b-32b2-a78f-bb6c69c6403d",
                    "sense_definition": "A small, usually round or cylindrical object designed for easy swallowing, usually containing some sort of medication or vitamins.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told him to take one <w>pill</w> every morning with breakfast.",
                            "target_lang_translations": {
                                "ru": "Врач сказал ему принимать одну <w>таблетку</w> каждое утро за завтраком.",
                                "zh": "医生告诉他每天早上吃早饭时服一粒<w>药片</w>。"
                            }
                        },
                        {
                            "text": "She swallowed the bitter <w>pill</w> with a large glass of water.",
                            "target_lang_translations": {
                                "ru": "Она проглотила горькую <w>пилюлю</w> с большим стаканом воды.",
                                "zh": "她就着一大杯水吞下了那粒苦苦的<w>药片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tablet",
                        "capsule"
                    ],
                    "common_phrases": [
                        "take a pill",
                        "sleeping pill",
                        "vitamin pill",
                        "sugar pill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой, обычно круглый или цилиндрический объект, предназначенный для проглатывания, обычно содержащий лекарство или витамины.",
                        "zh": "一种通常为圆形或圆柱形、便于吞咽的小东西，一般含有药物或维生素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таблетка",
                                "target_lang_sense_clarification": "самое общее название"
                            },
                            {
                                "target_lang_word": "пилюля",
                                "target_lang_sense_clarification": "обычно круглой формы; также используется в переносном смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "药片",
                                "target_lang_sense_clarification": "最常见的说法，指可吞服的药丸或药片"
                            },
                            {
                                "target_lang_word": "药丸",
                                "target_lang_sense_clarification": "强调一粒一粒的药丸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4be04155-c4db-34bc-9407-aa1e43635913",
                    "sense_definition": "An oral contraceptive medication taken by women to prevent pregnancy; usually referred to with the definite article.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to go on the <w>pill</w> for birth control.",
                            "target_lang_translations": {
                                "ru": "Она решила начать принимать <w>противозачаточные таблетки</w> для контроля рождаемости.",
                                "zh": "她决定开始服用<w>避孕药</w>来避孕。"
                            }
                        },
                        {
                            "text": "Many women find it convenient to use the <w>pill</w> for family planning.",
                            "target_lang_translations": {
                                "ru": "Многие женщины считают удобным использовать <w>противозачаточные таблетки</w> для планирования семьи.",
                                "zh": "许多女性觉得用<w>避孕药</w>来进行计划生育很方便。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the pill",
                        "go on the pill",
                        "come off the pill",
                        "morning-after pill"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "almost always called 'the pill'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оральный контрацептив, принимаемый женщинами для предотвращения беременности.",
                        "zh": "女性为避免怀孕而服用的口服避孕药，英语中通常说作 the pill。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противозачаточная таблетка",
                                "target_lang_sense_clarification": "обычно используется во множественном числе"
                            },
                            {
                                "target_lang_word": "гормональные контрацептивы",
                                "target_lang_sense_clarification": "медицинский контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "避孕药",
                                "target_lang_sense_clarification": "最常见的日常说法"
                            },
                            {
                                "target_lang_word": "口服避孕药",
                                "target_lang_sense_clarification": "较正式，指口服避孕药"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3766b790-eb89-38c9-98ef-3427d7a00e0c",
                    "sense_definition": "Something offensive, unpleasant, or disappointing which must be accepted or endured.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_unpleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Losing the championship final was a bitter <w>pill</w> to swallow for the team.",
                            "target_lang_translations": {
                                "ru": "Проигрыш в финале чемпионата стал для команды горькой <w>пилюлей</w>.",
                                "zh": "输掉冠军决赛对这支队来说是一个难以下咽的<w>苦果</w>。"
                            }
                        },
                        {
                            "text": "The new tax increase was a hard <w>pill</w> for the public to accept.",
                            "target_lang_translations": {
                                "ru": "Новое повышение налогов стало тяжелой <w>пилюлей</w> для общества.",
                                "zh": "新的增税对公众来说是个难以接受的<w>苦果</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bitter pill to swallow",
                        "hard pill to swallow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то оскорбительное, неприятное или разочаровывающее, что приходится принять или пережить.",
                        "zh": "指令人反感、不愉快或失望，但又不得不接受或忍受的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилюля",
                                "target_lang_sense_clarification": "в идиоме 'горькая пилюля'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苦果",
                                "target_lang_sense_clarification": "比喻不得不接受的痛苦结果"
                            },
                            {
                                "target_lang_word": "难以下咽的事",
                                "target_lang_sense_clarification": "泛指令人难受但必须接受的事情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "033bcc1a-067f-36aa-844c-ac7bec570fac",
                    "sense_definition": "A rounded rectangle containing a brief text caption indicating the tag or category that an item belongs to in a user interface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Click the blue <w>pill</w> to filter the search results by date.",
                            "target_lang_translations": {
                                "ru": "Нажмите на синюю <w>таблетку</w>, чтобы отфильтровать результаты поиска по дате.",
                                "zh": "点击蓝色的<w>胶囊标签</w>，按日期筛选搜索结果。"
                            }
                        },
                        {
                            "text": "The design uses a small <w>pill</w> to show which keywords are active.",
                            "target_lang_translations": {
                                "ru": "В дизайне используется небольшая <w>плашка</w>, чтобы показать активные ключевые слова.",
                                "zh": "这个设计用一个小<w>胶囊标签</w>来显示哪些关键词处于激活状态。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical design/computing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Закругленный прямоугольник с коротким текстом, указывающий тег или категорию в пользовательском интерфейсе.",
                        "zh": "用户界面中一种圆角长条形的小标签，带有简短文字，用来表示项目所属的标签或类别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плашка",
                                "target_lang_sense_clarification": "элемент интерфейса"
                            },
                            {
                                "target_lang_word": "таблетка",
                                "target_lang_sense_clarification": "жаргон дизайнеров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胶囊标签",
                                "target_lang_sense_clarification": "界面中呈胶囊形、带简短文字的标签"
                            },
                            {
                                "target_lang_word": "胶囊形标签",
                                "target_lang_sense_clarification": "强调外形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b94f1bba-30b5-37be-875d-b8de07fba33e",
                    "sense_definition": "A contemptible, annoying, or unpleasant person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_unpleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop being such a <w>pill</w> and help us clean up the kitchen.",
                            "target_lang_translations": {
                                "ru": "Перестань быть такой <w>занудой</w> и помоги нам убраться на кухне.",
                                "zh": "别这么当<w>讨厌鬼</w>了，来帮我们收拾厨房吧。"
                            }
                        },
                        {
                            "text": "He can be a real <w>pill</w> when he does not get his own way.",
                            "target_lang_translations": {
                                "ru": "Он может быть настоящей <w>язвой</w>, когда всё идет не по его плану.",
                                "zh": "事情不顺他的意时，他真会变成个<w>烦人精</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "be a pill",
                        "such a pill"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Презренный, надоедливый или неприятный человек.",
                        "zh": "令人看不起、惹人烦或让人不快的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "надоедливый человек"
                            },
                            {
                                "target_lang_word": "язва",
                                "target_lang_sense_clarification": "неприятный, язвительный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "讨厌鬼",
                                "target_lang_sense_clarification": "口语，指讨厌的人"
                            },
                            {
                                "target_lang_word": "烦人精",
                                "target_lang_sense_clarification": "口语，指很烦人的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c485cf1-9a3a-36ac-86f6-be8bec7979f8",
                    "sense_definition": "A small ball of fibers formed on the surface of a textile fabric by rubbing or wear.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shape_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This old sweater is covered in <w>pills</w> after years of use.",
                            "target_lang_translations": {
                                "ru": "Этот старый свитер весь в <w>катышках</w> после многих лет носки.",
                                "zh": "这件旧毛衣穿了很多年以后，满是<w>毛球</w>。"
                            }
                        },
                        {
                            "text": "She used a razor to carefully remove every <w>pill</w> from her coat.",
                            "target_lang_translations": {
                                "ru": "Она использовала бритву, чтобы аккуратно удалить каждый <w>катышек</w> со своего пальто.",
                                "zh": "她用剃刀小心地把大衣上的每个<w>毛球</w>都刮掉了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bobble",
                        "fuzzball",
                        "lint ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький шарик из волокон, образующийся на поверхности ткани от трения или износа.",
                        "zh": "布料表面因摩擦或磨损而形成的小纤维球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катышек",
                                "target_lang_sense_clarification": "на одежде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毛球",
                                "target_lang_sense_clarification": "衣物表面因摩擦形成的小绒球"
                            },
                            {
                                "target_lang_word": "球球",
                                "target_lang_sense_clarification": "衣物起球后形成的小团"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c3a5e44-c881-33c4-943e-657a0d0b7e64",
                    "sense_definition": "An inlet on the coast; a small tidal pool or bay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat was moored safely in the <w>pill</w> away from the rough sea.",
                            "target_lang_translations": {
                                "ru": "Лодка была надежно пришвартована в <w>заводи</w>, вдали от бурного моря.",
                                "zh": "小船安全地停泊在那处<w>小海湾</w>里，避开了汹涌的海面。"
                            }
                        },
                        {
                            "text": "Local fishermen know every <w>pill</w> and creek along this stretch of coastline.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки знают каждую <w>протоку</w> и ручей на этом участке побережья.",
                                "zh": "当地渔民熟悉这段海岸线上每一处<w>潮汐湾</w>和小溪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South West England and Wales"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Залив на побережье; небольшая приливная заводь или бухта.",
                        "zh": "海岸上的一个小入口；小型的潮汐水湾或海湾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заводь",
                                "target_lang_sense_clarification": "спокойное место у берега"
                            },
                            {
                                "target_lang_word": "протока",
                                "target_lang_sense_clarification": "узкий водный путь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小海湾",
                                "target_lang_sense_clarification": "海岸边较小而平静的海湾"
                            },
                            {
                                "target_lang_word": "潮汐湾",
                                "target_lang_sense_clarification": "受潮汐影响的小海湾或水湾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67876cae-3080-3794-9291-c6534037bfcd",
                    "sense_definition": "A baseball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher threw the <w>pill</w> at ninety miles per hour.",
                            "target_lang_translations": {
                                "ru": "Питчер бросил <w>мяч</w> со скоростью девяносто миль в час.",
                                "zh": "投手把这个<w>棒球</w>以每小时九十英里的速度投了出去。"
                            }
                        },
                        {
                            "text": "He hit the <w>pill</w> straight into the outfield for a double.",
                            "target_lang_translations": {
                                "ru": "Он отбил <w>мяч</w> прямо в аутфилд, сделав дабл.",
                                "zh": "他把这个<w>棒球</w>直接打到了外场，形成了一支二垒安打。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бейсбольный мяч.",
                        "zh": "棒球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мяч",
                                "target_lang_sense_clarification": "спортивный снаряд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "棒球",
                                "target_lang_sense_clarification": "棒球运动中的球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c45ffd2f-48bd-35fb-970e-11fb80d146cb",
                    "sense_definition": "A bullet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gangster was afraid of taking a <w>pill</w> during the shootout.",
                            "target_lang_translations": {
                                "ru": "Гангстер боялся получить <w>пулю</w> во время перестрелки.",
                                "zh": "那个黑帮分子害怕在枪战中挨上一<w>枪子儿</w>。"
                            }
                        },
                        {
                            "text": "Soldiers in the trenches often referred to enemy fire as flying <w>pills</w>.",
                            "target_lang_translations": {
                                "ru": "Солдаты в окопах часто называли вражеский огонь летящими <w>пилюлями</w>.",
                                "zh": "战壕里的士兵常把飞来的子弹叫作飞来的<w>枪子儿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cap"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пуля.",
                        "zh": "子弹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуля",
                                "target_lang_sense_clarification": "боеприпас"
                            },
                            {
                                "target_lang_word": "маслина",
                                "target_lang_sense_clarification": "криминальный жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "枪子儿",
                                "target_lang_sense_clarification": "口语，指子弹"
                            },
                            {
                                "target_lang_word": "子弹",
                                "target_lang_sense_clarification": "较通用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "847d6b6d-653e-380d-b024-a2f074b9f90e",
                    "sense_definition": "Of a woven fabric surface, to form small matted balls of fiber due to wear or friction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fabric_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cheap wool sweaters tend to <w>pill</w> after just a few washes.",
                            "target_lang_translations": {
                                "ru": "Дешевые шерстяные свитера имеют тенденцию <w>скатываться</w> всего после нескольких стирок.",
                                "zh": "便宜的羊毛衫只洗几次就容易<w>起球</w>。"
                            }
                        },
                        {
                            "text": "High-quality cotton is less likely to <w>pill</w> than synthetic blends.",
                            "target_lang_translations": {
                                "ru": "Высококачественный хлопок с меньшей вероятностью будет <w>скатываться</w>, чем синтетические смеси.",
                                "zh": "优质棉料比混纺化纤更不容易<w>起球</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О поверхности ткани: образовывать маленькие свалявшиеся шарики волокон из-за износа или трения.",
                        "zh": "指织物表面因磨损或摩擦而形成小纤维球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скатываться",
                                "target_lang_sense_clarification": "о ткани/шерсти"
                            },
                            {
                                "target_lang_word": "покрываться катышками",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
