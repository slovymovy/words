                "senses": [
                    {
                        "sense_id": "868f1313-ca2d-3b4f-8074-c9b24821a71b",
                        "entry_id": "a9ba0d7e-f5fa-3946-820b-7cce8066d686",
                        "glosses": [
                            "Server, dessen Aufgabe die Ausführung eines serverseitigen Anwendungsprogramms ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9943858b-2205-49dd-953b-275b07f0e5c4",
                                "sense_id": "868f1313-ca2d-3b4f-8074-c9b24821a71b",
                                "text": "Mit der Version 8 der Serveranwendung muss auch der Anwendungsserver aufgestockt werden."
                            },
                            {
                                "example_id": "92619d1e-03da-49c2-aaed-83a93185d408",
                                "sense_id": "868f1313-ca2d-3b4f-8074-c9b24821a71b",
                                "text": "„Ein Anwendungsserver, englisch Application Server [ˌæplɪˈkeɪʃn̩ ˈsɝːvɚ], ist im Allgemeinen ein Server in einem Computernetzwerk, der Anwendungsprogramme ausführt. Im engeren Sinne bezeichnet der Begriff eine Software, die spezielle Dienste zur Verfügung stellt, wie beispielsweise Transaktionen, Authentifizierung oder den Zugriff auf Verzeichnisdienste, Webservices und Datenbanken über definierte Schnittstellen.“"
                            },
                            {
                                "example_id": "18625745-39b8-4340-bed0-f97e7da4f033",
                                "sense_id": "868f1313-ca2d-3b4f-8074-c9b24821a71b",
                                "text": "„Sollte ein Anwendungsserver ausfallen, gewährleistet ein einziges Ersatzsystem die Verfügbarkeit sämtlicher Produktivserver und stellt alle Anwendungen und Services innerhalb von Minuten wieder her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
