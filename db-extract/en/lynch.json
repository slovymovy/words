                    {
                        "sense_id": "226ce736-4484-3814-8265-654a0e3aaf7f",
                        "entry_id": "a43dfd81-edc0-3501-a3bc-df71616010ce",
                        "glosses": [
                            "To execute (somebody) without a proper legal trial or procedure, especially by hanging and backed by a mob."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7816f5f1-c717-4a08-937e-238d137bd000",
                                "sense_id": "226ce736-4484-3814-8265-654a0e3aaf7f",
                                "text": "Public anger erupted. Soldiers were lynched in the streets including young recruits proven to have been deceived by their generals about the true intentions of the attack."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7f18fb7-8007-3dbd-a5de-5f8f1aae5511",
                        "entry_id": "a43dfd81-edc0-3501-a3bc-df71616010ce",
                        "glosses": [
                            "To castigate severely."
                        ],
                        "tags": [
                            "broadly",
                            "colloquial",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c74967f8-b80c-49ec-ae5e-f88e78a93fcc",
                                "sense_id": "e7f18fb7-8007-3dbd-a5de-5f8f1aae5511",
                                "text": "I telephoned Bill Brandon in Oxford and begged him to get the new refrigeration unit into production before I got lynched."
                            }
                        ]
                    }
                ],
