                "translations": [
                    {
                        "translation_id": "6f645837-4548-4b14-a780-176aca508fbc",
                        "source_entry_id": "61201c45-3ee9-3822-a635-199bbef12112",
                        "source_sense_id": "38d9f439-232a-3681-9f67-4b5524a22ee0",
                        "source_sense_description": "benaming voor zoogdieren uit het geslacht Mammuthus",
                        "target_lang_word": "Mammut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mammut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19fa2ac5-858c-3a64-90fc-8c64be706478",
                                        "entry_id": "801f8542-9c28-3ebc-9bd1-b7fd085e8c4f",
                                        "glosses": [
                                            "Vertreter einer Gattung von ausgestorbenen Elefanten (Mammuthus)"
                                        ],
                                        "tags": [
                                            "Paläontologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849ea45a-79a2-49f2-9895-ddd5367f3d0d",
                                                "sense_id": "19fa2ac5-858c-3a64-90fc-8c64be706478",
                                                "text": "„Das Große Hasenloch diente Jägern in der Altsteinzeit als Aufenthaltsort. Knochenfunde aus der Höhle belegen, dass in dieser Gegend Mammute, Rentiere, Steinböcke, Höhlenbären, Fellnashörner und Höhlenlöwen lebten“"
                                            },
                                            {
                                                "example_id": "5b37e757-899c-45ea-8527-411a0787b163",
                                                "sense_id": "19fa2ac5-858c-3a64-90fc-8c64be706478",
                                                "text": "„Die gut isolierten langhaarigen Mammute der Kältesteppen überlebten offensichtlich dank entsprechender physiologischer Veränderungen auch mit weit weniger Wasser unter sehr kalten Bedingungen“"
                                            },
                                            {
                                                "example_id": "9086796d-78b5-4053-ad1d-f9196625fec8",
                                                "sense_id": "19fa2ac5-858c-3a64-90fc-8c64be706478",
                                                "text": "„Immer weiter führte ihn seine Jagd, fort von den fruchtbaren Ebenen mit ihren Mammuts, ihren Moschusochsen und Karibus.“"
                                            },
                                            {
                                                "example_id": "960748a1-8896-48a9-aab9-0bcf5548ed77",
                                                "sense_id": "19fa2ac5-858c-3a64-90fc-8c64be706478",
                                                "text": "„Es heißt Mammute, nicht Mammuts.“"
                                            },
                                            {
                                                "example_id": "b018c58e-f466-47a8-ad8e-6bad54e8449a",
                                                "sense_id": "19fa2ac5-858c-3a64-90fc-8c64be706478",
                                                "text": "Ab und zu wird in Sibirien im Permafrostboden ein gefrorenes Mammut gefunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dab269cc-a201-4f80-b378-db18308c2377",
                        "source_entry_id": "61201c45-3ee9-3822-a635-199bbef12112",
                        "source_sense_id": "38d9f439-232a-3681-9f67-4b5524a22ee0",
                        "source_sense_description": "benaming voor zoogdieren uit het geslacht Mammuthus",
                        "target_lang_word": "mammoth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mammoth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54a89fc4-69e6-37f4-918f-c97da0db3d1a",
                                        "entry_id": "f832d027-0748-3681-80b8-8de001557eea",
                                        "glosses": [
                                            "Any species of the extinct genus Mammuthus, of large, usually hairy, elephant-like mammals with long curved tusks and an inclined back, which became extinct with the last retreat of ice age glaciers during the late Pleistocene period, and are known from fossils, frozen carcasses, and Paleolithic cave paintings found in North America and Eurasia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbef5d4b-7d0e-40cf-9270-e16d08812bba",
                                                "sense_id": "54a89fc4-69e6-37f4-918f-c97da0db3d1a",
                                                "text": "Maimanto, as they say a sea elephant which is never seene, but accordinge to the Samuites he workes himselfe under grownde and so they finde his teeth or homes or bones in Pechore and Nova Zemla of which they […]"
                                            },
                                            {
                                                "example_id": "ec85227f-79ed-4e24-831d-dfeee6de98ac",
                                                "sense_id": "54a89fc4-69e6-37f4-918f-c97da0db3d1a",
                                                "text": "The Mammotovoy, which is dug out of the Earth in Siberia."
                                            },
                                            {
                                                "example_id": "ed05a8f7-7801-467f-9045-85f1dcbe87dc",
                                                "sense_id": "54a89fc4-69e6-37f4-918f-c97da0db3d1a",
                                                "text": "The old Siberian Russians affirm that the Mammuth is very like the Elephant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "315f28f5-a463-3796-bb84-6e135cb4563c",
                                        "entry_id": "f832d027-0748-3681-80b8-8de001557eea",
                                        "glosses": [
                                            "A mastodon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b972e04-c5db-4c58-a8a6-31ae6dc3c744",
                                                "sense_id": "315f28f5-a463-3796-bb84-6e135cb4563c",
                                                "text": "Many of our readers will remember the skeleton of the American mammoth, now the Mastodonton, being exhibited in London by Mr. Rembrandt Peale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "926bba55-e19b-3f2a-908b-2d44873d290a",
                                        "entry_id": "f832d027-0748-3681-80b8-8de001557eea",
                                        "glosses": [
                                            "Something very large of its kind."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a86e04b5-47a2-4519-8a14-ec96b0b6ec20",
                                                "sense_id": "926bba55-e19b-3f2a-908b-2d44873d290a",
                                                "text": "The last load, as we Yankees say, was a \"Mammoth\": […] producing an aggregate of nearly twelve cords."
                                            },
                                            {
                                                "example_id": "dbd9e9be-e217-479d-8475-dd6d5076bc4c",
                                                "sense_id": "926bba55-e19b-3f2a-908b-2d44873d290a",
                                                "text": "That is a lot of ship, about the size of big tankers before they grew so rapidly to become supers, mammoths and oilbergs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343ea3b8-75d2-34de-bcf1-5affa36da32d",
                                        "entry_id": "f832d027-0748-3681-80b8-8de001557eea",
                                        "glosses": [
                                            "A kind of large donkey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3184eb6f-2320-4305-bdd4-71e97fde5f52",
                                                "sense_id": "343ea3b8-75d2-34de-bcf1-5affa36da32d",
                                                "text": "Mammoths are taller than 54 inches. Each can carry up to 25% of its weight in combined tack, supplies, and rider."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mammoth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2f4b08a-21d7-3580-afc3-cbcdd6a0c166",
                                        "entry_id": "7c33272b-1b07-3e7b-8492-3078b4f6872e",
                                        "glosses": [
                                            "Comparable to a mammoth in its size; very large, huge, gigantic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c1e324-7bfb-4700-815f-3eff88219708",
                                                "sense_id": "c2f4b08a-21d7-3580-afc3-cbcdd6a0c166",
                                                "text": "I recieved [sic] from the persons to whom the inclosed is directed, a present of a quarter of a Mammoth-veal which at 115. days old weighed 438. lb."
                                            },
                                            {
                                                "example_id": "357ddf1f-8b87-490a-9e94-9213d47743a6",
                                                "sense_id": "c2f4b08a-21d7-3580-afc3-cbcdd6a0c166",
                                                "text": "A baker in this city offers Mammoth bread for sale. We suppose that his gigantic loaves were baked at a Salt Lick, and perhaps […]"
                                            },
                                            {
                                                "example_id": "5dacb1a5-fea2-418f-a7f5-0979c14c059c",
                                                "sense_id": "c2f4b08a-21d7-3580-afc3-cbcdd6a0c166",
                                                "text": "“Ha! ha!” he proudly cried, “a fig / For this, your mammoth torso! / Just watch me while I grow as big / As you—or even more so!”"
                                            },
                                            {
                                                "example_id": "fa15bcdb-7283-474d-95ea-5469dec2326d",
                                                "sense_id": "c2f4b08a-21d7-3580-afc3-cbcdd6a0c166",
                                                "text": "“[…] The task is mammoth but not hopeless and slowly we keep things going until this transition period is past.”"
                                            },
                                            {
                                                "example_id": "16a2d122-df24-45bd-94f1-d62097e31441",
                                                "sense_id": "c2f4b08a-21d7-3580-afc3-cbcdd6a0c166",
                                                "text": "The governor of the region said that all of the 13 missing were safe after a mammoth search and rescue operation."
                                            },
                                            {
                                                "example_id": "6df66dc2-0361-4b0f-9aff-829f28ff9a70",
                                                "sense_id": "c2f4b08a-21d7-3580-afc3-cbcdd6a0c166",
                                                "text": "Network Rail doesn't expect the line through Carmont to open for around a month, as it faces the mammoth task of recovering the two power cars and four coaches from ScotRail's wrecked train, repairing bridge 325, stabilising earthworks around the landslip, and replacing the track."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37b81f47-bc53-4db8-8ea2-77b16e6e8ceb",
                        "source_entry_id": "61201c45-3ee9-3822-a635-199bbef12112",
                        "source_sense_id": "38d9f439-232a-3681-9f67-4b5524a22ee0",
                        "source_sense_description": "benaming voor zoogdieren uit het geslacht Mammuthus",
                        "target_lang_word": "mammouth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mammouth",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a54ef02f-42d0-3e46-a443-42200196a25f",
                                        "entry_id": "193b1094-f92d-3786-a2b2-2697ece3704f",
                                        "glosses": [
                                            "Éléphantidé du genre Mammuthus dont l’espèce a disparu et qu’on retrouve à l’état fossile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cce12ca-53b3-3f7b-b25c-57b25a7ed4af",
                                        "entry_id": "193b1094-f92d-3786-a2b2-2697ece3704f",
                                        "glosses": [
                                            "Mammouth laineux, l’espèce la plus connue de ce genre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192a8c6b-ba20-4c39-9448-e0b95db6f93b",
                                                "sense_id": "5cce12ca-53b3-3f7b-b25c-57b25a7ed4af",
                                                "text": "Cette côte compte aussi de nombreux établissements, dans lesquels les indigènes recueillent des dents de mammouths, car ces parages recèlent en grand nombre des squelettes de ces grands antédiluviens, réduits à l’état fossile."
                                            },
                                            {
                                                "example_id": "e30839ee-4679-43a4-99b4-852e02ba95ab",
                                                "sense_id": "5cce12ca-53b3-3f7b-b25c-57b25a7ed4af",
                                                "text": "L’homme primitif, celui qui vivait à la même époque que tous ces grands animaux dont l’espèce est éteinte, tels que le mammouth, l’ours des cavernes, le cerf à bois gigantesques, etc., ne savait mettre en usage que des os, des cailloux, des débris de silex […]"
                                            },
                                            {
                                                "example_id": "31fc14f7-f041-4a8f-9c19-233fd26400fe",
                                                "sense_id": "5cce12ca-53b3-3f7b-b25c-57b25a7ed4af",
                                                "text": "C’est assez hasardé, ce nous semble, d’avancer comme Cuvier qu’il y a eu trois créations successives […] Et puis, ne répugne-t-il pas à l’esprit de faire apparaître sur la terre un mammouth grand comme trois ou quatre éléphants, par la seule action des causes extérieures ?"
                                            },
                                            {
                                                "example_id": "1584ebce-29b6-43ce-a311-39f1b86ecd22",
                                                "sense_id": "5cce12ca-53b3-3f7b-b25c-57b25a7ed4af",
                                                "text": "Quand on songe à ces faits, on ne peut s’étonner que le mammouth ait pu apparaître en Islande, comme me l’a affirmé le savant médecin islandais Hjaltalin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6709012b-c006-380e-a673-defcd535acfc",
                                        "entry_id": "193b1094-f92d-3786-a2b2-2697ece3704f",
                                        "glosses": [
                                            "Personne ou objet imposant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7e31dc-a0f5-4e1f-af92-3eea5da77d3f",
                                                "sense_id": "6709012b-c006-380e-a673-defcd535acfc",
                                                "text": "Un mammouth, voilà comment on peut définir le télescope spatial James-Webb (JWST, une mission de la NASA, de l’ESA et de l’Agence spatiale canadienne), successeur annoncé du célèbre Hubble. Mammouth en raison des dimensions de son miroir collecteur de lumière (6,5 mètres de diamètre), de sa masse au décollage (6,5 tonnes) mais aussi de son coût qui n’a cessé d’enfler au fil des années pour approcher aujourd’hui les 9 milliards de dollars."
                                            },
                                            {
                                                "example_id": "023c7853-7424-4e2e-b46e-d7faf84d3561",
                                                "sense_id": "6709012b-c006-380e-a673-defcd535acfc",
                                                "text": "Le 14 mars 1952, le truand Abel Danos, dit “le Mammouth”, tombait sous les balles d’un peloton d’exécution dans les fossés du Fort de Montrouge en criant “Vive la France !”"
                                            },
                                            {
                                                "example_id": "35b04374-9b87-4f29-a193-1c35478c7110",
                                                "sense_id": "6709012b-c006-380e-a673-defcd535acfc",
                                                "text": "Après le match de mammouth de Rudy Gobert (20 points, 17 rebonds dont 7 offensifs et 7 fautes provoquées) en 8ᵉ contre la Turquie samedi, Timothé Luwawu-Cabarrot a défendu le pivot de l’équipe de France, trop critiqué, selon lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74fc206b-0ce1-3c0c-87b1-17f7bc4bbc87",
                                        "entry_id": "193b1094-f92d-3786-a2b2-2697ece3704f",
                                        "glosses": [
                                            "L’Éducation nationale."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b57fcc0c-3823-4893-a657-330f21bf74da",
                                                "sense_id": "74fc206b-0ce1-3c0c-87b1-17f7bc4bbc87",
                                                "text": "A la rentrée prochaine, il manquera donc des enseignants devant les élèves, une situation certes pas nouvelle mais qui n’a jamais été aussi critique. Le mammouth, toutefois, ne compte pas se laisser abattre : à l’échelle nationale ou académique, des solutions sont trouvées pour ne pas laisser des enfants et adolescents sans enseignement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bf1270d-a1fa-301a-be47-e16633acaefb",
                                        "entry_id": "193b1094-f92d-3786-a2b2-2697ece3704f",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Il se blasonne comme l’éléphant dont il se distingue par la ligne du dos qui est oblique et les défenses recourbées."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea81b7bb-d131-4f8c-b158-91e783af9699",
                                                "sense_id": "1bf1270d-a1fa-301a-be47-e16633acaefb",
                                                "text": "D’argent au mammouth contourné au naturel défendu du champ sur une terrasse isolée de sinople, le tout soutenu de l’inscription PMC en lettres capitales d’argent accolées 2 et 1 et surmonté de l’inscription \"PRIGNAC et MARCAMPS\" de sable, qui est de Prignac-et-Marcamps de Gironde → voir illustration « armoiries avec un mammouth »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73323162-810f-4621-bfb5-066f1eda87da",
