                        ]
                    },
                    {
                        "translation_id": "e0a3878a-2fad-42f2-9bc5-7c659febdb17",
                        "source_entry_id": "44aacdb8-fe04-33dc-b32c-fcf0eb789dd2",
                        "source_sense_id": "32080a82-e042-3acc-b867-a8175cf08eaa",
                        "source_sense_description": "Vermittler von Immobilien zum Kauf oder zur Miete",
                        "target_lang_word": "realtor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "realtor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c4a1072-0b69-311c-ae09-7cef9c12d825",
                                        "entry_id": "b031b3f9-6738-393f-bd4d-3ac9a321d754",
                                        "glosses": [
                                            "A person or business that sells or leases out real estate, acting as an agent for the property owner."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ba92938-79a9-48a6-89ef-65eff76c74d3",
                                                "sense_id": "4c4a1072-0b69-311c-ae09-7cef9c12d825",
                                                "text": "It was composed of an engineer, if I remember correctly, a town planner, a realtor, and occasionally an architect […]"
                                            },
                                            {
                                                "example_id": "dd8e9114-5237-4a2f-b444-d901eb2a4396",
                                                "sense_id": "4c4a1072-0b69-311c-ae09-7cef9c12d825",
                                                "text": "First place, we ought to insist that folks call us ‘realtors’ and not ‘real-estate men.’ Sounds more like a reg’lar profession."
                                            },
                                            {
                                                "example_id": "2466e739-84ad-43d5-a5f5-c2d83fbe5f77",
                                                "sense_id": "4c4a1072-0b69-311c-ae09-7cef9c12d825",
                                                "text": "Intrigued by the prospect of an additional commission, the realtor hurriedly assured me he foresaw no problem in obtaining the lease."
                                            },
                                            {
                                                "example_id": "458d782a-daec-4cdc-9749-2481deb61688",
                                                "sense_id": "4c4a1072-0b69-311c-ae09-7cef9c12d825",
                                                "text": "The terms agent, broker, and realtor are often used interchangeably."
                                            },
                                            {
                                                "example_id": "72d6c49d-dcb7-40e7-ac74-6240898bc144",
                                                "sense_id": "4c4a1072-0b69-311c-ae09-7cef9c12d825",
                                                "text": "The realtor was like a carnivore, ready to spring. He was originally from New York and he seemed like the kind of guy who could smell a deal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fff4ea3-6c54-4226-8658-90d83f96bf6a",
                        "source_entry_id": "44aacdb8-fe04-33dc-b32c-fcf0eb789dd2",
                        "source_sense_id": "32080a82-e042-3acc-b867-a8175cf08eaa",
                        "source_sense_description": "Vermittler von Immobilien zum Kauf oder zur Miete",
                        "target_lang_word": "agent immobilier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agent immobilier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2a65efd-02cf-3625-8226-7e727a70e91e",
                                        "entry_id": "7afc4f35-dd34-3c58-8dd6-87956f621c32",
                                        "glosses": [
                                            "Intermédiaire sur les transactions de biens immobiliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764d0dad-1c8b-4e43-b676-2500b07bfdfe",
                                                "sense_id": "b2a65efd-02cf-3625-8226-7e727a70e91e",
                                                "text": "Il se souvenait très bien du jour où il avait décidé d’acheter cet appartement, neuf ans auparavant ; il revoyait l’agent immobilier, trapu et satisfait, vantant la lumière exceptionnelle, sans dissimuler la nécessité de certains « rafraîchissements ». Il s’était alors dit qu’il aurait dû être agent immobilier, ou gynécologue."
                                            },
                                            {
                                                "example_id": "828b3b16-7983-4767-88b6-f22878587823",
                                                "sense_id": "b2a65efd-02cf-3625-8226-7e727a70e91e",
                                                "text": "Près d’un million de transactions immobilières ont lieu chaque année en France et les agents immobiliers se voient précisément reprocher par l’organisme Traitement du renseignement et action contre les circuits financiers clandestins (Tracfin) de ne pas suffisamment coopérer à ce combat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
