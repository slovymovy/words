                        "sense_id": "ca437d10-14e0-3a1a-882b-6d17357a2e1b",
                        "entry_id": "6ea1c86b-f0ba-3fb6-a45f-546d4ae249ad",
                        "glosses": [
                            "Pratiquer une néphrostomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c47c63cb-ce90-4ad5-92e7-06396f58427d",
                                "sense_id": "ca437d10-14e0-3a1a-882b-6d17357a2e1b",
                                "text": "Si les deux reins sont peu hypertrophiés, il vaut mieux néphrostomiser le droit, plus facile à trouver."
                            },
                            {
                                "example_id": "e237e4c6-7511-4bdf-97a0-257bfea13665",
                                "sense_id": "ca437d10-14e0-3a1a-882b-6d17357a2e1b",
                                "text": "L'urographie intraveineuse a conduit dans ce cas à un geste contraire au dogme classique, qui conseille de néphrostomiser le rein douloureux."
                            }
                        ]
                    }
