                "senses": [
                    {
                        "sense_id": "231fa23a-ee93-388a-8cba-aaa0fd778ca2",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Extrémité ou bord coupé en biais, en talus."
                        ],
                        "tags": [],
                        "note": "se dit surtout du bord des glaces de miroir, des glaces de voiture, etc., et du tranchant de certains outils",
                        "examples": [
                            {
                                "example_id": "e7eff161-b566-4ba3-8655-62e5e88484c5",
                                "sense_id": "231fa23a-ee93-388a-8cba-aaa0fd778ca2",
                                "text": "C’est entre les biseaux et les barres du châssis que se mettent encore d'autres pièces de bois beaucoup plus courtes, taillées aussi en biseau, nommées les coins, qu’il chasse à coups de marteau, à l'aide d’un cognoir ou décognoir, qui est un véritable coin de bois."
                            },
                            {
                                "example_id": "31df970a-edfd-4dd3-b4cd-7b2118e13580",
                                "sense_id": "231fa23a-ee93-388a-8cba-aaa0fd778ca2",
                                "text": "Ces remarques, faîtes au sujet des biseaux d’affutage doubles, tels que ceux des haches, s'appliquent également, aux outils tranchants avec un seul biseau, comme les ciseaux à bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8bd0491-937c-3165-b207-f7d7e088e4a4",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Chose en biais."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a73f7dc8-57b4-369f-afba-f094f2b6fbd7",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "« On tourne ! Penchez une peu la tête, rentrez la pointe du pied. Souriez… Non, non, un sourire plus fermé, je vous prie. Ce que nous appelons le sourire en biseau. Souriez en biseau… Parfait ! » — (Henri Troyat, Le mort saisit le vif, 1942, réédition Le Livre de Poche, page 112)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "25a2c722-8304-3610-b65c-eda47b64643c",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Principales faces qui environnent la table d’un brillant."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3ad59b58-9838-36dc-888a-95c7a4526b05",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Taille qui permet d’enchâsser dans le cercle d’ouverture le verre d’une montre ou d’une pendule."
                        ],
                        "tags": [
                            "Horlogerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "60c262df-509f-343e-bbff-0a72080eb713",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Bec de l’embouchure de certains instruments, tels que la clarinette, le flageolet, la plupart des flûtes, et aussi de la partie terminale d’un tuyau d’orgue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6354e66d-4a95-3117-b3de-630c563825e0",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Morceaux de bois entourant les pages de caractères, et dont un côté est taillé obliquement pour recevoir les coins qui servent à serrer la forme."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "5afb18e0-7bdd-4a90-a6c2-735ac17b9443",
                                "sense_id": "6354e66d-4a95-3117-b3de-630c563825e0",
                                "text": "Les coins se placent entre les biseaux et le fer du châssis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6eeb67d-f7be-3fd1-9df4-2d0ce7b6bf9b",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Ces outils eux-mêmes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8a382328-e6bc-4bfb-9dda-3f1efb4b937d",
                                "sense_id": "f6eeb67d-f7be-3fd1-9df4-2d0ce7b6bf9b",
                                "text": "Un biseau de menuisier, de tourneur."
                            }
                        ]
                    },
                    {
                        "sense_id": "e100a9a3-542b-3460-b458-e847be7dd69f",
                        "entry_id": "43fb106f-177b-3afe-8af7-2889fefce69f",
                        "glosses": [
                            "Période entre deux postes où les deux activités se cumulent partiellement."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "283c59cb-9122-4d99-bb8c-6935df8700f8",
                                "sense_id": "e100a9a3-542b-3460-b458-e847be7dd69f",
                                "text": "J'ai fait un biseau de 2 mois entre mon ancien poste et mon nouveau poste."
                            }
                        ]
