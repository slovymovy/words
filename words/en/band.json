                                "target_lang_word": "带子",
                                "target_lang_sense_clarification": "条状物"
                            },
                            {
                                "target_lang_word": "橡皮筋",
                                "target_lang_sense_clarification": "用于捆绑的弹性环"
                            },
                            {
                                "target_lang_word": "戒指",
                                "target_lang_sense_clarification": "环状装饰物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab810469-112e-37fe-86ea-c471ee56e788",
                    "sense_definition": "A group of people who share a common interest or purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>band</w> of rebels fought against the empire for many years.",
                            "target_lang_translations": {
                                "ru": "Небольшой <w>отряд</w> повстанцев сражался против империи много лет.",
                                "zh": "一小<w>队</w>反叛者与帝国抗争了多年。"
                            }
                        },
                        {
                            "text": "The captain led his <w>band</w> of sailors across the dangerous ocean.",
                            "target_lang_translations": {
                                "ru": "Капитан вел свой <w>отряд</w> моряков через опасный океан.",
                                "zh": "船长带领他的水手<w>队伍</w>穿越了危险的海洋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gang",
                        "party",
                        "troop",
                        "company"
                    ],
                    "common_phrases": [
                        "band of brothers",
                        "band of thieves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, объединенных общими интересами или целью.",
                        "zh": "因共同利益或目的而聚集在一起的一群人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отря́д",
                                "target_lang_sense_clarification": "организованная группа"
                            },
                            {
                                "target_lang_word": "ба́нда",
                                "target_lang_sense_clarification": "преступная группа или компания"
                            },
                            {
                                "target_lang_word": "гру́ппа",
                                "target_lang_sense_clarification": "объединение людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "队伍",
                                "target_lang_sense_clarification": "有组织的群体"
                            },
                            {
                                "target_lang_word": "团伙",
                                "target_lang_sense_clarification": "贬义，指犯罪或不法群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5baac440-59b3-3cfb-a94e-bfbdc0db1bbc",
                    "sense_definition": "A stripe or long narrow area that is different in color or texture from its surroundings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strip_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake has a distinct red <w>band</w> around its neck.",
                            "target_lang_translations": {
                                "ru": "У змеи есть отчетливая красная <w>полоса</w> вокруг шеи.",
                                "zh": "这条蛇的脖子上有一圈明显的红色<w>条纹</w>。"
                            }
                        },
                        {
                            "text": "A <w>band</w> of golden light appeared on the horizon just before sunrise.",
                            "target_lang_translations": {
                                "ru": "<w>Полоса</w> золотистого света появилась на горизонте перед самым восходом.",
                                "zh": "日出前，地平线上出现了一道金色的光<w>带</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stripe",
                        "streak",
                        "line",
                        "bar"
                    ],
                    "common_phrases": [
                        "band of light",
                        "band of color"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоса или длинный узкий участок, отличающийся по цвету или текстуре от окружения.",
                        "zh": "颜色或质地与周围不同的长条状区域。"
                    },
