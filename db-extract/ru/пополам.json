                            {
                                "example_id": "7c777a41-eafd-4b70-a0f6-a93eff7f903e",
                                "sense_id": "ed5dbb2a-aa0f-3795-8836-bfe20044d92e",
                                "text": "Наза́д и посмотре́ть стра́шно. Там всё тако́е го́ре, что се́рдце попола́м рвётся при одно́м воспомина́нии.",
                                "translation": "It is dreadful to look back, too. There is such sorrow the past, and my heart is torn in two at the very memory of it.",
                                "english": "It is dreadful to look back, too. There is such sorrow the past, and my heart is torn in two at the very memory of it."
                            }
                        ]
                    },
