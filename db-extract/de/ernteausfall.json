                        "examples": [
                            {
                                "example_id": "5e023027-d227-4a10-acb7-37062653f051",
                                "sense_id": "56cf1a5f-bd90-32c2-b57a-466b99499353",
                                "text": "Der Ernteausfall ist im allgemeinen als gut zu bezeichnen, besonders die Qualität der Kartoffelernte hat die Bauern zufriedengestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
