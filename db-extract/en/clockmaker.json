                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db928432-a670-4084-b6ba-e47f0363244b",
                        "source_entry_id": "c77da694-07e8-38c2-8615-e38cd028e2ef",
                        "source_sense_id": "15cf7f3d-24c7-3cb4-b488-a77f7cf373f7",
                        "source_sense_description": "ein Handwerker, der Uhren herstellt und repariert",
                        "target_lang_word": "Uhrmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uhrmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                        "entry_id": "a4f1c8c1-8838-3cec-a367-4d27557a0c45",
                                        "glosses": [
                                            "Handwerker, der sich mit der Herstellung, der Reparatur und/oder dem Verkauf von Uhren oder Uhrwerken beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b7ea7e-e177-4784-9330-2a4b397ceee5",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "Noch heute brachte er die kaputte Uhr zum Uhrmacher."
                                            },
                                            {
                                                "example_id": "3564b807-e1e7-4ec7-b532-86dc0342a5d7",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Die Uhrmacher gaben Sie alle ratlos mir zurück; Sie wollten mit solchem Teufelsstück Gar nichts zu tun zu haben.“"
                                            },
                                            {
                                                "example_id": "be5fa564-79bb-43b9-81ab-3c03de11ef40",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Meist genügt es, die Uhr zum Uhrmacher seines Vertrauens zu bringen, um sie dort entmagnetisieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "c48b22aa-ef81-44ab-b44b-40d2f8ee6782",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Im frühen achtzehnten Jahrhundert gab es (abgesehen von dem Autodidakten John Harrison selbst), soweit wir wissen, keinen einzigen Uhrmacher im nördlichen Lincolnshire.“"
                                            },
                                            {
                                                "example_id": "b3e2b274-addd-41f1-bef4-81f0ce0363df",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Sein Vater war ein Uhrmacher, der sich geschickt in das Leben der alten Garnisonsstadt einordnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
