                                                "example_id": "4f23edb2-6fc6-4f2a-98b9-5c253c95dcc1",
                                                "sense_id": "af6477e6-1721-34bb-b69d-5afe8564a811",
                                                "text": "Man muss sich der Wirklichkeit stellen."
                                            },
                                            {
                                                "example_id": "5bfe9765-4984-41f5-b6c8-dbeadeefcf59",
                                                "sense_id": "af6477e6-1721-34bb-b69d-5afe8564a811",
                                                "text": "In Wirklichkeit interessiert es dich nicht."
                                            },
                                            {
                                                "example_id": "83fa129e-de7b-4c27-9a61-d285d02f09f0",
                                                "sense_id": "af6477e6-1721-34bb-b69d-5afe8564a811",
                                                "text": "„Was die soziale Wirklichkeit der DDR in ihren späten Jahren vor allem kennzeichnete, waren häufige Altersarmut und grassierende Wohnungsnot, wachsender Pflegenotstand und die zunehmende Überforderung des Gesundheitswesens.“"
                                            },
                                            {
                                                "example_id": "9d4c9744-9497-44a3-814a-6fa75df3369f",
                                                "sense_id": "af6477e6-1721-34bb-b69d-5afe8564a811",
                                                "text": "„Die Deutschen wie die Russen wissen aber, dass die Wirklichkeit größer und vielschichtiger ist als jede Realität – unsere Träume und Sehnsüchte gehören dazu, unsere Hoffnungen und Ängste.“"
                                            },
                                            {
                                                "example_id": "1118bef0-029d-4728-8dec-4ed434f7445a",
                                                "sense_id": "af6477e6-1721-34bb-b69d-5afe8564a811",
                                                "text": "„Dieser Eindruck verdichtet sich in der Tat immer dann, wenn Risikosportler nicht sachlich und objektiv über ihre Erlebnisse berichten, sondern euphorisch übersteigert in Heldentaten schwelgen, […] mit Fliegerlatein die Wirklichkeit zu überhöhen versuchen.“"
                                            },
                                            {
                                                "example_id": "e0345410-e402-44bc-b28d-158b9271e33f",
                                                "sense_id": "af6477e6-1721-34bb-b69d-5afe8564a811",
                                                "text": "„Wieder rannen Wirklichkeit und Traumgebilde zusammen, und sprach jemand, er selbst oder ein anderer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d45447f-a3a2-408c-8417-79fc00bd8cd2",
                        "source_entry_id": "4145bd67-76a3-3c22-8358-8b68c5657c17",
                        "source_sense_id": "c844107b-a84a-3da2-82b9-c539bfde3050",
                        "source_sense_description": "ohne Plural, veraltet: Wirklichkeit, Tatsächlichkeit",
                        "target_lang_word": "Tatsächlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tatsächlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa692031-7932-31b8-893e-c25a8cfa362c",
                                        "entry_id": "0755d0d7-115e-3c90-aea2-81bb47d3cdf5",
                                        "glosses": [
                                            "Eigenschaft der Welt, wie sie unabhängig von ihrer Wahrnehmung ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd679198-d6ba-4979-b6fa-d843c0ef9a4f",
                                                "sense_id": "fa692031-7932-31b8-893e-c25a8cfa362c",
                                                "text": "„Wäre die tiefste und fundamentalste Sache der Wirklichkeit, wäre die Quelle aller sonstigen Tatsächlichkeit etwas, das uns bis zu einem gewissen Grad ähnelt – wäre es ein rationaler Geist und bezögen wir unsere rationale Geistigkeit von ihm –, dann wäre unsere Überzeugung vertrauenswürdig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6cccea3-ebff-318b-9b86-cc52f9a771c8",
                                        "entry_id": "0755d0d7-115e-3c90-aea2-81bb47d3cdf5",
                                        "glosses": [
                                            "wahrer Umstand, Tatsache"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa8ead27-5d77-46a3-b623-7fbef7c89ffe",
                        "source_entry_id": "4145bd67-76a3-3c22-8358-8b68c5657c17",
                        "source_sense_id": "0763de79-fd0c-3c07-a3df-1c00c3e79aab",
                        "source_sense_description": "ohne Plural: Gegenwartsbezogenheit, Aktualität",
