                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu n'as rien cassé en tombant dans l'escalier, <w>heureusement</w> !"
                        },
                        {
                            "text": "Vous avez pensé à fermer la porte à clé, <w>heureusement</w> !"
