                "senses": [
                    {
                        "sense_id": "55d45573-41e0-32b6-9c30-79b1e6548899",
                        "entry_id": "1b985f1f-2427-3a30-989f-522c29c50304",
                        "glosses": [
                            "действие по значению гл. вылепливать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df39a050-de85-4366-9256-55cda7cf8050",
                                "sense_id": "55d45573-41e0-32b6-9c30-79b1e6548899",
                                "text": "Вылепливание горшка."
                            },
                            {
                                "example_id": "f8f44d77-d4c9-474a-8f67-aaf6af13bc1e",
                                "sense_id": "55d45573-41e0-32b6-9c30-79b1e6548899",
                                "text": "Рассеяния моих тех дней незатейливы. Вылепливание снежных баб, выпиливание лобзиком по фанере, рассуждения на заданные себе самому темы, солнечная игротерапия."
                            }
                        ]
                    },
                    {
                        "sense_id": "c34d1df8-f36d-398c-b2d9-8808d91dcd36",
                        "entry_id": "1b985f1f-2427-3a30-989f-522c29c50304",
                        "glosses": [
                            "перен. формирование, придание реальной формы, очертаний (представлений, образов, и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebd9dd5-f434-4a86-ade4-bbc07f3f02bf",
                                "sense_id": "c34d1df8-f36d-398c-b2d9-8808d91dcd36",
                                "text": "Гераклит соблюдает научную чистоту, когда называет грязью вылепливание богов, о которых мы не знаем, какие они на самом деле."
                            }
                        ]
                    }
