                "senses": [
                    {
                        "sense_id": "3c021882-1d1f-3133-a77b-db271957933d",
                        "entry_id": "cd231793-8fa9-3fe8-b329-b7e218ba57f9",
                        "glosses": [
                            "η αδιαντροπιά"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07dc423a-00d4-4d45-a39c-3c44eef3cafb",
                                "sense_id": "3c021882-1d1f-3133-a77b-db271957933d",
                                "text": "Il a tenu un discours plein d'impudeur. Έβγαλε έναν αδιάντροπο λόγο."
                            },
                            {
                                "example_id": "c2d3336f-7666-4add-bdb9-6e2b2030e760",
                                "sense_id": "3c021882-1d1f-3133-a77b-db271957933d",
                                "text": "Il y a de l'impudeur dans son attitude. Η συμπεριφορά του έχει μια αδιαντροπιά.",
                                "translation": "≈ συνώνυμα: immodestie\n#:: ≠ αντώνυμα: pudeur, réserve, retenue"
                            }
                        ]
                    },
                    {
                        "sense_id": "ef0c101b-c485-38a8-8174-bb9548792799",
                        "entry_id": "cd231793-8fa9-3fe8-b329-b7e218ba57f9",
                        "glosses": [
                            "η θρασύτητα, το θράσος"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772f37e2-8e3b-4786-aeee-e29b58b930e7",
                                "sense_id": "ef0c101b-c485-38a8-8174-bb9548792799",
                                "text": "Malgré ses biens, il a l'impudeur de demander encore. Παρ'όλα τα αγαθά του, έχει το θράσος να ζητάει κι άλλα.",
                                "translation": "≈ συνώνυμα: cynisme, indécence\n#:: ≠ αντώνυμα: confusion, honte"
                            }
                        ]
                    }
