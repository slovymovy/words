        "fr-extract.jsonl": [
            {
                "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                "word": "monstruosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04b5fd87-678c-4ab7-adc6-c8c556e3e358",
                        "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "monstruosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11f8581c-d2e6-3b51-861b-685840ed11ce",
                        "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                        "glosses": [
                            "Caractère de ce qui est monstrueux. Anomalie grave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1a6313-d715-476c-b006-cb72b80bb295",
                                "sense_id": "11f8581c-d2e6-3b51-861b-685840ed11ce",
                                "text": "Comment expliquer la monstruosité de ces actes ?"
                            },
                            {
                                "example_id": "c264072a-258f-4364-95ce-57bd975a51fa",
                                "sense_id": "11f8581c-d2e6-3b51-861b-685840ed11ce",
                                "text": "Léodagan : Vous êtes marié, comme moi ; vous savez que la monstruosité peut prendre des formes très diverses."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                        "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                        "glosses": [
                            "Personne ou chose monstrueuse."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "30f319ab-44e6-4c1b-b16e-a9b7eb0dc11a",
                                "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                                "text": "Un des clous du spectacle est l'exhibition de ces deux sœurs Josepha que dame nature s'est plu à lier de si étroite manière. Ces sortes de monstruosités, n'ayant rien à voir avec l'art dramatique, on me permettra de n'en point parler davantage."
                            },
                            {
                                "example_id": "9ed63ae2-a542-4919-a450-51964ce02553",
                                "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                                "text": "On en vient à lui attribuer presque toutes les malformations, presque toutes les monstruosités ; c’est l’âge d’or de la tératologie syphilitique."
                            },
                            {
                                "example_id": "7a99ba81-0761-4abe-83e5-0789caf2f4ff",
                                "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                                "text": "Mais ces propos me paraissent reposer sur une vision complètement « enchantée » de la concurrence, comme s’il était encore possible de croire qu’un « marché sain » est en mesure de nous sauver des monstruosités qu’il a lui-même engendrées."
                            }
                        ]
                    },
                    {
                        "sense_id": "f801c681-6b10-32bc-bb11-b6746485dbd0",
                        "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                        "glosses": [
                            "Ce qui suscite l’indignation, la réprobation, ce qui choque la raison ou la bienséance."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5e80e192-aa00-45e6-9672-b476ad363f9d",
                                "sense_id": "f801c681-6b10-32bc-bb11-b6746485dbd0",
                                "text": "Il prend plaisir à choquer mes parents en proférant des monstruosités."
                            },
                            {
                                "example_id": "755a5066-d4ae-4844-bb0b-e010ae7b661b",
                                "sense_id": "f801c681-6b10-32bc-bb11-b6746485dbd0",
                                "text": "Depuis que je vais dans la haute société, j’ai rencontré des monstruosités habillées de satin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98cc6096-0968-45e2-888d-668c5a61c9bf",
                        "source_entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                        "target_lang_word": "Abscheulichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abscheulichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81b2a77a-de13-329e-a8d7-34e931be5a9d",
                                        "entry_id": "547bb73b-0a84-3079-bffe-e9212f8f8d00",
                                        "glosses": [
                                            "etwas Abscheuliches, Abstoßendes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57082934-01e5-4a37-be34-f7baf9dfca4e",
                                                "sense_id": "81b2a77a-de13-329e-a8d7-34e931be5a9d",
                                                "text": "Über die Abscheulichkeit der Taten herrscht in der westlichen Gesellschaft Konsens und kaum Erklärungsnot: Der Täter, der sich oft auf den Islam beruft, fühle sich aufgrund äußeren Drucks gezwungen, die \"Ehre\" wiederherzustellen, erklärt ein Psychologe."
                                            },
                                            {
                                                "example_id": "373c7e35-4a2c-449e-8cbb-c8a854f82b3e",
                                                "sense_id": "81b2a77a-de13-329e-a8d7-34e931be5a9d",
                                                "text": "„So mußte ich mir vorwerfen, daß ich ein gehässiges Gemüt besäße; dabei hatte ich mich einer solchen Abscheulichkeit bisher nie für fähig gehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc5ec03b-6a6c-4637-9373-c0327aae2691",
                        "source_entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                        "target_lang_word": "Schändlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b9f23c0a-0fe0-44d1-b7e9-b9e1848f2002",
                        "source_entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                        "target_lang_word": "Ungeheuerlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungeheuerlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f847959-8b12-35a9-9023-0a510bdf227a",
                                        "entry_id": "096c768c-4419-3255-bd05-4c2b1d04835e",
                                        "glosses": [
                                            "Eigenschaft, extrem schrecklich/ungeheuerlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22571869-8e23-4723-9c78-d5cf3c1e1572",
                                                "sense_id": "8f847959-8b12-35a9-9023-0a510bdf227a",
                                                "text": "„Nichts jedoch hätte bei ihnen auf die Ungeheuerlichkeit eines Verbrechens hingedeutet, nicht einmal bei Pepa, die am unbeherrschtesten war.“"
                                            },
                                            {
                                                "example_id": "cf2e090f-92f3-4fad-962f-75a75d1f8b1d",
                                                "sense_id": "8f847959-8b12-35a9-9023-0a510bdf227a",
                                                "text": "„Es ist eine ganz gewöhnliche deutsche Familiengeschichte, die trotz, vielleicht auch wegen ihrer Ungeheuerlichkeit selten erzählt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e66890f-5c8d-4977-bb51-6a4d79e660e2",
                        "source_entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
