{
    "word_family": [
        "geloof",
        "geloven",
        "ongeloof",
        "ongelovige"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "459cad3f-a879-3ab2-8331-eb5a1188eeac",
                    "sense_definition": "Niet overtuigd van het bestaan van een god of het niet aanhangen van een religie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoewel zijn ouders erg vroom zijn, is hij zelf volledig <w>ongelovig</w> gebleven.",
                            "target_lang_translations": {
                                "en": "Although his parents are very pious, he himself has remained completely <w>unbelieving</w>."
                            }
                        },
                        {
                            "text": "In een <w>ongelovig</w> gezin wordt er meestal niet gebeden voor het eten.",
                            "target_lang_translations": {
                                "en": "In a <w>non-believing</w> family, people usually do not pray before meals."
                            }
                        }
                    ],
                    "synonyms": [
                        "irreligieus"
                    ],
                    "antonyms": [
                        "gelovig",
                        "religieus"
                    ],
                    "common_phrases": [
                        "ongelovig gezin",
                        "volledig ongelovig"
                    ],
                    "target_lang_definitions": {
                        "en": "Not convinced of the existence of a god or not adhering to a religion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unbelieving",
                                "target_lang_sense_clarification": "lacking religious faith"
                            },
                            {
                                "target_lang_word": "irreligious",
                                "target_lang_sense_clarification": "not following religious principles"
                            },
                            {
                                "target_lang_word": "non-believing",
                                "target_lang_sense_clarification": "not having a belief in a deity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77cbd685-7551-3080-ba17-979b43dad6b8",
                    "sense_definition": "Met verbazing of wantrouwen reagerend op iets dat moeilijk te bevatten is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek met <w>ongelovige</w> ogen naar de goochelaar die de kaart liet verdwijnen.",
                            "target_lang_translations": {
                                "en": "He looked with <w>incredulous</w> eyes at the magician who made the card disappear."
                            }
                        },
                        {
                            "text": "Toen ze de hoofdprijs won, staarde ze met een <w>ongelovige</w> blik naar het scherm.",
                            "target_lang_translations": {
                                "en": "When she won the grand prize, she stared at the screen with a <w>disbelieving</w> look."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ongelovige blik",
                        "ongelovige ogen"
                    ],
                    "target_lang_definitions": {
                        "en": "Reacting with amazement or distrust to something that is difficult to comprehend."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incredulous",
                                "target_lang_sense_clarification": "unwilling or unable to believe something"
                            },
                            {
                                "target_lang_word": "disbelieving",
                                "target_lang_sense_clarification": "showing a lack of belief in what is seen or heard"
                            },
                            {
                                "target_lang_word": "unbelieving",
                                "target_lang_sense_clarification": "expressing doubt or skepticism"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}