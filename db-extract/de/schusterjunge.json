                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f643aa58-f25d-4f27-85ed-75dd920c329a",
                                "sense_id": "271c03eb-aae8-3761-803d-2e1fbec8350b",
                                "text": "Zum Frühstück hätte ich gerne einen Schusterjungen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "1b77180b-4dea-376f-bfd8-3877c2f7ffa6",
