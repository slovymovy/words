                                "target_senses": [
                                    {
                                        "sense_id": "384d3a38-d7d3-3020-a63e-05f1db2f0721",
                                        "entry_id": "68ff989e-9f5e-3f09-a67d-777d8ae4e93e",
                                        "glosses": [
                                            "The terminal part of the large intestine through which feces pass after exiting the colon, but before leaving the body through the anus or cloaca."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23cab4b-3d15-48aa-88f9-ab3e8b73ec22",
                                                "sense_id": "384d3a38-d7d3-3020-a63e-05f1db2f0721",
                                                "text": "Using an alcohol enema involves placing a small tube into someone’s rectum and pouring alcohol into the colon. Because the alcohol is absorbed directly into the bloodstream, the recipient gets drunk faster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
