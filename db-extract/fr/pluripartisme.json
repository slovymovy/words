                "senses": [
                    {
                        "sense_id": "5fcabdc8-76ef-3c43-9749-b00c9bca81b1",
                        "entry_id": "c5867459-8882-391c-9f07-6660a9c905ae",
                        "glosses": [
                            "Coexistence de plusieurs partis politiques dans un même État."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32fdbb8-d58b-4a8f-9302-208d8aa0f2d1",
                                "sense_id": "5fcabdc8-76ef-3c43-9749-b00c9bca81b1",
                                "text": "Comment se manifesteront les « dissonances » sociales que provoque l’actuelle révolution technologique ? Dans le Parti, disent certains. Par le pluripartisme, préconisent les autres."
                            },
                            {
                                "example_id": "839a7467-1532-4615-b86e-adf9e10013d7",
                                "sense_id": "5fcabdc8-76ef-3c43-9749-b00c9bca81b1",
                                "text": "L’ouvrir d’emblée à un pluripartisme n’aurait pas abouti à un pluripartisme politique mais, tout simplement à un multipartisme ethnique, c’est-à-dire le contraire d’une unité nationale à construire."
                            }
                        ]
                    }
