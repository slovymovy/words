                        "entry_id": "78a21005-a3fb-385f-9b13-f8b1f9318737",
                        "glosses": [
                            "benaming voor vogels uit het geslacht Numididae"
                        ],
                        "tags": [
                            "hoendervogels"
                        ],
                        "examples": [
                            {
                                "example_id": "c9762ea8-789b-48bf-b189-614118caa4f9",
                                "sense_id": "d7547c3f-edd6-3d4e-8882-96178e1bba5b",
                                "text": "⧖ Zo vergelijkt ook Jeremias, Hoofdst. XVII: 6. den geheel verlaaten en hulploozen met het parelhoen in de woestijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4dcdad9c-ed90-468a-91d0-ff90882a5731",
                        "source_entry_id": "78a21005-a3fb-385f-9b13-f8b1f9318737",
                        "source_sense_id": "d7547c3f-edd6-3d4e-8882-96178e1bba5b",
                        "source_sense_description": "benaming voor vogels uit het geslacht Numididae",
                        "target_lang_word": "Perlhuhn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "77e21d06-12d7-4a52-aeb4-2d92987f96c7",
                        "source_entry_id": "78a21005-a3fb-385f-9b13-f8b1f9318737",
                        "source_sense_id": "d7547c3f-edd6-3d4e-8882-96178e1bba5b",
                        "source_sense_description": "benaming voor vogels uit het geslacht Numididae",
                        "target_lang_word": "guinea fowl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guinea fowl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed35dc9-1b6e-3671-ab60-1b9a1832c7db",
                                        "entry_id": "69deccd8-ff57-3159-8a5f-8545f1b82f22",
                                        "glosses": [
                                            "Any of several African birds of the family Numididae (6 species) resembling partridges."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9440a1c8-85b5-4d42-b7fb-ebdedb44614b",
                                                "sense_id": "8ed35dc9-1b6e-3671-ab60-1b9a1832c7db",
                                                "text": "A tiny white head with a small red wattle hanging from its beak was peeking into our tent. It whistled softly. I laughed. A guinea fowl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                        "entry_id": "69deccd8-ff57-3159-8a5f-8545f1b82f22",
                                        "glosses": [
                                            "The meat of this bird."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d834f12-681f-421c-b194-9e26eef4eaed",
                                                "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                                "text": "While Lawrence had given her the uncut version of his divorce, she had stolidly munched her way through a vast plate of guinea fowl stuffed with foie gras, boulangère potatoes and a wigwam of French beans."
                                            },
                                            {
                                                "example_id": "6aef4238-a35f-45b8-be99-476ab322a116",
                                                "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                                "text": "To the right is a long table housing a mouth-watering buffet of roast duck on platters, surrounded by smaller plates of guinea fowl, French bread, cold meats, and egg segments."
                                            },
                                            {
                                                "example_id": "85095e91-6a92-4cc5-9f2a-5733b05df7fe",
                                                "sense_id": "c71bc9c3-1dd1-34cc-8035-30478bbb5bc3",
                                                "text": "The waiter reappeared with plates of guinea fowl, baked with pancetta and apples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf7a5bd6-ace9-4e40-9301-0346c3497bf4",
                        "source_entry_id": "78a21005-a3fb-385f-9b13-f8b1f9318737",
                        "source_sense_id": "d7547c3f-edd6-3d4e-8882-96178e1bba5b",
                        "source_sense_description": "benaming voor vogels uit het geslacht Numididae",
                        "target_lang_word": "pintade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pintade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9bfcffa-e25d-3494-b33c-411b17dab57a",
                                        "entry_id": "ad378f77-7916-3725-a2f6-e06b83a15af2",
                                        "glosses": [
                                            "Nom donné à quatre genres totalisant six espèces d’oiseaux gallinacés coureurs originaires d’Afrique, appartenant à la famille des numididés, dont le plumage gris-bleuâtre ou noir est souvent semé de taches blanches plus ou moins arrondies et dont la tête est munie d’une sorte de casque de corne, d’une huppe ou d’une crête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beeff353-ad58-4abf-a325-496ec9bf11f1",
                                                "sense_id": "d9bfcffa-e25d-3494-b33c-411b17dab57a",
                                                "text": "Il existe aujourd'hui six espèces de pintades, dont la pintade de Numidie (Numida meleagris) ou pintade commune est celle dont sont dérivées les différentes races de pintades domestiques."
                                            },
                                            {
                                                "example_id": "3c2c8cce-0e5e-4a18-aba4-9aefebb4ebb3",
                                                "sense_id": "d9bfcffa-e25d-3494-b33c-411b17dab57a",
                                                "text": "Les oies, les dindes, les pintades, les pigeons fraternisant en compagnie de trois chats."
                                            },
                                            {
                                                "example_id": "b7a904ca-2fa1-4446-8a6a-6ab7426513a8",
                                                "sense_id": "d9bfcffa-e25d-3494-b33c-411b17dab57a",
                                                "text": "On ne peut pas vivre dans un monde où l’on croit que l’élégance exquise du plumage de la pintade est inutile."
                                            },
                                            {
                                                "example_id": "1ba33ad3-377e-4906-a77c-8c2e24da2680",
                                                "sense_id": "d9bfcffa-e25d-3494-b33c-411b17dab57a",
                                                "text": "À vingt, à vingt-cinq ans comme à soixante aujourd’hui, elle avait déjà cette tête d’effraie, ces lunettes, et cette allure sautillante de pintade qui vient de prendre un coup de bâton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daec5e23-8017-3c6c-8618-44b915fd61c3",
                                        "entry_id": "ad378f77-7916-3725-a2f6-e06b83a15af2",
                                        "glosses": [
                                            "Employé seul, i.e. en absence de descripteur spécifique, synonyme de la forme domestiquée de la pintade de Numidie, ou pintade domestique."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5c74616-c5d1-458a-a25a-1a532cc66951",
                                                "sense_id": "daec5e23-8017-3c6c-8618-44b915fd61c3",
                                                "text": "Les sentiments sont partagés pour savoir si la pintade a réellement soin ou non de sa couvée : le problème est encore à résoudre. Le plus souvent on ne lui permet pas de couver elle-même ses œufs, par la raison qu'elle ne s'y attache point, et qu'elle abandonne souvent ses petits: dans ce cas, il faut la faire suppléer par des poules, ou mieux par des poules d'Inde."
                                            },
                                            {
                                                "example_id": "55ddcf36-4dba-4ccd-a4d8-2a61fd1f13bd",
                                                "sense_id": "daec5e23-8017-3c6c-8618-44b915fd61c3",
                                                "text": "Tu vois, dans les eaux de Crète, la République nager parmi les Puissances comme une pintade dans une compagnie de goélands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0389bd34-ccec-3659-af14-978d6fd59c6a",
                                        "entry_id": "ad378f77-7916-3725-a2f6-e06b83a15af2",
                                        "glosses": [
                                            "Chair de cet animal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4016d5-6645-4e6f-afcc-98c516ae0646",
                                                "sense_id": "0389bd34-ccec-3659-af14-978d6fd59c6a",
                                                "text": "Sa pintade farcie aux noisettes, pistaches et pain d'épice était une merveille"
                                            },
                                            {
                                                "example_id": "6a2b9243-f68b-44d8-82df-0ee74eb5a9f9",
                                                "sense_id": "0389bd34-ccec-3659-af14-978d6fd59c6a",
                                                "text": "Le rôti chaud était un filet aux truffes, et le rôti froid, une galantine de pintade à la gelée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfac53f5-1662-3fb2-bd9a-8f1473bdbb88",
                                        "entry_id": "ad378f77-7916-3725-a2f6-e06b83a15af2",
                                        "glosses": [
                                            "Femme sotte et vaniteuse."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31cda93a-251c-4c9f-814a-ce8e26444d4e",
                                                "sense_id": "bfac53f5-1662-3fb2-bd9a-8f1473bdbb88",
                                                "text": "Michèle est une insupportable pintade."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pintade",
