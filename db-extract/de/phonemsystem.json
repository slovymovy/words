                "senses": [
                    {
                        "sense_id": "20d3b58f-b867-3f60-a3bc-648eabba8f0e",
                        "entry_id": "2986334b-44ea-3e93-b2f2-88af91e92a04",
                        "glosses": [
                            "systematisch geordnete Menge der Phoneme einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fff9cb88-1c00-4b16-a5cc-55aa4da0b832",
                                "sense_id": "20d3b58f-b867-3f60-a3bc-648eabba8f0e",
                                "text": "Jedem Phoneminventar liegt ein Phonemsystem zugrunde, das z. B. aufgrund der akustischen, der artikulatorischen oder auch der auditiven Merkmale der Phoneme bestimmt werden kann."
                            },
                            {
                                "example_id": "0c5616b4-70cd-49ea-b3a5-487b6693be14",
                                "sense_id": "20d3b58f-b867-3f60-a3bc-648eabba8f0e",
                                "text": "Jede Sprache hat ein ihr eigenes Phonemsystem."
                            },
                            {
                                "example_id": "0ea2a085-2df4-435e-a12a-e543fccd0f6d",
                                "sense_id": "20d3b58f-b867-3f60-a3bc-648eabba8f0e",
                                "text": "Eine Sprache kann Laute enthalten, die aber keine Phoneme sind und daher auch nicht zum Phonemsystem der betreffenden Sprache gehören. Im Deutschen etwa gehört der sog. Knacklaut zwar zum Lautsystem, nicht aber zum Phonemsystem."
                            },
                            {
                                "example_id": "74868afe-2050-400f-97a8-291a2f32ffcd",
                                "sense_id": "20d3b58f-b867-3f60-a3bc-648eabba8f0e",
                                "text": "„Die Sprachen unserer Erde zeigen eine Fülle von verschiedenartigen Phonemsystemen.“"
                            },
                            {
                                "example_id": "d256fab9-792b-4ad9-9025-456eaa473aed",
                                "sense_id": "20d3b58f-b867-3f60-a3bc-648eabba8f0e",
                                "text": "„Der Kontext gestattet die Aufhebung relevanter Oppositionen im Phonemsystem, weil auch er die Information liefern kann, die die Phonemopposition ausdrückte.“"
                            },
                            {
                                "example_id": "2d318a8d-f65e-4aeb-a28c-83b176458d21",
                                "sense_id": "20d3b58f-b867-3f60-a3bc-648eabba8f0e",
                                "text": "„Auch wenn die Darstellung sich auf die Aneignung des amerikanisch-englischen Phonemsystems bezieht, so hat sie unseres Erachtens dennoch einen hohen allgemeinen Explikationswert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
