                ],
                "senses": [
                    {
                        "sense_id": "be0fafa5-6980-3c34-8254-143627fced70",
                        "entry_id": "b843dbcc-1611-3afd-b62f-aec7a9e8213f",
                        "glosses": [
                            "Se défoncer soi-même (ou, au pluriel, se défoncer mutuellement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1dd8efc-1a04-4890-ab72-fdc95f589989",
                                "sense_id": "be0fafa5-6980-3c34-8254-143627fced70",
                                "text": "Encore un qui prendrait son malin à plaisir à s'autodéfoncer gratuitement à coups de barre à mines s'il pouvait se croiser dans la rue ?"
                            },
                            {
                                "example_id": "e147a4f4-4c11-49f6-afd6-070875ec5e13",
                                "sense_id": "be0fafa5-6980-3c34-8254-143627fced70",
                                "text": "Je comprend que tu veuilles \"te qualifier\", je ne puis te juger en aucun cas mais t'autocritiquer ou t'autodéfoncer à un certain degré ça peut aider."
                            },
                            {
                                "example_id": "69638cb6-6680-48b7-be16-ab9b0ebe9d8f",
                                "sense_id": "be0fafa5-6980-3c34-8254-143627fced70",
                                "text": "Et pour le dernier cas, il arrive que dans un même clan plusieurs personnes rentrent dans un round pour s'autodéfoncer les uns les autres"
                            }
                        ]
                    }
                ],
