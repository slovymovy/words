                ],
                "senses": [
                    {
                        "sense_id": "d6a3776d-e601-3d30-a91e-88d86c84add0",
                        "entry_id": "d38bf518-16f1-392f-8941-026a540571dc",
                        "glosses": [
                            "Zug, der früh am Morgen verkehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e4f909-83ae-4e30-bb89-f38db33057eb",
                                "sense_id": "d6a3776d-e601-3d30-a91e-88d86c84add0",
                                "text": "„Der Frühzug ist ein Abenteuer, er schaukelt heran, wenn die Morgendämmerung kommt, schießt durch Dörfer der Toten.“"
                            },
                            {
                                "example_id": "fe87f199-359b-4bbb-9a91-3db0688948ab",
                                "sense_id": "d6a3776d-e601-3d30-a91e-88d86c84add0",
                                "text": "„Alles, was noch auf dem Balkon verblieben war, sah ihnen neugierig nach, auch Gordon, der ihren Weitermarsch bis ins Bodetal hinein verfolgt haben würde, wenn nicht der eben mit neuen Ankömmlingen eingetrofffene Frühzug sein Interesse nach der entgegengesetzten Seite hin abgezogen hätte.“"
                            },
                            {
                                "example_id": "dc34e771-6542-4d89-9b71-cfbdcddd012d",
                                "sense_id": "d6a3776d-e601-3d30-a91e-88d86c84add0",
                                "text": "„Zwei alte Leute zogen ein, die mit dem Frühzug angekommen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
