                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get intoxicated",
                                "target_lang_sense_clarification": "To become affected by alcohol or drugs."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5bb870c-7b92-367e-bc3f-b73b5e10adec",
                    "sense_definition": "Gebiedende wijs van <w>roezen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Roes</w> eens lekker uit na deze zware week!",
                            "target_lang_translations": {
                                "en": "<w>Relax and drift away</w> after this hard week!"
                            }
                        },
                        {
                            "text": "<w>Roes</w> maar even weg van alle dagelijkse zorgen.",
                            "target_lang_translations": {
                                "en": "Just <w>drift away</w> from all your daily worries for a moment."
                            }
                        }
                    ],
                    "traits": [
                        {
