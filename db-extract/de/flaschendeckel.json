                "senses": [
                    {
                        "sense_id": "611ab601-483c-3ef8-b314-7573fc011b0c",
                        "entry_id": "7938cf65-d4e9-305b-9f37-aba2720187b9",
                        "glosses": [
                            "Verschluss für eine Flasche"
