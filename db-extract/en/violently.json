                    {
                        "sense_id": "5f3641a9-9f82-36b3-b1fd-5a062f9cd8ac",
                        "entry_id": "48c52294-30d9-3e15-a396-debae509a617",
                        "glosses": [
                            "To an intense degree; extremely; strongly; intensely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a4c7b7-0cab-407f-9d7b-7c54cc603dc0",
                                "sense_id": "5f3641a9-9f82-36b3-b1fd-5a062f9cd8ac",
                                "text": "I found myself violently disagreeing with him."
                            },
                            {
                                "example_id": "cea6b447-389a-4621-993e-1664b528d626",
                                "sense_id": "5f3641a9-9f82-36b3-b1fd-5a062f9cd8ac",
                                "text": "Arthur started to choke violently on his drink."
                            },
                            {
                                "example_id": "6ba55946-a7ba-4aa4-ad5b-ce546bc576fd",
                                "sense_id": "5f3641a9-9f82-36b3-b1fd-5a062f9cd8ac",
                                "text": "Those who believe in the blackpill tend to adopt violently misogynistic beliefs about the nature of women, particularly with regard to their sexual behaviour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78fd0b6a-66f4-4c69-a50b-550407bd82df",
