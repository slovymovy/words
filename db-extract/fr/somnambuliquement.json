                        "glosses": [
                            "À la manière des somnambules."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f97bc97b-f345-4d91-b720-4f8f86ad2077",
                                "sense_id": "0b6f55b8-4ce2-3561-a866-9c2a1f2bd2a0",
                                "text": "Tout son bonheur tomba, comme tombe un homme qui parvenu somnambuliquement sur la cime d’un toit, entend une voix, avance et s’écrase sur le pavé."
                            },
                            {
                                "example_id": "e2ef42f0-b45d-4681-ba87-687fd2e3cdaa",
                                "sense_id": "0b6f55b8-4ce2-3561-a866-9c2a1f2bd2a0",
                                "text": "Vingt et une fois j’ai accompli somnambuliquement mon nouveau métier, côte à côte avec Auguste, qui jouait un jeune Athénien."
                            }
                        ]
                    }
