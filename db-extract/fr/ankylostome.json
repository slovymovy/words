                        "entry_id": "207c9964-fa03-32f9-9216-d3bc2eda99d0",
                        "glosses": [
                            "Ver nématode parasite hématophage dont l'adulte est présent dans l'intestin grêle d'un mammifère, tel le chien, le chat, l'homme, parfois les ruminants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b81836-19a2-4ead-b5d4-daa8e9a3a1e8",
                                "sense_id": "60a8109c-c485-3425-b83c-1b55728276ec",
                                "text": "Les bœufs, les buffles, les moutons, les chèvres, et les chiens peuvent avoir des ankylostomes. En général, ils s’infestent lorsqu’ils vivent en collectivités surpeuplées."
                            }
                        ]
                    }
