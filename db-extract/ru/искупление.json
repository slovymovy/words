                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884840cd-e567-480f-89f5-ef0d9e943b48",
                                                "sense_id": "126ad962-e9d9-3184-a112-765a4a1145c1",
                                                "text": "Before creating the world, God knew both the need for and the means of the redemption He would provide through Jesus Christ."
                                            }
                                        ]
