                "senses": [
                    {
                        "sense_id": "4c61c84c-c937-3b32-83f1-f2ddf99451a9",
                        "entry_id": "0d32fb81-eb43-3ecc-b4fd-24fbb653f34b",
                        "glosses": [
                            "Saison des pluies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc6246e-078f-4328-8a6f-c4089bb9a6d9",
                                "sense_id": "4c61c84c-c937-3b32-83f1-f2ddf99451a9",
                                "text": "Google Maps kennt Tonka nicht. Der Ort ist zu klein, zu ihm führt nur eine Piste aus Sand und kleinen Steinen, die sich in der Regenzeit in glitschigen Schlamm verwandelt.",
                                "translation": "Google Maps ne connaît pas Tonka. Le bourg est trop petit, seule une piste de sable et de petits cailloux, qui se transforme en boue glissante à la saison des pluies, y mène."
                            },
                            {
                                "example_id": "7302bab2-5a37-4f6a-86af-c3aa6869f807",
                                "sense_id": "4c61c84c-c937-3b32-83f1-f2ddf99451a9",
                                "text": "Experten gehen davon aus, dass die Waldbrände mindestens bis Oktober andauern werden, dann wird die Regenzeit wahrscheinlich etwas Entlastung bringen."
                            }
                        ]
                    }
                ],
