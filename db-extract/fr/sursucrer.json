                        "glosses": [
                            "Sucrer de façon excessive, ou plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83cfa307-f5cb-44f1-a654-e79e514ba5c2",
                                "sense_id": "fec7f39e-3cfb-3029-8006-0bf881b85898",
                                "text": "Si l’on obtient que l’industrie agro-alimentaire cesse de “sursaler” et de “sursucrer” ses produits, il va bien falloir remplacer le sel et le sucre par autre chose."
                            },
                            {
                                "example_id": "e152834b-59e6-4a5c-aade-aaaf6baf1f60",
                                "sense_id": "fec7f39e-3cfb-3029-8006-0bf881b85898",
                                "text": "Pour éviter qu’elle ne vous fasse prendre du poids, ne la sursucrez pas."
                            },
                            {
                                "example_id": "0a056033-4ab7-446b-aa90-b8d927bbc5e0",
                                "sense_id": "fec7f39e-3cfb-3029-8006-0bf881b85898",
                                "text": "Lorsque vous utilisez le sucre pour adoucir l’acidité des aliments, il est important de ne pas sursucrer votre préparation."
                            }
                        ]
                    }
