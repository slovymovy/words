                "senses": [
                    {
                        "sense_id": "d79bc627-400d-3d91-8509-f5aefa4919eb",
                        "entry_id": "4cd0100b-aadc-38d9-aaea-806ea2a821d3",
                        "glosses": [
                            "A male given name from the Germanic languages; popular in the 19th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aed04d7-9fab-4057-89e8-a21fbe6998e2",
                                "sense_id": "d79bc627-400d-3d91-8509-f5aefa4919eb",
                                "text": "GWENDOLEN. […] and my ideal has always been to love someone of the name of Ernest. There is something in that name that inspires absolute confidence."
                            },
                            {
                                "example_id": "3205eac8-7760-4935-928a-1c8657e7b57e",
                                "sense_id": "d79bc627-400d-3d91-8509-f5aefa4919eb",
                                "text": "\"What's his name, your boyfriend?\" \"Ernest. Ernest Hemingway.\" The name was received in disparaging silence. Marlene said: \"You wouldn't get me going out with a feller called Ernest. My granddad was Ernest.\""
                            }
                        ]
                    },
