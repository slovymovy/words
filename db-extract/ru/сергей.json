                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88f9ddca-7586-48b7-a2eb-d40c56269d1d",
                                "sense_id": "7957085f-2e07-31ce-9dbc-f4c2fd0aebe2",
                                "text": "Сергей Иванович встретил брата своею обычною для всех ласково-холодною улыбкой и, познакомив его с профессором, продолжал разговор."
                            }
                        ]
