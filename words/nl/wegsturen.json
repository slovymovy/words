            "senses": [
                {
                    "sense_id": "15bd862e-2f69-3fa6-8fdd-2f9b7f35aa9f",
                    "sense_definition": "iemand bevelen of verzoeken om een bepaalde plaats te verlaten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De docent <w>stuurde</w> de vervelende leerling meteen de klas uit <w>weg</w>.",
                            "target_lang_translations": {
                                "en": "The teacher immediately <w>sent</w> the annoying student <w>out of</w> the classroom."
                            }
                        },
                        {
                            "text": "Als je niet rustig kunt blijven, moet ik je helaas <w>wegsturen</w>.",
                            "target_lang_translations": {
                                "en": "If you cannot remain calm, I will unfortunately have to <w>send</w> you <w>away</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "heensturen",
                        "wegzenden"
                    ],
                    "antonyms": [
                        "ontvangen",
                        "verwelkomen"
                    ],
                    "common_phrases": [
                        "iemand wegsturen"
                    ],
                    "target_lang_definitions": {
                        "en": "to order or request someone to leave a certain place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "send away",
                                "target_lang_sense_clarification": "to tell someone to leave one's presence or a location"
                            },
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to formally allow or order someone to leave"
                            },
                            {
                                "target_lang_word": "send off",
                                "target_lang_sense_clarification": "to order someone to leave an area or room"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e967f8a-2446-3d9a-9dea-485a2b69db63",
                    "sense_definition": "iemand ontslaan uit een functie of definitief laten vertrekken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd na een groot conflict zonder pardon <w>weggestuurd</w> door de directeur.",
                            "target_lang_translations": {
                                "en": "After a major conflict, he was <w>dismissed</w> without mercy by the director."
                            }
                        },
                        {
                            "text": "Het bestuur besloot de coach wegens teleurstellende resultaten per direct <w>weg</w> te <w>sturen</w>.",
                            "target_lang_translations": {
                                "en": "The board decided to <w>fire</w> the coach with immediate effect due to disappointing results."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontslaan",
                        "wegjagen"
                    ],
                    "antonyms": [
                        "aannemen",
                        "benoemen"
                    ],
                    "common_phrases": [
                        "zonder pardon weggestuurd"
                    ],
                    "target_lang_definitions": {
                        "en": "to dismiss someone from a job or position, or make them leave permanently"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to remove someone from a job or position"
                            },
                            {
                                "target_lang_word": "fire",
                                "target_lang_sense_clarification": "to terminate someone's employment"
                            },
                            {
                                "target_lang_word": "sack",
                                "target_lang_sense_clarification": "to discharge someone from employment"
                            }
                        ]
                    }
                }
            ]
