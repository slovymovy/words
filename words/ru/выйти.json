                        "zh": [
                            {
                                "target_lang_word": "嫁",
                                "target_lang_sense_clarification": "女性结婚"
                            },
                            {
                                "target_lang_word": "结婚",
                                "target_lang_sense_clarification": "成为配偶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "805b0411-17d2-3f58-9645-447f97d4b2df",
                    "sense_definition": "Завершиться определенным результатом, получиться, удаться",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас ничего не <вышло> с этим сложным проектом.",
                            "target_lang_translations": {
                                "en": "Nothing <worked out> with this complex project.",
                                "de": "Aus diesem schwierigen Projekt ist bei uns nichts <geworden>.",
                                "zh": "这个复杂的项目我们没能<成功>。"
                            }
                        },
                        {
                            "text": "Фотография <вышла> очень четкой и красивой.",
                            "target_lang_translations": {
                                "en": "The photograph <came out> very clear and beautiful.",
                                "de": "Das Foto ist sehr scharf und schön <geworden>.",
                                "zh": "照片<拍得>非常清晰漂亮。"
                            }
                        }
                    ],
                    "synonyms": [
                        "получиться",
                        "удаться"
