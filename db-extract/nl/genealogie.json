                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genealogie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28da98cc-fb98-30f1-9d96-afb78d93939c",
                                        "entry_id": "015b6cb9-9740-3f2c-9b08-217f98efab0c",
                                        "glosses": [
                                            "Disziplin, die sich mit der Erforschung der Abstammung von Personen oder Personengruppen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ec74ec-0d93-40d7-ba46-f3d4c4b313c6",
                                                "sense_id": "28da98cc-fb98-30f1-9d96-afb78d93939c",
                                                "text": "Die Genealogie kann manche Familiengeschichten sehr weit in die Vergangenheit zurückverfolgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c3b5c92-38af-3e15-a261-4a2a22dbda15",
                                        "entry_id": "015b6cb9-9740-3f2c-9b08-217f98efab0c",
                                        "glosses": [
                                            "Darstellung der Abstammung von Personen oder Personengruppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3cd35c-9146-4100-8e75-4414e349878e",
                                                "sense_id": "3c3b5c92-38af-3e15-a261-4a2a22dbda15",
                                                "text": "Die Genealogie der europäischen Fürstenhäuser zeigt viele verwandtschaftliche Verflechtungen."
                                            },
                                            {
                                                "example_id": "62deb230-7914-4ff2-ab1a-1707e4eba893",
                                                "sense_id": "3c3b5c92-38af-3e15-a261-4a2a22dbda15",
                                                "text": "„Mit GES-2000 kann man die Genealogie einer Familie oder einer Sippe bearbeiten, aber auch die Verkartung von Kirchenbüchern oder Orten durchführen.“"
                                            },
                                            {
                                                "example_id": "c26f1b3a-70b5-44d5-ab0d-53e10b9f9498",
                                                "sense_id": "3c3b5c92-38af-3e15-a261-4a2a22dbda15",
                                                "text": "„Die Genealogie einer Familie S t r e i t ist abgedruckt im DEUTSCHEN GESCHLECHTERBUCH, Band 33 (mit buntem Wappen)“"
                                            },
                                            {
                                                "example_id": "6641105e-b20e-4a3d-bfa2-7b2003b61cbd",
                                                "sense_id": "3c3b5c92-38af-3e15-a261-4a2a22dbda15",
                                                "text": "„Die beste Möglichkeit einer Geschichtsschreibung nach mathematischem Vorbild sah Leibniz in der Chronologie und in der Genealogie.“"
                                            },
                                            {
                                                "example_id": "03909c99-6b4f-4c6b-ab7e-9f7919dc3d79",
                                                "sense_id": "3c3b5c92-38af-3e15-a261-4a2a22dbda15",
                                                "text": "„Identität wird aus der Herkunft abgeleitet, die nun neben der Genealogie auch einen bestimmten geographischen Ort bezeichnet und insgesamt einen rechtlichen Status begründet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77500f03-86e4-4b90-80cf-b75f630952ef",
