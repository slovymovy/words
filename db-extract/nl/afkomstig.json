                                "sense_id": "cba7de5b-426d-393a-9c50-bb1acb76c393",
                                "text": "Hij is afkomstig uit zijn huis en gaat naar zijn werk."
                            },
                            {
                                "example_id": "973f8de4-3efa-4c23-8a4e-2e14ead2bfbb",
                                "sense_id": "cba7de5b-426d-393a-9c50-bb1acb76c393",
                                "text": "Hij is afkomstig uit Polen"
                            },
                            {
                                "example_id": "464447e7-577f-4ded-84b4-4e9799815600",
                                "sense_id": "cba7de5b-426d-393a-9c50-bb1acb76c393",
                                "text": "Vlak voor mijn komst naar Tunesië verergerden de symptomen van een mysterieuze ziekte waarvan ik niet weet wanneer en hoe ik die heb opgelopen, maar waarvan de artsen vermoeden dat het om een van dieren afkomstige bacterie is die zich via mijn luchtwegen in mijn longen heeft genesteld."
                            },
                            {
                                "example_id": "c0705492-e886-4a99-b74d-5c5cb94b6e63",
                                "sense_id": "cba7de5b-426d-393a-9c50-bb1acb76c393",
                                "text": "Cuben fiber is een superlicht maar sterk materiaal, afkomstig uit de zeilwereld."
                            }
                        ]
