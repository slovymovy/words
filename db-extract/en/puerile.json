                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "29916d18-2a32-45e8-b887-b3e740f758bb",
                        "entry_id": "1581c06f-f2aa-3a13-b795-65bfcb9c3caf",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more puerile"
                    },
                    {
                        "form_id": "6ee0ec85-10e2-4a48-86fe-265b04907edb",
                        "entry_id": "1581c06f-f2aa-3a13-b795-65bfcb9c3caf",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most puerile"
