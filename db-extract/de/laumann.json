                    }
                ],
                "senses": [
                    {
                        "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                        "entry_id": "2c2f011b-e1da-3e95-9c54-e11370457e74",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b661227-a63b-4c2f-bc9f-398fb1adea38",
                                "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Laumann kommt, geht der Herr Laumann.“"
                            },
                            {
                                "example_id": "dcec9ede-28ff-48a3-81a9-b0a3755627ff",
                                "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                                "text": "An verregneten Herbsttagen ist Familie Laumanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "48b3aba3-422d-4851-9dc7-6445916f6cf7",
                                "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                                "text": "Frau Laumann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f0a5ac81-b99b-4f19-adb6-44665238996b",
                                "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                                "text": "Herr Laumann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "23d0f06d-15dc-42d1-8774-d1e63d525299",
                                "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                                "text": "Die Laumanns kommen heute aus dem Oberpfälzer Wald."
                            },
                            {
                                "example_id": "ca74f043-091c-438e-afef-df0748325317",
                                "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                                "text": "Der Laumann trägt nie die Schals, die die Laumann ihm strickt."
                            },
                            {
                                "example_id": "28599367-9496-4300-9c73-9efcd723ebee",
                                "sense_id": "f55d8183-ddcb-3933-9398-72ee3c8c780e",
                                "text": "„Manfred Laumann und seine Frau Anna werden zivilen Ungehorsam üben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
