                                "sense_id": "a730dabc-419f-3e49-a81e-ce5a1636ec95",
                                "text": "Assad spreekt in het interview spottend over de mensen die hebben gebroken met zijn regime. Assad noemt dat 'een zelfreiniging van de regering en het land."
                            },
                            {
                                "example_id": "8c906307-80d6-464d-b055-51ec626620a2",
                                "sense_id": "a730dabc-419f-3e49-a81e-ce5a1636ec95",
                                "text": "„De noodzakelijke zelfreiniging van de kerk blijft uit.”"
                            },
                            {
                                "example_id": "e708fea4-3fdd-4488-b491-7d4f5e5972ea",
                                "sense_id": "a730dabc-419f-3e49-a81e-ce5a1636ec95",
                                "text": "Met deze Pakistaanse zelfreiniging zal Asia Bibi zeker vrijkomen en zullen Pakistaanse christenen werkelijk vrije burgers worden."
                            }
                        ]
