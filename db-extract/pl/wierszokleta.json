                    {
                        "translation_id": "e0771319-69ee-4c6c-8e41-d7522647ba1a",
                        "source_entry_id": "cfcb89e8-ef93-3545-a897-13135ae0ea58",
                        "source_sense_id": "36b2c3cd-fe24-3dfa-8d16-d6c238e53415",
                        "target_lang_word": "veršotepec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veršotepec",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "9171ad2d-6933-3aaa-b561-c70c54af9d7b",
                                        "entry_id": "0a49769c-2ad5-3898-af1e-81f463fad37c",
                                        "glosses": [
                                            "básník („ten, kdo tepá verše“)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9fbfb38-1aeb-31b7-878d-13219df2e45f",
                                        "entry_id": "0a49769c-2ad5-3898-af1e-81f463fad37c",
                                        "glosses": [
                                            "špatný, podřadný básník"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae815017-a108-4cbb-9990-bdb5aea22110",
                                                "sense_id": "d9fbfb38-1aeb-31b7-878d-13219df2e45f",
                                                "text": "Nový překlad Bible je dílem veršotepců, soudí čeští a moravští biskupové."
                                            },
                                            {
                                                "example_id": "9f25c4d9-33b9-4c0f-a43b-9e46f5b04962",
                                                "sense_id": "d9fbfb38-1aeb-31b7-878d-13219df2e45f",
                                                "text": "Obřad na radnici, i v kostele, proběhl rychle, a budiž řečeno ke cti starosty i kněze, ani jeden se nepřeřekl. Nebezpečí nastalo, když se objevila skupina Magdiných kolegů a kolegyň, které vedl starý Burda, známý veršotepec. Ale matka zasáhla včas, a představila jim Honzu, ještě než Burda spustil své rýmované blahopřání."
                                            },
                                            {
                                                "example_id": "ed92f0c2-f5d6-4944-b721-fce91e8fbfe8",
                                                "sense_id": "d9fbfb38-1aeb-31b7-878d-13219df2e45f",
                                                "text": "Jak známo, pokládán Mácha za cizáka, a raděno mu, básniti zcela jinak, nežli básnil — pokládán za básníka nedosti vlasteneckého… A přece z celé řady prací jeho dýše ryze český duch a vane poctivé nadšení vlastenecké, o jakémž valná čásť tehdejších planých veršotepců, z jichž bezmyšlénkovitého blábolení tropil si později Havlíček tak často zaslouženě trpký posměch, ani ponětí neměla."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33b0e3a6-fad7-4ca0-b26e-8776d90b50ca",
