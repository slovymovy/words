                "senses": [
                    {
                        "sense_id": "141cdb7d-29ea-39b0-a1de-32d45a8d8375",
                        "entry_id": "30ac0fa5-28f8-3699-a860-56759a5570b4",
                        "glosses": [
                            "durchlässige Vorrichtung, Gerät oder Baugruppe zur Trennung oder Aussonderung bestimmter Feststoffe in Filterbändern"
                        ],
                        "tags": [
                            "Anlagenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "80573575-4956-41fe-88bc-38029e999bdc",
                                "sense_id": "141cdb7d-29ea-39b0-a1de-32d45a8d8375",
                                "text": "„Für die Industrielle Flüssigkeitsfiltration werden heute überwiegend Bandfilter eingesetzt.“"
                            },
                            {
                                "example_id": "182d7016-3a8c-408d-98a8-f7e475fed61f",
                                "sense_id": "141cdb7d-29ea-39b0-a1de-32d45a8d8375",
                                "text": "„Bandfilter werden verwendet, um unerwünschte Partikel in Flüssigkeiten effektiv zu entfernen.“"
                            },
                            {
                                "example_id": "667d676c-627c-48e8-9d4f-ea2968213ab2",
                                "sense_id": "141cdb7d-29ea-39b0-a1de-32d45a8d8375",
                                "text": "„Bandfilter arbeiten nach dem Prinzip der Schwerkraft und sind sehr wartungsarm. Je nach geforderter Filterfeinheit werden bei Bandfilter Filtervliese mit unterschiedlichen Durchlässigkeiten eingesetzt. Bandfilter können auch ohne Vlies eingesetzt werden. Bandfilter werden z.B. zur Filtration von Kühlmitteln und Flüssigkeiten oder zur einfachen aber wirkungsvolle Entwässerung von grobkörnigen Abwässern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "405721fd-a0a8-3ef3-9f11-af1a98ef9e6e",
                        "entry_id": "30ac0fa5-28f8-3699-a860-56759a5570b4",
                        "glosses": [
                            "technisches Modul, das einen gewissen Frequenzbereich (den Durchlassbereich) ausfiltert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee56664d-feb6-4fff-bc1c-5fc2aa0c07bd",
                                "sense_id": "405721fd-a0a8-3ef3-9f11-af1a98ef9e6e",
                                "text": "Ein Bandfilter besteht aus zwei oder mehreren Parallelschwingkreisen, die miteinander lose gekoppelt sind."
                            },
                            {
                                "example_id": "6fbb7433-0895-4668-a562-750124e67129",
                                "sense_id": "405721fd-a0a8-3ef3-9f11-af1a98ef9e6e",
                                "text": "Bandfilter sind Filter, die eine bestimmte Frequenz sperren (sog. Notch-Filter oder Bandsperren) oder nur eine ganz bestimmte Frequenz durchlassen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
