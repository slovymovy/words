                "senses": [
                    {
                        "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                        "entry_id": "f042f3ce-4f3e-33cc-9597-309405c59990",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02040c6-169e-4906-a63b-321a51396a45",
                                "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                                "text": "Frau Echtermeyer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "54bf81bf-2657-4594-9d91-57836d197c13",
                                "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                                "text": "Herr Echtermeyer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cadaa7e8-111b-4271-986b-d1281e92842a",
                                "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                                "text": "Die Echtermeyers fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "b3189e0f-036e-411a-941f-37a526a5fe33",
                                "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                                "text": "Der Echtermeyer trägt nie die Pullover, die die Echtermeyer ihm strickt."
                            },
                            {
                                "example_id": "5c848dab-d03b-4e57-a764-ae015c9ba624",
                                "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Echtermeyer kommt, geht der Herr Echtermeyer.“"
                            },
                            {
                                "example_id": "93132cda-a074-4b4f-80bd-f77b3d724a60",
                                "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                                "text": "Echtermeyer kommt und geht."
                            },
                            {
                                "example_id": "a7a1f12d-482c-4fef-be99-025bd927e882",
                                "sense_id": "e726a60d-7279-3b70-b765-095ee94bfd98",
                                "text": "Echtermeyers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
