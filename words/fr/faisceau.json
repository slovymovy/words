                        "faisceau de présomptions"
                    ]
                },
                {
                    "sense_id": "bcbf455f-71dc-3a03-8991-698319efbb84",
                    "sense_definition": "Assemblage de baguettes entourant une hache, porté par les licteurs comme emblème du pouvoir dans la Rome antique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "symbole_romain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les licteurs précédaient le magistrat en portant le <w>faisceau</w> devant la foule."
                        },
                        {
                            "text": "Ce monument républicain reprend l'image antique du <w>faisceau</w> comme symbole d'unité."
                        }
                    ],
                    "common_phrases": [
                        "faisceau de licteur"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Contexte historique de l'Antiquité romaine"
                        }
                    ]
                },
                {
                    "sense_id": "97eabfc9-cb16-375f-bafd-284660c96f75",
                    "sense_definition": "Disposition de plusieurs fusils appuyés les uns contre les autres par leurs baïonnettes pour tenir debout.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la halte, les soldats fatigués formèrent les <w>faisceaux</w> avant de s'asseoir."
                        },
                        {
                            "text": "Le sergent ordonna à la section de mettre les fusils en <w>faisceau</w>."
