                    {
                        "sense_id": "24fff9c2-ac21-3f74-b509-0567b76650f4",
                        "entry_id": "a11c280f-5eaf-3845-bc55-569bb057d012",
                        "glosses": [
                            "cecha tego, co jest dobitne, wyraziste, niepozostawiające wątpliwości"
