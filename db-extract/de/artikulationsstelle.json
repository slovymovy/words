                ],
                "senses": [
                    {
                        "sense_id": "87c1d494-0f86-3495-8996-b1bb9235f7be",
                        "entry_id": "24af9e59-bdb5-3d1f-a054-0810b1562617",
                        "glosses": [
                            "Stelle im Sprechtrakt oder Bereich der Zunge, wo ein Laut gebildet wird"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "fc485365-5d81-4cb2-8d9e-65e58b559360",
                                "sense_id": "87c1d494-0f86-3495-8996-b1bb9235f7be",
                                "text": "Die Artikulationsstelle der Laute [b], [m] und [p] ist bilabial."
                            },
                            {
                                "example_id": "cc26cee5-4fed-464a-bec0-3827913055ec",
                                "sense_id": "87c1d494-0f86-3495-8996-b1bb9235f7be",
                                "text": "„Grundlegend für die Eigenschaften eines Lautes sind dessen Artikulationsart und dessen Artikulationsort (-stelle).“"
                            },
                            {
                                "example_id": "ff277911-a514-4203-ba3e-5621d0ff951b",
                                "sense_id": "87c1d494-0f86-3495-8996-b1bb9235f7be",
                                "text": "„Phonetisch kann ein Laut wie [t] durch verschiedene Merkmale der Artikulationsstelle, zum Beispiel [dental], [alveolar], [koronal], und der Artikulationsweise [konsonantisch], [nicht sonorant], [nicht nasal], [dauernd] [stimmhaft], eindeutig charakterisiert werden.“"
                            },
                            {
                                "example_id": "70fd2969-adcb-4889-8a2d-3fe5777e0779",
                                "sense_id": "87c1d494-0f86-3495-8996-b1bb9235f7be",
                                "text": "„Dies entspricht der allgemeinen Annahme, daß die Laute gemäß ihrer jeweiligen Artikulationsstelle von vorn nach hinten entwickelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
