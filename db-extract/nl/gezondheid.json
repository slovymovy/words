            {
                "entry_id": "7784efbe-d0ff-3106-8f63-d40b0db6034d",
                "word": "gezondheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc8327c7-9caa-32aa-9f14-46362c1f9df4",
                        "entry_id": "7784efbe-d0ff-3106-8f63-d40b0db6034d",
                        "glosses": [
                            "welbevinden, in goede staat zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef922f62-d846-4461-8500-ecbfc4c159ed",
                                "sense_id": "fc8327c7-9caa-32aa-9f14-46362c1f9df4",
                                "text": "Zijn gezondheid was gelukkig niet in gevaar."
                            },
                            {
                                "example_id": "37fbeb6e-23a7-4e66-b83b-7d6b1dbcfd22",
                                "sense_id": "fc8327c7-9caa-32aa-9f14-46362c1f9df4",
                                "text": "Het was gek om mijn gezondheid helemaal in handen van deze wonderlijke techniek te leggen, maar het leek mij de meest efficiënte optie."
                            },
                            {
                                "example_id": "c86b9bfd-57c0-4150-89d0-d8b44b0842f6",
                                "sense_id": "fc8327c7-9caa-32aa-9f14-46362c1f9df4",
                                "text": "Het aantal meldingen van rattenoverlast in Amsterdam is vorig jaar weer toegenomen. In 2024 ontving de gemeente 6800 meldingen, 600 meer dan het jaar daarvoor, meldt wethouder publieke gezondheid en preventie Alexander Scholtes in een brief aan de gemeenteraad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d6bab48-1428-43ea-abb8-0c7e91d57f3a",
                        "source_entry_id": "7784efbe-d0ff-3106-8f63-d40b0db6034d",
                        "source_sense_id": "fc8327c7-9caa-32aa-9f14-46362c1f9df4",
                        "source_sense_description": "welbevinden, in goede staat zijn",
                        "target_lang_word": "Gesundheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesundheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                        "entry_id": "cbfb3ffb-1120-321a-887a-503d0dcc9f6c",
                                        "glosses": [
                                            "als geistig ausgeglichen und emotional harmonisch empfundener, in körperlicher und vor allem praktischer Hinsicht als ausreichend kraftvoll erlebter Allgemeinzustand voller Arbeits- oder Leistungsfähigkeit und damit uneingeschränkter Handlungsfähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879ab69e-1074-454f-96d9-f1affa114056",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "Das schadet deiner Gesundheit!"
                                            },
                                            {
                                                "example_id": "8372e3cd-a704-46fd-a5e3-095d3e2b2074",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "Er sollte mehr für seine Gesundheit tun."
                                            },
                                            {
                                                "example_id": "0ed7f068-2cba-4533-b695-c9248d9f998c",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "Seine Gesundheit lässt sehr zu wünschen übrig."
                                            },
                                            {
                                                "example_id": "2a12c9e3-3722-428c-923f-30a548628116",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "Ich gebe meiner Gesundheit den Vorrang."
                                            },
                                            {
                                                "example_id": "33407d28-cb33-4ba2-958b-9f468f3e62a1",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "„Frauen trinken aber auch viel Tee, um sich möglichst viel Flüssigkeit zuzuführen und es in puncto Gesundheit den Topmodels gleichzutun.“"
                                            },
                                            {
                                                "example_id": "dfbe416c-e326-4f52-a452-897c1068ab16",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            },
                                            {
                                                "example_id": "cbbe7eaf-5876-45a5-b84e-bc0ab54df1a7",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "„Gesundheit, Gewicht und Genuss: Wer sich richtig ernähren will, bringt die Uhr ins Spiel.“"
                                            },
                                            {
                                                "example_id": "f5ac5d23-cf11-4832-8655-d09c3cac8544",
                                                "sense_id": "e5c08732-116d-3f75-a86e-fbb3de70fa12",
                                                "text": "„Sie antwortet lachend, ausgezeichnet, und sagt, ihr Gatte habe ihr die Gesundheit wieder geschenkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gesundheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef79c117-c4b0-3005-816d-618bba507792",
                                        "entry_id": "70a13049-dd90-3945-ad71-254589b22d92",
                                        "glosses": [
                                            "Ausruf für Gesundheit nach dem Niesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0ce533-8a27-4840-b949-d64bf83d5a64",
                                                "sense_id": "ef79c117-c4b0-3005-816d-618bba507792",
                                                "text": "Gesundheit! Und ein langes Leben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
