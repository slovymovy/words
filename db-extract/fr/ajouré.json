                "senses": [
                    {
                        "sense_id": "426faa33-c4c4-30c3-a3a0-ded7d206d3e7",
                        "entry_id": "ff0c0728-a822-30d6-b88b-a6a1c0378fac",
                        "glosses": [
                            "Qui est percé à jour, qui laisse passer la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb6197b2-0b6b-4b5e-8d8f-b3cbfd63a3d7",
                                "sense_id": "426faa33-c4c4-30c3-a3a0-ded7d206d3e7",
                                "text": "Balcon ajouré."
                            },
                            {
                                "example_id": "54a2ffeb-15eb-402e-85ff-a761e4b8cd56",
                                "sense_id": "426faa33-c4c4-30c3-a3a0-ded7d206d3e7",
                                "text": "Dentelle ajourée."
                            },
                            {
                                "example_id": "1e227ca0-3347-42ce-82b9-e3a75139f1a4",
                                "sense_id": "426faa33-c4c4-30c3-a3a0-ded7d206d3e7",
                                "text": "Le lendemain, en sortant de l’école, j’allai au bureau de tabac, et j’achetai une très belle feuille de papier à lettres. Elle était ajourée en dentelle sur les bords […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6a4524b-25d6-3f00-bde4-3e61d4aa18b2",
                        "entry_id": "ff0c0728-a822-30d6-b88b-a6a1c0378fac",
                        "glosses": [
                            "Se dit de pièces percées à jour qui laissent voir l’émail du champ. En particulier, des fenêtres d’un bâtiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26644a2a-72f3-44a0-9659-7d0ad922c385",
                                "sense_id": "f6a4524b-25d6-3f00-bde4-3e61d4aa18b2",
                                "text": "MAISON. — Rare en armoiries, où elle paraît ordinairement de face. On dit ouverte, ajourée, maçonnée et essorée, de la porte, des fenêtres, des joints, des pierres et du toit d’une maison, lorsqu’ils sont d’un autre émail que le corps du bâtiment. […] Bastide — d’argent, à une maison de gueules, ouverte de sable, ajourée de cinq fenêtres du même, bâtie sur une terrasse de sinople ; au chef d’azur, chargé de trois étoiles d’or. Provence."
                            },
                            {
                                "example_id": "45eeae25-f334-4fce-8106-2f12e35712b6",
                                "sense_id": "f6a4524b-25d6-3f00-bde4-3e61d4aa18b2",
                                "text": "D’argent au château de trois tours d’azur, ouvert et ajouré du champ, surmonté d’une moucheture d’hermine de sable, qui est de Villebret → voir illustration « château ajouré »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4652f062-e592-4444-869c-91cf6224ba23",
                        "source_entry_id": "ff0c0728-a822-30d6-b88b-a6a1c0378fac",
                        "target_lang_word": "à jour",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à jour",
