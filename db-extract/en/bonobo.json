                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ddedda3-cc94-47cd-89fd-782e1040a84f",
                        "source_entry_id": "2de96889-c4d3-3162-aa56-dcf97ffe1828",
                        "source_sense_id": "aa2ac78b-e5f4-3ec1-ae34-21756e733ab9",
                        "source_sense_description": "Zoologie: Bonobo, Zwergschimpanse (Pan paniscus)",
                        "target_lang_word": "Bonobo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bonobo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4780f2b2-7f06-36ec-9001-62eb47047804",
                                        "entry_id": "7b31c305-4bc0-3057-a960-1cbd78e00b27",
                                        "glosses": [
                                            "(in den zentralafrikanischen Regenwald-Gebieten südlich des Kongo beheimatete) Menschenaffen-Art (Pan paniscus) mit braunschwarzem Haarkleid, die nur unwesentlich kleiner ist und einen schlankeren Körperbau mit längeren Gliedmaßen und weniger hervorspringendem Kiefer besitzt als ihre nahverwandte Geschwisterart des Schimpansen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e60bfc72-29b3-4b4e-80b8-9226dd7e9b09",
                                                "sense_id": "4780f2b2-7f06-36ec-9001-62eb47047804",
                                                "text": "„Der Salonga-Nationalpark ist einer der größten Waldparks der Erde. Er ist gleichzeitig das einzige Schutzgebiet für den seltenen Zwergschimpansen oder Bonobo (Pan paniscus).“"
                                            },
                                            {
                                                "example_id": "828601ac-edbb-427f-8a69-c91e751eb3a7",
                                                "sense_id": "4780f2b2-7f06-36ec-9001-62eb47047804",
                                                "text": "„Doch bei den Bonobos pflegen die körperlich schwächeren Weibchen sich durchzusetzen, was einer Schimpansenfrau kaum gelingen würde.“"
                                            },
                                            {
                                                "example_id": "5ed45c8a-cf9d-4c50-9e8d-495b158dc993",
                                                "sense_id": "4780f2b2-7f06-36ec-9001-62eb47047804",
                                                "text": "„Die Bonobos stehen stammesgeschichtlich den Menschen näher als die Schimpansen.“"
                                            },
                                            {
                                                "example_id": "a3fa822c-b47c-4895-a73b-0d15e4970b3c",
                                                "sense_id": "4780f2b2-7f06-36ec-9001-62eb47047804",
                                                "text": "„Insbesondere in den westlichen und zentralen Bereichen der Cuvette Centrale leben heute nur noch sehr wenige Bonobos. Die Weltnaturschutzunion IUCN schätzt den verbliebenen Gesamtbestand an wildlebenden Bonobos auf etwa 10.000 bis 50.000 Tiere.“"
                                            },
                                            {
                                                "example_id": "cf8d10bd-6e98-448d-804f-bb556097c2e3",
                                                "sense_id": "4780f2b2-7f06-36ec-9001-62eb47047804",
                                                "text": "„Wo Bonobos leben, sind die Baumkronen breit und damit auch nahrungsreich, enthalten die Früchte wenig Schadstoffe, und wachsen eiweißreiche Kräuter, auf die in mageren Zeiten zurückgegriffen werden kann. Diese geringe Nahrungskonkurrenz erlaubt Bonobos, in relativ großen Kleingruppen von durchschnittlich sechs bis sieben Tieren auf Futtersuche zu gehen.“"
                                            },
                                            {
                                                "example_id": "5121145d-04ec-4046-8ef7-30ec173a468d",
                                                "sense_id": "4780f2b2-7f06-36ec-9001-62eb47047804",
                                                "text": "„Der Unterschied zwischen dem Bonobo und dem Menschen betrifft etwa 400 Gene.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6edc737-46b0-43c2-9a79-60f347bc7836",
                        "source_entry_id": "2de96889-c4d3-3162-aa56-dcf97ffe1828",
                        "source_sense_id": "aa2ac78b-e5f4-3ec1-ae34-21756e733ab9",
                        "source_sense_description": "Zoologie: Bonobo, Zwergschimpanse (Pan paniscus)",
                        "target_lang_word": "Zwergschimpanse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwergschimpanse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afbb6138-2853-32ce-8903-950db3805ea0",
                                        "entry_id": "c13fb832-7877-3dd8-bc83-5a5f25979bd9",
                                        "glosses": [
                                            "(in den zentralafrikanischen Regenwald-Gebieten südlich des Kongo beheimatete) Menschenaffen-Art (Pan paniscus) mit braunschwarzem Haarkleid, die nur unwesentlich kleiner ist und einen schlankeren Körperbau mit längeren Gliedmaßen und weniger hervorspringendem Kiefer besitzt als ihre nahverwandte Geschwisterart des Schimpansen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d26a60-2c05-4cd9-b9fb-e61d3c80d958",
                                                "sense_id": "afbb6138-2853-32ce-8903-950db3805ea0",
                                                "text": "„Der Salonga-Nationalpark ist einer der größten Waldparks der Erde. Er ist gleichzeitig das einzige Schutzgebiet für den seltenen Zwergschimpansen oder Bonobo (Pan paniscus).“"
                                            },
                                            {
                                                "example_id": "dc4cc684-bce8-496b-8d08-5a683ada7e0a",
                                                "sense_id": "afbb6138-2853-32ce-8903-950db3805ea0",
                                                "text": "„Zwergschimpansen dürften die einzigen tierischen Primaten sein, bei denen erwachsene Weibchen einer Gruppe mit denen einer fremden eine enge Freundschaft eingehen.“"
                                            },
                                            {
                                                "example_id": "7d4c0b40-df50-4d1a-a476-c9f9f9a45004",
                                                "sense_id": "afbb6138-2853-32ce-8903-950db3805ea0",
                                                "text": "„Mit unseren nächsten Verwandten unter den Primaten, den Zwergschimpansen, den Bonobos, haben wir – wie gesagt – den größten Teil des Genoms, 98.7 Prozent, gemeinsam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
