        "fr-extract.jsonl": [
            {
                "entry_id": "5343ea3f-190d-31d1-9ee2-3dca509412cf",
                "word": "cubisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "185a3455-f98f-4830-9e79-f31a8ba0dce0",
                        "entry_id": "5343ea3f-190d-31d1-9ee2-3dca509412cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "cubismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c139507f-6d50-3e27-a561-53152d3144ce",
                        "entry_id": "5343ea3f-190d-31d1-9ee2-3dca509412cf",
                        "glosses": [
                            "Mouvement artistique qui utilise les formes géométriques de base (cube, prisme, cylindre, sphère, cône, etc.) comme moyen d'expression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0414c752-ca7b-45ad-8ca0-00d11044ecd2",
                                "sense_id": "c139507f-6d50-3e27-a561-53152d3144ce",
                                "text": "Objets et corps sont pétrifiés, « cubes », ­formes fuselées ou ovoïdes, denses et dures. Cette définition du cubisme par l’angle droit, la sphère ou toute autre géométrie dans l’espace, que Braque et ­Picasso inventent en 1908 et explorent jusqu’à l’hiver 1909-1910, est celle qui est reprise et systématisée par ceux qui se réclament du cubisme à partir de 1910."
                            },
                            {
                                "example_id": "9b5bf6aa-0934-4f0c-9667-2a1cde26654f",
                                "sense_id": "c139507f-6d50-3e27-a561-53152d3144ce",
                                "text": "Mais le cubisme n’était pas la modernité même; il était un prélude à l’abstraction, à la non-figuration."
                            },
                            {
                                "example_id": "c7521454-84d2-46d9-ace9-e07ab975b94a",
                                "sense_id": "c139507f-6d50-3e27-a561-53152d3144ce",
                                "text": "Le mot « cubisme » viendrait des paroles qu’auraient prononcées Henri Matisse au sujet d’une toile de 1908 de Georges Braque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49d1fee1-5c16-4429-8660-510872536cd6",
                        "source_entry_id": "5343ea3f-190d-31d1-9ee2-3dca509412cf",
                        "source_sense_id": "c139507f-6d50-3e27-a561-53152d3144ce",
                        "target_lang_word": "Kubismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kubismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd2dd393-f661-3989-89ce-f1fc3ab3b4c8",
                                        "entry_id": "594eda01-abc6-36f2-a80d-7d525828156d",
                                        "glosses": [
                                            "Stilrichtung in der modernen Kunst, in der natürliche Formen (zum Beispiel menschliche Körper) mit geometrischen Formen dargestellt werden"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589dc198-305c-442e-9239-ed24b1ff865d",
                                                "sense_id": "fd2dd393-f661-3989-89ce-f1fc3ab3b4c8",
                                                "text": "Pablo Picasso ist einer der bekanntesten Vertreter des Kubismus."
                                            },
                                            {
                                                "example_id": "9315055a-7ec9-47e3-894b-13b9cacc8428",
                                                "sense_id": "fd2dd393-f661-3989-89ce-f1fc3ab3b4c8",
                                                "text": "„Matisse habe die Begriffe Kubismus und Expressionismus erfunden, berichtet Däubler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2780b4cf-61e0-4dfa-a20b-eba4f09ab947",
                        "source_entry_id": "5343ea3f-190d-31d1-9ee2-3dca509412cf",
                        "source_sense_id": "c139507f-6d50-3e27-a561-53152d3144ce",
                        "target_lang_word": "cubism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cubism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1230b8fc-94fb-32fc-b9a9-34e7d544625f",
                                        "entry_id": "ac537468-f070-36c0-a96b-d18ffd785c99",
                                        "glosses": [
                                            "An artistic movement in the early 20th Century characterized by the depiction of natural forms as geometric structures of planes."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873f163f-b4ce-48b0-8615-be705278beea",
                                                "sense_id": "1230b8fc-94fb-32fc-b9a9-34e7d544625f",
                                                "text": "Matisse coined the name Cubism as a derisive joke."
                                            },
                                            {
                                                "example_id": "915363c2-bb19-4154-ae78-cf6aeee48cb0",
                                                "sense_id": "1230b8fc-94fb-32fc-b9a9-34e7d544625f",
                                                "text": "A few recall that, in 1908, he [Matisse] inspired the coinage of the term “cubism,” in disparagement of a movement that would eclipse his leading influence on the Parisian avant-garde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
