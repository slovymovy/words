                                "target_senses": [
                                    {
                                        "sense_id": "79d602d7-8c60-3d39-9215-83f1932ef67b",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "The guinea fowl (family Numididae)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50cdc18f-68f5-32f0-b4b6-ffc37f9fbac2",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A bird in the genus Meleagris with a fan-shaped tail and wattled neck, especially the wild turkey (Meleagris gallopavo, now domesticated)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bf925f3-f201-4099-b719-6756220c0809",
                                                "sense_id": "50cdc18f-68f5-32f0-b4b6-ffc37f9fbac2",
                                                "text": "It was a Turkey! He never could have stood upon his legs, that bird. He would have snapped 'em short off in a minute, like sticks of sealing-wax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6150f3e-212e-3f8f-8c66-ee004f6dc24c",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "The flesh or meat of this bird eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10001443-1e57-472e-8050-f7be426fd681",
                                                "sense_id": "a6150f3e-212e-3f8f-8c66-ee004f6dc24c",
                                                "text": "All week after Thanksgiving, I had turkey sandwiches for lunch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480c6b9d-24e9-3716-8bad-c13aaf463490",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "With a distinguishing word: a bird resembling the Meleagris gallopavo (for example, the brush turkey or bush turkey (Alectura lathami), and the water turkey (Anhinga anhinga))."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fa5ed3d-704b-3ee9-a6bb-c161a029342c",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "An act of throwing three strikes in a row."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a7d1d00-783e-3475-b51c-9a4c5c8a01de",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A patient feigning symptoms; a person faking illness or injury; a malingerer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1703700-c920-402d-be36-038215b776f6",
                                                "sense_id": "4a7d1d00-783e-3475-b51c-9a4c5c8a01de",
                                                "text": "Mumford (1970) noted that the terms ‘crock’, ‘gomer’, and ‘turkey’, were sometimes utilized by interns to designate different types of undesirable patients, and sometimes used synonymously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e4c4088-dec1-375d-b483-a053983f6a5c",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A pack carried by a lumberman; a bindle; also, a large travel bag, a suitcase."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "US",
                                            "countable",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A failure."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be5b39b-f26a-4f52-9f7c-b4a917b36e4e",
                                                "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                                "text": "That film was a turkey."
                                            },
                                            {
                                                "example_id": "3caf3bb0-34c8-4861-91f2-5a065471472d",
                                                "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                                "text": "And despite the gross incompetence of Hemmings' direction, the ludicrous script, and the heavy-handed acting, there remains a stellar reason to see and enjoy Just a Gigolo: David Bowie. David Bowie is a great actor, and not even this turkey can obscure that fact."
                                            },
                                            {
                                                "example_id": "b2ef1ec4-6679-4ed3-bc4d-38071446ebcb",
                                                "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                                "text": "There were a few turkeys. In the rush to present a futuristic vision, the railways' heritage was largely forgotten and we ended up with new stations at Euston and at Coventry, its brash sidekick which I particularly loathe, although (of course) it won design awards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b837eac-2711-3c61-9565-cbb74b6fb8e4",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A foolish or inept person."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "derogatory",
                                            "mildly",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee63ab55-7dbf-496e-ab2a-9a5c962781cd",
                                                "sense_id": "2b837eac-2711-3c61-9565-cbb74b6fb8e4",
                                                "text": "The turkey cut in front of me and then berated me for running into him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "916056bb-d042-35df-8dfe-7f57e7fa13ca",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67179d2f-4688-4c86-83ab-4f5adf12c7c4",
                        "source_entry_id": "d10130b4-4e44-34ed-9fa1-e2170a46534e",
                        "source_sense_id": "a83f1312-e27b-3683-b734-a626da570e0a",
                        "target_lang_word": "manque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                        "entry_id": "9faf03f5-5043-34a2-a9b5-bcb754ddc629",
                                        "glosses": [
                                            "Absence, défaut, fait de manquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a3ec36-323a-407e-9697-1a6f6d0f7e00",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Le vieux von Winterfeld entra bientôt dans le coma ; parmi les blessés, trois se rétablissaient assez rapidement, alors que l’état des autres empirait, par suite du manque de bonne nourriture."
                                            },
                                            {
                                                "example_id": "8f3b2e26-9e08-42a6-8585-618dc3d5053a",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Pendant que les lames attaquaient mon vaillant navire […], je restai allongé sur ma couchette, philosophant sur le manque de confort de ma présente situation."
                                            },
                                            {
                                                "example_id": "51cb8182-92f8-45bf-8c73-c49f8f8d4774",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Lui non plus n’aurait pas voulu choquer Jim par son manque de délicatesse, mais sa nature brutale subitement l’emportait."
                                            },
                                            {
                                                "example_id": "fcefcbd8-b66f-499f-9d3d-a17f3f2b433a",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Moyennant quoi rien ne réfrénait sa connardise que le manque d’imagination. Il ne faisait de doute pour personne que le connard n’était pas réformable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                        "entry_id": "9faf03f5-5043-34a2-a9b5-bcb754ddc629",
                                        "glosses": [
                                            "État de stress dû à la privation d’une drogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef284c7-459b-4883-8bc4-54c34db293ad",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "Il était encore trop tôt pour prévoir le « manque » d’April qui viendrait probablement un jour m’assaillir – le « manque » au sens où l’entendent ceux que la drogue a soumis, et qui la quittent, et dont le corps crie famine parce que ça leur a fait trop mal d’arracher le singe qui s’accrochait à leur dos. Et peut-être, d’ailleurs, ne connaîtrais-je pas ce « manque »."
                                            },
                                            {
                                                "example_id": "29ca7cea-ecb3-4358-b84d-e967e0e9f5fe",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "— Les gars des Stups prétendent que beaucoup de drogués prennent de la méthédrine quand ils ne peuvent se procurer de l’héro. Apparemment, ça les aide à supporter les douleurs du manque."
                                            },
                                            {
                                                "example_id": "36031178-9e05-4a6a-b0f3-08efba97a31e",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "Lorsqu’on joue aux cartes, malgré l’insignifiance des symptômes de manque, chacun fume comme une cheminée, même si sa consommation habituelle est très faible."
                                            },
                                            {
                                                "example_id": "2ab62254-4e33-4dfb-b875-4761724edc25",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "— Je suis au fond du trou, dit–il au capitaine. Je suis en manque, je n'ai plus d'argent et je suis bien incapable de trouver un boulot pour en gagner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcacae2e-6472-3c1e-a3ed-45a7fcafa45c",
