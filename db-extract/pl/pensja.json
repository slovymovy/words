                        "form": "pensjach"
                    },
                    {
                        "form_id": "f4b058f7-a782-4b29-9e00-19489e2e513f",
                        "entry_id": "b6a5659a-9db7-305a-922f-f963f62224de",
                        "tags": [
                            "vocative",
                            "plural"
                        ],
                        "form": "pensje"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b55c5e7f-8366-3a2f-8633-653af6202e34",
                        "entry_id": "b6a5659a-9db7-305a-922f-f963f62224de",
                        "glosses": [
                            "płaca za wykonaną pracę wypłacana w równych odstępach czasu, dotycząca jakiegoś okresu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6a0cde-ccb2-4d1f-bf34-4296ff00a296",
                                "sense_id": "b55c5e7f-8366-3a2f-8633-653af6202e34",
                                "text": "Dzisiaj wreszcie przyszła moja pensja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "96a08b48-971c-38ac-92d4-2e4d2203726e",
                        "entry_id": "b6a5659a-9db7-305a-922f-f963f62224de",
                        "glosses": [
                            "prywatna szkoła żeńska, najczęściej z internatem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f79a6a0-43c3-42d6-8e79-c9ace15d983d",
                                "sense_id": "96a08b48-971c-38ac-92d4-2e4d2203726e",
                                "text": "Madzia pamiętała dzień, w którym Linka i Stasia opuściły pensję; zdawało jej się jednak, że pani Latter nawet nie spostrzegła tego wypadku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5dcfe854-77f5-3837-8199-dbc783e45fce",
                        "entry_id": "b6a5659a-9db7-305a-922f-f963f62224de",
                        "glosses": [
                            "ogół uczennic pensji (1.2)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a2c3e1-de58-4f52-bed5-6bf30417c20d",
                                "sense_id": "5dcfe854-77f5-3837-8199-dbc783e45fce",
                                "text": "A kto wie, czy pani Latter nie gniewa się i za to, że ona całowała Zosię Piasecką i mogła zarazić całą pensję jakąś niezdecydowaną chorobą."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74ebab78-4518-4729-a750-43b1d4074134",
                        "source_entry_id": "b6a5659a-9db7-305a-922f-f963f62224de",
                        "source_sense_id": "b55c5e7f-8366-3a2f-8633-653af6202e34",
                        "target_lang_word": "salary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                        "entry_id": "04522e15-6ae7-32ff-bb19-b467c7ac7dcc",
                                        "glosses": [
                                            "A fixed amount of money paid to a worker, usually calculated on a monthly or annual basis, not hourly, as wages. Implies a degree of professionalism and/or autonomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644ab3ca-1ae0-40a2-81b1-be20b71846c2",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "This is hire and salary, not revenge."
                                            },
                                            {
                                                "example_id": "4de70d20-c0c7-4e2b-b9e0-daf1b89d9820",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "Andrew Houſtoun and Adam Muſhet, being Tackſmen of the Excize, did Imploy Thomas Rue to be their Collector, and gave him a Sallary of 30. pound Sterling for a year."
                                            },
                                            {
                                                "example_id": "f7d3555e-6742-4925-b704-125b0a36075e",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "I used to say to our audiences: “It is difficult to get a man understand something, when his salary depends upon his not understanding it!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8e74aa-92fe-3aae-a146-e4167358d407",
                                        "entry_id": "700a4a9e-5296-35c7-8eb0-6a1a2500a1cc",
                                        "glosses": [
                                            "To pay on the basis of a period of a week or longer, especially to convert from another form of compensation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "salary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6de84f96-de3a-3da3-bd06-18c345c5ff91",
                                        "entry_id": "27c89012-ae88-3fa6-9819-18d319e6b7f6",
                                        "glosses": [
                                            "Saline."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9e20d14-5b75-414d-95aa-572dddd4b4ef",
                        "source_entry_id": "b6a5659a-9db7-305a-922f-f963f62224de",
                        "source_sense_id": "b55c5e7f-8366-3a2f-8633-653af6202e34",
                        "target_lang_word": "salario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salario",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "88e7f6b7-abad-36d8-a19f-a2a5e2660824",
                                        "entry_id": "1674e3a5-8094-38d9-b30b-c1041b9aa6fb",
                                        "glosses": [
                                            "Dinero o bienes que periódicamente percibe una persona de un patrón o empleador por determinado período de trabajo. Si el pago es por día se denomina jornal (por jornada)."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bfe4bfc-f246-4282-911c-d636ab558a18",
                                                "sense_id": "88e7f6b7-abad-36d8-a19f-a2a5e2660824",
                                                "text": "Dado que se trata de un costo para los empleadores y de la principal fuente de ingresos de los trabajadores, los salarios pueden ser objeto de conflictos y se han convertido en uno de los principales temas de las negociaciones colectivas en todo el mundo"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b543cac-4bbe-4f72-ac55-bcc6492f199d",
                        "source_entry_id": "b6a5659a-9db7-305a-922f-f963f62224de",
                        "source_sense_id": "b55c5e7f-8366-3a2f-8633-653af6202e34",
                        "target_lang_word": "Gehalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d36dd225-36bb-3de8-8410-47a242e80104",
                                        "entry_id": "57124f8d-5247-3024-8a6c-8f539a5d0337",
                                        "glosses": [
                                            "Menge einer bestimmten Substanz in einem Gemisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edeafe05-e3d2-4274-8255-ee4dd75d601c",
                                                "sense_id": "d36dd225-36bb-3de8-8410-47a242e80104",
                                                "text": "Süßwasser weist einen Gehalt an Salz von 0,1 % auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37199562-1149-3ad4-80b8-25f2d8fca11f",
                                        "entry_id": "57124f8d-5247-3024-8a6c-8f539a5d0337",
                                        "glosses": [
                                            "der ideelle Wert, der geistige beziehungsweise gedankliche Inhalt eines kreativen Werkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7e90e6-8ea9-48f9-8410-260e3c63ea71",
                                                "sense_id": "37199562-1149-3ad4-80b8-25f2d8fca11f",
                                                "text": "Der Gehalt dieser Fernsehsendung ist gleich null."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gehalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                        "entry_id": "602da67f-0e25-3f49-9c38-b2913a4adc66",
                                        "glosses": [
                                            "Geldbetrag, welcher auf Grund von Anwesenheit und verrichteter Dienste regelmäßig an Beamte oder Angestellte bezahlt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5470b25-b3d4-435f-be5f-b6beb8b2185f",
                                                "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                                "text": "Historisch und auch in der Umgangssprache werden zwei Formen des Entgelts unterschieden: das Gehalt eines Angestellten und der Lohn eines Arbeiters."
                                            },
                                            {
                                                "example_id": "c49861a7-ac0f-4b22-a78b-a921f918fbfd",
                                                "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                                "text": "Mein Gehalt ist schon seit Jahren nicht gestiegen, gleichzeitig werden Strom und Lebensmittel immer teurer."
                                            },
                                            {
                                                "example_id": "4881d69d-d2d5-46c8-92aa-d02cfe29231a",
                                                "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                                "text": "Bei dem Gehalt möchte ich hier nicht weiter arbeiten."
                                            },
                                            {
                                                "example_id": "18c62ee6-29af-46d4-9210-df7737ed528d",
                                                "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                                "text": "„Bleibt der Gehalt eines Beamten, der Dienste einer höheren Verwendungsgruppe leistet, hinter dem Anfangsgehalt der entsprechenden höheren Verwendungsgruppe zurück, so ist eine Mehrleistungsvergütung in der Höhe des Unterschiedsbetrages zwischen dem Anfangsgehalt der höheren Verwendungsgruppe und dem tatsächlichen Gehalt des Beamten als angemessen anzusehen.“"
                                            },
                                            {
                                                "example_id": "d34d3bf8-cb53-48a4-8288-40ea7d0f1d4a",
                                                "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                                "text": "„Er erzählte mir, er sei im Münzamt mit einem noch sehr kleinen Gehalt angestellt, das jedoch später höher würde; sein Vater und seine Mutter wohnten in Toledo, und er sei allein mit seiner geliebten Braut in Madrid.“"
                                            },
                                            {
                                                "example_id": "d5bae0ad-8b84-47a1-a663-41638249a726",
                                                "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                                "text": "„Verwendung für sein Gehalt wird Einstein schon gefunden haben.“"
                                            },
                                            {
                                                "example_id": "23a6a287-bcb3-49b3-9bda-a77063181738",
                                                "sense_id": "550cfda2-f5d5-3167-95a0-8e3fb25af0cb",
                                                "text": "„Die Arbeit als Leiter der Polizeiwache war deutlich einsamer, ungeachtet des höheren Gehalts und der größeren Wertschätzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45760606-c5ab-4fa1-ae58-8c29e005cae8",
