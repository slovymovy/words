                    {
                        "translation_id": "18b3726b-c6c1-431b-8c5a-bd0c87b5cfb3",
                        "source_entry_id": "d540b87a-9d3d-3407-aad9-734d282246c9",
                        "source_sense_id": "ba77d37b-328e-3a41-8ea7-9f8ca6521759",
                        "source_sense_description": "having many wrinkles",
                        "target_lang_word": "faltig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faltig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41d2ef50-05d0-3190-b9c2-65d3f1071b48",
                                        "entry_id": "6d50791a-8280-3cf6-abda-80090cdc2d1e",
                                        "glosses": [
                                            "von Falten durchzogen, zerknittert"
                                        ],
                                        "tags": [
                                            "Stoff"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871aaf25-9d6c-4c38-98d7-dd9932e2151b",
                                                "sense_id": "41d2ef50-05d0-3190-b9c2-65d3f1071b48",
                                                "text": "Beim Bügeln musst Du das Hemd auf dem Brett ganz glattziehen. Wie sieht das sonst aus: ganz faltig und zerknittert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b322ef03-61da-3c3d-a69f-6f62ba9ff019",
                                        "entry_id": "6d50791a-8280-3cf6-abda-80090cdc2d1e",
                                        "glosses": [
                                            "Runzeln habend"
                                        ],
                                        "tags": [
                                            "Gesicht",
                                            "Haut"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b53d1ee-5a1f-4bd5-9483-53df52c0cfb5",
                                                "sense_id": "b322ef03-61da-3c3d-a69f-6f62ba9ff019",
                                                "text": "Viele glauben immer noch, dass Make-up die Poren verstopft, die Haut früher faltig macht und sie nicht atmen lässt. Doch das stimmt nicht."
                                            },
                                            {
                                                "example_id": "f4e6798c-30a1-437c-8567-7c23ce285401",
                                                "sense_id": "b322ef03-61da-3c3d-a69f-6f62ba9ff019",
                                                "text": "Crystal-Abhängige sehen auch so alt aus. Sie magern ab, die Haut wird faltig, die Augen fallen ein."
                                            },
                                            {
                                                "example_id": "70a9d221-a512-46e0-919f-c03d092ac41c",
                                                "sense_id": "b322ef03-61da-3c3d-a69f-6f62ba9ff019",
                                                "text": "\"Sie tragen etwas ausgedünntes, angegrautes, gefärbtes Haar auf dem Kopf – oder gar keines. Ihre Haut ist leicht faltig, ihre Augen haben einiges gesehen von der Welt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
