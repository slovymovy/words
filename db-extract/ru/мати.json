                        "form": "ма́ти^△"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c6f431d-b1bd-3750-af7b-9a82cbae9a21",
                        "entry_id": "fa6c744f-2f1c-3ac8-977c-4106c04ff17c",
                        "glosses": [
                            "устар. или церк., нар.-поэт., высок. мать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57b199df-28b4-41a4-b604-7759dd4fe45f",
                                "sense_id": "0c6f431d-b1bd-3750-af7b-9a82cbae9a21",
                                "text": "Россия-мати! Свет мой безмерный!"
                            },
                            {
                                "example_id": "6e1de63a-227f-453c-b635-3e575a3e9049",
                                "sense_id": "0c6f431d-b1bd-3750-af7b-9a82cbae9a21",
                                "text": "Отец мой прилежаще пития хмельного, // А мати ― постница, молитвенница бысть."
                            },
                            {
                                "example_id": "8efbfc61-30e6-412f-b768-73ff14b904ef",
                                "sense_id": "0c6f431d-b1bd-3750-af7b-9a82cbae9a21",
                                "text": "Давид не более находит утешения, когда признает, что в беззакониях зачат он, и во гресех роди его мати его."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a314b909-0bbf-4af7-8bce-0531b7840e6f",
                        "source_entry_id": "fa6c744f-2f1c-3ac8-977c-4106c04ff17c",
                        "source_sense_id": "0c6f431d-b1bd-3750-af7b-9a82cbae9a21",
                        "target_lang_word": "Mutti",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mutti",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6813f03f-27aa-392c-9384-8a3a02a20e4a",
                                        "entry_id": "66e77de1-5723-3efe-b70f-b0ee891f3c1d",
                                        "glosses": [
                                            "Koseform zu Mutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdb8c70-9bed-4e6d-9c92-95290f65509f",
                                                "sense_id": "6813f03f-27aa-392c-9384-8a3a02a20e4a",
                                                "text": "„Mutti war denn auch das Wort der vergangenen Woche, in der Angela Merkels zweite Kanzlerschaft begann.“"
                                            },
                                            {
                                                "example_id": "10b49074-a13d-41ca-adf9-9ef847750db3",
                                                "sense_id": "6813f03f-27aa-392c-9384-8a3a02a20e4a",
                                                "text": "„Nicht, dass Marc oder ich eine bräuchten, aber Muttis sind nun einmal Muttis.“"
                                            },
                                            {
                                                "example_id": "12d340f8-daf0-4c55-a1ed-621002f1075a",
                                                "sense_id": "6813f03f-27aa-392c-9384-8a3a02a20e4a",
                                                "text": "„Die Mutti fährt mit ihrem Kleinwagen zum Supermarkt und kauft Wasser in Glasflaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
