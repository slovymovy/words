                        "examples": [
                            {
                                "example_id": "759e717d-3f0f-419d-9141-28367730ef0b",
                                "sense_id": "6c937a53-5998-321c-9ed8-3423940a8db7",
                                "text": "Het is weer de achtenveertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "8fc62504-c181-4115-a69c-0bcdbdced6ba",
                                "sense_id": "6c937a53-5998-321c-9ed8-3423940a8db7",
                                "text": "Haar negenenveertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de achtenveertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f3963b1-9fa9-3bc8-8f62-ccb6ed5f51e8",
                        "entry_id": "bb5d6178-75d7-3821-8ff7-e7014ad3f93b",
                        "glosses": [
                            "groep van 48 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ee333b-f849-44ce-be25-04e9dc784664",
                                "sense_id": "8f3963b1-9fa9-3bc8-8f62-ccb6ed5f51e8",
                                "text": "De achtenveertig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
