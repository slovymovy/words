                "senses": [
                    {
                        "sense_id": "cfd523b6-9c30-3d4e-9c26-a9c134bcccdf",
                        "entry_id": "fdf55823-c26b-3c02-b948-1d25473c482e",
                        "glosses": [
                            "A miscellaneous collection of different things; a miscellany."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f1ffd6f-b383-4238-b19e-56731e72e8f9",
                                "sense_id": "cfd523b6-9c30-3d4e-9c26-a9c134bcccdf",
                                "text": "Bright copper utensils, strings of onions, and gigantic sausages, wine-skins, chillies, and castanets hung with a miscellanea of all kinds from the roof and walls."
                            },
                            {
                                "example_id": "e7d7d454-3dc9-4517-938e-bdf71f762980",
                                "sense_id": "cfd523b6-9c30-3d4e-9c26-a9c134bcccdf",
                                "text": "Long tables of statistics from the Census Reports, extracts from books, and sometimes whole books reappear in the Record, jumbled into a miscellanea that includes a flamboyant discourse on “The Outlook for Prosperity,” […]"
                            },
                            {
                                "example_id": "4e779a65-e7b9-4031-b849-e3208f53c144",
                                "sense_id": "cfd523b6-9c30-3d4e-9c26-a9c134bcccdf",
                                "text": "Through a renewed process of selection, miscellanea are cut down to compendia, which, once structurally organized, become texts"
                            }
                        ]
                    }
                ],
