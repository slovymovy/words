                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae5af6a3-8957-46b5-9380-0bd7445974ff",
                                                "sense_id": "ea684060-eb55-3754-b53c-1800657b8424",
                                                "text": "Die Autofahrerinnen und Autofahrer mit dem Kennzeichen AG backen sicher einen feinen <>, was einem Karottenkuchen entspricht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
