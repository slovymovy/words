{
    "word_family": [
        "temptation",
        "tempter",
        "temptress",
        "tempting",
        "temptingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f15a610-7b9e-396e-9084-747bf7b1d7ab",
                    "sense_definition": "To attract or allure someone by appearing appealing or desirable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of fresh bread from the bakery began to <w>tempt</w> the hungry passersby.",
                            "target_lang_translations": {
                                "ru": "Запах свежего хлеба из пекарни начал <w>соблазнять</w> голодных прохожих.",
                                "tr": "Fırından gelen taze ekmek kokusu, aç yoldan geçenleri <w>cezbetmeye</w> başladı.",
                                "zh": "面包店里飘出的新鲜面包香气开始<w>吸引</w>饥肠辘辘的行人。"
                            }
                        },
                        {
                            "text": "The travel agency tried to <w>tempt</w> customers with photos of beautiful tropical beaches.",
                            "target_lang_translations": {
                                "ru": "Турагентство пыталось <w>прельстить</w> клиентов фотографиями красивых тропических пляжей.",
                                "tr": "Seyahat acentesi, güzel tropikal plaj fotoğraflarıyla müşterileri <w>cezbetmeye</w> çalıştı.",
                                "zh": "旅行社试图用美丽的热带海滩照片来<w>诱惑</w>顾客。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allure",
                        "attract",
                        "entice",
                        "lure"
                    ],
                    "antonyms": [
                        "repel",
                        "repulse"
                    ],
                    "common_phrases": [
                        "tempt customers",
                        "tempt the palate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать или манить кого-либо, выглядя привлекательным или желанным.",
                        "tr": "Birini çekici veya arzu edilir görünerek kendine çekmek veya cezbetmek.",
                        "zh": "通过展现出吸引力或令人向往的特质，来吸引或诱惑某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазнять",
                                "target_lang_sense_clarification": "привлекать чем-то заманчивым"
                            },
                            {
                                "target_lang_word": "прельщать",
                                "target_lang_sense_clarification": "очаровывать или манить"
                            },
                            {
                                "target_lang_word": "искушать",
                                "target_lang_sense_clarification": "вызывать сильное желание"
                            },
                            {
                                "target_lang_word": "манить",
                                "target_lang_sense_clarification": "притягивать к себе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cezbetmek",
                                "target_lang_sense_clarification": "birini kendine çekmek, etkilemek"
                            },
                            {
                                "target_lang_word": "özendirmek",
                                "target_lang_sense_clarification": "bir şeyi yapmaya heveslendirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "使人产生兴趣或向往"
                            },
                            {
                                "target_lang_word": "诱惑",
                                "target_lang_sense_clarification": "用某种手段引诱人"
                            },
                            {
                                "target_lang_word": "勾引",
                                "target_lang_sense_clarification": "引诱人做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "094000a1-f445-35ff-8089-4a852e1c0465",
                    "sense_definition": "To persuade or provoke someone to do something wrong or unwise, often by offering a reward.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high salary might <w>tempt</w> him to take a job he doesn't actually like.",
                            "target_lang_translations": {
                                "ru": "Высокая зарплата может <w>соблазнить</w> его согласиться на работу, которая ему на самом деле не нравится.",
                                "tr": "Yüksek maaş, onu aslında sevmediği bir işi kabul etmesi için <w>ayartabilir</w>.",
                                "zh": "高薪可能会<w>诱使</w>他接受一份他其实并不喜欢的工作。"
                            }
                        },
                        {
                            "text": "Don't <w>tempt</w> me to eat that chocolate cake while I am trying to diet.",
                            "target_lang_translations": {
                                "ru": "Не <w>искушай</w> меня съесть этот шоколадный торт, пока я пытаюсь соблюдать диету.",
                                "tr": "Diyet yapmaya çalışırken beni o çikolatalı keki yemem için <w>baştan çıkarma</w>.",
                                "zh": "我正在节食，别<w>引诱</w>我吃那块巧克力蛋糕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entice",
                        "seduce",
                        "incite",
                        "induce"
                    ],
                    "antonyms": [
                        "discourage",
                        "deter"
                    ],
                    "common_phrases": [
                        "tempt someone to",
                        "tempt into doing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убеждать или провоцировать кого-либо совершить что-то неправильное или неразумное, часто предлагая вознаграждение.",
                        "tr": "Birini, genellikle bir ödül teklif ederek yanlış veya akılsızca bir şey yapmaya ikna etmek veya kışkırtmak.",
                        "zh": "劝说或怂恿某人做错误或不明智的事情，通常伴随某种利益诱导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазнять",
                                "target_lang_sense_clarification": "склонять к чему-либо"
                            },
                            {
                                "target_lang_word": "подбивать",
                                "target_lang_sense_clarification": "подстрекать к действию"
                            },
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "убеждать сделать что-либо"
                            },
                            {
                                "target_lang_word": "искушать",
                                "target_lang_sense_clarification": "вводить в грех или ошибку"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "baştan çıkarmak",
                                "target_lang_sense_clarification": "doğru yoldan saptırmak veya kötü bir şeye ikna etmek"
                            },
                            {
                                "target_lang_word": "ayartmak",
                                "target_lang_sense_clarification": "birini kandırarak yanlış bir işe sürüklemek"
                            },
                            {
                                "target_lang_word": "kışkırtmak",
                                "target_lang_sense_clarification": "birini kötü bir iş yapması için tahrik etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引诱",
                                "target_lang_sense_clarification": "诱导人走入歧途"
                            },
                            {
                                "target_lang_word": "怂恿",
                                "target_lang_sense_clarification": "劝诱人做不该做的事"
                            },
                            {
                                "target_lang_word": "诱使",
                                "target_lang_sense_clarification": "诱导并使人做出某种行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c055495-da5a-3bdd-9c28-f365bbf8eefb",
                    "sense_definition": "To act in a way that makes a particular bad outcome more likely to happen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Driving so fast on these icy roads is really starting to <w>tempt</w> fate.",
                            "target_lang_translations": {
                                "ru": "Такая быстрая езда по обледенелым дорогам — это настоящая попытка <w>испытать</w> судьбу.",
                                "tr": "Bu buzlu yollarda bu kadar hızlı sürmek gerçekten <w>kadere meydan okumaya</w> başlıyor.",
                                "zh": "在这些结冰的道路上开这么快，简直是在<w>挑战</w>命运。"
                            }
                        },
                        {
                            "text": "By not wearing a helmet, you <w>tempt</w> providence and risk a serious head injury.",
                            "target_lang_translations": {
                                "ru": "Не надевая шлем, вы <w>искушаете</w> провидение и рискуете получить серьезную травму головы.",
                                "tr": "Kask takmayarak <w>şansını zorluyor</w> ve ciddi bir kafa yaralanması riski alıyorsun.",
                                "zh": "不戴头盔就是在<w>冒犯</w>天意，这会让你面临头部重伤的风险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "court",
                        "provoke",
                        "risk"
                    ],
                    "common_phrases": [
                        "tempt fate",
                        "tempt providence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать таким образом, который делает определенный плохой исход более вероятным.",
                        "tr": "Kötü bir sonucun gerçekleşme olasılığını artıran bir şekilde davranmak.",
                        "zh": "指行为鲁莽，增加了发生不幸后果的可能性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытывать",
                                "target_lang_sense_clarification": "в контексте судьбы"
                            },
                            {
                                "target_lang_word": "искушать",
                                "target_lang_sense_clarification": "подвергать риску (судьбу)"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "вызывать негативные последствия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kadere meydan okumak",
                                "target_lang_sense_clarification": "kötü bir sonucu riske atacak şekilde davranmak"
                            },
                            {
                                "target_lang_word": "şansını zorlamak",
                                "target_lang_sense_clarification": "tehlikeli bir duruma davetiye çıkarmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒犯",
                                "target_lang_sense_clarification": "指挑战某种不可控的力量"
                            },
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "指不顾后果地去尝试危险的事"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}