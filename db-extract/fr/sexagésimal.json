                        "form": "sexagésimales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62afc82d-70f2-3c1b-bc5b-d0b9fc4913ae",
                        "entry_id": "813a046a-5053-34ae-921a-592930d43d96",
                        "glosses": [
                            "Qui se rapporte à la base soixante, caractéristique d’un système de numération en base soixante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c67477a-49ad-42a8-949f-0249b56fbf60",
                                "sense_id": "62afc82d-70f2-3c1b-bc5b-d0b9fc4913ae",
                                "text": "Système sexagésimal babylonien : système de numération antique qui utilisait la base soixante."
                            }
                        ]
                    },
                    {
                        "sense_id": "d91fd231-2ac9-3a5e-89d7-37dedcfcd796",
                        "entry_id": "813a046a-5053-34ae-921a-592930d43d96",
                        "glosses": [
                            "Qui se divise en soixante, qui possède soixante pour dénominateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654075c9-21ab-42a7-9fd0-a6fd5d770552",
                                "sense_id": "d91fd231-2ac9-3a5e-89d7-37dedcfcd796",
                                "text": "Fractions sexagésimales : Fractions dont le dénominateur est une puissance de soixante."
                            },
                            {
                                "example_id": "859a669c-fa28-4fba-b38f-29421376a01c",
                                "sense_id": "d91fd231-2ac9-3a5e-89d7-37dedcfcd796",
                                "text": "Division sexagésimale : Division du degré en soixante minutes et de la minute en soixante secondes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "633e3a89-d211-48eb-8741-2a25ff30d183",
                        "source_entry_id": "813a046a-5053-34ae-921a-592930d43d96",
                        "target_lang_word": "sexagesimal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexagesimal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbec8099-8696-3d54-a664-121acb37e3c2",
                                        "entry_id": "bcc58485-75c9-356c-9035-d14945ed582f",
                                        "glosses": [
                                            "auf die Zahl sechzig als Basis bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e862f865-78c0-4a8f-9402-0f14aa458ff6",
                                                "sense_id": "fbec8099-8696-3d54-a664-121acb37e3c2",
                                                "text": "„Im weiteren Verlauf wurde in der babylonischen Mathematik ab ca. 2000 v. Chr. ein sexagesimales Stellenwertsystem verwendet.“"
                                            },
                                            {
                                                "example_id": "8023b266-24da-4eee-a46c-c0820259485e",
                                                "sense_id": "fbec8099-8696-3d54-a664-121acb37e3c2",
                                                "text": "„Bemerkenswert ist hier auch der senkrechte Strich, der den dekadischen ganzzahligen Teil vom sexagesimalen Bruchteil scheidet.“"
                                            },
                                            {
                                                "example_id": "ba9733c8-b494-4e1c-aae4-163438d760df",
                                                "sense_id": "fbec8099-8696-3d54-a664-121acb37e3c2",
                                                "text": "„[…] denn Powell unterstellt dabei, daß man im alten Šuruppak schon mit dem voll entwickelten, abstrakten sexagesimalen Stellenwertsystem zu rechnen verstand[…]“"
                                            },
                                            {
                                                "example_id": "15a9dc0b-8c28-436d-8785-6eb491002bd7",
                                                "sense_id": "fbec8099-8696-3d54-a664-121acb37e3c2",
                                                "text": "„Seit um die Mitte des 19. Jh. erkannt wurde, daß zur Wiedergabe von Zahlen in dieser Schrift ein sexagesimales System verwendet wurde, ist über dessen Ursprung viel gerätselt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc0bd43-0e84-402a-8bb1-796725dc3562",
                        "source_entry_id": "813a046a-5053-34ae-921a-592930d43d96",
                        "target_lang_word": "sexagesimal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexagesimal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e3e7b8d-f427-3fa3-be36-f2d73a95807c",
                                        "entry_id": "553a543f-668d-327f-ae00-f3306a31caa3",
                                        "glosses": [
                                            "Of, related to, or based on the number sixty."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "865d299b-8a03-4f1c-9dd0-8f08893fbf45",
                                                "sense_id": "6e3e7b8d-f427-3fa3-be36-f2d73a95807c",
                                                "text": "The common English divisions of time, longitude, and latitude are all computed using sexagesimal arithmetic."
                                            },
                                            {
                                                "example_id": "d5c27058-2216-4627-b3e2-fcd3dff1f1fb",
                                                "sense_id": "6e3e7b8d-f427-3fa3-be36-f2d73a95807c",
                                                "text": "She then supplied a detailed description of the Babylonians, who had relied on a sexagesimal system―counting by sixties, she explained―for both mathematics and astronomy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sexagesimal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a3e3e7f-0b64-3b44-9462-35d45c360e40",
                                        "entry_id": "b9463c50-940b-36a3-be58-daae8085afc6",
                                        "glosses": [
                                            "A fraction involving division by 60; a sixtieth part of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05bc3249-a7c6-483c-a9f8-6b2ebdad17cf",
                                                "sense_id": "9a3e3e7f-0b64-3b44-9462-35d45c360e40",
                                                "text": "Decimals are actually less convenient than sexagesimals for working with most common fractions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8cbf86d-11f5-3fc4-a533-01728a840caf",
                                        "entry_id": "b9463c50-940b-36a3-be58-daae8085afc6",
                                        "glosses": [
                                            "A base-60 number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187f4d45-9c87-4224-8bdb-8ec7dc7a46d9",
                                                "sense_id": "d8cbf86d-11f5-3fc4-a533-01728a840caf",
                                                "text": "Babylonian mathematics was computed in sexagesimals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
