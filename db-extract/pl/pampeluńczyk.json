                "senses": [
                    {
                        "sense_id": "1f671a6b-071b-3116-baf7-28e45a8312cf",
                        "entry_id": "3400236f-a8b9-3408-8ac2-6a4c9429472f",
                        "glosses": [
                            "mieszkaniec Pampeluny; osoba z tego miasta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb7b05d7-6667-4b54-8183-046fe61a2979",
                                "sense_id": "1f671a6b-071b-3116-baf7-28e45a8312cf",
                                "text": "W 2003 r., po dwóch miesiącach w śpiączce, zmarł Fermín Etxeberria, pampeluńczyk, który upadł podczas biegu i uderzył głową w bruk"
                            },
                            {
                                "example_id": "01c94ae1-d608-4de5-8a9b-9fe5f4f96cdc",
                                "sense_id": "1f671a6b-071b-3116-baf7-28e45a8312cf",
                                "text": "– Miasto, które znasz, zniknie. Cicha, spokojna Pampeluna odejdzie w niebyt. Nastanie istny szał – ostrzegają mnie pampeluńczycy dwa dni przed najsłynniejszą fiestą świata"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
