                "senses": [
                    {
                        "sense_id": "c41f5e34-e2db-3d79-93a3-114d4ed0e657",
                        "entry_id": "68cc8860-e0cd-346e-bc97-e73949c3b44e",
                        "glosses": [
                            "Donner un caractère gratuit à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7001850d-95d4-48ae-bd58-2ace47798e83",
                                "sense_id": "c41f5e34-e2db-3d79-93a3-114d4ed0e657",
                                "text": "Samedi 25 janvier: il parait que les CFF, sur ordre de la police grisonne, n'ont pas assez de wagons pour faire des trains spéciaux pour monter a Davos. Tant pis on gratuitisera les trains normaux, rendez-vous samedi matin dans les gares de Genève, Lausanne, Bern, Bâle et Zürich pour prendre les trains."
                            },
                            {
                                "example_id": "bafcc3e9-6cc9-4a40-8928-55fe7b9f4c94",
                                "sense_id": "c41f5e34-e2db-3d79-93a3-114d4ed0e657",
                                "text": "Mais ce marché est saturé bouffé par des majors qui «gratuitisent» tout et j'ai eu la chance de retrouver finalement en 2013 un cdi chez un ancien client qui n'a jamais regardé mon cv d'ailleurs et s'en tape… heureusement."
                            },
                            {
                                "example_id": "057e9da0-7c6f-48e1-8a04-d5140722b0fd",
                                "sense_id": "c41f5e34-e2db-3d79-93a3-114d4ed0e657",
                                "text": "Venez nombreux pour pouvoir gratuitiser le train!!!"
                            },
                            {
                                "example_id": "20b6b7b2-d7ba-4226-ab0f-2169d10ae12d",
                                "sense_id": "c41f5e34-e2db-3d79-93a3-114d4ed0e657",
                                "text": "Comment \"démarchandiser\" ou \"gratuitiser\" les vide-greniers ?"
                            },
                            {
                                "example_id": "bf16aef1-3f8d-475d-a38b-1a4cab1a2312",
                                "sense_id": "c41f5e34-e2db-3d79-93a3-114d4ed0e657",
                                "text": "Donc, le FIJ existe depuis 5 ans, il était payant au début et a fini par se \"gratuitiser\" il y a 3 ans."
                            }
                        ]
                    }
                ],
