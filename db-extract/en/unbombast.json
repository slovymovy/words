                        "sense_id": "262bfc13-c1e6-36be-97e9-1a5568bf3abe",
                        "entry_id": "0ddd44e8-1d47-3c4b-b62a-259451de9f4b",
                        "glosses": [
                            "To take down or discredit (bombastic speech or writing)."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "18b9fde9-81a7-408d-bbf3-76640b35f88f",
                                "sense_id": "262bfc13-c1e6-36be-97e9-1a5568bf3abe",
                                "text": "We wish Mr. Rafinesque to understand, that when any pseudo scientific publication is published here, calculated to mislead at home, and to discredit the country abroad, we shall proceed to unbombast it as soon as our leisure permits."
                            },
                            {
                                "example_id": "9b9a411d-ff5f-43d3-b650-eca3699c53d1",
                                "sense_id": "262bfc13-c1e6-36be-97e9-1a5568bf3abe",
                                "text": "Earlier in the year he had written to Backhouse, 'will it not then be singularly hard if we cannot find time to unbombast the impudence of the matchless Jonathan?'"
                            }
                        ]
                    }
