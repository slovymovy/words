                        "examples": [
                            {
                                "example_id": "20219931-992b-40be-b6ab-2644604ce5fe",
                                "sense_id": "cbd53e5a-2c53-3c1c-8c8d-12a9ad48824c",
                                "text": "Позвала бы шальная барыня наметанных своих клевретов, что бьют на сало нагулянный скот, ― подумал Рубашкин, ― мигом уходила бы меня в своем доме, и никто бы не откликнулся тут за меня в этой глуши!"
                            }
                        ]
                    }
