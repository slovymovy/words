                "senses": [
                    {
                        "sense_id": "6757d5ba-fc00-3e11-884b-dd693b07ce07",
                        "entry_id": "676543ec-36b4-3218-8e0b-342f568f1a38",
                        "glosses": [
                            "jemand, der den Euro als Gemeinschaftswährung ablehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714ba090-07a1-4287-a434-b1358b898299",
                                "sense_id": "6757d5ba-fc00-3e11-884b-dd693b07ce07",
                                "text": "„Die wesentlichsten Befürchtungen vieler deutscher Euro-Gegner haben sich bisher nicht verwirklicht.“"
                            },
                            {
                                "example_id": "ca2831d2-27bf-4f59-8e0e-124c25a5e188",
                                "sense_id": "6757d5ba-fc00-3e11-884b-dd693b07ce07",
                                "text": "„Die deutschen Euro-Gegner suchen den Zusammenschluss mit ihren Gesinnungsgenossen in Frankreich.“"
                            },
                            {
                                "example_id": "437f1e82-84b8-4c70-8bb6-19569fcfd688",
                                "sense_id": "6757d5ba-fc00-3e11-884b-dd693b07ce07",
                                "text": "„Kein Scherz: Die AfD will goldene D-Mark-Münzen verkaufen. So finden die Euro-Gegner endlich zu ihrer eigentlichen Bestimmung: Devotionalienhändler für Deutschland“"
                            },
                            {
                                "example_id": "a7796a3c-5dec-475f-8c3b-c86818595640",
                                "sense_id": "6757d5ba-fc00-3e11-884b-dd693b07ce07",
                                "text": "„Er gehört zu einer Gruppe von Euro-Gegnern, die 2011 vor dem Bundesverfassungsgericht gegen das erste Rettungspaket für Griechenland und den Euro-Rettungsschirm klagte.“"
                            }
                        ],
