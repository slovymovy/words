        "fr-extract.jsonl": [
            {
                "entry_id": "670dc338-945d-3173-b8a5-82bfa0de5009",
                "word": "roquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4b73f2b2-cec1-4d63-b19a-b194db6a30ba",
                        "entry_id": "670dc338-945d-3173-b8a5-82bfa0de5009",
                        "tags": [
                            "plural"
                        ],
                        "form": "roquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c186e1e-e32f-3399-89ab-7b39f696a99e",
                        "entry_id": "670dc338-945d-3173-b8a5-82bfa0de5009",
                        "glosses": [
                            "Variante de rochet."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "916d4b33-d3f3-4b89-82fd-4285992ed8fd",
                                "sense_id": "3c186e1e-e32f-3399-89ab-7b39f696a99e",
                                "text": "Allons, dit Gervaise prise à son tour de charité, et défaisant son roquet de laine, voici un surtout un peu plus chaud que le vôtre. Mettez ceci sur vos épaules."
                            },
                            {
                                "example_id": "fba25ee7-815b-47da-aef1-a3f2409a12a2",
                                "sense_id": "3c186e1e-e32f-3399-89ab-7b39f696a99e",
                                "text": "Sous les plis du roquet, à côté du pommeau de la brette chargée sans doute de le défendre, un quignon de pain montrait son nez."
                            },
                            {
                                "example_id": "679fabb2-2066-45b4-9abe-df72ee8ea2af",
                                "sense_id": "3c186e1e-e32f-3399-89ab-7b39f696a99e",
                                "text": "Vers le haut et sur toute sa longueur, ce métier porte une espèce de bobinière ou râtelier, destiné à recevoir les bobines ou roquets, qui ont à fournir le ou les fils destinés à être transformés en lacets creux; […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "390b47c8-a080-3ace-9d8b-83aa62908179",
                "word": "roquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b25a015a-97b3-402e-99b9-da095c85a258",
                        "entry_id": "390b47c8-a080-3ace-9d8b-83aa62908179",
                        "tags": [
                            "plural"
                        ],
                        "form": "roquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf80d7e3-2a82-3f26-89be-82ca37f2f622",
                        "entry_id": "390b47c8-a080-3ace-9d8b-83aa62908179",
                        "glosses": [
                            "Variante de roquette."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2719b569-b14d-47b9-835f-4b22b9f8007e",
                                "sense_id": "bf80d7e3-2a82-3f26-89be-82ca37f2f622",
                                "text": "Ayez un baston creux et rond de la longueur de trois ou quatre pieds, dedans lequel bois vous mettrez un de ces petitz canons [rouleaux de papier remplis de poudre], et donnerez le feu par un bout, et incontinent s'en ira en l'air faisant grand bruit ; et si le dict canon ou roquet."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2eaeb0cf-05e7-3917-ab79-a15df636480d",
                "word": "roquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f56712d-9e60-4616-a928-212795035562",
                        "entry_id": "2eaeb0cf-05e7-3917-ab79-a15df636480d",
                        "tags": [
                            "plural"
                        ],
                        "form": "roquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "045b127d-3df7-3199-8c1f-ca3fbd865532",
                        "entry_id": "2eaeb0cf-05e7-3917-ab79-a15df636480d",
                        "glosses": [
                            "(Ouest de la France) Chemin, ruelle montueuse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3cc05eb0-a2e6-40bb-afc1-73e67166da79",
                                "sense_id": "045b127d-3df7-3199-8c1f-ca3fbd865532",
                                "text": "La route qui conduisait de la rivière aux carrières était une montée fort raide, ce qui lui avait fait donner par le peuple le nom de Roquet de Saint-Cyr. (Dans le langage populaire le mot roquet désigne un mauvais chemin rocailleux qui monte.)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                "word": "roquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "346516f6-1dbc-4a2b-aff8-23e194edc3d2",
                        "entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                        "tags": [
                            "plural"
                        ],
                        "form": "roquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "641b167a-ab2a-3fd2-be49-9ffa24eae079",
                        "entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                        "glosses": [
                            "Race de chien obtenue par croisement du petit danois et du doguin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b4f80d-b3f3-47b6-8f3a-f653eb64e59a",
                                "sense_id": "641b167a-ab2a-3fd2-be49-9ffa24eae079",
                                "text": "Tous ces chiens sont des métis simples, et viennent du mélange de deux races pures ; mais il ya encore d'autres chiens qu'on pourrait appeler doubles métis, parce qu'ils viennent du mélange d'une race pure et d'une race déjà mêlée.\nLe roquet est un double métis qui vient du doguin et du petit danois."
                            }
                        ]
                    },
                    {
                        "sense_id": "508afcd1-7e3c-3eab-ba2d-ffd60141f5d5",
                        "entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                        "glosses": [
                            "Petit chien hargneux qui rauque."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a690e839-28b3-431d-beb7-9829e2fd0929",
                                "sense_id": "508afcd1-7e3c-3eab-ba2d-ffd60141f5d5",
                                "text": "Parmi les animaux domestiques appartenant au même groupe, citons […] les roquets qui gardent les douars et les troupeaux ou qui rôdent dans les rues et aux abords des villes, où ils se chargent de la voirie."
                            },
                            {
                                "example_id": "4adba834-6b70-4852-8c8b-5a291babe619",
                                "sense_id": "508afcd1-7e3c-3eab-ba2d-ffd60141f5d5",
                                "text": "Des chiens aboyèrent à l’entrée de la Creuse. On eût dit que tous les mâtins du village s’étaient donné rendez-vous, faisant sonner leur large coup de gueule, et, quand ils se taisaient, on entendait le grondement rageur des petits roquets, qui ne décoléraient pas."
                            },
                            {
                                "example_id": "b4d0fd2d-3755-4c76-ab10-260ffd1b5469",
                                "sense_id": "508afcd1-7e3c-3eab-ba2d-ffd60141f5d5",
                                "text": "Ah ! les voies de Dieu (on a bien raison de le dire) sont impénétrables et ses instruments inconscients viennent se jeter dans nos jambes comme des roquets dans un jeu de quilles."
                            },
                            {
                                "example_id": "a4bf9d7e-f696-478d-8b6d-a0cc6e09e415",
                                "sense_id": "508afcd1-7e3c-3eab-ba2d-ffd60141f5d5",
                                "text": "À l'époque du frai, il pousse spontanément un petit cri peu harmonieux, qui participe de l’aboiement du roquet et du pépiement du poussin."
                            },
                            {
                                "example_id": "4bffaf45-b884-4230-9407-d79e23150fc2",
                                "sense_id": "508afcd1-7e3c-3eab-ba2d-ffd60141f5d5",
                                "text": "Derrière certaines portes un roquet aboie avec acharnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "193b3dc9-146f-3e97-aa4e-6df8551d0ee8",
                        "entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                        "glosses": [
                            "Homme insultant, hargneux, mais qui est peu redoutable."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5152f546-fb49-44ff-84ac-e06f8b03f825",
                                "sense_id": "193b3dc9-146f-3e97-aa4e-6df8551d0ee8",
                                "text": "Depuis Œdipe, il [St-Hyacinthe] m'a toujours suivi comme un roquet qui aboie après un homme qui passe sans le regarder."
                            },
                            {
                                "example_id": "850893ab-ed08-491e-ada8-a3af5cd27b40",
                                "sense_id": "193b3dc9-146f-3e97-aa4e-6df8551d0ee8",
                                "text": "Critiques. Le plus sale roquet peut faire une blessure mortelle ; il suffit qu’il ait la rage."
                            },
                            {
                                "example_id": "1623329a-9414-49f1-b5e8-926f805f9c08",
                                "sense_id": "193b3dc9-146f-3e97-aa4e-6df8551d0ee8",
                                "text": "Soyez gentil de me laisser parler et de cesser d’intervenir incessamment, un peu comme le roquet n’est-ce pas […]"
                            },
                            {
                                "example_id": "56d66119-aa05-4c75-a393-3f71e906b133",
                                "sense_id": "193b3dc9-146f-3e97-aa4e-6df8551d0ee8",
                                "text": "Certains disent qu’il aurait dû résister à la meute. Ils ignorent peut-être à quel point avoir sur le dos une armée de petits roquets agressifs et malveillants, qui ne manquent jamais une occasion pour vous cracher au visage, peut être éreintant."
                            },
                            {
                                "example_id": "fe716215-0c9f-4a82-94b2-72b55ea4203a",
                                "sense_id": "193b3dc9-146f-3e97-aa4e-6df8551d0ee8",
                                "text": "Ce mec, c'est un roquet qui aboie dans le vide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f575edd-ade6-4b72-bcfa-299312c92fd7",
                        "source_entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                        "source_sense_description": "1. Race de chien",
                        "target_lang_word": "Spitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35051c85-736b-37fa-8926-f3a3278ab6eb",
                                        "entry_id": "77e47206-7cd4-36e0-a452-f7eabbfbbbac",
                                        "glosses": [
                                            "eine kleinwüchsige Hundeart, ehedem der typische Wachhund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba22f61-466d-4ee4-ae56-c4056bdaf654",
                                                "sense_id": "35051c85-736b-37fa-8926-f3a3278ab6eb",
                                                "text": "Ein Spitz kläfft aber auch bei jeder Gelegenheit."
                                            },
                                            {
                                                "example_id": "8f492280-15a2-41d7-b30c-331ca76c3838",
                                                "sense_id": "35051c85-736b-37fa-8926-f3a3278ab6eb",
                                                "text": "„Der Spitz bellte jetzt auch die Sekretärin an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1c6b9e6-0a32-39d2-bcca-427576d4a110",
                                        "entry_id": "77e47206-7cd4-36e0-a452-f7eabbfbbbac",
                                        "glosses": [
                                            "ein leichter Rausch (regional)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61bb5cc7-127f-45a9-96fc-1d74a0d42b57",
                                                "sense_id": "b1c6b9e6-0a32-39d2-bcca-427576d4a110",
                                                "text": "Sein Spitz machte ihn immer gesprächiger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d513fbc2-0fb3-3445-80ec-caed22512a26",
                                        "entry_id": "77e47206-7cd4-36e0-a452-f7eabbfbbbac",
                                        "glosses": [
                                            "Spitze"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6002d29a-5e40-4bd6-8d71-0f1b91b55be8",
                        "source_entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                        "source_sense_description": "2. Petit chien qui aboie",
                        "target_lang_word": "Kläffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kläffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6e3faf5-8e62-3c04-8841-c482dd54b383",
                                        "entry_id": "f8a1657e-b71f-3a68-9041-e2c55e247047",
                                        "glosses": [
                                            "Hund, der ständig bellt (kläfft)"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202250b7-f239-426b-ad2d-d5969d598d25",
                                                "sense_id": "f6e3faf5-8e62-3c04-8841-c482dd54b383",
                                                "text": "„Dieser kleine Kläffer hat ein so schräges Bellen, dass man wirklich meint, er ticke nicht richtig.“"
                                            },
                                            {
                                                "example_id": "24b0543f-f6c4-44de-b75d-2cd670f4f858",
                                                "sense_id": "f6e3faf5-8e62-3c04-8841-c482dd54b383",
                                                "text": "„Der Hund ignorierte würdig die Kläffer der Nachbarn, zog nicht an der Leine, war durch den Start eines hochfrisierten Motorrads nicht zu erschüttern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4c6cdd6-2a5f-30c2-8c57-0482ec1774fa",
                                        "entry_id": "f8a1657e-b71f-3a68-9041-e2c55e247047",
                                        "glosses": [
                                            "Person, die dauernd lauthals nörgelt, protestiert, schimpft"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "485d2cf6-97a1-48c7-a85e-ae313dd160ee",
                                                "sense_id": "e4c6cdd6-2a5f-30c2-8c57-0482ec1774fa",
                                                "text": "„Sie hatten sofort vor Schäuble salutiert, als ein paar kleine Kläffer aus den unteren Regionen sich dem Parteibefehl widersetzten.“"
                                            },
                                            {
                                                "example_id": "f661b589-a782-4205-ad0f-7d2ad45718b1",
                                                "sense_id": "e4c6cdd6-2a5f-30c2-8c57-0482ec1774fa",
                                                "text": "„Nein, er war kein neidischer Kläffer. Gewiß hat er einen schonungslosen Witz besessen, dessen Stachel bald die eine, bald die andre Menschenart spüren mußte. Aber er nahm sich selbst nicht aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64e0948d-4719-472c-86cd-7c101548ffd5",
                        "source_entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
                        "source_sense_description": "2. Petit chien qui aboie",
                        "target_lang_word": "cur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f456aaab-9e66-3b15-be61-2abe9e6a36c6",
                                        "entry_id": "853e333d-f80a-321a-9f19-ee0bfe8ceabd",
                                        "glosses": [
                                            "A contemptible or inferior dog."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1627a352-3ea8-40c0-861d-a327919022af",
                                                "sense_id": "f456aaab-9e66-3b15-be61-2abe9e6a36c6",
                                                "text": "A fals double tunge is more fiers and fell\nThen Cerberus the cur couching in the kenel of hel;\nWherof hereafter, I thinke for to write,"
                                            },
                                            {
                                                "example_id": "23a187af-6e9a-490f-a6a2-fe02a51104d2",
                                                "sense_id": "f456aaab-9e66-3b15-be61-2abe9e6a36c6",
                                                "text": "you have many enemies, that know not why they are so, but, like to village-curs, bark when their fellows do."
                                            },
                                            {
                                                "example_id": "871bec4f-daaa-4ac1-9984-31efbc7c915a",
                                                "sense_id": "f456aaab-9e66-3b15-be61-2abe9e6a36c6",
                                                "text": "A Churliſh Envious Curr vvas gotten into a Manger, and there lay Growling and Snarling to keep the Horſes from their Provender. The Dog Eat None himſelf, and yet rather Ventur'd the Starving his Own Carcaſe then he would ſuffer any thing elfe to be the Better for't."
                                            },
                                            {
                                                "example_id": "b219a2cc-84a5-467a-be4e-8fd9fbb24c14",
                                                "sense_id": "f456aaab-9e66-3b15-be61-2abe9e6a36c6",
                                                "text": "He threw the soapsuds skilfully over a wretched little yellow cur he had, then turning his face to the agent's house, he shouted from the distance, \"All the men gone last night!\""
                                            },
                                            {
                                                "example_id": "b54401a1-5bea-4853-810a-04865a800e92",
                                                "sense_id": "f456aaab-9e66-3b15-be61-2abe9e6a36c6",
                                                "text": "\"You have no more spirit than a mongrel cur. You lie down on the ground and ask people to trample on you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4696ee56-7c28-3337-83e1-c6cb811dc9f2",
                                        "entry_id": "853e333d-f80a-321a-9f19-ee0bfe8ceabd",
                                        "glosses": [
                                            "A detestable person."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9210cac8-9ee4-499e-bc7b-1b9419abb2dc",
                                                "sense_id": "4696ee56-7c28-3337-83e1-c6cb811dc9f2",
                                                "text": "This butcher's cur is venom-mouth'd, and I have not the power to muzzle him."
                                            },
                                            {
                                                "example_id": "ae1f8b5b-113f-4695-99f5-f084ed38a109",
                                                "sense_id": "4696ee56-7c28-3337-83e1-c6cb811dc9f2",
                                                "text": "\"Who 's a cur - now - hey?\""
                                            },
                                            {
                                                "example_id": "1ba05934-d98b-4f53-9fd4-00a5269ff6c4",
                                                "sense_id": "4696ee56-7c28-3337-83e1-c6cb811dc9f2",
                                                "text": "Clayton interrupted him. “Stop!” he cried. “Stop! What manner of cur are you that you traduce the character of a good woman whom we believe dead! God!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e3814bd-db84-30f5-80b9-76548bae868e",
                                        "entry_id": "853e333d-f80a-321a-9f19-ee0bfe8ceabd",
                                        "glosses": [
                                            "A sheepdog or watchdog."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fff97f7-d2fe-4645-8743-8f4214e33bd9",
                                                "sense_id": "2e3814bd-db84-30f5-80b9-76548bae868e",
                                                "text": "Then send our Curs to gather up the Sheep"
                                            },
                                            {
                                                "example_id": "552f6622-fea0-4394-9ac3-a71fe82a9b57",
                                                "sense_id": "2e3814bd-db84-30f5-80b9-76548bae868e",
                                                "text": "\"He's a good sharp cur,\" or \"a good cur,\" is said of any dog that barks at strangers and guards his master's property."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfbd77b2-ae33-4700-94e1-d3a90779207c",
                        "source_entry_id": "e69263ec-200e-321c-b564-efd3275f652b",
