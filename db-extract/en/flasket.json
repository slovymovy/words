                        "examples": [
                            {
                                "example_id": "b449db62-f858-4c53-8b37-85997c90294d",
                                "sense_id": "dc5fdc1d-03f7-33eb-9c62-4eccd1dc9830",
                                "text": "There, in a meadow by the rivers side, A flocke of Nymphes I chaunced to espy, 20 All lovely daughters of the flood thereby, With goodly greenish locks, all loose untyde, As each had bene a bryde; And each one had a little wicker basket, Made of fine twigs, entrayled* curiously, 25 In which they gathered flowers to fill their flasket**, And with fine fingers cropt full feateously@ The tender stalkes on hye."
                            }
                        ]
                    },
