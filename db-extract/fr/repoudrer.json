                "senses": [
                    {
                        "sense_id": "d9042c01-7dc9-37a5-837a-db64f1de4031",
                        "entry_id": "f3f39f06-70bd-3b6d-b4a9-f0d80013142e",
                        "glosses": [
                            "Poudrer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6ccd03-f82f-439a-89e1-a8397a1cc099",
                                "sense_id": "d9042c01-7dc9-37a5-837a-db64f1de4031",
                                "text": "J’essuyai mes larmes, repoudrai le bout de mon nez. En un mot, je ravalais ma façade lézardée. Je m'étudiai une dernière fois dans la glace. Personne n'aurait pu soupçonner mon tumulte intérieur."
                            },
                            {
                                "example_id": "39e7edf3-b63d-44e5-b9da-d4a35b0e5ee8",
                                "sense_id": "d9042c01-7dc9-37a5-837a-db64f1de4031",
                                "text": "L’annonce d’un incident technique fut faite, elle se reprit tout à coup, incompréhensiblement, sécha ses yeux, fut repoudrée et entra en scène."
                            }
                        ]
                    }
                ],
