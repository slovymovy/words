                "senses": [
                    {
                        "sense_id": "262d8a52-7193-3051-9aca-6e1d8ab60125",
                        "entry_id": "048d20f2-e2bb-3082-abe2-7c23b2792ff4",
                        "glosses": [
                            "Faire tomber une entrave physique, morale, intellectuelle ou psychologique."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "785d84be-21c3-40a8-9ac0-da98c2fbf7ea",
                                "sense_id": "262d8a52-7193-3051-9aca-6e1d8ab60125",
                                "text": "Ici aussi, pas de front plissé par l’effort intellectuel. Mais peut-être la ceinture défaite parce qu’on a trop mangé. La bedaine décarcanée, on peut laisser venir la musique: tango, fox-trot, black bottom…"
                            },
                            {
                                "example_id": "1c8de1e6-2b5e-45d8-8e3a-648dfe0f6600",
                                "sense_id": "262d8a52-7193-3051-9aca-6e1d8ab60125",
                                "text": "Les ondes des cloches de la cathédrale apportent l’Angelus du soir qui s’infiltre à travers les murs du couvent et dont une partie va longuement mourir tout près sur les flots « décarcanés »."
                            }
                        ]
                    }
