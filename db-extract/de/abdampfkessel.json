                "senses": [
                    {
                        "sense_id": "adb9ec07-d635-3ea8-8d22-245dc5c6dc38",
                        "entry_id": "765a272a-a842-3cbc-a5aa-0f4f55000fea",
                        "glosses": [
                            "Kessel, der verwendet wird, um den während eines Arbeitsprozesses entstehenden Dampf abzuleiten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "57655a65-c41d-45ca-972b-8e2c46696c72",
                                "sense_id": "adb9ec07-d635-3ea8-8d22-245dc5c6dc38",
                                "text": "„Der Topf kann auch auf den Dampfapparat oder in einen zu diesem gehörigen Abdampfkessel gesetzt werden, wenn er mit einem Dichtungsring von Messing versehen ist.“"
                            },
                            {
                                "example_id": "0b90d09d-a7bc-422b-b21f-cb6b19f5b347",
                                "sense_id": "adb9ec07-d635-3ea8-8d22-245dc5c6dc38",
                                "text": "„Die so vorgewärmten und präparirten Stoffe gelangen nun in den Abdampfkessel E, in welchem höchstens atmosphärischer Druck herrscht.“"
                            },
                            {
                                "example_id": "e0b1fc27-2ab8-4096-8e6c-2edbb0db8c26",
                                "sense_id": "adb9ec07-d635-3ea8-8d22-245dc5c6dc38",
                                "text": "„Der zurückbleibende helle und durchsichtige Zuckersaft kommt in den Abdampfkessel, in welchem er ins Kochen gebracht und etwa um ein Drittel eingedampft wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
