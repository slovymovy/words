{
    "word_family": [
        "barbershop",
        "barbering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6df7a3a3-ea20-30f7-9e09-afeed4ae2190",
                    "sense_definition": "A person whose profession is cutting the hair and beards of usually male customers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the <w>barber</w> to get a haircut before the interview.",
                            "target_lang_translations": {
                                "ru": "Он пошел к <w>парикмахеру</w>, чтобы подстричься перед собеседованием.",
                                "zh": "面试前，他去<w>理发师</w>那里剪了头发。"
                            }
                        },
                        {
                            "text": "The <w>barber</w> trimmed his beard very carefully with sharp scissors.",
                            "target_lang_translations": {
                                "ru": "<w>Парикмахер</w> очень аккуратно подровнял ему бороду острыми ножницами.",
                                "zh": "<w>理发师</w>用锋利的剪刀非常小心地修剪了他的胡须。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hairdresser",
                        "hairstylist",
                        "haircutter"
                    ],
                    "common_phrases": [
                        "at the barber",
                        "barber shop",
                        "go to the barber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чья профессия — стрижка волос и бороды, обычно у клиентов-мужчин.",
                        "zh": "从事为顾客（通常为男性）理发和修剪胡须职业的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парикмахер",
                                "target_lang_sense_clarification": "общее название профессии"
                            },
                            {
                                "target_lang_word": "барбер",
                                "target_lang_sense_clarification": "мужской мастер (современное)"
                            },
                            {
                                "target_lang_word": "брадобрей",
                                "target_lang_sense_clarification": "устаревшее или ироничное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理发师",
                                "target_lang_sense_clarification": "理发行业从业者"
                            },
                            {
                                "target_lang_word": "男士理发师",
                                "target_lang_sense_clarification": "专门从事男士理发的理发师"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4941c9e6-836c-31c3-8e39-3b709fa077fc",
                    "sense_definition": "A barber surgeon, a foot soldier specializing in treating battlefield injuries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, a <w>barber</w> would often perform minor surgeries.",
                            "target_lang_translations": {
                                "ru": "В Средние века <w>цирюльник</w> часто выполнял мелкие хирургические операции.",
                                "zh": "在中世纪，<w>理发外科医生</w>经常进行一些小手术。"
                            }
                        },
                        {
                            "text": "The wounded soldier was treated by a <w>barber</w> on the field.",
                            "target_lang_translations": {
                                "ru": "Раненого солдата на поле боя лечил <w>цирюльник</w>.",
                                "zh": "受伤的士兵在战场上由<w>理发外科医生</w>进行了救治。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context referring to barber surgeons"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цирюльник-хирург, солдат, специализирующийся на лечении боевых ранений.",
                        "zh": "历史上兼任外科手术的理发师，常在战场上处理伤口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цирюльник",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理发外科医生",
                                "target_lang_sense_clarification": "历史上的职业称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "153b1141-ca2a-3eea-ad52-8d2cbce888d3",
                    "sense_definition": "A storm accompanied by driving ice spicules formed from sea water, especially one occurring on the Gulf of St. Lawrence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishermen stayed ashore to avoid the dangerous <w>barber</w>.",
                            "target_lang_translations": {
                                "ru": "Рыбаки остались на берегу, чтобы избежать опасного <w>ледяного шторма</w>.",
                                "zh": "渔民们留在岸上以躲避危险的<w>冰风暴</w>。"
                            }
                        },
                        {
                            "text": "A fierce <w>barber</w> blew in from the gulf, covering the deck in ice.",
                            "target_lang_translations": {
                                "ru": "С залива налетел свирепый <w>ледяной ветер</w>, покрывший палубу льдом.",
                                "zh": "一场猛烈的<w>冰风暴</w>从海湾袭来，甲板上覆盖了一层冰。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Gulf of St. Lawrence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шторм, сопровождающийся ледяной крошкой из морской воды, особенно в заливе Святого Лаврентия.",
                        "zh": "一种伴随海面冰晶飞溅的强风暴，常见于圣劳伦斯湾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ледяной шторм",
                                "target_lang_sense_clarification": "шторм с ледяной крошкой из морской воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冰风暴",
                                "target_lang_sense_clarification": "伴有冰晶的强风"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d72df316-4f43-367f-b584-4daea95ccb62",
                    "sense_definition": "To cut the hair or beard of a person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He learned to <w>barber</w> his own hair to save money.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>стричь</w> свои волосы сам, чтобы сэкономить деньги.",
                                "zh": "为了省钱，他学会了自己<w>理发</w>。"
                            }
                        },
                        {
                            "text": "She has <w>barbered</w> professionally for over ten years.",
                            "target_lang_translations": {
                                "ru": "Она профессионально <w>занимается стрижками</w> уже более десяти лет.",
                                "zh": "她从事专业<w>理发</w>工作已经超过十年了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "barber a beard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стричь волосы или бороду человеку.",
                        "zh": "为某人修剪头发或胡须。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стричь",
                                "target_lang_sense_clarification": "волосы"
                            },
                            {
                                "target_lang_word": "брить",
                                "target_lang_sense_clarification": "бороду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理发",
                                "target_lang_sense_clarification": "修剪头发"
                            },
                            {
                                "target_lang_word": "修剪",
                                "target_lang_sense_clarification": "修剪胡须"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c695444c-73a9-3ad2-b4f4-98eae1d5a682",
                    "sense_definition": "To chatter or talk excessively.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop <w>barbering</w> and get back to your work.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань <w>болтать</w> и возвращайся к работе.",
                                "zh": "请停止<w>闲聊</w>，回到你的工作中去。"
                            }
                        },
                        {
                            "text": "They stood on the corner <w>barbering</w> about the game for hours.",
                            "target_lang_translations": {
                                "ru": "Они стояли на углу, часами <w>трепясь</w> об игре.",
                                "zh": "他们站在街角，就那场比赛<w>闲聊</w>了几个小时。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болтать или чрезмерно разговаривать.",
                        "zh": "喋喋不休或过度交谈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "трепаться",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲聊",
                                "target_lang_sense_clarification": "非正式的交谈"
                            },
                            {
                                "target_lang_word": "唠叨",
                                "target_lang_sense_clarification": "过度说话"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "90809b14-442e-37df-b758-943b4433c741",
                    "sense_definition": "A surname originating as an occupation for a barber.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Barber</w> is our new mathematics teacher at school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Барбер</w> — наш новый школьный учитель математики.",
                                "zh": "<w>巴伯</w>先生是我们学校新来的数学老师。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Barber</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил женщину по имени Сара <w>Барбер</w> на конференции.",
                                "zh": "我在会议上遇到了一位名叫莎拉·<w>巴伯</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия профессии цирюльника.",
                        "zh": "源自理发师职业的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Барбер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴伯",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "711d0205-7200-30f1-8d30-43a000656ed0",
                    "sense_definition": "A place name used for various locations in the United States and Curaçao.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small town of <w>Barber</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они посетили маленький городок <w>Барбер</w>.",
                                "zh": "在公路旅行期间，他们参观了<w>巴伯</w>小镇。"
                            }
                        },
                        {
                            "text": "He lives in a quiet neighbourhood called <w>Barber</w>.",
                            "target_lang_translations": {
                                "ru": "Он живет в тихом районе под названием <w>Барбер</w>.",
                                "zh": "他住在一个叫<w>巴伯</w>的安静社区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных населенных пунктов в США и на Кюрасао.",
                        "zh": "美国和库拉索岛等地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Барбер",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴伯",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}