        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6acd3371-0613-301e-a2e5-1ed784da6159",
                    "sense_definition": "To join or connect two or more things together.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_connect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter carefully <w>jointed</w> the boards to create a smooth floor.",
                            "target_lang_translations": {
                                "ru": "Плотник тщательно <w>подогнал</w> доски, чтобы создать ровный пол.",
                                "zh": "木匠仔细地将木板<w>接合</w>起来，铺成了平整的地板。"
                            }
                        },
                        {
                            "text": "They used a special adhesive to <w>joint</w> the pipes securely.",
                            "target_lang_translations": {
                                "ru": "Они использовали специальный клей, чтобы надежно <w>соединить</w> трубы.",
                                "zh": "他们用一种特殊的粘合剂将管子牢固地<w>连接</w>在一起。"
                            }
