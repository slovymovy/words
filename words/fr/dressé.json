                    "sense_id": "01299f08-c424-3262-96e5-dd1a006d6769",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>dresser</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur a <w>dressé</w> la table pour le dîner de ce soir.",
                            "target_lang_translations": {
                                "en": "The waiter has <w>set</w> the table for tonight's dinner.",
                                "ru": "Официант <w>накрыл</w> стол к сегодняшнему ужину.",
                                "de": "Der Kellner hat den Tisch für das Abendessen heute Abend <w>gedeckt</w>.",
                                "es": "El camarero ha <w>puesto</w> la mesa para la cena de esta noche.",
                                "zh": "服务员已经把今晚晚餐的餐桌<w>摆好</w>了。"
                            }
                        },
                        {
                            "text": "La police a <w>dressé</w> un procès-verbal après cet accident de la route.",
                            "target_lang_translations": {
                                "en": "The police <w>drew up</w> a report after that road accident.",
                                "ru": "Полиция <w>составила</w> протокол после этого дорожного происшествия.",
                                "de": "Die Polizei hat nach diesem Verkehrsunfall ein Protokoll <w>aufgenommen</w>.",
                                "es": "La policía <w>levantó</w> un acta después de ese accidente de tráfico.",
                                "zh": "这起交通事故发生后，警方<w>制作</w>了一份笔录。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "avoir dressé la table",
                        "avoir dressé un procès-verbal"
                    ],
                    "target_lang_definitions": {
