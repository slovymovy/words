                "senses": [
                    {
                        "sense_id": "e62787f6-ed72-35d7-8798-ce150b37d517",
                        "entry_id": "21b943fa-011e-397a-b4cb-a15a979ae775",
                        "glosses": [
                            "Infrequently."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e335ce09-223c-4226-a4d2-66b51305c29b",
                                "sense_id": "e62787f6-ed72-35d7-8798-ce150b37d517",
                                "text": "She not unfrequently stopped at the Parsonage, and had a few minutes' conversation with Charlotte, but was scarcely ever prevailed upon to get out."
                            },
                            {
                                "example_id": "9526af85-71f6-43e4-8dee-245bd58229bb",
                                "sense_id": "e62787f6-ed72-35d7-8798-ce150b37d517",
                                "text": "Near to the jail, and by consequence near to Smithfield also, and the Compter, and the bustle and noise of the city; and just on that particular part of Snow Hill where omnibus horses going eastward seriously think of falling down on purpose, and where horses in hackney cabriolets going westward not unfrequently fall by accident, is the coach-yard of the Saracen's Head Inn;"
                            },
                            {
                                "example_id": "dddd9624-b3f5-41ab-9f9c-a3b430b0538a",
                                "sense_id": "e62787f6-ed72-35d7-8798-ce150b37d517",
                                "text": "Hurry had all the prejudices and antipathies of a white hunter, who generally regards the Indian as a sort of natural competitor, and not unfrequently as a natural enemy."
                            },
                            {
                                "example_id": "771d9e08-b57f-4d53-8f06-dc664ce1c1e2",
                                "sense_id": "e62787f6-ed72-35d7-8798-ce150b37d517",
                                "text": "Kings and free states not unfrequently maintained a troupe of professional singers and dancers, ready to undertake at the shortest notice the performance of the most elaborate Ode."
                            }
                        ]
                    }
                ],
