                        "glosses": [
                            "kleine, verschließbare Öffnung im Deck eines Schiffes für das Ein- und Aussteigen/Be- und Entladen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95bc2ce-e635-4d9f-ae10-58e61b372e89",
                                "sense_id": "6346e6c6-5c20-3ab1-90f5-69288688a60e",
                                "text": "„Der Abstieg durch das Turmluk ist eng. Vor allem für Gäste, die übers Meer kommen, denn sie müssen sich in einem astronautenähnlichen Schutzanzug durch das Luk zwängen, bevor sie wie Wesen aus einer anderen Welt in die eingespielte »Bordfamilie« hineinplatzen.“"
                            },
                            {
                                "example_id": "9bd6c259-9b33-4954-9a08-80908004ce32",
                                "sense_id": "6346e6c6-5c20-3ab1-90f5-69288688a60e",
                                "text": "„Das Luk flog auf.“"
                            }
                        ],
