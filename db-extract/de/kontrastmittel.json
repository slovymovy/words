                "senses": [
                    {
                        "sense_id": "0632d294-8521-3396-b2ec-16d9b1864df1",
                        "entry_id": "abf8ea9f-b0fd-34ab-9540-98ebcec8c2e7",
                        "glosses": [
                            "Arzneimittel, das beim Röntgen, bei Magnetresonanztomografien und Sonografien eingesetzt wird, um bestimmte körperliche Strukturen und Funktionen sichtbar zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9ec098-4937-418a-9250-56e62434054e",
                                "sense_id": "0632d294-8521-3396-b2ec-16d9b1864df1",
                                "text": "„Sie spritzen der Patientin Kontrastmittel und beobachten im Röntgen, ob sich die Substanz durch die Füllung der linken Hinterhauptsarterie auch im benachbarten Venenabfluss verteilt, dem sogenannten Sinus sigmoideus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
