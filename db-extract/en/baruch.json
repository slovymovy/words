                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b506c4de-d690-49e4-9f6f-c30a9a1b1b0e",
                                                "sense_id": "eb849eb7-4c69-3188-92c3-f16819c6c2d4",
                                                "text": "Baruch urodził się w Polsce, ale teraz mieszka w Izraelu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
