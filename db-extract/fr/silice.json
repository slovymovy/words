                "senses": [
                    {
                        "sense_id": "05423bc3-8fdc-36a4-81f4-248e17c33a2f",
                        "entry_id": "3f769e14-f351-359a-abf7-7a7fbd7a7939",
                        "glosses": [
                            "Dioxyde de silicium, (SiO₂)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee39a5f-f36a-4328-8cde-eca82a0b31cc",
                                "sense_id": "05423bc3-8fdc-36a4-81f4-248e17c33a2f",
                                "text": "Le dérivé du silicium le plus important est la silice ou anhydride silicique, auquel correspondent l’acide silicique et les silicates."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd257959-8b1f-32aa-9cff-6a9857a4e346",
                        "entry_id": "3f769e14-f351-359a-abf7-7a7fbd7a7939",
                        "glosses": [
                            "Minéral dur et stable, présent, sous forme de quartz, dans les roches magmatiques acides, sous forme cristalline ou à l’état amorphe dans les roches volcaniques, ou en dépôt d’alluvion souvent éolien et qui parfois est utilisé dans la fabrication du verre, du cristal, de la faïence, de la porcelaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815f40a1-ddee-4824-b7d2-9af71af85aa7",
                                "sense_id": "cd257959-8b1f-32aa-9cff-6a9857a4e346",
                                "text": "Un anneau composé de soluble dans la pyridine pour 64 % en poids, de silice (sable, diatomées, foraminifères) pour 18 % et de sulfate de calcium pour 12 %, et datant de 3500 avant J.C. a été découvert à Ur en Irak du Sud."
                            },
                            {
                                "example_id": "64ade315-4b1a-4176-9fd7-45cf64087ca4",
                                "sense_id": "cd257959-8b1f-32aa-9cff-6a9857a4e346",
                                "text": "La France compte parmi les rares pays à disposer d’une silice appropriée aux besoins des industries utilisatrices pour lesquelles il n’existe pas de produit de substitution. La verrerie, la fonderie et l’industrie de haute technologie sont les principales industries consommatrice de silice."
                            }
                        ]
                    }
                ],
