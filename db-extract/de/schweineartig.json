                "senses": [
                    {
                        "sense_id": "b46d24e9-5880-364f-90ed-51f51ce52b26",
                        "entry_id": "36766d26-9578-3bef-891a-c55414fffb84",
                        "glosses": [
                            "wie ein Schwein aussehend, an ein Schwein erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc448b01-c459-4ea2-9a48-09f483a352b4",
                                "sense_id": "b46d24e9-5880-364f-90ed-51f51ce52b26",
                                "text": "„Die arme Sary hatte nur Zeit »Neeeeeiiiin!« zu rufen, ehe Wheeler sie mit seinen schweineartigen Armen umfing.“"
                            },
                            {
                                "example_id": "bef80a7c-9b62-4b8f-94a2-77bd8be216ad",
                                "sense_id": "b46d24e9-5880-364f-90ed-51f51ce52b26",
                                "text": "„Seine Boxershorts von Brooks Brothers waren in ihre Richtung ausgebeult und seine schweineartigen, haarigen Hüften bockten bereits in hilfloser Vorfreude.“"
                            }
