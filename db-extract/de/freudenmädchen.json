                "senses": [
                    {
                        "sense_id": "4e83d094-59a1-3b84-8010-f34641ac6f5f",
                        "entry_id": "21c536ac-cac1-3a2c-b02a-44811137b7ba",
                        "glosses": [
                            "Frau, die gegen Bezahlung sexuelle Dienstleistungen erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a75732-4853-4891-9e6f-b28914705b8f",
                                "sense_id": "4e83d094-59a1-3b84-8010-f34641ac6f5f",
                                "text": "„Als die deutsche Verwaltung in Libau in Kraft getreten war, hatte sie gleich zweihundert Freudenmädchen zwecks ärztlicher Untersuchung festsetzen lassen.“"
                            },
                            {
                                "example_id": "fa51cd78-c6d7-466e-a87e-2078a1f0fabb",
                                "sense_id": "4e83d094-59a1-3b84-8010-f34641ac6f5f",
                                "text": "„Auch Freudenmädchen, die der Armee gefolgt waren, verrichteten ihre Dienste in Zelten am Ufer des Flusses.“"
                            },
                            {
                                "example_id": "b90ff986-478b-44dd-96c4-aaaf9b467d54",
                                "sense_id": "4e83d094-59a1-3b84-8010-f34641ac6f5f",
                                "text": "„Warum also, fragte er, hätte solch ein älteres Freudenmädchen keinen Orden kriegen sollen?“"
                            },
                            {
                                "example_id": "3a9f55f5-73f8-4fa7-a364-9ec028e9b814",
                                "sense_id": "4e83d094-59a1-3b84-8010-f34641ac6f5f",
                                "text": "„Beim Dessert kamen drei oder vier weitere Offiziere und eine Viertelstunde später zwei unappetitliche Freudenmädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e337d77-575a-4896-af6d-f0091e2506a8",
                        "source_entry_id": "21c536ac-cac1-3a2c-b02a-44811137b7ba",
                        "source_sense_id": "4e83d094-59a1-3b84-8010-f34641ac6f5f",
                        "source_sense_description": "Frau, die gegen Bezahlung sexuelle Dienstleistungen erbringt",
                        "target_lang_word": "whore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e951e36-eccb-3c21-839e-4b3e9616fd1a",
                                        "entry_id": "18437ea8-943e-3a92-8c78-12a934dedfed",
                                        "glosses": [
                                            "Synonym of prostitute: a person (especially a woman) who offers sexual services for payment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e23caf-f114-418b-a088-22abe0011a4a",
                                                "sense_id": "2e951e36-eccb-3c21-839e-4b3e9616fd1a",
                                                "text": "The merciless Macdonald – worthy to be a rebel, for that the multiplying villainies of nature do swarm upon him – from the Western Isles of kerns and gallowglasses is supplied, and fortune on his damned quarrel smiling showed like a rebel's whore."
                                            },
                                            {
                                                "example_id": "85299ba4-0d88-4313-8245-c9c7cacd57ae",
                                                "sense_id": "2e951e36-eccb-3c21-839e-4b3e9616fd1a",
                                                "text": "I come looking for a job\nBut I get no offers\nJust a come-on from the whores on Seventh Avenue"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47df4909-e897-3f4c-bf3f-5d8675c57e8b",
                                        "entry_id": "18437ea8-943e-3a92-8c78-12a934dedfed",
                                        "glosses": [
                                            "A person who is sexually promiscuous; a slut."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0de6fe82-b2ac-48d1-a469-e651cc5dad41",
                                                "sense_id": "47df4909-e897-3f4c-bf3f-5d8675c57e8b",
                                                "text": "He cals her on a ſudden, all to naught; ſhe is a ſtrumpet, a light huswife, a bitch, an arrant whore."
                                            },
                                            {
                                                "example_id": "3061336c-884e-485a-ba32-8ece7fa6aa04",
                                                "sense_id": "47df4909-e897-3f4c-bf3f-5d8675c57e8b",
                                                "text": "So after he fucks the shit out of me, he tells me I'm lying about his whore not being Brad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d0fefc5-7369-3b91-94ce-07a6e9fe7c8d",
                                        "entry_id": "18437ea8-943e-3a92-8c78-12a934dedfed",
                                        "glosses": [
                                            "A person who is unscrupulous, especially one who compromises their principles for gain."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de4d890-bb72-41dd-a608-cf5716b74854",
                                                "sense_id": "1d0fefc5-7369-3b91-94ce-07a6e9fe7c8d",
                                                "text": "Dude: Since when did you become a political whore?\nPhil: I prefer the term political slut, thank you very much!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4feaf7f3-0ffa-3014-9aac-c128de9d4219",
                                        "entry_id": "18437ea8-943e-3a92-8c78-12a934dedfed",
                                        "glosses": [
                                            "A person who will violate behavioral standards to achieve something desired."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b66e52f-b3d1-49e7-aebe-df75e2043d4b",
                                                "sense_id": "4feaf7f3-0ffa-3014-9aac-c128de9d4219",
                                                "text": "Vidal is at once more detached and more preoccupied with his own view, celebrating an aristocracy of sensibility constantly thwarted and ignored by those mere whores after fame, the statesmen and politicians."
                                            },
                                            {
                                                "example_id": "a4be221b-769f-427d-b548-99ce0be3e363",
                                                "sense_id": "4feaf7f3-0ffa-3014-9aac-c128de9d4219",
                                                "text": "By that time, Tejeda had already been accused of beating his wife, abandoning his children, living in sin with another woman, being a whore for the insurance lobby, and accepting bribes."
                                            },
                                            {
                                                "example_id": "dd63b1b6-fd60-4c70-bc01-a82cf208f89d",
                                                "sense_id": "4feaf7f3-0ffa-3014-9aac-c128de9d4219",
                                                "text": "a shameless hack—such a whore for the money—that he wouldn't even lend his name to his creations."
                                            },
                                            {
                                                "example_id": "9909800c-b0c6-4604-8897-379ce9188494",
                                                "sense_id": "4feaf7f3-0ffa-3014-9aac-c128de9d4219",
                                                "text": "I don't want to be a media whore,\" says Babydol. \"I don't need to 'sell' my record — it will sell because it's good or won't if it's not"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66104e9-3ec2-37b8-8f7c-02872cd10c14",
                                        "entry_id": "18437ea8-943e-3a92-8c78-12a934dedfed",
                                        "glosses": [
                                            "A contemptible person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc7c16d-3b66-40ec-a9a6-861030bca84a",
                                                "sense_id": "f66104e9-3ec2-37b8-8f7c-02872cd10c14",
                                                "text": "\"Begone,\" Clare shouted. She could not bring herself to kill in cold blood. \"Begone, or I'll shoot.\"\n\"Idiot whore,\" he shouted back. \"You would not dare.\""
                                            },
                                            {
                                                "example_id": "90c89505-fdf8-4efa-9908-e5b43d81843f",
                                                "sense_id": "f66104e9-3ec2-37b8-8f7c-02872cd10c14",
                                                "text": "I don't need that Lamont Cranston to tell me. Every Irishman knows what evil lurks in the hearts of men. We've known since the time of that rotten ould whore, Elizabeth the Bloody First!"
                                            },
                                            {
                                                "example_id": "6ce6c68f-90eb-43cd-a646-b87f678bd76b",
                                                "sense_id": "f66104e9-3ec2-37b8-8f7c-02872cd10c14",
                                                "text": "Saxon curses rang in her ears. Dane, they yelled, Viking whore. We will have revenge on you."
                                            }
                                        ]
                                    }
                                ]
                            },
