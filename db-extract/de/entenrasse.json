                "senses": [
                    {
                        "sense_id": "ba4adb87-3fa8-38ba-9082-7511520f913d",
                        "entry_id": "a3d817dc-937c-39a1-a3c9-c091081955a3",
                        "glosses": [
                            "Rasse einer Ente"
                        ],
                        "tags": [
                            "Tierzucht"
                        ],
                        "examples": [
                            {
                                "example_id": "cba46c5a-4b4f-4741-b765-adfbb533194a",
                                "sense_id": "ba4adb87-3fa8-38ba-9082-7511520f913d",
                                "text": "„Darunter sind Hühner, Tauben, Gänse, Puten und viele Entenrassen.“"
                            },
                            {
                                "example_id": "1bdfd486-acdd-4f1e-92a4-33ebee836ae7",
                                "sense_id": "ba4adb87-3fa8-38ba-9082-7511520f913d",
                                "text": "„An Entenrassen waren die Zwergenten zu bewundern.“"
                            },
                            {
                                "example_id": "08a90baa-a740-431c-8d94-e652c3f24980",
                                "sense_id": "ba4adb87-3fa8-38ba-9082-7511520f913d",
                                "text": "„Ich habe mir für 500 Euro meine geliebte Entenrasse malen lassen.“"
                            },
                            {
                                "example_id": "5eed94e7-82db-416e-a179-5ebec184d7a1",
                                "sense_id": "ba4adb87-3fa8-38ba-9082-7511520f913d",
                                "text": "„Wie der Umweltbeauftragte der Gemeinde Heusweiler, Peter Paulus, im Gespräch mit der Saarbrücker Zeitung verriet, sollen noch seltene Gänse- und Entenrassen angeschafft werden, so dass neben den Geißen, Kaninchen und Hühnern fünf vom Aussterben bedrohte Tierarten vorhanden sind.“"
                            },
                            {
                                "example_id": "c1aabdf1-83b9-44ad-af67-c840472fddf7",
                                "sense_id": "ba4adb87-3fa8-38ba-9082-7511520f913d",
                                "text": "„Zu den angemeldeten, zum Teil seltenen Hausgeflügelrassen aus mehreren Ländern gehören Pommerngänse und verschiedene Entenrassen, etwa Zwergenten, Sachsenenten und Warzenenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
