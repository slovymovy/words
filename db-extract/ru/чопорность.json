                        "sense_id": "58f58e26-76b5-3384-a8e1-523845c1f09f",
                        "entry_id": "bbe4d416-f6be-3b6d-8444-046b6cf51d1f",
                        "glosses": [
                            "свойство по значению прилагательного чопорный; чрезмерная строгость в поведении, в соблюдении приличий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93fbf3de-9d67-4c12-861d-4bf76711f539",
                                "sense_id": "58f58e26-76b5-3384-a8e1-523845c1f09f",
                                "text": "Англичане всюду умеют внести свою чопорность, негибкие нравы и скуку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b079e5e1-a16e-4470-a499-b695b45d10c2",
                        "source_entry_id": "bbe4d416-f6be-3b6d-8444-046b6cf51d1f",
                        "source_sense_id": "58f58e26-76b5-3384-a8e1-523845c1f09f",
                        "target_lang_word": "stiffness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stiffness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50281dd0-23d4-36dc-89d5-cf6eff7f36ea",
                                        "entry_id": "60adce81-2277-33be-bd22-328c925b73a2",
                                        "glosses": [
                                            "Rigidity or a measure of rigidity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "488c1cd0-7097-3e86-a662-e22ec6e9dd9b",
                                        "entry_id": "60adce81-2277-33be-bd22-328c925b73a2",
                                        "glosses": [
                                            "Inflexibility or a measure of inflexibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38301975-bf8e-3fb6-aeaa-2f9c68fa4bc7",
                                        "entry_id": "60adce81-2277-33be-bd22-328c925b73a2",
                                        "glosses": [
                                            "Inelegance; a lack of relaxedness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0845742-f7ff-416c-be4a-90b0ca43195e",
                                                "sense_id": "38301975-bf8e-3fb6-aeaa-2f9c68fa4bc7",
                                                "text": "His stiffness hampered the conversation."
                                            },
                                            {
                                                "example_id": "6902afa3-2887-43b0-82ae-cc2e4576928e",
                                                "sense_id": "38301975-bf8e-3fb6-aeaa-2f9c68fa4bc7",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            },
                                            {
                                                "example_id": "4202b9f9-be35-4239-b7bc-a95d99722e80",
                                                "sense_id": "38301975-bf8e-3fb6-aeaa-2f9c68fa4bc7",
                                                "text": "After years when I met a friend inside the aircraft and could sense stiffness in the conversation, a whiff of mild slang was the ice breaker, followed by loads of campus nostalgia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caeb1292-62eb-310c-bfcd-8725b42dd9ae",
                                        "entry_id": "60adce81-2277-33be-bd22-328c925b73a2",
                                        "glosses": [
                                            "Muscular tension due to unaccustomed or excessive exercise or work; soreness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3a3aed-e87a-4edd-9fa6-7e0307086b8c",
                                                "sense_id": "caeb1292-62eb-310c-bfcd-8725b42dd9ae",
                                                "text": "Juvenile rheumatoid arthritis (JRA), often referred to by doctors today as juvenile idiopathic arthritis (JIA), is a type of arthritis that causes joint inflammation and stiffness for more than six weeks in a child aged 16 or younger. It affects approximately 50,000 children in the United States. Inflammation causes redness, swelling, warmth, and soreness in the joints, although many children with JRA do not complain of joint pain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
