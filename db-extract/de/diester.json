                "senses": [
                    {
                        "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                        "entry_id": "9af8b98a-746a-30ef-ad0e-d7e44355c86c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df032a7-6261-4d0b-aa75-3bbb37f0c6a6",
                                "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                                "text": "Frau Diester ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "646684ef-0c91-4a5b-9bb9-1839b54db00a",
                                "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                                "text": "Herr Diester wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d5670b6a-38b1-4dea-8a91-5f99cfc37727",
                                "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                                "text": "Die Diesters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d7e00e40-8294-44dc-87d5-f59d43435ada",
                                "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                                "text": "Der Diester trägt nie die Schals, die die Diester ihm strickt."
                            },
                            {
                                "example_id": "2f264f1d-b3b4-49c5-bbc7-e27f871ada4f",
                                "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Diester kommt, geht der Herr Diester.“"
                            },
                            {
                                "example_id": "870515b7-58b0-4552-891c-5e6bc024df61",
                                "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                                "text": "Diester kommt und geht."
                            },
                            {
                                "example_id": "44da505f-40d0-4def-89e4-14483351d1d0",
                                "sense_id": "cde140b3-4de4-36fa-b4a4-b539de857741",
                                "text": "Diesters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
