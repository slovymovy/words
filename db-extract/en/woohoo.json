                "senses": [
                    {
                        "sense_id": "8e2115b3-4197-3217-92cf-9e34db4178bf",
                        "entry_id": "2178c631-a0df-33da-86e2-c8414b86a454",
                        "glosses": [
                            "To engage in sexual intercourse, especially as referenced in The Sims video game series."
                        ],
                        "tags": [
                            "euphemistic",
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "61eb4c4b-4427-4ba5-a9bb-4ab8a2487d0b",
                                "sense_id": "8e2115b3-4197-3217-92cf-9e34db4178bf",
                                "text": "At some point I discovered real romance novels, the ones with all the euphemisms and graphic bits rather than WooHooing and ambiguously ruffling sheets, and moved on from the lurid stories of my sim families. My love for the series lives on though my interest in making my sims get it on has waned. Later installments have introduced public WooHooing, time travel sex, and the ability to seduce the Grim Reaper, […]"
                            },
                            {
                                "example_id": "24d3742b-2863-49f3-af04-840ff97e5bf8",
                                "sense_id": "8e2115b3-4197-3217-92cf-9e34db4178bf",
                                "text": "Ok, I have two female sims who are roommates and I made them WooHoo because why not. […] So then I assumed since my sim was already pregnant WooHoo'ing again would be fine, but then after this my second sim has started throwing up."
                            }
                        ]
                    }
