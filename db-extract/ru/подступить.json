                            {
                                "example_id": "6dd18ec5-78a2-445a-ab99-04e21e4ddeff",
                                "sense_id": "2d371013-b3b9-36c7-bc43-5dc9c49f5557",
                                "text": "Красная гвардия подступила к Новочеркасску и Ростову."
                            }
                        ]
                    },
                    {
                        "sense_id": "17dfeeca-7ef8-3074-9b53-905225a9c567",
                        "entry_id": "ef9a0ab8-cb6d-343b-939b-0f2e427bfba3",
                        "glosses": [
                            "перемещаясь, передвинуться вплотную к чему-либо или подняться до какого-либо уровня"
                        ],
                        "tags": [
                            "о воде, льдах и т.п."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c4a0092f-e700-316d-9cca-f7586fc80f5a",
                        "entry_id": "ef9a0ab8-cb6d-343b-939b-0f2e427bfba3",
                        "glosses": [
