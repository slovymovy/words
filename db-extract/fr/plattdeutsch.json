                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28c02d16-9e55-39d6-b9fc-b31268e5771f",
                        "entry_id": "4d5f8f23-043b-331a-a261-6e584b90184d",
                        "glosses": [
                            "Bas-allemand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8621a672-d70c-4f07-a420-cd5a421cfc9f",
                                "sense_id": "28c02d16-9e55-39d6-b9fc-b31268e5771f",
                                "text": "I —Chronique d'Ost-Frise, depuis l'an 1106 jusqu'à 1661, traduite de Jean-Fréd. Ravinga, […]. L'original est écrit en plattdeutsch, espèce de patois qui se rapproche du hollandais."
                            },
                            {
                                "example_id": "baff2b4c-a722-4c46-8387-d42822c57978",
                                "sense_id": "28c02d16-9e55-39d6-b9fc-b31268e5771f",
                                "text": "Plusieurs fois il avait provoqué notre admiration lorsque, pris de colère, il se mettait à injurier notre gardien dans une langue barbare, mélange de flamand et de «plattdeutsch», qui médusait ce dernier."
                            },
                            {
                                "example_id": "8cc364da-8108-47ca-baa2-11f70fcabe61",
                                "sense_id": "28c02d16-9e55-39d6-b9fc-b31268e5771f",
                                "text": "Faites donc un détour par La Crete, un village de mennonites, pour le plaisir de les entendre parler en plattdeutsch !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c64e45d3-b393-4642-af68-a80a1fb56961",
                        "source_entry_id": "4d5f8f23-043b-331a-a261-6e584b90184d",
                        "source_sense_id": "28c02d16-9e55-39d6-b9fc-b31268e5771f",
                        "target_lang_word": "Plattdeutsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plattdeutsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffd14eb-07db-33a0-80fc-a4de751bd3b3",
                                        "entry_id": "a52e6c79-bfee-3822-b2a9-be7ff711ea23",
                                        "glosses": [
                                            "eine westgermanische Sprache gesprochen südlich der Küsten der Nord- und Ostsee, sowie bei Exilanten in Amerika und Osteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3286a8e0-a77f-4c04-90c8-10ca31b49a57",
                                                "sense_id": "1ffd14eb-07db-33a0-80fc-a4de751bd3b3",
                                                "text": "Er spricht auch Plattdeutsch. Er versteht Platt. He snackt ok Platt. He versteit Platt."
                                            },
                                            {
                                                "example_id": "21e1d3d0-48c7-4279-8b8a-b14e13c3069f",
                                                "sense_id": "1ffd14eb-07db-33a0-80fc-a4de751bd3b3",
                                                "text": "„Hier wird mit dem Gebrauch des Plattdeutschen die Brücke geschlagen zu den Flamen…“"
                                            },
                                            {
                                                "example_id": "d88935b5-4da1-4e74-a66f-a1a5fccdeebc",
                                                "sense_id": "1ffd14eb-07db-33a0-80fc-a4de751bd3b3",
                                                "text": "„Aber sie waren auch immer in Eile und Müdigkeit geschrieben, vielleicht verdarb auch das seltsame Gemisch von Seemannssprache, Plattdeutsch und anderen Dialekten, das wir an Bord redeten, die Orthographie.“"
                                            },
                                            {
                                                "example_id": "9e2651f9-c23d-4d5f-90e8-065f1014606f",
                                                "sense_id": "1ffd14eb-07db-33a0-80fc-a4de751bd3b3",
                                                "text": "„Plattdeutsch erlebt mancherorts eine kleine Renaissance.“"
                                            },
                                            {
                                                "example_id": "93e6e6e8-bd25-4a41-b272-7b580e9e5c50",
                                                "sense_id": "1ffd14eb-07db-33a0-80fc-a4de751bd3b3",
                                                "text": "„Plattdeutsch sei eine eigenständige Sprache und kein Dialekt, sagte Opa.“"
                                            },
                                            {
                                                "example_id": "f7dbaec8-d680-4b66-a455-e1e4e1cb2b7e",
                                                "sense_id": "1ffd14eb-07db-33a0-80fc-a4de751bd3b3",
                                                "text": "„So wird der Gebrauch des Plattdeutschen auch nicht mehr negativ und sozial bewertet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
