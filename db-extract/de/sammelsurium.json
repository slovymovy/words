                "senses": [
                    {
                        "sense_id": "a9fb7b53-a70b-3f86-b7cf-2fa9a1a65341",
                        "entry_id": "ddaa2227-0868-3e1b-8285-07e2a6e26796",
                        "glosses": [
                            "ungeordnetes Durcheinander, unsystematische Sammlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8159e6c-8627-477e-9145-45e1ecf3eb57",
                                "sense_id": "a9fb7b53-a70b-3f86-b7cf-2fa9a1a65341",
                                "text": "In der Zigarrenkiste verbarg sich ein buntes Sammelsurium von alten Münzen, Orden und Medaillen."
                            },
                            {
                                "example_id": "086802c5-0db0-4a4c-b9b9-1901ebb4e569",
                                "sense_id": "a9fb7b53-a70b-3f86-b7cf-2fa9a1a65341",
                                "text": "„Im Grunde stellten »Rotwelsch«, »kochemer Loschen« oder »Plattenkohl«, wie man sie je nach Gegend nannte, ein Sammelsurium verschiedener Sprachen dar.“"
                            },
                            {
                                "example_id": "10bf1102-7555-4b49-98fc-f515038f00f5",
                                "sense_id": "a9fb7b53-a70b-3f86-b7cf-2fa9a1a65341",
                                "text": "„Ansonsten hätte ich ein ganzes Sammelsurium an Karten kaufen und kilometerweit mit mir herumschleppen müssen.“"
                            },
                            {
                                "example_id": "6dd43247-b8ab-46eb-8c53-f831cfc15bb5",
                                "sense_id": "a9fb7b53-a70b-3f86-b7cf-2fa9a1a65341",
                                "text": "„In der Schachtel war ein Sammelsurium von Papieren und allerlei Kleinkram aus dem Auto.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "948b553d-58e6-4aae-bf97-533d8f8b6eb8",
