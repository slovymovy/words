                    },
                    {
                        "translation_id": "5cecbf6a-4607-454f-930a-d43c8b0c8623",
                        "source_entry_id": "121992cf-151b-3a7b-a45b-77ed724fa28e",
                        "source_sense_id": "c1c7e956-5daa-3696-973a-9ce4b5288955",
                        "target_lang_word": "activement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbca29cb-eb7a-3e24-a836-98127cea26fd",
                                        "entry_id": "5d074037-2b47-3931-991c-62dd5def2e0a",
                                        "glosses": [
                                            "D’une manière active."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b53a8362-aca7-44f5-af90-b7a9f1816d53",
                                                "sense_id": "dbca29cb-eb7a-3e24-a836-98127cea26fd",
                                                "text": "Et qui m’empêcherait, je vous prie, Monsieur Peau-de-chat, de calligraphier, les doigts déjà m’en démangent ! une jolie relation de mon voyage, station par station, dans le goût de ces anciens itinéraires Japonais dont j’ai là des échantillons, de laisser ma mémoire activement et paresseusement débouliner le long d’un chemin peint en jaune à travers toute sorte de bosses vertes, comme on voit sur ces grands tableaux au sortir des gares qui offrent aux touristes le menu de toutes les curiosités du district ?"
                                            },
                                            {
                                                "example_id": "95d4bd4b-2452-4662-8a97-75b0e40f2800",
                                                "sense_id": "dbca29cb-eb7a-3e24-a836-98127cea26fd",
                                                "text": "Louis aimait la vie sociale et participait activement à la vie des sociétés locales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8619df-364f-3d0d-9af3-57359b14b4b4",
                                        "entry_id": "5d074037-2b47-3931-991c-62dd5def2e0a",
                                        "glosses": [
                                            "À la voix active, c’est-à-dire d'un verbe qui a un complément direct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c678c4-ac1e-43a1-aacb-6f5ac736d27d",
                                                "sense_id": "8f8619df-364f-3d0d-9af3-57359b14b4b4",
                                                "text": "Dans la célèbre phrase de Bossuet, « dormez votre sommeil », dormir est employé activement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d69d33b5-9002-49f1-a58f-164fc4f3ea7e",
                        "source_entry_id": "121992cf-151b-3a7b-a45b-77ed724fa28e",
                        "source_sense_id": "c1c7e956-5daa-3696-973a-9ce4b5288955",
                        "target_lang_word": "énergiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "énergiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                        "entry_id": "4fde6d43-fc4d-36b5-b098-c2ec1dbf1acf",
                                        "glosses": [
                                            "Avec énergie, force ; activement, avec entrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac1c2ae-76dc-49f2-bfa6-29ba85e49931",
                                                "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                                "text": "[…], d’Ablancourt supprimait énergiquement les lettres doubles et mettait i pour y à peu près partout."
                                            },
                                            {
                                                "example_id": "aa98abd7-6999-4c87-b679-6cac9c2a9343",
                                                "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                                "text": "Tétas, qui avait sans doute à se plaindre de procédés aussi violents, se rebellait non moins énergiquement entre les mains de Camus."
                                            },
                                            {
                                                "example_id": "c675bfcc-5f16-4de0-b564-b5e011c992cd",
                                                "sense_id": "f1d86a11-4964-3cc4-bd05-2a5032955c39",
                                                "text": "Sa taille grande, mais un peu forte, caractérisait énergiquement la jeunesse et le bonheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "699f51ce-da9f-3de5-b7b3-b8c33dbbc36c",
                                        "entry_id": "4fde6d43-fc4d-36b5-b098-c2ec1dbf1acf",
                                        "glosses": [
                                            "Avec véhémence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3503a6-3413-418b-bd8d-034ca9eb2023",
                                                "sense_id": "699f51ce-da9f-3de5-b7b3-b8c33dbbc36c",
                                                "text": "Le Courrier français, qui n'y allait pas par quatre chemins, demanda énergiquement que la circulation fût interdite sur le chemin de fer du Nord tant que la sécurité des voyageurs n'y serait pas assurée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
