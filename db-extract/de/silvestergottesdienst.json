                "senses": [
                    {
                        "sense_id": "2b8b4ffa-e74b-33dc-901e-347623aefc6f",
                        "entry_id": "28125e2e-7602-302f-a5fc-299b9d82bb08",
                        "glosses": [
                            "Gottesdienst zu Silvester"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a05044-7985-4ebc-b90a-f0b9e6a4a24a",
                                "sense_id": "2b8b4ffa-e74b-33dc-901e-347623aefc6f",
                                "text": "„Silvestergottesdienste am Nachmittag, am Abend oder in der Nacht geben Raum für die Thematisierung von Vergänglichkeit und Neuanfang, Wunsch, Dank und Bitte, häufig sind sie musikalisch oder meditativ gestaltet.“"
                            },
                            {
                                "example_id": "aa2a247a-841d-43ed-b9b2-3173f35c615c",
                                "sense_id": "2b8b4ffa-e74b-33dc-901e-347623aefc6f",
                                "text": "„Es war ja auch das allererste Mal, dass Katholiken, Protestanten und orthodoxe Christen ihren Silvestergottesdienst gemeinsam feierten.“"
                            },
                            {
                                "example_id": "b8000812-84cc-45ef-b554-2851fecafcda",
                                "sense_id": "2b8b4ffa-e74b-33dc-901e-347623aefc6f",
                                "text": "„Fast eintausend Menschen waren beim Silvestergottesdienst am Hartberger Hauptplatz dabei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
