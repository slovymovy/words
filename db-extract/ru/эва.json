                    {
                        "translation_id": "c8703ba9-d358-411c-9b1e-6b160925739f",
                        "source_entry_id": "4ca8b5cc-f174-3e1c-8cc5-da2dd8bdb5cc",
                        "source_sense_id": "93bab095-c2da-3448-b64d-d3cba53fb357",
                        "target_lang_word": "Ewa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ewa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f3486d80-9624-30c8-b0da-29641f9fa979",
                                        "entry_id": "759b38b7-a244-3b3a-a9ae-c4a840a79288",
                                        "glosses": [
                                            "biblijne imię pierwszej kobiety oraz protoplastki rodu ludzkiego"
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c52c86b-c611-4a82-97fe-2ee13f3cd287",
                                                "sense_id": "f3486d80-9624-30c8-b0da-29641f9fa979",
                                                "text": "Adam i Ewa umieszczeni przez Boga w raju, zostali z niego wypędzeni ponosząc karę za uległość szatanowi i nieposłuszeństwo Bogu (…), a także utracili nieśmiertelność"
                                            },
                                            {
                                                "example_id": "8276e8df-1474-4803-8afc-bd936ff30772",
                                                "sense_id": "f3486d80-9624-30c8-b0da-29641f9fa979",
                                                "text": "Synami Adama i Ewy byli Kain, Abel i Set"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "f418656d-ce2d-3240-a29f-4c20fd7794cc",
                                        "entry_id": "759b38b7-a244-3b3a-a9ae-c4a840a79288",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b41f822-ceef-4c5c-a057-1a506c5bbeaa",
                                                "sense_id": "f418656d-ce2d-3240-a29f-4c20fd7794cc",
                                                "text": "Chłopaki zaciągnęli go do kina, potem Pawełek zdobył bilety na recital Ewy Demarczyk, a potem był mecz hokejowy Polska – NRD, na który poszli całą gromadą i na przemian to wrzeszczeli, to dęli w trąbki, dopingując swojaków."
                                            },
                                            {
                                                "example_id": "3e500fdb-4539-4e04-bab3-b378675f06d3",
                                                "sense_id": "f418656d-ce2d-3240-a29f-4c20fd7794cc",
                                                "text": "Mam na imię Ewa i jestem nauczycielką z Warszawy."
                                            },
                                            {
                                                "example_id": "a772b10b-8282-49e3-ac74-94da9e2bc133",
                                                "sense_id": "f418656d-ce2d-3240-a29f-4c20fd7794cc",
                                                "text": "Na 24 grudnia przypadają imieniny Ewy i Adama."
                                            },
                                            {
                                                "example_id": "f0f855b9-0f2b-4298-b594-35dd8f1fdb43",
                                                "sense_id": "f418656d-ce2d-3240-a29f-4c20fd7794cc",
                                                "text": "Ewę, żonę mojego kolegi z podstawówki, poznałem dużo później."
                                            },
                                            {
                                                "example_id": "7656e7a2-1d7b-4b26-bf31-369ce51bddbd",
                                                "sense_id": "f418656d-ce2d-3240-a29f-4c20fd7794cc",
                                                "text": "Pani Ewo, proszę nas jutro odwiedzić z synem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "bd0b8f26-000d-3b8f-a5e6-a17abb26f24e",
                                        "entry_id": "759b38b7-a244-3b3a-a9ae-c4a840a79288",
                                        "glosses": [
                                            "każda kobieta"
                                        ],
                                        "tags": [
                                            "literary",
                                            "metaphoric"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ff395e9-2236-4299-bf11-6faf6cca3a28",
                        "source_entry_id": "4ca8b5cc-f174-3e1c-8cc5-da2dd8bdb5cc",
                        "source_sense_id": "93bab095-c2da-3448-b64d-d3cba53fb357",
                        "target_lang_word": "Ève",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ève",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c53bfbd-376c-35f9-a556-b66a3560be5f",
                                        "entry_id": "5ac3042b-b088-3ad6-9bb3-77cb91b09b0e",
                                        "glosses": [
                                            "Première femme qui vécut sur la Terre, selon la Bible."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d936f7d9-43eb-4c36-bbaf-1cc59afa59f4",
                                                "sense_id": "4c53bfbd-376c-35f9-a556-b66a3560be5f",
                                                "text": "Mais il était prêtre et avait le dégoût du ventre d’Ève."
                                            },
                                            {
                                                "example_id": "74963e3c-344a-4774-a8d7-90ed48710f73",
                                                "sense_id": "4c53bfbd-376c-35f9-a556-b66a3560be5f",
                                                "text": "Et déjà apparaissait, dans le péché originel, le double aspect, — sottise, orgueil, — de toute faute contre le bon sens : c’est en flattant l’orgueil d’Ève, en faisant appel à cet orgueil, que le serpent l’a déterminée à désobéir, et à goûter d’une pomme dont elle ne savait même pas si elle en aimerait le goût."
                                            },
                                            {
                                                "example_id": "f4a060f4-18bd-4ab9-87b3-dfd829982070",
                                                "sense_id": "4c53bfbd-376c-35f9-a556-b66a3560be5f",
                                                "text": "Elle est la mère du genre humain, la nouvelle Ève."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
