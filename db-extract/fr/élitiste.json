                                        "entry_id": "1fba808d-da45-32ed-8557-d08a2b3d7367",
                                        "glosses": [
                                            "Someone who believes in or is perceived as believing in rule by an elite group."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
