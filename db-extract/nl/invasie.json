                        "entry_id": "f33f1560-88ec-3d40-adbb-86d05858b559",
                        "glosses": [
                            "het binnendringen van een legermacht in een ander land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975927ce-bf64-45d3-b10b-d5d433dd11b1",
                                "sense_id": "458d874d-37d4-30a0-a9f6-25d4ab19c9b5",
                                "text": "De invasie van Normandië in 1944 was het begin van de Bevrijding."
                            },
                            {
                                "example_id": "4dd71d37-6596-4bc5-95ae-177d074d08f1",
                                "sense_id": "458d874d-37d4-30a0-a9f6-25d4ab19c9b5",
                                "text": "De documenten onthullen dat de regering van president Vladimir Poetin bij de start van de Russische invasie van Oekraïne in 2022 de opdracht had gegeven om kinderen uit weeshuizen mee te nemen naar Rusland. Dat moest gebeuren onder het mom van \"humanitaire evacuaties\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df10ed1b-76b9-4a1f-9302-484905f22f85",
                        "source_entry_id": "f33f1560-88ec-3d40-adbb-86d05858b559",
                        "source_sense_id": "458d874d-37d4-30a0-a9f6-25d4ab19c9b5",
