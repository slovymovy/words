                                "target_senses": [
                                    {
                                        "sense_id": "580f45de-eb8d-3139-bc2d-a899d6e69fb1",
                                        "entry_id": "d4665d24-a46e-37c9-a44b-7b4bd32d0f5b",
                                        "glosses": [
                                            "A fluid that dissolves a solid, liquid, or gaseous solute, resulting in a solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2bdf61-9efb-4e6d-8f4c-53950bf5cfd5",
                                                "sense_id": "580f45de-eb8d-3139-bc2d-a899d6e69fb1",
                                                "text": "Holonym: solution"
                                            },
                                            {
                                                "example_id": "508b92d4-a33a-4da9-87b2-0de4a9ed0b51",
                                                "sense_id": "580f45de-eb8d-3139-bc2d-a899d6e69fb1",
                                                "text": "Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, another solvent, which has the well-known property of causing this type of cancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5cb23e-6b7f-3786-8baf-5c585cac730f",
                                        "entry_id": "d4665d24-a46e-37c9-a44b-7b4bd32d0f5b",
                                        "glosses": [
                                            "That which resolves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13daf43-01fa-4e0f-b919-3b7cb6292dbc",
                                                "sense_id": "5d5cb23e-6b7f-3786-8baf-5c585cac730f",
                                                "text": "It explains. And explanation is the true solvent of mystery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "solvent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b064ec-64aa-38c0-95a2-a700f0a55d02",
                                        "entry_id": "dfc9e645-c39d-32c0-8b28-4bbecf2c9d2b",
                                        "glosses": [
                                            "Able to pay all debts as they become due, and having no more liabilities than assets."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d78c8ed7-d4bf-4c48-a975-9362dc123720",
                                                "sense_id": "f6b064ec-64aa-38c0-95a2-a700f0a55d02",
                                                "text": "Near-synonyms: above water, in the black"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df79e43-4e91-327e-ac98-54135bc6fb74",
                                        "entry_id": "dfc9e645-c39d-32c0-8b28-4bbecf2c9d2b",
                                        "glosses": [
                                            "Having the power of dissolving; causing solution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcfcc6aa-b40c-4ccf-b1ef-9eaeb2f3cd7c",
                                                "sense_id": "8df79e43-4e91-327e-ac98-54135bc6fb74",
                                                "text": "Surprisingly, this analysis revealed that acute exposure to solvent vapors at concentrations below those associated with long-term effects appears to increase the risk of a fatal automobile accident."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
