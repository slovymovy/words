        "fr-extract.jsonl": [
            {
                "entry_id": "6642db9b-1146-31bf-8f29-340d2718bdaa",
                "word": "plant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93590be5-24fc-4cc6-9a99-f16265f09ee7",
                        "entry_id": "6642db9b-1146-31bf-8f29-340d2718bdaa",
                        "tags": [
                            "plural"
                        ],
                        "form": "plants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccc37c08-7182-307f-8e52-6f61c20c81d9",
                        "entry_id": "6642db9b-1146-31bf-8f29-340d2718bdaa",
                        "glosses": [
                            "Jeune végétal destiné à être planté ou qui vient de l’être."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fcbd7f2-8175-4281-a613-2c21910fca61",
                                "sense_id": "ccc37c08-7182-307f-8e52-6f61c20c81d9",
                                "text": "Jeune plant, nouveau plant, vigne qui ne fait que commencer à produire, arbres fruitiers nouvellement planté."
                            },
                            {
                                "example_id": "85a0bc47-c15a-49b6-861d-6756b0da3496",
                                "sense_id": "ccc37c08-7182-307f-8e52-6f61c20c81d9",
                                "text": "Mais le mal est si avancé que, souvent, des dégringolades de cailloux emportent les jeunes plants."
                            },
                            {
                                "example_id": "b18efb45-ea9b-44c0-af53-3667e37c5c39",
                                "sense_id": "ccc37c08-7182-307f-8e52-6f61c20c81d9",
                                "text": "Une autre méthode consiste à tremper le plant préparé dans une solution d’hormone de bouturage, telle que l'Exubérone® qui contient 4 g/L d’acide β-indole acétique."
                            }
                        ]
                    },
                    {
                        "sense_id": "a668bdb7-a995-3dd0-8a2f-a97952729071",
                        "entry_id": "6642db9b-1146-31bf-8f29-340d2718bdaa",
                        "glosses": [
                            "Jeunes arbres ou jeunes plantes, en plantation, dans un même terrain."
                        ],
                        "tags": [
                            "broadly",
                            "collectively"
                        ],
                        "examples": [
                            {
                                "example_id": "ca4dc84b-758f-46d7-9c4d-e32721eab510",
                                "sense_id": "a668bdb7-a995-3dd0-8a2f-a97952729071",
                                "text": "Le desmédiphame peut causer un retard de croissance temporaire et/ou la chlorose ou la brûlure de la pointe des feuilles de la betterave à sucre lorsqu'on l'applique sur des plants soumis à un stress."
                            },
                            {
                                "example_id": "a5fe16ed-d9c0-4afc-9757-b171b3c8f432",
                                "sense_id": "a668bdb7-a995-3dd0-8a2f-a97952729071",
                                "text": "D’après une étude réalisée en Côte d’Ivoire, dans les lieux où les éléphants avaient disparu depuis longtemps on ne trouvait plus de plants de certaines espèces forestières qu’ils ont coutume de disséminer (Alexandre, 1978)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4afe43f1-69b0-4471-b625-e34e28a134ca",
                        "source_entry_id": "6642db9b-1146-31bf-8f29-340d2718bdaa",
                        "target_lang_word": "Setzling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Setzling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8f30c0-287a-369c-acc3-aa3efc249bc8",
                                        "entry_id": "eff4d2fc-ef37-3a42-b422-db89dc886fd3",
                                        "glosses": [
                                            "gezüchtete Jungpflanze, die zum Wachsen an einen anderen Ort verpflanzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127f071f-1e95-4346-8073-5f82f8fd8d41",
                                                "sense_id": "cb8f30c0-287a-369c-acc3-aa3efc249bc8",
                                                "text": "Ich habe in der Gärtnerei eine Menge Setzlinge gekauft und möchte sie noch heute in meinem Garten einpflanzen."
                                            },
                                            {
                                                "example_id": "1892fb26-7dba-4cd0-9b81-9f5641c83170",
                                                "sense_id": "cb8f30c0-287a-369c-acc3-aa3efc249bc8",
                                                "text": "„Wenn er zu früh pflanzte, riskierte er, die Setzlinge zu verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4385a543-f1d6-3af0-91e3-fca5c97d6e5c",
                                        "entry_id": "eff4d2fc-ef37-3a42-b422-db89dc886fd3",
                                        "glosses": [
                                            "Jungfisch, der zur Aufzucht in einen Teich gesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108d9446-5fda-4754-9720-a03b4956f256",
                                                "sense_id": "4385a543-f1d6-3af0-91e3-fca5c97d6e5c",
                                                "text": "Die Setzlinge gedeihen gut im neuen Teich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
