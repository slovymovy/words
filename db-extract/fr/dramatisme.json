                        "glosses": [
                            "État dramatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15b540c-0061-4c06-9ad8-5025be8d6c5e",
                                "sense_id": "534da170-decb-39ff-94fe-2fb183deccba",
                                "text": "La plupart du temps, son dramatisme s’épuise, au plan de l’acteur, entre une expression de soi sans médiation consistante et l’imitation d’un autre, déjà sous-typé dans l’écriture et encore détypisé par le jeu."
                            },
                            {
                                "example_id": "e0ed04f7-ced4-42c7-88e7-8a2c8ad977c3",
                                "sense_id": "534da170-decb-39ff-94fe-2fb183deccba",
                                "text": "Certes, Macbeth est d'un dramatisme plus saillant que celui de Parsifal, certes Warlikowski a droit à ses hauts et ses bas, certes nous pouvons nous tromper."
                            },
                            {
                                "example_id": "d44aeaf7-d59e-45ad-bb34-23bf14213dff",
                                "sense_id": "534da170-decb-39ff-94fe-2fb183deccba",
                                "text": "Il manque plusieurs couches de dramatisme à la chose, mais, en l’état, Fabien Gabel, qui ne peut inventer une ardeur que le spectacle ne véhicule pas, tient fort bien le plateau, avec des gestes clairs."
                            }
                        ]
                    }
