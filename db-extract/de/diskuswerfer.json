                "senses": [
                    {
                        "sense_id": "4b7de73e-f4d8-37c4-a9a6-16f5d179b9c0",
                        "entry_id": "8a7c7c49-ae41-3319-a013-19829c060f98",
                        "glosses": [
                            "Person, die das Diskuswerfen ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03411816-e500-4aef-908f-14bb62c7b262",
                                "sense_id": "4b7de73e-f4d8-37c4-a9a6-16f5d179b9c0",
                                "text": "Bei der Olympiade gelang den Diskuswerfern kein Sieg."
                            },
                            {
                                "example_id": "7a34f9d3-c8c9-4c26-9191-e7ed19827df5",
                                "sense_id": "4b7de73e-f4d8-37c4-a9a6-16f5d179b9c0",
                                "text": "„Die starke Serie von Diskuswerfer Lukas Weißhaidinger in dieser Saison ist ausgerechnet beim Diamond-League-Meeting in London gerissen, wo im August die Weltmeisterschaft in Szene geht.“"
                            },
                            {
                                "example_id": "5571ba0c-34b8-4950-8518-9e93b73551e7",
                                "sense_id": "4b7de73e-f4d8-37c4-a9a6-16f5d179b9c0",
                                "text": "„Der frühere chinesische Diskuswerfer starb am Sonntag, wie die amtliche Nachrichtenagentur Xinhua meldete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
