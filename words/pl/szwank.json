                    "semantic_group_id": "szkoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo groźnego wypadku żaden z pasażerów nie poniósł poważnego <w>szwanku</w> na zdrowiu.",
                            "target_lang_translations": {
                                "ru": "Несмотря на опасную аварию, никто из пассажиров не понёс серьёзного <w>ущерба</w> для здоровья."
                            }
                        },
                        {
                            "text": "Reputacja firmy ucierpiała i wystawiona została na ciężki <w>szwank</w> po ostatnim skandalu.",
                            "target_lang_translations": {
                                "ru": "Репутация компании пострадала и подверглась тяжёлому <w>урону</w> после недавнего скандала."
                            }
                        }
                    ],
                    "synonyms": [
