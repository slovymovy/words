                {
                    "sense_id": "293cdb58-d41d-30c4-b26e-124d5920a3c0",
                    "sense_definition": "Opération par laquelle une banque prête une somme d'argent à rembourser avec des intérêts, ou délai accordé pour payer un achat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons obtenu un <w>crédit</w> pour acheter notre maison en banlieue."
                        },
                        {
                            "text": "Elle a payé son nouvel ordinateur avec sa carte de <w>crédit</w>."
                        }
                    ],
                    "synonyms": [
                        "prêt"
                    ],
                    "common_phrases": [
                        "carte de crédit",
                        "crédit immobilier",
                        "acheter à crédit"
                    ]
                },
                {
                    "sense_id": "eeb4e0dd-641e-3508-9602-1c856871d1da",
                    "sense_definition": "Unité de valeur accordée pour la réussite d'un cours ou d'un module dans l'enseignement supérieur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il doit valider soixante <w>crédits</w> pour réussir son année universitaire."
                        },
                        {
                            "text": "Chaque cours magistral rapporte un certain nombre de <w>crédits</w> à l'étudiant."
                        }
                    ],
                    "common_phrases": [
                        "crédits universitaires",
                        "valider ses crédits"
                    ]
                },
                {
                    "sense_id": "65ecaf9f-47b3-34c5-b920-ef36ca08b521",
                    "sense_definition": "Confiance, foi ou considération que l'on accorde aux paroles ou aux actions de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas accorder trop de <w>crédit</w> à ces rumeurs sans fondement."
                        },
                        {
                            "text": "Ses succès professionnels lui confèrent un grand <w>crédit</w> auprès de la direction."
