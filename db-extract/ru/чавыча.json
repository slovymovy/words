                "senses": [
                    {
                        "sense_id": "3277c7c3-d299-3d18-86c7-9a342939ebe4",
                        "entry_id": "e94ad237-5eba-308d-9e93-05a9928c6cbd",
                        "glosses": [
                            "зоол., ихтиол. ценная промысловая рыба семейства лососёвых (лат. Oncorhynchus tshawytscha)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c81bc2-b4d4-4cb9-bf5d-047fb82f88ea",
                                "sense_id": "3277c7c3-d299-3d18-86c7-9a342939ebe4",
                                "text": "Чавыча есть самая вкусная и нежная рыба."
                            },
                            {
                                "example_id": "edaa7a93-4cac-4a0a-bd7f-8f3129793a18",
                                "sense_id": "3277c7c3-d299-3d18-86c7-9a342939ebe4",
                                "text": ".. чавыча — огромный, драгоценный лосось."
                            },
                            {
                                "example_id": "69ea6d17-6ca2-4909-85c2-3e6a475eb0e2",
                                "sense_id": "3277c7c3-d299-3d18-86c7-9a342939ebe4",
                                "text": "Я не назвал красную рыбу и её родичей — кету, горбушу и чавычу, но лососи — особый разговор…"
                            },
                            {
                                "example_id": "94161c2d-7c99-4b67-a4de-7f7b1d210278",
                                "sense_id": "3277c7c3-d299-3d18-86c7-9a342939ebe4",
                                "text": "Чавыча нерестится в реках северной части Тихого океана от Анадыря до Амура, на острове Хоккайдо и в Калифорнии."
                            }
