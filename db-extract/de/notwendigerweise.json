        "fr-extract.jsonl": [],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "687ff0d0-e7e1-3e53-9b2c-bfce0a33aca9",
                "word": "notwendigerweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a23b060-410a-3881-be05-b7111058602f",
                        "entry_id": "687ff0d0-e7e1-3e53-9b2c-bfce0a33aca9",
                        "glosses": [
                            "auf eine Art und Weise, die notwendig ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "32116124-171a-4283-bd44-51aee19abd19",
                                "sense_id": "9a23b060-410a-3881-be05-b7111058602f",
                                "text": "„Die Geschichte des globalen Gehirns ist nicht nur eine Geschichte von Erfolgen und Innovationen, sondern auch des damit notwendigerweise verbundenen \"Bösen\".“"
                            },
                            {
                                "example_id": "aea55ca0-2e6d-4cca-89ba-a2aa534b2ae8",
                                "sense_id": "9a23b060-410a-3881-be05-b7111058602f",
                                "text": "„Therapeutische Kommunikationen gehen also notwendigerweise über solche Ratschläge hinaus, die gewöhnlich, aber zweckloserweise die Betroffenen sich selbst geben beziehungsweise die ihnen von ihren Verwandten und Freunden gegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d8619bb-8e39-4845-b011-dfe71fb7bead",
                        "source_entry_id": "687ff0d0-e7e1-3e53-9b2c-bfce0a33aca9",
                        "source_sense_id": "9a23b060-410a-3881-be05-b7111058602f",
                        "source_sense_description": "umgangssprachlich: auf eine Art und Weise, die notwendig ist",
                        "target_lang_word": "certainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "certainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "In a way which is certain; with certainty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d57d5d-7e5a-4160-9e91-43ef23e26163",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "he verily thought he had young live frogs in his belly, qui vivebant ex alimento suo, that lived by his nourishment, and was so certainly persuaded of it, that for many years following he could not be rectified in his conceit."
                                            },
                                            {
                                                "example_id": "acad7d4d-3217-4638-bf27-04d0a5664d95",
                                                "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                                                "text": "The torque was \"built up\" in the special back axle and the car crawled tankwise but very certainly over the obstacles without a jar or hesitation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "Without doubt, surely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f5edfd-a190-46a3-b3d7-c40fc07f1c6f",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "The accident was certainly caused by human error."
                                            },
                                            {
                                                "example_id": "c6e95e92-978c-49ae-9844-6e3da1e1bab4",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "That was certainly sweet of him."
                                            },
                                            {
                                                "example_id": "72e8830c-37fa-428a-a001-0713feed9d07",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "'I'm all grown up now' -'You certainly have (grown)!'"
                                            },
                                            {
                                                "example_id": "d45ba451-4f5d-428c-9d74-ab88e2d6ec73",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "b27e5847-2b91-4193-81d0-5d87b301fe6d",
                                                "sense_id": "5928ab1b-4002-3748-9d16-8d547881cec6",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, but could not prove, and would cite as they took to the streets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                        "entry_id": "196239da-e64e-3311-8d50-44239eeeeb8b",
                                        "glosses": [
                                            "An emphatic affirmative answer; of course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f25142-62b5-44da-806f-561c4542c5e9",
                                                "sense_id": "f9f4d4b6-dfbd-3cbb-a253-4da5f82e3b2c",
                                                "text": "Would you like it with ice?  Certainly, and with lemon please."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eeafdef-86e4-452d-94ca-f7cdbf38afec",
                        "source_entry_id": "687ff0d0-e7e1-3e53-9b2c-bfce0a33aca9",
                        "source_sense_id": "9a23b060-410a-3881-be05-b7111058602f",
                        "source_sense_description": "umgangssprachlich: auf eine Art und Weise, die notwendig ist",
                        "target_lang_word": "inevitably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inevitably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "In a manner that is impossible to avoid or prevent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08800aaa-6923-483d-aa77-7be4292fad13",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Inevitably, all creatures eventually die."
                                            },
                                            {
                                                "example_id": "5827a595-83c6-484b-9bc4-c0a5881c1a61",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The sun inevitably rises."
                                            },
                                            {
                                                "example_id": "06bf50fd-b154-4936-9eb2-e3fe5abba149",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Despite the town's best efforts, the dam inevitably gave way."
                                            },
                                            {
                                                "example_id": "db8f225d-9ab6-4e49-ba19-07d68df88c12",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The inevitably cold winter approaches."
                                            },
                                            {
                                                "example_id": "409248be-d951-46c3-b7e3-0eca0be61dc0",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "In a period of transition from steam to diesel, many of the schemes are inevitably of an interim nature and only on full dieselisation will the final pattern be determined and full benefit derived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "As usual; predictably; as expected."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94f48e5-d72a-4b55-8a4f-83af29ec993e",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Inevitably, the next-door neighbour began to mow his lawn just as she lays down her head after a long night shift."
                                            },
                                            {
                                                "example_id": "0ee46b52-0abd-4d75-a09e-3a3829bb3924",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The child inevitably began to cry when his mother went to work."
                                            },
                                            {
                                                "example_id": "28c305d3-4fc2-4be3-b7f6-117a34258d46",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The inevitably long line of customers queued for the latest 'Harry Potter'."
                                            },
                                            {
                                                "example_id": "4930ca80-51b7-41c5-8c1a-f41c6cec8d05",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Far from it: direct military intervention by a Western state – even if Prime Minister Nuri al-Maliki is requesting it – would dramatically worsen the situation, and ISIS, contrary to what pro-interventionists might say, would inevitably come out on top."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7167816a-2cff-40af-b8d4-21e0dd97681c",
                        "source_entry_id": "687ff0d0-e7e1-3e53-9b2c-bfce0a33aca9",
                        "source_sense_id": "9a23b060-410a-3881-be05-b7111058602f",
                        "source_sense_description": "umgangssprachlich: auf eine Art und Weise, die notwendig ist",
                        "target_lang_word": "necessarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necessarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                        "entry_id": "a235f6aa-322a-3eb3-9b85-6bedeefe0837",
                                        "glosses": [
                                            "Inevitably; of necessity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc75b67-f1d2-4283-b953-7fb4a0795006",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "It is not necessarily true that children get their morals from their parents."
                                            },
                                            {
                                                "example_id": "cdce5b1d-007b-40d1-b345-97f2940540ab",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "But clever cities will not necessarily be better ones."
                                            },
                                            {
                                                "example_id": "05607629-a489-405f-a83c-d7200b806f09",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "Oregon’s uptick in marijuana sales along the Idaho border doesn’t necessarily mean that it’s all Idahoans who are lighting up, Lehner said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
