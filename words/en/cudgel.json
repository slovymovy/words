                        "wooden cudgel"
                    ]
                },
                {
                    "sense_id": "5abfebb6-87b8-3dbf-a461-ae6039f2f6ab",
                    "sense_definition": "Something used as a coercive tool, weapon, or threat to force someone into compliance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposition party used the scandal as a political <w>cudgel</w> against the mayor."
                        },
                        {
                            "text": "Economic sanctions were wielded as a <w>cudgel</w> to compel the government to negotiate."
                        }
                    ],
                    "synonyms": [
                        "bludgeon",
                        "lever",
                        "weapon"
                    ],
                    "common_phrases": [
                        "political cudgel",
                        "use as a cudgel",
                        "take up the cudgels"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79f3a720-59e1-3f3f-989d-24fdbf27c634",
                    "sense_definition": "To beat or strike someone with a short heavy club.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon_club",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The highwaymen managed to <w>cudgel</w> the traveler until he surrendered his money."
                        },
                        {
                            "text": "The angry crowd attempted to <w>cudgel</w> the intruder out of the village."
                        }
                    ],
                    "synonyms": [
                        "beat",
                        "bludgeon",
                        "club"
                    ]
                },
                {
                    "sense_id": "8e82a611-d3d1-37cd-8033-b22cb3882ae8",
                    "sense_definition": "To think intensely or struggle to recall something; to rack one's brain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rack_brain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began <w>cudgeling</w> his brains trying to remember where he had hidden the key."
                        },
                        {
                            "text": "I had to <w>cudgel</w> my memory for hours before the name finally came to me."
                        }
                    ],
                    "synonyms": [
                        "rack"
                    ],
                    "common_phrases": [
                        "cudgel one's brains",
                        "cudgel one's wits"
                    ]
                }
            ]
        }
    ]
