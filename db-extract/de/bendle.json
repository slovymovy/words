                "senses": [
                    {
                        "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                        "entry_id": "1305c403-026c-31ed-a3c0-2a83974c92bb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31fa023f-db99-4646-b755-4fdc5cd76dfb",
                                "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                                "text": "Frau Bendle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3e0de6e7-cdc4-414a-89d0-d468c2c1e3df",
                                "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                                "text": "Herr Bendle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0587f271-b8e9-4106-bab7-37335f288691",
                                "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                                "text": "Die Bendles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "64e540ca-21e3-4ba3-aab6-76d20c9e073b",
                                "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                                "text": "Der Bendle trägt nie die Schals, die die Bendle ihm strickt."
                            },
                            {
                                "example_id": "893e07cb-0221-4824-a95c-4f465f391e22",
                                "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bendle kommt, geht der Herr Bendle.“"
                            },
                            {
                                "example_id": "d6a5a30c-9278-424b-8aa7-6af1b4a8400c",
                                "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                                "text": "Bendle kommt und geht."
                            },
                            {
                                "example_id": "eec6beaa-b4a7-4128-8499-fd290426b019",
                                "sense_id": "3c4f09aa-0b3a-3daf-99f4-ddf9ebd68278",
                                "text": "Bendles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
