                "senses": [
                    {
                        "sense_id": "8f295e25-9ad1-31ad-80ad-980a1b09cddf",
                        "entry_id": "1bab1d4d-0288-342f-a140-a25fa76b9c62",
                        "glosses": [
                            "Enlever son caractère solutréen à."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "78a3d55f-b97b-41c3-baf5-10031b5019fd",
                                "sense_id": "8f295e25-9ad1-31ad-80ad-980a1b09cddf",
                                "text": "La figure 5 présente une esquisse typologique des faciès lithiques \"désolutréanisés\" du Solutréen de Laugerie-Haute."
                            },
                            {
                                "example_id": "265873d3-f880-4634-8422-77824524ace4",
                                "sense_id": "8f295e25-9ad1-31ad-80ad-980a1b09cddf",
                                "text": "Le typologiste, s’il veut comparer cette industrie avec celles qui ne possèdent pas cette particularité, est obligé de « délamelliser » le Magdalénien ou « désolutréaniser » le Solutréen comme le fait P. E. L. Smith pour l’industrie de la grotte du Placard trop riche en fossiles directeurs solutréens (Smith, 1966)."
                            }
                        ]
                    }
