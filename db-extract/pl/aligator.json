                ],
                "senses": [
                    {
                        "sense_id": "1e99d180-66ec-346c-97c7-abd2c4566147",
                        "entry_id": "9c40c4da-315f-393c-a48e-afca9f8f0058",
                        "glosses": [
                            "wodny, drapieżny gad z rodziny Alligatoridae, o szerokim pysku, mylony często z krokodylem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768d89d5-08b1-4b88-a06f-d73d345ce108",
                                "sense_id": "1e99d180-66ec-346c-97c7-abd2c4566147",
                                "text": "Z bezpiecznej odległości, z łódki obserwowaliśmy ogromnego aligatora wpełzającego do rzeki."
                            },
                            {
                                "example_id": "05bd9005-49b1-46e1-ac4a-6183eb4bbda7",
                                "sense_id": "1e99d180-66ec-346c-97c7-abd2c4566147",
                                "text": "W nikczemnym jego sklepiku żółw wisiał, wypchany aligator obok szczątków dziwnego kształtu ryb; na jego półkach leżała tu i ówdzie zbieranina próżnych flasz, słojów, zielonych czerepów, pęcherzów, stęchłych nasion; resztki sznurków i zapleśniałe kawałki lukrecji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "82dc13e0-0e1e-3ae8-8a90-efc24a229ce3",
                        "entry_id": "9c40c4da-315f-393c-a48e-afca9f8f0058",
                        "glosses": [
                            "bardzo wymagający nauczyciel"
                        ],
                        "tags": [
                            "uczn."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68ed2f0e-af41-4fb1-9f3d-ec5a2f01594b",
                        "source_entry_id": "9c40c4da-315f-393c-a48e-afca9f8f0058",
                        "source_sense_id": "1e99d180-66ec-346c-97c7-abd2c4566147",
                        "target_lang_word": "alligator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alligator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff63e2cf-317d-3cff-96f3-f414327cd824",
                                        "entry_id": "c26529b0-dce6-3319-8af5-ee6c38c3e1ce",
                                        "glosses": [
                                            "Either of two species of large amphibious reptile, Alligator mississippiensis or Alligator sinensis, in the genus Alligator within order Crocodilia, which have sharp teeth and very strong jaws and are native to the Americas and China, respectively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa2b4dfc-925f-481a-9e3c-4d1fa2bbdf7d",
                                                "sense_id": "ff63e2cf-317d-3cff-96f3-f414327cd824",
                                                "text": "All you could see of the alligator were two eyes above the water, then suddenly it snatched up and caught the poor bird with strong jaws full of sharp teeth."
                                            },
                                            {
                                                "example_id": "a3e7ea41-d942-409c-8601-ca3b93cf087a",
                                                "sense_id": "ff63e2cf-317d-3cff-96f3-f414327cd824",
                                                "text": "Alligators and crocodiles look extremely alike.\nThe main distinguishing feature is the teeth. In a crocodile the teeth in its upper and lower jaws are in line, but in an alligator, when its mouth is shut, the upper teeth lie outside the lower ones."
                                            },
                                            {
                                                "example_id": "0c8a63aa-c859-4557-8949-0ca919427d4d",
                                                "sense_id": "ff63e2cf-317d-3cff-96f3-f414327cd824",
                                                "text": "In 1967, the federal government declared alligators to be an Endangered Species and prohibited gator hunting and the sale of hides. The alligator responded and by the mid-1970s, the reptile numbers soared to an estimated half-million."
                                            },
                                            {
                                                "example_id": "3291c15d-e60c-4ed4-8b40-4bc2282d49e5",
                                                "sense_id": "ff63e2cf-317d-3cff-96f3-f414327cd824",
                                                "text": "They ran to the village screaming at the top of their lungs that an alligator was coming after them. Several of the men in Alimacani retrieved from a storehouse the tool they used to catch alligators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92e3889-2b19-319c-977d-8f9988ba9cae",
                                        "entry_id": "c26529b0-dce6-3319-8af5-ee6c38c3e1ce",
                                        "glosses": [
                                            "A member of the family Alligatoridae, which includes the caimans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac84ea5c-fac1-310e-9bc6-4e5f21c8a12d",
                                        "entry_id": "c26529b0-dce6-3319-8af5-ee6c38c3e1ce",
                                        "glosses": [
                                            "A dwarf crocodile (Osteolaemus tetraspis)"
                                        ],
                                        "tags": [
                                            "Nigeria"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "908adefa-aad0-39ef-9be6-2f7831960392",
                                        "entry_id": "c26529b0-dce6-3319-8af5-ee6c38c3e1ce",
                                        "glosses": [
                                            "A crocodile of any species."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ffe5bdc-6070-4268-b43d-d96d8cf43969",
                                                "sense_id": "908adefa-aad0-39ef-9be6-2f7831960392",
                                                "text": "Alligators were very numerous, in fact the harbour was infested by them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8747b4fa-147b-38f4-9f57-a198ff407b49",
                                        "entry_id": "c26529b0-dce6-3319-8af5-ee6c38c3e1ce",
                                        "glosses": [
                                            "Any of various machines with strong jaws, one of which opens like the movable jaw of an alligator.",
                                            "A form of squeezer for the puddle ball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b890defd-14d4-3290-b359-09bf4cdcffd0",
                                        "entry_id": "c26529b0-dce6-3319-8af5-ee6c38c3e1ce",
                                        "glosses": [
                                            "Any of various machines with strong jaws, one of which opens like the movable jaw of an alligator.",
                                            "A rock breaker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "492e07e9-0d5f-3fb8-bf29-aa6f9e55e309",
                                        "entry_id": "c26529b0-dce6-3319-8af5-ee6c38c3e1ce",
                                        "glosses": [
                                            "Any of various machines with strong jaws, one of which opens like the movable jaw of an alligator.",
                                            "A kind of job press."
