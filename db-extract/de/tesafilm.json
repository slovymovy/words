                                        "glosses": [
                                            "Alternative letter-case form of sellotape."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5136c304-74f0-4676-9fd4-f96943ed10b2",
                                                "sense_id": "df851d7c-74e3-36f2-a75f-2debf4515bd6",
                                                "text": "He stood on his bed then Sellotaped the mermaid picture on to his wall so she would be the first thing he would see when he woke up."
                                            },
                                            {
                                                "example_id": "75dfe039-fe62-4348-bc4f-49a1ff93a884",
                                                "sense_id": "df851d7c-74e3-36f2-a75f-2debf4515bd6",
                                                "text": "She Sellotaped the stems back on but they just fell off again."
                                            },
                                            {
                                                "example_id": "ac679b57-affc-4fb6-9fd2-f8115df1d084",
                                                "sense_id": "df851d7c-74e3-36f2-a75f-2debf4515bd6",
                                                "text": "On one car he Sellotaped the ticket over the windscreen wiper."
                                            },
                                            {
                                                "example_id": "74ffb086-c4d8-4239-b987-f61641016b5d",
                                                "sense_id": "df851d7c-74e3-36f2-a75f-2debf4515bd6",
                                                "text": "‘Didn’t they tell you about the pipe leakage problem there?’ ‘Yeah, I Sellotaped it.’ She stared at him. ‘You Sellotaped it?’ ‘Yeah, I just Sellotaped the shit out of it.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
