                "senses": [
                    {
                        "sense_id": "c19323d2-67d5-3c8e-8723-044d9db80b64",
                        "entry_id": "e7d76178-1082-3161-9c0d-619458b24ef6",
                        "glosses": [
                            "eine niederpreußische Varietät des Ostniederdeutschen, die von den Russlandmennoniten in verschiedenen Teilen der Erde gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dfc759e-69e0-4fca-9195-c746efdc539e",
                                "sense_id": "c19323d2-67d5-3c8e-8723-044d9db80b64",
                                "text": "„Hier wird eine allgemeine Übersicht über Plautdietsch und verschiedene Ressourcen, die ins Plautdietsche einführen, geboten.“"
                            },
                            {
                                "example_id": "51eb26f9-8df8-4e9d-87a8-8900e5dbe35a",
                                "sense_id": "c19323d2-67d5-3c8e-8723-044d9db80b64",
                                "text": "„Neben neuen Werken tragen in besonderem Maße Übersetzungen von klassischer Literatur ins Plautdietsch zu einem Aufschwung der Mundart bei.“"
                            },
                            {
                                "example_id": "928c862e-754d-4f93-bde6-756455df0e1f",
                                "sense_id": "c19323d2-67d5-3c8e-8723-044d9db80b64",
                                "text": "„Als Aussiedler - ich bin russlanddeutscher Mennonit mit der Muttersprache Plautdietsch - möchte ich vor allem die Aussage Lachauers unterstreichen, dass in der bisherigen Wahrnehmung von Russlanddeutschen die \"Dimension Karaganda\" ausgeblendet war.“"
                            },
                            {
                                "example_id": "62bff903-bb3c-4c6f-9faa-0cb51028c26d",
                                "sense_id": "c19323d2-67d5-3c8e-8723-044d9db80b64",
                                "text": "„Wir bieten Hutterisch Deutsch, Texas Deutsch, Pennsylvania Deutsch und Plautdietsch an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
