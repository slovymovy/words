                                    {
                                        "sense_id": "ecf0abd8-7cfe-3896-b25a-b859d9e8d040",
                                        "entry_id": "6c77b797-ccdf-31d4-9406-cca04bf28e7a",
                                        "glosses": [
                                            "Artisanal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b48dcaa-7a82-4fdd-8b44-432ce43069e4",
                                                "sense_id": "ecf0abd8-7cfe-3896-b25a-b859d9e8d040",
                                                "text": "Bread is either cheap (soft, squishy supermarket loaves) or expensive (artisan bakery loaves)."
                                            },
                                            {
                                                "example_id": "14771eac-33d7-41d0-b979-d1d28e9e619e",
                                                "sense_id": "ecf0abd8-7cfe-3896-b25a-b859d9e8d040",
                                                "text": "Cartier and Tiffany have some unlikely new neighbours near Sloane Square — a butcher, a greengrocer and a cheesemonger. […] The row of artisan food and drink shops also includes a wine merchant. A bakery is due to open in time for Christmas and a tenant is being sought for a sixth unit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33a2dbb8-6821-4825-84b2-d7b70744f820",
                        "source_entry_id": "e2966caa-a6db-3d3f-bb33-aabeaa44ed08",
