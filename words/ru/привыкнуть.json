{
    "word_family": [
        "привычка",
        "привычный",
        "привыкание"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61fc94cb-9405-3986-b0db-8eaccace50d1",
                    "sense_definition": "Стать воспринимать что-либо как обычное, нормальное или знакомое в результате повторения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К новому климату было непросто <w>привыкнуть</w>.",
                            "target_lang_translations": {
                                "en": "It wasn't easy to <w>get used</w> to the new climate."
                            }
                        },
                        {
                            "text": "Я быстро <w>привык</w> вставать рано утром.",
                            "target_lang_translations": {
                                "en": "I quickly <w>got used</w> to getting up early in the morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "свыкнуться",
                        "обвыкнуть"
                    ],
                    "antonyms": [
                        "отвыкнуть"
                    ],
                    "common_phrases": [
                        "быстро привыкнуть",
                        "трудно привыкнуть"
                    ],
                    "target_lang_definitions": {
                        "en": "To come to perceive something as ordinary, normal, or familiar through repetition or habit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get used",
                                "target_lang_sense_clarification": "to something / to doing something"
                            },
                            {
                                "target_lang_word": "get accustomed",
                                "target_lang_sense_clarification": "to something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d8a6b4-fad2-3716-a81c-9c380992b69e",
                    "sense_definition": "Приспособиться к новым условиям или обстоятельствам.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После переезда в другой город пришлось <w>привыкнуть</w> к новому ритму жизни.",
                            "target_lang_translations": {
                                "en": "After moving to another city, I had to <w>adjust</w> to the new rhythm of life."
                            }
                        },
                        {
                            "text": "Организм должен <w>привыкнуть</w> к большим физическим нагрузкам.",
                            "target_lang_translations": {
                                "en": "The body needs to <w>adapt</w> to high physical loads."
                            }
                        }
                    ],
                    "synonyms": [
                        "приспособиться",
                        "адаптироваться",
                        "освоиться"
                    ],
                    "antonyms": [
                        "отвыкнуть"
                    ],
                    "common_phrases": [
                        "привыкнуть к условиям",
                        "привыкнуть к мысли"
                    ],
                    "target_lang_definitions": {
                        "en": "To adapt or adjust to new conditions, circumstances, or physical demands."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adjust",
                                "target_lang_sense_clarification": "to new conditions or changes"
                            },
                            {
                                "target_lang_word": "adapt",
                                "target_lang_sense_clarification": "to a new environment or circumstances"
                            },
                            {
                                "target_lang_word": "get used",
                                "target_lang_sense_clarification": "to a situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79c10895-e23b-3fdc-b0f7-3dd9e3de21f2",
                    "sense_definition": "Почувствовать привязанность к кому-либо или чему-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети очень сильно <w>привыкли</w> к своей первой учительнице.",
                            "target_lang_translations": {
                                "en": "The children became very deeply <w>attached</w> to their first teacher."
                            }
                        },
                        {
                            "text": "Я так <w>привык</w> к этой старой квартире, что не хочу переезжать.",
                            "target_lang_translations": {
                                "en": "I have <w>grown so attached</w> to this old apartment that I don't want to move."
                            }
                        }
                    ],
                    "synonyms": [
                        "сжиться",
                        "привязаться"
                    ],
                    "target_lang_definitions": {
                        "en": "To develop an emotional attachment or deep familiarity toward someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow fond of",
                                "target_lang_sense_clarification": "someone or something"
                            },
                            {
                                "target_lang_word": "get attached",
                                "target_lang_sense_clarification": "to someone or something"
                            },
                            {
                                "target_lang_word": "grow attached",
                                "target_lang_sense_clarification": "to a person or place"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}