                    "frequency": "Middle",
                    "semantic_group_id": "admission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect decided to <w>cop</w> to the theft after hours of questioning.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый решил <w>сознаться</w> в краже после многочасового допроса.",
                                "zh": "经过几个小时的审讯，嫌疑人决定<w>承认</w>盗窃事实。"
                            }
