                "senses": [
                    {
                        "sense_id": "af2a900f-f4a1-3934-9cbf-a8598bfaaef0",
                        "entry_id": "48c6a218-ac8b-37b6-9a6d-378e2afe9aa4",
                        "glosses": [
                            "Fanzine à diffusion limitée et tirage amateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7477acd9-baf2-4b47-ae53-c818c6519503",
                                "sense_id": "af2a900f-f4a1-3934-9cbf-a8598bfaaef0",
                                "text": "Et de faire des échanges, qui sait, pour qu’un étudiant belge du Plateau feuillette le zine érotique d’une auteure de Saint-Georges-de-Beauce, ou qu’un tripeux de musique de Sainte-Anne-des-Monts puisse écouter, dans son baladeur, un Hot Summer Mix enregistré sur une vieille cassette TDK par un membre d’un groupe de Lachine à un cheveu de partir pour la gloire."
                            },
                            {
                                "example_id": "50e702b6-fdf2-4e59-bbc6-0aa21610a210",
                                "sense_id": "af2a900f-f4a1-3934-9cbf-a8598bfaaef0",
                                "text": "Des mini-cd, des mini-films, des mini-zines, comme cette parodie d’un Maxim sérigraphié, où un grotesque hamburger coiffé d’un postiche a remplacé le visage de l’amazone de la couverture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "382c3829-43ab-4777-ac7f-fb71f209f46c",
                        "source_entry_id": "48c6a218-ac8b-37b6-9a6d-378e2afe9aa4",
                        "source_sense_id": "af2a900f-f4a1-3934-9cbf-a8598bfaaef0",
                        "target_lang_word": "zine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b128696b-8791-3c7a-85a8-4e775f2b2e8c",
                                        "entry_id": "426367a8-877e-3b97-bb0c-1f7c1148b8ea",
                                        "glosses": [
                                            "A low-circulation, noncommercial publication of original or appropriated texts and images, especially one of minority interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f45dad58-9002-4316-9689-c1ad5831d7bc",
                                                "sense_id": "b128696b-8791-3c7a-85a8-4e775f2b2e8c",
                                                "text": "Zines contributed to an evolving critical language that would ultimately take two paths: into the gut or to the academy. The most compelling zines fused the two."
                                            },
                                            {
                                                "example_id": "57e1d326-ceb4-4b6d-9d55-e26b32c4567b",
                                                "sense_id": "b128696b-8791-3c7a-85a8-4e775f2b2e8c",
                                                "text": "The feminist zine community is not located in place but it geographically dispersed, constituting a connected flow of communicative practices, spaces, texts, technologies, bodies, and utterances."
                                            },
                                            {
                                                "example_id": "0262de7c-e648-48e8-aae3-422f64ca00ad",
                                                "sense_id": "b128696b-8791-3c7a-85a8-4e775f2b2e8c",
                                                "text": "I conducted a content analysis of the zines I collected by using techniques of thematic analysis (Patton, 1990). I read and reread each of the zines’ contents. I annotated the prose, cartoons, poetry, and narratives in the zines by noting key words that signaled topics and assigning codes and subcodes that were later collapsed to form categories."
                                            },
                                            {
                                                "example_id": "91f489da-b69b-4607-ac58-41c564df0546",
                                                "sense_id": "b128696b-8791-3c7a-85a8-4e775f2b2e8c",
                                                "text": "“Do you think Cal Bodian's over there? Do you think he'll sign my zine?” “♪♪ Bum, bada-dum. ♪♪ My P.I. Undercover fanzine. I've done everything myself. I just took a guess about the chest hair.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
