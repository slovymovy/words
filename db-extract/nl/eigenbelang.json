                                        "entry_id": "52067fec-4492-3180-98f3-c533c9043845",
                                        "glosses": [
                                            "Interesse am Verlauf und Ausgang von etwas, das durch den Willen zur Erlangung eines möglichst eigenen Vorteils oder Nutzens daraus geprägt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6132d575-3643-48ae-9493-c82c44a83b4b",
                                                "sense_id": "df7cce45-f6bc-3ba7-abd1-b004930489e3",
                                                "text": "„[…] Rücksichtsloses Eigeninteresse und Konfrontation haben Trumps Außenpolitik genauso geprägt wie ständige Personalwechsel, Überraschung und Konfusion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ce57789-ee79-43c6-84f1-9266fa42bce8",
                        "source_entry_id": "7c1cb6b1-07c4-3799-b4c8-db1fe5892b50",
                        "source_sense_id": "d3671c6b-b9f6-37b9-8497-de445e089f96",
                        "target_lang_word": "self-interest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-interest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                        "entry_id": "0754b173-1534-391a-8780-0c907494bd4f",
                                        "glosses": [
                                            "One's personal interest or advantage, especially when pursued without regard for others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a05622b-d627-4d8c-b5f1-56f31463789f",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "I cannot abandon my husband for the sake of self-interest and personal gain."
                                            },
                                            {
                                                "example_id": "9b15dd4a-9c94-4b86-bd6a-88774804d32d",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "And so he reasoned until the first generous impulse to proclaim the truth and relinquish his titles and his estates to their rightful owner was forgotten beneath the mass of sophistries which self-interest had advanced."
                                            },
                                            {
                                                "example_id": "4f1b27c1-b536-4a0b-baa9-fb4fdcd90214",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "Corruption becomes fatal when those in power are no longer able to distinguish the difference between self-interest and the national interest."
                                            },
                                            {
                                                "example_id": "2a50f168-1741-4273-b227-5cff7ea39279",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "Government standards of decency and honesty were quite low, and decision-makers were tainted with self-interest and corruption at the very highest level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
