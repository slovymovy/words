                ],
                "senses": [
                    {
                        "sense_id": "a2466e34-e526-3cd4-813e-2f961c8218a2",
                        "entry_id": "d3816a1f-f264-3f8c-aeef-02f0495a80f2",
                        "glosses": [
                            "Wissenschaft vom Lehren und Lernen des Sports, seiner Leitziele, Lernziele und Methoden, Berufswissenschaft des Sportlehrers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3365f9f0-ca74-4574-bda2-1272467735ab",
                                "sense_id": "a2466e34-e526-3cd4-813e-2f961c8218a2",
                                "text": "„Die Positionen, die innerhalb der Sportdidaktik gegenüber dem außerschulischen Sport vertreten werden, haben eine beträchtliche Spannweite.“"
                            },
                            {
                                "example_id": "f540d274-8c1d-4a5c-85a5-588756f43b27",
                                "sense_id": "a2466e34-e526-3cd4-813e-2f961c8218a2",
                                "text": "„Indes steht solche didaktisch legitime und verlangte erzieherische Verzweckung auch für die Sportdidaktik unter dem vorbehaltlichen Wissen darum, daß Spielen im Vollsinne seiner Bedeutung […] nur vom Spielenden selbst zu beurteilen ist und sich damit im Letzten pädagogischer und unterrichtlicher Machbarkeit und Verfügung entzieht.“"
                            },
                            {
                                "example_id": "a253925b-fd67-45fd-8e02-64d5aa46ca8e",
                                "sense_id": "a2466e34-e526-3cd4-813e-2f961c8218a2",
                                "text": "„Die Sportdidaktik ist zu thematischen Schwerpunkt der Sportpädagogik und zum Kernbereich der Sportlehrerausbildung geworden.“"
                            },
                            {
                                "example_id": "c7fe3c87-ad85-40c9-8cfa-0cc3afd094bf",
                                "sense_id": "a2466e34-e526-3cd4-813e-2f961c8218a2",
                                "text": "„Sportdidaktik steht thematisch und institutionell in dem größeren Problemzusammenhang der Sportwissenschaft.“"
                            },
                            {
                                "example_id": "a9e19a05-0775-4579-b3fb-079596c2f64c",
                                "sense_id": "a2466e34-e526-3cd4-813e-2f961c8218a2",
                                "text": "„Eine Sportdidaktik, die sich nachweislich bislang höchst unzulänglich die sozialen Prozesse im Sportunterricht zum Reflexions- und Forschungsgegenstand gemacht hat, steht angesichts der Probleme, die mit der Eingliederung und gleichberechtigten Berücksichtigung Behinderter auftreten, mit leeren Händen da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
