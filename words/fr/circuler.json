{
    "word_family": [
        "circulation",
        "circulaire",
        "circulatoire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a4aa3cd-6171-3a96-be13-f51cfa90b9a7",
                    "sense_definition": "Se déplacer ou rouler, en parlant de véhicules ou de moyens de transport.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cause de la neige, les bus ne peuvent plus <w>circuler</w> sur cette route."
                        },
                        {
                            "text": "Beaucoup de voitures <w>circulent</w> chaque matin sur les grands boulevards de la ville."
                        }
                    ],
                    "synonyms": [
                        "rouler"
                    ],
                    "common_phrases": [
                        "circuler librement"
                    ]
                },
                {
                    "sense_id": "b2c64442-fc64-390e-ae2f-725d81c7cfec",
                    "sense_definition": "Aller et venir çà et là, se déplacer dans un lieu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les touristes <w>circulaient</w> tranquillement entre les étals du marché pour choisir des fruits."
                        },
                        {
                            "text": "Les policiers ont demandé aux curieux de <w>circuler</w> pour dégager le passage."
                        }
                    ],
                    "synonyms": [
                        "déambuler"
                    ],
                    "antonyms": [
                        "stationner"
                    ],
                    "common_phrases": [
                        "circulez, il n'y a rien à voir"
                    ]
                },
                {
                    "sense_id": "b4692c10-5a44-3bcc-b09e-8b27425950ac",
                    "sense_definition": "Se propager d'une personne à une autre, en parlant d'une rumeur, d'une idée ou d'une information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une fausse nouvelle <w>circule</w> rapidement sur Internet depuis ce matin."
                        },
                        {
                            "text": "Plusieurs bruits ont <w>circulé</w> dans l'entreprise à propos d'un changement de direction."
                        }
                    ],
                    "synonyms": [
                        "se propager",
                        "se répandre"
                    ],
                    "common_phrases": [
                        "faire circuler l'information",
                        "rumeur qui circule"
                    ]
                },
                {
                    "sense_id": "e2bd343c-8d4e-3e12-9f37-62ea15010d4d",
                    "sense_definition": "Se mouvoir de façon continue dans un circuit fermé, en parlant d'un fluide ou de l'air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sang <w>circule</w> dans tout le corps grâce aux battements réguliers du cœur."
                        },
                        {
                            "text": "Ouvrez grand la fenêtre afin de laisser l'air frais <w>circuler</w> dans la pièce."
                        }
                    ],
                    "synonyms": [
                        "s'écouler"
                    ],
                    "antonyms": [
                        "stagner"
                    ],
                    "common_phrases": [
                        "faire circuler l'air"
                    ]
                },
                {
                    "sense_id": "bab3c8b8-240b-32f2-954c-de790ea4a00f",
                    "sense_definition": "Passer d'une personne à une autre ou être en usage, en parlant de monnaie, de biens ou de documents.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a fait <w>circuler</w> une feuille de présence au début du cours."
                        },
                        {
                            "text": "Ces billets de banque ne <w>circulent</w> plus depuis l'introduction de la nouvelle devise."
                        }
                    ],
                    "common_phrases": [
                        "faire circuler un document",
                        "faire circuler la pétition"
                    ]
                }
            ]
        }
    ]
}