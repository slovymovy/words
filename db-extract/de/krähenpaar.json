                        "examples": [
                            {
                                "example_id": "70537e10-7a20-4c5e-9c5f-07a45eed3d53",
                                "sense_id": "a3fe9a03-6369-383c-b696-4541a23edd0b",
                                "text": "„Ich sah ihn vor der Kirche, wo er seine Pfeife rauchte und ein Krähenpaar bewunderte, das in der steinernen Vogeltränke des Pfarrhauses badete.“"
                            },
                            {
                                "example_id": "813fd855-8408-4263-ae9c-4005d9261440",
                                "sense_id": "a3fe9a03-6369-383c-b696-4541a23edd0b",
                                "text": "„Ich stoße einen Pfiff in Richtung eines Krähenpaares aus, das auf einem Telefonmast schnäbelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
