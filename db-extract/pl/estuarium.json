                        "glosses": [
                            "poszerzone, lejkowate ujście rzeki, powstałe w wyniku działania pływów morskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e24fd6f0-9b0b-4245-9ef5-ac55a7d03c6e",
                                "sense_id": "04d31ec3-c48d-328d-91e2-073eccb3ded5",
                                "text": "Roślinność wodna tego estuarium jest bardzo bogata."
                            }
                        ],
