                    {
                        "sense_id": "650756f9-d0ab-37ff-bfb8-cbdfdb969594",
                        "entry_id": "bef01102-0b5e-3b80-a932-3372cae9e79e",
                        "glosses": [
                            "Kritiker, Rezensent, der äußerst kleinlich, hämisch und schmähsüchtig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07dcb519-e818-4301-bc13-27892464dd03",
                                "sense_id": "650756f9-d0ab-37ff-bfb8-cbdfdb969594",
                                "text": "„Doch muß ich eines seiner Werke ausnehmen, das Gedicht auf die Deklamation, welches, nebst etwa zwanzig kleinen Aufsätzen und einigen Stellen seines Célibataire, ihm eine ehrenvolle Stelle anweist und verhindern wird, daß man ihn nach seinem Tode auf die tiefere Stufe setze, zu welcher ihn die finsteren Zoïlusse, die ihm während seines Lebens wehe getan, verdammen möchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
