                "senses": [
                    {
                        "sense_id": "b2a21834-3303-3cb8-9442-7b65c85c72b4",
                        "entry_id": "2c09b90b-c58f-3311-81ac-5843e96e54ce",
                        "glosses": [
                            "To stand up; arise; be erect; rise."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9155b9fd-79dc-47a6-a728-0dff4ed83a2c",
                                "sense_id": "b2a21834-3303-3cb8-9442-7b65c85c72b4",
                                "text": "At once, upstood the monarch, and upstood / The wise Ulysses."
                            },
                            {
                                "example_id": "0101750d-96d4-435c-acb3-6350310723da",
                                "sense_id": "b2a21834-3303-3cb8-9442-7b65c85c72b4",
                                "text": "The combination with a closet seat, of a flexible mat having sockets, plates secured upon the seat and having recesses, and a standard pivoted upon each plate and fold- able to lie in the respective socket or to upstand from the seat, […]"
                            },
                            {
                                "example_id": "1f7991a9-0c6b-453d-96be-68739aabadb8",
                                "sense_id": "b2a21834-3303-3cb8-9442-7b65c85c72b4",
                                "text": "Put differently, attention to norms and rules did not increase the likelihood that a student would choose to upstand or intervene. Students who were more likely to recommend direct support for the victim (choosing to upstand), however, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bd56bc8-5c32-445e-903b-b07601d62983",
                        "source_entry_id": "2c09b90b-c58f-3311-81ac-5843e96e54ce",
                        "source_sense_id": "b2a21834-3303-3cb8-9442-7b65c85c72b4",
                        "source_sense_description": "stand up",
                        "target_lang_word": "ériger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ériger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29782460-d8d7-32fb-8ad4-9ce9b4de43a5",
                                        "entry_id": "93ba82bb-0b35-30ec-a82a-d902a130644d",
                                        "glosses": [
                                            "Dresser, élever, en parlant d'un monument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab4ee0e-8659-461f-8e95-e226d26f73e3",
                                                "sense_id": "29782460-d8d7-32fb-8ad4-9ce9b4de43a5",
                                                "text": "La Lune était au plus proche de la Terre dans la nuit de jeudi à vendredi et de cette statue de Poséidon érigée près d’Athènes."
                                            },
                                            {
                                                "example_id": "e9407487-5a7b-41ac-a61e-4d15b34c8ba6",
                                                "sense_id": "29782460-d8d7-32fb-8ad4-9ce9b4de43a5",
                                                "text": "Après avoir traversé le pont, on débouche sur place des Carmes où fut érigée, en 1885, la statue du conventionnel Grégoire. L'abbé Grégoire a la figure énergique, […]."
                                            },
                                            {
                                                "example_id": "b7bd3232-31a6-4362-8506-d94eb74a19d9",
                                                "sense_id": "29782460-d8d7-32fb-8ad4-9ce9b4de43a5",
                                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, restaient d’un vert dru malgré la chaleur torride de cette fin d’été."
                                            },
                                            {
                                                "example_id": "21419eff-24a9-418c-a04b-97030c3cb3c0",
                                                "sense_id": "29782460-d8d7-32fb-8ad4-9ce9b4de43a5",
                                                "text": "Nous quitterons, nous retrouverons,\ntoute la salle rire nous ferons,\nsept rivières, sept montagnes\nentre nous érigerons.\nComme si n'avions pas assez\nde douleurs et de défaites\n― de paroles nous achèverons."
                                            },
                                            {
                                                "example_id": "441752f1-5ce9-45df-975f-036595cd304c",
                                                "sense_id": "29782460-d8d7-32fb-8ad4-9ce9b4de43a5",
                                                "text": "Au loin, il y avait de ces champignons qui érigent un gland glueux de pus verdâtre ou qui s'affaissent, flasques, comme des éponges pourries aux puanteurs de charognes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0397229b-eb23-30b8-a189-06b02cb011c4",
                                        "entry_id": "93ba82bb-0b35-30ec-a82a-d902a130644d",
                                        "glosses": [
                                            "Instituer ; établir."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711c773c-7079-4f1d-9807-c09267c25a34",
                                                "sense_id": "0397229b-eb23-30b8-a189-06b02cb011c4",
                                                "text": "Le Conseil vote le maintien, sous ces deux rapports, de la réunion de Marqueny à Coulommes.\nII rejette la demande de la section de Day d’être érigée en commune."
                                            },
                                            {
                                                "example_id": "b1018f70-9327-46ee-a6b6-e866b81a38c9",
                                                "sense_id": "0397229b-eb23-30b8-a189-06b02cb011c4",
                                                "text": "Le quiétisme, tant accusé d’obscurité, n'avait été que trop clair. Il érigeait en système et posait avec franchise comme suprême perfection l’état d'immobilité et d’impuissance où l'âme parvient à la longue quand elle abdique son activité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                        "entry_id": "93ba82bb-0b35-30ec-a82a-d902a130644d",
                                        "glosses": [
                                            "Faire passer d’une condition dans une autre plus élevée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4de8376-3652-445b-a8bd-79370120b42e",
                                                "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                                "text": "Ériger une église en cathédrale."
                                            },
                                            {
                                                "example_id": "2b39976d-6380-4edc-9b08-592b857739ff",
                                                "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                                "text": "Ériger un évêché en archevêché."
                                            },
                                            {
                                                "example_id": "7ae49090-0a7d-4b35-a3a2-eb2531a7681e",
                                                "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                                "text": "La crédulité populaire érige quelquefois les scélérats en héros."
                                            },
                                            {
                                                "example_id": "f6aaa50c-050c-43ae-a2fc-13013e3ae263",
                                                "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                                "text": "Ériger son caprice en principe, une exception en règle."
                                            },
                                            {
                                                "example_id": "02d5902e-15a9-4e5b-a600-18f919ac3aed",
                                                "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                                "text": "S’ériger en censeur public."
                                            },
                                            {
                                                "example_id": "9be48705-d634-4a3a-982d-049f987514d7",
                                                "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                                "text": "S’ériger en réformateur."
                                            },
                                            {
                                                "example_id": "e4990fec-1b51-43d6-95f0-14a19d58342d",
                                                "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                                                "text": "S’ériger en moraliste, en critique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
