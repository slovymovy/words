                                    {
                                        "sense_id": "a58e7a6b-823e-38fb-8341-481477745e6d",
                                        "entry_id": "ae7239d8-3644-39db-87ba-9818a53c5da2",
                                        "glosses": [
                                            "Frau, deren Ehegatte verstorben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f592bd-3b9c-43dc-8c80-ff9322c5dd41",
                                                "sense_id": "a58e7a6b-823e-38fb-8341-481477745e6d",
                                                "text": "Als Witwe hat sie es schwer, ihre Kinder allein zu erziehen."
                                            },
                                            {
                                                "example_id": "c8993403-c8b7-4e8b-b19a-506234d5505e",
                                                "sense_id": "a58e7a6b-823e-38fb-8341-481477745e6d",
                                                "text": "„Beide sind Witwer, denen die Witwe Goos, der das Haus zu eigen ist, die Wirtschaft führt.“"
                                            },
                                            {
                                                "example_id": "eb07259a-499c-446f-a3b1-96925bada5a5",
                                                "sense_id": "a58e7a6b-823e-38fb-8341-481477745e6d",
                                                "text": "„Sie sind wie Witwen, wie enteignete Pächter, Märtyrer, Wahnsinnige.“"
                                            },
                                            {
                                                "example_id": "d81410b0-aab3-487e-84d4-8f4c630b6c9e",
                                                "sense_id": "a58e7a6b-823e-38fb-8341-481477745e6d",
                                                "text": "„Die erste prominente Witwe, die die Zigarettenindustrie verklagte, war die Witwe von King Cole.“"
                                            },
                                            {
                                                "example_id": "002daa4b-a19d-4123-a636-84751fabd5c3",
                                                "sense_id": "a58e7a6b-823e-38fb-8341-481477745e6d",
                                                "text": "„Eine andere trifft den Sohn einer reichen Witwe, die vor den Unruhen im Zarenreich auf einen Landsitz nahe bei Tewjes Dorf geflohen ist.“"
                                            },
                                            {
                                                "example_id": "a410107c-54cc-4f31-9c26-1d26ea87056b",
                                                "sense_id": "a58e7a6b-823e-38fb-8341-481477745e6d",
                                                "text": "„Seine Witwe, der nicht wenige Fans schon damals eine Mitschuld an Cobains Suizid gegeben hatten, postete ein zweites Foto: ...“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
