                "senses": [
                    {
                        "sense_id": "d9e9dd79-bf53-3163-a8d9-1d8429434ee0",
                        "entry_id": "3f765267-2bd0-37ee-b020-3e6e4b5e6803",
                        "glosses": [
                            "auffallend große weibliche Brust"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "f63b0ef3-18de-4f18-bf7c-dd78b576f50d",
                                "sense_id": "d9e9dd79-bf53-3163-a8d9-1d8429434ee0",
                                "text": "„Riesentitten gibt es viele, das reicht nicht für eine Berühmheit, sonst gäbe es allzu viele Berühmtheiten.“"
                            },
                            {
                                "example_id": "1dc0217c-01e1-461e-bb02-59a18dd213af",
                                "sense_id": "d9e9dd79-bf53-3163-a8d9-1d8429434ee0",
                                "text": "„Sie wiederum lächelte ihn immer nur seltsam benebelt an und sah zu, wie er seine Arbeit erledigte, wobei sie mit ihren Riesentitten entweder keck auf dem Bett lag oder auf dem abgeschabten Sessel thronte und ihren aufgeblähten Bauch streichelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
