                                "target_lang_sense_clarification": "weather condition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3876755-2c1c-3f1d-b933-491005f77182",
                    "sense_definition": "het in beweging zijn van lucht",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wind-activiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wind <w>waait</w> uit het noorden en brengt koude lucht mee.",
                            "target_lang_translations": {
                                "en": "The wind <w>blows</w> from the north and brings cold air with it."
                            }
                        },
                        {
                            "text": "Er <w>waait</w> een frisse zeewind over het strand.",
                            "target_lang_translations": {
                                "en": "A fresh sea breeze <w>blows</w> across the beach."
                            }
                        }
                    ],
                    "synonyms": [
                        "blazen"
                    ],
                    "common_phrases": [
                        "een frisse wind waait",
                        "uit het noorden waaien"
                    ],
                    "target_lang_definitions": {
                        "en": "the movement of air"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "air current"
                            }
                        ]
