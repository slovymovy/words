                ],
                "senses": [
                    {
                        "sense_id": "4b9fd219-1422-334a-b717-29daf13a440f",
                        "entry_id": "4fe23116-f11e-3353-89e2-da7dbad7cd35",
                        "glosses": [
                            "Mitglied eines Kongresses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "683d7865-8eb4-42b2-8421-8fbc7724285b",
                                "sense_id": "4b9fd219-1422-334a-b717-29daf13a440f",
                                "text": "„Die 1892 erfolgte Reform der zentralen Legislative (Imperial Legislative Council) hatte die Hoffnungen der nationalliberalen Kongressmitglieder weitgehend erfüllt.“"
                            },
                            {
                                "example_id": "75789fde-6ed1-4742-b6b2-a735a744d1df",
                                "sense_id": "4b9fd219-1422-334a-b717-29daf13a440f",
                                "text": "„In den 80er Jahren, dem Goldenen Zeitalter des Terrorismus, bediente man sich spezieller Verfahren, um sich mit einem Kidnapping zu befassen, das ein Kongressmitglied in Mitleidenschaft zog.“"
                            },
                            {
                                "example_id": "71441142-4ff7-4d56-9feb-8e48e462abd3",
                                "sense_id": "4b9fd219-1422-334a-b717-29daf13a440f",
                                "text": "„Sollte jemand von ihnen versuchen, Kontakt mit einem Kongressmitglied, einem Medienvertreter oder sonstigen problematischen Personen aufzunehmen, werden drastische Maßnahmen gegen ihn ergriffen, um es zu verhindern.“"
                            },
                            {
                                "example_id": "c3c1b90a-cb58-4209-aa02-335ae053ef37",
                                "sense_id": "4b9fd219-1422-334a-b717-29daf13a440f",
                                "text": "„Es tut mit leid, es hat eine Weile gedauert, bis ich das Kongressmitglied ausfindig machen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
