                "senses": [
                    {
                        "sense_id": "8c7eca18-738c-3d0d-868e-a56800f09725",
                        "entry_id": "297d3fbc-34e9-3b5c-90ab-3d0373260b88",
                        "glosses": [
                            "Artisan qui fond des cloches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f2aac4-8266-40a6-b91c-b44022054ee2",
                                "sense_id": "8c7eca18-738c-3d0d-868e-a56800f09725",
                                "text": "Le saintier, c’était le fondeur de cloches, un façonnier ambulant toujours par monts et par vaux, hier ici et demain ailleurs, un compagnon qui usait les clous de ses souliers sur tous les chemins caillouteux de France et de Navarre."
                            },
                            {
                                "example_id": "d7070d6f-72a7-46c3-b3d3-bbee4c7b3a1e",
                                "sense_id": "8c7eca18-738c-3d0d-868e-a56800f09725",
                                "text": "Il serait fils de saintier. Puis saintier lui-même. Puis père et grand-père de saintiers. Et ainsi jusqu’à la fin des temps, tant que des cloches sonneraient dans les clochers."
                            },
                            {
                                "example_id": "605a5c93-167c-4e63-8d2a-d58c9c547184",
                                "sense_id": "8c7eca18-738c-3d0d-868e-a56800f09725",
                                "text": "Les bancs de l’église paroissiale portent encore, gravés dans le bois, les noms des principales dynasties de saintiers."
                            }
                        ]
                    }
                ],
