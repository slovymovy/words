                        "examples": [
                            {
                                "example_id": "d2a02f3f-cc5e-4bfb-9a72-25e65f45783e",
                                "sense_id": "9b228022-c166-3db9-9b82-9c06edfff26b",
                                "text": "Deze privédetective en medewerker van News of the World kreeg in 2007 een gevangenisstraf van zes maanden, omdat hij samen met royaltyverslaggever Clive Goodman het telefoonverkeer van personeel van de koninklijke familie had afgeluisterd."
                            },
                            {
                                "example_id": "1d68191d-1232-45d4-ac86-ac35fd4daca2",
                                "sense_id": "9b228022-c166-3db9-9b82-9c06edfff26b",
                                "text": "Prinses Diana heeft in de jaren negentig telefoonnummers van de hofhouding van prins Charles doorgespeeld naar de media. Dat zei de royaltyverslaggever van de krant News of the World in het proces tegen hem."
                            }
