                                "target_senses": [
                                    {
                                        "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                                        "entry_id": "712ee4b5-c827-37c0-b0ca-aa6b7d6b4842",
                                        "glosses": [
                                            "während einer anderen (Haupt-)Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4befb8-b8af-42d0-9152-6b8906bb42ba",
                                                "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                                                "text": "Der alte Schotte ließ das Geheimnis des Erfolgs ganz nebenbei fallen."
                                            },
                                            {
                                                "example_id": "1634659c-de11-4bbc-b1de-27734afa225a",
                                                "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                                                "text": "Nur als so nebenbei bemerkt: die ulkige Zeichnung kostet ein paar tausend Euro."
                                            },
                                            {
                                                "example_id": "816a3c29-f27b-4227-87f2-a76c24686934",
                                                "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                                                "text": "„Sebastian Kehl steht kurz vor dem Abschluss eines Studiengangs bei der UEFA und macht nebenbei den ersten Trainerschein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55aab6d9-66aa-4aa3-b72b-46566a455ae9",
                        "source_entry_id": "2b40a73b-be81-3899-9ab1-c9816742c341",
                        "source_sense_id": "a3175aed-da4c-3299-a264-09c19d593966",
                        "target_lang_word": "en passant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en passant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                        "entry_id": "8f66eeb2-a967-36bb-89f0-053f840638c2",
                                        "glosses": [
                                            "En faisant avec quelque sorte de précipitation et sans y avoir donné le temps nécessaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce26b0e5-0fa2-46f4-9f91-1d237f566b24",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "Je n’ai pas eu le loisir d’examiner l’endroit, je ne l’ai vu qu’en passant."
                                            },
                                            {
                                                "example_id": "5e61dcc1-c9c4-49fe-bdae-cba42d441375",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "Je ne lui ai parlé de votre affaire qu’en passant."
                                            },
                                            {
                                                "example_id": "fe87bf55-d1e2-464e-b9a6-1b8a731bfd5c",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "J’ai traité cet appel comme n’importe quel autre, sans enjeu d’aucune sorte, un petit signe en passant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                        "entry_id": "8f66eeb2-a967-36bb-89f0-053f840638c2",
                                        "glosses": [
                                            "Se dit, en interrompant le fil d’une conversation, pour parler succinctement d’une chose qui se présente à l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e1e6b1-acc3-4f9d-b790-9dd0afaa3658",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Nous dirons en passant que les céréales sont beaucoup moins sujettes à la verse en Champagne que dans d'autres contrées."
                                            },
                                            {
                                                "example_id": "a5ed221b-b9d9-42e8-8ea1-80fa3aa1242b",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Un peu de ridicule et de bizarrerie se mêle infailliblement à cette époque transitoire de l’âge des garçons, et il me faut bien indiquer cette note en passant."
                                            },
                                            {
                                                "example_id": "9dd02069-9bcd-4fb9-823f-6a7d19d92682",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Je mentionne, en passant, les méfaits du micronationalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f0c57a0-7f4a-4faa-af80-ebdca0887f01",
                        "source_entry_id": "2b40a73b-be81-3899-9ab1-c9816742c341",
                        "source_sense_id": "a3175aed-da4c-3299-a264-09c19d593966",
                        "target_lang_word": "au passage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au passage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d67a6f2-b577-3732-8524-e3424033d189",
                                        "entry_id": "37cf7c6c-a46e-38a8-a2d7-6d19228a4755",
                                        "glosses": [
                                            "Dénote l’ajout d’un court argument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4818a44b-c6fc-45c5-a7a9-66ae91c4fe08",
                                                "sense_id": "5d67a6f2-b577-3732-8524-e3424033d189",
                                                "text": "Elle a en effet mis les trois moyens d'information d’accord en commençant par occuper la radio, puis en mettant la main sur la télévision, tuant au passage une quatorzaine de Lituaniens indépendantistes et sans armes."
                                            },
                                            {
                                                "example_id": "58e80618-209a-4527-9f5d-2656aeb16e20",
                                                "sense_id": "5d67a6f2-b577-3732-8524-e3424033d189",
                                                "text": "La fanfare l’avait épargné, serpentante et alignée, et les couacs qu’il avait notés au passage ne lui étaient pas spécialement destinés."
                                            },
                                            {
                                                "example_id": "1ae33c4f-9208-43b4-bcc8-d69d44fb18a5",
                                                "sense_id": "5d67a6f2-b577-3732-8524-e3424033d189",
                                                "text": "Les trois larrons se ruèrent alors vers la sortie, bousculant au passage les videurs qui, comme à l’accoutumée, n’avaient rien vu rien entendu, et ils s’égayèrent dans les rues de la petite station balnéaire en ricanant comme des gosses espiègles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20b36462-f6a8-4191-9546-324c528f0c64",
                        "source_entry_id": "2b40a73b-be81-3899-9ab1-c9816742c341",
                        "source_sense_id": "a3175aed-da4c-3299-a264-09c19d593966",
                        "target_lang_word": "incidemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incidemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b914a3f6-99e5-32f5-a2cc-849ac61c3099",
                                        "entry_id": "8829decd-2b3b-31aa-b370-46136353affb",
                                        "glosses": [
                                            "Par incident, d’une manière incidente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced6d58a-1820-4929-95ea-abb18f67e8cc",
                                                "sense_id": "b914a3f6-99e5-32f5-a2cc-849ac61c3099",
                                                "text": "M. Leibnitz, qui n'entre dans la querelle qu’à cette occasion et très incidemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                        "entry_id": "8829decd-2b3b-31aa-b370-46136353affb",
                                        "glosses": [
                                            "Par connexité, par suite."
                                        ],
                                        "tags": [
                                            "Pratique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e534cea-638d-4440-ae9b-de5e5f44c947",
                                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                                "text": "Cet homme est défendeur au principal, et incidemment demandeur par ses défenses."
                                            },
                                            {
                                                "example_id": "c5485d2c-e5ee-4c6a-badf-5fc54cd5041a",
                                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                                "text": "Il s’est constitué incidemment demandeur."
                                            },
                                            {
                                                "example_id": "a0e31284-f333-4360-8b40-f0aff27cad2e",
                                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                                "text": "On n’a traité cette question qu’incidemment."
                                            },
                                            {
                                                "example_id": "8b4abb65-f65b-48e3-8480-ae2b8b9345fc",
                                                "sense_id": "23787b7d-b9ba-3af6-9dcd-dfbc0cd30b39",
                                                "text": "Il en a parlé incidemment dans son histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
