                    "frequency": "High",
                    "semantic_group_id": "habillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il préfère porter des <w>bretelles</w> plutôt qu'une ceinture pour tenir son pantalon de costume."
                        },
                        {
                            "text": "La jeune femme a discrètement remis la <w>bretelle</w> de sa robe d'été en place."
                        }
                    ],
                    "common_phrases": [
