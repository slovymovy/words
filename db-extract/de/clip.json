                "senses": [
                    {
                        "sense_id": "ff90be27-269a-35b9-8ead-fd2255983704",
                        "entry_id": "2b053f77-c7ee-3ae3-bb0f-81ee544ca2ac",
                        "glosses": [
                            "mechanische Halterung (oft mit zwei Schenkeln, die man öffnen und schließen kann)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61de60ae-c2cf-443d-8a79-2591f032ba50",
                                "sense_id": "ff90be27-269a-35b9-8ead-fd2255983704",
                                "text": "Boshaft ist, jemandem die Clips an den Hosenträgern unbrauchbar zu machen."
                            },
                            {
                                "example_id": "d2fc4f49-a273-4287-b9ae-87fba1b0441e",
                                "sense_id": "ff90be27-269a-35b9-8ead-fd2255983704",
                                "text": "Jeder bekam einen Clip mit dem Namen seines Unternehmens und dem eigenen Aufgabenbereich."
                            },
                            {
                                "example_id": "808175fb-7c8f-4c39-b6ef-f849536a3349",
                                "sense_id": "ff90be27-269a-35b9-8ead-fd2255983704",
                                "text": "Der Clip zum Pulsmessen wird einfach am Ohrläppchen befestigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18e4c55f-6f5e-39a6-813d-0e8b4ea34522",
                        "entry_id": "2b053f77-c7ee-3ae3-bb0f-81ee544ca2ac",
                        "glosses": [
                            "Videoclip, kurzes Filmstück, audiovisuelle Sequenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e3fc68-1158-4271-bf89-7bf51c126a38",
                                "sense_id": "18e4c55f-6f5e-39a6-813d-0e8b4ea34522",
                                "text": "Morgen drehen wir einen Clip, in dem erklärt wird, wie man das Waschmaschinensieb reinigt."
                            },
                            {
                                "example_id": "5212164b-fdba-4050-beeb-61c57b2cf910",
                                "sense_id": "18e4c55f-6f5e-39a6-813d-0e8b4ea34522",
                                "text": "„Roth entdeckte auch, dass er selbst stark auf YouTube vertreten war, und schickte die schmeichelhafteren Clips seinen Freunden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5e4f0827-e801-36ae-a9d0-7bc57e76a59d",
                        "entry_id": "2b053f77-c7ee-3ae3-bb0f-81ee544ca2ac",
                        "glosses": [
                            "Kurzfilm, der ein Musikstück filmisch umsetzt, kurzes Musikvideo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c59b9ec-2fc0-4b4e-aa53-7c94b962de60",
                                "sense_id": "5e4f0827-e801-36ae-a9d0-7bc57e76a59d",
                                "text": "Morgen drehen wir den Clip zur neuen Single."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3f861061-a327-3f56-9096-30b22049bbb7",
                        "entry_id": "2b053f77-c7ee-3ae3-bb0f-81ee544ca2ac",
                        "glosses": [
                            "Einzelbild/einzelne Grafik einer Clipart-Sammlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7beeb55e-ae4e-4a22-9e17-4bf7a4de222d",
                                "sense_id": "3f861061-a327-3f56-9096-30b22049bbb7",
                                "text": "Wenn sie mit dieser Aufgabe fertig sind, suchen sie bitte fünf passende Clips aus unserer Sammlung 165/3 heraus."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
