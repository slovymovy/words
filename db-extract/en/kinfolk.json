                "senses": [
                    {
                        "sense_id": "231d2d84-fe21-3d51-8c45-4ba57b539d78",
                        "entry_id": "aad6fc33-06a8-31aa-8c22-a480c66b2679",
                        "glosses": [
                            "Relatives, relations."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "31e9ea9b-3e6c-418c-a9a9-1d05d09d09a6",
                                "sense_id": "231d2d84-fe21-3d51-8c45-4ba57b539d78",
                                "text": "‘You have kinfolks here though. Women. That used to live in this house.’"
                            },
                            {
                                "example_id": "0257bb05-6eab-434d-b26a-946e93b02f67",
                                "sense_id": "231d2d84-fe21-3d51-8c45-4ba57b539d78",
                                "text": "“Ah, woe is me! Alas, for my kingdom and my kinfolk!”"
                            },
                            {
                                "example_id": "56e8647b-cbe7-4b29-92a7-8fed3d73cb2a",
                                "sense_id": "231d2d84-fe21-3d51-8c45-4ba57b539d78",
                                "text": "That says something about the nature of man—his fantasies of death that get enacted into the slaughter of man by man—kinfolk or strangers in droves—on every possible mindless occasion."
                            },
                            {
                                "example_id": "55ffc4c0-0380-4745-8c8f-adfdd7bdd49a",
                                "sense_id": "231d2d84-fe21-3d51-8c45-4ba57b539d78",
                                "text": "I'm in the 'land gettin' smoked with my kinfolk"
                            },
                            {
                                "example_id": "94b66e29-3b01-4444-9b44-cffe18b2c8ff",
                                "sense_id": "231d2d84-fe21-3d51-8c45-4ba57b539d78",
                                "text": "Three 6 Mafia, them my kinfolk."
                            }
                        ]
                    }
                ],
