                "senses": [
                    {
                        "sense_id": "d60f1dff-4222-3f6a-8faf-216366258796",
                        "entry_id": "974cc823-fc4f-32a0-8643-459c02bd2d82",
                        "glosses": [
                            "A female demon which comes to men, especially monks, in their dreams to seduce them and have sexual intercourse, drawing energy from the men to sustain themselves, often until the point of exhaustion or death."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7edd56a9-20c4-430e-8883-b34e823c4e00",
                                "sense_id": "d60f1dff-4222-3f6a-8faf-216366258796",
                                "text": "1977 Italo Calvino, The Castle of Crossed Destinies, Part 2, Chapter 5, 1969. Translated from Italian by William Weaver.\nWhen the Sabbath is caught by the first ray of the rising sun, all the witches and the vampires, incubi and succubi, take flight, some transforming themselves into noctules, some into other bats, some into still other species of Chiroptera."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf7a28fb-2b8f-340d-8ab3-042793dd14b2",
                        "entry_id": "974cc823-fc4f-32a0-8643-459c02bd2d82",
                        "glosses": [
                            "A strumpet, whore or prostitute."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2e58374-b96f-41b1-9075-26c5be59a9b7",
                        "source_entry_id": "974cc823-fc4f-32a0-8643-459c02bd2d82",
                        "source_sense_description": "female demon",
                        "target_lang_word": "succube",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "succube",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                                        "entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                                        "glosses": [
                                            "Démon qui, suivant l’opinion populaire, prend l’apparence d’une femme et est censé apparaître la nuit pour abuser sexuellement d’un homme pendant son sommeil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085078c4-7944-415e-a990-bc8e004b0682",
                                                "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                                                "text": "Sa bouche était grande. Mais sans cette gloutonnerie de succube que se donnent les stars."
                                            },
                                            {
                                                "example_id": "dd5b9cb5-7230-4b8b-9c70-ab20086fe360",
                                                "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                                                "text": "— Ah, Méridiana, perle de mes bataillons de succubes ! Tu daignes enfin nous rejoindre, se réjouit le Maître comme la belle démone s’avançait."
                                            },
                                            {
                                                "example_id": "39af53c0-bd77-4599-9cc2-c5afb7130c33",
                                                "sense_id": "d0196243-fb96-3ea2-a4ca-9a913eb96100",
                                                "text": "Elle dormait la tête renversée, un de ses pieds refoulant ses couvertures, comme la succube au-dessus de laquelle le rêve bat des ailes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0bc5a42-3a6e-3dfd-84a7-0b8eac056dff",
                                        "entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                                        "glosses": [
                                            "Insulte à connotation religieuse."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0856784-ad9e-418d-ad95-4bb87aaa7759",
                                                "sense_id": "b0bc5a42-3a6e-3dfd-84a7-0b8eac056dff",
                                                "text": "– Honte à toi! Lâche! Succube! Menteuse! Parjure!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82b6b5c2-2a36-3643-a9e3-39c13577e2ed",
                                        "entry_id": "4f936529-ad3f-31c9-be09-ae38823f4310",
                                        "glosses": [
                                            "Dans le jeu Donjons et Dragons, un démon avec un pouvoir de métamorphose."
                                        ],
