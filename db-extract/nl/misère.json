                ],
                "senses": [
                    {
                        "sense_id": "0f210f9a-7286-309c-9a59-14a4663e0f16",
                        "entry_id": "966d6b9a-8cbb-3c7d-8f4c-ea22583fa119",
                        "glosses": [
                            "armoedige, ellendige toestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30d4b41d-b43b-4b3b-b2cf-acaeb5a3c040",
                                "sense_id": "0f210f9a-7286-309c-9a59-14a4663e0f16",
                                "text": "De deskundige hoopt dat de grootste misère voorbij is."
                            },
                            {
                                "example_id": "52f2436a-0bd5-46e5-8373-55e1d7ec3faa",
                                "sense_id": "0f210f9a-7286-309c-9a59-14a4663e0f16",
                                "text": "Ook hij ondervindt de economische misère aan den lijve."
                            },
                            {
                                "example_id": "5f295fa0-5262-49ec-a478-691e41a12ede",
                                "sense_id": "0f210f9a-7286-309c-9a59-14a4663e0f16",
                                "text": "De trainer verloste de speler uit zijn misère door hem te wisselen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90df2687-2232-4e71-8f24-5f7e30465753",
                        "source_entry_id": "966d6b9a-8cbb-3c7d-8f4c-ea22583fa119",
                        "source_sense_id": "0f210f9a-7286-309c-9a59-14a4663e0f16",
                        "source_sense_description": "armoedige, ellendige toestand",
                        "target_lang_word": "misery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "Great unhappiness; extreme pain of body or mind; wretchedness; distress; woe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843f3f29-76a1-4325-932a-e1f86ff408f1",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "Ever since his wife left him you can see the misery on his face."
                                            },
                                            {
                                                "example_id": "3f0b8704-e49e-4238-a8c2-0a72e7a44b28",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "For miſerie doth braueſt mindes abate, / And make them ſeeke for that they wont to ſcorne, / Of fortune and of hope at once forlorne."
                                            },
                                            {
                                                "example_id": "26192730-f9fe-4d5b-ae46-83c72117a231",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "It was not just the confusion that unhappiness brings, it was not just the loneliness, it was the despair that accompanies all those emotions that turns unhappiness into utter misery."
                                            },
                                            {
                                                "example_id": "ff8901d5-162c-47f5-abbf-dfaf3e00db22",
                                                "sense_id": "16020650-2d61-3e7f-b9f4-e85791bb44fc",
                                                "text": "Then, in January, a creeping tsunami of train cancellations, triggered by major staff absences as a result of the aggressive transmissibility of Omicron, heaped further misery on rail users."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16716ed-2583-3e91-bc56-10329fdeaa1f",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "A bodily ache or pain."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb5ed3f-e497-45f7-a46d-714d5a630e82",
                                                "sense_id": "e16716ed-2583-3e91-bc56-10329fdeaa1f",
                                                "text": "[...] and I had a misery in my left breast and shoulder. I was hurt, but knew not how or how much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a59426-a495-304a-83fb-b9e9f7ef795d",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "Cause of misery; calamity; misfortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ac0ebb5-869d-3d1f-bb74-47c6da410d92",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "poverty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cbb79ca-bef5-4de0-85be-b752972b913b",
                                                "sense_id": "4ac0ebb5-869d-3d1f-bb74-47c6da410d92",
                                                "text": "The Widdow that hath but a pan of braſſe, […]\nMuſt pay her Landlord many a groat,\nOr twil be puld out of her throat: […]\nThe rich haue all, the poore liue in miſerie: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dcf153a-95c8-32c3-9f4d-da3441ebb613",
                                        "entry_id": "e3fc0a3a-a23a-3c66-8a67-473aaa6dbc9f",
                                        "glosses": [
                                            "greed; avarice."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f57c4f40-b6b4-4169-9766-c49149988588",
                        "source_entry_id": "966d6b9a-8cbb-3c7d-8f4c-ea22583fa119",
                        "source_sense_id": "0f210f9a-7286-309c-9a59-14a4663e0f16",
                        "source_sense_description": "armoedige, ellendige toestand",
                        "target_lang_word": "misère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4830f83-b272-39ec-bf8a-dced15756cec",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Condition, état de celui qui inspire la pitié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42eff5c3-3ca4-461d-bdf6-bb2559331e1b",
                                                "sense_id": "a4830f83-b272-39ec-bf8a-dced15756cec",
                                                "text": "L’attitude de la théologie chrétienne à l’égard des juifs a été fixée dans le début du IVᵉ siècle (concile de Nicée, 325) : le judaïsme ne doit pas disparaître, il doit vivre, mais dans un état d’avilissement et de misère tel qu’il fasse nettement apparaître aux yeux des croyants comme des incroyants le châtiment infligé par Dieu à ceux qui n’ont pas voulu reconnaître la divinité de Jésus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0afdd4e7-5257-30b6-b4d9-041280f5a9c8",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "État de faiblesse et de néantise de l’homme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11c15c1a-ebe2-432d-8365-eeb30b632c5c",
                                                "sense_id": "0afdd4e7-5257-30b6-b4d9-041280f5a9c8",
                                                "text": "[…] il est également dangereux à l'homme de connaître Dieu sans connaître sa misère, et de connaître sa misère sans connaître le Rédempteur qui peut l'en guérir."
                                            },
                                            {
                                                "example_id": "e6cb0ba1-9a79-4128-8ff2-d14fab44cdd1",
                                                "sense_id": "0afdd4e7-5257-30b6-b4d9-041280f5a9c8",
                                                "text": "Le dogme de l’incurable méchanceté de l’homme a, d’ailleurs, chez certains de ses adeptes, une autre racine : un plaisir romantique à évoquer la race humaine murée dans une misère fatale et éternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Privation des choses nécessaires à la vie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f570a218-c9da-446c-b0ea-44b2e390ad0b",
                                                "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                                "text": "La misère qui règne est indescriptible. Les troupes ont transformé les environs en un vaste désert, où il ne reste plus un habitant, plus une tête de bétail, plus un boisseau de grain. L'intendance ne réussit plus à pourvoir aux besoins de tous les ventres affamés dont elle a la charge."
                                            },
                                            {
                                                "example_id": "8cac37b7-cd53-4d8b-8927-6985a99c64d9",
                                                "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                                "text": "La Pauvreté, ah ! la garce ! Elle va dans un cortège d’humiliations, de basses rancunes, de fangeuses abdications. Elle traîne, derrière elle, sa sœur la Misère, au rire édenté, aux orbites desséchées, aux doigts mous."
                                            },
                                            {
                                                "example_id": "f408dadf-6822-4083-b897-c93d85ea6feb",
                                                "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                                "text": "Ayant une suffisante connaissance des taudis de Marseille, je m’imaginais que leur misère n’était guère dépassable."
                                            },
                                            {
                                                "example_id": "a69e5f44-9087-4be1-bdc9-2a78b4d20e05",
                                                "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                                "text": "Comme approchait le jour de l’inauguration du nouveau président, le désordre, la crainte et la misère étendaient leur empire."
                                            },
                                            {
                                                "example_id": "7bc638ae-3a4a-4fbe-a56e-898fe7ce1b67",
                                                "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                                "text": "— Nous ne sommes peut-être pas riches, mais tu ne vas pas aller faire la plonge comme si nous étions à la misère, non !"
                                            },
                                            {
                                                "example_id": "6b6cffe6-8d61-4599-bad9-821c614be73b",
                                                "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                                "text": "— Si c’est de l’enterrement, que tu veux parler, dit Julien, sois tranquille, je payerai ma part.\nPaul ne répond que par un haussement d’épaules et le père s’empresse de dire :\n— C’est à moi que ça revient. Je ne suis pas à la misère."
                                            },
                                            {
                                                "example_id": "3d213ca5-0a2e-49a2-9ffa-d7d610d367d0",
                                                "sense_id": "2e3674ed-31e7-3782-9965-277bf1143a20",
                                                "text": "C’était la misère, ils n’avaient pas de moyens, mais pour nous la musique était bien plus importante que la richesse, c’est ce qui nous a forgés mentalement et socialement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e2baef1-1767-3eb0-a24f-44d8241295cf",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Au XVIIIᵉ siècle, chanson anonyme décrivant les épreuves et malheurs de certaines professions."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e816a436-77b6-450e-9723-dc6d2abe2e48",
                                                "sense_id": "1e2baef1-1767-3eb0-a24f-44d8241295cf",
                                                "text": "Au XVIIIᵉ siècle est apparu un nouveau genre, celui des complaintes des métiers, poèmes populaires anonymes qui décrivaient les épreuves et malheurs de certaines professions. Ces textes qui firent le bonheur des éditeurs de colportage étaient intitulés Misères. Je possède quelques-uns de ces livrets : La Misère des clercs de procureurs, La Misère des garçons chirurgiens, La Misère des apprentis imprimeurs […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42db27c2-1e12-343c-a47c-fa4e53389d1b",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Bagatelle, chose de peu d’importance et de valeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "131e8409-4ed2-4e9b-b9d8-5019224df0db",
                                                "sense_id": "42db27c2-1e12-343c-a47c-fa4e53389d1b",
                                                "text": "On ne s’étonnera donc pas du sang-froid avec lequel il accueillit les applaudissements de la Société Royale ; il était au-dessus de ces misères, n’ayant pas d’orgueil et encore moins de vanité […]"
                                            },
                                            {
                                                "example_id": "0c7cace6-9f4c-42e1-ad97-3073a2981261",
                                                "sense_id": "42db27c2-1e12-343c-a47c-fa4e53389d1b",
                                                "text": "C’est une vieille R5 blanche qui agonise. Je l’ai achetée parce qu’elle valait une misère."
                                            },
                                            {
                                                "example_id": "4981e935-8583-4b27-b4bf-43c68f9c480f",
                                                "sense_id": "42db27c2-1e12-343c-a47c-fa4e53389d1b",
                                                "text": "Alphonse lui-même, qui semblait encore le meilleur de tous, eh bien ! ma chère, il s’est brouillé avec moi pour une misère."
                                            },
                                            {
                                                "example_id": "15ed040d-2705-432e-87d5-627edcf3b217",
                                                "sense_id": "42db27c2-1e12-343c-a47c-fa4e53389d1b",
                                                "text": "Il a l’air de se bien porter, mais il a toujours quelques misères de santé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb138310-7848-372e-90e2-176907015dcc",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Pénis."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c6669e-6161-4366-a5f9-8b67b94078ba",
                                                "sense_id": "cb138310-7848-372e-90e2-176907015dcc",
                                                "text": "« Cachez votre misère, père Milon, allons il y a des enfants. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0445bba-9eb0-3cf2-9ebd-b77e0c696503",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Nom usuel de diverses plantes ornementale du genre Tradescantia, de la famille des commélinacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0026451d-9634-4498-8e7e-058637f1b61a",
                                                "sense_id": "e0445bba-9eb0-3cf2-9ebd-b77e0c696503",
                                                "text": "Les angles des murs garnis de haut en bas de plantes vertes, d’aucubas et de misères approfondissaient le silence en lui donnant cette aspiration, cette délectation de soi qu’il connaît en forêt et qui lui donne comme un bruit d’ailes."
                                            },
                                            {
                                                "example_id": "f36f9a5e-081b-4ecd-b507-ac7a717509b1",
                                                "sense_id": "e0445bba-9eb0-3cf2-9ebd-b77e0c696503",
                                                "text": "Ces formations filamenteuses, observées pour la première fois dans les cellules du pollen de Tradescantia (nom populaire: misère), furent baptisées chromosomes par Waldeyer en 1888."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a3e7900-a0a4-31b8-9504-9c3485dfc2e0",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Difficulté. → voir avoir de la misère"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8085ca1-d9f4-4098-b03c-219e3e48c1f2",
                                                "sense_id": "2a3e7900-a0a4-31b8-9504-9c3485dfc2e0",
                                                "text": "C’est une grande misère que les meilleurs procès."
                                            },
                                            {
                                                "example_id": "851412e8-a5f1-4af5-b7ab-5aa2db96045b",
                                                "sense_id": "2a3e7900-a0a4-31b8-9504-9c3485dfc2e0",
                                                "text": "C’est une misère que d’avoir affaire à lui."
                                            },
                                            {
                                                "example_id": "e7a4ab5b-5772-4980-b331-7aa8b3416e01",
                                                "sense_id": "2a3e7900-a0a4-31b8-9504-9c3485dfc2e0",
                                                "text": "Mais j'eus bien des misères à l'école avec tous ces nombres ! Avec le calcul c'était encore pire."
                                            },
                                            {
                                                "example_id": "872ede76-6ccc-4c1a-a4bd-cfc4621c643a",
                                                "sense_id": "2a3e7900-a0a4-31b8-9504-9c3485dfc2e0",
                                                "text": "Je partis de Paris, j'y revins et, me trouvant sans place, j'eus beaucoup de misère. […]. Les années 1865-66-67 ne furent pas brillantes pour les coiffeurs, et surtout pour moi, qui exerce cette profession."
                                            },
                                            {
                                                "example_id": "113d59c0-7ac9-4f2d-b55f-0c7f6606658f",
                                                "sense_id": "2a3e7900-a0a4-31b8-9504-9c3485dfc2e0",
                                                "text": "— Ceux qui s’en vont sont bien tranquilles. Toute la misère est pour ceux qui restent."
                                            },
                                            {
                                                "example_id": "7918d244-37e0-4347-bba3-3be8349ed41a",
                                                "sense_id": "2a3e7900-a0a4-31b8-9504-9c3485dfc2e0",
                                                "text": "Il y avait une jeune fille qui servait comme domestique chez des gens riches et qui avait à supporter mille misères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025804c4-3b3c-36a2-965b-53c7f7b637bd",
                                        "entry_id": "412f1aad-4d65-3ec1-b9de-c5d8395e9f27",
                                        "glosses": [
                                            "Malchance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd9813d7-2ade-447c-ad00-47c23befcea5",
                                                "sense_id": "025804c4-3b3c-36a2-965b-53c7f7b637bd",
                                                "text": "C’était la poisse, la pouille, la misère, la débine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "misère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ed0589f-22cd-3d12-8d04-237f574d369b",
                                        "entry_id": "fbea7365-f7f7-3af7-ae2e-4acb8301a9f0",
                                        "glosses": [
                                            "S’emploie pour marquer la consternation, le désespoir ou l’exaspération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06a84af8-9fac-471a-8689-7f8b1d4c3ca3",
                                                "sense_id": "2ed0589f-22cd-3d12-8d04-237f574d369b",
                                                "text": "Qu’est-ce qu’il y a ? Ah ! misère, le pauvre enfant est blessé !"
                                            },
                                            {
                                                "example_id": "8482f6c6-7bfa-4aa8-880e-6379bfcceb98",
                                                "sense_id": "2ed0589f-22cd-3d12-8d04-237f574d369b",
                                                "text": "La concierge, Mme Misère. C’est papa qui l’appelée comme ça, parce qu’elle gémit tout le temps : « Misère, misère ! »."
                                            },
                                            {
                                                "example_id": "85d91f8d-f4e5-469e-ae46-9d87d47d35fa",
                                                "sense_id": "2ed0589f-22cd-3d12-8d04-237f574d369b",
                                                "text": "Alors - alors\nQue faire ? Que faire ?\nMisère, misère\nTant pis\nEt puis on s'est souri !"
                                            },
                                            {
                                                "example_id": "5235abd4-aec9-45bb-b4d6-74b11d224058",
                                                "sense_id": "2ed0589f-22cd-3d12-8d04-237f574d369b",
                                                "text": "Misère, misère !… Ah, vous ne pouvez pas comprendre, vous les soldats qui êtes en plein dans l’action, les sentiments qui nous animent à l’arrière."
                                            },
                                            {
                                                "example_id": "65b28f48-45ab-4de6-a173-477c055020eb",
                                                "sense_id": "2ed0589f-22cd-3d12-8d04-237f574d369b",
                                                "text": "La décision initiale de Radio-­Canada de censurer un épisode d’une série-culte est complètement ridicule. Misère ! On parle ici d’une série ubuesque, où les lits sont verticaux et les vidanges sont sacrées !"
                                            }
                                        ]
                                    }
                                ]
                            },
