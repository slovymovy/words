                "senses": [
                    {
                        "sense_id": "5369aa94-3c84-391f-ace4-3626d1b9df27",
                        "entry_id": "928e549d-ebf3-377f-8f99-efd40abd0787",
                        "glosses": [
                            "Person, die Reinigungsarbeiten verrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bba2784-b051-4a97-a82a-79cc4a563fcb",
                                "sense_id": "5369aa94-3c84-391f-ace4-3626d1b9df27",
                                "text": "„Renate arbeitete jetzt als Putzhilfe bei uns im Haushalt für zwei Mark fünfzig in der Stunde und bei Rautenbergs für drei Mark fünfzig.“"
                            },
                            {
                                "example_id": "a992a0b8-c8c9-4f5a-896d-53e1839568ea",
                                "sense_id": "5369aa94-3c84-391f-ace4-3626d1b9df27",
                                "text": "„Dreimal waren sie zusammen in Feldafing, mein Vater hatte seine Geliebte einfach als Putzhilfe ausgegeben und als unabkömmlich für seinen Haushalt eingestuft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
