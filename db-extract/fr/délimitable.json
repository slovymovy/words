                        "glosses": [
                            "Qui peut être délimité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfbad16d-7f60-4d0c-96c2-20de473b2f5a",
                                "sense_id": "c0a111bb-8b6a-32fb-a5fa-5e3460fec63e",
                                "text": "Cette tumeur, à la palpation, se montre dure, noduleuse ; elle a l’étendue d’une paume de main, elle est bien délimitable en bas et à droite, non délimitable en haut et à gauche."
                            },
                            {
                                "example_id": "8a9d8c8e-06ed-4412-8690-499ba81bae15",
                                "sense_id": "c0a111bb-8b6a-32fb-a5fa-5e3460fec63e",
                                "text": "Un exemple : classiquement, pour faire usage d’armes de guerre, il faut se trouver dans une zone de conflit armé, un lieu délimitable ; or, le drone chasseur-tueur est utilisé pour frapper n’importe où, dans des zones où la guerre n’est pas déclarée : la Somalie, le Yémen, le Pakistan…"
                            },
                            {
                                "example_id": "b47ca9a6-4cac-4e8b-9c8e-8da49bbcc6ef",
                                "sense_id": "c0a111bb-8b6a-32fb-a5fa-5e3460fec63e",
                                "text": "Nous avons opté pour l'île de la Cité car c’est un lieu facilement délimitable et déjà \"fémininisé\" grâce à Notre-Dame, qui incarne vraiment ce qu’est Paris."
                            }
                        ]
                    }
