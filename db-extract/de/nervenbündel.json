                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9da7753b-33f9-3513-bef5-a58a7eb32476",
                        "entry_id": "791523fe-ed39-3e37-b6a0-d5f9254bd934",
                        "glosses": [
                            "Person, die nervlich überfordert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51539501-f4f6-42f4-bd7a-22efdb441f43",
                                "sense_id": "9da7753b-33f9-3513-bef5-a58a7eb32476",
                                "text": "„Sie brachten es fertig, gestandene Wüstenfüchse, die es wagten, um Nachschlag zu bitten, zu zitternden Nervenbündeln zu machen.“"
                            },
                            {
                                "example_id": "561e1c3d-3097-4add-b3ad-050524868067",
                                "sense_id": "9da7753b-33f9-3513-bef5-a58a7eb32476",
                                "text": "„Schon damals, als sie in der zehnten Klasse angefangen hatte, sich mit Viđar zu treffen, war sie das reinste Nervenbündel gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
