                "senses": [
                    {
                        "sense_id": "8b0cba5b-9a3f-340e-9320-9a5cc28761a4",
                        "entry_id": "b77365f7-96f8-3e94-8ecd-bbb92f1fb8f3",
                        "glosses": [
                            "Bildung, Produktion des Pigments Melanin"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7be97139-b4e1-4710-ab32-e7b200024cd6",
                                "sense_id": "8b0cba5b-9a3f-340e-9320-9a5cc28761a4",
                                "text": "„Es handelt sich um eine angeborene Störung der Melaninherstellung in Haut, Haaren und Augen.“"
                            },
                            {
                                "example_id": "b55546bb-0246-419f-9e26-e3457f9a69ac",
                                "sense_id": "8b0cba5b-9a3f-340e-9320-9a5cc28761a4",
                                "text": "„Der Albinismus ist eine angeborene Stoffwechselerkrankung mit Störung der Melaninherstellung (Haut, Haare, Augen).“"
                            },
                            {
                                "example_id": "bc643983-9c46-4ef2-a7e3-861cd7ad8cfa",
                                "sense_id": "8b0cba5b-9a3f-340e-9320-9a5cc28761a4",
                                "text": "„Des Weiteren kann die angeborene Stoffwechselstörung PKU (Phenylketonurie) die Melaninherstellung so behindern, dass die Betroffenen eine sehr helle Haut und dazu blonde Haare haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
