                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b047f1e-34b4-43eb-a859-f853a85f1172",
                                "sense_id": "08e790a0-7610-31a7-ba50-9e4782b48ebd",
                                "text": "Здесь геро́й наш понево́ле отступи́л наза́д и погляде́л на него́ при́стально.",
                                "translation": "At this our hero involuntarily stepped back and stared at him.",
                                "english": "At this our hero involuntarily stepped back and stared at him."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
