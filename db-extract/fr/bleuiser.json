                ],
                "senses": [
                    {
                        "sense_id": "5089eea1-57b0-337d-93c5-d597dfffe76a",
                        "entry_id": "921af291-2408-325e-9e24-57dc5e452666",
                        "glosses": [
                            "Rendre bleu, donner un caractère bleu à. Variante de bleuir."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c81d4241-cbd3-40d9-961d-5ea4ccfb1132",
                                "sense_id": "5089eea1-57b0-337d-93c5-d597dfffe76a",
                                "text": "En l'honneur de la nouvelle chanson d'un de mes groupes préférés, Blue des BIG BANG, j'ai décidé de \"bleuiser\" mes ongles!"
                            },
                            {
                                "example_id": "83a8f7b1-3e69-4379-abcb-d868e8e2740f",
                                "sense_id": "5089eea1-57b0-337d-93c5-d597dfffe76a",
                                "text": "Au Moyen Age, le bleu était une couleur protectrice et divine (contre les forces du mal, toussa toussa) et comme c’était les garçons le sexe important, il a été décidé de les bleuiser pour leur bien."
                            },
                            {
                                "example_id": "0196c290-c0a8-4c0f-b525-47c82dde456e",
                                "sense_id": "5089eea1-57b0-337d-93c5-d597dfffe76a",
                                "text": "Ben, sinon faut choper des bonshommes normaux, et les bleuiser."
                            },
                            {
                                "example_id": "db91c419-4f1a-4248-bff2-dc0bc64cee5a",
                                "sense_id": "5089eea1-57b0-337d-93c5-d597dfffe76a",
                                "text": "Imprégner, rassurer, calmer..\"bleuiser\" (en note :) à ne pas confondre avec bleuir..(de peur...)"
                            }
                        ]
                    },
                    {
                        "sense_id": "c6ada20e-adc8-342c-bb0d-4a415a39310e",
                        "entry_id": "921af291-2408-325e-9e24-57dc5e452666",
                        "glosses": [
                            "Transformer des liens rouges en liens bleus, par la création de contenu. Variante de bleuir."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
