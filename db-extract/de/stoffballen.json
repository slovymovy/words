                    {
                        "translation_id": "730cd5e2-abe9-4d62-be58-4ddf0ef96cb4",
                        "source_entry_id": "1bc9bc8f-f807-3c89-89f2-0d9e48a2d441",
                        "source_sense_id": "d2b15f72-c79b-3262-8b0b-33254ee857f1",
