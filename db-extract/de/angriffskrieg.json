                        "target_lang_word": "war of aggression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "war of aggression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de3d02fb-0b6d-3548-b9c7-d8df1f0fd342",
                                        "entry_id": "55d3ca4d-0400-3982-94cb-6d180aae2f9e",
                                        "glosses": [
                                            "A military conflict waged without the justification of self-defense, usually for territorial gain and subjugation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67bd15c9-d21d-445f-9569-085188f0295a",
                                                "sense_id": "de3d02fb-0b6d-3548-b9c7-d8df1f0fd342",
                                                "text": "The crime of war, the crime of the war of aggression, and the crime of aggression are clearly three different crimes with three different facts of the case. For a complex judgment of war, they nonetheless overlap with one another, and their separation seems to a large section of public opinion a mere juridical artifice."
                                            }
                                        ]
                                    }
                                ]
