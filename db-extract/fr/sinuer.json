                "senses": [
                    {
                        "sense_id": "68fbd5a0-ee36-3c22-b291-b6c811794228",
                        "entry_id": "c435b896-70ad-349a-a06f-c402544ed4cd",
                        "glosses": [
                            "Tourner fréquemment, changer souvent de direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef017ef5-8464-410c-8813-e9a2647cb38b",
                                "sense_id": "68fbd5a0-ee36-3c22-b291-b6c811794228",
                                "text": "Les hommes, silencieux, sinuaient à travers les hauts portants, découvrant à chaque détour un feu nouveau, et marchaient dans une route de flammes."
                            },
                            {
                                "example_id": "cb289bb9-7cd4-460d-b1de-da9da083e670",
                                "sense_id": "68fbd5a0-ee36-3c22-b291-b6c811794228",
                                "text": "Et c'est pour lui […] une chronique qui sinue à travers cent anecdotes tissée de bons mots, de plaisanteries, d'humour wallon."
                            },
                            {
                                "example_id": "026cfd92-8b06-4bca-92b3-765c6c25e980",
                                "sense_id": "68fbd5a0-ee36-3c22-b291-b6c811794228",
                                "text": "La route sinue entre les montagnes."
                            }
                        ]
                    }
                ],
