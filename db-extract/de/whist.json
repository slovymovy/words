                "senses": [
                    {
                        "sense_id": "7bc48dd1-f8f5-3b26-ba39-0725621be90a",
                        "entry_id": "66bfe6e0-0490-387b-a9e0-24459d3f272f",
                        "glosses": [
                            "Kartenspiel aus England für vier Personen mit französischem Blatt (52 Karten), Vorläufer von Bridge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2286ec17-cbf3-49cb-bdd6-b5705f39660f",
                                "sense_id": "7bc48dd1-f8f5-3b26-ba39-0725621be90a",
                                "text": "„Er war ganz Soldat und ging darin auf. Nun hat er nichts zu tun und steht im Tattersall umher oder besucht den Club, ja, fast läßt sich sagen, er lebe da. Vor Tisch liest er Zeitungen, nach Tisch spielt er Whist oder Billard […].“"
                            },
                            {
                                "example_id": "b608624d-a5cc-4af5-b931-514591460986",
                                "sense_id": "7bc48dd1-f8f5-3b26-ba39-0725621be90a",
                                "text": "„Der Graf entschloß sich zu einer Partie Whist, und Walpole begann ein Primspiel mit der Gräfin, die offensichtlich mogelte.“"
                            },
                            {
                                "example_id": "09e73863-e86d-4927-aacb-79070e6a839b",
                                "sense_id": "7bc48dd1-f8f5-3b26-ba39-0725621be90a",
                                "text": "„Und die Frau war ausgegangen, um Karten zu spielen, so eine Art Whist, was sie Bridge nennen, wobei sie einander sagen, was sie in der Hand haben, und dann erst ausspielen.“"
                            },
                            {
                                "example_id": "4717e80e-b0df-48da-a130-0bba8c85ebb9",
                                "sense_id": "7bc48dd1-f8f5-3b26-ba39-0725621be90a",
                                "text": "„Der beste Schachspieler der Christenheit ist vielleicht nicht mehr als eben nur der beste Schachspieler; die Tüchtigkeit und Gewandtheit im Whist lassen aber auf einen feinen Kopf schließen, der überall, wo der Geist mit dem Geist kämpft, des Erfolges sicher sein kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
