                        "examples": [
                            {
                                "example_id": "a795fa5b-b498-4409-97f4-d7cd01e2141c",
                                "sense_id": "abbd1c10-a69c-3666-bfa3-9c87e9870250",
                                "text": "On a baissé l’électricité, et sa lumière plus jaune brouille les pavots modern-style de la frise."
                            },
                            {
                                "example_id": "1c301760-694e-4b33-9102-3e4c8025c7b1",
                                "sense_id": "abbd1c10-a69c-3666-bfa3-9c87e9870250",
                                "text": "Madame Dax loua sans réserve l’élégance du mobilier modern-style, et le bon goût des tableaux accrochés aux murs."
                            },
                            {
                                "example_id": "3e9ae6a5-08f8-48e0-8c59-6af357643287",
                                "sense_id": "abbd1c10-a69c-3666-bfa3-9c87e9870250",
                                "text": "La robe la plus modern-style, quand ce n’est pas tout simplement la plus chère, les tente dix fois plus que celle qui conviendrait le mieux à leur genre de beauté."
                            }
                        ]
                    }
