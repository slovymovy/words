                "senses": [
                    {
                        "sense_id": "78274018-9a50-35ff-941e-c1ef3931ec55",
                        "entry_id": "4a3b3a24-df5d-305f-8e11-150207029e63",
                        "glosses": [
                            "paradiesischer Ort in den Tropen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48081e0-80a9-4696-99da-c757e1ad6148",
                                "sense_id": "78274018-9a50-35ff-941e-c1ef3931ec55",
                                "text": "„Das Angebot lautete: vier Monate bezahlter Urlaub in einem Tropenparadies, sechs Monate, wenn die Dreharbeiten sich verzögerten, und vielleicht weniger Paradies, wenn die Rebellen vor Ort ein bisschen zu selbstbewusst würden, und vielleicht eher Arbeit als Urlaub und eher schlecht als gut bezahlt, aber unterm Strich bedeutete es eine Erholungspause von meinem amerikanischen Asyl.“"
                            },
                            {
                                "example_id": "73dd63d4-6cb6-444f-98eb-7e2fd7298170",
                                "sense_id": "78274018-9a50-35ff-941e-c1ef3931ec55",
                                "text": "„Alles muss den Anschein von Normalität haben, und was ist normaler als eine Ladung Obst aus einem Tropenparadies.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
