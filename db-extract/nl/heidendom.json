                    }
                ],
                "translations": [
                    {
                        "translation_id": "6df6c6bc-d8da-47a7-aa49-55a07a5a8a8c",
                        "source_entry_id": "8e22067e-afc5-3a02-9806-1b5b7d08ea4d",
                        "source_sense_id": "a38be125-3fa2-31e1-a1bb-7a610258b647",
                        "source_sense_description": "een verzamelnaam voor de polytheïstische religies waarmee het zich verspreidende christendom in aanraking kwam",
                        "target_lang_word": "Heidentum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heidentum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e28dddd0-b8ab-385f-953a-d482f0ca210f",
                                        "entry_id": "b223782f-e97a-329d-965d-95c029813368",
                                        "glosses": [
                                            "Zustand des Nicht-zum-Christentum-bekehrt-Seins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb3927e7-d3a5-4564-b44a-57b41a9d5690",
                                                "sense_id": "e28dddd0-b8ab-385f-953a-d482f0ca210f",
                                                "text": "„Kurz: Nicht das Christentum, sondern das Heidentum sei die für Europa adäquate, passende Religion.“"
                                            },
                                            {
                                                "example_id": "909acc34-a53b-4054-b1cc-95f6d0079bc7",
                                                "sense_id": "e28dddd0-b8ab-385f-953a-d482f0ca210f",
                                                "text": "„Das Heidentum scheint nicht nur in den erst im Spätmittelalter bekehrten baltischen Landschaften, sondern auch im kernchristlichen Italien bis in die Zeit der Gegenreformation hinein eine selbstbewusste Kultur mit gutem Gewissen und einer solide durchgearbeiteten, fast schon theologisch reflektierten Tradition gewesen zu sein.“"
                                            },
                                            {
                                                "example_id": "5f8542ab-6fc2-4754-b667-3263c45f3f6d",
                                                "sense_id": "e28dddd0-b8ab-385f-953a-d482f0ca210f",
                                                "text": "„Trotz leichter Unterschiede in den verschiedenen Schwerpunktsetzungen lässt sich an den Themen der Berichte feststellen, dass es den Missionaren in Kamerun vor allem um eine Art Kreuzzug des Christentums gegen das Heidentum ging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c60198b-bef2-3cd0-9322-fcbbaf029f1a",
                                        "entry_id": "b223782f-e97a-329d-965d-95c029813368",
                                        "glosses": [
                                            "Gesamtheit aller Nichtchristen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e1098f-6d03-4b63-b0c4-b328a0c97ae4",
                                                "sense_id": "5c60198b-bef2-3cd0-9322-fcbbaf029f1a",
                                                "text": "„Trotz leichter Unterschiede in den verschiedenen Schwerpunktsetzungen lässt sich an den Themen der Berichte feststellen, dass es den Missionaren in Kamerun vor allem um eine Art Kreuzzug des Christentums gegen das Heidentum ging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2b4e862-0cb3-4031-a745-02fe9bd19d23",
                        "source_entry_id": "8e22067e-afc5-3a02-9806-1b5b7d08ea4d",
                        "source_sense_id": "a38be125-3fa2-31e1-a1bb-7a610258b647",
                        "source_sense_description": "een verzamelnaam voor de polytheïstische religies waarmee het zich verspreidende christendom in aanraking kwam",
                        "target_lang_word": "paganism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paganism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef018ff0-2a0b-39c4-a96f-e8f6f4e16ddd",
                                        "entry_id": "ed1f96ed-56dc-3e97-81c4-3d65f59e6222",
                                        "glosses": [
                                            "Any indigenous polytheistic religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3c09f8-64ae-4091-a725-f0ba7e1be4d3",
                                                "sense_id": "ef018ff0-2a0b-39c4-a96f-e8f6f4e16ddd",
                                                "text": "Most people in that region practise their own form of paganism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73b70e22-9723-33b8-b118-975ca7884910",
                                        "entry_id": "ed1f96ed-56dc-3e97-81c4-3d65f59e6222",
                                        "glosses": [
                                            "Any of a class of religions often associated with nature rituals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ecca89-bd6f-40c7-b290-7c80d4f093ba",
                                                "sense_id": "73b70e22-9723-33b8-b118-975ca7884910",
                                                "text": "Various neopagan movements have arisen, each advancing its own form of paganism. Some are monotheist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8611172b-4a91-4788-ad8e-85d20327fb5d",
                        "source_entry_id": "8e22067e-afc5-3a02-9806-1b5b7d08ea4d",
                        "source_sense_id": "a38be125-3fa2-31e1-a1bb-7a610258b647",
                        "source_sense_description": "een verzamelnaam voor de polytheïstische religies waarmee het zich verspreidende christendom in aanraking kwam",
                        "target_lang_word": "paganisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paganisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca905198-f8ba-34d9-a8d5-0682afab9595",
                                        "entry_id": "12b14ec1-2f82-3175-88f1-69b20e658c88",
                                        "glosses": [
                                            "Religion des païens, sorte de polythéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1515b5d9-6e6a-4271-80e8-8cda8e2ebb0d",
                                                "sense_id": "ca905198-f8ba-34d9-a8d5-0682afab9595",
                                                "text": "Le paganisme des Grecs était l’une des principales causes de la perfection de leur goût dans les arts : ces dieux, toujours près des hommes, et néanmoins toujours au-dessus d’eux, consacraient l’élégance et la beauté des formes dans tous les genres de tableaux."
                                            },
                                            {
                                                "example_id": "9711df5e-3a63-4556-bb31-388a44357121",
                                                "sense_id": "ca905198-f8ba-34d9-a8d5-0682afab9595",
                                                "text": "La Gaule était restée longtemps en dehors de cette christianisation. Pendant près de deux siècles, le paganisme résista aux entreprises de la nouvelle religion."
                                            },
                                            {
                                                "example_id": "fca763e4-2fa6-4da2-b865-42fb1db2af31",
                                                "sense_id": "ca905198-f8ba-34d9-a8d5-0682afab9595",
                                                "text": "Jamais, peut-être, pareille orgie ne s’était déroulée à la face du ciel depuis les tristes âges du paganisme, et, si je n’avais été prévenu, je me serais cru transporté par un songe diabolique dans les sentines de Suburre, dans les lupanars de Capoue."
                                            },
                                            {
                                                "example_id": "faa74e39-b123-48d4-9146-f7dec8ac445d",
                                                "sense_id": "ca905198-f8ba-34d9-a8d5-0682afab9595",
                                                "text": "L’enfance de la jeune fille s’était écoulée pâle et décolorée, au milieu de pratiques religieuses outrées, dans ce pays où la religion du Christ est plutôt un paganisme que la foi pure, noble et simple de nos contrées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
