                    {
                        "translation_id": "976b6397-5307-4300-8f25-43c8877a3731",
                        "source_entry_id": "f8c7a99a-3613-30cf-875b-b7bd24ebb7dd",
                        "source_sense_id": "4a4353e3-8f54-3bf8-80c2-c2acb283e073",
                        "target_lang_word": "silbenbildend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silbenbildend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c384f9fb-4c2b-37ad-93db-17b3ff15bea3",
                                        "entry_id": "a566a375-fd19-3e10-be6c-70625cf06939",
                                        "glosses": [
                                            "Eigenschaft von Lauten, die den Kern (Gipfel, Nukleus) einer Silbe bilden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b59ac5-39d6-41cb-9f9a-59e1928fe765",
                                                "sense_id": "c384f9fb-4c2b-37ad-93db-17b3ff15bea3",
                                                "text": "„Hinter diesem vielversprechenden Titel verbirgt sich allerdings weniger eine tiefgehende linguistische Analyse der Silbe in slawischen Sprachen, als vielmehr eine Analyse etymologischer Wörterbücher des Tschechischen und Slowakischen hinsichtlich der Häufigkeit von silbenbildenden Konsonanten in den westslawischen Sprachen.“"
                                            },
                                            {
                                                "example_id": "2c344b63-1aa0-486c-9f76-e90572e1d937",
                                                "sense_id": "c384f9fb-4c2b-37ad-93db-17b3ff15bea3",
                                                "text": "„Außer Vokalen und Diphthongen können jedoch auch Konsonanten r, ŕ, l, ĺ „silbenbildend“ sein.“"
                                            },
                                            {
                                                "example_id": "48832c95-8568-4c1f-8306-17d13c04f977",
                                                "sense_id": "c384f9fb-4c2b-37ad-93db-17b3ff15bea3",
                                                "text": "„Sie war die erste geschriebene Sprache der Geschichte, die silbenbildende Zeichen verwendete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
