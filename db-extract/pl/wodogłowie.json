                        "source_sense_id": "ac8939b4-a7b5-3637-881c-85de3a41236b",
                        "target_lang_word": "hydrocephalus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrocephalus",
