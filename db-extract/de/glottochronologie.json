                                "sense_id": "92940d11-210c-3fd8-9b25-90ecc866ea16",
                                "text": "Die Glottochronologie untersucht das Alter und die Verwandtschaftsverhältnisse von Sprachen."
                            },
                            {
                                "example_id": "56c06f9f-068d-4c50-8832-9ef0ebd3968f",
                                "sense_id": "92940d11-210c-3fd8-9b25-90ecc866ea16",
                                "text": "Die Ergebnisse der Glottochronologie werden aufgrund elementarer Probleme von vielen Linguisten bezweifelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
