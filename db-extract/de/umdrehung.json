                "senses": [
                    {
                        "sense_id": "888fbb92-fea8-3ec4-9151-579f27dfe505",
                        "entry_id": "87ee3f32-7796-328d-b6a3-ad6b6b1d3231",
                        "glosses": [
                            "vollständige Rotation um eine Drehachse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ecf122c-6668-43d2-9b88-ed6056364c91",
                                "sense_id": "888fbb92-fea8-3ec4-9151-579f27dfe505",
                                "text": "Nach jeder Umdrehung des Zahnrades wird der Zähler um eine Stelle weitergestellt."
                            },
                            {
                                "example_id": "72f3ecbd-9a90-4d19-bfdc-9a5e8dfcf266",
                                "sense_id": "888fbb92-fea8-3ec4-9151-579f27dfe505",
                                "text": "„Dass ein mit mehreren tausend Umdrehungen arbeitender Automotor ohne Übersetzung die Kraft nicht auf die Straße bekommt, ist jedermann klar - aber wozu sollte ein Getriebe bei einem Flugzeug gut sein?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "59ba0970-fae9-3aa3-90d4-bd9912c12dfd",
                        "entry_id": "87ee3f32-7796-328d-b6a3-ad6b6b1d3231",
                        "glosses": [
                            "ein Volumenprozent Alkohol in einem Getränk"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "8a30e12c-e833-41c3-8c76-406190d0fd66",
                                "sense_id": "59ba0970-fae9-3aa3-90d4-bd9912c12dfd",
                                "text": "Dieses Bier hat sieben Umdrehungen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "682211a0-aa5b-4198-972b-756073eb814f",
                        "source_entry_id": "87ee3f32-7796-328d-b6a3-ad6b6b1d3231",
                        "source_sense_id": "888fbb92-fea8-3ec4-9151-579f27dfe505",
                        "source_sense_description": "vollständige Rotation um eine Drehachse",
                        "target_lang_word": "revolution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revolution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29451873-7702-3cf6-9b23-620f146109d3",
                                        "entry_id": "3372d67d-cf76-3da4-b316-3f5359b09481",
                                        "glosses": [
                                            "A political upheaval in a government or state characterized by great change."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dcf0c53-d6ff-41d3-8a13-608e42ea6068",
                                                "sense_id": "29451873-7702-3cf6-9b23-620f146109d3",
                                                "text": "The revolution had completely transformed the monarchy into a republic."
                                            },
                                            {
                                                "example_id": "2ca27543-393e-49dd-832a-94152dcd487b",
                                                "sense_id": "29451873-7702-3cf6-9b23-620f146109d3",
                                                "text": "Una rivoluzione è certamente la cosa più autoritaria che ci sia: è l'atto per il quale una parte della popolazione impone la sua volontà all'altra parte per mezzo di fucili, baionette e cannoni; mezzi autoritari, se ce ne sono; e il partito vittorioso, se non vuole aver combattuto invano, deve continuare questo dominio col terrore che le sue armi inspirano ai reazionari."
                                            },
                                            {
                                                "example_id": "5be03480-ebdd-49e5-9420-d5b6742198ae",
                                                "sense_id": "29451873-7702-3cf6-9b23-620f146109d3",
                                                "text": "The essence of every revolution consisted and consists in putting a new class in power, thus enabling it to realize its own program in life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2752e254-efe2-33c1-8078-3c8c87567315",
                                        "entry_id": "3372d67d-cf76-3da4-b316-3f5359b09481",
                                        "glosses": [
                                            "The popular removal and replacement of a government, especially by sudden violent action."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c97c0525-c77f-468c-b4a8-7fb3bf046f4a",
                                                "sense_id": "2752e254-efe2-33c1-8078-3c8c87567315",
                                                "text": "For a long time the dormouse and polecat had seemed to him overfeeble enemies for his restless valour, even as the granary floor seemed to afford too narrow a field. Every day he read the papers of the previous day in the servants' hall of the houses he visited, and it appeared to him that this war in America, which was hailed as the awakening of the spirit of liberty and justice in the New World, ought to produce a revolution in France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f59f068-c00d-355a-883b-fbccfb03c1b3",
                                        "entry_id": "3372d67d-cf76-3da4-b316-3f5359b09481",
                                        "glosses": [
                                            "Rotation: the turning of an object around an axis, one complete turn of an object during rotation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "614cdcda-4bd4-4a7c-9375-73da40bf84f4",
                                                "sense_id": "6f59f068-c00d-355a-883b-fbccfb03c1b3",
                                                "text": "The ratio between the speeds of revolution of wheel and disc is substantially equal to the reciprocal of the ratio between the diameter of the wheel and the diameter of the mean contact circle on the disc."
                                            },
                                            {
                                                "example_id": "35f9e5f3-e3e8-448c-ae35-8a0f214f54ea",
                                                "sense_id": "6f59f068-c00d-355a-883b-fbccfb03c1b3",
                                                "text": "The Earth has two motions: a daily revolution (or turning around) upon its axis, and a yearly course around the sun."
                                            },
                                            {
                                                "example_id": "e6a7ae7c-af2e-4e64-8f15-9b38efbe8692",
                                                "sense_id": "6f59f068-c00d-355a-883b-fbccfb03c1b3",
                                                "text": "Numerous cases are recorded which incontestibly prove that during pregnancy, the uterus perform a half or even a complete revolution, on itself, producing torsion of the cervix […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b26332-4668-34f0-b4d9-498bcace6f19",
                                        "entry_id": "3372d67d-cf76-3da4-b316-3f5359b09481",
                                        "glosses": [
                                            "In the case of celestial bodies, the traversal of one body along an orbit around another body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a6c941c-5949-4240-afbd-b5535536b3f9",
                                                "sense_id": "b8b26332-4668-34f0-b4d9-498bcace6f19",
                                                "text": "It takes 365 days for the Earth to complete one revolution around the sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c5f7cb-c7bb-307d-b680-e40145f8749a",
                                        "entry_id": "3372d67d-cf76-3da4-b316-3f5359b09481",
                                        "glosses": [
                                            "A sudden, vast change in a situation, a discipline, or the way of thinking and behaving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebfe7a36-1ef3-42f2-9e20-4b4cadb9d561",
                                                "sense_id": "b1c5f7cb-c7bb-307d-b680-e40145f8749a",
                                                "text": "the AI revolution"
                                            },
                                            {
                                                "example_id": "1f450f48-797c-47d6-855c-745a105f1299",
                                                "sense_id": "b1c5f7cb-c7bb-307d-b680-e40145f8749a",
                                                "text": "Ông Kac-Mac là kinh tế học K. M. Ông ấy ngiên kứu rõ ràng tư bản chủ ngĩa, dế quốc chủ ngĩa, zai kấp tranh dấu, vân vân ở dâu mà sinh ra; lịch sử nó thế nào, hiện tượng nó thế nào, và kết quả nó sẽ ra thế nào."
                                            },
                                            {
                                                "example_id": "0c57ff96-8de1-4d32-8b41-5d554b467a9d",
                                                "sense_id": "b1c5f7cb-c7bb-307d-b680-e40145f8749a",
                                                "text": "In 1825, the first public railway carried passengers across the English countryside, setting in motion not just an engineering revolution, but an industrial one too. Imagine the awe and excitement of those first passengers as they boarded the train, unaware that they were witnessing the dawn of a new era."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b83eeda-9996-35f0-8c4f-c8738bc81007",
                                        "entry_id": "3372d67d-cf76-3da4-b316-3f5359b09481",
                                        "glosses": [
                                            "A round of periodic changes, such as between the seasons of the year."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b753f88-8342-373f-a1ea-22c9c9cfedc9",
                                        "entry_id": "3372d67d-cf76-3da4-b316-3f5359b09481",
                                        "glosses": [
                                            "Consideration of an idea; the act of revolving something in the mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd2f60e6-2dc1-4e9d-ba59-bfa2f7110e66",
                        "source_entry_id": "87ee3f32-7796-328d-b6a3-ad6b6b1d3231",
