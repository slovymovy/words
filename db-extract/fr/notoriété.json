        "fr-extract.jsonl": [
            {
                "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                "word": "notoriété",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "89bdb085-1092-4f99-b376-0ac11f82a7cf",
                        "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                        "tags": [
