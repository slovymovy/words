                        "glosses": [
                            "apparaat met sterke uv-lampen dat men kan gebruiken om snel bruin te worden, ook als de zon niet schijnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6162dab3-7b47-459d-a42d-ba4f3e2c2add",
                                "sense_id": "9e3cf59a-cfcd-325d-8f1d-d508625ae35e",
                                "text": "Binnen stuiten we op veel meer pluspunten. Er is een zwembad, een sauna en een zonnekanon. De gezellig ingerichte bar nodigt uit om het laat te maken."
                            },
                            {
                                "example_id": "2b4b7dcb-a78e-49f7-b4ef-9c1b39e91f7a",
                                "sense_id": "9e3cf59a-cfcd-325d-8f1d-d508625ae35e",
                                "text": "Op de hoesvan Sexor staat hij afgebeeld met een zorgvuldig getrimde baard en dito matje in de nek en een teint die veelvuldig gebruik van het zonnekanon doet vermoeden."
                            }
                        ]
                    }
