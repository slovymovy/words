                        "translation_id": "692b4be9-3f75-4de1-b8e7-6cb88df47412",
                        "source_entry_id": "ee4df3c8-3424-3412-82b9-76edab9d8d7b",
                        "source_sense_id": "99dc5620-5a24-31f1-9175-da0011129fee",
                        "target_lang_word": "bimbo",
