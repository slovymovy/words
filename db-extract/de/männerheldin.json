                ],
                "senses": [
                    {
                        "sense_id": "c8e8ee73-5ae5-3383-ba92-29520f0d8fac",
                        "entry_id": "1e23f243-8715-3999-86c5-414153548ce8",
                        "glosses": [
                            "Frau, die bei Männern besonders gut ankommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fab9521-42f5-4f9b-9ce0-3fcfc8b8893b",
                                "sense_id": "c8e8ee73-5ae5-3383-ba92-29520f0d8fac",
                                "text": "„›Nicht doch, aber du machtest in Madina nicht den Eindruck einer Männerheldin auf mich‹, überlegte sie laut. ›Das waren alles Weicheier mit Muskelbergen.‹“"
                            },
                            {
                                "example_id": "6a1c0b62-224f-43e5-b441-a4855ba10c6a",
                                "sense_id": "c8e8ee73-5ae5-3383-ba92-29520f0d8fac",
                                "text": "„Man kennt einzig und allein den berühmt-berüchtigten Frauenheld, die Männerheldin hat gegen ihn keine Chance – die Amazone konnte sich meist nicht durchsetzen.“"
                            },
                            {
                                "example_id": "7904234a-00b3-459b-8810-ad955f28eb47",
                                "sense_id": "c8e8ee73-5ae5-3383-ba92-29520f0d8fac",
                                "text": "„Er hat eine wundervolle Frau vor sich, Modell der größten Fotografen der Welt, eine Männerheldin, eine Männerfresserin, und dieses Arschloch sagt einfach Ziehen Sie sich aus, und sie zieht sich aus.“"
                            },
                            {
                                "example_id": "58682852-d72a-45e4-a34a-fe0f42edbf65",
                                "sense_id": "c8e8ee73-5ae5-3383-ba92-29520f0d8fac",
                                "text": "„Léger, Eluard, Soupault, Crevel, Dali, Masson usw. usw. – mit allen traf sie sich ‹häufig›; über das Zeug zur Männerheldin jedenfalls verfügte sie in reichem Masse.“"
                            },
                            {
                                "example_id": "52a691ce-2229-4c3f-8fa7-df9a8619daee",
                                "sense_id": "c8e8ee73-5ae5-3383-ba92-29520f0d8fac",
                                "text": "„Wenn eine Frau in dieser Landschaft Zigaretten raucht, ist sie entweder eine hemmungslose Männerheldin oder die Gefährtin eines Asozialen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
