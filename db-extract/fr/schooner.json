        "fr-extract.jsonl": [
            {
                "entry_id": "81bd68ef-6092-3ca6-8c52-1c80c92c9ea2",
                "word": "schooner",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eab22e56-3d4c-4722-b8fa-b4391b151c61",
                        "entry_id": "81bd68ef-6092-3ca6-8c52-1c80c92c9ea2",
                        "tags": [
                            "plural"
                        ],
                        "form": "schooners"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a719cc34-6acb-3a6d-8cfc-81a6eda4dc13",
                        "entry_id": "81bd68ef-6092-3ca6-8c52-1c80c92c9ea2",
                        "glosses": [
                            "Deux-mâts, gréé comme une goélette."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "1e84a693-d5f1-4e92-b809-19c7f3b25096",
                                "sense_id": "a719cc34-6acb-3a6d-8cfc-81a6eda4dc13",
                                "text": "M. Lear avait occupé une place auprès de ce grand homme : il voulut bien, en mémoire de mon illustre patron, me faire donner passage sur un schooner des États-Unis."
                            },
                            {
                                "example_id": "32da328f-0416-471e-a36f-4be032bdfb25",
                                "sense_id": "a719cc34-6acb-3a6d-8cfc-81a6eda4dc13",
                                "text": "Paine et Proudfoot avaient été débarqués dans l’île par un schooner qui faisait la pêche des phoques."
                            },
                            {
                                "example_id": "4e9baa0a-fc12-4f21-93f0-97b9233cc552",
                                "sense_id": "a719cc34-6acb-3a6d-8cfc-81a6eda4dc13",
                                "text": "L’aube se leva, nous montrant un îlot rocheux à notre gauche sous le vent, et au vent un schooner de guerre qui faisait route directement sur nous."
                            },
                            {
                                "example_id": "978bb317-9772-4ece-81c2-a5a397e61827",
                                "sense_id": "a719cc34-6acb-3a6d-8cfc-81a6eda4dc13",
                                "text": "Le soir la vigie signale à quelques encablures de la côte une goélette immobile qui semble donner de la bande. […]. Comme le schooner peut avoir besoin de secours, nous approchons en sondant prudemment. C'est bien une goélette, d'une centaine de tonnes, qui s'est échouée sur les cailloux de Mingan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5b4cedd-449c-4a68-ab7a-e0dccafa8dfc",
                        "source_entry_id": "81bd68ef-6092-3ca6-8c52-1c80c92c9ea2",
                        "source_sense_id": "a719cc34-6acb-3a6d-8cfc-81a6eda4dc13",
                        "target_lang_word": "Schoner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schoner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                        "entry_id": "76508804-c864-3693-8975-6fe711cd1f7c",
                                        "glosses": [
                                            "zweimastiges Segelschiff. Unterteilung in den Gaffelschoner, welcher nur Gaffel- und Stagsegel führt, sowie den Rahschoner, welcher Rahen am vordersten Mast aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ffce69-20e3-4d5c-b121-a5b8f6a40c81",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "Heute hat im Hafen ein Schoner angelegt."
                                            },
                                            {
                                                "example_id": "45dafff0-7f05-4f39-bf5d-9d72318a6cca",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Sie hatten die Ketsch bald eingeholt, welche die Strömung inzwischen noch näher an den Schoner herangebracht hatte.“"
                                            },
                                            {
                                                "example_id": "741f22db-e5df-478e-91dd-6fffe0950c93",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Vor der Bucht lag kein Schoner mehr vor Anker, am Horizont waren nicht einmal Segel zu erkennen.“"
                                            },
                                            {
                                                "example_id": "bb60dc26-4050-4e08-a433-ae0d015e3f12",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Acht Tage nach Barthels Abreise lief ein schwedischer Schoner in den Hafen, der Zedernholz nach Chile führte.“"
                                            },
                                            {
                                                "example_id": "a47fb1c0-8988-4b3b-8b9f-5e98ca1838f7",
                                                "sense_id": "5e8fd5c9-0078-3772-9281-7a964d0f0dd9",
                                                "text": "„Einige Schoner kämpften sich in der frischen Brise die Bucht entlang, und ein köstlicher Salzgeschmack lag in der Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schoner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2a565b-2c60-3b09-a7d9-7613c94b5fe8",
                                        "entry_id": "09b60fb6-0bcc-30ae-9115-e143a40aba4e",
                                        "glosses": [
                                            "Gegenstand oder Vorrichtung, womit etwas geschützt werden soll"
                                        ],
                                        "tags": [
                                            "meist in Zusammensetzungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588e542f-ba65-4061-ba11-ea18b80683ef",
                                                "sense_id": "9e2a565b-2c60-3b09-a7d9-7613c94b5fe8",
                                                "text": "Während des Zweikampfs verlor er den Schoner und wurde ernsthaft verletzt."
                                            },
                                            {
                                                "example_id": "46f15d0a-8d79-456b-942c-8c418461232a",
                                                "sense_id": "9e2a565b-2c60-3b09-a7d9-7613c94b5fe8",
                                                "text": "„Nachdem sie in der Umkleidekabine ihre Schlittschuhe angelegt hatte, versah sie die Kufen mit Schonern, um sie zu schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "035d14c3-e499-4c7a-b098-a83b517647e4",
                        "source_entry_id": "81bd68ef-6092-3ca6-8c52-1c80c92c9ea2",
                        "source_sense_id": "a719cc34-6acb-3a6d-8cfc-81a6eda4dc13",
                        "target_lang_word": "schooner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schooner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A sailing ship with two or more masts, all with fore-and-aft sails; if two masted, having a foremast and a mainmast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12653cdf-868e-4b9a-804d-b720c217f2e2",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "The night was considerably clearer than anybody on board her desired when the schooner Ventura headed for the land."
                                            },
                                            {
                                                "example_id": "d551cd75-9fea-40f6-a7d7-ff93cc82dae0",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "Designed by Frank Payne's renowned Boston design office, and built in 1928 of longleaf yellow pine, this 82-footer has been a racing schooner — a staysail schooner — since the heyday of Class-A ocean racing in schooners during the late 1920s and early 1930s."
                                            },
                                            {
                                                "example_id": "a71b7409-3fbd-4a58-b1c3-143042f3d02d",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "In addition to the square-rigged sailing ships, the schooners were the second largest group of large sailing vessels."
                                            },
                                            {
                                                "example_id": "5c5e7494-6d80-42de-83e4-3d963f40c88e",
                                                "sense_id": "bb6de94f-3f00-390e-a343-446266055448",
                                                "text": "Unfortunately, anyone looking for a schooner today has limited choices. In the used boat market there are always some wooden hulls available, and occasionally ones of steel or aluminum, but fiberglass-hulled schooners are harder to come by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd5df64-384c-3b58-9a4e-25b3dc7978af",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A glass for drinking a large measure of sherry."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4713d4f9-2b6a-4a84-a90d-9c7721cd72c3",
                                                "sense_id": "7bd5df64-384c-3b58-9a4e-25b3dc7978af",
                                                "text": "Boycott any pub that bans work clothes, allows customers to reserve tables or only sells beer in schooners. That is less a pub, more a private members’ club."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A glass of beer, of a size which varies between states (Wikipedia)."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16705b3e-361a-49b9-9e2e-6168169dfafd",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "Foaming schooners of beer grew ever larger and more numerous as the crimson February suns went to their rest."
                                            },
                                            {
                                                "example_id": "01a7d115-b092-40c6-b681-8ad7b5e8ce7e",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "At first I refused, but ten schooners later I was ready to take on Jaws with a butterknife[.]"
                                            },
                                            {
                                                "example_id": "b34474f2-3624-455c-826b-e6ef4e451d17",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "And needless to say, the Western Australia row will eventually be filled in as well, though not before drinking a schooner of the amber nectar in Perth."
                                            },
                                            {
                                                "example_id": "4994d244-d7e3-45e1-94e1-1718dea4a9c3",
                                                "sense_id": "ca5678ee-8242-3739-b8c0-a5ca8676112d",
                                                "text": "For a true Adelaide experience, head for the bar and order a schooner of Coopers, the local brew, or a glass of SA′s impressive wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023187f7-55c4-3bb3-89d7-aa5c707c0bfa",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A large goblet or drinking glass, used for lager or ale (Wikipedia)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9de03c5-4413-36de-a605-f8701bc3193a",
                                        "entry_id": "e8790b66-d061-3390-bf24-1872cddb11a6",
                                        "glosses": [
                                            "A covered wagon used by emigrants."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
