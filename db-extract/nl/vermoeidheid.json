        "nl-extract.jsonl": [
            {
                "entry_id": "c1bd3218-179f-32ba-9dfe-a0cb34e0ccc0",
                "word": "vermoeidheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c25a28ad-5bfc-32cd-abb7-69e75cc02c8e",
                        "entry_id": "c1bd3218-179f-32ba-9dfe-a0cb34e0ccc0",
                        "glosses": [
                            "moeheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37abfd18-a904-4ddc-a005-15306ead2a5e",
                                "sense_id": "c25a28ad-5bfc-32cd-abb7-69e75cc02c8e",
                                "text": "Ze raakte de tas even aan; door haar vermoeidheid was ze wat minder op haar hoede, en haar geest vloog zo snel alle kanten uit dat ze moeite had haar kalmte te bewaren."
                            },
                            {
                                "example_id": "771da3b5-a1a9-4980-9991-07b263855080",
                                "sense_id": "c25a28ad-5bfc-32cd-abb7-69e75cc02c8e",
                                "text": "Meteen na de start, meldde ze zich vooraan, pal achter Can, en pal voor Grøvdal en de Zwitserse Fabienne Schlumpf. Maar gaandeweg begon ze van vermoeidheid te trekkebekken en kort daarop groeide het gat met de koplopers, Can, Schlumpf en uiteindelijk ook de Noorse."
                            }
                        ]
                    },
                    {
                        "sense_id": "b881ddbb-193d-33b4-828d-810e42246d96",
                        "entry_id": "c1bd3218-179f-32ba-9dfe-a0cb34e0ccc0",
                        "glosses": [
                            "verzwakking van materiaal door wisselende belasting"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "374afe05-da9f-4130-835b-394faf055401",
                                "sense_id": "b881ddbb-193d-33b4-828d-810e42246d96",
                                "text": "Staal, titanium en carbon zijn materialen die een zeer hoge weerstand hebben tegen vermoeidheid. Zolang de belasting maar niet boven een bepaalde grens komt, zal het materiaal nooit breken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac824912-a21b-4383-81a4-a69cca1a96b2",
                        "source_entry_id": "c1bd3218-179f-32ba-9dfe-a0cb34e0ccc0",
                        "target_lang_word": "tiredness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
