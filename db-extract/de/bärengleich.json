                "senses": [
                    {
                        "sense_id": "b0a6228a-68ab-3375-b3cc-d8f45b6769c1",
                        "entry_id": "60f1e217-52e2-3b0a-9e1e-73801af002b2",
                        "glosses": [
                            "wie ein Bär, einem Bär ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aadf04b4-3e47-46f1-b61f-c1cae2386c4f",
                                "sense_id": "b0a6228a-68ab-3375-b3cc-d8f45b6769c1",
                                "text": "„Ein anderer Posten sah eine bärengleiche Erscheinung unter die Tür der Juwelenkammer schlüpfen.“"
                            },
                            {
                                "example_id": "5a9f0ea0-5d4c-49d5-ba1d-5af4af26d862",
                                "sense_id": "b0a6228a-68ab-3375-b3cc-d8f45b6769c1",
                                "text": "„Der Professor betonte seine mannhaften, bärengleichen Tugenden, während sich der Doktor in giftiger Nörgelei erging, die zu seiner quäkenden Stimme passte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
