                "senses": [
                    {
                        "sense_id": "9590ae51-0849-3e8b-be4e-0b630942176d",
                        "entry_id": "570cec04-3e34-364b-9411-2fcba1d82650",
                        "glosses": [
                            "militärisches Ausnahmegericht zur schnellen Urteilsfindung und -vollstreckung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3616d822-0a89-4dc2-9fae-810a28f5ab26",
                                "sense_id": "9590ae51-0849-3e8b-be4e-0b630942176d",
                                "text": "„Er duckte sich nicht unter den Schlägen der Bürger, im Keller traten ein paar Offiziere zu einem Standgericht zusammen, es genügte, daß er zugab, Eglhofer zu sein, der Spruch hieß Tod.“"
                            },
                            {
                                "example_id": "6298cc98-2194-4bf8-97f0-f3ca41bf3ecb",
                                "sense_id": "9590ae51-0849-3e8b-be4e-0b630942176d",
                                "text": "„Wahrscheinlich – nein, nur zu offensichtlich waren in ihrem Falle nicht deutsche Standgerichte, sondern die Russen am Werk.“"
                            },
                            {
                                "example_id": "debd64cd-c24f-4ed5-bafc-c548f1090e23",
                                "sense_id": "9590ae51-0849-3e8b-be4e-0b630942176d",
                                "text": "„Das Standgericht verurteilt Toller zu fünf Jahren Festungshaft und schickt ihn ins Zuchthaus Niederschönenfeld.“"
                            },
                            {
                                "example_id": "b14b46e5-a484-47d6-9646-596bfb31753b",
                                "sense_id": "9590ae51-0849-3e8b-be4e-0b630942176d",
                                "text": "[April 1945:] „So erkannte etwa der Kampfkommandant von Gotha, dass eine Verteidigung der Stadt gegen die anrückenden US-Truppen zwecklos wäre und ließ weiße Fahnen aufhängen. Er wurde dafür vor ein Standgericht der Wehrmacht in Weimar gestellt und erschossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96c92fa7-531c-4cac-937b-93b5af9d9f1c",
                        "source_entry_id": "570cec04-3e34-364b-9411-2fcba1d82650",
                        "source_sense_id": "9590ae51-0849-3e8b-be4e-0b630942176d",
                        "source_sense_description": "militärisches Ausnahmegericht zur schnellen Urteilsfindung und -vollstreckung",
                        "target_lang_word": "cour martiale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cour martiale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b182f5a3-c316-34b7-bf71-0fe3df179ebb",
                                        "entry_id": "969d7ee5-5598-3698-bff7-f510ba17e8ca",
                                        "glosses": [
                                            "Tribunal d’exception qui exerce la justice militaire (principalement en temps de guerre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057328f5-9d54-4791-8131-dda481a69307",
                                                "sense_id": "b182f5a3-c316-34b7-bf71-0fe3df179ebb",
                                                "text": "Maintenant c'était la cour martiale, terrifiante à force de simplicité. Une grange vide, une table, les cinq juges sur des chaises de paille ; en face, debout, l'accusé."
                                            },
                                            {
                                                "example_id": "844aab0c-fff4-4cca-bc78-0e82473b2bc2",
                                                "sense_id": "b182f5a3-c316-34b7-bf71-0fe3df179ebb",
                                                "text": "Le 16, la Cour martiale se réunit. Elle refuse à entendre les officiers qui ont demandé à déposer. Ceux qui cherchent à défendre les accusés sont injuriés. Trente-deux hommes sont acquittés, mais les quatre caporaux sont condamnés à mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
