                "senses": [
                    {
                        "sense_id": "fff334f4-6cb5-3be9-93d6-fbea124099ac",
                        "entry_id": "ada7450c-6b60-3170-bfe0-c06f7e3c6c58",
                        "glosses": [
                            "zwanghaftes Verlangen danach, sich Operationen zu unterziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c065dba9-ae59-466a-9b8f-7fc3ded49394",
                                "sense_id": "fff334f4-6cb5-3be9-93d6-fbea124099ac",
                                "text": "„Ich habe Ihre Aufsätze über Operationssucht sowie linksseitige und rechtsseitige Gesichtsausdrücke gelesen.“"
                            },
                            {
                                "example_id": "46d7b083-88fa-4a5a-8d6d-b34d0dd2d41e",
                                "sense_id": "fff334f4-6cb5-3be9-93d6-fbea124099ac",
                                "text": "„Einzelfälle von Operationssucht waren den Medizinern schon vor Jahrzehnten bekannt geworden.“"
                            },
                            {
                                "example_id": "44106bcc-87a6-4f2f-b4fb-a8830354dd00",
                                "sense_id": "fff334f4-6cb5-3be9-93d6-fbea124099ac",
                                "text": "„Oftmals werde von einer Operationssucht gesprochen, sagt von Saldern: »Sicher gibt es Frauen, denen ihre Brustvergrößerung nach den Schwangerschaften so gut gefällt, dass sie sich später auch den Bauch verschönern lassen wollen.«“"
                            },
                            {
                                "example_id": "604b9767-c972-438f-8691-92e1c4721cd5",
                                "sense_id": "fff334f4-6cb5-3be9-93d6-fbea124099ac",
                                "text": "„Beschrieben wurden 1923/1934 eine ‚Operationssucht‘ und 1951 ein ‚Münchhausen-Syndrom‘.“"
                            },
                            {
                                "example_id": "44e44cfb-db2f-41ab-b51c-82cb0e8b4330",
                                "sense_id": "fff334f4-6cb5-3be9-93d6-fbea124099ac",
                                "text": "„Hoffen wir für Pixee, dass sie so schnell wie möglich zur Besinnung kommt und ihre Operationssucht nachlässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
