                        "entry_id": "69148c11-f34e-3f96-a12d-6680a3aa80f4",
                        "glosses": [
                            "seks waarbij de man met zijn penis het lichaam van de partner binnengaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01992f44-3462-4050-97ab-67497142f833",
