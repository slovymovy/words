                "entry_id": "f1e35b75-9ef7-30d4-974b-f6ef209a25ce",
                "word": "modernist",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "2a1efb7c-a33d-49ef-a016-d2cb52307e6b",
                        "entry_id": "f1e35b75-9ef7-30d4-974b-f6ef209a25ce",
                        "tags": [
                            "plural"
                        ],
                        "form": "modernisten"
