                    "frequency": "Middle",
                    "semantic_group_id": "pensee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce refrain entraînant me <w>trotte</w> dans la tête depuis ce matin."
                        },
                        {
                            "text": "Une étrange inquiétude n'a cessé de lui <w>trotter</w> dans l'esprit pendant son voyage."
                        }
                    ],
                    "synonyms": [
