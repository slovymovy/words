                "senses": [
                    {
                        "sense_id": "dcf86981-9c9f-318c-bddd-3d1c7980310a",
                        "entry_id": "6ae7e901-91fd-30d1-9719-443c7d68b7e8",
                        "glosses": [
                            "nicht genau definierter südöstlicher Teil des Atlantischen Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48c333bb-c20e-4191-a2e6-484014e048d2",
                                "sense_id": "dcf86981-9c9f-318c-bddd-3d1c7980310a",
                                "text": "„Bis dahin waren Funde dieser Krabbe von unseren Küsten gänzlich unbekannt, denn man kannte diese Art nur aus dem Südostatlantik, dem Mittelmeer und dem Ärmelkanal als dem nördlichsten Ausläufer ihres Vorkommens.“"
                            },
                            {
                                "example_id": "7c36f365-01b7-4c52-a463-3d02af689ea4",
                                "sense_id": "dcf86981-9c9f-318c-bddd-3d1c7980310a",
                                "text": "„CDie Fischgründe des Südostatlantiks bei Cape Point sind die ideale Umgebung, um eine breite Vielfalt an Seevögeln zu beobachten, darunter Albatrosse, Sturmvögel und Sturmtaucher.“"
                            },
                            {
                                "example_id": "5e3ed1d8-ff84-4d34-bc9d-b1947777213b",
                                "sense_id": "dcf86981-9c9f-318c-bddd-3d1c7980310a",
                                "text": "„Über 80 Prozent der Schneckenarten aus dem vormals unbesammelten Abyss des Südostatlantiks waren neu.“"
                            },
                            {
                                "example_id": "7e615bc4-74d8-4ad8-b857-6493c16ceacd",
                                "sense_id": "dcf86981-9c9f-318c-bddd-3d1c7980310a",
                                "text": "„Das ganze letzte Jahr hat er auf einem Krabbenfangschiff im Südostatlantik gearbeitet, aber jetzt scheint er Sehnsucht nach festem Boden unter den Füßen zu haben.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
