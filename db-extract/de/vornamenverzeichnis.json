                "senses": [
                    {
                        "sense_id": "056d480f-ffaa-3be0-a92f-f9f6e57fdc42",
                        "entry_id": "152d87fc-d8ba-3aa9-8908-1dd4694afdc6",
                        "glosses": [
                            "Liste von Vornamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e8dc38-65a6-4521-935c-f3e76b8548f4",
                                "sense_id": "056d480f-ffaa-3be0-a92f-f9f6e57fdc42",
                                "text": "„Das rückläufige Vornamenverzeichnis bietet die Möglichkeit, eine Auswahl zwischen Namen zu treffen, die dieselbe Endung haben.“"
                            },
                            {
                                "example_id": "0369fbd6-79a5-4703-8067-7ac4ecc256b7",
                                "sense_id": "056d480f-ffaa-3be0-a92f-f9f6e57fdc42",
                                "text": "„Alle eingeschickten Baby-Bilder werden am 6. Mai an der Vernissage des Vornamenverzeichnisses 2009 von Statistik Stadt Zürich ausgestellt, zu der alle Teilnehmenden herzlich eingeladen sind.“"
                            },
                            {
                                "example_id": "c04762b0-414b-4d0c-a400-5ef97d148ef5",
                                "sense_id": "056d480f-ffaa-3be0-a92f-f9f6e57fdc42",
                                "text": "„Das ‚Stammbuch der Familie‘ im Taschenbuchformat enthält Informatives wie ein Vornamenverzeichnis, alle Hochzeitstage sowie einschlägige Bestimmungen über die Ehe und Familie.“"
                            },
                            {
                                "example_id": "11e5be45-15c7-4926-b48a-3b08a1c03c00",
                                "sense_id": "056d480f-ffaa-3be0-a92f-f9f6e57fdc42",
                                "text": "„Westfälisches Geschlechterbuch, der Band umfaßt die Stammfolgen Delius westfälischen Stammes (u. Steinmann), mit einem Vornamenverzeichnis aller männlichen und weiblichen Namensträger.“"
                            },
                            {
                                "example_id": "7b5ed527-332e-4acb-a15b-4e2f4a8614c2",
                                "sense_id": "056d480f-ffaa-3be0-a92f-f9f6e57fdc42",
                                "text": "„Anschließend können sich die werdenden Eltern mit Vornamenverzeichnis, Schwangerschaftstagebuch und Ratgeberteil befassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
