        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8d6f98c-a677-32ed-ad2c-c4c6a70291b9",
                    "sense_definition": "To strike someone or something hard, usually with a hand or fist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He warned the intruder that he would <w>clout</w> him if he stepped any closer.",
                            "target_lang_translations": {
                                "zh": "他警告入侵者，如果再敢走近一步就<w>揍</w>他。"
                            }
                        },
                        {
                            "text": "The older brother <w>clouted</w> him on the shoulder during their scuffle.",
                            "target_lang_translations": {
                                "zh": "扭打中，哥哥朝他的肩膀<w>猛击</w>了一拳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hit",
                        "smack",
                        "strike",
                        "cuff"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "猛击，痛打（通常用手或拳头）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "揍",
                                "target_lang_sense_clarification": "击打或敲打"
                            },
                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "用力击打"
                            },
                            {
                                "target_lang_word": "打",
                                "target_lang_sense_clarification": "击打"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7966463b-9df5-3e72-b824-7be964f8ad3e",
                    "sense_definition": "To patch, repair, or bandage with a piece of cloth or leather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "patch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman spent the afternoon <w>clouting</w> his torn sails with spare canvas.",
                            "target_lang_translations": {
                                "zh": "渔夫花了一个下午用备用帆布<w>修补</w>他破损的风帆。"
                            }
                        },
                        {
                            "text": "He managed to <w>clout</w> his worn leather boots so they would last through the season.",
                            "target_lang_translations": {
                                "zh": "他设法给磨破的皮靴<w>打补丁</w>，好让它们能撑过这个季节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "patch",
                        "mend"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historic sense meaning to patch or mend"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用布或皮革修补、打补丁"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "修补",
                                "target_lang_sense_clarification": "用布或皮打补丁"
