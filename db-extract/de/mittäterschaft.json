                        "form": "die Mittäterschaft"
                    },
                    {
                        "form_id": "21154850-db59-48b2-9a6c-c920d2599724",
                        "entry_id": "aea72360-0607-30bd-8867-9ff0b8b23dca",
                        "tags": [
