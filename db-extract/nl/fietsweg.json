                "senses": [
                    {
                        "sense_id": "abb6d971-f0f6-3638-b514-e33be4d5381a",
                        "entry_id": "20ac5dae-2e13-3bb7-b0e6-c8cee551213d",
                        "glosses": [
                            "wegen die geschikt zijn om overheen te fietsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "210be791-14b0-41a3-9bb1-b6d2a5892554",
                                "sense_id": "abb6d971-f0f6-3638-b514-e33be4d5381a",
                                "text": "In eerste instantie zal een fietstracé tussen Enschede en Almelo worden vastgesteld. Het gaat dan niet om de aanleg van een nieuwe fietsweg, maar nadrukkelijk om het aan elkaar koppelen van bestaande fietsstroken. De verbinding moet veilig, comfortabel en snel worden, onder meer door te kiezen voor viaducten, en kruisingen zo veel mogelijk te voorkomen."
                            },
                            {
                                "example_id": "07ef0835-7c5c-45d3-ba38-abc112b8f07c",
                                "sense_id": "abb6d971-f0f6-3638-b514-e33be4d5381a",
                                "text": "Anno 2012 is het in de Peel aangenaam vertoeven. Verdwalen is uitgesloten, want de fietswegen zijn keurig bewegwijzerd met knooppunten."
                            },
                            {
                                "example_id": "94922542-49a6-43fc-b3fe-345895ece65f",
                                "sense_id": "abb6d971-f0f6-3638-b514-e33be4d5381a",
                                "text": "En dan Ben Morshuis. Hij gaat heus wel eens een paar dagen weg, maar eigenlijk blijft hij het liefst thuis, in het mooie Ootmarsum: „Hier hebben we het gevoel altijd op vakantie te zijn.” Een prachtig oud stadscentrum, perfect gerestaureerde oude gebouwen, kunstgaleries, het Openluchtmuseum Land van Heeren en Boeren en het Schoolmuseum Educatorium, plus ook nog eens wandelpaden en fietswegen in bosrijk gebied."
                            }
                        ]
                    }
