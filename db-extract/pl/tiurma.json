                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "45f72743-3d77-40ee-b5f6-af51dc7a9696",
                                "sense_id": "81c36c01-7e65-32bd-a8e7-af8b145417a2",
                                "text": "Oto nasi - te nieszczęsne, wycieńczone niedobitki łagrów i tiurm - będą teraz zmuszeni bić się ramię w ramię z Sowietami"
                            },
                            {
                                "example_id": "eab2eaef-1a74-49b6-bed6-27afda5d63a2",
                                "sense_id": "81c36c01-7e65-32bd-a8e7-af8b145417a2",
                                "text": "Poznał wiele tiurm od Gęsiówki, Toledo poczynając, po Siedlce, Iławę, Strzelce Opolskie, Wiśnicz, Goleniów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
