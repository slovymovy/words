                    {
                        "sense_id": "d22860ae-a212-38b2-be04-2c5e4ad5cc23",
                        "entry_id": "778734cd-71ab-3757-99a3-b0682fe33ac7",
                        "glosses": [
                            "To implore or invoke."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ea05ae54-c7b0-47ef-bcd5-32bda83d0e90",
                                "sense_id": "d22860ae-a212-38b2-be04-2c5e4ad5cc23",
                                "text": "Be thou the tenth Muſe, ten times more in worth / Then thoſe old nine which rimers inuocate, […]"
                            },
                            {
                                "example_id": "9ed6b0a3-5330-49d9-885a-b767e189f5bf",
                                "sense_id": "d22860ae-a212-38b2-be04-2c5e4ad5cc23",
                                "text": "[B]oth the muſes and the graces are his hard Miſtriſſes, though he daily Invocate them, though he ſacrifize Hecatombs, they ſtil look a ſquint, […]"
                            },
                            {
                                "example_id": "6ba8d530-889b-409a-b56e-af8e87077108",
                                "sense_id": "d22860ae-a212-38b2-be04-2c5e4ad5cc23",
                                "text": "For proof hereof, if Dagon be thy god, / Go to his Temple, invocate his aid"
                            }
                        ]
                    },
                    {
                        "sense_id": "b42e23ee-aba2-35f0-ab74-aeab45ba8fa5",
                        "entry_id": "778734cd-71ab-3757-99a3-b0682fe33ac7",
                        "glosses": [
                            "To conjure up or summon."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7e278f4d-b071-431a-a4c6-5373d04370c8",
                                "sense_id": "b42e23ee-aba2-35f0-ab74-aeab45ba8fa5",
                                "text": "Poore key-cold Figure of a holy King,\nPale Aſhes of the Houſe of Lancaſter;\nThou bloodleſſe Remnant of that Royall Blood,\nBe it lawfull that I inuocate thy Ghoſt,\nTo heare the Lamentations of poore Anne,\nWife to thy Edward, to thy ſlaugthered Sonne,\nStab'd by the ſelfeſame hand that made theſe wounds."
                            }
                        ]
                    }
