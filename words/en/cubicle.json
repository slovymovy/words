{
    "word_family": [
        "cubic",
        "cube"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b0a0a6b-7c0b-3428-96c8-0cf03e9fd65e",
                    "sense_definition": "A small separate part or one of the compartments of a room, especially in a work environment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "small enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spend most of my day working in a small <w>cubicle</w> at the office.",
                            "target_lang_translations": {
                                "ru": "Большую часть дня я провожу за работой в небольшой офисной <w>кабинке</w>."
                            }
                        },
                        {
                            "text": "Most libraries provide a quiet <w>cubicle</w> for students who need to study alone.",
                            "target_lang_translations": {
                                "ru": "Большинство библиотек предоставляют тихую <w>ячейку</w> для студентов, которым нужно заниматься в одиночестве."
                            }
                        }
                    ],
                    "common_phrases": [
                        "office cubicle",
                        "work cubicle",
                        "quiet cubicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая отдельная часть или один из отсеков комнаты, особенно в рабочей среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабочее место",
                                "target_lang_sense_clarification": "в офисе открытого типа"
                            },
                            {
                                "target_lang_word": "ячейка",
                                "target_lang_sense_clarification": "отдельный отсек"
                            },
                            {
                                "target_lang_word": "кабинка",
                                "target_lang_sense_clarification": "небольшое огороженное пространство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "729dc643-ea99-39e6-b319-a6df51536e12",
                    "sense_definition": "A small enclosure in a public toilet for individual use.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "small enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public restroom was very busy and every <w>cubicle</w> was occupied.",
                            "target_lang_translations": {
                                "ru": "В общественном туалете было очень много народу, и каждая <w>кабинка</w> была занята."
                            }
                        },
                        {
                            "text": "The toilets will have weight-sensitive floors to make sure only one person is using each <w>cubicle</w> at a time.",
                            "target_lang_translations": {
                                "ru": "В туалетах будут полы, чувствительные к весу, чтобы гарантировать, что в каждой <w>кабинке</w> одновременно находится только один человек."
                            }
                        }
                    ],
                    "synonyms": [
                        "stall"
                    ],
                    "common_phrases": [
                        "toilet cubicle",
                        "bathroom cubicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое огороженное место в общественном туалете для индивидуального использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинка",
                                "target_lang_sense_clarification": "в туалете"
                            },
                            {
                                "target_lang_word": "кабина",
                                "target_lang_sense_clarification": "отдельное помещение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03713198-4776-364e-ad2c-3dcb9fa97339",
                    "sense_definition": "A small enclosure at a swimming pool or gym used to provide personal privacy when changing clothes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "small enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please leave your clothes in the <w>cubicle</w> while you go for a swim.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставьте свои вещи в <w>кабинке</w>, пока идете плавать."
                            }
                        },
                        {
                            "text": "The gym has a private <w>cubicle</w> for members to change their clothes.",
                            "target_lang_translations": {
                                "ru": "В спортзале есть отдельная <w>кабинка</w>, где посетители могут переодеться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "changing cubicle",
                        "shower cubicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое помещение в бассейне или спортзале, используемое для обеспечения приватности при переодевании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинка",
                                "target_lang_sense_clarification": "для переодевания"
                            },
                            {
                                "target_lang_word": "раздевалка",
                                "target_lang_sense_clarification": "индивидуальное место"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}