                ],
                "senses": [
                    {
                        "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                        "entry_id": "075d88c8-5838-369d-9092-f9d5978f20e0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f50ae0a-ffd3-4898-8389-35d0d2d98c45",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "Herr Beckers wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b6ca6b86-2b9a-4edd-85e3-18c3ae90d91f",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "Die Beckers fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "c7fbfce4-e917-441e-9614-8b4e2009b1fe",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "Der Beckers trägt nie die Pullover, die die Beckers ihm strickt."
                            },
                            {
                                "example_id": "cdfda49c-b8b3-4e8d-841a-6667368db17d",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "Ernst-Malte Beckers konnte als ein Verkaufsgenie gelten."
                            },
                            {
                                "example_id": "fffb00e5-0c78-41ce-9e06-cf04204f61f0",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Beckers kommt, geht der Herr Beckers.“"
                            },
                            {
                                "example_id": "185accd1-7912-4a75-8cfc-9de43b508cb2",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "Beckers kommt und geht."
                            },
                            {
                                "example_id": "7b3284b1-6109-485c-82e2-2adaeecde149",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "Beckers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f07e640d-4337-432d-8522-178cbe3b7282",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "An verregneten Herbsttagen ist Familie Beckers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "4db12efa-e7d9-4349-9fb6-67693beed51a",
                                "sense_id": "d5f2f7fb-89ed-3e3b-9b57-675599c85512",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Beckers das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
