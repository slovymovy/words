                                "target_senses": [
                                    {
                                        "sense_id": "0fe362e2-5957-3c3f-9581-0267d91d755a",
                                        "entry_id": "6f4fafef-37ea-37b4-9e15-428a6b37e8c6",
                                        "glosses": [
                                            "Qui se rapporte à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "706b38b2-6204-472d-8906-a7880fd37ca5",
                                                "sense_id": "0fe362e2-5957-3c3f-9581-0267d91d755a",
                                                "text": "Les Prussiens étant allés à Flaignes-les-Oliviers pour toucher les deux premiers douzièmes de la contribution imposée à cette commune, les maires de Prez et de La Cerleau crurent bien faire en allant à Flaignes pour payer les sommes afférentes à leurs communes; […]."
                                            },
                                            {
                                                "example_id": "02124959-fbde-4572-b181-452aff5c1825",
                                                "sense_id": "0fe362e2-5957-3c3f-9581-0267d91d755a",
                                                "text": "Les États Parties procèdent à l’enregistrement des propriétaires et des commerçants d’armes de petit calibre se trouvant sur leurs territoires respectifs et maintiennent une base de données électronique nationale y afférente."
                                            },
                                            {
                                                "example_id": "47c27e2f-af00-4ecf-9a7e-e6d59836bbfb",
                                                "sense_id": "0fe362e2-5957-3c3f-9581-0267d91d755a",
                                                "text": "Fin des cambriolages, des vols à l’arraché, voies de fait, types armés, types désarmés, à cran, pas à cran, et des kilos de papiers y afférents. « Y afférent », il se l’était entendu dire deux fois ces derniers temps."
                                            },
                                            {
                                                "example_id": "eab9335a-df7b-41eb-8bbb-45701944f58f",
                                                "sense_id": "0fe362e2-5957-3c3f-9581-0267d91d755a",
                                                "text": "Les notions de bien et de mal ne peuvent-elles être liées qu'à l'existence de l'au-delà, avec les récompenses et les punitions afférentes ?"
                                            },
                                            {
                                                "example_id": "ac7a1d5f-7fdb-44aa-9d33-9024bcbc4b35",
                                                "sense_id": "0fe362e2-5957-3c3f-9581-0267d91d755a",
                                                "text": "Le Québec a également fourni d'autres contributions afférentes pour la construction d'infrastructures et la décontamination."
                                            },
                                            {
                                                "example_id": "bd6dbd23-a580-4021-8ca0-893f10d4d54e",
                                                "sense_id": "0fe362e2-5957-3c3f-9581-0267d91d755a",
                                                "text": "Des renseignements afférents à une affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992314f1-23f4-33da-93b7-f64bc2dbe18f",
                                        "entry_id": "6f4fafef-37ea-37b4-9e15-428a6b37e8c6",
                                        "glosses": [
                                            "Qualifie la part qui revient à chacun des intéressés dans un objet indivis ou dans un partage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91dd9412-0e56-4831-8c34-556fc9730ec6",
                                                "sense_id": "992314f1-23f4-33da-93b7-f64bc2dbe18f",
                                                "text": "La portion afférente d’un héritage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afférent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55af7000-408b-3bbb-974a-90e3f1bde6c6",
                                        "entry_id": "7bfaeb4a-6620-3fc1-8cdb-8ef8b13574cc",
