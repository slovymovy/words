                    "sense_definition": "geïnfecteerd raken door bacteriën of virussen, vaak gepaard gaand met roodheid en zwelling",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je die wond niet goed schoonmaakt, kan hij snel <w>ontsteken</w>.",
                            "target_lang_translations": {
                                "en": "If you don't clean that wound properly, it can quickly <w>become inflamed</w>."
                            }
                        },
                        {
                            "text": "Zijn tandvlees begon pijnlijk te <w>ontsteken</w> na de operatie.",
                            "target_lang_translations": {
                                "en": "His gums began to <w>become</w> painfully <w>inflamed</w> after the surgery."
                            }
                        }
                    ],
                    "synonyms": [
                        "infecteren"
                    ],
                    "antonyms": [
                        "genezen"
                    ],
                    "common_phrases": [
                        "een wond ontsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To become infected by bacteria or viruses, often accompanied by redness and swelling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to become inflamed",
                                "target_lang_sense_clarification": "medical condition of tissue"
                            },
                            {
                                "target_lang_word": "to get infected",
                                "target_lang_sense_clarification": "wound or body part"
                            }
                        ]
                    }
                },
                {
