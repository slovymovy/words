                        "glosses": [
                            "Get the fuck out; can be used to express disbelief or displeasure."
                        ],
                        "tags": [
                            "Internet",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c69a9275-9ae3-4c95-b8ec-df6c9fb9e817",
                                "sense_id": "18f0faec-cdd9-3a2a-abca-dc1026162389",
                                "text": "GTFO of my house."
                            },
                            {
                                "example_id": "10187766-81f3-4b23-9c0d-12290c63b7fe",
                                "sense_id": "18f0faec-cdd9-3a2a-abca-dc1026162389",
                                "text": "\"I just found a hundred bucks.\" \"GTFO!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "ae8c1ec3-9ed9-31e9-b9e6-feecb4099d9a",
                        "entry_id": "36236f30-2735-3451-9521-b63df953cca0",
                        "glosses": [
                            "Get the fuck off. See get off"
                        ],
                        "tags": [
                            "Internet",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "a1fe9375-8e0d-43da-ac56-e884200b2805",
                                "sense_id": "ae8c1ec3-9ed9-31e9-b9e6-feecb4099d9a",
                                "text": "Also, the Supreme court has ruled that we don't have to restrict media to \"only what is fit for children\". Live with it or GTFO Usenet."
                            },
                            {
                                "example_id": "b3ad8905-d354-45a8-8785-62b474c3f098",
                                "sense_id": "ae8c1ec3-9ed9-31e9-b9e6-feecb4099d9a",
                                "text": "He told the morons to GTFO my porch...^([sic – meaning ellipsis in original])"
                            },
                            {
                                "example_id": "c93bcb62-6732-4cb1-99b4-02c1035c0b0f",
                                "sense_id": "ae8c1ec3-9ed9-31e9-b9e6-feecb4099d9a",
                                "text": "GTFO our group you manc bastard!"
                            }
                        ]
