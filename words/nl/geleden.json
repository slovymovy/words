                    "sense_id": "3cb86d03-6c52-3201-bd2c-841766311bdd",
                    "sense_definition": "geeft aan dat een bepaalde periode verstreken is sinds een moment in het verleden",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is alweer drie jaar <w>geleden</w> dat we elkaar hebben gezien.",
                            "target_lang_translations": {
                                "ru": "Мы виделись уже три года <w>назад</w>.",
                                "en": "It was three years <w>ago</w> that we saw each other.",
                                "pl": "Minęły już trzy lata <w>temu</w>, odkąd się widzieliśmy.",
                                "de": "Es ist schon wieder drei Jahre <w>her</w>, dass wir uns gesehen haben.",
                                "fr": "Cela fait déjà trois ans <w>qu'on ne s'est pas vus</w>.",
                                "it": "Sono già passati tre anni <w>fa</w> da quando ci siamo visti l'ultima volta.",
                                "cs": "Je to už tři roky <w>zpátky</w>, co jsme se viděli.",
                                "tr": "Birbirimizi görmeyeli zaten üç yıl <w>oldu</w>.",
                                "es": "Ya <w>hace</w> tres años que no nos vemos.",
                                "zh": "我们已经三年没见面了，距离上次见面已经过去三年<w>以前</w>了。"
                            }
                        },
                        {
                            "text": "Kort <w>geleden</w> heb ik besloten om te verhuizen.",
                            "target_lang_translations": {
                                "ru": "<w>Недавно</w> я решил переехать.",
                                "en": "A short while <w>ago</w> I decided to move.",
                                "pl": "Niedawno <w>temu</w> zdecydowałem się na przeprowadzkę.",
                                "de": "Vor <w>kurzem</w> habe ich beschlossen umzuziehen.",
                                "fr": "Il y a peu <w>de temps</w>, j'ai décidé de déménager.",
                                "it": "Poco tempo <w>fa</w> ho deciso di traslocare.",
                                "cs": "<w>Nedávno</w> jsem se rozhodl přestěhovat.",
                                "tr": "Kısa süre <w>önce</w> taşınmaya karar verdim.",
                                "es": "<w>Hace</w> poco decidí mudarme.",
                                "zh": "我<w>不久前</w>决定搬家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terug"
                    ],
                    "common_phrases": [
                        "lang geleden",
                        "kort geleden",
                        "een tijdje geleden",
                        "jaren geleden"
