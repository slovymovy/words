                                "target_senses": [
                                    {
                                        "sense_id": "f1662347-8451-3718-8a4e-b30716645837",
                                        "entry_id": "01cfa2cc-66b3-3d25-9c0a-fcff8c4b3256",
                                        "glosses": [
