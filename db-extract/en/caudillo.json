                    }
                ],
                "senses": [
                    {
                        "sense_id": "96fdf6dc-d304-3f83-90f0-daa02340d32e",
                        "entry_id": "647fc97f-7d20-3924-97e6-8764f357c03e",
                        "glosses": [
                            "A leader."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2b4b81e-a72d-410d-901d-6aadfc2576c7",
                                "sense_id": "96fdf6dc-d304-3f83-90f0-daa02340d32e",
                                "text": "While an America in decline may throw up a more competent caudillo than Trump in time, it is difficult to reasonably conclude that it possesses the societal solidarity to wage a decades-long, global struggle against a near-competitor."
                            }
                        ]
                    },
                    {
                        "sense_id": "61c21771-f597-3ed1-bc11-6a6bde7c8529",
                        "entry_id": "647fc97f-7d20-3924-97e6-8764f357c03e",
                        "glosses": [
                            "A military dictator, especially one ruling in Spain, Portugal or Latin America."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09741957-0d5e-4264-b5c9-424f1039c45d",
                                "sense_id": "61c21771-f597-3ed1-bc11-6a6bde7c8529",
                                "text": "For, despite all the debunking and cynicism in this generation, there still are, amazingly, trusting people around who need to believe in great helmsmen, dear leaders, fuhrers, presidents-for-life, generalissimos and charismatic caudillos."
                            },
                            {
                                "example_id": "d00c3504-e614-41d1-8a88-b69a31a1692a",
                                "sense_id": "61c21771-f597-3ed1-bc11-6a6bde7c8529",
                                "text": "Then there’s Mexico’s outgoing populist and wannabe caudillo, Andrés Manuel López Obrador, who is pushing a crowd-pleasing law to require all judges be elected by popular vote, including to the Supreme Court."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1b32131-2ce7-4859-9139-cc1ff9e8cb22",
                        "source_entry_id": "647fc97f-7d20-3924-97e6-8764f357c03e",
                        "source_sense_description": "military dictator in South America",
                        "target_lang_word": "caudillo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caudillo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4138ec9-5c27-357e-a099-70e673c3b6f3",
                                        "entry_id": "393530af-96cf-3b57-ac5c-13854c4f5b43",
                                        "glosses": [
                                            "Dictateur militaire ou politique qui a pris le pouvoir en Amérique latine ou en Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "805b9ebe-b950-41f3-bcb4-13cffea64036",
                                                "sense_id": "e4138ec9-5c27-357e-a099-70e673c3b6f3",
                                                "text": "Le caudillo Franco."
                                            },
                                            {
                                                "example_id": "26e098f7-fc1c-4ff4-8d47-b4af6556c3ac",
                                                "sense_id": "e4138ec9-5c27-357e-a099-70e673c3b6f3",
                                                "text": "Ángel Vicente Peñaloza, surnommé El Chacho, (1798-1863) était un caudillo et chef militaire fédéraliste, un des derniers chefs de cette tendance politique à s’être soulevé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dc44671-9689-448f-9cbb-3cf4ef16a555",
                        "source_entry_id": "647fc97f-7d20-3924-97e6-8764f357c03e",
                        "source_sense_description": "military dictator in South America",
                        "target_lang_word": "кауди́льо",
                        "target_lang_code": "ru",
