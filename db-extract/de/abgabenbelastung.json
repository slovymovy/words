                "senses": [
                    {
                        "sense_id": "25057c48-5d3a-35d2-92d1-786fa35b8302",
                        "entry_id": "b55c28a6-3744-35c1-9d38-50dca8ffd6ea",
                        "glosses": [
                            "durch (die Zahlung von) Abgaben entstehende Belastung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "defaa7af-4f4c-46a3-b7a3-d0b8d2e4a9e1",
                                "sense_id": "25057c48-5d3a-35d2-92d1-786fa35b8302",
                                "text": "„Eine zu hohe Abgabenbelastung kann zu Versuchen der Steuervermeidung (Kapitalflucht ins Ausland) und zur Beeinträchtigung der wirtschaftlichen Entwicklung durch verringerte Konsum- und Investitionsausgaben führen.“"
                            },
                            {
                                "example_id": "dc52eb8f-7b18-4f55-8f32-d8d72604cb3f",
                                "sense_id": "25057c48-5d3a-35d2-92d1-786fa35b8302",
                                "text": "„Im internationalen Vergleich wird die Abgabenbelastung meist als Prozentsatz der Steuern und Sozialversicherungsbeiträge relativ zum Bruttosozialprodukt gemessen.“"
                            },
                            {
                                "example_id": "883dc735-d79a-4096-9f47-fbaba3ab9f42",
                                "sense_id": "25057c48-5d3a-35d2-92d1-786fa35b8302",
                                "text": "„Über die Position Deutschlands im internationalen Standortwettbewerb wird derzeit vor allem mit Blick auf die Steuer- und Abgabenbelastung, das Lohnkostenniveau, die Sozialleistungen und die Arbeitszeit diskutiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
