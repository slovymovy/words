                                    {
                                        "sense_id": "519d45ce-353d-3943-9be9-d4f8157f00f5",
                                        "entry_id": "8098a19f-1c09-3a51-b945-8a7128a45415",
                                        "glosses": [
                                            "mehrarmiger Leuchter mit Kerzen oder Glühlampen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2515714-e0bb-4e2c-9bed-d1ba67972f60",
                                                "sense_id": "519d45ce-353d-3943-9be9-d4f8157f00f5",
                                                "text": "„Von der Decke herab hing ein großer, funkelnder Kandelaber aus Murano-Glas, auch er ein Überbleibsel der italienischen Zwischenmieter.“"
                                            },
                                            {
                                                "example_id": "04d45e08-c34a-42b3-bb54-758a39e6a80d",
                                                "sense_id": "519d45ce-353d-3943-9be9-d4f8157f00f5",
                                                "text": "„Um den Tisch herum standen sieben grosse Kandelaber, ähnlich den in der Kirche gebräuchlichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea175fe7-b5a4-3d7d-bfe5-8e62148ad285",
                                        "entry_id": "8098a19f-1c09-3a51-b945-8a7128a45415",
                                        "glosses": [
                                            "Straßenlaterne mit einem oder mehreren Armen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f01815f-1ff9-41dd-a0a6-87b776dc8acc",
                                                "sense_id": "ea175fe7-b5a4-3d7d-bfe5-8e62148ad285",
                                                "text": "„Karfunkelstein erzählte, daß an den Kandelabern in der Charlottenburger Straße und in der Bismarckstraße vom Knie bis zum Adolf-Hitler-Platz die Leichen von SS-Männern hingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
