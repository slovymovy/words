                        "entry_id": "70cbba20-de03-3d80-8737-5391c9324107",
                        "glosses": [
                            "Kind, das sich viel auf den Straßen aufhält"
                        ],
                        "tags": [
                            "oft abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "770fb912-d6d8-44b4-bdc4-fbfacae76491",
                                "sense_id": "3fefbc48-ba00-3c72-bc11-10d9a5b06e58",
                                "text": "In seiner Kindheit war er ein Straßenkind, jeden Tag hat er auf der Straße Fußball gespielt."
                            }
                        ],
                        "sense_index_json": "\"2\""
