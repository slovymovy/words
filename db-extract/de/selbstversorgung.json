                "senses": [
                    {
                        "sense_id": "6eb9b228-3807-3861-9a8d-d8f768f607ce",
                        "entry_id": "fec8854a-01a9-395b-b2ac-ff3befc771f9",
                        "glosses": [
                            "eigenständige Herstellung von Nahrung oder sonstigen Gütern zum Eigenverbrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ad367a-20ba-42aa-850b-88389c20b7d4",
                                "sense_id": "6eb9b228-3807-3861-9a8d-d8f768f607ce",
                                "text": "Die Selbstversorgung älterer Menschen endet mit der persönlichen Beweglichkeit oder der Einschränkung geistiger Höhe."
                            },
                            {
                                "example_id": "bdf9c4f0-caaf-442e-b6a1-1f6827eadf52",
                                "sense_id": "6eb9b228-3807-3861-9a8d-d8f768f607ce",
                                "text": "„Die Stadtverwaltung von Freiburg setzte auf Selbstversorgung.“"
                            },
                            {
                                "example_id": "a02de3ef-743a-4152-9178-a99e1a7e57c9",
                                "sense_id": "6eb9b228-3807-3861-9a8d-d8f768f607ce",
                                "text": "Die Selbstversorgung intakter Betriebe oder ganzer Staaten ist Grundvoraussetzung für wirtschaftlichen Aufschwung und nachhaltigen Export."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
