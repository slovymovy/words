                    "sense_id": "76cffc2f-f9ba-3b2f-b2a0-dedcbacb9735",
                    "sense_definition": "czynność rozdzielenia czegoś na części, kawałki lub pomiędzy kogoś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dzielenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spotkałem się z moją byłą żoną, żeby omówić sprawiedliwy <w>podział</w> majątku.",
                            "target_lang_translations": {
                                "ru": "Я встретился с бывшей женой, чтобы обсудить справедливый <w>раздел</w> имущества."
                            }
                        },
                        {
                            "text": "Nauczyciel zaproponował <w>podział</w> klasy na dwie równe grupy przed rozpoczęciem gry.",
                            "target_lang_translations": {
                                "ru": "Учитель предложил <w>деление</w> класса на две равные группы перед началом игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozdzielenie",
                        "rozbicie"
                    ],
                    "antonyms": [
                        "połączenie",
                        "zjednoczenie"
                    ],
                    "common_phrases": [
