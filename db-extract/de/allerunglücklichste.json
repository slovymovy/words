                ],
                "senses": [
                    {
                        "sense_id": "75201fd4-539c-38fa-8f8d-dc302031462b",
                        "entry_id": "3ccac627-e517-3a2e-b346-2dbf690dd576",
                        "glosses": [
                            "unglücklich/unglücklichste"
                        ],
                        "tags": [
                            "verstärkend für"
                        ],
                        "examples": [
                            {
                                "example_id": "10ae46d1-eda7-403f-8ea7-1a4c8f54cef3",
                                "sense_id": "75201fd4-539c-38fa-8f8d-dc302031462b",
                                "text": "„Wenn man an einem dunklen Ort allein ist, wo man nicht sehen kann, wohin nur einmal am Tage der Mann kommt, der das Essen bringt, wo man nur in gebückter Haltung herumgehen kann, dann ist man der allerunglücklichste Mensch.“"
                            },
                            {
                                "example_id": "1e89d806-a440-47a9-a839-84cf552500b0",
                                "sense_id": "75201fd4-539c-38fa-8f8d-dc302031462b",
                                "text": "„»Ich bin die allerunglücklichste Mutter von der Welt,« schluchzte die unselige Helene.“"
                            },
                            {
                                "example_id": "cd2110c4-2de0-49d3-92cb-1c3b5d8f6890",
                                "sense_id": "75201fd4-539c-38fa-8f8d-dc302031462b",
                                "text": "„Die Herzogin von Sanseverina wurde der trübseligen Fürstin von Parma, Clara Paolina, vorgestellt, die sich, weil ihr Mann eine Mätresse hatte (eine recht hübsche Frau, die Marchesa Balbi), für das allerunglücklichste Weib auf Erden hielt.“"
                            },
                            {
                                "example_id": "84071aec-b109-4358-81de-7a550e246719",
                                "sense_id": "75201fd4-539c-38fa-8f8d-dc302031462b",
                                "text": "„Eine geschiedene Frau, das ist nicht Fisch, nicht Fleisch, nicht Frau und auch nicht Mädchen! Das ist das allerunglücklichste Wesen von der Welt!“"
                            },
                            {
                                "example_id": "daa5a5a5-1279-4e82-99a9-aa6087595005",
                                "sense_id": "75201fd4-539c-38fa-8f8d-dc302031462b",
                                "text": "„Ach, allerschönste Prinzessin, verlangt nur das nicht von mir! Ich bin der allerunglücklichste Mensch unter der Sonne und habe den allerhäßlichsten Namen.“"
                            },
                            {
                                "example_id": "d8e63794-4893-46e4-b9c4-ef7569ed3f51",
                                "sense_id": "75201fd4-539c-38fa-8f8d-dc302031462b",
                                "text": "adverbiell: „Ein Krieg, in welchen die Niederlande mit den Hansestädten verwickelt wurden, fiel für die erstern allerunglücklichst aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
