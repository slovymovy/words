                "senses": [
                    {
                        "sense_id": "83fe3cdd-e9b4-30c7-8c2a-8c6745eaa23a",
                        "entry_id": "34ffa80e-4851-3cd5-9df5-ce1ba0bf92e0",
                        "glosses": [
                            "ein Eiweiß auf der Zellmembran der roten Blutkörperchen im menschlichen Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7a5905-5254-4a0e-a330-de210fac2dad",
                                "sense_id": "83fe3cdd-e9b4-30c7-8c2a-8c6745eaa23a",
                                "text": "„Dass dieses Charakteristikum des menschlichen Blutes auf Erkenntnisse aus Tierversuchen mit Affen zurückgeht, sagt schon der Name: Rhesusfaktor leitet sich vom Rhesusaffen (Macaca mulatta) ab. Diese Affen weisen den Faktor ebenfalls auf und der Name geht auf die Verwendung von Erythrozyten (rote Blutkörperchen) aus dem Blut von Rhesusaffen für die Gewinnung der ersten Testseren zurück“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "119587e4-df1c-427d-8cf4-91dfba01f02b",
                        "source_entry_id": "34ffa80e-4851-3cd5-9df5-ce1ba0bf92e0",
                        "source_sense_id": "83fe3cdd-e9b4-30c7-8c2a-8c6745eaa23a",
                        "source_sense_description": "ein Eiweiß auf der Zellmembran der roten Blutkörperchen im menschlichen Blut",
                        "target_lang_word": "Rhesus factor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhesus factor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9141f6-b8b5-3f58-9e1e-4dbfc209233f",
                                        "entry_id": "0fdcfae0-8fe6-36aa-9fbe-ec85a637649a",
                                        "glosses": [
                                            "An antigen of the Rhesus system; understood unless otherwise specified to refer to Rhesus factor D (RhD), which appears on the surface of the red blood cells of most (85%) humans. An incompatibility between the Rh-blood types of a mother and her baby may cause serious disease for the baby."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc725be4-ab22-4395-b706-3368ca569fc2",
                        "source_entry_id": "34ffa80e-4851-3cd5-9df5-ce1ba0bf92e0",
                        "source_sense_id": "83fe3cdd-e9b4-30c7-8c2a-8c6745eaa23a",
                        "source_sense_description": "ein Eiweiß auf der Zellmembran der roten Blutkörperchen im menschlichen Blut",
                        "target_lang_word": "резус-фактор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "резус-фактор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "219d27b4-46f4-338f-952f-7934c28ea370",
                                        "entry_id": "52197ace-2b3f-3f82-ae74-7d5adabcd610",
                                        "glosses": [
                                            "генет. система аллогенных антигенов (веществ, стимулирующих выработку антител)) в крови человека, независимая от факторов, определяющих группы крови"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a265ad9-4b80-4ebb-aa09-66ccdb9e79d8",
                                                "sense_id": "219d27b4-46f4-338f-952f-7934c28ea370",
                                                "text": "Единственный совет, который до последнего времени мог дать врач резус-отрицательной женщине, ― выходить замуж только за резус-отрицательного мужчину: только это гарантировало отрицательный резус-фактор у ребенка."
                                            },
                                            {
                                                "example_id": "6f3d1fdc-0207-4658-9a0d-0150c0e3b849",
                                                "sense_id": "219d27b4-46f4-338f-952f-7934c28ea370",
                                                "text": "Резус-фактор – это белок, который находится на поверхности эритроцитов. Он может присутствовать (положительный резус) или отсутствовать (резус отрицательный). Около 85% людей являются резус-положительными, 15% – резус-отрицательными."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
