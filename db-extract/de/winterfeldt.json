                ],
                "senses": [
                    {
                        "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                        "entry_id": "b069454d-4bdd-317f-a305-2187ff84519e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9f2fe4-85e0-4472-8ea4-ed71548adbad",
                                "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                                "text": "Frau Winterfeldt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9963a462-2855-4df6-a270-84d6ced4399c",
                                "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                                "text": "Herr Winterfeldt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "885837c8-583f-4bb3-9e1c-964edcd1f1de",
                                "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                                "text": "Die Winterfeldts kommen heute aus Irland."
                            },
                            {
                                "example_id": "d9fb984a-6c73-47a2-b7a7-273c7a2c85af",
                                "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                                "text": "Der Winterfeldt trägt nie die Schals, die die Winterfeldt ihm strickt."
                            },
                            {
                                "example_id": "cdbb16cc-7091-42cb-a3c9-d744a7912c28",
                                "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Winterfeldt kommt, geht der Herr Winterfeldt.“"
                            },
                            {
                                "example_id": "f9982508-e34d-451e-93fc-2300377c0d93",
                                "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                                "text": "Winterfeldt kommt und geht."
                            },
                            {
                                "example_id": "08d06fa4-515c-48b9-b897-8e69939c823a",
                                "sense_id": "764f7f9f-5aa6-33cd-87d5-823c261f5536",
                                "text": "Winterfeldts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
