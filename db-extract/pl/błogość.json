                                "target_senses": [
                                    {
                                        "sense_id": "ed96f072-642c-3eed-9470-312d446a9d83",
                                        "entry_id": "6a84b062-9550-36c3-af5b-c9622d7b9f02",
                                        "glosses": [
                                            "Supreme, utmost bliss and happiness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26dd0c01-4418-41d0-bbda-f3aaf3afa3a6",
                                                "sense_id": "ed96f072-642c-3eed-9470-312d446a9d83",
                                                "text": "Here is Gregson coming down the road with beatitude written upon every feature of his face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867150e0-c08d-35de-806a-967f879ef6a2",
                                        "entry_id": "6a84b062-9550-36c3-af5b-c9622d7b9f02",
                                        "glosses": [
                                            "Any of the Biblical blessings given by Jesus in Matthew 5:3–12. E.g.: \\\"Blessed are the meek for they shall inherit the earth\\\" (Matthew 5:5)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a1097a1-177e-473e-814c-02eadef38566",
                        "source_entry_id": "a7b9c725-145b-3c2c-8144-4389b6ccb50a",
                        "source_sense_id": "e3867a7d-1c32-3d10-bc1e-74bc030cc16e",
                        "target_lang_word": "bliss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bliss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f799743-9232-3f2a-892b-39a0b4a98e9c",
                                        "entry_id": "7b4b2a82-b653-33b5-ae86-f1e7823e6d37",
                                        "glosses": [
                                            "Perfect happiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b848293-b30d-47ac-8eee-1bdd4a2763ab",
                                                "sense_id": "0f799743-9232-3f2a-892b-39a0b4a98e9c",
                                                "text": "The afternoon at the spa was utter bliss."
                                            },
                                            {
                                                "example_id": "1fc321bf-b116-4007-9d01-d7ba38f3d965",
                                                "sense_id": "0f799743-9232-3f2a-892b-39a0b4a98e9c",
                                                "text": "Bliss was it in that dawn to be alive, / But to be young was very heaven!"
                                            },
                                            {
                                                "example_id": "eb8db48e-56e8-4a26-b874-1e986abe11e7",
                                                "sense_id": "0f799743-9232-3f2a-892b-39a0b4a98e9c",
                                                "text": "What can you do if you are thirty and, turning the corner of your own street, you are overcome, suddenly, by a feeling of bliss—absolute bliss!—as though you'd suddenly swallowed a bright piece of that late afternoon sun and it burned in your bosom, sending out a little shower of sparks into every particle, into every finger and toe?"
                                            },
                                            {
                                                "example_id": "c64ec777-1bf9-486c-a83f-2b23d17418b2",
                                                "sense_id": "0f799743-9232-3f2a-892b-39a0b4a98e9c",
                                                "text": "When they insist on knowing my bliss\nI tell them this\nWhen they want to know what the reason is\nI only smile when I lie, then I tell them why"
                                            },
                                            {
                                                "example_id": "83da39fe-c8cb-4ad6-94ff-76ea0b29119e",
                                                "sense_id": "0f799743-9232-3f2a-892b-39a0b4a98e9c",
                                                "text": "So who is this saying that money is bliss?\nYour logic remiss\nYou and the devil about to kiss"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13641e2c-1690-476e-a6f4-8a06f34fd717",
                        "source_entry_id": "a7b9c725-145b-3c2c-8144-4389b6ccb50a",
                        "source_sense_id": "e3867a7d-1c32-3d10-bc1e-74bc030cc16e",
                        "target_lang_word": "felicity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "felicity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "733bdfab-1a00-355f-80d5-a6fcc59e5b5b",
                                        "entry_id": "c5e1e4f4-8bc4-36a8-9478-e8f58ccc54aa",
                                        "glosses": [
                                            "Happiness; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01867db9-a1b6-40a7-a664-ea7b53bb2283",
                                                "sense_id": "733bdfab-1a00-355f-80d5-a6fcc59e5b5b",
                                                "text": "Whan this ſayd monument diſcouered was / Suche a ſuauite and fragrant odoure / Aſcended from the corps by ſingular grace / Paſſyng all worldly ſwetnes and ſauour / That all there present that day and hour / Suppoſed they had ben / in the felicite / Of erthely paradiſe / without ambiguite."
                                            },
                                            {
                                                "example_id": "3ee45c79-ec0b-427f-b338-3c4e4f2a8c7f",
                                                "sense_id": "733bdfab-1a00-355f-80d5-a6fcc59e5b5b",
                                                "text": "[T]he wiſe Man gave his Teſtimony to this, as the juſt Standard of true Felicity, when he prayed to have neither Poverty nor Riches."
                                            },
                                            {
                                                "example_id": "a60b2119-c2ee-4616-8cd9-ed4548b65d4c",
                                                "sense_id": "733bdfab-1a00-355f-80d5-a6fcc59e5b5b",
                                                "text": "[…] Mr. and Mrs. Norris began their career of conjugal felicity with very little less than a thousand a year."
                                            },
                                            {
                                                "example_id": "aa55d27d-5008-40d1-a748-f97c6c1a491b",
                                                "sense_id": "733bdfab-1a00-355f-80d5-a6fcc59e5b5b",
                                                "text": "For two reasons then it is right to be content with that which happens to thee; the one, because it was done for thee and prescribed for thee, and in a manner had reference to thee, originally from the most ancient causes spun with thy destiny; and the other, because even that which comes severally to every man is to the power which administers the universe a cause of felicity and perfection, nay even of its very continuance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ca7e2fc-f7fb-3689-8c89-2f4ff284aff6",
                                        "entry_id": "c5e1e4f4-8bc4-36a8-9478-e8f58ccc54aa",
                                        "glosses": [
                                            "An apt and pleasing style in speech, writing, etc.; (countable) an apt and pleasing choice of words."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdf3816a-ac40-3c0a-a6c9-fb361a4b2b34",
                                        "entry_id": "c5e1e4f4-8bc4-36a8-9478-e8f58ccc54aa",
                                        "glosses": [
                                            "Good luck; success; (countable) An instance of unexpected good luck; a stroke of luck; also, a lucky characteristic."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9a22b31-661d-3c1f-a3bd-7ed4b834856a",
                                        "entry_id": "c5e1e4f4-8bc4-36a8-9478-e8f58ccc54aa",
                                        "glosses": [
                                            "Reproduction of a sign with fidelity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c779f580-18c2-4109-9ac8-a854da19ad13",
                                                "sense_id": "a9a22b31-661d-3c1f-a3bd-7ed4b834856a",
                                                "text": "The quotation was rendered with felicity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bce6d3d-9587-3805-a728-acaebeb8d8c3",
                                        "entry_id": "c5e1e4f4-8bc4-36a8-9478-e8f58ccc54aa",
                                        "glosses": [
                                            "Something that is either a source of happiness or particularly apt."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82bc5172-656e-4b94-90f3-1777ea9c5b0e",
                                                "sense_id": "4bce6d3d-9587-3805-a728-acaebeb8d8c3",
                                                "text": "[…] to weare our ſelues & neuer reſt,\nUntill we reach the ripeſt fruites of all,\nThat perfect bliſſe and ſole felicitie,\nThe ſweet fruition of an earthly crowne."
                                            },
                                            {
                                                "example_id": "aa5f883d-aa3c-40d5-b2d1-0672d097c3c9",
                                                "sense_id": "4bce6d3d-9587-3805-a728-acaebeb8d8c3",
                                                "text": "The season’s main attraction, the felicities of the sun, dimmed in the light of our competition and our growing friendliness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa99b65a-cb66-3158-bc74-16e676aa8003",
                                        "entry_id": "c5e1e4f4-8bc4-36a8-9478-e8f58ccc54aa",
                                        "glosses": [
                                            "Period (as opposed to lifetime) utility."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7bdce5d-95dd-4243-87a9-760f13e16897",
                                                "sense_id": "fa99b65a-cb66-3158-bc74-16e676aa8003",
                                                "text": "In equation (19.24) U#95;C(#92;cdot) is the marginal felicity of consumption[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5f9fc30-4e7d-4e46-8178-da2ad85586f4",
                        "source_entry_id": "a7b9c725-145b-3c2c-8144-4389b6ccb50a",
                        "source_sense_id": "e3867a7d-1c32-3d10-bc1e-74bc030cc16e",
                        "target_lang_word": "béatitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béatitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                                        "glosses": [
                                            "Félicité dont les élus jouissent au paradis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e77094-eb5b-43c2-ac37-2c19a8a459bd",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "Ceux-là ne navigueront plus sur les mers mauvaises parce qu’ils ont trouvé le port et que l’ancre a été jetée dans l’incomparable béatitude."
                                            },
                                            {
                                                "example_id": "7cf1e5dc-8d5b-4b8e-aee1-6efdf4d192ac",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "J’ai commencé dès ma douzième année à me faire une certaine idée que Donzac, l’année dernière et cette année, m’a rendue claire, c’est qu’à leur insu, les chrétiens qui nous ont élevés prennent en tout le contrepied de l’Évangile, et que de chaque béatitude du Sermon sur la Montagne, ils ont fait une malédiction : qu’ils ne sont pas doux, qu’ils ne sont pas seulement injustes mais qu’ils exècrent la justice."
                                            },
                                            {
                                                "example_id": "bd48a833-516d-47a9-9165-8d60edf67c90",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "La vraie béatitude consiste dans la vue de Dieu. — Les huit béatitudes, les huit sortes de félicités dont l’évangile fait l’énumération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                                        "glosses": [
                                            "Bonheur parfait, satisfaction tranquille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c79dab-4b80-47e0-b64c-cf23ba4055a1",
                                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                                "text": "Un grand chat noir, frileusement roulé en boule, rêvait dans la lueur rouge du feu, avec un tout petit ronron de béatitude."
                                            },
                                            {
                                                "example_id": "754abccf-eefc-4198-92ea-cb7a64bfc0fb",
                                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                                "text": "Je sens mes intestins qui ronronnent légèrement. La digestion sans heurts est le plus grand facteur d'activité. Le cerveau s'emplit avec le ventre et l'optimisme a sa source dans la béatitude des tripes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
