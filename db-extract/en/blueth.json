                "senses": [
                    {
                        "sense_id": "2d92f8d7-db95-3f54-b3f3-b4780d5041c4",
                        "entry_id": "e7979974-105c-36a3-9f05-83d5f3792458",
                        "glosses": [
                            "The state of being blue; blueness."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e7d8c89e-2873-4e27-8856-a334fded6816",
                                "sense_id": "2d92f8d7-db95-3f54-b3f3-b4780d5041c4",
                                "text": "I have long been mortified that for these three years you have seen it only in winter: it is now in the height of its greenth, blueth, gloomth, honey-suckle, and seringahood."
                            },
                            {
                                "example_id": "9a14419e-54c8-4554-bc44-57180cf81634",
                                "sense_id": "2d92f8d7-db95-3f54-b3f3-b4780d5041c4",
                                "text": "[…] where it should appear lightly touched with blue. The bluth of the cheeks should rather be rich than glaring: […]"
                            },
                            {
                                "example_id": "2a958bbf-1533-4a05-bd09-9a5cfd11cfca",
                                "sense_id": "2d92f8d7-db95-3f54-b3f3-b4780d5041c4",
                                "text": "The sky and the distances, as you looked down the Etschthal, had what in Devonshire is called the \"blueth\" of Italy."
                            },
                            {
                                "example_id": "e7b13bcb-b7a4-4fed-a227-055f5f33ca47",
                                "sense_id": "2d92f8d7-db95-3f54-b3f3-b4780d5041c4",
                                "text": "One sits — a small \"one\" among twenty thousand — drowned in liquid blueth (there ought to be such a word as blueth, even if there isn't) and drowned also in heavenly floods of music."
                            }
                        ]
                    }
