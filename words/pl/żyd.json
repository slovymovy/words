{
    "word_family": [
        "żydowski",
        "żydówka",
        "żydostwo"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "356a64c0-814b-35f7-a9d0-fc1faf97d333",
                    "sense_definition": "Członek narodu żydowskiego; osoba mająca żydowskie pochodzenie etniczne lub kulturowe (zapisywane wielką literą).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ethnicity",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "Współcześni <w>Żydzi</w> pielęgnują tradycje i historię swoich przodków.",
                            "target_lang_translations": {
                                "ru": "Современные <w>евреи</w> берегут традиции и историю своих предков.",
                                "en": "Contemporary <w>Jews</w> cherish the traditions and history of their ancestors."
                            }
                        },
                        {
                            "text": "W tym mieście przed wojną mieszkali obok siebie Polacy i <w>Żydzi</w>.",
                            "target_lang_translations": {
                                "ru": "В этом городе до войны жили рядом поляки и <w>евреи</w>.",
                                "en": "Before the war, Poles and <w>Jews</w> lived side by side in this town."
                            }
                        }
                    ],
                    "synonyms": [
                        "Izraelita",
                        "Hebrajczyk"
                    ],
                    "common_phrases": [
                        "naród żydowski",
                        "kultura żydowska",
                        "historia Żydów"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pisane wielką literą"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член еврейского народа; лицо, имеющее еврейское этническое или культурное происхождение (пишется с большой буквы).",
                        "en": "A member of the Jewish people; a person of Jewish ethnic or cultural origin (capitalized)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еврей",
                                "target_lang_sense_clarification": "национальность"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Jew",
                                "target_lang_sense_clarification": "ethnicity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "360ad689-bb84-3ec4-a521-bce161384e8e",
                    "sense_definition": "Wyznawca judaizmu, religii mojżeszowej.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdy pobożny <w>żyd</w> ściśle przestrzega zasad szabatu.",
                            "target_lang_translations": {
                                "ru": "Каждый набожный <w>еврей</w> строго соблюдает правила шаббата.",
                                "en": "Every devout <w>Jew</w> strictly observes the rules of the Sabbath."
                            }
                        },
                        {
                            "text": "W synagodze zebrali się ortodoksyjni <w>żydzi</w> na wspólną modlitwę.",
                            "target_lang_translations": {
                                "ru": "В синагоге собрались ортодоксальные <w>иудеи</w> на совместную молитву.",
                                "en": "Orthodox <w>Jews</w> gathered in the synagogue for joint prayer."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyznawca judaizmu",
                        "starozakonny"
                    ],
                    "antonyms": [
                        "goj"
                    ],
                    "common_phrases": [
                        "ortodoksyjny żyd",
                        "pobożny żyd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последователь иудаизма, иудейской религии.",
                        "en": "An adherent of Judaism, the Mosaic religion."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иудей",
                                "target_lang_sense_clarification": "религиозная принадлежность"
                            },
                            {
                                "target_lang_word": "еврей",
                                "target_lang_sense_clarification": "последователь веры"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Jew",
                                "target_lang_sense_clarification": "religious adherent"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd0f3214-e3c1-3f68-9159-61e373332bb1",
                    "sense_definition": "Osoba bardzo skąpa, chciwa i nadmiernie oszczędna (określenie obraźliwe).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie bądź taki <w>żyd</w> i pożycz mi te kilka złotych na bilet.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>жмотом</w> и одолжи мне эти несколько злотых на билет.",
                                "en": "Don't be such a <w>cheapskate</w> and lend me a few zlotys for the ticket."
                            }
                        },
                        {
                            "text": "Zachował się jak <w>żyd</w>, nie zostawiając kelnerowi ani grosza napiwku.",
                            "target_lang_translations": {
                                "ru": "Он повел себя как <w>скряга</w>, не оставив официанту ни гроша чаевых.",
                                "en": "He acted like a <w>miser</w>, not leaving the waiter a single penny as a tip."
                            }
                        }
                    ],
                    "synonyms": [
                        "skąpiec",
                        "sknera",
                        "chytrus",
                        "dusigrosz",
                        "centuś"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "obraźliwe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень скупой, жадный и чрезмерно экономный человек (оскорбительное определение).",
                        "en": "A very stingy, greedy, or excessively frugal person (offensive)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скряга",
                                "target_lang_sense_clarification": "скупой человек"
                            },
                            {
                                "target_lang_word": "жмот",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "жид",
                                "target_lang_sense_clarification": "оскорбительное"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "miser",
                                "target_lang_sense_clarification": "stingy person"
                            },
                            {
                                "target_lang_word": "cheapskate",
                                "target_lang_sense_clarification": "informal"
                            },
                            {
                                "target_lang_word": "Jew",
                                "target_lang_sense_clarification": "offensive, derogatory slur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a987c243-c40a-35ed-978f-85bc2a7afc2b",
                    "sense_definition": "Duża, nieestetyczna plama z atramentu na papierze.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pióro wylało mi w trakcie pisania i w zeszycie zrobił się wielki <w>żyd</w>.",
                            "target_lang_translations": {
                                "ru": "Ручка потекла во время письма, и в тетради получилась огромная <w>клякса</w>.",
                                "en": "My pen leaked while writing and left a huge <w>inkblot</w> in my notebook."
                            }
                        },
                        {
                            "text": "Nauczycielka obniżyła ocenę za liczne <w>żydy</w> i skreślenia w wypracowaniu.",
                            "target_lang_translations": {
                                "ru": "Учительница снизила оценку за многочисленные <w>кляксы</w> и зачеркивания в сочинении.",
                                "en": "The teacher lowered the grade due to numerous <w>blots</w> and crossings-out in the essay."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zrobić żyda"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "gwara uczniowska"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое, неэстетичное чернильное пятно на бумаге.",
                        "en": "A large, unsightly ink blot on paper (dated school slang)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клякса",
                                "target_lang_sense_clarification": "чернильное пятно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "inkblot",
                                "target_lang_sense_clarification": "stain on paper"
                            },
                            {
                                "target_lang_word": "blot",
                                "target_lang_sense_clarification": "ink stain"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}