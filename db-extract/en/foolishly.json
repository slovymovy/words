                "translations": [
                    {
                        "translation_id": "a5e1be10-8421-4503-836e-4e8c466ef0a3",
                        "source_entry_id": "982569a9-4ff0-3c5b-b28e-917dc354c8ca",
                        "source_sense_id": "cf56986b-b655-34e8-824e-ada455123023",
                        "source_sense_description": "töricht, törichterweise",
                        "target_lang_word": "töricht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "töricht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62d658c5-1022-3c0e-b322-e96c46f36db0",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "ohne Vernunft und Überlegung"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daac3354-8ce8-4925-96cd-f2dd12bc0b38",
                                                "sense_id": "62d658c5-1022-3c0e-b322-e96c46f36db0",
                                                "text": "Es wäre äußerst töricht, wenn du dieses Stellenangebot ausschlügest."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c43146f-47c8-3f8b-ab58-514775d3e5c5",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "keinen Argwohn zeigend; nicht besonders schlau, klug"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f96ceb1d-4d15-4322-ab63-43e7fd9b9462",
                                                "sense_id": "4c43146f-47c8-3f8b-ab58-514775d3e5c5",
                                                "text": "Immer wenn ich dich etwas frage, lächelst du nur töricht zurück."
                                            },
                                            {
                                                "example_id": "3ef720bb-8232-4c38-9775-ab1ae9c3a8c2",
                                                "sense_id": "4c43146f-47c8-3f8b-ab58-514775d3e5c5",
                                                "text": "„Man kann hier natürlich sagen, das Tier sei zu töricht, um die Sinnlosigkeit seines Verfahrens einzusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a228e2ba-ab87-37cc-9207-4e7309785ca5",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "ohne Erfolg oder Hoffnung, sich nicht lohnend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e748a3-154d-4df8-9934-aaeaea152092",
                                                "sense_id": "a228e2ba-ab87-37cc-9207-4e7309785ca5",
                                                "text": "„Meine Schwester hofft auch nach 20 Jahren noch auf die Rückkehr ihres in Afrika verschwundenen Gatten.“ — „Tja, das ist wohl eine törichte Hoffnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "267c5120-ca90-36ae-874d-24000eb01814",
                                        "entry_id": "509a411f-00c0-3be9-9d23-161856b7659f",
                                        "glosses": [
                                            "besonders seltsam, unsinnig oder ärgerlich wirkend"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb35c15-3d76-46da-9251-b47b6d7c242e",
                                                "sense_id": "267c5120-ca90-36ae-874d-24000eb01814",
                                                "text": "Dein ewiges törichtes Verhalten bei Tisch kannst du dir mal abgewöhnen."
                                            },
                                            {
                                                "example_id": "38f737e3-3e82-48e3-a2b1-5b249a1da03e",
                                                "sense_id": "267c5120-ca90-36ae-874d-24000eb01814",
                                                "text": "Selbst im Hirn des weisesten Mannes gibt es einen törichten Winkel. (Aristoteles 384–322 v.Chr.)"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
