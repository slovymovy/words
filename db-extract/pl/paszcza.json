                    {
                        "translation_id": "9e9b31ae-4466-4324-840b-24a94bfa4b37",
                        "source_entry_id": "d1447f46-3551-35ee-8ce3-7f775258e4a5",
                        "source_sense_id": "00ea487c-822c-39a5-bc69-ad1e5f6ff25f",
