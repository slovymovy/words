                ],
                "senses": [
                    {
                        "sense_id": "73c16c46-6f20-3c4b-9678-8c792c4d971e",
                        "entry_id": "848fb49a-9ddc-3ec3-b01f-432dd29a8e9d",
                        "glosses": [
                            "Soutenir en chantant le travail des bœufs qui traînent la charrue."
                        ],
                        "tags": [
                            "Berry"
                        ],
                        "examples": [
                            {
                                "example_id": "47dd135e-28dd-496e-a683-0bb8e41fede7",
                                "sense_id": "73c16c46-6f20-3c4b-9678-8c792c4d971e",
                                "text": "Malgré tout ce que j’invente ici pour chasser le spleen que cette belle capitale me donne toujours, j’ai toujours le cœur enflé d’un gros soupir quand je pense aux terres labourées, aux noyers autour des guérets, aux bœufs briolés par la voix des laboureurs, et à nos bonnes réunions, rares, il est vrai, mais toujours si douces et, si complètes."
                            },
                            {
                                "example_id": "6e98ddb2-3d44-423b-bce2-fe859bd0cb1f",
                                "sense_id": "73c16c46-6f20-3c4b-9678-8c792c4d971e",
                                "text": "L’usage de brioler les bœufs remonte à la plus haute antiquité."
                            },
                            {
                                "example_id": "a2cc98c2-9bfe-444d-8f97-da2175781de3",
                                "sense_id": "73c16c46-6f20-3c4b-9678-8c792c4d971e",
                                "text": "Bien brioler est chose rare ; aussi prise-t-on beaucoup les laboureurs dont la voix pleine et sonore sait trembler et soutenir indéfiniment les notes graves et lentes de ce chant primitif."
                            }
                        ]
                    }
                ],
