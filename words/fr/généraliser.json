            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ae551b6-0371-3a86-9704-b91ec33eb77e",
                    "sense_definition": "Tirer une conclusion globale ou une règle générale à partir de cas particuliers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "raisonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas <w>généraliser</w> à partir d'une seule mauvaise expérience."
                        },
                        {
                            "text": "Dans son analyse sociologique, le journaliste évite soigneusement de <w>généraliser</w>."
                        }
                    ],
                    "synonyms": [
                        "extrapoler"
                    ],
                    "antonyms": [
                        "particulariser",
                        "nuancer"
                    ],
                    "common_phrases": [
                        "tendance à généraliser",
                        "sans vouloir généraliser"
                    ]
                },
                {
                    "sense_id": "0fc7f436-7322-3217-8b01-babaf51b20d0",
                    "sense_definition": "Étendre l'application ou l'usage de quelque chose à un ensemble plus vaste ou à tous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise souhaite <w>généraliser</w> le télétravail pour tous ses employés dès le mois prochain."
                        },
                        {
                            "text": "Le gouvernement a décidé de <w>généraliser</w> ce dispositif à l'ensemble des écoles du pays."
                        }
                    ],
                    "synonyms": [
                        "diffuser",
                        "propager",
                        "étendre"
                    ],
                    "antonyms": [
                        "limiter",
                        "restreindre"
                    ],
                    "common_phrases": [
                        "généraliser l'usage",
                        "généraliser une pratique",
                        "généraliser une mesure"
                    ]
                },
                {
                    "sense_id": "f9a26413-df83-317b-bee0-444dfaf3f661",
                    "sense_definition": "Devenir commun, habituel ou répandu dans une population ou un domaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'utilisation des smartphones a commencé à se <w>généraliser</w> au début des années 2010."
                        },
                        {
                            "text": "Cette méthode de travail moderne tend à se <w>généraliser</w> rapidement dans le secteur technologique."
                        }
                    ],
                    "synonyms": [
                        "se propager",
                        "se répandre"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'estomper"
                    ],
                    "common_phrases": [
                        "se généraliser rapidement"
                    ]
                },
                {
                    "sense_id": "8196049b-e1bf-3864-8048-30043b7f124b",
                    "sense_definition": "Élargir la portée conceptuelle ou l'énoncé d'une théorie, d'une hypothèse ou d'une formule.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "raisonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs ont réussi à <w>généraliser</w> ce théorème à des espaces de dimension quelconque."
                        },
                        {
                            "text": "Ce scientifique cherche à <w>généraliser</w> son hypothèse de départ pour englober de nouveaux phénomènes physiques."
                        }
                    ],
                    "synonyms": [
                        "élargir"
                    ],
                    "antonyms": [
                        "spécifier"
                    ],
                    "common_phrases": [
                        "généraliser une formule",
                        "généraliser un théorème"
                    ]
                }
            ]
        }
    ]
