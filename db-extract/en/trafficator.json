                        "entry_id": "9dced9fe-a211-3f55-8547-3d9f2f700d77",
                        "glosses": [
                            "A blinking light on a motor vehicle that indicates the direction in which it is about to turn."
                        ],
                        "tags": [
                            "Nigeria"
                        ],
                        "examples": [
                            {
                                "example_id": "2f5823ed-168d-424d-92ba-e514b0259ff7",
                                "sense_id": "9945a581-ca8c-3b4b-9f19-b1c7aa822f13",
                                "text": "There were vehicles following me, of course, but was any of them trailing me? […] Without any warning, and without signalling with the trafficator, I took a sudden right turn, hoping to shake off my trailer."
                            }
                        ]
                    },
                    {
                        "sense_id": "96fc5746-c253-30a9-b57f-9d6ca11f46d8",
                        "entry_id": "9dced9fe-a211-3f55-8547-3d9f2f700d77",
                        "glosses": [
                            "A semaphore device with a steady light that served the same purpose on early vehicles."
                        ],
                        "tags": [
                            "historical"
                        ],
