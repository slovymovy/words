                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35631e6-7dd5-4755-b26f-525f15d30f7d",
                                "sense_id": "08d90201-53ec-3a5b-8d89-c5ba28999be4",
                                "text": "„Darunter leidet der Film. Für die Fluchtszenen nimmt sie sich viel Zeit: rennen, Blicke zurück, erschrockene Kinderaugen, wenn die Familie sich unter einem Dielenboden versteckt und die Gestapo über ihren Köpfen trampelt. Zu oft hat man solche Einstellungen in anderen Holocaust-Filmen gesehen.“"
                            }
