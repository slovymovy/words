                        "glosses": [
                            "Faire cesser d’être bête."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7ae93e14-6b51-46d8-9ddc-0838105d865c",
                                "sense_id": "42106aee-bb41-32c1-9a9a-e3713be81c35",
                                "text": "Si les autorités s’acharnaient à déprêtrailler le pays, et à débêtiser le peuple, ce n'était pas pour le laisser organiser impunément ses propres cérémonies."
                            },
                            {
                                "example_id": "4d25f796-a834-4319-85c1-5d151ce81f9f",
                                "sense_id": "42106aee-bb41-32c1-9a9a-e3713be81c35",
                                "text": "Pour vous « débêtiser » une bonne fois pour toutes, lisez, toutes affaires cessantes, le dernier livre de Jacques Généreux, recensé ci-dessous"
                            }
                        ]
                    }
