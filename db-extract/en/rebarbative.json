                        "source_sense_id": "485e1c78-541e-3ad3-9040-b8097cb68f7b",
                        "source_sense_description": "repellent",
                        "target_lang_word": "odporný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odporný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb5aaae-2866-3ecb-af0e-03de67d5fe9b",
                                        "entry_id": "5b477ea0-01e3-387d-9948-37e0710da4e5",
                                        "glosses": [
                                            "takový, jaký vzbuzuje fyzický odpor, nechuť, pocit hnusu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c01ce0-c987-428b-9cdd-ce6fc7170497",
                                                "sense_id": "4eb5aaae-2866-3ecb-af0e-03de67d5fe9b",
                                                "text": "Odporná srst a trčící zuby. Nejšerednější psi světa."
                                            },
                                            {
                                                "example_id": "43fb0749-e63f-4a39-95d5-5eb828d6d670",
                                                "sense_id": "4eb5aaae-2866-3ecb-af0e-03de67d5fe9b",
                                                "text": "Na koprovou omáčku ze školní jídelny mnozí z nás vzpomínají jako na cosi svrchovaně odporného."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc11758-ef32-33cc-a286-7fe49e121dc3",
                                        "entry_id": "5b477ea0-01e3-387d-9948-37e0710da4e5",
                                        "glosses": [
                                            "(morálně) takový, jaký vyvolává odpor, odsouzení, zavržení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f35e273f-bef7-4a4c-9531-4cce48cfe9dd",
                                                "sense_id": "3bc11758-ef32-33cc-a286-7fe49e121dc3",
                                                "text": "Členové vedení záškodnického spiknutí proti republice patří jistě k nejodpornějším zjevům ve službách západních imperialistů. Proces s nimi podává o tom od první hodiny svého zahájení nejvýraznější svědectví"
                                            },
                                            {
                                                "example_id": "554c3623-9416-467e-884b-17893a94b2f6",
                                                "sense_id": "3bc11758-ef32-33cc-a286-7fe49e121dc3",
                                                "text": "… konečně zalezl jako jedovatý plaz u vědomí, že před slušnou veřejností, sytou odporných afér, definitivně prohrál."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d007b57a-2614-3194-8555-cf753d25c974",
                                        "entry_id": "5b477ea0-01e3-387d-9948-37e0710da4e5",
                                        "glosses": [
                                            "odporující"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe76af9-b2c6-4370-a9b4-b246c02b463d",
                                                "sense_id": "d007b57a-2614-3194-8555-cf753d25c974",
                                                "text": "A protož zde obcování své míti hleď! a měj mysl ke mně co nejvýš vždycky zdviženou, k bližním co nejníž skloněnou; zemských věcí, dokud tam jsi, užívej, v nebeských se kochej; buď povolný mně, odporný a odbojný světu a tělu; ostříhej vnitř tobě ode mne udělené moudrosti, zevnitř tobě ode mne poručené sprostnosti; měj hlásné srdce, tichý jazyk: k čitedlnosti bíd bližních buď outlý, k snášení vlastních křivd otrlý; duší služ mně samému, tělem, komu můžeš aneb musíš; coť poroučím, čiň, co na tě vzkládám, nes; k světu buď neochotný, ke mně vždycky se vinoucí; v světě buď tělem, ve mně srdcem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
