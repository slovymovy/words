                                        "entry_id": "cd7f89cc-e254-39df-acf5-48fef75d4b08",
                                        "glosses": [
                                            "To induce or influence one's peers."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
