                                "example_id": "b553641a-0744-4903-ae9f-9329ea3a4398",
                                "sense_id": "7b78451b-f4b3-35f9-b606-c1f1eaad083a",
                                "text": "„Wir unterscheiden zwischen Notfallmaßnahmen (z. B. bei postrenaler Anurie), Interimslösungen und definitiven Maßnahmen.“"
                            },
