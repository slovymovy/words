                        "sense_id": "c8f7b40f-9981-3bf3-8096-fd536c2fbe9a",
                        "entry_id": "ef1f82c5-c97b-34f3-aa51-489d1bde98ed",
                        "glosses": [
                            "ruimte in gevangenis, politiebureau of gerechtsgebouw waar een verdachte ondervraagd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a2ac51-67ea-4582-952f-484abd3fa2c4",
                                "sense_id": "c8f7b40f-9981-3bf3-8096-fd536c2fbe9a",
                                "text": "De verhoorkamer is voorzien van een camera en opname apparatuur."
                            },
                            {
                                "example_id": "e901e9e8-1b87-4a68-8f5d-8db26594f09b",
                                "sense_id": "c8f7b40f-9981-3bf3-8096-fd536c2fbe9a",
                                "text": "Als een cameraman speurt hij rond in de shopping mall waar doorheen de reizigers naar hun vliegtuig worden geleid, maar ook langs de verhoorkamers waar asielzoekers hun eerste indrukken van het land van aankomst opdoen en de grenshospitia waar zij op uitwijzing wachten. Daar doet het oog zijn controlerende werk. Net als aan de grenzen van Europa waar Dijstelbloem mee mocht kijken met de nieuwe surveillance-diensten ter indamming van de migrantenstroom."
                            },
                            {
                                "example_id": "6ec52236-c00d-45e1-bcac-1a66a6baab22",
                                "sense_id": "c8f7b40f-9981-3bf3-8096-fd536c2fbe9a",
                                "text": "Ze waren waarschijnlijk boven geweest om naar haar te informeren bij de leiding, want ze toonden nu een heel ander soort respect dan toen ze het eerst de verhoorkamer binnenkwam."
                            }
                        ]
                    }
