                    {
                        "translation_id": "4fa8e7f7-9ff4-4720-8902-a7bf043a317a",
                        "source_entry_id": "0a528096-9051-37e3-8d06-f8573ef96315",
                        "target_lang_word": "треба",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
