                        "cross_references": [
                            {
                                "target_word": "clay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24e4fbc7-c739-3875-9699-eaec67817efd",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "A mineral substance made up of small crystals of silica and alumina, that is ductile when moist; the material of pre-fired ceramics."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e43cd6c1-ad24-4238-acfd-33f3072c8e39",
                                                "sense_id": "24e4fbc7-c739-3875-9699-eaec67817efd",
                                                "text": "Three chairs of the steamer type, all maimed, comprised the furniture of this roof-garden, with (by way of local color) on one of the copings a row of four red clay flower-pots filled with sun-baked dust […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d7061f-b24d-31d6-9839-780ef05c8474",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "An earth material with ductile qualities."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06f822cd-1f98-3455-bc60-46877103bbea",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "A tennis court surface made of crushed stone, brick, shale, or other unbound mineral aggregate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5411fa5f-7de0-4213-8e4c-4cf6ce9c6439",
                                                "sense_id": "06f822cd-1f98-3455-bc60-46877103bbea",
                                                "text": "The French Open is played on clay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "The material of the human body."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e0fc67-a79d-4d83-988b-78e7324bcb79",
                                                "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                                "text": "From clay we are made."
                                            },
                                            {
                                                "example_id": "299f1bfa-e493-46d4-84b1-9ef1d5607c27",
                                                "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                                "text": "Thine hands have made me and fashioned me together round about...thou hast made me as the clay."
                                            },
                                            {
                                                "example_id": "c289d8e1-9e60-4547-a918-d0987607bd6c",
                                                "sense_id": "53b1484e-9ace-3487-a1b1-9a63e3ccec1d",
                                                "text": "But now, O Lord, thou art our Father; we are the clay, and thou art our potter; and we are the work of thy hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c025d4-5b05-3843-ab23-6ed9609628fe",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "A particle less than 3.9 microns in diameter, following the Wentworth scale."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4fce871-4471-3fed-b68e-eec7c24382dc",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "A clay pipe for smoking tobacco."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "958c29fa-539d-3c5e-bc92-89ae5cf8a5af",
                                        "entry_id": "72c463be-e5a1-39d1-8cae-b1805d028edb",
                                        "glosses": [
                                            "A clay pigeon."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b266eba-0264-470c-bb0e-f55dcff91515",
                                                "sense_id": "958c29fa-539d-3c5e-bc92-89ae5cf8a5af",
                                                "text": "We went shooting clays at the weekend."
                                            }
