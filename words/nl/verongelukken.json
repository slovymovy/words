{
    "word_family": [
        "ongeluk",
        "geluk",
        "gelukkig",
        "ongelukkig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51ca5ffc-e6eb-3090-8859-607104362916",
                    "sense_definition": "bij een ongeluk om het leven komen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overlijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pierre <w>verongelukte</w> in 1906 tijdens een tragisch ongeval in Parijs.",
                            "target_lang_translations": {
                                "en": "Pierre <w>died in an accident</w> in 1906 during a tragic incident in Paris."
                            }
                        },
                        {
                            "text": "Hij is helaas op weg in de Alpen <w>verongelukt</w>.",
                            "target_lang_translations": {
                                "en": "He unfortunately <w>perished</w> on his way in the Alps."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to die in an accident or crash"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "die in a crash",
                                "target_lang_sense_clarification": "specifically in a vehicle or traffic accident"
                            },
                            {
                                "target_lang_word": "be killed in an accident",
                                "target_lang_sense_clarification": "general term for dying due to a mishap"
                            },
                            {
                                "target_lang_word": "perish",
                                "target_lang_sense_clarification": "more formal, used for dying in a disaster or accident"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e8517b-ab92-3dc4-9b59-86a52727a57e",
                    "sense_definition": "onbruikbaar worden of zwaar beschadigd raken door een ongeluk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij een kettingbotsing zijn gisteravond tien auto's <w>verongelukt</w>.",
                            "target_lang_translations": {
                                "en": "Ten cars <w>were wrecked</w> in a pile-up last night."
                            }
                        },
                        {
                            "text": "De vrachtwagen is volledig <w>verongelukt</w> en kan niet meer gerepareerd worden.",
                            "target_lang_translations": {
                                "en": "The truck <w>was completely totaled</w> and can no longer be repaired."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be destroyed or severely damaged in an accident"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be totaled",
                                "target_lang_sense_clarification": "informal, used for vehicles damaged beyond repair"
                            },
                            {
                                "target_lang_word": "be wrecked",
                                "target_lang_sense_clarification": "to be severely damaged in a collision"
                            },
                            {
                                "target_lang_word": "be destroyed",
                                "target_lang_sense_clarification": "to be rendered unusable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d00b72c5-748c-320d-9cee-64ab829d850a",
                    "sense_definition": "mislukken of niet goed terechtkomen in het leven",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mislukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kan wel zeggen dat hij sociaal gezien helemaal <w>verongelukt</w> is.",
                            "target_lang_translations": {
                                "en": "You could say that he has <w>failed</w> completely in a social sense."
                            }
                        },
                        {
                            "text": "Zijn ambitieuze plannen voor het bedrijf zijn helaas volledig <w>verongelukt</w>.",
                            "target_lang_translations": {
                                "en": "His ambitious plans for the company have unfortunately <w>fallen through</w> completely."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak figuurlijk gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to fail or to end up in a bad state in life (figurative)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fail",
                                "target_lang_sense_clarification": "to not succeed in plans or life"
                            },
                            {
                                "target_lang_word": "go wrong",
                                "target_lang_sense_clarification": "to take a turn for the worse"
                            },
                            {
                                "target_lang_word": "be ruined",
                                "target_lang_sense_clarification": "to have one's life or plans destroyed"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}