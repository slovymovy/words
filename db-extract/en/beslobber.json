                "senses": [
                    {
                        "sense_id": "422b5b65-7b9b-3b30-a119-e237c2f951a1",
                        "entry_id": "94750e33-4a8d-3950-a602-65353470acf7",
                        "glosses": [
                            "To wet, besmear, or befoul with spittle or anything running from the mouth; cover in slobber; bespawl."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cb25b4f3-13d9-4c64-a539-5c996fa20700",
                                "sense_id": "422b5b65-7b9b-3b30-a119-e237c2f951a1",
                                "text": "For one moment I had a vision of a horrible mask like a giant toad's, of a warty, leprous skin, and of a loose mouth all beslobbered with fresh blood."
                            }
                        ]
                    },
                    {
                        "sense_id": "54e8f6bf-ad7c-3f27-ae0e-3be316666c22",
                        "entry_id": "94750e33-4a8d-3950-a602-65353470acf7",
                        "glosses": [
                            "To slobber over with effusive kisses; praise or flatter fulsomely or in a fulsome manner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "900ae224-282c-4c05-9a07-21770d1afd83",
                                "sense_id": "54e8f6bf-ad7c-3f27-ae0e-3be316666c22",
                                "text": "1828, Thomas Babington Macaulay, essay?\nThe salaried Viceroy of France […] beslobbering his brother and his courtiers in a fit of maudlin affection."
                            }
                        ]
                    }
