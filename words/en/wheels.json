                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bodybuilder worked hard to build his massive <w>wheels</w> for the competition.",
                            "target_lang_translations": {
                                "ru": "Бодибилдер усердно работал, чтобы раскачать свои массивные <w>ноги</w> к соревнованиям.",
