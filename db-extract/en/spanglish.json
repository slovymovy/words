                    {
                        "sense_id": "86c66096-da14-39e6-96d7-6aa539fcd3ba",
                        "entry_id": "c2bdfac1-af6e-3a63-b2fb-7a970c90c274",
                        "glosses": [
                            "A language blend of English and Spanish spoken by both Latinas, Latinos, and Anglo-Americans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba96b63d-2352-4edd-8156-f07489536993",
                                "sense_id": "86c66096-da14-39e6-96d7-6aa539fcd3ba",
                                "text": "The Nobel laureate Octavio Paz is said to have had it that Spanglish is “neither good, nor bad, but abominable.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "049a973d-1db3-3130-8ad6-403c172a3248",
                        "entry_id": "c2bdfac1-af6e-3a63-b2fb-7a970c90c274",
                        "glosses": [
                            "The mixing of Spanish and English together in a sentence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e54c951-00eb-4269-869c-57c51da50675",
                                "sense_id": "049a973d-1db3-3130-8ad6-403c172a3248",
                                "text": "His Spanglish was quite embarrassing when he said he was \"embarazado\"."
                            }
                        ]
                    }
                ],
