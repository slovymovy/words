                                    {
                                        "sense_id": "abc5286a-81c3-3a7a-9e64-3c4d72884996",
                                        "entry_id": "65023188-4fe8-3e33-9c13-2aed0a0d4b3e",
                                        "glosses": [
                                            "unter (innerem) Druck stehend, willentlich nicht vermeidbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b18cb9ce-14d8-4e90-a0ff-a56d8b259e3d",
                                                "sense_id": "abc5286a-81c3-3a7a-9e64-3c4d72884996",
                                                "text": "„Skin Picker bearbeiten zwanghaft ihre Haut, bis offene Wunden entstehen und Narben bleiben.“"
                                            },
                                            {
                                                "example_id": "0db3da51-6e0c-40be-a2e3-84c3a716cdbf",
                                                "sense_id": "abc5286a-81c3-3a7a-9e64-3c4d72884996",
                                                "text": "„Das sogenannte Stalking, das zwanghafte Belästigen und Verfolgen einer Person, kann auch nach schweizerischem Recht strafbar sein, obwohl das Strafgesetzbuch keinen entsprechenden Straftatbestand enthält.“"
                                            },
                                            {
                                                "example_id": "9f944181-edbe-4150-94dd-33d2c11d95f9",
                                                "sense_id": "abc5286a-81c3-3a7a-9e64-3c4d72884996",
                                                "text": "„In den späteren Fünfzigern veränderte ein Literaturagent und zwanghafter Sammler von Science-Fiction-Memorabilia namens Forest J. Ackerman das Leben Tausender Kinder — ich gehörte dazu — mit seinem Magazin ‚Famous Monsters of Filmland‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e615092-eb14-359c-a26a-48753b2c33e6",
                                        "entry_id": "65023188-4fe8-3e33-9c13-2aed0a0d4b3e",
                                        "glosses": [
                                            "ohne eigenen inneren Antrieb, unecht oder gespielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656fcf47-abb9-4641-b227-c132aa13f63e",
                                                "sense_id": "3e615092-eb14-359c-a26a-48753b2c33e6",
                                                "text": "„Merken wir nicht, wie zwanghaft die Lustigkeit vieler Entertainer ist?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5f84688-f163-4b37-ac02-66a182d2cce3",
