                "senses": [
                    {
                        "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                        "entry_id": "a4c3c5ed-693d-37d5-bd78-ea7c7c154589",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc6a19e-1538-4a1b-95c3-6c6164924512",
                                "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                                "text": "Frau Gutbrod ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "92f788d0-2fdf-48c8-950d-444477a92e61",
                                "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                                "text": "Herr Gutbrod wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ece84257-a174-4ea7-979b-6f37ce65a00b",
                                "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                                "text": "Die Gutbrods fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "e79d5414-9b7f-4047-8547-8f76835821de",
                                "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                                "text": "Der Gutbrod trägt nie die Pullover, die die Gutbrod ihm strickt."
                            },
                            {
                                "example_id": "4fcd0a77-a1ef-49d0-8638-663180578105",
                                "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gutbrod kommt, geht der Herr Gutbrod.“"
                            },
                            {
                                "example_id": "e6e7f492-c040-48fb-9777-89a51a38030b",
                                "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                                "text": "Gutbrod kommt und geht."
                            },
                            {
                                "example_id": "96804832-f601-4792-b918-9f1082df05ae",
                                "sense_id": "8864bef5-616a-35ff-893c-f540a7384c2b",
                                "text": "Gutbrods kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
