                        "glosses": [
                            "verpleegkundige zorg die mensen in hun eigen woonomgeving ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3e4db5-72f2-476e-9690-10dddde061aa",
                                "sense_id": "5a02e3c3-2666-312e-b883-72a058f33e74",
                                "text": "De overheid beslist ieder jaar wat er in de basisverzekering komt. Vanuit de basisverzekering wordt de belangrijkste zorg vergoed. Een greep: een bezoek aan de huisarts; ziekenhuiszorg: de ambulance, het ziekenhuisverblijf en de behandeling door medisch specialisten; tandartskosten voor kinderen tot en met 18 jaar; kraamzorg en verloskundige hulp; fysiotherapie tot 18 jaar en voor chronische aandoeningen; geneesmiddelen; wijkverpleging; en kosten voor de apotheek."
                            },
                            {
                                "example_id": "78300a75-673b-42b3-9304-c331843064e6",
                                "sense_id": "5a02e3c3-2666-312e-b883-72a058f33e74",
                                "text": "De beroepsvereniging voor verpleegkundigen en verzorgenden (V&VN) is blij. ,,De aanhouder wint. Een jaar nadat we met onze actiedag de administratieve lastendruk in de zorg hoog op de politieke agenda zetten, is het einde van de 5-minutenregistratie in de wijkverpleging dan eindelijk in zicht.‘’"
                            }
                        ]
                    }
