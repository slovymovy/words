                                    {
                                        "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                        "entry_id": "39013504-d05b-3588-af35-a7dc3b154db4",
                                        "glosses": [
                                            "Any of species Eriobotrya japonica of trees (Japanese medlar, Chinese plum, Japanese plum)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d692e966-81a1-4d0e-acb9-4ec4eb229c0f",
                                                "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                                "text": "Japan Mespilus, or Loquat."
                                            },
                                            {
                                                "example_id": "c1ebac6c-f1aa-4fcc-b106-6706523eafdb",
                                                "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                                "text": "As far as the eye can see, one observes nothing but loquat orchards growing luxuriantly on the low, rich land, where the roots never suffer from lack of water."
                                            },
                                            {
                                                "example_id": "fc03a394-1561-4e6e-ab21-8507a21c00de",
                                                "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                                "text": "I climbed up into the loquat (Eriobotrya japonica) tree in our backyard to think."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7b128d-4a62-3745-abd8-fb8908120154",
                                        "entry_id": "39013504-d05b-3588-af35-a7dc3b154db4",
                                        "glosses": [
                                            "The fruit of this tree. It is as large as a small plum, but grows in clusters, and contains four or five large seeds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
