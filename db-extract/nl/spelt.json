                                "target_senses": [
                                    {
                                        "sense_id": "a59745df-181e-3474-9ec5-df792b6e1443",
                                        "entry_id": "bffa9b42-0f73-3a78-a31a-435038b4b5d2",
                                        "glosses": [
                                            "зерновая культура"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "030c0d00-a1b9-4cdb-89a1-ea427bd63285",
                                                "sense_id": "a59745df-181e-3474-9ec5-df792b6e1443",
                                                "text": "Поэтому спельта – отличный диетический продукт, при регулярном употреблении помогает нормализовать вес. Спельта содержит богатый набор незаменимых аминокислот, в том числе триптофан, улучшающий настроение."
                                            }
                                        ]
