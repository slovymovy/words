                        "examples": [
                            {
                                "example_id": "67027973-3aaa-42e1-bbbb-879f91441e75",
                                "sense_id": "d183617e-0e72-3006-b02e-02cb0bf9e4e9",
                                "text": "Bromeosin is nitrated in an enamelled pan placed in a water-bath."
                            },
                            {
                                "example_id": "143f5d09-d09a-438f-be07-71bd9147dcd6",
                                "sense_id": "d183617e-0e72-3006-b02e-02cb0bf9e4e9",
                                "text": "With potash solution, bromeosin gives in the cold an orange-red solution, which on boiling becomes purple-red, violet, and pure blue, with a strong green fluorescence."
                            },
                            {
                                "example_id": "27e4946f-e27d-4575-a1b2-4294012995a6",
                                "sense_id": "d183617e-0e72-3006-b02e-02cb0bf9e4e9",
                                "text": "Bromine is chiefly used for the production of bromeosins (q.v.) and for the manufacture of bromides."
                            }
                        ]
                    }
