                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Membership in the <w>EON</w> was mandatory for many Greek students during the late 1930s."
                        },
                        {
                            "text": "The regime utilized the <w>EON</w> to promote nationalist ideals among young citizens."
                        }
                    ],
                    "traits": [
