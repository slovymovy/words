                    }
                ],
                "senses": [
                    {
                        "sense_id": "95245955-3357-38bb-940b-bb152a0b4e0e",
                        "entry_id": "40fbb723-038d-303f-bee2-4233297a70b2",
                        "glosses": [
                            "Of or pertaining to dialectic; (in philosophy) logically reasoned through the exchange of opposing ideas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4fd3e9-d36b-4510-afb0-192c4dede9b3",
                                "sense_id": "95245955-3357-38bb-940b-bb152a0b4e0e",
                                "text": "Sure, maybe. We know — have long known — that romanticism and fatalism are dialectical lovers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "038a1e52-f979-4357-9f2b-f6ac641e0804",
                        "source_entry_id": "40fbb723-038d-303f-bee2-4233297a70b2",
                        "source_sense_id": "95245955-3357-38bb-940b-bb152a0b4e0e",
                        "source_sense_description": "pertaining to dialectics",
                        "target_lang_word": "dialektický",
