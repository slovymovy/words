                "senses": [
                    {
                        "sense_id": "6252eef1-8894-3703-9379-00ee3a7a2527",
                        "entry_id": "0b73e154-99bd-309c-8ce5-dfa776cbb20c",
                        "glosses": [
                            "Variante orthographique de accordéoner."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7d4a07f4-63e1-4764-b6a7-626b47b8fcb3",
                                "sense_id": "6252eef1-8894-3703-9379-00ee3a7a2527",
                                "text": "J’accordéonne son jean sur ses mollets, arrache sa culotte. Elle a un petit gémissement, …."
                            },
                            {
                                "example_id": "d10bdbe7-84c8-40bf-a697-5aa13265061b",
                                "sense_id": "6252eef1-8894-3703-9379-00ee3a7a2527",
                                "text": "Vous avez sûrement déjà vu ou possédé des bottes dont le pli du cou-de-pied a fini par se relâcher et « accordéonner » jusqu'à être importable."
                            },
                            {
                                "example_id": "c8cb5495-efdf-4674-8bf0-000731f384ae",
                                "sense_id": "6252eef1-8894-3703-9379-00ee3a7a2527",
                                "text": "C'était peut-être à une lointaine époque, mais comme chacun le sait, dans les récits, les époques ont tendance à s'accordéonner, à se télescoper, pour présenter de curieuses ressemblances."
                            }
                        ]
                    }
