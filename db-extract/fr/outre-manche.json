                "senses": [
                    {
                        "sense_id": "da57a846-f17d-39b2-95a9-319211d55404",
                        "entry_id": "564ea351-e54d-32dc-aea5-be5a258e44dc",
                        "glosses": [
                            "La Grande-Bretagne, du point de vue français."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "e3d79e77-fab2-4190-afc0-829ab18bf050",
                                "sense_id": "da57a846-f17d-39b2-95a9-319211d55404",
                                "text": "Si ce sont des chevaux de distinction, ayant une certaine dose de sang anglais, on les chausse avec de vieux fers à l’anglaise à leur passage à Nîmes ou tout autre ville, et on les dit originaires d’outre-Manche."
                            },
                            {
                                "example_id": "56fd37e1-0561-47b4-aed5-bc92a3c6614c",
                                "sense_id": "da57a846-f17d-39b2-95a9-319211d55404",
                                "text": "Vatelin. — Moi qui jamais, en dehors de cette… aventure d’outre-Manche — je sais bien que c’est idiot d’avouer ça — n’avais jamais trompé ma femme, il a fallu qu’une fois à Londres, un mois d’absence, pas de femme, — on n’est pas de bois — … Je croyais au moins que c’en était fini."
                            }
                        ]
                    }
