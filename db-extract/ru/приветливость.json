                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17247484-27a1-4177-ab53-0defc272c3a1",
                        "source_entry_id": "583d2011-0a39-3303-bba4-b959be51fd5c",
                        "source_sense_id": "57fbe0c9-f386-30db-afb7-d5c67225ed60",
                        "target_lang_word": "Freundlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freundlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                        "entry_id": "77fb2f66-647b-35a6-b64b-2dda0ca7688f",
                                        "glosses": [
                                            "Liebenswürdigkeit, wohlwollende Geneigtheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65268c1-8194-4a89-8472-f8aab1271292",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "Ich möchte Ihnen danken, denn soviel Freundlichkeit bin ich von Fremden nicht gewohnt."
                                            },
                                            {
                                                "example_id": "d26908f9-5d09-404e-97d5-ef24db5cf62b",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Bald verwandelte sich die Freundlichkeit zu meinem Erstaunen in überschwängliche Vertraulichkeit.“"
                                            },
                                            {
                                                "example_id": "e81d5d6f-a334-4ead-92aa-9525d0fa3e3c",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Er bat schnell den Bekannten, der nicht sehr beglückt schien, um die Freundlichkeit, bei seinem Koffer einen Augenblick zu warten, überblickte noch die Situation, um sich bei der Rückkehr zurechtzufinden, und eilte davon.“"
                                            },
                                            {
                                                "example_id": "88fdef06-b88b-4898-82d9-a2739a8fcf21",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„In ihn hatte ich größeres Vertrauen, und ich beschloss, auf seine Freundlichkeit zu zählen.“"
                                            },
                                            {
                                                "example_id": "1ad64ea1-33cb-4abb-8743-cf531a58353f",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Der Rektor empfing mich mit überströmender Freundlichkeit.“"
                                            },
                                            {
                                                "example_id": "6dcbf7a5-259d-4c4c-9542-75dca622d6b0",
                                                "sense_id": "3c206e12-ad22-38ec-b42c-917782f1b1bb",
                                                "text": "„Freundlichkeit heißt, auf andere zuzugehen, ohne ihnen hinterher zu laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "578b59f7-da45-4f41-82d6-038bc35265eb",
                        "source_entry_id": "583d2011-0a39-3303-bba4-b959be51fd5c",
                        "source_sense_id": "57fbe0c9-f386-30db-afb7-d5c67225ed60",
                        "target_lang_word": "Gemütlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemütlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "Gefühl der Geborgenheit, Vertrautheit und Sicherheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e451dc97-c2fa-4b74-b3a3-fc239aec6171",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Gemütlichkeit ist Ausdruck und spezifische Färbung des deutschen Rückzugs ins Private.“"
                                            },
                                            {
                                                "example_id": "aa988f12-5788-48b2-b94f-cb90b3549c19",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Die allermeisten finden die Gemütlichkeit in ihren eigenen vier Wänden, aber sie lässt sich nicht einschließen.“"
                                            },
                                            {
                                                "example_id": "2d59d453-fff7-4113-a102-218a266a951b",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Am nächsten Morgen ist es vorbei mit der Gemütlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "ruhige, unehrgeizige Herangehensweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43ab1b50-8b43-4373-b1e3-54f10cd2ca04",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "Probier's mal mit Gemütlichkeit."
                                            },
                                            {
                                                "example_id": "b885b816-c5f8-4529-aa29-b095229b3c80",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "Wenn der Chef kommt, ist die Gemütlichkeit flöten."
                                            },
                                            {
                                                "example_id": "cd8d68cf-6254-4724-a0dd-d0da00680e9c",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "„Es gibt Deutsche, die den Kampf ums Dasein mit einem Gedrängel hinter sich bringen, das der Gemütlichkeit ins Gesicht schlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d16b3082-ae30-3fed-bad0-767c3b308e62",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "Situationen und besonders Gespräche, die auf das Gemüt einwirken"
                                        ],
                                        "tags": [
                                            "laut E. T. A. Hoffmann"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bda6ee7-7199-4ea0-aa7d-b590402bf917",
                                                "sense_id": "d16b3082-ae30-3fed-bad0-767c3b308e62",
                                                "text": "„Unerachtet der strengen Ordensregel waren die Andachtsübungen dem Prior Leonardus mehr Bedürfnis des … Geistes, als asketische Buße für Sünde, und er wußte diesen Sinn der Andacht so in den Brüdern zu entzünden, dass sich über alles, was sie tun mussten, um der Regel zu genügen, eine Heiterkeit und Gemütlichkeit ergoß, die in der Tat ein höheres Sein in der irdischen Beengtheit erzeugte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b10310b-1ce0-4bc5-a845-0c6dabe2a962",
                        "source_entry_id": "583d2011-0a39-3303-bba4-b959be51fd5c",
                        "source_sense_id": "57fbe0c9-f386-30db-afb7-d5c67225ed60",
                        "target_lang_word": "affabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                        "entry_id": "d9cd2416-ab88-31b3-b333-53e3574f01f1",
                                        "glosses": [
                                            "Qualité de celui qui reçoit, qui écoute et entretient avec bienveillance ceux qui s'adressent à lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c11aa9-0e09-481a-8339-d23357364785",
                                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                                "text": "Sa figure intelligente, dont les traits et le teint trahissaient une assez forte proportion de sang soudanais, […], sévère au repos, prenait par moments une expression de grande affabilité."
                                            },
                                            {
                                                "example_id": "9ec6fa92-e451-4134-bab5-6b72fe724c58",
                                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                                "text": "Son visage à demi incliné, où la satisfaction le disputait au comme il faut, se plissait de petites rides d'affabilité."
                                            },
                                            {
                                                "example_id": "b68e7c68-b2b1-4ce5-b4ee-ce714f4ff888",
                                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                                "text": "L’affabilité de la mère supérieure l'agaçait brusquement."
                                            },
                                            {
                                                "example_id": "85275468-e71e-4220-afcd-92803a1be863",
                                                "sense_id": "46e9f22d-d5d3-3cbb-ad26-7ae8ad57b64c",
                                                "text": "Il riait aussi volontiers que de bonne grâce et prodiguait autant d’affabilité pour la dernière des souillons que pour les plus grands seigneurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df1d21d5-fcb5-44c2-989e-16315361bfac",
                        "source_entry_id": "583d2011-0a39-3303-bba4-b959be51fd5c",
                        "source_sense_id": "57fbe0c9-f386-30db-afb7-d5c67225ed60",
                        "target_lang_word": "aménité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aménité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f456adff-b604-3560-b43e-8daa283a8260",
                                        "entry_id": "a45f48a0-fe41-3bde-be11-083cdd01e678",
                                        "glosses": [
                                            "Agrément, en parlant d’un lieu ou d’un air."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "915d516d-d47c-40ca-81d7-9ec64ba74078",
                                                "sense_id": "f456adff-b604-3560-b43e-8daa283a8260",
                                                "text": "Et, gagné par l’aménité de l’air et du jour, M. Bergeret s’assit au bord du chemin, sur une des pierres qui, tirées jadis de la montagne, se couvraient lentement d’une mousse noire."
                                            },
                                            {
                                                "example_id": "1251f0d1-55d0-45b0-b309-757b99fee4c4",
                                                "sense_id": "f456adff-b604-3560-b43e-8daa283a8260",
                                                "text": "Oh ! aimable vie policée de nos jardins ! Courtoisie, aménité de potager à « fleuriste » et de bosquet à basse-cour !"
                                            },
                                            {
                                                "example_id": "d917be14-eedb-4d72-b44d-df33ee4e4313",
                                                "sense_id": "f456adff-b604-3560-b43e-8daa283a8260",
                                                "text": "Par mépris des aménités habituelles, Michel avait choisi la pièce principale, évidemment destinée au rôle de salon, pour y installer son grand lit à baldaquin, son bureau, deux fauteuils de cuir devant la cheminée, et quelques centaines de livres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bafb94f-6830-3de6-8a24-f0939addc22d",
                                        "entry_id": "a45f48a0-fe41-3bde-be11-083cdd01e678",
                                        "glosses": [
                                            "Douceur accompagnée de politesse et de grâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "394fa3ae-54bb-46e1-a2bb-51da6e80875b",
                                                "sense_id": "6bafb94f-6830-3de6-8a24-f0939addc22d",
                                                "text": "Il y avait plus d’un grand mois que je n’avais vu Madeleine cinq minutes de suite sans témoin, et plus longtemps encore que je n’avais obtenu d’elle quoi que ce fût qui ressemblât à ses aménités d’autrefois."
                                            },
                                            {
                                                "example_id": "658b80cd-8a85-4fd8-8a04-65ce4cbd93c5",
                                                "sense_id": "6bafb94f-6830-3de6-8a24-f0939addc22d",
                                                "text": "Des bourgeois y vinrent, d'abord, et puis des artistes, des peintres surtout, et de toutes les écoles. Les réalistes y coudoyaient sans aménité les fantaisistes, et les ingristes y avaient avec les coloristes de bruyantes prises de becs ; […]."
                                            },
                                            {
                                                "example_id": "d0f6239d-6eca-4e7f-b812-3f76ef32f40f",
                                                "sense_id": "6bafb94f-6830-3de6-8a24-f0939addc22d",
                                                "text": "On se pénétrait de la douceur de la tablée festive où la dureté habituelle du jugement social s’atténue, se mue en molle aménité, et les fâchés à mort de l’année dernière réconciliés se passent le bol de mayonnaise."
                                            },
                                            {
                                                "example_id": "63e7f916-8ed2-4d29-b53d-2507d55332fd",
                                                "sense_id": "6bafb94f-6830-3de6-8a24-f0939addc22d",
                                                "text": "Ils le fixaient sans aménité, comme s'ils le sommaient de justifier sa présence en Occident."
                                            },
                                            {
                                                "example_id": "909b5dcb-de25-4548-9286-f9c4c445aa60",
                                                "sense_id": "6bafb94f-6830-3de6-8a24-f0939addc22d",
                                                "text": "— […] j’évitais soigneusement toutes les concessions, toutes les aménités de style qui eussent pu rendre l’Essai sur l’amour moins singulièrement baroque aux yeux des gens de lettres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e898040-c144-35e2-adc9-76b8c74b0269",
                                        "entry_id": "a45f48a0-fe41-3bde-be11-083cdd01e678",
                                        "glosses": [
                                            "Éléments naturels de l’environnement représentant un attrait pour les habitants et les touristes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe29b4d3-73f3-448f-af94-4817896b42ff",
                                                "sense_id": "6e898040-c144-35e2-adc9-76b8c74b0269",
                                                "text": "Le développement d’une stratégie de tourisme rural durable en cohérence avec les aménités naturelles et culturelles de Teruel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
