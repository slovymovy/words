                ],
                "translations": [
                    {
                        "translation_id": "1712ff13-3a7d-4e8c-9f84-7e3d482c6ebb",
                        "source_entry_id": "90ec8b24-1cb8-3529-bcc6-f675125ce91a",
                        "source_sense_id": "3c720db4-641d-3ddb-bf25-e0511681a2cc",
                        "source_sense_description": "sehr erfreute Stimmung",
                        "target_lang_word": "delight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0399ac7-49be-3cb0-91dc-698bc73e38b1",
                                        "entry_id": "bdd8ab3d-0bb6-32fa-b269-fc3e568e59fd",
                                        "glosses": [
                                            "Joy; pleasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecff38cc-24dd-4c2b-b15a-c6bfb075330f",
                                                "sense_id": "b0399ac7-49be-3cb0-91dc-698bc73e38b1",
                                                "text": "A fool hath no delight in understanding."
                                            },
                                            {
                                                "example_id": "9e21b61f-a1e1-4cda-916c-747a563c895e",
                                                "sense_id": "b0399ac7-49be-3cb0-91dc-698bc73e38b1",
                                                "text": "[…] the isle is full of noises,\nSounds and sweet airs, that give delight and hurt not."
                                            },
                                            {
                                                "example_id": "ae48466c-f13e-4fb0-8e4c-ff81fa97c7cd",
                                                "sense_id": "b0399ac7-49be-3cb0-91dc-698bc73e38b1",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            },
                                            {
                                                "example_id": "ea76aab8-b6e3-4120-9b23-78d79189fb33",
                                                "sense_id": "b0399ac7-49be-3cb0-91dc-698bc73e38b1",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eeffd78-bef1-3908-9661-ea89b256da53",
                                        "entry_id": "bdd8ab3d-0bb6-32fa-b269-fc3e568e59fd",
                                        "glosses": [
                                            "Something that gives great joy or pleasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cacf50b-c3a3-468b-a481-7fe68b840541",
                                                "sense_id": "7eeffd78-bef1-3908-9661-ea89b256da53",
                                                "text": "Greensleeves was all my joy / Greensleeves was my delight, […]"
                                            },
                                            {
                                                "example_id": "a78c8aa8-854a-4fe6-b5b5-92e0fb333c20",
                                                "sense_id": "7eeffd78-bef1-3908-9661-ea89b256da53",
                                                "text": "[…] Awake\nMy fairest, my espous’d, my latest found,\nHeav’ns last best gift, my ever new delight,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "delight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63757bfa-1094-3f48-813d-7051daf32f7e",
                                        "entry_id": "392ff689-c8ee-33d7-831f-cb8ecf735bad",
                                        "glosses": [
                                            "To give delight to; to affect with great pleasure; to please highly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "109e0b7b-eb84-4c8a-ae58-de2a2e3a77ac",
                                                "sense_id": "63757bfa-1094-3f48-813d-7051daf32f7e",
                                                "text": "Delight our souls with talk of knightly deeds."
                                            },
                                            {
                                                "example_id": "d895ed86-7444-4487-b7c2-61a43430b7a0",
                                                "sense_id": "63757bfa-1094-3f48-813d-7051daf32f7e",
                                                "text": "A beautiful landscape delights the eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6b8db1-bfb0-3286-b4fc-83f4e842901e",
                                        "entry_id": "392ff689-c8ee-33d7-831f-cb8ecf735bad",
                                        "glosses": [
                                            "To have or take great pleasure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3030837-95b0-4499-89d5-650ed063a0fe",
                                                "sense_id": "ca6b8db1-bfb0-3286-b4fc-83f4e842901e",
                                                "text": "A ſclaunderous tunge, a tunge of a ſkolde,\nWorketh more miſchiefe than can be tolde;\nThat, if I wiſt not to be controlde,\nYet ſomwhat to ſay I dare well be bolde,"
                                            },
                                            {
                                                "example_id": "b7e65561-03e7-4be9-85f2-bba38c72728a",
                                                "sense_id": "ca6b8db1-bfb0-3286-b4fc-83f4e842901e",
                                                "text": "For I have loved you well and long, / Delighting in your company."
                                            },
                                            {
                                                "example_id": "826e4511-0db1-4bdd-95af-ded60b096953",
                                                "sense_id": "ca6b8db1-bfb0-3286-b4fc-83f4e842901e",
                                                "text": "He was an eisteddfodwr and delighted to hear good singing, whether it was in the sanctuary or at the eisteddfodic gatherings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
