                "forms": [],
                "senses": [
                    {
                        "sense_id": "1cd0952d-14f3-3ae5-8d4e-df4927401431",
                        "entry_id": "c38e32ba-7b52-33b5-9861-84185d3212c8",
                        "glosses": [
                            "Nom de famille"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9189000f-2cc1-4cd9-8112-00a2c2612803",
                                "sense_id": "1cd0952d-14f3-3ae5-8d4e-df4927401431",
                                "text": "Dans cette saga, Alain Mercier nous offre les biographies simultanées du footballeur Zacharie, du tennisman Yannick et du basketteur Joakim."
                            },
                            {
                                "example_id": "8201b733-c5a3-4644-b1dc-9b611eabb6ff",
                                "sense_id": "1cd0952d-14f3-3ae5-8d4e-df4927401431",
                                "text": "Lors de la deuxième partie de la soirée, des médailles du travail ont été remises par le chef d’agence et Bernard Pourpoint, maire de la commune : celle des quinze ans à Julien Mercier, chef de carrière depuis 2019, et celle des trente ans à Jean-Yves Mayo."
                            },
                            {
                                "example_id": "1031bb7d-3bf2-4fa7-8157-1df48d129536",
                                "sense_id": "1cd0952d-14f3-3ae5-8d4e-df4927401431",
                                "text": "Anthony Loyd (presse écrite, « The Times »), Maurine Mercier (radio, RTS - France Info), Nick Paton Walsh, Brice Lainé, Natalie Galloné et Étienne Dupont (TV, CNN) et Siegfried Modola (photo, free-lance), ont été récompensés ; ce dernier pour un reportage en Birmanie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
