                        "de waarheid vertellen"
                    ],
                    "common_phrases": [
                        "iemand iets wijsmaken",
                        "zichzelf iets wijsmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone believe something that is not true, often through deception or self-delusion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to make someone believe",
                                "target_lang_sense_clarification": "convincing someone of a falsehood"
