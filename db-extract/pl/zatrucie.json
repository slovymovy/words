                                        "examples": [
                                            {
                                                "example_id": "d9061fe7-d634-42ef-bf07-023b7e25056a",
                                                "sense_id": "ea285b2b-6446-32dd-b6a7-46753bfc9d1e",
                                                "text": "The number of young children in the US who have died from opioid overdoses has increased significantly, according to a new study on accidental poisonings of children 5 and younger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868b2643-fd20-35f4-b060-28c91fe5417f",
                                        "entry_id": "317e73e0-5972-311c-9828-de678e0894aa",
                                        "glosses": [
                                            "The state of being poisoned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e55041d-e7da-405e-902f-f5973cbc942b",
                                                "sense_id": "868b2643-fd20-35f4-b060-28c91fe5417f",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese[…]began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poisoning",
