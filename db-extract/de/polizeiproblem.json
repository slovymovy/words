                "senses": [
                    {
                        "sense_id": "4b78a002-2100-36da-98e3-d86d6ad07110",
                        "entry_id": "2d3de31d-749b-35ec-ab08-8517956cf2a8",
                        "glosses": [
                            "strukturelle Begünstigung von diskriminierendem Verhalten und der Ausübung übermäßiger Gewalt durch Polizeibeamte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7327c382-5972-4906-8e81-e933b1de2139",
                                "sense_id": "4b78a002-2100-36da-98e3-d86d6ad07110",
                                "text": "„Im Verlauf des Herbstes kamen dann allerdings derart viele rechte Umtriebe innerhalb der Behörden ans Licht, dass inzwischen kaum mehr zu leugnen ist: Es gibt ein Polizeiproblem, auch hierzulande.“"
                            },
                            {
                                "example_id": "7a58bc79-b7dc-4a53-bfe4-4b875310a624",
                                "sense_id": "4b78a002-2100-36da-98e3-d86d6ad07110",
                                "text": "„Mir ist viel zu schnell vom Einzeltäter die Rede und viel zu schnell hat Herr Beuth erklärt, man habe kein Polizeiproblem.“"
                            },
                            {
                                "example_id": "f8c29efe-908c-437d-9899-726ba7b8ba42",
                                "sense_id": "4b78a002-2100-36da-98e3-d86d6ad07110",
                                "text": "„Polizeiproblem im Bundestag“"
                            },
                            {
                                "example_id": "c23d343b-e1bd-4f92-b95a-ec889e19f8b0",
                                "sense_id": "4b78a002-2100-36da-98e3-d86d6ad07110",
                                "text": "„Vergewaltigungsverdacht: Großbritannien hat ein Polizeiproblem“"
                            },
                            {
                                "example_id": "05e07092-ff67-44f4-8f0b-31bd0024ef67",
                                "sense_id": "4b78a002-2100-36da-98e3-d86d6ad07110",
                                "text": "„Polizeiproblem in Freiburg: Viel Verständnis für Rechtsextreme“"
                            }
                        ],
