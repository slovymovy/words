                    "sense_definition": "przestawać być zagubionym, pojawiać się znowu po nieobecności",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finding_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zgubione przed tygodniem klucze nagle <w>odnajdują</w> się na dnie szafy.",
                            "target_lang_translations": {
                                "en": "The keys lost a week ago suddenly <w>turn up</w> at the bottom of the wardrobe."
                            }
                        },
                        {
                            "text": "Zaginione przesyłki pocztowe rzadko <w>odnajdują</w> się po tak długim czasie.",
                            "target_lang_translations": {
                                "en": "Lost postal parcels rarely <w>turn up</w> after so much time."
                            }
                        }
                    ],
                    "synonyms": [
