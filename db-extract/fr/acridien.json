                    {
                        "sense_id": "7240ca58-6141-374b-8441-9c52bf59b3ec",
                        "entry_id": "81bee6b1-e546-31c3-b2dc-4dd81f03d36e",
                        "glosses": [
                            "Qui ressemble à une sauterelle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4e86fd7e-8c7f-3d3a-a16a-a28211d0dd4b",
                        "entry_id": "81bee6b1-e546-31c3-b2dc-4dd81f03d36e",
                        "glosses": [
                            "Relatif aux acrididés, c’est-à-dire aux criquets (autrefois confondus avec les sauterelles)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30102f2-54ba-4681-bd2c-7d3cdd788e16",
                                "sense_id": "4e86fd7e-8c7f-3d3a-a16a-a28211d0dd4b",
                                "text": "L’agriculture malienne est souvent menacée par des invasions acridiennes."
                            },
                            {
                                "example_id": "08578e6d-6fe8-4c06-8893-e70e400f6de3",
                                "sense_id": "4e86fd7e-8c7f-3d3a-a16a-a28211d0dd4b",
                                "text": "La Grande-Bretagne avait entrepris de compter ses sujets au Nigeria dès 1866, d’abord dans la colonie de Lagos, puis au-delà et, après l’ « amalgamation » du Nord et du Sud en 1914, à l’échelle du pays ainsi créé de toutes pièces. Mais, parfois, une invasion acridienne ou une émeute contre l’impôt de capitation rendaient le décompte impossible."
                            },
                            {
                                "example_id": "237a0971-5281-459b-b80e-9683246dbb7c",
                                "sense_id": "4e86fd7e-8c7f-3d3a-a16a-a28211d0dd4b",
                                "text": "Pullulations, concentrations et migrations combinent leurs effets pour faire du risque acridien un phénomène particulièrement brutal."
                            }
                        ]
                    }
                ],
