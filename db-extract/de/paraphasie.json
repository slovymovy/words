                "senses": [
                    {
                        "sense_id": "b7ddca66-e64f-3e4f-9e4f-28999918c7e9",
                        "entry_id": "658f14ff-fd50-3e9d-8130-4212c91f3012",
                        "glosses": [
                            "eine Sprachstörung mit Laut- und/oder Wortentstellungen und auch unsinnigen Wortneubildungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "176a87e3-fff3-417b-8edd-49a84f187131",
                                "sense_id": "b7ddca66-e64f-3e4f-9e4f-28999918c7e9",
                                "text": "Eine Paraphasie kann sich so äußern, dass jemand ein Wort durch ein bedeutungsähnliches ersetzt (z.B. \"Fluss\" durch \"Bach\")."
                            },
                            {
                                "example_id": "857998f6-a3e4-4f5b-8f61-1baa1b06212f",
                                "sense_id": "b7ddca66-e64f-3e4f-9e4f-28999918c7e9",
                                "text": "„Unterschieden werden phonetische, phonematische und semantische Paraphasie sowie die neologistische Paraphasie, bei der es in Übereinstimmung mit den phonotaktischen Regeln der jeweiligen Sprache zu lexikalisch nicht existenten, beziehungslosen Neubildungen kommt.“"
                            },
                            {
                                "example_id": "86a38dcf-82a6-495e-a35d-4c0e8e1509ab",
                                "sense_id": "b7ddca66-e64f-3e4f-9e4f-28999918c7e9",
                                "text": "„Wenn sie als Symptom krankhafter Störungen auftritt, wird sie unter dem medizinischen Fachnamen Paraphasie inbegriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
