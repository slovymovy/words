                        "entry_id": "7bd70f34-fe93-380b-904e-44d3b5bae96c",
                        "glosses": [
                            "Kartenspiel für vier Personen, das mit 32 Karten gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b319fbee-fb5d-4771-b5db-95e11e9895f5",
                                "sense_id": "76792bbd-0a5e-3780-8345-a05b4b2df7d5",
                                "text": "Sie spielte mit ihren Freunden Schafkopf und trank dabei Bier."
                            },
                            {
                                "example_id": "ec7ffa68-1706-4cb6-8e88-14434345ae0b",
                                "sense_id": "76792bbd-0a5e-3780-8345-a05b4b2df7d5",
                                "text": "Schafkopf ist es eines der beliebtesten und verbreitetsten Kartenspiele Bayerns und angrenzender Regionen. Es gilt als Kulturgut und Teil der altbayrischen und der fränkischen Lebensart."
                            }
                        ],
