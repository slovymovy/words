                {
                    "sense_id": "13b48cf6-5d93-321c-9597-32844941fc13",
                    "sense_definition": "Относиться к чему-либо легкомысленно или с пренебрежением, не бояться опасности.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Смелый герой <смеётся> над любой опасностью и врагами.",
                            "target_lang_translations": {
                                "en": "The brave hero <laughs> at any danger and enemies.",
                                "nl": "De dappere held <lacht> om elk gevaar en alle vijanden.",
                                "pl": "Odważny bohater <w>śmieje się</w> z każdego niebezpieczeństwa i wrogów.",
                                "fr": "Le héros courageux <se rit> de tout danger et de ses ennemis.",
                                "de": "Der tapfere Held <lacht> über jede Gefahr und seine Feinde.",
                                "es": "El héroe valiente <se ríe> de cualquier peligro y de los enemigos.",
                                "it": "L'eroe coraggioso <ride> di ogni pericolo e dei nemici.",
                                "tr": "Cesur kahraman her türlü tehlikeye ve düşmana <gülüp geçer>.",
                                "cs": "Odvážný hrdina se <směje> jakémukoli nebezpečí i nepřátelům."
                            }
                        },
                        {
                            "text": "Она <смеялась> над всеми трудностями и уверенно шла вперёд.",
                            "target_lang_translations": {
                                "en": "She <laughed> at all difficulties and moved confidently forward.",
                                "nl": "Ze <lachte> om alle moeilijkheden en ging vol vertrouwen vooruit.",
                                "pl": "Ona <w>drwiła</w> ze wszystkich trudności i pewnie szła naprzód.",
                                "fr": "Elle <se riait> de toutes les difficultés et avançait avec confiance.",
                                "de": "Sie <lachte> über alle Schwierigkeiten und ging selbstbewusst vorwärts.",
                                "es": "Ella <se reía> de todas las dificultades y avanzaba con confianza.",
                                "it": "Lei <rideva> di tutte le difficoltà e andava avanti con sicurezza.",
                                "tr": "Tüm zorluklara <gülüp geçiyor> ve güvenle ilerliyordu.",
                                "cs": "Všem těžkostem se jen <vysmívala> a sebevědomě šla kupředu."
                            }
                        }
                    ],
                    "common_phrases": [
