                    }
                ],
                "translations": [
                    {
                        "translation_id": "fafd3c18-b5bc-4015-9076-c9657f36d334",
                        "source_entry_id": "45961e8c-9080-377e-845d-36390c1607ef",
                        "source_sense_id": "a856ffb6-bfe8-33f7-82e0-9f30c7b758e8",
                        "source_sense_description": "colloquial; a present",
                        "target_lang_word": "cadeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f21c005-1146-37a4-9e1d-4012ff27322f",
                                        "entry_id": "a3b44c09-d739-3ab4-a718-2b34ea033d32",
                                        "glosses": [
                                            "Présent, don."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d237bd4-378a-4430-bf0f-74196e80db80",
                                                "sense_id": "8f21c005-1146-37a4-9e1d-4012ff27322f",
                                                "text": "Je me représentais sa mine lorsqu’elle recevrait mon cadeau, et je me demandais : « Qu’est-ce qu’elle dira ? »"
                                            },
                                            {
                                                "example_id": "0a488ca3-0e4f-459c-8666-ba9423e1e7b1",
                                                "sense_id": "8f21c005-1146-37a4-9e1d-4012ff27322f",
                                                "text": "Je reçus de France un important matériel, un nouveau cinématographe, cadeau de mon ami Pierre Albaran, et un phonographe envoyé par Jean Borotra, le champion de tennis."
                                            },
                                            {
                                                "example_id": "4217ad37-1be5-4bb2-bcc3-337ec74f88f2",
                                                "sense_id": "8f21c005-1146-37a4-9e1d-4012ff27322f",
                                                "text": "Le « gros » l'entretenait parcimonieusement de repas et de cadeaux mesquins et lui payait sa chambre, au coin de la rue Grange-Batelière."
                                            },
                                            {
                                                "example_id": "b480d69a-4739-4c9a-81dd-ebd251f57773",
                                                "sense_id": "8f21c005-1146-37a4-9e1d-4012ff27322f",
                                                "text": "Cheikh Gaafar se montra généreux pour la dot et les cadeaux. Il fit célébrer de belles fêtes pour le mariage. […]. Le village entier fut en liesse."
                                            },
                                            {
                                                "example_id": "e660ba2b-aae9-4709-87d2-a15593e85a92",
                                                "sense_id": "8f21c005-1146-37a4-9e1d-4012ff27322f",
                                                "text": "J’ai reçu des sous-vêtements, des montres, même des étuis à crayon. Que des choses pratiques. Ce ne sont pas des cadeaux, ça! Les cadeaux, c’est le luxe, l’inattendu, le flafla. Ça ne sert à rien, un cadeau qui sert à quelque chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22b30959-55f2-3dc4-8814-85c023ddb55a",
                                        "entry_id": "a3b44c09-d739-3ab4-a718-2b34ea033d32",
                                        "glosses": [
                                            "Fête que l’on donnait principalement à des femmes, partie de plaisir."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a86cf69f-55a4-4502-a1c3-8b02bab7cca4",
                                                "sense_id": "22b30959-55f2-3dc4-8814-85c023ddb55a",
                                                "text": "Elles y ont reçu des cadeaux merveilleux de musique et de danse."
                                            },
                                            {
                                                "example_id": "5f314841-9aed-4bb3-a236-2870d7d5ccb8",
                                                "sense_id": "22b30959-55f2-3dc4-8814-85c023ddb55a",
                                                "text": "Des promenades du temps,\nOu dîners qu’on donne aux champs,\nIl ne faut point qu’elle essaye\nSelon les prudents cerveaux,\nLe mari dans ces cadeaux\nEst toujours celui qui paye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb95ba1-c756-3904-a4b5-384924f3ce80",
                                        "entry_id": "a3b44c09-d739-3ab4-a718-2b34ea033d32",
                                        "glosses": [
                                            "Employé par antiphrase pour désigner quelqu’un ou quelque chose qui déplait ou qui nuit."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fa3cda8-585a-48fb-a050-c5d0c6774889",
                                                "sense_id": "deb95ba1-c756-3904-a4b5-384924f3ce80",
                                                "text": "Ah ! C’est un joli cadeau ! Depuis vingt-huit ans que je l’endure ! Ah ! Je suis servie !"
                                            },
                                            {
                                                "example_id": "ffb971ef-728f-4da3-94af-992d8d157238",
                                                "sense_id": "deb95ba1-c756-3904-a4b5-384924f3ce80",
                                                "text": "Avec ça le crâne aussi lisse que ces saletés de melons qui font la richesse de la région, mais l’intelligence en moins.\nIncapable de prononcer une phrase sans mettre un mot à la place d’un autre.\nUn cadeau pour l’humanité."
                                            },
                                            {
                                                "example_id": "ee82f5f2-abb3-4bfb-858f-601a6d33456e",
                                                "sense_id": "deb95ba1-c756-3904-a4b5-384924f3ce80",
                                                "text": "Ivre mort, le salaud ! Allons bon, v’là autre chose ! Tu parles d’un cadeau, ce mec !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a447a12-21b6-31b1-bf17-d3f36e07e535",
                                        "entry_id": "a3b44c09-d739-3ab4-a718-2b34ea033d32",
                                        "glosses": [
                                            "Sorte de mandrin utilisé par les armuriers pour limer certains orifices."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4216862e-5c81-46d5-92b5-5857f83f00f1",
                                                "sense_id": "4a447a12-21b6-31b1-bf17-d3f36e07e535",
                                                "text": "Cadeau, mandrin en fer sur lequel on lime et façonne les orifices des embouchoirs, des grenadières et des capucines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
