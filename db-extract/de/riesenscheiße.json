                "senses": [
                    {
                        "sense_id": "414dd6b7-e5c2-3aa9-9eb9-9e9dda86a89c",
                        "entry_id": "f2549bc6-3356-38fd-80b0-83f385065c7f",
                        "glosses": [
                            "etwas extrem Schlechtes, Wertloses, Unsinniges sehr große Schwierigkeiten"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "25767c91-b7ea-4fbd-bcff-1b6652b148a4",
                                "sense_id": "414dd6b7-e5c2-3aa9-9eb9-9e9dda86a89c",
                                "text": "„Zwei Tage davor hat er zwei andere Männer umgebracht, und die beiden waren zufällig von uns. Genauso wie die drei bei dieser Riesenscheiße ein paar Tage vorher.“"
                            },
                            {
                                "example_id": "62ebe668-6bfc-439e-ab75-fe659f570a0b",
                                "sense_id": "414dd6b7-e5c2-3aa9-9eb9-9e9dda86a89c",
                                "text": "„›Unangenehm, meine Fresse‹, schimpfte Hoffmann. ›Das macht diesen Fall zu einer Riesenscheiße!‹“"
                            },
                            {
                                "example_id": "398784cf-ddf7-4b43-9259-4675d8f88910",
                                "sense_id": "414dd6b7-e5c2-3aa9-9eb9-9e9dda86a89c",
                                "text": "„›Mr Carey‹, sagte er. ›Sie haben eine Riesenscheiße gebaut.‹“"
                            },
                            {
                                "example_id": "4384d3d7-ba5a-4ffc-a061-c53dba4dbaef",
                                "sense_id": "414dd6b7-e5c2-3aa9-9eb9-9e9dda86a89c",
                                "text": "„Der würde nie einen Blick aufs große Ganze erhaschen, denn wenn er je auch nur ahnen würde, in was für einer Riesenscheiße er da mittendrin steckte, dann würde er die Beine in die Hand nehmen und davonrennen.“"
                            },
                            {
                                "example_id": "87db9151-b07b-4898-9d5e-3e24f43251b1",
                                "sense_id": "414dd6b7-e5c2-3aa9-9eb9-9e9dda86a89c",
                                "text": "„›Eine Riesenscheiße‹, stellte Nyathi fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
