                    },
                    {
                        "translation_id": "03d9458b-a21e-46a7-9fd8-038ce71fca54",
                        "source_entry_id": "cd728e50-5909-3bae-808b-ce560ce49a47",
                        "source_sense_id": "8812bd87-460c-395b-b9e2-eb3f8e7749c1",
                        "target_lang_word": "Völkerbund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Völkerbund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28b061e5-f009-3b23-90b3-5f9bcc13a2b5",
                                        "entry_id": "ee89d199-4fb3-3ce0-8ba3-6beb9e51e15e",
                                        "glosses": [
                                            "internationale Organisation von Staaten zur Wahrung des Friedens (1920-1946)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6702f29a-2d80-4b5c-98f7-abce77afe62e",
                                                "sense_id": "28b061e5-f009-3b23-90b3-5f9bcc13a2b5",
                                                "text": "„1923 wird Äthiopien in den Völkerbund aufgenommen, im Jahr darauf reist der Ras durch Europa.“"
                                            },
                                            {
                                                "example_id": "3288a760-da98-4108-b5fb-3e3569619c2e",
                                                "sense_id": "28b061e5-f009-3b23-90b3-5f9bcc13a2b5",
                                                "text": "„Formell wurden die deutschen Kolonien unter die Verwaltung des neugeschaffenen Völkerbundes gestellt, praktisch wurden sie unter den Siegermächten Frankreich, England und Belgien aufgeteilt.“"
                                            },
                                            {
                                                "example_id": "698f4bd2-a1e6-4cdd-b089-a502552971b1",
                                                "sense_id": "28b061e5-f009-3b23-90b3-5f9bcc13a2b5",
                                                "text": "„Fridtjof Nansen kam 1925 als Hochkommissar des Völkerbundes nach Batumi.“"
                                            },
                                            {
                                                "example_id": "4fa0af88-1722-4287-9ec3-18bba5ed7e65",
                                                "sense_id": "28b061e5-f009-3b23-90b3-5f9bcc13a2b5",
                                                "text": "„Leider gelang es ihm aber nicht einmal, seinen eigenen Kongress davon zu überzeugen, dass die USA diesem Völkerbund beitreten sollten.“"
                                            },
                                            {
                                                "example_id": "e73af88f-35b5-465c-9781-48868d7ec5ef",
                                                "sense_id": "28b061e5-f009-3b23-90b3-5f9bcc13a2b5",
                                                "text": "„Bereits 1934 trat Afghanistan dem Völkerbund bei, und seit der zweiten Hälfte der dreißiger Jahre engagierten sich Deutschland, Frankreich, Japan und Italien beim Aufbau des afghanischen Bildungs- und Wirtschaftswesens.“"
                                            },
                                            {
                                                "example_id": "3a0d7013-d89f-4e80-83e4-2a8fb376292a",
                                                "sense_id": "28b061e5-f009-3b23-90b3-5f9bcc13a2b5",
                                                "text": "„Die Einbeziehung dieser Erklärung in das Mandat, das die Briten vom Völkerbund erhielten, machte aus einem einseitigen, unverbindlichen Versprechen eine rechtlich bindende, internationale Verpflichtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adec92a1-b9f3-4685-a1ab-abdf5aa8507c",
                        "source_entry_id": "cd728e50-5909-3bae-808b-ce560ce49a47",
                        "source_sense_id": "8812bd87-460c-395b-b9e2-eb3f8e7749c1",
                        "target_lang_word": "League of Nations",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "League of Nations",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9868d31-c284-31ef-bffe-e4f44ac3102d",
                                        "entry_id": "34c4bb02-9d2a-3bd7-ab9e-2d9ac57f7e0a",
                                        "glosses": [
                                            "An international organization founded as a result of the Treaty of Versailles, which ended the First World War. Its goals included disarmament, preventing war through collective security, settling disputes between countries through negotiation, diplomacy and improving global quality of life. The predecessor of the United Nations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "862890de-2615-4d33-a112-c53170e87665",
                        "source_entry_id": "cd728e50-5909-3bae-808b-ce560ce49a47",
                        "source_sense_id": "8812bd87-460c-395b-b9e2-eb3f8e7749c1",
                        "target_lang_word": "Société des Nations",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Société des Nations",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a44f9fa5-c469-383a-84c9-e7eaf626fb4f",
                                        "entry_id": "b4f4e459-0597-3977-93cc-03282bbff2fe",
                                        "glosses": [
                                            "Pacte international établi après la Première Guerre mondiale en vue de garantir la paix mondiale (1920-1946)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "373d18b0-fe17-4245-9950-54f24b769982",
                                                "sense_id": "a44f9fa5-c469-383a-84c9-e7eaf626fb4f",
                                                "text": "Kraft ist Macht… La Force prime le Droit. Vos hallucinés de la Société des Nations nous font rire à Moscou… Un guignol pour les vieillards tombés en enfance, pour les vieux marmots qui font joujou avec les utopies pendant que leurs nurses rêvassent sur le lac de Genève… La Société des Nations !… Ah ! Ah !... Quand le monde entier fermente de haine ?... Quand les Jaunes, édifiés par nous, s’éveillent peu à peu ? Quand les Germains, à peine groggy, reprennent doucement leurs respiration ? Quand les Anglo-Saxons vous embrassent pour mieux vous étrangler ?…"
                                            },
                                            {
                                                "example_id": "34670b89-fd48-4425-8bd7-2a48f00ac88d",
                                                "sense_id": "a44f9fa5-c469-383a-84c9-e7eaf626fb4f",
                                                "text": "Or, qu’est-ce au vrai, que la Société des Nations ? Une « compagnie anonyme », selon la parole de Briand, où les États actionnaires sont eux-mêmes guidés par d’invisibles meneurs de jeu."
                                            },
                                            {
                                                "example_id": "fb392ad6-c10e-4f14-86f9-ff380c24bb5c",
                                                "sense_id": "a44f9fa5-c469-383a-84c9-e7eaf626fb4f",
                                                "text": "Rien dans le pacte ne nous permet d’établir une discrimination entre les Membres de la Société des Nations en raison de leur régime intérieur, de la couleur de leur peau, de distinctions raciales et de l’état de leur civilisation."
                                            },
                                            {
                                                "example_id": "3dbddaf0-05f4-46d7-ae90-2967adce6639",
                                                "sense_id": "a44f9fa5-c469-383a-84c9-e7eaf626fb4f",
                                                "text": "Depuis la fondation de la Société des Nations, les évènements se sont précipités avec une rapidité fatale vers la seconde phase de la catastrophe mondiale du XXᵉ siècle, qui éclata le 1ᵉʳ septembre 1939, exactement comme si la S.D.N. n’avait pas existé."
                                            },
                                            {
                                                "example_id": "9b4d8f4e-64a5-4e18-a554-bea2c412f089",
                                                "sense_id": "a44f9fa5-c469-383a-84c9-e7eaf626fb4f",
                                                "text": "S’il n’y avait pas eu toutes ces guerres, toutes ces batailles qui vous déplaisent, que serait la France, Chalumot ? Quelle place aurait-elle, par exemple, au sein de cette Société des Nations dont l’humanité s’enorgueillit ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
