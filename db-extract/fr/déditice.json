                "senses": [
                    {
                        "sense_id": "4b61a9ee-de46-3f85-bc90-21cd5f14e1a8",
                        "entry_id": "4a27fe18-9561-3a29-a59e-c4afe6090c61",
                        "glosses": [
                            "Statut de ceux qui ont pris les armes et combattu contre le peuple romain, et se sont rendus après la défaite."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "453c4895-db42-3c12-a52f-295f437bb56e",
                        "entry_id": "4a27fe18-9561-3a29-a59e-c4afe6090c61",
                        "glosses": [
                            "Nom de ceux qui ont ce statut."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "022bf1ba-ce22-43d2-b884-74e1087be29a",
                                "sense_id": "453c4895-db42-3c12-a52f-295f437bb56e",
                                "text": "Le déditice a en commun avec l’esclave qu’on peut en faire ce que l’on veut, d’être comme lui sans droits et entièrement à la merci des autres. Il peut devenir esclave mais il n’est pas esclave."
                            },
                            {
                                "example_id": "621c9587-95a7-4ccf-8609-ec2347a6be6c",
                                "sense_id": "453c4895-db42-3c12-a52f-295f437bb56e",
                                "text": "Du Danube, Sarmates et Taïfales passèrent dans l’Empire comme déditices."
                            },
                            {
                                "example_id": "86407ab7-c2dc-466a-b2c6-3a4ae77db929",
                                "sense_id": "453c4895-db42-3c12-a52f-295f437bb56e",
                                "text": "Voici dans quelle circonstance : lorsqu'un Romain avait épousé par erreur une Latine ou une Pérégrine ou même une Déditice la croyant Latine, ou qu’une citoyenne avait épousé par erreur un Latin ou un Pérégrin ou même un Déditice le croyant citoyen."
                            }
                        ]
                    }
                ],
