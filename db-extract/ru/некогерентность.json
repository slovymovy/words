                "senses": [
                    {
                        "sense_id": "cbd2e0f5-b270-31ef-a81f-32988fbd778c",
                        "entry_id": "60969f56-a925-3b1e-90cd-69ad2e19d3cf",
                        "glosses": [
                            "физ. свойство или состояние по значению прилагательного некогерентный; отсутствие когерентности"
                        ],
                        "tags": [],
