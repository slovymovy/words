                        "entry_id": "c251b2bb-0c67-3532-8d80-4c99c109748a",
                        "glosses": [
                            "Inscription ou définition automatique de l’heure et de la date associées à un évènement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5527b861-98fb-4b2d-b926-74069edf53d4",
                                "sense_id": "7c759dee-b5c0-364c-acb8-b570024e6972",
                                "text": "Qui sera converti par votre signature et un horodatage."
                            },
                            {
                                "example_id": "119da57a-6407-4eae-9e97-bda0cbefe18d",
                                "sense_id": "7c759dee-b5c0-364c-acb8-b570024e6972",
                                "text": "Il s’agit d’un document de spécification qui précise les exigences sur les formats de contremarques de temps fournies par les autorités d’horodatage, ainsi qu’un certain nombre d’exigences de sécurité applicables."
                            },
                            {
                                "example_id": "fd5314fc-28c6-47de-9961-746604d42275",
                                "sense_id": "7c759dee-b5c0-364c-acb8-b570024e6972",
                                "text": "L’enregistrement comporte la date et l’heure de chaque opération de traitement de données («horodatage»)."
                            }
                        ]
