                        "entry_id": "fd3623ae-2ec3-3c52-9561-1cceea2d46c1",
                        "glosses": [
                            "Celui qui hérite avec un ou plusieurs autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c3c941-1f7a-475d-be6d-75a52f5535e7",
                                "sense_id": "bc77d743-5ed4-3103-9cff-545a49939f0d",
                                "text": "Partage entre cohéritiers."
                            },
                            {
                                "example_id": "db833223-db08-4cd8-89a0-ff38274dd241",
                                "sense_id": "bc77d743-5ed4-3103-9cff-545a49939f0d",
                                "text": "Elles sont cohéritières."
                            },
                            {
                                "example_id": "b1b84fae-42d1-4b82-bc76-27b4a3c830b8",
                                "sense_id": "bc77d743-5ed4-3103-9cff-545a49939f0d",
                                "text": "Sans doute, par le rapport des dettes, le cohéritier débiteur se libère envers ses cohéritiers comme s’il faisait un paiement."
                            }
                        ]
                    }
                ],
                "translations": [
