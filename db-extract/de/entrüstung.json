                "senses": [
                    {
                        "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                        "entry_id": "df5d4cd4-df02-3036-8c85-916d983a16ce",
                        "glosses": [
                            "Gefühl der Beleidigung in seinem sittlichen Empfinden"
                        ],
                        "tags": [
                            "Plural ungebräuchlich"
                        ],
                        "examples": [
                            {
                                "example_id": "5878b502-7332-43d7-b11c-14a086626ca7",
                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                "text": "Vor Entrüstung über die freche Antwort fehlten dem Lehrer die Worte."
                            },
                            {
                                "example_id": "2451b3de-0311-4fd5-991b-693d10f6670e",
                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                "text": "Ein britischer Fernsehsender hat eine Weihnachtsansprache des iranischen Präsidenten Mahmud Ahmadinedschad ausgestrahlt und damit einen Sturm der Entrüstung ausgelöst."
                            },
                            {
                                "example_id": "28dc0e80-1429-4b47-aea9-243cf021e0d5",
                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                "text": "Mit Entrüstung reagieren die Telekom-Konkurrenten auf die Pläne des Ex-Monopolisten, die Miete für die Teilnehmeranschlussleitung zu erhöhen."
                            },
                            {
                                "example_id": "807c5147-1cd8-4656-a9bd-99207b21ef8e",
                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                "text": "„Meine Entrüstung ist ungebrochen.“"
                            },
                            {
                                "example_id": "3cacb0dd-95b8-4eb3-bba4-1d58b482d651",
                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                "text": "„Ein Sturm der Entrüstung bricht los.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
