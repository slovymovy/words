        "fr-extract.jsonl": [
            {
                "entry_id": "13f79674-626a-342a-864c-9114885e3c7c",
                "word": "druide",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b214b039-dacd-43c1-906e-fd3483bb6822",
                        "entry_id": "13f79674-626a-342a-864c-9114885e3c7c",
                        "tags": [
                            "plural"
                        ],
                        "form": "druides"
                    },
                    {
                        "form_id": "0e611f63-23fb-45d8-b106-e290640d0f26",
                        "entry_id": "13f79674-626a-342a-864c-9114885e3c7c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "druidesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2a4bea1-5830-31f2-a338-2aed0a61e709",
                        "entry_id": "13f79674-626a-342a-864c-9114885e3c7c",
                        "glosses": [
                            "Membre de la classe sacerdotale chez les Celtes de Gaule, de Bretagne et d’Irlande."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "823f08bd-6fc3-4801-9280-37965dc3b16f",
                                "sense_id": "a2a4bea1-5830-31f2-a338-2aed0a61e709",
                                "text": "La réunion annuelle des druides dans la forêt des Carnutes."
                            },
                            {
                                "example_id": "afbe8758-3ef4-4cb7-92bf-87639c3a2fab",
                                "sense_id": "a2a4bea1-5830-31f2-a338-2aed0a61e709",
                                "text": "Un vaste espace ouvert, au milieu de cette clairière, paraissait avoir été autrefois voué aux rites de la superstition des druides."
                            },
                            {
                                "example_id": "fd7808a9-883f-4667-aa8c-24fb2e0641a2",
                                "sense_id": "a2a4bea1-5830-31f2-a338-2aed0a61e709",
                                "text": "Jeanne était une radicaliste païenne, sans s’en douter davantage. Ses superstitions rustiques lui venaient en droite ligne de la religion des druides, cette doctrine peu connue dans son essence, car on ne l’a jugée que d’après les crimes qui l’ont souillée et dénaturée."
                            },
                            {
                                "example_id": "92cbde6f-3b75-4909-ab72-99176329498c",
                                "sense_id": "a2a4bea1-5830-31f2-a338-2aed0a61e709",
                                "text": "Elle chercha, en faisant rouler les pages sous son pouce, un mot qui fixât son attention ; elle vit celui de druide. — Ah ! voilà un grand caractère, se dit-elle ; je vais voir sans doute un de ces mystérieux sacrificateurs dont la Bretagne, m’a-t-on dit, conserve encore les pierres levées ; mais je le verrai sacrifiant des hommes : ce sera un spectacle d’horreur ; cependant lisons."
                            },
                            {
                                "example_id": "541b61f6-ab0e-4b1e-9894-0a70d4c48e64",
                                "sense_id": "a2a4bea1-5830-31f2-a338-2aed0a61e709",
                                "text": "Songez que Chartres est le premier oratoire que Notre-Dame ait eu en France. Il se relie aux temps messianiques, car bien avant que la fille de Joachim ne fût née, les Druides avaient instauré, […], un autel à la « Vierge qui devait enfanter » « Virgini Pariturae »."
                            },
                            {
                                "example_id": "898ed419-a9ed-447e-a3ad-ef1f921a84fc",
                                "sense_id": "a2a4bea1-5830-31f2-a338-2aed0a61e709",
                                "text": "D'un autre côté, ces druides avaient toutes les qualités requises pour fasciner une personnalité telle que celle de Posidonius. Ils étaient avant tout des philosophes, tout comme le « très savant »."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f412c92-99b2-3781-85ab-5dedc0499462",
                        "entry_id": "13f79674-626a-342a-864c-9114885e3c7c",
                        "glosses": [
                            "Magicien capable de contrôler les plantes et les animaux."
                        ],
                        "tags": [
                            "Fantastique",
                            "Jeux de rôle",
                            "Jeux de rôle d’action-aventure"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1424d4e-1840-4181-b47e-1e6028578e50",
                        "source_entry_id": "13f79674-626a-342a-864c-9114885e3c7c",
                        "target_lang_word": "Druide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                        "entry_id": "d3f047c4-cb62-3bbb-ae30-0605bae939c5",
                                        "glosses": [
                                            "keltischer Priester"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f2142d7-357b-4205-add7-5fcf4a5d909b",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "In Gallien hatten die Druiden große Macht."
                                            },
                                            {
                                                "example_id": "c13e592c-ccb0-4322-8b7f-f1fbcdfcf716",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Den Neukelten beziehungsweise Neuheiden und vor allem den neuen Druiden geht es um eine Wiederbelebung keltischer Tradition, vor allem der keltischen Religion nach dem Motto: Nicht das Christentum, sondern das Heidentum ist die für Europa adäquate Religion.“"
                                            },
                                            {
                                                "example_id": "e637918f-6613-4f4d-81b6-256d01921b6d",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Ihre Priester, die Druiden, trafen sich einmal im Jahr an geweihtem Ort.“"
                                            },
                                            {
                                                "example_id": "48a3669e-fc7c-40eb-8d0c-0341376103b5",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Bei der Vermittlung zwischen Göttern und Menschen spielten die Druiden, was soviel wie ‚die Wissenden um die Eiche‘ bedeutet, eine wichtige Rolle.“"
                                            },
                                            {
                                                "example_id": "0ce4597e-c0f6-4704-a7d5-4e03145ab88a",
                                                "sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                                                "text": "„Die Druiden waren die ausgebildeten Spezialisten für Religion und Ritus, zudem Richter in privaten und öffentlichen Angelegenheiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
