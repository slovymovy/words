                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f693e825-8e06-4cf3-b549-c54f39553339",
                                "sense_id": "31f90465-7eff-3190-aa65-0c6df7573e1d",
                                "text": "„Er ließ sich von dem Koch, einem vergnügten Dicken, ins Verhör nehmen und bekam einen Löffel Labskaus ab, dann aber getraute er sich aufs Vorderdeck und peilte das Logis.“"
                            },
                            {
                                "example_id": "fb19641c-8ae3-4f01-b7fc-236e2fcf2531",
                                "sense_id": "31f90465-7eff-3190-aa65-0c6df7573e1d",
                                "text": "„In einem 1878 als Synagoge für die Kurgäste erbauten Haus werden ostfriesische Spezialitäten wie Labskaus, Snirtjebraten und Steckrübencremesuppe mit Krabben angeboten.“"
                            }
                        ],
