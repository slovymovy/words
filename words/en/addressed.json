    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9913e6b7-5a62-36f1-8948-e29e5d10e4ce",
                    "sense_definition": "Simple past and past participle of <w>address</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>addressed</w> the issue immediately to prevent further problems.",
                            "target_lang_translations": {
                                "ru": "Менеджер немедленно <w>занялся</w> этим вопросом, чтобы предотвратить дальнейшие проблемы.",
                                "pl": "Menedżer natychmiast <w>zajął się</w> tą kwestią, aby zapobiec dalszym problemom."
                            }
                        },
                        {
                            "text": "He stood up and <w>addressed</w> the crowd with a powerful speech.",
                            "target_lang_translations": {
                                "ru": "Он встал и <w>обратился</w> к толпе с мощной речью.",
                                "pl": "Wstał i <w>zwrócił się</w> do tłumu z poruszającym przemówieniem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "addressed the issue",
                        "addressed the crowd",
                        "addressed the problem"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола \"address\" (обращаться, заниматься чем-либо).",
                        "pl": "Forma czasu przeszłego i imiesłów czasu przeszłego czasownika 'address' (zająć się czymś, zwrócić się do kogoś)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обратился",
                                "target_lang_sense_clarification": "начал говорить с кем-либо"
                            },
                            {
                                "target_lang_word": "занялся",
                                "target_lang_sense_clarification": "приступил к решению проблемы или вопроса"
                            },
                            {
                                "target_lang_word": "адресовал",
                                "target_lang_sense_clarification": "направил кому-либо"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zajął się",
                                "target_lang_sense_clarification": "podjął działania w celu rozwiązania problemu"
                            },
                            {
                                "target_lang_word": "zwrócił się",
                                "target_lang_sense_clarification": "skierował słowa do kogoś"
                            },
                            {
                                "target_lang_word": "zaadresował",
                                "target_lang_sense_clarification": "skierował coś do konkretnego odbiorcy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba0476e1-55c1-3fb1-8e00-01a1a2305281",
                    "sense_definition": "Of a document or package, written with the destination details.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please include a stamped <w>addressed</w> envelope with your application form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, приложите к анкете конверт с маркой и <w>написанным адресом</w>.",
                                "pl": "Proszę dołączyć do formularza zgłoszeniowego opłaconą kopertę ze <w>zaadresowaną</w> zwrotnie etykietą."
                            }
                        },
                        {
                            "text": "The letter was <w>addressed</w> to the wrong person and returned to the sender.",
                            "target_lang_translations": {
                                "ru": "Письмо было <w>адресовано</w> не тому человеку и вернулось отправителю.",
                                "pl": "List został <w>zaadresowany</w> do niewłaściwej osoby i zwrócony do nadawcy."
                            }
                        }
                    ],
                    "synonyms": [
                        "labeled",
                        "directed"
                    ],
                    "antonyms": [
                        "unaddressed",
                        "blank"
                    ],
                    "common_phrases": [
                        "addressed envelope",
                        "self-addressed",
                        "wrongly addressed"
                    ],
                    "target_lang_definitions": {
                        "ru": "О документе или посылке: имеющий написанные данные получателя.",
                        "pl": "O dokumencie lub przesyłce: posiadający wypisane dane odbiorcy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адресованный",
                                "target_lang_sense_clarification": "предназначенный кому-либо, с указанием адреса"
                            },
                            {
                                "target_lang_word": "с адресом",
                                "target_lang_sense_clarification": "имеющий надпись с адресом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zaadresowany",
                                "target_lang_sense_clarification": "posiadający wypisany adres odbiorcy"
                            },
                            {
                                "target_lang_word": "z adresem",
                                "target_lang_sense_clarification": "mający naniesione dane adresowe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76540562-4a52-3f5e-869a-6b6066ff376f",
                    "sense_definition": "Having been the recipient of a speech or presentation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>addressed</w> audience listened quietly to the speaker's remarks.",
                            "target_lang_translations": {
                                "ru": "Аудитория, <w>к которой обращались</w>, тихо слушала замечания оратора.",
                                "pl": "Publiczność, <w>do której się zwrócono</w>, słuchała w ciszy uwag mówcy."
                            }
                        },
                        {
                            "text": "She felt like the directly <w>addressed</w> party in the conversation.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя стороной, <w>к которой непосредственно обращались</w> в разговоре.",
                                "pl": "Czuła się jak strona, <w>do której bezpośrednio się zwrócono</w> w trakcie rozmowy."
                            }
                        }
                    ],
                    "synonyms": [
                        "spoken to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, к кому обращена речь или выступление.",
                        "pl": "Osoba lub grupa, do której skierowano wypowiedź lub przemówienie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "к которому обратились",
                                "target_lang_sense_clarification": "получатель сообщения или речи"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "do której się zwrócono",
                                "target_lang_sense_clarification": "odbiorca komunikatu"
                            },
                            {
                                "target_lang_word": "adresat",
                                "target_lang_sense_clarification": "osoba, do której skierowano słowa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
