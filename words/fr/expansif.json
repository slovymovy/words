                    "frequency": "Middle",
                    "semantic_group_id": "personnalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Très chaleureux et <w>expansif</w>, il noue facilement des amitiés partout où il voyage. "
                        },
                        {
                            "text": "Elle a une nature <w>expansive</w> qui met immédiatement tout le monde à l'aise."
                        }
                    ],
                    "synonyms": [
