                            {
                                "example_id": "d0ef5a87-4b52-4161-98f4-3a486518e31b",
                                "sense_id": "00f261c8-71b6-3d97-a197-e4cee6f873c1",
                                "text": "Wat veel mensen niet weten is dat het maar om een dubbeltje gaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "b892662a-775d-33ff-956b-88b2827b2bb9",
                        "entry_id": "1c9b49e7-70b6-3fe0-beaf-d337ea07bfa6",
