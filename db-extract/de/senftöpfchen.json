                "senses": [
                    {
                        "sense_id": "d0b45a7f-c1e8-3d12-86b6-32e48d2c8437",
                        "entry_id": "a7c6e3d1-7f06-3f74-adea-8687676be85e",
                        "glosses": [
                            "kleines Behältnis zur Aufbewahrung und zum Servieren von Senf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4cf986-ae3e-4c58-9507-97b3f7bc7612",
                                "sense_id": "d0b45a7f-c1e8-3d12-86b6-32e48d2c8437",
                                "text": "„Ich muss mit meiner Frikadelle, dem Senftöpfchen und dem Löffelchen bei Wind und Wetter auf die Straße gehen.“"
                            },
                            {
                                "example_id": "d7b61c2a-7510-432b-a7e5-ba5b896d4f52",
                                "sense_id": "d0b45a7f-c1e8-3d12-86b6-32e48d2c8437",
                                "text": "„Zur Lagerung eignet sich ein Gefäß mit relativ engem Hals, wie man es von den traditionellen Senftöpfchen kennt.“"
                            },
                            {
                                "example_id": "b035af74-989f-415f-9712-9a64fe2c6605",
                                "sense_id": "d0b45a7f-c1e8-3d12-86b6-32e48d2c8437",
                                "text": "„‚In Europa liegt die Würze‘, hatte Tillich auf die Senftöpfchen kleben lassen.“"
                            },
                            {
                                "example_id": "a0e1ceb5-9af8-4821-8dc9-c05d9421894c",
                                "sense_id": "d0b45a7f-c1e8-3d12-86b6-32e48d2c8437",
                                "text": "„Allerlei Senftöpfchen, bunte Nudeln und Panettone: Wer heute Lebensmittel einkauft, bekommt eine Welt an Genuss.“"
                            },
                            {
                                "example_id": "7a2a0eeb-c8b0-4f5a-a04e-2e247b08ce98",
                                "sense_id": "d0b45a7f-c1e8-3d12-86b6-32e48d2c8437",
                                "text": "Auf einem Tablett in der Mitte des Tisches gesellten sich ein Salz- und ein Pfefferstreuer zu einem Senftöpfchen aus Steingut, daraus ein kurzer Löffelstiel ragte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
