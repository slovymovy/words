                                        "glosses": [
                                            "das, was schon vorbestimmt ist; Berufung, Schicksal"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a75ceea5-69c5-4c02-a074-1616fffccb34",
                                                "sense_id": "faa2d784-85e9-36bc-baeb-4de11e8885f7",
                                                "text": "Seine Bestimmung ist es, Polizist zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "553a330c-fccd-3cf1-93f8-a8e0095162c0",
                                        "entry_id": "fe356a54-8abc-3e51-81b6-207ddd6f3c45",
                                        "glosses": [
                                            "wissenschaftliche Ermittlung, zum Beispiel von Pflanzen, von chemischen Zusammensetzungen etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9bd1e5f-501c-4fe3-94e9-6af8c640adce",
                                                "sense_id": "553a330c-fccd-3cf1-93f8-a8e0095162c0",
                                                "text": "Die Bestimmung des Alters der Fossilien gestaltete sich schwierig."
                                            },
                                            {
                                                "example_id": "d9968409-6cdf-4c2b-88af-bdbeaf3f51f9",
                                                "sense_id": "553a330c-fccd-3cf1-93f8-a8e0095162c0",
                                                "text": "„Das war der Tag, an dem ich die ersten Proben mitnahm. Sie vertrockneten später im Labor, weil Laura und Henrik sich nicht dafür interessierten, weil Angela im Vorprüfungsstress war und ich an der Bestimmung scheiterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "c7c0c404-e9cc-30b5-a49b-1f47df5f2d0e",
                                        "entry_id": "fe356a54-8abc-3e51-81b6-207ddd6f3c45",
                                        "glosses": [
                                            "Satzteil, der einen Umstand angibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a392fb-d863-492e-96b4-685a071c8606",
                                                "sense_id": "c7c0c404-e9cc-30b5-a49b-1f47df5f2d0e",
                                                "text": "In dem Satz „Sie läuft auf dem Balkon“ ist „auf dem Balkon“ eine adverbiale Bestimmung."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef145253-4879-45fa-9cbc-dab964c916a7",
                        "source_entry_id": "e8f77dfd-343f-375f-8542-9fcad57009fd",
                        "source_sense_id": "fc10ee78-e9f5-3c94-9e04-9cfbfd268c63",
                        "target_lang_word": "определение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "определение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1c14a4c3-8c08-3570-81c0-8bae8d469355",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "действие по значению гл. определять; выяснение, вычисление чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d53cf6ca-5993-4aec-a4e6-9e85f442ffa6",
                                                "sense_id": "1c14a4c3-8c08-3570-81c0-8bae8d469355",
                                                "text": "Тотчас после затмения мы занялись определением широты той местности Луны, на которой мы находились."
                                            },
                                            {
                                                "example_id": "e0b66c23-84cb-4252-b975-f611ec165813",
                                                "sense_id": "1c14a4c3-8c08-3570-81c0-8bae8d469355",
                                                "text": "Мы, врачи, желая поставить диагноз, т. е. определение тому или другому, выделяющемуся в душевной или телесной жизни человека, состоянию, прежде всего перечисляем кратко его симптоматологию, т. е. те проявления, на сочетании которых мы можем выделить и обособить данное состояние как особенное и характерное."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d131e6de-41de-3d9d-be5d-b85ab6bc4c83",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "формулировка, разъясняющая содержание, смысл чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb1f2e8-0b8a-4837-8aa0-54632cd9d134",
                                                "sense_id": "d131e6de-41de-3d9d-be5d-b85ab6bc4c83",
                                                "text": "Здесь необходимо более точное определение термина."
                                            },
                                            {
                                                "example_id": "e995b091-1609-4b07-8c64-bd5e593c123a",
                                                "sense_id": "d131e6de-41de-3d9d-be5d-b85ab6bc4c83",
                                                "text": "Достоевский не имел никаких богословских притязаний, а потому и мы не имеем права искать у него каких-нибудь логических определений Церкви по существу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac3ee317-d5ba-3483-bd18-1e784a3905a7",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "юр. одна из форм решения суда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f11b7b-bd48-4a1c-b276-1e161af533a0",
                                                "sense_id": "ac3ee317-d5ba-3483-bd18-1e784a3905a7",
                                                "text": "Суд вынес определение по данному делу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4290f9cd-f4e0-3803-8f09-83851789d499",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "лингв. второстепенный член предложения, обозначающий качество, свойство или другой признак предмета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424513b3-a18b-40df-a3a9-65d51ef10099",
                                                "sense_id": "4290f9cd-f4e0-3803-8f09-83851789d499",
                                                "text": "Согласованное определение выражается прилагательным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dae6259-2456-3cbe-8c6e-72e2af0b80cf",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "назначение, предопределение, предначертание, предписание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22af1428-604f-4b57-bcda-d3ae8a5ce676",
                                                "sense_id": "1dae6259-2456-3cbe-8c6e-72e2af0b80cf",
                                                "text": "Но оставим это; я нашёл моё благополучие, и вы, последователи мои, вы также можете обладать им: раскройте сердца ваши, познайте все изгибы оных, научитесь терпению и без отчаяния носите тот тяжкий крест, который определение судьбы налагает на вас: тогда вы будете истинно счастливы, тогда найдёте подобие моей Вареньки, под именем которой скрывается терпение, вера, надежда, любовь, все добродетели."
                                            },
                                            {
                                                "example_id": "1298a3cf-dd36-4e45-9ca8-c81a5d5e57ea",
                                                "sense_id": "1dae6259-2456-3cbe-8c6e-72e2af0b80cf",
                                                "text": "Я не очень давно достиг до сего здравого рассуждения и теперь удостоверен, что по определению неисповедимых судеб и славные стихотворцы должны жевать зелёные лавры и питаться только сею не очень вкусною пищею."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0470ec-1fea-3142-9735-2dc111721129",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "действие по значению гл. определяться; обусловливание, задача какого-либо действия, выбор"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b5511c-467e-471f-8eb0-ed4fea6469b7",
                                                "sense_id": "ff0470ec-1fea-3142-9735-2dc111721129",
                                                "text": "Но Россия, ещё в самом своём младенчестве крещённая в христианскую веру, получила отсюда залог высшей духовной жизни и должна была, достигнув зрелого возраста, сложившись и определившись физически, искать себе свободного нравственного определения."
                                            },
                                            {
                                                "example_id": "183bd32f-8307-4707-9608-4fb41ffef056",
                                                "sense_id": "ff0470ec-1fea-3142-9735-2dc111721129",
                                                "text": "В такие минуты, когда мысль не отсуживает вперёд каждого определения воли, а единственными пружинами жизни остаются плотские инстинкты, я понимаю, что ребёнок, по неопытности, особенно склонный к такому состоянию, без малейшего колебания и страха, с улыбкой любопытства, раскладывает и раздувает огонь под собственным домом, в котором спят его братья, отец, мать, которых он нежно любит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb756db-da9d-31d0-bd4f-9c122698c087",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "устраивание, пристраивание, привлечение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43581d44-c451-433b-8b5e-7755556b22cf",
                                                "sense_id": "7bb756db-da9d-31d0-bd4f-9c122698c087",
                                                "text": "Когда умер Иван Фёдорович Мельников, казанские родные его стали хлопотать о наследстве в пользу его законных детей и об определении на службу моего отца."
                                            },
                                            {
                                                "example_id": "b35d9f88-c139-42df-9ead-837a551e3b81",
                                                "sense_id": "7bb756db-da9d-31d0-bd4f-9c122698c087",
                                                "text": "Он по просьбе восемнадцатилетнего своего брата Василия Ивановича, которого любил император Павел Петрович, не в пример другим определён был одиннадцати лет от роду лейб-гвардии в Семеновский полк унтер-офицером (9 марта 1800 г.) и оставался при матери, а затем также по ходатайству брата 1 января 1801 года был отставлен из военной службы для определения к статским делам коллежским регистратором, имея от роду только 12 лет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "426826f9-6206-360d-9e37-25e7a50bf226",
                                        "entry_id": "813668d7-a418-370e-a27e-b080e3706fbf",
                                        "glosses": [
                                            "назначение на службу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e211056b-76e7-460a-9336-30133d0b03bf",
                                                "sense_id": "426826f9-6206-360d-9e37-25e7a50bf226",
                                                "text": "Назначения и увольнения от общественных должностей следовали так быстро, что едва газета успевала объявить об определении известного лица, как его опять лишал места произвол императора."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
