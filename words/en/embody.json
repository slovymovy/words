{
    "word_family": [
        "embodiment",
        "disembody",
        "disembodiment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b1a1db1-b4ff-3f4e-b41f-9465288e4a92",
                    "sense_definition": "To represent a quality, feeling, or idea in a physical or concrete form.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new leader seems to <w>embody</w> the hopes and dreams of the entire nation.",
                            "target_lang_translations": {
                                "ru": "Кажется, новый лидер <w>воплощает</w> в себе надежды и мечты всей нации."
                            }
                        },
                        {
                            "text": "In many stories, the villain is written to <w>embody</w> pure evil without any redeeming qualities.",
                            "target_lang_translations": {
                                "ru": "Во многих историях злодей написан так, чтобы <w>олицетворять</w> чистое зло без каких-либо искупающих качеств."
                            }
                        }
                    ],
                    "synonyms": [
                        "actualize",
                        "concretize",
                        "materialize",
                        "objectify",
                        "realize"
                    ],
                    "antonyms": [
                        "exclude",
                        "disembody"
                    ],
                    "common_phrases": [
                        "embody the spirit",
                        "embody an ideal",
                        "perfectly embody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять какое-либо качество, чувство или идею в физической или конкретной форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воплощать",
                                "target_lang_sense_clarification": "придавать конкретную форму идее или качеству"
                            },
                            {
                                "target_lang_word": "олицетворять",
                                "target_lang_sense_clarification": "быть живым примером или выражением чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b40d1c0-a6b8-3dd8-a80b-512fe77ee508",
                    "sense_definition": "To express or include an idea or principle in a formal system, such as a law or a constitution.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations <w>embody</w> the principle of equal pay for equal work.",
                            "target_lang_translations": {
                                "ru": "Новые правила <w>закрепляют</w> принцип равной оплаты за равный труд."
                            }
                        },
                        {
                            "text": "The US Constitution aimed to <w>embody</w> the ideals of diverse groups of people.",
                            "target_lang_translations": {
                                "ru": "Конституция США была призвана <w>воплотить</w> идеалы различных групп людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "embrace",
                        "encompass",
                        "enfold"
                    ],
                    "common_phrases": [
                        "embody the principles",
                        "embody in law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать или включать идею или принцип в официальную систему, такую как закон или конституция."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "фиксировать принципы в законе или документе"
                            },
                            {
                                "target_lang_word": "воплощать",
                                "target_lang_sense_clarification": "отражать основные идеи в системе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e63bb01-33a4-3cb0-95c8-c5ade91a9842",
                    "sense_definition": "To comprise or include several different parts as a single, cohesive whole.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest design will <w>embody</w> all the features requested by our customers.",
                            "target_lang_translations": {
                                "ru": "Последний дизайн будет <w>сочетать в себе</w> все функции, запрошенные нашими клиентами."
                            }
                        },
                        {
                            "text": "These services <w>embody</w> the most complete system of transportation in the country.",
                            "target_lang_translations": {
                                "ru": "Эти услуги <w>представляют собой</w> самую полную транспортную систему в стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "integrate",
                        "merge",
                        "encompass"
                    ],
                    "common_phrases": [
                        "embody various features"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержать или включать в себя несколько различных частей как единое, сплоченное целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетать в себе",
                                "target_lang_sense_clarification": "объединять различные характеристики"
                            },
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "содержать в составе целого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4afe8601-d78e-39e9-8cb5-de27d591f1af",
                    "sense_definition": "To unite or join together into a single mass or body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters remained <w>embodied</w> peaceably until the charter was confirmed.",
                            "target_lang_translations": {
                                "ru": "Протестующие мирно <w>оставались единой группой</w> до тех пор, пока хартия не была подтверждена."
                            }
                        },
                        {
                            "text": "During the winter, the birds will <w>embody</w> and fly toward warmer climates together.",
                            "target_lang_translations": {
                                "ru": "Зимой птицы <w>сбиваются в стаи</w> и вместе летят в теплые края."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuse",
                        "merge",
                        "coalesce"
                    ],
                    "antonyms": [
                        "scatter",
                        "disperse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of physical unification is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединяться или соединяться в единую массу или тело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплотиться",
                                "target_lang_sense_clarification": "собраться в единую группу"
                            },
                            {
                                "target_lang_word": "объединиться",
                                "target_lang_sense_clarification": "стать единым целым"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}