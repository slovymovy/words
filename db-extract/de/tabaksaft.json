                "senses": [
                    {
                        "sense_id": "88a5b52d-8d4e-32fe-bd3c-6a13743fe243",
                        "entry_id": "942bf877-e016-3200-88e1-6b74760880be",
                        "glosses": [
                            "Flüssigkeit, die beim Tabakkonsum durch eine Vermischung von Tabak und Speichel entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474024c0-4a5c-4641-a511-75c1240383a5",
                                "sense_id": "88a5b52d-8d4e-32fe-bd3c-6a13743fe243",
                                "text": "„Der Mann machte ein finsteres Gesicht. Tabaksaft lief ihm aus dem Mundwinkel.“"
                            },
                            {
                                "example_id": "faf39bfe-905f-4595-a7eb-810cb07eea4f",
                                "sense_id": "88a5b52d-8d4e-32fe-bd3c-6a13743fe243",
                                "text": "„Beaumont spuckte Tabaksaft in einen Plastikbecher, den er in der Hand hielt.“"
                            },
                            {
                                "example_id": "e20bc347-9da3-4445-9449-85ca53847b63",
                                "sense_id": "88a5b52d-8d4e-32fe-bd3c-6a13743fe243",
                                "text": "„Das Bächlein rann über den leicht geneigten Boden, sammelte unterwegs einzelne Spritzer des von ihm ausgespuckten Tabaksafts auf und hielt langsam auf das rostige Abflussgitter zu, wo alle seine diversen Flüssigkeiten in beträchtlicher Menge versickerten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
