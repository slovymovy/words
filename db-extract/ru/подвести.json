                ],
                "senses": [
                    {
                        "sense_id": "2e82cd3a-ddc7-35e6-842b-17dbda1303ef",
                        "entry_id": "c3333376-8f94-3acd-b0a4-81204e17a43e",
                        "glosses": [
                            "to lead (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a1641c-39b6-481e-a1b7-0e1bf0fae235",
                                "sense_id": "2e82cd3a-ddc7-35e6-842b-17dbda1303ef",
                                "text": "Князь подвёл госте́й к окну́, и им откры́лся преле́стный вид.",
                                "translation": "The prince led his guests to the window, and before them opened a lovely view.",
                                "english": "The prince led his guests to the window, and before them opened a lovely view."
                            },
                            {
                                "example_id": "11b413c3-2f20-4d6a-823d-1424c7171b7e",
                                "sense_id": "2e82cd3a-ddc7-35e6-842b-17dbda1303ef",
                                "text": "Дожда́вшись конца́ кадри́ли, Си́тников подвёл Арка́дия к Одинцо́вой; но едва́ ли он был ко́ротко с ней знако́м: и сам он запу́тался в реча́х свои́х, и она́ гляде́ла на него́ с не́которым изумле́нием.",
                                "translation": "When the quadrille was over, Sitnikov led Arkady over to Madame Odintsov. But he hardly seemed to know her at all, and stumbled over his words, while she looked at him in some surprise.",
                                "english": "When the quadrille was over, Sitnikov led Arkady over to Madame Odintsov. But he hardly seemed to know her at all, and stumbled over his words, while she looked at him in some surprise."
                            },
                            {
                                "example_id": "89575403-6499-45cf-85d2-dd236155d11a",
                                "sense_id": "2e82cd3a-ddc7-35e6-842b-17dbda1303ef",
                                "text": "Порфи́рий Влади́мирыч подвёл А́нниньку к окну́ и указа́л руко́й на карти́ну весе́ннего возрожде́ния.",
                                "translation": "Porfiry Vladimirych took Anninka to the window and pointed to this scene of spring’s regeneration.",
                                "english": "Porfiry Vladimirych took Anninka to the window and pointed to this scene of spring’s regeneration."
                            }
                        ]
                    },
                    {
                        "sense_id": "05f2f75e-c0de-3ed6-a418-b7d877e74b64",
                        "entry_id": "c3333376-8f94-3acd-b0a4-81204e17a43e",
                        "glosses": [
                            "to bring closer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205b1dc9-3c57-42be-8b53-89b074dfaab7",
                                "sense_id": "05f2f75e-c0de-3ed6-a418-b7d877e74b64",
                                "text": "подвести́ часы́",
                                "translation": "to alter the watch/clock; to set the watch/clock",
                                "english": "to alter the watch/clock; to set the watch/clock"
                            },
                            {
                                "example_id": "06aac6b7-42ae-4868-8f09-42da47523ae9",
                                "sense_id": "05f2f75e-c0de-3ed6-a418-b7d877e74b64",
                                "text": "подвести́ войска́ к грани́це",
                                "translation": "to bring troops to the border",
                                "english": "to bring troops to the border"
                            },
                            {
                                "example_id": "7622162b-4b7c-49c5-bd61-b159c3a6fa11",
                                "sense_id": "05f2f75e-c0de-3ed6-a418-b7d877e74b64",
                                "text": "У него́ живо́т от го́лода подвело́.",
                                "translation": "He is awfully hungry; he feels pinched.",
                                "english": "He is awfully hungry; he feels pinched."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d98471b-1bf1-3528-8ad9-e147831b7f65",
                        "entry_id": "c3333376-8f94-3acd-b0a4-81204e17a43e",
                        "glosses": [
                            "to place (under)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b6320e-deb7-4be9-898a-533981432506",
