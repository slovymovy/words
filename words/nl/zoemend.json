                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er vloog een bij <w>zoemend</w> door de openstaande deur naar binnen.",
                            "target_lang_translations": {
                                "en": "A bee flew <w>buzzing</w> inside through the open door."
                            }
                        },
                        {
                            "text": "De koelkast stond de hele nacht luidruchtig te <w>zoemen</w> in de keuken.",
                            "target_lang_translations": {
