                "senses": [
                    {
                        "sense_id": "a7ae7e5f-4287-33d3-98f8-a75dba1d6fbb",
                        "entry_id": "b4e3d84f-4b05-3ad9-a2a2-f482998dd8b9",
                        "glosses": [
                            "Installation de cloisons pour isoler un certain volume du bâtiment, en particulier pour éviter la propagation d’un feu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1da6d87-a169-4026-9407-0faf400cd286",
                                "sense_id": "a7ae7e5f-4287-33d3-98f8-a75dba1d6fbb",
                                "text": "L’encloisonnement d’un escalier ou d’un ou plusieurs ascenseurs est constitué par une cage continue jusqu’au niveau d’évacuation vers l’extérieur. L’encloisonnement peut être commun à un escalier et à un ascenseur."
                            },
                            {
                                "example_id": "c1fb4a7a-c99e-47f1-ba85-5bd7d4213f13",
                                "sense_id": "a7ae7e5f-4287-33d3-98f8-a75dba1d6fbb",
                                "text": "Cet article précise que la protection des escaliers et des ascenseurs par encloisonnement, ou par ouverture à l’air libre de la cage, s’oppose à la propagation du feu vers les étages supérieurs et permet l’évacuation des personnes à l’abri des fumées et des gaz."
                            },
                            {
                                "example_id": "5c721c0e-1bd2-4c68-90f8-ae480a13cf78",
                                "sense_id": "a7ae7e5f-4287-33d3-98f8-a75dba1d6fbb",
                                "text": "Les systèmes de sécurité incendie, les planchers et les mezzanines coupe-feu vont être entièrement repensés, ainsi que l’encloisonnement des cages d’escalier et le système électrique."
                            }
                        ]
                    }
