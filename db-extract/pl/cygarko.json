                        "translation_id": "dde1affc-d040-41d2-a1a3-cd0bf46b4bda",
                        "source_entry_id": "b3456286-d886-3d55-b60f-2530bb580def",
                        "source_sense_id": "e22d3d0e-703e-348a-94b7-78eb5d47ee34",
                        "target_lang_word": "сигарка",
