                "senses": [
                    {
                        "sense_id": "07510830-704e-3752-9026-22d149498996",
                        "entry_id": "ec81ac80-94d1-33f0-a014-1b278a5a28f5",
                        "glosses": [
                            "Art und Weise, wie man etwas tut, um ein Lüftungsziel zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98add6fc-60df-44ec-abb7-0c01bd7b7fcd",
                                "sense_id": "07510830-704e-3752-9026-22d149498996",
                                "text": "„Fenster gekippt halten ist eine Lüftungsmethode für den Sommer.“ Schimmel -"
                            },
                            {
                                "example_id": "0fb049ef-dc88-4435-bb49-6f0da682be4f",
                                "sense_id": "07510830-704e-3752-9026-22d149498996",
                                "text": "„Diese Lüftungsmethode eignet sich auch dann, wenn besonders starke Gerüche in den Räumen sind, beispielweise vom Rauchen oder Kochen.“"
                            },
                            {
                                "example_id": "2988b0df-f5d8-4547-9c03-371c1ae3231d",
                                "sense_id": "07510830-704e-3752-9026-22d149498996",
                                "text": "„Diese Ströme sollen, unabhängig von der Lüftungsmethode, mindestens Folgendes betragen: - für die Küche mit Aussenfenster, die mit einem Gas- oder Kochherd ausgestattet ist - 70 m3/h […]“"
                            },
                            {
                                "example_id": "7fb3665c-abd6-45bf-9550-a99e04a27259",
                                "sense_id": "07510830-704e-3752-9026-22d149498996",
                                "text": "„Kennzeichnend für das durchgehendes Firstlüftungssystem ist die Lüftungsmethode, die mittels zweier Lüftungsfenster pro Dach, eines an jeder Seite, stattfindet.“"
                            },
                            {
                                "example_id": "60b9bfba-4d13-46c1-a2e2-1aa98f4a5bee",
                                "sense_id": "07510830-704e-3752-9026-22d149498996",
                                "text": "„Die Klimacomputer-Serie DOL 339 wird bei den Lüftungsmethoden Tunnel, LPV und Combi-Tunnel eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
