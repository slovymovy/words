                                        "glosses": [
                                            "narzędzie tnące z zębatym ostrzem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd991639-f214-46d5-91a3-3d75f548720b",
                                                "sense_id": "c21590e2-595a-317c-a025-e96a45175969",
                                                "text": "Podejdź z tą piłą i utnij mi tę belkę pięć centymetrów niżej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "52ea689b-3f3b-384c-a0a3-8e1473d610a0",
                                        "entry_id": "1edbe113-b338-37ce-93ec-e97aad2a04d5",
                                        "glosses": [
                                            "ryba Pristis pristis z rodziny piłowatych, wyglądem przypominająca rekina"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440942e4-b773-4caa-b230-9c938ebfd284",
                                                "sense_id": "52ea689b-3f3b-384c-a0a3-8e1473d610a0",
                                                "text": "Piły mają specyficzny wygląd pyska, kształtem przypominającego piłę (1.1), który służy im do ogłuszania i zabijania ofiar."
                                            }
                                        ],
