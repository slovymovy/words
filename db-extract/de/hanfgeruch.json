                "senses": [
                    {
                        "sense_id": "eb3c8eff-b17a-37f5-9179-1444644b718f",
                        "entry_id": "f6def66f-1a7d-3684-9e5c-4138fe758317",
                        "glosses": [
                            "Geruch, der von frischen und/oder weiblichen Hanfpflanzen stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66c37e6a-55e8-4a50-8c2b-a2b083438901",
                                "sense_id": "eb3c8eff-b17a-37f5-9179-1444644b718f",
                                "text": "„Dabei nahmen sie aus einem Luftschacht kommend Hanfgeruch wahr.“"
                            },
                            {
                                "example_id": "8d45293a-e381-40ba-98ce-bff6629918ab",
                                "sense_id": "eb3c8eff-b17a-37f5-9179-1444644b718f",
                                "text": "„Nachbarn hatten süßen Hanfgeruch wahrgenommen.“"
                            },
                            {
                                "example_id": "36bc627b-1dc7-4b19-8898-ef6367105797",
                                "sense_id": "eb3c8eff-b17a-37f5-9179-1444644b718f",
                                "text": "„Die Ursache des Hanfgeruchs ist also nach wie vor ein Rätsel.“"
                            },
                            {
                                "example_id": "4cbc6316-4fec-44a2-9626-865d9ca7e881",
                                "sense_id": "eb3c8eff-b17a-37f5-9179-1444644b718f",
                                "text": "„Laut Polizeisprecherin Adina Mircioane hatte ein Mieter am Sonntagabend gegen 20.00 Uhr die Polizei gerufen, weil ihn der ständige Hanfgeruch in dem Wohnhaus in der Viriotgasse enervierte.“"
                            },
                            {
                                "example_id": "639822c1-dd45-4874-a4dd-a5b1e3647d3c",
                                "sense_id": "eb3c8eff-b17a-37f5-9179-1444644b718f",
                                "text": "„Stoßen die Detektoren auf Hanfgeruch, wird Alarm geschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
