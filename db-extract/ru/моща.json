                        "glosses": [
                            "разг. то же, что мощность; мощь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5195f49-f772-415c-ad2c-7f126486cfcd",
                                "sense_id": "03a74f5e-36da-36a3-a767-739f7e121e95",
                                "text": "Я в армии на «КрАЗах» ездил, вот моща так моща…"
