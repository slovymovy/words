                                "sense_id": "b5633c8d-03d4-3c9d-b93d-2a89de9ac32e",
                                "text": "Er is een nieuw bouwterrein in de buurt.",
                                "translation": "There is a new building site in the neighborhood.",
                                "english": "There is a new building site in the neighborhood."
                            },
                            {
                                "example_id": "5043d0db-9064-4c37-bc93-77b46cd9dda6",
                                "sense_id": "b5633c8d-03d4-3c9d-b93d-2a89de9ac32e",
                                "text": "De arbeiders waren druk bezig op het bouwterrein.",
                                "translation": "The workers were busy on the building site.",
