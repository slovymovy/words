                    "sense_id": "f4d40c64-95b8-37c3-b200-78519ee07dbb",
                    "sense_definition": "Zich rechtop op de voeten bevinden; in verticale positie zijn.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <stond> al een uur in de rij voor de kassa.",
                            "target_lang_translations": {
                                "ru": "Он уже час <стоял> в очереди в кассу.",
                                "en": "He had been <standing> in line for the checkout for an hour already.",
                                "pl": "On już od godziny <stał> w kolejce do kasy.",
                                "de": "Er <stand> schon eine Stunde lang in der Schlange vor der Kasse.",
                                "fr": "Il <était debout> déjà depuis une heure dans la file d'attente de la caisse.",
                                "it": "Era già da un'ora in coda alla cassa <in piedi>.",
                                "cs": "Už hodinu <stál> ve frontě u pokladny.",
                                "tr": "Kasa kuyruğunda zaten bir saattir <w>bekliyordu</w>.",
                                "es": "Él ya <estuvo de pie> una hora en la cola de la caja."
                            }
                        },
                        {
                            "text": "Ik <sta> liever dan dat ik op de grond moet zitten.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю <стоять>, чем сидеть на полу.",
                                "en": "I prefer <standing> to sitting on the floor.",
                                "pl": "Wolę <stać> niż siedzieć na ziemi.",
                                "de": "Ich <stehe> lieber, als dass ich auf dem Boden sitzen muss.",
                                "fr": "Je préfère <rester debout> plutôt que de devoir m'asseoir par terre.",
                                "it": "Preferisco <stare in piedi> piuttosto che dovermi sedere per terra.",
                                "cs": "Raději budu <stát>, než abych musel sedět na zemi.",
                                "tr": "Yerde oturmak zorunda kalmaktansa <w>ayakta durmayı</w> tercih ederim.",
                                "es": "Prefiero <estar de pie> que tener que sentarme en el suelo."
                            }
                        }
                    ],
                    "antonyms": [
                        "zitten",
                        "liggen"
                    ],
                    "common_phrases": [
                        "in de rij staan",
                        "stil staan",
                        "op de uitkijk staan"
                    ],
