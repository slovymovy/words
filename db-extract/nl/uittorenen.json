                        "cross_references": []
                    },
                    {
                        "translation_id": "fdb61f0d-d30b-4aec-998c-4c80afd88a0e",
                        "source_entry_id": "0fb6cfbf-13b1-38bf-985b-ebf8297469be",
                        "source_sense_id": "5794442c-534d-3cc5-87c2-8898fd85aaa8",
                        "target_lang_word": "rise above",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rise above",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c471ef8f-8bd9-3500-b87b-5caefe3e3f90",
                                        "entry_id": "e3ed9970-dcac-34bc-9f58-2a3657ddcbb4",
                                        "glosses": [
                                            "To ignore petty or trivial issues and do what one is supposed to; to act better than someone or something inappropriate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d855a555-0457-4b07-b31c-04e32c232a63",
                                                "sense_id": "c471ef8f-8bd9-3500-b87b-5caefe3e3f90",
                                                "text": "We must rise above ourselves. We must rise above what it means to be human. We must rise above what our ordinary consciousness inspires us to do. We must rise above our needs, our self-interest, our greed, our hunger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a5431c1-766a-39a6-bf45-b53b7a4fdf2a",
                                        "entry_id": "e3ed9970-dcac-34bc-9f58-2a3657ddcbb4",
                                        "glosses": [
                                            "To prevent something unfortunate or traumatic from affecting oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2e3a27-03aa-498e-8800-e1b6281e6ccd",
                                                "sense_id": "7a5431c1-766a-39a6-bf45-b53b7a4fdf2a",
                                                "text": "I have times of weakness, but I choose to rise above them. No matter what you're going through—whether it be divorce, losing a loved one, or a burnt out headlight—you have a choice to rise above. You will rise above because you are strong enough."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
