                    "sense_id": "c1d173d8-4447-3f1d-9ecd-71173fae7daa",
                    "sense_definition": "Qui s'écarte des règles communes, plein d'originalité ou de fantaisie imprévisible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte a conçu une façade très <w>fantaisiste</w> qui attire immédiatement le regard des passants."
                        },
                        {
                            "text": "Elle adore porter des vêtements à la coupe <w>fantaisiste</w> lors des grandes réceptions mondaines."
                        }
                    ],
                    "synonyms": [
