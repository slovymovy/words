                            {
                                "example_id": "45297dcf-9657-4df2-a7cb-2399cfd9a1dd",
                                "sense_id": "24cea73a-3e98-305a-95c3-6b3d66445268",
                                "text": "Kevins Spreche ist mir aber zuwider."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8e134286-1e11-3f8e-9f10-3fc16fead8ea",
                        "entry_id": "4cdda25f-1d43-313c-9ef4-e11a8b93ce35",
                        "glosses": [
                            "gesprochene Sprache, mündliche Form der Sprache"
                        ],
                        "tags": [],
