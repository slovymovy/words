                                        "entry_id": "28f2f008-0e03-32a3-89b3-1369b2a17e35",
                                        "glosses": [
                                            "верхняя оконечность, вершина чего-либо; макушка (дерева, дома, горы и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
