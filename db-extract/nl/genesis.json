                                        "sense_id": "b5daecde-996d-3ca0-bf9c-04fa02f02f95",
                                        "entry_id": "eb3cdf74-4af1-367e-8395-a5c0f3da1656",
                                        "glosses": [
                                            "1. Buch Mose"
