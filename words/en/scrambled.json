{
    "word_family": [
        "scramble",
        "scrambler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ecec8aa-852e-35c4-9c1c-2a7123e06d53",
                    "sense_definition": "Cooked by stirring or beating whites and yolks together, typically in a heated pan.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered toast with <w>scrambled</w> eggs for breakfast at the diner.",
                            "target_lang_translations": {
                                "pl": "Zamówiła w dinerze tosty z <w>jajecznicą</w> na śniadanie."
                            }
                        },
                        {
                            "text": "He always preferred his eggs fried rather than <w>scrambled</w>.",
                            "target_lang_translations": {
                                "pl": "Zawsze wolał jajka sadzone niż <w>w postaci jajecznicy</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scrambled eggs"
                    ],
                    "target_lang_definitions": {
                        "pl": "O jajkach: usmażone lub ścięte na patelni z wymieszanych białek i żółtek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "jajecznica",
                                "target_lang_sense_clarification": "danie z roztrzepanych i usmażonych jajek (scrambled eggs)"
                            },
                            {
                                "target_lang_word": "w postaci jajecznicy",
                                "target_lang_sense_clarification": "opis sposobu przyrządzenia jajek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76902a26-d130-3a44-9ca4-468a646b4a88",
                    "sense_definition": "Mixed together in a confused or disordered state, or intentionally jumbled so as to be unintelligible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disordered",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The television screen showed only static and a completely <w>scrambled</w> picture.",
                            "target_lang_translations": {
                                "pl": "Ekran telewizora pokazywał tylko szum i całkowicie <w>zakłócony</w> obraz."
                            }
                        },
                        {
                            "text": "After hours of studying without a break, his thoughts felt thoroughly <w>scrambled</w>.",
                            "target_lang_translations": {
                                "pl": "Po wielu godzinach nauki bez przerwy jego myśli były kompletnie <w>pomieszane</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumbled",
                        "disordered",
                        "shuffled"
                    ],
                    "antonyms": [
                        "ordered"
                    ],
                    "common_phrases": [
                        "scrambled signal"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wymieszany w chaotyczny sposób lub celowo zakłócony, zaszyfrowany (np. sygnał)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zakłócony",
                                "target_lang_sense_clarification": "o sygnale, obrazie"
                            },
                            {
                                "target_lang_word": "pomieszany",
                                "target_lang_sense_clarification": "o myślach, kolejności"
                            },
                            {
                                "target_lang_word": "poszarpany",
                                "target_lang_sense_clarification": "o obrazie telewizyjnym"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "402c05eb-2cdd-30cc-9901-4dc9b1d2c94b",
                    "sense_definition": "Simple past tense and past participle of <w>scramble</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers <w>scrambled</w> up the steep and rocky hillside to reach the summit.",
                            "target_lang_translations": {
                                "pl": "Turyści <w>wdrapali się</w> na strome i kamieniste zbocze, aby dotrzeć na szczyt."
                            }
                        },
                        {
                            "text": "Shoppers <w>scrambled</w> to find the best deals before the store closed.",
                            "target_lang_translations": {
                                "pl": "Klienci <w>rzucili się</w> do szukania najlepszych okazji przed zamknięciem sklepu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma czasu przeszłego i imiesłów od 'scramble': wdrapywać się na czworakach lub rzucać się gwałtownie do czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wdrapał się",
                                "target_lang_sense_clarification": "czas przeszły od scramble (wspinać się na czworakach)"
                            },
                            {
                                "target_lang_word": "rzucił się",
                                "target_lang_sense_clarification": "czas przeszły od scramble (walczyć o coś w pośpiechu)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}