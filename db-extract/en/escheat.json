                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "63859b62-d569-35d5-a136-d2ac8a5def52",
                                        "entry_id": "ae087ae3-d2c8-3a3c-b615-912f65824ffa",
                                        "glosses": [
                                            "diabeł, czart"
