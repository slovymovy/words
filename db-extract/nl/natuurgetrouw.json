                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7399709a-9487-4cf5-84f6-03af65478763",
                                                "sense_id": "560a0ae5-2113-3b25-acbc-87249f205df4",
                                                "text": "A realistic appraisal of the situation."
                                            },
                                            {
                                                "example_id": "46c23623-a1a2-4e71-8c55-d5368eece869",
                                                "sense_id": "560a0ae5-2113-3b25-acbc-87249f205df4",
                                                "text": "Scotland needed a victory by eight points to have a realistic chance of progressing to the knock-out stages, and for long periods of a ferocious contest looked as if they might pull it off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeab5e9e-b700-30a9-be1b-d4d293a8b287",
