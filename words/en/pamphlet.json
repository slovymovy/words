{
    "word_family": [
        "pamphleteer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "713d90dd-2ed9-36f3-a83e-b4d7a0c9f03f",
                    "sense_definition": "A small, thin book or booklet, usually with a paper cover, containing information or advertising.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "printed_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourist office gave us a <w>pamphlet</w> with a map of the city.",
                            "target_lang_translations": {
                                "tr": "Turizm ofisi bize şehir haritası içeren bir <w>broşür</w> verdi."
                            }
                        },
                        {
                            "text": "She read the <w>pamphlet</w> to learn more about the local history.",
                            "target_lang_translations": {
                                "tr": "Yerel tarih hakkında daha fazla bilgi edinmek için <w>kitapçığı</w> okudu."
                            }
                        }
                    ],
                    "synonyms": [
                        "booklet",
                        "brochure",
                        "leaflet"
                    ],
                    "common_phrases": [
                        "information pamphlet",
                        "tourist pamphlet"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgi veya reklam içeren, genellikle kağıt kapaklı, küçük ve ince kitapçık veya broşür."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "broşür",
                                "target_lang_sense_clarification": "bilgilendirici veya tanıtıcı küçük basılı materyal"
                            },
                            {
                                "target_lang_word": "kitapçık",
                                "target_lang_sense_clarification": "küçük ebatlı, az sayfalı basılı eser"
                            },
                            {
                                "target_lang_word": "risale",
                                "target_lang_sense_clarification": "küçük boyutlu bilgilendirici kitapçık"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7517ddf8-864d-3fc6-aeaa-16274039d4ab",
                    "sense_definition": "A short printed work that discusses political issues or controversial topics.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "printed_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The activist wrote a <w>pamphlet</w> to protest the new law.",
                            "target_lang_translations": {
                                "tr": "Aktivist, yeni yasayı protesto etmek için bir <w>risale</w> yazdı."
                            }
                        },
                        {
                            "text": "He distributed a political <w>pamphlet</w> to everyone in the town square.",
                            "target_lang_translations": {
                                "tr": "Kent meydanındaki herkese siyasi bir <w>bildiri</w> dağıttı."
                            }
                        }
                    ],
                    "synonyms": [
                        "tract"
                    ],
                    "common_phrases": [
                        "political pamphlet"
                    ],
                    "target_lang_definitions": {
                        "tr": "Siyasi meseleleri veya tartışmalı konuları ele alan kısa basılı yayın veya bildiri."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "risale",
                                "target_lang_sense_clarification": "siyasi veya fikri konularda yazılmış küçük kitapçık"
                            },
                            {
                                "target_lang_word": "pamflet",
                                "target_lang_sense_clarification": "yergi ya da siyasi eleştiri içeren küçük kitapçık"
                            },
                            {
                                "target_lang_word": "bildiri",
                                "target_lang_sense_clarification": "siyasi veya ideolojik görüş açıklayan basılı metin"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65590985-a558-3c7f-ab6d-178e7e9fb909",
                    "sense_definition": "To hand out or distribute printed booklets or leaflets to people.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were <w>pamphleting</w> outside the university gates.",
                            "target_lang_translations": {
                                "tr": "Öğrenciler üniversite kapısının önünde <w>broşür dağıtıyorlardı</w>."
                            }
                        },
                        {
                            "text": "They spent the whole afternoon <w>pamphleting</w> the busy shopping street.",
                            "target_lang_translations": {
                                "tr": "Bütün öğleden sonrayı işlek alışveriş caddesinde <w>el ilanı dağıtarak</w> geçirdiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "hand out"
                    ],
                    "common_phrases": [
                        "pamphleting the street"
                    ],
                    "target_lang_definitions": {
                        "tr": "İnsanlara basılı kitapçık, broşür veya el ilanı dağıtmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "broşür dağıtmak",
                                "target_lang_sense_clarification": "el ilanı veya broşürleri çevredekilerin eline vermek"
                            },
                            {
                                "target_lang_word": "el ilanı dağıtmak",
                                "target_lang_sense_clarification": "insanlara sokakta vb. basılı kağıt vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e03dee-6c65-37cf-8163-9185650f5032",
                    "sense_definition": "To write or publish information in the form of a short booklet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization decided to <w>pamphlet</w> their findings to reach a wider audience.",
                            "target_lang_translations": {
                                "tr": "Kuruluş, daha geniş bir kitleye ulaşmak için bulgularını <w>kitapçık halinde yayımlamaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "The controversial report was <w>pamphleted</w> and sent to all local officials.",
                            "target_lang_translations": {
                                "tr": "Tartışmalı rapor <w>risale olarak basıldı</w> ve tüm yerel yetkililere gönderildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "publish"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgileri kısa bir kitapçık veya risale şeklinde yazmak ya da yayımlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kitapçık halinde yayımlamak",
                                "target_lang_sense_clarification": "bir metni broşür veya risale olarak basıp çıkarmak"
                            },
                            {
                                "target_lang_word": "risale olarak basmak",
                                "target_lang_sense_clarification": "içeriği küçük bir kitapçık formatında basmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}