                "senses": [
                    {
                        "sense_id": "e2489e04-c5d1-38b7-8922-9f4c62180ac5",
                        "entry_id": "c40530c9-d788-3357-bf36-9901b833c650",
                        "glosses": [
                            "Anlage/Stützpunkt der Flotte"
