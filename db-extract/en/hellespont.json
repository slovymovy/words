                    {
                        "sense_id": "9aee3484-e14b-3473-ad99-591ff4b2c16c",
                        "entry_id": "4d2aba62-2161-3120-ada1-1b1ece65a60d",
                        "glosses": [
                            "The strait connecting the Sea of Marmara with the Aegean Sea to the west."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d48a1898-ebe7-4341-8bd4-56aa66743e84",
                                "sense_id": "9aee3484-e14b-3473-ad99-591ff4b2c16c",
                                "text": "That he who has the time should lack the force, that she who has the force should lack the time! That a trifling and in all probability tractable obstruction of some endocrinal Bandusia, that a mere matter of forty-five or fifty minutes by the clock, should as effectively as death itself, or as the Hellespont, separate lovers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8683493-d204-4c98-9ce8-7f3261e4822e",
                        "source_entry_id": "4d2aba62-2161-3120-ada1-1b1ece65a60d",
                        "source_sense_id": "9aee3484-e14b-3473-ad99-591ff4b2c16c",
