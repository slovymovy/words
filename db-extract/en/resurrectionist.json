    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a94b793c-b2ad-3f70-ac41-8013c690984b",
                "word": "resurrectionist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "577891e2-c719-4bfe-b75d-68e9c0c2fb81",
                        "entry_id": "a94b793c-b2ad-3f70-ac41-8013c690984b",
                        "tags": [
                            "plural"
                        ],
                        "form": "resurrectionists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbc42d0a-7a7d-360c-96a8-f98fc8cedfd9",
                        "entry_id": "a94b793c-b2ad-3f70-ac41-8013c690984b",
                        "glosses": [
                            "One who sells cadavers to anatomists, surgeons, etc., especially by exhuming corpses from graves; a graverobber."
                        ],
                        "tags": [
                            "euphemistic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "46ad7a54-f0ee-4072-a0b4-1802f3bcbd80",
                                "sense_id": "dbc42d0a-7a7d-360c-96a8-f98fc8cedfd9",
                                "text": "One... who makes open profession of dealing in dead bodies and is well known by the name of the Resurrectionist."
                            },
                            {
                                "example_id": "a4cd67cb-030b-4071-9e19-e73b770563fe",
                                "sense_id": "dbc42d0a-7a7d-360c-96a8-f98fc8cedfd9",
                                "text": "Early in the 19th century, Udny Green churchyard was a favourite haunt of resurrectionists who dug up freshly interred corpses to sell to the medical school at Aberdeen. To prevent this, in 1832 the villagers built a mort-house where they kept the newly dead for a while before burial."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecd3f608-d76b-3a9c-bce9-ac5de128d08a",
                        "entry_id": "a94b793c-b2ad-3f70-ac41-8013c690984b",
                        "glosses": [
                            "A believer in a future bodily resurrection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a1d0543-af68-42d7-997c-7ae9050d6eb1",
                                "sense_id": "ecd3f608-d76b-3a9c-bce9-ac5de128d08a",
                                "text": "1830, A. Addis, Theory of Prophecy, Prol. p.xliv\nThose who make the rest of the dead... to be the same with the remnant slain by the sword... to be consistent, ought to make the first resurrectionists the same with the armies in heaven."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7dff743-1110-39ef-8185-4aeff0c7bad4",
                        "entry_id": "a94b793c-b2ad-3f70-ac41-8013c690984b",
                        "glosses": [
                            "One who resurrects an abandoned idea, practice, etc.; a revivalist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1824c611-5786-41ac-9c88-020ff74edff9",
                                "sense_id": "c7dff743-1110-39ef-8185-4aeff0c7bad4",
                                "text": "We have no taste for enacting the part of literary resurrectionists."
                            },
                            {
                                "example_id": "ab57e9a7-e84b-44e1-9203-675c3d590b92",
                                "sense_id": "c7dff743-1110-39ef-8185-4aeff0c7bad4",
                                "text": "Bank is a theatrical resurrectionist: His New York-based company... specializes in unearthing and staging ‘neglected but worthy’ works."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a0826f8-d7b7-3f85-aeda-9ee2f173ec02",
                        "entry_id": "a94b793c-b2ad-3f70-ac41-8013c690984b",
                        "glosses": [
                            "One who sells repaired or reconditioned goods; a refurbisher."
                        ],
                        "tags": [
                            "humorous",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b942cea8-a542-4a2d-9fe1-40d26e633f27",
                                "sense_id": "4a0826f8-d7b7-3f85-aeda-9ee2f173ec02",
                                "text": "Some of the habitual buyers [of ostrich feathers] have nicknames, and those who do a local business and buy for re-selling are known as ‘resurrectionists’."
                            }
                        ]
                    },
                    {
                        "sense_id": "65496e1d-2d68-3e1f-94ac-fb9ca02735f0",
                        "entry_id": "a94b793c-b2ad-3f70-ac41-8013c690984b",
                        "glosses": [
                            "A racehorse that (once or numerously) suddenly recovers its stamina midrace."
                        ],
                        "tags": [
                            "humorous",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "93e488b0-f18d-4fc3-a20d-05f14e7ef8fb",
                                "sense_id": "65496e1d-2d68-3e1f-94ac-fb9ca02735f0",
                                "text": "There is a class of horses called ‘resurrectionists’... and they either recover early form... or... become animated, when they were supposed to be gone altogether, with... life and vigour."
                            }
                        ]
                    }
                ],
