                "senses": [
                    {
                        "sense_id": "50141110-a455-3876-bfa1-7d516af9a4f5",
                        "entry_id": "e31c397f-652c-3874-beb5-e35bfb10d364",
                        "glosses": [
                            "der Vorgang, die Handlung, etwas neu anzulegen, zu erstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86230039-8bba-4b0f-8f29-954be0784c7c",
                                "sense_id": "50141110-a455-3876-bfa1-7d516af9a4f5",
                                "text": "„Anordnungen zum Feldheckenschutz und zur Neuanlage von Hecken sind bereits für das frühe 18. Jahrhundert belegt.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "bc390a9d-76d6-3308-8e06-f315fbb04514",
                        "entry_id": "e31c397f-652c-3874-beb5-e35bfb10d364",
                        "glosses": [
                            "etwas, das neu errichtet, angelegt, erstellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a78ce7-d9d5-4f51-b9e3-c4532c76f110",
                                "sense_id": "bc390a9d-76d6-3308-8e06-f315fbb04514",
                                "text": "„§ 10 ZuG 2007 soll besondere Anreize zur Investition in Neuanlagen und in klimafreundliche Technik vermitteln und ermöglicht den Betreibern von Neuanlagen, … noch vier Jahre lang die der … Altanlage zustehende Menge an Zertifikate zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "7bbd1618-f632-3382-a415-adce44171711",
                        "entry_id": "e31c397f-652c-3874-beb5-e35bfb10d364",
                        "glosses": [
                            "Geld-, Sachvermögen, das zum ersten Mal oder erneut in etwas investiert, angelegt wird"
                        ],
                        "tags": [
                            "Finanzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "aaf8b2c7-50df-4246-a6c3-d321fb58fc8f",
                                "sense_id": "7bbd1618-f632-3382-a415-adce44171711",
                                "text": "„[Für Versicherungskonzerne] dürfte es immer schwerer werden, mit Neuanlagen am Kapitalmarkt die garantierten Zinsen zu erwirtschaften.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
