                "senses": [
                    {
                        "sense_id": "9e70dfec-e971-347f-bc08-920149b818ee",
                        "entry_id": "af1e0bff-4417-340a-8b33-ca75906d8ab8",
                        "glosses": [
                            "kleineres Haus, das aus Steinen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f4da9d-ee0d-48dd-ad62-3853f7d0601b",
                                "sense_id": "9e70dfec-e971-347f-bc08-920149b818ee",
                                "text": "„Nach wenigen Metern stoppten wir an einem gemauerten Steinhäuschen.“"
                            },
                            {
                                "example_id": "e79c8d7e-37a0-4ad2-82bc-8def0c7c408d",
                                "sense_id": "9e70dfec-e971-347f-bc08-920149b818ee",
                                "text": "„Kleine Steinhäuschen schmiegen sich um einen Berg, es gibt Kirchen und eine Burg und man kann den Ätna sehen.“"
                            },
                            {
                                "example_id": "847da05f-c7c1-46b9-b9ff-727cd88cc485",
                                "sense_id": "9e70dfec-e971-347f-bc08-920149b818ee",
                                "text": "„Ich erinnere mich vor allem an das hellere Licht, das weiße Steinhäuschen mit den Lavendelbüschen davor, in denen die Bienen summten und die Tag und Nacht betörend dufteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
