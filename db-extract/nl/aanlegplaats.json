                        ],
                        "form": "aanlegplaatsjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c5b29b7-9d6c-3de5-87bc-c9ce2c8db11a",
                        "entry_id": "797a6aba-59c5-3ee4-b189-019e005d2595",
                        "glosses": [
                            "plaats waar men een boot aanlegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec034722-4cf4-49e4-bcdb-1106e942a01a",
                                "sense_id": "3c5b29b7-9d6c-3de5-87bc-c9ce2c8db11a",
                                "text": "Om aan de geur van de natte en vieze Orpington in de auto te ontkomen, stapte Gunnar Barbarotti tijdens de zeven minuten durende overtocht uit, en zo kwam het dat hij heel duidelijk de man zag die bij de aanlegplaats van de pont in Fàrôsund stond te wachten om naar de overkant te gaan."
                            },
                            {
                                "example_id": "b1b6b58c-3d8f-4313-86b9-095cbd9b4e02",
                                "sense_id": "3c5b29b7-9d6c-3de5-87bc-c9ce2c8db11a",
                                "text": "Hij loopt met nonchalante passen achter de aanlegplaats langs, naar de fietsenrekken, zijn hand in de tas verborgen rond het ranke postuur van zijn geliefde, zijn troost, zijn rode, fruitige duivelin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac126113-08a8-4817-be24-1fba6c258a01",
                        "source_entry_id": "797a6aba-59c5-3ee4-b189-019e005d2595",
                        "source_sense_id": "3c5b29b7-9d6c-3de5-87bc-c9ce2c8db11a",
                        "target_lang_word": "Anlegestelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anlegestelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                        "entry_id": "c4b9a659-1c85-3f34-bc5e-9ac00d32d5de",
                                        "glosses": [
                                            "Stelle am Ufer, an der Schiffe anlegen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b56d5f-04de-4132-a4ab-c92a74487779",
                                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                                "text": "„Die Uferzone der Koblenzer Altstadt zieht mit den Anlegestellen für die Touristenschifffahrt, dem Reisebusparkplatz und der räumlichen Nähe zur Innenstadt hohe Touristenzahlen an.“"
                                            },
                                            {
                                                "example_id": "7f9555e1-a30d-4dea-b757-20288d84b697",
                                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                                "text": "„Praktischerweise sind die Anlegestellen direkt vor den bekanntesten Weinstuben, und so muß auf dem Heimweg nur ein kurzes Stück schwankenden Fußes bewältigt werden.“"
                                            },
                                            {
                                                "example_id": "232800b4-0b89-4997-ab18-28256d13e0e3",
                                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                                "text": "„Heute befindet sich die Anlegestelle der Boote mit den hölzernen Bootsschuppen am östlichen Ortsrand.“"
                                            },
                                            {
                                                "example_id": "fcc04252-0ed8-48cc-b660-5ab6954e9fdd",
                                                "sense_id": "6b12065d-6552-36f2-9e8e-503b08c4682f",
                                                "text": "„Nach dem Essen, als wir wieder auf der Höhe unserer Zurechnungsfähigkeit und unserer normalen Kommunikationsstärke angelangt sind, spazieren wir Richtung Anlegestelle, an unserem Schiff vorbei und winken unseren Mitreisenden zu, die das Sonnendeck bevölkern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "897ae2d8-8597-483e-bb0c-d7e0f2660e88",
                        "source_entry_id": "797a6aba-59c5-3ee4-b189-019e005d2595",
                        "source_sense_id": "3c5b29b7-9d6c-3de5-87bc-c9ce2c8db11a",
                        "target_lang_word": "jetty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jetty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03b10e23-96f8-31b4-afa0-a1f55fd82b4b",
                                        "entry_id": "e464d0e0-ab51-3e12-8bfe-c8697fdece56",
                                        "glosses": [
                                            "To jut out; to project."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a332cd4-03d6-4800-8e5c-71945c1fb2a3",
                                                "sense_id": "03b10e23-96f8-31b4-afa0-a1f55fd82b4b",
                                                "text": "ADENTELLARE […] It is properly to jetty out, or indent stones or timber of any unfinished building, that another may the easier be joyned unto, or that finished."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jetty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae54edb8-285d-3c55-a677-105bf1f04f83",
                                        "entry_id": "c10a7c61-e48c-31ce-a638-b128df4454ee",
                                        "glosses": [
                                            "A structure of wood or stone extended into the sea to influence the current or tide, or to protect a harbor or beach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7149514-677b-4763-bee0-4ed9d99e1bff",
                                                "sense_id": "ae54edb8-285d-3c55-a677-105bf1f04f83",
                                                "text": "[I]nſtead of demolition, they found conſtruction; for the French vvere then at vvork on the repair of the jettees. On the remonſtrances of General [Henry Seymour] Convvay, ſome parts of theſe jettees were immediately deſtroyed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b813637c-d971-3cb8-8076-14750450043d",
                                        "entry_id": "c10a7c61-e48c-31ce-a638-b128df4454ee",
                                        "glosses": [
                                            "A dock or wharf extending from the shore; a pier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78571ac0-41db-3c27-bb1b-d9c0e933cb5f",
                                        "entry_id": "c10a7c61-e48c-31ce-a638-b128df4454ee",
                                        "glosses": [
                                            "A part of a building that jets or projects beyond the rest, and overhangs the wall below."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jetty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "346ca2f6-2444-34e3-ae0f-f0f9df3cfa7d",
                                        "entry_id": "07e8ecaa-05ec-3092-a481-ac5a458f7da6",
                                        "glosses": [
                                            "Made of jet, or like jet in color."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbd97726-92ff-48c1-869b-dbaab1fccb14",
                                                "sense_id": "346ca2f6-2444-34e3-ae0f-f0f9df3cfa7d",
                                                "text": "Blacke are his colloures, blacke Pauillion,\nHis ſpeare, his ſhield, his horſe, his armour, plumes,\nAnd Ietty Feathers menace death and hell,\nUUithout reſpect of ſex, degree or age."
                                            },
                                            {
                                                "example_id": "8bf05adc-bda9-4551-8625-17c87a5283ad",
                                                "sense_id": "346ca2f6-2444-34e3-ae0f-f0f9df3cfa7d",
                                                "text": "those large black eyes were so blackly fringed, / The glossy rebels mocked the jetty stain [...]."
                                            },
                                            {
                                                "example_id": "c0ebfdc9-478b-4655-a5c5-f8f5e3b4a81a",
                                                "sense_id": "346ca2f6-2444-34e3-ae0f-f0f9df3cfa7d",
                                                "text": "But there was only Glorvina of the jetty ringlets with whom his intercourse was familiar, and this dashing young woman was not bent upon loving the Major, but rather on making the Major admire her […]"
                                            },
                                            {
                                                "example_id": "bb86d34b-e64a-49ca-8082-6cbcefa7e1d9",
                                                "sense_id": "346ca2f6-2444-34e3-ae0f-f0f9df3cfa7d",
                                                "text": "She raised her face veil […] showing two black eyes fringed with jetty lashes, whose glances were soft and languishing and whose perfect beauty was ever blandishing […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b505deb5-4946-44d0-8253-9f58f8a4d2ff",
                        "source_entry_id": "797a6aba-59c5-3ee4-b189-019e005d2595",
                        "source_sense_id": "3c5b29b7-9d6c-3de5-87bc-c9ce2c8db11a",
                        "target_lang_word": "embarcadère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embarcadère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca14776c-583a-387e-bdd1-7dee1348b485",
                                        "entry_id": "8ede8735-762b-3600-932f-de30becdaef7",
                                        "glosses": [
                                            "Espèce de cale, de jetée qui, du rivage, s’avance un peu dans la mer, et qu’on nomme aussi débarcadère, parce qu’elle sert au débarquement comme à l’embarquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ec6df5-b388-409c-9b80-310a8895b5c1",
                                                "sense_id": "ca14776c-583a-387e-bdd1-7dee1348b485",
                                                "text": "Tumultueux concours de monde aux abords de l’embarcadère, gens qui partent et gens qui regardent partir, recrutés parmi la population cosmopolite de Bakou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6340989d-e30c-36e6-853d-c38ec45467fc",
                                        "entry_id": "8ede8735-762b-3600-932f-de30becdaef7",
                                        "glosses": [
                                            "Lieu de départ d’un bâtiment ou d’un chemin de fer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb45ca1d-3ea7-4db3-b144-4aa1904b9de5",
                                                "sense_id": "6340989d-e30c-36e6-853d-c38ec45467fc",
                                                "text": "Je quittai l’embarcadère, remorqué par Bob Schultz et son yacht à moteur We Two, escorté par une vedette de la police américaine, et par le commodore du Morris Yacht Club dans son yacht à moteur."
                                            },
                                            {
                                                "example_id": "68d4519d-1da4-479e-8e32-170f1e7386f0",
                                                "sense_id": "6340989d-e30c-36e6-853d-c38ec45467fc",
                                                "text": "Le Havre, tout le monde le sait, est une ville de création beaucoup plus récente que Rouen, une ville claire, ouverte, aérée, une ville rectiligne. […]. Le Havre, c’est avant tout l’embarcadère de haute mer, la façade tournée vers le Nouveau Monde."
                                            },
                                            {
                                                "example_id": "459383bc-fc1e-42e3-a5b2-5a6cf4faaacc",
                                                "sense_id": "6340989d-e30c-36e6-853d-c38ec45467fc",
                                                "text": "Aujourd’hui, Monsieur lui fera voir la cathédrale... demain l’embarcadère du chemin de fer... et après-demain, bon voyage, monsieur Dumollet !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
