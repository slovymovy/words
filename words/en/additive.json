{
    "word_family": [
        "add",
        "addition",
        "additional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9fce847-4cba-3715-9bb2-cdd596d83385",
                    "sense_definition": "A substance added to another substance or product to improve its quality or change its properties.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many processed foods contain a chemical <w>additive</w> to preserve freshness.",
                            "target_lang_translations": {
                                "zh": "许多加工食品都含有化学<w>添加剂</w>以保持新鲜。"
                            }
                        },
                        {
                            "text": "The fuel <w>additive</w> helps the engine run more smoothly.",
                            "target_lang_translations": {
                                "zh": "这种燃油<w>添加剂</w>有助于发动机运行得更平稳。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "food additive",
                        "fuel additive"
                    ],
                    "target_lang_definitions": {
                        "zh": "为改善质量或改变性质而添加到另一种物质或产品中的物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "添加剂",
                                "target_lang_sense_clarification": "指加入食品、燃料等中以改善性能的物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847c8608-9a39-3ecf-a4af-d2191a80291d",
                    "sense_definition": "A word or phrase that adds information to a sentence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word also functions as an <w>additive</w> in this context.",
                            "target_lang_translations": {
                                "zh": "在这个语境下，这个词也起到了<w>附加词</w>的作用。"
                            }
                        },
                        {
                            "text": "Linguists classify this term as an <w>additive</w> because it introduces new information.",
                            "target_lang_translations": {
                                "zh": "语言学家将该术语归类为<w>附加词</w>，因为它引入了新的信息。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在句子中增加信息的词或短语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "附加词",
                                "target_lang_sense_clarification": "语言学中用于表示补充信息的词汇"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "40bba41d-55e3-3b44-a184-7f8a165bfcaa",
                    "sense_definition": "Relating to the process of adding or something that can be added.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total weight is calculated using an <w>additive</w> process.",
                            "target_lang_translations": {
                                "zh": "总重量是使用<w>累加</w>过程计算出来的。"
                            }
                        },
                        {
                            "text": "These two factors have an <w>additive</w> effect on the final result.",
                            "target_lang_translations": {
                                "zh": "这两个因素对最终结果有<w>累加</w>效应。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "additive effect",
                        "additive process"
                    ],
                    "target_lang_definitions": {
                        "zh": "与相加过程有关的，或可以被添加的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "相加的",
                                "target_lang_sense_clarification": "指涉及加法运算或累加过程的"
                            },
                            {
                                "target_lang_word": "累加的",
                                "target_lang_sense_clarification": "指效果可以叠加的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09ac7b1b-21f9-37ed-b7ea-b6183bc28381",
                    "sense_definition": "Describing a mathematical function that preserves the operation of addition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Linear maps are often <w>additive</w> by definition.",
                            "target_lang_translations": {
                                "zh": "根据定义，线性映射通常是<w>可加</w>的。"
                            }
                        },
                        {
                            "text": "The function is <w>additive</w> because the sum of the parts equals the whole.",
                            "target_lang_translations": {
                                "zh": "该函数是<w>可加</w>的，因为各部分之和等于整体。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "描述保持加法运算的数学函数。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可加的",
                                "target_lang_sense_clarification": "数学中指满足可加性条件的函数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5035e8ee-d123-3f12-8088-e7562c36ac98",
                    "sense_definition": "Relating to a mathematical group where the primary operation is addition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The set of integers forms an <w>additive</w> group.",
                            "target_lang_translations": {
                                "zh": "整数集构成一个<w>加法群</w>。"
                            }
                        },
                        {
                            "text": "We define the operation within this <w>additive</w> structure.",
                            "target_lang_translations": {
                                "zh": "我们在这种<w>加法</w>结构内定义该运算。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与以加法为主要运算的数学群有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加法群的",
                                "target_lang_sense_clarification": "代数中指以加法为群运算的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c85dd69-71bc-38e9-9dcc-1c9e5b9a8dc4",
                    "sense_definition": "Relating to a chemical reaction where atoms are added to a molecule.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>additive</w> reaction creates a new compound.",
                            "target_lang_translations": {
                                "zh": "这种<w>加成</w>反应生成了一种新的化合物。"
                            }
                        },
                        {
                            "text": "This specific <w>additive</w> process is common in organic synthesis.",
                            "target_lang_translations": {
                                "zh": "这种特定的<w>加成</w>过程在有机合成中很常见。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与原子被添加到分子中的化学反应有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加成的",
                                "target_lang_sense_clarification": "化学中指涉及加成反应的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeed50e9-bc17-3442-bd7f-2602200f450a",
                    "sense_definition": "Relating to genes that work together to influence a single physical trait.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Height is influenced by many <w>additive</w> genes.",
                            "target_lang_translations": {
                                "zh": "身高受许多<w>累加效应</w>基因的影响。"
                            }
                        },
                        {
                            "text": "The <w>additive</w> effect of these genes determines the final phenotype.",
                            "target_lang_translations": {
                                "zh": "这些基因的<w>累加效应</w>决定了最终的表型。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与共同影响单一物理性状的基因有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "累加效应的",
                                "target_lang_sense_clarification": "遗传学中指基因作用可以叠加的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}