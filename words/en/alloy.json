{
    "word_family": [
        "unalloyed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "353b5281-aeed-35ea-abe3-70e51512c50b",
                    "sense_definition": "A metal made by combining two or more metallic elements, especially to give greater strength or resistance to corrosion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metallurgy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Brass is a common <w>alloy</w> of copper and zinc used in many household items.",
                            "target_lang_translations": {
                                "ru": "Латунь — это распространенный <w>сплав</w> меди и цинка, используемый во многих предметах домашнего обихода."
                            }
                        },
                        {
                            "text": "The manufacturer used a lightweight aluminum <w>alloy</w> to build the bicycle frame.",
                            "target_lang_translations": {
                                "ru": "Производитель использовал легкий алюминиевый <w>сплав</w> для изготовления рамы велосипеда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aluminum alloy",
                        "lightweight alloy",
                        "metal alloy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металл, полученный путем объединения двух или более металлических элементов, особенно для придания большей прочности или коррозионной стойкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплав",
                                "target_lang_sense_clarification": "металлический"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f11e0ac-8b8e-3284-b4fb-07842f80b025",
                    "sense_definition": "An inferior metal mixed with a precious one, often to reduce the cost or change the properties.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metallurgy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler confirmed that the ring was made of pure gold without <w>alloy</w>.",
                            "target_lang_translations": {
                                "ru": "Ювелир подтвердил, что кольцо сделано из чистого золота без <w>примесей</w>."
                            }
                        },
                        {
                            "text": "Ancient coins often contained a significant amount of <w>alloy</w> to stretch the supply of silver.",
                            "target_lang_translations": {
                                "ru": "Древние монеты часто содержали значительное количество <w>примеси</w> неблагородных металлов, чтобы сэкономить запасы серебра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "without alloy",
                        "pure gold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неблагородный металл, смешанный с драгоценным, часто для снижения стоимости или изменения свойств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примесь",
                                "target_lang_sense_clarification": "в драгоценных металлах"
                            },
                            {
                                "target_lang_word": "лигатура",
                                "target_lang_sense_clarification": "в ювелирном деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abbad2ed-ced6-3060-ab54-4892775e5d09",
                    "sense_definition": "A mixture or combination of different things, often abstract qualities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film was a strange <w>alloy</w> of documentary realism and surrealist fantasy.",
                            "target_lang_translations": {
                                "ru": "Фильм представлял собой странный <w>сплав</w> документального реализма и сюрреалистической фантазии."
                            }
                        },
                        {
                            "text": "His personality was an <w>alloy</w> of journalism and show business that captivated the audience.",
                            "target_lang_translations": {
                                "ru": "Его личность была <w>сочетанием</w> журналистики и шоу-бизнеса, которое покорило аудиторию."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "alloy of journalism"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смесь или сочетание различных вещей, часто абстрактных качеств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплав",
                                "target_lang_sense_clarification": "переносное значение, сочетание"
                            },
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "разнородных элементов"
                            },
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "абстрактных качеств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56ddb9a1-982c-3b0c-9a0a-1b07e8764c6a",
                    "sense_definition": "Something added that lowers the value or purity of the whole; a taint or stain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of his departure was the only <w>alloy</w> to her otherwise perfect happiness.",
                            "target_lang_translations": {
                                "ru": "Известие о его отъезде было единственной <w>тенью</w>, омрачавшей ее в остальном идеальное счастье."
                            }
                        },
                        {
                            "text": "There is often some <w>alloy</w> of sadness even in the greatest moments of pleasure.",
                            "target_lang_translations": {
                                "ru": "Даже в моменты величайшего наслаждения часто присутствует некоторая <w>примесь</w> грусти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alloy of pleasure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то добавленное, что снижает ценность или чистоту целого; налет или пятно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примесь",
                                "target_lang_sense_clarification": "омрачающая что-либо"
                            },
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "омрачающее обстоятельство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc2a2068-8b11-3ce3-a72c-69fd7226cfa0",
                    "sense_definition": "To mix or combine different elements, especially metals.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician will <w>alloy</w> the two metals to create a more durable material.",
                            "target_lang_translations": {
                                "ru": "Техник <w>сплавит</w> два металла, чтобы создать более прочный материал."
                            }
                        },
                        {
                            "text": "They decided to <w>alloy</w> copper with tin to produce bronze for the statues.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>сплавить</w> медь с оловом, чтобы получить бронзу для статуй."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alloy metals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешивать или комбинировать различные элементы, особенно металлы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплавлять",
                                "target_lang_sense_clarification": "металлы"
                            },
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "в сплав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ad8c320-f946-380e-babe-6616cc11b22a",
                    "sense_definition": "To reduce the purity of a precious metal by mixing it with a less valuable substance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mint would <w>alloy</w> gold with silver to make the currency more durable.",
                            "target_lang_translations": {
                                "ru": "Монетный двор <w>разбавлял</w> золото серебром, чтобы сделать валюту более износостойкой."
                            }
                        },
                        {
                            "text": "It is common practice to <w>alloy</w> gold with copper for use in jewelry.",
                            "target_lang_translations": {
                                "ru": "В ювелирном деле обычной практикой является <w>сплавление</w> золота с медью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alloy gold with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижать чистоту драгоценного металла путем смешивания его с менее ценным веществом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легировать",
                                "target_lang_sense_clarification": "добавлять примеси в металл"
                            },
                            {
                                "target_lang_word": "разбавлять",
                                "target_lang_sense_clarification": "драгоценный металл"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f3a0ae4-7818-34fd-9ed6-0ebe82074e27",
                    "sense_definition": "To spoil or diminish the quality of something by adding something inferior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not want to <w>alloy</w> pleasure with misfortunes during his long-awaited vacation.",
                            "target_lang_translations": {
                                "ru": "Он не хотел <w>омрачать</w> удовольствие невзгодами во время своего долгожданного отпуска."
                            }
                        },
                        {
                            "text": "The bitter argument served to <w>alloy</w> the joy of their recent victory.",
                            "target_lang_translations": {
                                "ru": "Горький спор <w>омрачил</w> радость их недавней победы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alloy pleasure with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Портить или уменьшать качество чего-либо, добавляя что-то худшее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "омрачать",
                                "target_lang_sense_clarification": "радость или удовольствие"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "добавлением чего-то дурного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}