    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1ae64d7-dd4c-3ef9-8f62-49ff36ff07b7",
                    "sense_definition": "Composition odorante liquide ou solide utilisée pour la toilette et pour sentir bon.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cosmetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a reçu un flacon de <w>parfum</w> très réputé pour son anniversaire."
                        },
                        {
                            "text": "Il met un peu de <w>parfum</w> sur son cou chaque matin avant de sortir."
                        }
                    ],
                    "common_phrases": [
                        "flacon de parfum",
                        "bouteille de parfum",
                        "mettre du parfum"
                    ]
                },
                {
                    "sense_id": "65a75e30-ce47-3a23-a0de-336af8b63e8e",
                    "sense_definition": "Odeur aromatique agréable qui se dégage des fleurs, des plantes ou d'autres substances.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "senteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le doux <w>parfum</w> des roses embaume agréablement tout le jardin au printemps."
                        },
                        {
                            "text": "Ce savon artisanal laisse un léger <w>parfum</w> fruité sur la peau après la douche."
                        }
                    ],
                    "synonyms": [
                        "fragrance",
                        "odeur"
                    ],
                    "common_phrases": [
                        "doux parfum",
                        "parfum de fleur"
                    ]
                },
                {
                    "sense_id": "8ada4e26-2643-3c31-b131-8e99d4effded",
                    "sense_definition": "Arôme ou saveur distinctive d'une préparation alimentaire, en particulier d'une crème ou d'une glace.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "alimentaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur nous a demandé quel <w>parfum</w> nous préférions pour notre sorbet."
                        },
                        {
                            "text": "Les enfants ont choisi une glace au <w>parfum</w> de vanille et de chocolat."
                        }
                    ],
                    "synonyms": [
                        "arôme"
                    ],
                    "common_phrases": [
                        "parfum de glace",
                        "parfum vanille",
                        "parfum fraise"
                    ]
                },
                {
                    "sense_id": "54edb48d-7dcb-3573-9804-5565741240b1",
                    "sense_definition": "Atmosphère particulière, impression diffuse ou évocation subtile de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette affaire politique complexe dégageait un léger <w>parfum</w> de scandale dans la presse."
                        },
                        {
                            "text": "Un véritable <w>parfum</w> de liberté flottait dans les rues après les réformes."
                        }
                    ],
                    "synonyms": [
                        "odeur"
                    ],
                    "common_phrases": [
                        "parfum de scandale",
                        "parfum d'aventure"
                    ]
                },
                {
                    "sense_id": "8de2867d-7fab-3570-93de-c763a433244e",
                    "sense_definition": "Fumigation employée autrefois pour désinfecter et assainir les habitations contre la contagion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "desinfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les épidémies, les médecins allumaient un <w>parfum</w> puissant dans chaque pièce."
                        },
                        {
                            "text": "Ce vieux traité décrit la recette exacte du <w>parfum</w> utilisé pour assainir les maisons."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "utilisé lors des épidémies d'autrefois"
                        }
                    ]
                }
            ]
        }
    ]
}