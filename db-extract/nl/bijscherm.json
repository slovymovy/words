                        "examples": [
                            {
                                "example_id": "9d4930d9-d511-4c1e-9fad-e2ab34e2c419",
                                "sense_id": "fb363658-43c2-322f-81ae-05bc1063bff5",
                                "text": "Muisjes bestaan uit \"meermalen gesuikerde anijszaadjes', of beter gezegd anijsvruchtjes en omdat de vruchtjes vaak de bloemsteeltjes van de bijschermen nog bij zich dragen hebben ze, voor wie daar gevoelig voor is, wel iets van een muis. Het steeltje is dan als het ware de staart van de muis."
                            },
                            {
                                "example_id": "4eaa5611-094b-4232-b138-6c0c3d16faa2",
                                "sense_id": "fb363658-43c2-322f-81ae-05bc1063bff5",
                                "text": "Wat wordt verstaan onder `liervormig', een `gevorkt bijscherm' of iets simpels als een `hauw', blijft in woorden uitgelegd cryptisch. Zelfs de wetenschappelijke Heukels is in dit opzicht gebruikersvriendelijker dankzij glasheldere tekeningen van de verschillende bladvormen, bloeiwijzen en vruchtbeginsels."
                            },
                            {
                                "example_id": "5bfd3a73-c3fc-4b12-a5ab-d0036fa97acd",
                                "sense_id": "fb363658-43c2-322f-81ae-05bc1063bff5",
                                "text": "Het gevorkt bijscherm of tweetakkig scherm is een bloeiwijze, waarbij de hoofdas is afgesloten door een bloem. Hieronder staan twee zijtakken ingeplant, die weer afgesloten worden door een bloem. Op deze zijtakken staan weer twee zijtakken enz. De vertakkingen staan loodrecht op elkaar. Bij een gevorkt bijscherm staat de oudste bloem in het midden."
                            }
                        ]
                    }
