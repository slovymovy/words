                                "target_senses": [
                                    {
                                        "sense_id": "8b7794d4-8425-3b92-b1e9-2e4ad7f7dbf4",
                                        "entry_id": "66eff67b-f1f4-3f4a-9984-67126ea997d3",
                                        "glosses": [
                                            "A person who lives in a swampy area."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e00546c3-fe2d-33e9-b8b9-a41d07e2fcef",
                                        "entry_id": "66eff67b-f1f4-3f4a-9984-67126ea997d3",
                                        "glosses": [
                                            "A person who clears a road for lumberers in a forest or swamp."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "216840b0-cd35-4335-a80e-5cc53eac5c78",
                                                "sense_id": "e00546c3-fe2d-33e9-b8b9-a41d07e2fcef",
                                                "text": "In the latter part of winter, I hired with a lumberer – camped out, and wrought in the forest as a swamper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "103ed2e7-3753-3423-acc3-9d67ae1bf97f",
                                        "entry_id": "66eff67b-f1f4-3f4a-9984-67126ea997d3",
                                        "glosses": [
                                            "Someone or something that swamps or overwhelms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be5a074-091e-4961-9093-4287dcf951d4",
                                                "sense_id": "103ed2e7-3753-3423-acc3-9d67ae1bf97f",
                                                "text": "The Population Factor is a dissipator or swamper of the gain in per capita income and hence of the redressal of poverty to that degree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b99039a-9676-3a4c-9af5-5600d703d7c4",
                                        "entry_id": "66eff67b-f1f4-3f4a-9984-67126ea997d3",
                                        "glosses": [
                                            "A truck driver's assistant; an assistant to a driver of horses, mules or bullocks."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e02dc42-94b4-4cc5-9c15-5d45fc1a9693",
                                                "sense_id": "6b99039a-9676-3a4c-9af5-5600d703d7c4",
                                                "text": "To use such a brake on the front wagon, the driver stood up on the seat, letting the team follow the leaders, and threw his whole weight on the upper end of the bar, while the swamper braked the rear wagon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cceedb32-4cc5-3f20-afa1-028166cbadfc",
                                        "entry_id": "66eff67b-f1f4-3f4a-9984-67126ea997d3",
                                        "glosses": [
                                            "a person who travels by foot but has his belongings on a wagon."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a93d05c-ec15-4786-b216-cf1b763ff02b",
                                                "sense_id": "cceedb32-4cc5-3f20-afa1-028166cbadfc",
                                                "text": "On the road to the Diorite King, which is about 40 miles from Leonora, there was nothing much to see except a good many swampers. A “swamper” is a man tramping without his swag, which he entrusts to a teamster to bring on his waggon."
                                            },
                                            {
                                                "example_id": "822a9865-1937-4123-a7d4-82dd235d5ddd",
                                                "sense_id": "cceedb32-4cc5-3f20-afa1-028166cbadfc",
                                                "text": "He arrived at Western Australia the year after the discovery of gold at Coolgardie, and walked to the goldfields as a \"swamper\" – that is, he paid to have his belongings carried on a dray while he trudged along beside it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70196e02-28e4-322d-98f5-7eef67e62111",
                                        "entry_id": "66eff67b-f1f4-3f4a-9984-67126ea997d3",
                                        "glosses": [
                                            "A handyman or general employee in a liquor saloon; a cook's assistant."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad350cb-7a0e-485e-94a6-28f70ca9c96f",
                                                "sense_id": "70196e02-28e4-322d-98f5-7eef67e62111",
                                                "text": "The old swamper shifted his broom and held it between his elbow and his side while he held out his hand for the can."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c38b9689-ccb7-4b95-9a90-effa06849a2c",
                        "source_entry_id": "58ef75bf-3599-3cd9-97f1-bd264bb133f9",
                        "source_sense_id": "e7871074-fcf5-37a0-a6e8-fb23cc9e4dbc",
                        "source_sense_description": "Femme",
                        "target_lang_word": "busher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "busher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2861e187-3fe6-3e24-8ed7-c9870d187d2a",
                                        "entry_id": "70cae497-f99b-3785-9463-64ea69574f6a",
                                        "glosses": [
                                            "A major league baseball player who has recently come from a small league."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7584941-f9e4-41a6-a947-7c1d80fb6366",
                                                "sense_id": "2861e187-3fe6-3e24-8ed7-c9870d187d2a",
                                                "text": "He was talking about me all the time that day in Boston, standing with the bat boy, making cracks. That's all right but when he called me a busher in front of the whole Yank team and then challenged me, I had to fight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
