                "senses": [
                    {
                        "sense_id": "8078ece6-431b-3535-9f33-f8f720411e0d",
                        "entry_id": "da138453-d2b0-3992-9dd9-944582e78490",
                        "glosses": [
                            "с.-х. доение коров с помощью электрического доильного аппарата"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42258880-b26b-42b6-b1ab-786a896baa04",
                        "source_entry_id": "da138453-d2b0-3992-9dd9-944582e78490",
                        "source_sense_id": "8078ece6-431b-3535-9f33-f8f720411e0d",
                        "target_lang_word": "electric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddae64ab-d91f-33ee-b36c-4ddc395ca563",
                                        "entry_id": "f1f10e49-2d66-3d5f-9e90-6f86cc51afc1",
                                        "glosses": [
                                            "Of, relating to, produced by, operated with, or utilising electricity; electrical."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2558e8-da71-49d4-b89a-9651ad0738b5",
                                                "sense_id": "ddae64ab-d91f-33ee-b36c-4ddc395ca563",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            },
                                            {
                                                "example_id": "5d0f01d7-49dd-4d88-bc05-39590d353f12",
                                                "sense_id": "ddae64ab-d91f-33ee-b36c-4ddc395ca563",
                                                "text": "[Rural solar plant] schemes are of little help to industry or other heavy users of electricity. Nor is solar power yet as cheap as the grid. For all that, the rapid arrival of electric light to Indian villages is long overdue. When the national grid suffers its next huge outage, as it did in July 2012 when hundreds of millions were left in the dark, look for specks of light in the villages."
                                            },
                                            {
                                                "example_id": "d10e0d33-2bff-4fd9-adf7-d8a4be99dac4",
                                                "sense_id": "ddae64ab-d91f-33ee-b36c-4ddc395ca563",
                                                "text": "While Britain continues to argue about how to deliver affordable electrification and decarbonisation, Swiss railways have been 100% electric since the 1960s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e229eb-2441-3ab5-a4bc-83be278c64c2",
                                        "entry_id": "f1f10e49-2d66-3d5f-9e90-6f86cc51afc1",
                                        "glosses": [
                                            "Of or relating to an electronic version of a musical instrument that has an acoustic equivalent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "896c98a2-d31e-31bb-8df8-959ff45eb9a8",
                                        "entry_id": "f1f10e49-2d66-3d5f-9e90-6f86cc51afc1",
                                        "glosses": [
                                            "Emotionally thrilling; electrifying."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a293cfb4-1ba2-4ec0-88e0-1268783c6e50",
                                                "sense_id": "896c98a2-d31e-31bb-8df8-959ff45eb9a8",
                                                "text": "A glance from Beatrice—for nothing is so electric as the kindness of sympathy—stopped the tide of bewailings that were gushing forth. \"Poor child!\" muttered the housekeeper; \"but it's no good telling her.\""
                                            },
                                            {
                                                "example_id": "3e1c4055-7808-4f61-823a-8f750f970254",
                                                "sense_id": "896c98a2-d31e-31bb-8df8-959ff45eb9a8",
                                                "text": "And bold / Electric Pindar, quick as fear, / With race-dust on his cheeks, and clear / Slant startled eyes that seemed to hear // The chariot rounding the last goal, / to hurtle past it in his soul."
                                            },
                                            {
                                                "example_id": "3589c5fe-f708-4584-8038-9094b994909a",
                                                "sense_id": "896c98a2-d31e-31bb-8df8-959ff45eb9a8",
                                                "text": "I SING the Body electric; The armies of those I love engirth me, and I engirth them; They will not let me off till I go with them, respond to them, And discorrupt them, and charge them full with the charge of the Soul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "electric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c6272f1-8044-387d-9a4c-8447703c48c9",
                                        "entry_id": "80325656-c0e4-304b-9fe1-7bc8dbd3d4f5",
                                        "glosses": [
                                            "Electricity; the electricity supply."
                                        ],
                                        "tags": [
                                            "informal",
                                            "usually",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "232282b5-9495-4ad2-967a-12d8807c4601",
                                                "sense_id": "3c6272f1-8044-387d-9a4c-8447703c48c9",
                                                "text": "We had to sit in the dark because the electric was cut off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b77d3f1-45ad-35f9-86fe-b959a784e5e6",
                                        "entry_id": "80325656-c0e4-304b-9fe1-7bc8dbd3d4f5",
                                        "glosses": [
                                            "An electric powered version of something that was originally or is more commonly not electric.",
                                            "An electric car, locomotive, train etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dab29bf7-db78-41bf-9fd5-c9228aa825a9",
                                                "sense_id": "6b77d3f1-45ad-35f9-86fe-b959a784e5e6",
                                                "text": "Equally I can stand in a station like Lucerne in Switzerland, and watch with ill-concealed admiration the majestic entry of one of the latest Gotthard \"Ae 6/6\" electrics, packing 6,000 horsepower within its 60 ft. of length and 121 tons of weight, with its sleek dark green sides and handsome stainless steel bands and front wings."
                                            },
                                            {
                                                "example_id": "3cbec282-e6b6-47a2-a161-f956f6dee277",
                                                "sense_id": "6b77d3f1-45ad-35f9-86fe-b959a784e5e6",
                                                "text": "There were electric vehicles around, but four-wheel drive electrics were pretty damned rare, and the snow was deep enough to stop anything that didn't have a minimum of four big wheels spinning at all times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749b35c4-90d5-3c43-b21c-59ae9f9f29e2",
                                        "entry_id": "80325656-c0e4-304b-9fe1-7bc8dbd3d4f5",
                                        "glosses": [
                                            "An electric powered version of something that was originally or is more commonly not electric.",
                                            "An electric toothbrush."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aa47cf8-dcb6-4f03-9526-90e374e28590",
                                                "sense_id": "749b35c4-90d5-3c43-b21c-59ae9f9f29e2",
                                                "text": "The beautiful VIOlight bathroom unit takes up very little space (it's about the size of a cup), yet it holds up to 4 toothbrushes - even electrics!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccba234d-5df9-34c8-b7fe-a6180f948c9f",
                                        "entry_id": "80325656-c0e4-304b-9fe1-7bc8dbd3d4f5",
                                        "glosses": [
                                            "An electric powered version of something that was originally or is more commonly not electric.",
                                            "An electric typewriter."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7386b9b0-7f88-42e2-ae85-577f52ddb571",
                                                "sense_id": "ccba234d-5df9-34c8-b7fe-a6180f948c9f",
                                                "text": "Richard's old Olivetti electric had been put aside for the time being on top of one of the filing cabinets. “It serves the purpose,” Richard said. He nodded at the word processor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a032298-bda4-3b87-9e4b-ffdd68600f6b",
                                        "entry_id": "80325656-c0e4-304b-9fe1-7bc8dbd3d4f5",
                                        "glosses": [
                                            "A substance or object which can be electrified; an insulator or non-conductor, like amber or glass."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcebcce4-ef46-3e2e-aeec-6c9e69623748",
                                        "entry_id": "80325656-c0e4-304b-9fe1-7bc8dbd3d4f5",
                                        "glosses": [
                                            "Fencing with the use of a body wire, box, and related equipment to detect when a weapon has touched an opponent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
