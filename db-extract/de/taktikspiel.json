                ],
                "senses": [
                    {
                        "sense_id": "97835e29-9976-326a-82d0-40493fb7dd8e",
                        "entry_id": "e9566239-084b-38d2-8868-bad936c4f213",
                        "glosses": [
                            "Spielform, bei der ein systematisch geplantes, zielgerichtetes Vorgehen gefordert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904f4569-fd5a-489e-bb64-d42d0afc263e",
                                "sense_id": "97835e29-9976-326a-82d0-40493fb7dd8e",
                                "text": "„Stone Age Junior habe den Reiz des gleichnamigen, 2008 erschienenen Familienspiels in ein altersgerechtes Steinzeitabenteuer übertragen, es sei ein forderndes Taktikspiel für planvolle Sammler ab fünf Jahren, lobten sie.“"
                            },
                            {
                                "example_id": "b5cda38d-642c-4588-9026-25cad7a23e6b",
                                "sense_id": "97835e29-9976-326a-82d0-40493fb7dd8e",
                                "text": "„Bei Nintendo lag der Fokus ganz klar auf weniger martialisch inszenierten Neuheiten für die Switch-Konsole – darunterSplatoon 2, Super Mario Odyssey, Xenoblade Chronicles 2 sowie das rundenbasierte Taktikspiel Mario + Rabbids Kingdom Battle, welches in Zusammenarbeit mit Ubisoft entsteht.“"
                            },
                            {
                                "example_id": "50569242-7579-4993-81d4-83ac97f0fe9d",
                                "sense_id": "97835e29-9976-326a-82d0-40493fb7dd8e",
                                "text": "„Wenn der Preis solcher taktischer Spiele so hoch ist – und so scheint es diesmal bei der SPD der Fall zu sein – sollte die Politik in Zukunft auf solche Taktikspiele verzichten.“"
                            },
                            {
                                "example_id": "5b348d3c-1f78-43c5-ade9-3b1f300e4382",
                                "sense_id": "97835e29-9976-326a-82d0-40493fb7dd8e",
                                "text": "„Beim Taktikspiel ‚Tactix’ ändert sich die Lage auf dem Feld viel schneller, das Spiel ist flotter als Schach, dafür aber weniger variantenreich.“"
                            },
                            {
                                "example_id": "f64a2492-ea43-45b9-80e4-cf74f9775704",
                                "sense_id": "97835e29-9976-326a-82d0-40493fb7dd8e",
                                "text": "„Mit ‚Euphrat & Tigris’ ist ein klasse Strategie- und Taktikspiel herausgekommen, dessen Tiefe sich erst nach einigen Partien richtig erschließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
