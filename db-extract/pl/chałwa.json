                                        "entry_id": "3d21cd0a-43e2-3141-8fd7-7d5f34fb7d3b",
                                        "glosses": [
                                            "Confiserie orientale faite de farine, d'huile de sésame, de miel, de fruits et d'amandes ou de pistaches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97247c2c-e268-4b3e-8c49-858af48f774a",
                                                "sense_id": "64fbce05-2ee7-32b2-9e4d-14d1f0f1ca35",
                                                "text": "En un sens, il est le meilleur instituteur que nous ayons jamais engagé, ses élèves font des progrès prodigieux, leurs parents ne jurent que par lui, la mission n’a jamais reçu autant de cadeaux, des agneaux, des coqs, du halva, tout en l’honneur de Baskerville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07a3e752-3958-3732-bc08-571048fe87c2",
                                        "entry_id": "3d21cd0a-43e2-3141-8fd7-7d5f34fb7d3b",
                                        "glosses": [
                                            "Confiserie indienne à base de semoule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3490420-5b72-4809-9dd9-eb76d9c0330e",
                                                "sense_id": "07a3e752-3958-3732-bc08-571048fe87c2",
                                                "text": "… des abricots, de la confiture, et de l'halwa, un gâteau à la semoule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
