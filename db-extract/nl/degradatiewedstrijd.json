                                "example_id": "dabb9d64-4cb3-4555-b3bb-5184152f4b84",
                                "sense_id": "7f0abb1c-9818-3bb1-8191-8f92a57a0c02",
                                "text": "Het Nederlandse Davis Cup-team speelt de promotie-/degradatiewedstrijd tegen Kroatië in de Ziggo Dome in Amsterdam. De interland wordt in het weekeinde van 12, 13 en 14 september gespeeld."
                            },
                            {
                                "example_id": "bfd3c5e8-e307-4ba3-b4ab-f444b724d58b",
                                "sense_id": "7f0abb1c-9818-3bb1-8191-8f92a57a0c02",
                                "text": "De promotie/degradatiewedstrijd om een plaats in de wereldgroep zal nu op neutraal terrein of in België worden gespeeld."
                            },
                            {
                                "example_id": "bdb6ce89-8286-465c-b389-d83e684b990c",
                                "sense_id": "7f0abb1c-9818-3bb1-8191-8f92a57a0c02",
                                "text": "Het werd een degradatiewedstrijd met twee gezichten. De Graafschap had voor rust de overhand en nadat Nenad Sreckovic en Vito Wormgoor kansjes gemist hadden, maakte Rydell Poepon na een steekpass van Yuri Rose 1-0."
                            }
                        ]
