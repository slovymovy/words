                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My heart <w>fluttered</w> with excitement before the big performance.",
                            "target_lang_translations": {
                                "cs": "Před velkým vystoupením se mi srdce <w>rozbušilo</w> vzrušením."
                            }
                        },
                        {
                            "text": "He was <w>fluttering</w> with anxiety while waiting for the test results.",
                            "target_lang_translations": {
                                "cs": "Při čekání na výsledky testů se <w>chvěl</w> úzkostí."
