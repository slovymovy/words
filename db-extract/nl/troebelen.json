        "nl-extract.jsonl": [
            {
                "entry_id": "22d9e564-0783-340c-af03-34e25b760a2d",
                "word": "troebelen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d677542-8dc2-3d5b-acdc-07e8006b3fec",
                        "entry_id": "22d9e564-0783-340c-af03-34e25b760a2d",
                        "glosses": [
                            "onrust"
                        ],
                        "tags": [
                            "politieke"
                        ],
                        "examples": [
                            {
                                "example_id": "d276a47d-033a-416f-a368-ffbdde2ab95f",
                                "sense_id": "5d677542-8dc2-3d5b-acdc-07e8006b3fec",
                                "text": "Turkse troebelen: Toeristen lijken het doelwit van aanslagen in Antalya, Marmaris en Istanboel. Maar ze verlaten Turkije niet in paniek. Sommigen weten nauwelijks wat er is gebeurd, anderen calculeren nuchter de risico’s in: minibusjes kun je beter mijden."
                            },
                            {
                                "example_id": "bce9ab97-f153-46cf-a8c0-d69a235f0b34",
                                "sense_id": "5d677542-8dc2-3d5b-acdc-07e8006b3fec",
                                "text": "Vlek en Wassink werken de plannen nu verder uit. \"Na alle troebelen rond de vorming van de gemeente is dit een mooie gelegenheid Dinkelland op de kaart te zetten\", meent Vlek."
                            },
                            {
                                "example_id": "5c420808-98a8-4efa-85cd-c023efd4177a",
                                "sense_id": "5d677542-8dc2-3d5b-acdc-07e8006b3fec",
                                "text": "Probleem van Hans is dat hij - bij wijze van spreken - de ene avond Heineken drinkt, de volgende avond Grolsch en avond drie De Koninck, elke morgen met barstende koppijn wakker wordt en iedere keer het merk bier de schuld geeft van zijn kater. Dat ie - nogmaals, het is overdrachtelijk - een probleemdrinker is, komt niet in hem op. Zelfde verhaal voor Gijs Stavinga, ooit ambtenaar bij de gemeente Enschede en verstokt SP’er. In zijn enigszins verward mailtje verwijt hij de Tweede Kamerfractie van de PvdA de troebelen in de Enschedese fractie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a348e486-365c-4c23-a4ac-16b843f5c283",
                        "source_entry_id": "22d9e564-0783-340c-af03-34e25b760a2d",
                        "source_sense_id": "5d677542-8dc2-3d5b-acdc-07e8006b3fec",
                        "source_sense_description": "(politieke) onrust",
                        "target_lang_word": "commotion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commotion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69155af0-99ea-3189-941e-b1de5c4cb90f",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "A state of turbulent motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "An agitated disturbance or a hubbub."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ccea11d-9845-4aef-8f7d-514f88bf72dc",
                                                "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                                "text": "It would seem as if calm were necessary to convulsion; for the tranquillity of the last few months was again to be disturbed by political commotion."
                                            },
                                            {
                                                "example_id": "50db1e12-5c7c-40f7-b23d-8aa572d32787",
                                                "sense_id": "4017d01a-ce2c-3474-ad90-0693b13c8ca9",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "530ed46a-d712-32d8-9006-e1fefa7c1e05",
                                        "entry_id": "4128d331-ca18-368c-926b-0f69dd5bc716",
                                        "glosses": [
                                            "Sexual excitement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0ac015a-2f1c-43ff-9810-b1fa460f2008",
                                                "sense_id": "530ed46a-d712-32d8-9006-e1fefa7c1e05",
                                                "text": "and now, glancing my eyes towards that part of his dress which cover'd the essential object of enjoyment, I plainly discover'd the swell and commotion there",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9db993bb-a5b4-4e7c-88ce-7414808108ce",
                        "source_entry_id": "22d9e564-0783-340c-af03-34e25b760a2d",
