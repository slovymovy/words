                    {
                        "sense_id": "dd515a50-09c4-355f-98f0-a2dcfcda3fb5",
                        "entry_id": "abfc54e1-dfd8-3431-8038-869b04847df9",
                        "glosses": [
                            "Ce que représente un signifiant, le concept. On note généralement le signifiant en italique et le signifié entre guillemets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c590a69f-e92e-4d3f-8949-3dc882bf5ba7",
                                "sense_id": "dd515a50-09c4-355f-98f0-a2dcfcda3fb5",
                                "text": "Les unités significatives sont généralement désignées sous le nom de signes, leur sens étant dit signifié et leur forme parlée signifiant; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5eda236a-93b5-4ba3-81b1-9933acd0ea1f",
                        "source_entry_id": "abfc54e1-dfd8-3431-8038-869b04847df9",
                        "source_sense_id": "dd515a50-09c4-355f-98f0-a2dcfcda3fb5",
                        "target_lang_word": "signified",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
