                "senses": [
                    {
                        "sense_id": "546f3e91-32ca-3869-a077-871c39996dbd",
                        "entry_id": "519d651b-452d-316e-b755-bbe93fb41af1",
                        "glosses": [
                            "Verhaltensweise während des Abbiegevorgangs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f67cff-4e84-4364-bd9e-45ec03deaf63",
                                "sense_id": "546f3e91-32ca-3869-a077-871c39996dbd",
                                "text": "„Ein richtiges Abbiegeverhalten im Straßenverkehr erfordert vor und während des Abbiegevorgangs die Einhaltung festgelegter Regelungen.“"
                            },
                            {
                                "example_id": "8e8db1d2-375e-4bee-ac32-3933422d4ba3",
                                "sense_id": "546f3e91-32ca-3869-a077-871c39996dbd",
                                "text": "„Während der Grundschule legen sie in der Regel eine Fahrradprüfung ab, dann aber vergehen bis zum Führerschein oft zehn Jahre, ehe sie wieder mit Vorfahrtsregeln oder Abbiegeverhalten konfrontiert werden.“"
                            },
                            {
                                "example_id": "c9a04beb-b2b2-4012-8247-4905e165d3a9",
                                "sense_id": "546f3e91-32ca-3869-a077-871c39996dbd",
                                "text": "„Besonders das Beachten von roten Ampeln, das Verbot des Fahrens auf Gehwegen seitens der Radler und das Abbiegeverhalten von Autofahrern sowie die Ahndung des Parkens auf Radwegen sind Schwerpunkte der Kontrolltätigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
