                "senses": [
                    {
                        "sense_id": "7a4c2d08-4e0c-3477-8216-4bb6474fc7d8",
                        "entry_id": "5f9e97d8-28c7-3de1-a493-a0af04cfaa4a",
                        "glosses": [
                            "Vertrag, in dem die Bedingungen für die Vergabe einer Lizenz geregelt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523364e6-63a2-4b06-908e-b3188aa6fa9b",
                                "sense_id": "7a4c2d08-4e0c-3477-8216-4bb6474fc7d8",
                                "text": "„Lizenzgebühren bezeichnen die aus dem Lizenzvertrag zu zahlenden Entgelte für die Verwertung bes. von Lizenzen und Patenten.“"
                            },
                            {
                                "example_id": "4f7a4475-6bb3-41b5-8425-1ded05b00a56",
                                "sense_id": "7a4c2d08-4e0c-3477-8216-4bb6474fc7d8",
                                "text": "„YouTube und die Rechteverwertungsgesellschaft Gema haben sich nach langem Streit auf einen Lizenzvertrag geeinigt.“"
                            },
                            {
                                "example_id": "ce247c7d-5e1d-4756-b6ed-d1dd75efb37d",
                                "sense_id": "7a4c2d08-4e0c-3477-8216-4bb6474fc7d8",
                                "text": "„Facebook und die Universal Music Group haben einen Lizenzvertrag abgeschlossen und wollen damit ein \"dynamisches Modell der Zusammenarbeit zwischen Musikunternehmen und sozialen Plattformen kreieren, um die Interessen von Musikern und Liedtextern voranzubringen und gleichzeitig das soziale Musikerlebnis für Fans zu verbessern.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
