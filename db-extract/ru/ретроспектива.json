                                        "entry_id": "96382ed1-eaff-30c7-99a8-6396e196bb9e",
                                        "glosses": [
                                            "Ausstellung, die einen Überblick über das Schaffen (eine Schaffensphase, einen bestimmten Aspekt, das Gesamtwerk) eines Künstlers vermittelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4be5569-9feb-40e0-aa4b-adfecb720f9b",
                                                "sense_id": "f1a38087-c01a-398e-a33c-340730b1569e",
                                                "text": "„Die Retrospektive ist mit fast 100 Gemälden von über 40 Leihgebern aus der ganzen Welt bestückt.“"
                                            }
