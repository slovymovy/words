                                        "examples": [
                                            {
                                                "example_id": "12191fd2-4d1c-4898-a784-f8c5ca06c920",
                                                "sense_id": "4d416e48-b8e1-3852-9979-2376244d964b",
                                                "text": "So, little by little, youth loosens the hard carapace of confining custom their elders have built over the human heart."
                                            },
                                            {
                                                "example_id": "e6f07aa1-69f0-4394-a2e7-8c6f06b364c1",
                                                "sense_id": "4d416e48-b8e1-3852-9979-2376244d964b",
                                                "text": "This is all a massive failure of science to pierce the carapace of public ignorance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
