                "senses": [
                    {
                        "sense_id": "087376ac-5e88-39b5-8179-0783195d868f",
                        "entry_id": "0579db34-8f44-39f5-bc77-f48192cf6805",
                        "glosses": [
                            "wirtschaftliches Abkommen, das von mindestens 2 Staaten oder Unternehmen unterzeichnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee18a90-cedd-42d9-834a-ebca0eac4c6a",
                                "sense_id": "087376ac-5e88-39b5-8179-0783195d868f",
                                "text": "„Ein Handelsvertrag zwischen Venedig und Byzanz sichert der ehemals byzantinischen Hafenstadt die Unabhängigkeit.“"
                            },
                            {
                                "example_id": "f84ee6d5-63ef-4bc1-98da-ab04042c4eb0",
                                "sense_id": "087376ac-5e88-39b5-8179-0783195d868f",
                                "text": "„Zwischen dem Deutschen Reich und dem mittelamerikanischen Staat Nicaragua wird nach längeren Verhandlungen ein Handelsvertrag abgeschlossen.“"
                            },
                            {
                                "example_id": "6f0ea022-cabb-4058-b6fe-6098af9ea353",
                                "sense_id": "087376ac-5e88-39b5-8179-0783195d868f",
                                "text": "„Dafür erhalten sie sogar die Vollmacht, im Namen des britischen Staates Handelsverträge abzuschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
