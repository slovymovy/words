                    {
                        "sense_id": "8e506faf-e277-33f8-993a-61993082cdad",
                        "entry_id": "8cefd250-cb40-3700-acef-61de00594b2d",
                        "glosses": [
                            "Membre de l’association d’étudiants de Suisse nommée Zofingue."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "f1590f21-bd6c-469d-a845-6c9bf2731919",
                                "sense_id": "8e506faf-e277-33f8-993a-61993082cdad",
                                "text": "Il y a Edmond Gilliard, né en 1875, licencié ès lettres, zofingien, ami de Ramuz et d’A. Cingria."
                            },
                            {
                                "example_id": "1e150591-c720-4cdd-aed2-e4209401d95b",
                                "sense_id": "8e506faf-e277-33f8-993a-61993082cdad",
                                "text": "Avec la défaite du Sonderbund en 1847, la voie s’ouvrit pour créer un Etat confédéral pour lequel le Zofingien Johann Konrad Kern rédigea le projet de constitution."
                            },
                            {
                                "example_id": "639ba322-0a0f-428c-bc69-0b10e2d38441",
                                "sense_id": "8e506faf-e277-33f8-993a-61993082cdad",
                                "text": "On s’y faisait des relations précieuses et il était de notoriété publique qu’un Zofingien, grâce à l’appui des anciens, ne pouvait manquer, les diplômes nécessaires obtenus, de faire carrière …."
                            }
                        ]
                    }
