{
    "word_family": [
        "continu",
        "continuïteit",
        "continuum"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9ca7f95-96f7-3f49-ab63-bc76b72616d5",
                    "sense_definition": "Iets dat al bezig is, laten doorgaan of voortzetten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voortzetten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het bedrijf van zijn vader over te nemen, <w>continueert</w> hij een oude familietraditie.",
                            "target_lang_translations": {
                                "zh": "通过接管他父亲的公司，他<w>延续</w>了一项古老的家族传统。"
                            }
                        },
                        {
                            "text": "De directie besloot om het project na de zomer te <w>continueren</w>.",
                            "target_lang_translations": {
                                "zh": "管理层决定在夏天之后<w>继续</w>该项目。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使正在进行的事物继续下去。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "继续",
                                "target_lang_sense_clarification": "指动作或状态的延续。"
                            },
                            {
                                "target_lang_word": "延续",
                                "target_lang_sense_clarification": "指事物在时间上的延长。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c03a4d40-a4c3-3de7-86c3-793e57d6cd2e",
                    "sense_definition": "Een juridische procedure of rechtszaak uitstellen naar een latere datum.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uitstellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter besloot de zitting te <w>continueren</w> tot volgende maand vanwege ontbrekend bewijs.",
                            "target_lang_translations": {
                                "zh": "由于证据不足，法官决定将庭审<w>延期</w>至下个月。"
                            }
                        },
                        {
                            "text": "Vanwege de afwezigheid van de getuige werd de zaak <w>gecontinueerd</w>.",
                            "target_lang_translations": {
                                "zh": "由于证人缺席，案件被<w>推迟</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in juridische context."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将法律程序或诉讼推迟到以后的日期。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "延期",
                                "target_lang_sense_clarification": "指将预定的时间推迟。"
                            },
                            {
                                "target_lang_word": "推迟",
                                "target_lang_sense_clarification": "指把时间向后挪。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}