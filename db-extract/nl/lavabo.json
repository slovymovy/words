                "senses": [
                    {
                        "sense_id": "2021f3d2-5288-3c7d-a5d5-93871bc9a937",
                        "entry_id": "47c02152-c4d7-30e5-9201-1f4fe1b6f733",
                        "glosses": [
                            "gebed door de priester met een rituele handwassing als onderdeel van de Latijnse mis"
                        ],
                        "tags": [
                            "rooms-katholiek"
                        ],
                        "examples": [
                            {
                                "example_id": "ada24ca1-30f4-4a7e-9e97-e12070a78470",
                                "sense_id": "2021f3d2-5288-3c7d-a5d5-93871bc9a937",
                                "text": "De priester aan 't altaar echter heeft ook nog de collecten, het epistel en het graduale. Na het evangelie leest hij het offertorium, het lavabo en de secreten, den canon en het memento, en komt zoo tot de elevatie of opheffing (van de Hostie en de Kelk). Met het Pater Noster en het Agnus Dei, de benedictie en het St.-Jans-evangelie sluit hij de offerande."
                            }
                        ]
                    }
