                "senses": [
                    {
                        "sense_id": "f89d0588-34da-3ea7-89e8-20cadbc201a9",
                        "entry_id": "52dab235-7b78-3d64-aedf-73e5dd54132f",
                        "glosses": [
                            "brennbares Gas, das in Hochöfen entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e79f3989-0397-49bd-ba48-f38551be0073",
                                "sense_id": "f89d0588-34da-3ea7-89e8-20cadbc201a9",
                                "text": "Vor der Verbrennung muss das Gichtgas gereinigt werden."
                            },
                            {
                                "example_id": "f14eaa3a-fdf8-4df7-81f0-ccd4e63a2429",
                                "sense_id": "f89d0588-34da-3ea7-89e8-20cadbc201a9",
                                "text": "„Das Gichtgas war nach den bisherigen Ermittlungen der Kriminalpolizei aus einer defekten Stoffbuchse ausgetreten, mit deren Hilfe am Hochofen ein Rohr abgedichtet wird.“"
                            },
                            {
                                "example_id": "48707c5f-be32-4211-ab90-4881681ffcbd",
                                "sense_id": "f89d0588-34da-3ea7-89e8-20cadbc201a9",
                                "text": "„Das als Gichtgas bezeichnete Gasgemisch strömt in den feuerfest ausgemauerten Winderhitzer. Dort werden die brennbaren Bestandteile des Gichtgases wie restliches Kohlenstoffmonooxid und Wasserstoff verbrannt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d6b17cc-041f-4872-907c-1cb58db5ce1e",
