                ],
                "senses": [
                    {
                        "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                        "entry_id": "10c626c9-48eb-3838-ae40-4a915d87dd1a",
                        "glosses": [
                            "dasjenige Wort, auf das sich ein Pronomen oder ein Attribut bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "818b0fbe-b560-4638-906e-761f5beeab64",
                                "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                                "text": "Im Beispiel „der kleine Bach“ ist „Bach“ das Beziehungswort zu dem Adjektivattribut „kleine“."
                            },
                            {
                                "example_id": "9652e132-d82f-4300-9d7b-dd6ec588b5ef",
                                "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                                "text": "Im Beispiel „Karl der Große“ ist „Karl“ das Beziehungswort zu der Apposition „der Große“."
                            },
                            {
                                "example_id": "d760c9c7-69cc-4afc-8f86-3366a9d9a904",
                                "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                                "text": "In dem Satz „Ich liebe den Baum vor unserem Haus, er spendet Schatten und Sauerstoff“ ist \"Baum\" das Beziehungswort zum Personalpronomen „er“."
                            },
                            {
                                "example_id": "185c7cdc-858c-48ae-ac70-ec8b800cc71e",
                                "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                                "text": "In dem Satz „Ein Junge, der zu spät kommt, verliert“ ist \"Junge\" das Beziehungswort zum Relativsatz „der zu spät kommt“ beziehungsweise zum Relativpronomen „der“."
                            },
                            {
                                "example_id": "cf1ebe2e-56f2-4b87-861e-974a5b7d947a",
                                "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                                "text": "„Relativsätze werden im Allgemeinen direkt hinter das Beziehungswort gestellt, auf das sie sich beziehen.“"
                            },
                            {
                                "example_id": "c2d5f385-eb0b-4e3b-b66b-d947165fd45b",
                                "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                                "text": "„Adjektivattribute werden dem Beziehungswort im Deutschen normalerweise vorangestellt und flektiert. Als Attribute von Substantiven kongruieren sie in diesem Fall in Genus, Kasus und Numerus mit dem Beziehungswort.“"
                            },
                            {
                                "example_id": "b0d7f6ef-bcb9-4605-a51b-a78527fd6267",
                                "sense_id": "6844b7e1-3713-38e6-9773-48266d74ac0d",
                                "text": "Erklärung des rhetorischen Stilmittels der Enallage/Hypallage: „Das Adjektivattribut wird nicht dem Beziehungswort zugeordnet, sondern dem vorangehenden regierenden Substantiv, zu dem es logisch nicht gehört. Z. B.: »Im grünen Schatten des Holunders« (Trakl).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
