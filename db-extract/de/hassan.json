                ],
                "senses": [
                    {
                        "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                        "entry_id": "a80e8a9b-477c-32d2-b489-3a0274eb134e",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ceab11-b574-4196-b986-12d5af1d1d2d",
                                "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                                "text": "Frau Hassan ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e3c1ea1a-6bf9-4738-b53e-3ef0892ba859",
                                "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                                "text": "Herr Hassan wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2ec2b6af-b04c-4ea3-ada5-ecb0048480e0",
                                "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                                "text": "Die Hassans fliegen heute nach New York."
                            },
                            {
                                "example_id": "9dc27a83-cf5e-4f8e-8cbc-dec376be9e5a",
                                "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                                "text": "Der Hassan trägt nie die Schals, die die Hassan ihm strickt."
                            },
                            {
                                "example_id": "950ec03d-c35e-418a-a3f3-332925850f18",
                                "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hassan kommt, geht der Herr Hassan.“"
                            },
                            {
                                "example_id": "a072f296-2f4f-4e43-a5ec-c606addc8b9e",
                                "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                                "text": "Hassan kommt und geht."
                            },
                            {
                                "example_id": "f7028b5a-a48e-4d3d-a30b-99c79103c80c",
                                "sense_id": "09675a3e-af19-3013-bca6-9d95dd733a10",
                                "text": "Hassans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
