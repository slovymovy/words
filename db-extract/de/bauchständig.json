                        "glosses": [
                            "sich am Bauch befindend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4393334-3c41-44b1-9a07-79349503674a",
                                "sense_id": "de8efe9c-b0c7-3b59-9567-c9096f34723f",
                                "text": "„Rennmäuse markieren ihr Territorium mit einem Sekret aus ihren bauchständigen Duftdrüsen.“"
                            },
                            {
                                "example_id": "f6b89a29-747c-4c82-95d5-a6e95d6e558e",
                                "sense_id": "de8efe9c-b0c7-3b59-9567-c9096f34723f",
                                "text": "„Barschlachse ähneln aufgrund der Stachelstrahlen in den Flossen, den oft vorhandenen Kammschuppen und der Schädelausbildung den Barschartigen Fischen, doch liegen die Bauchflossen bauchständig […].“"
                            }
                        ],
