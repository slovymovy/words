                                    {
                                        "sense_id": "2dc8c4b8-a0d7-3e8b-bdbf-947a5f4c80ff",
                                        "entry_id": "7ff78bc9-7d93-3127-ad75-9fdd211e60ec",
                                        "glosses": [
                                            "der westliche Teil Europas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd11940-9bdd-4b9e-81e8-ca2e57b52c9b",
                                                "sense_id": "2dc8c4b8-a0d7-3e8b-bdbf-947a5f4c80ff",
                                                "text": "Frankreich, Belgien und die Niederlande sind Staaten in Westeuropa."
                                            },
                                            {
                                                "example_id": "e29ce2fe-3411-4499-b78e-b3a05b8ebae7",
                                                "sense_id": "2dc8c4b8-a0d7-3e8b-bdbf-947a5f4c80ff",
                                                "text": "„Die größte Unruhe entstand jedoch um die Mitte des 5. Jahrhunderts, als die Hunnen in Westeuropa erschienen.“"
                                            },
                                            {
                                                "example_id": "bf05b445-8d11-493c-bcc1-7968e54f2f66",
                                                "sense_id": "2dc8c4b8-a0d7-3e8b-bdbf-947a5f4c80ff",
                                                "text": "„Dies war auch für das europäische Festland von Bedeutung, denn die christliche Mission Westeuropas erfolgte in der Nachfolge Patricks durch irische Mönche!“"
                                            },
                                            {
                                                "example_id": "ef1c8359-f6a5-4537-b53b-b777d23bc435",
                                                "sense_id": "2dc8c4b8-a0d7-3e8b-bdbf-947a5f4c80ff",
                                                "text": "Der Golfstrom ist wichtig für das milde Klima in Westeuropa. Nun deutet eine Studie darauf hin, dass sich die Strömung abschwächt. Ursache sei der Klimawandel, vermuten die Forscher."
                                            },
                                            {
                                                "example_id": "983f7ccd-5d92-4bef-8ddc-cf428811584e",
                                                "sense_id": "2dc8c4b8-a0d7-3e8b-bdbf-947a5f4c80ff",
                                                "text": "„Im 18. Jahrhundert begannen sich die Sprachverhältnisse bei den aschkenasischen Juden in Mittel- und Westeuropa grundlegend zu verändern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
