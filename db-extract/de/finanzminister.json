                ],
                "senses": [
                    {
                        "sense_id": "53b7f681-bbc4-3ec9-a701-ebde354bdab8",
                        "entry_id": "cd0d9fdb-7578-330d-8b93-7e63fb50fc91",
                        "glosses": [
                            "Leiter eines Finanzministeriums, der Verantwortliche für die Verwaltung der Finanzen eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e48a8a30-612f-4ca5-9e9d-b786b7a5af48",
                                "sense_id": "53b7f681-bbc4-3ec9-a701-ebde354bdab8",
                                "text": "Schon zuvor - bei der Debatte um die Verlegung des Nationalfeiertags - hatte sich der Regierungschef vom Finanzminister falsch informiert gefühlt."
                            },
                            {
                                "example_id": "1a6710e3-3c7d-49c2-9c39-b819c05044f5",
                                "sense_id": "53b7f681-bbc4-3ec9-a701-ebde354bdab8",
                                "text": "Vor dem G-20-Treffen hat Finanzminister Tim Geithner ein nationales Regulierungsziel vorgegeben, das dem deutschen in seiner Radikalität ähnelt: Konzerne, deren Schieflage und ungeordnete Pleite das ganze Wirtschaftssystem gefährden, könnten dann verstaatlicht werden."
                            },
                            {
                                "example_id": "ee598270-3c9f-4c5b-9987-20a316142862",
                                "sense_id": "53b7f681-bbc4-3ec9-a701-ebde354bdab8",
                                "text": "„Regierungschefs und Finanzminister setzten im Rahmen von G7 und G20 ihre Telefonkontakte fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
