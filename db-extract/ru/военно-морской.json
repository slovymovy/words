                    {
                        "form_id": "d159f562-1766-4489-872b-df8fd2a71468",
                        "entry_id": "cf1f7c39-59ba-3ee7-b394-f68b87ce1c60",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "воѐнно-морски́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4f4b341-7278-32cc-a817-e4aab11a4d9d",
                        "entry_id": "cf1f7c39-59ba-3ee7-b394-f68b87ce1c60",
                        "glosses": [
                            "относящийся к вооруженным силам, действующим на море, к ведению войны на море"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68dbad37-ef9f-4b1e-babb-b73b2e3fbf96",
                                "sense_id": "a4f4b341-7278-32cc-a817-e4aab11a4d9d",
                                "text": "Вторым по значимости является военно-морской флот, а замыкают тройку приоритетов силы общего назначения."
                            },
                            {
                                "example_id": "a8c10075-cbb5-48b1-821f-08f38d6780a9",
                                "sense_id": "a4f4b341-7278-32cc-a817-e4aab11a4d9d",
                                "text": "Практикуется направление в страны, поставляющие военно-морскую технику, экипажей и команд в полном составе для освоения ее на месте."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64d8b0a3-f9fd-434e-baaf-c86ba9eb0b50",
                        "source_entry_id": "cf1f7c39-59ba-3ee7-b394-f68b87ce1c60",
                        "source_sense_id": "a4f4b341-7278-32cc-a817-e4aab11a4d9d",
                        "target_lang_word": "naval",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naval",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dae69644-c9a4-36b7-9499-beff3ae74410",
                                        "entry_id": "5bae0660-4e6f-375b-a712-4d6e69fdeace",
                                        "glosses": [
                                            "Of or relating to a navy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16beb6db-fd93-4653-8e1c-6b3a99726067",
                                                "sense_id": "dae69644-c9a4-36b7-9499-beff3ae74410",
                                                "text": "Conditions were horrendous aboard most British naval vessels at the time. Scurvy and other diseases ran rampant, killing more seamen each year than all other causes combined, including combat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4df9b4a-9981-3112-aecb-5ee680df177f",
                                        "entry_id": "5bae0660-4e6f-375b-a712-4d6e69fdeace",
                                        "glosses": [
                                            "Of or relating to ships in general."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
