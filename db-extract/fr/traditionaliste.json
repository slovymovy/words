                                        "sense_id": "7e3ac81c-9634-3976-9dc4-422b1a5f7417",
                                        "entry_id": "c0b7a9a1-dfb1-39de-a9d9-714c2216f554",
                                        "glosses": [
                                            "che concerne una o più tradizioni verificate e confermate come reali e vere"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e85d1daa-9a1b-39c1-af4f-52cd88df7460",
                                        "entry_id": "c0b7a9a1-dfb1-39de-a9d9-714c2216f554",
                                        "glosses": [
                                            "che non è “sofisticato” ma si attiene alla verità quando accertata in modo incontrastato"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tradizionalista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "532325bd-670c-3809-8acc-04f811e06415",
                                        "entry_id": "4adbb086-9c9f-3742-8256-7aa57daf9735",
                                        "glosses": [
                                            "chi è legato al passato"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06d69bb2-bb17-315b-9dac-28326df27af8",
                                        "entry_id": "4adbb086-9c9f-3742-8256-7aa57daf9735",
                                        "glosses": [
                                            "chi ama le origini più “genuine” e le considera più aderenti al vero"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2cac867-b88b-420a-8eeb-52ee33c9755f",
                                                "sense_id": "06d69bb2-bb17-315b-9dac-28326df27af8",
                                                "text": "un tradizionalista vive quasi ogni esperienza come rinnovamento delle cose nella loro assidua costanza"
                                            },
                                            {
                                                "example_id": "1df73fb3-095b-4069-a7dd-39a8b008f62e",
                                                "sense_id": "06d69bb2-bb17-315b-9dac-28326df27af8",
                                                "text": "in cucina il tradizionalista preferisce un’ottima trattoria ad alcune innovazioni pur non disdegnandole quando “ben eseguite”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
