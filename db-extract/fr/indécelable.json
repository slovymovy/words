                "senses": [
                    {
                        "sense_id": "0ff1aabe-bae1-3ba6-a103-687bddc52b57",
                        "entry_id": "e07fb298-21fc-3ece-9b87-002312545b61",
                        "glosses": [
                            "Qui n’est pas décelable, qui ne peut être décelé ou perçu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c796082-1522-42a1-ae86-18b17fda9128",
                                "sense_id": "0ff1aabe-bae1-3ba6-a103-687bddc52b57",
                                "text": "Le programme fut vite arrêté : avec un poison inconnu et indécelable, il empoisonnerait, dans son château, son beau-frère, et annoncerait qu’il avait été frappé d’une attaque d’apoplexie."
                            },
                            {
                                "example_id": "73f646b5-09eb-4045-a8ec-37fbb85873db",
                                "sense_id": "0ff1aabe-bae1-3ba6-a103-687bddc52b57",
                                "text": "Cette pourriture interne se développe au verger et en entrepôt ; elle est indécelable à la cueillette."
                            },
                            {
                                "example_id": "64a3bd74-cdc5-4e2b-b65c-6032f575b743",
                                "sense_id": "0ff1aabe-bae1-3ba6-a103-687bddc52b57",
                                "text": "Beaucoup de psychiatres allemands et autrichiens approuvèrent les conceptions d’Oppenheim, en faveur de l’action conjuguée de la commotion et de l’émotion, et de l’existence dans tous les cas d'une perturbation cérébrale objective, quoique « fonctionnelle » et anatomiquement indécelable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17a2f18f-5a15-4846-92ec-d1e14b9a11dc",
                        "source_entry_id": "e07fb298-21fc-3ece-9b87-002312545b61",
                        "source_sense_id": "0ff1aabe-bae1-3ba6-a103-687bddc52b57",
                        "target_lang_word": "undetectable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undetectable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                        "entry_id": "556fd0cc-73c4-3205-86fe-407124391f16",
                                        "glosses": [
                                            "Unable to be detected; not detectable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac0aef9-1bdf-4424-9920-87f875ddb2ee",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "In these days of “rolled” gold, electro-plate, and undetectable pearls, it is curious that almost the only honest Ersatz material known to the goldsmith's art should be utterly forgotten."
                                            },
                                            {
                                                "example_id": "8f014d50-a304-49ad-99af-8acc92cabd63",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "A trial of scar may be justified in a woman with a previous cesarean section who is currently on HAART, has an undetectable virus and spontaneously goes into labor."
                                            },
                                            {
                                                "example_id": "b1195444-5c70-4c35-a9d5-658dfa4db303",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "“OK, so for a few weeks I've been working on a bit of a side project. I give you the Red Kriegtober.” “Um--” “Or the Red Octkrieger. I can't decide. It's a narco sub for transporting cocaine. It's totally undetectable by the Coast Guard. Thoughts?”"
                                            },
                                            {
                                                "example_id": "0cb37757-4ed1-4198-b55f-6c6c2954ed53",
                                                "sense_id": "cb5d3431-f6ef-3047-b5fc-56cdef0e3783",
                                                "text": "Some forms of data poisoning are undetectable. Attackers can insert adversarial noise into the training data, altering the training data in a way that is hidden to human observers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
