                                            {
                                                "example_id": "f8dce5e0-93c9-4da2-a252-4b9a7f308d21",
                                                "sense_id": "81732e4f-cc13-319b-9aea-af175e9b4ad5",
                                                "text": "Du entsetzt mich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9aacbb8-1056-3345-8586-00221b6c2fe8",
                                        "entry_id": "02818102-ae46-367a-91a3-aabf464ba4b3",
                                        "glosses": [
                                            "(gehoben) aus der Fassung geraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d69bd502-ccba-494a-8b4b-47c894253e3f",
                                                "sense_id": "d9aacbb8-1056-3345-8586-00221b6c2fe8",
                                                "text": "Wir entsetzten uns, als wir davon erfuhren."
                                            },
                                            {
                                                "example_id": "3aefb14a-42e8-4504-b99f-a2fb060362b0",
                                                "sense_id": "d9aacbb8-1056-3345-8586-00221b6c2fe8",
                                                "text": "„Aller Welt will ich kurz und sachlich eine Reihe von rein häuslichen Begebenheiten enthüllen, deren Wirkungen mich entsetzt – gemartert – vernichtet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "982f86c0-e849-35a9-9b93-76a967599c34",
                                        "entry_id": "02818102-ae46-367a-91a3-aabf464ba4b3",
                                        "glosses": [
                                            "eine von Feinden belagerte Festung oder einen eingeschlossenen Teil des Heeres befreien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb64cd3-08c3-46d3-a539-0eebd2a491b8",
                                                "sense_id": "982f86c0-e849-35a9-9b93-76a967599c34",
                                                "text": "„Edward durfte die Burg nicht entsetzen, denn das hätte Roberts Autorität untergraben, und die Engländer hätte die strategische Initiative wiedererlangt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
