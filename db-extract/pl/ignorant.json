                        ]
                    },
                    {
                        "translation_id": "97bfc9a5-9910-4472-bc33-bdeade463199",
                        "source_entry_id": "37f36cb1-813e-31f6-9411-bfbce9db9543",
                        "source_sense_id": "7e596a2f-110b-36f6-b8b8-2db447399387",
                        "target_lang_word": "Ignorant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ignorant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed3fb1eb-4a7c-3e15-aa0e-0dc8479f38e3",
                                        "entry_id": "46a904a8-5d90-37ba-b461-d317ec719b7d",
                                        "glosses": [
                                            "Person, die sich nicht darum bemüht, Wahrheit zu erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6837fd36-278d-49b6-b263-6ae914201852",
                                                "sense_id": "ed3fb1eb-4a7c-3e15-aa0e-0dc8479f38e3",
                                                "text": "Wie kann dieser Ignorant seine Augen nur so vor der Realität verschließen?"
                                            },
                                            {
                                                "example_id": "929f1a66-674e-4057-af51-40b572596b07",
                                                "sense_id": "ed3fb1eb-4a7c-3e15-aa0e-0dc8479f38e3",
                                                "text": "„Es gab Ignoranten auch unter Jesuiten.“"
                                            },
                                            {
                                                "example_id": "8215d874-9b71-4567-9a06-075b554b1208",
                                                "sense_id": "ed3fb1eb-4a7c-3e15-aa0e-0dc8479f38e3",
                                                "text": "„Der Ignorant, der nichts wissen will, ist eben zum Scheitern verurteilt und fällt.“"
                                            },
                                            {
                                                "example_id": "43ac066c-9cdc-43a6-af8f-90c8bbdc2733",
                                                "sense_id": "ed3fb1eb-4a7c-3e15-aa0e-0dc8479f38e3",
                                                "text": "„Diese Ignoranten in Rom sind ihrer Denkweise nach völlig antiquiert.“"
                                            },
                                            {
                                                "example_id": "4d2cfc41-fb01-457a-835b-841d4390860a",
                                                "sense_id": "ed3fb1eb-4a7c-3e15-aa0e-0dc8479f38e3",
                                                "text": "„Die beiden gingen, versöhnt durch den Ignoranten Kern, einträchtig in ihren abgeschabten Anzügen davon, um noch über einige Rennwagen zu streiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
