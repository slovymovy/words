                ],
                "senses": [
                    {
                        "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                        "entry_id": "2bc0da34-b1d6-32e2-aabc-1e35a212d6ac",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf436fc-7158-4eb3-8664-b56cb130e4b3",
                                "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                                "text": "Frau Neuschwender ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e588c30b-2c3d-42d9-99de-e3a3fd2099ae",
                                "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                                "text": "Herr Neuschwender wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5358b31c-9206-4482-babc-f937a5067f43",
                                "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                                "text": "Die Neuschwenders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0fa02153-1952-4724-9d5b-0cdc2a3d6183",
                                "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                                "text": "Der Neuschwender trägt nie die Schals, die die Neuschwender ihm strickt."
                            },
                            {
                                "example_id": "adaf087c-1d88-4d14-83e5-4914eea542cf",
                                "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neuschwender kommt, geht der Herr Neuschwander.“"
                            },
                            {
                                "example_id": "870d3bc6-b965-4ae8-84e4-a97905cd8fef",
                                "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                                "text": "Neuschwender kommt und geht."
                            },
                            {
                                "example_id": "5b3b7c08-be84-4f11-94ac-08bb4b4ff0a9",
                                "sense_id": "3dae4435-5930-3e30-804a-aaec5a26dab6",
                                "text": "Neuschwenders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
