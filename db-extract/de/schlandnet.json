                "senses": [
                    {
                        "sense_id": "02c4fbf5-e016-374b-bd9d-35c5d7ea3671",
                        "entry_id": "7f744d17-1a98-33b1-ac74-6ee12d4b969f",
                        "glosses": [
                            "Konzept, nach dem Internetverkehr zwischen zwei deutschen Stellen nicht übers Ausland geleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38a81f1e-9abd-4c66-8b31-797b046d90e5",
                                "sense_id": "02c4fbf5-e016-374b-bd9d-35c5d7ea3671",
                                "text": "„Die Internetsociety, die für die Weiterentwicklung der Netzinfrastruktur zuständig ist, nennt das Schlandnet denn auch eine ‚lediglich symbolische Politik, die keine nachhaltigen Verbesserungen für die Menschen erreichen kann, aber von ihrer eigenen Konzept- und Ahnungslosigkeit ablenken will‘.“"
                            },
                            {
                                "example_id": "dc48ab8a-dd62-4ff6-a04b-f37f2d338ec9",
                                "sense_id": "02c4fbf5-e016-374b-bd9d-35c5d7ea3671",
                                "text": "„Doch wie lässt sich technisch überhaupt ein solches ‚Schlandnet‘ oder ‚Schengennet‘ einrichten?“"
                            },
                            {
                                "example_id": "059d05bc-5757-4e83-bf47-6f14adf6f482",
                                "sense_id": "02c4fbf5-e016-374b-bd9d-35c5d7ea3671",
                                "text": "„SchlandNet – eine ‚lustige Idee‘?“"
                            },
                            {
                                "example_id": "5284206a-cd3d-4072-9181-3bde5a5f595c",
                                "sense_id": "02c4fbf5-e016-374b-bd9d-35c5d7ea3671",
                                "text": "„Unter dem Hashtag SchlandNet lacht das halbe Internet über ein abhörsicheres Deutschland-Netz. Doch an dessen Umsetzung wird bereits gearbeit.“"
                            },
                            {
                                "example_id": "23a351ed-4695-4291-a7df-657433cf6672",
                                "sense_id": "02c4fbf5-e016-374b-bd9d-35c5d7ea3671",
                                "text": "„Im Rahmen des Spähskandals spielen Provider und Regierungen mit dem Gedanken, nationale Netze wie das deutsche Schlandnet zu realisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
