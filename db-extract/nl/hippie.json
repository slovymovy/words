                                "target_senses": [
                                    {
                                        "sense_id": "a710540d-8288-36d2-b5e7-a877fe123f2d",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "A teenager who imitated the beatniks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bf1b7b9-1b2e-3ed6-899f-ad7148272b77",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "One who chooses not to conform to prevailing social norms: especially one who subscribes to values or actions such as acceptance or self-practice of recreational drug use, liberal or radical sexual mores, advocacy of communal living, strong pacifism or anti-war sentiment, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61a47bf9-82fd-33ea-bb2f-2f7524ce76cb",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "A person who keeps an unkempt or sloppy appearance and has unusually long hair (for males), and is thus often stereotyped as a deadbeat."
                                        ],
                                        "tags": [
                                            "modern",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25a9e7aa-58f6-37da-9a4b-bb7f6f4ddbf7",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "Someone who dresses in a hippie style."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cef05e36-999c-3989-9fb0-33297d018f2b",
                                        "entry_id": "56a2fd21-9ae5-38b9-9e37-ccc470961d18",
                                        "glosses": [
                                            "One who is hip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hippie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                        "entry_id": "d3735f13-929a-324a-bb4f-499db36a68e8",
                                        "glosses": [
                                            "Of or pertaining to hippies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862e91a2-8e3d-44fe-9caa-ff76533d5420",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "That dress looks very hippie."
                                            },
                                            {
                                                "example_id": "b0799aa2-e4c3-4f53-9891-805665213053",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "The drug-taking he's writing about is less hippie than punk: it's about speed and smack and pills as much as hallucinogens and weed, about compulsion as well as escape."
                                            },
                                            {
                                                "example_id": "b7dc1f9a-9d09-4413-b938-cb7a805a1df0",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "You have to understand I worked in a very hippie nightclub for years, and the majority of the staff did not even like the Grateful Dead."
                                            },
                                            {
                                                "example_id": "b37353ef-b6c7-40a2-8adb-00a95b5b0c85",
                                                "sense_id": "5ee2f36e-cc48-33f6-81b7-4eb6311d560f",
                                                "text": "And then I discovered LSD, you can't get much more hippie than that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a705f042-4fc1-3189-83a2-1d5b8d63d829",
                                        "entry_id": "d3735f13-929a-324a-bb4f-499db36a68e8",
                                        "glosses": [
                                            "Not conforming to generally accepted standards."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706ffcc0-0ba1-4160-98c0-5ddb8e3a4b1b",
                                                "sense_id": "a705f042-4fc1-3189-83a2-1d5b8d63d829",
                                                "text": "They used a bunch of hippie compression formats instead of the usual RAR and ZIP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "025589dd-64ad-47bb-87e1-8dedaa31a9ad",
                        "source_entry_id": "604670dc-9126-3b09-9366-4462174d4430",
                        "source_sense_id": "d52ffa38-73ef-374f-b3c5-172f4cec3a77",
                        "target_lang_word": "hippie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hippie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9546ead0-063d-3e07-8b62-8c861a3a5c67",
                                        "entry_id": "09a97b85-3af7-39e1-880e-3b352e1b5075",
                                        "glosses": [
                                            "Membre d’un mouvement de contreculture des années 1960 et 1970, caractérisée par le rejet des valeurs conservatrices de la bourgeoisie, l’usage de drogues récréationnelles, l’abandon du puritanisme sexuel, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b921c7-9ea3-4fa8-b9cb-e7e5fcb023df",
                                                "sense_id": "9546ead0-063d-3e07-8b62-8c861a3a5c67",
                                                "text": "Deuxièmement, j'aurais affirmé que ce que nous appelons en Amérique les hippies et que vous appelez les beatniks constitue la nouvelle classe révolutionnaire. Je n'ai jamais rien prétendu de ce genre."
                                            },
                                            {
                                                "example_id": "c2f132ee-e717-491e-baaa-88227a5c0a8b",
                                                "sense_id": "9546ead0-063d-3e07-8b62-8c861a3a5c67",
                                                "text": "Quelques uns songent aux provos, déjà oubliés, mais symptômes d’une violence toujours latente sous la placidité du nord, aux hippies sur lesquels on marchait littéralement dans les années soixante, les enjambant de son mieux comme on l’eût fait de cadavres, maintenant refoulés sur Copenhague, sur Vancouver, sur Goa, où je les ai retrouvés hier encore, un peu plus pâles en dépit du soleil des Tropiques, ou sur je ne sais quel port ou quelle plage d’un autre monde."
                                            },
                                            {
                                                "example_id": "5e1fd00a-9f73-482e-8ea9-a01f359fe77d",
                                                "sense_id": "9546ead0-063d-3e07-8b62-8c861a3a5c67",
                                                "text": "Elle s'est fait des amis chez les hippies qui campent au bout de la plage. Elle est gras dur, comme on dit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f35570-73f6-3a8b-bcbe-be80030a4141",
                                        "entry_id": "09a97b85-3af7-39e1-880e-3b352e1b5075",
                                        "glosses": [
                                            "Personne qui s’habille de façon non conventionnelle, généralement en se laissant pousser les cheveux (pour les hommes) et adoptant un style de vie marginal, communautaire ou nomade."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81b48b60-813e-4f85-8ad9-077acc889d15",
                                                "sense_id": "40f35570-73f6-3a8b-bcbe-be80030a4141",
                                                "text": "P'tite crisse d'agace-pissette, t'aimes mieux te faire pogner le cul par ta gang de pouilleux, maudite droguée. Vous êtes tous pareils vous autres les hippies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hippie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "364463bb-96e5-3a48-8b14-c41edacd3856",
                                        "entry_id": "936b8af6-dc7f-3026-ae09-b8254115c132",
                                        "glosses": [
                                            "Relatif à la contreculture des hippies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79f65587-5136-462c-98dc-d36453a3dc8e",
                                                "sense_id": "364463bb-96e5-3a48-8b14-c41edacd3856",
                                                "text": "Elle continua néanmoins à sortir avec le musicien, s'autorisant de simples flirts avec les garçons du cours de théâtre, moins nombreux que les filles qui les partageaient de bonne grâce, une polyandrie de circonstance encouragée par la philosophie hippie."
                                            },
                                            {
                                                "example_id": "583af6da-11d8-4c54-bfd0-4957767f3537",
                                                "sense_id": "364463bb-96e5-3a48-8b14-c41edacd3856",
                                                "text": "Culture hippie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
