                "senses": [
                    {
                        "sense_id": "1dd4dd3c-a873-39f4-a8f4-100e3077c8d0",
                        "entry_id": "a593e980-373f-3317-8a38-ce81e754a90d",
                        "glosses": [
                            "Tortillonner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab306d7-49cd-4f05-b44e-148cea86f806",
                                "sense_id": "1dd4dd3c-a873-39f4-a8f4-100e3077c8d0",
                                "text": "Il en fait deux ou trois et revient à la première qu'il détortillonne, il masse, il lisse il retortillonne et défait."
                            },
                            {
                                "example_id": "f76a1100-042d-4483-9aa2-f073139b7fca",
                                "sense_id": "1dd4dd3c-a873-39f4-a8f4-100e3077c8d0",
                                "text": "Ben il se retortillonne pardi !!"
                            },
                            {
                                "example_id": "746d9798-bb39-4a63-8d74-91e0477ecc26",
                                "sense_id": "1dd4dd3c-a873-39f4-a8f4-100e3077c8d0",
                                "text": "(...) j'entoure assez près du lait en ayant enlevé au max l'air, je tortillonne le fil, je rabats la pointe du sachet et je retortillonne au-dessus!"
                            }
                        ]
                    }
