                    },
                    {
                        "translation_id": "92dc2cc0-d46d-4d5c-89bb-59a3caaf73b0",
                        "source_entry_id": "058f955f-bd41-31e5-8576-fed8e4c66953",
                        "source_sense_id": "e8e2bd5f-18be-35fb-b3cd-994eb30dcdb0",
                        "source_sense_description": "Données informatiques à très grande échelle",
                        "target_lang_word": "big data",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "big data",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3c4e0ce-3409-370e-ad11-5e9299bb7dce",
                                        "entry_id": "f86559fa-bb25-32df-b42e-cb03c6901fd0",
                                        "glosses": [
                                            "Data on a very large scale, such that it can only be gathered or processed with computers, especially with reference to its potential to allow for new breakthroughs or understanding in a particular field of study."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d173c00d-23f4-4eb0-be92-6d62fe5fcda0",
                                                "sense_id": "c3c4e0ce-3409-370e-ad11-5e9299bb7dce",
                                                "text": "The insights gained from big data can be used to improve products and customer service, but they can also be used in ways that creep out customers and make them feel uncomfortable or watched."
                                            },
                                            {
                                                "example_id": "8fb4e808-aacf-4248-8bf4-594f72a94ca2",
                                                "sense_id": "c3c4e0ce-3409-370e-ad11-5e9299bb7dce",
                                                "text": "As we’ll discuss in more detail, the big data of this revolution is far more powerful than the analytics that were used in the past. We can measure and therefore manage more precisely than ever before. We can make better predictions and smarter decisions."
                                            },
                                            {
                                                "example_id": "c16861df-50d4-42ba-b993-d965b9e3da3e",
                                                "sense_id": "c3c4e0ce-3409-370e-ad11-5e9299bb7dce",
                                                "text": "Big data has the potential to revolutionise the global healthcare system, but barriers to its adoption mean progress is slow."
                                            },
                                            {
                                                "example_id": "06ffa667-33ab-4a60-86a3-3da8a973dc04",
                                                "sense_id": "c3c4e0ce-3409-370e-ad11-5e9299bb7dce",
                                                "text": "James Cheshire and Oliver Uberti’s enchanting and exhilarating annotated atlas of animal movements[…]is a product of ‘big data’ methodology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
