                                "target_senses": [
                                    {
                                        "sense_id": "fd2f5960-3bb3-39a8-9d47-7514ef1fda24",
                                        "entry_id": "2318f970-d748-3bfe-9baf-696a34f865e5",
                                        "glosses": [
                                            "Rendre russe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7652f4da-77ac-43b0-aaab-3d394bea1b0b",
                                                "sense_id": "fd2f5960-3bb3-39a8-9d47-7514ef1fda24",
                                                "text": "– Dites, petit père, rugis-je et russifié-je, faudrait voir à ne pas confondre paire de couilles et paire de chaussettes."
                                            },
                                            {
                                                "example_id": "afd5ac47-cae6-4219-8127-3dc362f53928",
                                                "sense_id": "fd2f5960-3bb3-39a8-9d47-7514ef1fda24",
                                                "text": "En 1897, le tsar Nicolas II envoie le général Golitsyne russifier les provinces du Caucase ; en 1898, il nomme gouverneur général de Finlande Nikolai Bobrikov, qui entreprend de russifier la population."
                                            },
                                            {
                                                "example_id": "abcc7ac3-a0dc-4f2d-8e38-91213af425d5",
                                                "sense_id": "fd2f5960-3bb3-39a8-9d47-7514ef1fda24",
                                                "text": "Poutine lui-même nie l’existence même du peuple ukrainien et ses actions démontrent qu’il souhaite son éradication, que ce soit par le ciblage criminel des populations civiles ou la déportation systématique d’enfants ukrainiens pour les « russifier »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
