                                "target_senses": [
                                    {
                                        "sense_id": "f40bac82-f919-3d33-bd4b-fe7de60f971f",
                                        "entry_id": "3863cca0-8bdd-3c3b-8242-923d82b0ab0c",
                                        "glosses": [
                                            "Frau, die einen bestimmten Orden verliehen bekommen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf23818-f8bb-4c06-beab-bcbbda8d2837",
                                                "sense_id": "f40bac82-f919-3d33-bd4b-fe7de60f971f",
                                                "text": "„Die Namen dieser Damen sind in der im Jahre 1851 gedruckten Liste des Hohen Ordens verzeichnet; es sind die verwittwete Herzogin Maria Augusta von Württemberg, geborne Prinzessin von Thurn und Taxis, welche sich 1742 als Ritterin des Hohen Ordens unterzeichnet, die Kaiserin Elisabeth von Rußland, welche den Orden am 12. März 1743 in Petersburg durch die Hand des Preußischen Gesandten Baron von Mardefeld, so wie die Kaiserin Katharina II. von Rußland, welche den Orden am 22 November 1762 erhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
