                "senses": [
                    {
                        "sense_id": "3f8b0eb4-1b28-33f5-9405-99bd32eaa519",
                        "entry_id": "df577051-0d3f-3e15-ba34-27bfbf0edb89",
                        "glosses": [
                            "Linguistik, speziell Phonetik/ deutsche Bezeichnung für Dentale sowie Dentallaute, also für Laute (genauer: Konsonanten), die mit der Zungenspitze an den oberen Schneidezähnen gebildet werden"
                        ],
                        "tags": [
                            "Lautlehre"
                        ],
                        "examples": [
                            {
                                "example_id": "3db35f89-15ca-4d03-9ee9-abed6498241f",
                                "sense_id": "3f8b0eb4-1b28-33f5-9405-99bd32eaa519",
                                "text": "Im Deutschen gibt es keine wirklichen Zahnlaute, da bei Lauten wie [t] oder [s] die Zunge nicht an die Zähne, sondern an den Zahndamm geht; sie sind deshalb Zahndammlaute (= Alveolare). Oft werden Alveolare jedoch vereinfacht als Zahnlaute bezeichnet. Echte Zahnlaute gibt es zum Beispiel im Schwedischen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
