                        "cross_references": [
                            {
                                "target_word": "Gänsestall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c7d3089-cca2-3c4d-a83e-e7d3844b216c",
                                        "entry_id": "5f08f0fc-cdc7-3f5c-922d-f920b762d5f1",
                                        "glosses": [
                                            "Gebäude einer Farm, eines landwirtschaftlichen Betriebs, das zur Unterbringung von Gänsen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31750daf-08ff-482e-bb9b-865dc0f556b1",
                                                "sense_id": "5c7d3089-cca2-3c4d-a83e-e7d3844b216c",
                                                "text": "„Wenn man nämlich der Legende Glauben schenken möchte, versteckte sich der Mönch, weil er nicht zum Bischof geweiht werden wollte, im Gänsestall.“"
                                            },
                                            {
                                                "example_id": "dd8ce246-ae41-4698-be1d-c7bb1d466525",
                                                "sense_id": "5c7d3089-cca2-3c4d-a83e-e7d3844b216c",
                                                "text": "„Ebenfalls neu im Zoo sind in einem Gänsestall die bayerischen Landgänse.“"
                                            },
                                            {
                                                "example_id": "270302bb-b62e-49c4-b92e-74ece48fc19a",
                                                "sense_id": "5c7d3089-cca2-3c4d-a83e-e7d3844b216c",
                                                "text": "„Wenn sie über ihn sprechen, gehen sie hinüber zum Gänsestall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
