                ],
                "senses": [
                    {
                        "sense_id": "b4e96edb-440a-355e-9ea0-39b254efe4c9",
                        "entry_id": "219cb737-2bb3-3643-b29b-05a6a41cae23",
                        "glosses": [
                            "To remove the mythological elements of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "80ce3f62-9f9b-4ed2-b194-2d6322fbb7bb",
                                "sense_id": "b4e96edb-440a-355e-9ea0-39b254efe4c9",
                                "text": "Archaeological evidence has demythologized some parts of the Bible."
                            },
                            {
                                "example_id": "c1c88046-fe67-4714-a52a-3618e64072a4",
                                "sense_id": "b4e96edb-440a-355e-9ea0-39b254efe4c9",
                                "text": "[commentating on \"mother of all the living\" in Gen. 3:20] A similar phrase is used to describe the mother goddess in ancient Near Eastern mythology. Here the image has been demythologized. It simply expresses the biblical concepts of one human race and of woman's primary role--motherhood."
                            },
                            {
                                "example_id": "7445bf19-f26b-4897-a579-f954fd7564ad",
                                "sense_id": "b4e96edb-440a-355e-9ea0-39b254efe4c9",
                                "text": "However, the notion that an originally “mythological” figure has been “depotentized”, then variously “repotentized” or further “demythologized” by later, dependent authors, though the “mythological” understanding finally prevailed in later Jewish literature, does not sound entirely convincing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ede5971-6ef6-46c1-a9ff-33ab27d46505",
                        "source_entry_id": "219cb737-2bb3-3643-b29b-05a6a41cae23",
                        "source_sense_id": "b4e96edb-440a-355e-9ea0-39b254efe4c9",
                        "source_sense_description": "1. To remove the mythological elements",
                        "target_lang_word": "entmythologisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entmythologisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53a2bbb5-1a87-35cc-ba8c-49a2c6a47f51",
                                        "entry_id": "0bc1bf5d-df3f-3e78-be87-3e97730561f7",
                                        "glosses": [
                                            "von Mythen befreien; mythische oder irrationale Vorstellungen beseitigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9289e74b-636b-40cd-b4df-8efd6b7c5a60",
                                                "sense_id": "53a2bbb5-1a87-35cc-ba8c-49a2c6a47f51",
                                                "text": "Kriegerische Zeiten bringen Propaganda mit sich. Darum lohnt es sich, eine Art Meisterwerk der Propaganda der NS-Zeit erneut zu betrachten und gleichzeitig zu entmythologisieren."
                                            },
                                            {
                                                "example_id": "c303851d-8ae6-4054-ba5b-e1af96958543",
                                                "sense_id": "53a2bbb5-1a87-35cc-ba8c-49a2c6a47f51",
                                                "text": "Ihre Versuche, die Bedeutung des protestantischen Pfarrhauses für das deutsche Geistesleben zu entmythologisieren, laufen in der Summe auf eine erneute Remythisierung hinaus."
                                            },
                                            {
                                                "example_id": "f0fff6b1-f934-4129-b13c-9e5edbef687b",
                                                "sense_id": "53a2bbb5-1a87-35cc-ba8c-49a2c6a47f51",
                                                "text": "So erweisen sich die Enkel der Angehörigen der Kriegsgeneration und die ganz Jungen als die \"neuen Historiker\" und entmythologisieren die vorgetäuschte heroische Vergangenheit ihrer Vorfahren."
                                            },
                                            {
                                                "example_id": "66fa3cb2-6922-46fa-b128-a20ebdde5929",
                                                "sense_id": "53a2bbb5-1a87-35cc-ba8c-49a2c6a47f51",
                                                "text": "Während Regisseur Dmitri Tcherniakov das \"Rheingold\", also den ersten \"Ring\"-Schnipsel, konsequent entgöttert, entdämonisiert und entmythologisiert, macht Dirigent Christian Thielemann genau das Gegenteil."
                                            },
                                            {
                                                "example_id": "bf374a07-7b51-4cc4-8ee0-2ed989029fcb",
                                                "sense_id": "53a2bbb5-1a87-35cc-ba8c-49a2c6a47f51",
                                                "text": "Die europäische Neuzeit hat das gewalttätige Heilige zwar entmythologisiert, so Girard, aber auf den Flügeln der Wissenschaft sei die absolute Rache am Feind als schrecklichste Drohung der Weltgeschichte über uns gekommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
