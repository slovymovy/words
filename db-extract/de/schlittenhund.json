                "senses": [
                    {
                        "sense_id": "39ac7420-349f-3617-8ddf-c8b0909a067d",
                        "entry_id": "883055b0-fddd-35b1-a756-43ebc816cac5",
                        "glosses": [
                            "Hund, der einen Schlitten zieht, entweder alleine oder im Rudel (einige Hundearten sind dazu besonders geeignet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a62d26d1-ab8b-4aac-ac45-18b73efcd123",
                                "sense_id": "39ac7420-349f-3617-8ddf-c8b0909a067d",
                                "text": "Der Schlittenhund zieht den Schlitten über die Schneefläche."
                            },
                            {
                                "example_id": "6e5648ae-1f02-43ad-9940-08fb3dc392a0",
                                "sense_id": "39ac7420-349f-3617-8ddf-c8b0909a067d",
                                "text": "„Das kleine Städtchen Ilulissat liegt 250 Kilometer nördlich des Polarkreises, hat fünftausend Einwohner und ebenso viele Schlittenhunde, einhundert angemeldete Autos, aber keine Ampel.“"
                            },
                            {
                                "example_id": "91703955-170a-4869-8010-05b7129e0633",
                                "sense_id": "39ac7420-349f-3617-8ddf-c8b0909a067d",
                                "text": "„Eisiger Kälte trotzen aber nicht nur die Schlittenhunde: Auch Rentiere haben sich in schneereichen Gebieten als Zugtiere bewährt, insbesondere in Russland und Nordskandinavien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
