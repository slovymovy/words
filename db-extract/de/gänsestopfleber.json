                        "sense_id": "d3af2631-2a84-35c4-b87d-a76760223f25",
                        "entry_id": "a74e66be-2ca5-3c6b-badc-f98f005029dc",
                        "glosses": [
                            "als Speise zubereitete Leber der Gans, die durch zwangsweise Überfütterung (Stopfen) vergrößert und verfettet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b2cbf8-51dc-46fd-936c-f035d8a72167",
                                "sense_id": "d3af2631-2a84-35c4-b87d-a76760223f25",
                                "text": "„An einer Variation von der Gänsestopfleber mit Cidre-Sorbet, Atlantik-Steinbutt (unter Basilikum und Pinienkernen gegart) oder einem Rehcarre mit getrüffeltem Wirsing hätten sicher auch Bush und Merkel ihre helle Freude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
