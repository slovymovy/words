                                        "sense_id": "6959355c-4cbf-3509-a30c-2806742ac0fb",
                                        "entry_id": "dda60772-6a2d-31ba-99dd-89c51736ab0b",
                                        "glosses": [
                                            "Visionäre und Schwärmer des 13. und 14. Jahrhunderts, die das nahe bevorstehende Ende der Welt erwarteten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e500d189-fa23-407a-85b1-fcfa14dbf0ba",
                                                "sense_id": "6959355c-4cbf-3509-a30c-2806742ac0fb",
                                                "text": "Es gibt christliche Apokalyptiker, denen man Unrecht antäte, wenn man sie als reine Phantasten ansähe, indem sie nämlich durchaus eines Tages den katastrophalen Untergang wenigstens ihrer eigenen Anhänger vorweisen können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e90d8e4-5f45-35d5-8994-44b6cab30f97",
                                        "entry_id": "dda60772-6a2d-31ba-99dd-89c51736ab0b",
                                        "glosses": [
                                            "Person, die eine Apokalypse verfasst oder auslegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88393da0-bc3a-4c7d-b078-3059faafdd7d",
                                                "sense_id": "9e90d8e4-5f45-35d5-8994-44b6cab30f97",
                                                "text": "„Wie die Propheten des Alten Testaments richtet der Apokalyptiker Johannes den fordernden Willen Gottes den Menschen seiner Gegenwart aus […].“"
                                            }
                                        ],
