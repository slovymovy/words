                        "glosses": [
                            "Warnung der Öffentlichkeit vor einer Bombe oder einem bevorstehenden Bombardement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f14815e-b576-43f0-b46b-5ec30cdbdde9",
                                "sense_id": "234b03d9-d166-36cc-98fb-190352b509bc",
                                "text": "Wegen eines herrenlosen Koffers in der Abflughalle wurde Bombenalarm ausgelöst."
                            },
                            {
                                "example_id": "8f3e4861-0f12-4ea4-8861-80eae5796fbf",
                                "sense_id": "234b03d9-d166-36cc-98fb-190352b509bc",
                                "text": "In den letzten Kriegsjahren verging fast keine Nacht ohne Bombenalarm."
                            },
                            {
                                "example_id": "804d0912-3f81-42a7-b137-a248a912cc2d",
                                "sense_id": "234b03d9-d166-36cc-98fb-190352b509bc",
                                "text": "„Zum nächstgelegenen, öffentlichen Bunker brauchte man zehn bis fünfzehn Minuten. Zu weit und zu gefährlich, um bei Bombenalarm hinzulaufen.“"
                            }
                        ],
