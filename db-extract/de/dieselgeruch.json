                ],
                "senses": [
                    {
                        "sense_id": "b5c82ed5-6cfd-3296-bb76-524dc0be7953",
                        "entry_id": "23b7caaf-fe92-318a-87c0-e3c1dc6265a2",
                        "glosses": [
                            "Geruch, der von Diesel stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018a9f82-ebef-487e-9b2f-f79cf2ab1adf",
                                "sense_id": "b5c82ed5-6cfd-3296-bb76-524dc0be7953",
                                "text": "Der Dieselgeruch gleicht dem Heizölgeruch, da beides identische Substanzen sind; lediglich aus steuerlichen Gründen ist Heizöl rötlich eingefärbt und kostet weniger."
                            },
                            {
                                "example_id": "06098efa-c796-4a3e-b64d-26da6bf11fb8",
                                "sense_id": "b5c82ed5-6cfd-3296-bb76-524dc0be7953",
                                "text": "„Dieselgeruch lag in der Luft.“"
                            },
                            {
                                "example_id": "f11b175f-3ef3-4d9e-8d13-086db4884e45",
                                "sense_id": "b5c82ed5-6cfd-3296-bb76-524dc0be7953",
                                "text": "„Am Dienstagmittag stellte ein Spaziergänger starken Diesel- oder Heizölgeruch am Freibach zwischen dem Neukirchener Ortsrand und der Deschermühle fest.“"
                            },
                            {
                                "example_id": "033cb514-933e-425e-a60b-918a24c35abd",
                                "sense_id": "b5c82ed5-6cfd-3296-bb76-524dc0be7953",
                                "text": "„Denn die Kombination des Filtermaterials und einer imprägnierten Aktivkohleschicht kann außerdem die Dieselgerüche um bis zu 90 Prozent reduzieren.“"
                            },
                            {
                                "example_id": "ab60bfd1-a706-4c8e-bf01-89530bf2e67c",
                                "sense_id": "b5c82ed5-6cfd-3296-bb76-524dc0be7953",
                                "text": "„Da ein starker Dieselgeruch wahrnehmbar war, wurde die Einsatzstelle mit Ölsperren und ölabsorbierenden Vliesschläuchen eingedämmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
