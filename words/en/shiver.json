{
    "word_family": [
        "shivering",
        "shiveringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d7d160d-43a6-3774-93f3-c8c522c03573",
                    "sense_definition": "To tremble or shake, especially when cold or frightened.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tremble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stood outside for hours, <w>shivering</w> in the frosty air.",
                            "target_lang_translations": {
                                "cs": "Stáli venku celé hodiny a <w>třásli se</w> v mrazivém vzduchu."
                            }
                        },
                        {
                            "text": "The cold wind made the children <w>shiver</w> while they waited for the bus.",
                            "target_lang_translations": {
                                "cs": "Studený vítr způsobil, že se děti <w>třásly</w>, zatímco čekaly na autobus."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremble",
                        "shake",
                        "quiver"
                    ],
                    "common_phrases": [
                        "shiver with cold",
                        "shiver with fear"
                    ],
                    "target_lang_definitions": {
                        "cs": "Třást se nebo chvět, zejména v důsledku chladu nebo strachu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třást se",
                                "target_lang_sense_clarification": "obecné vyjádření chvění těla"
                            },
                            {
                                "target_lang_word": "klepat se",
                                "target_lang_sense_clarification": "intenzivnější projev třesu, často z chladu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7546e0b-ba60-358f-ae03-2c564d82af7f",
                    "sense_definition": "To break into splinters or fragments.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glass vase fell and <w>shivered</w> into a thousand pieces on the floor.",
                            "target_lang_translations": {
                                "cs": "Skleněná váza spadla a <w>roztříštila se</w> na podlaze na tisíc kousků."
                            }
                        },
                        {
                            "text": "The impact caused the wooden mast to <w>shiver</w> upon hitting the rocks.",
                            "target_lang_translations": {
                                "cs": "Náraz způsobil, že se dřevěný stěžeň při úderu o skály <w>roztříštil</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shatter",
                        "splinter"
                    ],
                    "common_phrases": [
                        "shiver into fragments"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozbít se na třísky nebo úlomky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "roztříštit se",
                                "target_lang_sense_clarification": "rozpadnutí na mnoho malých kusů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aecee2f7-f4e1-32bf-b837-41b6fab4a641",
                    "sense_definition": "To cause to shake or tremble, as a sail, by steering close to the wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tremble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor had to <w>shiver</w> the sails to slow the boat down.",
                            "target_lang_translations": {
                                "cs": "Námořník musel <w>nechat plachty třepotat</w>, aby loď zpomalil."
                            }
                        },
                        {
                            "text": "The wind caused the canvas to <w>shiver</w> as the boat turned.",
                            "target_lang_translations": {
                                "cs": "Vítr způsobil, že se plátno <w>třepotalo</w>, když se loď otáčela."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit chvění plachet při plavbě příliš blízko větru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nechat plachty třepotat",
                                "target_lang_sense_clarification": "námořnický termín pro ztrátu tahu plachty"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79046191-346b-3e83-82cf-9f90bb09f361",
                    "sense_definition": "The act of shivering.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tremble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>shiver</w> went up my spine when I heard the noise.",
                            "target_lang_translations": {
                                "cs": "Když jsem uslyšel ten hluk, přeběhl mi po zádech náhlý <w>mráz</w>."
                            }
                        },
                        {
                            "text": "He could not stop the <w>shiver</w> caused by the freezing temperature.",
                            "target_lang_translations": {
                                "cs": "Nemohl zastavit <w>třes</w> způsobený mrazivou teplotou."
                            }
                        }
                    ],
                    "synonyms": [
                        "tremor",
                        "shudder"
                    ],
                    "common_phrases": [
                        "a shiver down the spine"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt třesení se nebo chvění."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třes",
                                "target_lang_sense_clarification": "náhlý záchvěv nebo stav chvění"
                            },
                            {
                                "target_lang_word": "třesení",
                                "target_lang_sense_clarification": "proces nebo stav chvění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0841a893-d1bb-3116-b518-5904ae0dd618",
                    "sense_definition": "A fragment or splinter, especially of glass or stone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The floor was covered in a <w>shiver</w> of broken glass.",
                            "target_lang_translations": {
                                "cs": "Podlaha byla pokryta <w>střepy</w> rozbitého skla."
                            }
                        },
                        {
                            "text": "He carefully removed a small <w>shiver</w> of stone from his boot.",
                            "target_lang_translations": {
                                "cs": "Opatrně si z boty vyndal malý <w>úlomek</w> kamene."
                            }
                        }
                    ],
                    "synonyms": [
                        "splinter",
                        "fragment",
                        "shard"
                    ],
                    "target_lang_definitions": {
                        "cs": "Úlomek nebo střep, zejména skla nebo kamene."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "střep",
                                "target_lang_sense_clarification": "úlomek skla nebo keramiky"
                            },
                            {
                                "target_lang_word": "tříska",
                                "target_lang_sense_clarification": "úlomek dřeva nebo jiného materiálu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bce3cf05-b48c-332c-8e61-c54954141e4e",
                    "sense_definition": "A bodily response to early hypothermia.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tremble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The uncontrollable <w>shiver</w> was a clear sign of his body losing heat.",
                            "target_lang_translations": {
                                "cs": "Nekontrolovatelná <w>třesavka</w> byla jasným znamením, že jeho tělo ztrácí teplo."
                            }
                        },
                        {
                            "text": "Medical staff monitored the patient for a persistent <w>shiver</w>.",
                            "target_lang_translations": {
                                "cs": "Zdravotnický personál sledoval pacienta, zda se u něj neprojeví přetrvávající <w>třesavka</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tělesná reakce na počínající podchlazení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "třesavka",
                                "target_lang_sense_clarification": "mimovolný třes těla při podchlazení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20c340c5-3efd-3a39-a983-87c97ea27a98",
                    "sense_definition": "A thin slice; a shive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She cut a thin <w>shiver</w> of bread for the soup.",
                            "target_lang_translations": {
                                "cs": "Ukrojila tenký <w>plátek</w> chleba k polévce."
                            }
                        },
                        {
                            "text": "He offered a small <w>shiver</w> of cheese to his guest.",
                            "target_lang_translations": {
                                "cs": "Nabídl svému hostu malý <w>kousek</w> sýra."
                            }
                        }
                    ],
                    "synonyms": [
                        "slice",
                        "sliver"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tenký plátek nebo kousek."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plátek",
                                "target_lang_sense_clarification": "tenký kus potraviny"
                            },
                            {
                                "target_lang_word": "kousek",
                                "target_lang_sense_clarification": "malý úlomek nebo část"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79073c13-a54b-3439-a130-c6cdd4dd3802",
                    "sense_definition": "Collective noun for a group of sharks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The divers were amazed to see a <w>shiver</w> of sharks circling the reef.",
                            "target_lang_translations": {
                                "cs": "Potápěči byli ohromeni, když viděli <w>hejno</w> žraloků kroužících kolem útesu."
                            }
                        },
                        {
                            "text": "A <w>shiver</w> of sharks moved silently through the deep water.",
                            "target_lang_translations": {
                                "cs": "<w>Hejno</w> žraloků se tiše pohybovalo hlubokou vodou."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kolektivní podstatné jméno pro skupinu žraloků."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hejno",
                                "target_lang_sense_clarification": "obecné označení pro skupinu ryb"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1c22ca88-152f-383f-bb62-bddf4d6d47a4",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named Mr. <w>Shiver</w>.",
                            "target_lang_translations": {
                                "cs": "Autor knihy se jmenuje pan <w>Shiver</w>."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Shiver</w> at the conference.",
                            "target_lang_translations": {
                                "cs": "Na konferenci jsem potkal ženu jménem Sarah <w>Shiver</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Shiver",
                                "target_lang_sense_clarification": "příjmení se nepřekládá"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}