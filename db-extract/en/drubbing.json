                                    {
                                        "sense_id": "273dcf62-fd2e-311d-96fc-49756b145ad4",
                                        "entry_id": "a492f6e3-d300-3318-aed2-18bb5ce45c70",
                                        "glosses": [
                                            "Sonnerie de cloche."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f61b749c-d54a-3c96-8a23-a5c04626ac66",
                                        "entry_id": "a492f6e3-d300-3318-aed2-18bb5ce45c70",
                                        "glosses": [
                                            "Masturbation."
                                        ],
                                        "tags": [
                                            "rare",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fb4da76-f365-4a77-bbaf-cf34f37facdf",
                                                "sense_id": "f61b749c-d54a-3c96-8a23-a5c04626ac66",
                                                "text": "On restait couchés deux par deux… On se passait des branlées sévères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "044cd00b-1b33-3eec-8eba-3f2221b3be76",
                                        "entry_id": "a492f6e3-d300-3318-aed2-18bb5ce45c70",
                                        "glosses": [
                                            "Raclée, correction, coups donnés ou reçus."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb63cb94-69aa-4b03-a5a3-79b707792ef5",
                                                "sense_id": "044cd00b-1b33-3eec-8eba-3f2221b3be76",
                                                "text": "Je suis devenu comme fou et je lui ai filé une branlée terrible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a41cb45-6225-3421-99fd-51b35379ce26",
                                        "entry_id": "a492f6e3-d300-3318-aed2-18bb5ce45c70",
                                        "glosses": [
                                            "Sévère défaite, correction."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c413385f-3daa-4a01-93c6-cb301305eb56",
                                                "sense_id": "7a41cb45-6225-3421-99fd-51b35379ce26",
                                                "text": "En face, c’étaient des martiens, notre équipe a pris une de ces branlées !"
                                            },
                                            {
                                                "example_id": "73ef5253-98f0-452f-8568-9f025fa5a9f3",
                                                "sense_id": "7a41cb45-6225-3421-99fd-51b35379ce26",
                                                "text": "J’ai mis une branlée à Vincent !"
                                            },
                                            {
                                                "example_id": "621e63f9-7cbf-49c4-aa95-d0459c8389a2",
                                                "sense_id": "7a41cb45-6225-3421-99fd-51b35379ce26",
                                                "text": "Lors du mondial 2014, l’Allemagne a mis une branlée au Brésil."
                                            },
                                            {
                                                "example_id": "28a08e02-0fa4-4627-9574-ba47c7f5415f",
                                                "sense_id": "7a41cb45-6225-3421-99fd-51b35379ce26",
                                                "text": "Espérons que cette branlée mémorable aura au moins le mérite de remettre en cause quelques certitudes chez nos chers entraineurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "branlée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eda1f534-cead-3327-beba-f4fadebda9b9",
                                        "entry_id": "a3eb2c0b-9f2f-3f60-b863-79ae97b4bd5b",
                                        "glosses": [
                                            "Participe passé féminin singulier du verbe branler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58397763-6a8b-434e-bb55-5a8a4bd5d9d2",
                                                "sense_id": "eda1f534-cead-3327-beba-f4fadebda9b9",
                                                "text": "À ces mots, l’impudente Nicette, dans les bras de Saint-Clair, et déjà branlée par ce beau jeune homme, lâche un blasphème horrible…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
