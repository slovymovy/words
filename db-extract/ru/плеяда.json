                "senses": [
                    {
                        "sense_id": "b86471db-0f52-3260-b243-394af42a7025",
                        "entry_id": "bd076cbd-4589-3c84-a008-ea488f8b6041",
                        "glosses": [
                            "книжн. группа выдающихся деятелей в какой-либо области культуры, науки в одну эпоху"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95cf1f72-c6ab-430f-bef4-ffb20cc5d071",
                                "sense_id": "b86471db-0f52-3260-b243-394af42a7025",
                                "text": "Конечно, Майков был самый талантливый из всей плеяды поэтов того времени."
                            }
                        ]
                    },
                    {
                        "sense_id": "f35d19cd-38e0-3e77-b8c7-2a8565a6df68",
                        "entry_id": "bd076cbd-4589-3c84-a008-ea488f8b6041",
                        "glosses": [
