                            {
                                "example_id": "6ecc2e24-efdf-4d03-acc7-c7bf405fb2f8",
                                "sense_id": "a3e8b2bf-4157-38d3-815c-4d4c8dcc4841",
                                "text": "„Das Accoudoir ist entfernt worden, eine gerade Rückwand mit querrechteckiger Felderung bildete die Lehne, die Stallen waren durch Wangen mit kräftigen Volutenkonsolen getrennt.“"
                            }
                        ],
