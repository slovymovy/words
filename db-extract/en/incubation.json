                "word": "incubation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a6c557a6-9211-4310-8488-32e55e31bc95",
                        "entry_id": "4bba5baf-cf66-3dab-b280-6c5b9b3ed383",
