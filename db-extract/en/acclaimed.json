                    {
                        "translation_id": "d97f0cae-fedb-4fb2-a2bc-c6aa6930e5c3",
                        "source_entry_id": "6325fc45-91e8-3a4b-bb89-6fe87758356e",
                        "source_sense_id": "da575f95-f765-3537-9c5b-c8955ef55437",
