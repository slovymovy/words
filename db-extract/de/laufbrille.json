                ],
                "senses": [
                    {
                        "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                        "entry_id": "c12fc355-f08a-3ebd-a2e2-2f533b0406b6",
                        "glosses": [
                            "Brille, die speziell für Läufer entwickelt wurde; Brille, die als Schutzbrille beim Laufen gedacht ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "237f2373-bac2-49dc-8004-d7df7cafe0e8",
                                "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                                "text": "„Beim Radeln und Laufen gibt es mit einer guten Rad- oder Laufbrille nie Probleme.“"
                            },
                            {
                                "example_id": "de375c98-2519-4ef3-b78a-0c9b959fede8",
                                "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                                "text": "„Erst vor sechs Jahren wurde Bloovs gegründet und das mit dem festen Fokus auf Rad- und Laufbrillen.“"
                            },
                            {
                                "example_id": "3beab198-8d79-4e23-a687-e4fe6632b301",
                                "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                                "text": "„Diese Laufbrillen sind besonders praktisch für Läufer, die bei unterschiedlichen Wetterbedingungen oder zu verschiedenen Tageszeiten laufen.“"
                            },
                            {
                                "example_id": "4e4987a8-bd20-4b06-8e47-6ba8a49ffd53",
                                "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                                "text": "„Es ist wichtig, dass du deine Laufbrille regelmäßig pflegst und wartest, um sicherzustellen, dass sie in gutem Zustand bleibt und dir den besten Schutz bietet.“"
                            },
                            {
                                "example_id": "ec2c3602-dbf5-433a-a3b0-278fff29f6a8",
                                "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                                "text": "„Wenn du dich für eine Laufbrille entscheidest, solltest du also auf die Passform, die Gläser, das Rahmenmaterial und den Preis achten.“"
                            },
                            {
                                "example_id": "a0d3a100-be42-4cf7-ae04-03b83aa4dfb3",
                                "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                                "text": "„Eine Laufbrille schützt die Augen vor Insekten, Staub, Schmutz und anderen Fremdkörpern, die beim Laufen ins Auge gelangen können.“"
                            },
                            {
                                "example_id": "c720a780-3a7d-4169-b028-3d8b6b125aa3",
                                "sense_id": "17054298-21d3-3987-9a87-210b1874d891",
                                "text": "„Eine Laufbrille kann dazu beitragen, Blendung zu reduzieren, insbesondere bei hellem Sonnenlicht oder reflektierenden Oberflächen wie Wasser oder Schnee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
