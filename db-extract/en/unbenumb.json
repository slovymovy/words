                                            {
                                                "example_id": "62f2ec09-ce77-4738-9e38-7287e011716e",
                                                "sense_id": "9036c3ca-6653-310e-b48b-f8725a198819",
                                                "text": "Er schaffte es, sein Hab und Gut wiederzuerlangen."
                                            },
                                            {
                                                "example_id": "ab3d9675-403a-4b6e-b1a8-c2166bd08534",
                                                "sense_id": "9036c3ca-6653-310e-b48b-f8725a198819",
                                                "text": "Mit ihrer wiedererlangten Freiheit stieg auch ihr Selbstbewusstsein."
                                            }
