                "entry_id": "19cf8204-567c-3c57-ba3d-a228544a6a60",
                "word": "marinade",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b4edaf85-c39d-4d46-81b9-b0a926899df1",
                        "entry_id": "19cf8204-567c-3c57-ba3d-a228544a6a60",
                        "tags": [
                            "plural"
