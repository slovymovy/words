                "senses": [
                    {
                        "sense_id": "8803a7b9-71a9-3e7d-8229-4f0e7e47fb13",
                        "entry_id": "97ab942c-c1c9-38d5-8899-1b6bc6cb46bd",
                        "glosses": [
                            "Donner un caractère français à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d41354-ba01-4e53-bca0-d7d70f809077",
                                "sense_id": "8803a7b9-71a9-3e7d-8229-4f0e7e47fb13",
                                "text": "La ville de New-Castle, par exemple, est loin de l’unité d’esprit désirable et de la rigidité puritaine des origines ; elle est « francifiée, écossifiée, hollandifiée »."
                            },
                            {
                                "example_id": "a807c91b-17c0-4ea1-8eb3-3d5b78751413",
                                "sense_id": "8803a7b9-71a9-3e7d-8229-4f0e7e47fb13",
                                "text": "Il ne me fallait que 5 millions par mois pour « francifier » l’Espagne; oui, pour la « francifier », répéta-t-il."
                            }
                        ]
                    }
