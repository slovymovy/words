                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis très fatigué ce soir, alors <w>lâche</w>-moi quelques minutes."
                        },
                        {
                            "text": "Elle a enfin accepté de me <w>lâcher</w> avec ses questions incessantes."
                        }
                    ],
                    "common_phrases": [
