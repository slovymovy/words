                ],
                "senses": [
                    {
                        "sense_id": "0ec1fdfd-3be2-3075-8c72-db733fb469a1",
                        "entry_id": "68ac0447-1ff7-39b8-94c3-8ffdeae42528",
                        "glosses": [
                            "Socke, die speziell für das Laufen entwickelt wurde"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "52df0ea2-c51b-42d5-851f-4ef8b69dfd28",
                                "sense_id": "0ec1fdfd-3be2-3075-8c72-db733fb469a1",
                                "text": "„Die wichtigsten Eigenschaften sind die Passform, das geeignete Material um insbesondere die Wärme und Feuchtigkeitsregulation zu optimieren und die Elastizität oder Spannkraft, damit die Laufsocke bei der ausgeübten Sportart in keiner Situation verrutschen kann und der Fuß perfekt in der Socke und damit auch im Sportschuh sitzt.“"
                            },
                            {
                                "example_id": "524dc2bf-2f93-45b1-9b1c-02ad47037b38",
                                "sense_id": "0ec1fdfd-3be2-3075-8c72-db733fb469a1",
                                "text": "„Eine halbhohe Laufsocke (bis zum Wadenansatz), die funktionale Komponenten mit einem sehr angenehmen Tragegefühl vereint.“"
                            },
                            {
                                "example_id": "9e3b82da-75a5-49b2-8cdf-5d813dbc7dc5",
                                "sense_id": "0ec1fdfd-3be2-3075-8c72-db733fb469a1",
                                "text": "„Der Fußrücken der Laufsocke ist für eine systematische Luftzirkulation mit einer anatomischen Mesh-Struktur-Zone ausgestattet.“"
                            },
                            {
                                "example_id": "9665be54-cfd9-4ffb-9538-7b5b62407675",
                                "sense_id": "0ec1fdfd-3be2-3075-8c72-db733fb469a1",
                                "text": "„Als halbhohe Laufsocke empfehlen wir den optimalen Einsatz der Laufsocke für kurze bis mittlere Laufdistanzen.“"
                            },
                            {
                                "example_id": "5d55961c-da4c-40cb-9a7e-174b1173e8f0",
                                "sense_id": "0ec1fdfd-3be2-3075-8c72-db733fb469a1",
                                "text": "„Eine tolle Socke mit allen Eigenschaften, die du von einer Laufsocke erwartest, kombiniert mit einem ausgeklügelten integrierten Wärmesystem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95453c30-52dd-3eef-a439-56c6757a0802",
                        "entry_id": "68ac0447-1ff7-39b8-94c3-8ffdeae42528",
                        "glosses": [
                            "Schutzhülle für den Lauf (Rohr) eines Paintball-Markierers, die bei einem versehentlichen Schuss den Paintball auffängt und so Verletzungen verhindert"
                        ],
                        "tags": [
                            "Paintball"
                        ],
                        "examples": [
                            {
                                "example_id": "bc8785be-5828-4065-b55e-6d91fb329398",
                                "sense_id": "95453c30-52dd-3eef-a439-56c6757a0802",
                                "text": "„Die Laufsocke oder auch Barrel Sock, ist auf jedem Spielfeld pflicht, sollte sich einmal ein Schuss lösen, wird dieser durch die Laufsocke oder auch Laufkondom aufgehalten.“"
                            },
                            {
                                "example_id": "0f831370-4277-4426-80f3-476bf95b432c",
                                "sense_id": "95453c30-52dd-3eef-a439-56c6757a0802",
                                "text": "„Somit ist die Laufsocke das Sicherheitsprodukt was jeder besitzen sollte und bei allen Markieren im Lieferumfang in der Regel immer mit dabei ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
