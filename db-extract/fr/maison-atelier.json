                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58bbc14e-97f6-47ab-b925-fe7e496852f6",
                                "sense_id": "81bf7c5c-11d5-3bc0-ba2a-b41a25cf7113",
                                "text": "Les « maisons-ateliers » du quartier Mu seraient celles d’un fondeur, d’un graveur de sceaux et d’un potier."
                            },
                            {
                                "example_id": "8e0201d5-0c1d-4333-bd6d-273f6078d858",
                                "sense_id": "81bf7c5c-11d5-3bc0-ba2a-b41a25cf7113",
                                "text": "Avec son ami l’architecte et peintre Oudinot, il conçoit une maison-atelier qui sera le premier foyer artistique du village, en bordure du parc du château."
                            },
                            {
                                "example_id": "bdddb4a5-b6e3-434b-8773-85725a231dcd",
                                "sense_id": "81bf7c5c-11d5-3bc0-ba2a-b41a25cf7113",
                                "text": "Il est très investi dans la vie sociale et artistique locale, vit et travaille dans sa maison-atelier, chef-d’œuvre d'architecture."
                            },
                            {
                                "example_id": "f9f04e8f-2ded-4c82-8f3f-e6005c9199b3",
                                "sense_id": "81bf7c5c-11d5-3bc0-ba2a-b41a25cf7113",
                                "text": "Une maison-atelier à louer, rue Paixhans, 2. S'adresser à M. Geoffroy, place de la Comédie, 7."
                            }
                        ]
                    }
