            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7de003b-7cdf-364a-9c5e-9e7a1ba5a242",
                    "sense_definition": "hoorbaar diep uitademen, meestal als uiting van frustratie, verdriet of opluchting",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ademhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vermoeide leraar moest diep <w>zuchten</w> toen de leerlingen weer niet luisterden.",
                            "target_lang_translations": {
                                "en": "The tired teacher had to <w>sigh</w> deeply when the students didn't listen again."
                            }
                        },
                        {
                            "text": "Stop met <w>zuchten</w> en eet je bord leeg!",
                            "target_lang_translations": {
                                "en": "Stop <w>sighing</w> and finish your plate!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "diep zuchten",
                        "hoorbaar zuchten"
                    ],
                    "target_lang_definitions": {
                        "en": "to exhale a deep, audible breath, usually as an expression of frustration, sadness, or relief"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sigh",
                                "target_lang_sense_clarification": "to let out a deep breath"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a2ed618-a394-322b-9130-a7e2e2b0b4d2",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>zucht</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ademhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het horen van het goede nieuws slaakte de hele klas diepe <w>zuchten</w> van verlichting.",
                            "target_lang_translations": {
                                "en": "After hearing the good news, the whole class let out deep <w>sighs</w> of relief."
                            }
                        },
                        {
                            "text": "De <w>zuchten</w> van de patiënt waren in de stille gang van het ziekenhuis duidelijk te horen.",
                            "target_lang_translations": {
                                "en": "The patient's <w>sighs</w> could be clearly heard in the quiet hospital corridor."
                            }
                        }
                    ],
                    "common_phrases": [
