                "senses": [
                    {
                        "sense_id": "0d067c8e-54c9-31ed-a31f-b030ac484daf",
                        "entry_id": "378fdf97-4711-35e1-8326-8e557fb16a3a",
                        "glosses": [
                            "im allgemeinsten Sinne eine Haltung, die auf etwas Geistiges hin ausgerichtet ist, im engeren Sinne von einer religiösen Ausrichtung (von der Verbindung zum) Transzendenten, dem Jenseits beziehungsweise Gott"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9976469-88ce-453c-8e4e-2b9fa4d8ed32",
                                "sense_id": "0d067c8e-54c9-31ed-a31f-b030ac484daf",
                                "text": "„Für ihn ist Philosophie »eine Synthese der Wissenschaft und Spiritualität«.“"
                            },
                            {
                                "example_id": "9a8a9c6c-125a-4fd4-900d-d56f953e9e44",
                                "sense_id": "0d067c8e-54c9-31ed-a31f-b030ac484daf",
                                "text": "„Spiritualität dient unserer Bewusstseinsentwicklung.“"
                            },
                            {
                                "example_id": "0d081136-87d8-4466-ae37-445e998c5b06",
                                "sense_id": "0d067c8e-54c9-31ed-a31f-b030ac484daf",
                                "text": "„Besonders mit der vermeintlichen Abstammung vom Propheten ist eine besondere Spiritualität verbunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
