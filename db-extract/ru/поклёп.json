                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "225fa87f-fd81-34ff-834f-577a69c23f99",
                                        "entry_id": "51cd0a3f-589d-3ac1-b543-35b06e9818a1",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de calomnier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "699a9e87-19bc-4615-a4b1-69814a7c9fbd",
                                                "sense_id": "225fa87f-fd81-34ff-834f-577a69c23f99",
                                                "text": "Il arrive presque toujours qu’un homme ignore les bruits qui courent sur son compte : une ville entière s’occupe de lui, le calomnie ou le tympanise ; s’il n’a pas d’amis, il ne saura rien."
                                            }
