                                    {
                                        "sense_id": "fb7d77c9-0324-3516-aa88-b658b8abd143",
                                        "entry_id": "85b929c9-99c5-3549-8f10-5d4e630d7682",
                                        "glosses": [
                                            "A small circle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a44fdde1-8556-3530-bbbd-5c0889ee44a8",
                                        "entry_id": "85b929c9-99c5-3549-8f10-5d4e630d7682",
                                        "glosses": [
                                            "A ring (typically of gold or silver) worn as an ornament on the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2a99d09-9b89-4fbe-8aab-74edaf7d7de7",
                                                "sense_id": "a44fdde1-8556-3530-bbbd-5c0889ee44a8",
                                                "text": "He wore in addition to his leathern trappings and jewelled ornaments a great circlet of gold about his brow in the exact centre of which was set an immense stone, the exact counterpart of that which I had seen upon the breast of the little old man at the atmosphere plant nearly twenty years before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd37f55-746d-3fc7-b06c-67ca7235ecd4",
                                        "entry_id": "85b929c9-99c5-3549-8f10-5d4e630d7682",
                                        "glosses": [
                                            "A crown without arches or a covering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f92990-9402-4262-aacd-3c839e9840ef",
                                                "sense_id": "8bd37f55-746d-3fc7-b06c-67ca7235ecd4",
                                                "text": "Her faire lockes in rich circlet be enrold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c76947e-055e-384f-923d-aad59803f4b6",
                                        "entry_id": "85b929c9-99c5-3549-8f10-5d4e630d7682",
                                        "glosses": [
                                            "A round body; an orb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "141c50a7-55d7-446d-80f3-34eca0775477",
                                                "sense_id": "1c76947e-055e-384f-923d-aad59803f4b6",
                                                "text": "Fairest of stars […] that crown'st the smiling morn / With thy bright circlet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
