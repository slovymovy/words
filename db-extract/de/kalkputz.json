                "senses": [
                    {
                        "sense_id": "10e9c0d4-ad11-3953-985c-e05d45899697",
                        "entry_id": "aaddd1d8-002a-39d0-b8a8-62c54426306d",
                        "glosses": [
                            "rein mineralischer Putz, der sich ohne andere Bindemittel verfestigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5ffc43-047e-4a7e-a8b5-c5ba2f52b3cd",
                                "sense_id": "10e9c0d4-ad11-3953-985c-e05d45899697",
                                "text": "„Der frische Kalkputz darf nicht von einem durchgängigen Feuchtefilm überzogen werden, das Stauwasser würde das Eindiffundieren von Kohlendioxid verhindern.“"
                            },
                            {
                                "example_id": "cecfb394-dd71-4c85-a6ee-986a7037e277",
                                "sense_id": "10e9c0d4-ad11-3953-985c-e05d45899697",
                                "text": "„Deshalb beugen Kalkputze, im Gegensatz zu nicht saugfähigen Dispersionsfarben, mit pH-Werten über 12 dem mikrobiellen Befall vor.“"
                            },
                            {
                                "example_id": "f4c3ccb0-bd93-4e54-b07f-e50809476e0f",
                                "sense_id": "10e9c0d4-ad11-3953-985c-e05d45899697",
                                "text": "„Die Innenwände der Wohngeschosse haben dieselbe Stärke und sind mit einem Kalkputz versehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
