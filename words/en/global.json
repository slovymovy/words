{
    "word_family": [
        "globe",
        "globalize",
        "globalization",
        "globally",
        "globalism",
        "globalist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e952dd44-2633-3ff7-988d-889beeab0af7",
                    "sense_definition": "Concerning all parts of the world.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_world",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollution is a <w>global</w> problem that requires international cooperation.",
                            "target_lang_translations": {
                                "ru": "Загрязнение — это <w>глобальная</w> проблема, требующая международного сотрудничества.",
                                "zh": "污染是一个<w>全球</w>性问题，需要国际合作。"
                            }
                        },
                        {
                            "text": "The <w>global</w> economy has become increasingly interconnected over the last decade.",
                            "target_lang_translations": {
                                "ru": "<w>Мировая</w> экономика стала все более взаимосвязанной за последнее десятилетие.",
                                "zh": "过去十年中，<w>全球</w>经济变得日益紧密相连。"
                            }
                        }
                    ],
                    "synonyms": [
                        "world-wide",
                        "planetary",
                        "international",
                        "worldwide"
                    ],
                    "antonyms": [
                        "domestic",
                        "national",
                        "local",
                        "regional"
                    ],
                    "common_phrases": [
                        "global warming",
                        "global economy",
                        "global market",
                        "global village"
                    ],
                    "target_lang_definitions": {
                        "ru": "Касающийся всех частей света; всемирный.",
                        "zh": "涉及世界各个部分的；全世界的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глобальный",
                                "target_lang_sense_clarification": "всемирный, всеобщий"
                            },
                            {
                                "target_lang_word": "мировой",
                                "target_lang_sense_clarification": "относящийся к миру в целом"
                            },
                            {
                                "target_lang_word": "всемирный",
                                "target_lang_sense_clarification": "охватывающий весь мир"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全球",
                                "target_lang_sense_clarification": "指覆盖整个地球的范围"
                            },
                            {
                                "target_lang_word": "世界",
                                "target_lang_sense_clarification": "指与世界相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d45a81-b963-361b-bf0a-9057df314182",
                    "sense_definition": "Pertaining to the whole of something; total or universal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_total",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to take a <w>global</w> view of the situation rather than focusing on details.",
                            "target_lang_translations": {
                                "ru": "Нам нужно взглянуть на ситуацию <w>глобально</w>, а не сосредотачиваться на деталях.",
                                "zh": "我们需要从<w>整体</w>角度看待局势，而不是纠结于细节。"
                            }
                        },
                        {
                            "text": "The report provides a <w>global</w> summary of the company's performance.",
                            "target_lang_translations": {
                                "ru": "Отчет предоставляет <w>общую</w> сводку показателей деятельности компании.",
                                "zh": "这份报告提供了公司业绩的<w>全面</w>总结。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "global view",
                        "global approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к целому; общий или всеобъемлющий.",
                        "zh": "与整体相关的；总体的或普遍的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общий",
                                "target_lang_sense_clarification": "касающийся всего в целом"
                            },
                            {
                                "target_lang_word": "глобальный",
                                "target_lang_sense_clarification": "всеохватывающий, масштабный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整体",
                                "target_lang_sense_clarification": "指从全局角度出发"
                            },
                            {
                                "target_lang_word": "全面",
                                "target_lang_sense_clarification": "指涵盖所有方面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e77c209f-23c0-334d-b1f4-a9a03d99a7cc",
                    "sense_definition": "Of a variable, accessible by all parts of a program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>global</w> variable can be accessed by any function in the script.",
                            "target_lang_translations": {
                                "ru": "<w>Глобальная</w> переменная может быть использована любой функцией в скрипте.",
                                "zh": "<w>全局</w>变量可以被脚本中的任何函数访问。"
                            }
                        },
                        {
                            "text": "Using <w>global</w> settings makes it harder to debug the application.",
                            "target_lang_translations": {
                                "ru": "Использование <w>глобальных</w> настроек усложняет отладку приложения.",
                                "zh": "使用<w>全局</w>设置会增加应用程序调试的难度。"
                            }
                        }
                    ],
                    "antonyms": [
                        "local"
                    ],
                    "common_phrases": [
                        "global variable",
                        "global scope"
                    ],
                    "target_lang_definitions": {
                        "ru": "О переменной: доступная из любой части программы.",
                        "zh": "指变量，可被程序的任何部分访问。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глобальный",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全局",
                                "target_lang_sense_clarification": "计算机编程术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "954fcf6e-e920-32c6-8697-760246c85660",
                    "sense_definition": "Spherical or ball-shaped.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the center of the room was a small, <w>global</w> mass.",
                            "target_lang_translations": {
                                "ru": "В центре комнаты находилась небольшая <w>сферическая</w> масса.",
                                "zh": "房间中央有一个小的<w>球形</w>物体。"
                            }
                        },
                        {
                            "text": "The fruit has a distinctively <w>global</w> form.",
                            "target_lang_translations": {
                                "ru": "Фрукт имеет отчетливо <w>шарообразную</w> форму.",
                                "zh": "这种水果有着明显的<w>球形</w>外观。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ball-shaped",
                        "globular",
                        "round",
                        "spherical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий форму шара или сферы.",
                        "zh": "呈球状或球形的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сферический",
                                "target_lang_sense_clarification": "в форме сферы"
                            },
                            {
                                "target_lang_word": "шарообразный",
                                "target_lang_sense_clarification": "похожий на шар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球形",
                                "target_lang_sense_clarification": "指物体的形状"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9e80c005-bd1c-341a-a213-f0203148b4bd",
                    "sense_definition": "In a global manner; world-wide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_world",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to go <w>global</w> with its new marketing campaign.",
                            "target_lang_translations": {
                                "ru": "Компания решила выйти <w>на мировой уровень</w> со своей новой маркетинговой кампанией.",
                                "zh": "公司决定通过新的营销活动<w>走向世界</w>。"
                            }
                        },
                        {
                            "text": "You should think <w>global</w> even when you are acting locally.",
                            "target_lang_translations": {
                                "ru": "Вам следует мыслить <w>глобально</w>, даже когда вы действуете локально.",
                                "zh": "即使在本地行动时，你也应该具备<w>全球</w>视野。"
                            }
                        }
                    ],
                    "synonyms": [
                        "world-wide"
                    ],
                    "antonyms": [
                        "local"
                    ],
                    "common_phrases": [
                        "go global",
                        "think global"
                    ],
                    "target_lang_definitions": {
                        "ru": "В глобальном масштабе; всемирно.",
                        "zh": "以全球性的方式；在世界范围内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глобально",
                                "target_lang_sense_clarification": "наречие"
                            },
                            {
                                "target_lang_word": "на мировой уровень",
                                "target_lang_sense_clarification": "в контексте выхода на рынки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全球性",
                                "target_lang_sense_clarification": "副词性用法"
                            },
                            {
                                "target_lang_word": "走向世界",
                                "target_lang_sense_clarification": "指业务或影响力的扩张"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71fc786f-b8fa-3759-b764-ee84fc332313",
                    "sense_definition": "A globally scoped identifier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Defining too many <w>globals</w> can lead to conflicts in the code.",
                            "target_lang_translations": {
                                "ru": "Определение слишком большого количества <w>глобальных переменных</w> может привести к конфликтам в коде.",
                                "zh": "定义过多的<w>全局变量</w>可能会导致代码冲突。"
                            }
                        },
                        {
                            "text": "The programmer checked the list of <w>globals</w> to find the error.",
                            "target_lang_translations": {
                                "ru": "Программист проверил список <w>глобальных переменных</w>, чтобы найти ошибку.",
                                "zh": "程序员检查了<w>全局变量</w>列表以查找错误。"
                            }
                        }
                    ],
                    "antonyms": [
                        "local"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идентификатор с глобальной областью видимости.",
                        "zh": "具有全局作用域的标识符。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глобальная переменная",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全局变量",
                                "target_lang_sense_clarification": "计算机编程术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}