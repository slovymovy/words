                "entry_id": "99289362-ae75-344a-a2f4-cc1a1a30ed26",
                "word": "pluripotent",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c34b99f-5ecf-374c-b49b-0c8fcb726e17",
                        "entry_id": "99289362-ae75-344a-a2f4-cc1a1a30ed26",
                        "glosses": [
                            "Having much or unlimited potential to develop in a certain way, especially in a desirable fashion."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f82eda3-0389-39ee-a6ff-aa9fe4d4b918",
                        "entry_id": "99289362-ae75-344a-a2f4-cc1a1a30ed26",
                        "glosses": [
                            "Able to develop into more than one mature cell or tissue type, but not all."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e3c3d807-ee4b-447e-a8e7-e0493bbbc953",
                                "sense_id": "3f82eda3-0389-39ee-a6ff-aa9fe4d4b918",
                                "text": "After injecting the virus into the eye, the pluripotent genes were then switched on by feeding the mouse an antibiotic."
                            },
                            {
                                "example_id": "2f26a479-a48c-4e42-9b3a-7f8c160b9049",
                                "sense_id": "3f82eda3-0389-39ee-a6ff-aa9fe4d4b918",
                                "text": "As the embryo grows, ‘pluripotent’ stem cells appear, which are limited in their potency."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e829af24-eb38-4264-ba00-87ad33a3eb59",
                        "source_entry_id": "99289362-ae75-344a-a2f4-cc1a1a30ed26",
                        "source_sense_description": "able to develop into most cell types",
                        "target_lang_word": "pluripotent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluripotent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                        "entry_id": "ba9c58a0-b186-37d8-ab21-94f49363b25c",
                                        "glosses": [
                                            "Se dit d’une cellule qui a la faculté de se différencier en tous les types cellulaires d’un organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86da30d-ba05-483f-85d8-e712dabd8357",
                                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                                "text": "Il est donc tel moment où l’ectoderme pluripotent va se développer en épithèle de revêtement et en épithèle glandulaire."
                                            },
                                            {
                                                "example_id": "4642fcc7-6968-40c4-ab76-7838913de382",
                                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                                "text": "Les cellules nerveuses issues in vitro après différenciation des cellules pluripotentes pourraient être greffées dans le cerveau du patient."
                                            },
                                            {
                                                "example_id": "f32b7af5-628a-4b66-9cbd-e8e69057e80d",
                                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                                "text": "Une étude effectuée sur les cheveux a montré que les kératinocytes pluripotents se trouvaient dans la partie moyenne de la région des gaines épithéliales."
                                            },
                                            {
                                                "example_id": "4555bee8-d948-4de2-b124-a8c18c12c4c2",
                                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                                "text": "Dans la présente étude, l'équipe a marqué des cellules souches pluripotentes humaines (cellules capables de se développer en tous les types de cellules du corps) avec une protéine fluorescente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
