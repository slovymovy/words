                "senses": [
                    {
                        "sense_id": "fdce8190-546c-341d-99a2-e23ffa7bbfc9",
                        "entry_id": "c5aab100-9320-3ae8-a356-20ef2488ad8c",
                        "glosses": [
                            "(männlicher^☆) Bauer, der Feldfrüchte anbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "273f5779-68f4-47d1-a0c2-e52a6ade183b",
                                "sense_id": "fdce8190-546c-341d-99a2-e23ffa7bbfc9",
                                "text": "„Sie waren Ackerbauern und Viehzüchter, die verstreut auf Gehöften oder in kleinen Dörfern wohnten.“"
                            },
                            {
                                "example_id": "e9e61def-18cb-4ab4-a3f8-27d598f4e905",
                                "sense_id": "fdce8190-546c-341d-99a2-e23ffa7bbfc9",
                                "text": "„Die Gülle, die vom Hof nicht vollständig auszubringen ist, wird von Vertragsfirmen mit blankpolierten Tankwagen zum öffentlichen Wirtschaftsdüngerlager, oft auch in andere, teilweise weit entfernt liegende Regionen gefahren, wo die meisten Ackerbauern selbst keine Tiere mehr halten, dafür jedoch für ihren Anbau von Mais, Roggen und Weizen Phosphor, Stickstoff und Spurenelemente gut gebrauchen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aac7f54-9ee5-4c37-81a2-fca6aa282287",
                        "source_entry_id": "c5aab100-9320-3ae8-a356-20ef2488ad8c",
                        "source_sense_id": "fdce8190-546c-341d-99a2-e23ffa7bbfc9",
                        "source_sense_description": "Bauer, der Feldfrüchte anbaut",
                        "target_lang_word": "farmer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "farmer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59761f66-85a1-30b8-94c8-9dfd068a6920",
                                        "entry_id": "bb3d9e82-beaa-3918-9085-24b0a9d1e241",
                                        "glosses": [
                                            "Someone or something that farms, as:",
                                            "A person who works the land and/or who keeps livestock; anyone engaged in agriculture on a farm."
                                        ],
                                        "tags": [
                                            "agent"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b54e8d-4f7c-48c3-9b86-9c88ba0e3fb8",
                                                "sense_id": "59761f66-85a1-30b8-94c8-9dfd068a6920",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f20a69-aabe-3ea6-8c36-2456f383e875",
                                        "entry_id": "bb3d9e82-beaa-3918-9085-24b0a9d1e241",
                                        "glosses": [
                                            "Someone or something that farms, as:",
                                            "More specifically, a farm owner, as distinguished from a farmworker or farmhand as a hired employee thereof."
                                        ],
                                        "tags": [
                                            "British",
                                            "agent",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ed5e9fd-31d6-3fab-a3ef-05ccf420df45",
                                        "entry_id": "bb3d9e82-beaa-3918-9085-24b0a9d1e241",
                                        "glosses": [
                                            "One who takes taxes, customs, excise, or other duties, to collect for a certain rate per cent."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc0e4d20-5eab-4711-bcc3-15fa40418ed3",
                                                "sense_id": "6ed5e9fd-31d6-3fab-a3ef-05ccf420df45",
                                                "text": "a farmer of the revenues"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb6e7343-64d5-3412-bd1a-e23ef7c2131a",
                                        "entry_id": "bb3d9e82-beaa-3918-9085-24b0a9d1e241",
                                        "glosses": [
                                            "The lord of the field, or one who farms the lot and cope of the crown."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fa0c2b0-23c6-3992-ab36-91f9fed14c7b",
                                        "entry_id": "bb3d9e82-beaa-3918-9085-24b0a9d1e241",
                                        "glosses": [
                                            "A regular person; someone who did not receive a prestigious scholarship."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93ad723e-ccea-3b94-b9c5-f93c2089972c",
                                        "entry_id": "bb3d9e82-beaa-3918-9085-24b0a9d1e241",
                                        "glosses": [
                                            "A baby farmer (operator of a rural orphanage)."
                                        ],
