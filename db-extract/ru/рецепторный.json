                    }
                ],
                "senses": [
                    {
                        "sense_id": "fbcd58f0-8270-3fa3-9f47-9a94e044a170",
                        "entry_id": "47566c55-6a98-3fa3-baa6-9e9380e5faf8",
                        "glosses": [
                            "биол. связанный, соотносящийся по значению с существительным рецептор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2315fdc-8b40-49f7-bc52-88ec4ba2dd1b",
                                "sense_id": "fbcd58f0-8270-3fa3-9f47-9a94e044a170",
                                "text": "Обонятельные рецепторные белки принадлежат к суперсемейству мембранносвязанных рецепторов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d278fef7-28d0-4db4-88fc-34e56b08563a",
                        "source_entry_id": "47566c55-6a98-3fa3-baa6-9e9380e5faf8",
                        "source_sense_id": "fbcd58f0-8270-3fa3-9f47-9a94e044a170",
                        "target_lang_word": "receptor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "receptor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb53c54a-9b9d-33b4-96c3-17265a901e32",
                                        "entry_id": "de7204a1-0103-3ec9-a5e8-2124c1746ec7",
                                        "glosses": [
                                            "A protein on a cell wall that binds with specific molecules so that they can be absorbed into the cell in order to control certain functions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd79a65d-cde5-45ba-98e2-9bb70def1a1c",
                                                "sense_id": "fb53c54a-9b9d-33b4-96c3-17265a901e32",
                                                "text": "In the target organ, the drug is recognised by ‘receptors’. These are large molecules, usually proteins, to which the drug binds tightly and with a high degree of specificity."
                                            },
                                            {
                                                "example_id": "d5427bf0-13bc-414f-94d0-5d8f50c36507",
                                                "sense_id": "fb53c54a-9b9d-33b4-96c3-17265a901e32",
                                                "text": "White blood cells of the immune system, the gut and the spleen also have another type of cannabinoid receptor, known as CB2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5a7779-a3b6-3de9-a921-6fb26ad1ef4b",
                                        "entry_id": "de7204a1-0103-3ec9-a5e8-2124c1746ec7",
                                        "glosses": [
                                            "Any specialized cell or structure that responds to sensory stimuli."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "156b1223-84bb-3356-a5fd-0a554d66f64a",
                                        "entry_id": "de7204a1-0103-3ec9-a5e8-2124c1746ec7",
                                        "glosses": [
                                            "One who receives something or someone; in particular, one who harbors a fugitive."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d46e6730-0611-4096-8531-2f6744266907",
                                                "sense_id": "156b1223-84bb-3356-a5fd-0a554d66f64a",
                                                "text": "[…] fewe that were there did spend the same daie abowte the searchinge out of sundrye that were receptors of ffelons, where we fownd a greate manye aswell in London, Westminster, Sowthwarke, as in all other places abowte the same."
                                            },
                                            {
                                                "example_id": "ec606634-2dd4-4811-a789-e01e96845b95",
                                                "sense_id": "156b1223-84bb-3356-a5fd-0a554d66f64a",
                                                "text": "The kind Receptors of the Fugitiues after the Detection."
                                            },
                                            {
                                                "example_id": "fc881bab-b0bb-4118-ac8b-21f2f6a1bea7",
                                                "sense_id": "156b1223-84bb-3356-a5fd-0a554d66f64a",
                                                "text": "An act […] Against pyrats, their assistors or abettors, out-traidors or receptors, against breakers of the admirall's arrestments and attachments against goods forbidden,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
