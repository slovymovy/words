                "senses": [
                    {
                        "sense_id": "9258677e-40bf-39de-b96d-3e1d71434e7d",
                        "entry_id": "ece8091f-24de-3676-aac7-a0b0af1c388d",
                        "glosses": [
                            "Behälter/Tank, der mit Wasser oder Luft gefüllt werden kann, um den Auftrieb eines U-Boots nach Bedarf zu regeln"
                        ],
                        "tags": [
                            "U-Boot-Bau"
                        ],
                        "examples": [
                            {
                                "example_id": "44037a74-4c4a-411a-8daa-4039b04bef24",
                                "sense_id": "9258677e-40bf-39de-b96d-3e1d71434e7d",
                                "text": "„Der Kommandant lässt Pressluft in die Tauchzellen blasen.“"
                            },
                            {
                                "example_id": "a51a149e-199e-4b7c-9a3f-5847809e3fa1",
                                "sense_id": "9258677e-40bf-39de-b96d-3e1d71434e7d",
                                "text": "„Die innere Tauchzelle ist so dimensioniert, daß das Boot, wenn die äußeren beschädigt werden, allein auf ihr schwimmen kann.“"
                            },
                            {
                                "example_id": "6a0e742e-d1bd-4913-959b-920f878308ba",
                                "sense_id": "9258677e-40bf-39de-b96d-3e1d71434e7d",
                                "text": "„Das in einer niederländischen Werft gebaute Boot verfügt denn auch über „echte“ Tauch- und Regelzellen wie sie von den U-Boot-Filmen bekannt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
