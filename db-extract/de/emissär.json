                        "glosses": [
                            "Bote mit einem meist geheimen Auftrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d04faaf5-fc8c-4e93-a8e1-337e29af6023",
                                "sense_id": "be2d0b7c-e24e-3f99-94d3-ba62eee8aacc",
                                "text": "„Mit Geld, das ihnen die Stadt zur Verfügung gestellt hatte, begannen die Frankfurter Emissäre in Frankreich, Belgien und den Niederlanden ihre Aufkäufe; sie wußten, daß diese Kunst in Deutschland fünf- oder sechsmal so hohe Preise erzielen würde.“"
                            }
                        ],
