                        "entry_id": "56c2d722-138a-32b5-9369-314f991af463",
                        "glosses": [
                            "an obstructor, a hinderer, an obstructionist (one who is uncooperative and seeks to thwart something)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "adb7336f-d41f-4e86-b248-a8cc730e9b9a",
                                "sense_id": "1f62e5f9-48ec-3a15-a595-061fb0b9e550",
                                "text": "Ze verdacht de dwarsligger ervan een infiltrant te zijn.",
                                "translation": "She suspected the obstructionist of being an infiltrator.",
                                "english": "She suspected the obstructionist of being an infiltrator."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fc55e9f-33e8-373e-af6a-21e7834ea311",
                        "entry_id": "56c2d722-138a-32b5-9369-314f991af463",
                        "glosses": [
                            "a sleeper, a railroad tie"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8f52531d-cc5e-49b2-857a-acf06c2e72e7",
                                "sense_id": "2fc55e9f-33e8-373e-af6a-21e7834ea311",
                                "text": "Een paar van de dwarsliggers bleken verrot.",
                                "translation": "A few of the sleepers turned out to be rotten.",
                                "english": "A few of the sleepers turned out to be rotten."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7e9a4b7-1855-3da1-9f44-7a085f185b47",
                        "entry_id": "56c2d722-138a-32b5-9369-314f991af463",
                        "glosses": [
                            "a small book with its text aligned parallel to the spine"
                        ],
                        "tags": [
