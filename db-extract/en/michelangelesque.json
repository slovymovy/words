                        "sense_id": "5c90b8c9-6677-3a0c-8790-7cd5477e9116",
                        "entry_id": "283cd3c7-bb22-3d3c-80b0-d93f2d5ffe23",
                        "glosses": [
                            "Resembling or relating to the works of the artist Michelangelo (1475–1564)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4bc5ece-a2bb-4d27-82f1-4aa32119d922",
                                "sense_id": "5c90b8c9-6677-3a0c-8790-7cd5477e9116",
                                "text": "The lady in question, at all events, with her slightly Michaelangelesque squareness, her eyes of other days, her full lips, her long neck, her recorded jewels, her brocaded and wasted reds, was a very great personage—only unaccompanied by a joy. And she was dead, dead, dead."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "601e32b0-d114-4230-9e78-6f61e9c19a60",
                        "source_entry_id": "283cd3c7-bb22-3d3c-80b0-d93f2d5ffe23",
                        "source_sense_id": "5c90b8c9-6677-3a0c-8790-7cd5477e9116",
