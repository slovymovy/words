                "senses": [
                    {
                        "sense_id": "a9eb2bbe-8cc9-3667-b9ae-0cc52fc10a50",
                        "entry_id": "8a05dda2-f2b3-3744-8cb0-e3ef7cf89f6e",
                        "glosses": [
                            "Kind, das durch Flucht seine angestammte Heimat verlassen musste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb212fb2-170b-48be-9af7-4242e0c7578d",
                                "sense_id": "a9eb2bbe-8cc9-3667-b9ae-0cc52fc10a50",
                                "text": "„Das schmale Heft über Flüchtlingskinder erzählt von den häufig ganz unscheinbaren Spuren der Gewalt.“"
                            },
                            {
                                "example_id": "1249524d-9983-4101-88de-b79ac2ce3534",
                                "sense_id": "a9eb2bbe-8cc9-3667-b9ae-0cc52fc10a50",
                                "text": "„In der ersten Klasse malte das Flüchtlingskind Ibrahim Totenköpfe und blutverschmierte Menschen, die Blumenbilder seiner Mitschüler verstand er nicht.“"
                            },
                            {
                                "example_id": "e411cd4e-33c3-4746-8c72-33a57902caea",
                                "sense_id": "a9eb2bbe-8cc9-3667-b9ae-0cc52fc10a50",
                                "text": "„Die Barmherzigen Schwestern betreiben in der Diözese Broumana im Libanon eine Schule und ein Internat. Am Unterricht nehmen zur Zeit auch 57 syrische Flüchtlingskinder Teil.“"
                            },
                            {
                                "example_id": "4a463178-bd55-4ded-a93d-e35c8cd6adc7",
                                "sense_id": "a9eb2bbe-8cc9-3667-b9ae-0cc52fc10a50",
                                "text": "„3500 Euro kamen am Ende als Spende für die Schule für syrische Flüchtlingskinder in der Türkei zusammen.“"
                            },
                            {
                                "example_id": "58ba03d0-fd17-46bf-9b40-482bc47bf480",
                                "sense_id": "a9eb2bbe-8cc9-3667-b9ae-0cc52fc10a50",
                                "text": "„Sie erzählte ihm viel von ihrer Arbeit mit palästinensischen Flüchtlingskindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
