                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2fbc870d-9826-3568-a01e-e4c0be6aec10",
                        "entry_id": "1a2bbcae-02c4-368c-a6b7-6407616b47e1",
                        "glosses": [
                            "proces zanikania gatunków lub innej grupy taksonomicznej organizmów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b59e61f-42fb-46f3-ae7c-f1bb05c11892",
                                "sense_id": "2fbc870d-9826-3568-a01e-e4c0be6aec10",
                                "text": "Do tego rodzaju wymierania, będącego wynikiem konkurencji międzygatunkowej i realizacją postępu w ewolucji, dodać należy wymieranie powodowane przez losowe zmiany środowiska lub geologiczną ewolucję masywów kontynentalnych."
                            },
                            {
                                "example_id": "699346cf-0794-4d01-b377-fc50d6653dcf",
                                "sense_id": "2fbc870d-9826-3568-a01e-e4c0be6aec10",
                                "text": "Zdarzenie to, określane jako ordowickie wymieranie, uważane jest za drugą największą katastrofę w historii życia na Ziemi."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
