                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c5f769-3cb5-4cbf-97f6-82b7155fdca8",
                                "sense_id": "1d119328-3bb9-3b7d-8da2-3cf8dce7f2b1",
                                "text": "„Der hochgewachsene, streitlustige Rotschopf und Philip hatten mehr gemeinsam als hochherzige Sympathien für den kleinen Mann; beide waren zum Beispiel große Baseballfans, und an Sonntagnachmittagen übte Irv mit dem Jungen oder ging mit ihm zu einem Dodgers-Spiel in Ebbets Field.“"
                            },
                            {
                                "example_id": "8a4420f6-58ba-49e4-9c91-c5981d21ec5b",
                                "sense_id": "1d119328-3bb9-3b7d-8da2-3cf8dce7f2b1",
                                "text": "„Heute ist der durchschnittliche Baseballfan in den USA 57 Jahre alt.“"
                            }
                        ],
