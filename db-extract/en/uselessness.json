        "de-extract.jsonl": [
            {
                "entry_id": "1d5d0f73-dbfb-3c11-acc5-ccd51e7fb740",
                "word": "uselessness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7f3015d-a3fa-3ef6-88e1-9f77165d3b99",
                        "entry_id": "1d5d0f73-dbfb-3c11-acc5-ccd51e7fb740",
                        "glosses": [
                            "Zustand, ohne Nutzen zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf8b604-9917-495b-8629-83516feb0495",
                                "sense_id": "a7f3015d-a3fa-3ef6-88e1-9f77165d3b99",
                                "text": "\"Art's uselessness appears to be contradicted by the persistence of men and women in doing art throughout history.\"",
                                "translation": "Der Nutzlosigkeit von Kunst scheint die Beharrlichkeit von Männern und Frauen zu widersprechen, sie durch die Geschichte hinweg auszuüben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3aca3c7d-23f7-4e62-a5d2-3321419c16fe",
                        "source_entry_id": "1d5d0f73-dbfb-3c11-acc5-ccd51e7fb740",
                        "source_sense_id": "a7f3015d-a3fa-3ef6-88e1-9f77165d3b99",
                        "source_sense_description": "Zustand, ohne Nutzen zu sein",
                        "target_lang_word": "Nutzlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nutzlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc36fecc-a128-3479-8bb0-09e42d4d5a3a",
                                        "entry_id": "c042c226-a0c0-34ab-8415-94ef128a13cd",
                                        "glosses": [
                                            "Zustand, ohne Nutzen zu sein/zu nichts gut zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d272944f-80d0-4206-9726-f6b9a73dfd87",
                                                "sense_id": "fc36fecc-a128-3479-8bb0-09e42d4d5a3a",
                                                "text": "„Der Fluch der untätigen Nutzlosigkeit war in diesem Moment von uns genommen, braune Kristalle rieselten nun aus den aufgeschlitzten Säcken unaufhaltsam in die Tiefen des Schiffsbauchs hinab.“"
                                            },
                                            {
                                                "example_id": "9682d776-4dcd-4794-b99e-7f4d3a606641",
                                                "sense_id": "fc36fecc-a128-3479-8bb0-09e42d4d5a3a",
                                                "text": "„Offenbar existiert ein tiefes Bedürfnis, sich in der Welt der Effizienz mal eine Zeitlang einer anstrengenden Nutzlosigkeit zu widmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "688dae53-8a70-49e1-a119-61dc9974fbb3",
                        "source_entry_id": "1d5d0f73-dbfb-3c11-acc5-ccd51e7fb740",
                        "source_sense_id": "a7f3015d-a3fa-3ef6-88e1-9f77165d3b99",
                        "source_sense_description": "Zustand, ohne Nutzen zu sein",
                        "target_lang_word": "Unbrauchbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unbrauchbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "206f1902-182b-3bec-a26c-ba364adb6eec",
                                        "entry_id": "54287a92-4456-3f2a-9532-a578e0523a1b",
                                        "glosses": [
                                            "Eigenschaft von etwas/jemandem, nicht zu benutzen/zu nichts nütze zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3492f6-7b9b-4a40-96d7-c9f234e855ef",
                                                "sense_id": "206f1902-182b-3bec-a26c-ba364adb6eec",
                                                "text": "Ich schmeiße dieses Gerät weg, weil die Unbrauchbarkeit zu hoch ist."
                                            },
                                            {
                                                "example_id": "02eacf6b-3f85-436d-aa8d-0313f94b00be",
                                                "sense_id": "206f1902-182b-3bec-a26c-ba364adb6eec",
                                                "text": "„Obwohl auch das Land inzwischen die Unbrauchbarkeit der Gutachten einräumt, weist es bisher alle Forderungen zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
