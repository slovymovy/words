                        "cross_references": []
                    },
                    {
                        "translation_id": "b1a1046e-539e-4b6b-83b0-04211a04cfff",
                        "source_entry_id": "66c3ec20-739a-363d-99c4-7c2f772d77b1",
                        "source_sense_id": "4665626a-8a4f-30a4-976d-57bbea6e1254",
                        "target_lang_word": "tilt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09205bcf-224b-3e33-af94-dd73c2d9a181",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To slope or incline (something); to slant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356f2851-0d5a-491d-b6cf-b04fd00285ca",
                                                "sense_id": "09205bcf-224b-3e33-af94-dd73c2d9a181",
                                                "text": "Tilt the barrel to pour out its contents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3af01c3-265b-381e-b674-b7f776c135be",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To be at an angle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a05d252-be63-4550-aacd-38abf76d9edc",
                                                "sense_id": "e3af01c3-265b-381e-b674-b7f776c135be",
                                                "text": "For as the Trunk of the Body, is kept from tilting forvvard by the Muſcules of the Back: So, from falling backvvard, by theſe of the Belly."
                                            },
                                            {
                                                "example_id": "58d27fd4-3f95-49ec-8650-c26598d61b35",
                                                "sense_id": "e3af01c3-265b-381e-b674-b7f776c135be",
                                                "text": "“Marge Gets A Job” opens with the foundation of the Simpson house tilting perilously to one side, making the family homestead look like the suburban equivalent of the Leaning Tower Of Pisa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0c9790-3619-33de-8343-c634b29e062f",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To charge (at someone) with a lance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d644c146-9d8c-477a-9bed-ea0cb0430806",
                                                "sense_id": "0d0c9790-3619-33de-8343-c634b29e062f",
                                                "text": "Auster and Aquilon with winged Steeds / All ſweating, tilt about the watery heauens, / With ſhiuering ſpeares enforcing thunderclaps, / And from their ſhields ſtrike flames of lightening"
                                            },
                                            {
                                                "example_id": "fb780b01-b668-4c2b-850d-8b78aca32690",
                                                "sense_id": "0d0c9790-3619-33de-8343-c634b29e062f",
                                                "text": "He tilts / With piercing steel at bold Mercutio's breast."
                                            },
                                            {
                                                "example_id": "a7e74172-ab2a-4ce8-b0c7-0b313ae6a39d",
                                                "sense_id": "0d0c9790-3619-33de-8343-c634b29e062f",
                                                "text": "But in this tournament can no man tilt, / Except the lady he loves best be there."
                                            },
                                            {
                                                "example_id": "b53ef6ae-6f26-45cd-baf0-11fc71ef2fab",
                                                "sense_id": "0d0c9790-3619-33de-8343-c634b29e062f",
                                                "text": "Mr. Smith strongly tilts at Mr. McCarter's use of the adjective \"unprepossessing\" to describe the station buildings at Moniaive and elsewhere; [...]."
                                            },
                                            {
                                                "example_id": "25e09a40-780e-432a-a566-d4bc37bc02d4",
                                                "sense_id": "0d0c9790-3619-33de-8343-c634b29e062f",
                                                "text": "At Offham, in Kent, tilting at the quintain provides a climax to the day's revels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc81be82-ebff-3081-9d3d-451c6449ecee",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To point or thrust a weapon at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0887d5e6-c81f-4d09-a071-5e59ab92f28c",
                                                "sense_id": "fc81be82-ebff-3081-9d3d-451c6449ecee",
                                                "text": "And he should tilt her?"
                                            },
                                            {
                                                "example_id": "9ca278c9-d2cd-4a52-bce4-ef791cda8ad4",
                                                "sense_id": "fc81be82-ebff-3081-9d3d-451c6449ecee",
                                                "text": "I say I quarrel’d with you; / We did not tilt each other – that’s a blessing, – / Good gods! no innocent blood upon my head!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b845c7de-13e1-33e2-b416-786538a6f5ad",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To point or thrust (a weapon)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e962a64-4631-472b-a73f-aa3748040d7d",
                                                "sense_id": "b845c7de-13e1-33e2-b416-786538a6f5ad",
                                                "text": "Sons against fathers tilt the fatal lance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c309232-0e24-3139-9ac2-71f479f91d7d",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To forge (something) with a tilt hammer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43fe3f1e-cc63-41c3-b7ae-37dc01fea89d",
                                                "sense_id": "5c309232-0e24-3139-9ac2-71f479f91d7d",
                                                "text": "to tilt steel in order to render it more ductile"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c7b529c-4fc3-3621-808e-e6a3f44ac91b",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To intentionally let the ball fall down to the drain by disabling flippers and most targets, done as a punishment to the player when the machine is nudged too violently or frequently."
                                        ],
                                        "tags": [
                                            "of a machine"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8836499c-15b1-31d8-b61c-d07dbfc5976c",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To enter a state of frustration and worsened performance resulting from a series of losses."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e42fe62b-1460-41ed-bc0d-4c2068c0a958",
                                                "sense_id": "8836499c-15b1-31d8-b61c-d07dbfc5976c",
                                                "text": "The D.F.S. industry is still inextricably tied up in those poker roots. Players talk about \"tilting\" because of \"variance,\" especially when a \"fish\" puts in a \"donkey\" lineup that ends up going crazy. (In regular American English, this translates roughly to \"I am really mad because some idiot punched in some random lineup that ended up catching every conceivable break and beating me.\")"
                                            },
                                            {
                                                "example_id": "4b557622-0be1-4528-9733-ca8fce6aa595",
                                                "sense_id": "8836499c-15b1-31d8-b61c-d07dbfc5976c",
                                                "text": "Even the best players can tilt which can cause their performance to drop significantly. Players often tilt when they're on a losing spree or frustrated with the game."
                                            },
                                            {
                                                "example_id": "927d599c-2460-4444-9a88-cf7147a6a4ba",
                                                "sense_id": "8836499c-15b1-31d8-b61c-d07dbfc5976c",
                                                "text": "This was yet another surprising momentum swing, with Nepomniachtchi seemingly having addressed his tendency to tilt after a loss, and with Ding crashing back down to Earth after having squared the ledger in the previous game. Is this a new Nepomniachtchi, capable of digging deep and avenging losses?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d90fd2f-1866-316b-b0e3-e6c1c39f546b",
                                        "entry_id": "5a561d23-f0e5-3b3f-ace3-0f0c5a72eb40",
                                        "glosses": [
                                            "To modify one's approach."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bee43b2-e4a9-4fd6-8105-4b4ea0bad7dd",
                                                "sense_id": "7d90fd2f-1866-316b-b0e3-e6c1c39f546b",
                                                "text": "While self-checkout machines are often used alongside cashiers, labor unions say that tilting toward fully cashierless operations threatens the French way of life by encouraging American-style consumerism and automation, putting thousands of jobs at risk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c8a453-6c47-33e9-8989-87870d1ef2af",
                                        "entry_id": "37a91a52-35a6-338a-9011-f316ca133f47",
