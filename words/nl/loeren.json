{
    "word_family": [
        "beloeren",
        "loer",
        "loerbakkes",
        "loergedraai"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e39f8ed-32f1-3026-befb-77074ccdd09d",
                    "sense_definition": "Intensief en vaak met kwade bedoelingen naar iemand of iets kijken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die vreemde man zat de hele tijd naar de voorbijgangers te <w>loeren</w>.",
                            "target_lang_translations": {
                                "en": "That strange man was <w>leering</w> at the passers-by the whole time."
                            }
                        },
                        {
                            "text": "Ik voelde me ongemakkelijk omdat hij naar mijn computerscherm zat te <w>loeren</w>.",
                            "target_lang_translations": {
                                "en": "I felt uncomfortable because he was <w>peering</w> at my computer screen."
                            }
                        }
                    ],
                    "synonyms": [
                        "gluren",
                        "spieden"
                    ],
                    "common_phrases": [
                        "naar iemand loeren",
                        "stiekem loeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To look at someone or something intensely, often with bad intentions or in a sneaky way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to leer",
                                "target_lang_sense_clarification": "with unpleasant or sexual intent"
                            },
                            {
                                "target_lang_word": "to peer",
                                "target_lang_sense_clarification": "looking closely or with difficulty"
                            },
                            {
                                "target_lang_word": "to spy",
                                "target_lang_sense_clarification": "watching secretly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74e10299-e0c6-30d7-a015-6b46864d4c6c",
                    "sense_definition": "Geduldig wachten op een geschikt moment om toe te slaan of iets te bemachtigen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wachten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat zat urenlang in het gras te <w>loeren</w> op een muis.",
                            "target_lang_translations": {
                                "en": "The cat sat <w>lying in wait</w> in the grass for a mouse for hours."
                            }
                        },
                        {
                            "text": "Hij <w>loert</w> op die ene kans om promotie te maken binnen het bedrijf.",
                            "target_lang_translations": {
                                "en": "He is <w>watching for</w> that one chance to get a promotion within the company."
                            }
                        }
                    ],
                    "synonyms": [
                        "beloeren",
                        "opwachten"
                    ],
                    "common_phrases": [
                        "loeren op een kans",
                        "op een prooi loeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To wait patiently for a suitable moment to strike or to obtain something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lie in wait",
                                "target_lang_sense_clarification": "waiting to ambush"
                            },
                            {
                                "target_lang_word": "to watch for",
                                "target_lang_sense_clarification": "waiting for an opportunity"
                            },
                            {
                                "target_lang_word": "to lurk",
                                "target_lang_sense_clarification": "waiting hidden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12df7da3-d8e7-3667-98fb-0ac2a7f8e3d9",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>loer</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben hem verschillende <w>loeren</w> gedraaid tijdens zijn carrière.",
                            "target_lang_translations": {
                                "en": "They played several <w>tricks</w> on him during his career."
                            }
                        },
                        {
                            "text": "Pas op dat ze je geen gemene <w>loeren</w> draaien bij die verkoop.",
                            "target_lang_translations": {
                                "en": "Watch out that they don't play any mean <w>tricks</w> on you during that sale."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand loeren draaien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of loer"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'loer', referring to tricks or practical jokes played on someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tricks",
                                "target_lang_sense_clarification": "deceptive acts"
                            },
                            {
                                "target_lang_word": "pranks",
                                "target_lang_sense_clarification": "mischievous acts"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}