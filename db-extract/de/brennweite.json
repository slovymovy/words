                        "entry_id": "167c108c-9d88-3b66-ae1e-bfaabbda5040",
                        "glosses": [
                            "Abstand des Brennpunkts von der Hauptebene eines optischen Systems"
                        ],
                        "tags": [
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "1010fa2c-a9a1-4b0a-8a60-b5948942b384",
                                "sense_id": "326bae49-144d-37f5-889c-028be1dbb4af",
                                "text": "Teleobjektive haben eine große Brennweite."
                            },
                            {
                                "example_id": "249dabe2-be39-4b3a-9aba-d1280ff56b81",
                                "sense_id": "326bae49-144d-37f5-889c-028be1dbb4af",
                                "text": "„Zoomobjektive mit ihrer variablen Brennweite sind praktisch, weil sie vom Weitwinkel fürs Panorama bis zum leichten Tele für Porträts zahlreiche Aufnahmesituationen abdecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
