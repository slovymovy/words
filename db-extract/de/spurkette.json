                "senses": [
                    {
                        "sense_id": "f2103c0a-b8a5-36d7-a907-6df7bd047332",
                        "entry_id": "652d2e7b-0934-3b46-a84f-741e60b6d33d",
                        "glosses": [
                            "Kette, die auf den Rädern der Lenkachse(n) montiert wird und den Rädern eine Längsführung gibt, um ein seitliches Wegrutschen zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf22145-2b73-4729-9e5a-444faad9b132",
                                "sense_id": "f2103c0a-b8a5-36d7-a907-6df7bd047332",
                                "text": "„Spurketten verfügen über Kettenstränge v. a. in Laufrichtung und werden daher nur auf Lenkachsen aufgezogen. Heutige Schneeketten für PKW bzw. LKW verfügen meist über Kombinationen aus schräg verlaufenden Kettenstücken und sind damit eine Mischung aus Antriebs- und Spurkette.“"
                            },
                            {
                                "example_id": "682fc427-33cb-4244-bd01-ae61f12260c1",
                                "sense_id": "f2103c0a-b8a5-36d7-a907-6df7bd047332",
                                "text": "„Die Spurkette, bei der in der Reifenmitte zwischen den Quadranten ein oder zwei Längsstücke nebeneinander angeordnet sind, gibt eine sichere Führung der Räder in Längsrichtung; sie wird gern als Geländekette benutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
