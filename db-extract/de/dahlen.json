                ],
                "senses": [
                    {
                        "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                        "entry_id": "c3ad6c04-32ed-397b-8a10-692dfd89b38a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "229b63a9-39fd-4b19-ab61-22950612dcca",
                                "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                                "text": "Frau Dahlen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "32184dba-e9f5-4d97-816c-235a46b6fc44",
                                "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                                "text": "Herr Dahlen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0775b543-ad99-4693-a250-2166940308f7",
                                "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                                "text": "Die Dahlens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bfca679d-ba35-49f1-b353-e059b7b9fb0a",
                                "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                                "text": "Der Dahlen trägt nie die Schals, die die Dahlen ihm strickt."
                            },
                            {
                                "example_id": "853700bf-385c-4f12-9721-d42bfff4aecc",
                                "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dahlen kommt, geht der Herr Dahlen.“"
                            },
                            {
                                "example_id": "5fb77476-fd14-4236-9d12-8c42a90a675b",
                                "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                                "text": "Dahlen kommt und geht."
                            },
                            {
                                "example_id": "615dca6d-046d-420c-9e20-5b2c0009e240",
                                "sense_id": "d1257f48-fcdf-333a-ad16-6827a40f362a",
                                "text": "Dahlens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
