                                        "glosses": [
                                            "Having a peak or peaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc71874-4507-41f1-9be9-9dd6e00bf8fb",
                                                "sense_id": "b07a848c-1b61-329a-8390-319046118395",
                                                "text": "The wizard wore a peaked cap."
                                            }
