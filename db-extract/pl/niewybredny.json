                                                "sense_id": "347f35b6-ad47-37e8-b5cf-8dc1d0dc6a79",
                                                "text": "Der Stein ist bisher nur grob behauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0aded1fb-5209-3e84-9803-9ff82974f5f8",
