        "fr-extract.jsonl": [
            {
                "entry_id": "7f1db22f-1dd5-3e0b-9a5b-21da58352717",
                "word": "relent",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2c22aac0-9da6-41f9-8355-b09192a3459b",
                        "entry_id": "7f1db22f-1dd5-3e0b-9a5b-21da58352717",
                        "tags": [
                            "plural"
                        ],
                        "form": "relents"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b44ffbc-1726-353b-b958-96fb23422717",
                        "entry_id": "7f1db22f-1dd5-3e0b-9a5b-21da58352717",
                        "glosses": [
                            "Mauvaise odeur qui persiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e5544b-43b8-49e0-85fe-59f78a41c1d7",
                                "sense_id": "3b44ffbc-1726-353b-b958-96fb23422717",
                                "text": "Sans doute aussi de ces choux équivoques dont les abominables relents empuantaient avec une obstination digne d’éloges le palier de leur cinquième étage."
                            },
                            {
                                "example_id": "c8afcbe4-9680-4f08-bebb-42357fb2ad27",
                                "sense_id": "3b44ffbc-1726-353b-b958-96fb23422717",
                                "text": "Et soulevant à eux deux le fauteuil dans lequel Amédée balancé, aux trois quarts évanoui, se laissait faire, ils le mirent à même de respirer, au lieu des relents du couloir, les puanteurs variées de la rue."
                            },
                            {
                                "example_id": "72d9d801-76f0-41d9-9c1d-09ee7c347c0b",
                                "sense_id": "3b44ffbc-1726-353b-b958-96fb23422717",
                                "text": "La poussière du Vieux-Port, chargée de salures, éparpille un relent lointain de choses épicées."
                            },
                            {
                                "example_id": "7aff25ff-ba96-44d9-8112-ad59b8a7be4d",
                                "sense_id": "3b44ffbc-1726-353b-b958-96fb23422717",
                                "text": "Un relent d’encens stagnait dans la pièce, du jardin me parvenaient les trilles joyeuses d'un rossignol à la pleine lune, […]."
                            },
                            {
                                "example_id": "14dfc510-a260-4f6b-bf9b-2e9ab6d96e74",
                                "sense_id": "3b44ffbc-1726-353b-b958-96fb23422717",
                                "text": "Elle craint le relent insidieux que peut dégager une plaie ouverte, et s’inonde d’eaux de toilette."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ab1d722-6f7e-3169-bf46-dba6ceb2622c",
                        "entry_id": "7f1db22f-1dd5-3e0b-9a5b-21da58352717",
                        "glosses": [
                            "Ce qui reste, qui est dans le fond."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2eb789a0-8e42-4e50-9269-be5ce095ed54",
                                "sense_id": "3ab1d722-6f7e-3169-bf46-dba6ceb2622c",
                                "text": "Vers 1913, après la mort de Noémi, l’oncle qui avait hérité du 26 rue Marais découvrit quelques pièces cachées à l’entresol, éclairées seulement par des jours presque invisibles, pleines du relent un peu équivoque du passé."
                            },
                            {
                                "example_id": "dfe81b27-0593-412d-bb00-fd5dd6f479ca",
                                "sense_id": "3ab1d722-6f7e-3169-bf46-dba6ceb2622c",
                                "text": "Ce phénomène est encore plus marqué au Canada français, qui est systématiquement montré du doigt dans le reste du pays au cours d’une campagne de presse aux forts relents francophobes."
                            },
                            {
                                "example_id": "f2911c82-2215-4dd6-928b-46c48739a6c7",
                                "sense_id": "3ab1d722-6f7e-3169-bf46-dba6ceb2622c",
                                "text": "Jusqu’au 20 janvier 2021, personne ne peut prévoir l’issue de la situation actuelle aux relents de guerre civile, qui risque de dégénérer davantage."
                            },
                            {
                                "example_id": "bc2a9e82-fd29-4c36-a0b4-d22907e528a3",
                                "sense_id": "3ab1d722-6f7e-3169-bf46-dba6ceb2622c",
                                "text": "Je ne sais pas vous, mais j’ai un peu la gerbe ces jours-ci, comme si un vieux reste d’huître m’était resté coincé au fond de la gorge et distillait encore ses relents d’intoxication."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e8cc3e8-d7a2-408c-98a2-92829c4f3c03",
                        "source_entry_id": "7f1db22f-1dd5-3e0b-9a5b-21da58352717",
                        "target_lang_word": "Brodem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brodem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                        "entry_id": "49a8c72e-97a9-3c1e-a5f9-c508ad405c03",
                                        "glosses": [
                                            "Luft voller Dunst und Gerüchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46dbfc2d-bbbb-40ec-95d2-edbf2225b2f2",
                                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                                "text": "Was für ein höllischer Brodem quillt hier empor!"
                                            },
                                            {
                                                "example_id": "25fbb3b3-547a-4d5b-9ff4-a2161e5f76fa",
                                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                                "text": "„Ein dicker Brodem von Körperlichkeit, ein Gestank nach schofelster Sinnlichkeit macht sich immer breiter.“"
                                            },
                                            {
                                                "example_id": "868d69ed-4f1a-4c5f-aded-f0a200a07ff2",
                                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                                "text": "„Sobald das Wellfleisch fertig ist, werden die ersten Gäste betafelt, und der Brodem vom toten Schwein zieht ins Haus ein.“"
                                            },
                                            {
                                                "example_id": "b345c78c-2969-4eee-b2ea-a228b8a44d63",
                                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                                "text": "„Der Rauch und Qualm, der wie ein dicker, stickiger Brodem über den Straßen liegt, wird von den tiefhängenden Wolken niedergehalten und in die Straßenzeilen zurückgedrückt.“"
                                            },
                                            {
                                                "example_id": "e25dc402-7e23-4ef5-a44b-6e8db3fa3f6c",
                                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                                "text": "„In diesem gelbroten Brodem lag die Frau auf dem Bett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
