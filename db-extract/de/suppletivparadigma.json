                "senses": [
                    {
                        "sense_id": "b2185b62-7ea6-3665-894a-23b9bd438fe0",
                        "entry_id": "89a13d3e-422f-32c6-ae61-1cd6139d266a",
                        "glosses": [
                            "Flexions- oder Komparationsschema, bei dem die einzelnen Formen von unterschiedlichen Wortstämmen (durch Suppletion) gebildet werden"
                        ],
                        "tags": [
                            "Linguistik (Sprachwissenschaft)"
                        ],
                        "examples": [
                            {
                                "example_id": "63095a03-cb91-4d31-bc72-e902e0a1ce1b",
                                "sense_id": "b2185b62-7ea6-3665-894a-23b9bd438fe0",
                                "text": "Die Steigerung (Komparation) von „gut“ ist ein Beispiel für ein Suppletivparadigma, in dem der Positiv „gut“ einen anderen Wortstamm aufweist als der Komparativ „besser“."
                            },
                            {
                                "example_id": "2910b4dc-a6d4-4f4f-b4bc-486c1296241a",
                                "sense_id": "b2185b62-7ea6-3665-894a-23b9bd438fe0",
                                "text": "Die Konjugation des Hilfsverbs „sein“ im Indikativ Präsens mit dem Formen „bin, bist, ist, sind, seid“ ist ebenfalls ein Beispiel für ein Suppletivparadigma."
                            },
                            {
                                "example_id": "f74c1451-baed-40f6-9729-c46f512ff171",
                                "sense_id": "b2185b62-7ea6-3665-894a-23b9bd438fe0",
                                "text": "„Darüber hinaus wären noch spezielle Annahmen beim Suppletivparadigma sein zu machen.“"
                            },
                            {
                                "example_id": "ac48a825-3c22-4df4-bab5-886ab8f79a48",
                                "sense_id": "b2185b62-7ea6-3665-894a-23b9bd438fe0",
                                "text": "„Diese Prognose bezieht sich vorzugsweise auf nicht-suppletive Paradigmen; sie soll nun durch einen Seitenblick auf Suppletivparadigmen ergänzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
