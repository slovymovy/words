                                        "entry_id": "0f200096-924f-390e-9a60-3ac8ced949bb",
                                        "glosses": [
                                            "Variante eines Atoms, mit gleicher Protonenzahl, aber mit verschiedener Neutronenzahl im Atomkern"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880412ad-7586-4534-9412-da02a01fb34f",
                                                "sense_id": "b8bff777-f11c-355d-92b5-f796955489fa",
                                                "text": "Das Element Wasserstoff (H) hat drei Isotope: ¹H (Protium) ohne Neutron, Deuterium mit einem Neutron und Tritium mit zwei Neutronen, jeweils mit einem Proton."
                                            },
                                            {
                                                "example_id": "f43de4e2-e53a-4da3-bc46-a9c1cc14468c",
                                                "sense_id": "b8bff777-f11c-355d-92b5-f796955489fa",
                                                "text": "„Was ihm half, sein fünftes und sechstes Lebensjahrzehnt zu überstehen, waren seine Frau Claire, seine zwei Kinder und sein neues Forschungsgebiet: die Anwendung von radioaktiven Isotopen bei der Therapie bösartiger Krankheiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
