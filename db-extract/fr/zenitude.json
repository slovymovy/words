                        "examples": [
                            {
                                "example_id": "948e0f79-92cb-4926-94b8-f2907d9a231b",
                                "sense_id": "6cae9af1-2f77-3e9a-9ca2-3846979aaf5b",
                                "text": "En temps normal, je passais sur beaucoup de choses mais là, il y avait un besoin de temps pour retrouver une certaine zenitude."
                            },
                            {
                                "example_id": "04a5b03c-8267-47b8-875c-6c556d77a8c0",
                                "sense_id": "6cae9af1-2f77-3e9a-9ca2-3846979aaf5b",
                                "text": "Vendredi, ce dernier se disait d’une «grande zenitude» par rapport aux «gamineries» de «Dany»."
                            },
                            {
                                "example_id": "e89cf3a7-a67e-4e88-9b3c-a8cc74e0280d",
                                "sense_id": "6cae9af1-2f77-3e9a-9ca2-3846979aaf5b",
                                "text": "Négligeant le capharnaüm, il s’allongea sur un canapé, et consulta avec la zenitude d’un bonze de Ré, un catalogue de la maison Ruggieri."
                            }
                        ]
                    }
