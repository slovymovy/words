                                    {
                                        "sense_id": "dfd6fedd-c0a7-34f1-a4a7-7058482bf4ff",
                                        "entry_id": "15a1c167-43fa-32bb-8b5f-94848e0b4b49",
                                        "glosses": [
                                            "ein zehnfüßiger Süßwasserkrebs, der am Grunde von langsam fließenden Wasserläufen, Teichen und Seen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a72e32-7093-45c7-afd7-910a5314db7e",
                                                "sense_id": "dfd6fedd-c0a7-34f1-a4a7-7058482bf4ff",
                                                "text": "Der Flusskrebs wird bis zu 18 cm groß."
                                            },
                                            {
                                                "example_id": "affac282-1e25-4d72-bed5-f17a0188a81c",
                                                "sense_id": "dfd6fedd-c0a7-34f1-a4a7-7058482bf4ff",
                                                "text": "Flusskrebse graben ihre Bauten in die Uferböden von Flüssen oder Teichen."
                                            },
                                            {
                                                "example_id": "26a295b7-0001-427c-91ee-583562985854",
                                                "sense_id": "dfd6fedd-c0a7-34f1-a4a7-7058482bf4ff",
                                                "text": "Der Flusskrebs bewegt sich mithilfe seiner acht Laufbeine schreitend am Gewässergrund fort."
                                            },
                                            {
                                                "example_id": "a7bccdb3-47e3-4a6c-8a2d-12df326029f7",
                                                "sense_id": "dfd6fedd-c0a7-34f1-a4a7-7058482bf4ff",
                                                "text": "„Wir jagten geschlagene zwei Stunden nach den Flusskrebsen, waren nass bis auf die Knochen und hatten gerade mal zwei Stück gefangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
