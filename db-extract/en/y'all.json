                "senses": [
                    {
                        "sense_id": "a1f90246-90b0-3122-89eb-098ab21ab0ee",
                        "entry_id": "bf763576-6668-3a62-935b-e037843a38c7",
                        "glosses": [
                            "You (plural)."
                        ],
                        "tags": [
                            "Appalachia",
                            "Caribbean",
                            "Singapore",
                            "Southern-US",
                            "informal",
                            "nominative",
                            "objective",
                            "plural",
                            "second-person"
                        ],
                        "examples": [
                            {
                                "example_id": "f8aafd93-5487-4959-a8bc-c2eccce4ef63",
                                "sense_id": "a1f90246-90b0-3122-89eb-098ab21ab0ee",
                                "text": "[...] and this y'all know is true, [...]"
                            },
                            {
                                "example_id": "b54e1d74-1792-46b6-97af-bc8946542b50",
                                "sense_id": "a1f90246-90b0-3122-89eb-098ab21ab0ee",
                                "text": "Much later, after dozens of the men had come up to me to shake my hand (with both of theirs) and say \"Y'all come back soon, hear? ..."
                            },
                            {
                                "example_id": "c64bc6df-b559-4e98-adb8-c7afb702d9e3",
                                "sense_id": "a1f90246-90b0-3122-89eb-098ab21ab0ee",
                                "text": "People in the South do indeed seem to be addressing a single person as \"y'all.\" For instance, a restaurant patron might ask a waiter, \"What y'all got for dessert tonight?\" In that case, \"y'all\" refers collectively to the people who run the restaurant."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fd6850f-0fd6-3b1a-8384-3d3f315247d2",
                        "entry_id": "bf763576-6668-3a62-935b-e037843a38c7",
                        "glosses": [
                            "Everyone; everybody."
                        ],
                        "tags": [
                            "Southern-US",
                            "nominative",
                            "objective",
                            "plural",
                            "second-person"
                        ],
                        "examples": [
                            {
                                "example_id": "a585ab21-2137-41e0-b205-871a636cb50c",
                                "sense_id": "0fd6850f-0fd6-3b1a-8384-3d3f315247d2",
                                "text": "Hey y'all!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5bce0d1a-7836-3389-9d7f-aed6eb1a6cc6",
                        "entry_id": "bf763576-6668-3a62-935b-e037843a38c7",
                        "glosses": [
                            "You (singular)."
                        ],
                        "tags": [
                            "Southern-US",
                            "nominative",
                            "objective",
                            "plural",
                            "rare",
                            "second-person"
                        ],
                        "examples": [
                            {
                                "example_id": "c7f8a8f7-e94c-4a30-96ef-5d4bdaeef5b9",
                                "sense_id": "5bce0d1a-7836-3389-9d7f-aed6eb1a6cc6",
                                "text": "I made this for both y'all and your wife to enjoy."
                            },
                            {
                                "example_id": "533e0f59-ce40-42e8-b4c8-87e17b23abeb",
                                "sense_id": "5bce0d1a-7836-3389-9d7f-aed6eb1a6cc6",
                                "text": "You alla sudden gettin’ human with yo’ N-word and now a US Grant. Y’all becomin’ a rare white boy, ain’t ya?"
                            }
                        ]
                    }
                ],
