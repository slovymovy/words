                    "frequency": "Middle",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette phrase complexe est formée d'une <w>proposition</w> principale et de deux subordonnées."
                        },
                        {
                            "text": "Le professeur nous a appris à repérer chaque <w>proposition</w> dans un texte littéraire."
                        }
                    ],
                    "common_phrases": [
