                "senses": [
                    {
                        "sense_id": "33f75c2b-d49c-3f6c-bfb1-e1c7f3e70d2e",
                        "entry_id": "d62538cf-d664-322c-8e26-71a8d4e7a169",
                        "glosses": [
                            "Schweigepflicht innerhalb der Mafia und vergleichbarer Organisationen, die sich auf die Mitglieder und deren Tätigwerden erstreckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21475b46-3f13-412e-af3b-157e5b95afe9",
                                "sense_id": "33f75c2b-d49c-3f6c-bfb1-e1c7f3e70d2e",
                                "text": "„Das mafiöse RAF-Prinzip der Omertà hat damit eine weitere Bewährungsprobe bestanden.“"
                            },
                            {
                                "example_id": "67e90197-59aa-42c4-ba97-67c990c04771",
                                "sense_id": "33f75c2b-d49c-3f6c-bfb1-e1c7f3e70d2e",
                                "text": "„In Mafia-Clans einzudringen ist ein langwieriges Geschäft, die Omertà steht wie eine Mauer, wer redet, muss sterben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ec0b9c61-e4fc-3309-b4c6-815aa378965b",
                        "entry_id": "d62538cf-d664-322c-8e26-71a8d4e7a169",
                        "glosses": [
                            "unabhängig von mafiösen Verflechtungen bestehende Verpflichtung, über einen Sachverhalt Stillschweigen zu bewahren, die auf einer Vereinbarung zwischen mehreren Personen (beispielsweise Politikern) beruht oder die sich (seltener) auch eine Einzelperson allein auferlegt hat"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "fa8c6c98-fd2b-4194-81b9-16caeec7ab9d",
                                "sense_id": "ec0b9c61-e4fc-3309-b4c6-815aa378965b",
                                "text": "„Die Hoffnung, die Pleite könnte doch noch abgewendet werden, siegte zusammen mit der Angst, offenes Reden über das Schlimmste würde dieses erst recht herbeiführen.\nDas Gesetz dieser europäischen Omertà ist jetzt gebrochen.“"
                            },
                            {
                                "example_id": "b6306a0c-76de-4194-b7b4-d2532583c54a",
                                "sense_id": "ec0b9c61-e4fc-3309-b4c6-815aa378965b",
                                "text": "„Jörg Jaksche ist ein Kronzeuge, weil die Omertà, das Gesetz des Schweigens, nicht mehr funktioniert. Die Omertà hat funktioniert, weil alle, Teamleiter, Ärzte, Fahrer, Masseure, Mechaniker, von den Sünden der anderen wussten.“"
                            },
                            {
                                "example_id": "893e73b4-6e1d-4b4f-a5c4-3b91d301ceb9",
                                "sense_id": "ec0b9c61-e4fc-3309-b4c6-815aa378965b",
                                "text": "„Selbst Bayern-Fans loben seinen Mut, gegen die Omertà an der Säbener Straße aufzubegehren.“"
                            },
                            {
                                "example_id": "d213297a-c55b-4592-9ec5-8317a6b64545",
                                "sense_id": "ec0b9c61-e4fc-3309-b4c6-815aa378965b",
                                "text": "„Doch 1983 war es ausgerechnet Peter Brown, der die Omertà brach, die sich der innere Kreis der Beatles auferlegt hatte.“"
                            },
                            {
                                "example_id": "9cf0f44e-3828-42d9-82e3-4187a843b2d3",
                                "sense_id": "ec0b9c61-e4fc-3309-b4c6-815aa378965b",
                                "text": "„Jetzt, wo mein nächster Geburtstag eine Null in der Zahl hat, und es ist nicht die 30, befolge ich bezüglich meines Alters eine strikte Omertà.“"
                            },
                            {
                                "example_id": "634cb5b7-1c49-4288-862b-2f96da99615e",
                                "sense_id": "ec0b9c61-e4fc-3309-b4c6-815aa378965b",
                                "text": "„In der amerikanischen HipHop-Szene galt bislang die Omertà.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
