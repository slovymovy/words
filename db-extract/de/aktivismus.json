                                        "sense_id": "14309441-6990-3543-918a-2d798a33fcfa",
                                        "entry_id": "5ac53a40-6f96-358f-add1-b5889b854277",
                                        "glosses": [
                                            "The practice of using action to achieve a result, such as political demonstration or a strike in support of or in opposition to an issue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e55cee-5fd5-454e-9aa6-cebbd4a1a6a4",
                                                "sense_id": "14309441-6990-3543-918a-2d798a33fcfa",
                                                "text": "That worries the government, which fears that environmental activism could become the foundation for more general political opposition."
                                            }
