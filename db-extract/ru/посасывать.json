                "senses": [
                    {
                        "sense_id": "06348b1b-faa8-3cd2-8fb8-d02c0d285670",
                        "entry_id": "fcc1aafd-3bf4-3606-9d34-a95c708b3170",
                        "glosses": [
                            "разг. сосать понемногу, изредка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7636877c-cbf2-42cc-a4f8-87fac4f53523",
                                "sense_id": "06348b1b-faa8-3cd2-8fb8-d02c0d285670",
                                "text": "Сидит и наговаривает, а сам трубочку свою носогрейку посасывает, как следует быть настоящему солдату."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cc3741a-ae5d-308d-a7d1-16f39e0533ed",
                        "entry_id": "fcc1aafd-3bf4-3606-9d34-a95c708b3170",
                        "glosses": [
                            "разг. пить понемногу, с перерывом, небольшими порциями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9af94836-d4a2-4277-8136-1471997eb152",
                                "sense_id": "3cc3741a-ae5d-308d-a7d1-16f39e0533ed",
                                "text": "Он небрежно, умеючи, посасывает шампанское из широкого фужера и большими, ясными глазами оглядывает сидящего против него молодого коммуниста."
                            }
                        ]
                    }
