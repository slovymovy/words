                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "ca53250f-9016-4a4e-9613-08331196322a",
                        "entry_id": "e8850b11-782c-3d94-9021-4254f8ee1d93",
                        "tags": [
                            "positive"
                        ],
                        "form": "krekel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "118b3290-3106-38c6-9371-dc8e59127683",
                        "entry_id": "e8850b11-782c-3d94-9021-4254f8ee1d93",
                        "glosses": [
                            "gesund und munter"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "43c4fddb-1377-47c1-95e9-148070bd493d",
                                "sense_id": "118b3290-3106-38c6-9371-dc8e59127683",
                                "text": "„Die Stutenfrau erzählte weiter, dass Metta Focken Zwillinge bekommen hätte – twee lütje Jungens, ober krekel und gesund!“"
                            },
                            {
                                "example_id": "12dd807d-3d49-4e12-8139-e79cb11fa4fd",
                                "sense_id": "118b3290-3106-38c6-9371-dc8e59127683",
                                "text": "„Die Mama ist schon wieder krekel und genießt mit ihrem Gatten den weitläufigen Garten.“"
                            },
                            {
                                "example_id": "b36a8144-6066-4a84-8576-88cecfb818be",
                                "sense_id": "118b3290-3106-38c6-9371-dc8e59127683",
                                "text": "„Wi sünd jo dankbor dat vi leevt, dat unse Kinner Du hest bewacht, un dat se krekel un gesund un wi in Laun`borg ünnerkoom`n.“"
                            },
                            {
                                "example_id": "b56c95e7-a70f-435a-a6d6-61f9ef4c244e",
                                "sense_id": "118b3290-3106-38c6-9371-dc8e59127683",
                                "text": "„Vorhin wurde ja die Alternative eröffnet, ist das nur noch eine krekle Alte, die den Trends hinterherrennt, oder ist sie selber Trendsetterin?“"
                            },
                            {
                                "example_id": "6712f80e-b8c3-4557-b045-a4d1739ef042",
                                "sense_id": "118b3290-3106-38c6-9371-dc8e59127683",
                                "text": "„Daß aber unter all dem kreklen Gealber auch noch ein gut konstruierter und spannender Krimi-Plot zum Vorschein kommt (wie plündere ich die Rentenkasse einer großen Firma?), das ist etlichen Beifall wert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
