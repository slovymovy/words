                    {
                        "translation_id": "ec701f3d-ea99-41bf-8cd4-b38aeb43fd2f",
                        "source_entry_id": "1d7ac030-b331-30ea-8ac1-6d44d4da3517",
                        "source_sense_id": "9859521c-0901-375c-aa14-ddd9197dec07",
                        "target_lang_word": "pipe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pipe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce555b19-dd7f-3f01-a643-98f9666aa2b9",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Pipeau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "657ae2ef-1462-3d83-bb2c-3d65a3d6d0db",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Chalumeau utilisé autrefois pour boire le vin consacré, pendant la messe"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10d53c8c-bae8-3b80-a2c1-9ef286c06386",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Objet pour fumer du tabac ou une autre substance fumable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe025070-c732-497b-8f7b-8cbca605d431",
                                                "sense_id": "10d53c8c-bae8-3b80-a2c1-9ef286c06386",
                                                "text": "La ville de Saint-Claude dans le Jura est la capitale mondiale de la pipe."
                                            },
                                            {
                                                "example_id": "a57d13ec-38fd-4893-b4b1-40441081128d",
                                                "sense_id": "10d53c8c-bae8-3b80-a2c1-9ef286c06386",
                                                "text": "À propos de fumage ou de fumerie, — lequel des deux se dit ? — avertissons les romanciers qui n’ont pas renouvelé depuis quelques années les couleurs de leur palette locale, de ne pas s’aviser de mettre, à la bouche des Hollandais ou des Allemands modernes qu’ils dépeindront, des pipes de terre, de porcelaine ou d’écume de mer, — Alphonse Karr écrirait : de Kummer ; — on ne fume plus que le cigare par tous les pays que nous avons parcourus."
                                            },
                                            {
                                                "example_id": "5625124c-488f-4267-ad41-675cb2790320",
                                                "sense_id": "10d53c8c-bae8-3b80-a2c1-9ef286c06386",
                                                "text": "Connaissez-vous Turinaz ? me demanda […] le père Milot, le cordonnier de Longeverne, tandis que je fumais une pipe près de sa banchette en le regardant tirer le ligneul."
                                            },
                                            {
                                                "example_id": "24f429e1-d243-4bc0-8697-001e8b3e8331",
                                                "sense_id": "10d53c8c-bae8-3b80-a2c1-9ef286c06386",
                                                "text": "Mais que ce soient des pipes en maïs, en bruyère ou en écume, les New-Yorkais ne savent pas fumer la pipe. Ils l’allument et la laissent s’éteindre, la mettent dans leur poche, la rallument deux minutes plus tard, et ainsi de suite. Je me demande quel plaisir ils peuvent bien y prendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5123a791-c101-3879-82b6-458f8d6da4a0",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Fellation. (Note : On utilise plus souvent le verbe tailler que le faire faire pour désigner cette action.)"
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10b595c0-4f7c-4993-a1e2-94405634e96c",
                                                "sense_id": "5123a791-c101-3879-82b6-458f8d6da4a0",
                                                "text": "Mais pendant ce temps, aux États-Unis, qu’est-ce qui se passe? Il se passe qu’un type est en prison pour s’être fait tailler une pipe, il y a quelques années. Il avait 17 ans. La fille avait 15 ans. Relation totalement consensuelle."
                                            },
                                            {
                                                "example_id": "080751da-555a-4601-9278-738e975469e0",
                                                "sense_id": "5123a791-c101-3879-82b6-458f8d6da4a0",
                                                "text": "[…] le petit Viet a taillé une pipe à son grand con de frère américain et lui a taxé, ce faisant, une forte liasse de dollars qui dépassait de sa poche."
                                            },
                                            {
                                                "example_id": "5f8a3071-ef5b-4b59-a97e-1fd1cfd4b91c",
                                                "sense_id": "5123a791-c101-3879-82b6-458f8d6da4a0",
                                                "text": "La saison parisienne a été éprouvante pour les lyricomanes. En quelques jours, on a pu voir Elina Makropoulos, l’héroïne de Janácek, soulever sa jupe et s’asseoir sur la cuvette des toilettes, dans la production signée Warlikowski pour Bastille. Puis Carmen tailler une pipe sur la scène du Châtelet, tandis que Micaëla se faisait sodomiser puis dessouder, au milieu de saillies brutales méticuleusement mises en scène par l’Autrichien Martin Kusej confondant l’opéra de Bizet avec Tombeau pour cinq cent mille soldats de Pierre Guyotat."
                                            },
                                            {
                                                "example_id": "f594ae30-1fd5-4665-86ec-5dc81bbfbb23",
                                                "sense_id": "5123a791-c101-3879-82b6-458f8d6da4a0",
                                                "text": "Et tu devras recommencer à lui faire une pipe pendant qu'il continuera de te frapper. Alors, il vaut mieux pour toi que tu apprennes vite à contrôler ta respiration et à ravaler tes vomissures si jamais tu as des haut-le-cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05acc59-48a7-3369-866d-e055314ffd1b",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Grande futaille pour mettre du vin des liquides, des marchandises tels par exemple des harengs. La contenance en était généralement de 800 litres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "077295f2-779a-43d7-b478-c8399775e2d8",
                                                "sense_id": "a05acc59-48a7-3369-866d-e055314ffd1b",
                                                "text": "Il leur suffisait de tremper le bout des doigts dans une pipe de cidre ou une cuvée de vin pour changer cidre et vin en bouse liquide ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "306cb0c8-a5d2-3817-9ed0-e0738eb6ca5e",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Mesure de capacité, utilisée dans quelques pays, équivalant à ce genre de futaille, et dont le volume varie selon les usages."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d4dac07-1156-40d7-9ca5-a262cdf544ff",
                                                "sense_id": "306cb0c8-a5d2-3817-9ed0-e0738eb6ca5e",
                                                "text": "Imaginez-vous qu’il n’y a plus de vignes à Madère ! La récolte de vin qui, en 1813, s’élevait à vingt-deux mille pipes, est tombée, en 1845, à deux mille six cent soixante-neuf. Aujourd’hui, elle ne va pas à cinq cents ! C’est un affligeant spectacle."
                                            },
                                            {
                                                "example_id": "073885a4-c6f2-4ca2-8eef-dcb860bb7676",
                                                "sense_id": "306cb0c8-a5d2-3817-9ed0-e0738eb6ca5e",
                                                "text": "Si, d’aventure, il restait sur place, attendant une vacance à l'usine, il travaillait à la mine et était payé par pipe de minerai extraite."
                                            },
                                            {
                                                "example_id": "3d90d0d7-56e3-4281-9f14-5edd8d4eaaa1",
                                                "sense_id": "306cb0c8-a5d2-3817-9ed0-e0738eb6ca5e",
                                                "text": "… la pipe de minerai de fer pèse environ 540 kg et la pipe de charbon environ 85 kg"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5dde64-668a-3187-9c73-e636b342aaa0",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Petite saucisse sèche d’Ardenne."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3843d916-52bf-45b7-84be-5bc157ff5221",
                                                "sense_id": "cb5dde64-668a-3187-9c73-e636b342aaa0",
                                                "text": "A. Gouv. w., reconnaissant les dénominations « Saucisson d'Ardenne », « Petit Saucisson d'Ardenne », « Collier d'Ardenne » et « Pipe d'Ardenne » en qualité d'indications géographiques, M.B., 29 octobre 2010,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20185443-70bb-3629-b329-1c6b674cd18d",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Cigarette."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b63b7f5d-e11b-460a-b3a6-e318773db523",
                                                "sense_id": "20185443-70bb-3629-b329-1c6b674cd18d",
                                                "text": "« Allons, ne t’émeus pas. Je ne fais pas ma malle. Assieds-toi plutôt, allume une petite pipe (il appelait ainsi les cigarettes) et parlons de ton camarade. Il faut absolument le tirer de là »."
                                            },
                                            {
                                                "example_id": "f2e4bf00-5502-42ca-a739-484866cf4c5f",
                                                "sense_id": "20185443-70bb-3629-b329-1c6b674cd18d",
                                                "text": "– T’as pas une pipe ?\nMaillat lui tendit son paquet.\n– Prends-en plusieurs.\n– T’es un pote, dit l’homme."
                                            },
                                            {
                                                "example_id": "152abfb8-7e63-49fe-b1b5-25fb44bdad5c",
                                                "sense_id": "20185443-70bb-3629-b329-1c6b674cd18d",
                                                "text": "Peux-pas avoir une pipe, chef?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193236e0-9022-3cc9-918f-5f0a237ce997",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Objet en terre cuite en forme de pipe, servant de cible dans les stands de tir des baraques foraines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c95fecb3-5deb-4203-945c-8920dedc7acc",
                                                "sense_id": "193236e0-9022-3cc9-918f-5f0a237ce997",
                                                "text": "Ils étaient en tout une douzaine, qui abattaient les policiers et au besoin les passants, comme des pipes au tir de la foire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e5c1cd9-9ede-3d2a-8dd2-d68ceced415c",
                                        "entry_id": "356f51fc-28d2-3034-9125-37b9236f0bfc",
                                        "glosses": [
                                            "Incapable, incompétent, mauvais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37a29e2-7a2e-422e-bc42-fe80d0089b9a",
                                                "sense_id": "0e5c1cd9-9ede-3d2a-8dd2-d68ceced415c",
                                                "text": "« Ce n'est pas avec Luc Sonor, qui est une pipe, que le staff technique va progresser »"
                                            }
                                        ]
                                    }
                                ]
                            },
