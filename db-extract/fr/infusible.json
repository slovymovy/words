                ],
                "senses": [
                    {
                        "sense_id": "9c93d275-6075-3366-b839-363f2202faa2",
                        "entry_id": "0823b221-41f0-38e2-a63e-e39a2e933d42",
                        "glosses": [
                            "Partie qui ne fond pas dans une masse de matière."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "08b05841-a521-4e45-8a7c-26822ad8725e",
                                "sense_id": "9c93d275-6075-3366-b839-363f2202faa2",
                                "text": "La proportion nécessaire pour empêcher le gonflement dépend de la nature de la houille, du degré de finesse du poussier, du degré de finesse de l’infusible, de la densité apparente du mélange et de la loi de chauffage."
                            },
                            {
                                "example_id": "e7bb9d61-c092-4f1c-84a5-0514fe68f533",
                                "sense_id": "9c93d275-6075-3366-b839-363f2202faa2",
                                "text": "Souvent non dissous lors de la fusion des matières premières, les infusibles se désintègrent sous les températures élevées des fours et génèrent des micro-inclusions préjudiciables."
                            }
                        ]
                    }
                ],
