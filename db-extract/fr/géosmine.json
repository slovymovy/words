                                "target_senses": [
                                    {
                                        "sense_id": "7274fbfc-534f-3cba-bfba-4d0836c0fafb",
                                        "entry_id": "da821e20-79dd-3f10-a5b8-a589de14390b",
                                        "glosses": [
                                            "A bacterial derivative of decahydronaphthalene that has a strong earthy smell and is the material responsible for petrichor and for the earthy taste of beetroot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7bee9bd-a1e6-4747-8315-da61fafe957e",
                                                "sense_id": "7274fbfc-534f-3cba-bfba-4d0836c0fafb",
                                                "text": "A good example of this is geosmin, for which a typical sensitivity for the human nose is below 10 parts per trillion (10 parts in 10¹⁸ v/v) (ppt)."
                                            },
                                            {
                                                "example_id": "c6f96747-c8df-4966-ab8f-6ee78a2246fe",
                                                "sense_id": "7274fbfc-534f-3cba-bfba-4d0836c0fafb",
                                                "text": "A. versicolor may be one of the major producers of the moldy smelling component, geosmin, in buildings (Bjurman and Kristensson 1992)."
                                            },
                                            {
                                                "example_id": "f029914c-d6b9-4d7b-a83d-12226686a246",
                                                "sense_id": "7274fbfc-534f-3cba-bfba-4d0836c0fafb",
                                                "text": "Beetroots: The flavor is decisively characterized by the earthy note of geosmin"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
