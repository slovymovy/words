                "senses": [
                    {
                        "sense_id": "27e888aa-a69f-3ca9-933e-f74ac8cd173b",
                        "entry_id": "ec08fb5c-fd72-3b7c-826c-f78e9dc13b75",
                        "glosses": [
                            "Nettoyer du linge en le frottant avec les poings."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "84d4c01e-becf-4a13-aaa3-83d250ac7fe7",
                                "sense_id": "27e888aa-a69f-3ca9-933e-f74ac8cd173b",
                                "text": "L'épouse Faudon s'est installée sur le léger surplomb d'une gravière, au pied d'une roche où bruissent des chants de cascatelle. Endroit idéal pour poignasser le linge."
                            }
                        ]
                    },
                    {
                        "sense_id": "53d95de0-e888-3c28-8dbb-fe2e9db02aa2",
                        "entry_id": "ec08fb5c-fd72-3b7c-826c-f78e9dc13b75",
                        "glosses": [
                            "tripoter, manier."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "4f0ebf42-c45f-492e-bb8f-1ec6f9641f0f",
                                "sense_id": "53d95de0-e888-3c28-8dbb-fe2e9db02aa2",
                                "text": "Arrête donc de poignasser ce chien ; tu as les mains sales !"
                            },
                            {
                                "example_id": "186e2623-2fc8-427c-a907-a2aa0658eadc",
                                "sense_id": "53d95de0-e888-3c28-8dbb-fe2e9db02aa2",
                                "text": "Poignasser les légumes dans un supermarché."
                            },
                            {
                                "example_id": "efd48939-bf84-46e5-bac2-729565b552b9",
                                "sense_id": "53d95de0-e888-3c28-8dbb-fe2e9db02aa2",
                                "text": "C’est ce que j’espérais car alors il fallait « poignasser » longuement le beurre pour en faire transpirer le « petit lait » qui restait."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5f017df-784d-3fc7-921d-f5a8b6c15873",
                        "entry_id": "ec08fb5c-fd72-3b7c-826c-f78e9dc13b75",
                        "glosses": [
                            "Tripoter."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "fcef8df3-eafb-488f-b48e-79572649ae5c",
                                "sense_id": "c5f017df-784d-3fc7-921d-f5a8b6c15873",
                                "text": "Belon se laisse poignasser les muscles par « de ces gros valets, après vous avoir bien tiré et remué les bras, c 'en devant, c 'en derrière, jusqu 'à faire craquer les os,…»"
                            }
                        ]
                    }
