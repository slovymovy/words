        "fr-extract.jsonl": [
            {
                "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                "word": "comparable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c99b4bd2-eb19-4cf9-97ea-7583dd885fd5",
                        "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "comparables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                        "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                        "glosses": [
                            "Qui peut être comparé avec quelqu’un ou avec quelque chose pour leur ressemblance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df7591e-8160-4106-8a2f-96c76ee40f53",
                                "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                                "text": "La rupture des glaces s’opérait avec un fracas extraordinaire, comparable parfois à des décharges d’artillerie."
                            },
                            {
                                "example_id": "121a4196-6009-4284-baba-cc85e6f54efa",
                                "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                                "text": "J'ai vu, dans ma longue carrière d'ingénieur acousticien, bien des matières excellentes conductrices du son, mais jamais je n'en rencontrerai une seule comparable, même de loin, à celle dont sont pétris les murs de l'hôtel Terminus à Marseille."
                            },
                            {
                                "example_id": "9b661aa2-89fb-40de-8c1d-670a66542eff",
                                "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                                "text": "La fragilité des aciers carburés trempés, comparable à celle du verre, semble, elle aussi, une propriété caractéristique du carbure trempant du fer β plutôt que du fer β lui—même."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b80ec68-a913-393a-be3f-3d1c8f998c8e",
                        "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                        "glosses": [
                            "Entre lesquels existe une relation d’ordre."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "f61a3d7b-3874-4a2f-928d-471f1e2ce895",
                                "sense_id": "3b80ec68-a913-393a-be3f-3d1c8f998c8e",
                                "text": "Deux éléments x et y d’un ensemble sont dits comparables si le premier est inférieur ou égal au second (noté x ≤ y) ou vice-versa."
                            }
                        ]
                    },
                    {
                        "sense_id": "30b3620c-c110-3fa0-bd3a-3015acffe1fb",
                        "entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
                        "glosses": [
                            "Dont on peut former le comparatif de supériorité et le superlatif de supériorité."
                        ],
                        "tags": [
                            "Adjectif ou adverbe"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "433ed2f2-62dc-4a7e-8b13-96da1bbf4b27",
                        "source_entry_id": "ef24ee77-ede6-39fc-ad67-56c1b0c2b494",
