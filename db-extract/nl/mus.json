                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d46897e3-c324-3a67-9e6b-ced37421bf06",
                                        "entry_id": "80d10672-43aa-3649-b95c-8b4eb902f35b",
                                        "glosses": [
                                            "The house sparrow, Passer domesticus; a small bird with a short bill, and brown, white and gray feathers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b620c3c-aebf-4ed0-97c9-536cca2ec948",
                                                "sense_id": "d46897e3-c324-3a67-9e6b-ced37421bf06",
                                                "text": "Man progresses generally, not both legs at once like a sparrow, but by putting one leg forward first, and then the other."
                                            },
                                            {
                                                "example_id": "d44d5638-655e-409b-8bc1-bf1be499acb4",
                                                "sense_id": "d46897e3-c324-3a67-9e6b-ced37421bf06",
                                                "text": "In a poem by Sappho, Aphrodite is represented as riding in a car drawn by sparrows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a5407c7-12c6-315f-8253-d723422dd181",
                                        "entry_id": "80d10672-43aa-3649-b95c-8b4eb902f35b",
                                        "glosses": [
                                            "A member of the family Passeridae, comprising small Old World songbirds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5ceb9e5-61f7-315b-abc2-47476763e177",
                                        "entry_id": "80d10672-43aa-3649-b95c-8b4eb902f35b",
                                        "glosses": [
                                            "A member of the family Passerellidae (or Emberizidae, under classification systems that subsume the New World sparrows under Emberizidae), comprising small New World songbirds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6918e1b1-a543-3417-b3fa-2c8864f21f17",
                                        "entry_id": "80d10672-43aa-3649-b95c-8b4eb902f35b",
                                        "glosses": [
                                            "Generically, any small, nondescript bird."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5503fff4-0d77-37e0-9d8a-e176870af3f1",
                                        "entry_id": "80d10672-43aa-3649-b95c-8b4eb902f35b",
                                        "glosses": [
                                            "A quick-witted, lively person."
                                        ],
                                        "tags": [
                                            "London",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d47cc173-1ef4-4049-a0b5-b2616cf164a1",
                                                "sense_id": "5503fff4-0d77-37e0-9d8a-e176870af3f1",
                                                "text": "cockney sparrow"
                                            },
                                            {
                                                "example_id": "ff003eba-d12f-4c55-85f2-027fd0e097f9",
                                                "sense_id": "5503fff4-0d77-37e0-9d8a-e176870af3f1",
                                                "text": "I take it there 's scarcely a happier fellow alive than your honest town-bred smoke-dried cockney sparrow."
                                            },
                                            {
                                                "example_id": "3573e4c1-07fe-4a5d-aa84-8bab9913eb41",
                                                "sense_id": "5503fff4-0d77-37e0-9d8a-e176870af3f1",
                                                "text": "Professional cockney sparrow Martine has acted since childhood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5546a3f3-5df1-4e5d-bd53-59329d23b1e7",
                        "source_entry_id": "670ca65d-38fa-3140-8d9c-6a47c358a0d0",
                        "source_sense_id": "da7119e6-23e0-36df-8cd8-67f6394f021e",
                        "source_sense_description": "benaming voor vogels uit de familie Passeridae",
                        "target_lang_word": "moineau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moineau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35fed504-7407-30ba-9fd2-6ff0b70f47e2",
                                        "entry_id": "b05450f3-e2e7-3dff-9d8e-530a65e01287",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau, de la famille des passéridés, trapu au bec court et au plumage brunâtre et clair qui fait son nid dans les trous des murailles ou de tout bâtiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a340ca62-6dc1-4e27-95e0-163954da71cc",
                                                "sense_id": "35fed504-7407-30ba-9fd2-6ff0b70f47e2",
                                                "text": "Les moineaux, ces inévitables parasites de l’homme, ont établi leur quartier-général dans les ruines du vieux château."
                                            },
                                            {
                                                "example_id": "23f60da0-1d33-49e5-9e0e-9d8ac4f23cde",
                                                "sense_id": "35fed504-7407-30ba-9fd2-6ff0b70f47e2",
                                                "text": "Un moineau, à qui manquait une patte, qu’on avait remplacée par un bout d’allumette, sautillait gaiement sur l’épaule et sur la tête du vieillard."
                                            },
                                            {
                                                "example_id": "3b1c653c-943f-4175-808f-f68c416c051b",
                                                "sense_id": "35fed504-7407-30ba-9fd2-6ff0b70f47e2",
                                                "text": "En proie à une étrange surexcitation, il ne cessait de chanter :\nIls sont dans les vignes, les moineaux !\nIls sont dans les vignes !\ntournant autour de la table de la salle à manger sans qu’on pût l’arrêter."
                                            },
                                            {
                                                "example_id": "987ad9d0-5f4c-4f43-8252-417893e0e133",
                                                "sense_id": "35fed504-7407-30ba-9fd2-6ff0b70f47e2",
                                                "text": "Puis, les allées et venues des moineaux au rayon des pâtes, en face de sa caisse, retiennent son attention. Les piafs se faufilent sous les comptoirs et les plus culottés s’attaquent aux paquets de cellophane sous les rayons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc7ab9a-cb07-3518-a09e-041663eae9df",
                                        "entry_id": "b05450f3-e2e7-3dff-9d8e-530a65e01287",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau, de la famille des passéridés, trapu au bec court et au plumage brunâtre et clair qui fait son nid dans les trous des murailles ou de tout bâtiment.",
                                            "Tout oiseau commun de petite taille."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b2e894-cb24-45d5-8195-b6236163207e",
                                                "sense_id": "bcc7ab9a-cb07-3518-a09e-041663eae9df",
                                                "text": "Cette idée de contempler, mais aussi de prendre un arrêt forcé, m’avait convaincu de ne considérer que le transit par la terre et la voie maritime, plutôt que de me laisser tenter par un vol de moineau entre les deux grandes villes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e53a0d-6d33-33ae-a084-29c284b9e246",
                                        "entry_id": "b05450f3-e2e7-3dff-9d8e-530a65e01287",
                                        "glosses": [
                                            "Petit ouvrage militaire construit dans les fossés d’une place forte et qui permettait aux défenseurs de tirer d’un côté, ou des deux côtés, de l’ouvrage sur les assaillants qui s’y trouvaient."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57188a84-7075-3689-a19b-d88fb533c789",
                                        "entry_id": "b05450f3-e2e7-3dff-9d8e-530a65e01287",
                                        "glosses": [
                                            "Individu, type au comportement singulier."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06253291-bf89-4771-9444-84b0ee12ba46",
                                                "sense_id": "57188a84-7075-3689-a19b-d88fb533c789",
                                                "text": "C’est un drôle de moineau ; un vilain, un sale moineau."
                                            },
                                            {
                                                "example_id": "c7f92fde-6de2-46f3-8d55-d10d8bc3e40e",
                                                "sense_id": "57188a84-7075-3689-a19b-d88fb533c789",
                                                "text": "« À ton aise de lui donner raison, mais pendant que ce moineau-là fait des farces avec les filles, les vaches en profitent pour aller se gonfler dans les luzernes. Quand il y en aura une de crevée, on verra bien si tu riras encore. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1e9e3cf-9f11-347f-8ba3-83d4201baa27",
                                        "entry_id": "b05450f3-e2e7-3dff-9d8e-530a65e01287",
                                        "glosses": [
                                            "Volant."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc45cd9d-092e-470a-a834-1006e83a605a",
                                                "sense_id": "c1e9e3cf-9f11-347f-8ba3-83d4201baa27",
                                                "text": "Les jeux de raquettes, avec un moineau ou une balle (ou les deux à la fois fournis dans l’ensemble), ont toujours la cote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be4e361c-9b5c-3f87-aee6-60d29f440d08",
                                        "entry_id": "b05450f3-e2e7-3dff-9d8e-530a65e01287",
                                        "glosses": [
                                            "Pénis, zizi."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "childish",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0487dfeb-acdd-43d7-9238-07ce3819d9d5",
                                                "sense_id": "be4e361c-9b5c-3f87-aee6-60d29f440d08",
                                                "text": "On était aux petits oiseaux, hier matin, …. On avait même « le moineau à l’air » ! Si on s’est mis carrément à nu, c’est quand même pour la bonne cause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
