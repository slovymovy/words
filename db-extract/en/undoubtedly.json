                "senses": [
                    {
                        "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                        "entry_id": "c765d208-4c5e-32dd-9549-1f8c430d2e6c",
                        "glosses": [
                            "Without doubt; definitely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f14f2397-0f7b-4e01-bea5-73e800d079a6",
                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                "text": "The cane was undoubtedly of foreign make, for it had a solid silver ferrule at one end, which was not English hall–marked."
                            },
                            {
                                "example_id": "1ce691d9-5a8c-4522-89d8-2374aeee8b87",
                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                            },
                            {
                                "example_id": "67475126-f87b-45d9-b8cc-5c05c8488998",
                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                "text": "“It’s been a long process and I’ve come close to giving up along the way, but this is undoubtedly the craziest archaeological excavation I’ve yet been part of,” Bloch said in the news release."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1435bc23-7cb1-480f-9585-ae38023ec828",
                        "source_entry_id": "c765d208-4c5e-32dd-9549-1f8c430d2e6c",
                        "source_sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
