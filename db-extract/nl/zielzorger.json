                "senses": [
                    {
                        "sense_id": "ae90b46a-7a92-3a92-b336-eec1da3cf43e",
                        "entry_id": "3bc12c14-c71e-378c-b5ed-8f8eb6bb2a9f",
                        "glosses": [
                            "geestelijke die zich bezighoudt met het zielenheil van gelovigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b533e05-fb1b-4e97-970d-45b8837cf5ae",
                                "sense_id": "ae90b46a-7a92-3a92-b336-eec1da3cf43e",
                                "text": "Graham groeide uit tot een icoon en leider van een rijk en machtig evangelisatie-imperium. Hij werd vertrouweling en zielzorger van presidenten en hoogwaardigheidsbekleders en een kruisvaarder die met oproepen tot bekering over de aardbol trok."
                            },
                            {
                                "example_id": "c26ddf1d-e555-4816-94fa-9c992a778943",
                                "sense_id": "ae90b46a-7a92-3a92-b336-eec1da3cf43e",
                                "text": "Axel Kullik is zielzorger, speciaal voor de politie. „Als de agenten ervaringen met zwaar geweld krijgen, kan dat voor psychische problemen zorgen. Daarom ben ik hier”, zegt de dominee uit Oldenburg."
                            },
                            {
                                "example_id": "747a6bd4-1644-47b5-ba63-baa2319d286f",
                                "sense_id": "ae90b46a-7a92-3a92-b336-eec1da3cf43e",
                                "text": "‘Ik ben een gulzige en chaotische lezer, met een voorkeur voor essays en poëzie. Er liggen zes boeken: Frits van der Meer met Augustinus, de zielzorger: echt een meesterwerk."
                            }
                        ]
                    }
                ],
