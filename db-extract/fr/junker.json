            {
                "entry_id": "84148785-7eb3-3a04-b586-571e546b7f0a",
                "word": "junker",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "52f8903e-8660-44a4-846c-4b393ca6a6b8",
                        "entry_id": "84148785-7eb3-3a04-b586-571e546b7f0a",
                        "tags": [
                            "plural"
                        ],
                        "form": "junkers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55744d4e-20fb-35db-a8a1-ba3b8ec7a709",
                        "entry_id": "84148785-7eb3-3a04-b586-571e546b7f0a",
                        "glosses": [
                            "Aristocrate prussien non titré dont la noblesse repose sur la propriété foncière en Prusse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d139621-b4c0-48fc-9683-d9fbfe3be1da",
                                "sense_id": "55744d4e-20fb-35db-a8a1-ba3b8ec7a709",
                                "text": "Les junkers d'Allemagne de l’Est déboutés définitivement à Strasbourg."
                            },
                            {
                                "example_id": "d2164b65-6fe9-4840-a49f-59b4c6beb577",
                                "sense_id": "55744d4e-20fb-35db-a8a1-ba3b8ec7a709",
                                "text": "Les carabines de luxe, les couteaux à cran d’arrêt pour junkers, les brownings pour émeutiers distingués, les lames, les dagues à sanglier qui sont étalés là dans une ordonnance de musée, ne peuvent être que de Paris, ville des crimes passionnels et des coups de poignard."
                            },
                            {
                                "example_id": "b9f02b9b-b729-4fd9-b6bf-dd1cef6cdbdd",
                                "sense_id": "55744d4e-20fb-35db-a8a1-ba3b8ec7a709",
                                "text": "Gunther von Löwenberg avait beaucoup perdu de sa superbe de jadis qui en faisait un oracle écouté des junkers de Cottbus."
                            },
                            {
                                "example_id": "ea4d5df3-7307-4ba7-9a5c-1a58c3267522",
                                "sense_id": "55744d4e-20fb-35db-a8a1-ba3b8ec7a709",
                                "text": "On sentait encore ces hobereaux si étroitement fidèles à l’esprit de caste des junkers qu’ils en devenaient anachroniques. Leur attitude ambiguë s’illustrait par un paradoxe formulé à mots couverts, à savoir que la défaite de l’Allemagne serait une catastrophe, mais que la victoire de Hitler serait une catastrophe bien plus grande encore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a22664-0a9b-44ea-8810-dff622aceddc",
                        "source_entry_id": "84148785-7eb3-3a04-b586-571e546b7f0a",
                        "source_sense_id": "55744d4e-20fb-35db-a8a1-ba3b8ec7a709",
