                        "examples": [
                            {
                                "example_id": "ae791784-3e50-4c79-8940-e1f1e3931682",
                                "sense_id": "24608a19-92ca-3dfd-8253-030925a5ebe8",
                                "text": "Nous sommes en effet ici en présence de sols profonds à faible réserve en eau, à charge caillouteuse importante et à substrat de gravier, engorgeable en période humide et à potentialités agricoles limitées."
                            },
                            {
                                "example_id": "d2263299-9cd3-419e-b9fe-358944807b15",
                                "sense_id": "24608a19-92ca-3dfd-8253-030925a5ebe8",
                                "text": "Cette machine non-engorgeable est conçue pour pomper les liquides contenant de gros solides (jusqu’au diamètre total de refoulement), des solides fragiles tels que les cristaux, le carbone et même des crustacés et des mollusques vivants, des éléments abrasifs, ainsi que des matériaux longs fibreux et filandreux."
                            }
