                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1aaae96-48be-4968-bcf1-24bd7b3179d5",
                                "sense_id": "a2ba5892-adba-3d16-977c-5bbba27dc89d",
                                "text": "„Nur in rund 13 Prozent der Fälle sind typische Risikopatienten betroffen, also Menschen, die bereits einen Herzinfarkt hatten oder die eine andere bekannte Herzerkrankung haben.“"
                            },
                            {
                                "example_id": "b8efe269-877b-45b9-8b27-078089601bab",
                                "sense_id": "a2ba5892-adba-3d16-977c-5bbba27dc89d",
                                "text": "„Die zum Asthma führende primäre Lungenerkrankung nennt man Asthma bronchiale, die primäre Herzerkrankung Asthma cardiale.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
