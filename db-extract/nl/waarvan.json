                                        "sense_id": "aa8c7e62-8929-36d9-8c8e-363a28389e00",
                                        "entry_id": "8a50de16-6cfc-387a-a4d5-b61ae4640b31",
                                        "glosses": [
                                            "von welcher Sache/Angelegenheit"
