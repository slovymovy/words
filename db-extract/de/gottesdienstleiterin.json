                "senses": [
                    {
                        "sense_id": "36bd60ab-53fc-3d09-87ee-535113a75f93",
                        "entry_id": "9f8a7d45-a5d0-3d26-8adc-84f2cbf8e7cb",
                        "glosses": [
                            "Frau, die einen Gottesdienst zelebriert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d263175a-2f53-4467-a645-59feb20f60b1",
                                "sense_id": "36bd60ab-53fc-3d09-87ee-535113a75f93",
                                "text": "„Der Gottesdienst beginnt mit dem Lied ‚Auge im Sturm‘. Noch während der letzten Liedtakte tritt die Gottesdienstleiterin in den Fokusbereich. Sie blickt die Gemeinde freundlich an.“"
                            },
                            {
                                "example_id": "eb06d4e6-ae95-4b13-b941-c8a6c298c108",
                                "sense_id": "36bd60ab-53fc-3d09-87ee-535113a75f93",
                                "text": "„Ja, und ich übe es auch in der Pfarrgemeinde aus, ich bin also Gottesdienstleiter, ja, schon dann zwar begrenzt auf die Wortgottesdienste in unserem Krankenhaus, […]“"
                            },
                            {
                                "example_id": "82b533c5-5548-4930-8c2f-66c1147492f0",
                                "sense_id": "36bd60ab-53fc-3d09-87ee-535113a75f93",
                                "text": "„Aber sehr oft steckt viel Herzblut darin, und wenn ich an Hartmut Rosas erste und zweite Stimmgabel denke, ist es in diesen Formaten viel besser möglich, dass zumindest alle auch mal erste Stimmgabel sind, nicht nur eine Gottesdienstleiterin oder ein Priester.“"
                            },
                            {
                                "example_id": "38f316c5-29d8-4ec7-8662-178f0b1a05e3",
                                "sense_id": "36bd60ab-53fc-3d09-87ee-535113a75f93",
                                "text": "„Weitere empirische Studien sollten derartiges praxeologisches Wissen von Gottesdienstleiterinnen vermehrt in Diskussionen über eine zeitgenössische Gestaltung von Gottesdiensten einspielen.“"
                            },
                            {
                                "example_id": "074b9cf4-2c11-4c4f-909a-406dd5ae125a",
                                "sense_id": "36bd60ab-53fc-3d09-87ee-535113a75f93",
                                "text": "„Verschiedene Gottesdienstleiterinnen führten durch die Litanei gegen das Böse, sprachen die Lesungen und Fürbitten, leiteten das Singen an, brachten in einer Prozession tanzend Brot und Wein, segneten und verteilten es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
