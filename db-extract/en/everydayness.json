                        "translation_id": "8d0f9176-ffd0-49a8-ad4f-92feaf38cda2",
                        "source_entry_id": "ee547f7a-972d-3f4e-9e9e-b483f2753751",
                        "source_sense_description": "state of happening every day",
                        "target_lang_word": "Alltäglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alltäglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                        "entry_id": "00dbe628-7846-3adf-81ce-d8c344c1d5e1",
                                        "glosses": [
                                            "Zustand, dass etwas jeden Tag gemacht oder erlebt wird; nichts Besonderes mehr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ed97281-f042-47a9-986a-d48fbf8ad508",
                                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                                "text": "„Das Üben am Klavier muss zur Alltäglichkeit werden, wenn Du gut werden willst!“"
                                            },
                                            {
                                                "example_id": "f8c42baf-8fab-4253-afc4-28e076c455ff",
                                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                                "text": "Alltäglichkeiten wie Wasserholen, Feldarbeit oder Versteckspielen werden durch Landminen zur tödlichen Gefahr."
                                            },
                                            {
                                                "example_id": "d868179c-aae7-412c-813b-a1d53e91a938",
                                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                                "text": "Der Autor, der Auschwitz aus eigener Erfahrung kannte, beschreibt […] den Massenmord als Alltäglichkeit."
                                            },
                                            {
                                                "example_id": "a7531770-934c-4262-94ce-efbbc34966a1",
                                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                                "text": "Die Wahl von normalem DIN-A4 Papier ist bewusst, der Künstler will mit der Alltäglichkeit des Materials spielen und aus einem absolut gewöhnlichen Material fantasivolle und außergewöhnliche Arbeiten schaffen."
                                            },
                                            {
                                                "example_id": "d1e2de8a-ef21-489d-9de7-8227a6daed9a",
                                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                                "text": "Nur die verdrängten Alltäglichkeiten der DDR lassen sie heute in einem rosaroten Licht erscheinen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
