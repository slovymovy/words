                            },
                            {
                                "target_word": "scarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "655a086a-6be5-3227-97c8-0ed932adfa6f",
                                        "entry_id": "95e5fd56-5aac-3e97-8e40-9df368e0d197",
                                        "glosses": [
                                            "To eat very quickly."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0df6ae3-be86-49a2-839e-4101d54ea386",
                                                "sense_id": "655a086a-6be5-3227-97c8-0ed932adfa6f",
                                                "text": "You sure scarfed that pizza."
                                            },
                                            {
                                                "example_id": "a4c23cf1-45e2-4eb6-95cc-12cf4591f9a9",
                                                "sense_id": "655a086a-6be5-3227-97c8-0ed932adfa6f",
                                                "text": "We dug in. We ate everything there was to eat on the table. We ate like there was no tomorrow. We didn't talk. We ate. We scarfed. We grazed that table. We were into serious eating. We finished everything, including half a strawberry pie."
                                            },
                                            {
                                                "example_id": "b6dd5bf8-c9c7-407d-80bf-704b0e8cd006",
                                                "sense_id": "655a086a-6be5-3227-97c8-0ed932adfa6f",
                                                "text": "Me: scarfing my daughter’s macaroni and cheese, now chilly, over the sink while halfheartedly rinsing dishes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6fb45d0-d0d7-4eed-8110-95e34e66b88a",
                        "source_entry_id": "86b004fc-48b5-3822-b8e6-15a474e24e49",
                        "source_sense_id": "be63106c-769f-335a-8d49-1b75637ca243",
                        "source_sense_description": "breites Tuch, das man über den Schultern trägt, Schultertuch",
                        "target_lang_word": "shawl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                        "entry_id": "88d70e71-5199-3fde-a7f4-dec67f2e1b1b",
                                        "glosses": [
                                            "A square or rectangular piece of cloth worn as a covering for the head, neck, and shoulders, typically by women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fda61c3-1956-437e-894e-0ed180a6279f",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "She wears her shawl when it's cold outside."
                                            },
                                            {
                                                "example_id": "ab7b95ce-3ef5-4ca5-be64-ebfcd99a7f71",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Just then Norbourne entered the chamber; and, fancying from her attitude that his wife was asleep, he approached softly, and drew a large shawl around her."
                                            },
                                            {
                                                "example_id": "4393a2ea-1334-4441-8a30-d03a38da1bfe",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                                            },
                                            {
                                                "example_id": "4a59fcda-91e3-46b1-b879-c617d25fead9",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Jessamy turned. Her uplifted candle showed a dark handsome young women in a black dress. She wore a wide shawl over her head which hung down on either side, only partially hiding a starched, white apron.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb1a5ee-d9f5-3a47-981b-a655a71467b4",
                                        "entry_id": "88d70e71-5199-3fde-a7f4-dec67f2e1b1b",
                                        "glosses": [
                                            "A fold of wrinkled flesh under the lips and neck of a bloodhound, used in scenting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff1c2fc-4076-3a06-a223-3b7a2130522d",
                                        "entry_id": "41f6566d-74f8-362d-bcb9-b13874023547",
                                        "glosses": [
                                            "To wrap in a shawl."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299f4961-3b91-4830-b63e-6ec9153f4d97",
                                                "sense_id": "eff1c2fc-4076-3a06-a223-3b7a2130522d",
                                                "text": "Rebecca was shawling her in an upper apartment , where these two friends had an opportunity for a little of that secret talking and conspiring which forms the delight of female life"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
