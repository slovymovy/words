                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c860ab4-9579-45de-a31f-98cf741c75f2",
                        "source_entry_id": "3be312e8-1d5d-3416-aee6-2548b273ddb4",
                        "source_sense_description": "to make stable",
                        "target_lang_word": "стабилизи́ровать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стабилизи́ровать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "44195324-eb6f-3754-beae-1d9da1fa6d74",
                                        "entry_id": "dd77719a-dfa8-31b2-b581-a69a0edea12f",
                                        "glosses": [
                                            "приводить (привести) в устойчивое состояние; делать (сделать) устойчивым"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542ff251-de87-4878-8e52-0bc6856653c1",
                                                "sense_id": "44195324-eb6f-3754-beae-1d9da1fa6d74",
                                                "text": "И Брюхоненко приступил к поискам препарата, который, не будучи ядовитым, мог бы стабилизировать кровь, временно лишая её способности к свёртыванию."
                                            },
                                            {
                                                "example_id": "1c4fe539-d9e2-4a73-a1d3-5c8e1289288d",
                                                "sense_id": "44195324-eb6f-3754-beae-1d9da1fa6d74",
                                                "text": "Пропустив мяч, армейцы оттянули назад не только полузащитников, но и двух нападающих. Но это лишь на время стабилизировало положение."
                                            },
                                            {
                                                "example_id": "e4a84e1a-8e3c-4b32-9219-891d19127739",
                                                "sense_id": "44195324-eb6f-3754-beae-1d9da1fa6d74",
                                                "text": "Шток, продетый сквозь головную часть якоря, стабилизировал его на грунте и не препятствовал втягиванию в клюз."
                                            },
                                            {
                                                "example_id": "ee517e3f-5f9d-4d86-82f7-2ee1968eafce",
                                                "sense_id": "44195324-eb6f-3754-beae-1d9da1fa6d74",
                                                "text": "Стабилизировать курс рубля можно с помощью расходования резервов ЦБ и, наоборот, изменить размер резервов за счет курсовых манипуляций."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
