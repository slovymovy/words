{
    "word_family": [
        "bump",
        "bumpy",
        "bumpiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23c4617b-4826-3016-b1b2-4287014dd058",
                    "sense_definition": "Plural of <w>bump</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_protrusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road was full of <w>bumps</w> that made the car shake.",
                            "target_lang_translations": {
                                "nl": "De weg zat vol <w>hobbels</w> waardoor de auto schudde."
                            }
                        },
                        {
                            "text": "She had several small <w>bumps</w> on her arm after the insect bites.",
                            "target_lang_translations": {
                                "nl": "Ze had verschillende kleine <w>bulten</w> op haar arm na de insectenbeten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "speed bumps"
                    ],
                    "target_lang_definitions": {
                        "nl": "Kleine verhogingen of zwellingen op een oppervlak of op de huid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "hobbels",
                                "target_lang_sense_clarification": "verwijzend naar onregelmatigheden in een weg of oppervlak"
                            },
                            {
                                "target_lang_word": "bulten",
                                "target_lang_sense_clarification": "verwijzend naar zwellingen op de huid of een object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc0d54ed-ae5a-35ce-828b-66de83313fae",
                    "sense_definition": "The ritual tossing of someone into the air to celebrate their birthday",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children gave him the birthday <w>bumps</w> in the garden.",
                            "target_lang_translations": {
                                "nl": "De kinderen <w>gooiden hem in de lucht</w> in de tuin voor zijn verjaardag."
                            }
                        },
                        {
                            "text": "He was nervous about getting the <w>bumps</w> on his tenth birthday.",
                            "target_lang_translations": {
                                "nl": "Hij was zenuwachtig om <w>in de lucht gegooid te worden</w> op zijn tiende verjaardag."
                            }
                        }
                    ],
                    "common_phrases": [
                        "birthday bumps"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een Britse verjaardagstraditie waarbij de jarige in de lucht wordt gegooid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "in de lucht gooien",
                                "target_lang_sense_clarification": "beschrijvende vertaling voor de verjaardagstraditie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c47e0fe1-1550-3e19-a066-161b8d3997ad",
                    "sense_definition": "Third-person singular simple present indicative of <w>bump</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He often <w>bumps</w> into the furniture when the lights are off.",
                            "target_lang_translations": {
                                "nl": "Hij <w>botst</w> vaak tegen de meubels als het licht uit is."
                            }
                        },
                        {
                            "text": "The boat <w>bumps</w> against the dock as the tide comes in.",
                            "target_lang_translations": {
                                "nl": "De boot <w>stoot</w> tegen de kade terwijl het tij opkomt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegen iets aan botsen of stoten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "botst",
                                "target_lang_sense_clarification": "tegen iets aan komen"
                            },
                            {
                                "target_lang_word": "stoot",
                                "target_lang_sense_clarification": "een korte, krachtige aanraking"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}