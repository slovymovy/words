                "senses": [
                    {
                        "sense_id": "6cf092f3-a5a6-3cdc-9eb9-b052912cdf77",
                        "entry_id": "e8ad033f-11cd-3e16-8d2e-0e1fea492c54",
                        "glosses": [
                            "Soldat, der einen Panzer fährt; der Fahrer eines Panzers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec48d457-769a-4a75-bb4f-9b08bfe28f3b",
                                "sense_id": "6cf092f3-a5a6-3cdc-9eb9-b052912cdf77",
                                "text": "Für Panzerfahrer gibt es eine spezielle Fahrausbildung."
                            },
                            {
                                "example_id": "2367b4aa-6f99-4b25-877f-05a206873a4b",
                                "sense_id": "6cf092f3-a5a6-3cdc-9eb9-b052912cdf77",
                                "text": "„Arnold Schwarzenegger kramte im Militärmuseum in Columbus (US-Bundesstaat Ohio) in Erinnerungen an die Zeit als Panzerfahrer beim österreichischen Bundesheer in Graz-Wetzelsdorf.“"
                            },
                            {
                                "example_id": "cff5fb55-cce1-4fba-b6a4-b9c4425838d5",
                                "sense_id": "6cf092f3-a5a6-3cdc-9eb9-b052912cdf77",
                                "text": "„Dabei handele es sich um einen 20 Jahre alten Panzerfahrer und einen 28-Jährigen, der diesen beim Rückwärtsfahren eingewiesen hatte, sagte eine Sprecherin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
