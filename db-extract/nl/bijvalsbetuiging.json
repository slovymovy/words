                                            {
                                                "example_id": "aef7450c-08b7-4777-b58c-32d6f297b67e",
                                                "sense_id": "d4cb8f82-1cae-3207-81a5-4b4e581e969d",
                                                "text": "a highly-acclaimed novel"
