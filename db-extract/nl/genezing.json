                        "sense_id": "744cafa4-67fb-3bdc-a9d4-9ff4fbb47f50",
                        "entry_id": "cc159aa0-56fb-30df-a879-44e8f3f52a44",
                        "glosses": [
                            "het proces van het weer gezond worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39ab3151-e320-455b-a85c-dec9197b536d",
                                "sense_id": "744cafa4-67fb-3bdc-a9d4-9ff4fbb47f50",
                                "text": "De genezing van deze diepe wond zal wel enige tijd gaan duren."
                            }
                        ]
