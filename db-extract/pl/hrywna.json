                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hřivna",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "8c64656a-a819-3f9f-91c9-65e982f286b4",
                                        "entry_id": "6eda4d7a-d869-3e3a-9a69-2a3eee7994bf",
                                        "glosses": [
                                            "měnová jednotka Ukrajiny"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36cbe961-1937-343b-b7ac-875a11c701da",
                                        "entry_id": "6eda4d7a-d869-3e3a-9a69-2a3eee7994bf",
                                        "glosses": [
                                            "platební jednotka"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1cd65e-8b23-49a9-996f-59d5751b2a10",
                                                "sense_id": "36cbe961-1937-343b-b7ac-875a11c701da",
                                                "text": "V první den zavítali stavové všichni, to pod pokutou pěti hřiven do Těšína, aby oslavili přítomností svou zahájení práva zemského."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed3f2c5e-8bfa-363f-a80e-7ddc32baec38",
                                        "entry_id": "6eda4d7a-d869-3e3a-9a69-2a3eee7994bf",
                                        "glosses": [
                                            "jednotka hmotnosti"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08772fe-6226-4867-81c4-aef9b5995733",
                                                "sense_id": "ed3f2c5e-8bfa-363f-a80e-7ddc32baec38",
                                                "text": "…že ten hrob Davidův otevřel, a tři tisíce hřiven zlata z něho vzal : pět set z nich Antiochovi dal, aby odtrhl a jeho při pokoji zanechal, ostatek na jiné potřeby obrátil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21ce102-8c6b-36f1-b1b2-8f2cbf608759",
                                        "entry_id": "6eda4d7a-d869-3e3a-9a69-2a3eee7994bf",
                                        "glosses": [
                                            "hodnota obecně, nadání"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1c754e9-87e5-4af0-8e92-171c1d906b2f",
                                                "sense_id": "c21ce102-8c6b-36f1-b1b2-8f2cbf608759",
                                                "text": "Bělorusko přispělo svou hřivnou do pokladnice světových kultur a dalo České republice nejen vzpomínku na Franciska Skorinu…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78b05d8e-ac76-41c3-b3a6-492c42c00892",
                        "source_entry_id": "d06fa928-a263-30a2-af86-55ea84ded9f8",
                        "source_sense_id": "95c7715c-9dc3-32e5-8f36-d1a9e92e7583",
                        "target_lang_word": "hryvnia",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hryvnia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c411c53b-8908-3b36-854d-3d9448f0934c",
                                        "entry_id": "ac9d0184-892c-323a-a29a-ce3e50250da5",
                                        "glosses": [
                                            "Unité monétaire de l’Ukraine, divisée en 100 kopecks. Son symbole est ₴ (Unicode U+20B4). Son code ISO 4217 est UAH."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "347f6a09-360e-40f2-b41d-ebe111254fcf",
                                                "sense_id": "c411c53b-8908-3b36-854d-3d9448f0934c",
                                                "text": "Ce n’est que dans la seconde moitié des années 1990, en particulier après l’introduction en 1996 d’une nouvelle monnaie plus stable (la hryvnia), que la situation a commencé à se redresser."
                                            },
                                            {
                                                "example_id": "00eddbf4-9eca-4b74-baac-137125ae6bdc",
                                                "sense_id": "c411c53b-8908-3b36-854d-3d9448f0934c",
                                                "text": "Face à la nouvelle exacerbation des tensions en ce début d'année, les prévisions de croissance du PIB et la devise (la hryvnia) trinquent de nouveau."
                                            },
                                            {
                                                "example_id": "ede54ed9-b42e-4dc3-acac-1b87f6ac9fd4",
                                                "sense_id": "c411c53b-8908-3b36-854d-3d9448f0934c",
                                                "text": "Avant que l’affaire des « œufs à 17 hryvnias (0,42 euro) » ne conduise à un vaste limogeage au sein de son administration, Oleksiï Reznikov avait commencé par nier tout problème, évoquant une « manipulation délibérée » et dénonçant « la diffusion de fausses informations nuisant aux intérêts de la défense »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc8093f1-ed7b-4d76-a836-92cae06d32f6",
                        "source_entry_id": "d06fa928-a263-30a2-af86-55ea84ded9f8",
                        "source_sense_id": "95c7715c-9dc3-32e5-8f36-d1a9e92e7583",
