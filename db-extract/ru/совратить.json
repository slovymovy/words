                    },
                    {
                        "form_id": "4784cf1c-05d4-4112-9b1a-be9b32633fb1",
                        "entry_id": "394349f9-8e38-3145-9a03-8f883a9bc331",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "соврати́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72a0263b-1ad4-3f0a-9918-fa257ec4d46f",
                        "entry_id": "394349f9-8e38-3145-9a03-8f883a9bc331",
                        "glosses": [
                            "устар. отводить в сторону, отклонять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f580edd-fbf4-4111-8d94-19a1cfc4b2ae",
                                "sense_id": "72a0263b-1ad4-3f0a-9918-fa257ec4d46f",
                                "text": "Все наши силы, совокупно употреблённые, не были в состоянии совратить его с того места, на котором оно стояло."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7fbbe2f-b092-3226-9354-78cdb006c6bc",
                        "entry_id": "394349f9-8e38-3145-9a03-8f883a9bc331",
                        "glosses": [
                            "склонить к предосудительным поступкам, ложным убеждениям; сбить с правильного жизненного пути"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6305947b-a816-4533-a0fa-83f61de76062",
                                "sense_id": "e7fbbe2f-b092-3226-9354-78cdb006c6bc",
                                "text": "Мы все для него — посланцы дьявола, чтобы совратить его невинную душу!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9dd9f193-8b13-3a8c-897f-889b997891ce",
                        "entry_id": "394349f9-8e38-3145-9a03-8f883a9bc331",
                        "glosses": [
                            "добиться полового контакта с кем-либо; соблазнить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5520a80-7311-49e9-949d-0e3664dd4230",
                                "sense_id": "9dd9f193-8b13-3a8c-897f-889b997891ce",
                                "text": "А если вы думаете, что я его совратила, то, поверьте мне, это совсем не так."
                            },
                            {
                                "example_id": "b340aa09-e25a-479a-9bba-5c12c4639088",
                                "sense_id": "9dd9f193-8b13-3a8c-897f-889b997891ce",
                                "text": "Пьеса была написана Александром Грином по английскому роману В. Мэргерит и имела довольно обычное содержание: банкир Дюли совратил горничную Аннет, она забеременела, он выгнал её из дома, и она стала проституткой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8dc2b32-adb5-4b54-89ab-54f3e1dec088",
                        "source_entry_id": "394349f9-8e38-3145-9a03-8f883a9bc331",
                        "source_sense_description": "отводить в сторону, отклонять",
                        "target_lang_word": "change the course",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cd47c3cb-4301-4e86-81db-e289d3e998b1",
                        "source_entry_id": "394349f9-8e38-3145-9a03-8f883a9bc331",
                        "source_sense_description": "склонить к предосудительным поступкам, ложным убеждениям; сбить с правильного жизненного пути",
                        "target_lang_word": "corrupt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corrupt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79f1ee2d-d678-35bf-a129-bcfa904486ff",
                                        "entry_id": "45eec8ca-0e81-30fe-9d79-b31343bb1866",
                                        "glosses": [
                                            "Willing to act dishonestly for personal gain; accepting bribes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3823d4dc-4902-30a7-8c31-fa08d5f6fe70",
                                        "entry_id": "45eec8ca-0e81-30fe-9d79-b31343bb1866",
                                        "glosses": [
                                            "In a depraved state; debased; perverted; morally degenerate; weak in morals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa802be9-af54-4e98-b676-e57ba86a774c",
                                                "sense_id": "3823d4dc-4902-30a7-8c31-fa08d5f6fe70",
                                                "text": "The government here is corrupt, so we'll emigrate to escape them."
                                            },
                                            {
                                                "example_id": "ae5d0b6d-9413-4642-a00e-c54ef4adb49d",
                                                "sense_id": "3823d4dc-4902-30a7-8c31-fa08d5f6fe70",
                                                "text": "The earth also was corrupt before God, and the earth was filled with violence."
                                            },
                                            {
                                                "example_id": "c5e2d250-38ec-446d-a0ae-483419ea49d5",
                                                "sense_id": "3823d4dc-4902-30a7-8c31-fa08d5f6fe70",
                                                "text": "At what ease\nMight corrupt minds procure knaves as corrupt\nTo swear against you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde7835e-bd7f-3b49-9b96-93a1c07de3f3",
                                        "entry_id": "45eec8ca-0e81-30fe-9d79-b31343bb1866",
                                        "glosses": [
                                            "Abounding in errors; not genuine or correct; in an invalid state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e96aed5-1959-4d08-bee2-a4ec6dce4b0a",
                                                "sense_id": "fde7835e-bd7f-3b49-9b96-93a1c07de3f3",
                                                "text": "The text of the manuscript is corrupt."
                                            },
                                            {
                                                "example_id": "fedc551d-ae2b-4c7b-8b06-9f3a86386251",
                                                "sense_id": "fde7835e-bd7f-3b49-9b96-93a1c07de3f3",
                                                "text": "It turned out that the program was corrupt - that's why it wouldn't open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf996a9-63d3-31f0-809c-5bad8799d576",
                                        "entry_id": "45eec8ca-0e81-30fe-9d79-b31343bb1866",
                                        "glosses": [
                                            "In a putrid state; spoiled; tainted; vitiated; unsound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb22a23-39f5-44ef-9d37-db77f63931e3",
                                                "sense_id": "ebf996a9-63d3-31f0-809c-5bad8799d576",
                                                "text": "with such corrupt and pestilent bread to feed them."
                                            }
                                        ]
                                    }
                                ]
                            },
