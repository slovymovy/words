{
    "word_family": [
        "fight"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ccc5dd4-ca8c-32fc-9841-338c3cbfdac2",
                    "sense_definition": "A person who fights, especially as a soldier or in a conflict.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person_combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave <w>fighter</w> defended his country against the invasion.",
                            "target_lang_translations": {
                                "ru": "Храбрый <w>боец</w> защищал свою страну от вторжения.",
                                "zh": "这位勇敢的<w>战士</w>保卫国家抵御了入侵。"
                            }
                        },
                        {
                            "text": "Several rebel <w>fighters</w> were seen hiding in the mountains.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>бойцов</w> повстанцев видели прячущимися в горах.",
                                "zh": "有人看到几名叛军<w>战士</w>躲在山里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "combatant",
                        "soldier",
                        "warrior"
                    ],
                    "common_phrases": [
                        "freedom fighter",
                        "enemy fighter",
                        "rebel fighter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который сражается, особенно как солдат или участник конфликта.",
                        "zh": "指参与战斗的人，尤指士兵或冲突的参与者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "участник сражения, солдат"
                            },
                            {
                                "target_lang_word": "воин",
                                "target_lang_sense_clarification": "возвышенное или историческое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战士",
                                "target_lang_sense_clarification": "指参与战斗的士兵或武装人员"
                            },
                            {
                                "target_lang_word": "战斗员",
                                "target_lang_sense_clarification": "指战斗中的人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8201dee-d841-31ab-a770-3f6bb0fac125",
                    "sense_definition": "A person who competes in boxing, wrestling, or martial arts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person_combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavyweight <w>fighter</w> entered the ring to loud cheers from the crowd.",
                            "target_lang_translations": {
                                "ru": "<w>Боец</w>-тяжеловес вышел на ринг под громкие приветствия толпы.",
                                "zh": "这位重量级<w>格斗选手</w>在观众的欢呼声中走上拳台。"
                            }
                        },
                        {
                            "text": "She is a talented MMA <w>fighter</w> who has won many championships.",
                            "target_lang_translations": {
                                "ru": "Она талантливый <w>боец</w> ММА, выигравшая много чемпионатов.",
                                "zh": "她是一位才华横溢的综合<w>格斗选手</w>，曾多次获得冠军。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "professional fighter",
                        "prize fighter",
                        "MMA fighter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, участвующий в боксе, борьбе или боевых искусствах.",
                        "zh": "指参加拳击、摔跤或武术比赛的运动员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "спортсмен в единоборствах"
                            },
                            {
                                "target_lang_word": "борец",
                                "target_lang_sense_clarification": "занимающийся борьбой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格斗选手",
                                "target_lang_sense_clarification": "指参加格斗类运动的运动员"
                            },
                            {
                                "target_lang_word": "拳手",
                                "target_lang_sense_clarification": "特指拳击运动员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba403bd3-528e-3630-9f26-aeb1cb4a736e",
                    "sense_definition": "A fast military aircraft designed to attack and destroy other aircraft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aircraft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air force sent a <w>fighter</w> to intercept the unidentified plane.",
                            "target_lang_translations": {
                                "ru": "ВВС отправили <w>истребитель</w> на перехват неопознанного самолета.",
                                "zh": "空军派出一架<w>战斗机</w>去拦截那架不明身份的飞机。"
                            }
                        },
                        {
                            "text": "He dreams of becoming a <w>fighter</w> pilot when he grows up.",
                            "target_lang_translations": {
                                "ru": "Он мечтает стать пилотом <w>истребителя</w>, когда вырастет.",
                                "zh": "他梦想长大后成为一名<w>战斗机</w>飞行员。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fighter jet",
                        "fighter pilot",
                        "fighter plane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый военный самолет, предназначенный для атаки и уничтожения других самолетов.",
                        "zh": "一种用于攻击和摧毁敌方飞机的快速军用飞机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истребитель",
                                "target_lang_sense_clarification": "тип самолета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战斗机",
                                "target_lang_sense_clarification": "指军用飞机类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf1de03c-60db-3891-b905-5697afb2bb5d",
                    "sense_definition": "A person with strong determination who does not give up easily, especially when facing illness or difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a real <w>fighter</w> who managed to beat cancer twice.",
                            "target_lang_translations": {
                                "ru": "Она настоящий <w>боец</w>, сумевшая дважды победить рак.",
                                "zh": "她是一位真正的<w>斗士</w>，成功两次战胜了癌症。"
                            }
                        },
                        {
                            "text": "You have to be a <w>fighter</w> to succeed in this competitive business.",
                            "target_lang_translations": {
                                "ru": "Нужно быть <w>бойцом</w>, чтобы преуспеть в этом конкурентном бизнесе.",
                                "zh": "在这个竞争激烈的行业里，你必须做一个<w>斗士</w>才能成功。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "real fighter",
                        "born fighter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с сильной волей, который не сдается легко, особенно перед лицом болезни или трудностей.",
                        "zh": "指意志坚定、不轻易放弃的人，特别是在面对疾病或困难时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "человек с сильным характером"
                            },
                            {
                                "target_lang_word": "борец",
                                "target_lang_sense_clarification": "тот, кто борется с трудностями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斗士",
                                "target_lang_sense_clarification": "指具有顽强拼搏精神的人"
                            },
                            {
                                "target_lang_word": "强者",
                                "target_lang_sense_clarification": "指在困难面前表现坚强的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2fdd85-015e-3773-b862-86e8af0cdde2",
                    "sense_definition": "A video game genre focused on physical combat between characters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon playing a new <w>fighter</w> on the console.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, играя в новый <w>файтинг</w> на приставке.",
                                "zh": "我们整个下午都在游戏机上玩一款新的<w>格斗游戏</w>。"
                            }
                        },
                        {
                            "text": "This classic 2D <w>fighter</w> requires very fast reflexes to win.",
                            "target_lang_translations": {
                                "ru": "Этот классический 2D <w>файтинг</w> требует очень быстрой реакции для победы.",
                                "zh": "这款经典的2D<w>格斗游戏</w>需要极快的反应速度才能获胜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "2D fighter",
                        "3D fighter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for fighting game"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр видеоигр, сфокусированный на физическом бое между персонажами.",
                        "zh": "一种以角色间物理格斗为核心的电子游戏类型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "файтинг",
                                "target_lang_sense_clarification": "жанр игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格斗游戏",
                                "target_lang_sense_clarification": "指游戏类型"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}