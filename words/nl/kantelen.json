{
    "word_family": [
        "kanteel",
        "kanteling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8fba1fe-5937-3263-aad8-63d9f3960ab2",
                    "sense_definition": "Omvallen of uit evenwicht raken en op een zij terechtkomen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de harde wind is de vrachtwagen plotseling <w>gekanteld</w>.",
                            "target_lang_translations": {
                                "fr": "À cause du vent violent, le camion a soudainement <w>basculé</w>."
                            }
                        },
                        {
                            "text": "Schepen kunnen <w>kantelen</w> als de zware lading gaat schuiven.",
                            "target_lang_translations": {
                                "fr": "Les navires peuvent <w>chavirer</w> si la lourde cargaison se déplace."
                            }
                        }
                    ],
                    "synonyms": [
                        "omvallen",
                        "omkiepen"
                    ],
                    "common_phrases": [
                        "bijna kantelen",
                        "plotseling kantelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tomber ou basculer sur le côté en perdant l'équilibre"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "basculer",
                                "target_lang_sense_clarification": "perdre l'équilibre et verser"
                            },
                            {
                                "target_lang_word": "se renverser",
                                "target_lang_sense_clarification": "se coucher sur le côté"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e02f831-7b5b-3e56-b1e6-c4080ef3e7eb",
                    "sense_definition": "Iets een halve of kwart slag draaien om een andere zijde boven te krijgen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de doos voorzichtig <w>kantelen</w> om de onderkant te bekijken.",
                            "target_lang_translations": {
                                "fr": "Tu dois <w>incliner</w> la boîte avec précaution pour regarder le dessous."
                            }
                        },
                        {
                            "text": "Toen hij de zware doos wilde <w>kantelen</w>, scheurde de bodem los.",
                            "target_lang_translations": {
                                "fr": "Lorsqu'il a voulu <w>faire basculer</w> la lourde boîte, le fond s'est déchiré."
                            }
                        }
                    ],
                    "synonyms": [
                        "kantelen",
                        "draaien"
                    ],
                    "common_phrases": [
                        "een doos kantelen",
                        "voorzichtig kantelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Faire tourner un objet d'un quart ou d'un demi-tour pour présenter une autre face"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "incliner",
                                "target_lang_sense_clarification": "pencher un objet"
                            },
                            {
                                "target_lang_word": "faire basculer",
                                "target_lang_sense_clarification": "faire tourner sur un axe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7317779a-2609-34ea-aa02-feb7625ea944",
                    "sense_definition": "Meervoud van <w>kanteel</w>; uitstekende delen op een verdedigingsmuur van een kasteel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Van achter de <w>kantelen</w> schoten boogschutters hun pijlen af op de aanvallers.",
                            "target_lang_translations": {
                                "fr": "De derrière les <w>créneaux</w>, les archers tiraient leurs flèches sur les assaillants."
                            }
                        },
                        {
                            "text": "Het oude kasteel heeft nog steeds zijn originele <w>kantelen</w>.",
                            "target_lang_translations": {
                                "fr": "Le vieux château a encore ses <w>créneaux</w> d'origine."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of kanteel"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Pluriel de kanteel ; découpes crénelées au sommet des murs d'un château"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "créneaux",
                                "target_lang_sense_clarification": "sur un rempart ou château"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}