                "senses": [
                    {
                        "sense_id": "646adaad-e1be-3fbc-94f8-f72930b1384f",
                        "entry_id": "eee96c0c-4d2f-3099-bac0-d00908a7f2cc",
                        "glosses": [
                            "A devotion; a devotional; a piece of religious text used for devotion, or the time spent on reading and reflecting on such text."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c0e95682-d358-47b6-8692-e56f3e7d9d94",
                                "sense_id": "646adaad-e1be-3fbc-94f8-f72930b1384f",
                                "text": "The 246 daily devos help you dive deep for treasure to keep. Every devo starts with a fun saying that will help you learn and remember the meaning of one small slice of the Bible."
                            },
                            {
                                "example_id": "6a4bded5-88bd-4648-a285-30cafbfec682",
                                "sense_id": "646adaad-e1be-3fbc-94f8-f72930b1384f",
                                "text": "I used to hate doing devos, but now I just have to do devos. When I don't, it just feels like something's wrong."
                            },
                            {
                                "example_id": "184da0da-78bb-4e53-8873-db1b2452d3a6",
                                "sense_id": "646adaad-e1be-3fbc-94f8-f72930b1384f",
                                "text": "Consider this: If a friend asked you to do a devo with them for a month, how would you feel? […] Call your devo-partner (or better yet, take a WEEKEND WALK together) and spend some time reflecting on the past week."
                            }
                        ]
                    }
