            "senses": [
                {
                    "sense_id": "c06e30e9-8120-32d0-b77f-6e828761a5ac",
                    "sense_definition": "iets dat angst of grote bezorgdheid veroorzaakt omdat het op gevaar of problemen wijst",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verontrustend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts vond de resultaten van het bloedonderzoek <w>alarmerend</w> en stelde een vervolgonderzoek voor.",
                            "target_lang_translations": {
                                "en": "The doctor found the results of the blood test <w>alarming</w> and suggested a follow-up examination."
                            }
                        },
                        {
                            "text": "Er is een <w>alarmerende</w> toename van het aantal mensen dat zonder werk komt te zitten.",
                            "target_lang_translations": {
                                "en": "There is an <w>alarming</w> increase in the number of people becoming unemployed."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevaarlijk",
                        "verontrustend"
                    ],
                    "antonyms": [
                        "geruststellend",
                        "ongevaarlijk"
                    ],
                    "common_phrases": [
                        "alarmerende toename",
                        "alarmerende berichten",
                        "alarmerende situatie"
                    ],
                    "target_lang_definitions": {
                        "en": "something that causes fear or great concern because it indicates danger or problems"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alarming",
                                "target_lang_sense_clarification": "causing worry or fear"
                            },
                            {
                                "target_lang_word": "disturbing",
                                "target_lang_sense_clarification": "causing anxiety or concern"
                            },
                            {
                                "target_lang_word": "concerning",
                                "target_lang_sense_clarification": "worrying"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eef13678-254c-3c28-ac1b-f72b92de60e9",
                    "sense_definition": "onvoltooid deelwoord van <w>alarmeren</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuige rende naar buiten, luidkeels de buurt <w>alarmerend</w> over de brand.",
                            "target_lang_translations": {
                                "en": "The witness ran outside, loudly <w>alarming</w> the neighborhood about the fire."
                            }
                        },
                        {
                            "text": "Door de politie te bellen en zo iedereen <w>alarmerend</w>, voorkwam hij een ramp.",
                            "target_lang_translations": {
                                "en": "By calling the police and thus <w>alerting</w> everyone, he prevented a disaster."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of the verb 'to alarm' or 'to alert'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alarming",
                                "target_lang_sense_clarification": "the act of warning others"
                            },
                            {
                                "target_lang_word": "alerting",
                                "target_lang_sense_clarification": "warning someone of a danger"
                            }
                        ]
                    }
                }
            ]
