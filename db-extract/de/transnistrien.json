                "senses": [
                    {
                        "sense_id": "5d078e53-db64-39b3-abe8-19ff810d601a",
                        "entry_id": "a57fcbf4-4a44-3b2f-bc4e-bb93603ae9d3",
                        "glosses": [
                            "Region im Osten Moldawiens, die sich zwar von Moldawien unabhängig erklärt hat, aber nicht als unabhängiger Staat anerkannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8edf92a-95a8-42a3-ad5f-b12be494db99",
                                "sense_id": "5d078e53-db64-39b3-abe8-19ff810d601a",
                                "text": "Transnistrien liegt östlich des Flusses Dnister."
                            },
                            {
                                "example_id": "65bb1759-42c5-4575-940c-1ba7148ccc33",
                                "sense_id": "5d078e53-db64-39b3-abe8-19ff810d601a",
                                "text": "„Manche melden sich gleich in Transnistrien an, um die paar Rubel Zusatzrente zu bekommen, die Russland zahlt.“"
                            },
                            {
                                "example_id": "da572179-2793-4a0a-8027-0f030dbe1892",
                                "sense_id": "5d078e53-db64-39b3-abe8-19ff810d601a",
                                "text": "„Wenn es einen Staat gab, der noch unbekannter als die Republik Moldau war, dann war es Transnistrien.“"
                            },
                            {
                                "example_id": "8a916a13-10a8-40ce-a087-72cab210c219",
                                "sense_id": "5d078e53-db64-39b3-abe8-19ff810d601a",
                                "text": "„Appelfelds Mutter war 1941, als er acht gewesen war, von rumänischen Soldaten ermordet worden; er war aus einem Konzentrationslager in Transnistrien geflohen und hatte drei Jahre auf der Flucht verbracht: Er hatte sich in den Wäldern versteckt und als Hirtenjunge gearbeitet und die Tatsache, dass er Jude war, die ganze Zeit verheimlicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c667a3a-a30c-42bb-b833-fdd0ad859556",
