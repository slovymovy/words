                "senses": [
                    {
                        "sense_id": "2a843923-2978-395a-8c8c-4983ce360800",
                        "entry_id": "15160245-3118-36c7-b955-fe2e43f43efc",
                        "glosses": [
                            "in omvang of getal groter wordend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c894ed2d-b91b-4ab3-a360-283f1cd6bcff",
                                "sense_id": "2a843923-2978-395a-8c8c-4983ce360800",
                                "text": "De toenemende welvaart gaat gepaard met een toenemende vraag naar energie."
                            },
                            {
                                "example_id": "2cb6ce73-79d5-4c3f-98d2-d59e8c345e62",
                                "sense_id": "2a843923-2978-395a-8c8c-4983ce360800",
                                "text": "De stad is toneel van toenemend geweld."
                            },
                            {
                                "example_id": "ecf2c1f9-6e72-4729-9a19-d524c1c745fe",
                                "sense_id": "2a843923-2978-395a-8c8c-4983ce360800",
                                "text": "In onze tijd bestaat er een toenemende belangstelling, zowel voor de folklore als voor de achtergrond en de inhoud van de feesten. Temeer als die beleefd kunnen worden door het hele gezin en de hele groep, jong of oud."
                            }
                        ]
                    }
                ],
