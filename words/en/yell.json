{
    "word_family": [
        "yeller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e6bd081-f954-3ddb-8d05-99f5e99a3e2c",
                    "sense_definition": "To shout; to make a loud sound with the voice, especially to express intense emotions such as anger, excitement, or pain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_make_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>yell</w> inside the library.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>кричите</w> в библиотеке.",
                                "zh": "请不要在图书馆里<w>大声喊叫</w>。"
                            }
                        },
                        {
                            "text": "The crowd started to <w>yell</w> with excitement when the team scored a goal.",
                            "target_lang_translations": {
                                "ru": "Толпа начала <w>кричать</w> от восторга, когда команда забила гол.",
                                "zh": "当球队进球时，人群兴奋地<w>欢呼</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "holler",
                        "scream"
                    ],
                    "common_phrases": [
                        "yell for help",
                        "yell out",
                        "yell in pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кричать; издавать громкий звук голосом, особенно для выражения сильных эмоций, таких как гнев, волнение или боль.",
                        "zh": "大声喊叫；用声音发出响亮的声音，通常用于表达愤怒、兴奋或痛苦等强烈情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкий звук"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "разговорное; кричать очень громко"
                            },
                            {
                                "target_lang_word": "вопить",
                                "target_lang_sense_clarification": "издавать пронзительные крики (от боли или страха)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喊",
                                "target_lang_sense_clarification": "大声叫喊"
                            },
                            {
                                "target_lang_word": "大叫",
                                "target_lang_sense_clarification": "发出响亮的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc157786-b556-33c0-85da-cae6999c4f40",
                    "sense_definition": "To tell someone off or scold them, typically in a loud and angry manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_scold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father used to <w>yell</w> at me when I came home late.",
                            "target_lang_translations": {
                                "ru": "Мой отец обычно <w>кричал</w> на меня, когда я приходил домой поздно.",
                                "zh": "我父亲以前在我晚回家时总会<w>吼</w>我。"
                            }
                        },
                        {
                            "text": "She did not mean to <w>yell</w> at the children for making a mess.",
                            "target_lang_translations": {
                                "ru": "Она не хотела <w>кричать</w> на детей за то, что они устроили беспорядок.",
                                "zh": "她并不是故意因为孩子们弄乱了东西而<w>冲</w>他们<w>大喊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "scream",
                        "bellow"
                    ],
                    "common_phrases": [
                        "yell at someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ругать или отчитывать кого-либо, обычно громко и сердито.",
                        "zh": "通常以大声且愤怒的方式责备或训斥某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "на кого-либо; ругать"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "на кого-либо; грубо ругать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吼",
                                "target_lang_sense_clarification": "大声斥责"
                            },
                            {
                                "target_lang_word": "冲……大喊",
                                "target_lang_sense_clarification": "对某人发火"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f449c945-4136-3b35-b248-d0977a9aee4e",
                    "sense_definition": "To convey information or directions by shouting.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_make_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>yelled</w> directions to the lost tourists from across the street.",
                            "target_lang_translations": {
                                "ru": "Он <w>прокричал</w> дорогу заблудившимся туристам с другой стороны улицы.",
                                "zh": "他从街对面<w>大声喊出</w>方向，指引那些迷路的游客。"
                            }
                        },
                        {
                            "text": "The captain <w>yelled</w> orders to the crew during the storm.",
                            "target_lang_translations": {
                                "ru": "Капитан <w>выкрикивал</w> приказы команде во время шторма.",
                                "zh": "暴风雨中，船长向船员<w>高声下达</w>了命令。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "call"
                    ],
                    "common_phrases": [
                        "yell instructions",
                        "yell orders"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать информацию или указания криком.",
                        "zh": "通过大喊来传达信息或指令。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "сообщать громким голосом"
                            },
                            {
                                "target_lang_word": "выкрикивать",
                                "target_lang_sense_clarification": "громко произносить слова"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喊出",
                                "target_lang_sense_clarification": "大声说出指令"
                            },
                            {
                                "target_lang_word": "高声传达",
                                "target_lang_sense_clarification": "大声告知信息"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7fe2527-c68a-3404-8c3c-3c456f720e84",
                    "sense_definition": "A loud shout or cry, often expressing strong emotion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a loud <w>yell</w> of surprise when she saw the gift.",
                            "target_lang_translations": {
                                "ru": "Она издала громкий <w>крик</w> удивления, когда увидела подарок.",
                                "zh": "看到礼物时，她惊讶地发出了一声<w>喊叫</w>。"
                            }
                        },
                        {
                            "text": "We heard a <w>yell</w> coming from the playground and ran to help.",
                            "target_lang_translations": {
                                "ru": "Мы услышали <w>крик</w>, доносящийся с детской площадки, и побежали на помощь.",
                                "zh": "我们听到操场上传来一声<w>喊声</w>，便跑过去帮忙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "cry",
                        "call",
                        "holler",
                        "scream"
                    ],
                    "common_phrases": [
                        "let out a yell",
                        "give a yell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий крик или возглас, часто выражающий сильную эмоцию.",
                        "zh": "响亮的喊叫声，通常表达强烈的情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "громкий звук голоса"
                            },
                            {
                                "target_lang_word": "вопль",
                                "target_lang_sense_clarification": "пронзительный или жалобный крик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喊声",
                                "target_lang_sense_clarification": "响亮的声音"
                            },
                            {
                                "target_lang_word": "尖叫",
                                "target_lang_sense_clarification": "刺耳的喊叫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3232a67c-cedb-3953-bbea-14f562e6cccc",
                    "sense_definition": "A rhythmic phrase or slogan shouted by a group, especially in support of a sports team.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_cheer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cheerleaders taught the crowd a new <w>yell</w> before the game started.",
                            "target_lang_translations": {
                                "ru": "Чирлидеры научили толпу новой <w>кричалке</w> перед началом игры.",
                                "zh": "比赛开始前，啦啦队长教了观众一个新的<w>加油口号</w>。"
                            }
                        },
                        {
                            "text": "Every student knew the school <w>yell</w> by heart and shouted it proudly.",
                            "target_lang_translations": {
                                "ru": "Каждый ученик знал школьную <w>кричалку</w> наизусть и гордо выкрикивал её.",
                                "zh": "每个学生都熟记学校的<w>加油口号</w>，并自豪地喊了出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "college yell",
                        "rebel yell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритмичная фраза или лозунг, выкрикиваемый группой, особенно в поддержку спортивной команды.",
                        "zh": "团体（尤其是体育队支持者）高喊的节奏性短语或口号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричалка",
                                "target_lang_sense_clarification": "спортивная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口号",
                                "target_lang_sense_clarification": "助威用的短语"
                            },
                            {
                                "target_lang_word": "加油口号",
                                "target_lang_sense_clarification": "体育竞技中的助威词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2c6d703f-5358-3cf3-89ea-94ab327fda54",
                    "sense_definition": "The second-largest island in the Shetland Islands council area, Scotland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a ferry to visit the island of <w>Yell</w> during our trip to Scotland.",
                            "target_lang_translations": {
                                "ru": "Мы сели на паром, чтобы посетить остров <w>Йелл</w> во время нашей поездки в Шотландию.",
                                "zh": "在苏格兰旅行期间，我们乘渡轮去了<w>耶尔岛</w>。"
                            }
                        },
                        {
                            "text": "The coastline of <w>Yell</w> is known for its rugged beauty and wildlife.",
                            "target_lang_translations": {
                                "ru": "Побережье <w>Йелл</w> известно своей суровой красотой и дикой природой.",
                                "zh": "<w>耶尔岛</w>的海岸线以其粗犷的美景和野生动物而闻名。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Второй по величине остров в архипелаге Шетландских островов, Шотландия.",
                        "zh": "苏格兰设得兰群岛议会区内第二大岛屿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Йелл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耶尔岛",
                                "target_lang_sense_clarification": "地理名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "492eb6c1-17bb-3695-b8b9-049e54db0307",
                    "sense_definition": "An unincorporated community in Marshall County, Tennessee, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in the small community of <w>Yell</w> in Tennessee.",
                            "target_lang_translations": {
                                "ru": "Он вырос в небольшой общине <w>Йелл</w> в штате Теннесси.",
                                "zh": "他在田纳西州的一个叫<w>耶尔</w>的小社区长大。"
                            }
                        },
                        {
                            "text": "The history of <w>Yell</w> dates back to the early nineteenth century.",
                            "target_lang_translations": {
                                "ru": "История <w>Йелл</w> восходит к началу девятнадцатого века.",
                                "zh": "<w>耶尔</w>的历史可以追溯到十九世纪初。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неинкорпорированная община в округе Маршалл, штат Теннесси, США.",
                        "zh": "美国田纳西州马歇尔县的一个非建制社区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Йелл",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耶尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81232bd2-4771-382b-96d5-c30911c7c015",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_person",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Yell</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Йелл</w> был известен своим вкладом в местную библиотеку.",
                                "zh": "<w>耶尔</w>先生因对当地图书馆的贡献而闻名。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Yell</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил женщину по имени Сара <w>Йелл</w> на конференции.",
                                "zh": "我在会议上遇到了一位名叫莎拉·<w>耶尔</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Йелл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耶尔",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "72eeb573-e09a-39fc-857c-3df501207512",
                    "sense_definition": "Dry; not producing milk (used of a cow).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "adj_dry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer decided to sell the <w>yell</w> cow at the market.",
                            "target_lang_translations": {
                                "ru": "Фермер решил продать <w>яловую</w> корову на рынке.",
                                "zh": "农夫决定把那头<w>不产奶的</w>母牛卖到市场上。"
                            }
                        },
                        {
                            "text": "After several years, the old cow became <w>yell</w> and stopped giving milk.",
                            "target_lang_translations": {
                                "ru": "Через несколько лет старая корова стала <w>яловой</w> и перестала давать молоко.",
                                "zh": "几年后，这头老牛变得<w>不产奶了</w>，不再产奶。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Scottish/Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Яловая; не дающая молока (о корове).",
                        "zh": "干的；不产奶的（指母牛）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яловая",
                                "target_lang_sense_clarification": "о корове"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不产奶的",
                                "target_lang_sense_clarification": "指母牛"
                            }
                        ]
                    }
                }
            ]
        }
