                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ea8b4ec-f524-3c78-812b-c126d822b5bb",
                                        "entry_id": "137a6e40-d260-3638-86a8-eec527aa6188",
                                        "glosses": [
                                            "A cruel or savage act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f457f1-777e-4ca4-b479-9d618cd406d2",
                                                "sense_id": "6ea8b4ec-f524-3c78-812b-c126d822b5bb",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police[…]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "576979dc-75de-3b9c-a1f1-9f781910867d",
                                        "entry_id": "137a6e40-d260-3638-86a8-eec527aa6188",
                                        "glosses": [
                                            "The use of excessive physical force, often in the form of violence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cadaa48-14c9-4374-ab6d-2a4bed77a631",
                                                "sense_id": "576979dc-75de-3b9c-a1f1-9f781910867d",
                                                "text": "police brutality"
                                            },
                                            {
                                                "example_id": "d7ec801d-3150-4b5f-971e-95ea3dea27d5",
                                                "sense_id": "576979dc-75de-3b9c-a1f1-9f781910867d",
                                                "text": "school brutality"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4f4e50c-f80e-498d-b9cc-cf3f05939063",
                        "source_entry_id": "0b5af886-40f8-321b-833b-444592aecde4",
                        "source_sense_id": "3447a59b-e822-3af5-9e9f-f3dd9145118b",
                        "target_lang_word": "brutalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brutalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                                        "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                                        "glosses": [
                                            "Caractère de celui qui est brutal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7ed428-2dc9-4b5f-8630-654b7b271ec1",
                                                "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                                                "text": "La brise fraîchissante du soir avait séché et soulevé ses cheveux, donnait à son visage un désordre à travers lequel apparaissait de la brutalité."
                                            },
                                            {
                                                "example_id": "e46c9a02-ac84-4bcd-bfbc-66cf3ec85ad8",
                                                "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                                                "text": "Sa brutalité lui a fait beaucoup d’ennemis."
                                            },
                                            {
                                                "example_id": "342868f4-bf12-4401-a7a0-fcf6bf11490b",
                                                "sense_id": "dd692a83-83fc-3c7a-b200-a1062c968fd9",
                                                "text": "Parler, répondre avec brutalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "368b4146-066e-36c7-b841-bad2521d2c87",
                                        "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                                        "glosses": [
                                            "Passion brutale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bde9a9c-7fba-491f-b2f6-c8bc04bc70ae",
                                                "sense_id": "368b4146-066e-36c7-b841-bad2521d2c87",
                                                "text": "Assouvir sa brutalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2be4e5b-d797-37fe-8c77-591727d564df",
                                        "entry_id": "b0439400-b4ec-353f-8f89-c7a2d11f8bf7",
                                        "glosses": [
                                            "Manière d’agir ou de parler brutale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5276757f-bc91-4c7d-94d8-8d7111cd54c4",
                                                "sense_id": "e2be4e5b-d797-37fe-8c77-591727d564df",
                                                "text": "On recommanda bien à cette femme, une fois de plus, de quitter son compagnon, qui en dehors de son alcoolisme et de sa brutalité, n'était de toutes façons qu'un bon à rien, incapable de garder un travail fixe bien longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
