                        "glosses": [
                            "zoals dat onder zakenlieden gebruikelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2769a1-fa37-449d-b1b0-5a0f1aaf4399",
                                "sense_id": "17431b6a-37f6-3ae1-80ce-bb92f39693e3",
                                "text": "Hij benaderde deze geruchtmakende materie een uiterst zakelijke wijze."
                            },
                            {
                                "example_id": "25fcabfc-0715-48c1-85f0-9f64399e7eee",
                                "sense_id": "17431b6a-37f6-3ae1-80ce-bb92f39693e3",
                                "text": "Sjarel Ex stopt komend najaar als directeur van het Rotterdamse museum Boijmans Van Beuningen. Ex is sinds 2004 artistiek en zakelijk eindverantwoordelijke bij het museum."
                            }
                        ]
                    },
                    {
                        "sense_id": "278c7f5d-35f1-3b1e-bd41-9dcaa2ca260e",
                        "entry_id": "e226737a-eff9-3d29-bdd3-173a4b255cc3",
                        "glosses": [
                            "gebaseerd op de feiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f83676a1-5369-4b45-a58e-2f26957f7c09",
                                "sense_id": "278c7f5d-35f1-3b1e-bd41-9dcaa2ca260e",
                                "text": "Maar zakelijk gezien viel er niet onderuit te komen."
                            }
                        ]
                    }
