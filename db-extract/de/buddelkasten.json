                "senses": [
                    {
                        "sense_id": "fbf1d66a-b0d3-37c7-a6d3-635426e39196",
                        "entry_id": "a3a4e085-948c-3f41-884b-853cf3309150",
                        "glosses": [
                            "Kasten mit Sand zum Spielen für Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f2b52a-a57c-4461-95ba-9b0fcbdbb18c",
                                "sense_id": "fbf1d66a-b0d3-37c7-a6d3-635426e39196",
                                "text": "Bei den Meiers steht nun auch so ein schrecklicher Buddelkasten im Garten."
                            },
                            {
                                "example_id": "bda30614-092f-4f7b-b3c1-c418afe5ef30",
                                "sense_id": "fbf1d66a-b0d3-37c7-a6d3-635426e39196",
                                "text": "Ihre Katzen haben sich in unserem Buddelkasten eine Toilette eingerichtet, Herr Nachbar."
                            },
                            {
                                "example_id": "3e3d695b-6b16-4e88-9cfe-161a0d8c8500",
                                "sense_id": "fbf1d66a-b0d3-37c7-a6d3-635426e39196",
                                "text": "Die Kinder bauen Sandburgen im Buddelkasten."
                            },
                            {
                                "example_id": "5992b761-2760-47b2-8f9b-12adf84360b9",
                                "sense_id": "fbf1d66a-b0d3-37c7-a6d3-635426e39196",
                                "text": "Weil sich die Kinder ständig gestritten haben, was im Sand gemacht werden soll, haben wir nun zwei Buddelkasten/Buddelkästen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
