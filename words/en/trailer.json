{
    "word_family": [
        "trail"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2bbcd00-20dd-352b-9f6b-500785d63aad",
                    "sense_definition": "A short video advertisement for a film, video game, or television show, showing clips from it to attract an audience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media_preview",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>trailer</w> for the new superhero movie looks absolutely amazing.",
                            "target_lang_translations": {
                                "ru": "<w>Трейлер</w> нового фильма о супергероях выглядит просто потрясающе.",
                                "zh": "这部新超级英雄电影的<w>预告片</w>看起来棒极了。"
                            }
                        },
                        {
                            "text": "I usually watch the <w>trailer</w> online before deciding to buy a cinema ticket.",
                            "target_lang_translations": {
                                "ru": "Я обычно смотрю <w>трейлер</w> в интернете, прежде чем решить купить билет в кино.",
                                "zh": "我通常在决定买电影票之前先在网上看<w>预告片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preview",
                        "teaser",
                        "promo"
                    ],
                    "common_phrases": [
                        "movie trailer",
                        "film trailer",
                        "watch the trailer",
                        "official trailer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий рекламный видеоролик фильма, видеоигры или телешоу, состоящий из фрагментов, для привлечения аудитории.",
                        "zh": "电影、电子游戏或电视节目的简短宣传视频，通过展示片段来吸引观众。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трейлер",
                                "target_lang_sense_clarification": "рекламный ролик"
                            },
                            {
                                "target_lang_word": "анонс",
                                "target_lang_sense_clarification": "предварительный показ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预告片",
                                "target_lang_sense_clarification": "影视宣传片"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71b414fa-9051-353c-af79-9ebe5e756e3b",
                    "sense_definition": "An unpowered vehicle pulled by another vehicle, used to transport heavy goods, equipment, or materials.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_cargo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We rented a utility <w>trailer</w> to move our furniture to the new house.",
                            "target_lang_translations": {
                                "ru": "Мы арендовали грузовой <w>прицеп</w>, чтобы перевезти мебель в новый дом.",
                                "zh": "我们租了一辆货运<w>拖车</w>把家具搬到新家。"
                            }
                        },
                        {
                            "text": "The truck pulled a heavy <w>trailer</w> loaded with logs down the highway.",
                            "target_lang_translations": {
                                "ru": "Грузовик тянул по шоссе тяжелый <w>прицеп</w>, груженный бревнами.",
                                "zh": "卡车在高速公路上拉着一辆装满原木的沉重<w>挂车</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "boat trailer",
                        "utility trailer",
                        "horse trailer",
                        "tractor-trailer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несамоходное транспортное средство, буксируемое другим транспортным средством, используемое для перевозки тяжелых грузов или оборудования.",
                        "zh": "由另一辆车牵引的无动力车辆，用于运输重物、设备或材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прицеп",
                                "target_lang_sense_clarification": "транспортное средство"
                            },
                            {
                                "target_lang_word": "трейлер",
                                "target_lang_sense_clarification": "специальный прицеп"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖车",
                                "target_lang_sense_clarification": "运输车辆"
                            },
                            {
                                "target_lang_word": "挂车",
                                "target_lang_sense_clarification": "大型运输挂车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57ee3628-f4cb-3870-b803-f69226b96df4",
                    "sense_definition": "A vehicle furnished for living or sleeping in, towed behind a car or truck, often used for camping or travel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_living",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire summer traveling around the country in a <w>trailer</w>.",
                            "target_lang_translations": {
                                "ru": "Они провели все лето, путешествуя по стране в <w>трейлере</w>.",
                                "zh": "他们整个夏天都在开着<w>房车</w>环游全国。"
                            }
                        },
                        {
                            "text": "We parked our <w>trailer</w> at the campsite near the lake for the weekend.",
                            "target_lang_translations": {
                                "ru": "Мы припарковали наш <w>трейлер</w> в кемпинге у озера на выходные.",
                                "zh": "周末我们把<w>房车</w>停在了湖边的露营地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "camper",
                        "caravan",
                        "travel trailer",
                        "mobile home",
                        "RV"
                    ],
                    "common_phrases": [
                        "camping trailer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство, оборудованное для жилья или ночлега, буксируемое автомобилем; часто используется для кемпинга.",
                        "zh": "一种配备了生活或睡眠设施的车辆，由汽车或卡车牵引，常用于露营或旅行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трейлер",
                                "target_lang_sense_clarification": "жилой фургон"
                            },
                            {
                                "target_lang_word": "дом на колёсах",
                                "target_lang_sense_clarification": "автодом"
                            },
                            {
                                "target_lang_word": "кемпер",
                                "target_lang_sense_clarification": "фургон для кемпинга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "房车",
                                "target_lang_sense_clarification": "可居住的拖挂式车辆"
                            },
                            {
                                "target_lang_word": "露营车",
                                "target_lang_sense_clarification": "用于旅行的拖车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01f690b1-4dd1-3da1-9bbc-991988f21a87",
                    "sense_definition": "A prefabricated home designed to be transported but typically kept permanently in one place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle_living",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young couple bought a <w>trailer</w> in a quiet park as their first home.",
                            "target_lang_translations": {
                                "ru": "Молодая пара купила <w>трейлер</w> в тихом парке в качестве своего первого жилья.",
                                "zh": "这对年轻夫妇在一个安静的园区买了一间<w>活动房屋</w>作为他们的第一个家。"
                            }
                        },
                        {
                            "text": "After the storm, many families in the <w>trailer</w> park needed temporary shelter.",
                            "target_lang_translations": {
                                "ru": "После шторма многим семьям в парке <w>трейлеров</w> потребовалось временное убежище.",
                                "zh": "风暴过后，许多住在<w>活动房屋</w>区里的家庭需要临时住所。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mobile home"
                    ],
                    "common_phrases": [
                        "trailer park",
                        "trailer home"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сборный дом, предназначенный для транспортировки, но обычно устанавливаемый на постоянном месте.",
                        "zh": "一种预制房屋，设计用于运输，但通常长期固定在一个地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трейлер",
                                "target_lang_sense_clarification": "жилище"
                            },
                            {
                                "target_lang_word": "вагончик",
                                "target_lang_sense_clarification": "временное жильё"
                            },
                            {
                                "target_lang_word": "мобильный дом",
                                "target_lang_sense_clarification": "передвижной дом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活动房屋",
                                "target_lang_sense_clarification": "可移动的住宅"
                            },
                            {
                                "target_lang_word": "拖车屋",
                                "target_lang_sense_clarification": "简易住宅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fb55254-c47b-3188-b74e-13ceb2e0f6ee",
                    "sense_definition": "The final part of a data packet, file, or transmission, often containing control information or a check sequence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software checks the <w>trailer</w> to verify the integrity of the data packet.",
                            "target_lang_translations": {
                                "ru": "Программа проверяет <w>трейлер</w> (концевик), чтобы подтвердить целостность пакета данных.",
                                "zh": "该软件通过检查<w>尾部</w>来验证数据包的完整性。"
                            }
                        },
                        {
                            "text": "Each transmission block consists of a header, the data body, and a <w>trailer</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый блок передачи состоит из заголовка, тела данных и <w>трейлера</w>.",
                                "zh": "每个传输块由头部、数据主体和<w>尾部</w>组成。"
                            }
                        }
                    ],
                    "antonyms": [
                        "header"
                    ],
                    "common_phrases": [
                        "trailer record",
                        "packet trailer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключительная часть пакета данных, файла или передачи, часто содержащая контрольную информацию.",
                        "zh": "数据包、文件或传输的最后部分，通常包含控制信息或校验序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трейлер",
                                "target_lang_sense_clarification": "информатика"
                            },
                            {
                                "target_lang_word": "концевик",
                                "target_lang_sense_clarification": "конец записи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尾部",
                                "target_lang_sense_clarification": "数据包末端"
                            },
                            {
                                "target_lang_word": "结束符",
                                "target_lang_sense_clarification": "数据记录末尾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9628054-ed04-3f8d-904d-3b5f3d534875",
                    "sense_definition": "A part of an object, such as a plant stem, that extends or drags behind the main body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "extension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ivy sent out a long <w>trailer</w> that crept across the garden path.",
                            "target_lang_translations": {
                                "ru": "Плющ выпустил длинный <w>побег</w>, который пополз по садовой дорожке.",
                                "zh": "常春藤伸出一条长长的<w>蔓</w>，爬过了花园小径。"
                            }
                        },
                        {
                            "text": "You should trim the dead <w>trailer</w> to encourage new growth on the plant.",
                            "target_lang_translations": {
                                "ru": "Вам следует обрезать засохший <w>ус</w>, чтобы стимулировать новый рост растения.",
                                "zh": "你应该修剪掉枯死的<w>藤</w>，以促进植物长出新芽。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extension",
                        "appendage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть объекта, например стебель растения, которая тянется или стелется за основной частью.",
                        "zh": "物体的一部分，例如植物的茎，延伸或拖在主体后面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побег",
                                "target_lang_sense_clarification": "ботаника"
                            },
                            {
                                "target_lang_word": "ус",
                                "target_lang_sense_clarification": "часть растения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蔓",
                                "target_lang_sense_clarification": "植物延伸的部分"
                            },
                            {
                                "target_lang_word": "藤",
                                "target_lang_sense_clarification": "植物的茎"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb3f6e6a-cebc-335d-a006-c7d486899e9e",
                    "sense_definition": "Someone who follows or tracks another person or vehicle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "follower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy took a sudden turn to shake off his <w>trailer</w>.",
                            "target_lang_translations": {
                                "ru": "Шпион резко свернул, чтобы оторваться от своего <w>преследователя</w>.",
                                "zh": "间谍突然转弯，试图甩掉他的<w>跟踪者</w>。"
                            }
                        },
                        {
                            "text": "She suspected she had a <w>trailer</w> following her car through the city.",
                            "target_lang_translations": {
                                "ru": "Она подозревала, что за ее машиной по городу едет <w>преследователь</w>.",
                                "zh": "她怀疑有一名<w>跟踪者</w>开车在城里尾随她。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто следует за другим человеком или транспортным средством, выслеживая его.",
                        "zh": "跟踪或尾随他人或车辆的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преследователь",
                                "target_lang_sense_clarification": "человек"
                            },
                            {
                                "target_lang_word": "сыщик",
                                "target_lang_sense_clarification": "детектив"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跟踪者",
                                "target_lang_sense_clarification": "尾随他人的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0aa20449-92d4-34e9-8588-063063ed4948",
                    "sense_definition": "To transport something, such as a vehicle or animal, using a trailer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>trailer</w> the broken car to the nearest mechanic.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>везти на прицепе</w> сломанную машину к ближайшему механику.",
                                "zh": "我们不得不把坏掉的车<w>拖运</w>到最近的修理厂。"
                            }
                        },
                        {
                            "text": "They <w>trailer</w> their horses to competitions almost every weekend.",
                            "target_lang_translations": {
                                "ru": "Они <w>возят</w> своих лошадей <w>в трейлере</w> на соревнования почти каждые выходные.",
                                "zh": "他们几乎每个周末都用拖车把马<w>拖运</w>去参加比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trailer a boat",
                        "trailer a horse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить что-либо, например транспортное средство или животное, используя прицеп.",
                        "zh": "使用拖车运输某物，例如车辆或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить на прицепе",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "буксировать",
                                "target_lang_sense_clarification": "тянуть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖运",
                                "target_lang_sense_clarification": "用拖车运输"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}