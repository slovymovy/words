                        "examples": [
                            {
                                "example_id": "b9cf84b8-67fd-463d-9610-97fa096dd0c6",
                                "sense_id": "61c8b35e-00ce-3597-8230-870d5aaccc41",
                                "text": "„Die Flügelgläser werden auch \"gekniffene Gläser\" genannt, abgeleitet von der Art der Herstellung.“"
                            },
                            {
                                "example_id": "c92e0c8a-ad85-4161-89a2-df4aa5752d69",
                                "sense_id": "61c8b35e-00ce-3597-8230-870d5aaccc41",
                                "text": "„Wir erinnern hier nur an die stattlichen Kelche und Flügelgläser, an die milchfarbigen und fadenförmigen Glasflüsse venetianischer Fabriken, die heute von Liebhabern sehr gesucht sind.“"
                            }
