                    {
                        "sense_id": "a5c4842c-5165-39f9-aeee-9d5c1db49265",
                        "entry_id": "947593d0-9fdc-3ab3-96f8-750767832eca",
                        "glosses": [
                            "nazwa kilkunastu miejscowości, dzielnic i części miast w Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7af5b35e-0b10-4571-8521-c19bf0a9f6e6",
                                "sense_id": "a5c4842c-5165-39f9-aeee-9d5c1db49265",
                                "text": "Chełm był tuż przede mną, plątanina domów, ogrodów i cerkwi, osypana błyszczącą rosą świateł, piętrzyła się na tle nieba czarnymi, groźnymi konturami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "29a7f3bc-b343-300f-84da-0df239938ddc",
                        "entry_id": "947593d0-9fdc-3ab3-96f8-750767832eca",
                        "glosses": [
                            "nazwa kilku gór i wzniesień w Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe103e36-75db-4306-ac8a-8094e9bc517d",
                                "sense_id": "29a7f3bc-b343-300f-84da-0df239938ddc",
                                "text": "Dość rozległe, częściowo jedynie zalesione wzgórze Chełmu stanowi kulminację w grzbiecie wododziałowym Wisły i Odry"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "863eb411-d74b-38b2-9dc6-675656488d60",
                        "entry_id": "947593d0-9fdc-3ab3-96f8-750767832eca",
                        "glosses": [
                            "mezoregion fizycznogeograficzny, garb na Wyżynie Śląskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a411d8-589b-4cd3-8516-cb63fe473a2f",
                                "sense_id": "863eb411-d74b-38b2-9dc6-675656488d60",
                                "text": "Powierzchnia Chełma wynosi ok. 320 km²."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "bcbc37ad-225e-3032-9544-e8c8603c114e",
                        "entry_id": "947593d0-9fdc-3ab3-96f8-750767832eca",
                        "glosses": [
                            "jezioro w gminie Łobez, w województwie zachodniopomorskim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b234f0a-bac7-4785-bfbf-8f98cf4473aa",
