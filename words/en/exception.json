{
    "word_family": [
        "except",
        "exceptional",
        "exceptionally",
        "exceptionable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c23d9cc6-b05d-3eab-8e29-c9ad1094cb3a",
                    "sense_definition": "Something or someone that does not follow a rule or is not included in a general statement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exclusion_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most birds can fly, but the penguin is a well-known <w>exception</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство птиц умеют летать, но пингвин — известное <w>исключение</w>.",
                                "zh": "大多数鸟类都会飞，但企鹅是一个众所周知的<w>例外</w>。"
                            }
                        },
                        {
                            "text": "We usually do not allow pets, but we will make an <w>exception</w> in this case.",
                            "target_lang_translations": {
                                "ru": "Обычно мы не разрешаем домашних животных, но в этом случае сделаем <w>исключение</w>.",
                                "zh": "我们通常不允许携带宠物，但在这种情况下我们会破例<w>例外</w>处理。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outlier",
                        "exclusion",
                        "special case"
                    ],
                    "antonyms": [
                        "generality",
                        "commonness"
                    ],
                    "common_phrases": [
                        "exception to the rule",
                        "make an exception",
                        "without exception",
                        "no exception"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то или кто-то, что не подчиняется правилу или не включено в общее утверждение.",
                        "zh": "指不遵循规则或未被包含在一般陈述中的事物或人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "отступление от правил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "例外",
                                "target_lang_sense_clarification": "不符合常规的情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41d40f72-0825-3f01-bc0d-5a79b1371c40",
                    "sense_definition": "The act of leaving someone or something out of a group or list.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "exclusion_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone was invited to the party with the <w>exception</w> of the new neighbors.",
                            "target_lang_translations": {
                                "ru": "На вечеринку пригласили всех, за <w>исключением</w> новых соседей.",
                                "zh": "除了新邻居外，所有人都被邀请参加了聚会，这是个<w>除外</w>。"
                            }
                        },
                        {
                            "text": "The law applies to all citizens with the <w>exception</w> of those under eighteen.",
                            "target_lang_translations": {
                                "ru": "Закон распространяется на всех граждан, за <w>исключением</w> лиц моложе восемнадцати лет.",
                                "zh": "该法律适用于所有公民，十八岁以下者<w>除外</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "with the exception of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в том, чтобы не включать кого-то или что-то в группу или список.",
                        "zh": "将某人或某物排除在群体或列表之外的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "изъятие",
                                "target_lang_sense_clarification": "удаление из состава"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除外",
                                "target_lang_sense_clarification": "排除在范围之外"
                            },
                            {
                                "target_lang_word": "排除",
                                "target_lang_sense_clarification": "不包括在内"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89221f28-736f-3f4b-9b5e-a122ed0e90cc",
                    "sense_definition": "A feeling of disagreement, anger, or offense, usually used in the phrase 'take exception'.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took great <w>exception</w> to the rude comments made about her work.",
                            "target_lang_translations": {
                                "ru": "Она выразила сильное <w>несогласие</w> с грубыми комментариями о её работе.",
                                "zh": "她对有关她工作的粗鲁评论表示强烈<w>反对</w>。"
                            }
                        },
                        {
                            "text": "I take <w>exception</w> to the suggestion that I was not honest.",
                            "target_lang_translations": {
                                "ru": "Я выражаю <w>возражение</w> против предположения, что я был нечестен.",
                                "zh": "我对说我不诚实的暗示表示<w>异议</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take exception to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство несогласия, гнева или обиды; обычно используется в выражении 'take exception'.",
                        "zh": "一种不赞同、愤怒或被冒犯的感觉，通常用于短语“take exception”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возражение",
                                "target_lang_sense_clarification": "протест"
                            },
                            {
                                "target_lang_word": "несогласие",
                                "target_lang_sense_clarification": "обида"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反对",
                                "target_lang_sense_clarification": "表示不赞同"
                            },
                            {
                                "target_lang_word": "异议",
                                "target_lang_sense_clarification": "不同意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca55fe69-af33-3c7f-84a5-cbf74198031e",
                    "sense_definition": "An error or unexpected event that occurs during the execution of a computer program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application crashed because of an unhandled null pointer <w>exception</w>.",
                            "target_lang_translations": {
                                "ru": "Приложение завершилось сбоем из-за необработанного <w>исключения</w> нулевого указателя.",
                                "zh": "由于存在未处理的空指针<w>异常</w>，应用程序崩溃了。"
                            }
                        },
                        {
                            "text": "Developers must write code to catch every possible <w>exception</w> to prevent errors.",
                            "target_lang_translations": {
                                "ru": "Разработчики должны писать код для перехвата каждого возможного <w>исключения</w>, чтобы предотвратить ошибки.",
                                "zh": "开发人员必须编写代码来捕获所有可能的<w>异常</w>以防止错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "throw an exception",
                        "catch an exception",
                        "unhandled exception"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибка или непредвиденное событие, возникающее во время выполнения компьютерной программы.",
                        "zh": "计算机程序执行过程中发生的错误或意外事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "информатика"
                            },
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "сбой программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异常",
                                "target_lang_sense_clarification": "计算机程序运行中的错误"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1829d40b-77b1-3f5c-8b62-ddfcd6c5aab8",
                    "sense_definition": "A formal objection or a specific clause in a legal document that excludes something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_clause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney filed an <w>exception</w> to the judge's ruling.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты подал <w>возражение</w> на постановление судьи.",
                                "zh": "辩护律师对法官的裁决提出了<w>异议</w>。"
                            }
                        },
                        {
                            "text": "The property deed contains an <w>exception</w> regarding the mineral rights.",
                            "target_lang_translations": {
                                "ru": "Документ на право собственности содержит <w>оговорку</w> касательно прав на полезные ископаемые.",
                                "zh": "房产契约中包含一项关于矿产权利的<w>除外条款</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное возражение или особый пункт в юридическом документе, исключающий что-либо.",
                        "zh": "法律文件中的正式反对意见或排除某项内容的特定条款。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возражение",
                                "target_lang_sense_clarification": "юридическое"
                            },
                            {
                                "target_lang_word": "отвод",
                                "target_lang_sense_clarification": "отклонение кандидатуры или требования"
                            },
                            {
                                "target_lang_word": "оговорка",
                                "target_lang_sense_clarification": "пункт в документе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "异议",
                                "target_lang_sense_clarification": "法律上的正式反对"
                            },
                            {
                                "target_lang_word": "除外条款",
                                "target_lang_sense_clarification": "法律文件中的排除性规定"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}