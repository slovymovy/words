                "senses": [
                    {
                        "sense_id": "9979f543-5479-3c54-9800-b7ea27d0a91f",
                        "entry_id": "fabfae02-b30a-3a37-b963-ec8d4cc79cd3",
                        "glosses": [
                            "Faire sortir quelque chose de ce qui l’abrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfae18aa-183b-423b-8de1-d5a7ab4ef478",
                                "sense_id": "9979f543-5479-3c54-9800-b7ea27d0a91f",
                                "text": "Quand on parvient à évulser adroitement, quand on désenchatonne le globe oculaire de dessous la cornée transparente qui l’abrite, on constate que la rétine qui en fait la masse a une forme ovoïde, de globuleuse qu’elle devait être avant l’énucléation."
                            },
                            {
                                "example_id": "a9ea4245-6f36-4206-82e5-dfeaf999f66e",
                                "sense_id": "9979f543-5479-3c54-9800-b7ea27d0a91f",
                                "text": "La tumeur fut aisément désenchatonnée."
                            },
                            {
                                "example_id": "b070eea7-f8b5-4359-bcac-e0ab0a804e3b",
                                "sense_id": "9979f543-5479-3c54-9800-b7ea27d0a91f",
                                "text": "M Bérard répond à cela que le difficile n’a pas été de faire franchir au cristallin l’ouverture de la cornée, mais bien de le désenchatonner, quel est ce rôle, et quelles inductions peut-on en tirer pour la thérapeutique ?"
                            }
                        ]
                    }
                ],
