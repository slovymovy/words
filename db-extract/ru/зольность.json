                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c878c4-1ae7-3fe8-9589-da2c4d615e00",
                                        "entry_id": "37797175-b627-39f8-81c3-b85fb35dd988",
                                        "glosses": [
                                            "Verbrennungsrückstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97da6e65-0fd5-4b69-b6f4-1d53e64ddade",
                                                "sense_id": "f8c878c4-1ae7-3fe8-9589-da2c4d615e00",
                                                "text": "Es verbrannte zu Asche."
                                            },
                                            {
                                                "example_id": "28d9a160-def2-4258-be61-92fb1fcf03da",
                                                "sense_id": "f8c878c4-1ae7-3fe8-9589-da2c4d615e00",
                                                "text": "„Er klopfte die Asche aus seiner Pfeife und stopfte sie erneut.“"
                                            },
                                            {
                                                "example_id": "987730e6-10f0-4ac9-b762-74d76097c7fb",
                                                "sense_id": "f8c878c4-1ae7-3fe8-9589-da2c4d615e00",
                                                "text": "[Dita Kraus, Überlebende des Konzentrationslagers Auschwitz:] „»Die Luft war voller Asche, wie Schnee. Vom Rauch der Schornsteine.«“"
                                            },
                                            {
                                                "example_id": "d3e1bea7-7139-4072-bd12-546f3db7ef76",
                                                "sense_id": "f8c878c4-1ae7-3fe8-9589-da2c4d615e00",
                                                "text": "„Ich bückte mich und warf Herbert eine Handvoll Asche ins Gesicht.“"
                                            },
                                            {
                                                "example_id": "1eca6b43-783f-4583-b672-f5c51646130b",
                                                "sense_id": "f8c878c4-1ae7-3fe8-9589-da2c4d615e00",
                                                "text": "„Die Finger lagen lose um die Zigarette, schnippten in regelmäßigen Abständen die Asche auf die Steinfliesen, wo sie sich aufzulösen schien und verschwand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e9d44494-cf8d-3aad-91f0-dbe9cf8de249",
                                        "entry_id": "37797175-b627-39f8-81c3-b85fb35dd988",
                                        "glosses": [
                                            "feinkörniger Auswurf von Vulkanen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f54a90-b55a-4f3f-9523-8ba6ad8fb724",
                                                "sense_id": "e9d44494-cf8d-3aad-91f0-dbe9cf8de249",
                                                "text": "Der Vulkan spie Asche und Lava."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9f99aadd-4cde-34f2-9251-cb81274f37fa",
                                        "entry_id": "37797175-b627-39f8-81c3-b85fb35dd988",
                                        "glosses": [
