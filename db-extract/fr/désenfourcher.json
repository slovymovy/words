                        "glosses": [
                            "Descendre de ce qu’on avait enfourché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dca58ef-459b-4d42-b5da-e6a72138bb24",
                                "sense_id": "68e5e003-69bd-3dda-b234-6ef1533419c6",
                                "text": "Il n’est pas si facile qu’on croit de désenfourcher Pégase, quelque mauvais cavalier qu’on puisse être."
                            },
                            {
                                "example_id": "e6df9f14-8ea1-4dea-9adf-33fc48286420",
                                "sense_id": "68e5e003-69bd-3dda-b234-6ef1533419c6",
                                "text": "Quand il a eu fini de ne pas faire et qu’il a désenfourché sa cavale un peu frustrée, alors il y est allé de son petit couplet."
                            }
                        ]
                    }
