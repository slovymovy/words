                    }
                ],
                "translations": [
                    {
                        "translation_id": "42f4d11b-baee-4d78-bd0e-3158a2ba06aa",
                        "source_entry_id": "a4531aec-b9a8-32f0-ba86-e8b9a867d2e6",
