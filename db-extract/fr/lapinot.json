                                            {
                                                "example_id": "1b0d30bd-758a-461f-8ecb-6d87a284bbb9",
                                                "sense_id": "78dc8659-99b7-31c6-8dc5-329f82eaf4cd",
                                                "text": "Let’s start on the bunny slope."
                                            },
                                            {
                                                "example_id": "732d726a-4189-4664-8e4d-85dd003d409a",
                                                "sense_id": "78dc8659-99b7-31c6-8dc5-329f82eaf4cd",
                                                "text": "We are on the bunniest of bunny hills. I've fallen no fewer than six times and I love every minute of it."
                                            }
                                        ]
                                    }
                                ]
                            },
