                "senses": [
                    {
                        "sense_id": "459abf45-9acf-3234-9ac9-e33f70dad5bf",
                        "entry_id": "99b77b87-bf97-33eb-9a45-57b437bbf748",
                        "glosses": [
                            "Person, die sich wissenschaftlich mit Witzen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5515fab-0935-499c-900c-017979d3ad21",
                                "sense_id": "459abf45-9acf-3234-9ac9-e33f70dad5bf",
                                "text": "„Erstmals wurden Kabarettisten, Komiker, Witzeforscher und das, was wir später »Comedians« nennen sollten und wollten, auf die schmutzigen und trüben, aber authentischen, weil infantilen und anarchischen Quellen des Witzes aufmerksam.“"
                            },
                            {
                                "example_id": "794c8672-71fa-4332-82f0-43f73f3afdc9",
                                "sense_id": "459abf45-9acf-3234-9ac9-e33f70dad5bf",
                                "text": "„Dafür ist uns ein über 150 Jahre altes Beispiel überliefert, das Professor Herbert Schöffler (1946 in Göttingen gestorben), ein eifriger, ja leidenschaftlicher Witzeforscher, einmal aufgezeichnet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
