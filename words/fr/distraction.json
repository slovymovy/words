                },
                {
                    "sense_id": "28a3f6f3-13b0-3f2d-9016-38c629d1b7a5",
                    "sense_definition": "Action de séparer, d'isoler ou de prélever une partie d'un ensemble.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "séparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a formellement demandé la <w>distraction</w> de ces biens avant le partage.",
                            "target_lang_translations": {
                                "en": "The lawyer formally requested the <w>separation</w> of these assets before the division of the estate.",
                                "ru": "Адвокат официально потребовал <w>выделения</w> этого имущества до раздела.",
                                "de": "Der Anwalt hat formell die <w>Abtrennung</w> dieser Vermögenswerte vor der Teilung beantragt.",
                                "es": "El abogado pidió formalmente la <w>separación</w> de estos bienes antes de la partición.",
                                "zh": "律师在分配遗产前正式申请这些财产的<w>分割</w>。"
                            }
                        },
                        {
                            "text": "Le décret ordonne la <w>distraction</w> d'une commune pour créer une nouvelle collectivité.",
                            "target_lang_translations": {
                                "en": "The decree orders the <w>detachment</w> of a commune to create a new local authority.",
                                "ru": "Указ предписывает <w>отчленение</w> коммуны для создания нового муниципального образования.",
                                "de": "Das Dekret ordnet die <w>Abtrennung</w> einer Gemeinde an, um eine neue Gebietskörperschaft zu schaffen.",
                                "es": "El decreto ordena la <w>desmembración</w> de un municipio para crear una nueva entidad local.",
                                "zh": "这项法令规定了一个市镇的<w>剥离</w>，以设立新的地方行政单位。"
                            }
                        }
                    ],
