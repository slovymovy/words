                                    {
                                        "sense_id": "7bb5bf83-aa55-34ee-9212-425ac7f8d413",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A rent or stipend payable at some regular time, generally annual, e.g., canon frumentarius"
                                        ],
                                        "tags": [
                                            "Roman",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
