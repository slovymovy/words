                        ],
                        "examples": [
                            {
                                "example_id": "26870bc8-e7b4-4321-94f6-b599d0352764",
                                "sense_id": "3a628615-6eb5-325e-8e1b-a27973cb71ec",
                                "text": "L’esclave mondain sortit une petite bonbonne du frigogidaire et proposa à Clélia d’y goûter."
                            },
                            {
                                "example_id": "1ea7133a-d62c-456a-8485-3f52c66a4dbf",
                                "sense_id": "3a628615-6eb5-325e-8e1b-a27973cb71ec",
                                "text": "C’est un excellent produit, pas de point négatif en un an de fonctionnement. La journée on ne l’entend pas, et la nuit, la cave fait le bruit d'un frigogidaire."
                            },
                            {
                                "example_id": "316b9396-c57d-46d9-8c87-398957f415d9",
                                "sense_id": "3a628615-6eb5-325e-8e1b-a27973cb71ec",
                                "text": "Poster 50 x 70 cm. Il trouvera sa place dans toutes les pièces à vivre, au dessus de votre cheminée, de votre lit ou à côté de votre frigogidaire. Signé par l'équipe et en édition limitée numérotée."
                            },
                            {
                                "example_id": "d0f94283-7934-4d66-bb4c-8f43aa958c58",
                                "sense_id": "3a628615-6eb5-325e-8e1b-a27973cb71ec",
                                "text": "Tu peux éventuellement avoir un frigogidaire dans un non-meublé, surtout dans les appartements destinés aux étudiants. Demande ce qu'il y a exactement dans l'appart."
                            }
                        ]
                    }
