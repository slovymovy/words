                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "bf07b6e1-4ddc-3a50-9eb5-c0818037a731",
                                        "entry_id": "6437db2b-344d-3b78-8676-37bc306fa5d9",
                                        "glosses": [
                                            "dospělý člověk samičího pohlaví"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56c9bb9-6c6b-4d37-b532-d46e83242ad3",
                                                "sense_id": "bf07b6e1-4ddc-3a50-9eb5-c0818037a731",
                                                "text": "Ženy si večer vyprávěly, co zajímavého od rána zažily."
                                            },
                                            {
                                                "example_id": "ae75652d-9967-4a5d-8d6c-674143980be8",
                                                "sense_id": "bf07b6e1-4ddc-3a50-9eb5-c0818037a731",
                                                "text": "To promluvila v ní naše chodská žena. Obětavá a statečná. Žena, jaké nezná jiná země a jiný kraj. Žena, která koná mužskou práci – oře, seče, žne, dříví seká, s potahem jezdí jako muž, ale která dovede paličkovat krajky jemné jako pavučina, upřít na vřetenu nit tenkou jako hedvábí a rovnou jako struna – žena, která nikdy si nezoufá, která dovede, je-li třeba, uživit sebe, děti i muže – ničemu a opilce..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eeb7bc1-2556-3e4d-a3b9-1967c5491e00",
                                        "entry_id": "6437db2b-344d-3b78-8676-37bc306fa5d9",
                                        "glosses": [
                                            "žena (1) vdaná za daného muže"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312df328-a26d-4754-a809-ec66e13e9963",
                                                "sense_id": "7eeb7bc1-2556-3e4d-a3b9-1967c5491e00",
                                                "text": "Tehdy jsem poprvé uviděl svou budoucí ženu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "žena",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "9c0a10d1-60c5-3010-be7e-3baab1e6d680",
                                        "entry_id": "76532575-15ba-3e6f-80d3-a451e8d0c441",
                                        "glosses": [
                                            "přechodník přítomný jednotného čísla mužského rodu od slovesa hnát"
                                        ],
                                        "tags": [
                                            "form-of"
