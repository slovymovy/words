                "senses": [
                    {
                        "sense_id": "1836e554-07be-3ae3-99a5-3a4d9344ba63",
                        "entry_id": "74e70c2b-c6cf-3c0b-bc98-21ba3d3e4217",
                        "glosses": [
                            "неодобр. тот, кто имеет обыкновение много брюзжать, сердито выражать своё недовольство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f616056-92ee-4a78-8d51-e49c707bab25",
                                "sense_id": "1836e554-07be-3ae3-99a5-3a4d9344ba63",
                                "text": "Наверное, в результате таких вот случайностей и избавляются люди от идеалов — превращаются в брюзг и циников."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8133ffc7-500e-4e4a-9956-22f5f5b12b06",
                        "source_entry_id": "74e70c2b-c6cf-3c0b-bc98-21ba3d3e4217",
                        "source_sense_id": "1836e554-07be-3ae3-99a5-3a4d9344ba63",
                        "target_lang_word": "grumbler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grumbler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ca4d9c-938b-3138-a4ee-e58622139913",
                                        "entry_id": "d23d1fbe-0b83-31fc-a9e1-6a658f9646ba",
                                        "glosses": [
                                            "A person who persistently grumbles; a complainer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58eb3e31-59b2-4266-853b-4337f96680a0",
                                                "sense_id": "e8ca4d9c-938b-3138-a4ee-e58622139913",
                                                "text": "But the grumbler must be heard through the newspapers, and a great deal of unpleasantness comes to newspapers from the grumbler; and the newspapers, and not the grumbler, nearly always have to take the brunt of the trouble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
