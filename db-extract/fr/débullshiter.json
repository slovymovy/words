                "senses": [
                    {
                        "sense_id": "4dc99f4f-3ac3-355d-a819-b1855c97f7e0",
                        "entry_id": "f6147566-9e1b-3ce0-a7b5-2cd1dc7d0c3e",
                        "glosses": [
                            "Enlever son caractère de bullshit à."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "03bbdb0a-26c1-429e-87d6-da1d311fb8d0",
                                "sense_id": "4dc99f4f-3ac3-355d-a819-b1855c97f7e0",
                                "text": "Comment débullshiter? On pourrait, bien sûr, dire que ce qui est du bullshit pour les uns n'est pas du bullshit pour d'autres."
                            },
                            {
                                "example_id": "f3110f82-834f-4f4f-a597-8ea898b2efc1",
                                "sense_id": "4dc99f4f-3ac3-355d-a819-b1855c97f7e0",
                                "text": "Après 2 ans d'enquête sur l'informatique quantique, plusieurs conférences données, de nombreuses rencontres avec les chercheurs, spécialistes et même politiques, ils souhaitent \"débullshiter\" et vulgariser le sujet."
                            },
                            {
                                "example_id": "f3fdb083-23f8-4f97-b716-0c8b90e545f3",
                                "sense_id": "4dc99f4f-3ac3-355d-a819-b1855c97f7e0",
                                "text": "Dans cet épisode de 1h30 elle nous donne les clés pour se \"débullshiter\" et enfin être la personne que nous voulons être (entrepreneurs ou pas)"
                            }
                        ]
                    }
