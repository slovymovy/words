{
    "word_family": [
        "целить",
        "целевой",
        "целенаправленный",
        "целеустремленный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1aafc13c-94d3-3a2d-b8d6-a7afbb8996f7",
                    "sense_definition": "то, к чему стремятся, что намечено достигнуть, намерение или задача",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он поставил перед собой важную <w>цель</w> и упорно работал для её достижения.",
                            "target_lang_translations": {
                                "en": "He set an important <w>goal</w> for himself and worked hard to achieve it."
                            }
                        },
                        {
                            "text": "У каждого человека в жизни должна быть какая-то высокая <w>цель</w>.",
                            "target_lang_translations": {
                                "en": "Every person should have some high <w>aim</w> in life."
                            }
                        }
                    ],
                    "synonyms": [
                        "намерение",
                        "задача"
                    ],
                    "common_phrases": [
                        "достичь цели",
                        "поставить цель"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that one strives for, a planned achievement, intention, or task."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "goal",
                                "target_lang_sense_clarification": "A result or objective that one is attempting to achieve."
                            },
                            {
                                "target_lang_word": "aim",
                                "target_lang_sense_clarification": "A specific intention or purpose in life or an activity."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2a4832f-22e1-378f-b878-abe47975c9de",
                    "sense_definition": "предмет или место, в которое стреляют или должны попасть",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Стрелок сделал точный выстрел и попал прямо в <w>цель</w>.",
                            "target_lang_translations": {
                                "en": "The shooter made an accurate shot and hit the <w>target</w> directly."
                            }
                        },
                        {
                            "text": "Военные учения включали стрельбу по движущимся наземным <w>целям</w>.",
                            "target_lang_translations": {
                                "en": "Military exercises included shooting at moving ground <w>targets</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "мишень"
                    ],
                    "common_phrases": [
                        "попасть в цель",
                        "бить мимо цели"
                    ],
                    "target_lang_definitions": {
                        "en": "An object or location that is intended to be hit by a projectile."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "target",
                                "target_lang_sense_clarification": "A mark or object to shoot at for practice or testing accuracy."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8154c348-189b-3f39-b481-df21ca9bf597",
                    "sense_definition": "объект, детектируемый радаром или иными средствами обнаружения",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Радар зафиксировал неопознанные воздушные <w>цели</w> на границе страны.",
                            "target_lang_translations": {
                                "en": "The radar detected unidentified aerial <w>targets</w> at the country's border."
                            }
                        },
                        {
                            "text": "Оператор системы слежения должен быстро классифицировать все обнаруженные <w>цели</w>.",
                            "target_lang_translations": {
                                "en": "The tracking system operator must quickly classify all detected <w>targets</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "объект"
                    ],
                    "target_lang_definitions": {
                        "en": "An object detected by radar or other surveillance systems."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "target",
                                "target_lang_sense_clarification": "An object or entity tracked by detection systems."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e79ff39c-d7df-3d0d-af97-2fd16e4cf7fc",
                    "sense_definition": "небольшой выступ на передней части ствола огнестрельного оружия для прицеливания",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "target",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При прицеливании важно совместить <w>цель</w> с прорезью прицела.",
                            "target_lang_translations": {
                                "en": "When aiming, it is important to align the <w>front sight</w> with the rear sight notch."
                            }
                        },
                        {
                            "text": "Старая винтовка имела поврежденную <w>цель</w>, что мешало точной стрельбе.",
                            "target_lang_translations": {
                                "en": "The old rifle had a damaged <w>front sight</w>, which hindered accurate shooting."
                            }
                        }
                    ],
                    "synonyms": [
                        "мушка"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее название мушки"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small projection on the front of a firearm barrel used for aiming."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "front sight",
                                "target_lang_sense_clarification": "The specific part of a firearm's sighting system."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f67a672b-0da7-38e0-9681-e393a1036125",
                    "sense_definition": "нетронутая земля, целина",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тракторы вышли в поле, чтобы поднять вековую <w>цель</w>.",
                            "target_lang_translations": {
                                "en": "Tractors went out into the field to plow up the age-old <w>virgin soil</w>."
                            }
                        },
                        {
                            "text": "Освоение новых земель началось с распашки <w>цели</w> в степных районах.",
                            "target_lang_translations": {
                                "en": "The development of new lands began with the plowing of <w>virgin soil</w> in the steppe regions."
                            }
                        }
                    ],
                    "synonyms": [
                        "целина",
                        "целик"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "региональное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Virgin soil or uncultivated land."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "virgin soil",
                                "target_lang_sense_clarification": "Land that has never been plowed or cultivated."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "082cae50-5ad5-354b-95de-0cf1878e9189",
                    "sense_definition": "повелительное наклонение глагола <w>целить</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Внимательно <w>цель</w> перед тем, как нажать на спусковой крючок.",
                            "target_lang_translations": {
                                "en": "Carefully <w>aim</w> before pulling the trigger."
                            }
                        },
                        {
                            "text": "Не <w>цель</w> в людей, даже если оружие не заряжено.",
                            "target_lang_translations": {
                                "en": "Do not <w>aim</w> at people, even if the weapon is not loaded."
                            }
