                "translations": [
                    {
                        "translation_id": "ce04cf62-92f4-4cf9-a1aa-e273e0e5fb14",
                        "source_entry_id": "13ae3ef4-7ea1-3f8e-90cc-1406cea605bd",
                        "source_sense_id": "409efb0f-8971-398e-bda2-f9e98f2cc657",
                        "source_sense_description": "verschärfen, verstärken",
                        "target_lang_word": "verstärken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstärken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41e8475e-f5e0-364c-aa59-0816e2b03c96",
                                        "entry_id": "0a20e6b3-e5fd-3799-bec0-8e81706edf0c",
                                        "glosses": [
                                            "stärker, belastbarer machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a3cab6-5dd3-43c3-a1ac-9223ffc2ce94",
                                                "sense_id": "41e8475e-f5e0-364c-aa59-0816e2b03c96",
                                                "text": "Diese stark beanspruchte Stelle sollten wir mit einem Stück Leder verstärken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca1e4e4f-322e-3c54-b7ac-dce26cae0fb5",
                                        "entry_id": "0a20e6b3-e5fd-3799-bec0-8e81706edf0c",
                                        "glosses": [
                                            "intensiver werden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c1ad5c-71b8-4fed-a003-b3a253137b1c",
                                                "sense_id": "ca1e4e4f-322e-3c54-b7ac-dce26cae0fb5",
                                                "text": "Der Effekt verstärkt sich mit jeder Anwendung."
                                            },
                                            {
                                                "example_id": "807ce263-5e22-4d2c-bc22-386e1bdceb9a",
                                                "sense_id": "ca1e4e4f-322e-3c54-b7ac-dce26cae0fb5",
                                                "text": "In den letzten Tagen haben sich die Schmerzen im Bein verstärkt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be069388-796a-34fd-a1b4-8756f845fabb",
                                        "entry_id": "0a20e6b3-e5fd-3799-bec0-8e81706edf0c",
                                        "glosses": [
                                            "zahlenmäßig vergrößern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d78858c-51bd-4356-9d75-12d815530f7b",
                                                "sense_id": "be069388-796a-34fd-a1b4-8756f845fabb",
                                                "text": "Der Bundestag hat beschlossen die Truppen in Afghanistan zu verstärken."
                                            },
                                            {
                                                "example_id": "6a5c6b40-aac4-4cfd-9ebd-864411e28af1",
                                                "sense_id": "be069388-796a-34fd-a1b4-8756f845fabb",
                                                "text": "Nach der Ankündigung des US-Präsidenten Barack Obama, die US-Truppenpräsenz in Afghanistan um 17.000 Soldaten zu verstärken, wurde heute bekannt, dass auch die Bundeswehr ihre Militärpräsenz in dem Land am Hindukusch ausbauen will."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba13f6eb-9e08-4821-975e-da77ffdabd69",
                        "source_entry_id": "13ae3ef4-7ea1-3f8e-90cc-1406cea605bd",
                        "source_sense_id": "409efb0f-8971-398e-bda2-f9e98f2cc657",
                        "source_sense_description": "verschärfen, verstärken",
                        "target_lang_word": "verschärfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschärfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                        "entry_id": "707ee87d-50c4-373b-9a66-fd977788a554",
                                        "glosses": [
                                            "etwas strenger machen, etwas rigoroser machen; auch: etwas erhöhen, etwas steigern; auch: etwas verschlechtern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5daa977e-d8b2-4d00-8636-d4b79583a7ec",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "Radrennen: Am Berg verschärfte die Spitzengruppe das Tempo, sie wollten sich nicht vom Peloton einholen lassen."
                                            },
                                            {
                                                "example_id": "78a14016-6aba-4a55-a13e-a00f294c49d2",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "Wirtschaft: Die Automatisierung verschärft die Arbeitslosigkeit."
                                            },
                                            {
                                                "example_id": "e722fd37-87e3-4e0d-ad29-087e4e8a8b71",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "Sport: »Nur wenn Du Dein Training verschärfst, wirst Du noch mithalten können.«"
                                            },
                                            {
                                                "example_id": "a48974d8-56f2-46f1-92b9-a9f67030797a",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "Die Polizei verschärft die Kontrollen an deutschen Grenzen, was ein Bruch des Schengen-Abkommens ist."
                                            },
                                            {
                                                "example_id": "124f867a-37a3-40fc-ad1a-4e3a94c653b2",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "„Das Parlament in Wien verschärfte das Asylgesetz drastisch […].“"
                                            },
                                            {
                                                "example_id": "ebbbcf33-1067-43ba-9446-49c3d66bddde",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "[…] „Colorado [hat] nach dem Kino-Massaker von Aurora die Waffengesetze verschärft, ebenso Connecticut nach dem Grundschulmassaker von Newtown.“"
                                            },
                                            {
                                                "example_id": "3a80a8b4-1c53-4eff-a96e-bb580a4d63a0",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "„Die Sicherheitsmaßnahmen für die Zugänge zum Tempelberg in der Altstadt Jerusalems wurden verschärft. Am Wochenende war es zu Auseinandersetzungen zwischen Palästinensern und Beamten gekommen.“"
                                            },
                                            {
                                                "example_id": "21d2ee07-f269-4097-be95-3529702c23df",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "„Es gebe in der EU zu viele Tote durch Schusswaffen, sagt EU-Innenkommissarin Cecilia Malmström. Aus diesem Grund soll das Waffenrecht verschärft werden.“"
                                            },
                                            {
                                                "example_id": "2cd62e57-872c-4185-92b3-756ef501185b",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "„Am 13. August 1942 verschärften die Schweizer Behörden die Einreisebestimmungen für Juden.“"
                                            },
                                            {
                                                "example_id": "5fc809ec-c770-457c-ad35-e95d0bd532fa",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "„Die Haft wird verschärft und Bonhoeffer wird im Februar 1945 ins Konzentrationslager Buchenwald gebracht.“"
                                            },
                                            {
                                                "example_id": "b1d0488e-5686-4f9a-99ed-4bc66c297c61",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "„Infektionskontrollen in Spitälern und Kliniken wurden verschärft.“"
                                            },
                                            {
                                                "example_id": "7118bfaf-c8d7-4c1a-ac7d-e33c0d0d576f",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "Der anhaltende Regen verschärft die Lage in den Hochwassergebieten."
                                            },
                                            {
                                                "example_id": "b9fa241b-ec1e-4c69-9b21-f2bf0c379b0f",
                                                "sense_id": "0268aa7d-a7bf-3def-81f0-6eafe6c0e8ca",
                                                "text": "[Schlagzeile:] „Kampf ums Wohnen: Wie verschärfen Airbnb und Co. den Wohnungsmangel in Thüringer Städten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bfcb3a9f-2f1c-3ecc-ae20-e6a251e84d4b",
                                        "entry_id": "707ee87d-50c4-373b-9a66-fd977788a554",
                                        "glosses": [
                                            "in eine kritischere, bedrohlichere Lage geraten"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6f9d62-6868-4c6e-a7e7-718de33521dd",
                                                "sense_id": "bfcb3a9f-2f1c-3ecc-ae20-e6a251e84d4b",
                                                "text": "Wegen des Klimawandels und der Staudämme in der Türkei wird sich die Wasserknappheit im Irak künftig verschärfen."
                                            },
                                            {
                                                "example_id": "252f6a67-cf37-4025-a515-0c61d09d9f29",
                                                "sense_id": "bfcb3a9f-2f1c-3ecc-ae20-e6a251e84d4b",
                                                "text": "Die Corona-Pandemie verschärft sich weiterhin weltweit, vor allem in Europa."
                                            },
                                            {
                                                "example_id": "b7cd020a-341d-4ae2-a55b-ba9b11f7c6d8",
                                                "sense_id": "bfcb3a9f-2f1c-3ecc-ae20-e6a251e84d4b",
                                                "text": "„Mit der Belagerung verschärfte sich in Augsburg die bereits bestehende Nahrungsmittelknappheit drastisch weiter.“"
                                            },
                                            {
                                                "example_id": "3133f8c6-8097-4958-bc6d-abd2789cc579",
                                                "sense_id": "bfcb3a9f-2f1c-3ecc-ae20-e6a251e84d4b",
                                                "text": "„Mit dem trockenen und heißen Sommer verschärft sich die Wasserknappheit in Brandenburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
