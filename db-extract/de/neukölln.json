                "senses": [
                    {
                        "sense_id": "03ef23e8-0b95-3744-a6d7-e21159eae451",
                        "entry_id": "2a4f4881-e28c-3f28-9a1b-32f8871404e5",
                        "glosses": [
                            "der achte Verwaltungsbezirk von Berlin (Deutschland)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb298a7b-d55f-4d08-b0c6-507e32e97ff3",
                                "sense_id": "03ef23e8-0b95-3744-a6d7-e21159eae451",
                                "text": "In Neukölln ist ein Großteil der historischen Bauten erhalten, und so präsentiert der Bezirk eine reiche Altbaulandschaft."
                            },
                            {
                                "example_id": "1eec7795-aa18-43ea-8944-ceb23eab8ddd",
                                "sense_id": "03ef23e8-0b95-3744-a6d7-e21159eae451",
                                "text": "Ein großer Teil der Bevölkerung Neuköllns hat einen Migrationshintergrund."
                            },
                            {
                                "example_id": "055a7581-a265-4d2f-8c4c-da2b5abcfab4",
                                "sense_id": "03ef23e8-0b95-3744-a6d7-e21159eae451",
                                "text": "„In Teilen von Neukölln, Spandau und Lichtenberg trieben rivalisierende Banden und Bürgerwehren ihr Unwesen, weil der Staat weder die Versorgung der Bevölkerung gewährleisten noch deren Sicherheit garantieren konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6817925-0bba-3fd5-996e-e25e8687febf",
                        "entry_id": "2a4f4881-e28c-3f28-9a1b-32f8871404e5",
                        "glosses": [
                            "Berlin-Neukölln, der namensgebende Ortsteil des Bezirkes Neukölln ^([1]) in Berlin"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "02e015b8-c4fa-468f-ae5d-c2366f37255e",
                                "sense_id": "c6817925-0bba-3fd5-996e-e25e8687febf",
                                "text": "Bis 1920 war der Ortsteil Neukölln eine eigenständige Stadt, und bis 1912 hieß die Stadt \"Rixdorf\"."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
