                        "sense_id": "344fd176-34b6-3467-8d2b-8e050c0c96f1",
                        "entry_id": "bffa5082-38e4-3ce6-bf1b-926d574d7d59",
                        "glosses": [
                            "Poisson d’eau douce de la famille des salmonidés et du genre Salvelinus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a394da-5027-4870-95b5-93047e8ec61b",
                                "sense_id": "344fd176-34b6-3467-8d2b-8e050c0c96f1",
                                "text": "Elle se prépara de l’'omble à la poêle, mit La Ruée vers l’or dans le lecteur de DVD et s’assit avec son dîner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b12115-5387-4bdd-91b6-9a5f46b6aee6",
                        "source_entry_id": "bffa5082-38e4-3ce6-bf1b-926d574d7d59",
                        "source_sense_id": "344fd176-34b6-3467-8d2b-8e050c0c96f1",
                        "target_lang_word": "Saibling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saibling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "472f889c-2929-34d0-87ae-4c28bffadeed",
                                        "entry_id": "35dcda21-1cc3-3774-8db9-de514d542d31",
                                        "glosses": [
                                            "ein stromlinienförmiger, zur Familie der Forellenfische gehöriger Süßwasserfisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887a33f2-2abc-4fcf-8994-20f79ed67a30",
                                                "sense_id": "472f889c-2929-34d0-87ae-4c28bffadeed",
                                                "text": "Das Futter für Saiblinge, Bachforellen und Huchen ist biologisch zertifiziert und enthält wenig Fett."
                                            },
                                            {
                                                "example_id": "023aec11-c416-4bea-b0ef-11237eb932f2",
                                                "sense_id": "472f889c-2929-34d0-87ae-4c28bffadeed",
                                                "text": "Forelle wie Saibling werden auf dieselbe Art gegart, wobei ich das Garen in der Alufolie bevorzuge."
                                            },
                                            {
                                                "example_id": "b7a19499-2330-49de-abdd-6a4ef968dd7c",
                                                "sense_id": "472f889c-2929-34d0-87ae-4c28bffadeed",
                                                "text": "Unlängst wies in einer Fernsehrunde der Manager eines Nahrungsmittelkonzerns stolz darauf hin, daß es Biochemikern gelungen sei, die fast ausgestorbenen Saiblinge in den Schweizer und französischen Bergseen vor dem endgültigen Verschwinden zu bewahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52ed3196-bd32-3063-8a65-f5afc8d3766d",
                                        "entry_id": "35dcda21-1cc3-3774-8db9-de514d542d31",
                                        "glosses": [
                                            "der unter [1] genannte Fisch als Speise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51508817-9d80-46e2-9f4b-ec77b48fa9d1",
                                                "sense_id": "52ed3196-bd32-3063-8a65-f5afc8d3766d",
                                                "text": "Es ist auf Fische spezialisiert, die hier in herrlicher Frische angeboten werden, nicht nur lokale Sorten wie der omnipräsente Saibling."
                                            },
                                            {
                                                "example_id": "ff26ff96-ae7f-4b34-aa81-8bb058ff2bd1",
                                                "sense_id": "52ed3196-bd32-3063-8a65-f5afc8d3766d",
                                                "text": "Beim schön knusprigen und sehr frischen Saibling passierte ein böser Patzer: Der Fisch ertrank in einer dicken Estragon-Sauce."
                                            },
                                            {
                                                "example_id": "3076d11c-5230-446c-9b48-0f3fd1a01d12",
                                                "sense_id": "52ed3196-bd32-3063-8a65-f5afc8d3766d",
                                                "text": "Als Vorspeisen gibt es ein winziges Steak vom Rind auf Salat und ein knuspriges Filet vom Saibling auf Nudeln mit leicht erhitzten Gurken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "847f57bf-bdc2-46a5-91a7-83c4c447a0b6",
                        "source_entry_id": "bffa5082-38e4-3ce6-bf1b-926d574d7d59",
                        "source_sense_id": "344fd176-34b6-3467-8d2b-8e050c0c96f1",
                        "target_lang_word": "char",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "char",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e7f499-d26f-37ef-ba1a-fb964159953b",
                                        "entry_id": "38e887e8-8c3d-3e3f-b55c-2beab8587351",
                                        "glosses": [
                                            "Alternative form of cha (“tea”)."
                                        ],
                                        "tags": [
                                            "British",
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "char",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d442496-3c8e-32e4-90db-52a35d587c7c",
                                        "entry_id": "c99c8286-8cea-3846-8c44-50bec3dde239",
                                        "glosses": [
                                            "A character (text element such as a letter or symbol)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bdbefb0-4a30-4b70-9ee4-6fbaf3a71de4",
                                                "sense_id": "6d442496-3c8e-32e4-90db-52a35d587c7c",
                                                "text": "The unit is an 80-column, 30 char. /sec dot matrix printer which uses a 5 by 7 font."
                                            },
                                            {
                                                "example_id": "fe44eee7-0ca2-49bb-8e0a-0b4021f96057",
                                                "sense_id": "6d442496-3c8e-32e4-90db-52a35d587c7c",
                                                "text": "Chars can be considered as integers if need be without an explicit cast."
                                            },
                                            {
                                                "example_id": "0561ce98-1619-401b-92f1-966d6e56c5d8",
                                                "sense_id": "6d442496-3c8e-32e4-90db-52a35d587c7c",
                                                "text": "Then since each char occupies one byte, these four bytes represent the three letters 'B', 'y', 'e', and the null character NUL."
                                            },
                                            {
                                                "example_id": "3afd625b-33df-41ac-b280-5dfbd8ad2fce",
                                                "sense_id": "6d442496-3c8e-32e4-90db-52a35d587c7c",
                                                "text": "When a 32-bit int value is stored to a 16-bit char variable, information can be lost if the 16 most significant bits are not zeroes in the int value."
                                            },
                                            {
                                                "example_id": "4e74b576-2ae2-4374-9839-cd1e3892080d",
                                                "sense_id": "6d442496-3c8e-32e4-90db-52a35d587c7c",
                                                "text": "Thus string variables are pointer variables to chars."
                                            },
                                            {
                                                "example_id": "de9045a2-b3be-4787-a903-bdea849ee1b2",
                                                "sense_id": "6d442496-3c8e-32e4-90db-52a35d587c7c",
                                                "text": ".NET uses the Unicode character set in which each char constant or variable takes up two bytes (16 bits) of storage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "073e55ac-5b1d-3b24-af19-ecbc2dc6fbc2",
                                        "entry_id": "c99c8286-8cea-3846-8c44-50bec3dde239",
                                        "glosses": [
                                            "A character (being involved in the action of a story)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85d8efe9-b934-4e30-8782-ba62a6f8b4db",
                                                "sense_id": "073e55ac-5b1d-3b24-af19-ecbc2dc6fbc2",
                                                "text": "In fact, when I somewhat lack inspiration, I tend to convert my characters according to the rules of a game which universe is close enough (I did it for some of the chars in my WIP, taking the Cyberpunk 2020 rulebook)."
                                            },
                                            {
                                                "example_id": "d14f4323-dce1-4f0a-9de3-804e8f8d4b70",
                                                "sense_id": "073e55ac-5b1d-3b24-af19-ecbc2dc6fbc2",
                                                "text": "WoW exp I feel that it is just a progress from Lv70 to 80 and then back to square one to raid\\arena or die expansion. So I don’t see the point of going back just to level my char to 80 and let them idle at end-game."
                                            },
                                            {
                                                "example_id": "7e21b3a5-d040-4df9-9f4e-32f6534ae5fd",
                                                "sense_id": "073e55ac-5b1d-3b24-af19-ecbc2dc6fbc2",
                                                "text": "The class (an adventuring style (e.g. mage, warrior, hunter, etc.) of the character, which determines abilities, weapons, etc.) choice often also influences the gaming and language of a character during role-playing. As one of the participants states: / Character bound politeness is part of some of my chars – as well as impoliteness is. An example: A Paladin or Priest has to be polite in RPG according to his profession to the light, a Warlock is the opposite as well as rogues etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "char",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f12e7d98-6997-39e8-b330-0adce2facf9b",
                                        "entry_id": "16c1a6c8-e30c-302f-a39a-36bfec943360",
                                        "glosses": [
