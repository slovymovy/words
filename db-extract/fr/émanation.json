        "fr-extract.jsonl": [
            {
                "entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                "word": "émanation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3a81c355-5d3c-42a0-a16b-20137ed9b20e",
                        "entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                        "tags": [
                            "plural"
                        ],
                        "form": "émanations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b6958ab-e897-36f5-b611-37f1e1a9ca43",
                        "entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                        "glosses": [
                            "Dégagement spontané des corps volatils contenus dans certaines substances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0998b87-9657-4275-a423-b6ef5122cd10",
                                "sense_id": "0b6958ab-e897-36f5-b611-37f1e1a9ca43",
                                "text": "L’émanation lumineuse est, suivant la théorie de Newton, l’émission en ligne droite de particules impondérables lancées par un corps lumineux."
                            },
                            {
                                "example_id": "c0957d38-ea51-405a-a7a1-06504536940b",
                                "sense_id": "0b6958ab-e897-36f5-b611-37f1e1a9ca43",
                                "text": "L’émanation électronique est l’émission d’atomes négatifs provenant d’un corps radioactif."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd4a4c97-5352-36fc-90c9-d419321d96cf",
                        "entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                        "glosses": [
                            "Résultat de ce dégagement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa879238-91fe-44e3-a40b-a0f88c739a95",
                                "sense_id": "cd4a4c97-5352-36fc-90c9-d419321d96cf",
                                "text": "La promesse valait pour l'ensemble des chasseurs, dont la transpiration mêlée aux émanations alcoolisées d’après-rasage emboucanait l'atmosphère d'un suint pimenté."
                            }
                        ]
                    },
                    {
                        "sense_id": "84841697-a7b5-3983-92ca-2004460dc454",
                        "entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                        "glosses": [
                            "Conséquence de quelque chose ; chose qui procède d’une autre."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "71b50d9a-37cc-46a6-8f95-e9c5157d9282",
                                "sense_id": "84841697-a7b5-3983-92ca-2004460dc454",
                                "text": "Malgré la répression intense, la plupart des manifestants décrivent la révolution en cours comme une libération irréversible. Les dreadlocks, les coupes afros, les cheveux détachés ou courts pour les femmes en sont des émanations parmi d’autres."
                            },
                            {
                                "example_id": "700d3a7f-cbb9-4ee1-a75e-c14ea9fe1b37",
                                "sense_id": "84841697-a7b5-3983-92ca-2004460dc454",
                                "text": "L’émanation du Verbe."
                            },
                            {
                                "example_id": "151e74cb-6877-4a0b-99c0-8f38e79fd67d",
                                "sense_id": "84841697-a7b5-3983-92ca-2004460dc454",
                                "text": "Son influence est une émanation du pouvoir suprême."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f874bf0-d323-3d19-bacc-61634101bf52",
                        "entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                        "glosses": [
                            "Ancien nom du radon."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfa896a8-c3b4-46ee-9a52-3171206b89b5",
                        "source_entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                        "target_lang_word": "Emanation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emanation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "597f9c4f-f4b6-361b-8f90-d78aec6d51a3",
                                        "entry_id": "9ace8d43-6608-3920-a99d-ec05623ab7c7",
                                        "glosses": [
                                            "Entstehung aus einem höher entwickelten, göttlichen Einen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47f882d-7830-40d8-b727-333180d5f3ee",
                                                "sense_id": "597f9c4f-f4b6-361b-8f90-d78aec6d51a3",
                                                "text": "„Mit Hilfe von verschiedenen Schrifttypen und -größen, Zahlen, Pfeilen, Klammern und Strichen bietet sie immerhin noch etwa zwanzig grafische Möglichkeiten an, die Varianten, Zeilenumbrüche und Verszählungen desselben Textes sowie die editorischen Bemerkungen und Eingriffe darzustellen und damit die Emendation überprüfbar zu machen, was im dringlichen Duktus Sattlers immer ein bisschen wie Emanation klingt, dem Ausfluss aller Dinge aus dem göttlichen Einen.“"
                                            },
                                            {
                                                "example_id": "07395c0e-8bc3-481f-92f5-e89559822124",
                                                "sense_id": "597f9c4f-f4b6-361b-8f90-d78aec6d51a3",
                                                "text": "„Der Engel ist die mehr oder weniger materialisierte Emanation einer göttlichen Wesenheit und umschließt die doppelte, unheilvolle und wohltätige Natur, wie sie allen mythischen Gestalten eigentümlich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3003e6d-9635-38a3-b2b6-817502f7f5ab",
                                        "entry_id": "9ace8d43-6608-3920-a99d-ec05623ab7c7",
                                        "glosses": [
                                            "bestimmte Wirkung eines Körpers nach außen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18f5a9d-8ca3-4bbc-9dbb-e310d45e5d42",
                                                "sense_id": "e3003e6d-9635-38a3-b2b6-817502f7f5ab",
                                                "text": "„Eine andere Theorie, von Roland Barthes, besagte, daß die „Realisten“, zu denen er sich selber zählte, „eine Photographie keineswegs als eine ‚Kopie‘ des Wirklichen betrachten – sondern als eine Emanation des vergangenen Wirklichen: als Magie und nicht als Kunst“.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8da357e7-3695-3f60-9e58-3911034ac962",
                                        "entry_id": "9ace8d43-6608-3920-a99d-ec05623ab7c7",
                                        "glosses": [
                                            "Freisetzung von nicht fester Substanz"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58592f07-e845-4fbf-8bec-1607e42eeffb",
                                                "sense_id": "8da357e7-3695-3f60-9e58-3911034ac962",
                                                "text": "„Mit Röhrenglocken, wie Kirchtürme groß, wollen sie uns in Schrecken versetzen, mit einem trocknen Geklöppel wie von gebleichtem Riesengebein, mit gleißenden Emanationen unbestimmbaren Ursprungs – überdimensionale Saxophone könnten das sein, tausend automatische Geigen dazu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a877566b-b324-30f9-9da8-68115cce2d2c",
                                        "entry_id": "9ace8d43-6608-3920-a99d-ec05623ab7c7",
                                        "glosses": [
                                            "Bezeichnung für das chemische Element Radon"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a70f06-dc28-4a19-8cda-1d9990730ab7",
                                                "sense_id": "a877566b-b324-30f9-9da8-68115cce2d2c",
                                                "text": "Es ist erforderlich, das Wasser der Quelle unmittelbar zu entnehmen und sofort zu untersuchen, weil sonst Verluste an Emanation (Radon) eintreten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9421468-2ecd-48c6-a1d5-97d795d86d18",
                        "source_entry_id": "2959a3a2-de65-3a27-a460-9b68ff1cc389",
                        "target_lang_word": "emanation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emanation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e2b560a-9d28-3d8b-923f-bd78e76f0afe",
                                        "entry_id": "d22755bb-286d-3f08-9c63-89fbea836c5b",
                                        "glosses": [
                                            "The act of flowing or proceeding (of something, quality, or feeling) from a source or origin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "701372b5-e2bd-3ca6-83b1-fe4e0ae21f9d",
                                        "entry_id": "d22755bb-286d-3f08-9c63-89fbea836c5b",
                                        "glosses": [
                                            "That which issues, flows, or proceeds from any object as a source; efflux; an effluence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37465d2-eb0d-4347-bd8f-ff0d2c82dd6e",
                                                "sense_id": "701372b5-e2bd-3ca6-83b1-fe4e0ae21f9d",
                                                "text": "Perfume is an emanation from a flower."
                                            },
                                            {
                                                "example_id": "a02980e5-243d-4ce9-8077-738b04ebe042",
                                                "sense_id": "701372b5-e2bd-3ca6-83b1-fe4e0ae21f9d",
                                                "text": "Her love for Francis Evelyn was an emanation of that romance which is in the heart of every girl; her preference was as much circumstance as choice, and strengthened by no comparison."
                                            },
                                            {
                                                "example_id": "715be13a-d7ad-474e-92f3-09d4ee2835b6",
                                                "sense_id": "701372b5-e2bd-3ca6-83b1-fe4e0ae21f9d",
                                                "text": "Hence, not only men, but all animals, and even vegetables, were supposed to be impregnated with some particle of the divine nature which was infused into them, and from which their various qualities and dispositions, as well as their powers of propagation, were thought to be derived. These appeared to be so many emanations of the divine attributes, operating in different modes and degrees, according to the nature of the beings to which they belonged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb34e63e-9b32-3011-9b36-da6df03536c1",
                                        "entry_id": "d22755bb-286d-3f08-9c63-89fbea836c5b",
                                        "glosses": [
                                            "(physics, chemistry) The element radon (Rn)"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "185291d1-be20-3271-9b7d-511d55c645fb",
                                        "entry_id": "d22755bb-286d-3f08-9c63-89fbea836c5b",
                                        "glosses": [
                                            "The generation of the Son and the procession of the Holy Spirit, as distinct from the origination of created beings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
