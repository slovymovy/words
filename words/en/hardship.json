{
    "word_family": [
        "hard",
        "harden",
        "hardly",
        "hardness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ebf1fd0-e122-398f-860b-31a0e1efb05d",
                    "sense_definition": "A state of severe suffering, difficulty, or lack of basic necessities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families in the region are currently facing severe financial <w>hardship</w> due to the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Многие семьи в регионе в настоящее время сталкиваются с серьезными финансовыми <w>трудностями</w> из-за экономического кризиса."
                            }
                        },
                        {
                            "text": "The refugees had to endure great <w>hardship</w> during their long and dangerous journey across the border.",
                            "target_lang_translations": {
                                "ru": "Беженцам пришлось перенести огромные <w>лишения</w> во время долгого и опасного пути через границу."
                            }
                        }
                    ],
                    "synonyms": [
                        "difficulty",
                        "misery",
                        "trouble",
                        "affliction",
                        "woe",
                        "suffering",
                        "adversity"
                    ],
                    "common_phrases": [
                        "financial hardship",
                        "endure hardship",
                        "economic hardship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильных страданий, трудностей или отсутствия предметов первой необходимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишения",
                                "target_lang_sense_clarification": "отсутствие необходимых условий жизни"
                            },
                            {
                                "target_lang_word": "тяготы",
                                "target_lang_sense_clarification": "трудности и испытания"
                            },
                            {
                                "target_lang_word": "невзгоды",
                                "target_lang_sense_clarification": "жизненные трудности и беды"
                            },
                            {
                                "target_lang_word": "нужда",
                                "target_lang_sense_clarification": "крайняя бедность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c0a4aa9-6fa6-30ff-ab0b-4417bd57a20b",
                    "sense_definition": "A specific circumstance or burden that causes difficulty or creates a barrier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new tax regulations proved to be a significant <w>hardship</w> for small business owners in the city.",
                            "target_lang_translations": {
                                "ru": "Новые налоговые правила оказались значительным <w>бременем</w> для владельцев малого бизнеса в городе."
                            }
                        },
                        {
                            "text": "We invite you to make a small donation to the museum if this will not be a <w>hardship</w> for you.",
                            "target_lang_translations": {
                                "ru": "Мы приглашаем вас сделать небольшое пожертвование музею, если это не будет для вас <w>затруднительным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "difficulty",
                        "problem"
                    ],
                    "common_phrases": [
                        "cause hardship",
                        "personal hardship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное обстоятельство или бремя, которое создает трудности или препятствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трудность",
                                "target_lang_sense_clarification": "препятствие или проблема"
                            },
                            {
                                "target_lang_word": "затруднение",
                                "target_lang_sense_clarification": "сложность в делах или финансах"
                            },
                            {
                                "target_lang_word": "бремя",
                                "target_lang_sense_clarification": "тяжелая обязанность или налог"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1816017-f2a1-31ac-8fa3-f8d3d4295bb5",
                    "sense_definition": "To treat someone poorly or subject them to difficult living conditions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic argued that the new educational policy was <w>hardshipping</w> students by removing essential resources.",
                            "target_lang_translations": {
                                "ru": "Критик утверждал, что новая образовательная политика <w>ущемляет</w> студентов, лишая их необходимых ресурсов."
                            }
                        },
                        {
                            "text": "It was claimed that the administration was <w>hardshipping</w> the workers by demanding excessive overtime without extra pay.",
                            "target_lang_translations": {
                                "ru": "Утверждалось, что администрация <w>притесняет</w> рабочих, требуя чрезмерных сверхурочных без дополнительной оплаты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохо обращаться с кем-либо или подвергать кого-либо тяжелым условиям жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притеснять",
                                "target_lang_sense_clarification": "создавать тяжелые условия"
                            },
                            {
                                "target_lang_word": "ущемлять",
                                "target_lang_sense_clarification": "ограничивать в правах или ресурсах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
