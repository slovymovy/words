        "fr-extract.jsonl": [
            {
                "entry_id": "db2949c3-d7ab-3c0a-99e9-9e8408411c6b",
                "word": "coquettement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2362e09c-5aba-37fa-b7da-c6ac9b3956b9",
                        "entry_id": "db2949c3-d7ab-3c0a-99e9-9e8408411c6b",
                        "glosses": [
                            "D’une façon coquette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7419211-4c9a-48ef-9a65-0c1e3eaca365",
                                "sense_id": "2362e09c-5aba-37fa-b7da-c6ac9b3956b9",
                                "text": "Une jeune personne éblouissante, fort coquettement mise et fort leste."
                            },
                            {
                                "example_id": "6ac00b6a-74f3-4971-8415-a6d018118ef3",
                                "sense_id": "2362e09c-5aba-37fa-b7da-c6ac9b3956b9",
                                "text": "Le jeune Desherbiers avait bien supporté la fatigue des marches, il commençait même à se donner des airs en faisant résonner les molettes de ses éperons sur le pavé, en portant son bonnet de police coquettement posé sur l’oreille droite, et les Berlinoises, qui avaient remarqué sa jolie tête blonde, lui eurent bientôt appris à walser."
                            },
                            {
                                "example_id": "26106302-4392-4f81-869f-87a1b46aea71",
                                "sense_id": "2362e09c-5aba-37fa-b7da-c6ac9b3956b9",
                                "text": "Leurs compagnes ouvraient leurs sacs, y prenaient un miroir et s'arrangeaient coquettement les cheveux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e2c9562-8ed8-4fbe-bfd9-2955b2e96c3e",
                        "source_entry_id": "db2949c3-d7ab-3c0a-99e9-9e8408411c6b",
                        "source_sense_id": "2362e09c-5aba-37fa-b7da-c6ac9b3956b9",
                        "target_lang_word": "coquettishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coquettishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f9fa0bd-aac6-37d3-89b7-96e1e373ad84",
                                        "entry_id": "33ce12eb-1151-3f0c-8a49-3d2b646bba97",
                                        "glosses": [
                                            "In a coquettish manner; flirtatiously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce21e25e-88d1-4e0e-9c52-15cb4bd7df77",
                                                "sense_id": "0f9fa0bd-aac6-37d3-89b7-96e1e373ad84",
                                                "text": "She reached the abstract, comic art-style mountain, which the Maker had decided to destroy ten times in the past hour without ever quite being able to bring itself to do so. She dramatically increased in scale, and winked coquettishly. A speech balloon appeared above her head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58d38cac-a160-4d24-b588-ee47e5c91aef",
                        "source_entry_id": "db2949c3-d7ab-3c0a-99e9-9e8408411c6b",
                        "source_sense_id": "2362e09c-5aba-37fa-b7da-c6ac9b3956b9",
                        "target_lang_word": "prettily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prettily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                                        "entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                                        "glosses": [
                                            "In a pretty manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a28e4d5-0e85-4df1-9e20-a886c8738ee5",
                                                "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                                                "text": "And thus they were all begging for pancakes, the one more prettily than the other, because they were so hungry, and such good little children."
                                            },
                                            {
                                                "example_id": "c5fc51ee-2077-4a9d-a9fb-b6ce217ae9e4",
                                                "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                                                "text": "St. Lawrence Station is very prettily situated, high cliffs on the left, and the lush vegetation of the Undercliff sloping down to the sea on the right."
                                            },
                                            {
                                                "example_id": "f270896f-4da8-4433-8a46-f9bdd29b5bd6",
                                                "sense_id": "b5010ce5-beba-3300-8d35-9dc71a78a436",
                                                "text": "The air was clear and scented, the breeze flitted lightly through the tall grass around his cave, the birds were chirruping at each other, the butterflies were flitting about prettily, and the whole of nature seemed to be conspiring to be as pleasant as it possibly could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0100251-9871-37d2-a1c9-6407774446b8",
                                        "entry_id": "b7b9c60e-a192-30ba-bc80-90de43642cd1",
                                        "glosses": [
                                            "Very badly; terribly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b314fbe-d9c7-4482-acdc-d6b804ce7556",
                                                "sense_id": "b0100251-9871-37d2-a1c9-6407774446b8",
                                                "text": "“Indeed!” replied he. “Then, my dear Isabella, it is the most extraordinary sort of thing in the world, for in general every thing does give you cold. Walk home!—you are prettily shod for walking home, I dare say. It will be bad enough for the horses.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65b5b131-3a40-486b-8146-b3a9c7dc5765",
                        "source_entry_id": "db2949c3-d7ab-3c0a-99e9-9e8408411c6b",
                        "source_sense_id": "2362e09c-5aba-37fa-b7da-c6ac9b3956b9",
                        "target_lang_word": "smartly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smartly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc2569dc-06ed-3bbb-9fa1-c2615a89764e",
                                        "entry_id": "f0dfe8f9-0be4-3e51-8cab-fcfbc30ec11d",
                                        "glosses": [
                                            "In a smart manner."
                                        ],
