                        "entry_id": "99ab3464-a2f5-37d8-92b9-16278873fc4e",
                        "glosses": [
                            "bitteres, fettiges Sekret, das von speziellen Drüsen im Ohr zur Reinigung des äußeren Gehörganges abgesondert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba0aafda-6923-4026-a7d0-a30a7eaa1a56",
                                "sense_id": "310ff604-5079-3327-80e4-95f4c1c3eef7",
                                "text": "Ohrenschmalz dient unter anderem zur Reinigung des äußeren Gehörganges von Schmutz und Staub."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
