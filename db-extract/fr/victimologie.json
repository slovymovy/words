                        "sense_id": "44c0dfc6-647c-3c7c-8698-3432dee20b1c",
                        "entry_id": "d2c70854-ea02-3275-9bb9-49926f008ae7",
                        "glosses": [
                            "Branche de la criminologie étudiant la psychologie des victimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af8a91ba-b123-410b-9d00-bedb8ba3d029",
                                "sense_id": "44c0dfc6-647c-3c7c-8698-3432dee20b1c",
                                "text": "En gros, on veut une spécialiste en « victimologie »"
                            },
                            {
                                "example_id": "897ac12f-a2a2-4067-b63d-3b699bc1ef8c",
                                "sense_id": "44c0dfc6-647c-3c7c-8698-3432dee20b1c",
                                "text": "Tous les quinze jours, l’association reçoit des victimes d'attentat ou de viol, tous patients de l’Institut de victimologie, spécialisé dans le traitement du stress post-traumatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "768e4df7-8688-4601-a3ec-f983c8c8b2a5",
                        "source_entry_id": "d2c70854-ea02-3275-9bb9-49926f008ae7",
                        "source_sense_id": "44c0dfc6-647c-3c7c-8698-3432dee20b1c",
                        "target_lang_word": "Viktimologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viktimologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "624c3387-d637-309d-b0a8-e0919e3a8029",
                                        "entry_id": "607e4199-d2ac-3323-aaf5-67b21509538e",
                                        "glosses": [
                                            "Disziplin der Kriminologie, die sich mit den Opfern von Straftaten und ihren Beziehungen zum Täter beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4649937-94ed-4e57-af7c-4732a2859290",
                                                "sense_id": "624c3387-d637-309d-b0a8-e0919e3a8029",
                                                "text": "„Denn eine Grundregel der Viktimologie, jenes Forschungszweiges, der herausfinden möchte, wer warum und wann zum Opfer wird, ist folgende: Meist kennen sich Täter und Opfer - und sei es noch so oberflächlich oder kurz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
