                        "target_lang_word": "крокодиловы слёзы",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крокодиловы слёзы",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "819cb4cc-90cd-3ff7-913b-e6d3c7abfb56",
                                        "entry_id": "ff8b4b1f-5269-3743-8878-b15864d98de7",
                                        "glosses": [
                                            "разг., ирон. или неодобр. о чьём-либо притворном, лицемерном, фальшивом сочувствии или сожалении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc6bcc0-c378-4d78-9f1d-27fcbdb8f861",
                                                "sense_id": "819cb4cc-90cd-3ff7-913b-e6d3c7abfb56",
                                                "text": "Если китайское подданство, патриотизм чужого отечества, — то зачем крокодиловы слёзы о русских интересах?"
                                            },
                                            {
                                                "example_id": "f093f110-e460-422f-86c5-094e361eb31d",
                                                "sense_id": "819cb4cc-90cd-3ff7-913b-e6d3c7abfb56",
                                                "text": "Путём двурушничества, подлой лжи, наглого обмана, подхалимства и крокодиловых слёз они обманывали многих коммунистов и пролезали во все щели, чтобы вредить и пакостить социалистическому государству рабочих и крестьян."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
