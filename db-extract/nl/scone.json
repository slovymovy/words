                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d954596-5c61-46ca-879e-c53c56e00b84",
                                "sense_id": "81f8954a-afad-396a-adec-49cd0d98ed3f",
                                "text": "Ze zit in The Garden Café achter haar dagelijkse scone, die ze deelt met een kwispelende King Charles Cavalier."
                            },
                            {
                                "example_id": "67156523-6e69-4081-b4a7-70a7bbeac41d",
                                "sense_id": "81f8954a-afad-396a-adec-49cd0d98ed3f",
                                "text": "Via een privé-ingang zouden ze naar de persoonlijke zitkamer van de koningin op de eerste verdieping zijn gegaan waar de koningin normaal gesproken om die tijd een aantal sandwiches, scones en wat fruit zou eten, geserveerd met haar eigen mix van Darjeeling en Assam thee, bekend als Queen Mary’s blend."
                            },
                            {
                                "example_id": "7c0e8e42-4dc3-49b5-bca3-ee4e949aefb8",
                                "sense_id": "81f8954a-afad-396a-adec-49cd0d98ed3f",
                                "text": "De thee werd gebracht, ik dacht eraan om eerst melk te nemen, en de schaal met scones werd rondgestuurd, eerst naar mij. Toen moest ik weer om de tafel lopen om het de moeder aan te bieden."
                            }
                        ]
                    }
