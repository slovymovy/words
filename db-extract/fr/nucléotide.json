                "senses": [
                    {
                        "sense_id": "06f67b48-0c35-3372-8285-e9777859fcba",
                        "entry_id": "0f491711-ec7c-3663-abfd-c77cb7f84a33",
                        "glosses": [
                            "Monomère, composant de base de l’acide désoxyribonucléique et de l’acide ribonucléique, composé d’un groupement phosphate (ou acide phosphorique), d’un pentose, sucre à cinq atomes de carbone (désoxyribose pour l’ADN et ribose pour l’ARN) et d’une base azotée (purine ou pyrimidine)."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "92c18619-84e0-4261-9e0f-49d35757912e",
                                "sense_id": "06f67b48-0c35-3372-8285-e9777859fcba",
                                "text": "m représente le nucléotide à 2′-O-méthyler."
                            },
                            {
                                "example_id": "d9f4596c-8754-4070-8afc-8e7680ed18af",
                                "sense_id": "06f67b48-0c35-3372-8285-e9777859fcba",
                                "text": "l’ADN humain aligne trois milliards de nucléotides (le nom sous lequel on regroupe les molécules A, C, T et G), soit l'équivalent d’un texte de 750 000 pages ou encore 750 tomes d’une édition de la Pléiade."
                            },
                            {
                                "example_id": "d6d7fde4-2a44-43ae-bfed-df71d4896238",
                                "sense_id": "06f67b48-0c35-3372-8285-e9777859fcba",
                                "text": "Bienvenue à Gattaca : le terme Gattaca fait en fait référence aux quatre nucléotides qui composent l’ADN"
                            }
                        ]
                    }
                ],
