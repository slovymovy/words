                "senses": [
                    {
                        "sense_id": "0b4a8d5b-3012-3d25-8083-22bb3d10138b",
                        "entry_id": "54738f67-76cf-3f4a-ad77-3aca8ccbdfaa",
                        "glosses": [
                            "Genre musical traditionnel azéri, suite de mouvements liés à un mode particulier et associant le chant à des instruments traditionnels, târ (luth à 11 cordes), kamânche (vièle à quatre cordes) et tambours sur cadre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611bd43f-d5f3-4779-bbca-4bcf5ef9a031",
                                "sense_id": "0b4a8d5b-3012-3d25-8083-22bb3d10138b",
                                "text": "L’Unesco a inscrit en 2005 l’art du mugham azéri, à la croisée des mondes turc et persan, au Patrimoine immatériel de l’humanité."
                            }
                        ]
                    },
                    {
                        "sense_id": "2853358b-d082-3635-939f-9e82f0810ad1",
                        "entry_id": "54738f67-76cf-3f4a-ad77-3aca8ccbdfaa",
                        "glosses": [
                            "Trio de musiciens interprètes de cette musique, en général chant, târ et kamânche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebfbd63-40db-48f2-9a5e-0cf39258b68f",
                                "sense_id": "2853358b-d082-3635-939f-9e82f0810ad1",
                                "text": "Le mugham azéri composé de Kamila Nabiyeva au chant, Elshan Mansurov au kamantché, et Alakbar Alakbarov au târ, se produit en France en 2019 avec le soutien de l'Ambassade d'Azerbaïdjan."
                            }
                        ]
                    }
                ],
