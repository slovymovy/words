                ],
                "senses": [
                    {
                        "sense_id": "57d1cda1-2161-3585-a059-fa629d09df5c",
                        "entry_id": "30ef8f0c-0ec4-3633-9b8e-e5bca72ef4c6",
                        "glosses": [
                            "Être plus convaincant que ce qui est normalement nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe6d7d3d-7ca4-4f97-af9d-ea3c8c85cf44",
                                "sense_id": "57d1cda1-2161-3585-a059-fa629d09df5c",
                                "text": "Un numéro amusant qui ne sert qu'à surconvaincre les convaincus de chaque bord et glaner des cons."
                            },
                            {
                                "example_id": "5ef2225a-508a-417d-8500-38c82840a35e",
                                "sense_id": "57d1cda1-2161-3585-a059-fa629d09df5c",
                                "text": "Cela n'aura aucune valeur scientifique, mais au moins les convaincus pourront se surconvaincre, ou bien se déconvaincre"
                            },
                            {
                                "example_id": "e0d76967-7f9c-4e97-a08f-b8d483c32098",
                                "sense_id": "57d1cda1-2161-3585-a059-fa629d09df5c",
                                "text": "Alors que les RPG med-fan, y'a intérêt de me surconvaincre que ça vaut le coup pour que je lâche des thunes pour y jouer."
                            }
                        ]
                    }
                ],
