                    {
                        "sense_id": "5cdee185-9afc-369a-b090-6efb555373b9",
                        "entry_id": "3b470d5b-7723-3417-8975-986d07599f96",
                        "glosses": [
                            "Prostituée de rue."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2d4b2f49-786a-4c89-ac24-dd0b82bab21c",
                                "sense_id": "5cdee185-9afc-369a-b090-6efb555373b9",
                                "text": "Mais voilà… on ne s’imagine pas combien il y a de femmes, avec des bouches d’anges, des yeux d’étoiles et des robes de trois mille francs, qui, chez elles, sont grossières de langage, ordurières de gestes, et dégoûtantes à force de vulgarité… de vraies pierreuses !…"
                            },
                            {
                                "example_id": "85808e99-9ae8-44db-83b4-af165846d1c3",
                                "sense_id": "5cdee185-9afc-369a-b090-6efb555373b9",
                                "text": "Sur le trottoir, des pierreuses, décoiffées et mornes, discutaient."
                            },
                            {
                                "example_id": "7ffe1df2-1135-49d4-9c7a-bc4b01127702",
                                "sense_id": "5cdee185-9afc-369a-b090-6efb555373b9",
                                "text": "Si vous jouez « à la putain » avec quelques petits garçons, n’empruntez pas vingt-cinq morpions à la fille du jardinier pour vous faire un vrai con de pierreuse."
                            },
                            {
                                "example_id": "21c10c3a-1204-4850-a104-416c49c606d0",
                                "sense_id": "5cdee185-9afc-369a-b090-6efb555373b9",
                                "text": "La taille souple, elle marchait avec un léger déhanchement de pierreuse, et sa croupe paraissait sensible comme un pendule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65e82821-d12c-431c-9cf1-120574f1b405",
                        "source_entry_id": "3b470d5b-7723-3417-8975-986d07599f96",
