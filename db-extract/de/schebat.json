                        "examples": [
                            {
                                "example_id": "e1230e5f-e0ce-4dbe-b8ad-273d9daaeaec",
                                "sense_id": "3eb4dd78-6045-3038-aa56-874c42d6285d",
                                "text": "„Nachbars Ephraim, ein junger Bursche, der an Zodick's Stelle in Ben David's Hause getreten war, wurde angewiesen, dem Greise Jochai gefällig in Allem zu Diensten zu sein, und nachdem die Familie noch den Freudentag gefeiert hatte, der in den Mond Schebat fällt, fuhren Vater und Tochter, von den Segenssprüchen des Altvaters begleitet, von dannen, im Gefolge eines ansehnlichen Krämerzugs, der nach dem Bodensee trachtete.“"
                            }
                        ],
