                    "frequency": "Middle",
                    "semantic_group_id": "couvre-chef",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a rabattu la <w>visière</w> de sa casquette pour ne pas être ébloui par le soleil."
