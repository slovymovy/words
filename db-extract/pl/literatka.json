                    },
                    {
                        "sense_id": "2fcdac94-efbf-363d-9d9e-498f9c388ad4",
                        "entry_id": "6ae7550a-9e77-3a69-a119-99c59c93c226",
                        "glosses": [
                            "mała szklaneczka o pojemności około 100–150 ml, używana zwykle do picia wódki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd7e9201-a4f2-435e-be6d-b4dc6d4c65d8",
                                "sense_id": "2fcdac94-efbf-363d-9d9e-498f9c388ad4",
                                "text": "Piliśmy alkohol z literatek."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "915dbc9a-35fd-393b-837a-c0e5f945071a",
                        "entry_id": "6ae7550a-9e77-3a69-a119-99c59c93c226",
