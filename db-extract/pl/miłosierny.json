                            {
                                "example_id": "b5cdfe61-1b14-463d-bc25-b548e3007d29",
                                "sense_id": "49a20b3f-7649-380b-848d-52e6b308948d",
                                "text": "Dlatego musiał się upodobnić pod każdym względem do braci, aby stał się miłosiernym i wiernym arcykapłanem wobec Boga dla przebłagania za grzechy ludu"
                            },
                            {
                                "example_id": "82235cfa-6edc-41c0-97c2-add80c5d895e",
                                "sense_id": "49a20b3f-7649-380b-848d-52e6b308948d",
                                "text": "Śmierć jest miłosierna, bo nie ma stamtąd powrotu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
