                ],
                "senses": [
                    {
                        "sense_id": "e722d96e-307e-3ca0-9470-a5c3850c4b8d",
                        "entry_id": "9b4c3857-bec7-3ebf-9de3-17666fb370b9",
                        "glosses": [
                            "Entfernung eines Punktes auf einer Biegung zu einem gedachten Kreismittelpunkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1490aef5-da12-4c52-a905-d07a127d5810",
                                "sense_id": "e722d96e-307e-3ca0-9470-a5c3850c4b8d",
                                "text": "„Der mögliche kleinste Biegeradius ist abhängig von Schlauchaufbau und Steifigkeit, die sich aus Art und Stärke von Seele, Einlage und Decke ergeben.“"
                            },
                            {
                                "example_id": "6a8eabd2-15ba-49d9-be3e-d1df54a4e379",
                                "sense_id": "e722d96e-307e-3ca0-9470-a5c3850c4b8d",
                                "text": "„Im Fall des ausrollbaren Fernsehers von LG aber sei der Biegeradius vorgegeben, der Druck auf die Materialien also genau berechnet.“"
                            },
                            {
                                "example_id": "02401148-4413-4015-8023-b01f16c591cc",
                                "sense_id": "e722d96e-307e-3ca0-9470-a5c3850c4b8d",
                                "text": "„In umfangreichen Tests hat der Multitouchscreen 10 000 Biegezyklen bei fünf und drei Millimetern Biegeradius problemlos bestanden.“"
                            },
                            {
                                "example_id": "6c345b34-a721-4436-8fc8-10441121c0e4",
                                "sense_id": "e722d96e-307e-3ca0-9470-a5c3850c4b8d",
                                "text": "„Dynamische Biegebeanspruchung kann die vorderen Bremsschläuche an der Stelle des kleinsten Biegeradius so belasten, dass es mit der Zeit zu einem möglichen Materialversagen der inneren Gewebeschicht der vorderen Bremsschläuche kommen kann“"
                            },
                            {
                                "example_id": "8e962dc4-22b1-4c86-a2e9-440d0bcbae79",
                                "sense_id": "e722d96e-307e-3ca0-9470-a5c3850c4b8d",
                                "text": "„Für die Montage sollten strikte Vorgaben mit dem Produkt kommen, etwa welcher maximale Biegeradius eingehalten werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
