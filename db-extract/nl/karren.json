                ],
                "senses": [
                    {
                        "sense_id": "7d971170-f5e8-34fd-ab6d-9a2b127aac20",
                        "entry_id": "799f2b35-76a7-3a4c-8b0f-435d4810525b",
                        "glosses": [
                            "met een voertuig rijden"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "1953c212-923d-4511-855b-1eb0fc825855",
                                "sense_id": "7d971170-f5e8-34fd-ab6d-9a2b127aac20",
                                "text": "Dat boompje leek me een soort hindernis. „Onzin!” zei ik tegen mezelf. „We karren er gewoon overheen!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "fc95404d-b796-3c01-8dd2-ba0c8e917d90",
                        "entry_id": "799f2b35-76a7-3a4c-8b0f-435d4810525b",
                        "glosses": [
                            "in een bak op wielen vervoeren"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "faa65d0f-39da-4ad6-86ad-c86f0ac25304",
                                "sense_id": "fc95404d-b796-3c01-8dd2-ba0c8e917d90",
                                "text": "Eén van de ovens was een zogeheten veldoven, waarvan de lange zijden gemetseld werden van oude stenen en de kopzijden gebruikt werden om de groene (droge,ongebakken) stenen naar binnen te karren en te stapelen."
                            }
                        ]
                    }
