                "senses": [
                    {
                        "sense_id": "30d44407-18c2-32e0-87a8-d4cea5cdf824",
                        "entry_id": "249101a3-14f2-3bfe-b1e6-028b06113138",
                        "glosses": [
                            "мифол. в древнегреческой мифологии: имя богини плодородия и царства мёртвых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0995c08e-f141-4ef0-b578-4b9b3fe16f0e",
                                "sense_id": "30d44407-18c2-32e0-87a8-d4cea5cdf824",
                                "text": "И так оно и вышло: четыре месяца в году её дочь ― Персефона, царица теней; а восемь месяцев ― прежняя Кора, ныне же и могучая владычица элевсинских таинств."
                            }
                        ]
                    },
                    {
                        "sense_id": "27de1f16-0aae-3ab4-8c80-578b040a84f7",
                        "entry_id": "249101a3-14f2-3bfe-b1e6-028b06113138",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa9fb1e9-86f0-46c8-a971-b9921f6e4df7",
                        "source_entry_id": "249101a3-14f2-3bfe-b1e6-028b06113138",
                        "source_sense_description": "имя богини",
                        "target_lang_word": "Persephone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Persephone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b643e077-7cc8-3dd1-8dde-b3c3824eefcd",
                                        "entry_id": "33703699-f108-370b-9111-01c80e48dc34",
                                        "glosses": [
                                            "A minor deity, the queen of the Underworld/Hades, and goddess of the seasons and vegetation. Originally named Kore/Core, she is the daughter of Zeus and Demeter; and the wife of Hades. Her Roman counterpart is Proserpina."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "feeaff1e-251f-30bd-8c09-46a7962f475d",
                                        "entry_id": "33703699-f108-370b-9111-01c80e48dc34",
                                        "glosses": [
                                            "399 Persephone, a main belt asteroid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9809b03-304a-345f-a614-72daa1718d83",
                                        "entry_id": "33703699-f108-370b-9111-01c80e48dc34",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01fd3768-281b-49e8-add0-32fb97777f45",
                                                "sense_id": "c9809b03-304a-345f-a614-72daa1718d83",
                                                "text": "‘My name is Persephone’ she says, ‘but in England everyone calls me Seph.’"
                                            }
                                        ]
