                                    {
                                        "sense_id": "08a8b202-de97-34c7-a612-96dba8f7e429",
                                        "entry_id": "de3f7d9b-0f9a-391c-a44c-facc450445e3",
                                        "glosses": [
                                            "Prone to or capable of having orgasms."
