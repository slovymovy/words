                        "cross_references": [
                            {
                                "target_word": "May",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "550b91a4-f6cc-379a-b781-aa9bee2a9e79",
                                        "entry_id": "86f360df-bb1a-3272-b489-6affe259383c",
                                        "glosses": [
                                            "The fifth month of the Gregorian calendar, following April and preceding June."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392652e2-76d0-4e37-bb0f-7898ea5d52a5",
                                                "sense_id": "550b91a4-f6cc-379a-b781-aa9bee2a9e79",
                                                "text": "Holonyms: calendar year; year"
                                            },
                                            {
                                                "example_id": "b3c5d64f-9545-49bb-85fc-02a3e244915d",
                                                "sense_id": "550b91a4-f6cc-379a-b781-aa9bee2a9e79",
                                                "text": "All in the merry month of May, / When green leaves they was springing, / This young man on his death-bed lay, / For the love of Barbara Allen."
                                            },
                                            {
                                                "example_id": "1288989f-a440-46ca-9e5f-f26bb3550c75",
                                                "sense_id": "550b91a4-f6cc-379a-b781-aa9bee2a9e79",
                                                "text": "At a signing ceremony in the Kazakh capital, Astana, on May 29, the presidents of Russia, Belarus, and Kazakhstan ratified the Eurasian Economic Union (EEU) into existence. An EEU modeled on the European Union was first mooted back in 1994 by Kazakh President Nursultan Nazarbayev, but took off only after his Russian counterpart, Vladimir Putin, seized upon its potential as a Moscow-centered, Asia-oriented alternative to the EU."
                                            },
                                            {
                                                "example_id": "528e9bc9-d300-4f17-8d6f-f6991035fc94",
                                                "sense_id": "550b91a4-f6cc-379a-b781-aa9bee2a9e79",
                                                "text": "In May, White House deputy chief of staff for policy Stephen Miller told reporters the Trump administration is “looking at” suspending the writ of habeas corpus for migrants under claims of an “invasion.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521df8c9-7bb0-332b-8bad-c9b22143615f",
                                        "entry_id": "86f360df-bb1a-3272-b489-6affe259383c",
                                        "glosses": [
                                            "A female given name, usually pet name for Mary and Margaret, reinforced by the month and plant meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2faa4f03-6559-45a9-a870-5cff94eebba8",
                                                "sense_id": "521df8c9-7bb0-332b-8bad-c9b22143615f",
                                                "text": "[…] I will not send Owen's Lily May to the almshouse.\" \"Lily―what?\" demanded Mrs. Morley rather sharply, for she was half provoked with what she mentally called Amy's whim of keeping the outcast child when she might send it to the asylum. \"Lily May,\" said Amy, smiling. \"Her name is Mary, and we called her first Little Mary, and then Little May. But Owen calls her Lily May.\""
                                            },
                                            {
                                                "example_id": "7dbd70ab-f690-4ed4-9e05-18ea23ffb4b9",
                                                "sense_id": "521df8c9-7bb0-332b-8bad-c9b22143615f",
                                                "text": "Their parents named them June and May because their birthdays occurred in those months. […] May was like the time of year in which she had been born, changeable, chilly and warm by turns, sullen yet able to know and show loveliness that couldn't last."
                                            },
                                            {
                                                "example_id": "50d57f00-8066-45a6-9124-d11f80a01904",
                                                "sense_id": "521df8c9-7bb0-332b-8bad-c9b22143615f",
                                                "text": "It's an awkward name: Isamay, pronounced Is-a-may. Isa is my paternal grandmother's name (shortened from Isabel) and May my maternal grandmother's (it comes, somehow, from Margaret). The amalgamation is, as you see, strictly alphabetical. Life, I feel, would have been much easier if they had chosen Maybel."
                                            },
                                            {
                                                "example_id": "2741435a-1df4-421d-954e-cb8348ef490d",
                                                "sense_id": "521df8c9-7bb0-332b-8bad-c9b22143615f",
                                                "text": "Sahaiʔa May Talbot was born on Feb. 15, 2014. However, on her birth certificate, her name is spelled Sahai'a because the Northwest Territories government only allows the Roman alphabet to be used on official documents."
                                            }
                                        ]
                                    },
