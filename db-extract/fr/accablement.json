        "fr-extract.jsonl": [
            {
                "entry_id": "c9092bc8-7e38-394d-b690-07e878ffb4a1",
                "word": "accablement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf64cefe-78a7-4220-ba04-236fc1953a8f",
                        "entry_id": "c9092bc8-7e38-394d-b690-07e878ffb4a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "accablements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                        "entry_id": "c9092bc8-7e38-394d-b690-07e878ffb4a1",
                        "glosses": [
                            "État d’une personne accablée par la maladie, par l’affliction, ou par des charges morales pesantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac6668f1-70e4-4543-ae1d-49166e7bd00e",
                                "sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                                "text": "Je m’arrêtai un instant sur un banc ruisselant de pluie, et tel était mon accablement que je ne sentais point l’humidité froide."
                            },
                            {
                                "example_id": "3df04d6c-0855-4fe4-b8c6-e3438934b0ff",
                                "sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                                "text": "Sous le grand ciel du printemps, limpide encore et lumineux, sous l’accablement lourd de l’été, les dunes du Souf s’étendaient […]"
                            },
                            {
                                "example_id": "f697a2d3-d9e0-4ca1-94bc-c7ca77b56ab9",
                                "sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                                "text": "De grands souffles passaient, charriant l’haleine des végétations trempées de pluie, qui vivent d’une vie plus forte, après l’accablement des jours."
                            },
                            {
                                "example_id": "3a70dc47-73ee-41b6-903d-a9f6a8a94fdc",
                                "sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                                "text": "L’accablement particulier qui l’oppressait ne provenait pas tant d’une anxiété patriotique que de la faim ; évidemment, il se sentait très affamé."
                            },
                            {
                                "example_id": "9f206164-6976-497c-9517-1c5c8ead50c9",
                                "sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                                "text": "À mon tour, je leur serrai la main et j’éprouvai une sorte de nausée en présence de Reynolde. Ce feutre gris, cette moustache, cette voix chaude et ce parfum d’eau de toilette m’avaient toujours causé un vif accablement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f8dac1d-3bfb-41b5-8dfe-b23b8f9b58ce",
                        "source_entry_id": "c9092bc8-7e38-394d-b690-07e878ffb4a1",
                        "source_sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                        "target_lang_word": "dejection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dejection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df24a7b8-59ca-3406-8593-14101c0e05d3",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "A state of melancholy or depression; low spirits, the blues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebda68d7-5357-3a06-852b-6f5d2152a5da",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "The act of humbling or abasing oneself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23421866-f8b1-45a7-b12d-73850b428297",
                                                "sense_id": "ebda68d7-5357-3a06-852b-6f5d2152a5da",
                                                "text": "Adoration implies submission and dejection, so that while we worship we cast down ourselves; there must be therefore some great eminence in the object worshipped, or else we should dishonor our own nature in the worship of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54747406-941e-36ea-8d15-8fb71aae6fe9",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "A low condition; weakness; inability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b34edf3-5c58-4547-b761-a59f92b8e89b",
                                                "sense_id": "54747406-941e-36ea-8d15-8fb71aae6fe9",
                                                "text": "Meat remaining in the stomach undigested, dejection of appetite, wind coming upwards, are signs of a phlegmatick constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                        "entry_id": "a406fd40-ce51-3a09-a378-78d3a3a76538",
                                        "glosses": [
                                            "Defecation or feces."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195d1cb0-bdc2-4aab-bf3a-0578752907f4",
                                                "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                                "text": "His dejections were frequent, loose, changing in character from hour to hour, made up of undigested food, of mucus and watery fluid, varying in color, mostly green, and never healthy in consistence, color, or odor."
                                            },
                                            {
                                                "example_id": "5ace986c-5aa6-4f46-93a3-f29e02b741e9",
                                                "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                                "text": "No dejection since his entrance, nor has he passed urine."
                                            },
                                            {
                                                "example_id": "8e3d53f6-21d2-4173-b33e-478c9bf8a277",
                                                "sense_id": "9ccca405-3f53-36f1-9794-65b2fbbc3094",
                                                "text": "Chorera infantum may begin as an attack of acute indigestion, or, what is more frequently the case, suddenly, with severe vomiting and copious dejections, high fever and rapid prostration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d4b5f30-f352-4fc7-8ec3-f233b960c3ae",
                        "source_entry_id": "c9092bc8-7e38-394d-b690-07e878ffb4a1",
                        "source_sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                        "target_lang_word": "despondency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despondency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "379d3fe6-9e7c-3858-ba22-20e5dc2add47",
                                        "entry_id": "bfeb0b6c-8ea1-3c6b-9d3e-0b6c98dd77c1",
                                        "glosses": [
                                            "The loss of hope or confidence; despair or dejection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f427d4c-5324-4237-98c4-8ae1b16524f0",
                                                "sense_id": "379d3fe6-9e7c-3858-ba22-20e5dc2add47",
                                                "text": "Not everyone succumbed to such nostalgia and despondency. Some saw the existential threat to Scots as a call to document what remained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c07e5ba-8b72-356c-b0f0-7fd0798878a9",
                                        "entry_id": "bfeb0b6c-8ea1-3c6b-9d3e-0b6c98dd77c1",
                                        "glosses": [
                                            "A feeling of depression or disheartenment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cefcf8b1-17e8-41f1-a01e-f14ef0a831e0",
                                                "sense_id": "4c07e5ba-8b72-356c-b0f0-7fd0798878a9",
                                                "text": "He kissed her brow, and left her. She watched him unconsciously, till the winding walk hid him from her sight, and then sank back on her seat, every nerve relaxing from its high-strained excitement into utter and still despondency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9829ff06-0756-43ea-a085-d5d2b60d03bf",
                        "source_entry_id": "c9092bc8-7e38-394d-b690-07e878ffb4a1",
                        "source_sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                        "target_lang_word": "depression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fab73381-4787-35c0-8e58-a557a34feee4",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A state of mind producing serious, long-term lowering of enjoyment of life or inability to visualize a happy future; any of several mental disorders with this state of mind as a central feature."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1749bcdf-e767-4053-9d5b-f862a1fe7c66",
                                                "sense_id": "fab73381-4787-35c0-8e58-a557a34feee4",
                                                "text": "I used to suffer from depression, but now I'm mostly content with my life."
                                            },
                                            {
                                                "example_id": "8713f305-24a9-4126-82a3-ca5acd5fc07a",
                                                "sense_id": "fab73381-4787-35c0-8e58-a557a34feee4",
                                                "text": "It is that Mr. Levi's death could not be dissociated from the major depression with which he was afflicted, and that indeed his suicide proceeded directly from that illness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A period of low morale or unhappiness (a period of experiencing the above-mentioned state of mind) which lasts longer than several weeks and may include ideation of self-inflicted injury or suicide."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1423222-2c35-48d7-9e28-deef1a507172",
                                                "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                                "text": "[…] your illness reflects the textbook description of bipolar disorder (euphoric, grandiose, manic highs followed by deep depressions,[…]"
                                            },
                                            {
                                                "example_id": "72f37d12-857d-4fc5-8ea8-57745b245bb6",
                                                "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                                "text": "His first major breakdown occurred when his son was five years old; he continued to go to pieces periodically, with a particularly deep depression that lasted from the time Bill was in sixth grade until the time he finished junior high[…]"
                                            },
                                            {
                                                "example_id": "f1c985b3-783b-4bb2-a9d1-19855141d111",
                                                "sense_id": "f5caa6bb-5a0f-3132-88c4-4b6c4639d17f",
                                                "text": "Many alcoholics who die from suicide suffer from deep depressions that are quite frequently protracted,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebfcf11c-cf24-311a-9d25-624aa44e9f99",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "An area that is lower in topography than its surroundings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d846d42e-3b2c-4ee8-bdf7-10d7c7553c67",
                                                "sense_id": "ebfcf11c-cf24-311a-9d25-624aa44e9f99",
                                                "text": "It was not far from the house; but the ground sank into a depression there, and the ridge of it behind shut out everything except just the roof of the tallest hayrick. As one sat on the sward behind the elm, with the back turned on the rick and nothing in front but the tall elms and the oaks in the other hedge, it was quite easy to fancy it the verge of the prairie with the backwoods close by."
                                            },
                                            {
                                                "example_id": "9f9eee97-9980-4923-b876-0aab06817bd9",
                                                "sense_id": "ebfcf11c-cf24-311a-9d25-624aa44e9f99",
                                                "text": "These large [mazes] led to smaller ones which were constructed to hold in the hand, usually in the form of a circular tray. In these a marble was contained which had to be manipulated to roll into a depression in the centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2e08f9-c6aa-3c23-8450-b18ceb5b3d20",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "An area of lowered air pressure that generally brings moist weather, sometimes promoting hurricanes and tornadoes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31fe5a85-4c25-3d28-a8ff-fc0c05bfeb52",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A period of major economic contraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed3ddf00-5857-3760-9f49-cfceee1d9a48",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "Four consecutive quarters of negative, real GDP growth. See NBER."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe34d832-66cb-4618-810e-0fa95e8614aa",
                                                "sense_id": "ed3ddf00-5857-3760-9f49-cfceee1d9a48",
                                                "text": "The Great Depression was the worst financial event in US history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d9c171-4061-3706-b425-7ef8bcd79f6f",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "The act of lowering or pressing something down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da65eb7-76cd-4e0a-9f33-340810e4daa1",
                                                "sense_id": "d2d9c171-4061-3706-b425-7ef8bcd79f6f",
                                                "text": "Depression of the lever starts the machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7dc6c1-6642-37a3-aa4a-212f9fa5cd15",
                                        "entry_id": "43c78322-531a-3f1c-9c6b-a4b86bf2b0f7",
                                        "glosses": [
                                            "A lowering, in particular a reduction in a particular biological variable or the function of an organ, in contrast to elevation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdac6948-f343-4daf-aa46-8b9f729ab240",
                        "source_entry_id": "c9092bc8-7e38-394d-b690-07e878ffb4a1",
                        "source_sense_id": "2c6a2695-b866-3ab0-864f-542745b247dc",
                        "target_lang_word": "consternation",
                        "target_lang_code": "en",
