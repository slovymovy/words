                "senses": [
                    {
                        "sense_id": "e3b9a8eb-7761-30c3-9a08-30d7e103ce5c",
                        "entry_id": "717f100d-5447-3521-91f4-0a633f89463b",
                        "glosses": [
                            "Crise de folie meurtrière, tuerie où le tueur abat toutes les personnes rencontrées, au risque assumé voire recherché d’être lui-même abattu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a67e63-2196-4567-8606-82610582e44a",
                                "sense_id": "e3b9a8eb-7761-30c3-9a08-30d7e103ce5c",
                                "text": "Amoklauf an der Columbine High School",
                                "translation": "La tuerie de Columbine"
                            },
                            {
                                "example_id": "f19facb3-ac1d-42e8-b529-39f11853e9a5",
                                "sense_id": "e3b9a8eb-7761-30c3-9a08-30d7e103ce5c",
                                "text": "Die Polizei München bestätigt am Samstag Mittag, dass die Bluttat keinen Bezug zu Terrorismus aufweist. Alles deutet auf einen Amoklauf hin.",
                                "translation": "La police de Munich confirme samedi à midi que la tuerie ne présente pas de rapport avec le terrorisme. Tout indique qu'il s’agit d’une crise de folie meurtrière."
                            },
                            {
                                "example_id": "75965d81-39e9-49ab-b08f-5f0478fa4191",
                                "sense_id": "e3b9a8eb-7761-30c3-9a08-30d7e103ce5c",
                                "text": "Ein zweiter Amoklauf innerhalb von zwei Tagen schockt Serbien. Präsident Vučić kündigt politische Folgen an: Er will die Nation entwaffnen.",
                                "translation": "Une deuxième tuerie en l’espace de deux jours choque la Serbie. Le président Vučić annonce des conséquences politiques : Il veut désarmer la nation."
                            }
                        ]
                    }
                ],
