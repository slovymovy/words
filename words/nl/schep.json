{
    "word_family": [
        "opschepper",
        "schepping",
        "schepper",
        "inschepen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10381733-7ed3-366a-add4-4c0dac2c9cd5",
                    "sense_definition": "Werktuig met een plat of hol blad om aarde, zand of andere stoffen op te pakken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij pakte een <w>schep</w> en begon een diep gat in de tuin te graven. ",
                            "target_lang_translations": {
                                "en": "He grabbed a <w>shovel</w> and started digging a deep hole in the garden."
                            }
                        },
                        {
                            "text": "Met een grote <w>schep</w> verplaatste de man de aarde naar de container.",
                            "target_lang_translations": {
                                "en": "With a large <w>shovel</w>, the man moved the earth to the container."
                            }
                        }
                    ],
                    "synonyms": [
                        "schop",
                        "spade"
                    ],
                    "common_phrases": [
                        "met een schep",
                        "een grote schep"
                    ],
                    "target_lang_definitions": {
                        "en": "A tool with a flat or curved blade used to pick up earth, sand, or other materials."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shovel",
                                "target_lang_sense_clarification": "for moving earth, snow, or sand"
                            },
                            {
                                "target_lang_word": "spade",
                                "target_lang_sense_clarification": "for digging ground"
                            },
                            {
                                "target_lang_word": "scoop",
                                "target_lang_sense_clarification": "small tool for loose materials"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e7d07e6-e6ad-3b47-a291-d3ffb05b521c",
                    "sense_definition": "De hoeveelheid van iets die op een schep of lepel past.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij deed twee <w>scheppen</w> suiker in de koffie om het zoeter te maken.",
                            "target_lang_translations": {
                                "en": "He put two <w>spoonfuls</w> of sugar in the coffee to make it sweeter."
                            }
                        },
                        {
                            "text": "Mag ik nog een <w>schep</w> ijs als toetje?",
                            "target_lang_translations": {
                                "en": "May I have another <w>scoop</w> of ice cream for dessert?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "een schep suiker",
                        "nog een schep"
                    ],
                    "target_lang_definitions": {
                        "en": "The amount of something that fits on a shovel, scoop, or spoon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scoop",
                                "target_lang_sense_clarification": "amount of ice cream, powder, etc."
                            },
                            {
                                "target_lang_word": "spoonful",
                                "target_lang_sense_clarification": "amount contained in a spoon"
                            },
                            {
                                "target_lang_word": "shovelful",
                                "target_lang_sense_clarification": "amount held on a shovel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40a4753a-1810-39da-8630-d6e8edc77477",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>scheppen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schep</w> de soep alvast in de diepe borden op tafel.",
                            "target_lang_translations": {
                                "en": "I am already <w>ladling</w> the soup into the soup plates on the table."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>schep</w> ik vers eten voor de hond.",
                            "target_lang_translations": {
                                "en": "Every morning I <w>scoop</w> fresh food for the dog."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ik schep op"
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'scheppen' (to scoop, ladle, or create)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scoop",
                                "target_lang_sense_clarification": "I scoop / serve food or material"
                            },
                            {
                                "target_lang_word": "ladle",
                                "target_lang_sense_clarification": "I serve liquid like soup"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d9729f-726a-3a4c-abb8-60037fa7a8ec",
                    "sense_definition": "Gebiedende wijs van <w>scheppen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schep</w> alsjeblieft niet zo op over je nieuwe auto.",
                            "target_lang_translations": {
                                "en": "Please don't <w>boast</w> so much about your new car."
                            }
                        },
                        {
                            "text": "<w>Schep</w> de borden maar snel vol, het eten is klaar.",
                            "target_lang_translations": {
                                "en": "Quickly <w>fill</w> up the plates, the food is ready."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schep niet op"
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'scheppen' (to scoop/ladle or to brag when combined with 'op')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scoop",
                                "target_lang_sense_clarification": "command to serve or gather material"
                            },
                            {
                                "target_lang_word": "boast",
                                "target_lang_sense_clarification": "in combination with 'op' (brag)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}