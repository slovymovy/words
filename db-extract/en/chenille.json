                "senses": [
                    {
                        "sense_id": "67ca624e-86e0-33c9-8ee7-a230a2c34a7b",
                        "entry_id": "252ea22e-55f9-3bcb-9042-01e2eda56c5e",
                        "glosses": [
                            "An extremely soft and bunchy fabric often used to make sweaters."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f11f2ba-81c1-469c-aecf-257e55288d42",
                                "sense_id": "67ca624e-86e0-33c9-8ee7-a230a2c34a7b",
                                "text": "The house seemed unfamiliar in the dark stormy light; the red and purple glass of the front door made livid bruises on the linoleum; the green chenille curtain was like a veil of seaweed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e31e3a9-b8ce-4938-9e4a-0a3ee71932c8",
                        "source_entry_id": "252ea22e-55f9-3bcb-9042-01e2eda56c5e",
