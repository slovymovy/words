{
    "word_family": [
        "native",
        "nativity",
        "nativism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "57b4fe0c-e4ec-3f82-90c7-88af0a83a9f7",
                    "sense_definition": "Not indigenous or original to a particular place or environment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park authorities are working to remove <w>nonnative</w> plants that are crowding out local species.",
                            "target_lang_translations": {
                                "ru": "Администрация парка работает над удалением <w>неместных</w> растений, которые вытесняют местные виды."
                            }
                        },
                        {
                            "text": "Many <w>nonnative</w> animals struggle to survive in the harsh winter climate of this region.",
                            "target_lang_translations": {
                                "ru": "Многим <w>чужеродным</w> животным трудно выжить в суровом зимнем климате этого региона."
                            }
                        }
                    ],
                    "synonyms": [
                        "introduced",
                        "exotic",
                        "alien"
                    ],
                    "antonyms": [
                        "native",
                        "indigenous"
                    ],
                    "common_phrases": [
                        "nonnative species",
                        "nonnative plants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не являющийся местным или коренным для определенной среды или региона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неместный",
                                "target_lang_sense_clarification": "общий термин для обозначения того, что не является коренным"
                            },
                            {
                                "target_lang_word": "интродуцированный",
                                "target_lang_sense_clarification": "научный термин для видов, завезенных из других мест"
                            },
                            {
                                "target_lang_word": "чужеродный",
                                "target_lang_sense_clarification": "подчеркивает чуждость для данной экосистемы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c35effdf-0c47-35b4-a013-8de7eee038f2",
                    "sense_definition": "A person or organism that is not indigenous to a particular place.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city offers special orientation programs to help <w>nonnatives</w> adjust to the local culture.",
                            "target_lang_translations": {
                                "ru": "Город предлагает специальные адаптационные программы, чтобы помочь <w>приезжим</w> освоиться в местной культуре."
                            }
                        },
                        {
                            "text": "As a <w>nonnative</w>, he found the local customs quite difficult to understand at first.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>некоренным жителем</w>, поначалу он находил местные обычаи довольно сложными для понимания."
                            }
                        }
                    ],
                    "synonyms": [
                        "foreigner",
                        "outsider",
                        "newcomer"
                    ],
                    "antonyms": [
                        "native",
                        "local"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или организм, не являющийся коренным жителем данной местности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приезжий",
                                "target_lang_sense_clarification": "человек, который приехал из другого места"
                            },
                            {
                                "target_lang_word": "чужестранец",
                                "target_lang_sense_clarification": "человек из другой страны"
                            },
                            {
                                "target_lang_word": "некоренной житель",
                                "target_lang_sense_clarification": "формальное обозначение человека, не принадлежащего к коренному населению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}