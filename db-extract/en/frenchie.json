                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a78cdaed-ee28-3953-9ab0-2926d3868974",
                        "entry_id": "ef3fdc5c-411c-3a32-84db-2fbae941de53",
                        "glosses": [
                            "A French kiss."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6de20811-cd19-418f-9188-f86422e17600",
                                "sense_id": "a78cdaed-ee28-3953-9ab0-2926d3868974",
                                "text": "“Kiss me,” she said.\nHe heard a giggle from Molly.\n“Give her a Frenchie,” Solly said."
                            }
                        ]
                    }
