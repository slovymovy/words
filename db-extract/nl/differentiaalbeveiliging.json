                                "target_word": "Fehlerstromschutzschalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb98714-8b81-32ba-b59f-9aeda72bd832",
                                        "entry_id": "0bcea3f3-eb11-3753-b702-f0034ee42313",
                                        "glosses": [
                                            "Schutzeinrichtung in Stromnetzen, die den angeschlossenen, überwachten Stromkreis vom restlichen Stromnetz abtrennt, wenn Strom den überwachten Stromkreis auf falschem Weg verlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e57547d-570b-46f4-8dc4-32144629f773",
                                                "sense_id": "ceb98714-8b81-32ba-b59f-9aeda72bd832",
                                                "text": "In Österreich sind seit 1980 Fehlerstromschutzschalter gesetzlich in jedem Haushalt vorgeschrieben."
                                            },
                                            {
                                                "example_id": "f6c291f4-f3f4-41ba-aa6a-15c3d0744bd2",
                                                "sense_id": "ceb98714-8b81-32ba-b59f-9aeda72bd832",
                                                "text": "Der Fehlerstromschutzschalter schaltet aus Sicherheitsgründen automatisch den Strom ab, wenn dieser den Stromkreis auf falschem Wege verlässt."
                                            },
                                            {
                                                "example_id": "a2b3b6b2-e50d-4811-982e-8e1a1e8de5b9",
                                                "sense_id": "ceb98714-8b81-32ba-b59f-9aeda72bd832",
                                                "text": "Wenn der Föhn in die mit Wasser gefüllte Badewanne fällt, sollte der Fehlstromschutzschalter den Strom zu diesem Gerät abschalten."
                                            },
                                            {
                                                "example_id": "c4a60739-39de-4c1b-9408-e8824ce2ca2c",
                                                "sense_id": "ceb98714-8b81-32ba-b59f-9aeda72bd832",
                                                "text": "„Denn eine neue DIN verlange eine Absicherung ‚aller vom Laien bedienbaren Steckdosen‘ über einen Fehlerstromschutzschalter.“"
                                            },
                                            {
                                                "example_id": "b031b05c-2be6-4b27-bfad-cbb455f4187d",
                                                "sense_id": "ceb98714-8b81-32ba-b59f-9aeda72bd832",
                                                "text": "„Schutz bieten etwa Fehlerstromschutzschalter, die bei einer Berührung mit Wasser den Stromfluss unterbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
