            {
                "entry_id": "2201bda2-2e01-394e-bcda-04f79072feba",
                "word": "overproof",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c8b16e76-139d-450f-bce2-6f32de7a33de",
                        "entry_id": "2201bda2-2e01-394e-bcda-04f79072feba",
                        "tags": [
                            "plural"
