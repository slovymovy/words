            "senses": [
                {
                    "sense_id": "917caf26-3bb3-3cc9-a0dd-1f0d5849d31b",
                    "sense_definition": "The ability to judge well, wisely, or critically.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board praised her <w>discernment</w> when selecting candidates for the senior executive position."
