                "senses": [
                    {
                        "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                        "entry_id": "2abb2185-77f1-3ded-972c-026110c9e666",
                        "glosses": [
                            "unfreiwillige Entlassung (vom Arbeitsplatz)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ef859e81-95fe-418f-acc3-80d764a48532",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "Die zweite Abmahnung bedeutete für den Mitarbeiter den drohenden Rausschmiss."
                            },
                            {
                                "example_id": "962200ec-8b1a-442f-b0c1-3a348d1b9cbf",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "Er sagte nichts weiter zu den Anschuldigungen, denn er wollte nicht seinen Rausschmiss riskieren."
                            },
                            {
                                "example_id": "ca554dbf-dca4-4675-9859-8ed8ac6f5efe",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "Meine Eltern haben mir den Rausschmiss angedroht, falls ich weiter die Schule schwänze."
                            },
                            {
                                "example_id": "267dc84f-67cb-420b-836c-49d39f03a977",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "Als sie mehr Transparenz forderte, hat man ihr mit dem Rausschmiss gedroht."
                            },
                            {
                                "example_id": "9d45655a-c667-486f-a364-5bc1920adc08",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "Wie willst du denn jetzt noch deinen Rausschmiss vermeiden?"
                            },
                            {
                                "example_id": "69bfd77c-8439-4f5e-9922-4a42155f8400",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "„Flynns Rausschmiss ist dafür Anfang und Ausgangspunkt.“"
                            },
                            {
                                "example_id": "b84fde3a-53b6-4573-b0b6-b432a3cf3e2f",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "„Er habe, so begründete der General den Rausschmiss, es verabsäumt, seine amtlichen Obliegenheiten und seine Verpflichtungen gegenüber der Kölner Bevölkerung zu erfüllen; so habe er die Trümmerbeseitigung der zu sechzig Prozent zerstörten Stadt sträflich schleifen lassen.“"
                            },
                            {
                                "example_id": "4aae6649-fd8c-4db2-9a8f-d357afea21f5",
                                "sense_id": "85f7d0cd-ea0e-3b11-bbb6-ad2e479d7d7a",
                                "text": "„Es tat mir leid, dass der Rausschmiss aus dem Auktionshaus ihn so aufzuwühlen schien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
