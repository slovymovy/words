                ],
                "senses": [
                    {
                        "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                        "entry_id": "05dc87b0-8b65-3266-99d4-81a80b17ad84",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "070afa84-55fc-4a19-b2dc-b05b43d552df",
                                "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                                "text": "Frau Herdle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e03ccdcb-3c09-41e5-b050-f0f35222a772",
                                "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                                "text": "Herr Herdle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b94d2b71-6ae4-4178-99b3-5fc4a76062ae",
                                "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                                "text": "Die Herdles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0512ee7e-cee5-4b34-b6cc-faca3c14b48c",
                                "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                                "text": "Der Herdle trägt nie die Schals, die die Herdle ihm strickt."
                            },
                            {
                                "example_id": "c6af43a8-afc7-4bcb-a074-092b525b0c77",
                                "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Herdle kommt, geht der Herr Herdle.“"
                            },
                            {
                                "example_id": "e4794692-deb1-470c-9179-1c816b5ab040",
                                "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                                "text": "Herdle kommt und geht."
                            },
                            {
                                "example_id": "0de723db-20cf-42b5-8a96-734c54324848",
                                "sense_id": "e62324a7-9d6b-3337-bf86-94149c6473c6",
                                "text": "Herdles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
