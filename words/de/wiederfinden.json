                    "sense_definition": "etwas oder jemanden, das oder der verloren gegangen oder verlegt war, durch Suchen oder Zufall wieder entdecken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "auffinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach langer Suche <w>fand</w> sie ihre Brille unter dem Sofa <w>wieder</w>."
                        },
                        {
                            "text": "Ich hoffe sehr, dass wir den verloren gegangenen Hund bald <w>wiederfinden</w>."
                        }
                    ],
                    "synonyms": [
                        "auffinden"
                    ],
                    "antonyms": [
                        "verlegen",
                        "verlieren"
                    ],
                    "common_phrases": [
                        "den Schlüssel wiederfinden",
                        "eine Geldbörse wiederfinden"
                    ]
                },
                {
