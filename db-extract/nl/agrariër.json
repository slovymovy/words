                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39fbf67d-510e-4d8f-8ec8-501538f2a5ee",
                                                "sense_id": "4084be48-679a-348e-8568-493f0451b2e1",
                                                "text": "Er wollte Jurisprudenz studieren, aber musste aus Mangel an zureichendem Geld Agrarier werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
