                    },
                    {
                        "translation_id": "d97f3529-7d7d-4a35-b659-89d9433cdba2",
                        "source_entry_id": "2569512e-a2c6-395e-b66b-c355d79d811f",
                        "source_sense_id": "6db706a6-a12a-3812-a055-76369493d18a",
                        "source_sense_description": "am Boden wachsende Pflanze",
                        "target_lang_word": "creeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8469c8f4-06e1-3be0-abe6-2b723a6a67c8",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A person or a thing that crawls or creeps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c87441a-1165-49ca-93da-91b0f7513432",
                                                "sense_id": "8469c8f4-06e1-3be0-abe6-2b723a6a67c8",
                                                "text": "Standing Waters[…] are most unwholesome, putrified, and full of mites, creepers, slimy, muddy, uncleane, corrupt, impure, by reason of the Suns heat, and still standing;"
                                            },
                                            {
                                                "example_id": "8feee6f8-28be-422a-9e8b-0e57d5bd3d04",
                                                "sense_id": "8469c8f4-06e1-3be0-abe6-2b723a6a67c8",
                                                "text": "With his presence marked by shots of children’s toys overlaid with ominous music, Z is more of a creeper than a reaper—until a shocking, sudden moment midway through the film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82db22fa-9ee1-3c3d-8aaa-2995c3f80ff7",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "Any creeping animal (such as a serpent), reptile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eb096eb-8e4d-35e0-be77-2c865d83584e",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A one-piece garment for infants designed to facilitate access to the wearer's diaper."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1be8bba-ba01-393c-9b83-1358c2282e09",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A device which allows a small child to safely roam around a room from a seated or standing position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c2100b3-7dcf-3194-9f36-60a7e941af63",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A metal plate with spikes, designed to be worn with shoes to prevent slipping."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28e60cdb-d1a3-3d37-89d1-c702f04b30dd",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A spur-like device strapped to the boot to facilitate climbing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da6bf966-113f-30ec-abbe-07affa263a0d",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A small low iron, or dog, between the andirons."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8c2e7c9-b326-3c25-8a2a-417a41f646dc",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "An instrument with iron hooks or claws for dredging up items from a well or other water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6f1b002-e19a-3ee3-b1cb-ccaf2104f508",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "Any device for causing material to move steadily from one part of a machine to another, such as an apron in a carding machine, or an inner spiral in a grain screen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "138584a4-ec0d-3637-a324-66fa9bc3b11f",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "Any plant (as ivy or periwinkle) that grows by creeping, especially a climbing plant of the genus Parthenocissus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "836524a2-82fc-487a-b7b7-789c2f4ec5e0",
                                                "sense_id": "138584a4-ec0d-3637-a324-66fa9bc3b11f",
                                                "text": "Then the piglet tore loose from the creepers and scurried into the undergrowth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f29e13-7353-3a70-bf0e-d73e6df94cf7",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A treecreeper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e37c7d4-8596-304b-9eca-9836619000ab",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "Strophitus undulatus, a freshwater mussel of the eastern United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52f93ee1-deaa-3fce-9e41-5d247572f35d",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A small four-hooked grapnel used to recover objects dropped onto the sea bed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23d902e1-fb05-3127-be23-63fd7124acf0",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "The lowest gear of some tractors or trucks: one with so low a gear ratio that the vehicle creeps along at the speed of a human's slow walk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6f2963-2f68-47a0-890b-69b0203cec4e",
                                                "sense_id": "23d902e1-fb05-3127-be23-63fd7124acf0",
                                                "text": "Throwing it in creeper and then getting out to work alongside is strictly forbidden because it is too dangerous if anything goes wrong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e11e9c-04bb-3651-b6f6-75350ed0ce09",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A low-profile wheeled platform whereupon one may lie on one's back and gain better access to the roof of a space with very low height (such as the underbody of a vehicle), or a low stool similarly wheeled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80cee69d-371f-4c22-b9b0-b73b577e4619",
                                                "sense_id": "24e11e9c-04bb-3651-b6f6-75350ed0ce09",
                                                "text": "If my phone rings while I'm on a creeper underneath the car with oil on my hands, well, the caller will just have to leave a voicemail."
                                            },
                                            {
                                                "example_id": "93452a8c-4a6b-4d6e-9cf9-2aaddac64fbf",
                                                "sense_id": "24e11e9c-04bb-3651-b6f6-75350ed0ce09",
                                                "text": "\"Yeah.\" It was him, alright; if the world's weariest pair of workboots hadn't tipped her off, his world-weary voice certainly would have. \"Where were you?\"\n\"My quarters. We've got a full ticket set today, and techs work best without oversight.\" Neither of these things was untrue, though the curation was more than a little dishonest.\n\"Maybe yours do.\" Nascimbeni rolled out, back flat against a neon orange creeper, and sat up with an audible wince. \"Mine fuck the dog.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bd11259-e0e0-344d-bb51-c6ef6be435ad",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A person who creeps people out; a creepy person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a22f9fd-176b-4155-958a-6ffcb574012b",
                                                "sense_id": "2bd11259-e0e0-344d-bb51-c6ef6be435ad",
                                                "text": "Don't go to a nightclub to find a boyfriend. They're all creepers there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d778f78f-64ac-3e74-bc72-2ba5c5b0bb70",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A kind of shoe, usually with a suede upper and a thick crepe sole, associated with various 20th-century subcultures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "577ea00d-023f-3e83-990f-774519c7e75a",
                                        "entry_id": "2bf666a7-7c4f-39de-8dc2-34db128826ac",
                                        "glosses": [
                                            "A ball that travels low, near ground level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baba4854-09b6-41bd-b377-f3b2520227a9",
                                                "sense_id": "577ea00d-023f-3e83-990f-774519c7e75a",
                                                "text": "May joined Hutton and proceeded to play masterly cricket in which the straight-drive predominated. There was always the possibility that he might be trapped by a creeper, but May watched the ball intently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
