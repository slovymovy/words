                "senses": [
                    {
                        "sense_id": "527d8373-07ca-3222-a03e-81aaa23594ad",
                        "entry_id": "e94c3773-4d3b-306c-bebc-dbf36d1d6919",
                        "glosses": [
                            "Partie dorsale du diencéphale qui participe, via la sécrétion de mélatonine au contrôle du sommeil et à la régulation de fonctions végétatives comme la faim et la soif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cda9c6f4-d169-4ecc-8985-4d91c63eccc5",
                                "sense_id": "527d8373-07ca-3222-a03e-81aaa23594ad",
                                "text": "L’épithalamus joue un rôle d'interface entre le système limbique et le reste du cerveau."
                            },
                            {
                                "example_id": "7f993fc1-eba5-4a34-a86d-9e68a10d1fee",
                                "sense_id": "527d8373-07ca-3222-a03e-81aaa23594ad",
                                "text": "L’épithalamus renferme aussi la glande pinéale, ou corps pinéal, qui adopte la forme approximative d’une pomme de pin, d’où elle tire son nom."
                            }
                        ]
                    }
                ],
