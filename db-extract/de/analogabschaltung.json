                        "examples": [
                            {
                                "example_id": "8bbd2fd3-f061-4020-8788-796e12c7c343",
                                "sense_id": "1de922c2-8cfc-3d46-9c2e-473b017c230c",
                                "text": "„Spätestens am 30. April 2012 ist Schluss: Mit der Analogabschaltung ist der Sieg des digitalen Satelliten-Fernsehens besiegelt.“"
                            },
                            {
                                "example_id": "d9f97fc7-2c36-410f-ba97-4afb8f694ff4",
                                "sense_id": "1de922c2-8cfc-3d46-9c2e-473b017c230c",
                                "text": "„Alleine von den Haushalten, die ihre Programme über Satellit empfangen sind derzeit noch ein Viertel analog und damit ca. vier Millionen TV-Haushalte von der Analogabschaltung unmittelbar betroffen.“"
                            },
                            {
                                "example_id": "62f0dfa8-80ae-4c82-b171-9193091ce92c",
                                "sense_id": "1de922c2-8cfc-3d46-9c2e-473b017c230c",
                                "text": "„Astra geht auf Kundenfang: 500 Tage vor der Analogabschaltung will Astra sein Marketing forcieren.“"
                            }
                        ],
