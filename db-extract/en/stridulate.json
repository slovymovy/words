                    }
                ],
                "senses": [
                    {
                        "sense_id": "3454dd6e-7ddc-31c3-80b5-3b97b55c0fc2",
                        "entry_id": "7deb6952-4b50-337d-8c32-5c9e7c1df844",
                        "glosses": [
                            "To make a high-pitched chirping, grating, hissing, or squeaking sound, as male crickets and grasshoppers do, by rubbing certain body parts together."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a82dfcf8-cbb8-4c08-b798-0cb3c5d2f141",
                                "sense_id": "3454dd6e-7ddc-31c3-80b5-3b97b55c0fc2",
                                "text": "A window was open, and the crickets were stridulating at an ominous speed in the black motionless foliage."
                            },
                            {
                                "example_id": "006c7a42-ced0-4a17-9645-7624fca6f6ef",
                                "sense_id": "3454dd6e-7ddc-31c3-80b5-3b97b55c0fc2",
                                "text": "The crickets stridulated their everlasting monotonous meaningful note."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b8081b8-e888-49b0-9385-5d40eca26d54",
                        "source_entry_id": "7deb6952-4b50-337d-8c32-5c9e7c1df844",
                        "source_sense_id": "3454dd6e-7ddc-31c3-80b5-3b97b55c0fc2",
                        "source_sense_description": "to make a noise by rubbing body parts as do crickets",
                        "target_lang_word": "striduler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "striduler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c053ea9f-a09b-3cba-bfa2-58e5d861d988",
                                        "entry_id": "65821a85-4724-3d82-a23e-27e2b5ff3f12",
                                        "glosses": [
                                            "Émettre un son strident et aigu, une stridulation, en frottant certains organes l'un contre l'autre, en parlant de certains arthropodes : insectes tels que le grillon, la sauterelle, le criquet ou arachnides tels que la mygale…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de979bd5-37f5-42f7-aef9-5ff9c3b43e6c",
                                                "sense_id": "c053ea9f-a09b-3cba-bfa2-58e5d861d988",
                                                "text": "L’instituteur Jean-Henry Fabre, dans son harmas de Sérignan-du-Comtat, sa friche, sa « solitude », sous les platanes où stridulent grillons et cigales, comparait le monde des fourmis à la république spartiate de Lycurgue. Il évoquait aussi la « brutale république des guêpes »."
                                            },
                                            {
                                                "example_id": "5f905f84-d5d8-436c-8abf-25f4652b7042",
                                                "sense_id": "c053ea9f-a09b-3cba-bfa2-58e5d861d988",
                                                "text": "Monotone, têtue comme un cœur qui bat, une sauterelle stridulait ; contre le silence infini, sous l’infini du ciel, il semblait que la terre fît écho à cette voix en moi qui sans répit chuchotait : je suis là ; mon cœur oscillait de sa chaleur vivante au feu glacé des étoiles."
                                            },
                                            {
                                                "example_id": "37dc060c-284b-411a-9a51-e6a990c37c5e",
                                                "sense_id": "c053ea9f-a09b-3cba-bfa2-58e5d861d988",
                                                "text": "C'est dehors que je fais un dernier tour sur l'herbe en brosse qui n'a guère remonté depuis la fenaison et où stridulent des centaines de grillons."
                                            },
                                            {
                                                "example_id": "d6763dce-add6-42f2-9851-4ad55ea68863",
                                                "sense_id": "c053ea9f-a09b-3cba-bfa2-58e5d861d988",
                                                "text": "Quelque part, une cigale stridulait éperdument, surprenante en ce mois de l’année."
                                            },
                                            {
                                                "example_id": "9b92fb08-63f6-46f9-b6d5-691df3ae5c9d",
                                                "sense_id": "c053ea9f-a09b-3cba-bfa2-58e5d861d988",
                                                "text": "Les grillons et les sauterelles stridulent en frottant leurs élytres l’un contre l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c6b999-9aff-3675-9843-e8d84491c3e9",
                                        "entry_id": "65821a85-4724-3d82-a23e-27e2b5ff3f12",
                                        "glosses": [
                                            "Faire le bruit d'un insecte qui stridule."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "947c2777-1c7a-4aa8-9189-a2c1be9e3662",
                                                "sense_id": "88c6b999-9aff-3675-9843-e8d84491c3e9",
                                                "text": "La sonnerie des portables stridulait dans le TGV, dans les restaurants, dans les églises et même les monastères bénédictins résistaient mal à la cacophonie ambiante."
                                            },
                                            {
                                                "example_id": "aff00ad9-5138-4171-8eb2-f070871bcf5f",
                                                "sense_id": "88c6b999-9aff-3675-9843-e8d84491c3e9",
                                                "text": "On l’a au fond de soi, le bruit de la roulette ; il fait partie du corps. On fait semblant de l’oublier, mais la cigale est toujours prête à striduler."
                                            },
                                            {
                                                "example_id": "91db0646-fa57-437f-8295-df2953414418",
                                                "sense_id": "88c6b999-9aff-3675-9843-e8d84491c3e9",
                                                "text": "Quand le niveau de l'eau a atteint la taille, plusieurs femmes se sont mises à gémir et d'autres à striduler comme une nuée d'insectes en détresse."
                                            },
                                            {
                                                "example_id": "c0866792-b78c-45f5-b398-0a1d6742b1df",
                                                "sense_id": "88c6b999-9aff-3675-9843-e8d84491c3e9",
                                                "text": "Près du mur une sauterelle se mit à striduler et, tel un fil bleu, une libellule longue et fine passa, flottant sur ses brunes ailes de gaze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
