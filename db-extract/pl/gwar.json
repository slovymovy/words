                    {
                        "sense_id": "b6b580dd-2f29-3cb1-9d3e-6fff6ecfbec4",
                        "entry_id": "e0c2eb96-271b-3c58-96f2-af87e843f315",
                        "glosses": [
                            "hubbub, buzz, bustle"
                        ],
                        "tags": [
