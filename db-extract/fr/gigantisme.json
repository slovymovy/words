        "fr-extract.jsonl": [
            {
                "entry_id": "061ee122-a447-3b8f-afbc-00fe012c3761",
                "word": "gigantisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "366898c0-65b7-47be-9fc9-0ae5cd01a205",
                        "entry_id": "061ee122-a447-3b8f-afbc-00fe012c3761",
                        "tags": [
                            "plural"
                        ],
                        "form": "gigantismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fdc1308-2cc6-3a61-a8c9-09577630d385",
                        "entry_id": "061ee122-a447-3b8f-afbc-00fe012c3761",
                        "glosses": [
                            "Exagération du développement de certaines parties du corps humain ou du corps en général, dans le sens de la hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7786b0c3-1915-4501-8789-559851b05728",
                                "sense_id": "1fdc1308-2cc6-3a61-a8c9-09577630d385",
                                "text": "Né en 1761, Charles Byrne était atteint de gigantisme, en raison d’une tumeur bénigne de l’hypophyse non diagnostiquée."
                            },
                            {
                                "example_id": "9cf1f79d-ff88-4a5e-8303-de5a3d34114a",
                                "sense_id": "1fdc1308-2cc6-3a61-a8c9-09577630d385",
                                "text": "Dans l’acromégalie, comme d’ailleurs dans le gigantisme, maladie qui a tant de points communs avec elle, le trouble de la nutrition qui fait les déformations squelettiques serait le phénomène primitif; la tumeur de l’hypophyse est secondaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8807b20-f34e-32f5-9e8b-e7b4092c276f",
                        "entry_id": "061ee122-a447-3b8f-afbc-00fe012c3761",
                        "glosses": [
                            "Énormité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5b854803-2f34-4ce5-ba5d-89a7e7094a82",
                                "sense_id": "b8807b20-f34e-32f5-9e8b-e7b4092c276f",
                                "text": "Le « Virtuosa » est un vaisseau clinquant, joyeux, coloré, kitch, digne représentant assumé du gigantisme et de tous les superlatifs, devant lequel il est difficile de rester impassible."
                            },
                            {
                                "example_id": "ae2a8ced-6072-4e5c-8227-733bf283cbc8",
                                "sense_id": "b8807b20-f34e-32f5-9e8b-e7b4092c276f",
                                "text": "Affectés par leur gigantisme et par des contestations croissantes au sein des démocraties en raison de leurs coûts prohibitifs, les grands événements sportifs sont plus souvent tombés dans le giron des Etats autoritaires ou illibéraux.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7f20d58-8391-4f83-8c95-e6906dabb572",
                        "source_entry_id": "061ee122-a447-3b8f-afbc-00fe012c3761",
                        "target_lang_word": "Gigantismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gigantismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30babb53-8542-39b6-bf82-c0df709156e3",
                                        "entry_id": "356b2e6a-37b5-3232-9b8b-be329b73b8b8",
                                        "glosses": [
                                            "(krankhaft) gesteigertes Wachstum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37453b14-50e1-40ae-bf5f-165c4602a7c5",
                                                "sense_id": "30babb53-8542-39b6-bf82-c0df709156e3",
                                                "text": "Gigantismus kann durch Tumore und eine Fehlproduktion bestimmter Hormone ausgelöst werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4abb9041-f8e3-3956-b883-c11ce2a172a2",
                                        "entry_id": "356b2e6a-37b5-3232-9b8b-be329b73b8b8",
                                        "glosses": [
                                            "ein Phänomen, bei dem Tiere und Pflanzen über Generationen hinweg signifikant wachsen"
                                        ],
                                        "tags": [
                                            "Evolutionsbiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a666e3e7-6adf-417b-9400-9cfd9319c1e1",
                                                "sense_id": "4abb9041-f8e3-3956-b883-c11ce2a172a2",
                                                "text": "Auf Inseln entwickeln Nagetiere häufig Gigantismus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "734d46f8-28f4-3b27-9fc1-cde807423456",
                                        "entry_id": "356b2e6a-37b5-3232-9b8b-be329b73b8b8",
                                        "glosses": [
                                            "Ausdruck einer Geisteshaltung, die ohne Maß ist und zur Übertreibung neigt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "521e2db8-97e0-4e78-945f-c88f76707c22",
                                                "sense_id": "734d46f8-28f4-3b27-9fc1-cde807423456",
                                                "text": "Der Gigantismus internationaler Sportveranstaltungen stört viele Bürgerinnen und Bürger."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
