                    }
                ],
                "senses": [
                    {
                        "sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                        "entry_id": "ce465b6b-ee39-3de0-b400-eba6744c5a5c",
                        "glosses": [
                            "obojętność wobec spraw religii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c2e85b-eae1-4383-a39a-6324f41107e6",
                                "sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                                "text": "Należy natomiast zająć się socjologią areligijności, wynikającej z przewartościowania znaczenia religii w życiu społecznym"
                            },
                            {
                                "example_id": "7ac74faa-e2f7-4692-8c84-e9c379ec1a63",
                                "sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                                "text": "W badanym środowisku nierzadko spotykamy się ze stosunkiem do spraw religii jako do sfery intymno-prywatnej, stosunkiem przekreślającym związek między religijnością lub areligijnością a poziomem moralnym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f653fc5e-a594-4619-afb0-6cc598e53bd8",
                        "source_entry_id": "ce465b6b-ee39-3de0-b400-eba6744c5a5c",
                        "source_sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                        "target_lang_word": "irreligiosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreligiosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5dc9849-bf55-3c54-9069-b82c52285fae",
                                        "entry_id": "6bf8326e-3e81-3fb6-a74d-7d21a29922da",
                                        "glosses": [
                                            "The quality of being irreligious."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "006979f2-0970-4ce7-a2fa-100001bcf9ba",
                                                "sense_id": "b5dc9849-bf55-3c54-9069-b82c52285fae",
                                                "text": "1584, William Allen, A True, Sincere and Modest Defence of English Catholics, London: The Manresa Press, 1914, Volume 2, Chapter 8, p. 126,\nAnd it is a singular note of irreligiosity in our days, that these profane heretics and godless persons do prefer human things before divine; the regiment temporal before spiritual; the body before the soul; earth before heaven; regality before priesthood; and this life before the next and all eternity."
                                            },
                                            {
                                                "example_id": "89c05eac-57cd-47d1-b4f8-32f8439970f4",
                                                "sense_id": "b5dc9849-bf55-3c54-9069-b82c52285fae",
                                                "text": "1930, William Malisoff, A Calendar of Doubts and Faiths, New York: G. H. Watt, “The Significance of Science,” pp. 277-278,\nThe irreligiosity of much that passes for religion is paralleled, of course, to quite an extent by the unscientific nature of a great deal that passes for science."
                                            },
                                            {
                                                "example_id": "f7aaff36-023a-40b4-af8f-6597919c462a",
                                                "sense_id": "b5dc9849-bf55-3c54-9069-b82c52285fae",
                                                "text": "The Tulsis celebrated Christmas in their store and, with equal irreligiosity, in their home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b93fb7-f817-3125-bd37-7f9188242b91",
                                        "entry_id": "6bf8326e-3e81-3fb6-a74d-7d21a29922da",
                                        "glosses": [
                                            "An impious action or utterance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eac274c-d210-474e-81d3-93755218b8e0",
                                                "sense_id": "e8b93fb7-f817-3125-bd37-7f9188242b91",
                                                "text": "[…] at first, the sudden insertion of scathing irreligiosities into the mouth of such a previously unflappable character seems a merely academic gesture."
                                            },
                                            {
                                                "example_id": "3f8fa6d1-3dca-4599-947a-95b3f45fd272",
                                                "sense_id": "e8b93fb7-f817-3125-bd37-7f9188242b91",
                                                "text": "Majlesi preached and popularized his discourse with the open support of the Shah. In exchange, he turned a blind eye to the personal and private impieties and irreligiosities of the Shah, as long as the Shah continued to officially pay lip service to Shi‘ism and publicly act as its protector and upholder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83bbf3d5-ef22-4e2e-87b8-2597e2435b94",
                        "source_entry_id": "ce465b6b-ee39-3de0-b400-eba6744c5a5c",
                        "source_sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                        "target_lang_word": "irreligion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreligion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "117047fd-e96b-32b7-abad-7f3c7682fe5f",
                                        "entry_id": "78b5be58-d8e8-3c12-ab7f-11f3219a3e4a",
                                        "glosses": [
                                            "The state of being irreligious; irreligious sentiment or thought."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec21001e-0fcb-4cf2-a5f0-d26d7c27267d",
                                                "sense_id": "117047fd-e96b-32b7-abad-7f3c7682fe5f",
                                                "text": "Lucretius' irreligion is too strong, / For early stomachs, to prove wholesome food […]"
                                            },
                                            {
                                                "example_id": "178651ae-819e-4d85-b2b2-3899e4eaf888",
                                                "sense_id": "117047fd-e96b-32b7-abad-7f3c7682fe5f",
                                                "text": "These often slangly letters censure modern irreligion and urge devotion to religion."
                                            },
                                            {
                                                "example_id": "3a9e6db5-55d5-49bc-bed3-f16e0c6befad",
                                                "sense_id": "117047fd-e96b-32b7-abad-7f3c7682fe5f",
                                                "text": "When we put this idea together with that of the other prescription, we see that what the two together demand is that, with respect to their religions and irreligions, all men shall stand before the government as equals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00572d9e-43df-42eb-bcf4-e07995ef84d6",
                        "source_entry_id": "ce465b6b-ee39-3de0-b400-eba6744c5a5c",
                        "source_sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                        "target_lang_word": "irreligiousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreligiousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ddaca36-8779-381c-9159-d6a571d55729",
                                        "entry_id": "0100d8d3-7877-3b23-82ac-f2153926e552",
                                        "glosses": [
                                            "The state or quality of being irreligious; ungodliness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e4e1e4f-7a7c-4775-8db9-8da0f88a318e",
                        "source_entry_id": "ce465b6b-ee39-3de0-b400-eba6744c5a5c",
                        "source_sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                        "target_lang_word": "irréligion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irréligion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
                                        "entry_id": "b1869545-8770-302c-a0dd-1644d20f5bc3",
                                        "glosses": [
                                            "État caractérisé par l'absence de la religion, de l'esprit religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ced7bd-3473-4cba-afc3-95b0f8524f52",
                                                "sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
                                                "text": "On l’accuse d’irréligion."
                                            },
                                            {
                                                "example_id": "3d2d20d0-8802-4c7f-807e-b0d0a98f0bec",
                                                "sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
                                                "text": "La débauche, les mauvaises compagnies l’ont jeté dans l’irréligion."
                                            },
                                            {
                                                "example_id": "d26f0075-1bbd-4471-98d6-3cc0fc423a29",
                                                "sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
                                                "text": "Entretenir l’esprit d’irréligion parmi les masses."
                                            },
                                            {
                                                "example_id": "85a372b2-7cfa-4201-a2d3-3f207649bab1",
                                                "sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
                                                "text": "Certes, les objections contre les dogmes ne m’avaient pas manqué depuis que je lisais au hasard tant de livres dont beaucoup manifestaient la plus audacieuse irréligion, et surtout je m’étais senti attiré vers le scepticisme, comme je vous l’ai dit, parce que je lui trouvais un double caractère de supériorité intellectuelle et de nouveauté sentimentale."
                                            },
                                            {
                                                "example_id": "176adc2a-39e2-4a8a-8ebd-b321a69bc302",
                                                "sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
                                                "text": "De toutes les choses nouvelles qui l’étonnaient dans la maison, celle dont elle restait bouleversée était la brusque irréligion de sa jeune maîtresse."
                                            },
                                            {
                                                "example_id": "996c1fae-729e-45dc-a110-1d9e8d1d60d9",
                                                "sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
                                                "text": "On tenait cependant pour acquis que les traits et le destin de la nationalité, ainsi définis, ne pouvaient se déployer pleinement que dans le cadre rural, à distance des villes, ces foyers d'irréligion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a96eeafa-2643-47c7-b4d1-7015d9452afb",
                        "source_entry_id": "ce465b6b-ee39-3de0-b400-eba6744c5a5c",
                        "source_sense_id": "f63a4445-29e0-33e0-afd2-bcc8b2863199",
                        "target_lang_word": "irreligion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreligion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eacd3c2b-50f7-3df9-a74e-1565be162052",
                                        "entry_id": "a9b9ec88-bf77-38da-b20b-fbab50298da5",
                                        "glosses": [
                                            "Variante de irréligion."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0429e74-fb1f-48c4-ba8b-d8e662e5aad0",
                                                "sense_id": "eacd3c2b-50f7-3df9-a74e-1565be162052",
                                                "text": "[…] les casuistes relâchés croyaient être les meilleurs et les plus utiles défenseurs de l’Église ; ils empêchaient, en effet les chrétiens faibles de tomber dans l’irreligion et les amenaient à pratiquer les sacrements, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
