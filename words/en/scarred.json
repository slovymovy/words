{
    "word_family": [
        "scar",
        "scarring"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2fce2a76-028f-3700-9491-9e2a04b16727",
                    "sense_definition": "Having one or more marks left on the skin after a wound or injury has healed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old soldier had a <w>scarred</w> face from the war.",
                            "target_lang_translations": {
                                "nl": "De oude soldaat had een <w>littekenachtig</w> gezicht door de oorlog.",
                                "cs": "Starý voják měl z války <w>zjizvenou</w> tvář."
                            }
                        },
                        {
                            "text": "Her knee was <w>scarred</w> after she fell off her bicycle.",
                            "target_lang_translations": {
                                "nl": "Haar knie was <w>met littekens bedekt</w> nadat ze van haar fiets was gevallen.",
                                "cs": "Její koleno bylo po pádu z kola <w>zjizvené</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "marked"
                    ],
                    "antonyms": [
                        "unblemished"
                    ],
                    "common_phrases": [
                        "badly scarred",
                        "deeply scarred"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het hebben van een of meer littekens op de huid nadat een wond of letsel is genezen.",
                        "cs": "Mající jednu nebo více jizev na kůži poté, co se rána nebo zranění zahojilo."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "littekenachtig",
                                "target_lang_sense_clarification": "met littekens bedekt"
                            },
                            {
                                "target_lang_word": "met littekens",
                                "target_lang_sense_clarification": "beschrijvend voor een huid of oppervlak"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zjizvený",
                                "target_lang_sense_clarification": "mající jizvy na kůži nebo povrchu"
                            },
                            {
                                "target_lang_word": "s jizvami",
                                "target_lang_sense_clarification": "popisující stav kůže nebo povrchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "850f5e36-9e92-39ef-86b2-6caa0d316e7a",
                    "sense_definition": "Simple past and past participle of <w>scar</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident <w>scarred</w> him for life.",
                            "target_lang_translations": {
                                "nl": "Het ongeluk heeft hem voor het leven <w>littekens bezorgd</w>.",
                                "cs": "Ta nehoda ho na celý život <w>poznamenala</w>."
                            }
                        },
                        {
                            "text": "The fire had <w>scarred</w> the landscape for miles.",
                            "target_lang_translations": {
                                "nl": "De brand had het landschap kilometers lang <w>beschadigd</w>.",
                                "cs": "Požár <w>zjizvil</w> krajinu na míle daleko."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb scar."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van het werkwoord 'littekens achterlaten' of 'beschadigen'.",
                        "cs": "Minulý čas a minulé příčestí slovesa 'zjizvit' nebo 'zanechat jizvu'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "littekens achtergelaten",
                                "target_lang_sense_clarification": "fysieke of emotionele sporen achterlatend"
                            },
                            {
                                "target_lang_word": "beschadigd",
                                "target_lang_sense_clarification": "het achterlaten van een blijvend spoor op een oppervlak"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zjizvil",
                                "target_lang_sense_clarification": "způsobil vznik jizvy"
                            },
                            {
                                "target_lang_word": "poznamenal",
                                "target_lang_sense_clarification": "zanechal trvalé následky (fyzické či psychické)"
                            }
                        ]
                    }
                }
            ]
        }
