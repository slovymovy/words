                        "examples": [
                            {
                                "example_id": "f77101d6-ce99-4454-99ad-6608ec00279a",
                                "sense_id": "d2b9b18d-5ee3-3413-acf0-4156672a547f",
                                "text": "„Das Namenskürzel leitet sich aus dem Englischen ‚Bed and Breakfast‘ ab, insofern ist es eine klare Leistungscharakterisierung, die auf den internaonalen Beherbergungsmärkten allgemein bekannt ist.“"
                            },
                            {
                                "example_id": "bcb736bd-cbbd-4fe5-848b-f5540194a8d1",
                                "sense_id": "d2b9b18d-5ee3-3413-acf0-4156672a547f",
                                "text": "„Dies schreiben wir ans Ende der zweiten Stufe ins Baumdiagramm neben das Namenskürzel des jeweiligen Spielers.“"
                            }
                        ],
