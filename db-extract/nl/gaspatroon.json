                                "example_id": "12ff8ba1-0bd5-44fa-bbdf-c9d2842c9625",
                                "sense_id": "1f5712eb-539b-341c-886c-a877fd7b09a4",
                                "text": "In de auto zijn zeker drie jerrycans en een gaspatroon aangetroffen, en flesjes met aanmaakvloeistof voor de barbecue. De politie onderzoekt of de man brand wilde stichten in het partijkantoor."
                            },
                            {
                                "example_id": "2170a8bb-f50d-44df-8c69-33dfc84e6e82",
                                "sense_id": "1f5712eb-539b-341c-886c-a877fd7b09a4",
                                "text": "Volgens de brandweer is er met opzet pepperspray of iets dergelijks in het klimaatsysteem gespoten. Er is een gaspatroon gevonden die daarop wijst."
                            }
                        ]
                    }
