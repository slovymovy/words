{
    "word_family": [
        "peddle",
        "peddler",
        "peddlery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "752d988e-9195-3cb2-916f-1aebb7cd8bcc",
                    "sense_definition": "present participle and gerund of <w>peddle</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole summer <w>peddling</w> cheap souvenirs to tourists along the beach.",
                            "target_lang_translations": {
                                "nl": "Hij bracht de hele zomer door met het <w>venten van</w> goedkope souvenirs aan toeristen langs het strand."
                            }
                        },
                        {
                            "text": "The newspaper accused the politician of <w>peddling</w> dangerous conspiracy theories.",
                            "target_lang_translations": {
                                "nl": "De krant beschuldigde de politicus van het <w>verspreiden van</w> gevaarlijke complottheorieën."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peddling influence"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het rondventen of verkopen van goederen, of het verspreiden van ideeën of geruchten (onvoltooid deelwoord van peddle)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "venten",
                                "target_lang_sense_clarification": "langs de deuren of op straat verkopen"
                            },
                            {
                                "target_lang_word": "verhandelen",
                                "target_lang_sense_clarification": "verkopen of slijten"
                            },
                            {
                                "target_lang_word": "verspreiden",
                                "target_lang_sense_clarification": "van ideeën, theorieën of geruchten"
                            },
                            {
                                "target_lang_word": "slijten",
                                "target_lang_sense_clarification": "van de hand doen, verpatsen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a2c37f5-d9df-37be-b5ba-6a7f21562dac",
                    "sense_definition": "The act of travelling around selling goods, or spreading ideas or information.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The illicit street <w>peddling</w> of fake designer watches was quickly stopped by the local police.",
                            "target_lang_translations": {
                                "nl": "De illegale <w>straathandel</w> in nagemaakte merkhorloges werd snel stopgezet door de lokale politie."
                            }
                        },
                        {
                            "text": "The continuous <w>peddling</w> of false rumors caused great distress to the whole family.",
                            "target_lang_translations": {
                                "nl": "Het voortdurende <w>verspreiden</w> van valse geruchten bezorgde de hele familie veel verdriet."
                            }
                        }
                    ],
                    "synonyms": [
                        "hawking",
                        "vending"
                    ],
                    "common_phrases": [
                        "street peddling"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het rondreizen om goederen te verkopen (leurhandel), of het verspreiden van ideeën of informatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "venten",
                                "target_lang_sense_clarification": "het verkopen op straat of langs de deuren"
                            },
                            {
                                "target_lang_word": "leurhandel",
                                "target_lang_sense_clarification": "ambulante verkoop van kleine goederen"
                            },
                            {
                                "target_lang_word": "verspreiding",
                                "target_lang_sense_clarification": "het verspreiden van ideeën of geruchten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "69eab108-2920-3a4e-ada0-cbcd701a7e0f",
                    "sense_definition": "Insignificant, petty, or of little value or importance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should not waste our precious time arguing over such <w>peddling</w> concerns.",
                            "target_lang_translations": {
                                "nl": "We moeten onze kostbare tijd niet verspillen aan het ruziën over zulke <w>futiele</w> kwesties."
                            }
                        },
                        {
                            "text": "The manager dismissed the complaint as a merely <w>peddling</w> matter that required no attention.",
                            "target_lang_translations": {
                                "nl": "De manager deed de klacht af als een louter <w>onbeduidende</w> zaak die geen aandacht vereiste."
                            }
                        }
                    ],
                    "synonyms": [
                        "piddling",
                        "petty",
                        "trifling",
                        "trivial"
                    ],
                    "antonyms": [
                        "momentous",
                        "significant"
                    ],
                    "target_lang_definitions": {
                        "nl": "Onbeduidend, futiel of van weinig waarde of belang."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "futiel",
                                "target_lang_sense_clarification": "onbeduidend of nietszeggend"
                            },
                            {
                                "target_lang_word": "onbenullig",
                                "target_lang_sense_clarification": "van heel weinig waarde of betekenis"
                            },
                            {
                                "target_lang_word": "kleinzielig",
                                "target_lang_sense_clarification": "bekrompen of pietluttig"
                            },
                            {
                                "target_lang_word": "onbeduidend",
                                "target_lang_sense_clarification": "niet noemenswaardig"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}