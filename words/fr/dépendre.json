{
    "word_family": [
        "dépendance",
        "dépendant",
        "indépendance",
        "indépendant",
        "interdépendance",
        "interdépendant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8093ecf6-f98c-3718-9cb0-62a292f1e7dc",
                    "sense_definition": "Être conditionné ou déterminé par quelque chose ou par les circonstances.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre départ en vacances <w>dépend</w> du temps qu'il fera demain matin."
                        },
                        {
                            "text": "La réussite de ce projet difficile <w>dépend</w> de votre investissement personnel."
                        }
                    ],
                    "common_phrases": [
                        "ça dépend",
                        "dépendre du temps",
                        "dépendre des circonstances"
                    ]
                },
                {
                    "sense_id": "35a45bff-1b9d-3815-9d7a-32ab36064003",
                    "sense_definition": "Être tributaire de quelqu'un ou d'une aide extérieure pour vivre ou subvenir à ses besoins.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "subordination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup d'étudiants <w>dépendent</w> encore financièrement de leurs parents durant leurs études."
                        },
                        {
                            "text": "Il refuse de <w>dépendre</w> des autres pour accomplir les gestes de la vie quotidienne."
                        }
                    ],
                    "common_phrases": [
                        "dépendre financièrement",
                        "dépendre de quelqu'un"
                    ]
                },
                {
                    "sense_id": "204a66bf-5c10-3c00-b7a7-4aeb00dc9dbc",
                    "sense_definition": "Être au pouvoir ou sous la seule responsabilité de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'issue de cette négociation délicate ne <w>dépend</w> désormais que de son choix."
                        },
                        {
                            "text": "Si cela ne <w>dépendait</w> que de moi, nous accepterions immédiatement cette proposition."
                        }
                    ],
                    "common_phrases": [
                        "ne dépendre que de",
                        "dépendre de soi"
                    ]
                },
                {
                    "sense_id": "f1322663-e82e-3274-a0cb-417164d35fb4",
                    "sense_definition": "Être rattaché administrativement, hiérarchiquement ou géographiquement à une entité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rattachement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite école rurale <w>dépend</w> directement de l'académie de la région voisine."
                        },
                        {
                            "text": "Le nouveau laboratoire de recherche <w>dépend</w> du ministère de l'Enseignement supérieur."
                        }
                    ],
                    "synonyms": [
                        "relever"
                    ],
                    "common_phrases": [
                        "dépendre d'un ministère",
                        "dépendre d'une juridiction"
                    ]
                },
                {
                    "sense_id": "5d41baa8-0250-3cab-a3d0-b033554b3257",
                    "sense_definition": "Décrocher ou ôter une chose de l'endroit où elle était suspendue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decrocher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>dépendre</w> les rideaux du salon avant de repeindre entièrement les murs."
                        },
                        {
                            "text": "Le conservateur a fait <w>dépendre</w> ce tableau précieux pour procéder à sa restauration."
                        }
                    ],
                    "synonyms": [
                        "décrocher",
                        "détacher"
                    ],
                    "antonyms": [
                        "accrocher",
                        "pendre",
                        "suspendre"
                    ],
                    "common_phrases": [
                        "dépendre un tableau"
                    ]
                }
            ]
        }
    ]
}