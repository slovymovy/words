        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8fe5ca74-f038-3259-9e43-c07148d33852",
                    "sense_definition": "Of, relating to, or made from sterling silver (an alloy containing 92.5% silver).",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "silver_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique spoon is made of <w>sterling</w> silver.",
                            "target_lang_translations": {
                                "ru": "Эта антикварная ложка сделана из <w>стерлингового</w> серебра.",
                                "zh": "这把古董勺子是由<w>标准纯银</w>制成的。"
                            }
                        },
                        {
                            "text": "She received a pair of <w>sterling</w> earrings for her birthday.",
                            "target_lang_translations": {
                                "ru": "На день рождения она получила пару серег из <w>стерлингового</w> серебра.",
                                "zh": "她生日时收到了一副<w>标准纯银</w>耳环。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sterling silver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к стерлинговому серебру или сделанный из него (сплав, содержащий 92,5% серебра).",
                        "zh": "指代标准纯银（含92.5%银的合金）或由其制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стерлинговый",
                                "target_lang_sense_clarification": "о серебре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标准纯银",
                                "target_lang_sense_clarification": "指代材质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dfbdf5f-3de4-3905-bbf7-9c298f5f0832",
                    "sense_definition": "Of or relating to the official currency of the United Kingdom.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank account is denominated in <w>sterling</w> currency.",
