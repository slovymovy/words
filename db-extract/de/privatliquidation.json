                            {
                                "example_id": "d679f8c1-056b-4492-a1cf-6530a8f1be16",
                                "sense_id": "0fd851c8-6d06-3a1b-8307-81b22968093f",
                                "text": "„In der Regel muss der Chefarzt dem Krankenhaus einen Teil (2011: 20 %) der Privatliquidationen abtreten.“"
                            },
