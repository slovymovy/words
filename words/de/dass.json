{
    "word_family": [
        "sodass"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "558c708c-5994-39b1-8e41-74d6f5058ede",
                    "sense_definition": "Leitet einen Nebensatz ein, der als Subjekt oder Objekt den Inhalt des Hauptsatzes wiedergibt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "inhaltssatz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe gehört, <w>dass</w> du eine neue Arbeitsstelle in Berlin gefunden hast."
                        },
                        {
                            "text": "Es freut mich sehr, <w>dass</w> ihr uns heute so zahlreich besuchen kommt."
                        }
                    ],
                    "common_phrases": [
                        "schön dass",
                        "gut dass"
                    ]
                },
                {
                    "sense_id": "37254043-b899-3052-a9bd-1a27241ef84e",
                    "sense_definition": "Leitet einen Folgesatz ein, der die Wirkung oder Folge eines Geschehens angibt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "konsekutiv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Vortrag war so spannend, <w>dass</w> alle Teilnehmenden bis zum Schluss aufmerksam zuhörten."
                        },
                        {
                            "text": "Es regnete den ganzen Tag so stark, <w>dass</w> die Straßen vollkommen überflutet waren."
                        }
                    ],
                    "synonyms": [
                        "sodass"
                    ],
                    "common_phrases": [
                        "so dass",
                        "derart dass"
                    ]
                },
                {
                    "sense_id": "b396be08-7c33-3d31-b899-ab8a43a75850",
                    "sense_definition": "Drückt in Verbindung mit Präpositionen wie „ohne“ das Fehlen eines Begleitumstandes aus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "modaler_nebensatz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er verließ den Raum ganz leise, ohne <w>dass</w> jemand von den Kollegen es bemerkte."
                        },
                        {
                            "text": "Sie löste das schwierige Problem allein, ohne <w>dass</w> sie um Unterstützung bitten musste."
                        }
                    ],
                    "common_phrases": [
                        "ohne dass"
                    ]
                },
                {
                    "sense_id": "20d7fb15-c08b-306b-80ab-dbf32d3e33c6",
                    "sense_definition": "Leitet einen Nebensatz ein, der eine Absicht, einen Zweck oder ein Ziel angibt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "final",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beeil dich ein wenig, <w>dass</w> wir den nächsten Zug noch rechtzeitig erreichen."
                        },
                        {
                            "text": "Sprich bitte etwas lauter, <w>dass</w> dich auch die Personen in der letzten Reihe verstehen."
                        }
                    ],
                    "synonyms": [
                        "damit"
                    ],
                    "common_phrases": [
                        "auf dass"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "häufig durch „damit“ ersetzt"
                        }
                    ]
                }
            ]
        }
    ]
}