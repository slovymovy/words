{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8762fd1-ada2-359e-98e8-23e284b8fb40",
                    "sense_definition": "A flying insect with a long thin body and four large, often brightly coloured wings.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The colorful <w>butterfly</w> landed gently on the flower.",
                            "target_lang_translations": {
                                "ru": "Разноцветная <w>бабочка</w> мягко опустилась на цветок.",
                                "zh": "那只色彩斑斓的<w>蝴蝶</w>轻轻地落在了花朵上。"
                            }
                        },
                        {
                            "text": "We watched a <w>butterfly</w> flying across the garden.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за <w>бабочкой</w>, летящей через сад.",
                                "zh": "我们看着一只<w>蝴蝶</w>飞过了花园。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "monarch butterfly",
                        "butterfly wings",
                        "catch a butterfly",
                        "butterfly net"
                    ],
                    "target_lang_definitions": {
                        "ru": "Летающее насекомое с длинным тонким телом и четырьмя большими, часто ярко окрашенными крыльями.",
                        "zh": "一种飞行昆虫，身体细长，有四片通常色彩鲜艳的翅膀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабочка",
                                "target_lang_sense_clarification": "насекомое"
                            },
                            {
                                "target_lang_word": "мотылёк",
                                "target_lang_sense_clarification": "небольшая бабочка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蝴蝶",
                                "target_lang_sense_clarification": "昆虫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "770aaadd-4bbc-36d9-b280-48a976cc78e7",
                    "sense_definition": "A swimming stroke in which both arms move forward together over the water while the legs move up and down.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She learned to swim the <w>butterfly</w> at a young age.",
                            "target_lang_translations": {
                                "ru": "Она научилась плавать <w>баттерфляем</w> в раннем возрасте.",
                                "zh": "她很小的时候就学会了<w>蝶泳</w>。"
                            }
                        },
                        {
                            "text": "The <w>butterfly</w> is often considered the most difficult stroke to master.",
                            "target_lang_translations": {
                                "ru": "<w>Баттерфляй</w> часто считается самым сложным для освоения стилем плавания.",
                                "zh": "<w>蝶泳</w>通常被认为是最难掌握的游泳姿势。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swim the butterfly",
                        "butterfly stroke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль плавания, при котором обе руки одновременно движутся вперед над водой, а ноги совершают волнообразные движения вверх и вниз.",
                        "zh": "一种游泳姿势，双臂同时向前划水，双腿上下摆动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баттерфляй",
                                "target_lang_sense_clarification": "стиль плавания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蝶泳",
                                "target_lang_sense_clarification": "游泳姿势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "007c3183-2f82-3eed-a280-18a1756005d5",
                    "sense_definition": "A feeling of nervous excitement or anxiety, usually felt in the stomach.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always get <w>butterflies</w> before speaking in public.",
                            "target_lang_translations": {
                                "ru": "У меня всегда <w>мандраж</w> перед выступлением на публике.",
                                "zh": "每次公开演讲前，我总是<w>心里七上八下</w>的。"
                            }
                        },
                        {
                            "text": "He had <w>butterflies</w> in his stomach while waiting for the results.",
                            "target_lang_translations": {
                                "ru": "У него были <w>бабочки</w> в животе, пока он ждал результатов.",
                                "zh": "等待结果时，他感到<w>心里七上八下</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have butterflies",
                        "get butterflies",
                        "butterflies in my stomach"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic usage, typically plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство нервного возбуждения или беспокойства, обычно ощущаемое в животе.",
                        "zh": "一种紧张或焦虑的感觉，通常在胃部产生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мандраж",
                                "target_lang_sense_clarification": "разг. сильное волнение"
                            },
                            {
                                "target_lang_word": "бабочки",
                                "target_lang_sense_clarification": "в идиоме \"бабочки в животе\""
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心里七上八下",
                                "target_lang_sense_clarification": "形容紧张不安"
                            },
                            {
                                "target_lang_word": "紧张",
                                "target_lang_sense_clarification": "焦虑感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7f9148d-c8d8-3d6d-8c0e-121bdda78d81",
                    "sense_definition": "A person who is not serious, or who frequently changes interests, social activities, or partners.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a real social <w>butterfly</w> and loves attending every party in town.",
                            "target_lang_translations": {
                                "ru": "Она настоящая <w>светская львица</w> и обожает посещать все вечеринки в городе.",
                                "zh": "她是个真正的<w>社交达人</w>，喜欢参加城里的每一场派对。"
                            }
                        },
                        {
                            "text": "He was something of a <w>butterfly</w>, never staying with one hobby for very long.",
                            "target_lang_translations": {
                                "ru": "Он был своего рода <w>мотыльком</w>, никогда не задерживаясь на одном хобби надолго.",
                                "zh": "他是个<w>轻浮的人</w>，从来没能长期坚持过任何一种爱好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "social butterfly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который несерьезен или часто меняет интересы, общественную деятельность или партнеров.",
                        "zh": "指不严肃、经常改变兴趣、社交活动或伴侣的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотылёк",
                                "target_lang_sense_clarification": "перен. легкомысленный человек"
                            },
                            {
                                "target_lang_word": "ветреный человек",
                                "target_lang_sense_clarification": "ненадежный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社交达人",
                                "target_lang_sense_clarification": "指善于交际的人"
                            },
                            {
                                "target_lang_word": "轻浮的人",
                                "target_lang_sense_clarification": "指不专一或不严肃的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f01f41c-16aa-3e62-b88c-dae83145c22d",
                    "sense_definition": "A thin strip of adhesive tape used to close a wound or cut.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse applied a <w>butterfly</w> to the small cut on his forehead.",
                            "target_lang_translations": {
                                "ru": "Медсестра наложила <w>пластырь-бабочку</w> на небольшой порез на его лбу.",
                                "zh": "护士在他的额头小伤口上贴了一个<w>蝴蝶贴</w>。"
                            }
                        },
                        {
                            "text": "You can use a <w>butterfly</w> to hold the edges of the wound together.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать <w>пластырь-бабочку</w>, чтобы стянуть края раны.",
                                "zh": "你可以用<w>蝴蝶贴</w>把伤口的边缘固定在一起。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "butterfly stitch",
                        "butterfly bandage",
                        "butterfly strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая полоска лейкопластыря, используемая для стягивания краев раны или пореза.",
                        "zh": "一种用于闭合伤口或切口的细胶带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластырь-бабочка",
                                "target_lang_sense_clarification": "медицинский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蝴蝶贴",
                                "target_lang_sense_clarification": "医用胶带"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98ec9ef6-9926-3982-9aa2-af489f0adf52",
                    "sense_definition": "To cut meat or fish almost completely in half and spread it flat, resembling the wings of a butterfly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "6",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>butterfly</w> the chicken breast so it cooks more evenly.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>разрезать бабочкой</w> куриную грудку, чтобы она прожарилась более равномерно.",
                                "zh": "你应该把鸡胸肉<w>蝴蝶切</w>开，这样受热更均匀。"
                            }
                        },
                        {
                            "text": "The chef showed us how to <w>butterfly</w> a shrimp for grilling.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар показал нам, как <w>разделать бабочкой</w> креветку для гриля.",
                                "zh": "厨师向我们展示了如何将虾<w>蝴蝶切</w>开以便烧烤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "butterfly the chicken",
                        "butterflied shrimp",
                        "butterfly a steak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрезать мясо или рыбу почти полностью пополам и развернуть плоско, напоминая крылья бабочки.",
                        "zh": "将肉或鱼几乎完全切开并摊平，使其形状像蝴蝶的翅膀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрезать бабочкой",
                                "target_lang_sense_clarification": "кулинарный прием"
                            },
                            {
                                "target_lang_word": "разделать как бабочку",
                                "target_lang_sense_clarification": "кулинария"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蝴蝶切",
                                "target_lang_sense_clarification": "烹饪刀法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}