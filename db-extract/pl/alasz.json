                                    {
                                        "sense_id": "3eff793a-b54b-3085-a8db-afe2896959ef",
                                        "entry_id": "7145799c-e4ff-3d7e-8537-13cab354df32",
                                        "glosses": [
                                            "A German caraway liqueur."
                                        ],
