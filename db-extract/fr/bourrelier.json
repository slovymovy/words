        "fr-extract.jsonl": [
            {
                "entry_id": "e4ca9f70-c21e-3c46-b8b0-44c435fc7108",
                "word": "bourrelier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fddc9fc7-9176-4581-ab29-8286d50dac8b",
                        "entry_id": "e4ca9f70-c21e-3c46-b8b0-44c435fc7108",
                        "tags": [
