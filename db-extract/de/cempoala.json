                        "glosses": [
                            "mesoamerikanische Stadt am Golf von Mexiko, heute eine archäologische Stätte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed08722-9cbe-4e3f-8fc3-30916e1a1f8f",
                                "sense_id": "79d79199-62ec-3d37-b022-ea8eee6bb9d8",
                                "text": "„Von diesem Mikropatriotismus erfuhr Cortés bereits in Cempoala, also kurz nach seiner Ankunft an der Küste.“"
                            },
                            {
                                "example_id": "42e0abdb-df20-4e9d-97f8-5d25d85b2db3",
                                "sense_id": "79d79199-62ec-3d37-b022-ea8eee6bb9d8",
                                "text": "„Nach dem Abzug von Moteuczomas Untertanen bekamen die Spanier Besuch von einer Abordnung des Totonaken-Herrschers von Cempoala, Chicomecatl, den sie später den ‹dicken Kaziken› nennen sollten.“"
                            }
                        ],
