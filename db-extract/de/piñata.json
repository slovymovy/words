                        "sense_id": "a3b71f0e-3085-3634-a605-2f790b6aa22e",
                        "entry_id": "fade7a8d-bbd1-3646-85bb-d5be5549f2de",
                        "glosses": [
                            "mit Süßigkeiten oder Früchten gefüllte, bunt gestaltete Figur, die bei Kindergeburtstagsfeiern zerschlagen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a84145-0ebc-4e24-8b77-c6c48aab39f0",
                                "sense_id": "a3b71f0e-3085-3634-a605-2f790b6aa22e",
                                "text": "„Die Leckereien stecken in einer sogenannten Piñata, einer Figur aus Pappmaschee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b539462-d686-430c-a795-bbccb03fe8c7",
                        "source_entry_id": "fade7a8d-bbd1-3646-85bb-d5be5549f2de",
                        "source_sense_id": "a3b71f0e-3085-3634-a605-2f790b6aa22e",
                        "target_lang_word": "piñata",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piñata",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e17f201-7eac-3b80-afcd-6f94892a3860",
                                        "entry_id": "a24e0c5f-2352-3236-a86f-dee1b2a325ec",
                                        "glosses": [
                                            "A doll or other decorated container that is filled with candy and hit with a hammer or a stick by blindfolded children during birthday parties or other celebrations until the candy falls out."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7538a3c0-2618-3407-b191-90bea1676418",
                                        "entry_id": "a24e0c5f-2352-3236-a86f-dee1b2a325ec",
                                        "glosses": [
                                            "Something which is repeatedly hit or damaged over a period of time."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84800ea0-df84-42e2-8aa2-6911a4a93e34",
                                                "sense_id": "7538a3c0-2618-3407-b191-90bea1676418",
                                                "text": "[…] Wiesbaden, largely crippled, nevertheless refuses to sink for the moment, and will become something of a steel piñata for passing British capital ships over the next few hours whilst throwing the odd torpedo back in retaliation."
                                            },
                                            {
                                                "example_id": "45b2ed45-15aa-4076-b114-57be05cf559e",
                                                "sense_id": "7538a3c0-2618-3407-b191-90bea1676418",
                                                "text": "When it opened, it prompted rapturous reviews akin to what, many years later, greeted Frank Gehry’s Guggenheim Bilbao. But the building soon became a piñata for everything wrong with modern architecture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piñata",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a59a42ca-1cc2-3309-8ec6-232658a167c9",
                                        "entry_id": "777fb9eb-47ea-34ef-bebc-a979dacc88b6",
                                        "glosses": [
                                            "To hit something or someone with sticks after having filled them with candy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0ece47-0d74-4ace-adcd-a574255b92ce",
                                                "sense_id": "a59a42ca-1cc2-3309-8ec6-232658a167c9",
                                                "text": "2015 (November 20) \"Zombie Broheims\", episode 14 of Pig Goat Banana Cricket\nCricket: \"Don't pinata me!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc3bf0ed-2d24-45f1-a7a1-d1cdd2720286",
