                "senses": [
                    {
                        "sense_id": "adfcf31c-93f7-3ff5-a7f3-c33643e70efe",
                        "entry_id": "54d3a7e1-2eb9-3333-9b73-df197f51b823",
                        "glosses": [
                            "Marsupial arboricole d’Océanie du genre zoologique Phalanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6778549-f08a-4472-bb03-230968757a63",
                                "sense_id": "adfcf31c-93f7-3ff5-a7f3-c33643e70efe",
                                "text": "Un discours préliminaire sur l’ensemble de ce que les Européens ont visité dans la Nouvelle-Hollande, et sur les lois de balancement des êtres variés qui y ont été découverts, formera le début du second volume, et précédera l’histoire des animaux marsupiaux ; animaux que Buffon, à l’exception des sarigues, d’un phalanger, et d’un kangourou, a entièrement ignorés."
                            }
                        ]
                    },
                    {
                        "sense_id": "0eee7d79-1824-30fe-a45c-27da5db5b5b5",
                        "entry_id": "54d3a7e1-2eb9-3333-9b73-df197f51b823",
                        "glosses": [
                            "Animal autrefois classé dans ce groupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0ff34b-0d82-4bdd-b1a2-e26f5366833f",
                                "sense_id": "0eee7d79-1824-30fe-a45c-27da5db5b5b5",
                                "text": "Le phalanger volant (Petaurus breviceps (wikispecies)) est un petit opossum planeur originaire d’Australie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
