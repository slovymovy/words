                "senses": [
                    {
                        "sense_id": "e5cfb940-5f4a-3ed8-9d03-275b624f6fd5",
                        "entry_id": "45c00706-3d3d-3e93-9928-999d22494177",
                        "glosses": [
                            "turmartige Vorrichtung, auf der die seiltragenden und seilführenden Bauteile zur Führung und Stützung der Seile einer Luftseilbahn befestigt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b0a3a8e-0355-4e7c-96b5-f6d1aa3d1f7f",
                                "sense_id": "e5cfb940-5f4a-3ed8-9d03-275b624f6fd5",
                                "text": "„Als der Weg an den Resten einer alten Seilbahnstütze vorbeiführt, macht Orfer daran regionale Geschichte fest: Mittels Seilbahn sei die in Grillenberg abgebaute Braunkohle früher in die Krupp'sche Metallfabrik in Berndorf transportiert worden.“"
                            },
                            {
                                "example_id": "dcf647fb-6166-4761-a3d0-a02255cb1406",
                                "sense_id": "e5cfb940-5f4a-3ed8-9d03-275b624f6fd5",
                                "text": "„Das Lawinenunglück im Januar beschädigte neben dem Hotel auch eine Seilbahnstütze.“"
                            },
                            {
                                "example_id": "7248c4b0-5716-49e8-96cd-8c5ff2301287",
                                "sense_id": "e5cfb940-5f4a-3ed8-9d03-275b624f6fd5",
                                "text": "„Eine von insgesamt 32 Gondeln der Kölner Seilbahn hat sich am Sonntagnachmittag an einer Seilbahnstütze verkeilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
