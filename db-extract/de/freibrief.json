                    }
                ],
                "senses": [
                    {
                        "sense_id": "05738640-6215-37fc-ae9f-bfd19f6bd6e9",
                        "entry_id": "8215715d-a96c-35b1-9c8d-348ee70da45f",
                        "glosses": [
                            "Urkunde über eine Erlaubnis; über eine Befreiung von einem Verbot; oder über die Entlassung aus der Leibeigenschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f40133f-86f9-4caa-99f1-cf88af2ab68c",
                                "sense_id": "05738640-6215-37fc-ae9f-bfd19f6bd6e9",
                                "text": "Trotz Hunger im Land erteilte der König dem Handelsmann einen Freibrief zur Ausfuhr von Lebensmitteln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "30474beb-d501-375e-8dc0-42024596d3e9",
                        "entry_id": "8215715d-a96c-35b1-9c8d-348ee70da45f",
                        "glosses": [
                            "die Erlaubnis für etwas üblicherweise Unerlaubtes"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ee09424a-1b14-4ca0-a575-c113b1591fa0",
                                "sense_id": "30474beb-d501-375e-8dc0-42024596d3e9",
                                "text": "„Die Nichtöffentlichkeit von Gerichtsverfahren ist \"für viele Richter und Anwälte ein Freibrief, schalten und walten zu können, wie es ihnen passt\".“"
                            },
                            {
                                "example_id": "656d3609-940e-4f3d-b7c5-c4d40f854d72",
                                "sense_id": "30474beb-d501-375e-8dc0-42024596d3e9",
                                "text": "„Deutsche Offiziere schärften ihren Untergebenen ein, es müssten »Boxernester ausgeräuchert« werden – ein Freibrief für Terror gegen die Bevölkerung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc94ea37-1d2a-4f69-8857-8013f442fa76",
                        "source_entry_id": "8215715d-a96c-35b1-9c8d-348ee70da45f",
                        "source_sense_id": "05738640-6215-37fc-ae9f-bfd19f6bd6e9",
                        "target_lang_word": "licence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "licence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12183672-ab3c-320e-ab4c-d3816c056274",
                                        "entry_id": "87f9253b-faa4-3be2-9358-cfb519907270",
                                        "glosses": [
                                            "UK, Canada, Australia, South Africa, Ireland, New Zealand, Malaysia, and Singapore standard spelling of license."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a756a83a-9b9b-454a-95e8-87d71cc51f68",
                                                "sense_id": "12183672-ab3c-320e-ab4c-d3816c056274",
                                                "text": "In some areas they have attempted to decasualize certain types of employment and to control street-trading by a local licensing system requiring juveniles to obtain their licences through the committees."
                                            },
                                            {
                                                "example_id": "72a2dd98-5748-4e21-825a-e08e91bda8d0",
                                                "sense_id": "12183672-ab3c-320e-ab4c-d3816c056274",
                                                "text": "Serlio criticises the artistic licence taken by both ancient and contemporary architects, here specifically related to the confusion created by the rich decoration of the arch–in his illustrations, he stripped the monument of most of its beautifully […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "licence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d7de8e1-50bc-3acb-ba4c-19b4e1b76a27",
                                        "entry_id": "840f5c8b-a5d4-37de-92eb-edad81ab2253",
                                        "glosses": [
                                            "Misspelling of license."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "South-Africa",
                                            "UK",
                                            "alt-of",
                                            "misspelling",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00d8ef8a-1ac6-4d1e-aea9-e2588303aa3b",
                        "source_entry_id": "8215715d-a96c-35b1-9c8d-348ee70da45f",
                        "source_sense_id": "30474beb-d501-375e-8dc0-42024596d3e9",
                        "source_sense_description": "umgangssprachlich: die Erlaubnis für etwas üblicherweise Unerlaubtes",
                        "target_lang_word": "carte blanche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carte blanche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bfaa7f0-a2ed-327f-9184-2e47a33d74b5",
                                        "entry_id": "e11f1c61-7caa-3e00-ada6-783a10d9244b",
                                        "glosses": [
                                            "Unlimited discretionary power to act; unrestricted authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d32dc0-d4aa-44ff-8fca-db20cdef4cf6",
                                                "sense_id": "9bfaa7f0-a2ed-327f-9184-2e47a33d74b5",
                                                "text": "“[…] But since when did army officers afford the luxury of amanuenses in this simple republic ?[…]Does your carte blanche run so far as that also ?”"
                                            },
                                            {
                                                "example_id": "d6d11d06-d9c4-418e-8f74-77fc38728f67",
                                                "sense_id": "9bfaa7f0-a2ed-327f-9184-2e47a33d74b5",
                                                "text": "We have given technology carte blanche, much in the way Congress has always, in the past, given automatic approval to defense budgets, resulting in the most gigantic graft in history."
                                            },
                                            {
                                                "example_id": "3544c46d-0a57-4a14-b1b6-2a51cf1b00ea",
                                                "sense_id": "9bfaa7f0-a2ed-327f-9184-2e47a33d74b5",
                                                "text": "Baron Cohen and director Larry Charles have indeed retreated with The Dictator, but they’ve gone back 80 years, when the Marx Brothers were given carte blanche at Paramount Pictures with a five-movie run that ended with their best movie, 1933’s Duck Soup."
                                            },
                                            {
                                                "example_id": "0f63edb1-2078-4d82-a42e-9078abe2418b",
                                                "sense_id": "9bfaa7f0-a2ed-327f-9184-2e47a33d74b5",
                                                "text": "Somewhat unsurprisingly, unleashing the most powerful navy on the planet with carte blanche to exterminate slavers on sight saw a dramatic and sudden collapse in slaver numbers in the late 1840s and early 1850s."
                                            },
                                            {
                                                "example_id": "6f29c66c-cb91-4965-816f-86d82649fdfc",
                                                "sense_id": "9bfaa7f0-a2ed-327f-9184-2e47a33d74b5",
                                                "text": "That’s especially the case since the Supreme Court issued a ruling last year that provides a former president with immunity from criminal prosecution for all “official acts” taken while in office. Trump and MAGA world interpret this, and not without cause, as giving them carte blanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e68bbcd-5f30-32c5-91f1-e70b3f565697",
                                        "entry_id": "e11f1c61-7caa-3e00-ada6-783a10d9244b",
                                        "glosses": [
                                            "A blank paper that is signed by some authority and given to a person to fill as they please."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c3e0e50-0b7a-412a-81dd-eb9d7a1b0955",
                                                "sense_id": "6e68bbcd-5f30-32c5-91f1-e70b3f565697",
                                                "text": "2001, Oliver Sacks, Uncle Tungsten: Memories of a Chemical Boyhood, Alfred A. Knopf (2001), 15,\nIndeed, I later learned that when they had bought the place, in 1930, they had given my father's older sister Lina their checkbook, carte blanche, saying, \"Do what you want, get what you want.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139385be-c7c8-3bec-9d86-9b2f5a0661d8",
                                        "entry_id": "e11f1c61-7caa-3e00-ada6-783a10d9244b",
                                        "glosses": [
                                            "A hand with no court cards."
