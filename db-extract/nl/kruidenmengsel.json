                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61660c1d-c664-3623-8ce7-6c93564a0100",
                                        "entry_id": "836a682d-90a3-3831-a598-daa9321225b8",
                                        "glosses": [
                                            "An alcoholic intoxication."
                                        ],
                                        "tags": [
