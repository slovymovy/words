                "senses": [
                    {
                        "sense_id": "454f1a30-80cd-30db-9ea0-d28f3cfdaeef",
                        "entry_id": "4260cb1a-17ee-350a-95b7-13a36a2a7cd6",
                        "glosses": [
                            "a female given name, equivalent to English Gerda"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a41d15b-7fea-418a-8c36-46f29da6e8d9",
                                "sense_id": "454f1a30-80cd-30db-9ea0-d28f3cfdaeef",
                                "text": "Ско́ро бу́ду я с тобо́й, зна́ю,\n На твои́х глаза́х та́ю,\n Я уйду́ с грозо́й, с поры́вом ветра́\n Ты меня́ найди́, Ге́рда!",
                                "translation": "I'll be with you soon, I know,\n I melt before your eyes,\n I will leave with a thunderstorm, with a gust of wind\n Find me, Gerda!",
                                "english": "I'll be with you soon, I know,\n I melt before your eyes,\n I will leave with a thunderstorm, with a gust of wind\n Find me, Gerda!"
                            }
                        ]
                    }
                ],
