                        "sense_id": "bb038490-4932-365b-a56d-38896f42c30a",
                        "entry_id": "02f60323-1e94-3d89-9ddb-fcb45dc536a9",
                        "glosses": [
                            "Gerät/Werkzeug, mit dem man Druck auf ein Material ausübt, um es zu pressen, meist Tabak in eine Pfeife"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eff13fb-e312-43c5-a3b9-5dcd15c955d1",
                                "sense_id": "bb038490-4932-365b-a56d-38896f42c30a",
                                "text": "Der Stopfer liegt neben dem Humidor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cc786238-b694-3614-b3a3-657634c836f2",
                        "entry_id": "02f60323-1e94-3d89-9ddb-fcb45dc536a9",
                        "glosses": [
                            "Stöpsel/Korken als Verschluss einer Flasche"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "966f7d28-40ae-4d19-b0cb-025393984183",
                                "sense_id": "cc786238-b694-3614-b3a3-657634c836f2",
                                "text": "Die Flasche wird mit einem frischen Stopfer verkorkt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "467c89fb-2d5d-36c1-a7d9-61abe67e6d37",
                        "entry_id": "02f60323-1e94-3d89-9ddb-fcb45dc536a9",
                        "glosses": [
                            "mit Garn/Wolle geflickte Stelle in der Kleidung"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "47a9d890-c23d-437f-abbb-d4621272a4ce",
                                "sense_id": "467c89fb-2d5d-36c1-a7d9-61abe67e6d37",
                                "text": "Dieser Stopfer in der Socke ist mir richtig gut gelungen, die Wollfäden verlaufen alle im rechten Winkel zueinander."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "40dea3b2-cf49-38c5-8b69-d50fefc874fa",
                        "entry_id": "02f60323-1e94-3d89-9ddb-fcb45dc536a9",
                        "glosses": [
                            "eine Person, die Kleidung flickt (stopft)"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "9d9c9b1f-3c11-45db-a7ee-c58d3aec2d2a",
                                "sense_id": "40dea3b2-cf49-38c5-8b69-d50fefc874fa",
                                "text": "Die Arbeiten der Schneider, Näher, Stopfer, Stricker und Putzmacher sind erstklassige Handanfertigungen."
                            }
