                                    {
                                        "sense_id": "47d6d265-b46e-3b4c-83db-87b7cb87b438",
                                        "entry_id": "f9af8850-6196-306d-8753-a19664b2c1f5",
                                        "glosses": [
                                            "Wucherung, Sprossung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a05592-61ca-40ed-95a4-b03fe116df41",
                                                "sense_id": "47d6d265-b46e-3b4c-83db-87b7cb87b438",
                                                "text": "Man muss das Geschwür an der Proliferation hindern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "603fe90b-fc34-37b1-9209-be0e61adeb34",
                                        "entry_id": "f9af8850-6196-306d-8753-a19664b2c1f5",
                                        "glosses": [
                                            "die Weiterverbreitung von Massenvernichtungswaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ddec3be-291f-4cf6-b1d7-be9435948f3c",
                                                "sense_id": "603fe90b-fc34-37b1-9209-be0e61adeb34",
                                                "text": "Der Atomwaffensperrvertrag verbietet die Proliferation von Nuklearwaffen."
                                            },
                                            {
                                                "example_id": "0538fe5a-5f90-402c-9ed5-730e7c38ea7f",
                                                "sense_id": "603fe90b-fc34-37b1-9209-be0e61adeb34",
                                                "text": "„Quellen der Proliferation sind häufig unzureichende nationale Exportkontrollen oder staatliche Akteure, die gezielt mit profilerationsrelevanten Gütern handeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed2715b-0d6d-4ac1-83ca-298f6a3f061d",
