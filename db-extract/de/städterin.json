                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e770cb-8232-4cb9-9ff0-089cbbc06ae5",
                                "sense_id": "9c5f0f11-f071-3183-ada6-25b86fdbf46e",
                                "text": "„Singend zogen sie umher und fanden ihre Lust vorzüglich darin, den schönen Städterinnen, welche nach dortiger Mode eine Art überbreiter Hüte trugen und damit umherspazierten, unter diese Hüte zu gucken, um des Anblicks ihrer Gesichter teilhaftig zu werden, was sonst unmöglich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
