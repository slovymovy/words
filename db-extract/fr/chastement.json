        "fr-extract.jsonl": [
            {
                "entry_id": "a9633f6e-02ed-3352-bfa2-044de1c8657c",
                "word": "chastement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5fe5da33-8500-3e12-ac53-d2d9388f4dc5",
                        "entry_id": "a9633f6e-02ed-3352-bfa2-044de1c8657c",
                        "glosses": [
                            "D’une manière chaste, avec chasteté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14a660b6-116f-48b6-884e-472ec435c14e",
                                "sense_id": "5fe5da33-8500-3e12-ac53-d2d9388f4dc5",
                                "text": "L’amour le moins honnête, exprimé chastement, N’excite point en nous de honteux mouvement."
                            },
                            {
                                "example_id": "3a20c740-deb9-4cf6-92b3-4002bb21363e",
                                "sense_id": "5fe5da33-8500-3e12-ac53-d2d9388f4dc5",
                                "text": "Sa robe de voyage, en stoff assez commun, à corsage fait chastement en guimpe, ornée d’une collerette à mille plis, allait lui paraître horrible à l’aspect des fraîches toilettes de Béatrix et de Camille."
                            },
                            {
                                "example_id": "b3b63515-47bc-4613-bc78-1603ffea9ad2",
                                "sense_id": "5fe5da33-8500-3e12-ac53-d2d9388f4dc5",
                                "text": "Ses grands yeux noirs couronnés de sourcils […], étaient voilés par de longs cils de velours qui en cachaient chastement l’éclat, …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adf298e5-723a-4c80-ad81-ac5a9eea2086",
                        "source_entry_id": "a9633f6e-02ed-3352-bfa2-044de1c8657c",
                        "source_sense_id": "5fe5da33-8500-3e12-ac53-d2d9388f4dc5",
                        "target_lang_word": "chastely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chastely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f584f863-d56a-33e8-875b-a36e1e36ca62",
                                        "entry_id": "00574a4a-1d1a-3713-b806-d337a5b238bd",
                                        "glosses": [
                                            "In a chaste manner. (either specifically virginal, or in a modest, unsexy and unrisqué manner)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b65fe802-3a68-47d5-85ab-017c6476041c",
                                                "sense_id": "f584f863-d56a-33e8-875b-a36e1e36ca62",
                                                "text": "Let lasses of a silly mind / Refuse what maist they're wanting / Since we for yielding were designed / We chastely should be granting."
                                            },
                                            {
                                                "example_id": "aed47485-8dec-4a64-be63-f3b196204ffe",
                                                "sense_id": "f584f863-d56a-33e8-875b-a36e1e36ca62",
                                                "text": "In holy orders no one is better loved than he who lives chastely, because chastity is the first principle for any cleric as well as the foundation of his life."
                                            },
                                            {
                                                "example_id": "5efc3549-8197-43cd-91b1-4d31e4ec3557",
                                                "sense_id": "f584f863-d56a-33e8-875b-a36e1e36ca62",
                                                "text": "Of the group, Max (Room’s Jacob Tremblay) is the most nominally mature, at least biologically speaking; unlike his childhood companions, he’s entered the early throes of puberty, and spends a lot of his waking hours pining, rather chastely, for a classmate (Millie Davis)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
