                "senses": [
                    {
                        "sense_id": "95d26125-7e01-3193-9800-15cb48537b33",
                        "entry_id": "45478208-c289-3ac5-b21e-04c86e93987c",
                        "glosses": [
                            "Bereiche in der Luft, dem Wasser und in der Erde, die nachlässig mit Müll verschmutzt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e8c09dd-ab55-45e6-a450-f287ca9b9cd0",
                                "sense_id": "95d26125-7e01-3193-9800-15cb48537b33",
                                "text": "„Greenpeace-Gruppen in 28 deutschen Städten zwischen Kiel und Friedrichshafen informieren heute über die globale Bedrohung der Meere durch Müllverschmutzung.“"
                            },
                            {
                                "example_id": "6ff9b06d-cf41-4f98-af31-e58cd6724b2d",
                                "sense_id": "95d26125-7e01-3193-9800-15cb48537b33",
                                "text": "„Bei Kleinstlebewesen wie Plankton nimmt die Bedrohung durch die Müllverschmutzung ihren Anfang: Plankton baut selbst kleinste Plastikpartikel in die Zellen ein.“"
                            },
                            {
                                "example_id": "3da45a16-edd2-4714-85e4-7720088354a3",
                                "sense_id": "95d26125-7e01-3193-9800-15cb48537b33",
                                "text": "„Er reist um die ganze Welt, zu wunderschönen Orten, die leider unter der Müllverschmutzung leiden.“"
                            },
                            {
                                "example_id": "f44f1bc0-4cf3-4baa-8f98-6a21db8950f2",
                                "sense_id": "95d26125-7e01-3193-9800-15cb48537b33",
                                "text": "„Zigarillos, Zigaretten und auch der Pfeifentabak sind der Grund für die enorme Luft – und Müllverschmutzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
