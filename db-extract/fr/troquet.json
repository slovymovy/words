        "fr-extract.jsonl": [
            {
                "entry_id": "176eb4cf-f5af-3a80-ac3f-d709674d0f77",
                "word": "troquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f29087a9-5cdb-40af-83db-35510f4007e9",
                        "entry_id": "176eb4cf-f5af-3a80-ac3f-d709674d0f77",
                        "tags": [
                            "plural"
                        ],
                        "form": "troquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3dfa2081-64fe-3dde-87a1-01dd58f8f199",
                        "entry_id": "176eb4cf-f5af-3a80-ac3f-d709674d0f77",
                        "glosses": [
                            "Débit de boissons."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7a18b5a0-2880-40d3-b603-c9564ab9cb46",
                                "sense_id": "3dfa2081-64fe-3dde-87a1-01dd58f8f199",
                                "text": "Le vers, très simple, violent ou joyeux, était en définitive l’unique langage qui convînt au peuple. La prose ne plaisait qu’aux gens d’une intelligence très subtile. Il avait fréquenté les anarchistes chez les troquets de la rue Saint-Jacques. Ils passaient leur soirée à dire et à écouter des romances."
                            },
                            {
                                "example_id": "489f210d-b4f1-42b2-86bf-f5bde7fb8e47",
                                "sense_id": "3dfa2081-64fe-3dde-87a1-01dd58f8f199",
                                "text": "Le soir, ils allèrent tous les six, de troquet en troquet, modulant leur chanson nouvelle."
                            },
                            {
                                "example_id": "a3e06b41-9da6-4ecd-b7ca-be417b63d143",
                                "sense_id": "3dfa2081-64fe-3dde-87a1-01dd58f8f199",
                                "text": "J’entre dans le premier troquet venu, et je suis à peine assis que je commence déjà à draguer la serveuse"
                            },
                            {
                                "example_id": "e8336804-d0e4-4815-a901-73debf79cc53",
                                "sense_id": "3dfa2081-64fe-3dde-87a1-01dd58f8f199",
                                "text": "Tout part à vau-l’eau : l’excommunication est devenue moins importante qu’une partie de baby-foot, le mariage et le baptême ne sont plus salutaires qu’aux marchands de dragées, les enterrements sont une annexe du troquet, même le latin ne les impressionne plus !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef27b3a-c7df-434d-a8b8-f3c5b2efc35f",
                        "source_entry_id": "176eb4cf-f5af-3a80-ac3f-d709674d0f77",
                        "source_sense_id": "3dfa2081-64fe-3dde-87a1-01dd58f8f199",
                        "source_sense_description": "Débit de boissons.",
                        "target_lang_word": "Kneipe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kneipe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb841c36-a66b-3c6b-a8eb-bc22fb8e8257",
                                        "entry_id": "a0027823-29bd-3151-b06f-94689543d487",
                                        "glosses": [
                                            "einfache, schlichte Schankwirtschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56575011-a646-4e32-8152-ae9c88465cf9",
                                                "sense_id": "bb841c36-a66b-3c6b-a8eb-bc22fb8e8257",
                                                "text": "Wir treffen uns in der Kneipe und trinken Bier."
                                            },
                                            {
                                                "example_id": "3472b505-0d7f-497c-9f98-4aded289fbe2",
                                                "sense_id": "bb841c36-a66b-3c6b-a8eb-bc22fb8e8257",
                                                "text": "„Die Kneipe war inzwischen voll geworden.“"
                                            },
                                            {
                                                "example_id": "1a8ed9dd-6e20-416a-a537-85da3aac65de",
                                                "sense_id": "bb841c36-a66b-3c6b-a8eb-bc22fb8e8257",
                                                "text": "„Mit dieser bunten Schar, die am 30. November in Tampa-Town landete und mit ihrem Sprachgewirr die Straßen und Kneipen des Städtchens füllte, kamen auch schon die ersten Neugierigen.“"
                                            },
                                            {
                                                "example_id": "d8d1c244-a184-4a78-9ea9-32e3bce71464",
                                                "sense_id": "bb841c36-a66b-3c6b-a8eb-bc22fb8e8257",
                                                "text": "„Immer mehr Kneipen hatten nachts auf.“"
                                            },
                                            {
                                                "example_id": "65b82783-bf36-4957-a6ba-8c62af632c2a",
                                                "sense_id": "bb841c36-a66b-3c6b-a8eb-bc22fb8e8257",
                                                "text": "„Vormittags darauf erwartet er Lina in der Kneipe, wie immer, die Zeitschriften hat er bei sich.“"
                                            },
                                            {
                                                "example_id": "243337ee-7033-4948-adc1-bd6fa6d7d770",
                                                "sense_id": "bb841c36-a66b-3c6b-a8eb-bc22fb8e8257",
                                                "text": "„In einer Kneipe allein am Tisch zusitzen war ein zweifelhaftes Vergnügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38c26ac1-f0cd-38a5-ae68-7e4a9582cac4",
                                        "entry_id": "a0027823-29bd-3151-b06f-94689543d487",
                                        "glosses": [
                                            "verbindungsstudentische Veranstaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "816141c0-f25b-4acf-9a90-e7df94db324a",
                                                "sense_id": "38c26ac1-f0cd-38a5-ae68-7e4a9582cac4",
                                                "text": "Bei Studentenverbindungen bezeichnet der Begriff Kneipe eine traditionelle Feier die nach bestimmten (Kneip- Comment ) und in Voll couleur gestaltet wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
