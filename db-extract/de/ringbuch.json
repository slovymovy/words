                "senses": [
                    {
                        "sense_id": "efeef574-5bf9-3e0e-84cd-f046ae6ac402",
                        "entry_id": "75475b6d-f212-362f-b1bc-0c29c94f9e8f",
                        "glosses": [
                            "fester/biegbarer Einband mit mehreren Ringen, in die entsprechend gelochte Papierblätter eingehängt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "681e5091-cd26-4797-9b62-2bbb48323cc0",
                                "sense_id": "efeef574-5bf9-3e0e-84cd-f046ae6ac402",
                                "text": "Ein Ringbuch erweist sich als praktisch, wenn man einzelne Blätter einfügen oder herausnehmen will."
                            },
                            {
                                "example_id": "ea566a23-fa2d-460f-ab5e-21b4a81f1d27",
                                "sense_id": "efeef574-5bf9-3e0e-84cd-f046ae6ac402",
                                "text": "„Renates neues Ringbuch hatte einen Schlüssel zum Abschließen.“"
                            },
                            {
                                "example_id": "96c5d007-1b40-4d16-8795-300a13ec49ef",
                                "sense_id": "efeef574-5bf9-3e0e-84cd-f046ae6ac402",
                                "text": "„Es war ein einfaches Blatt Papier ohne Umschlag, A 5, hellgrün, hastig aus einem Ringbuch gerissen.“"
                            },
                            {
                                "example_id": "40ee1485-9ddc-4a0a-9108-540d70cceae5",
                                "sense_id": "efeef574-5bf9-3e0e-84cd-f046ae6ac402",
                                "text": "„Auch er sieht zur Uhr, klappt sein Ringbuch zu und steht eilig auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
