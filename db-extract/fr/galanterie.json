        "fr-extract.jsonl": [
            {
                "entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                "word": "galanterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "744b39de-7c83-4828-a2f5-0a801cd36cbd",
                        "entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                        "tags": [
                            "plural"
                        ],
                        "form": "galanteries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cc29c27-6663-3d74-b639-f537620a38c5",
                        "entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                        "glosses": [
                            "Qualité de celui qui est galant ; agrément, politesse dans l’esprit et dans les manières."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fe487924-a40f-4c35-bdb2-79ef3209269e",
                                "sense_id": "3cc29c27-6663-3d74-b639-f537620a38c5",
                                "text": "Allons, messire templier, les lois de la galanterie sont libéralement interprétées en Palestine, et, en cette occasion, je ne veux rien confier à votre conscience."
                            },
                            {
                                "example_id": "7b0b71b0-d595-433e-a4de-934edf6056bc",
                                "sense_id": "3cc29c27-6663-3d74-b639-f537620a38c5",
                                "text": "« Surtout, mon oncle, n’allez pas dormir, dit-elle à demi-voix au vieux seigneur qui aussitôt écarquilla les yeux et se redressa sur son siège, cela ne serait pas aimable pour moi, et contraire aux lois de l’ancienne galanterie que vous vantez toujours."
                            },
                            {
                                "example_id": "eaec636e-879e-412b-bbef-20a5275680f9",
                                "sense_id": "3cc29c27-6663-3d74-b639-f537620a38c5",
                                "text": "Sans doute les gamins qu’il évangélisait n’usaient pas toujours entre eux et avec leurs camarades des villages voisins d’une politesse et d’une mansuétude qui rappelaient la vieille galanterie française et la charité chrétienne, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a72c2b1-a6d8-31cd-a7f5-bac044219b73",
                        "entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                        "glosses": [
                            "Ensemble des égards, des soins, des empressements pour les femmes qu’inspire l’envie de leur plaire."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf7737a-da7c-425c-ab2b-71c619f2fa4f",
                                "sense_id": "9a72c2b1-a6d8-31cd-a7f5-bac044219b73",
                                "text": "Les militaires de ce tyran impérial sont tous de vilains ignorants. Ils prennent la brutalité pour de la galanterie, ils ne connaissent pas plus les femmes qu'ils ne savent aimer ; […]."
                            },
                            {
                                "example_id": "4f122793-6b8f-46d9-8715-2284f5919553",
                                "sense_id": "9a72c2b1-a6d8-31cd-a7f5-bac044219b73",
                                "text": "Partout enfin on reconnaîtra ce respect de la vierge et de l'amante, sous la forme à la fois pompeuse et discrète, ardente et chaste, qui est restée celle de nos mœurs françaises et que nous appelons d'un mot inconnu des anciens : la galanterie."
                            }
                        ]
                    },
                    {
                        "sense_id": "10f83bc8-9cfe-3927-9564-bde179295d4a",
                        "entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                        "glosses": [
                            "Propos flatteurs qu’un homme tient à une femme, procédé qu’on emploie pour lui plaire, cadeau ingénieusement choisi, attention délicate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5c6cebb-f4f4-46ff-bbf1-bb98be52b910",
                                "sense_id": "10f83bc8-9cfe-3927-9564-bde179295d4a",
                                "text": "Dire des galanteries."
                            },
                            {
                                "example_id": "c405a38a-ecc9-4c2b-87d5-b520c99e115f",
                                "sense_id": "10f83bc8-9cfe-3927-9564-bde179295d4a",
                                "text": "Cette galanterie a paru lui plaire."
                            },
                            {
                                "example_id": "19bbc666-8b3c-4d39-b432-f46ac7623476",
                                "sense_id": "10f83bc8-9cfe-3927-9564-bde179295d4a",
                                "text": "La Guirlande de Julie est une galanterie demeurée célèbre."
                            }
                        ]
                    },
                    {
                        "sense_id": "603984d3-a037-3dd6-ad36-98888c47bba1",
                        "entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                        "glosses": [
                            "Commerce amoureux extraconjugal."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d5a5870f-38f8-4f0c-96c9-51487ed2bfe7",
                                "sense_id": "603984d3-a037-3dd6-ad36-98888c47bba1",
                                "text": "Cette femme a une galanterie avec un tel."
                            },
                            {
                                "example_id": "b959bf0f-603a-453f-a33c-17700c9328e4",
                                "sense_id": "603984d3-a037-3dd6-ad36-98888c47bba1",
                                "text": "On peut trouver des femmes qui n’ont jamais eu de galanterie ; mais il est rare d’en trouver qui n’en aient jamais eu qu’une […]"
                            },
                            {
                                "example_id": "539b5b02-b608-4970-83f3-3c422f060f87",
                                "sense_id": "603984d3-a037-3dd6-ad36-98888c47bba1",
                                "text": "Pour compléter ce bonheur, il avait été aimé par madame Donis, et cela juste au moment où il lui devenait assez difficile de continuer à éblouir de son luxe et de sa générosité les vieilles cocottes parisiennes, en déplacement de galanterie dans les villes d’eaux du Midi."
                            },
                            {
                                "example_id": "743f584c-7395-4b02-800f-c9cb18377bf4",
                                "sense_id": "603984d3-a037-3dd6-ad36-98888c47bba1",
                                "text": "Ce lieu sue la bêtise, pue la canaillerie et la galanterie de bazar. Mâles et femelles s’y valent."
                            },
                            {
                                "example_id": "d0f20f29-d693-4fc7-b958-582766a1b6ae",
                                "sense_id": "603984d3-a037-3dd6-ad36-98888c47bba1",
                                "text": "Il parvint à saisir qu’elles étaient loin d’être adonnées à la galanterie : devaient-elles s’y mettre, comme certaines, qu’elles n’enviaient pas ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e57e6ef9-3b9b-4254-a226-75cbef62b2eb",
                        "source_entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                        "source_sense_description": "Courtoisie envers les femmes",
                        "target_lang_word": "Galanterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galanterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                        "entry_id": "d55c646b-f9fa-3abb-a826-c561b73a5094",
                                        "glosses": [
                                            "ausgesprochen höfliches, zuvorkommendes Verhalten gegenüber Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c0b80e-3a3a-43b1-8326-419ab2202b70",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Es wäre nun vielleicht an der Zeit, daß Sie sich die Folgen Ihrer Galanterie gegen diese Dame klarmachen.“"
                                            },
                                            {
                                                "example_id": "1cbba07e-409f-4b00-bb54-31f62fb159af",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Ein solcher Ton der Galanterie herrschte in Granada, als ich die ersten Schritte in der Gesellschaft tat; doch ich verfiel nicht dieser Mode.“"
                                            },
                                            {
                                                "example_id": "4261c0a7-7cb5-4d62-bf5d-4a9e83b29ded",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Er tat ausgesprochen höflich und gebärdete sich wie im Caféhaus, glich ihre flach intonierte Schroffheit durch gestelzte Galanterie aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54799d23-6a27-3312-99dc-a69975434c7b",
                                        "entry_id": "d55c646b-f9fa-3abb-a826-c561b73a5094",
                                        "glosses": [
                                            "schmeichelndes, verbindliches Kompliment gegenüber Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef32b20-06a4-40c0-9964-41e6e7847fd8",
                                                "sense_id": "54799d23-6a27-3312-99dc-a69975434c7b",
                                                "text": "„Statt mir Handschuhe zu kaufen, beschloß ich, mich zu rächen, indem ich ihr aus dem Weg ging und sie der abgeschmackten Galanterie Sanzonios überließ, der angefaulte Zähne, eine blonde Perücke, eine unreine Haut und einen übelriechenden Atem hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a14fcba-11af-426b-937d-7d678408428b",
                        "source_entry_id": "15da9c25-17b6-3c92-bfa3-f1f26a795893",
                        "source_sense_description": "Courtoisie envers les femmes",
                        "target_lang_word": "gallantry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallantry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f76b34e2-0433-3698-a67b-280117042b89",
                                        "entry_id": "1b40c56b-e09c-323a-af40-3193ad338fa5",
                                        "glosses": [
                                            "courage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08efb479-8207-482a-b874-4d11e037ebbf",
                                                "sense_id": "f76b34e2-0433-3698-a67b-280117042b89",
                                                "text": "1926, P. G. Wodehouse, 'Lord Emsworth and the Girl Friend', Penguin, Harmondsworth: 1992, p 98.\n'I have the greatest respect for the young lady to whom you refer. She behaved on a certain recent occasion - on two recent occasions - with notable gallantry and resource, and I won't have her bally-ragged.'"
                                            },
                                            {
                                                "example_id": "ad0a7d2e-e5d6-4574-8a39-891626fab994",
                                                "sense_id": "f76b34e2-0433-3698-a67b-280117042b89",
                                                "text": "Our men have fought with grim gallantry. The soldiers of the Republic of Korea have also been fighting fiercely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb47b3ba-f86e-39c1-8633-679470de7261",
                                        "entry_id": "1b40c56b-e09c-323a-af40-3193ad338fa5",
                                        "glosses": [
                                            "chivalrous courtliness, especially towards women."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39478f7e-e378-4ea9-b84d-b97a09ab3491",
                                                "sense_id": "cb47b3ba-f86e-39c1-8633-679470de7261",
                                                "text": "Of the three things that startle us in the feasts of nobles, there is not one here; no swords, no duels, no tables reeking blood. No faithless gallantries here bring dishonour on some intimate friend."
                                            },
                                            {
                                                "example_id": "422c33f4-2d31-46e4-aac9-920b3358aec9",
                                                "sense_id": "cb47b3ba-f86e-39c1-8633-679470de7261",
                                                "text": "The Queen of Sheba has responded to Solomon's gallantry and accepted his one God . She is one who is ready to be guided . Her heart is open . The second part of the testing , the riddles , seem to be a more personal and human exchange ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e8c10f3-3769-3392-8e46-d77d9b6bf6cb",
                                        "entry_id": "1b40c56b-e09c-323a-af40-3193ad338fa5",
                                        "glosses": [
                                            "an instance of gallant behaviour or speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
