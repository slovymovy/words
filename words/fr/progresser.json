                {
                    "sense_id": "2d86565e-d6fc-3405-8d7a-86bac2a4cd3c",
                    "sense_definition": "Augmenter en intensité, en nombre ou en valeur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accroissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les exportations de la région continuent de <w>progresser</w> de façon régulière.",
                            "target_lang_translations": {
                                "en": "The region's exports continue to <w>increase</w> steadily.",
                                "ru": "Экспорт из региона продолжает стабильно <w>расти</w>.",
                                "de": "Die Exporte der Region <w>steigen</w> weiterhin stetig.",
                                "es": "Las exportaciones de la región siguen <w>aumentando</w> de forma regular.",
                                "zh": "该地区的出口继续稳步<w>增长</w>。"
                            }
                        },
                        {
                            "text": "Le nombre d'adhérents à cette association a fortement <w>progressé</w> cette année.",
                            "target_lang_translations": {
                                "en": "The number of members of this association has <w>increased</w> sharply this year.",
                                "ru": "В этом году число членов этой ассоциации резко <w>возросло</w>.",
                                "de": "Die Zahl der Mitglieder dieses Vereins ist in diesem Jahr stark <w>gestiegen</w>.",
                                "es": "El número de socios de esta asociación ha <w>aumentado</w> notablemente este año.",
                                "zh": "今年，该协会的会员人数大幅<w>增加</w>。"
                            }
                        }
                    ],
                    "synonyms": [
