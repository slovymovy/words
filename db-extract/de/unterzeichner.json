                ],
                "senses": [
                    {
                        "sense_id": "290f5c45-e5f4-368a-83b5-638215073ad6",
                        "entry_id": "c8927060-2230-39c2-bc0e-e1b680fe0b71",
                        "glosses": [
                            "(männliche^☆) Person, die ein Dokument mit ihrer Unterschrift bestätigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc5e131-9210-430a-8ec4-3933e84bc7b6",
                                "sense_id": "290f5c45-e5f4-368a-83b5-638215073ad6",
                                "text": "„Die Unterzeichner stoßen sich daran, dass solche Apps nicht nur nicht deinstallierbar sind, sondern gleichzeitig auch besondere Rechte haben.“"
                            },
                            {
                                "example_id": "5ec56335-e939-4b9b-aac6-a4ce5d0a3a09",
                                "sense_id": "290f5c45-e5f4-368a-83b5-638215073ad6",
                                "text": "„Zu den mehr als 110 Unterzeichnern gehören die frühere Bundesbeauftragte für die Stasi-Unterlagen, Marianne Birthler, der Schauspieler Jan Josef Liefers und der frühere Bundestagspräsident Wolfgang Thierse (SPD).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2e1467-6331-4867-b32b-774ed812ee13",
                        "source_entry_id": "c8927060-2230-39c2-bc0e-e1b680fe0b71",
                        "source_sense_id": "290f5c45-e5f4-368a-83b5-638215073ad6",
                        "source_sense_description": "Person, die ein Dokument mit ihrer Unterschrift bestätigt",
                        "target_lang_word": "signatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b29f5751-bcbf-39f7-ae4a-e5b95a735403",
                                        "entry_id": "c3133624-a1b6-3a52-b570-20f341125108",
                                        "glosses": [
                                            "One who signs or has signed something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a7d44c-2721-407a-9c28-71373ef20b1e",
                                                "sense_id": "b29f5751-bcbf-39f7-ae4a-e5b95a735403",
                                                "text": "John Hancock is famous for being the first signatory to the American Declaration of Independence, and for writing his name large."
                                            },
                                            {
                                                "example_id": "70db8c6d-6924-4a20-be39-8a123b3da456",
                                                "sense_id": "b29f5751-bcbf-39f7-ae4a-e5b95a735403",
                                                "text": "[...] it is reported that signatories of a petition for retention of service include the Home Secretary, Mr. R. A. Butler, who resides in the neighbourhood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "signatory",
                                "target_lang_code": "en",
