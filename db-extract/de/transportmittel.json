                "senses": [
                    {
                        "sense_id": "f21248b3-039f-3e64-83ca-8577914e036e",
                        "entry_id": "ee7c847c-01b8-3462-b1ea-0e1cd44348e0",
                        "glosses": [
                            "natürliche oder technische Einrichtung, die der Beförderung (= Transport) von Gütern oder Personen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624ccb1c-2480-4f6f-bc88-c3bb6cd63f92",
                                "sense_id": "f21248b3-039f-3e64-83ca-8577914e036e",
                                "text": "In manchen Städten hat die Tram den Status des bloßen Transportmittels bereits überwunden."
                            },
                            {
                                "example_id": "2209216b-8dcc-4db3-a5ce-fe92ce594bba",
                                "sense_id": "f21248b3-039f-3e64-83ca-8577914e036e",
                                "text": "„Eigentlich waren die Tramsportmittel entscheidend.“"
                            },
                            {
                                "example_id": "cd543717-3ed9-46ab-8838-d6fd993063e0",
                                "sense_id": "f21248b3-039f-3e64-83ca-8577914e036e",
                                "text": "„Mit diesem Transportmittel katapultierte ich mich an die Spitze der Ferienbewegung.“"
                            },
                            {
                                "example_id": "b8692f1f-3e7c-4fd9-973c-f980c2817016",
                                "sense_id": "f21248b3-039f-3e64-83ca-8577914e036e",
                                "text": "„Heute leben Rachel, Simon und ihr gemeinsamer Sohn Patrick friedlich in Rachels Heimatstadt Nantes, und das Transportmittel der Familie ist – wie kann es anders sein – ein Motorrad mit Beiwagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
