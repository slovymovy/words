                ],
                "senses": [
                    {
                        "sense_id": "753de456-2f80-38f7-afa1-e5ca975a3d2f",
                        "entry_id": "3f79b5d1-f400-371c-ab70-21e5c85ee5e6",
                        "glosses": [
                            "bei der Verarbeitung übrigbleibendes Kunststoffmaterial sowie nach der Benutzung nicht mehr benötigte Gegenstände aus Kunststoff"
                        ],
                        "tags": [
                            "Privathaushalt",
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "7f584840-74be-40af-b84f-650c1ee1eb43",
                                "sense_id": "753de456-2f80-38f7-afa1-e5ca975a3d2f",
                                "text": "„Die Abfallwirtschaft verwertet die gesammelten Kunststoffabfälle nahezu vollständig. Im Jahr 2013 hat sie 42 Prozent aller gesammelten Kunststoffabfälle werkstofflich recycelt. 57 Prozent der Abfälle wurden in Müllverbrennungsanlagen oder Ersatzbrennstoffkraftwerken energetisch verwertet. Aus Klima- und Umweltschutzsicht ist es wichtig, mehr Kunststoffabfälle werkstofflich zu verwerten.“"
                            },
                            {
                                "example_id": "faa0814d-60f8-40c4-ab92-9f4751cd9774",
                                "sense_id": "753de456-2f80-38f7-afa1-e5ca975a3d2f",
                                "text": "„Die Ergebnisse vom Atlantik stützen sich laut Law auf die bisher längsten und umfangreichsten Nachforschungen von Kunststoffabfällen in einem Weltmeer.“"
                            },
                            {
                                "example_id": "5476d763-41bb-45ec-8dd2-7960d92d9e73",
                                "sense_id": "753de456-2f80-38f7-afa1-e5ca975a3d2f",
                                "text": "„Gerade in den letzten Jahren ist der Kunststoffverbrauch explosionsartig angestiegen, so fielen 1994 allein in der Bundesrepublik Deutschland 36 Millionen Tonnen Müll an – davon waren 5 Prozent, also 1,8 Millionen Tonnen, Kunststoffabfälle!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
