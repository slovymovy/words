                ],
                "senses": [
                    {
                        "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                        "entry_id": "1dff8937-4070-3cb2-94ad-821aef85edd7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96ff749-ca49-4156-a547-913bc1df2c83",
                                "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                                "text": "Frau Stable ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9aa8c135-7162-4811-9a29-f043b3632c20",
                                "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                                "text": "Herr Stable wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "133d0a25-f44b-4867-b3df-a3f2c3197215",
                                "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                                "text": "Die Stables fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6fcc0a4a-3e6d-458e-ba4e-d3b1f53fbca9",
                                "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                                "text": "Der Stable trägt nie die Schals, die die Stable ihm strickt."
                            },
                            {
                                "example_id": "6a853333-1b6b-40b6-ba18-85c1c294212f",
                                "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stable kommt, geht der Herr Stable.“"
                            },
                            {
                                "example_id": "9d3e29b9-7a9d-40f1-80c1-7385374fa37a",
                                "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                                "text": "Stable kommt und geht."
                            },
                            {
                                "example_id": "416d87fd-dc2a-4471-b01d-84d22c3e9473",
                                "sense_id": "57ee0651-38f4-348f-ae25-9865b78b7244",
                                "text": "Stables kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
