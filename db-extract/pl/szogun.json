                "senses": [
                    {
                        "sense_id": "e0852dd4-07e7-3d5a-8424-a1d50588098b",
                        "entry_id": "ac3ea94e-1fa2-3967-b7c9-9da426427f39",
                        "glosses": [
                            "japoński wódz naczelny, generał, zwierzchnik sił zbrojnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc2d9a7-5dfa-4144-8305-88f29e5d8d8e",
                                "sense_id": "e0852dd4-07e7-3d5a-8424-a1d50588098b",
                                "text": "Szoguni w tamtych czasach sprawowali faktyczną władzę w Japonii. Cesarz nie miał już władzy, a funkcja ta stała się czysto reprezentacyjna"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "278aea95-8e44-443a-a07a-36bd1f513592",
                        "source_entry_id": "ac3ea94e-1fa2-3967-b7c9-9da426427f39",
                        "source_sense_id": "e0852dd4-07e7-3d5a-8424-a1d50588098b",
                        "target_lang_word": "shogun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shogun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "609392e2-f73a-3313-b844-147ce99e452a",
                                        "entry_id": "099bf479-e0f1-3261-9e0c-726056835868",
                                        "glosses": [
                                            "The supreme generalissimo of feudal Japan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e78931d-7b1b-4304-9be5-0e8f8c3d9aca",
                                                "sense_id": "609392e2-f73a-3313-b844-147ce99e452a",
                                                "text": "The third is the Shogun who reygneth at the preſent, and hath rayſed the perſecution (whereof this booke intreateth) againſt the Chriſtians, and he as it ſeemeth is acknowledged as Lord of all the threeſcore and ſix Kingdomes of Iaponia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08d5ea46-0e3b-4e64-9127-e7438d46d840",
                        "source_entry_id": "ac3ea94e-1fa2-3967-b7c9-9da426427f39",
                        "source_sense_id": "e0852dd4-07e7-3d5a-8424-a1d50588098b",
                        "target_lang_word": "šógun",
