                                        "sense_id": "76d6a2af-3918-3811-afe0-b9465f8fbe7a",
                                        "entry_id": "1a65f533-e733-3914-a6ef-b000d5f72bed",
                                        "glosses": [
                                            "Trouble qui associe des idées obsédantes (obsessions) et/ou des actes répétitifs (compulsions)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67eca22-4805-4f59-8f92-20ff00ee0382",
                                                "sense_id": "76d6a2af-3918-3811-afe0-b9465f8fbe7a",
                                                "text": "Cette peur d'être contaminé par des microbes s'appelle la germophobie (quand il s'agit de la saleté en général, c'est la mysophobie) et peut tourner au trouble obsessionnel compulsif."
                                            },
                                            {
                                                "example_id": "a8d5eff3-bfec-4e36-9361-40e50685931d",
                                                "sense_id": "76d6a2af-3918-3811-afe0-b9465f8fbe7a",
                                                "text": "Certains psychiatres les rapprochent des gens qui ont des troubles obsessionnels compulsifs (TOC)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
