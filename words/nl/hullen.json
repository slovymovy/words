{
    "word_family": [
        "omhullen",
        "verhullen",
        "hulsel",
        "onthullen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b285234a-c3d4-3225-9d50-d6dd0a5c4d4e",
                    "sense_definition": "zich kleden in iets of iets bedekken met een kledingstuk of stof",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning liet zich <w>hullen</w> in een prachtige mantel van zijde.",
                            "target_lang_translations": {
                                "en": "The king had himself <w>shrouded</w> in a beautiful silk cloak."
                            }
                        },
                        {
                            "text": "Zij was <w>gehuld</w> in een lange zwarte jurk voor de begrafenis.",
                            "target_lang_translations": {
                                "en": "She was <w>clad</w> in a long black dress for the funeral."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleden",
                        "steken"
                    ],
                    "antonyms": [
                        "ontbloten"
                    ],
                    "common_phrases": [
                        "gehuld in"
                    ],
                    "target_lang_definitions": {
                        "en": "To dress oneself in something or to cover something with a garment or fabric"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shroud",
                                "target_lang_sense_clarification": "to cover or envelop in a garment or cloth"
                            },
                            {
                                "target_lang_word": "clothe",
                                "target_lang_sense_clarification": "to dress or cover with clothing"
                            },
                            {
                                "target_lang_word": "drape",
                                "target_lang_sense_clarification": "to cover loosely with cloth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0c58119-1d11-300d-a4f4-c787d5829808",
                    "sense_definition": "zich figuurlijk ergens in verbergen of ergens door omgeven worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbergen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte weigerde te praten en <w>hulde</w> zich in stilzwijgen.",
                            "target_lang_translations": {
                                "en": "The suspect refused to speak and <w>shrouded</w> himself in silence."
                            }
                        },
                        {
                            "text": "De bergen waren die ochtend volledig <w>gehuld</w> in een dichte mist.",
                            "target_lang_translations": {
                                "en": "The mountains were completely <w>shrouded</w> in a thick mist that morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "verhullen",
                        "omhullen"
                    ],
                    "antonyms": [
                        "onthullen"
                    ],
                    "common_phrases": [
                        "zich in stilzwijgen hullen",
                        "in nevelen gehuld"
                    ],
                    "target_lang_definitions": {
                        "en": "To figuratively hide oneself in something or to be surrounded by something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shroud",
                                "target_lang_sense_clarification": "to conceal or hide from view, as if by a veil or mist"
                            },
                            {
                                "target_lang_word": "cloak",
                                "target_lang_sense_clarification": "to hide or disguise something"
                            },
                            {
                                "target_lang_word": "veil",
                                "target_lang_sense_clarification": "to cover or conceal to make something less clear"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c38451c5-745c-35bc-ae1e-1a9ea410807b",
                    "sense_definition": "iets stevig inpakken of omwikkelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verpakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegster <w>hulde</w> de baby in een warme deken.",
                            "target_lang_translations": {
                                "en": "The nurse <w>wrapped</w> the baby in a warm blanket."
                            }
                        },
                        {
                            "text": "Je moet het kwetsbare beeldje goed <w>hullen</w> in zacht papier.",
                            "target_lang_translations": {
                                "en": "You must <w>wrap</w> the fragile figurine well in soft paper."
                            }
                        }
                    ],
                    "synonyms": [
                        "wikkelen",
                        "inpakken",
                        "omhullen"
                    ],
                    "antonyms": [
                        "uitpakken"
                    ],
                    "common_phrases": [
                        "in een deken hullen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in de context van wikkelen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To wrap or envelop something firmly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wrap up",
                                "target_lang_sense_clarification": "to cover or enclose something by folding material around it"
                            },
                            {
                                "target_lang_word": "envelop",
                                "target_lang_sense_clarification": "to wrap up, cover, or surround completely"
                            },
                            {
                                "target_lang_word": "swaddle",
                                "target_lang_sense_clarification": "to wrap tightly with cloth, especially a baby"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}