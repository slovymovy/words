                                    {
                                        "sense_id": "e409b13a-9fdd-3fa1-9474-20b671147445",
                                        "entry_id": "c405cf6a-7c0d-3e7d-b81d-2c909546c91a",
                                        "glosses": [
                                            "stevig voorwerp waarvan één zijde open is en waarin iets kan worden bewaard.\\nHet grondvlak van dit object is meestal rechthoekig maar kan ook een cirkel zijn (een 'ronde bak', kom of kuip) of ellipsvormig -> teil of tobbe. De ´bak´ kan eventueel afgesloten worden met een deksel.\\nIndien het materiaal van deze ´bak´ bestaat uit karton spreekt men eerder van een doos, is het materiaal hout dan van een kist of krat\\nIndien de doorsnede een cirkel is en de bak relatief hoog dan noemt men dit een koker.\\nIs hij daarnaast ook stapelbaar doordat hij taps toeloopt dan spreekt men van een emmer, teil of tobbe behalve als hij van aardewerk, glas of keramiek is want dan spreekt men van een pot.\\nEen ronde metalen 'bak' die gebruikt wordt om te koken noemt men een pan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e9a0f1a-f766-3cb4-b79d-277ed01f15de",
                                        "entry_id": "c405cf6a-7c0d-3e7d-b81d-2c909546c91a",
                                        "glosses": [
                                            "een grap of mop"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1207e019-18e9-4a62-ac3a-fc0deda67879",
                                                "sense_id": "4e9a0f1a-f766-3cb4-b79d-277ed01f15de",
                                                "text": "De man vertelde schuine bakken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f436fde2-843b-3f72-9460-1866543ee274",
                                        "entry_id": "c405cf6a-7c0d-3e7d-b81d-2c909546c91a",
                                        "glosses": [
                                            "gevangenis"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c2ee68-6013-4b4c-a992-08b4d9fe502b",
                                                "sense_id": "f436fde2-843b-3f72-9460-1866543ee274",
                                                "text": "Hij had tien jaar in de bak gezeten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a198b69e-3e9b-38d5-9731-da4bd37400e5",
                                        "entry_id": "c405cf6a-7c0d-3e7d-b81d-2c909546c91a",
                                        "glosses": [
                                            "kopje"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58076b43-5f18-4711-82e8-7e690ec9f04b",
                                                "sense_id": "a198b69e-3e9b-38d5-9731-da4bd37400e5",
                                                "text": "Wil jij een lekkere bak koffie van me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39bd0f40-1bf2-36cd-9274-153621d2a5b6",
                                        "entry_id": "c405cf6a-7c0d-3e7d-b81d-2c909546c91a",
                                        "glosses": [
                                            "slee, grote auto"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dee61442-9843-4a41-a556-5a4e25fee21e",
                                                "sense_id": "39bd0f40-1bf2-36cd-9274-153621d2a5b6",
                                                "text": "De crimineel moest zo nodig in een grote patserbak rondrijden."
                                            },
                                            {
                                                "example_id": "ead06bb9-aa3d-4129-afee-2c8e3b88b227",
                                                "sense_id": "39bd0f40-1bf2-36cd-9274-153621d2a5b6",
                                                "text": "' De taxichauffeur had een stijf, haast deftig voorkomen, en leidde hem naar een dure auto waar hij met de geoefende souplesse van iemand met een luxueuze bak instapte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "395a44f8-b627-30ff-b1e4-6dd0cef9756f",
                                        "entry_id": "c405cf6a-7c0d-3e7d-b81d-2c909546c91a",
                                        "glosses": [
                                            "vaartuig dat moet worden gesleept (sleepbak) of geduwd (duwbak)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a2e10e-6bc3-40f6-be02-e3a8ddfd372a",
                                                "sense_id": "395a44f8-b627-30ff-b1e4-6dd0cef9756f",
                                                "text": "Een duwboot kan soms wel 6 bakken duwen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad71d2cf-6cf1-31d1-9b23-452dfdb5bab4",
