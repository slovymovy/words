                "senses": [
                    {
                        "sense_id": "451c4c35-ce95-3af4-b43d-0557d9e15abd",
                        "entry_id": "e78e7540-0735-3020-954c-a9214ed7767b",
                        "glosses": [
                            "L’une des fêtes célébrées pendant les jours complémentaires du calendrier révolutionnaire ; chacun de ces jours eux-mêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ec6ccf-c11c-4eee-83ad-d3cfa1b8e1a6",
                                "sense_id": "451c4c35-ce95-3af4-b43d-0557d9e15abd",
                                "text": "Le primidi, premier des sans-culottides, sera consacré à l’attribut le plus précieux et le plus relevé de l’espèce humaine, à l’intelligence qui nous distingue du reste de la création."
                            },
                            {
                                "example_id": "0d4d8c1a-3094-4f73-b503-87a0f9a6f86c",
                                "sense_id": "451c4c35-ce95-3af4-b43d-0557d9e15abd",
                                "text": "Pichegru avait fait dans cette marche quinze cents prisonniers ; il arriva sur les bords de la Meuse, le jour de la deuxième sans-culottide (18 septembre)."
                            },
                            {
                                "example_id": "3bd1f427-ea46-4c3b-9333-62782077433c",
                                "sense_id": "451c4c35-ce95-3af4-b43d-0557d9e15abd",
                                "text": "Les sans-culottides, ces jours complémentaires qui trouvaient leur place entre le 17 et le 21 septembre, avaient des noms à part, jour de la vertu, jour du génie, jour du travail, jour de l’opinion…"
                            }
                        ]
                    }
                ],
