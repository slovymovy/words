                                            "цепь подводных камней"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca351190-75a6-3e5a-9273-80a9ec04bc20",
                                        "entry_id": "8c5a64d1-49d3-3bc0-95ec-e843cee180fd",
                                        "glosses": [
                                            "с.-х. узкая полоса вспаханной или вскопанной земли в огороде или в цветнике"
                                        ],
                                        "tags": [],
