                {
                    "sense_id": "3a5a8f12-759d-3c1c-99cd-a8e250b616a6",
                    "sense_definition": "Het gerecht (vaak zoet) waarmee een maaltijd wordt afgesloten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We eten vanavond ijs met slagroom als <w>toetje</w>.",
                            "target_lang_translations": {
                                "en": "Tonight we are having ice cream with whipped cream for <w>dessert</w>.",
                                "ru": "Сегодня вечером у нас мороженое со взбитыми сливками на <w>десерт</w>.",
                                "zh": "我们今晚吃冰淇淋配鲜奶油作为<w>甜点</w>。"
                            }
                        },
                        {
                            "text": "Na het hoofdgerecht bestelden we nog een lekker <w>toetje</w>.",
                            "target_lang_translations": {
                                "en": "After the main course, we ordered a tasty <w>dessert</w>.",
                                "ru": "После основного блюда мы заказали вкусный <w>десерт</w>.",
                                "zh": "主菜之后，我们又点了一份美味的<w>甜点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dessert",
                        "nagerecht"
                    ],
                    "common_phrases": [
                        "lekker toetje",
                        "als toetje"
                    ],
                    "target_lang_definitions": {
                        "en": "The course (often sweet) that concludes a meal.",
                        "ru": "Блюдо (часто сладкое), которым завершают трапезу.",
                        "zh": "餐后食用的甜点。"
                    },
                    "translations": {
