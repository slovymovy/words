                                    {
                                        "sense_id": "b411d804-4bbe-3062-84d5-54724ac2f872",
                                        "entry_id": "23f0ea03-1727-3ac2-8c48-0b6fa331835a",
                                        "glosses": [
                                            "Alianza o unión con otro(s), generalmente temporal o de oportunidad, para obtener una ventaja o defender un objetivo común."
                                        ],
                                        "tags": [
                                            "Política",
                                            "se aplica casi siempre",
                                            "uniones entre grupos políticos",
                                            "empresas",
                                            "países"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a069134-7fa2-47b1-ae32-48bfe02b9ee9",
                                                "sense_id": "b411d804-4bbe-3062-84d5-54724ac2f872",
                                                "text": "Hablamos de coalición cuando se establece la unión entre dos o más individuos o grupos que mantienen divergencias en relación a principios, valores, o frente a los medios a emplearse para lograr sus objetivos a largo plazo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
