                "senses": [
                    {
                        "sense_id": "84524ede-e812-310f-bb1f-6d55765ab39d",
                        "entry_id": "2c86444d-3de7-3102-b5c2-0f78f4d595b8",
                        "glosses": [
                            "ein Buch, eine Broschüre oder ein Heft, die erklären, wie man eine Maschine bedient oder ein Produkt verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1e4940-fe05-43a2-9a52-eea4246d7a3d",
                                "sense_id": "84524ede-e812-310f-bb1f-6d55765ab39d",
                                "text": "Mit dieser Betriebsanleitung erhalten Sie alle Informationen, die Sie für den sicheren Betrieb der Maschine benötigen."
                            },
                            {
                                "example_id": "6dad0aef-9d00-49d6-8a75-18bad3fa6363",
                                "sense_id": "84524ede-e812-310f-bb1f-6d55765ab39d",
                                "text": "Die Betriebsanleitung wird von vielen Herstellern vernachlässigt, weil sie als lästiges und kostspieliges Anhängsel empfunden wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
