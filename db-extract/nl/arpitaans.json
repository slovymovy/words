                    {
                        "sense_id": "97830ab1-bb0b-3e40-aeb2-32f1e574c021",
                        "entry_id": "fe82ed04-8f45-3e98-ad72-4a6ead8d5bf1",
                        "glosses": [
                            "Romaanse taal die gesproken wordt in Oost-Frankrijk (centraal Rhônedal en Savoie), in het grootste deel van Franstalig Zwitserland en in Noordwest-Italië (vooral in het Aostadal), verdeeld in vele dialecten. Het taalgebied wordt ook wel Arpitanië genoemd."
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "61d2d2ae-f54d-4d44-8169-cff02bcb0df0",
                                "sense_id": "97830ab1-bb0b-3e40-aeb2-32f1e574c021",
                                "text": "Samen met de Langues d'Oc en de Langues d'Oïl vormt het Arpitaans de groep van de Galloromaanse talen."
                            }
                        ]
                    }
                ],
