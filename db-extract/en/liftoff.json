                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a5fc437-b91b-3393-b47c-466d9c65f499",
                        "entry_id": "f7a88e05-a77f-3254-a42a-bf6d304ed357",
                        "glosses": [
                            "The point in the launch of a rocket or an aircraft where it leaves contact with the ground."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15e595e2-9485-404d-9a8b-e9f69e361fa7",
                                "sense_id": "6a5fc437-b91b-3393-b47c-466d9c65f499",
                                "text": "we have liftoff [in narration of launches]"
                            }
                        ]
                    },
                    {
                        "sense_id": "88a0c925-6606-38a1-8537-3a979a0ef3fc",
                        "entry_id": "f7a88e05-a77f-3254-a42a-bf6d304ed357",
                        "glosses": [
                            "The point at which a person or animal leaves the ground, as for example when jumping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05adb030-86c8-4511-bb51-720ac1f03dda",
                                "sense_id": "88a0c925-6606-38a1-8537-3a979a0ef3fc",
                                "text": "As she was on her approach to the hoop, taking that first Jordanesque liftoff step, her mouth guard fell floorward. Undeterred, she kept going up with the ball in her right hand."
                            }
                        ]
                    },
                    {
                        "sense_id": "f10951d8-f174-308f-9b4d-d34f4b90f763",
                        "entry_id": "f7a88e05-a77f-3254-a42a-bf6d304ed357",
                        "glosses": [
                            "The point of launching into success or action."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "73eb218f-5068-4849-9a50-6b71f510199d",
                                "sense_id": "f10951d8-f174-308f-9b4d-d34f4b90f763",
                                "text": "Ederson was booked and received lengthy treatment, meaning that Mac Allister had to wait and wait. His penalty, though, bristled with assurance. Liverpool had liftoff. The home crowd sensed that this was their moment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bfc2c9b-3e2e-4968-aea6-dc62482ecea0",
                        "source_entry_id": "f7a88e05-a77f-3254-a42a-bf6d304ed357",
                        "source_sense_description": "the point in the launch of a rocket or an aircraft where it leaves contact with the ground",
                        "target_lang_word": "décollage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décollage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be12aeb0-c980-3839-898e-fe51a1b6933f",
                                        "entry_id": "07cf3605-f626-30fc-a3d3-3c926b93a785",
                                        "glosses": [
                                            "Action de décoller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21c155f-5d81-4855-9b19-eae9f520adeb",
                                                "sense_id": "be12aeb0-c980-3839-898e-fe51a1b6933f",
                                                "text": "La plupart des personnes venues assister à notre décollage étaient encore sur l'aérodrome à 10 heures et demie."
                                            },
                                            {
                                                "example_id": "2d5927fa-b473-4bb1-827a-fe7fd4521dbd",
                                                "sense_id": "be12aeb0-c980-3839-898e-fe51a1b6933f",
                                                "text": "Vingt-sept minutes après le décollage, Ariane 5, dans sa version lourde \"ECA\", doit mettre en orbite de transfert géostationnaire le satellite Directv 9S puis, cinq minutes plus tard, Optus D1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb5665e-fa0f-329f-a4a8-e0fa649b63fa",
                                        "entry_id": "07cf3605-f626-30fc-a3d3-3c926b93a785",
                                        "glosses": [
                                            "Phase de développement d’une économie au cours de laquelle l’évolution des mentalités, des évènements politiques, des progrès techniques et des qualifications provoque l'apparition d’une croissance auto-entretenue."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5490b884-f7a1-4c02-bd43-1b2f9b7c68f3",
                                                "sense_id": "3fb5665e-fa0f-329f-a4a8-e0fa649b63fa",
                                                "text": "En s’installant dans le sud de l’agglomération, Citroën apporte non seulement du travail à des milliers de personnes, souvent issues d’un monde agricole en pleine mutation, mais donne aussi le coup d’envoi du décollage rennais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec4ed9b-d3f7-33fe-985b-853ffc04e5de",
                                        "entry_id": "07cf3605-f626-30fc-a3d3-3c926b93a785",
                                        "glosses": [
                                            "Premier rhum bu dans la journée."
                                        ],
                                        "tags": [
                                            "Guadeloupe",
                                            "Martinique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8bb9a8-6ff9-4dc3-946e-7fb3b10f4da7",
                                                "sense_id": "cec4ed9b-d3f7-33fe-985b-853ffc04e5de",
                                                "text": "Il se contenta d’un décollage bu au goulot et s’en retourna vers son procès verbal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
