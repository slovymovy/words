{
    "word_family": [
        "kitbag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96a9083d-16ac-3b03-8653-3e757496648c",
                    "sense_definition": "A set of tools, supplies, or equipment needed for a specific purpose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "equipment_set",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She keeps a first-aid <w>kit</w> in the trunk of her car.",
                            "target_lang_translations": {
                                "ru": "Она хранит <w>аптечку</w> в багажнике своей машины.",
                                "zh": "她在汽车后备箱里放了一个急救<w>箱</w>。",
                                "nl": "Ze bewaart een <w>verbanddoos</w> in de kofferbak van haar auto."
                            }
                        },
                        {
                            "text": "He bought a shaving <w>kit</w> before going on his business trip.",
                            "target_lang_translations": {
                                "ru": "Он купил бритвенный <w>набор</w> перед командировкой.",
                                "zh": "他在出差前买了一套剃须<w>工具包</w>。",
                                "nl": "Hij kocht een <w>scheerset</w> voordat hij op zakenreis ging."
                            }
                        }
                    ],
                    "common_phrases": [
                        "first-aid kit",
                        "tool kit",
                        "survival kit",
                        "travel kit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор инструментов, припасов или оборудования для определенной цели.",
                        "zh": "为特定目的而准备的一套工具、用品或设备。",
                        "nl": "Een verzameling gereedschappen, benodigdheden of uitrusting die nodig is voor een specifiek doel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "инструментов, принадлежностей"
                            },
                            {
                                "target_lang_word": "комплект",
                                "target_lang_sense_clarification": "оборудования"
                            },
                            {
                                "target_lang_word": "аптечка",
                                "target_lang_sense_clarification": "первой помощи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工具包",
                                "target_lang_sense_clarification": "工具或用品的集合"
                            },
                            {
                                "target_lang_word": "急救箱",
                                "target_lang_sense_clarification": "医疗急救用品"
                            },
                            {
                                "target_lang_word": "套装",
                                "target_lang_sense_clarification": "成套的用品"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "een verzameling bij elkaar passende voorwerpen"
                            },
