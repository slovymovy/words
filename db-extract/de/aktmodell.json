                "senses": [
                    {
                        "sense_id": "4d19400a-e7c0-32ff-9c20-46bd12a64305",
                        "entry_id": "6332505c-2458-39f2-becf-f6f2b3f9b7b8",
                        "glosses": [
                            "Modell, das sich für die künstlerische Darstellung eines Aktes zur Verfügung stellt"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "69b669b9-ca8f-49c0-9f21-87a57c2d73ea",
                                "sense_id": "4d19400a-e7c0-32ff-9c20-46bd12a64305",
                                "text": "„Ich stand dem Bildhauer fünf Stunden täglich als Aktmodell und bekam zwei Mark pro Stunde.“"
                            },
                            {
                                "example_id": "ba032749-8cf8-4bc7-ac6e-313813b886b9",
                                "sense_id": "4d19400a-e7c0-32ff-9c20-46bd12a64305",
                                "text": "„Da ihr jegliche Erfahrung fehlt, verdient sie sich ihren Lebensunterhalt zunächst als Aktmodell.“"
                            },
                            {
                                "example_id": "8b73731e-03e9-471b-8b4f-ca180cf3059f",
                                "sense_id": "4d19400a-e7c0-32ff-9c20-46bd12a64305",
                                "text": "„Aktmodelle sind in verschiedenen Bereichen der Bildenden und der Darstellenden Künste tätig: In der Bildenden Kunst werden Aktmodelle vor allem in der Malerei, in der Graphik und in der Bildhauerei eingesetzt. Des Weiteren sind Aktmodelle auch im Bereich der künstlerischen Aktfotografie tätig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
