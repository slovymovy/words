                "senses": [
                    {
                        "sense_id": "278c02ea-2270-3077-aa7c-c8d86cec4a08",
                        "entry_id": "06f5c2f5-471e-339f-a2a6-d5f4d0aed99d",
                        "glosses": [
                            "Donner un caractère en rapport avec les Kiwis (Néo-Zélandais), les kiwis, etc., à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850b8eab-d9a9-4ac0-8e8b-62043e58a1ed",
                                "sense_id": "278c02ea-2270-3077-aa7c-c8d86cec4a08",
                                "text": "Maintenant c'est sûr qu'en dehors du kumara, des weet a bix et du pavlova, je n'ai pas trop kiwisé mes habitudes alimentaires."
                            },
                            {
                                "example_id": "3b7b1aed-f974-4e6f-9ae2-87c87f2fcb85",
                                "sense_id": "278c02ea-2270-3077-aa7c-c8d86cec4a08",
                                "text": "Un Français Kiwisé."
                            },
                            {
                                "example_id": "76ea5e33-937d-43b5-b1e7-d8e3e27f5833",
                                "sense_id": "278c02ea-2270-3077-aa7c-c8d86cec4a08",
                                "text": "Merci pour le tuto, je vais kiwiser mes ongles"
                            },
                            {
                                "example_id": "1eea47ab-7ad9-4eee-9b7b-f294a3d04739",
                                "sense_id": "278c02ea-2270-3077-aa7c-c8d86cec4a08",
                                "text": "Sation : à l'époque de ce pseudo dans mes premières années, je voulais Kiwiser le monde, ce qui est donc une kiwisation a grande échelle !"
                            },
                            {
                                "example_id": "9f32e625-c3a5-4dbc-93ea-b2d367676aa7",
                                "sense_id": "278c02ea-2270-3077-aa7c-c8d86cec4a08",
                                "text": "Avec un risque de kiwiser la partie si je sauve un oppresseur."
                            },
                            {
                                "example_id": "7ff151d9-e151-4935-80ca-3e5c91aecb3c",
                                "sense_id": "278c02ea-2270-3077-aa7c-c8d86cec4a08",
                                "text": "Pas très simple ce que tu demandes mais je veux bien donner un coup de main, enfin, si on peut dire.. sinon on va kiwiser le forum."
                            }
                        ]
                    }
                ],
