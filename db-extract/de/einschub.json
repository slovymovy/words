                    },
                    {
                        "translation_id": "0922b954-4d16-4b02-aeba-e101f92a6528",
                        "source_entry_id": "f4409bb6-9cfc-317d-8428-b49d0efc0e32",
                        "source_sense_id": "fa469e2f-d65e-3d96-abcb-894c35352749",
                        "source_sense_description": "eingeschobene Textpassage",
                        "target_lang_word": "распространение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "распространение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "19b1628b-60c7-36c2-a43e-a48e1ca63a6e",
                                        "entry_id": "684b2776-476a-34e2-b2e6-558cfbe014c7",
                                        "glosses": [
                                            "действие по значению гл. распространять, распространяться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6617feed-02db-4212-917b-0f3e2528ada8",
                                                "sense_id": "19b1628b-60c7-36c2-a43e-a48e1ca63a6e",
                                                "text": "Наибольшее распространение получила позиция, согласно которой, неотъемлемым свойством юридической ответственности выступает именно ретроспективность."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17eac0b8-6010-3a13-852e-71e7c28f4507",
                                        "entry_id": "684b2776-476a-34e2-b2e6-558cfbe014c7",
                                        "glosses": [
                                            "результат такого действия, частота встречаемости, употребимость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c9a10b-ce56-4d73-9596-facca4b5e3c6",
                                                "sense_id": "17eac0b8-6010-3a13-852e-71e7c28f4507",
                                                "text": "Двое-трое заключённых, готовивших побег из лагеря, выбирали в бараке жертву, так называемого «кабанчика», или «телка́», или «корову», или «тушёнку», или «консе́рву» — такое обилие наименований свидетельствует о популярности и широком распространении этого обычая."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
