                    {
                        "sense_id": "7d3f6db7-e9e8-3b3d-92ea-79415fca873f",
                        "entry_id": "10d28465-7802-3056-b86f-86d91fecc0a4",
                        "glosses": [
                            "much, (not) a lot"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "4526b6b7-345c-41c2-a3d1-88aca0221dde",
                                "sense_id": "7d3f6db7-e9e8-3b3d-92ea-79415fca873f",
                                "text": "Par ici, il n'y a pas grand-chose à faire.",
                                "translation": "There isn't much to do around here.",
                                "english": "There isn't much to do around here."
                            },
                            {
                                "example_id": "e539377e-4f25-4728-a6ce-3effd6e818f4",
                                "sense_id": "7d3f6db7-e9e8-3b3d-92ea-79415fca873f",
                                "text": "Je n'ai plus grand-chose à y ajouter.",
                                "translation": "I don't have much to add.",
                                "english": "I don't have much to add."
                            },
                            {
                                "example_id": "42d1d601-9a14-4ca8-b964-ca95273a3541",
                                "sense_id": "7d3f6db7-e9e8-3b3d-92ea-79415fca873f",
                                "text": "On me dit que nos vies ne valent pas grand-chose ; elles passent en un instant comme fanent les roses.",
                                "translation": "People tell me that our lives are not worth much; they go by in an instant, like roses wilt.",
                                "english": "People tell me that our lives are not worth much; they go by in an instant, like roses wilt."
                            }
                        ]
                    }
                ],
