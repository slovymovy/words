    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7f8a131-cd14-334d-a22e-6fc2fbd59a0b",
                    "sense_definition": "Faire usage d'une chose matérielle, d'un moyen ou de son temps pour parvenir à un résultat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>employer</w> un outil adapté pour réparer cette table en bois."
                        },
                        {
                            "text": "Elle <w>emploie</w> tout son temps libre pour préparer ses examens."
                        }
                    ],
                    "synonyms": [
                        "se servir de",
                        "utiliser"
                    ],
                    "common_phrases": [
                        "employer la force",
                        "employer son temps"
                    ]
                },
                {
                    "sense_id": "6b5618d1-ff37-324e-8f2a-3dd29528b77f",
                    "sense_definition": "Donner du travail ou une occupation rémunérée à une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise <w>emploie</w> plus de cinquante salariés dans la région."
                        },
                        {
                            "text": "Le directeur souhaite <w>employer</w> de nouveaux ouvriers qualifiés pour ce chantier."
                        }
                    ],
                    "common_phrases": [
                        "employer des ouvriers",
                        "employer du personnel"
                    ]
                },
                {
                    "sense_id": "af763507-ad1e-3647-9202-a2c0f98c8ca0",
                    "sense_definition": "Faire usage d'un mot, d'une formule ou d'une tournure linguistique dans l'expression orale ou écrite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas <w>employer</w> cette expression familière dans une lettre officielle."
                        },
                        {
                            "text": "Le professeur <w>emploie</w> un vocabulaire précis pour expliquer cette règle difficile."
                        }
                    ],
                    "synonyms": [
                        "utiliser"
                    ],
                    "common_phrases": [
                        "employer un mot",
                        "employer une expression"
                    ]
                }
            ]
        }
    ]
