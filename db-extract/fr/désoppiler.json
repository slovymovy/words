                        "sense_id": "259ece6f-93e6-33fa-87ae-bd3ceeef5b8f",
                        "entry_id": "57c9380e-7605-399f-b4b8-667e316b7746",
                        "glosses": [
                            "Déboucher (un conduit du corps)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "37afd328-cfe9-4dcf-bac4-d45b5ed6e6d9",
                                "sense_id": "259ece6f-93e6-33fa-87ae-bd3ceeef5b8f",
                                "text": "L’art de Désoppiler, c’est-à-dire, de lever les obstructions de la rate, Sive de modo cacandi prudenter, en prenant chaque feuillet pour se torcher le derriere."
                            },
                            {
                                "example_id": "cebc9f35-2331-4212-b926-787b2ef06da6",
                                "sense_id": "259ece6f-93e6-33fa-87ae-bd3ceeef5b8f",
                                "text": "Aucun remede ne désoppile plus sûrement, plutôt & plus agréablement que le mariage."
                            }
                        ]
