                    {
                        "sense_id": "ec13ea85-cdc5-3e45-8a96-999404f17ccc",
                        "entry_id": "2f8d6ea8-a30c-3c94-adcb-9c4d279f1e90",
                        "glosses": [
                            "Someone who creates or enacts laws.",
                            "especially a member of a legislative body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae63ea24-c47b-4ed6-bb8c-eeb6604084b1",
                                "sense_id": "ec13ea85-cdc5-3e45-8a96-999404f17ccc",
                                "text": "Give the children of the poor that portion of education which will enable them to know their own resources; which will cultivate in them an onward-looking hope, and give them rational amusement in their leisure hours: this, and this only, will work out that moral revolution, which is the legislator's noblest purpose."
                            }
                        ]
                    },
                    {
                        "sense_id": "db4affef-fd1c-3aa5-b41e-1facd19d2820",
                        "entry_id": "2f8d6ea8-a30c-3c94-adcb-9c4d279f1e90",
                        "glosses": [
                            "Someone who creates or enacts laws.",
                            "especially not any individual member of a legislative body but the abstracted author of a statute or statutes relevant for the principles of interpretation."
                        ],
                        "tags": [],
                        "examples": []
                    }
