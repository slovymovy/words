                    {
                        "translation_id": "f4e7a810-f4e9-4462-8c6c-d115d2a92308",
                        "source_entry_id": "eac7205f-bd59-3d83-ace7-d25941afbc5d",
                        "source_sense_id": "b5226068-9564-3c6a-946d-f6a84a6c3cd4",
                        "target_lang_word": "Scharfschütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharfschütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7373fe38-436b-351b-8f24-5e3903de27fb",
                                        "entry_id": "f7e13054-a078-3bc0-a7a8-e0ba9dc7b654",
                                        "glosses": [
                                            "Schütze zur gezielten Personenbekämpfung von Personen durch Präzisionsschüsse (paramilitärisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e333509b-4a44-4ddd-87c3-4a6653d4e236",
                                                "sense_id": "7373fe38-436b-351b-8f24-5e3903de27fb",
                                                "text": "Es ist unmöglich in das Tal zu gelangen, weil an beiden Seiten Scharfschützen auf den Anhöhen platziert sind, die jedes Durchkommen verhindern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eeb4a41e-a5cc-386d-bcac-ac65ec8bf249",
                                        "entry_id": "f7e13054-a078-3bc0-a7a8-e0ba9dc7b654",
                                        "glosses": [
                                            "Schütze mit besonderer Ausbildung zur gezielten Personenbekämpfung durch Präzisionsschüsse (militärisch und paramilitärisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f8de91-e2da-4d26-957d-d67bd0dc9180",
                                                "sense_id": "eeb4a41e-a5cc-386d-bcac-ac65ec8bf249",
                                                "text": "Die zwei Scharfschützen haben ihre Zielperson fest im Visier."
                                            },
                                            {
                                                "example_id": "ec5d4411-4431-4e4a-ba89-94ae9ab47cfd",
                                                "sense_id": "eeb4a41e-a5cc-386d-bcac-ac65ec8bf249",
                                                "text": "„Wenn sie Glück hatten, würde die japanische Artillerie nicht schießen, und vielleicht waren nicht allzu viele Scharfschützen zurückgelassen worden.“"
                                            },
                                            {
                                                "example_id": "b9a1ae0b-3807-4202-bf0f-3eaf63cf8be5",
                                                "sense_id": "eeb4a41e-a5cc-386d-bcac-ac65ec8bf249",
                                                "text": "„Nun trug die Infanterie auch nicht mehr auffällige scharlachrote Uniformröcke mit goldener Knopfleiste wie während des Ersten Burenkriegs, als sie vortreffliche Ziele für die feindlichen Scharfschützen geboten hatte.“"
                                            },
                                            {
                                                "example_id": "7009dacd-2bbc-417a-8a9d-d1d7a1dc0672",
                                                "sense_id": "eeb4a41e-a5cc-386d-bcac-ac65ec8bf249",
                                                "text": "„Die Hänge am östlichen Ufer waren befestigt und wurden von den Russen gehalten, in den Uferbüschen standen ihre Scharfschützen.“"
                                            },
                                            {
                                                "example_id": "bd281e24-3952-4c2c-9a13-2ea5b5f897d6",
                                                "sense_id": "eeb4a41e-a5cc-386d-bcac-ac65ec8bf249",
                                                "text": "„Dabei trifft ihn die Kugel eines französischen Scharfschützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "193bd04d-6eb6-3f53-8149-ede9901af274",
                                        "entry_id": "f7e13054-a078-3bc0-a7a8-e0ba9dc7b654",
                                        "glosses": [
                                            "Tätigkeitsbezeichnung für einen Soldaten beziehungsweise eine Soldatin mit der unter [2] genannten Ausbildung in den Deutschen Streitkräften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237ada21-8a3f-4f79-8abe-3ba0da3628d2",
                                                "sense_id": "193bd04d-6eb6-3f53-8149-ede9901af274",
                                                "text": "Die Schlacht war auch durch die tagtägliche Jagd russischer und deutscher Scharfschützen gegeneinander geprägt."
                                            },
                                            {
                                                "example_id": "212dcf05-6847-4fa1-9e1f-87c81ba29a1f",
                                                "sense_id": "193bd04d-6eb6-3f53-8149-ede9901af274",
                                                "text": "„Man sagte ihnen besonderes Talent als Fährtenleser, Kundschafter, Scharfschützen und Spione nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2eeb94b6-5b87-4139-98d3-43aa20a9e05f",
                        "source_entry_id": "eac7205f-bd59-3d83-ace7-d25941afbc5d",
                        "source_sense_id": "b5226068-9564-3c6a-946d-f6a84a6c3cd4",
                        "target_lang_word": "sniper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sniper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc3a43ce-9c7a-34e1-8ba6-f51bd1d35dcd",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "A person using long-range small arms for precise attacks from a concealed position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeabb1c0-c9b5-438c-9968-aed8f25e6fd0",
                                                "sense_id": "fc3a43ce-9c7a-34e1-8ba6-f51bd1d35dcd",
                                                "text": "The sniper shot him in the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0cc1b98-83b5-32af-bbeb-4fc17507fcfa",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "A sniper rifle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b6e015-a33e-3629-9c83-d0d8be790999",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "Any attacker using a non-contact weapon against a specific target from a concealed position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6cfef12-627e-3a02-b552-dfe6d0eaf455",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "One who shoots from a concealed position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e5f5d2-39d6-47d2-bbd0-9df049c7aa39",
                                                "sense_id": "a6cfef12-627e-3a02-b552-dfe6d0eaf455",
                                                "text": "The British, having cleared the open field, now faced the problem of advancing through the trees into the sniper fire of several hundred Virginia militia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21865ac-0153-3d79-8026-f9bc842f7cad",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "One who criticizes; a person who frequently snipes at others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9695b169-51bc-4649-8e4f-7749430c6da5",
                                                "sense_id": "e21865ac-0153-3d79-8026-f9bc842f7cad",
                                                "text": "They always sniped at each other in public. German snipers were a wishy-washy lot compared with Lester and his wife."
                                            },
                                            {
                                                "example_id": "75e4efad-3682-4c1a-a9b6-2273b150babe",
                                                "sense_id": "e21865ac-0153-3d79-8026-f9bc842f7cad",
                                                "text": "No winnable seat has been found for Mr. H. L. Nathan, a powerful recruit from the Liberal ranks, and poor Mr. Wedgwood Benn, an invaluable sniper for a party in Opposition, has been out of Parliament now since 1931."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c4e5e3-d4dc-3fb9-87a7-7f06db833257",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "A hunter of snipe (the bird)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d681377b-c940-3223-a275-68a2f1cce97a",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "A player who specializes in scoring goals."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49fa2b4d-1126-42fa-a17c-75eccbfe9f7d",
                                                "sense_id": "d681377b-c940-3223-a275-68a2f1cce97a",
                                                "text": "Alexander Ovechkin is often regarded as the greatest sniper of his generation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6763b25d-d061-337f-b342-5af7d39654e0",
                                        "entry_id": "b5a07e2b-65bd-330f-ae7d-be310a00800b",
                                        "glosses": [
                                            "A person or automated process set up by a person who or which attempts to win an online auction by placing a bid only seconds before the auction ends, leaving no time for other bidders to respond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f4888d-4d38-4b75-8e43-a1d23e02a681",
                                                "sense_id": "6763b25d-d061-337f-b342-5af7d39654e0",
                                                "text": "The real reason most snipers bid late in the auction is that they feel it helps them obtain bargains at the expense of novices who don't understand how proxy bidding works and who place bids for less than the amount they are really willing to pay."
                                            },
                                            {
                                                "example_id": "fd4b8b9c-e69c-485b-b90e-e3264eb4c0d0",
                                                "sense_id": "6763b25d-d061-337f-b342-5af7d39654e0",
                                                "text": "Sniping is the process of placing bids in the closing minutes or seconds of an auction. Snipers do this to avoid bidding wars that escalate the bids to more than they want to pay. Bidders can protect themselves against snipers by bidding the absolute maximum amount they are willing to pay with eBay's proxy bidding system."
                                            },
                                            {
                                                "example_id": "780ca8f7-6112-4ca2-9488-ed57330f7550",
                                                "sense_id": "6763b25d-d061-337f-b342-5af7d39654e0",
                                                "text": "The successful sniper makes one bid only—and makes it count. Sniping happens on eBay because the end time of each auction is rigidly enforced. If you know that an auction ends at 12:01:30, you can time your snipe to hit at 12:01:29, leaving no time for any other bidders to trump your bid."
                                            },
                                            {
                                                "example_id": "991907b5-5d91-4543-9f97-7c78389e2866",
                                                "sense_id": "6763b25d-d061-337f-b342-5af7d39654e0",
                                                "text": "The smart sniper slips in and places the final winning bid when it's too late for the other bidder to respond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
