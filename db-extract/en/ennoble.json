                                            {
                                                "example_id": "95826f0b-b1b2-4007-9753-de5630225685",
                                                "sense_id": "05b114b3-703a-3952-a990-ada9cb85013e",
                                                "text": "Sie wurde gestern geadelt!"
                                            },
                                            {
                                                "example_id": "19ec3db9-3ab0-49ca-aa73-ee87f2725562",
                                                "sense_id": "05b114b3-703a-3952-a990-ada9cb85013e",
                                                "text": "„Ich kann an einem Tag tausend adeln und zu Rittern machen. Aber so mächtig bin ich nicht, dass ich in tausend Jahren einen Gelehrten machen könnte.“ (Zitat von: Kaiser Sigismund von Luxemburg)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce7db954-7e57-3090-9ce4-c459c7c60136",
                                        "entry_id": "ae9d6391-f5d6-349b-a1b2-eddb4cee2483",
                                        "glosses": [
                                            "etwas oder jemanden veredeln beziehungsweise wertvoller, würdevoller machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a00e712-6958-463b-954b-b628288c4cf8",
                                                "sense_id": "ce7db954-7e57-3090-9ce4-c459c7c60136",
                                                "text": "Dieses Verhalten adelt ihn."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
