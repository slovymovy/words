                "senses": [
                    {
                        "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                        "entry_id": "b20e11d7-55fe-392f-abce-427ff17170f9",
                        "glosses": [
                            "Software, die Dateien beim Hochladen auf einen Server überprüft und gegebenenfalls abweist oder sonstige Maßnahmen initiiert"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "d2145442-253e-452b-bef8-89dd8d225a8c",
                                "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                                "text": "„Nun haben sich die Verhandler auf einen finalen Entwurf geeinigt – mit Uploadfiltern und Leistungsschutzrecht.“"
                            },
                            {
                                "example_id": "e7c5110d-1c8f-411e-9eb9-cf9d2fac185f",
                                "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                                "text": "„Die CDU-Spitze pocht nach dem Ja des Europaparlaments zum neuen Urheberrecht auf eine Umsetzung in Deutschland ohne die umstrittenen Uploadfilter.“"
                            },
                            {
                                "example_id": "2b5ea08c-9357-466b-bee6-95a0cf528666",
                                "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                                "text": "„Von der Vorratsdatenspeicherung über Zensursula bis Acta. Diese Demo gegen Uploadfilter ist größer als die früheren.“"
                            },
                            {
                                "example_id": "d7500dbb-31f8-497b-b0b1-553c3925b490",
                                "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                                "text": "„Kritiker fürchten, dass Kontrollen dann nur über Software möglich sind, sogenannte Uploadfilter, und warnen vor Zensur.“"
                            },
                            {
                                "example_id": "f4262691-3cfc-43bc-bacc-24a43ada4f40",
                                "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                                "text": "„Die Portale müssen Posts auf mögliche Urheberrechtsverletzungen prüfen, bevor sie erscheinen. Eine technische Lösung dafür wären Uploadfilter – also eine Software, die Beiträge auf mögliche Urheberrechtsverletzungen hin prüft und sie im Zweifel gar nicht erst online gehen lässt.“"
                            },
                            {
                                "example_id": "1143a4d5-0f51-4594-9034-825eeb081025",
                                "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                                "text": "„Gegner von Artikel 13 und den damit verbundenen Uploadfiltern wollen am Samstag europaweit demonstrieren.“"
                            },
                            {
                                "example_id": "06801175-2040-45fc-87ef-1c09218a8e5e",
                                "sense_id": "f5bbd094-d10d-309f-8e82-8f3ded04235a",
                                "text": "„Die geplante Reform des EU-Urheberrechts sorgt weiter für heftige Debatten. Vor allem die umstrittenen Uploadfilter, mit denen große Onlineplattformen in Zukunft hochgeladene Inhalte ihrer Nutzerinnen und Nutzer auf Urheberrechtsverletzungen prüfen müssten, bleiben umstritten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
