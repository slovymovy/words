                "senses": [
                    {
                        "sense_id": "6cfdc0c7-50bc-3bd4-898c-7443138b5bf9",
                        "entry_id": "3dc5e947-c867-3b82-a4e2-68b11d7836f6",
                        "glosses": [
                            "Sammelbezeichnung für die Dialekte des Niederdeutschen, die in Mecklenburg-Vorpommern, Brandenburg und im Norden Sachsen-Anhalts gesprochen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b15cb4-2726-4526-bee5-67c7f819c977",
                                "sense_id": "6cfdc0c7-50bc-3bd4-898c-7443138b5bf9",
                                "text": "„Als Unterschied zu den westniederdeutschen Mundarten wird für gewöhnlich die Bildung des Plurals der Verben im Präsens herangezogen. Dieser soll für alle drei Personen gleich sein (Einheitsplural) und im Westniederdeutschen auf -(e)t, im Ostniederdeutschen jedoch auf -e(n) ausgehen […].“"
                            },
                            {
                                "example_id": "4c103566-31dc-4c7f-9a76-9aa5e1ba6ae6",
                                "sense_id": "6cfdc0c7-50bc-3bd4-898c-7443138b5bf9",
                                "text": "„Der nord-südliche Gegensatz von Niederdeutsch und Mitteldeutsch setzt sich ostdeutsch in dem Verhältnis von Ostniederdeutsch und Ostmitteldeutsch fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
