                                "example_id": "9525172d-66dd-4ede-8bbd-28f24bfd22e2",
                                "sense_id": "6540adac-82fc-3b4e-9dd6-3b170999043e",
                                "text": "Gdy zobaczyła po drugiej stronie ulicy swojego byłego, uciekła odeń, jak jej się wydawało, niepostrzeżenie w boczną uliczkę."
                            }
                        ],
