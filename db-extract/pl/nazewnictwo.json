                "translations": [
                    {
                        "translation_id": "21fa4329-e727-4da7-875e-02c9e772abc8",
                        "source_entry_id": "d1cb276f-941d-3733-81c4-21a8ac3521f7",
                        "source_sense_id": "92a358ea-40f9-305c-9e26-530bb70afe63",
