                    {
                        "translation_id": "6c104ea1-5aa2-4cdb-b210-41c7e28710f0",
                        "source_entry_id": "598b311a-488f-3f50-8f64-80f00518eb99",
                        "source_sense_id": "d9bc2ef7-3214-333a-92ac-a7cca9fee416",
                        "source_sense_description": "bepaald soort loofboom, Populus tremula",
                        "target_lang_word": "aspen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspen",
