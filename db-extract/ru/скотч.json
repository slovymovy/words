                "senses": [
                    {
                        "sense_id": "23b718a8-d302-3836-aa51-9f7d885ecc75",
                        "entry_id": "d5e14eea-4bce-3cd9-bbae-2c1e997b155d",
                        "glosses": [
                            "то же, что клейкая лента"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d77921d8-0041-4e08-85b3-0345d80a4f2a",
                                "sense_id": "23b718a8-d302-3836-aa51-9f7d885ecc75",
                                "text": "Автомат был снаряжён двумя скреплёнными скотчем магазинами."
                            },
                            {
                                "example_id": "1f175d27-23a8-4196-87f7-25fe7caced2f",
                                "sense_id": "23b718a8-d302-3836-aa51-9f7d885ecc75",
                                "text": ".. Татарский заметил, что его рот заклеен широкой полосой скотча телесного цвета, на котором красным маркером нарисована улыбка. ❬…❭"
                            }
                        ]
                    }
                ],
