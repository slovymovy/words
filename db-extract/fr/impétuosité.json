        "fr-extract.jsonl": [
            {
                "entry_id": "43673351-b7cf-361d-944e-8c672191ecf5",
                "word": "impétuosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d548de7-dd5c-464b-a2e7-1c9236a069c8",
                        "entry_id": "43673351-b7cf-361d-944e-8c672191ecf5",
                        "tags": [
                            "plural"
                        ],
                        "form": "impétuosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0907d9b9-1da1-30b0-9079-91413b0a4318",
                        "entry_id": "43673351-b7cf-361d-944e-8c672191ecf5",
                        "glosses": [
                            "Caractère de ce qui est impétueux, fougueux, ardent, violent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eddef299-3520-4f16-9039-1b5170d4d086",
                                "sense_id": "0907d9b9-1da1-30b0-9079-91413b0a4318",
                                "text": "Alors, si le vent du nord vient à souffler, ces graux sont promptement agrandis, il s'en forme même de nouveaux, et les étangs se déchargent en peu de jours d'une grande partie de leurs eaux ; ils se vident presque entièrement si le mistral (nord-ouest) souffle assez long-temps avec son impétuosité ordinaire."
                            },
                            {
                                "example_id": "43b0f0f0-f62d-4a73-8597-7d0acd0454a9",
                                "sense_id": "0907d9b9-1da1-30b0-9079-91413b0a4318",
                                "text": "Don Juan -- Il n'est rien qui puisse arrêter l'impétuosité de mes désirs, je me sens un cœur à aimer toute la terre."
                            },
                            {
                                "example_id": "3c7261e0-cf7f-4faf-8b9f-0c517a327fa6",
                                "sense_id": "0907d9b9-1da1-30b0-9079-91413b0a4318",
                                "text": "C'est la justice qui a établi la société et qui la conserve. Sans la justice, nous serions encore errants et vagabonds, et sans elle, nos impétuosités nous rejetteraient bientôt dans la première confusion dont nous sommes heureusement sortis."
                            }
                        ]
                    },
                    {
                        "sense_id": "c83bb061-9ecb-3bb1-be9b-281d19998d93",
                        "entry_id": "43673351-b7cf-361d-944e-8c672191ecf5",
                        "glosses": [
                            "Extrême vivacité dans l’esprit, dans le caractère, dans les manières."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2fba4534-6223-4ad0-8f9e-94e4c7300530",
                                "sense_id": "c83bb061-9ecb-3bb1-be9b-281d19998d93",
                                "text": "À qui prendrait à son compte le mot de M de Boureuille je riposterais que le talent, pour un chef, c'est de modérer les impétuosités des jeunes hommes en les admonestant doucement, sans les décourager par des paroles de glace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d75cd043-595f-42c7-bb55-cbdd877fd0f4",
                        "source_entry_id": "43673351-b7cf-361d-944e-8c672191ecf5",
                        "source_sense_id": "0907d9b9-1da1-30b0-9079-91413b0a4318",
                        "target_lang_word": "impetuosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impetuosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0b237e-212b-365e-a4d4-f14f4f4a7f32",
                                        "entry_id": "ce279708-3f2d-3c4a-9c49-eaca61e00d28",
                                        "glosses": [
                                            "The quality of making rash or arbitrary decisions, especially in an impulsive or forceful manner."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f253b39-34c4-46eb-a606-c9563c548c79",
                                                "sense_id": "2f0b237e-212b-365e-a4d4-f14f4f4a7f32",
                                                "text": "She had however another motive, beside her obedience, to accompany the old gentleman in the chase; for by her presence she hoped in some measure to restrain his impetuosity, and to prevent him from so frequently exposing his neck to the utmost hazard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74afd29a-c336-3c08-9c78-65111c7b084c",
                                        "entry_id": "ce279708-3f2d-3c4a-9c49-eaca61e00d28",
                                        "glosses": [
                                            "The condition or quality of being impetuous, impatient; fury; violence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd00061-676b-48c3-a694-ef1be0b16f9f",
                                                "sense_id": "74afd29a-c336-3c08-9c78-65111c7b084c",
                                                "text": "Again his lordship began his long and deliberate perusal, while Henrietta watched the slow motion of his eyes with a degree of impetuosity she could scarcely repress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
