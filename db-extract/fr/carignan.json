                        "examples": [
                            {
                                "example_id": "09921a00-aeef-48c1-8208-ef2348848e70",
                                "sense_id": "8056e49e-636a-37ba-aa5c-e001da7aad35",
                                "text": "Le sergent Patrick Carignan, de la Sûreté du Québec (SQ), préparait une opération de sécurité routière, le 15 avril dernier, lorsqu’il a dû voler au secours d’un bambin."
                            },
                            {
                                "example_id": "186afa06-551c-4107-b544-dfb04d1f8bf7",
                                "sense_id": "8056e49e-636a-37ba-aa5c-e001da7aad35",
                                "text": "David Morin, politologue à l’université de Sherbrooke (Canada), a écrit, avec Marie-Ève Carignan, professeure en communication, Mon frère est complotiste, comment rétablir le lien et le dialogue social (Éd. de l’Homme), sorti début mars."
                            }
                        ]
                    }
