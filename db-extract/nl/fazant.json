                                "target_senses": [
                                    {
                                        "sense_id": "d8841379-70ed-3e57-944b-99d448faabeb",
                                        "entry_id": "87bae5f5-15b0-3a48-9503-2968556814a0",
                                        "glosses": [
                                            "орнитол. курообразная длиннохвостая птица семейства фазановых (Phasianus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f7ae77-8ff1-4dcd-8eb8-4015290c908b",
                                                "sense_id": "d8841379-70ed-3e57-944b-99d448faabeb",
                                                "text": "Любимую пищу фазанов составляют зерновые хлеба, и осенью можно видеть целые стада этих птиц, бегающих по полям или перелетающих с скирды на скирду."
                                            },
                                            {
                                                "example_id": "24eae3cb-3f25-48ff-9c0b-965156579cd6",
                                                "sense_id": "d8841379-70ed-3e57-944b-99d448faabeb",
                                                "text": "Вдруг с громким кудахтаньем из травы тяжело поднялась, шумно хлопая крыльями, пара фазанов, блестя на солнце перьями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c33c4a-b9bd-3a00-9cfe-63ac9a0ea5fc",
                                        "entry_id": "87bae5f5-15b0-3a48-9503-2968556814a0",
                                        "glosses": [
                                            "самец этой птицы с яркоокрашенным оперением"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e5230b6-85fe-376f-9201-ac61341b7524",
                                        "entry_id": "87bae5f5-15b0-3a48-9503-2968556814a0",
                                        "glosses": [
                                            "кулин. мясо этой птицы, употребляемое в пищу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60869281-d1b1-4809-be9f-58f6cdb42740",
                                                "sense_id": "4e5230b6-85fe-376f-9201-ac61341b7524",
                                                "text": "Максим Максимыч имел глубокие сведения в поваренном искусстве: он удивительно хорошо зажарил фазана, удачно полил его огуречным рассолом, и я должен признаться, что без него пришлось бы остаться на сухоядении."
                                            },
                                            {
                                                "example_id": "754871f5-562e-4864-a235-585eefddabda",
                                                "sense_id": "4e5230b6-85fe-376f-9201-ac61341b7524",
                                                "text": "Он подал огромную порцию стерляжьей ухи, свежей осетрины и жареного фазана, при котором место огурцов занимали солёная дыня и виноград."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b187a7ad-b6a9-3c98-ac5f-1cc8203e8332",
                                        "entry_id": "87bae5f5-15b0-3a48-9503-2968556814a0",
                                        "glosses": [
                                            "воен. жарг. в неформальной иерархии в советской и российской армии — солдат третьего полугодия службы (из двух лет)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
