                    {
                        "sense_id": "f5b1e57f-5789-3808-8f40-22d6dc86eb1c",
                        "entry_id": "ac6bb227-7aff-32ca-acc3-1e64f12b372a",
                        "glosses": [
                            "aanhoudend snel en hoorbaar ademen zoals past bij lichamelijke inspanning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0438d616-d375-48f9-926b-4baa77697dfb",
                                "sense_id": "f5b1e57f-5789-3808-8f40-22d6dc86eb1c",
                                "text": "Artur Z. veroorzaakte destijds veel commotie in de Noord-Hollands kustplaats. De schennispleger joeg vrouwen die alleen op straat waren de stuipen op het lijf door zijn broek te laten zakken en zichzelf - terwijl hij hen strak bleef aankijken - met veel gekreun en gehijg te bevredigen."
                            },
                            {
                                "example_id": "53983209-1efc-4788-8d96-9b8d28a991cb",
                                "sense_id": "f5b1e57f-5789-3808-8f40-22d6dc86eb1c",
                                "text": "De 38-jarige Koevermans staat niet meer in de spits, maar lekker in de verdediging. Geen gehijg van mandekkers in zijn nek, geen vliegende tackles op zijn benen. Dat bevalt wel. Inmiddels heeft hij er alweer drie seizoenen opzitten in het Helmondse amateurvoetbal."
                            }
                        ]
                    }
