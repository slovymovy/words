                        "first-rate",
                        "splendid",
                        "swell",
                        "superb"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Excelente, magnífico o de primera categoría."
                    },
                    "translations": {
