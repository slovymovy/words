                    {
                        "sense_id": "afdfcedb-4a27-3944-9140-fc27c2ebdf94",
                        "entry_id": "cd2270a9-371d-36af-bc5c-f4512b351937",
                        "glosses": [
                            "Erhöhung der maximalen Entfernung, die ein Fahrzeug oder Flugzeug ohne Auftanken zurücklegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e02677e1-a2f9-491b-9f3c-f91e6e4d04dd",
                                "sense_id": "afdfcedb-4a27-3944-9140-fc27c2ebdf94",
                                "text": "„Zur Reichweitenoptimierung verfügt die E-Schwalbe über eine Rekuperationsfunktion, bei der Bremsenergie in elektrischen Strom gewandelt wird.“"
                            },
                            {
                                "example_id": "d986424c-e697-421a-b11d-6c6443a6b4e8",
                                "sense_id": "afdfcedb-4a27-3944-9140-fc27c2ebdf94",
                                "text": "„Insgesamt bietet das Volta sieben Fahrmodi, die für jeweils unterschiedliche Kompromisse aus Unterstützung und Reichweitenoptimierung stehen.“"
                            },
                            {
                                "example_id": "f4e67a71-e7e2-4db2-9ba0-680bdcfda864",
                                "sense_id": "afdfcedb-4a27-3944-9140-fc27c2ebdf94",
                                "text": "„Dass es der Vorgänger 2,3 Sekunden schneller geschafft hat, lässt auf gewolltes Drosseln zwecks Reichweitenoptimierung schließen.“"
                            },
                            {
                                "example_id": "28ccffcd-0689-4934-a264-689955eb16cb",
                                "sense_id": "afdfcedb-4a27-3944-9140-fc27c2ebdf94",
