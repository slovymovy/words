                                "sense_id": "6850eea7-3565-35cc-ab1a-6523a6c46c98",
                                "text": "Najstarsze odkryte dotąd psie szczątki pochodzą z epoki górnego paleolitu i są datowane na okres 13-17 000 lat p.n.e."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
