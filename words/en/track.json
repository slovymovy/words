    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce29d206-e30c-3262-a18c-6161bf7e6c8d",
                    "sense_definition": "The pair of metal rails along which a train moves.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is dangerous to walk across the railway <w>tracks</w>.",
                            "target_lang_translations": {
                                "ru": "Опасно переходить через железнодорожные <w>пути</w>.",
                                "tr": "Demiryolu <w>raylarının</w> üzerinden yürümek tehlikelidir."
                            }
                        },
                        {
                            "text": "The train stopped because there was an obstacle on the <w>track</w>.",
                            "target_lang_translations": {
                                "ru": "Поезд остановился, так как на <w>путях</w> было препятствие.",
                                "tr": "<w>Raylarda</w> bir engel olduğu için tren durdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "rails",
                        "railway line"
                    ],
                    "common_phrases": [
                        "train track",
                        "railway track",
                        "cross the tracks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пара металлических рельсов, по которым движется поезд.",
                        "tr": "Trenlerin üzerinde hareket ettiği çift metal ray."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "железнодорожный"
                            },
                            {
                                "target_lang_word": "рельсы",
                                "target_lang_sense_clarification": "металлические направляющие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ray",
                                "target_lang_sense_clarification": "demiryolu demiri"
                            },
                            {
                                "target_lang_word": "demiryolu hattı",
                                "target_lang_sense_clarification": "tren yolu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4349f69a-3ecf-307c-b57d-2f4b89ad731f",
                    "sense_definition": "A mark or line of marks left on the ground by a person, animal, or vehicle that has moved over it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We followed the bear <w>tracks</w> deep into the forest.",
                            "target_lang_translations": {
                                "ru": "Мы шли по медвежьим <w>следам</w> вглубь леса.",
                                "tr": "Ayı <w>izlerini</w> takip ederek ormanın derinliklerine ilerledik."
                            }
                        },
                        {
                            "text": "The heavy truck left deep tire <w>tracks</w> in the mud.",
                            "target_lang_translations": {
                                "ru": "Тяжелый грузовик оставил глубокие <w>следы</w> шин в грязи.",
                                "tr": "Ağır kamyon çamurda derin lastik <w>izleri</w> bıraktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "footprint",
                        "trail",
                        "print",
                        "trace"
                    ],
                    "common_phrases": [
                        "make tracks",
                        "tire tracks",
                        "cover one's tracks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отпечаток или след, оставленный на земле человеком, животным или транспортным средством.",
                        "tr": "Bir insanın, hayvanın veya aracın zeminde bıraktığı iz veya çizgi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "отпечаток на земле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iz",
                                "target_lang_sense_clarification": "ayak veya tekerlek izi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc168a5-0354-3096-9f63-40c7dd621337",
                    "sense_definition": "A single song or piece of music on a recording.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My favorite <w>track</w> on this album is the last one.",
                            "target_lang_translations": {
                                "ru": "Мой любимый <w>трек</w> на этом альбоме — последний.",
                                "tr": "Bu albümdeki en sevdiğim <w>parça</w> sonuncusu."
                            }
                        },
                        {
                            "text": "The band played a bonus <w>track</w> for the fans.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла бонус-<w>трек</w> для фанатов.",
                                "tr": "Grup, hayranlar için ekstra bir <w>şarkı</w> çaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "song",
                        "recording",
                        "number",
                        "piece"
                    ],
                    "common_phrases": [
                        "bonus track",
                        "title track",
                        "backing track"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная песня или музыкальная композиция в записи.",
                        "tr": "Bir kayıttaki tek bir şarkı veya müzik eseri."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трек",
                                "target_lang_sense_clarification": "музыкальная запись"
                            },
                            {
                                "target_lang_word": "композиция",
                                "target_lang_sense_clarification": "песня"
                            },
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "звуковая"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "parça",
                                "target_lang_sense_clarification": "müzik parçası"
                            },
                            {
                                "target_lang_word": "şarkı",
                                "target_lang_sense_clarification": "müzik eseri"
                            },
                            {
                                "target_lang_word": "parça (track)",
                                "target_lang_sense_clarification": "ses kaydı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59aaa542-d900-3501-aa79-28387d3b8eea",
                    "sense_definition": "A prepared circular course or circuit used for racing or running.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athletes are warming up on the running <w>track</w>.",
                            "target_lang_translations": {
                                "ru": "Спортсмены разминаются на беговой <w>дорожке</w>.",
                                "tr": "Sporcular koşu <w>pistinde</w> ısınma hareketleri yapıyor."
                            }
                        },
                        {
                            "text": "He goes to the race <w>track</w> every weekend to watch the cars.",
                            "target_lang_translations": {
                                "ru": "Он ездит на гоночную <w>трассу</w> каждые выходные, чтобы посмотреть на машины.",
                                "tr": "Arabaları izlemek için her hafta sonu yarış <w>pistine</w> gidiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "racetrack",
                        "circuit",
                        "course"
                    ],
                    "common_phrases": [
                        "race track",
                        "running track",
                        "track and field"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально подготовленная круговая трасса для гонок или бега.",
                        "tr": "Yarış veya koşu için hazırlanmış dairesel parkur veya pist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трасса",
                                "target_lang_sense_clarification": "гоночная"
                            },
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "беговая"
                            },
                            {
                                "target_lang_word": "трек",
                                "target_lang_sense_clarification": "велотрек или стадион"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "pist",
                                "target_lang_sense_clarification": "yarış veya koşu pisti"
                            },
                            {
                                "target_lang_word": "parkur",
                                "target_lang_sense_clarification": "spor sahası"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3a9b628-cd1c-3490-91e9-543c656ca51c",
                    "sense_definition": "A rough path or road, usually formed by use rather than construction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked along a narrow dirt <w>track</w> through the woods.",
                            "target_lang_translations": {
                                "ru": "Мы шли по узкой грунтовой <w>тропе</w> через лес.",
                                "tr": "Ormanın içinden geçen dar bir toprak <w>patikada</w> yürüdük."
                            }
                        },
                        {
                            "text": "They live in a small house off the beaten <w>track</w>.",
                            "target_lang_translations": {
                                "ru": "Они живут в маленьком домике в стороне от проторенных <w>дорог</w>.",
                                "tr": "Gözden uzak, tenha bir yerde küçük bir evde yaşıyorlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "path",
                        "trail",
                        "lane"
                    ],
                    "common_phrases": [
                        "dirt track",
                        "beaten track",
                        "off the beaten track"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неровная тропа или дорога, обычно образованная в результате ходьбы или езды, а не строительства.",
                        "tr": "Genellikle yapılarak değil, kullanılarak oluşmuş engebeli patika veya yol."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тропа",
                                "target_lang_sense_clarification": "узкая дорожка"
                            },
                            {
                                "target_lang_word": "дорога",
                                "target_lang_sense_clarification": "грунтовая или проселочная"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "patika",
                                "target_lang_sense_clarification": "dar keçi yolu"
                            },
                            {
                                "target_lang_word": "toprak yol",
                                "target_lang_sense_clarification": "ham yol"
                            },
                            {
                                "target_lang_word": "yol",
                                "target_lang_sense_clarification": "patika/iz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a85036-df04-3212-aff2-01d495d50bc1",
                    "sense_definition": "Continuous awareness or knowledge of how something is changing, happening, or progressing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to keep <w>track</w> of all the new students in the class.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>следить</w> за всеми новыми учениками в классе.",
                                "tr": "Sınıftaki tüm yeni öğrencileri <w>takip etmek</w> zor."
                            }
                        },
                        {
                            "text": "I was reading a book and completely lost <w>track</w> of time.",
                            "target_lang_translations": {
                                "ru": "Я читал книгу и совершенно потерял <w>счёт</w> времени.",
                                "tr": "Kitap okuyordum ve zamanın nasıl geçtiğini tamamen <w>unuttum</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep track of",
                        "lose track of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянная осведомленность о том, как что-то меняется или происходит.",
                        "tr": "Bir şeyin nasıl değiştiği, ilerlediği veya gerçekleştiği konusunda sürekli bilgi sahibi olma durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счёт",
                                "target_lang_sense_clarification": "в выражении 'потерять счёт'"
                            },
                            {
                                "target_lang_word": "учёт",
                                "target_lang_sense_clarification": "в выражении 'вести учёт'"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takip",
                                "target_lang_sense_clarification": "bilgi sahibi olma"
                            },
                            {
                                "target_lang_word": "izleme",
                                "target_lang_sense_clarification": "süreci takip etme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77383084-c490-38e1-b422-5642dbb4b6f5",
                    "sense_definition": "A line of action, conduct, or development.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to work hard to get the project back on <w>track</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно усердно работать, чтобы вернуть проект в нужное <w>русло</w>.",
                                "tr": "Projeyi tekrar rayına <w>oturtmak</w> için çok çalışmamız gerekiyor."
                            }
                        },
                        {
                            "text": "She is on the fast <w>track</w> to becoming a manager.",
                            "target_lang_translations": {
                                "ru": "Она на прямом <w>пути</w> к тому, чтобы стать менеджером.",
                                "tr": "Yönetici olma <w>yolunda</w> hızla ilerliyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "course",
                        "path",
                        "direction"
                    ],
                    "common_phrases": [
                        "on track",
                        "back on track",
                        "fast track",
                        "track record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направление действий, поведения или развития.",
                        "tr": "Belirli bir hareket, davranış veya gelişme çizgisi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курс",
                                "target_lang_sense_clarification": "направление"
                            },
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "развития"
                            },
                            {
                                "target_lang_word": "колея",
                                "target_lang_sense_clarification": "привычный ход жизни"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yol",
                                "target_lang_sense_clarification": "gelişme yönü veya çizgisi"
                            },
                            {
                                "target_lang_word": "çizgi",
                                "target_lang_sense_clarification": "gidişat"
                            },
                            {
                                "target_lang_word": "rota",
                                "target_lang_sense_clarification": "izlenen yol"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38956de2-0e50-3db2-b0f0-baa63014b0cd",
                    "sense_definition": "A specific sequence of study or discussion within a larger program or conference.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conference features a special <w>track</w> for software developers.",
                            "target_lang_translations": {
                                "ru": "На конференции есть специальная <w>секция</w> для разработчиков программного обеспечения.",
                                "tr": "Konferansta yazılım geliştiricileri için özel bir <w>oturum</w> yer alıyor."
                            }
                        },
                        {
                            "text": "He chose the vocational <w>track</w> in high school instead of the academic one.",
                            "target_lang_translations": {
                                "ru": "Он выбрал профессиональное <w>направление</w> в старшей школе вместо академического.",
                                "tr": "Lisede akademik alan yerine mesleki <w>alanı</w> seçti."
                            }
                        }
                    ],
                    "synonyms": [
                        "stream",
                        "path"
                    ],
                    "common_phrases": [
                        "career track",
                        "academic track"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное направление обучения или дискуссий в рамках более крупной программы.",
                        "tr": "Büyük bir program veya konferans içindeki özel bir çalışma veya tartışma dizisi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направление",
                                "target_lang_sense_clarification": "учебное"
                            },
                            {
                                "target_lang_word": "секция",
                                "target_lang_sense_clarification": "на конференции"
                            },
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "группа обучающихся"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oturum",
                                "target_lang_sense_clarification": "konferans bölümü"
                            },
                            {
                                "target_lang_word": "alan",
                                "target_lang_sense_clarification": "akademik veya mesleki uzmanlaşma yönü"
                            },
                            {
                                "target_lang_word": "dal",
                                "target_lang_sense_clarification": "eğitim veya kariyer kolu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57e73c03-7994-39a3-8264-b521e6158dd8",
                    "sense_definition": "To watch, record, or monitor the progress or development of something over time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "monitor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This app helps you <w>track</w> your daily calorie intake.",
                            "target_lang_translations": {
                                "ru": "Это приложение помогает <w>отслеживать</w> ежедневное потребление калорий.",
                                "tr": "Bu uygulama günlük kalori alımınızı <w>takip etmenize</w> yardımcı olur."
                            }
                        },
                        {
                            "text": "Scientists are <w>tracking</w> the path of the hurricane.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>отслеживают</w> путь урагана.",
                                "tr": "Bilim insanları kasırganın izlediği yolu <w>izliyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "monitor",
                        "record",
                        "follow",
                        "observe"
                    ],
                    "antonyms": [
                        "ignore"
                    ],
                    "common_phrases": [
                        "track progress",
                        "track changes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наблюдать, записывать или контролировать развитие чего-либо с течением времени.",
                        "tr": "Bir şeyin zaman içindeki ilerleyişini veya gelişimini gözlemlemek, kaydetmek veya izlemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отслеживать",
                                "target_lang_sense_clarification": "наблюдать за изменениями"
                            },
                            {
                                "target_lang_word": "следить",
                                "target_lang_sense_clarification": "контролировать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takip etmek",
                                "target_lang_sense_clarification": "süreci gözlemlemek"
                            },
                            {
                                "target_lang_word": "izlemek",
                                "target_lang_sense_clarification": "gelişimi takip etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7def2619-d8b0-32aa-98f4-b51ea6de7f1c",
                    "sense_definition": "To follow the marks, signs, or smell left by a person or animal in order to find them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "follow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter <w>tracked</w> the deer through the forest for miles.",
                            "target_lang_translations": {
                                "ru": "Охотник <w>выслеживал</w> оленя в лесу много миль.",
                                "tr": "Avcı, geyiğin gidişatını orman boyunca millerce <w>takip etti</w>."
                            }
                        },
                        {
                            "text": "Police managed to <w>track</w> down the suspect at a hotel.",
                            "target_lang_translations": {
                                "ru": "Полиции удалось <w>выследить</w> подозреваемого в отеле.",
                                "tr": "Polis şüphelinin <w>izini sürüp</w> onu bir otelde yakalamayı başardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "trail",
                        "hunt",
                        "stalk",
                        "follow"
                    ],
                    "common_phrases": [
                        "track down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти по следам, знакам или запаху, чтобы найти кого-то.",
                        "tr": "Bir insanı veya hayvanı bulmak için bıraktığı izleri, işaretleri veya kokuyu takip etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выслеживать",
                                "target_lang_sense_clarification": "искать по следам"
                            },
                            {
                                "target_lang_word": "идти по следу",
                                "target_lang_sense_clarification": "преследовать"
                            }
                        ],
