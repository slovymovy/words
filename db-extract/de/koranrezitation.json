                "senses": [
                    {
                        "sense_id": "3d81789b-4a84-390a-887f-766d322b9ec2",
                        "entry_id": "68cc79f9-1fbb-3dcb-88d5-491bb7551fa2",
                        "glosses": [
                            "Rezitation des Koran"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c7b13e8-4ce7-4443-b87e-8de1ed11dd4d",
                                "sense_id": "3d81789b-4a84-390a-887f-766d322b9ec2",
                                "text": "„Joanne hatte sich mit einer pakistanischen Flagge und einer Audiokassette mit Koranrezitationen versorgt, die sogleich an den Fleischlieferanten weitergeleitet wurde, damit sie beim Schlachten abgespielt werden konnte.“"
                            },
                            {
                                "example_id": "d6dd41eb-fee2-4904-b2da-fb6975ddb532",
                                "sense_id": "3d81789b-4a84-390a-887f-766d322b9ec2",
                                "text": "„Als im November 2023 eine israelische Rakete ein Fahrzeug bei Ainata in der Bekaa-Ebene traf und eine Frau und ihre drei Enkelinnen tötete, die die Hisbollah-Schulen besuchten, wurde unter anderem auch dort mit gemeinsamen Koranrezitationen an die Opfer erinnert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
