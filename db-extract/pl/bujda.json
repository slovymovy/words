                        "cross_references": [
                            {
                                "target_word": "fib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "188c381b-5961-37ae-82a5-32ed59587118",
                                        "entry_id": "4911cf3e-a53e-38e3-8ec3-77e3a6b02e10",
                                        "glosses": [
                                            "A lie, especially one that is more or less inconsequential."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f3d5a16-d47b-4ea1-982b-74f50f90685e",
                                                "sense_id": "188c381b-5961-37ae-82a5-32ed59587118",
                                                "text": "Aſk me no queſtions, and I'll tell you no fibs."
                                            },
                                            {
                                                "example_id": "155b5d1a-096f-481d-8491-604ffba7cd8c",
                                                "sense_id": "188c381b-5961-37ae-82a5-32ed59587118",
                                                "text": "Wouldn’t that serve as an excuse, in Boston? I am told they are very sincere; they don't tell fibs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04271bb1-575f-331d-ade3-b63e31521c9c",
                                        "entry_id": "4911cf3e-a53e-38e3-8ec3-77e3a6b02e10",
                                        "glosses": [
                                            "A liar."
                                        ],
                                        "tags": [
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "473d4573-be08-48e6-9ff1-38d806b74ad1",
                                                "sense_id": "04271bb1-575f-331d-ade3-b63e31521c9c",
                                                "text": "\"Oh! you dreadful fib,\" said Flora."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9475f0-843f-3bc1-93bc-17da7d44860d",
                                        "entry_id": "c79ae4d6-77bb-36a9-9961-4bc6402b71f7",
                                        "glosses": [
                                            "To lie, especially more or less inconsequentially."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3903acdc-c55f-3937-9138-ff2dc16d97d3",
                                        "entry_id": "9dbb256d-55ca-31ac-afb7-44b84b68237a",
                                        "glosses": [
                                            "The fibula."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0faae3-87a6-3edc-a349-9590a7856874",
                                        "entry_id": "9db715a3-0d22-3c70-9f10-f792f272c90a",
                                        "glosses": [
                                            "To punch, especially a series of punches in rapid succession; to beat; to hit; to strike."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdd1dccf-2f1f-479c-b769-386434545595",
                                                "sense_id": "ab0faae3-87a6-3edc-a349-9590a7856874",
                                                "text": "Fib the cove's quarron in the rumpad for the lour in his bung; beat the fellow in the highway for the money in his purse."
                                            },
                                            {
                                                "example_id": "dccb4e77-3f61-4489-9a7e-faabbf9a9bed",
                                                "sense_id": "ab0faae3-87a6-3edc-a349-9590a7856874",
                                                "text": "The Chicken himself attributed this punishment to his having had the misfortune to get into Chancery early in the proceedings, when he was severely fibbed by the Larkey one, and heavily grassed."
                                            },
                                            {
                                                "example_id": "27492f6c-35e4-4d5e-97e3-c2147af2aa76",
                                                "sense_id": "ab0faae3-87a6-3edc-a349-9590a7856874",
                                                "text": "As Biggs and his party arrived, I heard Hawkins say to Berry, \"For heaven’s sake, my boy, fib with your right, and mind his left hand!\""
                                            },
                                            {
                                                "example_id": "31dca8ff-e3cc-4466-a0f8-28cb88a3ebd1",
                                                "sense_id": "ab0faae3-87a6-3edc-a349-9590a7856874",
                                                "text": "Then there was a wild scuffle and a furious outcry, and all the bargemen for a moment seemed to hug me and themselves too; when, as there was no room to hit out, in the phraseology of the ring, I fibbed at half-a-dozen waistcoats and faces with all my might and main."
                                            },
                                            {
                                                "example_id": "61d9d79a-1cc3-4e40-8591-b968ee6fd03d",
                                                "sense_id": "ab0faae3-87a6-3edc-a349-9590a7856874",
                                                "text": "Quoth he, \"Thou dost surely jest when thou sayest that thou dost not understand such words. Answer me this: Hast thou ever fibbed a chouse quarrons in the Rome pad for the loure in his bung?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d727be3f-2db0-3539-9e05-1814c9d8ad84",
                                        "entry_id": "adf5b0aa-928b-3e11-ac94-ce08616a22ed",
                                        "glosses": [
                                            "A kind of experimental poem where the number of syllables in each line is the next succeeding Fibonacci number."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
