                "senses": [
                    {
                        "sense_id": "aba2cd79-c867-3815-bbc5-18293f243193",
                        "entry_id": "b3619c8f-d177-3645-aede-cb42ffcab92b",
                        "glosses": [
                            "устар. и разг. то же, что нерешительность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e53a095-e429-405e-95d9-23b04e790c58",
                                "sense_id": "aba2cd79-c867-3815-bbc5-18293f243193",
                                "text": "Казалося нам, что он находился иногда в размышлении и нерешимости о продолжении пути своего."
                            },
                            {
                                "example_id": "e150852b-5c2d-49cf-a654-1944b906349a",
                                "sense_id": "aba2cd79-c867-3815-bbc5-18293f243193",
                                "text": "Андрей некоторое время стоял в нерешимости; одёрнув прилипшую к телу гимнастёрку, потрогал пальцем распухшее подглазье и бровь, затем взглянул на часы: до отхода поезда оставалось пять минут."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a5e06b3-ada1-4e08-805c-46f191320dc9",
                        "source_entry_id": "b3619c8f-d177-3645-aede-cb42ffcab92b",
                        "source_sense_id": "aba2cd79-c867-3815-bbc5-18293f243193",
                        "target_lang_word": "besluiteloosheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besluiteloosheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1aa69a55-9e7f-382b-a39e-d4af44fc445d",
                                        "entry_id": "36b26129-1c82-3ac7-a31f-f2ee2b21fd4c",
                                        "glosses": [
                                            "het besluiteloos zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3415d3-ac81-4a28-adf5-35bd4eeb15e9",
                                                "sense_id": "1aa69a55-9e7f-382b-a39e-d4af44fc445d",
                                                "text": "De besluiteloosheid van de zwakke bestuurder deed het bedrijf weinig goed."
                                            },
                                            {
                                                "example_id": "cbfac6bf-165f-4fba-99e3-0c351a4d1180",
                                                "sense_id": "1aa69a55-9e7f-382b-a39e-d4af44fc445d",
                                                "text": "De besluiteloosheid van de arts deed zijn patiënten weinig goed."
                                            },
                                            {
                                                "example_id": "7a607650-2186-4627-87f2-67bd5da21c4e",
                                                "sense_id": "1aa69a55-9e7f-382b-a39e-d4af44fc445d",
                                                "text": "Onzekerheid, besluiteloosheid, twijfel: de verschillende namen kwamen allemaal op hetzelfde neer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
