                    {
                        "sense_id": "a24ef24c-1199-3c83-8560-f3e5a6b495c6",
                        "entry_id": "69e709c2-1aba-3f24-8c93-1430f09ec8db",
                        "glosses": [
                            "Dire le mot « quoicoubeh »."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "d69f576c-1604-4ae1-9cbe-18eb6fcece0f",
                                "sense_id": "a24ef24c-1199-3c83-8560-f3e5a6b495c6",
                                "text": "J’arrête de quoicouber. C’est devenu trop toxique pour moi"
                            },
                            {
                                "example_id": "a6f1eab3-a489-435d-b0d8-2a70c200c131",
                                "sense_id": "a24ef24c-1199-3c83-8560-f3e5a6b495c6",
                                "text": "Il faut reprendre la propagande par le fait et quoicouber Macron"
                            },
                            {
                                "example_id": "cdf2303f-878a-40ff-8450-21d36f13980b",
                                "sense_id": "a24ef24c-1199-3c83-8560-f3e5a6b495c6",
                                "text": "@22iym Faut appeler l’intérim à 14h pour qu’elle khemem en pensant à l’idée de te quoicouber là"
                            },
                            {
                                "example_id": "2302b752-cc50-4063-a2fb-e328e17f12b2",
                                "sense_id": "a24ef24c-1199-3c83-8560-f3e5a6b495c6",
                                "text": "@zylbratz @LMargoulin Ils sont pas prêts à comment moi jvais les quoicouber"
                            },
                            {
                                "example_id": "8896ba92-b112-431f-a708-0c3d1b9ec0b9",
                                "sense_id": "a24ef24c-1199-3c83-8560-f3e5a6b495c6",
                                "text": "Le chemin du retour en noctilien samedi où j’ai rencontré un groupe de jeunes bourrés avec un d’eux qui essayait sans relâche (mais sans succès) de me quoicouber"
                            }
                        ]
                    }
