                                    {
                                        "sense_id": "38d0412c-b53e-3207-bf64-b701937c6417",
                                        "entry_id": "fab5de9d-95e9-3f5f-9efb-8ed261768b7e",
                                        "glosses": [
                                            "Gomme-résine inodore, jaune, âcre, amère, extraite de diverses espèces de Garcinia comme par exemple Garcinia hamburiy et Garcinia morella et qui s’employait autrefois en médecine comme purgatif aussi dans certaines peinture en tant que pigment jaune, pour l’aquarelle et pour la teinture de robes des bonzes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c817c6-22f9-427b-9db2-91e2b3d02817",
                                                "sense_id": "38d0412c-b53e-3207-bf64-b701937c6417",
                                                "text": "La gomme-gutte se recueille dans l’île de Ceylan et dans la presqu’île du Cambodge."
                                            },
                                            {
                                                "example_id": "97abe656-7d2e-483a-8c6f-9b8a7e4e9aa4",
                                                "sense_id": "38d0412c-b53e-3207-bf64-b701937c6417",
                                                "text": "La gomme-gutte est une des couleurs jaunes les plus pures."
                                            },
                                            {
                                                "example_id": "b880c509-e40e-49e5-be2b-71f7f8089083",
                                                "sense_id": "38d0412c-b53e-3207-bf64-b701937c6417",
                                                "text": "Prenez une once de jalap , & une demi-once de gomme gutte ; mettez le tout en poudre, mêlez-le et gardez-le pour l'usage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
