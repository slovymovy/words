                    {
                        "sense_id": "98dbf35b-0899-3261-989d-aa77895b289a",
                        "entry_id": "5b1ddf0b-c4a8-37c5-985a-72ce37dde5c6",
                        "glosses": [
                            "howl, wail"
                        ],
                        "tags": [
