                ],
                "senses": [
                    {
                        "sense_id": "9e975871-001c-3e38-b0a0-899ebced4bf3",
                        "entry_id": "cf65c371-049b-37c3-979f-a7cd6efb8173",
                        "glosses": [
                            "bedrijf dat veilingen organiseert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e573731c-1a60-4ab3-94e7-5e885d5368a4",
                                "sense_id": "9e975871-001c-3e38-b0a0-899ebced4bf3",
                                "text": "Op een veiling in Preston zijn gisteren 135 oude auto's geveild die al jaren stonden weg te roesten in een aantal loodsen op een terrein in de Engelse stad. Volgens het veilinghuis een \"unieke kans om in het bezit te komen van een klassieke oldtimer\"."
                            },
                            {
                                "example_id": "0147417a-f207-4cbb-a0f1-5484c4378563",
                                "sense_id": "9e975871-001c-3e38-b0a0-899ebced4bf3",
                                "text": "De Joodse gemeenschap heeft veel kritiek op de veiling, maar het veilinghuis is niet van plan de verkoop af te blazen. Volgens de eigenaar worden potentiële kopers gescreend om te voorkomen dat de nazi-spullen in verkeerde handen vallen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8142e69a-3d5c-34f9-957d-0c15afc9c0b6",
                        "entry_id": "cf65c371-049b-37c3-979f-a7cd6efb8173",
                        "glosses": [
                            "gebouw waar een bedrijf dat veilingen organiseert is gehuisvest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dadfae2e-406d-4b9f-a1ed-f38358ce19de",
                                "sense_id": "8142e69a-3d5c-34f9-957d-0c15afc9c0b6",
                                "text": "In Den Bosch is vanmiddag een veilinghuis overvallen. Twee gemaskerde overvallers bedreigden de bezoekers met een vuurwapen, sloegen vitrines kapot en gingen ervandoor met sieraden."
                            }
                        ]
                    }
