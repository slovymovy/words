                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57842d1c-918a-49c7-ab14-c75ce2f5126f",
                                "sense_id": "36d22661-5f66-3abd-9cda-3d05d31a96bd",
                                "text": "„Hegel etwa versuchte es mit dem Begriff „Holismus“, einer Lehre, die alle Erscheinungen des Lebens aus einem ganzheitlichen Prinzip ableitet – so Nina Lott, Wissenschaftliche Mitarbeiterin am Philosophischen Seminar der Universität Mainz: »Damit sie Wissenschaft ist, die Philosophie, muss sie in der Form des Systems auftreten. […]«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
