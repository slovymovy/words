        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5abf42d9-db06-3ba6-8a31-b1b50de8ba4c",
                    "sense_definition": "A line or mark made by folding or doubling a material.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His trousers had a sharp <w>crease</w> down the front.",
                            "target_lang_translations": {
                                "cs": "Jeho kalhoty měly vpředu ostrý <w>puk</w>.",
                                "ru": "Спереди на его брюках была наглажена острая <w>стрелка</w>."
                            }
                        },
                        {
                            "text": "The paper had many <w>creases</w> after being kept in his pocket.",
                            "target_lang_translations": {
                                "cs": "Papír byl po nošení v kapse samý <w>záhyb</w>.",
                                "ru": "Бумага покрылась множеством <w>складок</w> после того, как полежала у него в кармане."
                            }
                        }
                    ],
                    "synonyms": [
                        "rumple",
                        "fold",
                        "wrinkle"
                    ],
                    "common_phrases": [
                        "sharp crease"
                    ],
                    "target_lang_definitions": {
