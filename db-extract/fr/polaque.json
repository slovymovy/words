                                    {
                                        "sense_id": "6481c3e8-e9b7-3a5f-9c1c-67850b0bb73e",
                                        "entry_id": "0ec8f47e-8b69-39d4-ba45-13df12f34694",
                                        "glosses": [
                                            "A 17th-century three-masted merchant ship."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c61a65e1-017c-4d48-ba7a-9bb3250d6124",
                                                "sense_id": "6481c3e8-e9b7-3a5f-9c1c-67850b0bb73e",
                                                "text": "Before the Princess went to Palestine, do you know in what part of the polacre she slept?"
                                            },
                                            {
                                                "example_id": "b9aefe18-207c-498d-b09d-29adc14747a4",
                                                "sense_id": "6481c3e8-e9b7-3a5f-9c1c-67850b0bb73e",
                                                "text": "If that be so with respect to the Aum case, what shall we say to the case now established in proof onboard the polacre; that case which they have been unable by any evidence to shake, or by any observation to destroy?"
                                            },
                                            {
                                                "example_id": "981dffb7-093a-4416-990b-fa5950d2ac2d",
                                                "sense_id": "6481c3e8-e9b7-3a5f-9c1c-67850b0bb73e",
                                                "text": "As he approached the polacre he was surprised to see a Union Jack being hung over her gunwale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
