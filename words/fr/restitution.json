    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "478a5e3d-013b-3ee0-b54d-2867246649ac",
                    "sense_definition": "Action de rendre ce qui a été pris, indûment perçu, prêté ou volé à son propriétaire légitime.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rendre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur a accepté la <w>restitution</w> des bijoux dérobés avant le début du procès."
                        },
                        {
                            "text": "L'avocat a exigé la <w>restitution</w> intégrale de la somme versée par erreur sur ce compte."
                        }
                    ],
                    "synonyms": [
                        "remise",
                        "remboursement"
                    ],
                    "antonyms": [
                        "confiscation",
                        "rétention"
                    ],
                    "common_phrases": [
                        "demande de restitution",
                        "ordonner la restitution"
                    ]
                },
                {
                    "sense_id": "a6f860e7-0cf0-3f09-857a-23470eaebeb8",
                    "sense_definition": "Rétablissement d'un texte, d'un document ou d'une œuvre dégradée dans son état originel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retablir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philologue a consacré dix ans à la <w>restitution</w> du manuscrit médiéval incomplet."
                        },
                        {
                            "text": "La <w>restitution</w> précise du poème antique a été saluée par les plus grands spécialistes."
                        }
                    ],
                    "synonyms": [
                        "reconstitution",
                        "restauration"
                    ],
                    "common_phrases": [
                        "restitution d'un texte"
                    ]
                },
                {
                    "sense_id": "cdae3296-6d82-37c1-bb6f-fd5f5b58b180",
                    "sense_definition": "Reconstitution graphique ou matérielle d'un monument détruit à partir de ses vestiges et de données historiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retablir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les archéologues ont proposé une <w>restitution</w> en trois dimensions du temple gallo-romain."
                        },
                        {
                            "text": "Cette maquette offre une <w>restitution</w> fidèle de la forteresse avant sa destruction au seizième siècle."
                        }
                    ],
                    "synonyms": [
                        "reconstitution",
                        "modélisation"
                    ],
                    "common_phrases": [
                        "restitution 3D",
                        "restitution architecturale"
                    ]
                },
                {
                    "sense_id": "41572c9b-fd1f-317d-98e7-c2ac030ce80a",
                    "sense_definition": "Décision judiciaire qui décharge une personne d'un engagement juridique et rétablit la situation antérieure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a prononcé la <w>restitution</w> en entier au bénéfice du mineur injustement lésé."
                        },
                        {
                            "text": "Cette procédure juridique permet la <w>restitution</w> des parties dans leur état primitif."
                        }
                    ],
                    "synonyms": [
                        "rétablissement",
                        "annulation"
                    ],
                    "common_phrases": [
                        "restitution en entier"
                    ]
                },
                {
                    "sense_id": "cd5a4b83-ae73-3074-bffc-12a4db79efc8",
                    "sense_definition": "Reproduction d'une monnaie ou d'une médaille antique réalisée sous le règne d'un souverain postérieur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette pièce rare est une <w>restitution</w> frappée par Trajan en l'honneur d'Auguste."
                        },
                        {
                            "text": "Le musée conserve plusieurs <w>restitutions</w> impériales d'une remarquable finesse d'exécution."
                        }
                    ],
                    "common_phrases": [
                        "monnaie de restitution"
                    ]
                }
            ]
        }
    ]
