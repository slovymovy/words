{
    "word_family": [
        "kalafiorowy",
        "kalafiorkowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e060e4f-67f8-3170-8cf7-77797f0106d2",
                    "sense_definition": "jadalna część tej rośliny, biała główka złożona ze zwartych pędów kwiatowych, spożywana jako warzywo",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na obiad ugotowałam świeży <w>kalafior</w> z dodatkiem bułki tartej i masła.",
                            "target_lang_translations": {
                                "ru": "На обед я сварила свежую <w>цветную капусту</w> с панировочными сухарями и сливочным маслом."
                            }
                        },
                        {
                            "text": "Kup jeszcze dwa <w>kalafiory</w>, bo chcemy ugotować pyszną zupę.",
                            "target_lang_translations": {
                                "ru": "Купи ещё два <w>кочана цветной капусты</w>, потому что мы хотим сварить вкусный суп."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gotowany kalafior",
                        "zupa z kalafiora",
                        "główka kalafiora"
                    ],
                    "target_lang_definitions": {
                        "ru": "съедобная часть растения, белый кочан из плотных соцветий, употребляемый в пищу как овощ"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветная капуста",
                                "target_lang_sense_clarification": "овощ, кочан соцветий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69007b53-5361-313a-80d5-a4146dc7731c",
                    "sense_definition": "roślina uprawna z rodziny kapustowatych o jadalnych, skupionych kwiatostanach",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W naszym przydomowym ogródku <w>kalafior</w> rośnie wyjątkowo dobrze tego lata.",
                            "target_lang_translations": {
                                "ru": "В нашем огороде возле дома <w>цветная капуста</w> растёт этим летом на редкость хорошо."
                            }
                        },
                        {
                            "text": "Rolnik postanowił posadzić <w>kalafiory</w> obok wczesnej kapusty.",
                            "target_lang_translations": {
                                "ru": "Фермер решил посадить <w>цветную капусту</w> рядом с ранней капустой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uprawa kalafiora"
                    ],
                    "target_lang_definitions": {
                        "ru": "культурное растение семейства капустных со съедобными плотными соцветиями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветная капуста",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c11ecd2b-1ce8-393e-a38d-e86dc25f60e0",
                    "sense_definition": "małżowina uszna zniekształcona w wyniku powtarzających się urazów mechanicznych, częsta u zapaśników",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wielu latach walk na macie na jego lewym uchu pojawił się charakterystyczny <w>kalafior</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет схваток на ковре на его левом ухе появился характерный <w>пельмень</w>."
                            }
                        },
                        {
                            "text": "Zawodnicy sportów walki często mają zniekształcone uszy zwane potocznie <w>kalafiorami</w>.",
                            "target_lang_translations": {
                                "ru": "У бойцов часто бывают деформированные уши, которые в обиходе называют <w>пельменями</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ucho zapaśnika"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w żargonie sportowym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ушная раковина, деформированная в результате постоянных механических травм, типичная для борцов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пельмень",
                                "target_lang_sense_clarification": "деформированное ухо борца, жарг."
                            },
                            {
                                "target_lang_word": "цветная капуста",
                                "target_lang_sense_clarification": "борцовское ухо (калька с уха-цветной капусты)"
                            },
                            {
                                "target_lang_word": "сломанное ухо",
                                "target_lang_sense_clarification": "травмированное ухо борца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "912d83ce-5089-3798-af6f-a42654135c29",
                    "sense_definition": "kaloryfer, grzejnik",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starym mieszkaniu w zimie <w>kalafiory</w> ledwo grzały i trzeba było nosić gruby sweter.",
                            "target_lang_translations": {
                                "ru": "В старой квартире зимой <w>батареи</w> едва грели, и приходилось носить толстый свитер."
                            }
                        },
                        {
                            "text": "Dotknij tego <w>kalafiora</w> i sprawdź, czy wreszcie włączyli ogrzewanie w pokoju.",
                            "target_lang_translations": {
                                "ru": "Потрогай эту <w>батарею</w> и проверь, включили ли наконец отопление в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "kaloryfer",
                        "grzejnik"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "żartobliwe przekształcenie słowa kaloryfer"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "радиатор, батарея отопления (шутливое искажение слова kaloryfer)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "батарея",
                                "target_lang_sense_clarification": "отопительный прибор"
                            },
                            {
                                "target_lang_word": "радиатор",
                                "target_lang_sense_clarification": "отопительный прибор"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}