                "senses": [
                    {
                        "sense_id": "0576f984-9303-3344-8bea-d6041d483e0d",
                        "entry_id": "61fd83f5-7252-3f10-b7aa-2638a0ec3b5d",
                        "glosses": [
                            "Lexikon, das Rätsel-Begriffe enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e452076-7f19-44e5-87e6-ab30e45cf18b",
                                "sense_id": "0576f984-9303-3344-8bea-d6041d483e0d",
                                "text": "„Alphabetisch geordnet listet das Rätsellexikon ohne Ausnahme den gesamten Rätselwortschatz auf, der von der BASTEI Rätselredaktion fortwährend aktualisiert und gepflegt wird.“"
                            },
                            {
                                "example_id": "c06ceac6-e256-448e-a94b-1c160f3321eb",
                                "sense_id": "0576f984-9303-3344-8bea-d6041d483e0d",
                                "text": "„Um ihren Wissensdurst zu stillen, ist sie leidenschaftliche Kreuzworträtslerin geworden. Mithilfe eines Rätsellexikons löst sie jedes Rätsel komplett.“"
                            },
                            {
                                "example_id": "4fc602e9-58b4-43e6-975a-68c7589e1440",
                                "sense_id": "0576f984-9303-3344-8bea-d6041d483e0d",
                                "text": "„Um gerade den treuesten Kunden den Frust lückenhaft gelöster Schwedenrätsel zu ersparen, hat der Kelter Verlag jetzt ein Rätsellexikon entwickelt, das am 26.1. zum Preis von 6,95 Euro auf den Markt kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
