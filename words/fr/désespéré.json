        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1afccbf8-5bdf-3fca-b5aa-6dff8cdfb1e7",
                    "sense_definition": "Qui est plongé dans le désespoir, abattu ou privé de tout espoir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'annonce de cet échec cuisant, il est resté totalement <w>désespéré</w> pendant plusieurs jours.",
                            "target_lang_translations": {
                                "en": "After the announcement of this crushing failure, he was totally <w>despondent</w> for several days.",
                                "ru": "После объявления об этом сокрушительном провале он несколько дней был совершенно <w>подавлен</w>.",
                                "de": "Nach der Bekanntgabe dieses vernichtenden Misserfolgs war er mehrere Tage lang völlig <w>niedergeschlagen</w>.",
                                "es": "Tras el anuncio de este fracaso estrepitoso, quedó completamente <w>abatido</w> durante varios días.",
                                "zh": "这场惨败的消息公布后，他连续好几天都十分<w>沮丧</w>。"
                            }
                        },
                        {
                            "text": "Elle était tellement <w>désespérée</w> qu'elle ne savait plus vers qui se tourner pour obtenir de l'aide.",
                            "target_lang_translations": {
                                "en": "She was so <w>desperate</w> that she no longer knew whom to turn to for help.",
                                "ru": "Она была в таком <w>отчаянии</w>, что уже не знала, к кому обратиться за помощью.",
                                "de": "Sie war so <w>verzweifelt</w>, dass sie nicht mehr wusste, an wen sie sich um Hilfe wenden sollte.",
                                "es": "Estaba tan <w>desesperada</w> que ya no sabía a quién acudir para pedir ayuda.",
                                "zh": "她<w>绝望</w>得不知道还能向谁求助。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abattu",
                        "découragé",
                        "inconsolable"
                    ],
                    "antonyms": [
                        "confiant",
                        "serein"
                    ],
                    "common_phrases": [
                        "cri désespéré",
                        "appel désespéré"
                    ],
                    "target_lang_definitions": {
                        "en": "Overwhelmed by despair, dejected, or without any hope.",
                        "ru": "Охваченный отчаянием, подавленный или лишённый всякой надежды.",
                        "de": "Sehr traurig, seelisch am Boden und ohne jede Hoffnung.",
                        "es": "Sumido en la desesperación, abatido o sin ninguna esperanza.",
                        "zh": "形容心情沮丧、万念俱灰，对一切都不抱希望。"
                    },
                    "translations": {
