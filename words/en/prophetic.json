{
    "word_family": [
        "prophesy",
        "prophecy",
        "prophet",
        "prophetess",
        "prophetically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24f1be3f-e483-397b-8684-80d04e90cc9e",
                    "sense_definition": "Accurately predicting what will happen in the future; prescient.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prediction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her warnings about the economic crash proved to be remarkably <w>prophetic</w>.",
                            "target_lang_translations": {
                                "nl": "Haar waarschuwingen over de economische crash bleken opmerkelijk <w>profetisch</w> te zijn."
                            }
                        },
                        {
                            "text": "He seemed to possess a <w>prophetic</w> ability to foresee market trends before anyone else.",
                            "target_lang_translations": {
                                "nl": "Hij leek een <w>profetische</w> gave te bezitten om markttrends te voorzien voordat iemand anders dat deed."
                            }
                        }
                    ],
                    "synonyms": [
                        "prescient",
                        "farsighted",
                        "predictive"
                    ],
                    "common_phrases": [
                        "prophetic words",
                        "prophetic warning",
                        "prove prophetic"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het accuraat voorspellen van wat er in de toekomst zal gebeuren; vooruitziend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "profetisch",
                                "target_lang_sense_clarification": "accuraat vooruitziend"
                            },
                            {
                                "target_lang_word": "vooruitziend",
                                "target_lang_sense_clarification": "de toekomst goed inschattend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6393b0bb-654c-3a1a-bcdd-972f6a80a49a",
                    "sense_definition": "Of, belonging to, or characteristic of a prophet or prophecy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prophecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient scriptures contain many <w>prophetic</w> writings about the end of the world.",
                            "target_lang_translations": {
                                "nl": "De oude geschriften bevatten veel <w>profetische</w> teksten over het einde van de wereld."
                            }
                        },
                        {
                            "text": "She claimed to experience <w>prophetic</w> visions during her deep meditations.",
                            "target_lang_translations": {
                                "nl": "Ze beweerde tijdens haar diepe meditaties <w>profetische</w> visioenen te ervaren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prophetic vision",
                        "prophetic powers",
                        "prophetic writings"
                    ],
                    "target_lang_definitions": {
                        "nl": "Behorend tot, afkomstig van of kenmerkend voor een profeet of profetie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "profetisch",
                                "target_lang_sense_clarification": "van of als van een profeet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "844224cf-aa1f-3c8e-ad91-fa7de438d32a",
                    "sense_definition": "Foretelling or signifying future events; indicative of what is to come.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prediction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His unsettling dream was <w>prophetic</w> of the misfortune that soon followed.",
                            "target_lang_translations": {
                                "nl": "Zijn verontrustende droom was <w>voorspellend voor</w> het ongeluk dat al snel volgde."
                            }
                        },
                        {
                            "text": "The sudden chill in the air seemed <w>prophetic</w> of a harsh and unforgiving winter.",
                            "target_lang_translations": {
                                "nl": "De plotselinge kilte in de lucht leek een <w>voorteken</w> van een strenge en meedogenloze winter."
                            }
                        }
                    ],
                    "synonyms": [
                        "portentous",
                        "foreboding",
                        "harbinger"
                    ],
                    "common_phrases": [
                        "prophetic of"
                    ],
                    "target_lang_definitions": {
                        "nl": "Toekomstige gebeurtenissen aankondigend of voortekenen; indicatief voor wat komen gaat."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorspellend",
                                "target_lang_sense_clarification": "aankondigend wat er gaat gebeuren"
                            },
                            {
                                "target_lang_word": "voorafschaduwend",
                                "target_lang_sense_clarification": "een voorteken vormend van"
                            },
                            {
                                "target_lang_word": "profetisch",
                                "target_lang_sense_clarification": "een voorteken inhoudend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}