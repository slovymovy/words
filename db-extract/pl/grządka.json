                "senses": [
                    {
                        "sense_id": "303e4e17-e998-3e3e-9a96-9644a6e5158b",
                        "entry_id": "165ddda9-d83f-3e42-bb7e-70897f920ce5",
                        "glosses": [
                            "Beet, Rabatte"
                        ],
                        "tags": [
                            "Gartenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "c4da7bff-e9a5-4813-ac69-d64c0daa3d28",
                                "sense_id": "303e4e17-e998-3e3e-9a96-9644a6e5158b",
                                "text": "„Widać że okolica obfita we zboże, / I widać z liczby kopic, co wzdłuż i wszerz smugów / Świecą gęsto jak gwiazdy; widać z liczby pługów / Orzących wcześnie łany ogromne ugoru / Czarnoziemne, zapewne należne do dworu, / Uprawne dobrze nakształt ogrodowych grządek: / Że w tym domu dostatek mieszka i porządek.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7809d742-c8fd-3f15-a26e-eacc4ecdb113",
                        "entry_id": "165ddda9-d83f-3e42-bb7e-70897f920ce5",
                        "glosses": [
                            "kleine Stange, auf der Vögel sitzen können"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7e8c9a1-4ff9-4b03-9d30-9be1440a7843",
                        "source_entry_id": "165ddda9-d83f-3e42-bb7e-70897f920ce5",
                        "source_sense_id": "303e4e17-e998-3e3e-9a96-9644a6e5158b",
                        "source_sense_description": "Landwirtschaft, Gartenbau: Beet, Rabatte",
                        "target_lang_word": "Beet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e2d36b4-36ab-3b92-a692-6c18e7923506",
                                        "entry_id": "48eaca1a-444c-36a2-aacf-3431d19a6f2c",
                                        "glosses": [
                                            "abgegrenztes Stück Boden, das zur Zucht von Zier- und Nutzpflanzen genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0cd0339-8061-4912-a796-64e275c05338",
                                                "sense_id": "0e2d36b4-36ab-3b92-a692-6c18e7923506",
                                                "text": "Der Gärtner pflanzte auf seinem Beet stets nur Karotten."
                                            },
                                            {
                                                "example_id": "f8825792-adac-4d65-b729-5dfda6790d85",
                                                "sense_id": "0e2d36b4-36ab-3b92-a692-6c18e7923506",
                                                "text": "„Vor den Häusern reihten sich gut gepflegte Beete mit Tomaten, Paprika, Gurken und Salat.“"
                                            },
                                            {
                                                "example_id": "7a35159e-93dc-444d-89cd-5b32dc4e8145",
                                                "sense_id": "0e2d36b4-36ab-3b92-a692-6c18e7923506",
                                                "text": "„Eine kleine Ziegelmauer rahmt ein ordentliches Beet mit duftendem Lavendel ein.“"
                                            },
                                            {
                                                "example_id": "2cc7d1f3-f354-4cc5-a002-3cbce6df4592",
                                                "sense_id": "0e2d36b4-36ab-3b92-a692-6c18e7923506",
                                                "text": "„Ein paar Beete mit Narzissen, Veilchen und Tulpen blühten.“"
                                            },
                                            {
                                                "example_id": "5d58b1e8-f9e5-4866-89c9-f957660f025b",
                                                "sense_id": "0e2d36b4-36ab-3b92-a692-6c18e7923506",
                                                "text": "„Schon sahen sie sich in Hemdsärmeln am Rande eines Beetes beim Rosen-Okulieren, Umgraben, Hacken, Prüfen der Gartenerde und Austopfen von Tulpen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9675dc66-af21-4aeb-a780-a956ce9fb779",
                        "source_entry_id": "165ddda9-d83f-3e42-bb7e-70897f920ce5",
