                                        "examples": [
                                            {
                                                "example_id": "4db2e36f-c50f-414d-8432-32366b87a579",
                                                "sense_id": "4f600752-935d-3a52-b720-41f9019af5c1",
                                                "text": "„Auf ähnliche Weise wollen die Holzhauerinnen S. 17 ihre in den Krieg gezogenen Gatten an das Haus fesseln: «Wißt ihr, was wir bauen? Einen Käfig zum Verschluß. Wenn du nur erst heimgekommen Zu gemeinschaftlichem Frommen, Mach' ich meinen Käfig zu, Sollst mir nicht entkommen.»“"
                                            }
                                        ],
