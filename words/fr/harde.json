                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "troupe_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le ciel d'automne s'élevait une <w>harde</w> de buses tournoyant au-dessus des collines boisées."
                        },
                        {
                            "text": "L'ornithologue observa avec attention cette <w>harde</w> d'éperviers migrant vers le sud de la région."
                        }
                    ],
                    "synonyms": [
                        "volée"
                    ]
                }
            ]
        },
